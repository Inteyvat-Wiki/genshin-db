				]
			},
			"dialogs": [
				{
					"id": 756720101,
					"content": "Ого, что здесь делает этот резвый аша? И... Беннет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756720102,
					"content": "#О, это же {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720103
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720103,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720104
					],
					"speakerTitle": "Аша Мастер Цвета"
				},
				{
					"id": 756720104,
					"content": "Беннет, ты снова на курорте отдыхаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756720105,
					"content": "#Ага. {NICKNAME}, если ты помнишь, я написал в письме, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720106
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720106,
					"content": "...пару месяцев назад я наконец накопил достаточно денег на хорошо оплачиваемых поручениях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720107
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720107,
					"content": "...и смог пригласить всех своих пап и друзей сюда, на курорт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720108
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720108,
					"content": "Папы были очень рады увидеть, что в Натлане моя полоса неудач почти закончилась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720109
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720109,
					"content": "Да, такими хорошими новостями обязательно нужно делиться со всеми, Беннет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720110,
						756720111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756720110,
					"content": "Отличная новость!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720112
					]
				},
				{
					"id": 756720112,
					"content": "Эх, жаль, что мы не встретились на прошлой неделе. Могли бы пообедать вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720113
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720113,
					"content": "Ну, тогда подождём, пока вы снова окажетесь в Мондштадте. Найдём по-настоящему безопасное место и устроим Безопасный пещерный ужин любителей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720114
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720114,
					"content": "Погоди, Беннет... Ты хочешь сказать, что твои папы и друзья уехали, а ты остался здесь один?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756720115,
					"content": "Ага. Папы отлично проводили время, но потом узнали, что Диона из «Кошкиного хвоста» скоро уезжает в долгую командировку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720116
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720116,
					"content": "Поэтому они не стали продлевать отпуск и решили вернуться в Мондштадт, как и планировали, - чтобы успеть попить ещё её фирменные напитки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720117
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720117,
					"content": "Но не переживай, я не застрял тут из-за задержек или потерянного билета. Я остался помочь друзьям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720118
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720118,
					"content": "Мы ловили рыбу у моря и наткнулись на нескольких аш-колористов, у которых возникли сложности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720119
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720119,
					"content": "По моему опыту, они, скорее всего, ищут какое-то необычное сокровище...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720120
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720120,
					"content": "Хм. Раз их называют колористами, значит, их сокровище - это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720121,
						756720122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756720121,
					"content": "Какая-нибудь суперредкая краска?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720123
					]
				},
				{
					"id": 756720123,
					"content": "Именно! Аши не только разрисовывают всё вокруг, но и любят собирать редкие пигменты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720124
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720124,
					"content": "Колористы нашли в одном скрытом месте особый вид пигмента... Он как будто свободно перемещается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720125
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720125,
					"content": "И, как кристальные бабочки, эти цвета всё время летают туда-сюда. Колористы не знают, как их поймать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720126
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720126,
					"content": "Слушай, давай мы поможем. Сходим туда и разберёмся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756720127,
					"content": "Кто знает, может, мы уже сталкивались с чем-то подобным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720128,
						756720129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756720128,
					"content": "Помочь ашам в беде мы всегда готовы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720130
					]
				},
				{
					"id": 756720130,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720131
					],
					"speakerTitle": "Аша Мастер Цвета"
				},
				{
					"id": 756720131,
					"content": "Отлично! Тогда давайте вместе поможем колористам. Я буду следовать за вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720132
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720132,
					"content": "Надеюсь, они смогут добыть самые удивительные пигменты, создать ярчайшие краски и продолжат дарить радость своим искусством!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756720129,
					"content": "Если нужно что-то редкое для коллекции, обращайтесь к нам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720130
					]
				},
				{
					"id": 756720122,
					"content": "Или особенно ценная краска?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720123
					]
				},
				{
					"id": 756720111,
					"content": "#Сколько бы раз ты ни рассказывал, рад{F#а} за тебя!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720112
					]
				}
			]
		}
	]
}