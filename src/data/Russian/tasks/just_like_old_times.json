			"dialogs": [
				{
					"id": 761840301,
					"content": "А неплохое у вас чаепитие. Знал бы раньше, приходил бы почаще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840302,
						761840303
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 761840302,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				},
				{
					"id": 761840304,
					"content": "Хорошо, увидимся в следующий раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 761840303,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				}
			]
		}
	]
