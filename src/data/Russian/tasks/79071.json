			"dialogs": [
				{
					"id": 790710101,
					"content": "#{NICKNAME} и Паймон, добро пожаловать в Столицу Созвездия!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710102
					],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710102,
					"content": "Я много слышал о ваших подвигах от сослуживцев - храбрости вам не занимать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710103
					],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710103,
					"content": "Жаль, что мне нужно заниматься подготовкой стражников, иначе я бы сразился с вами в Дружеском матче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710104
					],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710104,
					"content": "Ты стражник Столицы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710105
					]
				},
				{
					"id": 790710105,
					"content": "Так точно! Мы исполняем приказ суверена, охраняем Столицу Созвездия и поддерживаем в ней мир и покой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710106
					],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710106,
					"content": "А вообще я отвечаю за тренировку стражников, делаю из них достойных воинов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710107
					],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710107,
					"content": "Значит, дверь позади тебя - это тренировочная площадка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710108
					]
				},
				{
					"id": 790710108,
					"content": "Да у вас глаз-алмаз! Этот вход ведёт в подземелье. Мы переделали его совсем недавно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710109
					],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710109,
					"content": "На этой тренировочной площадке ученики должны орудовать мечами в определённом ритме. Во время боя освещение поля постоянно меняется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710110
					],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710110,
					"content": "Как всё серьёзно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710111
					]
				},
				{
					"id": 790710111,
					"content": "И запутанно... Во время боя нужно придерживаться определённого ритма?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790710112,
					"content": "Эта деталь появилась благодаря истории под названием «Музыкант-сова».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710113
					],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710113,
					"content": "Какое-то время назад эта история была довольно популярной среди стражников. Увлёкшись чтением, многие из них забывали о тренировках, а некоторые даже ежедневные патрули пропускали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710114
					],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710114,
					"content": "А раз всем так полюбилась эта книга, я решил, что тренировку с отсылками к этой истории все полюбят ещё больше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710115
					],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710115,
					"content": "И я не прогадал - результат был налицо. По крайней мере... никто больше не откладывает патрулирование по личным причинам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710116
					],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710116,
					"content": "Хе-хе... Может, и вы захотите потренироваться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710117
					],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710117,
					"content": "С вашей доблестью и навыками на тренировочной площадке не страшны никакие испытания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710118,
						790710120
					],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710118,
					"content": "А почему бы и нет?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710119
					]
				},
				{
					"id": 790710119,
					"content": "Хвалю за смелость! Прошу, проходите в подземелье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Алоф"
				},
				{
					"id": 790710120,
					"content": "У нас есть ещё кое-какие дела...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710121
					]
				},
				{
					"id": 790710121,
					"content": "Без проблем. Приходите, когда будет время. Я всегда на посту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Алоф"
				}
			]
		}
	]
}