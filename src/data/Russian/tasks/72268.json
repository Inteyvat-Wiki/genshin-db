					],
					"speakerTitle": "Уда"
				},
				{
					"id": 722680102,
					"content": "Я отвечаю за испытание мудрости. Разгадай все головоломки, чтобы вернуть Огни высоких врат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680103
					],
					"speakerTitle": "Уда"
				},
				{
					"id": 722680103,
					"content": "Не обладая мудростью идти вперёд - это не храбрость, а безрассудство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680104
					],
					"speakerTitle": "Уда"
				},
				{
					"id": 722680104,
					"content": "Я подожду в Башне трёх миров, пока ты завершишь испытание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Уда"
