					"Годвин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370101,
					"content": "Я готов вернуться в Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370102
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370102,
					"content": "#Эй, путешественн{F#ица}{M#ик}! Ты можешь мне помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370103
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370103,
					"content": "Как ты можешь заметить, я рыцарь. Сейчас я на дежурстве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370104
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370104,
					"content": "Я обещал своей девушке отправить ей письмо, чтобы она не переживала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370105
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370105,
					"content": "Но я был очень занят и совсем забыл про это. Сможешь передать ей это <color=#00E1FFFF>письмо</color>? Её зовут <color=#00E1FFFF>Глория</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370106
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370106,
					"content": "Подожди, ты сказал Глория?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370107
					]
				},
				{
					"id": 200370107,
					"content": "Слепая девушка... Любит одуванчики...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200370108,
					"content": "Да! А ты - Годвин! Глория столько о тебе рассказывала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200370109,
					"content": "Откуда ты знаешь Глорию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370110
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370110,
					"content": "#Я помог{F#ла} ей с одним делом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370111
					]
				},
				{
					"id": 200370111,
					"content": "Да? Надеюсь, ничего опасного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370112
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370112,
					"content": "Она попросила нас собрать семена одуванчиков, чтобы пустить их по ветру. Они должны были донести до тебя её слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200370113,
					"content": "Семена одуванчиков? Похоже на Глорию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370114
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370114,
					"content": "Подожди, она говорила, что ты где-то очень далеко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370115
					]
				},
				{
					"id": 200370115,
					"content": "Да, изначально так и планировалось, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370116
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370116,
					"content": "Наверняка ты знаешь, что магистр Ордо Фавониус покинул Мондштадт и взял с собой большинство рыцарей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370117
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370117,
					"content": "Так вот, я тоже должен был участвовать в этой экспедиции. Но прямо перед отправлением я понял, что потерял подарок от Глории. Пока я его искал, все рыцари ушли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370118
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370118,
					"content": "Я не знаю, как мне их догнать... И что мне делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370119
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370119,
					"content": "В Мондштадт вернуться я не могу. Страшно представить, что обо мне подумают рыцари.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370120
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370120,
					"content": "Я обещал Глории отправлять открытки и подарки со всего света...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370121
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370121,
					"content": "Если она узнает, что я всё ещё рядом с Мондштадтом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370122
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370122,
					"content": "Ты сгоришь от стыда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200370123,
					"content": "Пожалуйста, отнеси <color=#00E1FFFF>Глории</color> это <color=#00E1FFFF>письмо</color>. Наверное, она ужасно волнуется за меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370124,
						200370126
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370124,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370125
					]
				},
				{
					"id": 200370125,
					"content": "Я бесконечно тебе благодарен. Прошу, никому обо мне не рассказывай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370126,
					"content": "Почему бы тебе не воспользоваться семечками одуванчика?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370127
					]
				},
				{
					"id": 200370127,
					"content": "Я столько всего хочу сказать ей. Понадобилось бы слишком много семечек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370128
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370128,
					"content": "Спасибо тебе ещё раз. И не забывай держать всё в секрете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Годвин"
				}
			]
		},
