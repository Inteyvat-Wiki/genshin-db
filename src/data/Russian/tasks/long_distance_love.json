					"Глория"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370301,
					"content": "Я знаю этот голос... Это вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370302
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200370302,
					"content": "Что привело вас ко мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370303
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200370303,
					"content": "Письмо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370304
					]
				},
				{
					"id": 200370304,
					"content": "Письмо? Мне? От кого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370305
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200370305,
					"content": "Годвин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370306
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200370306,
					"content": "Вы видели его? С ним всё в порядке? Он сказал, когда вернётся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370307
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200370307,
					"content": "Простите, я задаю слишком много вопросов. Наверняка он очень занят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370308
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200370308,
					"content": "Вы можете прочесть мне это письмо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370309
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200370309,
					"content": "Только тихо-тихо. Никто, кроме нас, не должен его услышать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370310
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200370310,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370311
					]
				},
				{
					"id": 200370311,
					"content": "Вы так красиво читаете...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370312
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200370312,
					"content": "Это конец письма.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370313
					]
				},
				{
					"id": 200370313,
					"content": "Гавань Ли Юэ... Годвин так далеко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370314
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200370314,
					"content": "Спасибо вам! Я буду хранить это письмо, как зеницу ока. В следующий раз, когда увидите <color=#00E1FFFF>Годвина</color>, передайте, что я не перестаю о нём думать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370315
					],
					"speakerTitle": "Глория"
				}
			]
		},
