						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Годвин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370501,
					"content": "#Ты доставил{F#а} моё письмо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370502
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370502,
					"content": "Глория передаёт привет! Она постоянно думает о тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370503
					]
				},
				{
					"id": 200370503,
					"content": "Фух... Она не злится на меня из-за того, что я долго не писал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370504
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370504,
					"content": "Откуда ты знаешь так много о Ли Юэ, если ты никогда не покидал Мондштадт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200370505,
					"content": "Из историй магистра Ордо Фавониус. Он повидал всё на свете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370506
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370506,
					"content": "#Спасибо! Ты мне очень помог{F#ла}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370507
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370507,
					"content": "Возьми эти семечки одуванчика. Я сам их собрал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370508
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 200370508,
					"content": "Я надеюсь, ты поможешь Глории, когда ей снова понадобятся семечки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Годвин"
				}
			]
		}
	]
}