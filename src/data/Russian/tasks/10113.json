				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Стэнли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130301,
					"content": "Скажи мне, Стэнли... Скажи, что же мне делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130302
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130302,
					"content": "Почему он продолжает повторять своё имя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130303,
						101130305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130303,
					"content": "Он что-то скрывает.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130304
					]
				},
				{
					"id": 101130304,
					"content": "Может, кого-то ещё зовут Стэнли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130307,
					"content": "*Хнык-хнык* Ох, Стэнли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130308
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130308,
					"content": "На твоём месте должен был быть я! Это я должен был умереть тогда в Пепельном море... Почему твой дух не вернётся и не отберёт у меня твоё имя? Почему, Стэнли, почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130309
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130309,
					"content": "Если бы ты не бросился спасать такого желторотого приключенца, как я, ты бы не умер в забытом Архонтами уголке этого мира!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130310
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130310,
					"content": "Ты был матёрым искателем приключений, однажды обязательно бы стал легендой... Но этого никогда не случится, потому что ты... Всё из-за бесполезного увязавшегося за тобой сопляка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130311
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130311,
					"content": "Эм... Кто-нибудь понимает, что тут происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130312,
					"content": "Кажется, наш друг правда был на Пепельном море. И он правда участвовал в трагедии, которая там произошла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130313
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130313,
					"content": "Но настоящим героем, настоящим Стэнли, был его друг, а не он сам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130314
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130314,
					"content": "Настоящий Стэнли погиб, спасая нашего «Стэнли».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130315
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130315,
					"content": "Подожди... Значит, нашего Стэнли зовут Стэнли только потому, что он украл имя Стэнли у настоящего Стэнли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130316,
					"content": "Боюсь, что так оно и есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130317
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130317,
					"content": "Стэнли, столько лет я жил в страхе... страхе, что твоё имя будет забыто в Мондштадте... Поэтому я рассказываю истории о твоих подвигах при каждой возможности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130318
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130318,
					"content": "Мондштадт должен помнить. Стэнли дошёл до самого центра Пепельного моря... Он величайший искатель приключений! Стэнли жив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130319
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130319,
					"content": "Стэнли никогда не умрёт, потому что я буду Стэнли! Я буду... Стэнли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130320
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130320,
					"content": "Прости меня, Стэнли... Я старею...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130321
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130321,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130322
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130322,
					"content": "Ребята, вы так и будете подслушивать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130323
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130323,
					"content": "Божечки! Он нас заметил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130305,
					"content": "Может, кого-то ещё зовут Стэнли?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130306
					]
				},
				{
					"id": 101130306,
					"content": "Не может быть. Даже я не слышал ни о каком другом Стэнли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Венти"
				}
			]
		},
		{
			"id": 1011304,
			"completionStepIds": [
				1011304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011304",
							"2"
						],
						"stepId": 1011304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Стэнли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130401,
					"content": "Уходите. Не нужно ничего спрашивать, просто оставьте меня одного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130402
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130402,
					"content": "Но ведь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130403,
					"content": "Идите! Не заставляйте меня повторять!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130404
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130404,
					"content": "#Почётный рыцарь {NICKNAME}! Венти! И Паймон! Я очень рад, что вы здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130405
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101130405,
					"content": "Я вас повсюду искал! Хотел отблагодарить за то, что помогли мне с поисками меча и щита. Мои родители наконец-то согласились меня поддерживать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130406
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101130406,
					"content": "Ох, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130407
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130407,
					"content": "Правда! Они даже согласились заплатить кому-нибудь, кто сможет починить Меч ослепительной доблести и Щит сияющей воли, чтобы я мог взять их с собой в дорогу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130408
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101130408,
					"content": "Восхитительно! Значит, Джек, ты собираешься покинуть Мондштадт и отправиться в путешествие по Тейвату?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130409
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130409,
					"content": "О нет, что ты, пока нет. Боюсь, у меня не хватит сил и навыков, чтобы уйти далеко от города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130410
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101130410,
					"content": "Кроме того, думаю, у Стэнли ещё не перевелись истории, хе-хе... Именно его истории вдохновили меня ступить на путь приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130411
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101130411,
					"content": "Ох, мистер Стэнли... Он снова напился?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130412
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101130412,
					"content": "Тогда встретимся завтра, мистер Стэнли. Надеюсь, как только уйдёт похмелье, вы сможете поделиться со мной новыми историями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130413
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101130413,
					"content": "Стэнли очень нравится этот парень, вам так не кажется?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130414
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130414,
					"content": "Джек? Джек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130415
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130415,
					"content": "Он уже ушёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130416
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130416,
					"content": "Ох, жаль... Спасибо вам, что не рассказали ему мой секрет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130417
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130417,
					"content": "Что? В кои-то веке ты обратил внимание на реальность? Совсем на тебя непохоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130418
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130418,
					"content": "Просто я... Я не смог посмотреть ему в глаза. Его страсть к приключениям такая настоящая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130419
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130419,
					"content": "Я просто старый обманщик, а этот парень - будущая звезда, полная стремлений... Я не могу допустить, чтобы он потерял веру в себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130421
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130420,
					"content": "Не обманщик! Те истории о приключениях Стэнли, они же ведь настоящие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130421,
					"content": "Истории... Приключения... Да какой от них толк теперь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130423
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130422,
					"content": "Честно говоря, мои воспоминания о приключениях, о Стэнли... Они становятся всё более размытыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130424
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130423,
					"content": "Это мой самый большой секрет... И самый большой страх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130425
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130424,
					"content": "Все эти годы я жил, чтобы рассказывать его историю. Но его личность и подробности жизни... Я их уже почти не помню, ха-ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130426,
					"content": "Всю жизнь он топил себя в чувстве вины...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130427,
					"content": "Всё, что осталось, - это его воображаемый друг...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130425,
					"content": "Зато одну вещь я не забуду никогда... Как он умер в Пепельном море, где ветер не смог унести его дух!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426,
						101130427
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130428,
					"content": "Да... Даже в его воспоминаниях настоящий Стэнли - это не тот живой и дышащий человек, которого он знал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130429
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130429,
					"content": "Вместо этого он создал картину покрытого шрамами воина... Который и следует за ним всю его жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130430
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130430,
					"content": "Я уже слишком стар... Я стараюсь не забывать, но всё равно старые образы ускользают от меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130431
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130431,
					"content": "Я правда бесполезен! Бесполезен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130432
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130432,
					"content": "Никто не заслуживает такой смерти... Никто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130433
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130433,
					"content": "Я... Я до сих пор не могу в это поверить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130434
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130434,
					"content": "Я благодарен всем вам... И благодарен святому Барбатосу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130435
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130435,
					"content": "Простите, мне нужно немного времени, чтобы успокоиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130436
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130436,
					"content": "Но я... Я буду в порядке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130437
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101130437,
					"content": "Хм, неплохо! Стэнли нашёл своё истинное «я», а Джек встал на свой собственный путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130438
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130438,
					"content": "Столько хороших новостей, за это надо выпить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130439
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130439,
					"content": "Значит, ты тоже не выйдешь из этой таверны, пока не напьёшься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130440
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130440,
					"content": "Ха-ха, конечно нет, здесь вино слишком дорогое. Но Джек пообещал мне раритетного винтажного вина в обмен на помощь, помните?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130441
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130441,
					"content": "Думаю, я схожу и напомню ему об этом. Встретимся на <color=#00E1FFFF>старом месте</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130442
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130443,
					"content": "Можно только догадываться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130444,
					"content": "Думаю, я знаю, где это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130445,
					"content": "Ладно, до встречи на <color=#00E1FFFF>старом месте</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130442,
					"content": "А? Что за старое место? Почему Паймон о нём не знает? Эй, бродяжка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130443,
						101130444,
						101130445
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130446,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1011305,
			"completionStepIds": [
				1011305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011305",
							"2"
						],
						"stepId": 1011305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130501,
					"content": "Наконец вы здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130502
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130502,
					"content": "Мы тебя еле нашли! В следующий раз говори яснее, где встречаемся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130503,
					"content": "Ну что, бродяжка, получил своё вино?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130504,
					"content": "Получил. Но Джек описывал его как раритетное и винтажное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130505
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130505,
					"content": "А на деле это оказалось полбутылки обычного сидра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130506
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130506,
					"content": "Ох, на меня нахлынули воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130507
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130507,
					"content": "Я ещё не принял свою форму, когда впервые увидел этот пейзаж.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130508
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130508,
					"content": "Какую форму?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130509
					]
				},
				{
					"id": 101130509,
					"content": "Это случилось 2600 лет назад, когда миром ещё не правили семеро Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130510
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130510,
					"content": "В то время древним Мондштадтом правил тиран, который закрыл свои границы страшным ураганом. Через него не могли пролететь даже птицы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130511
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130511,
					"content": "Древним Мондштадтом? Ах, это то место, где поселился Ужас Бури? Паймон помнит, ты рассказывал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130512,
					"content": "Да, сейчас это логово Ужаса Бури. Тирана, который правил из той башни, звали Декарабиан, бог бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130513
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130513,
					"content": "В те времена я был обычным ветерком среди тысяч ветров. Я не был никаким богом, и человеческой формы у меня не было...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130514
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130514,
					"content": "Я был всего лишь маленьким элементалем, жившим среди ветряных потоков. Я был нежным бризом, который приносил еле заметные перемены и семена надежды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130515
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130515,
					"content": "Маленьким элементалем? Без человеческой формы? Венти, ты выглядел не так, как сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130516
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130516,
					"content": "Да. История моей нынешней формы не сильно отличается от истории Стэнли... Я тоже принял форму друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130517
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130517,
					"content": "И...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130518
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130518,
					"content": "Что случилось с твоим другом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130519
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130519,
					"content": "(То же, что и с настоящим Стэнли...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130520
					]
				},
				{
					"id": 101130520,
					"content": "Скажи, Паймон, хочешь ли ты услышать следующую часть истории?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130521
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130521,
					"content": "Конечно! Не могу ждать! Рассказывай быстрее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130522,
						101130524
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130522,
					"content": "Паймон, собери нам пару яблок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130523
					]
				},
				{
					"id": 101130523,
					"content": "#Чего это ты вдруг захотел{F#а} яблок! Ты серьёзно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130526,
					"content": "#Ха-ха-ха, проголодал{F#ась}{M#ся}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130527
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130527,
					"content": "Ага.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130528
					]
				},
				{
					"id": 101130528,
					"content": "Аргх... Я тебя правда совсем не переношу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130529
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101130529,
					"content": "#Знаешь, иногда я поражаюсь тому, как{F#ая}{M#ой} ты умн{F#ая}{M#ый}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130530
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130530,
					"content": "Но, может быть, среди друзей и вправду необходимо понимание друг друга без слов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130531
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130531,
					"content": "Бодрящая выпивка, нежный ветерок... Такие мгновенья уносят меня назад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130532
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130532,
					"content": "К той песне, которую я впервые услышал от него...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130533
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101130533,
					"content": "Можно послушать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 101130524,
					"content": "Паймон, принеси нам рыбки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130525
					]
				},
				{
					"id": 101130525,
					"content": "А? Но ведь Венти рассказывает свою историю! Чего это вдруг тебе захотелось мяса?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}