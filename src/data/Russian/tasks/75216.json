				]
			},
			"dialogs": [
				{
					"id": 752190101,
					"content": "#Ой... Ты ведь {NICKNAME}! Стой, подожди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190102
					],
					"speakerTitle": "Хукиру"
				},
				{
					"id": 752190102,
					"content": "Тут у меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190103
					],
					"speakerTitle": "Хукиру"
				},
				{
					"id": 752190103,
					"content": "Что такое? Нужна помощь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752190104,
					"content": "Ха-ха, нет! Вам бандероль! Вот так совпадение, я как раз собирался вас искать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190105
					],
					"speakerTitle": "Хукиру"
				},
				{
					"id": 752190105,
					"content": "А вы тут как тут!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190106
					],
					"speakerTitle": "Хукиру"
				},
				{
					"id": 752190106,
					"content": "Мм? Кто нам прислал бандероль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752190107,
					"content": "Бандероль пришла издалека. Она долго добиралась до Гильдии искателей приключений, оттуда попала к курьерам Потомков Крон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190108
					],
					"speakerTitle": "Хукиру"
				},
				{
					"id": 752190108,
					"content": "Понимаете, в Натлане обстановка была не совсем обычная, торговые караваны давно не появлялись. Отправитель здесь не указан, но если судить по подписи... бандероль пришла из Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190109
					],
					"speakerTitle": "Хукиру"
				},
				{
					"id": 752190109,
					"content": "Видно, у вас в Фонтейне тоже полно друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190110,
						752190111
					],
					"speakerTitle": "Хукиру"
				},
				{
					"id": 752190110,
					"content": "Хорошо, я её забираю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190111,
					"content": "Отлично, давай сюда!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190112,
					"content": "Ох, слава Архонту, бандероль едва успела попасть мне в руки, а я уже нашёл получателей. Рабочий день начинается отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190113
					],
					"speakerTitle": "Хукиру"
				},
				{
					"id": 752190113,
					"content": "Ладно, мне сегодня ещё много посылок нужно доставить. Удачи вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190114
					],
					"speakerTitle": "Хукиру"
				},
				{
					"id": 752190114,
					"content": "Ага, и тебе тоже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752190115,
					"content": "Так, бандероль из Фонтейна... Совсем лёгенькая. Больше похожа на обычное письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752190116,
					"content": "Давай скорее посмотрим, что там!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752190117,
					"content": "Ой, это от Шарлотты! Фотография на память, которую мы сделали, когда уезжали из Фонтейна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752190118,
					"content": "Знаешь, фотография сделана совсем недавно, а кажется, что столько воды утекло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752190119,
					"content": "Хи-хи, надо её сохранить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}