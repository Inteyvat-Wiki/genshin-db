						3980914
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980914,
					"content": "Джинн ждёт вас в <color=#00E1FFFF>соборе</color>. Наверное, она хочет поговорить о Небесной лире, поэтому лучше поторопиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980908,
					"content": "Мы обязательно вернёмся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980905,
					"content": "Я буду скучать по ребятам из Ордо Фавониус.",
					"roleType": "TALK_ROLE_PLAYER",
