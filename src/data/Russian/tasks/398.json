					"Сайрус"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980401,
					"content": "Давайте, ребята, вперёд! Пришло время выручить родной Мондштадт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980402
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 3980402,
					"content": "Вперёд, искатели приключений! Мы не боимся смотреть опасности в лицо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980403
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 3980403,
					"content": "Наконец-то Гильдия искателей приключений может показать себя! Хватит снимать кошек с деревьев! Пришёл наш момент славы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980404
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 3980404,
					"content": "Молодёжь, спешите вступить в Гильдию искателей приключений! Поможем родному Мондштадту в трудный час вместе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980405
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 3980405,
					"content": "Не хочу расстраивать, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980406
					]
				},
				{
					"id": 3980406,
					"content": "А? Что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980407
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 3980407,
					"content": "Вы уже справились с драконом? Что я пропустил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980408
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 3980408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980409
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 3980409,
					"content": "Неужели Ужас Бури не дождался нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайрус"
				}
			]
		},
		{
			"id": 39807,
			"completionStepIds": [
				39807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
