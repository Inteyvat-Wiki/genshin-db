			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нимрод"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980301,
					"content": "Спасибо вам! Наконец-то мы можем оставить этот ужас позади.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 3980302,
					"content": "Из-за нападения дракона многие торговые пути были повреждены... Ладно, если закончится зерно и фрукты, но если вдруг не станет вина, то наступит конец света!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 3980303,
					"content": "Не могу представить и дня без алкоголя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 3980304,
					"content": "Эх... Поскорее бы они разобрались с караванами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нимрод"
				}
			]
		},
