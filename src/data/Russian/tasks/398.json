				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эмбер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980101,
					"content": "Ах, это вы! Наш почётный рыцарь вернулся с победой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980102
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980102,
					"content": "#Ха-ха! {NICKNAME} неплохо пров{M#ёл}{F#ела} время с Двалином!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3980103,
					"content": "Так вы вернулись вчера? Джинн вернулась в Мондштадт раньше вас. Она уже рассказала нам о твоих подвигах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980104
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980104,
					"content": "Эх... Когда же у меня появится возможность совершить что-нибудь такое же выдающееся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980105,
						3980108
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980105,
					"content": "Мы справились только благодаря тебе, Эмбер.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980106
					]
				},
				{
					"id": 3980106,
					"content": "Нет-нет! Всё вернулось на свои места благодаря именно вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980107
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980107,
					"content": "В мои обязанности скаута входило только сопровождение вас до города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980111,
					"content": "Да ну что вы, нам не трудно... Кстати, Эмбер! Ты всё это время ждала нас здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3980112,
					"content": "Да, моя текущая миссия не требует покидать город, но я не бездельничаю! Видите? Я помогаю восстанавливать город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980113
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980113,
					"content": "«Восстанавливать город»? А что тут произошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3980114,
					"content": "Да... Монстры воспользовались отсутствием Джинн и напали на город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980115
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980115,
					"content": "Я уже давно заметила, что хиличурлы собираются в группы и разбивают новые лагери вблизи от города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980116
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980116,
					"content": "Я помню! Во время нашей первой встречи мы помогли тебе зачистить один из них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3980117,
					"content": "Верно. Если бы мы не подготовились заранее, Мондштадт бы находился сейчас в полном хаосе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980118,
						3980121
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980118,
					"content": "Вот и славно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980119
					]
				},
				{
					"id": 3980119,
					"content": "Но с другой стороны, я заметила кое-какую странность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980120
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980120,
					"content": "Обычно хиличурлы не способны на такие организованные нападения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980123,
					"content": "Поэтому мне кажется, что за всем этим стояли маги Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980124
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980124,
					"content": "Ты думаешь, что они управляли хиличурлами? Если бы мы не освободили Двалина, они бы и его использовали в своих коварных целях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3980125,
					"content": "Именно! Теперь мне, как главному скауту, придётся вести наблюдение за орденом Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980126
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980126,
					"content": "#Ой, прости, пожалуйста! Ты долж{F#на}{M#ен} праздновать победу, а не слушать моё ворчание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980127
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980127,
					"content": "Точно! До того как мы влипли в это дело с Ужасом Бури, я обещала угостить вас медовым мясом с морковкой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980128
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980128,
					"content": "Теперь, когда всё закончилось, мы можем пойти отпраздновать! Что скажете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980129
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980129,
					"content": "Да! Пойдёмте есть! Паймон бы не забыла, даже если бы потеряла память!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3980130,
					"content": "Ха-ха! Я уже так давно не ела медовое мясо с морковкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980131
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980131,
					"content": "Подождите меня в <color=#00E1FFFF>«Хорошем охотнике»</color>. Я приду, как только закончу уборку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980121,
					"content": "Как они додумались до такого?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980122
					]
				},
				{
					"id": 3980122,
					"content": "Да, очень странно... Обычно хиличурлы не способны на такие организованные нападения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980108,
					"content": "Надеюсь, такая возможность будет появляться нечасто...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980109
					]
				},
				{
					"id": 3980109,
					"content": "#Да, ты прав{F#а}... Нужно ценить спокойное время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980110
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980110,
					"content": "Благодаря вам у нас снова настал мир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Эмбер"
				}
			]
		},
		{
