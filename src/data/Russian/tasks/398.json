			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сара",
					"Кэйа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980701,
					"content": "Здравствуйте! Я могу принять ваш заказ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980702
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 3980702,
					"content": "Вот так теперь мы приветствуем близких друзей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980703,
						3980705
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980703,
					"content": "#{M#Обознался}{F#Прости, я тебя не узнала}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980704
					]
				},
				{
					"id": 3980704,
					"content": "Ха-ха-ха! Я смотрю, победа над Ужасом Бури не только сделала тебя сильнее, но и научила рыцарскому юмору!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980707,
					"content": "Для меня большая честь находиться в присутствии заслуженных героев Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980708
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980708,
					"content": "Узнаю сладкие речи Кэйи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3980709,
					"content": "Ха-ха! Мои слова не могут быть более искренними, дорогая Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980710,
						3980714
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980710,
					"content": "Что ты тут делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980711
					]
				},
				{
					"id": 3980711,
					"content": "Просто нашёл тихое и уютное место, чтобы подумать кое о чём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980712
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980712,
					"content": "В то время как другие рыцари помогают восстанавливать город...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980713
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3980713,
					"content": "Я бы лучше пошёл разбирать завалы... Думать не так легко, как кажется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980717,
					"content": "Разобраться с чем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980718
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3980718,
					"content": "Орден Бездны что-то замышляет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980719
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980719,
					"content": "Действующий магистр Ордо Фавониус ушла воевать с Ужасом Бури, при этом оставив город совсем без защиты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980720
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980720,
					"content": "Неужели на месте ордена Бездны вы бы доверили нападение на город обычным хиличурлам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980721,
						3980722
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980721,
					"content": "Ты прав, это весьма странно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980723,
					"content": "Я решил понаблюдать за ними какое-то время. Изучить их стратегию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980724
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980724,
					"content": "Пока вы сражались с Ужасом Бури в его логове, у городских ворот Мондштадта послышался боевой клич хиличурлов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980725
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980725,
					"content": "Именно тогда я заметил подозрительную активность внутри города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980726
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980726,
					"content": "Внутри города?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980727
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3980727,
					"content": "Да. Пока оставшиеся рыцари обороняли город снаружи, этим умникам удалось проникнуть внутрь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980728
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980728,
					"content": "Я остался в городе и начал их преследовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980729
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980729,
					"content": "Мне удалось... «убедить» его поделиться этой информацией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980730
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980730,
					"content": "Выяснил я вот что... Кто-то дёргает за ниточки ордена Бездны из-за кулис.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980731
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980731,
					"content": "За ниточки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980732
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3980732,
					"content": "Именно. Этот «кто-то» планировал использовать Двалина как орудие войны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980733
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980733,
					"content": "А какими такими уловками тебе удалось выведать столько всего интересного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980734
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3980734,
					"content": "Хе-хе... Считайте, что здесь помог мой дар красноречия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980735
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980735,
					"content": "#Члены ордена Бездны обращаются к не{M#й}{F#му} «Ваше высочество».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980736
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980736,
					"content": "«Ваше высочество»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980737
					]
				},
				{
					"id": 3980737,
					"content": "Думаю, я рассказал вам достаточно на сегодня. Кажется, к нам вот-вот присоединится Эмбер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980738
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980738,
					"content": "Она обижается на то, что я не остался защищать с ней городские ворота... Я лучше пойду. Не вешайте нос, ребята!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980739
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980739,
					"content": "Ах, этот Кэйа! Снова убежал! Нечистая совесть покоя не даёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980740,
						3980742
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980740,
					"content": "По правде говоря, он тоже не дурака валяет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980741
					]
				},
				{
					"id": 3980741,
					"content": "Да что вы говорите? А вы уверены, что он снова не охмурил вас своим обаянием?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980744,
					"content": "Ладно, пусть идёт себе... Я так устала, давайте лучше закажем чего-нибудь поесть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980745
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980745,
					"content": "Сара, дорогая, принеси нам, пожалуйста, медовое мясо с морковкой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980742,
					"content": "Да! Вот негодяй!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980743
					]
				},
				{
					"id": 3980743,
					"content": "И не говори! Какой нехороший пример он подаёт своим подчинённым!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980722,
					"content": "Что же происходит на самом деле?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980714,
					"content": "Что ты опять замышляешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980715
					]
				},
				{
					"id": 3980715,
					"content": "Я? Я ничего. Но кое-кто другой что-то замышляет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980716
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980716,
					"content": "Поэтому я хочу разобраться с этим в тишине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3980705,
					"content": "Ах, мой дружище Кэйа!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980706
					]
				},
				{
					"id": 3980706,
					"content": "О, мои молитвы были услышаны! Во всём виновата моя харизма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Кэйа"
				}
			]
		},
		{
			"id": 39809,
			"completionStepIds": [
				39809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39809",
							"2"
						],
						"stepId": 39809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эмбер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980901,
					"content": "Вот мы и разобрались с Ужасом Бури. Чем планируете заняться теперь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980902
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980902,
					"content": "#Наверное, мы покинем Мондштадт и продолжим поиски {M#сестры нашего героя}{F#брата нашей героини}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980903
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3980903,
					"content": "Вот как... Неужели нам придётся попрощаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980904,
						3980905
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980904,
					"content": "Я буду скучать по Мондштадту.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				},
				{
					"id": 3980906,
					"content": "Ничего страшного! Пока дует ветер, мы будем помнить вас как почётных героев и спасителей Мондштадта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980907,
						3980908
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980907,
					"content": "Да направит нас ветер!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980909,
					"content": "Да! В Мондштадте вам всегда будут рады!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980910
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980910,
					"content": "Эй, давайте быстрее есть, а то мясо остынет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980911
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3980911,
					"content": "Ммм, как вкусно! Неудивительно, что Эмбер столько нахваливала это блюдо.",
