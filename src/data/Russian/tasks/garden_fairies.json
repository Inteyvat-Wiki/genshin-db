			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аранишат",
					"Аралила"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730410601,
					"content": "Эй! Ты чего?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410602
					],
					"speakerTitle": "Аранишат"
				},
				{
					"id": 730410602,
					"content": "Аранишата тоже быстро нашли, так что мы оба слабаки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410603
					],
					"speakerTitle": "Аралила"
				},
				{
					"id": 730410603,
					"content": "#У-у-у... оба слабаки... и только {F#золотая}{M#золотой} нара не {F#слабачка}{M#слабак}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410604
					],
					"speakerTitle": "Аранишат"
				},
				{
					"id": 730410604,
					"content": "Нельзя, чтобы и дальше так продолжалось! Нужно укрепить араракалари. И будет у нас сильный-сильный плод. Такой, что даже нара не найдёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410605,
						730410607
					],
					"speakerTitle": "Аралила"
				},
				{
					"id": 730410605,
					"content": "Но это не совсем верный метод...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410606
					]
				},
				{
					"id": 730410606,
					"content": "#Что, нара {F#испугалась}{M#испугался}? Больше играть не будет? В играх главное не победа, а участие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Аралила"
				},
				{
					"id": 730410609,
					"content": "#Несмотря на проигрыш, мне понравилось играть. {F#Золотая}{M#Золотой} нара и правда {F#хорошая}{M#хороший} нара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410610
					],
					"speakerTitle": "Аралила"
				},
				{
					"id": 730410610,
					"content": "#Нара нас победил{F#а}. Круто! Вот, держи цветочек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410611
					],
					"speakerTitle": "Аранишат"
				},
				{
					"id": 730410611,
					"content": "#Спасибо тебе, нара! Ты {F#хорошая подруга}{M#хороший друг}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аралила"
				},
				{
					"id": 730410607,
					"content": "У вас всё получится!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410608
					]
				},
				{
					"id": 730410608,
					"content": "Угу! В следующий раз я обязательно выиграю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Аранишат"
				}
			]
		}
	]
