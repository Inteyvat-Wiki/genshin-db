			"dialogs": [
				{
					"id": 730410101,
					"content": "#О, это же {M#золотой}{F#золотая} нара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410102
					],
					"speakerTitle": "Аранишат"
				},
				{
					"id": 730410102,
					"content": "Поиграй с Аралилой, нара! А Аранишат слабак, с ним не играй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410103
					],
					"speakerTitle": "Аралила"
				},
				{
					"id": 730410103,
					"content": "Ха, а ничего, что в прошлый раз Аранишат победил Аралилу! Аралила ещё слабее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410104
					],
					"speakerTitle": "Аранишат"
				},
				{
					"id": 730410104,
					"content": "#Ладно, хватит уже спорить. Хорошо, что здесь {M#золотой}{F#золотая} нара. Поиграем с {M#ним}{F#ней} и посмотрим, кто слабее всех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410105
					],
					"speakerTitle": "Аралила"
				},
				{
					"id": 730410105,
					"content": "Давай посмотрим. Я ничего не боюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410106
					],
					"speakerTitle": "Аранишат"
				},
				{
					"id": 730410106,
					"content": "Сначала прячется Аралила, а нара будет искать. Потом спрячется Аранишат, а нара будет искать. Кого найдут первым, тот проиграл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410107
					],
					"speakerTitle": "Аралила"
				},
				{
					"id": 730410107,
					"content": "#Нара, хочешь поиграть? Скажи, как будешь готов{F#а}, и начнём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аралила"
				}
			]
		},
