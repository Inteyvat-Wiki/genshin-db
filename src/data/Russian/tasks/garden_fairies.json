					"Аралила"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730410501,
					"content": "Ха-ха-ха-ха-ха-ха! Я сильнее Аралилы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410502
					],
					"speakerTitle": "Аранишат"
				},
				{
					"id": 730410502,
					"content": "#{F#Золотая}{M#Золотой} нара молодец! Как быстро ты меня {F#нашла}{M#нашёл}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410503
					],
					"speakerTitle": "Аралила"
				},
				{
					"id": 730410503,
					"content": "#{F#Золотая}{M#Золотой} нара, конечно, молодец! Но Аранишат кажется, дело скорее в том, Аралила - тот ещё слабак. Меня-то так быстро не нашли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранишат"
				}
			]
		},
		{
			"id": 7304106,
			"completionStepIds": [
				7304104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
