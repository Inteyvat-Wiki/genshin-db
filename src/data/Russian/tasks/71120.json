			"dialogs": [
				{
					"id": 711200101,
					"content": "Эй, убирайтесь отсюда! Это земля хозяина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200102
					],
					"speakerTitle": "Сидящий Тигр"
				},
				{
					"id": 711200102,
					"content": "Как грубо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200103,
						711200106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711200103,
					"content": "Вы кто такие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200104
					]
				},
				{
					"id": 711200104,
					"content": "#Зависит от того, кто ты {F#такая}{M#такой}. Всё зависит от тебя. Если будешь {F#вежливой}{M#вежливым}, мы подружимся! А будешь шуметь - пеняй на себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200105
					],
					"speakerTitle": "Свернувшийся Змей"
				},
				{
					"id": 711200105,
					"content": "Будь умницей и убирайся восвояси!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Сидящий Тигр"
				},
				{
					"id": 711200109,
					"content": "Вы очень подозрительные!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711200110,
					"content": "Подозрительные? Ох... Мы привратники. А то, как вы суёте свой нос куда не следует, вызывает ещё большее подозрение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200111
					],
					"speakerTitle": "Свернувшийся Змей"
				},
				{
					"id": 711200111,
					"content": "Ладно, хватит препираться. Оставьте нас в покое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сидящий Тигр"
				},
				{
					"id": 711200106,
					"content": "Что это за хозяин такой, которому принадлежит эта земля?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200107
					]
				},
				{
					"id": 711200107,
					"content": "Что за хозяин? Ты от страха помрёшь, лишь услышав его имя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200108
					],
					"speakerTitle": "Сидящий Тигр"
				},
				{
					"id": 711200108,
					"content": "Это для твоего же блага! Лучше не спрашивай о том, чего тебе знать не положено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Свернувшийся Змей"
				}
			]
		},
