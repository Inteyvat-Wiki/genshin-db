			"dialogs": [
				{
					"id": 711209101,
					"content": "Опять вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "Сидящий Тигр"
				},
				{
					"id": 711209102,
					"content": "Давайте обойдёмся без лишних вопросов! Сделайте вид, что не видели нас, а мы сделаем вид, что не видели вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "Свернувшийся Змей"
				},
				{
					"id": 711209103,
					"content": "Что вы здесь охраняете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "Угадай, за что нам платят?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "Свернувшийся Змей"
				},
				{
					"id": 711209105,
					"content": "И за что же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711209106,
					"content": "Кхе-кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "Свернувшийся Змей"
				},
				{
					"id": 711209107,
					"content": "(Я скажу только тебе, но ты не должна говорить никому другому... Подойди ближе. Я скажу тебе...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "Свернувшийся Змей"
				},
				{
					"id": 711209108,
					"content": "(Паймон внимательно слушает!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711209109,
					"content": "За то, чтобы выпроваживать бездельников вроде вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "Свернувшийся Змей"
				},
				{
					"id": 711209110,
					"content": "А-а-а!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711209111,
					"content": "Из пещеры доносятся странные звуки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "Простите, это я нечаянно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "Сидящий Тигр"
				},
				{
					"id": 711209113,
					"content": "Да, это всё он!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "Свернувшийся Змей"
				},
				{
					"id": 711209114,
					"content": "А, всё в порядке, тогда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
