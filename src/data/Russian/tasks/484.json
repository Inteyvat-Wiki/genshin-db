					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841107
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4841107,
					"content": "Скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				}
			]
		},
		{
