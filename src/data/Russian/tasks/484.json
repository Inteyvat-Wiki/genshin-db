			"trigger": {
				"objectNames": [
					"Эмбер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4843101,
					"content": "Хвала Архонтам, рыцари спасли меня! Теперь хиличурлы не посмеют напасть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843102
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 4843102,
					"content": "Что произошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843103
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4843103,
					"content": "Это невероятно, но... Хиличурлы напали на наш караван. К счастью, мы оказались быстрее них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843104
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 4843104,
					"content": "Хиличурлы? Мне казалось, рыцари Ордо Фавониус уничтожили все лагеря хиличурлов в округе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843105
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4843105,
					"content": "Здесь неподалёку есть маленький лагерь. Я стараюсь его избегать, когда прокладываю маршрут каравана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843106
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 4843106,
					"content": "Но сегодня этот сумасшедший упал прямо с неба! Он грохнулся посреди их лагеря!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843107
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 4843107,
					"content": "Хм... Похоже на...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4843108,
					"content": "Хиличурлы были в бешенстве! Они побежали за этим странным парнем, но не смогли его догнать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843109
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 4843109,
					"content": "Мне удалось сбежать, но хиличурлы разнесли мой фургон в щепки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843110
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 4843110,
					"content": "Странный парень? Что в нём было странного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843111
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4843111,
					"content": "Он что-то нёс. Что-то очень тяжёлое, из-за этого он не мог лететь прямо и в конце концов упал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843112
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 4843112,
					"content": "Таких, как он, нельзя пускать в небо. Даже дурак понимает, что не надо летать с тяжёлыми предметами. У него надо отобрать лётную лицензию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843113
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 4843113,
					"content": "Тяжёлый предмет... Артефакт! Это Птеродактиль!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843114
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4843114,
					"content": "Ты видел в какую сторону он пошёл?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843115
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4843115,
					"content": "Да... Кажется, он побежал туда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843116
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 4843116,
					"content": "#Мы уже близко! {NICKNAME}, в погоню!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843117
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4843117,
					"content": "Ах, да! Не переживай, рыцари помогут тебе разобраться с оставшимися хиличурлами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				}
			]
		},
