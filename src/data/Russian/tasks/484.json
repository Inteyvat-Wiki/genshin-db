				"objectNames": [
					"Эмбер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4842201,
					"content": "Куда мы пришли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4842202,
					"content": "Здесь следы заканчиваются.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4842203
					]
				},
				{
					"id": 4842203,
					"content": "Должно быть, элементальная сила артефакта иссякла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842204
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4842204,
					"content": "Птеродактиль догадался, что артефакт может выдать его местоположение, и послал своих приспешников задержать нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842205
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4842205,
					"content": "Так он смог дождаться, пока артефакт перестанет оставлять следы, и скрылся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842206
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4842206,
					"content": "Ему не уйти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				}
			]
		},
		{
			"id": 48435,
			"completionStepIds": [
				48432
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
