			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аракара"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680101,
					"content": "Привет! Здесь земля отличается от других мест. Что в ней особенного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680103
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680103,
					"content": "Эй, чего он не отвечает? Не расслышал, что ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680104,
						730680106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680104,
					"content": "П-привет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680105
					]
				},
				{
					"id": 730680105,
					"content": "А? Н-нара?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680108,
					"content": "#Как такое может быть? Откуда {F#взялась}{M#взялся} нара в Ванаране? Хотите поймать меня, чтобы зажарить? Аракара не такой вкусный, как грибы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680109
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680109,
					"content": "Мы не способны на такие ужасные вещи! Ведь мы же верные друзья аранар, и все об этом знают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680110,
						730680112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680110,
					"content": "Такое никто не говорил...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680111
					]
				},
				{
					"id": 730680111,
					"content": "Ох, может, такое никто и не говорил, но они думают про нас так. Все и так знают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680114,
					"content": "#Ну, меня зовут Паймон, а {M#этот золотой}{F#эта золотая} - {NICKNAME}. {M#Он хороший}{F#Она хорошая} нара!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680115,
					"content": "А ты Аракара, да? Что ты тут делаешь один?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680116,
					"content": "С какой целью Паймон спрашивает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680117
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680117,
					"content": "Ну, Паймон просто интересуется! Это уже на уровне инстинкта. Словно гонишься за ящерицей или пытаешься поймать бабочку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680118,
					"content": "Паймон - кошка, которая умеет летать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680119
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680119,
					"content": "НЕТ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680120,
					"content": "Если это какой-то секрет аранар, о котором нельзя рассказывать, то можешь не отвечать. Мы умеем быть тактичными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680121,
					"content": "Но всё равно как-то странно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680122
					]
				},
				{
					"id": 730680122,
					"content": "Да...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680123,
					"content": "Секрет? У Аракары нет секретов. Аракара ничего не делает, Аракара просто ждёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680124
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680124,
					"content": "Ждёт? Ты имеешь в виду других аранар?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680125,
					"content": "Аранакула отправился вместе с Арапанду в землю Ашаван, но я не знаю, когда они вернутся. С машиной Варуны не всё в порядке, поэтому сейчас не время заботиться о питомнике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680126
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680126,
					"content": "#Нара {NICKNAME} любит земледелие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680127,
						730680129
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680127,
					"content": "Заниматься земледелием нелегко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680128
					]
				},
				{
					"id": 730680128,
					"content": "Заниматься земледелием в валуке нелегко, а вот в ване - совсем другое дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680131,
					"content": "А почему ты не спрашиваешь Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680132,
					"content": "Паймон не бегает за бабочками, ловит ящериц. Похоже, ей не нравится возиться с землёй, поэтому и не спросил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680133
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680133,
					"content": "Очень хочется поспорить, но Паймон больше волнует результат, чем процесс! Что посажено в этом питомнике? Что-то съедобное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680134,
					"content": "Съедобное и полезное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680135
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680135,
					"content": "Но если сейчас Паймон голодна, то не иди в питомник за едой, а съешь грибы. В ване так много грибов. Их надо съесть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680136
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680136,
					"content": "Эх, мы ничего не можем начать, поскольку Аранакула ещё не вернулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680137
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680137,
					"content": "#Хорошо, придётся дождаться Аранакулу. Пошли, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680129,
					"content": "Я больше всего люблю пахать землю!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680130
					]
				},
				{
					"id": 730680130,
					"content": "Отлично! Аракара тоже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730680112,
					"content": "Паймон права!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680113
					]
				},
				{
					"id": 730680113,
					"content": "Хи-хи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730680106,
					"content": "Кушать подано!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680107
					]
				},
				{
					"id": 730680107,
					"content": "Грибы вкусные! Нара? Вкусно? Ах да, нара же не ест их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "Аракара"
				}
			]
		},
		{
			"id": 7306802,
