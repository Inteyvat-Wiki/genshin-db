	"talks": [
		{
			"id": 7306801,
			"completionStepIds": [
				7306801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306801",
							"2"
						],
						"stepId": 7306801,
