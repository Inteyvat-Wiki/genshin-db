				{
					"id": 700010601,
					"content": "Как обстоят дела с Похитителями сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010602
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010602,
					"content": "Они больше нас не побеспокоят.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010603
					]
				},
				{
					"id": 700010603,
					"content": "#Ты не подв{F#ела}{M#ёл} нас, почётный рыцарь. Отличная работа. А как ты заговаривал{F#а} зубы этому воришке... Неудивительно, что «тот господин» так высоко тебя ценит.",
