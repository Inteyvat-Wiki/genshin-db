				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Подозрительный горожанин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010301,
					"content": "Какое оживлённое место! Замечательно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010302
					],
					"speakerTitle": "Подозрительный горожанин"
				},
				{
					"id": 700010302,
					"content": "Когда ветер разносит лепестки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010303
					]
				},
				{
					"id": 700010303,
					"content": "Хм? Ой, да-да... Людям лучше разойтись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010304
					],
					"speakerTitle": "Подозрительный горожанин"
				},
				{
					"id": 700010304,
					"content": "#Так ты од{F#на}{M#ин} из нас. Ты как раз вовремя. Я приметил вон там беспечную влюблённую парочку. Пойдём, стащим немного моры, что скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010305
					],
					"speakerTitle": "Подозрительный горожанин"
				},
				{
					"id": 700010305,
					"content": "Отвлеки их, а я порежу кошельки. Как только всё сделаем - вернёмся в долину Ветров и встретимся с остальными. Интересно, как у них там дела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010306
					],
					"speakerTitle": "Подозрительный горожанин"
				},
				{
					"id": 700010306,
					"content": "Конечно. Только давай сначала прогуляемся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010307
					]
				},
				{
					"id": 700010307,
					"content": "Чего?! Постой, ты ж не Похититель сокровищ. А кто ты тогда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010308
					],
					"speakerTitle": "Подозрительный горожанин"
				},
				{
					"id": 700010308,
					"content": "Просто дружелюбный сосед рыцарь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010309
					]
				},
				{
					"id": 700010309,
					"content": "Пойман с поличным, миссия выполнена. Но Паймон интересно, как они так быстро здесь появились?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700010310,
					"content": "Давай не будем сейчас об этом беспокоиться. Он ведь сказал, что хочет встретиться со своими подельниками в долине Ветров? Пойдём посмотрим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7000104,
			"completionStepIds": [
				7000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000106",
							"2"
						],
						"stepId": 7000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нервный горожанин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010401,
					"content": "А? Чего надо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010402
					],
					"speakerTitle": "Нервный горожанин"
				},
				{
					"id": 700010402,
					"content": "Ветряные цветы парят в воздухе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010403
					]
				},
				{
					"id": 700010403,
					"content": "Лепестки? Какие лепестки? Разве не семена одуванчика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010404
					],
					"speakerTitle": "Нервный горожанин"
				},
				{
					"id": 700010404,
					"content": "Ну и что с того? У меня вообще всё хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010405
					],
					"speakerTitle": "Нервный горожанин"
				},
				{
					"id": 700010405,
					"content": "Извините за беспокойство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700010406,
					"content": "Похоже, это был обычный горожанин. Давай спросим кого-нибудь другого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7000105,
			"completionStepIds": [
				7000107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000107",
							"2"
						],
						"stepId": 7000107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Расстроенный горожанин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010501,
					"content": "Ох, дай же мне ещё один шанс...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010502
					],
					"speakerTitle": "Расстроенный горожанин"
				},
				{
					"id": 700010502,
					"content": "А? Что вам нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010503
					],
					"speakerTitle": "Расстроенный горожанин"
				},
				{
					"id": 700010503,
					"content": "Когда ветер разносит лепестки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010504
					]
				},
				{
					"id": 700010504,
					"content": "Да-да, лепестки цветов, что люди приносят Анемо Архонту. Я знаю, я должен бы наслаждаться праздником...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010505
					],
					"speakerTitle": "Расстроенный горожанин"
				},
				{
					"id": 700010505,
					"content": "И правда ведь. Почему я должен отчаиваться только потому, что меня отвергли? Праздник ещё не закончился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010506
					],
					"speakerTitle": "Расстроенный горожанин"
				},
				{
					"id": 700010506,
					"content": "Спасибо за поддержку, я возьму себя в руки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010507
					],
					"speakerTitle": "Расстроенный горожанин"
				},
				{
					"id": 700010507,
					"content": "Похоже, он нас неправильно понял. Ну, по крайней мере, он не вызывает подозрений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7000106,
			"completionStepIds": [
				7000111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
