	"talks": [
		{
			"id": 7000102,
			"completionStepIds": [
				7000102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000102",
							"2"
						],
						"stepId": 7000102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вэл"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010201,
					"content": "#О, путешественни{F#ца}{M#к}! Вот мы и встретились вновь. Как тебе праздничная атмосфера в городе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010202
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010202,
					"content": "Очень весело!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010203
					]
				},
				{
					"id": 700010203,
					"content": "Здорово, что тебе нравится. Не хотелось бы портить твоё праздничное настроение, но могу ли я попросить тебя кое о чём? Это тоже имеет отношение к празднику...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010204
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010204,
					"content": "Точнее, «тому господину» снова понадобилась твоя помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010205
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010205,
					"content": "#Я думал{F#а}, что во время Праздника ветряных цветов не принято давать поручения.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010206
					]
				},
				{
					"id": 700010206,
					"content": "Ох, не волнуйся. Эта просьба не связана с правилами праздника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010207
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010207,
					"content": "#Как ты мог{F#ла} заметить, Праздник ветряных цветов - очень оживлённое время. Тут и там кипит бурная деятельность, жители наслаждаются праздничной атмосферой. А рыцари Ордо Фавониус слишком заняты поддержанием порядка и могут многое упустить из виду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010208
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010208,
					"content": "Беззаботная толпа, переутомившиеся рыцари... Конечно, это даёт шанс Похитителям сокровищ сделать своё дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010209
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010209,
					"content": "По данным «того господина», Похитители сокровищ уже действуют в городе. Они притворяются праздными зеваками, гуляют по магазинам, но на самом деле планируют преступные махинации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010210
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010210,
					"content": "Если рыцари начнут полномасштабную операцию, это только вспугнёт Похитителей сокровищ и нарушит праздничное настроение горожан. Однако просто так мы их оставить не можем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010211
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010211,
					"content": "И поэтому ты решила обратиться ко мне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010212
					]
				},
				{
					"id": 700010212,
					"content": "Конечно! Да и «тот господин» попросил меня связаться именно с тобой. Он сказал, что ты больше всего подойдёшь для этой работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010213
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010213,
					"content": "Теперь давай перейдём к сути дела. Согласно собранным мною данным, все пробравшиеся в город Похитители сокровищ имеют при себе особую <color=#00E1FFFF>сумку</color> и используют специальный <color=#00E1FFFF>пароль</color>, чтобы узнавать друг друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010214
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010214,
					"content": "<color=#00E1FFFF>«Ветряные цветы парят в воздухе, путники любуются»</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010215,
						700010216
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010215,
					"content": "Легко запомнить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				},
				{
					"id": 700010217,
					"content": "Не ошибись с паролем, и тогда тебя примут за своего. Если получится, попробуй узнать о местоположении их лагеря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010218
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010218,
					"content": "Не забудь расправиться с ними, как только получишь всю нужную информацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010219
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010219,
					"content": "А рыцари не могут помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010220
					]
				},
				{
					"id": 700010220,
					"content": "Они выбиваются из сил, пытаясь поддержать порядок во время праздника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010221
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010221,
					"content": "В такие моменты долгом граждан становится... взять некоторые обязанности на себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010222
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010222,
					"content": "Мы рассчитываем на тебя, почётный рыцарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				},
				{
					"id": 700010216,
					"content": "Это в их духе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				}
			]
		},
		{
			"id": 7000103,
			"completionStepIds": [
				7000103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
