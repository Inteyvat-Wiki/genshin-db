				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мозе"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220101,
					"content": "Будь настороже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220102,
						742220106,
						742220109,
						742220116
					],
					"speakerTitle": "Мозе"
				},
				{
					"id": 742220102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220103
					]
				},
				{
					"id": 742220103,
					"content": "Я? Как видишь, я занят борьбой с варварской угрозой! Они участили свои нападения. Возможно, даже заслали шпионов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220104
					],
					"speakerTitle": "Мозе"
				},
				{
					"id": 742220104,
					"content": "Ситуация серьёзная! До прибытия подкрепления нужно быть особенно внимательными!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220105
					],
					"speakerTitle": "Мозе"
				},
				{
					"id": 742220105,
					"content": "Если будут вопросы, обращайся к моему адъютанту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мозе"
				},
				{
					"id": 742220106,
					"content": "Ребёнок здесь совсем один...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220107
					]
				},
				{
					"id": 742220107,
					"content": "Что? Ребёнок? Откуда здесь ребёнок? Не может быть, чтобы какой-то новобранец снова нарушил приказ и привёл семью в лагерь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220108
					],
					"speakerTitle": "Мозе"
				},
				{
					"id": 742220108,
					"content": "Эх... Доминус Кассиодор слишком мягок с новичками. Тридцать лет назад за такое уже бы наказали плетью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мозе"
				},
				{
					"id": 742220109,
					"content": "Ещё что-нибудь необычное?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220110
					]
				},
				{
					"id": 742220110,
					"content": "Пока нет. Но варвары подобны коварным хищникам, всегда атакуют, когда меньше всего ждёшь. Их тактика - застать врасплох.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220111
					],
					"speakerTitle": "Мозе"
				},
				{
					"id": 742220111,
					"content": "Они готовы на всё, чтобы проникнуть в наши города и заполучить секреты. Малейшая небрежность может привести к катастрофе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220112
					],
					"speakerTitle": "Мозе"
				},
				{
					"id": 742220112,
					"content": "Эх... Тридцать лет назад, когда я сопровождал доминуса Боэция в походе на север, они были лишь группкой примитивных дикарей, не ведавших коварства. Интересно, где они этому научились?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220113
					],
					"speakerTitle": "Мозе"
				},
				{
					"id": 742220113,
					"content": "Тридцать лет назад... Твои родители тогда ещё не родились...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220114
					]
				},
				{
					"id": 742220114,
					"content": "А? Что ты говоришь? С возрастом мой слух уже не тот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220115
					],
					"speakerTitle": "Мозе"
				},
				{
					"id": 742220115,
					"content": "Да, время не щадит никого... Когда мы покоряли Бетурию, я мог слышать гонги варваров на расстоянии нескольких километров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мозе"
				},
				{
					"id": 742220116,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220117
					]
				},
				{
					"id": 742220117,
					"content": "#{M#Уважаемый гражданин}{F#Уважаемая гражданка}, если заметишь кого-то подозрительного, сразу сообщи мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мозе"
				}
			]
		},
		{
			"id": 7422202,
			"completionStepIds": [
				7422202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422202",
							"2"
						],
						"stepId": 7422202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джованни"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220201,
					"content": "Ах, когда же эта война закончится?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220202
					],
					"speakerTitle": "Джованни"
				},
				{
					"id": 742220202,
					"content": "Что ты делаешь на крыше?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220203
					]
				},
				{
					"id": 742220203,
					"content": "#Хм? Я просматриваю окрестности на предмет подозрительной активности варваров, разумеется! Недавно... Погоди-ка, как ты {F#забралась}{M#забрался} на дозорную башню, {M#уважаемый гражданин}{F#уважаемая гражданка}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220204
					],
					"speakerTitle": "Джованни"
				},
				{
					"id": 742220204,
					"content": "#Я {F#первая спросила}{M#первый спросил}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220205
					]
				},
				{
					"id": 742220205,
					"content": "Ох, ладно, неважно. Трибун Меттий сообщает, что нападение варваров продолжается. Последние новости говорят о том, что они могли заслать к нам шпионов. Мы должны быть начеку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220206
					],
					"speakerTitle": "Джованни"
				},
				{
					"id": 742220206,
					"content": "Чем этих громил может заинтересовать наш маленький отдалённый городок? Причём настолько, что они заслали шпионов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220207
					],
					"speakerTitle": "Джованни"
				},
				{
					"id": 742220207,
					"content": "Мясо есть мясо, какой бы маленькой ни была порция.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220208
					]
				},
				{
					"id": 742220208,
					"content": "#Ах, {M#уважаемый гражданин}{F#уважаемая гражданка}, ты прав{F#а}! Нельзя падать духом, я должен нести службу. Хм... Судя по твоим словам, у тебя есть опыт в таких делах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220209
					],
					"speakerTitle": "Джованни"
				},
				{
					"id": 742220209,
					"content": "В таком случае, могу я попросить тебя осмотреть окрестности? Если варвары проявляли активность, они должны были оставить какие-нибудь следы. Например, деревянные мечи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220210
					],
					"speakerTitle": "Джованни"
				},
				{
					"id": 742220210,
					"content": "Эм... Как у детей, которые играют в войнушку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220211
					]
				},
				{
					"id": 742220211,
					"content": "Они же варвары. Что удивительного в том, что они сражаются палками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220212
					],
					"speakerTitle": "Джованни"
				},
				{
					"id": 742220212,
					"content": "В общем, я рассчитываю на тебя. Если что-нибудь обнаружишь, доложи мне. Считайте это своим почётным долгом ремурийца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джованни"
				}
			]
		},
		{
			"id": 7422207,
