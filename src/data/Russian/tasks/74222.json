				"points": []
			},
			"dialogs": [
				{
					"id": 742220701,
					"content": "#Ты {F#нашла}{M#нашёл} что-нибудь, {M#уважаемый гражданин}{F#уважаемая гражданка}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220702,
						742220703
					],
					"speakerTitle": "Джованни"
				},
				{
					"id": 742220702,
					"content": "#Я {F#нашла}{M#нашёл} кое-что...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742220703,
					"content": "Ничего.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220704
					]
				},
				{
					"id": 742220704,
					"content": "#Будь {F#осторожна}{M#осторожен}. Если что-то случится, сообщи мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джованни"
				}
			]
		},
		{
			"id": 7422208,
			"completionStepIds": [
				7422208,
				7422209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422208",
							"2"
						],
						"stepId": 7422208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джованни"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220801,
					"content": "Подумать только... Ошибки быть не может. Это один из сигнальных шестов варваров, с помощью которых они передают свои мерзкие послания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220802,
						742220803
					],
					"speakerTitle": "Джованни"
				},
				{
					"id": 742220802,
					"content": "Что, правда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				},
				{
					"id": 742220804,
					"content": "Не могу поверить, что их шпионы проникли в наши ряды. Похоже, опасения трибуна Меттия были небезосновательны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220805
					],
					"speakerTitle": "Джованни"
				},
				{
					"id": 742220805,
					"content": "Нужно выполнить свой долг и доложить ему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220806
					],
					"speakerTitle": "Джованни"
				},
				{
					"id": 742220806,
					"content": "#Благодарю тебя, {M#уважаемый гражданин}{F#уважаемая гражданка}. Если бы не ты, наша оборона могла бы рухнуть задолго до прихода полчищ варваров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220807
					],
					"speakerTitle": "Джованни"
				},
				{
					"id": 742220807,
					"content": "Я обязательно упомяну о твоём вкладе в своём отчёте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джованни"
				},
				{
					"id": 742220803,
					"content": "Только что ты говорил, что это деревянный меч...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				}
			]
		}
	]
}