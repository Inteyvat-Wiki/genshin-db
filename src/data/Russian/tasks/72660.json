			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каябуки Иккэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600101,
					"content": "#Эй, чужезем{F#ка}{M#ец}! Интересуешься сражениями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600102,
						726600104
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600102,
					"content": "#Я участвовал{F#а} уже в сотнях битв.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600103
					]
				},
				{
					"id": 726600103,
					"content": "А, замечательно! Значит, я не ошибся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600106,
					"content": "Дело вот в чём: похоже, что кто-то снова тайно устраивает Хякунин икки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600107,
						726600109
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600107,
					"content": "Хякунин иссю?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600108
					]
				},
				{
					"id": 726600108,
					"content": "Нет-нет, Хякунин икки, говорю. Что ещё за Хякунин иссю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600110
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600110,
					"content": "Был такой клан Тэнгу, члены которого подражали тэнгу. И в их среде существовал этот ритуал. Если вкратце, то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600111
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600111,
					"content": "Когда наступали плохие времена, когда было плохое настроение, когда надо было отпраздновать радостное событие или когда им просто было скучно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600112
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600112,
					"content": "Весёлым боем они справляли праздники или изгоняли неудачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600113
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600113,
					"content": "Похоже, что когда угодно можно устроить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600114
					]
				},
				{
					"id": 726600114,
					"content": "...Если подумать, то так и есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600115
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600115,
					"content": "Как бы то ни было, давай продолжим разговор в другом месте. В городе для таких тем слишком людно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600109,
					"content": "Что это?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600110
					]
				},
				{
					"id": 726600104,
					"content": "У тебя ко мне поручение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600105
					]
				},
				{
					"id": 726600105,
					"content": "Ну не то чтобы поручение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Каябуки Иккэй"
				}
			]
		},
		{
			"id": 7266002,
			"completionStepIds": [
				7266002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266002",
							"2"
						],
						"stepId": 7266002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каябуки Иккэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600201,
					"content": "Вот мы и пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600202
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600202,
					"content": "Пройдя через эти крайне подозрительные двери, ты попадёшь в место проведения Хякунин икки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600203,
						726600204
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600203,
					"content": "Очень интересно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				},
				{
					"id": 726600205,
					"content": "Хотя клан тэнгу давно запретили за нарушение общественного порядка и морали, но секретные Хякунин икки турниры всё равно иногда устраиваются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600206
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600206,
					"content": "Монстры, искатели приключений и воины со всех уголков мира стекаются сюда, чтобы принять участие в задорном побоище на этой арене.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600207
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600207,
					"content": "Зови своих друзей и товарищей! Ведь «хякунин» в названии означает, что чем больше народу, тем веселее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600208
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600208,
					"content": "#Ты похож{F#а} на {M#опытного путешественника}{F#опытную путешественницу} - у тебя наверняка много друзей, которые согласятся поучаствовать вместе с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600209
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600209,
					"content": "А ты не участвуешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600210
					]
				},
				{
					"id": 726600210,
					"content": "Я? Я участвую в роли зрителя. Я буду за тебя болеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600211
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600211,
					"content": "На самом деле моя цель - написать самую эпичную книгу о сражениях и получить приз «Потрясающий роман» от издательского дома Яэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600212
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600212,
					"content": "И интуиция подсказывает мне, что ты станешь самой яркой звездой этой арены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600213,
						726600214
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600213,
					"content": "Я буду стараться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600215,
					"content": "#Я уже даже придумал название для книги - «Хякунин икки. История величайшего бойцовского соревнования». Если когда-нибудь увидишь её на полках издательского дома Яэ, то там обязательно будет часть, где в бой вступает {M#светловолосый чужестранец}{F#светловолосая чужестранка}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600216
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600216,
					"content": "Жду не дождусь твоего выступления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726600214,
					"content": "Ну конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600204,
					"content": "Очень подозрительно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				}
			]
		}
	]
}