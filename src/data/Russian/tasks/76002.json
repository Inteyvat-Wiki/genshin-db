				]
			},
			"dialogs": [
				{
					"id": 760020101,
					"content": "#Эй, {M#братуха}{F#сеструха}, ты как раз вовремя. Тут один выскочка лезет на рожон, помоги разобраться, и я поделюсь добычей! Не обижу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020102
					],
					"speakerTitle": "Басу"
				},
				{
					"id": 760020102,
					"content": "#Вот как? Зовёшь на помощь, потому что проигрываешь? Ладно, я тоже могу сыграть по этим правилам! Слушай, {M#приятель}{F#подруга}, помоги мне победить этого мерзавца, и я отсыплю тебе моры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020103
					],
					"speakerTitle": "Хойка"
				},
				{
					"id": 760020103,
					"content": "А?! М-мы тут просто мимо проходили...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7600203,
			"completionStepIds": [
				7600203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
