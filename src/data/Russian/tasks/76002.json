			"dialogs": [
				{
					"id": 760020701,
					"content": "Ха-ха, мы всех разогнали! Уму непостижимо! Неужели они всерьёз думали, что мы станем их бойцами?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020702,
						760020704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760020702,
					"content": "В конце концов справедливость восторжествует!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760020703
					]
				},
				{
					"id": 760020703,
					"content": "Точно! Паймон интересно, а что они вообще пытались украсть?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760020707,
					"content": "А? Паймон думает, что это мек из Фонтейна? Их технологии впечатляют. Работает даже после такой длительной транспортировки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760020708,
					"content": "ВНИМАНИЕ. <color=#FF5E41FF>ОШИБКА</color> режима запуска. Энергетический модуль <color=#FF5E41FF>НЕx5F02&#5E38ИСПРАВЕН</color>. Ошибка верификации.",
