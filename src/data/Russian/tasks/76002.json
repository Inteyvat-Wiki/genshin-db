							9802.658
						],
						"pointId": 13215
					}
				]
			},
			"dialogs": [
				{
					"id": 760020301,
					"content": "Фух... Пусть убираются. У них ума с гулькин нос, а всё туда же - опять пытались пробраться на нашу территорию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020302
					],
					"speakerTitle": "Басу"
				},
				{
					"id": 760020302,
					"content": "Спасибо за помощь. Как только мои ребята доставят эту «Мадемуазель Бельвиль» в Нашгород, вы получите свою долю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020303
					],
					"speakerTitle": "Басу"
				},
				{
					"id": 760020303,
					"content": "А, точно, оплата... Подождите... Вы что, торговцы людьми?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760020304,
					"content": "Не пойми нас неправильно, малышка. Мы не занимаемся похищениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020305
					],
					"speakerTitle": "Басу"
				},
				{
					"id": 760020305,
					"content": "Мадемуазель Бельвиль, так называется этот кусок металла. Он прибыл к нам прямиком из Флёв Сандр, и его доставка потребовала немалых усилий. Если его украдут, нам крышка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020306
					],
					"speakerTitle": "Басу"
				},
				{
					"id": 760020306,
					"content": "Ого, мек из Фонтейна? Их технологии впечатляют. Работает, даже после такой длительной транспортировки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760020307,
					"content": "Шутишь? Его систему питания давным-давно демонтировали. Не может быть, чтобы он работал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020308
					],
					"speakerTitle": "Басу"
				},
				{
					"id": 760020308,
					"content": "ВНИМАНИЕ. <color=#FF5E41FF>ОШИБКА</color> режима запуска. Энергетический модуль <color=#FF5E41FF>НЕx5F02&#5E38ИСПРАВЕН</color>. Ошибка верификации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020309
					],
					"speakerTitle": "Мадемуазель Бельвиль"
				},
				{
					"id": 760020309,
					"content": "«Проверка не пройдена. <color=#FF5E41FF>Проверка не пройдена</color>. <color=#FF5E41FF>Проверка не пройдена</color>. <color=#FF5E41FF>Уничтожить</color>. <color=#FF5E41FF>Уничтожить</color>. <color=#FF5E41FF>Уничтожить</color>. <color=#FF5E41FF>Уничтожить, уничтожить, уничтожить, уни...</color>»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020310
					],
					"speakerTitle": "Мадемуазель Бельвиль"
				},
				{
					"id": 760020310,
					"content": "#Ой! {NICKNAME}, осторожно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
