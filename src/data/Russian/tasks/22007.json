						220070302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220070302,
					"content": "Хочешь поискать ещё? Или вернёмся к Бао Эр?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070303,
						220070304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220070303,
					"content": "Я хочу ещё немного поискать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070305
					]
				},
				{
					"id": 220070305,
					"content": "Отлично. Давай поищем повнимательнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220070304,
					"content": "Давай вернёмся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070306
					]
				},
				{
					"id": 220070306,
					"content": "Давай послушаем, что скажет Бао Эр.",
