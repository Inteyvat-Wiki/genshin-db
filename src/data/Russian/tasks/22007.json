					"nextDialogs": [
						220070203
					]
				},
				{
					"id": 220070203,
					"content": "Смотри, я положила в этот ящик разную одежду, чтобы не повредить реликвию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070204
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220070204,
					"content": "Я профессиональный учёный и не допускаю глупых ошибок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070205
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220070205,
					"content": "Спасибо тебе за помощь... Сама бы я с монстрами не справилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бао Эр"
				}
			]
		},
