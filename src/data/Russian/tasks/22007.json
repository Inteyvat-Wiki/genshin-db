			"dialogs": [
				{
					"id": 220070401,
					"content": "#Ты наш{F#ла}{M#ёл} реликвию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070402
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220070402,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070403
					]
				},
				{
					"id": 220070403,
					"content": "Давай посмотрим... Ух ты! Это в самом деле реликвия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070404
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220070404,
					"content": "Эм... Она не похожа на ту, которую я потеряла, но тоже выглядит драгоценной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070405
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220070405,
					"content": "Нужно, чтобы на эту реликвию взглянул настоящий эксперт. Не волнуйся, со мной она будет в безопасности. Спасибо вам двоим за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бао Эр"
				}
			]
