			"dialogs": [
				{
					"id": 220070101,
					"content": "Где же я могла её потерять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070102
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220070102,
					"content": "Что произошло?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070103
					]
				},
				{
					"id": 220070103,
					"content": "Я исследовала руины, а потом на меня внезапно напали монстры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070104
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220070104,
					"content": "Я спаслась бегством, но по пути обронила одну ценную реликвию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070105
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220070105,
					"content": "Мне удалось убежать, но теперь я не могу найти реликвию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070106
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220070106,
					"content": "Я везде уже посмотрела. Может быть, её забрали монстры... Что думаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070107
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220070107,
					"content": "Поможешь мне с поисками? Если найдёшь какую-нибудь реликвию, просто положи её в этот ящик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бао Эр"
				}
			]
		},
