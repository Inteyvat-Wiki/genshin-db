			"dialogs": [
				{
					"id": 751500401,
					"content": "Как попасть в Сердце Священной горы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500402
					]
				},
				{
					"id": 751500402,
					"content": "Вход в Сердце Священной горы близко. При воссоздании центра города Толлан владыка Шиукоатль стал копать вниз, чтобы обеспечить стабильную среду для экспериментов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500403
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751500403,
					"content": "И там он создал оружие, способное уничтожить Бездну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500404
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751500404,
					"content": "Однако из-за печати устройство подверглось сильному разложению Бездны. И в конце концов город был захвачен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500405
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751500405,
					"content": "Вход в Сердце Священной горы находится под разломами в Священном городе... Там разложение великого врага, скрытого в тени, дошло до самых глубин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Слуга источника"
				}
			]
		},
