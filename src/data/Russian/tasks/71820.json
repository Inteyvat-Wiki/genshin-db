			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Верр Голдет"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200201,
					"content": "Каждый Праздник морских фонарей одно и то же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200202
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718200202,
					"content": "У тебя что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200203
					]
				},
				{
					"id": 718200203,
					"content": "У нас тут проблемка. Почти все работники разошлись по домам праздновать с семьями. Так мы работать не можем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200204
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718200204,
					"content": "Нужно и гостей встречать, и постоялый двор украсить, а ещё подготовиться к празднику...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200205
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718200205,
					"content": "Это не учитывая обычных забот. Если от работы кони дохнут, то что тогда будет с Янь Сяо?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200206
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718200206,
					"content": "#Путешественни{F#ца}{M#к}, прояви сочувствие, помоги ему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200207
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718200207,
					"content": "Я спасу его!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200208
					]
				},
				{
					"id": 718200208,
					"content": "Уверена, он будет признателен. Он сейчас на кухне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200209
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718200209,
					"content": "А мне тут нужно кое с чем разобраться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верр Голдет"
				}
			]
		},
		{
			"id": 7182003,
			"completionStepIds": [
				7182003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182003",
							"2"
						],
						"stepId": 7182003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Улыбчивый Янь Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200301,
					"content": "Кто тут?! Сюда посторонним не... А, это ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200302
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718200302,
					"content": "Тебе что-то нужно? Если хочешь заказать еду, придётся подождать. Я сейчас очень занят...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200303,
						718200304
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718200303,
					"content": "#Я приш{F#ла}{M#ёл} помочь тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				},
				{
					"id": 718200305,
					"content": "Да ладно, серьёзно? О... Я буду рад любой помощи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200306
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718200306,
					"content": "Только что привезли ингредиенты. Они там, внизу. Нужны очень срочно. Пожалуйста, принеси их мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200307
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718200307,
					"content": "Заодно развесь эти фонари. Повесь их на двух деревьях, что у входа в постоялый двор... Хозяйка из-за этого постоянно меня пилит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718200304,
					"content": "Что я могу для тебя сделать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				}
			]
		},
		{
			"id": 7182015,
			"completionStepIds": [
				7182015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182015",
							"2"
						],
						"stepId": 7182015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Улыбчивый Янь Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201501,
					"content": "Что, уже всё готово?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201502
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718201502,
					"content": "Всё сделано в лучшем виде.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201503
					]
				},
				{
					"id": 718201503,
					"content": "Благодарю, я твой должник. Мне нужно поскорее приготовить эти блюда, не то гости будут сердиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
			]
		},
		{
			"id": 7182016,
			"completionStepIds": [
				7182016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182016",
							"2"
						],
						"stepId": 7182016,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Верр Голдет"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201601,
					"content": "#Уже вернул{F#ась}{M#ся}? Как там Янь Сяо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201602
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718201602,
					"content": "Теперь ему должно быть полегче.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201603
					]
				},
				{
					"id": 718201603,
					"content": "#Вот и хорошо. Спасибо, что выручил{F#а}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201604
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718201604,
					"content": "И тут нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201605,
						718201606
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718201605,
					"content": "Ван Я, голубушка, как поживаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				},
				{
					"id": 718201607,
					"content": "#{NICKNAME}? Вот так встреча! Не ожидала увидеть тебя здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201608
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718201608,
					"content": "#Можно сказать, что я снова занимаюсь рассылкой небесных фонарей. Ты слышал{F#а} о деревне Цинцэ? Она далеко от города, и живут там, считай, одни старики и дети.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201609
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718201609,
					"content": "Каждый год на Праздник морских фонарей Департамент по делам граждан отправляет им посыльного с вещами первой необходимости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201610
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718201610,
					"content": "Первая партия уже доставлена, но я хотела бы сделать для деревни что-нибудь ещё, чтобы праздник коснулся и неё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201611
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718201611,
					"content": "Поэтому я попросила поэта Цин Чжоу подготовить загадки на фонариках, чтобы как-то развлечь местную детвору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201612,
						718201613
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718201612,
					"content": "Цин Чжоу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201614,
					"content": "Такому знаменитому поэту, как он, это не составит труда. Также я хотела пригласить господина Бо Хуаня. Он отличный каллиграф. Здорово, если он поможет деревенским старикам написать на фонарях желания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201615
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718201615,
					"content": "Но найти его попросту невозможно. Говорят, что он отправился на Тростниковые острова за материалами, поэтому сейчас я пытаюсь его тут разыскать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201616,
						718201617
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718201616,
					"content": "Об этом стоило бы спросить у хозяйки постоялого двора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201618,
					"content": "Господин Бо Хуань? Дай подумать... Недавно он заходил на постоялый двор и упоминал, что пойдёт в окрестности что-то собирать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201619
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718201619,
					"content": "Но в этой области много чудовищ. Он наверняка уже ушёл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201620
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718201620,
					"content": "Понятно... Но мы с Цин Чжоу договаривались встретиться на постоялом дворе «Ваншу», и он должен скоро прийти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201621
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718201621,
					"content": "#Путешественни{F#ца}{M#к}, поможешь найти господина Бо Хуаня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201622
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718201622,
					"content": "#Считай, что я его уже наш{F#ла}{M#ёл}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201623
					]
				},
				{
					"id": 718201623,
					"content": "Благодарю. Я буду ждать Цин Чжоу, нам с ним ещё нужно обсудить кое-какие дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201624
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718201624,
					"content": "Ух... Сколько всего ещё нужно сделать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718201617,
					"content": "Ты не знаешь, где сейчас господин Бо Хуань?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201613,
					"content": "(А как же его договорённость с Вермеером?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201606,
					"content": "Ты пришла сюда запустить небесный фонарь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				}
			]
		},
		{
			"id": 7182019,
			"completionStepIds": [
				7182019
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182019",
							"2"
						],
						"stepId": 7182019,
						"stateName": "QUEST_STATE_UNFINISHED"
