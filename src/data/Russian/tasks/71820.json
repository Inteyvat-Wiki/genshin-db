			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Господин Бо Хуань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201901,
					"content": "Спасибо, спасибо! Ах, я такой неосмотрительный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201902
					],
					"speakerTitle": "Господин Бо Хуань"
				},
				{
					"id": 718201902,
					"content": "А что это ты тут делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201903
					]
				},
				{
					"id": 718201903,
					"content": "Я пришёл за материалами. Я решил, что на праздник было бы неплохо написать несколько красивых надписей и подарить их друзьям...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201904
					],
					"speakerTitle": "Господин Бо Хуань"
				},
				{
					"id": 718201904,
					"content": "Но для этого мне нужны особые чернила. Думал, прогуляюсь спокойно, найду нужные материалы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201905
					],
					"speakerTitle": "Господин Бо Хуань"
				},
				{
					"id": 718201905,
					"content": "А тут чудовища. Я такого не ожидал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201906
					],
					"speakerTitle": "Господин Бо Хуань"
				},
				{
					"id": 718201906,
					"content": "Насчёт приглашения Ван Я...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201907
					]
				},
				{
					"id": 718201907,
					"content": "Донести искусство каллиграфии до деревни Цинцэ?.. Хорошо, можешь на меня положиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201908
					],
					"speakerTitle": "Господин Бо Хуань"
				},
				{
					"id": 718201908,
					"content": "Цинцэ... Помню, там много стариков. Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201909
					],
					"speakerTitle": "Господин Бо Хуань"
				},
				{
					"id": 718201909,
					"content": "Придумал. Для чернил мне нужен кор ляпис и цветок цинсинь. Найдёшь их для меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201910
					],
					"speakerTitle": "Господин Бо Хуань"
				},
				{
					"id": 718201910,
					"content": "Разве из них можно сделать чернила?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201911
					]
				},
				{
					"id": 718201911,
					"content": "Ха-ха-ха, век живи - век учись. Размолотый кор ляпис придаёт чернилам дивный золотистый оттенок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201912
					],
					"speakerTitle": "Господин Бо Хуань"
				},
				{
					"id": 718201912,
					"content": "Ну а сок цветка цинсинь привносит тонкий цветочный аромат. Если чернила качественные, их запахи прекрасно друг друга дополняют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201913,
						718201914
					],
					"speakerTitle": "Господин Бо Хуань"
				},
				{
					"id": 718201913,
					"content": "Вот это серьёзный подход...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				},
				{
					"id": 718201915,
					"content": "Ах, это сущие пустяки по сравнению с тем, на что готовы пойти при изготовлении своих чернил некоторые ценители.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201916
					],
					"speakerTitle": "Господин Бо Хуань"
				},
				{
					"id": 718201916,
					"content": "На этот раз мы ничего усложнять не будем. Просто собери материалы и передай их мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201917
					],
					"speakerTitle": "Господин Бо Хуань"
				},
				{
					"id": 718201917,
					"content": "Фух... Мне надо передохнуть. Эти чудовища меня до смерти перепугали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Господин Бо Хуань"
				},
				{
					"id": 718201914,
					"content": "Как всё это хлопотно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				}
			]
		},
