			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ханаяма Каору"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250102,
					"content": "Если бы я могла посадить больше цветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250103
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250103,
					"content": "А, привет! Приятно познакомиться... Прошу прощения, а вы из тех, кто вернулся сюда жить? Не думаю, что раньше вас встречала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250104,
						721250109
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250104,
					"content": "Из тех, кто вернулся сюда жить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250105
					]
				},
				{
					"id": 721250105,
					"content": "М-м-м, хм-м, живших в Татарасуне людей эвакуировали в другие места из-за инцидента с горном Микагэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250106
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250106,
					"content": "Какое-то время назад я слышала, что с горном Микагэ всё в порядке, и в Татарасуне снова безопасно. Поэтому я пошла спросить, можно ли возвращаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250107
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250107,
					"content": "Получив подтверждение, я собрала вещи и вернулась сюда жить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250108
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250108,
					"content": "Но... Похоже, не так много людей хотят возвращаться, как это сделала я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250115
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250115,
					"content": "Но тут ничего не поделаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250116
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250116,
					"content": "В конце концов, раз уж в прошлом с горном Микагэ случилось что-то настолько ужасное, все беспокоились, что это может повториться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250117
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250117,
					"content": "А ты не беспокоишься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250118
					]
				},
				{
					"id": 721250118,
					"content": "Конечно, тоже беспокоюсь... Но я тоскую по дому и постоянно переживаю по поводу своих цветов, хе-хе. Поэтому я всё равно решила вернуться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250119
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250119,
					"content": "Но цветы, которые я здесь раньше высадила, все завяли. Как жаль, что я не могу найти семена этих цветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250120
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250120,
					"content": "Эта местность идеально подходит для разведения цветов. Что ни высаживай, из семян очень быстро вырастает целое море цветов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250121
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250121,
					"content": "Раньше я сажала цветы из далёких земель. Траву-светяшку из Мондштадта, ветряные астры и одуванчики, а также шелковицу из Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250122
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250122,
					"content": "Трава-светяшка и правда очень здорово смотрится ночью. Сажать её нужно в тени, много поливать, а краешки засохших листьев надо подрезать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250123
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250123,
					"content": "Я слышала, что ветряные астры хорошо растут на ветру. Но думаю, в Инадзуме ветер не такой сильный, как в Мондштадте... Поэтому я часто подхожу к ним и обдуваю бумажным веером, но не знаю, помогает ли это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250124
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250124,
					"content": "Одуванчики доставляют меньше всего хлопот. Они сами могут о себе позаботиться, но... Поэтому-то они и вырастают в самых разных неожиданных местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250125
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250125,
					"content": "Ох...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250126
					]
				},
				{
					"id": 721250126,
					"content": "О, есть ещё шелковица из Ли Юэ. За ней ухаживать очень хлопотно. В лепестках шелковицы всегда прячутся жуки оникабуто, и приходится вручную их собирать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250127
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250127,
					"content": "К сожалению, мне не удалось вырастить цветок цинсинь. Те, что я посадила, либо не выросли, либо быстро завяли. Эх, если бы существовала в этом мире такая волшебная земля, где бы хорошо росли все без исключения цветы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250128
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250128,
					"content": "Я... Я знаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250129
					]
				},
				{
					"id": 721250129,
					"content": "О, да, а ты знаешь, что в Ли Юэ есть цветы, называемые стеклянными колокольчиками? Цветок этот правда очень трудно найти. У кого я только не спрашивала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250130
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250130,
					"content": "Э...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250131
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250131,
					"content": "А! Прошу прощения! Я всегда так увлекаюсь, когда говорю о цветах. Мне очень, очень жаль!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250132
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250132,
					"content": "Вижу, ты и правда любишь цветы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250133
					]
				},
				{
					"id": 721250133,
					"content": "Небольшие исследования, хе-хе... Но теперь у меня даже нет семян, так что я не могу выращивать цветы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250109,
					"content": "Я не из здешних мест.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250110
					]
				},
				{
					"id": 721250110,
					"content": "А? Вот как. Я думала, найдётся ещё кто-то, как я, кто захочет вернуться и жить здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250111
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250111,
					"content": "Живших в Татарасуне людей эвакуировали в другие места из-за инцидента с горном Микагэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250112
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250112,
					"content": "Какое-то время назад я слышала, что с горном Микагэ всё в порядке, и в Татарасуне снова безопасно. Поэтому я пошла спросить, можно ли возвращаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250113
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250113,
					"content": "Получив подтверждение, я собрала вещи и вернулась сюда жить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250114
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250114,
					"content": "Но... Похоже, не так много людей хотят возвращаться, как это сделала я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250115
					],
					"speakerTitle": "Ханаяма Каору"
				}
			]
		},
