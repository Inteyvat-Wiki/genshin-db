				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250301,
					"content": "Что тебя сюда привело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250302
					]
				},
				{
					"id": 721250302,
					"content": "Я думаю, где можно найти семена, чтобы снова засадить здесь всё цветами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250303
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250303,
					"content": "Живших здесь на острове людей эвакуировали из-за инцидента с горном Микагэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250304
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250304,
					"content": "Я вернулась по своей инициативе, когда узнала, что проблемы с горном Микагэ разрешились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250305
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250305,
					"content": "Но все высаженные цветы завяли, и семена мне найти пока не удаётся. Как жаль, ведь это такое подходящее место для цветника...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ханаяма Каору"
				}
			]
		},
		{
