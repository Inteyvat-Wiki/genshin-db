				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250501,
					"content": "Эти семена цветов годятся?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250502
					]
				},
				{
					"id": 721250502,
					"content": "Эти... Да! Конечно же, годятся! Не сомневаюсь, что смогу вырастить из этих семян множество цветов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250503
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250503,
					"content": "Э, м-м-м, погодите... Я должна чем-нибудь отблагодарить вас за труды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250504
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721250504,
					"content": "Это для вас. Спасибо за семена цветов. Уверена, что когда вы приедете сюда в следующий раз, то увидите целое море прекрасных цветов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ханаяма Каору"
				}
			]
		},
