					}
				]
			},
			"dialogs": [
				{
					"id": 752780101,
					"content": "П-пожалуйста, постойте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780102
					],
					"speakerTitle": "«Читон»"
				},
				{
					"id": 752780102,
					"content": "У тебя что-то случилось, деточка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752780103,
					"content": "«Неси в себе чудо цветущего Гуицтли, пусть Священное пламя зажжёт твою улыбку!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780104
					],
					"speakerTitle": "«Читон»"
				},
				{
					"id": 752780104,
					"content": "А?.. Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752780105,
					"content": "«От имени курорта \"Оазис отдыха\" я дарую вам приветственный танец! Добро пожаловать! Да воссияет айдол Пипильпан!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780106
					],
					"speakerTitle": "«Читон»"
				},
				{
					"id": 752780106,
					"content": "Ну вот опять...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752780107,
					"content": "#Да, это я, «Читон». Хе-хе, давно не виделись, {M#господин}{F#госпожа} {NICKNAME} и госпожа Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780108
					],
					"speakerTitle": "«Читон»"
				},
				{
					"id": 752780108,
					"content": "О, привет, «Читон». Паймон испугалась, что мы встретили какого-то злодея!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780109,
						752780110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752780109,
					"content": "Ты в хорошем настроении?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				},
				{
					"id": 752780111,
					"content": "Хе-хе, папа решил сам обучить меня актёрскому мастерству. Говорит, что я большой талант!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780112
					],
					"speakerTitle": "«Читон»"
				},
				{
					"id": 752780112,
					"content": "Видишь? Он иногда говорит грубо, но на самом деле очень заботливый! Хотя было бы лучше, если бы он не учил тебя... сомнительным вещам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752780113,
					"content": "Ах да, это вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780114
					],
					"speakerTitle": "«Читон»"
				},
				{
					"id": 752780114,
					"content": "Это же твой костюм? А как же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752780115,
					"content": "Хе-хе, не волнуйтесь! Папа сшил для меня новый костюм. Теперь я даже лучше буду выглядеть на сцене! И больше не упаду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780116
					],
					"speakerTitle": "«Читон»"
				},
				{
					"id": 752780116,
					"content": "Считайте этот старый костюм сувениром! Возьмите, пожалуйста, и считайте его символом нашей дружбы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780117
					],
					"speakerTitle": "«Читон»"
				},
				{
					"id": 752780117,
					"content": "В следующий раз я надену новый костюм и покажу вам свой танец! Непременно приходите посмотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780118
					],
					"speakerTitle": "«Читон»"
				},
				{
					"id": 752780118,
					"content": "Да, обещаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752780119,
					"content": "«Читон»! Пора тренироваться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752780120,
					"content": "#Ладно, ладно, уже поздно. Я собираюсь потренироваться. {M#Господин}{F#Госпожа} {NICKNAME}, госпожа Паймон, до свидания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780121
					],
					"speakerTitle": "«Читон»"
				},
				{
					"id": 752780121,
					"content": "Пока-пока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752780122,
					"content": "(Ты и правда пойдёшь?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780123
					]
				},
				{
					"id": 752780123,
					"content": "Конечно! Хотя... увидеть выступление обычного айдола тоже было бы неплохо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752780110,
					"content": "Как дела?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				}
			]
		}
	]
}