			"dialogs": [
				{
					"id": 701140101,
					"content": "Удивительно, что госпожа Сандроне смогла выкроить время и посетить Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140102
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 701140102,
					"content": "Ты очень помог, когда я изучала вычислительный массив. Я хотела поблагодарить тебя лично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140103
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 701140103,
					"content": "Не стоит благодарности. Эта тема выходила за рамки моей компетенции. Успешное завершение проекта - целиком и полностью твоя заслуга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140104
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 701140104,
					"content": "Это наша общая заслуга. Хм... Кстати, а где Дурин? Я думала, он и на шаг от тебя не отходит, ведь ты вроде как его опекун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140105
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 701140105,
					"content": "Можно и так сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140106
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 701140106,
					"content": "Но в последнее время он делает успехи в развитии социальных навыков, поэтому я стараюсь давать ему возможность самому устраивать свою повседневную жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140107
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 701140107,
					"content": "Ты за него не беспокоишься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140108
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 701140108,
					"content": "Немного. Раньше, когда ему встречался человек с более... сильным характером, он...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140109
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 701140109,
					"content": "Перенимал у него странные привычки? Разные там словечки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140110
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 701140110,
					"content": "Да, именно. Ты тоже сталкивалась с чем-то подобным, госпожа Сандроне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140111
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 701140111,
					"content": "Ха, спрашиваешь? Я в этом эксперт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140112
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 701140112,
					"content": "Обычно после встречи с магистром Варкой я отвожу Дурина к Сахарозе, чтобы он помог ей с исследованиями и заодно немного успокоился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140113
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 701140113,
					"content": "Но если он проводит слишком много времени с магистром Джинн, я веду его к Кли. Чтобы он снова научился расслабляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140114
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 701140114,
					"content": "Тебе тоже непросто приходится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140115
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 701140115,
					"content": "Я всего лишь забочусь о своих близких.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140116
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 701140116,
					"content": "А как ты решаешь подобные вопросы, госпожа Сандроне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140117
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 701140117,
					"content": "Я? Мне обычно неохота во всё это вникать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140118
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 701140118,
					"content": "Но мне кажется, если у человека добрая душа, сколько на него ни влияй, в конце концов он всё равно вернётся к себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140119
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 701140119,
					"content": "Хм... Интересная точка зрения. Возможно, мне стоит перенять такой подход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				}
			]
		},
