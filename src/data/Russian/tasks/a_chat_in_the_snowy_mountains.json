			"dialogs": [
				{
					"id": 701140201,
					"content": "Благодарю за гостеприимство, госпожа Сандроне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140202,
						701140203
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 701140202,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				},
				{
					"id": 701140204,
					"content": "Хорошо. До встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 701140203,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				}
			]
		}
	]
