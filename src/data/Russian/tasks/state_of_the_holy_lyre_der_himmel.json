			"dialogs": [
				{
					"id": 3790401,
					"content": "Сработало! Как я и говорил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790402
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790402,
					"content": "Такая красивая... Такая сияющая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790403
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3790403,
					"content": "Джинн, делать комплименты себе нехорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3790404,
					"content": "Что? Я говорю о Небесной лире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790405
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3790405,
					"content": "#Благодаря кристаллу, который очистил{F#а} {NICKNAME}, Небесная лира перестала терять силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790406
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790406,
					"content": "Но этой силы всё ещё мало. Если бы у нас было больше слёз Двалина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790407,
						3790409,
						3790410
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790407,
					"content": "Мы можем помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790408
					]
				},
				{
					"id": 3790408,
					"content": "Где мы возьмём слёзы дракона?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3790411,
					"content": "Двалин плачет по сей день...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790412
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790412,
					"content": "Вдали от всех, исполненный страданий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790413
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790413,
					"content": "Двалин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790414
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3790414,
					"content": "Бедняжка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3790415,
					"content": "Это задача не для одного почётного рыцаря. Мы будем действовать вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790416
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3790416,
					"content": "Когда мы раздобудем кристаллы в форме слезы, ты займёшься их очищением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790417
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3790417,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790418
					]
				},
				{
					"id": 3790418,
					"content": "Силы добра объединяются, чтобы сразиться со злом. Это так вдохновляет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790419
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790419,
					"content": "Я напишу об этом песню!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790420
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790420,
					"content": "Эй! Ты что-нибудь кроме песен вообще умеешь делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3790421,
					"content": "Я же бард. Что мне ещё, по-твоему, делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790422
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790422,
					"content": "Ты такой наглый! Надо придумать тебе прозвище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3790423,
					"content": "Придумала! Теперь Паймон будет называть тебя <color=#00E1FFFF>бродяжка</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3790409,
					"content": "Да. Как мы это сделаем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				},
				{
					"id": 3790410,
					"content": "Мы должны заставить Двалина плакать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				}
			]
		}
	]
