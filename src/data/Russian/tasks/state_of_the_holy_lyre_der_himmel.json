			"dialogs": [
				{
					"id": 3790201,
					"content": "С возвращением!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790202
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790202,
					"content": "Небесная лира! У вас получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790203
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790203,
					"content": "Редкое дерево, украшенное узором ветра... Прохладные на ощупь струны... Она совсем не изменилась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790204
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790204,
					"content": "Ну что, Венти? Теперь ты можешь призвать Двалина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790205
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3790205,
					"content": "Хм... Небесная лира - это настоящее сокровище, но, к сожалению, она не работает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790206
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790206,
					"content": "Последний раз на ней играли больше тысячи лет назад. Её Анемо сила иссякла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790207
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790207,
					"content": "Теперь она непригодна даже для выступлений в таверне мистера Дилюка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790208
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790208,
					"content": "У меня в таверне отличная музыкальная программа. Барды дерутся друг с другом за право выступать в моей таверне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790209
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3790209,
					"content": "Сейчас это неважно, господин Дилюк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3790210,
					"content": "Эй, бард! Ты украл Небесную лиру, чтобы играть на ней перед кучкой пьянчуг?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3790211,
					"content": "Хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790212
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790212,
					"content": "Что значит «хе-хе»?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3790213,
					"content": "Двалина с её помощью нам всё равно не призвать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790214
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790214,
					"content": "Сама лира в порядке, но вот струны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790215
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790215,
					"content": "Твой выход, чужеземец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790216,
						3790217
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790216,
					"content": "Мой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				},
				{
					"id": 3790218,
					"content": "Расслабься, её не нужно чинить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790219
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790219,
					"content": "Просто заряд Анемо в ней очень слаб.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790220
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790220,
					"content": "#{NICKNAME}, ты ещё хранишь слезу Двалина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790221
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3790221,
					"content": "(кивает головой)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3790217,
					"content": "Я не умею чинить музыкальные инструменты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				}
			]
		},
