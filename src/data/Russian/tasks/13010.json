	"talks": [
		{
			"id": 1301002,
			"completionStepIds": [
				1301002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301002",
							"2"
						],
						"stepId": 1301002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сайно"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100201,
					"content": "Ну и жара... Вот бы найти прохладное местечко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100202,
					"content": "Отдохнём немного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100203
					]
				},
				{
					"id": 130100203,
					"content": "Нам ещё идти и идти, придётся потерпеть. Судя по окружающей обстановке, это не лучшее место для отдыха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100204
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100204,
					"content": "Уф... Ладно, но разве тебе не жарко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100205,
					"content": "Жарко, но я уже привык.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100206
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100206,
					"content": "И в чём же твой секрет? Силы Паймон на исходе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100207,
					"content": "Нужно сохранять ясную голову, а сила воли поможет. Стоит расслабиться - и сразу накатит усталость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100208
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100208,
					"content": "Шаг за шагом двигайся вперёд и не позволяй мозгу ограничивать возможности своего тела. А когда окажемся в безопасном месте, можно будет как следует отдохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100209
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100209,
					"content": "Хорошо. Только где же это безопасное место? Паймон считает, что и здесь нам ничего не угрожает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100210,
					"content": "Гляди, это бескрайняя пустыня. Ни одного монстра вокруг... Ой-ой! Откуда взялись эти скорпионы?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100211,
					"content": "Осторожно, они шутить не любят...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайно"
				}
			]
		},
		{
			"id": 1301004,
			"completionStepIds": [
				1301004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301004",
							"2"
						],
						"stepId": 1301004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сайно"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100401,
					"content": "Фух... Паймон и не думала, что здесь водятся скорпионы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100402,
					"content": "Это не обычные скорпионы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100403
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100403,
					"content": "Смотри, у них пронумерованы клешни. Это искусственно выведенные особи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100404
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100404,
					"content": "Это значит, что...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100405
					]
				},
				{
					"id": 130100405,
					"content": "Кто-то очень не хочет, чтобы мы попали на аукцион, вот и послал их нас остановить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100406
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100406,
					"content": "Вокруг море песка. Если бы с нами здесь разделались, никто бы ничего не узнал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100407
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100407,
					"content": "Кошмар! Хорошо, что мы ни на секунду не теряли бдительности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100408,
					"content": "Здесь что-то не так... В пустыне нет дорог, как они узнали, что мы будем идти здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100409
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100409,
					"content": "#Не двигайся, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100410
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100410,
					"content": "Ну конечно... Они подбросили тебе эту штуку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100411
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100411,
					"content": "Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100412,
					"content": "Устройство отслеживания, разработанное в Кшахреваре. Позволяет определить примерное местоположение человека, на которого оно надето.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100413
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100413,
					"content": "Не помню, чтобы это устройство запустили в массовое производство. Где же они его взяли... Неужели в это дело впутаны учёные из Кшахревара? Что-то здесь не так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100414
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100414,
					"content": "#Надо же, какие бывают штуковины! {NICKNAME}, как оно у тебя оказалось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100415,
					"content": "Должно быть, наёмники подбросили во время схватки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100416,
						130100417
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100416,
					"content": "Извини.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				},
				{
					"id": 130100418,
					"content": "В такой суматохе было трудно что-то заметить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100419
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100419,
					"content": "Хорошо, что Сайно заметил. Нужно поскорее от него избавиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100420,
					"content": "...Нет, лучше пока оставим, оно может пригодиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100421
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100421,
					"content": "Ну что, продолжим путь на аукцион. Мы потеряли много времени. Кто знает, какие опасности нас ещё поджидают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100417,
					"content": "#Я ничего не заметил{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				}
			]
		},
		{
			"id": 1301006,
			"completionStepIds": [
				1301009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301009",
							"2"
						],
						"stepId": 1301009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сайно"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100601,
					"content": "Это здесь проходит аукцион? Странно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100602,
					"content": "Никого нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100603
					]
				},
				{
					"id": 130100603,
					"content": "Ага! Никогошеньки. Может, у них перерыв?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100604,
					"content": "Разобравшись с наёмниками, мы сразу поспешили сюда, потому что боялись, что кто-то успеет предупредить их о нашем прибытии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100605
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100605,
					"content": "Но наш план не удался. Бьюсь об заклад, за нашими передвижениями наблюдали с помощью устройства отслеживания. Поэтому они и успели скрыться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100606
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100606,
					"content": "И что нам делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100607,
					"content": "Искать. Они бы не успели переместить отсюда все капсулы знаний. Наверняка мы сможем что-то найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100608
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100608,
					"content": "Тогда хорошенько здесь всё осмотрим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1301007,
			"completionStepIds": [
				1301011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301011",
							"2"
						],
						"stepId": 1301011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сайно",
					"Бахари"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100701,
					"content": "Ого! И правда, получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100702,
					"content": "Это ты тут самый главный злодей? Давай выкладывай всё, что знаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100703,
						130100704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100703,
					"content": "Ему что-нибудь известно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				},
				{
					"id": 130100705,
					"content": "Когда он появился, я решил не торопиться и понаблюдать со стороны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100706
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100706,
					"content": "Это не организатор аукциона, но один из важных торговцев. Я прав?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100707
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100707,
					"content": "А ты хорош, Сайно. Зришь в корень... Если бы я знал, что ты всё ещё здесь, не стал бы рисковать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100708
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100708,
					"content": "Рисковать? Что ты имеешь в виду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100709,
					"content": "Как только стало известно, что на аукцион готовится облава, все торговцы капсулами знаний в панике разбежались, побросав свои товары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100710
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100710,
					"content": "Пока что у этих капсул нет хозяев. Если бы удалось прибрать их к рукам, можно было бы заработать целое состояние. Но это уже не имеет значения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100711
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100711,
					"content": "Тебе ведь известно, кто изготавливает и продаёт капсулы знаний? Сам расскажешь или мне помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100712
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100712,
					"content": "Сам расскажу! Но давайте поговорим в другом месте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100713
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100713,
					"content": "Если кто-нибудь увидит, что я с вами разговариваю, мне и моей семье несдобровать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100714
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100714,
					"content": "И куда ты предлагаешь пойти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100715
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100715,
					"content": "Пойдёмте ко мне домой, в деревню Аару, там безопасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100716
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100716,
					"content": "#Ладно. {NICKNAME}, оставь устройство отслеживания здесь. Сходим туда и всё узнаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100704,
					"content": "Это он устроил аукцион?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				}
			]
		},
		{
			"id": 1301008,
			"completionStepIds": [
				1301008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301008",
							"2"
						],
						"stepId": 1301008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Симин",
					"Бахари",
					"Сайно"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100801,
					"content": "Папа, ты вернулся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100802
					],
					"speakerTitle": "Симин"
				},
				{
					"id": 130100802,
					"content": "У нас гости? Здравствуйте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100803
					],
					"speakerTitle": "Симин"
				},
				{
					"id": 130100803,
					"content": "Это моя дочь Симин. Она немного застенчива.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100804
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100804,
					"content": "Будь хорошей девочкой и поиграй немного, пока папа беседует с гостями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100805
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100805,
					"content": "Ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100806
					],
					"speakerTitle": "Симин"
				},
				{
					"id": 130100806,
					"content": "Среди торговцев имя Сайно знает каждый. А как вас зовут?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100807
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100807,
					"content": "#Я Паймон! А это {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100808
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100808,
					"content": "Честно говоря, я не ожидал, что у одиночки Сайно есть компаньоны. Вот почему я решил, что он ушёл ни с чем, когда устройство отслеживания стало удаляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100809
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100809,
					"content": "Хоть вы меня поймали, но я всё равно дам вам совет... Бросьте это расследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100810
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100810,
					"content": "Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100811
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100811,
					"content": "Производство, продажа, распределение выручки... На каждом этапе задействовано от нескольких десятков до сотни человек, и всех их объединяет жажда наживы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100812
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100812,
					"content": "Каждый сделает всё возможное, чтобы сохранить эту производственную цепочку, ведь выстроить её стоило такого труда. Ты ничего не добьёшься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100813
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100813,
					"content": "Но даже если у тебя всё получится, никто тебя не поблагодарит. Возможно, ты сам пожалеешь о том, что сделал... Так зачем тратить на это столько сил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100814
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100814,
					"content": "У каждого свои принципы, тут и говорить не о чем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100815
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100815,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100816
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100816,
					"content": "Папа, вот чай... И гостям тоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100817
					],
					"speakerTitle": "Симин"
				},
				{
					"id": 130100817,
					"content": "Ох, я даже забыл предложить вам чаю. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100818
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100818,
					"content": "Не за что. Гм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100819
					],
					"speakerTitle": "Симин"
				},
				{
					"id": 130100819,
					"content": "Чай у нас очень горький. Я добавила в него сахар, который дал мне папа. С ним будет вкуснее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100820
					],
					"speakerTitle": "Симин"
				},
				{
					"id": 130100820,
					"content": "Умница! Сахар ещё остался? Если нет, я в следующий раз куплю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100821
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100821,
					"content": "Да, ещё есть... Ладно, я пойду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100822
					],
					"speakerTitle": "Симин"
				},
				{
					"id": 130100822,
					"content": "Ты ведь говорил, что все, кто в этом замешан, получают хорошие деньги? По тебе не скажешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100823
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100823,
					"content": "...Вообще-то, именно об этом я и хотел поговорить. У меня есть к тебе личная просьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100824
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100824,
					"content": "Моя дочь больна от рождения. У неё слабое сердце и лёгкие. Малейшая нагрузка может привести к обмороку и поставить её жизнь под угрозу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100825
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100825,
					"content": "Из-за этого у неё с самого детства не было друзей. Она с утра до вечера сидит одна в своей комнате. Каждый день ей приходится принимать уйму лекарств, а это немалые деньги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100826
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100826,
					"content": "А я... Сначала я был обычным мелким торговцем, трудился от зари до зари, мотался с места на место. А зарабатывал так мало, что ничем не мог ей помочь, и на моих глазах она угасала день ото дня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100827
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100827,
					"content": "Но как-то раз один человек предложил мне хороший заработок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100828
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100828,
					"content": "Продавать капсулы знаний?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100829
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100829,
					"content": "Верно. И я заработал денег на лечение своей дочери. Ей становилось лучше прямо на глазах, моему счастью не было предела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100830
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100830,
					"content": "И таких, как я, много. Для тебя контрабанда капсул знаний недопустима, а для нас это способ выжить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100831
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100831,
					"content": "Я рассказал это, потому что хочу дать совет - остановись, Сайно, не лишай нас средств к существованию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100832
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100832,
					"content": "Как же так! То есть если мы остановим продажу капсул знаний, его дочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100833
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100833,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100834
					]
				},
				{
					"id": 130100834,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100835
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100835,
					"content": "Я должен узнать правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100836
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100836,
					"content": "Я найду врача, который поможет девочке, но смотреть сквозь пальцы на контрабанду капсул знаний я не буду. Это две совершенно разные проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100837
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100837,
					"content": "Я знал, что ты так скажешь. Но спасибо за предложение найти врача. Раз ты не собираешься останавливаться, обойди дом и посмотри на заднем дворе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100838
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100838,
					"content": "Там лежит последняя партия товара. Ты сразу всё поймёшь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100839
					],
					"speakerTitle": "Бахари"
				},
				{
					"id": 130100839,
					"content": "Вместе с Сайно вы идёте на задний двор.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130100840
					]
				},
				{
					"id": 130100840,
					"content": "Сколько же тут этого добра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100841
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100841,
					"content": "Здесь полным-полно ящиков и коробок! Всё так аккуратно упаковано. И это схрон только одного торговца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100842
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100842,
					"content": "Такой объём невозможно изготовить в небольшой мастерской. Неужели в этом замешана Академия? Не может быть, чтобы такое количество товара вывозилось из Академии, минуя проверку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100843
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100843,
					"content": "Смотри, это какие-то другие капсулы знаний. Может, в них и содержатся сведения о Чертоге упокоения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100844
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100844,
					"content": "Похоже на то. Подожди, это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100845,
						130100846
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100845,
					"content": "Какая-то незнакомая метка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				},
				{
					"id": 130100847,
					"content": "Это печать матры. Наличие этой метки означает, что находящиеся внутри товары прошли проверку матры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100848
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100848,
					"content": "Обнаружив устройство отслеживания, я заподозрил, что в этом замешан кто-то из Академии, но не мог понять, как оттуда можно вывезти столько капсул знаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100849
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100849,
					"content": "Теперь всё ясно. С этой печатью ввоз или вывоз товаров из Академии не требует повторной проверки, перемещению капсул ничего не мешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100850
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100850,
					"content": "Неудивительно, что они не хотят, чтобы я продолжал расследование. Нарушителями являются сами матры. Немыслимо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100851
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100851,
					"content": "Может, это просто недоразумение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100852
					]
				},
				{
					"id": 130100852,
					"content": "#{NICKNAME}, могу я попросить тебя кое о чём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100853
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100853,
					"content": "Раз эти ящики попали сюда из Академии, вероятно, в капсулах знаний о Чертоге упокоения тоже использовались исследовательские материалы из Академии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100854
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100854,
					"content": "Достаточно проверить записи в архиве, чтобы выяснить, кто за всем этим стоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100855
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100855,
					"content": "Но моё появление в Академии может их спугнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100856
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100856,
					"content": "Поможешь мне с этим разобраться? Я напишу письмо Набилу, он проведёт тебя в архив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100857
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100857,
					"content": "Предоставь это нам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100858
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100858,
					"content": "А я пока тоже кое-чем займусь. Улики ведут в Академию, но противник явно обладает властью и за её пределами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100859
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100859,
					"content": "От Бахари можно получить сведения об остальных торговцах. Я останусь здесь и займусь кое-какими приготовлениями. Если что-то обнаружите, сообщите мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100846,
					"content": "Сайно, ты такую когда-нибудь видел?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				}
			]
		},
		{
			"id": 1301010,
			"completionStepIds": [
				1301010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301010",
							"2"
						],
						"stepId": 1301010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130101001,
					"content": "Фух... Как же Паймон устала. Мы уже столько прошли. Может, хватит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101002,
						130101004
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130101002,
					"content": "Хватит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101003
					]
				},
				{
					"id": 130101003,
					"content": "Ура! Передохнём немного и вернёмся к Сайно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130101006,
					"content": "Вы решаете немного отдохнуть.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130101007
					]
				},
				{
					"id": 130101007,
					"content": "Нам пора. Давай вернёмся на аукцион и посмотрим, как там дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101008
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130101008,
					"content": "Интересно, сработала ли задумка Сайно?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130101004,
					"content": "Ещё немного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101005
					]
				},
				{
					"id": 130101005,
					"content": "Ещё идти? Силы Паймон на исходе... Может, отдохнём немного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1301011,
			"completionStepIds": [],
