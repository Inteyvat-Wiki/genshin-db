					"Сайно"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100610,
					"content": "Ну как, есть что-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100611
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100611,
					"content": "Хм, вроде ничего особенного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100612,
					"content": "Самые обычные капсулы знаний.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100613
					]
				},
				{
					"id": 130100613,
					"content": "Возможно, капсул знаний о Чертоге упокоения было не так много, тогда их успели унести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100614
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100614,
					"content": "#Не отчаивайтесь, у меня есть идея. {NICKNAME}, возвращайтесь назад тем путём, которым мы пришли, а я спрячусь здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100615
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100615,
					"content": "Потом выждите немного времени и возвращайтесь ко мне. Думаю, этот план сработает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100616
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100616,
					"content": "#Так вот для чего ты настоял, чтобы я оставил{F#а} устройство отслеживания!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100617
					]
				},
				{
					"id": 130100617,
					"content": "Они уходили в спешке и многое не смогли забрать. Не думаю, что они захотят бросить здесь свои товары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100618
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100618,
					"content": "Убедившись, что мы «ушли», кто-нибудь вернётся за капсулами. Нужно унести устройство отслеживания как можно дальше от этого места, тогда они подумают, что опасность миновала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100619
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130100619,
					"content": "Всё ясно! Мы их обхитрим - и они выдадут себя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100620
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100620,
					"content": "Ладно, мы пошли. Теперь всё в твоих руках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100621
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130100621,
					"content": "Не беспокойтесь. Если они осмелятся вернуться, я не дам им уйти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайно"
				}
			]
		},
