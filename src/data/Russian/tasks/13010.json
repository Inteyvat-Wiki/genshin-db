			},
			"dialogs": [
				{
					"id": 130101101,
					"content": "Что ж, времени мало. Если готовы, пора отправляться в путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайно"
