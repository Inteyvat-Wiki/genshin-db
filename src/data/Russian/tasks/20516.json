				"points": []
			},
			"dialogs": [
				{
					"id": 205160101,
					"content": "Ну куда же эта ветреница опять сбежала?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160102
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160102,
					"content": "Анна снова где-то гуляет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160103
					]
				},
				{
					"id": 205160103,
					"content": "Вот только не надо делать вид, что всё в порядке вещей, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160104
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160104,
					"content": "Анна совсем от рук отбилась. Стоило мне лишь отвернуться, она опять улизнула.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160105
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160105,
					"content": "А ведь болезнь её ещё полностью не прошла! Прошу, помоги мне найти её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160106,
						205160108,
						205160111
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160106,
					"content": "Хорошо, я помогу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160107
					]
				},
				{
					"id": 205160107,
					"content": "Благодарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160115,
					"content": "Точно! Анна всегда говорила, что хочет посмотреть статую Архонта ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160116
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160116,
					"content": "Туда ещё часто ходит сестра Грейс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160117
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160117,
					"content": "Можешь сначала расспросить её, вдруг она что-нибудь видела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160108,
					"content": "Ну, как поиски?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160109
					]
				},
				{
					"id": 205160109,
					"content": "Безрезультатно. Я даже за городом посмотрел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160110
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160110,
					"content": "Её нигде нет. Поэтому я обязан обратиться к тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160111,
					"content": "Какое любимое блюдо Анны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160112
					]
				},
				{
					"id": 205160112,
					"content": "Ну, она любит... Стой, не смей говорить о моей сестре, словно о кошке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160113
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160113,
					"content": "Ладно, ей много чего нравится, мне и не перечислить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160114
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160114,
					"content": "Я рассчитываю на твою помощь. А пока я здесь передохну, не то ноги отвалятся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Энтони"
				}
			]
		},
