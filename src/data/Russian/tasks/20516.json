			},
			"dialogs": [
				{
					"id": 205160301,
					"content": "#Ты наш{F#ла}{M#ёл} Анну?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160302
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160302,
					"content": "Да, она забралась в ладони статуи Архонта ветра.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160303
					]
				},
				{
					"id": 205160303,
					"content": "Ар... Архонта ветра?! Как ей вообще удалось туда залезть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160304
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160304,
					"content": "Так, я сейчас пойду туда, позову её вниз и как следует отчитаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160305
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205160305,
					"content": "Большое тебе спасибо. Вот, это тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		},
		{
			"id": 2051604,
