			},
			"dialogs": [
				{
					"id": 205160201,
					"content": "Отсюда открывается вид на весь Мондштадт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160202
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205160202,
					"content": "Смотри, не простудись.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160203
					]
				},
				{
					"id": 205160203,
					"content": "#Ай! Как же ты меня перепугал{F#а}! Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160204
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205160204,
					"content": "Могу поспорить, братишка опять меня обыскался. Здесь ему ни за что меня не найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160205
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205160205,
					"content": "Ладно, ладно, я скоро пойду домой. Пусть он не переживает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				}
			]
		},
		{
			"id": 2051603,
			"completionStepIds": [
				2051603
