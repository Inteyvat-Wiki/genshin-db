				{
					"id": 205160502,
					"content": "Смотри, не простудись.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160503
					]
				},
				{
					"id": 205160503,
					"content": "#Ай! Как же ты меня перепугал{F#а}! Что ты здесь делаешь? Как ты меня наш{F#ла}{M#ёл}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160504
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205160504,
					"content": "Я думала, здесь меня точно никто не найдёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160505
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205160505,
					"content": "А, знаю. Это сестра Грейс сказала тебе, где я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160506
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205160506,
					"content": "Она отправляла мне лекарства, которые я раньше принимала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160507
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205160507,
					"content": "Сестра Грейс очень хорошая, но я не хочу прожить всю жизнь в одном Мондштадте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160508
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205160508,
					"content": "Ладно, мой брат всё-таки ищет меня. Не волнуйся, я скоро пойду домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				}
			]
		},
