					"Грейс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205160401,
					"content": "Эта девочка, разве она уже не болеет? Как такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160402
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 205160402,
					"content": "Извините, вы тут одну девушку не видели?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160403
					]
				},
				{
					"id": 205160403,
					"content": "Ах, вы, наверное, говорите об Анне. Она сейчас на руке статуи Архонта ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160404
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 205160404,
					"content": "Я глазам своим не поверила, когда она промчалась рядом со мной. Бедняжка всё время хворала, а тут вдруг столько сил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160405
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 205160405,
					"content": "Я только оправилась от удивления, как она уже сидела на руке Архонта ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160406
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 205160406,
					"content": "И вы... не сердитесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160407
					]
				},
				{
					"id": 205160407,
					"content": "Ну, если только немножко. Всё-таки болезнь мучила её всю жизнь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160408
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 205160408,
					"content": "Она сейчас выглядит такой здоровой. Что и говорить... Разве можно тут рассердиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160409
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 205160409,
					"content": "Вот только там наверху сильный ветер. Как бы её не продуло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Грейс"
				}
			]
		},
