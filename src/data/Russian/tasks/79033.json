				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330101,
					"content": "Хм, изображение находится прямо в центре сцены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330102,
					"content": "Что эти двое делают? Похоже, один что-то говорит, а другой сидит на полу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330103,
					"content": "Паймон знает! Они готовятся ко сну, вот она и рассказывает историю на ночь человеку, что сидит на земле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330104,
					"content": "Фатуи не могут уснуть без сказки на ночь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330105
					]
				},
				{
					"id": 790330105,
					"content": "Не исключено, что среди них есть и такие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330106,
					"content": "Агафья, Персиков приказал провести тесты приёма сигнала. Похоже, нам всем четверым придётся уйти... Чевка, наверно, разозлится на меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330107,
					"content": "Брось, Яков, приказ есть приказ. Чевка не будет винить тебя за это!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330108,
					"content": "Если ты боишься, я могу пойти с тобой и поговорить с Чевкой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330109,
					"content": "Что? Так это не была сказка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330110,
					"content": "Но этот диалог кажется каким-то бессмысленным... Паймон ничего не понимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7903302,
			"completionStepIds": [
				7903307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7903307",
							"2"
						],
						"stepId": 7903307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330201,
					"content": "Ого, раковина сама всплыла со дна колодца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330202,
						790330203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330202,
					"content": "Это же раковина из мира грёз...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				},
				{
					"id": 790330204,
					"content": "#Восхитительно! Вот и изображения! {NICKNAME}, смотри, там кто-то наклоняется... А!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330205,
					"content": "#{NICKNAME}, не двигайся, позади тебя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330206,
						790330207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330206,
					"content": "Что там? Что-то страшное?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330208,
					"content": "А, это всего лишь изображение, воспроизведённое раковиной. Оно было прямо позади тебя, страх какой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330209,
					"content": "Детекторы сигнала... Два комплекта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330210,
					"content": "Фух, я думал, что у него серьёзные проблемы. А речь лишь об утомительном задании. Большое облегчение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330211,
					"content": "Ха! Ты бы видел, как он боялся, что ты его отругаешь. Словно младший брат робеет перед старшим. Может... он боится разочаровать нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330212,
					"content": "Мы, конечно, просто вместе служим, но... иногда мне кажется, будто мы семья...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330213,
					"content": "Семья?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330214,
					"content": "Хм... У Паймон такое чувство, что мы услышали что-то, чего не должны были слышать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330215,
					"content": "Эти Фатуи не выглядят такими уж плохими...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330207,
					"content": "Не пугай меня!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330203,
					"content": "Наверное, в ней скопился воздух...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				}
			]
		},
		{
			"id": 7903303,
			"completionStepIds": [
				7903305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7903305",
							"2"
						],
						"stepId": 7903305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330301,
					"content": "Похоже, двое лежат на земле... И смотрят на звёзды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330302,
					"content": "Какая странная картинка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330303,
					"content": "Яков, что тебе сказал командир? Ты что-то приуныл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330304,
					"content": "Из-за качки я упал, когда переносил устройство. К счастью, мне удалось быстро подхватить его, и он не пострадал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330305,
					"content": "Но командир всё равно сделал мне выговор и приказал нашему отряду провести тесты приёма сигнала. А это самая сложная работа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330306,
					"content": "Да ладно, не расстраивайся. Мы уже сотню раз это делали. Выше нос! Сходи поешь что-нибудь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330307,
					"content": "Они указывают на что-то высоко наверху. Ищут еду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790330308,
					"content": "Может, раковину надо поставить как-то иначе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}