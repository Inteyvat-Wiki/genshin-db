					"Федри"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733410101,
					"content": "#Привет! Ты {M#тот самый дарующий}{F#та самая дарующая} из чужих краёв?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410102
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410102,
					"content": "#{M#Дарующий}{F#Дарующая}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733410103
					]
				},
				{
					"id": 733410103,
					"content": "#Да, кругом говорят о {M#храбром герое, связанном}{F#храброй героине, связанной} узами с пари. Эта земля веками не видела подобного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410104
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410104,
					"content": "В прошлом пари часто были спутницами людей, мы даже жили вместе в оазисе Вурукаша.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410105
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410105,
					"content": "Несмотря на все угрозы тёмного пролома, разложение ни разу не проникло в оазис Вурукаша благодаря защите Харвисптохм и Хварны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410106
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410106,
					"content": "Прошли века, но память о тех годах для меня по-прежнему дороже всего на свете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410107,
						733410108
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410107,
					"content": "Прости, кто ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733410110
					]
				},
				{
					"id": 733410110,
					"content": "Я отвечаю за Озеро амриты. С тех пор как госпожа Зурван закрыла оазис, я никогда не покидала это место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410111
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410111,
					"content": "Озеро амриты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733410112
					]
				},
				{
					"id": 733410112,
					"content": "Озеро амриты дало жизнь нам, пари. Это оставленная госпожой первозданная вода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410113
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410113,
					"content": "Благодаря амрите обрели жизнь и силу бесчисленные формы Хварны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410114
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410114,
					"content": "Исчерпав свои силы, мы превращаемся в оперенье очищающего света, оставляя после себя лишь чистые воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410115
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410115,
					"content": "И, пройдя через Озеро амриты, принадлежащая Хварне память возвращается в Харвисптохм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410116
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410116,
					"content": "Питающая сила амриты может очистить любые горести и страдания и вернуть первозданную форму фамильярам Хварны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410117
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410117,
					"content": "А дарующий - это человек, помогающий созданиям Хварны вернуться в море цветов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410118
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410118,
					"content": "Но человеческие воины давно оставили эту обязанность. И пари, истощившие силы в борьбе со скверной, больше не могут вернуться в море цветов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410119
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410119,
					"content": "#Но теперь, когда нас вновь посетил{F#а} {M#воин}{F#воительница} из числа людей, рассеянное оперенье очищающего света наконец сможет вернуться сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410120
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410120,
					"content": "Если у тебя есть подношение, Озеро амриты примет любые воспоминания, а воды и дерево даруют тебе благословение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410121
					],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410121,
					"content": "Такова божественная милость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Федри"
				},
				{
					"id": 733410108,
					"content": "Не очень понимаю, о чём ты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733410109
					]
				},
				{
					"id": 733410109,
					"content": "Я чувствую, что лау{RUBY#[S]связь}па действительно соединяет тебя с пари.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410110
					],
					"speakerTitle": "Федри"
				}
			]
		}
	]
}