			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Жюльен"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940101,
					"content": "Ох... Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940102
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940102,
					"content": "#Похоже, ему не очень хорошо... Должно быть, он проголодался! {NICKNAME}, давай поделимся с ним едой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940103,
						732940105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940103,
					"content": "Надеюсь, она придаст ему сил.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940104
					]
				},
				{
					"id": 732940104,
					"content": "#{NICKNAME}, твои кулинарные способности на высоте. Паймон говорит это совершенно беспристрастно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940107,
					"content": "Вы отдаёте упавшему в обморок мужчине яичницу по-тейватски.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732940108
					]
				},
				{
					"id": 732940108,
					"content": "Я... Я словно родился заново!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940109
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940109,
					"content": "Это просто жареное яйцо. Он и вправду голодал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940110,
					"content": "Ах, эта невыразимая услада, что способна оживить мёртвого! Если бы я знал, что жареные яйца могут быть такими вкусными, я бы купил то мистическое яйцо у паренька.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940111
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940111,
					"content": "Что за мистическое яйцо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940112,
					"content": "Говорят, съев его, можно отвести от себя несчастья на целый день. Если бы я купил одно... или дюжину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940113
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940113,
					"content": "Как-то уж очень подозрительно звучит. Паймон способна мгновенно распознать мошенничество. Кстати, как ты здесь оказался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940114,
					"content": "Я... В общем, я прославленный художник из Фонтейна. Я прибыл в Сумеру в поисках вдохновения. Можете называть меня Жюльен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940115,
						732940117
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940115,
					"content": "Вдохновение? В таком месте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940116
					]
				},
				{
					"id": 732940116,
					"content": "Да. Ты что, не мог найти более подходящее место? Знаешь, более живописное и безопасное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940119,
					"content": "Кроме того, если ты художник из Фонтейна, почему у тебя при себе нет никаких вещей? Паймон поняла! Ты разведчик Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940120,
					"content": "Какие смелые выводы! Настолько смелые, что остаётся лишь гадать, какой жизненный опыт мог натолкнуть тебя на подобные мысли! Я художник и никто более.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940121
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940121,
					"content": "Я просто... В общем, я почерпнул достаточно вдохновения и уже готовился вернуться в Фонтейн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940122
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940122,
					"content": "Я не ожидал, что здешний климат будет настолько засушливым и что по сравнению с ним долина Чэньюй покажется болотом. И это ещё до того, как начались песчаные бури, стоило мне переступить границу Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940123
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940123,
					"content": "Должен признаться, мне больше подходит влажный климат, поэтому я планировал отправиться обратно по воде, чтобы полюбоваться пейзажами, но остался без плота, а я не умею плавать, поэтому...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940124
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940124,
					"content": "Могу представить, как нелегко тебе жилось в Фонтейне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940125
					]
				},
				{
					"id": 732940125,
					"content": "Это так, хотя дело не только в том, что я не умею плавать... Ох, не будем об этом. В итоге я нашёл место для отдыха у воды и несколько чайных листьев, которые не успели окончательно размокнуть. Позвольте мне отблагодарить вас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940126
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940126,
					"content": "Хочешь пригласить нас на чай?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940127,
					"content": "Д-да... Конечно! Я просто обязан отблагодарить вас за яичницу. Как я могу к вам обращаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940128
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940128,
					"content": "Ах да, Паймон забыла представиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940129,
						732940130,
						732940132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940129,
					"content": "#{NICKNAME} и Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940134
					]
				},
				{
					"id": 732940134,
					"content": "Ах, какие блистательные имена! Прошу вас разделить со мной чай в моём лагере, что неподалёку отсюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940130,
					"content": "#{M#Посланник}{F#Посланница} справедливости и {M#его}{F#её} верный слуга.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940131
					]
				},
				{
					"id": 732940131,
					"content": "#{NICKNAME} и Паймон, {M#его}{F#её} верная спутница.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940132,
					"content": "Называй нас Сияющее Золото и Мерцающее Серебро.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940133
					]
				},
				{
					"id": 732940133,
					"content": "#Сияющее Золото {NICKNAME} и Мерцающее Серебро Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940117,
					"content": "Неужели кто-то взаправду станет называть себя прославленным?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940118
					]
				},
				{
					"id": 732940118,
					"content": "Вот именно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940105,
					"content": "Ха-ха, он не ты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940106
					]
				},
				{
					"id": 732940106,
					"content": "Наверняка каждый хотя бы раз в жизни падал в голодный обморок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Паймон"
				}
			]
		},
