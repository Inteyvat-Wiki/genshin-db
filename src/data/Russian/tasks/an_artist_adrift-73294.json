			]
		},
		{
			"id": 7329405,
			"completionStepIds": [
				7329405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329405",
							"2"
						],
						"stepId": 7329405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Жюльен"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940501,
					"content": "Самая настоящая помойка! Как у тебя язык поворачивается называть это лагерем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940502,
					"content": "Отсюда открывается неплохой вид, а пляж даёт ощущение простора. Честно говоря, мне здесь намного комфортнее, чем в Фонтейне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940503
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940503,
					"content": "Что за жизнь у тебя была в Фонтейне? Это... не совсем то, что Паймон ожидала от прославленного художника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940504,
					"content": "По правде говоря, там, где я живу в Фонтейне, тесновато, потому что я не привык кичиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940505
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940505,
					"content": "Возможно, но даже лагеря искателей приключений в дикой местности выглядят гораздо лучше, чем это. А... Где твой питомец?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940506,
					"content": "У меня нет питомца. Должно быть, это оставил искатель приключений, который останавливался здесь до меня. К слову...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940507
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940507,
					"content": "Я бы с удовольствием оказал вам лучший приём, но большая часть моих вещей упала в воду, когда плот развалился, а плавать я не умею...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940508
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940508,
					"content": "Если бы вы нашли мои потерянные вещи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940509
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940509,
					"content": "Их можно будет использовать после того, как они побывали в воде?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940510
					]
				},
				{
					"id": 732940510,
					"content": "Я всё тщательно упаковал, но есть вещи, которые... Ох... Ладно, если они потеряны, то потеряны. Я всегда могу нарисовать заново... Да, нарисовать заново...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940511
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732940511,
					"content": "#{NICKNAME}, давай поможем этому бедолаге!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732940512,
					"content": "Мне больше не на кого положиться. Вы моя последняя надежда. Я буду ждать вас здесь и приготовлю чай к вашему возвращению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Жюльен"
				}
			]
		},
		{
			"id": 7329410,
			"completionStepIds": [
				7329410
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
