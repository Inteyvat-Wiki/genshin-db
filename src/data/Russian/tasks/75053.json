			"dialogs": [
				{
					"id": 750530101,
					"content": "#О, {M#чужеземец}{F#чужеземка}, вижу твой зоркий взгляд... Попробуешь пройти испытание «Глаза на пернатый приз»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530102
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530102,
					"content": "Тренируй зрение... получай награды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530103
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530103,
					"content": "Описание довольно краткое... Даже слишком краткое. Не очень понятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750530104,
					"content": "Подробные правила... расскажу позже... Хотите попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530105
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530105,
					"content": "Узнаем правила...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530106
					]
				},
				{
					"id": 750530106,
					"content": "Вылетят три кукузавра. Следи за средним...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530107
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530107,
					"content": "Когда вернутся... <color=#00E1FFFF>опознай того, кто был посередине</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530108
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530108,
					"content": "Значит, они поменяются местами в воздухе, и нам нужно отыскать того, кто изначально был посередине?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750530109,
					"content": "Верно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530110
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530110,
					"content": "Ха. Неудивительно, что ты называешь это тренировкой зрения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750530111,
					"content": "Сначала попробуем... простой вариант... для тренировки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530112
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530112,
					"content": "Если всё хорошо... сыграем ещё раз... уже по-настоящему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530113
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530113,
					"content": "Если преуспеешь... награда твоя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530114,
						750530116
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530114,
					"content": "#Я пока занят{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530115
					]
				},
				{
					"id": 750530115,
					"content": "Хорошо. Буду здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530116,
					"content": "Ладно, думаю, можно попробовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530117
					]
				},
				{
					"id": 750530117,
					"content": "#Будешь готов{F#а}... порази мишень... и начинай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Муепу"
				}
			]
		},
