					"nextDialogs": [
						750530303,
						750530307,
						750530311
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530303,
					"content": "Расскажи больше об испытании «Глаза на пернатый приз»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530304
					]
				},
				{
					"id": 750530304,
					"content": "Это традиция племени. Давняя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530305
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530305,
					"content": "Острое зрение... очень важно... для клана Цветочного Пера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530306
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530306,
					"content": "В нынешнем поколении... я руковожу испытанием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530307,
					"content": "Почему ты так медленно говоришь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530308
					]
				},
				{
					"id": 750530308,
					"content": "Пострадал. Упал с большой высоты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530309
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530309,
					"content": "Горло и грудь... Не могу говорить, как прежде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530310
					],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530310,
					"content": "Но я не думаю, что... всё так уж плохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Муепу"
				},
				{
					"id": 750530311,
					"content": "Не переживай, всё в порядке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530312
					]
				},
				{
					"id": 750530312,
					"content": "Желаю тебе удачи... Пока.",
