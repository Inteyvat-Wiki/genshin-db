					"Кайван"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230310101,
					"content": "#Сдаётся мне, что ты путешественни{F#ца}{M#к}. Отличное место для прогулки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310102
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310102,
					"content": "Или ты тоже заядлый рыбак, присматривающийся к этим водам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310103
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310103,
					"content": "Хороший выбор! Это лучшее место для рыбалки в округе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310104
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310104,
					"content": "Откуда такая уверенность? Здесь, похоже, больше никто не рыбачит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230310105,
					"content": "У меня отменное чутьё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310106
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310106,
					"content": "Как лучший рыбак в этом районе, я отлично разбираюсь в рыбных местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310107
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310107,
					"content": "П-правда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310108
					]
				},
				{
					"id": 230310108,
					"content": "И где же тогда твой улов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230310109,
					"content": "Ни слова больше, сейчас я покажу, что такое непревзойдённый улов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310110,
						230310111
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310110,
					"content": "Непревзойдённый...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				},
				{
					"id": 230310112,
					"content": "Если принесёте особые ингредиенты, я сделаю наживку и поймаю такую рыбу, какая вам и не снилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310113
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310113,
					"content": "Звучит подозрительно! Разве от самодельных наживок есть какой-то прок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230310114,
					"content": "Попытка не пытка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310115
					]
				},
				{
					"id": 230310115,
					"content": "Одно удовольствие иметь дело с такими, как вы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310116
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310116,
					"content": "Помимо закатника и пшеницы, я использую для своей наживки одухотворяющий ингредиент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310111,
					"content": "Улов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				}
			]
		},
