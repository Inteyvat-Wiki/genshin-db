			"dialogs": [
				{
					"id": 230310601,
					"content": "Отлично, у нас есть всё, что нужно. Теперь займёмся уникальной наживкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310602
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310602,
					"content": "Кайван ловко изготовил наживку",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310603
					]
				},
				{
					"id": 230310603,
					"content": "Отлично, можно приступать к рыбалке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310604
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310604,
					"content": "Крючок опустился на нужную глубину... Скорость течения подходящая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310605
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310605,
					"content": "Ведите себя тихо, рыба очень пуглива.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310606
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310606,
					"content": "Звук шагов на берегу тоже может её спугнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310607,
						230310608
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310607,
					"content": "Я стою неподвижно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				},
				{
					"id": 230310609,
					"content": "Тогда наберитесь терпения и тихонько ждите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310610
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310610,
					"content": "Кайван выудил какой-то мокрый свёрток",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310611
					]
				},
				{
					"id": 230310611,
					"content": "Что это? Не похоже на рыбу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230310612,
					"content": "#Такой «рыбы» я ещё не видел{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310613
					]
				},
				{
					"id": 230310613,
					"content": "И почему я не удивлён...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310614
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310614,
					"content": "Кхе-кхе, вечно вы, чужеземцы, любите докапываться до мелочей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310615
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310615,
					"content": "Всё, что крючок выуживает из воды, можно считать пойманной «рыбой».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310616
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310616,
					"content": "Вообще-то, это не я придумал себе прозвище «лучший рыбак».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310617
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310617,
					"content": "Как-никак для того, чтобы всякий раз вылавливать что-то, не способное даже наживку заглотить, требуется особое мастерство...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310618
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310618,
					"content": "Другие рыбаки хвалят мой уникальный талант...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310619,
						230310620
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310619,
					"content": "Возможно, они просто тебя успокаивают...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310621,
					"content": "Проще говоря, ты можешь поймать всё, кроме рыбы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310622
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230310622,
					"content": "Кхм! Неважно, что они думают! По крайней мере, я никогда не возвращаюсь с рыбалки с пустыми руками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310623
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310623,
					"content": "Если не везёт сегодня, то повезёт завтра! Однажды я обязательно поймаю рыбу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310624
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310624,
					"content": "Спасибо, что помогли найти ингредиенты. Вот ваша награда. А я подыщу новое место для рыбалки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310625
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310625,
					"content": "В следующий раз... В следующий раз я обязательно поймаю крупную рыбу! Я уверен в этом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230310620,
					"content": "Возможно, они просто над тобой потешаются...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310608,
					"content": "Паймон не касается земли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				}
			]
		},
