			"dialogs": [
				{
					"id": 3830401,
					"content": "Ух ты! Сработало!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3830402,
					"content": "Теперь она выглядит совсем иначе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830403
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3830403,
					"content": "Энергия Лиры полностью восстановлена. Теперь мы можем её использовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830404
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3830404,
					"content": "#Спасибо тебе, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830405
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3830405,
					"content": "Теперь нужно решить, куда мы призовём Ужас Бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830406
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3830406,
					"content": "Это точно нельзя делать в городе. Если что-то пойдёт не так, всему городу придёт конец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830407
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3830407,
					"content": "А если мы устроим это здесь, на винокурне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830408
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3830408,
					"content": "Я переживу, если винокурня будет вдруг уничтожена. Но всё-таки давайте выберем другое место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830409
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3830409,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830410
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3830410,
					"content": "Ветер, что дует с моря или высоко в горах, разнесёт песнь барда по округе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830411
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3830411,
					"content": "Чтобы это сработало, воздух должен быть свежим и в меру влажным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830412
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3830412,
					"content": "Понятно... Море или горы, так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3830413,
					"content": "Значит, самое подходящее место для игры на Лире - это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830414,
						3830415,
						3830416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3830414,
					"content": "Скала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830418,
					"content": "На востоке от озера Звездопадов есть высокая скала. Ты найдёшь её, если будешь двигаться на юг вдоль пляжа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830419
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3830419,
					"content": "#Это тот самый пляж, на котором ты рассказал{F#а} Паймон о {F#своём брате}{M#своей сестре}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3830420,
					"content": "В общем, там ты найдёшь <color=#00E1FFFF>утёс Звездолова</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830421
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3830421,
					"content": "Там есть и высокая скала, и морской ветер. Такое место подойдёт, бард?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830422
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3830422,
					"content": "Хм... Дайте подумать. Утёс Звездолова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830423
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3830423,
					"content": "Хорошо. Пусть будет утёс Звездолова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830424
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3830424,
					"content": "Отлично! Тогда встретимся на месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830425
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3830425,
					"content": "Пожалуйста, не опаздывайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830426
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3830426,
					"content": "Будет сделано, магистр!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3830427,
					"content": "Ох... Прошу прощения, я случайно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3830415,
					"content": "Побережье?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830416,
					"content": "Небо? Можно парить на планере и играть на Лире...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830417
					]
				},
				{
					"id": 3830417,
					"content": "Даже Эмбер не стала бы таким заниматься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830418
					],
					"speakerTitle": "Джинн"
				}
			]
		}
	]
}