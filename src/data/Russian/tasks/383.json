			"dialogs": [
				{
					"id": 3830201,
					"content": "Ух ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3830202,
					"content": "Отряд защитников Двалина, стройся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3830203,
					"content": "Что ж, давайте посмотрим на собранные кристаллы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830204
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3830204,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830205
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3830205,
					"content": "Они все осквернены...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830206
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3830206,
					"content": "Двалин... Сколько же страданий выпало на твою долю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830207
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3830207,
					"content": "#Прошу тебя, Путешественн{F#ица}{M#ик}, давай очистим эти кристаллы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830208
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3830208,
					"content": "В это сложно поверить, пока не увидишь своими глазами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830209
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3830209,
					"content": "Очень интересно. Процесс напоминает фильтрацию вина. За этим приятно наблюдать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830210
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3830210,
					"content": "Нам должно хватить этих кристаллов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		},
		{
			"id": 38303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
