			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Друсус"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030101,
					"content": "Неплохое местечко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030102
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030102,
					"content": "Ты снова работаешь над загадками?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030103
					]
				},
				{
					"id": 735030103,
					"content": "#{NICKNAME}! Ты как раз вовремя. Я работаю над совершенно новой серией загадок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030104
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030104,
					"content": "Местность здесь сложновата, конечно. Смотри, с одной стороны гавани в воду уходят огромные корни Священного древа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030105
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030105,
					"content": "А с другой стороны, у нас огромный лист лотоса и целый ряд кораблей, что вот-вот отправятся в плавание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030106
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030106,
					"content": "#{NICKNAME}, какая сторона лучше подходит для загадки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030107,
						735030110,
						735030113
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030107,
					"content": "Лучше взять за основу корни.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030108
					]
				},
				{
					"id": 735030108,
					"content": "Думаешь? Хотя да, корни Священного древа легко заметить. Значит, они станут удобной отправной точкой для загадки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030109
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030109,
					"content": "Хорошо! Придумаю загадку о корнях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030115,
					"content": "Хи-хи, дай-ка я напишу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030115,
						735030116
					]
				},
				{
					"id": 735030116,
					"content": "Хи-хи, дай-ка мне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030117
					]
				},
				{
					"id": 735030117,
					"content": "Ты чего так радостно хихикаешь?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735030118,
					"content": "Готово, прочти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030119
					]
				},
				{
					"id": 735030119,
					"content": "«Там, где мудрость возвращается в море, сокровища находятся под парусами».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030120
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030120,
					"content": "Неплохо получилось! Люди сразу подумают о порте, как прочитают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030121
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030121,
					"content": "Затем они сопоставят это с фразой «там, где мудрость возвращается в море». И догадаются, что место связано с Академией или с городом Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030122
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030122,
					"content": "Вот уж не думал, что у тебя талант к придумыванию загадок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030123
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030123,
					"content": "Минуточку, я положу загадку куда-нибудь, где её можно легко отыскать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030124
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030124,
					"content": "Оставим её здесь? Но ведь место из загадки совсем неподалёку. Так люди быстро всё поймут!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735030125,
					"content": "Ха-ха-ха, нужно как-то очертить зону поиска разгадки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030126
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030126,
					"content": "А то разгадывающий может и не понять, потому что вариантов будет слишком много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030127
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030127,
					"content": "Друсус размещает загадку...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030128
					]
				},
				{
					"id": 735030128,
					"content": "Ну вот, эта загадка готова. Пойдём к следующему месту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030129
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030129,
					"content": "Хм? У тебя наготове ещё одно местечко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735030110,
					"content": "Лист лотоса и корабль. Получится интересно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030111
					]
				},
				{
					"id": 735030111,
					"content": "Действительно, будет забавно, если мы свяжем их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030112
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030112,
					"content": "Хорошо, я придумаю загадку на эту тему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030113,
					"content": "Это слишком легко!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030114
					]
				},
				{
					"id": 735030114,
					"content": "Слишком легко? У тебя есть предложения получше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Друсус"
				}
			]
		},
		{
			"id": 7350302,
			"completionStepIds": [
				7350302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350302",
							"2"
						],
						"stepId": 7350302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Друсус"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030201,
					"content": "Так! Давай поместим вторую загадку сюда. Как разгадают её, можно будет отправляться за последним сундуком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030202
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030202,
					"content": "Последнее сокровище я оставлю... здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030203
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030203,
					"content": "А...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735030204,
					"content": "Уф...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030205
					]
				},
				{
					"id": 735030205,
					"content": "Здесь? Но ведь это же самый обычный холм с самым что ни на есть обычным водопадом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735030206,
					"content": "Вот именно! Но скоро они перестанут быть такими обычными, благодаря нашей загадке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030207
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030207,
					"content": "#Ну что, путешественни{F#ца}{M#к}, есть у тебя какие-то мысли по поводу этой загадки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030208,
						735030211,
						735030214
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030208,
					"content": "Давай уже, выкладывай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030209
					]
				},
				{
					"id": 735030209,
					"content": "Что, ни одной мыслишки? Эх, даже великие разгадыватели устают, добравшись сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030210
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030210,
					"content": "Ладно, надо придумать что-то попроще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030219,
					"content": "#Да ничего я не учил{F#ась}{M#ся}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030219,
						735030220
					]
				},
				{
					"id": 735030220,
					"content": "Весь секрет в практике.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030221
					]
				},
				{
					"id": 735030221,
					"content": "Вот как... Вполне в твоём духе! Вот это знания! Ладно, эту загадку я размещу вот здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030222
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030222,
					"content": "Друсус размещает загадку...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030223
					]
				},
				{
					"id": 735030223,
					"content": "Ну вот! На этой доске объявлений кто-нибудь точно её увидит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030224
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030224,
					"content": "Настал черёд последнего сундука.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030211,
					"content": "Можно взять за основу водопад.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030212
					]
				},
				{
					"id": 735030212,
					"content": "Хм... Да, водопад отлично отгадывается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030213
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030213,
					"content": "Хорошо, пусть загадка будет о нём. Что касается сложности... нужно её слегка понизить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030214,
					"content": "Хи-хи-хи, дай-ка я напишу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030215
					]
				},
				{
					"id": 735030215,
					"content": "А смех-то у тебя всё звонче и звонче!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735030216,
					"content": "Готово.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030217
					]
				},
				{
					"id": 735030217,
					"content": "«Зелёный зонтик созерцает занавес из жемчуга».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030218
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030218,
					"content": "#Эта загадка особенно «загадочна». Где это ты научил{F#ась}{M#ся} такое придумывать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Друсус"
				}
			]
		},
		{
			"id": 7350303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"1",
							"73503"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030301,
					"content": "«Испытай мелкие моря этой ветвью мудрости».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сундук с загадкой"
				}
			]
		},
		{
			"id": 7350304,
			"completionStepIds": [
				7350304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350304",
							"2"
						],
						"stepId": 7350304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Друсус"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030401,
					"content": "Это последний сундук. В него загадку мы класть не будем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030402
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030402,
					"content": "Что же туда положить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030403,
						735030406,
						735030409
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030403,
					"content": "Что-нибудь ценное.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030404
					]
				},
				{
					"id": 735030404,
					"content": "Согласен. И ценность этой вещи должна соответствовать сложности наших загадок. Ведь тот, кому достанется сундук, смог решить их все.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030405
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030405,
					"content": "Ценное... ценное... сразу мора в голову приходит. Ну, положу тогда побольше моры и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030413,
					"content": "#Отлично, с этой загадкой мы тоже закончили. Благодарю за помощь, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030414
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030414,
					"content": "Вот, возьми свою награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030415
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030415,
					"content": "Эх! Хотел затронуть с тобой тему загадок поглубже, но мне нужно бежать по делам в Академию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030416
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030416,
					"content": "Если в будущем обнаружишь какие-нибудь интересные загадки и не сможешь их разгадать, обращайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030417
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030417,
					"content": "Мы детально обсудим их, а потом... напридумываем новых загадок для искателей приключений! Ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030418
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030418,
					"content": "#Ну, пойду я. Удачи на твоём пути, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030419
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030419,
					"content": "Надеюсь, печально известная Похитительница сокровищ Нарзам не доставит серьёзных хлопот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030406,
					"content": "Что-то, что имеет ценность с практической точки зрения.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030407
					]
				},
				{
					"id": 735030407,
					"content": "Ценность с практической точки зрения? Что это может быть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030408
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030408,
					"content": "Вспомнил! Со мной недавно рецептом поделились. Пусть он и станет наградой тому, кто найдёт этот сундук.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030409,
					"content": "Возможность потренировать мозги - лучшее из сокровищ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030410
					]
				},
				{
					"id": 735030410,
					"content": "Ха-ха-ха-ха, золотые слова! Лучше и не скажешь! Это действительно бесценный опыт. И никакие сокровища с ним не сравнятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030411
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735030411,
					"content": "Что за чепуха?! Положите туда моры или рецепт! Ну или фрукты с овощами, но только в самом крайнем случае. Нужно обязательно что-нибудь положить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735030412,
					"content": "Шучу я, шучу. Я обязательно положу туда какую-нибудь награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Друсус"
				}
			]
		},
