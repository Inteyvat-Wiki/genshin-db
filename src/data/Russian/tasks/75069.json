			},
			"dialogs": [
				{
					"id": 750691101,
					"content": "Водопад, хе-хе... От шума водопада в ушах постоянно звенит и не слышно ничего другого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691102
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750691102,
					"content": "А, это ты... Я что-то могу для тебя сделать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691103
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750691103,
					"content": "Ничего.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691104
					]
				},
				{
					"id": 750691104,
					"content": "#Да?.. Прислушайся к моему совету, {M#воин}{F#воительница}. Уходи скорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кенин"
				}
			]
		},
