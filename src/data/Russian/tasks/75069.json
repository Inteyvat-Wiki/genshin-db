			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кенин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690201,
					"content": "Ох, сюда мало кто заходит. Это опасное место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690202
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750690202,
					"content": "Ты тоже из отряда искателей приключений? Хм, говорят, тень тёмного гигантского змея спустилась с «Тонатиу». Будь осторожнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690203
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750690203,
					"content": "Или лучше уходи, пока можешь. В этом отряде есть нечеловеческие существа... Эти голоса, эти проклятия... Так шумно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690204
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750690204,
					"content": "Здесь я могу обрести немного спокойствия... Водопад... Шум водопада заглушает остальные звуки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кенин"
				}
			]
		},
		{
			"id": 7506905,
			"completionStepIds": [
				7506903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7506903",
							"2"
						],
						"stepId": 7506903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690501,
					"content": "(Порванная страница с аккуратным почерком в начале...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690502
					],
					"speakerTitle": "Дневник Кенина"
				},
				{
					"id": 750690502,
					"content": "«...Чудовищ Бездны становится всё больше, это было предсказуемо... В конце концов, отряд оказался не в силах справиться с противником. План эвакуации уже реализуется...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690503
					],
					"speakerTitle": "Дневник Кенина"
				},
				{
					"id": 750690503,
					"content": "«Мы должны помочь оставшимся безопасно эвакуироваться. Опасайтесь тех, кто исчезает по ночам или возвращается из темноты».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690504
					],
					"speakerTitle": "Дневник Кенина"
				},
				{
					"id": 750690504,
					"content": "«...Чудовищ Бездны становится всё больше. Они могут обнаружить нашу базу, но сперва мы должны...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690505
					],
					"speakerTitle": "Дневник Кенина"
				},
				{
					"id": 750690505,
					"content": "(Дальше почерк становится неразборчивым...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690506
					],
					"speakerTitle": "Дневник Кенина"
				},
				{
					"id": 750690506,
					"content": "«Ах, холодно... Как холодно... Вот там... и кровь вытекает...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690507
					],
					"speakerTitle": "Дневник Кенина"
				},
				{
					"id": 750690507,
					"content": "«Водопад очень громкий. Да, именно так. Всё будет хорошо. Если так... Если я буду стоять под водопадом, то стану спокойным. Белые лица, открытые рты, бегущая кровь...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690508
					],
					"speakerTitle": "Дневник Кенина"
				},
				{
					"id": 750690508,
					"content": "«Там... что-то... там что-то есть...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690509
					],
					"speakerTitle": "Дневник Кенина"
				},
				{
					"id": 750690509,
					"content": "«Под водопадом под водопадом под водопадом под водопадом под водопадом под водопадом под водопадом под водопадом под водопадом...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дневник Кенина"
				}
			]
		},
		{
			"id": 7506908,
			"completionStepIds": [
				7506908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
