			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690801,
					"content": "(Холодное, похожее на статую тело человека, напоминающего Кенина. Каким-то образом сохранилось без следов разложения. Кажется застывшим во времени...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690802
					],
					"speakerTitle": "Мёрзлое тело"
				},
				{
					"id": 750690802,
					"content": "(И судя по обстановке, в таком состоянии он пребывает уже долгое время...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мёрзлое тело"
				}
			]
		},
