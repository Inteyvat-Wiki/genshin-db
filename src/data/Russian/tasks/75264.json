				"points": []
			},
			"dialogs": [
				{
					"id": 752640401,
					"content": "Слушай, вы схватили не того парня... Моего наставника зовут Канэй, а меня Джака... Вам нужно отправиться за ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640402
					],
					"speakerTitle": "Джака"
				},
				{
					"id": 752640402,
					"content": "Я не смогу делать фигурки так, как мой наставник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640403
					],
					"speakerTitle": "Джака"
				},
				{
					"id": 752640403,
					"content": "Тебя похитили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752640404
					]
				},
				{
					"id": 752640404,
					"content": "А что, вы разве с ними не заодно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640405
					],
					"speakerTitle": "Джака"
				},
				{
					"id": 752640405,
					"content": "Конечно, нет. Разве ты не видишь, что мы разогнали их?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752640406,
					"content": "Вот как? Отлично! Я свободен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640407
					],
					"speakerTitle": "Джака"
				},
				{
					"id": 752640407,
					"content": "Можешь возвращаться домой. Но... что же здесь произошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752640408,
					"content": "Эти ребята появились из ниоткуда и хотели подделать фигурки, которые продаются на курорте. Но у них ничего не вышло, поэтому они попытались похитить моего наставника, Канэя, чтобы он им помогал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640409
					],
					"speakerTitle": "Джака"
				},
				{
					"id": 752640409,
					"content": "Но что-то пошло не так, и они по ошибке схватили меня... Ох, я же всего три дня учусь рисовать у своего наставника... У меня нет никакой квалификации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640410
					],
					"speakerTitle": "Джака"
				},
				{
					"id": 752640410,
					"content": "Спасибо вам за спасение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640411
					],
					"speakerTitle": "Джака"
				},
				{
					"id": 752640411,
					"content": "Ажка, идём домой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640412
					],
					"speakerTitle": "Джака"
				},
				{
					"id": 752640412,
					"content": "~~~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ажка"
				}
			]
		}
