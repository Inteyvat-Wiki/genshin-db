			"dialogs": [
				{
					"id": 750000101,
					"content": "Эй, здоровяк! Всё хорошо? Встать сможешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750000102,
					"content": "Ой, ему совсем плохо! Что же случилось? Как же надоели эти летающие призрачные псы! И вообще, от летучек не жди ничего хорошего!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750000103,
					"content": "Ты ведь сама летаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000104
					]
				},
				{
					"id": 750000104,
					"content": "Паймон не такая, как они!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750000105,
					"content": "#Ладно, об этом потом поговорим! {NICKNAME}, посмотри скорее, у нас осталась еда? Надо его накормить... а потом пусть отдохнёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750000106,
					"content": "И тогда скоро будет как новенький!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000107,
						750000108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750000107,
					"content": "Поздно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				},
				{
					"id": 750000109,
					"content": "Нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750000110,
					"content": "*тяжело дышит*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000111
					],
					"speakerTitle": "Здоровяк?"
				},
				{
					"id": 750000111,
					"content": "#Нет. {NICKNAME}, ему, наверное, ужасно больно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000112,
						750000113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750000112,
					"content": "Мы победили твоих врагов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000114,
					"content": "*тяжело дышит*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000115
					],
					"speakerTitle": "Здоровяк?"
				},
				{
					"id": 750000115,
					"content": "Тебя... ещё что-то тревожит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000116
					]
				},
				{
					"id": 750000116,
					"content": "Ты хочешь... ещё что-то сказать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000117
					]
				},
				{
					"id": 750000117,
					"content": "#Дай... дай руку. {F#Избранница}{M#Избранник} драконов... дай мне руку...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000118
					]
				},
				{
					"id": 750000118,
					"content": "Объединить... силы. И тогда... увидеть всё и... освободить всех...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000119
					]
				},
				{
					"id": 750000119,
					"content": "#{NICKNAME}, что происходит? Надо действовать! А ты витаешь в облаках!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750000120,
					"content": "Нет, просто голова немного закружилась...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000121
					]
				},
				{
					"id": 750000121,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000122
					],
					"speakerTitle": "Здоровяк?"
				},
				{
					"id": 750000122,
					"content": "...Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000123
					],
					"speakerTitle": "Здоровяк?"
				},
				{
					"id": 750000123,
					"content": "Это твоё желание? Или...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000124
					]
				},
				{
					"id": 750000124,
					"content": "(Протянуть руку к умирающему зверю...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000125
					]
				},
				{
					"id": 750000125,
					"content": "Что ты делаешь? Ой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750000126,
					"content": "#{NICKNAME}, ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750000113,
					"content": "Можешь отдыхать, здоровяк. Ты молодец.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000108,
					"content": "Он слишком долго держался...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				}
			]
		},
