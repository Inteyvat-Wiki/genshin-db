			"dialogs": [
				{
					"id": 715340101,
					"content": "Хм, наверное, нужно сначала посмотреть на другие подарочные конверты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340102
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 715340102,
					"content": "#О, {NICKNAME}! Давно не виделись... Почему ты так {F#удивлена}{M#удивлён}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340103
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 715340103,
					"content": "#Я не ожидал{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340104
					]
				},
				{
					"id": 715340104,
					"content": "Увидеть, как воин вроде меня наслаждается Праздником морских фонарей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340105
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 715340105,
					"content": "#Я никогда не видел{F#а}, чтобы ты отдыхала...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340106
					]
				},
				{
					"id": 715340106,
					"content": "Комиссия Тэнрё несёт большую ответственность перед населением. Как член комиссии, я большую часть времени не могу позволить себе расслабиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340107
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 715340107,
					"content": "Возможно, люди воспринимают меня как одинокого воина, совершенно неуместного в таком праздничном и изысканном районе, как Ханамидзака.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340108
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 715340108,
					"content": "Но ослабить бдительность - значит позволить преступлению совершиться... Это негативно сказывается не только на моём долге, но и на атмосфере Ханамидзаки в целом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340109
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 715340109,
					"content": "Самое большее, что я могу сделать, - это воспользоваться любой свободной минуткой, которая подвернулась мне под руку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340110
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 715340110,
					"content": "Ах, прошу прощения. Я не должна говорить о таких серьёзных вещах во время праздника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340111
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 715340111,
					"content": "Я пытаюсь смастерить подарочный конверт, но у меня не получается. Может, дашь мне совет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340112
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 715340112,
					"content": "Хорошо, дай-ка подумать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
