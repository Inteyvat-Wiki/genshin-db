			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хамави"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110301,
					"content": "Вот незадача...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110302
					],
					"speakerTitle": "Хамави"
				},
				{
					"id": 230110302,
					"content": "Насчёт древесины для Виктора...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110303
					]
				},
				{
					"id": 230110303,
					"content": "Ты имеешь в виду древесину, которую у меня заказал тот Фатуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110304
					],
					"speakerTitle": "Хамави"
				},
				{
					"id": 230110304,
					"content": "Даже не напоминай. Вот что я тебе скажу: связываться с Фатуи - гиблое дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110305
					],
					"speakerTitle": "Хамави"
				},
				{
					"id": 230110305,
					"content": "На полпути на повозку с древесиной напали монстры. Людям удалось спастись, а вот повозка развалилась, брёвна так и остались где-то лежать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110306
					],
					"speakerTitle": "Хамави"
				},
				{
					"id": 230110306,
					"content": "Я не смею туда идти, и не могу найти того, кто бы помог избавиться от монстров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110308
					],
					"speakerTitle": "Хамави"
				},
				{
					"id": 230110308,
					"content": "Я не Фатуи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110309
					]
				},
				{
					"id": 230110309,
					"content": "Ты не Фатуи? Зачем же тогда ему помогаешь? Странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110310
					],
					"speakerTitle": "Хамави"
				},
				{
					"id": 230110310,
					"content": "Как бы то ни было, эту повозку я вернуть не могу. Остаётся лишь надеяться, что я смогу нанять кого-то в помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110311
					],
					"speakerTitle": "Хамави"
				},
				{
					"id": 230110311,
					"content": "Если тебе так срочно нужна древесина, я отмечу на твоей карте примерное местонахождение повозки. Можешь сходить и посмотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110312
					],
					"speakerTitle": "Хамави"
				},
				{
					"id": 230110312,
					"content": "Эх, если связался с Фатуи, не жди ничего хорошего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хамави"
				}
			]
		},
