			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Виктор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110101,
					"content": "Эм... Как же это вырезать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110102,
						230110103
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110102,
					"content": "Привет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				},
				{
					"id": 230110104,
					"content": "Ох, ну кто там ещё? Хватит меня отвлекать, я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110105
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110105,
					"content": "#{NICKNAME}?! Что ты делаешь в Сумеру?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110106
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110106,
					"content": "Это Рудольф послал тебя, чтобы меня побить? Я всего лишь преподнёс Лили небольшой подарок, но это было давно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110107,
						230110109
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110107,
					"content": "Я просто путешествую...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110108
					]
				},
				{
					"id": 230110108,
					"content": "Ты всё так же путешествуешь? Да, энергии в тебе хоть отбавляй...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110112,
					"content": "Вот уж действительно не ожидал тебя увидеть в Сумеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110113
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110113,
					"content": "Во время перевода из Мондштадта я получил приказ вернуться в Снежную.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110114
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110114,
					"content": "Однако на полпути пришёл новый приказ: мне нужно было явиться в Сумеру, чтобы помочь в работе господину Всеволоду, также я узнал, что меня перевели в подчинение господина Пульчинеллы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110115,
						230110116
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110115,
					"content": "Пульчинеллы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110117,
					"content": "Ага... Ой, лучше буду держать язык за зубами, а то господин Всеволод опять скажет, что я не гожусь для секретных заданий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110118
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110118,
					"content": "Имена этих Предвестников вовсе никакая не тайна. Странно, что он так об этом печётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110119
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110119,
					"content": "А что ты делаешь в Сумеру?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110120
					]
				},
				{
					"id": 230110120,
					"content": "Эм, мы с господином Всеволодом в основном отвечаем за тыловое снабжение. Проще говоря, занимаемся закупками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110121
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110121,
					"content": "Звучит, конечно, не очень серьёзно, но это куда лучше, чем всё время торчать в соборе Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110122
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110122,
					"content": "К тому же, хе-хе, с такой работой полно свободного времени, и никто за тобой не следит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110123
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110123,
					"content": "В детстве я увлекался резьбой по дереву, а поскольку в Сумеру деревьев в избытке, мне удалось неплохо набить руку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110124
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110124,
					"content": "Кто бы мог подумать, что сделанные мною вещицы так понравятся детям. Малышня не давала мне проходу, и я пообещал, что вырежу каждому по игрушке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110125,
						230110128
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110125,
					"content": "Ты же Фатуи!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110126
					]
				},
				{
					"id": 230110126,
					"content": "Ну да, и что? Архонт тебя побери... Кто сказал, что Фатуи не могут дарить игрушки детям?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110127
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110127,
					"content": "К тому же я всего лишь отвечаю за снабжение, а с серьёзными проблемами пускай теперь разбираются серьёзные ребята.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110130,
					"content": "В общем, всё просто. Мне не удалось вернуться в Снежную, но я в восторге от Сумеру. Я ни в чём не нуждаюсь, да и обстановка здесь - что надо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110131
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110131,
					"content": "После работы я чем-нибудь перекусываю, затем нахожу местечко с хорошим освещением и принимаюсь за резьбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110132
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110132,
					"content": "Несмотря на то, что... ха-ха, все смотрят на меня с некоторым недоверием, совсем как ты в наш первый разговор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110133
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110133,
					"content": "Но ничего не поделаешь. Никто не заставлял меня становиться Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110134,
						230110135
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110134,
					"content": "Я и сейчас тебе не доверяю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110136,
					"content": "Ну что ж... В общем, я доволен своей жизнью, к тому же у меня есть кое-какие сбережения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110137
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110137,
					"content": "Кто знает, может, через несколько лет, я поселюсь в Сумеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110138
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110138,
					"content": "#Не будем об этом. Путешественни{F#ца}{M#к}, раз уж ты тоже в Сумеру, давай продолжим наш «равноценный обмен», если тебе это интересно, конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110139
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110139,
					"content": "Однако на этот раз я отплачу не историей, а деньгами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110140,
						230110141
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110140,
					"content": "Так даже лучше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110143
					]
				},
				{
					"id": 230110143,
					"content": "Давай объясню, в чём суть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110144
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110144,
					"content": "На днях я заказал у Хамави древесину, но так ничего от него и не получил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110145
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110145,
					"content": "Мой рабочий день ещё не закончен, я не могу сам отправиться к нему, иначе господин Всеволод снова меня отчитает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110146
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110146,
					"content": "#Путешественни{F#ца}{M#к}, сможешь от моего имени узнать у Хамави, когда он доставит мою древесину?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110147,
						230110149
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110147,
					"content": "Готовь награду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110148
					]
				},
				{
					"id": 230110148,
					"content": "Не волнуйся, я позабочусь о награде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110151,
					"content": "#В общем, я рассчитываю на твою помощь, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110149,
					"content": "Ты же ничего не задумал?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110150
					]
				},
				{
					"id": 230110150,
					"content": "Разве в прошлую нашу сделку я осуществил какой-то коварный план? Не беспокойся. К чему мне лишние хлопоты? Не лучше ли жить спокойно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110141,
					"content": "Поручение от Фатуи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110142
					]
				},
				{
					"id": 230110142,
					"content": "Нет, что ты, всего лишь от Виктора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110143
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110135,
					"content": "Да кто тебе поверит?! Хватит набиваться в друзья!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110128,
					"content": "И ты не пытаешься выудить из детей хоть какие-то сведения?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110129
					]
				},
				{
					"id": 230110129,
					"content": "Эй! Я таким не занимаюсь! Что за жуткие стереотипы о Фатуи?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110116,
					"content": "Ещё один Предвестник?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110109,
					"content": "Ага, возвращайся со мной в Мондштадт!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110110
					]
				},
				{
					"id": 230110110,
					"content": "Ха-ха-ха, хорошо. Может, наденешь на меня наручники?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110111
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110111,
					"content": "Ладно, хватит шутить. Мне ещё работать надо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110103,
					"content": "Виктор?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				}
			]
		},
