				"points": []
			},
			"dialogs": [
				{
					"id": 230110601,
					"content": "Ну что? Древесину, которую я купил, уже доставили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110602
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110602,
					"content": "Вы рассказываете Виктору о произошедшем...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230110603
					]
				},
				{
					"id": 230110603,
					"content": "Опять монстры? У меня такое чувство, будто все повозки в мире притягивают монстров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110604
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110604,
					"content": "Ладно, неважно. Главное, что древесину доставят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110605
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110605,
					"content": "А вот и обещанное вознаграждение. Не забудь пересчитать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110606
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110606,
					"content": "Да, и ещё кое-что... Как там Лили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110607
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110607,
					"content": "Я с ней так и не попрощался. Она ведь на меня не сердится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110608,
						230110610
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110608,
					"content": "Она в полном порядке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110609
					]
				},
				{
					"id": 230110609,
					"content": "Вот и славно, кхм... И не надо на меня так смотреть, я просто поинтересовался!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110614,
					"content": "#Ну да ладно. Пересчитай ещё раз награду, путешественни{F#ца}{M#к}, всё должно быть правильно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110610,
					"content": "Можешь сам её навестить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110611
					]
				},
				{
					"id": 230110611,
					"content": "Тогда господин Всеволод устроит мне взбучку. Ладно, неважно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110612
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110612,
					"content": "Я даже письмо не решаюсь отправить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110613
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 230110613,
					"content": "Ведь получить письмо от Фатуи - не к добру, ха-ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Виктор"
				}
			]
		}
