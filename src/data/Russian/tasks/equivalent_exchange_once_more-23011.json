	"talks": [
		{
			"id": 2301101,
			"completionStepIds": [
				2301101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
