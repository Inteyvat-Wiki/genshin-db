					"Цяо Си"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "Как же быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "Цяо Си"
				},
				{
					"id": 210033002,
					"content": "Что стряслось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "Эй! Вы кто такие? Все, кто хочет пройти через мост, должны ответить на вопросы. Таковы правила!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "Цяо Си"
				},
				{
					"id": 210033004,
					"content": "#Хотя, судя по твоей одежде... Ты не очень похож{F#а} на злодея.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "Цяо Си"
				},
				{
					"id": 210033005,
					"content": "#Почему я так решил? Подумай, если бы злодей хотел перейти через мост, то, наверное, он оделся бы как-нибудь неприметно. Ты же, напротив, одет{F#а} весьма демонстративно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "Цяо Си"
				},
				{
					"id": 210033015,
					"content": "Чем ты тут занимаешься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "Цяо Си"
				},
				{
					"id": 210033006,
					"content": "Я солдат Миллелитов, ответственный за эту территорию. Через этот мост лежит путь к Тростниковым островам. Все путешественники и купцы используют этот маршрут, а я обеспечиваю их безопасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "Цяо Си"
				},
				{
					"id": 210033007,
					"content": "Пару дней назад я обнаружил группу монстров неподалёку. По всей видимости, они разбили здесь свой лагерь. Никаких нападений пока не произошло, но эти монстры всё равно представляют серьёзную угрозу безопасности путешественников. Я продолжаю наблюдение за ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "Цяо Си"
				},
				{
					"id": 210033008,
					"content": "Я бы с удовольствием расправился с ними сам, но если я покину свой пост, то какие-нибудь другие монстры смогут напасть на путешественников. Мне остаётся лишь ждать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "Цяо Си"
				},
				{
					"id": 210033009,
					"content": "Проблема с монстрами решена.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "Серьёзно? Это отличные новости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "Цяо Си"
				},
				{
					"id": 210033011,
					"content": "Спасибо тебе! Я должен был сделать это сам, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "Цяо Си"
				},
				{
					"id": 210033012,
					"content": "Даже не знаю, о чём думает командование. Им следует направить больше людей для охраны такой обширной территории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "Цяо Си"
				},
				{
					"id": 210033013,
					"content": "Я предоставлю им подробный доклад, как только у меня появится такая возможность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "Цяо Си"
				},
				{
					"id": 210033014,
					"content": "Благодарю за помощь. Вот твоя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цяо Си"
				}
			]
		},
