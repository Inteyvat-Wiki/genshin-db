					"Хуай Ань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221010101,
					"content": "Не видно ни конца, ни края...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010102
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010103
					]
				},
				{
					"id": 221010103,
					"content": "Эх... Непросто держать гостиницу в таком месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010104
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010104,
					"content": "В этих краях всё больше и больше монстров... Или мне просто так кажется...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010105
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010105,
					"content": "Монстры не осмеливаются приближаться к постоялому двору, но гостям нужно как-то до меня добираться. А у Миллелитов и без того работы хватает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010106
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010106,
					"content": "Если у тебя найдётся свободная минутка, разберись с этими чудовищами, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010107,
						221010108
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010107,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010109
					]
				},
				{
					"id": 221010109,
					"content": "Ха! Это хороший вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010113,
					"content": "Говоря о непростой работе... Не хотелось просить тебя об этом, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010114
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010114,
					"content": "#Будь уверен{F#а}, твои труды будут вознаграждены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010115
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010115,
					"content": "Спасибо. Желаю удачи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010108,
					"content": "Зачем же открывать гостиницу в таком месте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010110
					]
				},
				{
					"id": 221010110,
					"content": "Стоило подумать об этом перед тем, как открывать здесь гостиницу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010111
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010111,
					"content": "Но если бы не мы, то путешественникам было бы негде остановиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010112
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010112,
					"content": "Это непростая работа, но кто-то должен её делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Хуай Ань"
				}
			]
		},
		{
			"id": 2210102,
