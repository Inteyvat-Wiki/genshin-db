				"points": []
			},
			"dialogs": [
				{
					"id": 221010201,
					"content": "#Как идут дела? Избавил{F#ась}{M#ся} от монстров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010202
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010202,
					"content": "Пока ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010203
					]
				},
				{
					"id": 221010203,
					"content": "Понятно. Не спеши. Эти монстры могут навредить путешественникам, но, по крайней мере, постоялый двор в безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010204
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010204,
					"content": "В худшем случае, если парочка монстров забредёт ко мне в гостиницу, я смогу с ними... договориться. Безопасность постояльцев превыше всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010205
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010205,
					"content": "Если твоя гостиница находится так далеко от города, ты должен уметь за себя постоять!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				}
			]
		},
