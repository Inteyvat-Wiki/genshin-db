			"dialogs": [
				{
					"id": 221010301,
					"content": "#Как идут дела? Избавил{F#ась}{M#ся} от монстров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010302
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010302,
					"content": "Проблема решена.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010303
					]
				},
				{
					"id": 221010303,
					"content": "Отлично. Спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010304
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010304,
					"content": "Вот твоя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010305
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221010305,
					"content": "В наше время, если ты не можешь за себя постоять, то даже и не думай открывать гостиницу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				}
			]
		}
