				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Орбан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751970102,
					"content": "#Хорошо, что ты {F#зашла}{M#зашёл}. Насчёт тех клыков... А, так ты уже все {F#собрала}{M#собрал}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970103
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 751970103,
					"content": "Пока вы были заняты исследованием, у меня возникла одна проблемка. Сколько бы я этот клык молотом ни бил, ни крошки не отскакивает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970104
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 751970104,
					"content": "С таким я сталкиваюсь впервые, поэтому поручил обратиться к господину Альбедо за советом - как поступить с этим необычным материалом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970105
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 751970105,
					"content": "И вот, если вы посмотрите вон туда, то увидите, что господин Альбедо попросил госпожу Сахарозу принести рунный камень. Он лежит на алхимическом верстаке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970106
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 751970106,
					"content": "Рунный камень? Он как-то связан с нашими драконьими клыками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751970107,
					"content": "Ну, согласно тому, что госпожа Сахароза передала нам от господина Альбедо, для того чтобы использовать этот материал для ковки оружия, мы должны подвергнуть его специальной обработке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970108
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 751970108,
					"content": "Один из способов такой обработки - наполнить клык некой «жизненной силой» дракона, а затем использовать его для работы с другими клыками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970109
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 751970109,
					"content": "Что касается того, что госпожа Сахароза говорила о рунном камне... Ах да, это «реликвия, оставленная ордену Ордо Фавониус Бродячим ансамблем. Она помогла Мондштадту восстать против аристократов тысячу лет назад».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970110
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 751970110,
					"content": "Флейтист этого ансамбля однажды сразился с чудовищем, известным как Бакунава, в Пепельном море. Этот рунный камень был вырезан из его тела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970111
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 751970111,
					"content": "А? Погоди. Если Паймон не изменяет память, Ситлали рассказывала, что Пепельное море образовалось из-за битвы Санхаджа с Бездной пятьсот лет назад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751970112,
					"content": "Этот ансамбль точно существовал тысячу лет назад?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970113
					]
				},
				{
					"id": 751970113,
					"content": "Ха-ха, ошибки быть не может! О подвигах Бродячего ансамбля в эпоху аристократов говорится в «Истории королей и кланов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970114
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 751970114,
					"content": "Словом, господин Альбедо сказал, что в этом рунном камне заключена «бесконечная жизненная сила», сравнимая с силой дракона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970115
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 751970115,
					"content": "Нужно лишь использовать драконий клык, чтобы поглотить жизненную силу рунного камня с помощью алхимического верстака. После этого мы наконец сможем приступить к ковке нашего оружия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970116
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 751970116,
					"content": "Ничего себе... Нужно отдать Альбедо должное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970117,
						751970119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751970117,
					"content": "При случае отблагодарим его.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970118
					]
				},
				{
					"id": 751970118,
					"content": "#Точно! Что бы мы без него делали?.. {NICKNAME}, давай попробуем поглотить силу рунного камня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751970120,
					"content": "Ха-ха, вот и отлично. Держи клык. Дело теперь за тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970121
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 751970121,
					"content": "Сила алхимии поистине удивительна. Поглотить «жизненную силу» из тысячелетнего камня... Как такое вообще возможно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Орбан"
				},
				{
					"id": 751970119,
					"content": "Хорошо, сейчас я всё сделаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970120
					]
				}
			]
		},
