				"points": []
			},
			"dialogs": [
				{
					"id": 710050501,
					"content": "Мне нужно подумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050502
					]
				},
				{
					"id": 710050502,
					"content": "Эм... Конечно. Подумайте. Возможно, моё предложение - не самое лучшее с точки зрения цены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050503
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 710050503,
					"content": "Но я могу гарантировать, что вы не пожалеете, если отдадите это кольцо мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050504
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 710050504,
					"content": "Подумайте сами. Если вы продадите мне это кольцо сейчас, то в будущем мы сможем заключить ещё больше выгодных сделок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050505
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 710050505,
					"content": "А ещё я добавлю к указанной цене несколько дополнительных предметов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050506
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 710050506,
					"content": "Подумайте хорошенько! Я буду ждать вашего решения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бо Лай"
				}
			]
		},
