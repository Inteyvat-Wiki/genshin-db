				{
					"id": 710050401,
					"content": "Продано.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050402
					]
				},
				{
					"id": 710050402,
					"content": "Славно! Отличное решение. Вот ваши деньги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050403
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 710050403,
					"content": "Это кольцо - настоящее сокровище...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050404
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 710050404,
					"content": "Должно быть, в тех руинах припрятано ещё немало драгоценностей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бо Лай"
				}
			]
		},
		{
			"id": 7100505,
