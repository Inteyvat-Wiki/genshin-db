			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710051201,
					"content": "«Алчность, сожаление, сосредоточенность, зависимость, гнев, похоть, самовосхваление, конкуренция, смута...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051202
					],
					"speakerTitle": "Надпись"
				},
				{
					"id": 710051202,
					"content": "«Эти девять смертоносных желаний могут исцелить этот мир, но могут и разрушить его. Их пламя никогда не ослабнет и никогда не потухнет... Пусть будут воздвигнуты девять колонн, чтобы принести мир, и положить конец войнам».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051203
					],
					"speakerTitle": "Надпись"
				},
				{
					"id": 710051203,
					"content": "«Если грядущие поколения разрушат эти колонны, война вновь поглотит наш мир».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051204
					],
					"speakerTitle": "Надпись"
				},
				{
					"id": 710051204,
					"content": "«Читающий эти строки, возьми же сокровище и принеси мир в Ли Юэ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Надпись"
				}
			]
		},
