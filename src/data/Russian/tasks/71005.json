			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050201,
					"content": "У Паймон мурашки от этих руин, но мы уже приближаемся к выходу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710050202,
					"content": "Наши старания щедро вознаграждены! Мы получили сокровища, и даже то самое кольцо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710050203,
					"content": "Давай найдём кого-нибудь, кто <color=#00E1FFFF>разбирается в древностях</color>. Интересно, за сколько мы сможем его продать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7100503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
