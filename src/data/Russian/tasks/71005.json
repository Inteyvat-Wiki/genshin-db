			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бо Лай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050301,
					"content": "Не мог бы ты взглянуть на этот антиквариат?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050302
					]
				},
				{
					"id": 710050302,
					"content": "Антиквариат? Я в этом плохо разбираюсь, но, пожалуй, взгляну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050303
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 710050303,
					"content": "Это кольцо... Оно украшено нефритовым самоцветом. Отличным самоцветом. Один этот камень стоит целое состояние.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050304
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 710050304,
					"content": "Здесь какая-то надпись... «На войне страдают все»... Где вы нашли это кольцо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050305
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 710050305,
					"content": "В руинах на склоне Зимородка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050306
					]
				},
				{
					"id": 710050306,
					"content": "Склон Зимородка... Эх, как жаль... Совсем недалеко от Заоблачного предела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050307
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 710050307,
					"content": "Вот если бы это кольцо было из Заоблачного предела, то его цена несомненно была бы намного выше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050308
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 710050308,
					"content": "К сожалению, без интересной истории происхождения это кольцо сильно потеряет в цене. Однако это по-прежнему качественная вещица. Наверняка она кого-нибудь заинтересует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050309
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 710050309,
					"content": "Я дам за это кольцо <color=#00E1FFFF>180 000</color> моры и ещё кое-какие вещи. Что скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бо Лай"
				}
			]
		},
