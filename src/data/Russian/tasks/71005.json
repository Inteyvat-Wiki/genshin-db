					"Линь Лан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050901,
					"content": "Не могла бы ты взглянуть на этот антиквариат?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050902
					]
				},
				{
					"id": 710050902,
					"content": "#Антиквариат? Ты обратил{F#ась}{M#ся} к правильному человеку. В Ли Юэ не найдётся более точного оценщика антиквариата. Позволь мне взглянуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050903
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710050903,
					"content": "Хм... Браслет и драгоценный камень превосходного качества. Это древнее изделие... Но оно отлично сохранилось. Это очень и очень странно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050904
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710050904,
					"content": "Но я никогда не встречала эту фразу... «На войне страдают все»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050905
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710050905,
					"content": "#Ладно. Где ты наш{F#ла}{M#ёл} это кольцо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050906
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710050906,
					"content": "В руинах на склоне Зимородка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050907
					]
				},
				{
					"id": 710050907,
					"content": "Склон Зимородка... Мало у кого хватает смелости отправиться туда на поиски сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050908
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710050908,
					"content": "Эти руины были окружены девятью колоннами? А в центре находилась каменная табличка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050909
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710050909,
					"content": "Не удивляйся. Я часто слышу об этом месте от странствующих торговцев. Они всегда предполагают, что там находятся сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050910
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710050910,
					"content": "Иногда они рассказывают, что эти колонны построили основатели Ли Юэ, чтобы положить конец войне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050911
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710050911,
					"content": "Но я думаю, что это всего лишь легенда. В конце концов, если бы войну можно было остановить девятью колоннами, то наш мир был бы гораздо лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050912
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710050912,
					"content": "Правдива легенда или нет, но кольцо было найдено в руинах, а значит оно как-то связано с этой легендой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050913
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710050913,
					"content": "У кольца есть интересная история, к тому же оно мастерски изготовлено. Я дам за него хорошую цену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050914
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710050914,
					"content": "#Расслабься, меня не интересует, как именно ты заполучил{F#а} это кольцо. Меня интересует только бизнес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050915
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710050915,
					"content": "#Перейдём к делу. Я готова дать за кольцо <color=#00E1FFFF>200 000 моры</color>. Соглас{F#на}{M#ен}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лан"
				}
			]
		},
