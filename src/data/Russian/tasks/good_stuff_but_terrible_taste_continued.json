			"dialogs": [
				{
					"id": 740230301,
					"content": "#{M#Дядя}{F#Тётя} {NICKNAME} и сестрёнка Паймон, привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230302,
