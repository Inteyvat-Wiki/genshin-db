	"talks": [
		{
			"id": 7402301,
			"completionStepIds": [
				7402303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7402303",
							"2"
						],
						"stepId": 7402303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сальса",
					"Убу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230101,
					"content": "#Фух, стало намного лучше. Сальса бы нами гордилась, если бы увидела. Правда, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230102,
					"content": "Грабители! Грабёж среди бела дня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230103
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230103,
					"content": "А? Грабители? Где?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230104,
					"content": "Вы и есть грабители! Разрушили моё творение, ещё и сундук забрали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230105,
						740230107
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230105,
					"content": "Всё это и правда натворил член Гильдии...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230106
					]
				},
				{
					"id": 740230106,
					"content": "Натворил? А сами вы что натворили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230109,
					"content": "Значит, эти уродливые штуковины и есть твоё «творение»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230110,
					"content": "Какая бестактность! Что значит «уродливые штуковины»? Ты ничего не слышала об инсталляциях?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230111
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230111,
					"content": "Да, нам предстоит проделать ещё много работы по эстетическому воспитанию публики в Фонтейне. Хотя... вы не похожи на фонтейнцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230112
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230112,
					"content": "#Потому что мы никакие не фонтейнцы. Паймон зовут Паймон, а это {NICKNAME}, он{F#а} тоже состоит в Гильдии искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230113,
						740230115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230113,
					"content": "У-у-у, мы члены гнусного объединения.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230114
					]
				},
				{
					"id": 740230114,
					"content": "Да, но нам можно не носить форму, поэтому мы не «гнусные люди в зелёном»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230117,
					"content": "Меня зовут Убу, я искатель приключений и художник-инсталлятор. Послушал я ваш бред и теперь понимаю, что вы постоянно выкидываете разные странности... Так что не буду призывать вас к ответу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230118
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230118,
					"content": "А? На самом деле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230119,
					"content": "Что? Мне нужно вернуть шедевр на место. Так что если хочешь поблагодарить меня, не затягивай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230120
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230120,
					"content": "Благодарить тебя никто не собирается, а вот проклятий я для тебя припасла целый воз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230121
					],
					"speakerTitle": "Сальса"
				},
				{
					"id": 740230121,
					"content": "Сальса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230122,
					"content": "Сестрёнка Паймон, не бойся, я рядом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230123
					],
					"speakerTitle": "Сальса"
				},
				{
					"id": 740230123,
					"content": "Гнусный человек в зелёном! Мы разрушили все твои ловушки! Прекрати засорять прекрасный Фонтейн своими гнусностями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230124
					],
					"speakerTitle": "Сальса"
				},
				{
					"id": 740230124,
					"content": "Засорять? Подожди, что? Разрушили? Вы разрушили все мои инсталляции?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230125
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230125,
					"content": "Ну, не совсем разрушили... Мы просто немного всё переставили, чтобы они вписывались в пейзаж...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230126,
					"content": "#Ах вы... вы... обыватели! {M#Хулиганы}{F#Хулиганки}! Вы ничего не понимаете в искусстве! Вы превратили мои инсталляции, мои работы... в посредственные композиции...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230127
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230127,
					"content": "Но какое же это искусство? Паймон плохо разбирается в таких вещах, но смотреть на них совсем не хотелось. Разве можно считать их искусством?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230128,
					"content": "Конечно. Только сам художник решает, что есть искусство. Любое произведение, созданное художником, называется произведением искусства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230129
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230129,
					"content": "И кто тут художник?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230130
					],
					"speakerTitle": "Сальса"
				},
				{
					"id": 740230130,
					"content": "Я, а кто ещё? Убу, великий художник-инсталлятор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230131
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230131,
					"content": "В таком случае как основательница «Союза художников во имя будущего Фонтейна и борьбы с гнусным объединением» я объявляю, что твои инсталляции не являются искусством.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230132
					],
					"speakerTitle": "Сальса"
				},
				{
					"id": 740230132,
					"content": "Борьбы с... чем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230133,
						740230135
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230133,
					"content": "Борьбы с гнусным объединением.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230134
					]
				},
				{
					"id": 740230134,
					"content": "Имеется в виду Гильдия искателей приключений, которая портит пейзажи своими... эм... инсталляциями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230136,
					"content": "Что за ерунда! Я никогда не слышал о таком союзе. Девочка, по какому праву ты отрицаешь принадлежность моих инсталляций к искусству?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230137
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230137,
					"content": "Я сама художница. Разумеется, у меня есть такое право.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230138
					],
					"speakerTitle": "Сальса"
				},
				{
					"id": 740230138,
					"content": "А? Да ты просто в игры заигралась. Нельзя взять и назначить себя художницей. Должны быть работы, должно быть признание публики...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230139
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230139,
					"content": "А ты по какому праву считаешь себя художником? Гнусные ловушки это и есть твои инсталляции? И что, люди аплодируют, когда их видят?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230140
					],
					"speakerTitle": "Сальса"
				},
				{
					"id": 740230140,
					"content": "Просто обывателям не понять красоты моих работ. Настоящее искусство могут оценить лишь единицы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230141,
						740230143
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230141,
					"content": "Попробуй для начала создать произведение искусства, которое смогут понять многие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230142
					]
				},
				{
					"id": 740230142,
					"content": "Да, если твои работы никто не понимает, они либо слишком авангардные... либо просто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230145,
					"content": "Нет... не может быть! Мои произведения совершенны, в этом нет никаких сомнений. Просто вы их не понимаете, и все остальные тоже не понимают, вот и всё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230146
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230146,
					"content": "Чтоб вас всех! Я так просто не сдамся! Время покажет, кто был прав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230147
					],
					"speakerTitle": "Убу"
				},
				{
					"id": 740230147,
					"content": "Убу, спотыкаясь, уходит...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740230148
					]
				},
				{
					"id": 740230148,
					"content": "Какой настырный враг! Но я тоже не сдамся. Ведь от меня зависит будущее искусства Фонтейна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230149
					],
					"speakerTitle": "Сальса"
				},
				{
					"id": 740230149,
					"content": "Теперь у всех появилось дело, за которое нужно бороться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230150
					]
				},
				{
					"id": 740230150,
					"content": "Это ведь хорошо? Наверное, хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230143,
					"content": "Либо просто никто их не понимает.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230144
					]
				},
				{
					"id": 740230144,
					"content": "То и другое признак неудачи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230135,
					"content": "Очевидно, с тобой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230136
					]
				},
				{
					"id": 740230115,
					"content": "Привет, друг.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230116
					]
				},
				{
					"id": 740230116,
					"content": "Ты даже имени его не знаешь, а уже называешь другом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230107,
					"content": "Ага, гнусный человек в зелёном!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230108
					]
				},
				{
					"id": 740230108,
					"content": "#Грабитель{F#ница}, да ещё и заговаривается! Ну и денёк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "Убу"
				}
			]
		},
		{
			"id": 7402302,
