			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230201,
					"content": "Хм... Паймон не по себе от такой картины... Похоже на уродливые штуковины, которые мы видели раньше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230202,
					"content": "<color=#00E1FFFF>Зачем им понадобилось закапывать в землю Гидро монумент</color>? Паймон не понимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740230203,
					"content": "#{NICKNAME}, может, нам стоит поработать здесь над композицией? Как учила Сальса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7402303,
