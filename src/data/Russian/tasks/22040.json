				"points": []
			},
			"dialogs": [
				{
					"id": 220400101,
					"content": "Долго так бизнес не протянет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400102
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 220400102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400103
					]
				},
				{
					"id": 220400103,
					"content": "Ах, прошу прощения. Я просто немного потерялась в собственных мыслях. Вы здесь, чтобы купить одежду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400104
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 220400104,
					"content": "Высококлассных шелков из Ли Юэ по-прежнему нет в наличии, но у нас всё ещё остались кимоно из новейшей коллекции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400105
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 220400105,
					"content": "Вы раньше импортировали материалы из Ли Юэ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400106
					]
				},
				{
					"id": 220400106,
					"content": "Да. Раньше мы часто получали из Ли Юэ высококачественный шёлк, такой как тот, что производит торговая гильдия «Фэйюнь» из шелковицы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400107
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 220400107,
					"content": "Но в нынешней ситуации мы уже давно не можем импортировать такой шёлк. Для продолжения работы нам приходится полагаться на имеющиеся запасы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400108
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 220400108,
					"content": "Каждый моток шёлка, который мы используем здесь, мы уже не восполним...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400109
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 220400109,
					"content": "Изначально я планировала сама разработать несколько новых моделей кимоно или использовать новые краски, чтобы как-то обновить ткани и привлечь покупателей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400110
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 220400110,
					"content": "Но я не смогла придумать ничего, что можно было бы считать «новым» в плане узоров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400111
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 220400111,
					"content": "#Путешественни{F#ца}{M#к}, я уверена, что ты многое повидал{F#а} за время своих странствий. Могу ли я спросить, встречались ли тебе какие-либо дизайнерские решения, которые можно было бы назвать новаторскими?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400112
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 220400112,
					"content": "Сложно сказать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400113
					]
				},
				{
					"id": 220400113,
					"content": "#А, понимаю. Возможно, это довольно бесцеремонно с моей стороны, но... не мог{F#ла} бы ты помочь мне расспросить других чужеземцев об узорах, которые мы могли бы использовать в наших дизайнах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400114
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 220400114,
					"content": "В настоящее время я в одиночку заведую «Тканями и кимоно Огуры», поэтому я не могу покидать магазин. Если я хочу собрать информацию, я могу лишь просить других сделать это за меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400115
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 220400115,
					"content": "Я сделаю это!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400116
					]
				},
				{
					"id": 220400116,
					"content": "Отлично, дай подумать... Тебе следует пойти и спросить мисс Тан Вэнь и господина Рамзая. Возможно, у них появятся новые идеи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Огура Мио"
				}
			]
		},
