				"points": []
			},
			"dialogs": [
				{
					"id": 700081201,
					"content": "Привет. Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081202
					],
					"speakerTitle": "Арамис"
				},
				{
					"id": 700081202,
					"content": "В «Кошкином хвосте» подают новый праздничный напиток...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081203
					]
				},
				{
					"id": 700081203,
					"content": "Прошу прощения, но я нахожусь при исполнении и не могу пить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081204
					],
					"speakerTitle": "Арамис"
				},
				{
					"id": 700081204,
					"content": "Это безалкогольный напиток.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081205
					]
				},
				{
					"id": 700081205,
					"content": "Безалкогольный? Тогда, полагаю, я могу попробовать. Пить очень хочется...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081206
					],
					"speakerTitle": "Арамис"
				},
				{
					"id": 700081206,
					"content": "О, как вкусно! К тому же он отлично освежает и придаёт силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081207
					],
					"speakerTitle": "Арамис"
				},
				{
					"id": 700081207,
					"content": "Это новый напиток из «Кошкиного хвоста»? Когда у меня будет свободное время, я обязательно зайду выпить ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арамис"
				}
			]
		},
