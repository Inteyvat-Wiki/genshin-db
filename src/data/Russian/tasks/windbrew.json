				"points": []
			},
			"dialogs": [
				{
					"id": 700083801,
					"content": "Очень хорошо. Теперь, когда у нас есть все необходимые ингредиенты, давайте начнём готовить напиток.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083802
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700083802,
					"content": "Интересно, каким он будет на вкус...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083803
					]
				},
				{
					"id": 700083803,
					"content": "Ты тоже хочешь попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083804
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700083804,
					"content": "Хорошо... Сам процесс приготовления довольно прост. Если будешь следовать моим инструкциям, всё получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083805
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700083805,
					"content": "#{NICKNAME}, хочешь попробовать приготовить напиток сам{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083806
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700083806,
					"content": "Хочу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083807
					]
				},
				{
					"id": 700083807,
					"content": "#Отлично! Сначала я объясню процесс приготовления этого напитка, так что будь внимател{F#ьна}{M#ен}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083808
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700083808,
					"content": "Для начала кладём <color=#00E1FFFF>цветок-сахарок</color>, а только потом добавляем алкогольную основу... После этого пора добавить немного <color=#00E1FFFF>молока</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083809
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700083809,
					"content": "Чтобы придать напитку больше вкуса, добавляем <color=#00E1FFFF>ветряные астры</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083810
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700083810,
					"content": "Не спеши смешивать всё сразу. Позволь напитку сначала <color=#00E1FFFF>настояться</color> и полностью раскрыть цветочный аромат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083811
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700083811,
					"content": "Посыпь коктейль <color=#00E1FFFF>семенами одуванчика</color>. Теперь он похож на полное море звёзд. Добавляем <color=#00E1FFFF>лёд</color> и... Готово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083812
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700083812,
					"content": "Вот так это делается. Нельзя путать последовательность, если хочешь приготовить вкусный напиток.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083813
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700083813,
					"content": "#Если ты всё запомнил{F#ла}, можешь приступать. Спроси меня, если что-то забыла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Маргарита"
				}
			]
		},
