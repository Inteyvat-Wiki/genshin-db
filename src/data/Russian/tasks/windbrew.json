			"dialogs": [
				{
					"id": 700081301,
					"content": "Хочешь поиграть со мной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081302
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 700081302,
					"content": "В «Кошкином хвосте» подают новый праздничный напиток...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081303
					]
				},
				{
					"id": 700081303,
					"content": "«Кошкин хвост»... Тётя Грейс говорит, что детям нельзя пить алкоголь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081304
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 700081304,
					"content": "Это безалкогольный напиток.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081305
					]
				},
				{
					"id": 700081305,
					"content": "Правда? Тогда я попробую...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081306
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 700081306,
					"content": "Вкусно! Сладкий и освежающий! Это новый коктейль из «Кошкиного хвоста»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081307
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 700081307,
					"content": "Я расскажу Тимми и Лили! Уверена, они тоже захотят попробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нора"
				}
			]
		},
