					"Маргарита"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700080101,
					"content": "Похоже, все-таки надо придумать новый особый напиток...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080102
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080102,
					"content": "Всё хорошо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080103
					]
				},
				{
					"id": 700080103,
					"content": "А, это ты. Ну, я подумываю о создании нового особого напитка к Празднику ветряных цветов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080104
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080104,
					"content": "На празднике все будут веселиться и наверняка захотят что-нибудь поесть и выпить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080105
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080105,
					"content": "К тому же если они будут пить только алкогольные напитки, то быстро напьются, и рыцари Ордо Фавониус уведут их трезветь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080106
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080106,
					"content": "С другой стороны, слишком много алкоголя также может испортить атмосферу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080107
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080107,
					"content": "Даже так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080108
					]
				},
				{
					"id": 700080108,
					"content": "Хотя... Я слышала, что некоторым людям нравится эта дурманящая атмосфера, но напиваться на улице во время праздника - не самое лучшее решение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080109
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080109,
					"content": "Поэтому я хочу выпустить лёгкий молочный напиток со вкусом ветра, но без алкоголя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080110
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080110,
					"content": "Чтобы подчеркнуть вкус «ветра», я собираюсь использовать особенные ингредиенты: одуванчики и ветряные астры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080111
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080111,
					"content": "Но если я буду заниматься этим одна, у меня уйдёт очень много времени. Поможешь мне собрать необходимые ингредиенты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080112,
						700080116
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080112,
					"content": "Я соберу семена одуванчика.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080113
					]
				},
				{
					"id": 700080113,
					"content": "Я рассчитываю на тебя. На утёсе Звездолова растут прекрасные одуванчики. Пожалуйста, собери их там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080114
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080114,
					"content": "А я соберу ветряные астры. Встретимся здесь, когда подготовим соответствующие ингредиенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080115
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080115,
					"content": "Как только напиток будет готов, здесь можно будет найти людей для дегустации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080116,
					"content": "Я соберу ветряные астры.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080117
					]
				},
				{
					"id": 700080117,
					"content": "Я рассчитываю на тебя. В долине Ветров растут прекрасные ветряные астры. Пожалуйста, собери их там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080118
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080118,
					"content": "А я соберу одуванчики. Встретимся здесь, когда подготовим соответствующие ингредиенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080119
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700080119,
