			},
			"dialogs": [
				{
					"id": 700081401,
					"content": "Ну как, ты нашла желающих попробовать напиток?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081402
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700081402,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081403
					]
				},
				{
					"id": 700081403,
					"content": "Немного выпить на празднике... Неудивительно, что у «Доли ангелов» всё больше и больше клиентов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081404
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700081404,
					"content": "Думаю, всё будет в порядке. Кроме желающих выпить, есть ещё дети и стражники, которым тоже нужен особый праздничный напиток.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081405
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700081405,
					"content": "Я продолжу совершенствовать этот напиток. Спасибо за помощь. Вот твоя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081406
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700081406,
					"content": "Кстати, желаю вам счастливого Праздника ветряных цветов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Маргарита"
				}
			]
		},
