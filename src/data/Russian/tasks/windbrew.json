					"Нимрод"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700081101,
					"content": "Без хорошего напитка и праздник - не праздник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081102
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 700081102,
					"content": "В «Кошкином хвосте» подают новый праздничный напиток...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081103
					]
				},
				{
					"id": 700081103,
					"content": "Ты хочешь, чтобы я его попробовал? Ха-ха-ха! Без проблем! В вопросе выпивки я настоящий эксперт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081104
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 700081104,
					"content": "Дай-ка мне попробовать... А? У него... вообще нет вкуса алкоголя. Это больше похоже на какой-то молочный напиток.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081105
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 700081105,
					"content": "Не поймите меня неправильно, это очень вкусно, но я думаю, что безалкогольный напиток не подходит для праздника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081106
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 700081106,
					"content": "Я имею в виду, есть много людей, которые с нетерпением ждут возможности немного выпить на празднике. Не думаю, что такой напиток будет пользоваться спросом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нимрод"
				}
			]
		},
