			},
			"dialogs": [
				{
					"id": 790590101,
					"content": "Это сцена из шоу «Путешествие на Восток»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590102
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790590102,
					"content": "Первоначальная идея была связана со сказкой о мудром путнике и его путешествии на восток из Фонтейна через Сумеру в поисках истинной мудрости в Доме даэны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590103
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790590103,
					"content": "Сцена рассказывает о том, как путник спас «Мастера земных превращений» от того, чтобы его не раздавил массивный валун, и об их приключениях в пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590104
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790590104,
					"content": "К несчастью, Гидро эйдолоны, исполняющие роль как путника, так и Мастера, исчезли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590105
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790590105,
					"content": "Вот бы кто-нибудь <color=#00E1FFFF>вернул их</color> и смог запечатлеть их тренировку у большого камня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						79059106
					],
					"speakerTitle": "Сценические заметки"
				}
			]
		},
