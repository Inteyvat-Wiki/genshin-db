	"talks": [
		{
			"id": 1104301,
			"completionStepIds": [
				1104301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104301",
							"2"
						],
						"stepId": 1104301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430101,
					"content": "Ты что, хочешь, чтобы мы отсюда спрыгнули?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110430102,
					"content": "Не обязательно. Ну, разве что если у вас нет способа получше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430103,
						110430104
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430103,
					"content": "Лучше бы он у нас был.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				},
				{
					"id": 110430105,
					"content": "#Какой бы способ ты ни выбрал{F#а}, эксперимент закончится, как только ты достигнешь противоположного берега озера, что под нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430106
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430106,
					"content": "На основании твоей максимальной скорости и затраченного времени я проведу сравнительный анализ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430107
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430107,
					"content": "#Противоположного берега озера? Ты предлагаешь плыть?! Мы в горах, тут кругом снег! {NICKNAME} ведь околеет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110430108,
					"content": "Когда никаких ограничений нет, каждый инстинктивно выберет тот способ достижения цели, который кажется ему наиболее целесообразным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430109
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430109,
					"content": "Для одних ледяная вода будет невыносимой, а другим она даже понравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430110
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430110,
					"content": "Что бы вы ни предприняли, всё станет ценной частью эксперимента.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430111,
						110430112
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430111,
					"content": "Тогда за дело.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430113,
					"content": "Тогда прошу, приступай. Я буду с нетерпением ждать результатов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430112,
					"content": "Это куда легче, чем та часть с суперспособностями.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430104,
					"content": "Что-то я нервничаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				}
			]
		},
		{
			"id": 1104303,
			"completionStepIds": [
				1104303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104303",
							"2"
						],
						"stepId": 1104303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430301,
					"content": "Отличная работа. Я в глубоком восхищении от увиденного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430302
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430302,
					"content": "Слухи о тебе оказались правдой. По каждому показателю ты далеко опережаешь среднестатистического жителя Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430303
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430303,
					"content": "Но ты повсюду следовал за нами и ни капельки не устал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110430304,
					"content": "Я? Мне немного помогла алхимия, но это неважно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430305
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430305,
					"content": "Если окажется, что природные законы Тейвата на тебя не действуют, то я смог бы выдвинуть несколько гипотез касательно цивилизаций других миров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430306
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430306,
					"content": "А если природные законы Тейвата всё же на тебя действуют, то я также мог бы предположить, как протекала бы эволюция при отсутствии их влияния.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430307
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430307,
					"content": "Столь увлекательные бесчисленные вероятности, в которых можно копаться бесконечно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430308
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430308,
					"content": "Но как это поможет твоему исследованию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110430309,
					"content": "#Ты помог{F#ла} разрешить множество проблем, что его тормозили. Когда вернёмся в лагерь, я покажу тебе кое-что интересное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430310
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430310,
					"content": "Ты занимаешься изучением ещё чего-то?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430311
					]
				},
				{
					"id": 110430311,
					"content": "Возможно, я мог бы провести аналогию между тобой и некоторыми... необычными образцами. Надеюсь, ты не обидишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430312
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430312,
					"content": "Золото, окаменевшее дерево, солнце, в восемь раз крупнее нашего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430313
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430313,
					"content": "Природа исследования захватывает. Жаль только, что такие ощущения скоротечны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430314
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430314,
					"content": "Я хотел бы посвятить все свои силы исследованию, но число образцов ограничено. Когда тайны науки открываются, чувство озарения исчезает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430315
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430315,
					"content": "Все объекты нашего любопытства, становясь частью обыденного, как скучный закатник или цветок-сахарок, обречены потерять всяческий интерес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430316
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430316,
					"content": "А, так ты поэтому рисовал тех хиличурлов? Потому что ты увидел в них нечто новое и интересное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110430317,
					"content": "Совершенно верно. Как я сказал, по большей части эти существа «скучны и утратили к себе всяческий интерес».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430318
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430318,
					"content": "Значит, после всех этих экспериментов мы станем для тебя скучными? Как твои рисунки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110430319,
					"content": "Конечно, нет. Вашу помощь поистине сложно переоценить. Нашу дружбу я сохраню навсегда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430320
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430320,
					"content": "Ладно. До того, как мы отправимся в лагерь, остаётся провести последний опыт. Умственный эксперимент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430321
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110430321,
					"content": "Здесь поблизости есть руины, следуйте за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				}
			]
		},
