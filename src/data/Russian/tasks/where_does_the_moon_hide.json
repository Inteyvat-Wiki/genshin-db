			"dialogs": [
				{
					"id": 761190101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190102
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761190102,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190103
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 761190103,
					"content": "...Ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190104
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761190104,
					"content": "Похоже, им очень весело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761190105,
					"content": "Привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190106
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761190106,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190107
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 761190107,
					"content": "И тебе привет, луоннотар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190108
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761190108,
					"content": "Играешь в новую игру?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190109
					]
				},
				{
					"id": 761190109,
					"content": "Да. На «Флагмане» я видела, как люди играли со своими друзьями в стаканчики и позаимствовала эту идею.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190110
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761190110,
					"content": "Они накрывали самоцвет стаканом, а затем быстро перемешивали стаканы на столе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190111
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761190111,
					"content": "Когда стаканы останавливались, нужно было угадать, под каким из них находится самоцвет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190112
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761190112,
					"content": "Куухенки любят кружиться, завернувшись в ткань, поэтому я взяла за образец шляпу ведьмы и немного её усовершенствовала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190113
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761190113,
					"content": "Как мило.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190114
					]
				},
				{
					"id": 761190114,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190115
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 761190115,
					"content": "Кстати, неужели на «Флагмане» тебя никто не узнал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761190116,
					"content": "Когда меня спрашивали, я отвечала: «Сегодня я решила одеться как Лунная Богиня. Похоже, правда?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190117
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761190117,
					"content": "Ого, ты научилась этому трюку на Ночи лунной молитвы и вовсю его применяешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761190118,
					"content": "И они тебе поверили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190119
					]
				},
				{
					"id": 761190119,
					"content": "Хм... Похоже, они не особо поверили. Но больше со мной не разговаривали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190120
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761190120,
					"content": "Я плохо сыграла? В следующий раз попробую снова, но в другом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190121
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761190121,
					"content": "Паймон кажется, что кто-то извлёк неверные уроки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761190122,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190123
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 761190123,
					"content": "Луоннотар хочет пригласить тебя поиграть в прятки. Сыграешь с ней?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190124
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761190124,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190125
					]
				},
				{
					"id": 761190125,
					"content": "В таком случае, пожалуйста, для начала поставьте на кон сто тысяч моры. Таковы правила на «Флагмане».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190126
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761190126,
					"content": "Такое точно не стоило перенимать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
