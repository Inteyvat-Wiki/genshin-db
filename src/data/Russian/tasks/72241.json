					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410601,
					"content": "Меня зовут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410602
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410602,
					"content": "...Абэраку, создатель Гелиоса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410603
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410603,
					"content": "А я Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410604,
						722410609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722410604,
					"content": "Мы представляемся друг другу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410605
					]
				},
				{
					"id": 722410605,
					"content": "Ну, раз уж он начал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722410606,
					"content": "Просто демонстрирую хорошие манеры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722410607,
					"content": "Пустяки. Вы прошли долгий путь, и с моей стороны было бы невежливо не принять вас в таком плачевном состоянии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410608
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410608,
					"content": "#Не волнуйся! Мы не против. Правда, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722410613,
					"content": "И всё же, почему вы здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722410614,
					"content": "Я... Я создатель Гелиоса, и это место - моё... последнее пристанище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410615
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410615,
					"content": "Заснуть в тёмном, ледяном месте и не проснуться... Как я мог так просто умереть? Я, создатель Гелиоса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410616
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410616,
					"content": "Создатель Гелиоса?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410617
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722410617,
					"content": "Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722410618,
					"content": "Ах да, Гелиос... Так я сам мысленно называю своё творение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410619
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410619,
					"content": "Возможно, вам это неизвестно, но жители Бякуякоку называют эту штуку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410620
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410620,
					"content": "...Дайнити Микоси.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410621
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410621,
					"content": "Гелиос - это Дайнити Микоси, солнечная колесница, которая везёт Гипе{RUBY#[S]Бякуя но Хикари}рион.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410622,
						722410623
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410622,
					"content": "Создатель Дайнити Микоси?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410624,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410625
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410625,
					"content": "#О путешественни{M#к}{F#ца} из далёких земель! Хотя я создал его, меня арестовали и заключили в тюрьму над собственным творением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410626
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410626,
					"content": "После смерти моя душа была рассеяна по земле Бякуякоку, и многие воспоминания были мной утрачены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410627
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410627,
					"content": "Я помню, что там было что-то очень важное... высоко над Дайнити Микоси...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410628
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410628,
					"content": "#Но я больше не могу этого вспомнить. Прошу тебя, путешественни{M#к}{F#ца} из далёких земель, помоги мне вернуть мою одежду, корону и кости. Они спрятаны в трёх разных местах",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410629
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410629,
					"content": "Их можно найти в Теснине, Храме вечной ночи и Сердце змея.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410630
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410630,
					"content": "Принеси их на три алтаря - моя душа опять обретёт целостность, и я смогу открыть для тебя путь к Дайнити Микоси...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410631
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410631,
					"content": "Тогда ты сможешь попасть над Дайнити Микоси, в закрытые пространства, скрытые завесой Вечной ночи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410623,
					"content": "Ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410609,
					"content": "Меня зовут...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410610
					]
				},
				{
					"id": 722410610,
					"content": "#Понятно... Значит, ты путешественни{M#к}{F#ца} из далёких земель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410611
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410611,
					"content": "Простите, что принимаю вас в таком плачевном состоянии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410612
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410612,
					"content": "Всё нормально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7224107,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
