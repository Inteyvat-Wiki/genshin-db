					"speakerTitle": "Абэраку"
				}
			]
		},
		{
			"id": 7224108,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Абэраку",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410801,
					"content": "#О, путешественни{M#к}{F#ца} из далёких земель, это вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410802
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410802,
					"content": "Благодаря вам моя душа опять цела, и воспоминания возвращаются. Невероятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410803
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410803,
					"content": "Возможно, вы уже знаете, что в далёком прошлом в Бякуякоку царила лишь кромешная тьма и что те, кто жил в ней, пребывали в страхе перед Драконом глубин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410804
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410804,
					"content": "В те времена именно я организовал строительство Дайнити Микоси, и таким образом в Бякуякоку появилась смена дня и ночи. Отсюда зародилось название «Бякуя».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410805
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410805,
					"content": "Было сказано, что: «Теперь, когда построен Дайнити Микоси, хоть эта земля и пребывает в вечной ночи, мы, по крайней мере, можем отличить чёрное от белого».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410806
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410806,
					"content": "Как обидно, что пока осколки моей души не воссоединились, я даже не мог вспомнить тот день, когда люди толпились вокруг завершённого Дайнити Микоси.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410807
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410807,
					"content": "Это, должно быть, было моё самое любимое воспоминание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410808
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410808,
					"content": "Но увы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410809
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410809,
					"content": "Увы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722410810,
					"content": "Когда Дайнити Микоси был построен, а Дракон глубин побеждён, отогнан светом, к которому он не привык, люди вновь зажили спокойно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410811
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410811,
					"content": "Но как только воцарился мир... Ах, человеческое сердце трудно постичь. Кто знал тогда, что они начнут вынашивать столь злые планы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410812
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410812,
					"content": "#О путешественни{M#к}{F#ца} из далёких земель, я уверен, что вы знаете, как жадны могут быть злодеи до богатства и власти... Они посягнули на большее, чем когда-либо заслуживали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410813
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410813,
					"content": "Они стали использовать народ, внушая им, что надо поклоняться Дайнити Микоси. А народ дошёл в своём невежестве до предела, начав верить в неодушевлённые предметы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410814
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410814,
					"content": "В конце концов они провозгласили власть Сына С{RUBY#[D]Фаэтона}олнца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410815
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410815,
					"content": "Сына Солнца?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410816
					]
				},
				{
					"id": 722410816,
					"content": "Да, какого-нибудь ребёнка выбирают Сыном Солнца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410817
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410817,
					"content": "Конечно, такие дети не могли знать, как устроен мир. Они не могли править, поэтому оставались марионетками, соглашаясь с теми, кто дёргал их за ниточки, оставаясь за троном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410818
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410818,
					"content": "Я хотел воспротивиться этому, но Сын Солнца по наущению своего двора обвинил меня в государственной измене и заключил здесь в тюрьму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410819
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410819,
					"content": "А, Сын Солнца...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410820
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722410820,
					"content": "Но разве в итоге Сын Солнца не поймёт, что им манипулируют?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410821
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722410821,
					"content": "Именно поэтому ни один Сын Солнца так и не достиг зрелости. Ибо, как ты и говоришь, взрослые не так легко поддаются влиянию злодеев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410822
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410822,
					"content": "«Сын Солнца святой в свой день рожденья\\nНа Пегасе летит в дань уваженья».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410823,
						722410824
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410823,
					"content": "Значит ли это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				},
				{
					"id": 722410825,
					"content": "Да. Их отводили во внутреннее святилище Дайнити Микоси, нарядив в праздничные одежды. И пока они в приподнятом настроении...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410826
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410826,
					"content": "Спрятанные здесь вещи связаны с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410827
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410827,
					"content": "Золотая уздечка - доказательство того, что человек действительно Сын Солнца. Я спрятал её здесь, думая когда-нибудь передать людям и рассказать им... Но, полагаю, теперь это не имеет смысла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410828
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410828,
					"content": "#Путешественни{M#к}{F#ца} из далёких земель... Я не смог защитить ни этих детей, ни народ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410829
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410829,
					"content": "Меня зовут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410830
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410830,
					"content": "...Абэраку, создатель Гелиоса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410831
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410831,
					"content": "Я организовал строительство Дайнити Микоси. Это я высоко повесил сияющее зеркало, когда царила вечная ночь, и я считал себя гением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410832
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410832,
					"content": "Такой талант! Такие способности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410833
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410833,
					"content": "Я мечтал с помощью Дайнити Микоси изгнать тьму, но тогда я ещё не знал, что настоящая всепожирающая вечная ночь таится в чёрных сердцах жадных людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410834
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410834,
					"content": "#{M#Гость}{F#Гостья} из далёких земель, я передаю тебе эту Золотую уздечку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410835
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410835,
					"content": "Она свидетельство нашей в высшей степени смехотворной истории...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410836
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410836,
					"content": "Храни её... Делай с ней всё, что пожелаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410837
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410837,
					"content": "Это слишком ценный подарок...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410838
					]
				},
				{
					"id": 722410838,
					"content": "Ха! Нет, она уже потеряла смысл. То, что я восстановил целостность своей души и смог вручить уздечку тебе, - это судьба. Мирный конец существования непростой реликвии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410839
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410839,
					"content": "Ах... Такой талант, такие способности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722410824,
					"content": "То есть на один из дней рождения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				}
			]
		},
		{
