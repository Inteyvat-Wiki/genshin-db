				"points": []
			},
			"dialogs": [
				{
					"id": 751210101,
					"content": "Мне поручили найти пару книг...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "Вы рассказываете Куроде о книгах, которые нужны Ситлали.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "«Реинкарнация в непобедимого сёгуна Райдэн» первое издание и «Пожалуйста, Кицунэ Гудзи» ограниченное издание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "Курода"
				},
				{
					"id": 751210104,
					"content": "Должен сказать, твоя подруга знаток в этом вопросе. С точки зрения коллекционной ценности, ничто из того, что сейчас издаёт дом Яэ, не может соперничать с книгами, которые ты ищешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "Курода"
				},
				{
					"id": 751210105,
					"content": "Как жаль, что я не встречал таких читателей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "Курода"
				},
				{
					"id": 751210106,
					"content": "Книги можно найти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "В свободной продаже, а тем более на складах, ты не найдёшь ни одной, ни другой. Все давно распроданы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "Курода"
				},
				{
					"id": 751210108,
					"content": "Однако так получилось, что у меня есть по экземпляру каждой из них...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "Курода"
				},
				{
					"id": 751210109,
					"content": "Я могу их купить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "Нет, нет, нет. Этим книгам будет гораздо лучше у твоей подруги, которая оценит их по достоинству.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "Курода"
				},
				{
					"id": 751210111,
					"content": "Я с радостью подарю их тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Курода"
				}
			]
		}
	]
