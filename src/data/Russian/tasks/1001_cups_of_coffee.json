			"dialogs": [
				{
					"id": 230001701,
					"content": "#Эй! Путешественни{F#ца}{M#к}, вы тоже пришли. Ну что, понравилась сегодняшняя история?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001702,
						230001703
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230001702,
					"content": "Было очень интересно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230001704
					]
				},
				{
					"id": 230001704,
					"content": "Ха-ха, то же самое сказали и другие гости. В новое время появляются новые герои и новые истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001705
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230001705,
					"content": "Благодаря им мы всегда сможем заработать себе на жизнь... О, а благодаря вам я смогу выпить чашечку хорошего кофе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001706
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230001706,
					"content": "Спасибо за предоставленный материал! Прошу, примите это вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001707
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230001707,
