				"points": []
			},
			"dialogs": [
				{
					"id": 230000400,
					"content": "Однажды в Мондштадте...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000401
					]
				},
				{
					"id": 230000401,
					"content": "Тот самый Мондштадт, который облюбовал Анемо Архонт?.. По словам караванщиков, там появился дракон, вызывающий бури. Неплохой сюжет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000402
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000402,
					"content": "Но от караванщиков удалось узнать лишь несколько обрывочных и, похоже, не очень достоверных слухов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000403
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000403,
					"content": "#Например... «Как гром среди ясного неба обрушивается путешественни{F#ца}{M#к} с крыльями за спиной и на неимоверной высоте преследует дракона»! Что-то в этом роде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000404,
						230000405
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000404,
					"content": "Погоня действительно была по воздуху...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000406
					]
				},
				{
					"id": 230000406,
					"content": "#Или вот ещё... «{M#Ему}{F#Ей} удалось в одиночку проникнуть в церковь и похитить мощное оружие, наделённое великой силой Анемо Архонта».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000407,
						230000408
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000407,
					"content": "В церковь действительно удалось проникнуть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000409
					]
				},
				{
					"id": 230000409,
					"content": "#О! А как вам эта история? «{M#Ему}{F#Ей} удалось отыскать уязвимые места дракона, пронзить былые раны и, умывшись его кровью, обрести бессмертие!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000410,
						230000411
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000410,
					"content": "Нужно же было куда-то целиться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000411,
					"content": "Всего лишь очищение отравленной крови, влияющей на разум.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000408,
					"content": "Небесная лира вовсе не оружие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000409
					]
				},
				{
					"id": 230000405,
					"content": "На самом деле это был планер...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000406
					]
				}
			]
		},
		{
