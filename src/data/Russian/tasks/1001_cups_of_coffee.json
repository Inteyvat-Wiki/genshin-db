					"Маддах"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000500,
					"content": "Однажды в Ли Юэ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000501
					]
				},
				{
					"id": 230000501,
					"content": "Ли Юэ?.. По словам караванщиков, после падения Архонтов местные влиятельные силы ведут там друг с другом борьбу. Неплохой сюжет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000502
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000502,
					"content": "Но от караванщиков удалось узнать лишь несколько обрывочных и, похоже, не очень достоверных слухов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000503
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000503,
					"content": "#Например... «Путешественни{F#ца}{M#к} готовится к проведению Церемонии Вознесения и становится объектом, который хочет заполучить каждая из сил». Что-то в этом роде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000504,
						230000505
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000504,
					"content": "Это действительно была Церемония Вознесения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000506
					]
				},
				{
					"id": 230000506,
					"content": "#Или вот ещё... «{M#Ему}{F#Ей} пришлось вступить в ожесточённую схватку с Архонтом Вихрей. Даже Нефритовый дворец, поражённый яростью клинка, рухнул в море».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000507,
						230000508
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000507,
					"content": "Это действительно была схватка с Архонтом...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000509
					]
				},
				{
					"id": 230000509,
					"content": "#О! А как вам эта история? «{M#Ему}{F#Ей} удалось в одиночку урегулировать конфликт между людьми и Адептами и положить начало новой эре в Ли Юэ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000510,
						230000511
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000510,
					"content": "Конфликт действительно был улажен...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000511,
					"content": "Это результат совместных усилий жителей Ли Юэ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000508,
					"content": "Нефритовый дворец стал ключом к победе над Архонтом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000509
					]
				},
				{
					"id": 230000505,
					"content": "На самом деле это было поручение одного человека...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000506
					]
				}
			]
		},
