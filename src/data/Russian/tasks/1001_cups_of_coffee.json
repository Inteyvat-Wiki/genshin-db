			},
			"dialogs": [
				{
					"id": 230000600,
					"content": "Однажды в Инадзуме...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000601
					]
				},
				{
					"id": 230000601,
					"content": "Та самая Инадзума, что под защитой Электро Архонта?.. Я слышал от караванщиков, будто кто-то из местных ослушался указа об Охоте на Глаза Бога. Неплохой сюжет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000602
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000602,
					"content": "Но всё, что удалось узнать от караванщиков, это лишь несколько обрывочных и, похоже, не очень достоверных слухов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000603
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000603,
					"content": "Например... «Какой-то чужеземец бросил вызов Предвестнику Фатуи и мокрого места от него не оставил». Что-то в этом роде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000604,
						230000605
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000604,
					"content": "Бой действительно был выигран...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000606
					]
				},
				{
					"id": 230000606,
					"content": "#Или вот ещё... «{M#Ему}{F#Ей} в противостоянии с сёгуном удалось без единой царапины сбежать от Мусо но хитотати».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000607,
						230000608
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000607,
					"content": "Смертельного удара действительно удалось избежать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000609
					]
				},
				{
					"id": 230000609,
					"content": "#О! А как вам эта история? «{M#Ему}{F#Ей} удалось поглотить силу статуи всевидящего божества и изменить волю Архонтов...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000610,
						230000611
					],
					"speakerTitle": "Маддах"
				},
				{
					"id": 230000610,
					"content": "Намерения сёгуна действительно удалось изменить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000611,
					"content": "Ключом к победе стало желание людей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000608,
					"content": "Удар меча сдержал кто-то другой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000609
					]
				},
				{
					"id": 230000605,
					"content": "Именно сёгун вершил наказания.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000606
					]
				}
			]
		},
