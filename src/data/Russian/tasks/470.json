					"speakerTitle": "Паймон"
				},
				{
					"id": 4700103,
					"content": "Ммм! Запах идёт из «Хорошего охотника»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4700104,
					"content": "Толстые ломтики мягкого тостового хлеба...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4700105,
					"content": "Слегка поджаренный лук тает во рту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4700106,
					"content": "Нет больше сил терпеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4700107,
					"content": "Не могу больше терпеть! Давай же скорее закажем <color=#00E1FFFF>рыбацких бутербродов</color> в <color=#00E1FFFF>«Хорошем охотнике»</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4700108,
					"content": "Ты угощаешь, конечно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
