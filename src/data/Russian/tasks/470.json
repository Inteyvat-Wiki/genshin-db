			"dialogs": [
				{
					"id": 4700201,
					"content": "Какая вкуснотища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4700202,
					"content": "В «Хорошем охотнике» подают отличные рыбацкие сэндвичи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4700203,
					"content": "Как ни странно, жаренные мацутакэ - это традиционное мондштадтское блюдо. Все знают, как его готовить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4700204,
					"content": "Ты тоже можешь попробовать, если у тебя есть все ингредиенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4700205,
					"content": "Что думаешь? Получится ли у тебя готовить лучше, чем в «Хорошем охотнике»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4700206,
					"content": "Я с радостью готова пробовать твою стряпню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4700207,
					"content": "Не подведи меня!",
