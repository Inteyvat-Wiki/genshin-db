			"trigger": {
				"objectNames": [
					"Джиллиана"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200380101,
					"content": "Ах, интересно, в каком состоянии сейчас статуи семи Архонтов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380102
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200380102,
					"content": "Статуи Семи? А что с ними случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380103
					]
				},
				{
					"id": 200380103,
					"content": "Как бы тебе сказать... Раньше я каждую неделю ходила к статуям молиться. После молитвы я всегда протирала с них пыль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380104
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200380104,
					"content": "Я чистила статуи, чтобы отблагодарить Архонтов за благословения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380105
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200380105,
					"content": "Но сейчас у меня Лили, и я почти не выхожу из дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380106
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200380106,
					"content": "Уже очень давно никто не чистил статуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380107
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200380107,
					"content": "Это выглядит так, как будто я хочу всё спихнуть на твои плечи, но... Может ты почистишь статуи вместо меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380109,
						200380110
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200380109,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380111
					]
				},
				{
					"id": 200380111,
					"content": "Благодарю тебя! Да хранит тебя ветер!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200380115,
					"content": "Статуи Семи пропитаны силой Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380116
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200380116,
					"content": "Просто так с них пыль не стереть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380117
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200380117,
					"content": "Но с такими элементальными умениями у тебя не должно возникнуть никаких проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380118
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200380118,
					"content": "Это мне приходится целый день тратить, чтобы почистить всего лишь одну статую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200380110,
					"content": "Может, ветер сам сдует с них пыль?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380112
					]
				},
				{
					"id": 200380112,
					"content": "Я уверена, что у Барбатоса есть более серьёзные дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380113
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200380113,
					"content": "Нельзя вечно пребывать в праздности и оставлять весь труд Архонтам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380114
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200380114,
					"content": "Давай облегчим тяжкий труд Барбатоса, хотя бы немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Джиллиана"
				}
			]
		},
