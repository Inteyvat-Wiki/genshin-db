					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380303
					]
				},
				{
					"id": 200380303,
					"content": "#Спасибо тебе, дорог{F#ая}{M#ой}! Да хранит тебя Барбатос!",
