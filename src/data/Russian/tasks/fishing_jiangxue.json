			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзян Сюэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040301,
					"content": "У... У тебя получилось! Так быстро, Паймон ничего не успела разглядеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220040302,
					"content": "Кто ты такой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220040303,
					"content": "Простой рыбак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040304
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040304,
					"content": "Хм... Очень странно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040305
					]
				},
				{
					"id": 220040305,
					"content": "Да, странно. В этом мире творится много странного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040306
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040306,
					"content": "К примеру, повар с постоялого двора. Раньше он был воином, а сейчас полюбил кулинарию. Он выглядит зловеще, но у него доброе сердце, поверь мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040307
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040307,
					"content": "Или наш босс... Она из Мондштадта, но никто об этом не знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040308
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040308,
					"content": "Или ты... У тебя нет Глаза Бога, но ты используешь элементальные силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040309
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040309,
					"content": "Это странно... Но это не значит, что этого стоит бояться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040310
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040310,
					"content": "Прими это в знак моей благодарности. А я продолжу рыбачить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзян Сюэ"
				}
			]
		}
	]
}