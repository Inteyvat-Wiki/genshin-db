			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзян Сюэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040101,
					"content": "Надеюсь, я что-нибудь поймаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040102
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040103
					]
				},
				{
					"id": 220040103,
					"content": "Ловлю гигантскую рыбу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040104
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040104,
					"content": "Мой друг любит готовить. Если я принесу ему гигантскую рыбу, он будет без ума от счастья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040105
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040105,
					"content": "Только вот монстры распугали всю рыбу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040106
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040106,
					"content": "Я чувствую в тебе мощную элементальную силу. Поможешь мне разобраться с монстрами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040107,
						220040109
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040107,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040108
					]
				},
				{
					"id": 220040108,
					"content": "Благодарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040112,
					"content": "Но как ты узнаешь, когда появятся монстры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220040113,
					"content": "Зачем знать, когда можно просто увидеть? Посмотрите назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040114
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040114,
					"content": "Назад?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220040109,
					"content": "Как ты чувствуешь силу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040110
					]
				},
				{
					"id": 220040110,
					"content": "У меня когда-то был Глаз Бога. Я им больше не пользуюсь, но по-прежнему могу чувствовать элементальную силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040111
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220040111,
					"content": "Тебе не составит труда разобраться с этими монстрами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "Цзян Сюэ"
				}
			]
		},
		{
			"id": 2200403,
			"completionStepIds": [
				2200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200405",
							"2"
						],
						"stepId": 2200405,
						"stateName": "QUEST_STATE_UNFINISHED"
