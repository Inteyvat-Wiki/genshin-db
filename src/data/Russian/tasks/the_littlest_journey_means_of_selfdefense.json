			},
			"dialogs": [
				{
					"id": 210300201,
					"content": "#Путешественни{F#ца}{M#к}, ну как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300202
					],
					"speakerTitle": "Мастер Чжан"
				},
				{
					"id": 210300202,
					"content": "Теперь там будет безопасней.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300203
					]
				},
				{
					"id": 210300203,
					"content": "#{NICKNAME} - сама храбрость. Молодец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300204
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300204,
					"content": "Папа сказал, что они наняли несколько человек, чтобы те охраняли нас в пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300205
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300205,
					"content": "#Надеюсь, они будут такими же храбрыми воинами, как {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300206
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300206,
					"content": "Дядя кузнец, теперь ты можешь добыть руду и выковать нам оружие, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300207
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300207,
					"content": "Да, конечно. Сейчас соберусь и пойду добывать руду, а после можно уже и к ковке приступать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300208
					],
					"speakerTitle": "Мастер Чжан"
				},
				{
					"id": 210300208,
					"content": "Но я могу унести ограниченное количество руды. Надеюсь, больше никаких монстров там не появится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мастер Чжан"
				}
			]
		},
