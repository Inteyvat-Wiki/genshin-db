			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Малыш Мэн",
					"Мастер Чжан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "А вот эта руда от той чем-то отличается?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300102,
					"content": "Ну конечно. И цена, и качество сделанных из них вещей будут совсем разные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "Мастер Чжан"
				},
				{
					"id": 210300103,
					"content": "А... Но этих двух руд осталось совсем немного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300104,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "Мастер Чжан"
				},
				{
					"id": 210300105,
					"content": "Что вы здесь делаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "#Привет, {NICKNAME}! Я помогаю отцу проверить заказанное им оружие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300107,
					"content": "Дядя кузнец такой добрый! Он обещал сделать для меня маленький меч!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300108,
					"content": "Но он сказал, что сырья в последнее время не хватает. Партию оружия, которую заказал мой отец, возможно, задержится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300109,
					"content": "И я не знаю, когда будет изготовлен мой меч...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300110,
					"content": "Увы, ничего не поделаешь, в последнее время покупателей много, а руды очень мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "Мастер Чжан"
				},
				{
					"id": 210300111,
					"content": "В местах, где много руды, развелось большое количество монстров. Идти добывать боязно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "Мастер Чжан"
				},
				{
					"id": 210300112,
					"content": "Я решил подождать, чтобы потом пойти вместе с каким-нибудь искателем приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "Мастер Чжан"
				},
				{
					"id": 210300113,
					"content": "Но сколько же ждать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300114,
					"content": "#{NICKNAME}, многие говорят, что ты лихо сражаешься с монстрами. Это правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300115,
					"content": "Поможешь? Пожалуйста, пожалуйста, пожалуйста...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300116,
					"content": "Положись на меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "#Путешественни{F#ца}{M#к}, хочешь пойти посмотреть? Я могу отметить тебе, где обычно добываю руду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "Мастер Чжан"
				},
				{
					"id": 210300119,
					"content": "#Вот здесь. Будь {F#осторожна}{M#осторожен}. Там много монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "Мастер Чжан"
				},
				{
					"id": 210300120,
					"content": "#Полагаемся на тебя, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210300117,
					"content": "Хорошо... Придумаю что-нибудь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
		{
