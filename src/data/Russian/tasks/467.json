			"dialogs": [
				{
					"id": 4670301,
					"content": "Уже готово? Пахнет вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670302
					],
					"speakerTitle": "Линн"
				},
				{
