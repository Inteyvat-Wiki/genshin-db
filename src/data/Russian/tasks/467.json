			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Линн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4670101,
					"content": "Что бы мне ещё такого приготовить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670102
					],
					"speakerTitle": "Линн"
				},
				{
					"id": 4670102,
					"content": "О, здравствуйте! Вы здесь недавно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670103
					],
					"speakerTitle": "Линн"
				},
				{
					"id": 4670103,
					"content": "Мы путешествуем. А чем это так вкусно пахнет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4670104,
					"content": "Добро пожаловать в Мондштадт, путешественники!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670105
					],
					"speakerTitle": "Линн"
				},
				{
					"id": 4670105,
					"content": "Меня зовут Линн. Я инструктор по выживанию из Гильдии искателей приключений. Как вы могли заметить, я здесь экспериментирую с новыми рецептами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670106
					],
					"speakerTitle": "Линн"
				},
				{
					"id": 4670106,
					"content": "«Не путешествуй на голодный желудок!» - первое правило из «Руководства по выживанию в дикой природе».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670107
					],
					"speakerTitle": "Линн"
				},
				{
					"id": 4670107,
					"content": "Пикник! Вот что я люблю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4670108,
					"content": "#Мо{F#я}{M#й} {F#по}друг{F#а} тоже хорошо готовит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670801,
						4670901
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4670801,
					"content": "Только самые простые блюда...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670802
					]
				},
				{
					"id": 4670802,
					"content": "#Ничего страшного, котёл уже на огне! Давай посмотрим, на что ты способ{M#ен}{F#на}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670803
					],
					"speakerTitle": "Линн"
				},
				{
					"id": 4670803,
					"content": "Тебе выпал редкий шанс поучиться у настоящего эксперта по выживанию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "Линн"
				},
				{
					"id": 4671001,
					"content": "У меня есть грибы и курица. Ты можешь найти их вон в той бочке. Попробуй приготовить <color=#00E1FFFF>куриный шашлычок с грибами</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линн"
				},
				{
					"id": 4670901,
					"content": "Да, я просто обожаю готовить!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670902
					]
				},
				{
					"id": 4670902,
					"content": "#Котёл уже на огне! Давай посмотрим, на что ты способ{M#ен}{F#на}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670903
					],
					"speakerTitle": "Линн"
				},
				{
					"id": 4670903,
					"content": "Вместе готовить веселее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "Линн"
				}
			]
		},
