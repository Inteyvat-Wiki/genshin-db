				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610201,
					"content": "Вы передаёте энергию Адъюванта Замарану.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610202
					]
				},
				{
					"id": 710610202,
					"content": "Ого! Грибоголовый засветился! Теперь его можно звать Светоголовым?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610203,
					"content": "#Спасибо, {NICKNAME}. Спасибо, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610204
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610204,
					"content": "Благодаря вам в Замаране возродился свет жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610205
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610205,
					"content": "Но не нужно терять бдительность. Замаран знает, что порочная энергия ещё здесь и может напасть в любую минуту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610206
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610206,
					"content": "Ой, а что же тогда делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610207,
					"content": "Ой, откуда этот чёрный ил? Это его Грибоголовый называет порочной энергией?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7106103,
			"completionStepIds": [
				7106110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106110",
							"2"
						],
						"stepId": 7106110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610301,
					"content": "#Спасибо, {NICKNAME}. Спасибо, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610302
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610302,
					"content": "Долго никто не приходил на крики Замарана. Ладно бы многоногие и четвероногие, но и двуногие остались глухи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610303
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610303,
					"content": "#Только истинные мудрецы откликнулись на зов Замарана. Паймон мудрая и {NICKNAME} тоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610304
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610304,
					"content": "Лучшие из двуногих заслуживают благодарности Замарана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610323
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610323,
					"content": "Хм, Паймон Мудрую нельзя недооценивать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610305,
					"content": "Пустяки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610306
					]
				},
				{
					"id": 710610306,
					"content": "#Я верю, что придёт время, когда {NICKNAME} и Паймон смогут сравниться с Замараном и его сородичами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610307
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610307,
					"content": "Погоди, что ты, Грибоголовый, хочешь этим сказать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610308,
					"content": "Многоногий уступает четвероногому, четвероногий - двуногому и, естественно, двуногий - безногому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610309
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610309,
					"content": "#{NICKNAME} и Паймон, хоть вы и слабы от рождения, но преданностью и усилиями вы сможете изменить ход судьбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610310
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610310,
					"content": "Какой-то светящийся гриб, а такой заносчивый! Интересно, что можно приготовить из светящегося гриба...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610311,
						710610312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610311,
					"content": "Куриный шашлычок с грибами должен выйти просто отличным.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610312,
					"content": "Не заглядывайся на красивые грибы - они ядовиты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610313,
					"content": "У Паймон непомерный аппетит. Сегодня ест гриб, завтра ест гриб, а через сто дней не останется Паймон. Только гриб.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610314
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610314,
					"content": "#Ой, {NICKNAME}, Грибоголовый страшные вещи говорит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610315,
					"content": "Уф, Паймон не понимает юмора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610316
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610316,
					"content": "Это совсем не смешно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610317,
					"content": "И хоть Замарану удалось избавиться от порочной энергии, но сородичи всё ещё страдают. Но нынче силы у Замарана не те, что раньше. Замаран не может защитить слабых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610318
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610318,
					"content": "#Пожалуйста, {NICKNAME}, Замаран умоляет, спаси слабых, которые не могут спастись сами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610319
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610319,
					"content": "#Это те маленькие больные грибы? {NICKNAME}, ты им поможешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610320,
						710610321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610320,
					"content": "Раз уж мы здесь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610321,
					"content": "Если будет по дороге.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610322,
					"content": "Тогда пошли скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610207,
					"content": "Ой, откуда этот чёрный ил? Это его Грибоголовый называет порочной энергией?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7106104,
			"completionStepIds": [
				7106107
			],
