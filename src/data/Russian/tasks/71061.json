						710610503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610503,
					"content": "Но трещины заделаны, так что теперь всё должно быть в порядке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610504,
					"content": "#Спасибо, {NICKNAME}. Спасибо, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610505
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610505,
					"content": "Пусть не будет сожалений о вчерашнем дне и всего наилучшего в грядущем утре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610506
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610507
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610507,
					"content": "Похоже, что Грибоголовый снова заснул, поэтому нам лучше оставить его в покое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
