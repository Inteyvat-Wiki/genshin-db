			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610401,
					"content": "#Спасибо, {NICKNAME}. Спасибо, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610402
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610402,
					"content": "Неловко напоминать, но у двуногих есть поговорка: «Взялся за гуж, не говори, что не дюж».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610403,
						710610405
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610403,
					"content": "Ты хочешь ещё подкинуть нам поручений, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610404
					]
				},
				{
					"id": 710610405,
					"content": "Но ведь и ты не двуногий, так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610406
					]
				},
				{
					"id": 710610404,
					"content": "#Ты действительно заслуживаешь называться Мудр{M#ым}{F#ой} среди двуногих.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610406,
					"content": "Мы оба - живые существа, купающиеся в благословениях земли. Для нас естественно помогать друг другу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610407,
					"content": "Пожалуйста, примите эти Благословения мудрости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610408
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610408,
					"content": "Вы получаете Благословения мудрости.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610409
					]
				},
				{
					"id": 710610409,
					"content": "Ой... Какая подозрительная штуковина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610410,
					"content": "Замаран чувствует в воздухе порочную энергию, но не может определить, где источник. Идите вдоль воды и найдёте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610411
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610411,
					"content": "#{NICKNAME}, используй Благословения мудрости на источнике, а родня Замарана возьмёт на себя оставшееся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610412,
						710610413
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610412,
					"content": "Источник порочной энергии... Это действительно то, что нельзя оставлять без внимания.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610413,
					"content": "А кто тебе мешает разобраться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610414,
					"content": "#Вот {NICKNAME} шутки понимает. Не то что Паймон. У Замарана нет ног, а у тебя, {NICKNAME}, есть ноги, и работу ногами делают те, у кого есть ноги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610415
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610415,
					"content": "Кроме того, у Замарана есть более важная миссия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610416
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610416,
					"content": "А что это за миссия?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610417
					]
				},
				{
					"id": 710610417,
					"content": "#Подарок отнял слишком много сил. {NICKNAME} и Паймон - очень приятные собеседники, но Замарану нужно полежать в спячке, набраться сил бороться с порочной энергией, укрыть сенью своих сородичей и размножаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610418
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610418,
					"content": "#Благословляю тебя, {NICKNAME}. Благословляю тебя, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610419
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610419,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610420
					],
					"speakerTitle": "Замаран"
				},
				{
					"id": 710610420,
					"content": "Эй, Грибоголовый! Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610421,
					"content": "#{NICKNAME}, кажется, Грибоголовый уже спит. Идём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710610207,
					"content": "Ой, откуда этот чёрный ил? Это его Грибоголовый называет порочной энергией?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
