			},
			"dialogs": [
				{
					"id": 726950101,
					"content": "Бертран!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726950102,
					"content": "#{NICKNAME} и Паймон, вы очень вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950103
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950103,
					"content": "Моя Уникальная... В общем, моя Великолепная машина уже обработала ваши материалы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950104
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950104,
					"content": "Получилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950105
					]
				},
				{
					"id": 726950105,
					"content": "Это же машина, которую я создал своими руками! Конечно, она работает исправно! Мои технологии были выкованы в горнилах Фонтейна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950106
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950106,
					"content": "Кому как не нам, жителям Фонтейна, разбираться в работе этих тончайших приборов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950107
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950107,
					"content": "В прошлый раз всё взорвалось, потому что я поторопился и у меня не было помощников. Теперь всё будет иначе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950108
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950108,
					"content": "Ну раз так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726950109,
					"content": "Если снова всё взорвётся, то и мой последний вклад, и моя жизнь тоже взлетят на воздух.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950110
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950110,
					"content": "Даже если вы не верите мне, вас должна впечатлить моя решимость рискнуть жизнью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950111
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950111,
					"content": "Паймон даже не задумывалась, что в производстве игрушек нужно рисковать жизнью...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726950112,
					"content": "Ладно, в любом случае нам пора приступать к следующему этапу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950113
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950113,
					"content": "На всякий случай уточню: вы завершили первый из трёх этапов - «Сбор материалов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950114
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950114,
					"content": "Какой следующий этап: «Сбор ядер» или «Сбор энергии»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950115,
						726950118
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950115,
					"content": "«Сбор ядер»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950116
					]
				},
				{
					"id": 726950116,
					"content": "Поздравляю... ты ошибаешься. Если бы вы пошли собирать ядра, то внесли бы свой вклад в крах моей жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950117
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950117,
					"content": "Правильный ответ - «Наполнение энергией».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950121,
					"content": "В общем... так называемое «Наполнение энергией» происходит под воздействием элементов, когда вы держите коллектор материалов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950122
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950122,
					"content": "Например, я хочу собрать Гидро элемент, тогда я пойду с коллектором в реку, а если я хочу собрать Электро элемент...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950123
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950123,
					"content": "Нужно, чтобы стукнула молния?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726950124,
					"content": "Ох, вы настоящие искатели приключений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950125
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950125,
					"content": "Я уверен, вы даже устроены, как искатели приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950126
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950126,
					"content": "Устроены, как искатели приключений?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950127
					]
				},
				{
					"id": 726950127,
					"content": "Честно говоря, вступить в контакт с элементальными существами - лучший способ. Я отметил на карте три точки, где они часто появляются...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950128
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950128,
					"content": "Я уже собирался сам отправиться туда на лодке и поискать этих существ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950129
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950129,
					"content": "Это же опасно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726950130,
					"content": "Но теперь вы сами можете туда отправиться и посмотреть, есть ли там существа или нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950131
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950131,
					"content": "Да, вы точно справитесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950118,
					"content": "«Сбор энергии»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950119
					]
				},
				{
					"id": 726950119,
					"content": "#Что ж, казалось бы, так оно и есть... Но, по правде говоря, не «Сбор энергии», а «Наполнение энергией». Не ожидал{F#а}, что я предложу тебе два неправильных варианта, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950120
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950120,
					"content": "Как же раздражает его смех...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
