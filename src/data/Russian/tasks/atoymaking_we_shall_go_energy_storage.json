			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бертран"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950201,
					"content": "Хм... Элементы из коллектора нужно помещать в машину после каждого сбора, поэтому для каждого цикла потребуется три поездки. Не так-то это и просто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950202
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950202,
					"content": "Я подумаю, как можно сделать легче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бертран"
				}
			]
		},
		{
			"id": 7269503,
			"completionStepIds": [
				7269503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269503",
							"2"
						],
						"stepId": 7269503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бертран"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950301,
					"content": "Получается у вас пользоваться коллектором?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950302
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950302,
					"content": "Да, вполне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950303
					]
				},
				{
					"id": 726950303,
					"content": "Этот коллектор - моя гордость и радость. Он хорош и для сбора материалов, и для хранения элементов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950304
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950304,
					"content": "Если честно, я подумываю о том, чтобы сменить название...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950305
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950305,
					"content": "Паймон кажется, что «коллектор материалов» совсем неплохо звучит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950306,
						726950307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726950306,
					"content": "Я тоже так думаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				},
				{
					"id": 726950308,
					"content": "Правда? А мне вот кажется, что это название описывает не все возможности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950309
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950309,
					"content": "Что ж, давайте мне коллектор материалов. Как и в прошлый раз, нужно будет понаблюдать за пробным этапом, особенно за элементами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950310
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950310,
					"content": "Скорее всего, мы сможем продолжить только после того, как стабилизируются элементальные реакции в Великолепной машине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950311
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950311,
					"content": "Я очень рассчитываю на вашу помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726950307,
					"content": "Очень подходит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				}
			]
		}
	]
}