					"Рафик"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190401,
					"content": "#Ну как всё прошло? Осмотрел{F#а} лодку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190402
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190402,
					"content": "#Да, осмотрел{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190403
					]
				},
				{
					"id": 230190403,
					"content": "Вы описываете состояние корабля...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230190404
					]
				},
				{
					"id": 230190404,
					"content": "То есть у этих «экономных» конструкций есть свои проблемы. Оно и понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190405
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190405,
					"content": "Но обслуживание таких конструкций дело очень дорогое. Насколько я помню, у хозяина не самое лучшее материальное положение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190406
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190406,
					"content": "Ох, пойду поговорю с ним. Всё-таки жизни важнее денег.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рафик"
				}
			]
		}
