			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рафик"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190101,
					"content": "Ну вот, я и думал, что так будет дороже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190102
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190102,
					"content": "О чём ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190103
					]
				},
				{
					"id": 230190103,
					"content": "А, привет. Я изучаю проблемы в проектировании одного судна. А сейчас... зашёл в тупик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190104
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190104,
					"content": "Проще говоря, я хочу сделать судно более вместительным, не повышая затрат на его изготовление.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190105
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190105,
					"content": "При большем весе конструкция потеряет прочность, а при неравномерном распределении веса может возникнуть проблема баланса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190106
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190106,
					"content": "Лучшим решением будет замена материала на более качественный, но тогда снова возникает проблема расходов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190107
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190107,
					"content": "В целом, проблема в том, что у меня нет денег, а хочется создать хорошее судно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190108
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190108,
					"content": "Поэтому проблемы, которые можно решить с помощью денег, я должен обойти с помощью техники.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190109
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190109,
					"content": "А получится?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190110
					]
				},
				{
					"id": 230190110,
					"content": "Ха-ха, не поверишь, но многие так и делают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190111
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190111,
					"content": "В конце концов, у нас рыболовные судна, они не предназначены для дальних плаваний в шторм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190112
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190112,
					"content": "Поэтому все стараются экономить: починить то, что можно починить. Лодка на ходу - и сойдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190113
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190113,
					"content": "Именно благодаря такому подходу наше дело починки судов процветает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190114
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190114,
					"content": "#Путешественни{F#ца}{M#к}, не {F#могла}{M#мог} бы ты осмотреть судно, которое только что прибыло в порт? Кажется, у него какие-то проблемы из-за перевозки тяжёлых грузов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190115
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190115,
					"content": "Я как раз изучаю этот вопрос, может, это мне даст вдохновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190116,
						230190118
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190116,
					"content": "Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190117
					]
				},
				{
					"id": 230190117,
					"content": "Вот спасибо большое. Ах, мне пора - нужно чинить другой корабль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190118,
					"content": "Почему ты сам не пойдёшь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190119
					]
				},
				{
					"id": 230190119,
					"content": "Я хочу, но меня отправили на починку другой лодки - им срочно нужно забрать сети в море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190120
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230190120,
					"content": "#Поэтому мне ничего не остаётся, как просить тебя о помощи, путешественни{F#ца}{M#к}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рафик"
				}
			]
		},
