	"talks": [
		{
			"id": 2301901,
			"completionStepIds": [
				2301901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
