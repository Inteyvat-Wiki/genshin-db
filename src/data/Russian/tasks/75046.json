			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Урубамба"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "У-у-у... Где же вы? У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460102,
					"content": "Привет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "У-у-у... У... Ох.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460104,
					"content": "Мне плохо. Так... грустно. И ничего не поможет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460105,
					"content": "Вышел ненадолго купить соломы, а восемь моих татанказавриков куда-то убежали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460106,
					"content": "Они ещё совсем крошки, а если на них нападут хиличурлы? А если они заблудятся? А если попадут в ловушку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460107,
					"content": "#{F#Добрая девушка}{M#Добрый человек}, ты случайно не видел{F#а} моих татанказавриков?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460108,
					"content": "А как они выглядят?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "Я вырастил их матушку. Она мне почти как родная дочка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460110,
					"content": "Их матушка - красивейшая из всех татанказавров Удела Благодатных Земель. На нашем конкурсе красоты она была удостоена особого приза!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460111,
					"content": "Все восемь озорников унаследовали красоту своей матушки. У них светло-розовая шкура и идеально симметричные фиолетовые рога, похожие на два веера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460112,
					"content": "Если встретишь моих озорников, постарайся вернуть их домой. Очень тебя прошу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460113,
					"content": "Мои заврята... Дедушка никогда больше не будет с вами строг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460118,
					"content": "Постараюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "#Спасибо, {F#добрая девушка}{M#добрый человек}! Желаю тебе побить рекорд в жиме лёжа! И подтягиваться легко и свободно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Урубамба"
				}
			]
		},
