				},
				{
					"id": 750460202,
					"content": "Запомни их приметы: <color=#00E1FFFF>розовая шкура, фиолетовые рога.</color> Не перепутай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460203
					],
					"speakerTitle": "Урубамба"
				},
				{
