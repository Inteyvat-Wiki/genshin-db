						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Урубамба"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750460801,
					"content": "У-у-у... Где же вы? У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460802
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460802,
					"content": "Привет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460803
					]
				},
				{
					"id": 750460803,
					"content": "У-у-у... У... Ох.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460804
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460804,
					"content": "Мне плохо. Так... грустно. И ничего не поможет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460805
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460805,
					"content": "Вышел ненадолго купить соломы, а восемь моих татанказавриков куда-то убежали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460806
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460806,
					"content": "Они ещё совсем крошки, а если на них нападут хиличурлы? А если они заблудятся? А если попадут в ловушку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460807
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460807,
					"content": "#{F#Добрая девушка}{M#Добрый человек}, ты случайно не видел{F#а} моих татанказавриков?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460808
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460808,
					"content": "А как они выглядят?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460809
					]
				},
				{
					"id": 750460809,
					"content": "Я вырастил их матушку. Она мне почти как родная дочка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460810
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460810,
					"content": "Их матушка - красивейшая из всех татанказавров Удела Благодатных Земель. На нашем конкурсе красоты она была удостоена особого приза!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460811
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460811,
					"content": "Все восемь озорников унаследовали красоту своей матушки. У них светло-розовая шкура и идеально симметричные фиолетовые рога, похожие на два веера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460812
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460812,
					"content": "Если встретишь моих озорников, постарайся вернуть их домой. Очень тебя прошу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460813
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460813,
					"content": "Мои заврята... Дедушка никогда больше не будет с вами строг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460814
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460814,
					"content": "#Я отыскал{F#а} нескольких заврят.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460815
					]
				},
				{
					"id": 750460815,
					"content": "#Спасибо, {F#добрая девушка}{M#добрый человек}! Как хорошо, что они целы и невредимы. Я весь извёлся от беспокойства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460816
					],
					"speakerTitle": "Урубамба"
				},
				{
					"id": 750460816,
					"content": "#Но мы до сих пор не знаем, где остальные! Ох, не мог{F#ла} бы ты продолжить поиски? Если встретишь их, сразу веди домой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Урубамба"
				}
			]
		}
	]
}