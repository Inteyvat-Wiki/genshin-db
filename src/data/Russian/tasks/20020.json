				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Анна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "#С возвращением, путешественни{F#ца}{M#к}! Как всё прошло? Получилось сделать фотографии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200201002,
					"content": "Всё есть. И фотографии, и образцы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "#Ничего себе! Ты {F#управилась}{M#управился} так быстро... Вот это я понимаю, {F#опытная искательница приключений}{M#опытный искатель приключений}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200201004,
					"content": "#Большое спасибо, путешественни{F#ца}{M#к}! А давай я тебе в знак благодарности кое-что приготовлю? Будет вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200201005,
					"content": "Выглядит славно, да? Надеюсь, тебе понравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200201006,
					"content": "А я пойду и займусь записями. Хм, что же до этих растений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200201007,
					"content": "Надо будет спросить у Джека, как их сохранить в качестве образцов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200201008,
					"content": "Ну а сесилии лучше будут смотреться в вазе, нежели в гербарии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				}
			]
		},
