				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200200101,
					"content": "Так вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200102
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200102,
					"content": "Скажи-ка, братишка, на что ещё кроме еды годятся эти растения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200103
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200103,
					"content": "Откуда мне такое знать?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200104
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200200104,
					"content": "Мне известно, где они растут и съедобны ли, вот и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200105
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200200105,
					"content": "Хм... Тогда я сама проверю. Не переживай, я просто иду собирать растения. К чудовищам и близко не подойду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200106
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200106,
					"content": "Ох, просто будь осторожна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200107
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200200107,
					"content": "Знаю. Сегодня я вернусь чуть позже обычного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200108,
						200200109
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200108,
					"content": "Всё тренируешься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				},
				{
					"id": 200200110,
					"content": "#Привет, путешественни{F#ца}{M#к}! Я как раз собиралась пойти изучать растения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200111
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200111,
					"content": "Сайрус сказал, что искателям приключений крайне важно уметь находить еду во время вылазок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200112
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200112,
					"content": "Поэтому я решила изучить некоторые растения в окрестностях, записать их особенности и свойства и понемногу всё запомнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200113
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200113,
					"content": "Таким образом, во время сбора еды в дикой природе я смогу отличить, какие растения съедобные, а какие нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200114
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200114,
					"content": "Но... Не думаю, что одного словесного описания будет достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200115
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200115,
					"content": "#{NICKNAME}, я слышала, у тебя есть прибор под названием «фотокамера». Это правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200116
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200116,
					"content": "#Если да, не {F#могла}{M#мог} бы ты сделать снимки нескольких видов в их естественной среде произрастания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200117
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200117,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200118
					]
				},
				{
					"id": 200200118,
					"content": "Тогда, пожалуйста, сфотографируй для меня лилию калла, траву-светяшку и сесилию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200119
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200119,
					"content": "А после этого сорви и принеси их мне. Я хотела бы оставить их себе в качестве образцов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200120
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200120,
					"content": "Изображения растений в их естественной среде, живые образцы, подробное описание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200121
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200121,
					"content": "Раздел растений моего справочника выйдет очень неплохим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200122
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200122,
					"content": "#Тогда дело за тобой, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200123
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200123,
					"content": "Лилия калла растёт у ручья в Спрингвейле, а траву-светяшку можно найти в Вольфендоме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200124
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200124,
					"content": "А за сесилиями... разумеется, нужно будет сходить на утёс Звездолова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200125
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200125,
					"content": "Я же тем временем продолжу изучать растения в других местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200126
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200126,
					"content": "Когда фотографии будут готовы, встретимся в городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				},
				{
					"id": 200200109,
					"content": "Как идут твои тренировки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				}
			]
		},
		{
			"id": 2002010,
			"completionStepIds": [
				2002025,
				2002026
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2002025",
							"2"
						],
						"stepId": 2002025,
						"stateName": "QUEST_STATE_UNFINISHED"
