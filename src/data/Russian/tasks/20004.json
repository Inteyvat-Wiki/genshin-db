				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040301,
					"content": "О, привет. Давно не виделись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040302
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 200040302,
					"content": "Кажется, вы торопитесь. Не меня ищете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040303
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 200040303,
					"content": "Ты где пропадала, Мона?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200040304,
					"content": "Мы тебя уже несколько дней ищем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040305
					]
				},
				{
					"id": 200040305,
					"content": "Вот незадача... Недавно «Паровая птица» заказала у меня новую статью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040306
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 200040306,
					"content": "Её тема - связь между смещением звёзд и человеческими судьбами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040307
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 200040307,
					"content": "Чтобы написать её, эти дни я изучала звёзды и возвращалась очень поздно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040308
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 200040308,
					"content": "Ах, Мона так старается заработать денег...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200040309,
					"content": "Ну и в Кур-де-Фонтейне вышла новая версия звёздного глобуса, а я уже заплатила задаток.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040310
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 200040310,
					"content": "Когда я получу гонорар за статью, то полностью рассчитаюсь, и звёздный глобус будет мой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040311
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 200040311,
					"content": "Только не забудь заплатить Гёте за аренду...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040312
					]
				},
				{
					"id": 200040312,
					"content": "Аренду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040313
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 200040313,
					"content": "Ой!.. Я, конечно же, отложила немного денег...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040314
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 200040314,
					"content": "Подождите минутку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040315
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 200040315,
					"content": "Мона судорожно перебирает содержимое кошелька...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200040316
					]
				},
				{
					"id": 200040316,
					"content": "Вот... и вот ещё! Этого должно хватить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040317
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 200040317,
					"content": "(Кажется, Мона отдала последние деньги...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040318
					]
				},
				{
					"id": 200040318,
					"content": "Пожалуйста, передайте это Гёте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				}
			]
		},
