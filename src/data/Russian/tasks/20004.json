			},
			"dialogs": [
				{
					"id": 200040501,
					"content": "Вы вернулись. Гёте получил деньги за аренду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040502
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 200040502,
					"content": "Да, получил.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040503
					]
				},
				{
					"id": 200040503,
					"content": "Отлично. К счастью, аренда той комнаты обходится не так уж и дорого... Мне едва удалось наскрести денег.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040504
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 200040504,
					"content": "Думаю, несколько дней мне предстоит питаться салатом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				}
			]
		},
