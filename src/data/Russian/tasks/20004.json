			"dialogs": [
				{
					"id": 200040401,
					"content": "Ну что? Удалось найти Ас... эм... вашу подругу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040402
					],
					"speakerTitle": "Гёте"
				},
				{
					"id": 200040402,
					"content": "Вот плата за аренду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040403
					]
				},
				{
					"id": 200040403,
					"content": "Хорошо, хорошо. Этого достаточно. Спасибо вам большое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040404
					],
					"speakerTitle": "Гёте"
				},
				{
					"id": 200040404,
					"content": "Всё же мне любопытно, чем ваша подруга занимается?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040405
					],
					"speakerTitle": "Гёте"
				},
				{
					"id": 200040405,
					"content": "Она же такая одарённая девушка, но такая бедная...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гёте"
				}
			]
		},
		{
