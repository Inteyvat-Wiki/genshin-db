			"trigger": {
				"objectNames": [
					"Харрис"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210101,
					"content": "Ей бы перед приключением подкрепиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210102
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 205210102,
					"content": "О чём ты, Харрис?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210103
					]
				},
				{
					"id": 205210103,
					"content": "А, я о том, что Айрис перед вылазкой в горы стоит поесть горячей еды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210104
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 205210104,
					"content": "Она решила собрать группу для очередной вылазки в горы. Но сперва она хочет в одиночку разбить в горах лагерь, изучить обстановку и разработать план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210105
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 205210105,
					"content": "Её наблюдательный лагерь не так далеко отсюда, и доставить припасы будет несложно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210106
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 205210106,
					"content": "Драконий хребет - место суровое, и я подумал, что горячая еда придала бы ей сил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210107
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 205210107,
					"content": "Но сам я отправиться в горы не отважусь... Если тебя не затруднит, доставь Айрис сливочное рагу, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210108,
						205210110
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 205210108,
					"content": "Не вопрос.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210109
					]
				},
				{
					"id": 205210109,
					"content": "Большое тебе спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 205210113,
					"content": "Рагу с пылу с жару. Доставь его Айрис, пока оно не остыло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210114
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 205210114,
					"content": "Но если по пути что-нибудь случится и блюдо придёт в непригодность, возвращайся ко мне. Я приготовлю тебе свежую порцию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Харрис"
				},
				{
					"id": 205210110,
					"content": "Где именно мне её искать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210111
					]
				},
				{
					"id": 205210111,
					"content": "Она говорила, что разобьёт свой лагерь где-то на склоне горы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210112
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 205210112,
					"content": "Опытный искатель приключений вроде неё просто так отходить далеко от лагеря не станет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Харрис"
				}
			]
		},
		{
			"id": 2052102,
			"completionStepIds": [
				2052102
