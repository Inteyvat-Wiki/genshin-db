			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Айрис"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210301,
					"content": "Это сливочное рагу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210302
					]
				},
				{
					"id": 205210302,
					"content": "Тебя, должно быть, послал Харрис. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210303
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 205210303,
					"content": "Лучше к таким вкусностям не привыкать, иначе возвращаться к сухому пайку будет очень трудно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210304
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 205210304,
					"content": "Ха-ха-ха, шутка. Мне, как искателю приключений, к трудностям не привыкать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210305
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 205210305,
					"content": "Ты собираешься идти глубже в горы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210306
					]
				},
				{
					"id": 205210306,
					"content": "Конечно. Этот лагерь всего лишь перевалочный. Я буду двигаться дальше, а когда попадётся удобное место, то разобью ещё один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210307
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 205210307,
					"content": "А там котелок с горячей едой меня точно ждать не будет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210308
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 205210308,
					"content": "Впрочем, бежать вперёд, очертя голову, я не буду. Оценю обстановку и тут же вернусь в базовый лагерь. Пока не будет подробного плана, я ничего не стану предпринимать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210309
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 205210309,
					"content": "#Спасибо, что уделил{F#а} время и прин{F#есла}{M#ёс} мне еду. Это тебе за хлопоты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айрис"
				}
			]
		},
