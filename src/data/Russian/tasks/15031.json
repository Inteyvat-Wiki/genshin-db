			"dialogs": [
				{
					"id": 150310301,
					"content": "Есть! Отличный результат. Смотрите, флогистон, который был в нём, всё ещё активен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310302
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150310302,
					"content": "Посмотрим... Ой, горячо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150310303,
					"content": "Надо найти ещё несколько таких. Давайте поднимемся наверх.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вареса"
