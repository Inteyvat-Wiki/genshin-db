			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Цзи Тун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020201,
					"content": "#Погоди-ка, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020202
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020202,
					"content": "Что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020203
					]
				},
				{
					"id": 414020203,
					"content": "Знаю, это прозвучит неожиданно, но... Тебе нравятся фотокамеры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020204,
						414020205
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020204,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				},
				{
					"id": 414020206,
					"content": "Ну, эта фотокамера необычная. Это новейшая разработка Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020207
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020207,
					"content": "Фотокарточки, которые она распечатывает, получаются с особыми эффектами, каких в обычных камерах нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020208,
						414020209
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020208,
					"content": "Как так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020210,
					"content": "Эй, ты что, не веришь мне? Гильдия искателей приключений может всё тебе подтвердить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020211
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020211,
					"content": "Я тоже не верил. Я провозился с ней полдня, но всё не мог заставить её работать, когда ко мне на помощь пришёл один искатель приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020212
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020212,
					"content": "От обычных моделей она отличается тем, что у неё внутри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020213
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020213,
					"content": "Для печати в ней используется особое зелье, благодаря которому фотокарточки выглядят намного лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020214
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020214,
					"content": "Что скажешь? Если я смог тебя заинтересовать, ты можешь некоторое время ею попользоваться. Видов зелий у неё немного, но составить впечатление хватит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020215
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020215,
					"content": "Скоро я поеду в Фонтейн, чтобы закупить партию новых зелий, так что я буду рад видеть тебя в качестве клиента.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020216,
						414020217
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020216,
					"content": "Ну... Спасибо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020219
					]
				},
				{
					"id": 414020219,
					"content": "Камеру я дарю тебе. Если она тебе понравится, я буду рад иметь с тобой дело в будущем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020217,
					"content": "Сколько ты хочешь за эти зелья?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020218
					]
				},
				{
					"id": 414020218,
					"content": "За цену не переживай. Стоят они очень дёшево, а если тебе нужно много, можем договориться о скидке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020219
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020209,
					"content": "Что, правда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020205,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				}
			]
		},
		{
			"id": 4140203,
			"completionStepIds": [
				4140203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4140203",
							"2"
						],
						"stepId": 4140203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзи Тун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020301,
					"content": "Эта фотокамера тебе. Пожалуйста, прими её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020302,
						414020303
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020302,
					"content": "Ты... даришь её мне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				},
				{
					"id": 414020304,
					"content": "На некоторое время его будет достаточно, а когда оно кончится... Ты сможешь купить у меня ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020305
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020305,
					"content": "Кстати, я собираюсь связаться с тем торговцем и ввезти ещё больше видов зелий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020306
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020306,
					"content": "Если тебя что-нибудь заинтересует, я буду рад видеть тебя вновь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020307
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020307,
					"content": "Вот уж не ожидал, что вместе с камерой я куплю целый бизнес...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020303,
					"content": "А если зелье закончится?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				}
			]
		}
	]
}