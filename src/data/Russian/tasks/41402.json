			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Цзи Тун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020101,
					"content": "О, здравствуй. Я как раз хотел с тобой поговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020102,
						414020103
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020102,
					"content": "О чём?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				},
				{
					"id": 414020104,
					"content": "Нет, вовсе нет. Я уже разобрался, в чём дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020105
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020105,
					"content": "Мне удалось-таки найти того торговца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020106
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020106,
					"content": "Я сказал ему, что он продал мне проблемную камеру, но торговец не поверил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020107
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020107,
					"content": "К счастью, у меня были с собой твои фотокарточки. Без них убедить его было бы невозможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020108
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020108,
					"content": "Увидев их, он наконец-таки согласился осмотреть проданную мне камеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020109
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020109,
					"content": "Не далее как вчера пришёл он ко мне, да ещё и бутылочку зелья захватил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020110
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020110,
					"content": "Он пояснил, что эта фотокамера от обычных моделей отличается, и для нормальной печати фотокарточек в неё нужно заливать вот это вот зелье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020111
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020111,
					"content": "Без него на выходе будет сплошной цвет и никакой резкости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020112,
						414020113
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020112,
					"content": "Камера в порядке, и это хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020114,
					"content": "Ну... Теперь это зелье мне куда интереснее камеры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020115
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020115,
					"content": "Только подумай. Все просто покупают камеру, так? Купил, и пользуйся сколько влезет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020116
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020116,
					"content": "Но зелье-то заканчивается, и его придётся покупать снова и снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020117
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020117,
					"content": "Торговец тот говорил ещё, что разные зелья дают разные эффекты. Он сейчас разрабатывает новые виды зелий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020118
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020118,
					"content": "Может быть... На них можно будет заработать много моры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020119
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020119,
					"content": "Прости, что-то меня занесло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020120
					],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020120,
					"content": "Спасибо тебе за помощь. Подай мне фотокамеру, и я налью в неё зелье...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзи Тун"
				},
				{
					"id": 414020113,
					"content": "Значит, теперь всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020103,
					"content": "Снова нужны яркие фотокарточки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				}
			]
		},
		{
			"id": 4140202,
