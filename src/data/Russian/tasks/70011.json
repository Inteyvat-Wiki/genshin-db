			"dialogs": [
				{
					"id": 700110101,
					"content": "Yaya dala! Kundala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110102
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700110102,
					"content": "Mimi nye odomu! Kundala nye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110103
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700110103,
					"content": "Nye Odomu? Yoyo mani mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110104
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700110104,
					"content": "Mimi tomo, mimi plata odomu! Mimi mani ye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110105
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700110105,
					"content": "Mani?.. Zido mi, mi dada. Nye kundala? Mi plata yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110106
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700110106,
					"content": "Ух ты... Этот парень - ворчун!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110107,
						700110108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700110107,
					"content": "Мисс Маск, осторожно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700110109
					]
				},
				{
					"id": 700110109,
					"content": "Пожалуйста, не волнуйтесь. Всё в порядке. Я всё понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110110
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700110110,
					"content": "А?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700110111,
					"content": "Он просто хочет, чтобы мы помогли ему одолеть врага. Враг находится вот здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110113
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700110113,
					"content": "Понятно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700110114
					]
				},
				{
					"id": 700110114,
					"content": "Место отмечено на карте. Дальше дело за тобой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110115
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700110115,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700110108,
					"content": "Нужна наша помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700110109
					]
				}
			]
		},
