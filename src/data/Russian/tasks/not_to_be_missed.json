			"dialogs": [
				{
					"id": 206020501,
					"content": "#Ты вернул{F#ась}{M#ся}! Как дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020502
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206020502,
					"content": "Монстры всё ещё бродят по округе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206020503
					]
				},
				{
					"id": 206020503,
					"content": "Монстры всё ещё в окрестностях? Кажется, влияние того шторма ещё не рассеялось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020504
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206020504,
					"content": "Ха-ха, да это шанс! Шанс показать людям силу Гильдии искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020505
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206020505,
					"content": "Ордо Фавониус всё ещё сосредоточен на защите Мондштадта и прилежащих к нему земель, а с монстрами за пределами города им поможет Гильдия искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020506
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206020506,
					"content": "Я понял. Спасибо тебе за помощь. Я пересмотрю опубликованные поручения. Вот, это тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайрус"
				}
			]
		},
