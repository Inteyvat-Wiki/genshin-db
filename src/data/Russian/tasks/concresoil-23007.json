			"dialogs": [
				{
					"id": 230070201,
					"content": "Сейчас у меня есть несколько идей. Вот сегодня я ищу землю, пропитанную слизью слайма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070202
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070202,
					"content": "#Кое-кто показал мне место, где собираются слаймы. Путешественни{F#ца}{M#к}, ты можешь помочь мне собрать глину?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070203,
						230070206
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070203,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070204
					]
				},
				{
					"id": 230070204,
					"content": "Спасибо тебе. Неважно, что ты сделаешь со слаймами, самое главное собери глину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070205
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070205,
					"content": "Я отмечу место тебе на карте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070206,
					"content": "А ты сам не пойдёшь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070207
					]
				},
				{
					"id": 230070207,
					"content": "Мне очень хочется пойти, но мне ещё всякими горшками надо заниматься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070208
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070208,
					"content": "Но не волнуйся, я тебя награжу. Сделай это для меня, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070209
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070209,
					"content": "Отправляйся вот сюда, я тебе на карте отметил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070210
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070210,
					"content": "Спасибо тебе. Неважно, что ты сделаешь со слаймами, самое главное собери глину.",
					"roleType": "TALK_ROLE_NPC",
