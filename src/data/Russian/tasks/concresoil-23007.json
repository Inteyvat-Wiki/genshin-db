			"dialogs": [
				{
					"id": 230070301,
					"content": "Сейчас у меня есть несколько идей. Вот сегодня я ищу глину, с которой соприкасаются элементальные существа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070302
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070302,
					"content": "Вариант с попрыгуньями неплохой, потому что земля, на которой они растут, обладает особыми характеристиками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070303
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070303,
					"content": "Но я обычный каменщик, поэтому никак не смогу справиться с попрыгуньями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070304
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070304,
					"content": "#Путешественни{F#ца}{M#к}, можно попросить тебя помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070305,
						230070308
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070305,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070306
					]
				},
				{
					"id": 230070306,
					"content": "Тогда принеси мне землю, на которой растут попрыгуньи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070307
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070307,
					"content": "Я расскажу тебе про место, где обычно появляются попрыгуньи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070308,
					"content": "А ты сам не пойдёшь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070309
					]
				},
				{
					"id": 230070309,
					"content": "Мне очень хочется пойти, но мне ещё всякими горшками надо заниматься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070310
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070310,
					"content": "Но не волнуйся, я тебя награжу. Сделай это для меня, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070311
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070311,
