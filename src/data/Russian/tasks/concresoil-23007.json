					"Аким"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230070101,
					"content": "А есть ли материал получше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070102
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070102,
					"content": "Какой материал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070103
					]
				},
				{
					"id": 230070103,
					"content": "Ой, это я опять сам с собой разговариваю. В последние дни погода часто меняется, поэтому со зданиями возникает много проблем, которыми я и занимаюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070104
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070104,
					"content": "А ты разве не гончарным ремеслом занимаешься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070105
					]
				},
				{
					"id": 230070105,
					"content": "Ага, но ещё я кирпичи кладу. Ну то есть всё равно с глиной работаю, так что разница небольшая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070106
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070106,
					"content": "Вы слышали такую фразу? «Обучение похоже на строительство дома. Чтобы построить высокое здание, нужно заложить крепкий фундамент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070107
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070107,
					"content": "А если хотите расширить знания, то нужно убедиться в прочности основания. Если оно шаткое, то всё рухнет».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070108
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070108,
					"content": "Вот так говорили великие люди. Я не очень во всём этом разбираюсь, но, как видите, они считают, что строительство дома и обучение одинаково важны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070109,
						230070110
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070109,
					"content": "Это просто метафора...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				},
				{
					"id": 230070111,
					"content": "Как бы то ни было, но для фундамента дома нужны материалы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070112
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070112,
					"content": "Глина используется в качестве связующего и поддерживающего материала. Если улучшить качества глины, то дом будет более устойчивым, и мне не придётся так много работать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аким"
				},
				{
					"id": 230070110,
					"content": "#...Не уверен{F#а}, что так можно трактовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				}
			]
		},
