			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790200101,
					"content": "Так, так, так... Дай-ка посмотреть. Похоже на карту сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790200102,
					"content": "Правда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200103
					]
				},
				{
					"id": 790200103,
					"content": "Паймон никогда не ошибается, когда дело касается сокровищ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790200116,
					"content": "Похоже, это изображение оставили пираты Ако Домэки. Кажется, мы уже где-то слышали это имя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790200104,
					"content": "Смотри, здесь написано: «спрятано сокровище...» Видишь? Здесь есть сокровище, которое только и ждёт, когда мы его найдём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790200105,
					"content": "Давай читать дальше... «...разделили на четыре части...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790200106,
					"content": "Значит, они разделили что-то на четыре части?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200107,
						790200108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790200107,
					"content": "Они разделили сокровище?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				},
				{
					"id": 790200109,
					"content": "Я не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790200110,
					"content": "Как бы там ни было, здесь говорится, что нечто было помещено «среди рифов четырёх больших островов». Наверняка это рифы островов архипелага Золотого Яблока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790200111,
					"content": "Это, случайно, не один из этих рифов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790200112,
					"content": "Хм, значит, должно быть четыре подсказки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200113
					]
				},
				{
					"id": 790200113,
					"content": "И они находятся рядом с рифами четырёх островов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790200114,
					"content": "Скорее всего, говорится о четырёх самых больших островах архипелага.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790200115,
					"content": "Давай осмотрим другие три острова и посмотрим, что удастся найти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790200108,
					"content": "Они разделили подсказки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				}
			]
		},
