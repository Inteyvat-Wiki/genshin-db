				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Муалани",
					"Кинич",
					"Ахав",
					"Качина",
					"Ситлали"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270101,
					"content": "Восхищаюсь Пиро Архонтом! Она такая храбрая! Не побоялась помериться силами с великим Шбаланке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270102
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 50270102,
					"content": "Не скромничай. Ты бы тоже не побоялась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270103
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 50270103,
					"content": "Ха! А кто бы побоялся? Я нет! А ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270104
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 50270104,
					"content": "Я... я бы не стала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270105
					],
					"speakerTitle": "Качина"
				},
				{
					"id": 50270105,
					"content": "Тяга к сражениям в природе воина, тут не идёт речь про страх. В нужный момент инстинкты сделают выбор за вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270106
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 50270106,
					"content": "Эх... Да уж, энергии вам не занимать... Вы говорите о великом Шбаланке! О нашем могучем предке! Неужели вас так тянет помериться силами со старшими?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270107
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 50270107,
					"content": "Бабушка Ситлали! Давай как-нибудь тоже устроим дружеский поединок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270108
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 50270108,
					"content": "Нет, нет и ещё раз нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ситлали"
				}
			]
		},
		{
			"id": 502702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"502701",
							"2"
						],
						"stepId": 502701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Маусау",
					"Оророн",
					"Иансан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270201,
					"content": "Как думаешь, каким овощем я стану? Красным... или зелёным?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270202
					],
					"speakerTitle": "Маусау"
				},
				{
					"id": 50270202,
					"content": "Ты? Я думаю, что ты превратишься в лук.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270203
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 50270203,
					"content": "Лук?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270204
					],
					"speakerTitle": "Маусау"
				},
				{
					"id": 50270204,
					"content": "Ты неказистый на вид, но любой враг, который попытается напасть на тебя, зальётся слезами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270205
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 50270205,
					"content": "Да? Звучит круто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270206
					],
					"speakerTitle": "Маусау"
				},
				{
					"id": 50270206,
					"content": "О чём они вообще говорят...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270207
					],
					"speakerTitle": "Иансан"
				},
				{
					"id": 50270207,
					"content": "Лук - это сила. Однажды прихожу я в гости к своему другу, а он режет лук. Сам льёт слёзы, завриан его льёт слёзы, всё живое в доме льёт слёзы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270208
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 50270208,
					"content": "И ты? Ты тоже залился слезами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270209
					],
					"speakerTitle": "Иансан"
				},
				{
					"id": 50270209,
					"content": "Я тоже был там, но вовремя прикрыл глаза плащом. Какуку и Ифа не видели моего лица и подумали, что я тоже плачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270210
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 50270210,
					"content": "Я стану человеком-луковицей! И при встрече со мной все будут рыдать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270211
					],
					"speakerTitle": "Маусау"
				},
				{
					"id": 50270211,
					"content": "Не вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270212
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 50270212,
					"content": "Очень хочется сменить тему, но я понятия не имею, как остановить этот разговор...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270213
					],
					"speakerTitle": "Иансан"
				},
				{
					"id": 50270213,
					"content": "Иансан, а ты будешь маленький... грибочек. Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270214
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 50270214,
					"content": "Тебя никто не спрашивал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270215
					],
					"speakerTitle": "Иансан"
				},
				{
					"id": 50270215,
					"content": "Грибочек? Неплохо. Грибы крепкие и задорные. Мне они нравятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270216
					],
					"speakerTitle": "Иансан"
				},
				{
					"id": 50270216,
					"content": "Значит, сестрица Иансан тоже задорная?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270217
					],
					"speakerTitle": "Маусау"
				},
				{
					"id": 50270217,
					"content": "Ещё какая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270218
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 50270218,
					"content": "Угу, само собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иансан"
				}
			]
		}
	]
}