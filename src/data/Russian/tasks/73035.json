			"dialogs": [
				{
					"id": 730350401,
					"content": "Кажется, в ветвях Ашваттхи что-то светится... Это биджа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730350402,
					"content": "Ох, было нелегко, но это должно помочь Ране...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730350403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350404
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730350404,
					"content": "А-а?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350405,
						730350406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730350405,
					"content": "Арама, ты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				},
				{
					"id": 730350407,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350408
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730350408,
					"content": "Марана разрушила Ашваттху. Без неё у нас не получится добыть биджу. Поэтому я хочу посадить новое древо, только так я могу помочь вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350409
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730350409,
					"content": "Но, чтобы из семечка выросло дерево, потребуется очень много времени!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730350410,
					"content": "Не переживай. Скорость, с которой растут васары, зависит от семечка. Ашваттха передала мне свою силу. Ещё у нас есть фрукт васома и наши общие воспоминания. Всё получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350411
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730350411,
					"content": "Спасибо тебе, первая Ашваттха. Спасибо вам, Арадзи, Араяма и Арамаха. Ваши воспоминания принесут великую пользу. С их помощью вырастет новая Ашваттха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350412
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730350412,
					"content": "С Арамой что-то не так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730350413,
					"content": "Разве? Просто мне открылось множество вещей, я внезапно узнал столько новых слов и получил огромное количество воспоминаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350414
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730350414,
					"content": "Не волнуйтесь. Я всё тот же я, а вы мои друзья. И я обязательно вам помогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350415,
						730350416,
						730350417
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730350415,
					"content": "А биджа?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350419,
					"content": "В глубинах Храма Ашваттхи запечатана Ванарана прошлого, а также воплощение Мараны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350420
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730350420,
					"content": "Оно будет распространять свой яд на земли и сарву до тех пор, пока вся зелень не засохнет, все цветы не увянут и все источники не станут грязными. До тех пор, пока всё живое не погибнет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350421
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730350421,
					"content": "Нужно уничтожить его. Только так можно вырастить крепкое древо и собрать биджу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арама"
				},
				{
					"id": 730350416,
					"content": "Я верю тебе. Что дальше?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350417,
					"content": "Я понимаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350418
					]
				},
				{
					"id": 730350418,
					"content": "#Хорошо, что нара {NICKNAME} всё понимает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350419
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730350406,
					"content": "...что делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				}
			]
		},
