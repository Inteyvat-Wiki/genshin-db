					"Лань Ян"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191320401,
					"content": "Приветствую! Чем могу быть полезна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320402
					],
					"speakerTitle": "Лань Ян"
				},
				{
					"id": 191320402,
					"content": "#Я {M#пришёл}{F#пришла} за нарядом для Нин Гуан.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320403
					]
				},
				{
					"id": 191320403,
					"content": "О, знаю, знаю. Подожди, пожалуйста, сейчас я его тебе принесу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320404
					],
					"speakerTitle": "Лань Ян"
				},
				{
					"id": 191320404,
					"content": "После долгого ожидания Лань Ян наконец возвращается.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						191320405
					]
				},
				{
					"id": 191320405,
					"content": "Вот и наряд. Прошу передать его госпоже Нин Гуан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320406
					],
					"speakerTitle": "Лань Ян"
				},
				{
					"id": 191320406,
					"content": "Что-то ты задержалась.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320407
					]
				},
				{
					"id": 191320407,
					"content": "Да... Дело в том, что внутри полно вещей госпожи Нин Гуан: не только наряды, но и антиквариат, изделия из яшмы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320408
					],
					"speakerTitle": "Лань Ян"
				},
				{
					"id": 191320408,
					"content": "Сейчас мы по приказанию госпожи Нин Гуан меняем планировку помещения, и в нынешнем беспорядке что-то отыскать довольно сложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320409,
						191320410
					],
					"speakerTitle": "Лань Ян"
				},
				{
					"id": 191320409,
					"content": "(Похоже, у неё собралось довольно много вещей...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				},
				{
					"id": 191320411,
					"content": "Спасибо тебе. Вот, возьми этот наряд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лань Ян"
				},
				{
					"id": 191320410,
					"content": "(Вот они, проблемы богачей.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				}
			]
		},
