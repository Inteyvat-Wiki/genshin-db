	"talks": [
		{
			"id": 1111101,
			"completionStepIds": [
				1111101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111101",
							"2"
						],
						"stepId": 1111101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дядюшка Мэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110101,
					"content": "Мэн, я вернулась! Боюсь, Большого Г мы ещё не нашли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110102
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110102,
					"content": "Вот как. Простите за беспокойство. Все места, где он мог быть, мы уже осмотрели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110103
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110103,
					"content": "Кто всё-таки такой этот Большой Г?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111110104,
					"content": "Пожалуй, расскажу обо всём с самого начала. Я вырос у склона Уван. В детстве у меня там было много хороших друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110105
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110105,
					"content": "Один из них - Большой Г. Мы с ним были не разлей вода. Но однажды с ним случилось несчастье, и он погиб.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110106
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110106,
					"content": "Я не могу этого позабыть. Наверное, я слишком привязался к родным местам. Поэтому я часто прихожу к склону Уван.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110107
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110107,
					"content": "Но после одного такого визита на склон Уван мне стало как-то нехорошо. Теперь мне каждую ночь снится Большой Г.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110108
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110108,
					"content": "Может, я чем-то его побеспокоил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110109,
						111110110
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110109,
					"content": "Похоже на какую-то выдумку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110111
					]
				},
				{
					"id": 111110111,
					"content": "Может быть. Доказать мне нечем, но я себе места не нахожу, и с каждым днём мне всё тревожнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110112
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110112,
					"content": "Как мне смириться с тем, что друг детства мог превратиться в злого духа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110113
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110113,
					"content": "Поэтому он в ритуальное бюро и устроился. Вместо зарплаты я помогаю ему с этой проблемой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110114
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110114,
					"content": "Вообще-то рассказ Мэна вполне может быть правдой. Иногда призраки скитаются среди смертных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110115
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110115,
					"content": "Что же до злых духов, думаю, ты просто навёл на себя страху. Даже мне злые сущности встречались лишь несколько раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110116
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110116,
					"content": "Но ты уверена, что Большой Г не представляет опасности? Мне очень не хотелось бы, чтобы он кому-нибудь навредил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110117
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110117,
					"content": "Вот видите? Мэн никого слушать не станет, пока мы не найдём Большого Г.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110118
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110118,
					"content": "Люди, с которыми мы сегодня виделись, тоже детские друзья Мэна. Я предполагала, что Большой Г прятался у одного из них, но ошиблась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110119
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110119,
					"content": "Склон Уван, друзья из детства... Зацепок больше не осталось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110120
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110120,
					"content": "Простите, это ритуальное бюро «Ваншэн»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110121
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110121,
					"content": "Меня зовут Ло Чэн. Последнее время я чувствую себя очень странно. За мной будто кто-то наблюдает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110122
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110122,
					"content": "Несколько дней назад мы с другом на спор ходили к склону Уван. Я вернулся домой и заболел. Мне постоянно снятся кошмары, а врачи лишь разводят руками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110123
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110123,
					"content": "Думаю... Это проклятие! Меня проклял демон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110124
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110124,
					"content": "Да-да-да, хм, именно так. Демоническое проклятие, очень серьёзное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110125
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110125,
					"content": "Вы тоже знаете! Прямо как в древних сказаниях... Мстительные духи богов, погибших в Войне Архонтов, шлют на смертных зловещие проклятия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110126
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110126,
					"content": "А если проклятье не снять, органы сгорят, плоть отойдёт от кости и наступит мучительная смерть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110127
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110127,
					"content": "Симптомы, которые я испытываю, совпадают с описанными в сказаниях!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110128
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110128,
					"content": "Склон Уван? Хм... Вряд ли это проклятие. Наверное, это просто Большой Г...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110129
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110129,
					"content": "Стоп. Вы оба с этим потоком мыслей завязывайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110130
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110130,
					"content": "Но ты ведь сама так всегда делаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111110131,
					"content": "Ритуальное бюро «Ваншэн» разбирается во всякой нечисти, так? Умоляю, помогите! Я хочу жить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110132
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110132,
					"content": "Ладно, ладно, не паникуй. Ты обратился к кому нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110133
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110133,
					"content": "Но для снятия проклятия понадобится подходящее место... И нужно будет совершить кое-какие приготовления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110134
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110134,
					"content": "Новенькие, за мной, мне понадобится ваша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110135
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110135,
					"content": "Я... Я тоже пойду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110136
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110136,
					"content": "Сначала помоги ему подготовиться. Благовония для изгнания зла, как я тебя учила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110137
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110137,
					"content": "Когда всё будет готово, приходите ко мне. Покончим с этим - вернёмся к проблеме с Большим Г.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110138
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110138,
					"content": "Ладно, так и сделаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110139
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110139,
					"content": "Ну, вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110110,
					"content": "Такого не бывает.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110111
					]
				}
			]
		},
		{
			"id": 1111102,
			"completionStepIds": [
				1111102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111102",
							"2"
						],
						"stepId": 1111102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110201,
					"content": "Итак, какой загадочный ритуал ты собираешься провести?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111110202,
					"content": "А никакой. Нам пока просто нужно убить время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110203
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110203,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111110204,
					"content": "Вы что, поверили в эту муть с проклятиями мстительных богов? Их уже давно стёрли с лица Тейвата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110205
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110205,
					"content": "Тогда что мы здесь делаем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110206
					]
				},
				{
					"id": 111110206,
					"content": "Вы этих двоих видели? Один думает, что проклят, другой считает, что его друг превратился в злого духа. И никаких доводов они не слушают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110207
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110207,
					"content": "Эх... Теперь вы понимаете, почему простым людям лучше всего о делах загробных не знать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110208
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110208,
					"content": "Из-за этого столько людей на моих глазах потеряло над собой контроль. Чтобы успокоить их, нужно показать нечто убедительное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110209
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110209,
					"content": "А для этого лучше всего подойдёт шоу с уничтожением злюки-призрака.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110210
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110210,
					"content": "Хм... Похоже на трюк, чтобы развеселить трёхлетнего ребёнка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110211,
						111110213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111110211,
					"content": "Не лучше ли сказать людям правду?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110212
					]
				},
				{
					"id": 111110212,
					"content": "Ага. Особенно если страх происходит от неизвестного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111110216,
					"content": "Потому что в случае с невеждой правда лишь усугубит ситуацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110217
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110217,
					"content": "Я же хочу тех, кто приблизился к «грани», оттащить от неё. А поскольку проблема выдуманная, справляться с ней мы будем подходящими средствами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110218
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110218,
					"content": "Мысль вроде неплохая... Но почему он думает, что это проклятие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111110219,
					"content": "Известна ли вам история Якс?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110220,
						111110221
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110220,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110222
					]
				},
				{
					"id": 111110222,
					"content": "Яксы самоотверженно сражались с древними божествами в битве, погрузившей весь мир во тьму. Боги были повержены, но негодование их не ушло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110223
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110223,
					"content": "Оно обернулось расползшимся среди смертных мором. Охваченные ужасом люди приняли это за «проклятие богов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110224
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110224,
					"content": "Мор унёс много жизней, а трупы служили очагами дальнейшего распространения заразы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110225
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110225,
					"content": "Но потом обнаружили, что мор можно остановить, очищая воздух и сжигая тела умерших. Первыми к таким мерам прибегли основатели ритуального бюро «Ваншэн».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110226
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110226,
					"content": "...Правда? Паймон такого не ожидала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110227
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111110227,
					"content": "Ага. Это заняло много лет, но мор был полностью уничтожен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110228
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110228,
					"content": "За всю историю бюро нам приходилось справляться с подобными явлениями несколько раз, и каждый раз нам удавалось восстановить равновесие между жизнью и смертью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110229
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110229,
					"content": "Короче говоря, мы как бы «привратники», которые стоят на страже границы обоих миров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110230,
						111110231
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110230,
					"content": "Так вот, что означает «оберегать грань между жизнью и смертью»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110232
					]
				},
				{
					"id": 111110232,
					"content": "Поэтому проклятие - это просто фантазия, и я это лучше всех понимаю. Но о том, что когда-то был мор, простым людям говорить тоже не стоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110233
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110233,
					"content": "Подождём ещё немного и приготовимся к шоу. Монолит артерий земли послужит прекрасной декорацией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110234
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110234,
					"content": "Вы наконец пришли. Мы только что закончили с приготовлениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110235
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110235,
					"content": "Посмотри. Это приспособление изгоняет злых духов. Оно впитает твоё проклятие и заставит его принять материальную форму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110236
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110236,
					"content": "#Ни о чём не беспокойтесь, путешественни{F#ца}{M#к} - воин бывалый, и позаботится о нашей безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110237,
						111110238
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110237,
					"content": "Ну да, кто же ещё...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110239
					]
				},
				{
					"id": 111110239,
					"content": "А, точно, я забыла предупредить. Ничего, всё будет нормально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110240
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110240,
					"content": "Это правда решит мою проблему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110241
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110241,
					"content": "Доверься госпоже. С виду она ненормальная, но к делу подходит со всей серьёзностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110242
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110242,
					"content": "Почему сразу «ненормальная»? А не, например, очаровательно непосредственная? Или оригинальная?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110243
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110243,
					"content": "Итак, за дело. Новенькие, активируйте его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110238,
					"content": "Разве нам придётся сражаться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110239
					]
				},
				{
					"id": 111110231,
					"content": "#Я не знал{F#а}, что у «Ваншэн» такая долгая история.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110232
					]
				},
				{
					"id": 111110221,
					"content": "Немного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110222
					]
				},
				{
					"id": 111110213,
					"content": "Сколько тебе годиков, Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110214
					]
				},
				{
					"id": 111110214,
					"content": "#Почему ты это вдруг спросил{F#а}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111110215,
					"content": "Паймон просто хочет знать, почему нельзя всё сказать начистоту!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110216
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1111103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
