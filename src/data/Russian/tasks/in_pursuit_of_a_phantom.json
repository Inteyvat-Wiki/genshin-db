				}
			]
		},
		{
			"id": 1111105,
			"completionStepIds": [
				1111105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111105",
							"2"
						],
						"stepId": 1111105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ху Тао"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110501,
					"content": "Ну как? Чувствуешь, что проклятие покинуло твоё тело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110502
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110502,
					"content": "Да, я ощущаю необычайную лёгкость! Я исцелён!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110503
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110503,
					"content": "#Я так благодарен тебе и путешественни{F#це}{M#ку}! Если бы не вы, проклятие отняло бы мою жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110504
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110504,
					"content": "Отлично! Значит, теперь можно тебе сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110505
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110505,
					"content": "Раз, два, три... Мы вас развели!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110506
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110506,
					"content": "Э?.. Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110507
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110507,
					"content": "Обычным людям неизвестно, что штука эта - просто старый монолит артерий земли, который легко привлекает чудовищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110508
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110508,
					"content": "А чудовища были простыми чудовищами, а вовсе не проявлением твоего проклятия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110509
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110509,
					"content": "Теперь ты скажи мне: если я ничего не сделала, почему ты вдруг излечился?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110510
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110510,
					"content": "Э... Ну... Никакого проклятия не было?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110511
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110511,
					"content": "Тогда почему я болел?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110512
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110512,
					"content": "Может, простыл, или съел что-то не то, или сам себя до болезни запугал... Я за последнее. В моей практике такой случай далеко не первый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110513
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110513,
					"content": "Вот это поворот!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110514
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110514,
					"content": "Я тоже подобного не ожидал, но... Всё равно, спасибо тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110515
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110515,
					"content": "Не стоит. В этот раз мы с твоей мнительностью справились, но дальше ты уж как-нибудь сам. Я постоянно помогать тебе не могу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110516
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110516,
					"content": "Жизнь коротка. Наслаждайся ею, пока можешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110517
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110517,
					"content": "Это звучит... Немного странно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110518
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110518,
					"content": "Пожалуй, я пойду. Простите, что побеспокоил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110519
					],
					"speakerTitle": "Ло Чэн"
				},
				{
					"id": 111110519,
					"content": "Хорошо, что это не проделки Большого Г. Но он не остановится, пока мы его не найдём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110520
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110520,
					"content": "Раз уж с проклятием покончено, почему бы нам не продолжить поиски Большого Г?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110521
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110521,
					"content": "Не думаю, что в этом есть необходимость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110522
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110522,
					"content": "Он нашёл нас первым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110523
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110523,
					"content": "Б-Большой Г?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110524
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111110524,
					"content": "Э-эм... Простите, я не хотел никого беспокоить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110525
					],
					"speakerTitle": "Большой Г"
				},
				{
					"id": 111110525,
					"content": "Так это Большой Г? Да он просто ребёнок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110526
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111110526,
					"content": "Ну он дух. Вполне естественно, что он выглядит совсем как в день своей смерти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110527
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 111110527,
					"content": "А Паймон думала, что Большой Г - брутальный бородач...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110528
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111110528,
					"content": "Давайте отведём его в «Ваншэн». Нам ещё предстоит много работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ху Тао"
				}
			]
		},
