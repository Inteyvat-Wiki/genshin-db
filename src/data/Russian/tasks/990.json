			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Барбара"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 9901508,
					"content": "Тебе здесь нравится?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901509
					]
				},
				{
					"id": 9901519,
					"content": "Хочешь поговорить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901520
					]
				},
				{
					"id": 9901536,
					"content": "Чем хочешь заняться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901537
					]
				},
				{
					"id": 9901509,
					"content": "Да, очень нравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901510
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901510,
					"content": "Мне нравится освежающий пейзаж. Он совсем не похож на Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901511
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901511,
					"content": "Здесь я могу петь в своё удовольствие и не бояться побеспокоить других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901512
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901512,
					"content": "Твои песни никак нельзя назвать беспокойством.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901513
					]
				},
				{
					"id": 9901516,
					"content": "Отлично!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901517
					]
				},
				{
					"id": 9901513,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901514
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901514,
					"content": "Очень мило с твоей стороны! Тем не менее всегда нужно быть внимательной к другим людям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901515
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901515,
					"content": "#Я рада, что ты пригласил{F#а} меня сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901516
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901517,
					"content": "#Я рада, что ты пригласил{F#а} меня сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901518
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901518,
					"content": "Я бы хотела побыть здесь ещё немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901520,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901521
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901521,
					"content": "Хи-хи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901522
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901522,
					"content": "Почему ты вдруг улыбнулась?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901523
					]
				},
				{
					"id": 9901524,
					"content": "Я только что поняла, что давно вот так не разговаривала с другом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901525
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901525,
					"content": "Я очень счастлива.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901526
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901526,
					"content": "Тебя очень легко осчастливить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901527
					]
				},
				{
					"id": 9901530,
					"content": "Это потому, что ты всегда ставишь других людей на первое место.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901531
					]
				},
				{
					"id": 9901527,
					"content": "О... Разве?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901528
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901528,
					"content": "Это ведь не так уж и плохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901529
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901529,
					"content": "Чем легче ты получаешь радость, тем больше у тебя энергии и тем легче делиться этой радостью с другими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901530
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901531,
					"content": "Конечно, так и должно быть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901532
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901532,
					"content": "Обо мне всегда заботится много людей. Я просто хочу сделать всё, что в моих силах, чтобы отплатить за их доброту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901533
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901533,
					"content": "Какая же ты замечательная!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901534
					]
				},
				{
					"id": 9901534,
					"content": "Не нужно всё время осыпать меня комплиментами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901535
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901535,
					"content": "Только с конструктивной критикой мы можем расти, верно...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901537,
					"content": "В последнее время я репетирую новую песню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901538
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901538,
					"content": "Но есть некоторые моменты, в которых я до сих пор не уверена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901539
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901539,
					"content": "Нужно ли поднять тон в припеве?.. Нужно ли улучшить танцевальную часть?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901540
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901541,
					"content": "#Готов{F#а} оказать всяческую поддержку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901542
					]
				},
				{
					"id": 9901542,
					"content": "С удовольствием.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901543
					]
				},
				{
					"id": 9901540,
					"content": "Если ты не возражаешь, я бы хотела, чтобы ты посмотрел мой номер и дал свои рекомендации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901541
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901543,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901544
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901544,
					"content": "Эм... Пожалуйста, не смейся, если есть части, которые нужно улучшить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901545
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901545,
					"content": "Я много раз думала об этом, но мне потребовалось много времени, чтобы наконец-то набраться храбрости и выступить перед тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901546
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901547,
					"content": "Я не буду смеяться. Не переживай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901548
					]
				},
				{
					"id": 9901546,
					"content": "Если ты будешь смеяться, то я сгорю со стыда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901547
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901549,
					"content": "О... Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901550
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901550,
					"content": "Значит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901551
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 9901551,
					"content": "Да начнётся шоу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Барбара"
				}
			]
		},
