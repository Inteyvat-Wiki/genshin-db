			"dialogs": [
				{
					"id": 710060701,
					"content": "Где бы мне найти подходящий пейзаж...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060702
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060702,
					"content": "Я хочу спросить тебя про тот камень.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060703
					]
				},
				{
					"id": 710060703,
					"content": "Камень? А почему это он тебя внезапно заинтересовал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060704
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060704,
					"content": "Я подобрал его, пока искал подходящий вид около <color=#00E1FFFF>пруда Лу Хуа</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060705
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060705,
					"content": "Хочешь поискать в районе <color=#00E1FFFF>пруда Лу Хуа</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060706
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060706,
					"content": "Тогда смотри в оба. В этом пруду чего только нет! Понятия не имею, кто это всё туда выбросил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вермеер"
				}
			]
		},
