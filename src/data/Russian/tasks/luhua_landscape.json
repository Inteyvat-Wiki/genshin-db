			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вермеер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060601,
					"content": "#Ты уже наш{F#ла}{M#ёл} мои кисти и краски?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060602
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060602,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060603
					]
				},
				{
					"id": 710060603,
					"content": "Как я и думал, я оставил их в одном из мест, где писал картины. У меня есть дурная привычка разбрасывать инструменты во время работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060604
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060604,
					"content": "Я всегда забываю их собрать, когда тороплюсь. Спасибо тебе! Если бы не твоя помощь, мне пришлось бы возвращаться в город за новыми кисточками и красками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060605
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060605,
					"content": "Ты собираешься продолжить рисовать здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060606
					]
				},
				{
					"id": 710060606,
					"content": "Даже не упоминай об этом. Я слышал, что глаза этих статуй излучают свет, который видно на большом расстоянии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060607
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060607,
					"content": "Огромные статуи с горящими глазами у подножия горы... Это будет восхитительная картина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060608
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060608,
					"content": "Но когда добрался до этого места, я действительно обнаружил эти статуи, однако их глаза совсем не сияли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060609
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060609,
					"content": "Я решил, что просто пришёл в неподходящее время или подобрал неудачный ракурс... Именно поэтому я сменил место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060610
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060610,
					"content": "Но где бы я не останавливался, пейзаж оставался всё тем же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060611
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060611,
					"content": "Единственную ценность, которую я извлёк из этого предприятия, я обнаружил на дне пруда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060612
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060612,
					"content": "#Я тоже наш{F#ла}{M#ёл} такой камень.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060613
					]
				},
				{
					"id": 710060613,
					"content": "Хм. Дай взглянуть... Действительно, они абсолютно одинаковые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060614
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060614,
					"content": "Странно. На них есть надписи... Что же тут написано?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060615
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060615,
					"content": "«Каменный дом укрывает деревянную хижину, нанеси последний штрих, чтобы войти»... Что бы это могло означать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060616
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060616,
					"content": "Мне этот камушек всё равно ни к чему. Забери его себе. Считай, что это награда за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060617
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060617,
					"content": "Если честно, у меня есть одна догадка. Тебе не кажется, что эти камни немного напоминают глаза?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060618
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060618,
					"content": "Если так, то, может быть, «последний штрих» как-то связан с этими камнями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060619
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060619,
					"content": "Ха-ха-ха! Это всего лишь догадка, не воспринимай её всерьёз. Я продолжу искать подходящий вид. Спасибо за мои инструменты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вермеер"
				}
			]
		},
