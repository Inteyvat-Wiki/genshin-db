			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вермеер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060201,
					"content": "#Ты уже наш{F#ла}{M#ёл} мои кисти и краски?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060202
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060202,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060203
					]
				},
				{
					"id": 710060203,
					"content": "Как я и думал, я оставил их в одном из мест, где писал картины. У меня есть дурная привычка разбрасывать инструменты во время работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060204
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060204,
					"content": "Я всегда забываю их собрать, когда тороплюсь. Спасибо тебе! Если бы не твоя помощь, мне пришлось бы возвращаться в город за новыми кисточками и красками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060205
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060205,
					"content": "Ты собираешься продолжить рисовать здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060206
					]
				},
				{
					"id": 710060206,
					"content": "Даже не упоминай об этом. Я слышал, что глаза этих статуй излучают свет, который видно на большом расстоянии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060207
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060207,
					"content": "Огромные статуи с горящими глазами у подножия горы... Это будет восхитительная картина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060208
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060208,
					"content": "Но когда добрался до этого места, я действительно обнаружил эти статуи, однако их глаза совсем не сияли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060209
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060209,
					"content": "Я решил, что просто пришёл в неподходящее время или подобрал неудачный ракурс... Именно поэтому я сменил место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060210
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060210,
					"content": "Но где бы я не останавливался, пейзаж оставался всё тем же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060211
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060211,
					"content": "Единственную ценность, которую я извлёк из этого предприятия, я обнаружил на дне пруда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060212
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060212,
					"content": "Я понятия не имею, что это такое, но чем дольше я на него смотрю, тем больше он напоминает мне глаз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060213
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060213,
					"content": "Но если это действительно глаз, то где-то поблизости должен быть ещё один такой же камень. Насколько мне известно, у людей два глаза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060214
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060214,
					"content": "Эх... Но это лишь мои досужие домыслы. Не обращай внимания. Мне этот камушек всё равно ни к чему. Забери его себе. Считай, что это награда за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060215
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060215,
					"content": "Статуи с горящими глазами... Интересно, какие ещё секреты скрывает пруд Лу Хуа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вермеер"
				}
			]
		},
