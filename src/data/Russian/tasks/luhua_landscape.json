					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060402
					],
					"speakerTitle": "Таинственная статуя"
				},
				{
					"id": 710060402,
					"content": "Вставить",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
