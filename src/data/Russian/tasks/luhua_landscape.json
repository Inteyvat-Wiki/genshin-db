			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Вермеер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060101,
					"content": "Проклятье... Как же я теперь буду рисовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060102
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060103
					]
				},
				{
					"id": 710060103,
					"content": "#Путешественн{F#ица}{M#ик}, это ты! Привет. Я... искал вдохновения у пруда Лу Хуа. Собирался написать несколько картин, чтобы забрать их домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060104
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060104,
					"content": "Но я так и не смог подобрать подходящий ракурс. Все мои попытки вышли неудачными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060105
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060105,
					"content": "Я был так увлечён поиском места, что заметил пропажу кистей и красок, только когда пришёл сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060106
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060106,
					"content": "Должно быть, я оставил их там, где писал предыдущие картины. Поможешь мне их найти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060107,
						710060110
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060107,
					"content": "А где ты писал предыдущие картины?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060108
					]
				},
				{
					"id": 710060108,
					"content": "Эм... Честно говоря, я не помню. Я был настолько поглощён художественным процессом, что не замечал ничего вокруг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060109
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060109,
					"content": "Но я успел написать лишь две картины, поэтому кисти и краски могут быть только в тех двух местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060113,
					"content": "Возьми эти картины. Уверен, что мои принадлежности найдутся в одном из мест, <color=#00E1FFFF>с которых я писал эти пейзажи.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060114
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060114,
					"content": "Пожалуйста, принеси их мне. Я буду где-то здесь... Продолжу искать подходящий ракурс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060110,
					"content": "С чего же нам начать поиски?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060111
					]
				},
				{
					"id": 710060111,
					"content": "Я был настолько поглощён художественным процессом, что не замечал ничего вокруг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060112
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710060112,
					"content": "Но я успел написать всего две картины, поэтому кисти и краски могут быть только в тех двух местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Вермеер"
				}
			]
		},
		{
			"id": 7100602,
