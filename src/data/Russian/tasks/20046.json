			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Анна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200460201,
					"content": "#Готово! Спасибо, путешественни{F#ца}{M#к}. Задание по сопровождению на этот раз прошло гладко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460202
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460202,
					"content": "Но... неужели поручения искателей приключений всегда проходят таким образом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460203,
						200460205
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460203,
					"content": "Бывают и другие поручения.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460204
					]
				},
				{
					"id": 200460204,
					"content": "Звучишь ты что-то совсем отчаянно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460207,
					"content": "Ясно... Хорошо, я буду трудиться не покладая рук!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460208
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460208,
					"content": "А когда накоплю денег, отправлюсь вместе с братом, папой и мамой путешествовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460209
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460209,
					"content": "Энтони всегда хотел путешествовать, но... ему приходилось ухаживать за мной, когда я болела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460210
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460210,
					"content": "Но теперь я выздоровела и стала искательницей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460211
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460211,
					"content": "Хе-хе, настал час исполнить мечты брата!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460205,
					"content": "Со временем ты всё поймёшь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460206
					]
				},
				{
					"id": 200460206,
					"content": "Эй, не делай такой понурый вид...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "Анна"
				}
			]
		},
		{
			"id": 2004603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
