			"trigger": {
				"objectNames": [
					"Энтони"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200460301,
					"content": "#Путешественни{F#ца}{M#к}, прошу тебя, присмотри за Анной. Последнее время она так взволнована...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460302
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200460302,
					"content": "Ты не хочешь, чтобы она была искателем приключений?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460303
					]
				},
				{
					"id": 200460303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460304
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200460304,
					"content": "Я уважаю мечты Анны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460305
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200460305,
					"content": "Она наконец переборола болезнь, и у неё появилась возможность осуществить свою мечту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460306
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200460306,
					"content": "Я её брат, и я... полностью поддерживаю её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460307
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200460307,
					"content": "Вот так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		}
	]
