				"points": []
			},
			"dialogs": [
				{
					"id": 200460101,
					"content": "Что же... Поработаем сегодня как следует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460102,
						200460106
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460102,
					"content": "Вижу, ты полна энтузиазма.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460103
					]
				},
				{
					"id": 200460103,
					"content": "Ну конечно! Быть искательницей приключений так увлекательно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460104
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460104,
					"content": "Только вот... Хе-хе, мне ещё предстоит узнать о поручениях так много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460105
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460105,
					"content": "#Путешественни{F#ца}{M#к}, сходишь со мной ещё раз? Я хотела бы спросить тебя о некоторых вещах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460108,
					"content": "Тогда в путь. Сегодняшнее поручение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460109
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460109,
					"content": "Хм... Опять товарный аэростат...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				},
				{
					"id": 200460106,
					"content": "#Хочешь, чтобы я {F#составила}{M#составил} тебе компанию?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460107
					]
				},
				{
					"id": 200460107,
					"content": "Так сходишь? Хе-хе, я ещё многому хотела бы у тебя научиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "Анна"
				}
			]
		},
		{
			"id": 2004602,
			"completionStepIds": [
				2004604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2004604",
							"2"
