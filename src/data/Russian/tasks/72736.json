			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гранд-мастер Ханакадо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360101,
					"content": "Превосходно, превосходно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 727360102,
					"content": "Я не ожидал, что банда Аратаки сможет победить столько могучих участников жучиных боёв. Похоже, вы хорошо владеете этим искусством.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 727360103,
					"content": "Беру свои слова назад. Вы уважаемые и достойные противники, и я должен встретить вас во всеоружии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 727360104,
					"content": "Так! Пастушонок, ты главный. Пришло твоё время блистать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 727360105,
					"content": "И не воспринимай сказанное ранее всерьёз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 727360106,
					"content": "В бой, Король жучиных битв!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "Ха-ха-ха-ха-ха-ха! Началось! Финальная схватка! Близится моя окончательная победа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727360109,
					"content": "Я не знаю, как ты руководил командой, но результаты говорят сами за себя: банда Аратаки рулит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727360110,
					"content": "Гранд-мастер Ханакадо, приготовься к бою!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727360107,
					"content": "Король против гранд-мастера! Это будет легендарное зрелище!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
			"completionStepIds": [
				7273603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273603",
							"2"
						],
						"stepId": 7273603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гранд-мастер Ханакадо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360201,
					"content": "Раз так... Сразимся снова. В этот раз твои уловки не пройдут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360202
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 727360202,
					"content": "Победа и поражение уже не кажутся такими важными... Сразимся по-дружески?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360203
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 727360203,
					"content": "Нечасто мне попадаются такие замечательные соперники. Было бы жаль закончить наши сражения так скоро, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360204
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 727360204,
					"content": "Конечно! Давай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360205
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727360205,
					"content": "Хочешь разгадать мои секретные приёмы? Нет, малыш, не получится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360206
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727360206,
					"content": "Признай, что в жучиных боях я сильнее, и мы будем сражаться столько, сколько пожелаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360207
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727360207,
					"content": "Похоже, Пастушонок и гранд-мастер Ханакадо всё ещё горят энтузиазмом... Оставим их! Они могут сражаться в боях жуков, пока не закончатся жуки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}