			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Камисато Аяка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170901,
					"content": "#Ну, {NICKNAME}, как всё прошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170902,
						20170903
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170902,
					"content": "#{F#Сама}{M#Сам} не знаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				},
				{
					"id": 20170904,
					"content": "Хорошо сработали. Ждём теперь известий от Саю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170905
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170905,
					"content": "Через некоторое время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170906
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170906,
					"content": "Ох... ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170907
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170907,
					"content": "Физическая активность, конечно, помогает расти, но это уже чересчур...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170908
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170908,
					"content": "Мне дурно... всё кружится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170909
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170909,
					"content": "Отставить спать. Я должна сделать что-то важное... Ах да, они у меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170910
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170910,
					"content": "Не знаю, как выглядит нужный вам отчёт, поэтому я просто сгребла все подозрительные бумаги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170911
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170911,
					"content": "Получите... а я спать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170912
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170912,
					"content": "Госпожа, что это?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170913
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170913,
					"content": "В этом запечатанном конверте должен быть отчёт, который комиссия Тэнрё собирается представить сёгуну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170914
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170914,
					"content": "К тому же... есть переписка с Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170915
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170915,
					"content": "Выходит, Гудзи Яэ была права. За конфликтами в Инадзуме стоят они.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170916
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170916,
					"content": "#{NICKNAME}, этих доказательств будет достаточно. Отнеси их <color=#00E1FFFF>Гудзи Яэ</color>. Она, наверное, уже знает, что делать дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170917
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170917,
					"content": "А я соберу людей и попробую извести оставшихся в Инадзуме Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170918
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170918,
					"content": "А ещё... будьте крайне осторожны рядом с сёгуном. У меня мурашки по коже от мысли о том, как она достаёт свой меч...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170919
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170919,
					"content": "Нам вновь придётся довериться Гудзи Яэ. Она хорошо знает сёгуна, и, может, что-нибудь придумает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170920
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170920,
					"content": "Если Паймон не изменяет память, уже почти время встречи с Яэ Мико.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170921
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170921,
					"content": "Скорее, собираемся и идём в <color=#00E1FFFF>Великий храм Наруками</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170903,
					"content": "Мы подожгли фейерверк и убежали...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				}
			]
		},
