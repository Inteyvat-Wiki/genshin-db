			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Саю"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170201,
					"content": "Ой! Этот игрушечный т-тануки превратился в человека!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170202,
					"content": "Что это? Паймон такое видит впервые!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170203,
					"content": "Не тануки... мудзина... хр-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170204
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170204,
					"content": "Так устала... если не высплюсь... не вырасту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170205
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170205,
					"content": "Это и есть тот самый «профессионал»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170206,
					"content": "Что-то совсем не похоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170207,
					"content": "Хе-хе... Она член Сюмацубан. Самый настоящий ниндзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170208
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20170208,
					"content": "Ого, ниндзя! Значит, только что мы видели одну из их легендарных техник превращения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170209,
					"content": "А что такое «Сюмацубан»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170210,
					"content": "Они служат комиссии Ясиро. Это секретный отряд Камисато Аято.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170211
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20170211,
					"content": "Камисато Аято и комиссия Ясиро придерживаются нейтралитета, и я не могу отдавать Сюмацубан приказы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170212
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20170212,
					"content": "Но вот уговорить их самого ленивого члена помочь нам вполне в моих силах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170213
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20170213,
					"content": "У-ру-ру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170214
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170214,
					"content": "Сделайте вот что: сходите в город и найдите доказательства предательства комиссии Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170215
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20170215,
					"content": "Мне там появляться не подобает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170216
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20170216,
					"content": "Звучит это просто, вот только...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170217,
						20170218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170217,
					"content": "Я даже не знаю, с чего начать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				},
				{
					"id": 20170219,
					"content": "Хм? Я думала, вы уже сами всё поняли. Ладно, дам ещё указаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170220
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20170220,
					"content": "Человеку с улицы выведать всю внутреннюю деятельность комиссии Тэнрё практически невозможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170221
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20170221,
					"content": "Но, поскольку все три комиссии служат сёгуну, они поддерживают тесную связь. Работнику другой комиссии будет проще узнать, что же они затеяли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170222
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20170222,
					"content": "Комиссия Ясиро!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170223
					]
				},
				{
					"id": 20170223,
					"content": "Хе-хе... кажется, ты улавливаешь мою мысль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170224
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20170224,
					"content": "Сёгунат, наверное, всё ещё разыскивает тебя, но я уверена, что с помощью нашей ниндзя ты сможешь встретиться со своими друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170225
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20170225,
					"content": "Не забывай, что времени в обрез. Принеси доказательства своевременно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20170218,
					"content": "Какие именно нужны доказательства?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				}
			]
		},
		{
			"id": 201704,
