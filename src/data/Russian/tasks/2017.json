			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тома"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170403,
					"content": "Что вас привело сюда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170404
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170404,
					"content": "Встретились ли вы с сопротивлением? Как боевая обстановка? Я уже могу выходить, или ещё слишком опасно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170405
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170405,
					"content": "Ещё рано... по дороге сюда мы видели патруль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170406,
					"content": "Значит, ещё не кончилось... Вы, наверное, пришли, чтобы что-то обсудить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170407
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170407,
					"content": "Минуточку, я найду кого-нибудь, чтобы позвали госпожу Камисато.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170408
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170408,
					"content": "Тома и Аяка слушают рассказ о текущей ситуации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170409,
					"content": "Понятно. С момента нашей последней встречи вам пришлось пережить многое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170410
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170410,
					"content": "Как я понимаю, вам нужны доказательства предательства комиссии Тэнрё. Так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170411
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170411,
					"content": "Есть одна вещь, которая всегда беспокоила меня. Сёгунат уже давно ведёт войну с сопротивлением, но сёгун ни разу об этом не спросила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170412
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170412,
					"content": "Я считала, что ей это безразлично, но теперь мне кажется, проблема всегда заключалась в <color=#00E1FFFF>докладах комиссии Тэнрё</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170413
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170413,
					"content": "Что ты имеешь в виду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170414,
					"content": "Комиссия Тэнрё управляет внутренними военными делами. Если они что-то скрывают, мы ни за что об этом не узнаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170415
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170415,
					"content": "А в результате сёгун не может оценить вред Охоты на Глаза Бога и придерживается своего решения. Всё станет явным, если мы добудем их доклады.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170416
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170416,
					"content": "Насколько я помню, доступ к документам такого рода есть только у Кудзё Такаюки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170417
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170417,
					"content": "Вдобавок там полно охраны. Даже с помощью Саю стащить эти документы будет той ещё задачкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170418
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170418,
					"content": "Если бы только был способ отвлечь охрану...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170419
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170419,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170420,
						20170421
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170420,
					"content": "Отвлечь, значит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				},
				{
					"id": 20170422,
					"content": "Фейерверки Ёимии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170423
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170423,
					"content": "Такое мог предложить только Тома...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170424
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170424,
					"content": "Но это не лишено смысла. Статуя всевидящего божества находится у комиссии Тэнрё. Они точно обратят внимание на фейерверки рядом со статуей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170425
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170425,
					"content": "А Саю тем временем проникнет в здание комиссии и возьмёт доклад вместе с любыми другими бумагами, если таковые будут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170426
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170426,
					"content": "Отлично! Чувствую, скоро я вновь буду свободным человеком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170427
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170427,
					"content": "Уф... Давненько мы так не сидели и не разговаривали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170428
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170428,
					"content": "Не так уж и давно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170429
					]
				},
				{
					"id": 20170429,
					"content": "Как по мне, целую вечность... Я каждый день жду, что вы придёте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170430
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170430,
					"content": "Чайный дом всегда был моим любимым секретным местом, но теперь... Я уже не помню, когда последний раз выходил за его порог.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170431
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170431,
					"content": "Ох, как же мне хочется на горячие источники!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170432
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170432,
					"content": "Бедный Тома...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170433
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170433,
					"content": "Вернёмся к нашим делам. Когда отменят указ об Охоте, Тома обретёт свободу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170434
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170434,
					"content": "Мы хоть и свиделись вновь, но сейчас для дружеских бесед нет времени. Когда всё кончится, отпразднуем как следует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170435
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170435,
					"content": "И сыграем в сябу-сябу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170436
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20170436,
					"content": "Опять ты за своё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170437
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170437,
					"content": "Комиссия Тэнрё хорошо охраняется. Будьте рядом с ней осторожны. После этого встречаемся здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170438
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20170438,
					"content": "Ну, мы тогда в <color=#00E1FFFF>Ханамидзаку</color> к <color=#00E1FFFF>Ёимии</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170421,
					"content": "Это мы уже проходили...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				}
			]
		},
		{
			"id": 201707,
			"completionStepIds": [
				201707
			],
