			"trigger": {
				"objectNames": [
					"Саю"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170701,
					"content": "М-м-м... и я так думаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170702
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170702,
					"content": "Столько людей... если меня заметят, поймают...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170703
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170703,
					"content": "Нужно избавиться от них, чтобы я могла попасть внутрь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170704
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170704,
					"content": "Теперь вся надежда на Ёимию.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170705
					]
				},
				{
					"id": 20170705,
					"content": "Когда я добуду отчёт, встретимся в <color=#00E1FFFF>чайном доме «Коморэ»</color>, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170706
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170706,
					"content": "А если меня схватят... вытащите меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170707
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 20170707,
					"content": "Может, не стоит?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20170708,
					"content": "Н-ну, пойдём к <color=#00E1FFFF>статуе</color>! Осторожненько, чтобы нас никто не заметил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 201709,
			"completionStepIds": [
				201709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
