					"Бланш"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090502,
					"content": "#О, Лили, {NICKNAME}! И как? Они всё-таки пришли покушать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090503
					],
					"speakerTitle": "Бланш"
				},
				{
					"id": 700090503,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090504
					]
				},
				{
					"id": 700090504,
					"content": "Да, собачка съела целый кусок целиком! Спасиба, систлёнка! Было очень весело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090505
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090505,
					"content": "Вот и славно. Кстати, если будет время, можете также зайти к Флоре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090506
					],
					"speakerTitle": "Бланш"
				},
				{
					"id": 700090506,
					"content": "Сейчас ведь Праздник ветряных цветов. Неплохо было бы вернуться с букетом цветов, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090507
					],
					"speakerTitle": "Бланш"
				},
				{
					"id": 700090507,
					"content": "Ааа, дааа, пофли за цветочками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090508
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090508,
					"content": "Да, пойдём скорее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090509
					]
				},
				{
					"id": 700090509,
					"content": "Улааа!!! Спасиба!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лили"
				}
			]
		},
		{
