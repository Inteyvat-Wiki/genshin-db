				"points": []
			},
			"dialogs": [
				{
					"id": 700090401,
					"content": "Идите сюда, собачки... У нас есть для вас вкуфняфки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090402
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090402,
					"content": "Ух ты! Собачка плишла! Можно, я её погважу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090403
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090403,
					"content": "Мм, она такая мягкая и пуфыфтая! Дядя Фатуи сказал, сто у него дома тоже много собачек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090404
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090404,
					"content": "Но он сказал, сто его собачки больфые-плебольфые и пуфыфтые-плепуфыфтые... Навелна, их так плиятно гвадить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лили"
				}
			]
		},
