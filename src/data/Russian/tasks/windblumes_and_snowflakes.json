						700090803
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090803,
					"content": "Дядя! Делжите, это вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090804
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090804,
					"content": "Одуванчик и блинчик? Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090805
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090805,
					"content": "...Подарок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090806
					]
				},
				{
					"id": 700090806,
					"content": "П-подарок? От одуванчика остался один лишь стебель, а этот блин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090807
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090807,
					"content": "Лили приготовила его сама.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090808
					]
				},
				{
					"id": 700090808,
					"content": "...Выглядит он, конечно... Выглядит он, конечно, восхитительно! Я и не подозревал, насколько ты талантливый ребёнок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090809
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090809,
					"content": "Хи-хи, это меня мама научила! Я хочу посвушать ещё истолий, когда ты поефь, дядя Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090810
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090810,
					"content": "Ещё... историй?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090811
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090811,
					"content": "Ладно. Раз уж ты принесла мне подарки, я, так уж и быть, расскажу тебе что-нибудь ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090812
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090812,
					"content": "Улааа!!! Тогда я хочу, чтобы ты лассказал мне пло... Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090813
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090813,
					"content": "Кхе! Я... Нет уж, эти истории... Они вовсе не интересные, понятно? Давай я расскажу что-нибудь другое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				}
			]
		},
