			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Виктор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090101,
					"content": "Дяденька, а это плавда, сто Фатуи не плазднуют Плаздник ветляных цветов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090102
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090102,
					"content": "Ну я, эм... точно праздновать не буду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090103
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090103,
					"content": "Чего это ты тут делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090104
					]
				},
				{
					"id": 700090104,
					"content": "Кто, я? Ох, это опять ты... Ну чего ты снова на меня так подозрительно смотришь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090105
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090105,
					"content": "Я просто разговариваю с ребёнком. Я даже и не думал замышлять что-то плохое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090106
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090106,
					"content": "Похоже, что Фатуи действительно не отмечают этот праздник.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090107
					]
				},
				{
					"id": 700090107,
					"content": "А сто насёт тебя? Ты тоже не будешь его плаздновать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090108
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090108,
					"content": "Уверен, что в такое время у почётного рыцаря Мондштадта огромная гора важных дел. Я прав?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090109
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090109,
					"content": "А ты чего такой довольный?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090110
					]
				},
				{
					"id": 700090110,
					"content": "Кхм-кхм, ничего, просто так... Кстати говоря, если тебе больше нечего делать, можешь оказать мне одну услугу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090111
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090111,
					"content": "Родители этой девочки отправились за покупками посреди праздника и оставили её под присмотром сестёр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090112
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090112,
					"content": "Но, как ты знаешь, во время праздников у всех куча дел, даже у сестёр церкви. Им тоже некогда возиться с ребёнком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090113
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090113,
					"content": "Поэтому она прицепилась ко мне. Но, как ты наверняка знаешь, я не могу просто так покинуть собор и погулять с ней. Единственное, что я могу сделать - это стоять здесь и болтать с ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090114
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090114,
					"content": "Но даже просто общаясь с ребёнком, я чувствую, как вон та сестра сверлит меня своим взглядом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090115
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090115,
					"content": "Держу пари, она думает: «Ох, что же замышляет тот коварный Фатуи на этот раз», или что-то вроде того.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090116
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090116,
					"content": "Тьфу... В общем, для того чтобы отделаться от подозрений этой сестры и для психологического благополучия этого ребёнка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090117
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090117,
					"content": "...Могу ли я попросить вас, о почётный рыцарь, соизволить поиграть с этим ребёнком на улице?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090118,
						700090122
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090118,
					"content": "#Да, да, я тебя понял{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090119
					]
				},
				{
					"id": 700090119,
					"content": "Так просто? Но опять же, ты ведь почётный рыцарь. Как глупо было с моей стороны подумать, что ты попытаешься увильнуть или попросишь что-то взамен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090120
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090120,
					"content": "Всё, давай, иди, поиграй с ребёнком. А я останусь стоять здесь... до тех пор, пока сёстры не просверлят своим взглядом мне дырку в затылке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090121
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090121,
					"content": "Ох, когда же всё это наконец закончится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090122,
					"content": "Ты действительно просто хочешь, чтобы Лили смогла пойти поиграть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090123
					]
				},
				{
					"id": 700090123,
					"content": "Ты... Ладно, неважно. Да, я Фатуи, я злодей. Но разве у меня не могут быть добрые намерения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090124
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090124,
					"content": "Ну всё, давай, проваливай! Отведи этого ребёнка куда-нибудь, иначе она задохнётся в этом соборе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090125
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090125,
					"content": "А я останусь стоять здесь... до тех пор, пока сёстры не просверлят своим взглядом мне дырку в затылке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090126
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 700090126,
					"content": "Ох, когда же всё это наконец закончится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				}
			]
		},
		{
			"id": 7000902,
			"completionStepIds": [
				7000904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000904",
							"2"
						],
						"stepId": 7000904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лили"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090201,
					"content": "Почему дядя Фатуи не может пойти плаздновать плаздник?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090202,
						700090204
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090202,
					"content": "Он занят важными делами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090203
					]
				},
				{
					"id": 700090203,
					"content": "Важными делами? Важнее, чем плаздник?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090207,
					"content": "Но ведь пвахой Фатуи тоже когда-нибудь сможет стать холошим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090208
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090208,
					"content": "А, точно! Я скажу ему, что если он станет холошим человеком, то сможет пойти на плаздник вместе со всеми!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090209
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090209,
					"content": "Дядя Фатуи сейчас очень занят. Давай пойдём поиграем, хорошо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090210
					]
				},
				{
					"id": 700090210,
					"content": "Холошо. Значит, мы пойдём иглать вместе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090211
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090211,
					"content": "Конечно, только не убегай далеко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090212
					]
				},
				{
					"id": 700090212,
					"content": "Холошо! Пойдём сколее иглать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090204,
					"content": "Боюсь, Фатуи нельзя участвовать в Празднике ветряных цветов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090205
					]
				},
				{
					"id": 700090205,
					"content": "Но почему? Потомуфта Фатуи плохие, да? Папа говолит, что они не чистят зубы пелед сном и едят луками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090206
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090206,
					"content": "Ммм... Так себя вести - это пвоха. Я увелена, сто папа дяди Фатуи тоже лугается на нево...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Лили"
				}
			]
		},
		{
			"id": 7000903,
			"completionStepIds": [
				7000906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000906",
							"2"
						],
						"stepId": 7000906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бланш"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090302,
					"content": "#{NICKNAME}? Чем я могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090303
					],
					"speakerTitle": "Бланш"
				},
				{
					"id": 700090303,
					"content": "А это у нас кто? Лили? Почему ты здесь? Где твои родители?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090304
					],
					"speakerTitle": "Бланш"
				},
				{
					"id": 700090304,
					"content": "#У папы и мамы очень важные дела! Поэтому сиводня {NICKNAME} ведёт меня иглать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090305
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090305,
					"content": "Важные дела? Ах, Рудольф и Джиллиана, они...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090306
					],
					"speakerTitle": "Бланш"
				},
				{
					"id": 700090306,
					"content": "Систлёнка, а куда подевались щеночки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090307
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090307,
					"content": "Ох, щеночки? Если честно, я сама не знаю. Обычно они прячутся в своих будках и выходят, только когда я кладу им в миску немного еды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090308
					],
					"speakerTitle": "Бланш"
				},
				{
					"id": 700090308,
					"content": "Может быть, они убежали, потому что в городе сейчас слишком шумно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090309
					],
					"speakerTitle": "Бланш"
				},
				{
					"id": 700090309,
					"content": "Лили, ты хочешь с ними поиграть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090310
					],
					"speakerTitle": "Бланш"
				},
				{
					"id": 700090310,
					"content": "Да! Я хочу поиглать с щеночками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090311
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090311,
					"content": "Хм... Дай подумать. Мне кажется, что искать их по всему городу нет смысла. Лучше положить немного еды в их миску, и тогда они могут прийти сюда сами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090312
					],
					"speakerTitle": "Бланш"
				},
				{
					"id": 700090312,
					"content": "Обычно мясо птицы привлекает их больше всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090313
					],
					"speakerTitle": "Бланш"
				},
				{
					"id": 700090313,
					"content": "Ой... А у меня нету с собой никакого мяса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090314
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090314,
					"content": "Давай я займусь этим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090315
					]
				},
				{
					"id": 700090315,
					"content": "Плавда? Спасиба! Сколее, пошли колмить собачек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лили"
				}
			]
		},
