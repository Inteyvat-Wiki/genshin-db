	"talks": [
		{
			"id": 7000901,
			"completionStepIds": [
				7000903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
