					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090703
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090703,
					"content": "Готова! Я плиготовила тли блинчика: один тебе, один мне и один дяде Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090704
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 700090704,
					"content": "Ну всё, можно идти облатно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лили"
