				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150301,
					"content": "Он ушёл... И мы пойдём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 221150302,
					"content": "Постой... Что это такое? Это Чан Девятый обронил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 221150303,
					"content": "Давай проверим на всякий случай...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 2211505,
			"completionStepIds": [
				2211507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211507",
							"2"
						],
						"stepId": 2211507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чан Девятый"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150501,
					"content": "Чего же не хватает этой книге?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150502
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150502,
					"content": "Это ты обронил?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150503
					]
				},
				{
					"id": 221150503,
					"content": "Хм? О... Да, это моё. Мне не понравилось написанное, поэтому я решил выбросить рукописи в реку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150504
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150504,
					"content": "#Поверить не могу, что ты их собрал{F#а}... Чернила совсем размокли... Уже невозможно прочитать, что тут написано.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150505
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150505,
					"content": "Что здесь написано?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150506
					]
				},
				{
					"id": 221150506,
					"content": "История для одной девочки, которую я помню ещё совсем маленькой. Это черновики, которые я выкинул... Ты даже не представляешь, какой она была в детстве. Постоянно просила меня прочитать ей какую-нибудь историю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150507
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150507,
					"content": "К сожалению, тогда у меня не было возможности много писать. Я писал для неё только начала нескольких историй, и обещал дописать продолжения после...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150508
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150508,
					"content": "А потом эта девочка исчезла... И больше я её не видел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150509
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150509,
					"content": "Я уверен, что это решение её семьи. Я им никогда не нравился, и они не хотели, чтобы их дочь общалась со мной. Поэтому они уехали из деревни Цинцэ при первой возможности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150510
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150510,
					"content": "Но они ещё пожалеют. Когда я стану знаменитым, они сами ко мне придут. Вот увидишь, когда я напишу для неё книжку, эта книжка станет настоящим бестселлером!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150511
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150511,
					"content": "Тогда уж они посмотрят на меня иначе! Они поймут, что я уже не тот малыш Чан, которого они помнят!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150512
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150512,
					"content": "И тогда... Тогда мы встретимся вновь... Но сначала я должен закончить книжку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150513
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150513,
					"content": "П-Прости, я вот так вывалил на тебя всё сразу. Пора возвращаться к работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чан Девятый"
				}
			]
		},
		{
			"id": 2211506,
			"completionStepIds": [
				2211508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
