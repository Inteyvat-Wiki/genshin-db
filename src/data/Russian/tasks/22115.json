			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чан Девятый"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150201,
					"content": "Пф! Проклятые монстры... Чтоб им пусто было!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150202
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150202,
					"content": "Я всего лишь хотел найти маленькую кроху вдохновения для моей новой книги... Вместо этого я застрял здесь среди монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150203
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150203,
					"content": "Спасибо вам за помощь. Не знаю, что бы я без вас делал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150204
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150204,
					"content": "Бабуля Жо Синь беспокоится о тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150205
					]
				},
				{
					"id": 221150205,
					"content": "Беспокоится обо мне? А чего обо мне беспокоиться? Я уже взрослый, и могу сам о себе позаботиться... Даже с этими монстрами я бы сам разобрался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150206
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221150206,
					"content": "Однако спасибо тебе за помощь. Пойду-ка я поскорей домой, пока бабуля ещё кому-нибудь на меня не нажаловалась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чан Девятый"
				}
			]
		},
		{
			"id": 2211503,
			"completionStepIds": [
				2211505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211505",
							"2"
