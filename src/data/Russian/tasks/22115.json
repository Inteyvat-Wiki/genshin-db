				"points": []
			},
			"dialogs": [
				{
					"id": 221150101,
					"content": "Малыш Чан... Где же ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150102
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 221150102,
					"content": "Кто такой малыш Чан?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150103
					]
				},
				{
					"id": 221150103,
					"content": "Я так называю Чана Девятого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150104
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 221150104,
					"content": "Я так привыкла называть его малыш Чан, что мне уже странно слышать его полное имя - Чан Девятый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150105
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 221150105,
					"content": "Вчера вечером он ушёл искать материалы для своей новой книги. Я не обратила на это особенного внимания, только попросила его не задерживаться. Всё как обычно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150106
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 221150106,
					"content": "Но он всё ещё не вернулся. Я переживаю, не случилось ли с ним чего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150107
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 221150107,
					"content": "Я уже слишком стара, чтобы отправиться на его поиски. Поможете старушке найти своего дедушку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150108,
						221150110
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 221150108,
					"content": "Хорошо, я помогу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150109
					]
				},
				{
					"id": 221150109,
					"content": "Отлично. Спасибо вам большое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 221150110,
					"content": "В какую сторону он пошёл?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150111
					]
				},
				{
					"id": 221150111,
					"content": "Эх... Он всегда ходит в одно и то же место. На склон Уван.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150112
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 221150112,
					"content": "Прошу тебя, найдите его поскорей... Надеюсь, с ним ничего не случилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабуля Жо Синь"
				}
			]
		},
		{
			"id": 2211502,
			"completionStepIds": [
				2211504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
