						],
						"stepId": 2211508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бабуля Жо Синь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150601,
					"content": "Ох, малыш Чан...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150602
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 221150602,
					"content": "Чан Девятый вернулся в целости и сохранности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150603
					]
				},
				{
					"id": 221150603,
					"content": "Да, я уже видела. Спасибо вам, дорогуши!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150604
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 221150604,
					"content": "Он такой с самого детства... Убежит куда-нибудь далеко и впутается в неприятности... Наверное, он никогда не вырастет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150605
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 221150605,
					"content": "В любом случае это не ваша забота. Малыш Чан всегда будет делать то, что ему захочется...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150606
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 221150606,
					"content": "Спасибо, что вернули его домой. Вот ваша награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150607
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 221150607,
					"content": "Я больше не буду вас задерживать, вы, вероятно очень заняты. Но... Прошу вас, не превращайтесь в малыша Чана. Он настолько обеспокоен тем, как его видят окружающие, что упускает шанс побыть наедине с собой и по-настоящему узнать себя...",
