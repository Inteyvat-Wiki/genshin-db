				},
				{
					"id": 790290202,
					"content": "Я отправлюсь вперёд, чтобы показать вам, как правильно проплыть через рифы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290203
					],
					"speakerTitle": "Капитан Вороньих авиалиний"
				},
				{
					"id": 790290203,
					"content": "Видите вон там камень? Сначала нужно плыть к нему!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Капитан Вороньих авиалиний"
