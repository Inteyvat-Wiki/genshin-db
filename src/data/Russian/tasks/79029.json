			"dialogs": [
				{
					"id": 790290101,
					"content": "Здесь статуя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790290102,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290103
					],
					"speakerTitle": "Капитан Вороньих авиалиний"
				},
				{
					"id": 790290103,
					"content": "Эй, почему ты стоишь у входа в пещеру и тяжело вздыхаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790290112,
					"content": "Я... Я в ней живу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290113
					],
					"speakerTitle": "Капитан Вороньих авиалиний"
				},
				{
					"id": 790290113,
					"content": "Ты живёшь в пещере?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790290114,
					"content": "А что мне остаётся?! Толпа актёров приехала на остров и устроила такой гвалт, что спать невозможно... Вот пришлось найти место потише.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290104
					],
					"speakerTitle": "Капитан Вороньих авиалиний"
				},
				{
					"id": 790290104,
					"content": "Но откуда-то взялась толпа хиличурлов и заняла моё местечко. И мне приходится оставаться во власти стихий снаружи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290105
					],
					"speakerTitle": "Капитан Вороньих авиалиний"
				},
				{
					"id": 790290105,
					"content": "Эх... Я поклялся, что если кто-то поможет мне, то я расскажу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290106
					],
					"speakerTitle": "Капитан Вороньих авиалиний"
				},
				{
					"id": 790290106,
					"content": "Что расскажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790290107,
					"content": "Дам подсказку, как найти пиратский клад! Хотя я и сам-то четвертинку только знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290108
					],
					"speakerTitle": "Капитан Вороньих авиалиний"
				},
				{
					"id": 790290108,
					"content": "Четвертинку от подсказки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790290109,
					"content": "Кажется, вы как раз ищете сокровища. Помогите мне избавиться от хиличурлов, а я вам расскажу, где подсказка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290110
					],
					"speakerTitle": "Капитан Вороньих авиалиний"
				},
				{
					"id": 790290110,
					"content": "Говорят, что если вы соберёте все четыре части подсказки, то сможете найти сокровища, оставленные здесь пиратами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290111
					],
					"speakerTitle": "Капитан Вороньих авиалиний"
				},
				{
					"id": 790290111,
					"content": "Договорились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
