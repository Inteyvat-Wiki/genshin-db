			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266106",
							"2"
						],
						"stepId": 7266106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610501,
					"content": "Тут только остатки руды. Такое ощущение, что кто-то всё забрал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726610502,
					"content": "А?! Это что... Похитители сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726610503,
					"content": "Неужели это они всё забрали из кучи руды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726610504,
					"content": "Давай вслед за ними! Наверняка их лагерь где-то поблизости и окаменелости тоже там!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726610505,
					"content": "Пойдём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610506
					]
				},
				{
					"id": 726610506,
					"content": "Давай тихонечко, тихонечко. Лишь бы не заметили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7266106,
