			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нантак",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610101,
					"content": "О, молодой рыбак, рад тебя видеть. Что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610102
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610102,
					"content": "Не стесняйся, я твой гид по ловле рыбы. Если что - спрашивай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610103
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610103,
					"content": "Неудивительно, что Кудзирай всё не может забыть про Лунного левиафана, ведь её желание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610104
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610104,
					"content": "Эх... Если она узнает правду про Лунного левиафана, то ужасно расстроится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610105
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610105,
					"content": "Какую правду?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610106
					]
				},
				{
					"id": 726610106,
					"content": "На самом деле, когда мы вернулись, я тоже не прекратил поиски Лунного левиафана и наконец нашёл зацепку в одной древней книге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610107
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610107,
					"content": "Уцепившись за неё, я провёл полевые исследования и в итоге сделал поразительное открытие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610108
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610108,
					"content": "Я всё это описал в своей книге. Кстати, вроде неплохо продаётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610109
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610109,
					"content": "Вот, редактор как раз оставил одну книгу. Почитай, вся правда о Лунном левиафане там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610110
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610110,
					"content": "Паймон тоже хочет почитать! Дай Паймон почитать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726610111,
					"content": "«О том, что Лунный левиафан на самом деле гигантская морская черепаха»... Какое длинное название... А?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726610112,
					"content": "Гигантская черепаха? Лунный левиафан - гигантская морская черепаха?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726610113,
					"content": "Именно. Лунный левиафан просто гигантская морская черепаха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610114
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610114,
					"content": "Той ночью мы увидели морскую черепаху, спина которой была покрыта светящимися растениями, типа травы-светяшки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610115
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610115,
					"content": "Черепаха была беременна и плыла к берегу, чтобы отложить яйца. Так мы и нашли дорогу домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610116
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610116,
					"content": "Так что иди расскажи всё Кудзирай. Рано или поздно ей придётся узнать правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610117
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610117,
					"content": "Ну её, конечно, можно уговорить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610118
					]
				},
				{
					"id": 726610118,
					"content": "Судя по выражению лица, ты всё-таки сомневаешься? Но у моего исследования есть доказательства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610119
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610119,
					"content": "В старых трактатах говорится, что Лунный левиафан относится к виду древних существ из тех времён, когда на земле было намного больше животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610120
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610120,
					"content": "Их предки жили в районе современного Драконьего хребта. Там и сейчас можно найти их окаменелости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610121
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 726610121,
					"content": "Я даже видел несколько среди руды на <color=#00E1FFFF>западном склоне Ущелья спящего дракона</color>. Если не верите, то можете сходить посмотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нантак"
				}
			]
		},
