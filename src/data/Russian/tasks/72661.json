			"trigger": {
				"objectNames": [
					"Кудзирай Момидзи",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610601,
					"content": "Вы вернулись. А Цзя Вэй не пришёл?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610602
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610602,
					"content": "Променял море на женщину.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610603
					]
				},
				{
					"id": 726610603,
					"content": "А? Стал примерным семьянином? Ха-ха! Это в его стиле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610604
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610604,
					"content": "А ведь он тогда об этом и мечтал... Ладно, раз дело в этом, придётся его простить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610605
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610605,
					"content": "А Нантак? Вы нашли его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610606
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610606,
					"content": "Он написал бестселлер.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610607
					]
				},
				{
					"id": 726610607,
					"content": "А? Вот уж не думала, что он правда станет писателем. А он парень не промах. Что написал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610608
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610608,
					"content": "Паймон знает! Книга называется «О том, что Лунный левиафан на самом деле гигантская морская черепаха».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726610609,
					"content": "Ого, какое длинное название, это новелла какая-то? Неплохо... Надо будет тоже купить почитать... А? Погоди-ка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610610
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610610,
					"content": "О том, что Лунный левиафан... Лунный левиафан?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610611
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610611,
					"content": "...на самом деле гигантская морская черепаха.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610612
					]
				},
				{
					"id": 726610612,
					"content": "Он с ума сошёл? Как это морская черепаха? Он забыл, что мы собственными глазами его видели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610613
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610613,
					"content": "Мы сначала тоже не поверили... А потом мы нашли окаменелые остатки Лунного левиафана на Драконьем хребте... Вот, книга и окаменелость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726610614,
					"content": "Нет, я не верю... Это неправда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610615
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610615,
					"content": "Знаешь, семья Кудзирай - потомственные рыбаки. И мой отец тоже был известным в Инадзуме рыбаком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610616
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610616,
					"content": "Он потратил десятки лет охотясь за Лунным левиафаном, и однажды ему это почти удалось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610617
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610617,
					"content": "Хотя он потерпел неудачу в шаге от цели, но он не сдался. Для рыбака поймать легендарного Лунного левиафана - наивысшая честь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610618
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610618,
					"content": "Но когда он снова вышел в море... то больше не вернулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610619
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610619,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610620
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610620,
					"content": "Поэтому я не верю таким разговорам. Пожалуйста, помоги мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610621
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610621,
					"content": "Что же ты будешь делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610622
					]
				},
				{
					"id": 726610622,
					"content": "Пойду отыщу вещи моего отца. Он всю жизнь провёл в погоне за Лунным левиафаном и оставил много записей. Там обязательно должен быть способ поймать его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610623
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726610623,
					"content": "Я подготовила для тебя рыболовные упражнения, подожди пока. Мне ещё понадобится твоя помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кудзирай Момидзи"
				}
			]
		},
		{
			"id": 7266107,
