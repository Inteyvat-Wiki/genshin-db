			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ци из старой школы",
					"Ба Цзы",
					"Кодзэн",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610701,
					"content": "Что? Этот булыжник денег стоит? И он просто валялся в груде руды. Чудеса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610702
					],
					"speakerTitle": "Ци из старой школы"
				},
				{
					"id": 726610702,
					"content": "Булыжник! Ну ты даёшь. Книжек не читал, что ли? Это о-ка-ме-не-лость. Понимаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610703
					],
					"speakerTitle": "Беглец Линь"
				},
				{
					"id": 726610703,
					"content": "Она не просто денег стоит, а за неё половину Ли Юэ купить можно! Иди книжки почитай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610704
					],
					"speakerTitle": "Беглец Линь"
				},
				{
					"id": 726610704,
					"content": "Правда? Такая дорогая? Так если посчитать те, что в лагере, то мы, считай, сорвали кушать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610705
					],
					"speakerTitle": "Ба Цзы"
				},
				{
					"id": 726610705,
					"content": "Сорвали куш! Ты тоже иди книжку почитай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610706
					],
					"speakerTitle": "Беглец Линь"
				},
				{
					"id": 726610706,
					"content": "Эй, вы! А ну отдали окаменелость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726610707,
					"content": "А! Это кто? Ох, нас заметили! Вперёд, братаны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Беглец Линь"
				}
			]
		}
	]
}