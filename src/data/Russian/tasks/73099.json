			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730990101,
					"content": "Вот это да! Мир аранар поистине чудесен... Стоит только посмотреть на картину и сразу находишь сокровище...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990102,
					"content": "Итак, мы нашли все места, изображённые на картинах. Паймон интересно, где же аранара, который создал эти карты сокровищ?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990103,
						730990104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990103,
					"content": "Не все...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990105
					]
				},
				{
					"id": 730990105,
					"content": "Да, там был рисунок со множеством аранар. Но мы не нашли там сокровище...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990106,
					"content": "(Кажется, что в сумке что-то слегка вибрирует.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990107,
					"content": "(Найти вибрирующий предмет)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990108
					]
				},
				{
					"id": 730990108,
					"content": "Хм? Это же то семечко, которое мы нашли возле Разлома, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990109,
						730990111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990109,
					"content": "Кажется, оно указывает нам путь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990110
					]
				},
				{
					"id": 730990110,
					"content": "Хм... не исключено. Давай понаблюдаем за семенем, вдруг оно снова завибрирует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990113,
					"content": "Возможно, там попавший в беду аранара! Или что-то вроде сокровищницы аранар... И это семя - ключ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990111,
					"content": "Уму непостижимо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990112
					]
				},
				{
					"id": 730990112,
					"content": "Хм... Кажется, оно указывает нам путь... Давай понаблюдаем за семенем, вдруг оно снова завибрирует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990104,
					"content": "Осталось ещё одно место...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990105
					]
				}
			]
		},
