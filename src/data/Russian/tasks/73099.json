		{
			"id": 7309903,
			"completionStepIds": [
				7309905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7309905",
							"2"
						],
						"stepId": 7309905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Араминали",
					"Паймон",
					"Аранимба"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730990301,
					"content": "#Эй! Это {F#золотая}{M#золотой} нара! Пахнет ветром, землёй и аранарами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990302
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990302,
					"content": "#{F#Золотая}{M#Золотой} нара {F#разобралась}{M#разобрался} в араракалари Араямы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990303
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990303,
					"content": "Какой ужас! От преград никакого толка, кто угодно может проникнуть внутрь и растоптать «уютное гнёздышко» Араминали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990304
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990304,
					"content": "Эй, успокойся, мы ничего плохого не замышляем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990305,
					"content": "Что значит «не замышляем»? Хотите сказать, что вы не алчные?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990306
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990306,
					"content": "#Можно и так сказать. {NICKNAME} и я на стороне аранар. Мы хотим быть аранарам добрыми друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990307,
					"content": "Паймон прожорливая, но добрая.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990308
					]
				},
				{
					"id": 730990308,
					"content": "Эй! Может, это и правда, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990309,
					"content": "#{F#Добрая подруга}{M#Добрый друг} аранар... {F#Золотая}{M#Золотой} нара пахнет, как аранара. Знакомый запах, но я не встречал его уже очень давно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990310
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990310,
					"content": "#Кстати, у нас же есть странное семя! {NICKNAME}, покажи семя Араминали. Может, он что-нибудь знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990311,
					"content": "Он хочет пить! Ему нужно выпить много воды, прежде чем он сможет стать прежним. Пойдём... здесь много воды. Пусть он напьётся вдоволь, чтобы восстановиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990312
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990312,
					"content": "Вы кладёте семя в воду...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730990313
					]
				},
				{
					"id": 730990313,
					"content": "...Ух ты! Он вернулся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990314
					],
					"speakerTitle": "Аранимба"
				},
				{
					"id": 730990314,
					"content": "#Вот это да! Семя превратилось в аранара! Мы нашли попавшего в беду аранара! Видишь, я была права, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990315,
						730990316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990315,
					"content": "Надо же, и правда попавший в беду аранара...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				},
				{
					"id": 730990317,
					"content": "Это Аранимба! В отличие от Араминали, Аранимба любит путешествовать. Раньше он рисовал пейзажи, которые видел издалека, и отсылал их в Ванарану, но потом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990318
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990318,
					"content": "Потом Аранимба пошёл в очень тёмное и мрачное место, где было мало земли, но много камней... Под землёй было мало травы и мало деревьев, но много грибов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990319
					],
					"speakerTitle": "Аранимба"
				},
				{
					"id": 730990319,
					"content": "Хм... Похоже на Разлом. Для аранары Аранимба проделал дальний путь за пределы Сумеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990320,
					"content": "Да! Это долгий и опасный путь. Аранимба встретил опасного чёрного нару! Однако у Аранимбы была защита Арамухукунды, он превратился в семя и «выкрутился».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990321
					],
					"speakerTitle": "Аранимба"
				},
				{
					"id": 730990321,
					"content": "#Теперь Аранимба благополучно вернулся. Всё благодаря {M#золотому}{F#золотой} наре и белой леталке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990322
					],
					"speakerTitle": "Аранимба"
				},
				{
					"id": 730990322,
					"content": "#Нас зовут {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990323,
					"content": "#Да, нара {NICKNAME} и Паймон, вы - добрые друзья аранар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990324
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990324,
					"content": "#Араминали - «добрый друг» Аранимбы, поэтому нара {NICKNAME} и Паймон - тоже «добрые друзья» Аранимбы. Я понял!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990325
					],
					"speakerTitle": "Аранимба"
				},
				{
					"id": 730990325,
					"content": "Аранимбе пора идти. На этот раз, кроме рисунков, Аранимба пришлет «подарок» для Араминали и положит его в «сундук».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990326
					],
					"speakerTitle": "Аранимба"
				},
				{
					"id": 730990326,
					"content": "Все «сундуки» здесь принадлежат Араминали. Араминали - хозяин «сундуков».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990327
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990327,
					"content": "Для добрых друзей аранар, которые помогли многим аранарам... Аранара положит «сокровище» в «сундук» из «благодарности».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990328
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990328,
					"content": "В сундуке ничего не было?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990329,
					"content": "Аранары знают всё о ване, когда появляются на свет, но когда на свет появился «сундук», он был пуст! Араминали не знает почему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990330
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990330,
					"content": "Паймон перестала что-либо понимать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990331
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990331,
					"content": "#...Когда Араминали заполнит «сундук», нара {NICKNAME} сможет открыть его. И нара {NICKNAME} будет радостно восклицать «О да!» или вздыхать «Ах...», как это делают зелёные нары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990332
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990332,
					"content": "К чему такие сложности? Просто дайте нам то, что вы хотите положить в сундук в качестве благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990333
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990333,
					"content": "#Араминали знает, что зелёные нары любят заходить в пещеры или дома и открывать «сундуки». Нара {NICKNAME} и Паймон не любят так делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990334
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990334,
					"content": "Не то чтобы Паймон это не нравилось... Это кажется таким... необъяснимо притягательным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990335
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990335,
					"content": "#Нара любит «сундуки», и Араминали тоже. Араминали разрешает {F#доброй}{M#доброму} наре, {F#которая помогла}{M#который помог} аранаре, открыть «сундук».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990336
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990336,
					"content": "В ване много аранар. Некоторые из них нуждаются в помощи, а некоторые хотят поиграть с нарами. Когда нара исполняет их желания, он становится другом аранар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990337
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990337,
					"content": "Такой нара может открыть «сундук», который приготовил Араминали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990338
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990338,
					"content": "Поэтому Аранимбе нужно идти, чтобы наполнить «сундук».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990339
					],
					"speakerTitle": "Аранимба"
				},
				{
					"id": 730990339,
					"content": "Аранимба, ты только вернулся и снова собираешься уходить? Ты куда-то торопишься? Носишься вихрем как угорелый...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990340
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990340,
					"content": "Уи-и-и! Вихрь - это хорошо, а вот «горелый» - плохо. От огня Аранимбе снова захочется пить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990341
					],
					"speakerTitle": "Аранимба"
				},
				{
					"id": 730990341,
					"content": "Паймон спрашивает, зачем Аранимбе куда-то спешить? Аранимба мог бы остаться здесь ненадолго, побыть с Араминали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990342
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990342,
					"content": "Араминали, ты ведь так давно не видел Аранимбу! Разве вам не хочется поговорить обо всём на свете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990343
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990343,
					"content": "Аранимба - никогда не останавливается. Поэтому Аранимба не может быть хозяином «сундуков».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990344
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990344,
					"content": "Но куда бы ни пошёл Аранимба, пока вана знает, где он, знают ветер, цветы и трава, и Араминали тоже будет знать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990345
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990345,
					"content": "Так что всё в порядке. Не надо много говорить. Араминали будет слушать столько, сколько Аранимба захочет сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990346
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 730990346,
					"content": "#Хм... Это и есть дружба по-аранарски? {NICKNAME}, а вот у Паймон наверняка нашлась бы целая гора вещей, чтобы поделиться с тобой после разлуки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730990316,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				}
			]
		},
