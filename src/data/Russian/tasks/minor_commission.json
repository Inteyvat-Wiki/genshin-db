			"dialogs": [
				{
					"id": 761530101,
					"content": "Издательский бизнес не очень прибыльный... Может, заняться инвестициями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530102
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530102,
					"content": "Можно посмотреть инвестиционные купоны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530103
					]
				},
				{
					"id": 761530103,
					"content": "Хорошо, купоны стоят по 2000 моры за штуку, расчёт раз в неделю. Ха-ха, в этом маленьком мешочке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530104
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530104,
					"content": "...Ох!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530105
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530105,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530106
					]
				},
				{
					"id": 761530106,
					"content": "Ягода, почему ты здесь? Босс Нефер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530107
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530107,
					"content": "#Я просто сопровождаю {F#свою подругу}{M#своего друга}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530108
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761530108,
					"content": "Хе-хе, инвестиционный бизнес господина Дабита процветает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530109
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761530109,
					"content": "Ничего особенного! Ха-ха, так, мелочь, на жизнь хватает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530110
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530110,
					"content": "(Эта девчонка... что-то недоговаривает! Наверняка Нефер её послала... Пф.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530111
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530111,
					"content": "А на этом правда можно заработать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530112
					]
				},
				{
					"id": 761530112,
					"content": "Конечно! Босс сказала, что Дабит - самый уважаемый и способный негоциант. Инвестировать с ним - беспроигрышный вариант.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530113
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761530113,
					"content": "Да-да... Ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530114
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530114,
					"content": "(Так и знал, это Нефер!..)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530115
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530115,
					"content": "Когда можно будет получить прибыль от инвестиций?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530116
					]
				},
				{
					"id": 761530116,
					"content": "Сегодня! Прямо сегодня! Вы купили наши новые краткосрочные инвестиционные купоны! Прибыль и убытки сразу учитываются!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530117
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530117,
					"content": "Почему Паймон кажется, что ты это только что придумал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761530118,
					"content": "Э... В общем, спасибо за покупку краткосрочного инвестиционного купона!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530119
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530119,
					"content": "Вот ваша прибыль, желаю вам прекрасного дня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530120,
						761530121
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530120,
					"content": "В любом случае зарабатывать - это хорошо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				},
				{
					"id": 761530122,
					"content": "Правда? Хе-хе-хе, тогда купи Паймон птичку, Паймон очень нравятся такие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761530123,
					"content": "Эй, я пойду с вами и куплю одну для босса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530124
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761530124,
					"content": "Г-госпожа Ягода, подождите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530125
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530125,
					"content": "...Эм, госпожа Нефер просила что-то передать?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530126
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530126,
					"content": "А. Босс сказала: «Мы нашли то, что тебе нужно».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530127
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761530127,
					"content": "«Господин Дабит, не торопитесь. Всё нужно делать шаг за шагом, так надёжнее».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530128
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761530128,
					"content": "Да, как скажете... Значит, буду полагаться на вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дабит"
				},
				{
					"id": 761530121,
					"content": "Пойдём, Паймон, купим сахарные фигурки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				}
			]
