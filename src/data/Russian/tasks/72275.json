			},
			"dialogs": [
				{
					"id": 722750301,
					"content": "Прошу вас, идите к душам дзибасири и докажите свою доблесть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750302
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750302,
					"content": "Только когда вы пройдёте испытания, я смогу раскрыть все наши тайны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750303
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750303,
					"content": "Ох, я веду себя словно маленькая девочка, которой не терпится поделиться секретом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
