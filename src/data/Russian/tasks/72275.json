	"talks": [
		{
			"id": 7227501,
			"completionStepIds": [
				7227501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7227501",
							"2"
						],
						"stepId": 7227501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Эбоси",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750101,
					"content": "Раз я здесь, значит, кровавый коралл в руках Ватацуми. Это утешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750102
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750102,
					"content": "Меня зовут Эреб. На языке Инадзумы - Эбоси. Я служу Сангономии, и я одна из жриц Энканомии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750103
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750103,
					"content": "#А вы, должно быть, {F#героиня, получившая}{M#герой, получивший} коралл?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750104
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750104,
					"content": "Да, это я.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750105
					]
				},
				{
					"id": 722750105,
					"content": "Приношу свои извинения, но мне нужно рассказать об одном очень непростом деле. По правде говоря, я не знаю, с чего начать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750106
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750106,
					"content": "Просто рассказывай с самого начала, а мы будем слушать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722750107,
					"content": "Благодарю вас. В таком случае позвольте мне начать с Ватацуми Омиками, открывшего врата глубин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750108
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750108,
					"content": "В глубинах Энканомии находится природная система пещер, которая ведёт на остров Ватацуми. Это рай, который был обещан нам Ватацуми Омиками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750109
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750109,
					"content": "По указанию Омиками мы изучили культуру Наруками и установили дипломатические отношения со многими народами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750110
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750110,
					"content": "На острове Наруками мы прослыли «прекрасными созданиями с Ватацуми». Ведь на белоснежной коже жителей Ватацуми нет ни единого пятнышка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750111
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750111,
					"content": "Конечно, причиной этого было то, что наши предки в Энканомии не получали солнечного света...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750112,
						722750113
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750112,
					"content": "Можно ближе к делу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750114
					]
				},
				{
					"id": 722750114,
					"content": "Ах, прошу прощения. После того, как мы наладили дипломатические связи, я, будучи прислужницей Сангономии, частенько выступала в роли гида...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750115
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750115,
					"content": "Хорошо. Вернёмся к сути. У нас с госпожой Сангономией возникли разногласия. В результате посредничества Ватацуми Омиками возникла эта договорённость...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750116
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750116,
					"content": "Из-за того, что в Энканомии есть такое явление, как «грешные тени», её прошлое, история и истина не исчезнут, даже если оставить их на произвол судьбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750117
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750117,
					"content": "А потому усилия нужно было прилагать не для того, чтобы сохранить память, а для того, чтобы забыть о прошлом. Такого мнения придерживалась госпожа Сангономия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750118
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750118,
					"content": "(Сангономия, о которой она говорит, должно быть, существовала давным-давно...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722750119,
					"content": "Испытание по получению коралловой ветви по её замыслу было призвано ограничить число потомков, которые могли бы узнать правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750120
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750120,
					"content": "Что же до меня, то я всегда стояла за сохранение истины. И Ватацуми Омиками позволил мне добавить собственное испытание, раскрывающее после прохождения наши тайны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750121
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750121,
					"content": "Прошу вас принять это испытание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750122,
						722750123
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750122,
					"content": "Я пройду испытание.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750124
					]
				},
				{
					"id": 722750124,
					"content": "Прекрасно. Позвольте мне открыть это испытание для вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750123,
					"content": "Меня очень интересуют тайны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750124
					]
				},
				{
					"id": 722750113,
					"content": "Это мы уже слышали. Можно ближе к сути?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750114
					]
				}
			]
		},
		{
			"id": 7227502,
			"completionStepIds": [
				7227506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7227506",
							"2"
						],
						"stepId": 7227506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эбоси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750201,
					"content": "Вас признали все дзибасири. Они воплощают волю Ватацуми, а значит вы вправе узнать всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750202
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750202,
					"content": "Вы - спаситель народа Ватацуми, и Ватацуми также признаёт вас. Вы вправе спросить и получить ответы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750203
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750203,
					"content": "Тем не менее я прошу вас следовать правилам и не рассказывать никому о том, что узнаете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750204,
					"content": "Что вы хотите узнать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750205,
						722750206,
						722750207,
						722750208,
						722750209
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750205,
					"content": "О вишапах глубин...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750210
					]
				},
				{
					"id": 722750210,
					"content": "Они первобытные элементальные существа, не покорённые и не сломленные силой, пришедшей с небес, благодаря тому, что живут глубоко под водой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750211
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750211,
					"content": "Они очень умны. Пока мы воевали с ними, они даже смогли эволюционировать в различные элементальные формы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750212
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750212,
					"content": "Я нисколько не удивлюсь, если они выучили язык или, возможно, даже превратились в своего рода людей-ящериц.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750213
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750213,
					"content": "Феномен святой земли, по сути, является расширением их ареала обитания. Это означает, что усиливается первобытная элементальная сила трёх миров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750214
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750214,
					"content": "Только используя жизненную силу Ватацуми Омиками, чтобы пробудить его второго слугу, мы смогли преобразовать эту дикую, яростную стихийную силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750206,
					"content": "О Ватацуми Омиками...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750215
					]
				},
				{
					"id": 722750215,
					"content": "Ватацуми Омиками по воле рока попал в это место, где не правят силы небес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750216
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750216,
					"content": "Несомненно, для нас, жителей Бякуякоку, это обернулось удачей. Мы многим ему обязаны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750217
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750217,
					"content": "К сожалению, общаясь с нами, Ватацуми Омиками постиг истину, предшествовавшую его появлению. И небеса подтолкнули его принести себя в жертву.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750218
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750218,
					"content": "Правда, стоявшая за этой жертвой, должна была остаться нераскрытой. Только так народ Бякуякоку мог жить под властью Семерых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750207,
					"content": "Каков был миропорядок до появления солнца и луны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750219
					]
				},
				{
					"id": 722750219,
					"content": "До того как Бякуякоку погрузилась в пучину вод, весь мир объединяла единая культура.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750220
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750220,
					"content": "Позже разразилась великая война. Небеса опрокинулись, а земля была разорвана на части. Затем эта земля погрузилась в тёмные глубины океана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750221
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750221,
					"content": "Однако силы небес, похоже, не желали, чтобы помнящие это оставались на земле. Мы всё искали и искали дорогу домой, но её не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750222
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750222,
					"content": "Через много-много лет запрет небес ослаб. Так Ватацуми Омиками удалось попасть сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750208,
					"content": "О Дайнити Микоси...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750223
					]
				},
				{
					"id": 722750223,
					"content": "Дайнити Микоси создан мудрецом Абраксом и освещает даже самые тёмные глубины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750224
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750224,
					"content": "Кроме того, у него есть множество других функций.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750225
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750225,
					"content": "Это удивительное устройство, обладающее великой мощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Эбоси"
				},
				{
					"id": 722750209,
					"content": "У меня больше нет вопросов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750226
					]
				},
				{
					"id": 722750226,
					"content": "Хорошо. Ещё раз прошу, сохраните в секрете всё, что вы видели здесь, в Энканомии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эбоси"
