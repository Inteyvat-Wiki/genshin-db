							2187.956
						],
						"pointId": 7885
					}
				]
			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "А? Кажется, на этом мече что-то написано. Дай Паймон взглянуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711090602,
					"content": "«...Сжимая в руке клинок, пою я, готов убивать драконов и испить их крови. Божественный свет, подобно сияющей молнии, словно ледяная волна, грозит сокрушить горы...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "Записи древнего мечника"
				},
				{
					"id": 711090603,
					"content": "«...Под горой Тяньхэн я истребляю тигров, чешуйчатого зверя я кромсаю среди облаков... Когда я вернусь, увенчанный триумфом, мы заживём спокойно...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "Записи древнего мечника"
				},
				{
					"id": 711090604,
					"content": "Похоже, рядом есть ещё одна каменная табличка... Хм, надпись другая?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711090605,
					"content": "«...Я хотел оставить угощения, но рано или поздно они испортятся, поэтому я оставляю здесь рецепт. Вы можете приготовить угощение сами. Обещаю, будет вкусно».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "Древняя гравюра"
				},
				{
					"id": 711090606,
					"content": "«...Больше ничего не осталось. Только этот меч и пейзаж».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "Древняя гравюра"
				},
				{
					"id": 711090607,
					"content": "«...Что ждёт в конце пути? Вы знаете ответ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "Древняя гравюра"
				},
				{
					"id": 711090608,
					"content": "«...Не берите... сокровище, осталось только одно... отныне...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "Неразборчивая гравюра"
				},
				{
					"id": 711090609,
					"content": "«В отчаянии... Надеюсь, что вы прочтёте это...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "Неразборчивая гравюра"
				},
				{
					"id": 711090610,
					"content": "Ух... надпись внизу такая неровная. Паймон не поймёт никак, что там написано!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711090611,
					"content": "Вероятно, она означает, что он сам ничего не взял.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "У-у-у... Мы так и не нашли ни одного бесценного сокровища. Какая трата времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711090614,
					"content": "Точно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "Однако Паймон никак не ожидала увидеть столь красивый пейзаж в таком месте. Оно того стоило, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711090615,
					"content": "Не переживай, я приготовлю тебе что-нибудь вкусненькое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "#Правда? Ловлю тебя на слове, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711090612,
					"content": "Я тоже ничего не понимаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
		{
