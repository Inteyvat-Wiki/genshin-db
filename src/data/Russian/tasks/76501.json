			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лаума"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765010101,
					"content": "#Ах, {NICKNAME}, Паймон. Это вы. Лесные птицы только что сообщили о вашем прибытии. Вы пришли по важному делу или... нужно моё наставление?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010102,
						765010103
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 765010102,
					"content": "Да мы просто осматриваемся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				},
				{
					"id": 765010104,
					"content": "Это место пропитано лунным сиянием. Всё здесь - и травы, и живые существа - разительно отличается от внешнего мира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010105
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 765010105,
					"content": "Здесь и правда можно сделать множество ценных фотографий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010106
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 765010106,
					"content": "Прошу вас, ходите где пожелаете. Если вдруг у вас возникнут вопросы, обращайтесь ко мне в любое время, а я постараюсь на них ответить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010107,
						765010108
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 765010107,
					"content": "Здесь так спокойно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010109,
					"content": "Да, здесь я могу остаться наедине со своими мыслями и здесь я могу пошептаться с окружающими живыми существами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010110
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 765010110,
					"content": "Даже просто находясь здесь, можно обрести душевное спокойствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010111
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 765010111,
					"content": "О, как поэтично звучит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010112,
						765010113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765010112,
					"content": "Но, на самом деле, у меня есть маленькая просьба...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010114,
					"content": "Да. Ты отлично вписалась в фон, словно центр прекрасной картины! Ты бы точно потрясающе смотрелась на фотографии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765010115,
					"content": "Вы оставите мне картинку? Какой странный опыт! Если вы считаете, что покой этого момента и я сама достойны того, чтобы быть запечатлёнными на фотокамеру, я охотно соглашаюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010116
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 765010116,
					"content": "Для меня большая честь стать одним из воспоминаний о вашем путешествии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010117
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 765010117,
					"content": "Итак, что мне нужно сделать? Нужно ли мне устремить взгляд в каком-то направлении, или же сохранить обычную позу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010118,
						765010119
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 765010118,
					"content": "Обычную позу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010120,
					"content": "Ладно, вам лучше знать. Пусть вдохновение, каким бы мимолётным оно ни было, осчастливит вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лаума"
				},
				{
					"id": 765010119,
					"content": "Я постараюсь запечатлеть самый трогательный момент.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010113,
					"content": "Мы бы хотели сфотографировать тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010108,
					"content": "Лаума, а ты часто тут бываешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010103,
					"content": "Заодно ищем места для хороших кадров.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				}
			]
		},
