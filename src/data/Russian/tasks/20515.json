				{
					"id": 205150301,
					"content": "#Ты наш{F#ла}{M#ёл} Анну?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150302
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205150302,
					"content": "Она забралась на колокольню собора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150303
					]
				},
				{
					"id": 205150303,
					"content": "И никто из сестёр не заметил её?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150304
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205150304,
					"content": "Как у неё так получилось? Может, из неё действительно выйдет искатель приключений?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150305
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205150305,
					"content": "Пойду позову её вниз. Сестёр беспокоить не стоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150306
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205150306,
					"content": "Спасибо тебе за помощь. Прими это в знак благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		},
