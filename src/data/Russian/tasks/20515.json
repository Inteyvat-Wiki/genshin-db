					"Анна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205150201,
					"content": "Какие же эти сёстры бдительные. Меня чуть не заметили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150202
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205150202,
					"content": "Я могу только позавидовать твоей ловкости...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150203
					]
				},
				{
					"id": 205150203,
					"content": "#Ух ты! Как ты узнал{F#а}, что я здесь? Даже сёстры меня не заметили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150204
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205150204,
					"content": "Ну, раз тебе удалось меня найти, я пойду домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150205
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205150205,
					"content": "Обо мне не волнуйся, я всего лишь любовалась прекрасным видом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				}
			]
		},
