			},
			"dialogs": [
				{
					"id": 205150101,
					"content": "Куда это Анна опять убежала?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150102
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205150102,
					"content": "Что, снова не можешь найти Анну?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150103
					]
				},
				{
					"id": 205150103,
					"content": "Да. Я обошёл весь город, но её нигде нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150104
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205150104,
					"content": "Пожалуйста, помоги мне найти её. Я уже ног под собой не чую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150105,
						205150107
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205150105,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150106
					]
				},
				{
					"id": 205150106,
					"content": "Тогда дело за тобой. Если она, едва поправившись, не прекратит сбегать, тогда заболею я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205150111,
					"content": "Погоди... Анна говорила, что хочет пойти в собор поблагодарить сестёр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150112
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205150112,
					"content": "Лучше ты сначала сходи в собор. После этого можно будет расспросить Альберта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150113
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205150113,
					"content": "Он частенько ошивается у собора. Может быть, он что-нибудь видел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205150107,
					"content": "Может быть, она стала искателем приключений?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150108
					]
				},
				{
					"id": 205150108,
					"content": "Да ну, быть такого не может... Или всё-таки может?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150109
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205150109,
					"content": "Почему ты молчишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Энтони"
				}
			]
		},
		{
			"id": 2051502,
			"completionStepIds": [
				2051502
			],
