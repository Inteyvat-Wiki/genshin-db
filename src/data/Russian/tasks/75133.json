					"content": "Что-нибудь нашли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330202
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751330202,
					"content": "Может быть, здесь есть тоннель или потайной механизм? Давайте искать дальше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
