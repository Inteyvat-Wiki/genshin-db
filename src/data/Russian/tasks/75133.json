				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-136.96,
							453.037,
							10016.94
						],
						"pointId": 8608
					},
					{
						"sceneId": 3,
						"position": [
							-137.177,
							452.96,
							10019.38
						],
						"pointId": 8646
					}
				]
			},
			"dialogs": [
				{
					"id": 751330101,
					"content": "Паймон не ожидала, что Коко приведёт нас сюда. Ещё одна странная крепость. Совсем как та, где мы встретили Бону.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751330102,
					"content": "Смотрите, даже рисунок на стене такой же! Только его не пытались закрасить... Наверное, потому что сейчас мы выше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751330103,
					"content": "#{NICKNAME}, смотри! Наверное, это и есть царь питонов, о котором говорила Бона? Ну и тип!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751330104,
					"content": "Да, это царь питонов Оч-кан. Если верить легенде, ради создания «Тонатиу» он жестоко угнетал свой народ и в конце концов вызвал Бездну, чем погубил и себя, и своё царство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330105
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751330105,
					"content": "Но это всего лишь легенда. Даже в моём племени у каждого рассказчика своя версия, каким был конец Оч-кана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330106
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751330106,
					"content": "Может, он до сих пор блуждает по «Тонатиу», питаясь сокровищами. А может, злой дракон, который пытался нас остановить, это его призрак!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330107
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751330107,
					"content": "Ку-чи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330108
					],
					"speakerTitle": "Кокоуик"
				},
				{
					"id": 751330108,
					"content": "Ох, перестань! Твои истории пугают даже Коко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751330109,
					"content": "Р-р-р! Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330110,
					"content": "#С тех пор как мы победили злого дракона, {REALNAME[ID(2)|SHOWHOST(true)]} ждёт случая проявить себя. Наверное, он втайне соперничает с Коко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751330111,
					"content": "Ну ладно, и где Алтарь, который мы ищем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751330112,
					"content": "Если Коко не ошибся, он должен быть прямо под нами... Ммм? А я думала, его надо искать выше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330113
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751330113,
					"content": "Неужели вышла ошибка? Алтарь Первозданного огня не должен прятаться в горе. Как мы поднимемся оттуда в небо? Для этого придётся всю гору разрушить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330114
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751330114,
					"content": "Может быть, там приготовлено какое-нибудь специальное средство...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330115
					]
				},
				{
					"id": 751330115,
					"content": "Что же теперь делать? Внизу ты была уверена, что всё получится. И мы не понимаем, что говорит Коко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751330116,
					"content": "Кулу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330117
					],
					"speakerTitle": "Кокоуик"
				},
				{
					"id": 751330117,
					"content": "Р-р-р! Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330118,
					"content": "#Ну что, {REALNAME[ID(2)|SHOWHOST(true)]}, есть мысли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751330119,
					"content": "Кажется, я поняла. Паймон, он хочет сказать, что сухая логика никуда нас не приведёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330120
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751330120,
					"content": "Ты опять выдумываешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751330121,
					"content": "Ладно, что бы там ни было внизу, думаю, мы должны пойти и проверить. Это ведь тоже приключение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330122
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751330122,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330123,
					"content": "#Паймон не думала, что ты так воодушевишься, {REALNAME[ID(2)|SHOWHOST(true)]}. Тогда давайте посмотрим, как отсюда спуститься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
