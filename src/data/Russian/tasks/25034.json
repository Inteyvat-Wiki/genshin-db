			"dialogs": [
				{
					"id": 250340101,
					"content": "Вы ему не нравитесь. Уходите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250340102,
					"content": "Парень... Ты что, знаешь этот завриана?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "Нетерпеливые воры"
				},
				{
					"id": 250340103,
					"content": "Р-р-р... Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250340104,
					"content": "Смотрите-ка, этот завриан теряет терпение. Малец, иди-ка отсюда. Мы не бьём детей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "Нетерпеливые воры"
				},
				{
					"id": 250340105,
					"content": "Ребята, тащите мешок. Хм, за этого завриана точно дадут кучу моры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "Нетерпеливые воры"
				},
				{
					"id": 250340106,
					"content": "Не подходите! Ещё шаг, и я устрою вам взбучку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250340107,
					"content": "Взбучку? Ты? Ха-ха-ха, только посмотрите! Он хочет устроить нам взбучку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "Нетерпеливые воры"
				},
				{
					"id": 250340108,
					"content": "Ну, насмешил, малец! Ты сам это предложил, так что с меня взятки гладки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "Нетерпеливые воры"
				},
				{
					"id": 250340109,
					"content": "Р-р-р! Р-р! Р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250340110,
					"content": "Тсс, какой свирепый заврёнок... Малец, пора на боковую...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "Нетерпеливые воры"
				},
				{
					"id": 250340111,
					"content": "Сейчас я вас самих отправлю на боковую!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "#{M#Братик}{F#Сестричка}! Они негодяи! И хотят украсть Тику!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250340114,
					"content": "Р-р-р! Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250340115,
					"content": "...Мил человек, проходи мимо, а я потом отсыплю тебе моры в знак благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "Нетерпеливые воры"
				},
				{
					"id": 250340116,
					"content": "Тику нельзя обижать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "Тогда нам не о чем говорить. Что ж, это закон дороги. И правда на нашей стороне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "Нетерпеливые воры"
				},
				{
					"id": 250340119,
					"content": "Тьфу! Братья, задайте им!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нетерпеливые воры"
				},
				{
					"id": 250340117,
					"content": "Кто тебя нанял?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "С меня тоже взятки гладки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
