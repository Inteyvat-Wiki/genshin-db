			"dialogs": [
				{
					"id": 250340501,
					"content": "#Я рассчитываю на тебя, {M#братец}{F#сестрица}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340502
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250340502,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340503
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250340503,
					"content": "До племени слишком далеко, я бы никак не смог связаться с сестрой Ильяпой. Если бы не ты, Тику бы точно украли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340504
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250340504,
					"content": "Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340505
					]
				},
				{
					"id": 250340505,
					"content": "Мы хотели попрактиковаться в скалолазании, но в середине тренировки проголодались",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340506
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250340506,
					"content": "и захотели собрать немного фруктов. В поисках фруктов мы уходили всё дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340507
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250340507,
					"content": "И только когда наелись, обнаружили, что находимся уже очень далеко. Мама точно меня отчитает, когда я вернусь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340508
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250340508,
					"content": "#Спасибо, что спас{F#ла} нас. Возьми эти какауатли, я только что их сорвал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340509
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250340509,
					"content": "Скорее домой, Тика! Пойдём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340510
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250340510,
					"content": "Р-р-р! Р-р! Р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тика"
				}
			]
		}
