			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Нэко"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150101,
					"content": "Мяу, когда же этот камень станет похожим на меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150102
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150102,
					"content": "Как идут дела со скульптурой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150103
					]
				},
				{
					"id": 722150103,
					"content": "Каменный человек говорит, нужно ещё немного времени, и он достукает камень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150104
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150104,
					"content": "Хибики будет так рада, когда вернётся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150105
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150105,
					"content": "Да, но нужно ведь подготовить окрестности святилища к тому моменту, как камень будет готов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150106
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150106,
					"content": "Помогите мне развесить эти круглые звенящие шарики из металла вокруг святилища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150107
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150107,
					"content": "Это штучки Хибики. Я помню, их подарил Домэки, потому что ей нравилось играть ими с детьми. Кое-как их отыскала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150108
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150108,
					"content": "Это колокольчики?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150109
					]
				},
				{
					"id": 722150109,
					"content": "«Колокольчики»? Не знаю. Но Хибики часто играла со мной этими шариками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150110
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150110,
					"content": "Хибики кидала их на землю так, чтобы они катились далеко-далеко. А пока катились, они делали дзинь-дзинь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150111
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150111,
					"content": "Не знаю, что за магия в них скрыта. Но мы с другими кошками никогда не могли удержаться, когда слышали этот звук.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150112
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150112,
					"content": "И вот я подумала: наверное, люди не приходят в святилище, потому что здесь не хватает железных шариков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150113
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150113,
					"content": "Поэтому я прошу вас о помощи: повесьте эти шарики повыше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150114
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150114,
					"content": "Тогда люди услышат их звон и придут сюда. Так они не собьются с пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150115
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150115,
					"content": "Тогда в ящике для подношений будет много моры, святилище будет процветать... И Хибики обрадуется, когда вернётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150116
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150116,
					"content": "Так что развесьте эти железные шарики вокруг святилища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150117
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150117,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150118
					]
				},
				{
					"id": 722150118,
					"content": "Спасибо, мяу-мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				}
			]
		},
		{
			"id": 7221502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
