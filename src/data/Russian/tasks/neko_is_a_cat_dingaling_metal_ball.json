			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нэко"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150201,
					"content": "Теперь, когда тут есть железные шарики, люди обязательно придут. Хибики будет так рада!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				}
			]
		},
		{
			"id": 7221503,
			"completionStepIds": [
				7221503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221503",
							"2"
						],
						"stepId": 7221503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нэко"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150301,
					"content": "Ну что, всё развесили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150302
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150302,
					"content": "Всё развесили.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150303
					]
				},
				{
					"id": 722150303,
					"content": "Мяу-мяу, отлично. У меня точно получится вернуть это святилище к жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150304
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150305
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150305,
					"content": "Хм? Почему здесь всё ещё не толпятся люди?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150306,
						722150307
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150306,
					"content": "Наверное, нужно немного времени.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				},
				{
					"id": 722150308,
					"content": "#Ох, люди такие непонятные. Ну ты не в счёт - все-таки для человека ты очень сообразительн{M#ый}{F#ая}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150309
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150309,
					"content": "Хоть люди пока так и не пришли, но с этим звяканьем котята всегда смогут найти дорогу домой. Мяу-мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150310
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150310,
					"content": "Каменный человек говорит, что мой камень совсем скоро будет готов. Надо посмотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150311
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150311,
					"content": "А, точно. Случилось ещё кое-что. Кое-что странное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150312
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150312,
					"content": "Я расспросила двух зелёных людей о Хибики и Домэки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150313
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150313,
					"content": "Зелёные люди сказали, что незнакомы с Хибики и ничего о ней не знают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150314
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150314,
					"content": "Но высокий зелёный человек сказал, что он читал про Ако Домэки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150315
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150315,
					"content": "И он говорил всякие слова - «бандит», «покарать»... В общем это такие слова, которые значат, что Домэки - плохой человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150316
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150316,
					"content": "Это какая-то ошибка! Хибики играла с ним. А значит Домэки - хороший.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150317
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150317,
					"content": "Похоже, тот человек в этом совсем не разбирается. Я могу положиться только на тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150318
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150318,
					"content": "И Хибики... когда она вернётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722150307,
					"content": "Возможно, всё не так просто...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				}
			]
		}
	]
}