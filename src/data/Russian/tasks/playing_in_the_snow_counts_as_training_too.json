			"dialogs": [
				{
					"id": 706910101,
					"content": "#{M#Дядя почётный рыцарь}{F#Тётя почётный рыцарь}! Сюда, сюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910102
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 706910102,
					"content": "Кли нашла новых друзей! Хочешь поиграть с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910103
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 706910103,
					"content": "Они научили нас новой игре, которая называется «По снежным следам».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910104
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 706910104,
					"content": "Правила несложные. Это новый вид игры в прятки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910105
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 706910105,
					"content": "Ух ты! Кли, Яо Яо и Саю, когда вы успели подружиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706910106,
					"content": "Судя по названию игры, это улучшенная версия «По следам ветра»? Паймон не терпится поиграть с вами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910107,
						706910108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706910107,
					"content": "Прятки! Отлично!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				},
				{
					"id": 706910109,
					"content": "Апчхи... В лагере стало теплее, но всё равно хочется спать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910110
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 706910110,
					"content": "#Хм? Мне кажется, или это {NICKNAME} и Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910111
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 706910111,
					"content": "#Тебе не кажется. Это действительно {NICKNAME} и Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910112,
						706910113
					],
					"speakerTitle": "Яо Яо"
				},
				{
					"id": 706910112,
					"content": "Привет, Яо Яо! Привет, Саю!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910114,
					"content": "Отличная идея! Нужно двигаться и веселиться, тогда и сонливость пропадёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910115
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 706910115,
					"content": "А та ужасно серьёзная госпожа Сумирэ сказала ведь, что чем больше времени ты проведёшь в снежных горах, тем лучше станут твои навыки, Саю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910116
					],
					"speakerTitle": "Яо Яо"
				},
				{
					"id": 706910116,
					"content": "Не верится, что вы это запомнили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910117
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 706910117,
					"content": "Ладно... Но если я проиграю своим сверстникам или даже псу-ниндзя... то мне будет гораздо сложнее отлынивать от работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910118
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 706910118,
					"content": "Похоже, в этой поездке мне придётся потрудиться на славу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910119
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 706910119,
					"content": "Не волнуйся! Я приготовила гуляш по новому рецепту. Добавила порошок из заоблачного перчика и обычного перца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910120
					],
					"speakerTitle": "Яо Яо"
				},
				{
					"id": 706910120,
					"content": "Поешь немного, чтобы не простудиться во время игры в прятки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910121
					],
					"speakerTitle": "Яо Яо"
				},
				{
					"id": 706910121,
					"content": "Отлично! Я съем всю тарелку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910122
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 706910122,
					"content": "Паймон тоже хочет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706910123,
					"content": "Тогда... давайте начнём нашу игру в прятки в заснеженных горах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910124
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 706910124,
					"content": "Хе-хе! На Драконьем хребте всё белым-бело. Паймон спрячется так, что никто её не найдёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706910113,
					"content": "Хотите сыграть в прятки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910108,
					"content": "Я тоже хочу познакомиться с новыми друзьями Кли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				}
			]
		}
	]
}