	"talks": [
		{
			"id": 7370201,
			"completionStepIds": [
				7370201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370201",
							"2"
						],
						"stepId": 7370201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Зурван"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020101,
					"content": "Ты выглядишь гораздо счастливее, чем в прошлый раз, когда мы разговаривали. Кажется, всё прошло хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020102
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020102,
					"content": "Хм. Благодаря этим заданиям я выросла. А теперь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020103
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020103,
					"content": "...достойна ли ты считаться Цветочной хранительницей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020104
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020104,
					"content": "Нет... ещё нет. Осталась последняя часть задания, которую нужно выполнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020105
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020105,
					"content": "Пока не будут выполнены все задания, пока не будет заслужено ваше одобрение, я не остановлюсь. Только тогда Двурогий венец будет принадлежать мне по-настоящему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020106
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020106,
					"content": "О? Похоже, ты действительно уже прошла бунтарский период.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020107
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020107,
					"content": "Первоявленная... вы всё ещё вспоминаете об этом? Прошу, не надо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020108
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020108,
					"content": "Ха-ха. Несмотря ни на что, приятно видеть, что к тебе вернулось хорошее настроение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020109
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020109,
					"content": "#{NICKNAME}, Паймон, прошу, засвидетельствуйте, достойна ли Соруш Двурогого венца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020110
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020110,
					"content": "Тогда я буду ждать вас в конечной точке. До скорой встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зурван"
				}
			]
		},
		{
			"id": 7370206,
			"completionStepIds": [
				7370206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370206",
							"2"
						],
						"stepId": 7370206,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Соруш"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020601,
					"content": "Пролом Туниги... здесь был эпицентр бедствия. Хотя место кажется спокойным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020602
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020602,
					"content": "Нетрудно вспомнить, как всё было в те времена.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020603
					]
				},
				{
					"id": 737020603,
					"content": "Эти кристаллы огромны... Намного больше, чем даже унут! И подумать только: ответственность за решение проблем, которые могут возникнуть здесь, лежит на Соруш...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020604,
					"content": "Разве это не самая важная обязанность, которую должна выполнять Цветочная хранительница? Кроме того, это задача, которую Соруш сама должна ставить перед собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020605
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020605,
					"content": "Так говорят, во всяком случае...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020606,
					"content": "Ты мне не доверяешь? Хм. Я и не думала, что даже Белая Болталка меня недооценивает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020607
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020607,
					"content": "Ух, похоже, к Соруш опять вернулось её высокомерие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020608,
					"content": "#Не уверен{F#а}, хорошо это или плохо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020609
					]
				},
				{
					"id": 737020609,
					"content": "Пф. Почему вы всё ещё сомневаетесь во мне после того, как мы провели время вместе? Моя гордость никогда не была порождена слепым высокомерием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020610
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020610,
					"content": "Хм. Если хотите знать, я полностью осознаю свои прошлые ошибки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020611
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020611,
					"content": "Раньше я ставила репутацию выше действий, но теперь я поняла, что это проявление абсолютного пренебрежения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020612
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020612,
					"content": "Подобно тому, как Симург стала божественной птицей благодаря своей жертве, я стану Цветочной хранительницей благодаря своим деяниям и услышу, как моё имя воспевают, восхваляя моё служение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020613
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020613,
					"content": "Кроме того, я выполнила все поручения, которые вы мне давали, первоявленная. Теперь даже вы должны признать, что я достойна звания Цветочной хранительницы, достойна Двурогого венца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020614
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020614,
					"content": "Я действительно не возражаю против выбора Хварны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020615
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020615,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020616
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020616,
					"content": "Что? Ожидала, что я буду возражать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020617
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020617,
					"content": "Нет... Я просто... не ожидала, что вы так легко согласитесь, первоявленная...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020618
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020618,
					"content": "Неужели ни малейшей придирки не будет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020619
					]
				},
				{
					"id": 737020619,
					"content": "Ах, я не такая злобная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020620
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020620,
					"content": "Об обязанностях Цветочной хранительницы... На самом деле я не получила никаких сведений от венца...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020621
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020621,
					"content": "Это потому, что я ещё не вполне достойна звания Цветочной хранительницы? Мне пока не хватает подготовки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020622
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020622,
					"content": "Титул Цветочной хранительницы может передаваться по наследству, но обязанности меняются в зависимости от требований времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020623
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020623,
					"content": "Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020624
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020624,
					"content": "Проще говоря, не существует фиксированных правил. Тем более нет конкретных стандартов оценки. Обычно выбор Хварны является окончательным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020625
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020625,
					"content": "Вы хотите сказать, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020626
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020626,
					"content": "Я не заберу у тебя Двурогий венец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020627,
						737020629
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020627,
					"content": "Больше тебе не придётся беспокоиться о том, что макушка замёрзнет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020628
					]
				},
				{
					"id": 737020628,
					"content": "Не это главное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020633,
					"content": "Знаю! Это, должно быть, также часть проверки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020634
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020634,
					"content": "Похоже, Соруш что-то поняла?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020635
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020635,
					"content": "Ты забыла, Белая Болталка. Я только что сказала! Для прохождения проверки, помимо компетентности и наблюдательности, важно осознание совершённых мною в прошлом ошибок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020636
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020636,
					"content": "Даже если исход уже предрешён, не будет ли проявлением безрассудства, если я отброшу всё, чему научилась за это время? Я думаю, что это последнее испытание первоявленной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020637
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020637,
					"content": "Для достойной Цветочной хранительницы это простое задание. Это знак вашего полного доверия ко мне, первоявленная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020638
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020638,
					"content": "Я и не ожидала, что ты видишь меня насквозь. Хварна сделала верный выбор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020639
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020639,
					"content": "#Но твои изменения... Я полагаю, что {NICKNAME} и Паймон тоже отчасти помогли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020640
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020640,
					"content": "Несомненно! Яснапати и Белая Болталка - достойные личности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020641
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020641,
					"content": "Хотя мне хотелось бы сказать, что я достаточно сильна и сама по себе... но с их помощью погасить Знамение Апаоши не составит труда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020642
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020642,
					"content": "Так надёжнее. Не забывай, что Михир и Рашну также помогут вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020643
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020643,
					"content": "Не волнуйся, первоявленная! Я справлюсь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020644
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020644,
					"content": "Паймон продолжает думать, что Зурван могла спланировать это... Но, видя радость Соруш, Паймон и возразить нечего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020629,
					"content": "Не планируешь забирать или не можешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020630
					]
				},
				{
					"id": 737020630,
					"content": "Да, как сказала сама Зурван, выбор Хварны окончателен. Это значит, что и Зурван не может его изменить, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020631
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020631,
					"content": "Ха-ха... Вы действительно так думаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020632
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020632,
					"content": "Мм... Звучит страшновато.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7370207,
			"completionStepIds": [
				7370206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370206",
							"2"
						],
						"stepId": 7370206,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Соруш",
					"Зурван"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020701,
					"content": "Пролом Туниги... эпицентр давнего бедствия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020702
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020702,
					"content": "Вот это да! Паймон не думала, что Соруш действительно сможет погасить Знамение Апаоши.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020703,
					"content": "Погасить Знамение Апаоши - это обязанность Цветочной хранительницы. Соруш лишь сделала то, что должна была сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020704
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020704,
					"content": "Всё благодаря помощи Михир и Рашну.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020705
					]
				},
				{
					"id": 737020705,
					"content": "Да. И мы тоже постарались на славу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020706,
					"content": "О, да, яснапати и Белая Болталка, а обо мне ни слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020707
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020707,
					"content": "Ух, похоже, к Соруш опять вернулось её высокомерие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020708,
					"content": "Пф. Почему вы всё ещё сомневаетесь во мне после того, как мы провели время вместе? Моя гордость никогда не была порождена слепым высокомерием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020709
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020709,
					"content": "Хм. Если хотите знать, я полностью осознаю свои прошлые ошибки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020710
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020710,
					"content": "Раньше я ставила репутацию выше действий, но теперь я поняла, что это проявление абсолютного пренебрежения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020711
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020711,
					"content": "Подобно тому, как Симург стала божественной птицей благодаря своей жертве, я стану Цветочной хранительницей благодаря своим деяниям и услышу, как моё имя воспевают, восхваляя моё служение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020712
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020712,
					"content": "Кроме того, я выполнила все поручения, которые вы мне давали, первоявленная. Теперь даже вы должны признать, что я достойна звания Цветочной хранительницы, достойна Двурогого венца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020713
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020713,
					"content": "Я действительно не возражаю против выбора Хварны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020714
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020714,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020715
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020715,
					"content": "Что? Ожидала, что я буду возражать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020716
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020716,
					"content": "Нет... Я просто... не ожидала, что вы так легко согласитесь, первоявленная...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020717
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020717,
					"content": "Неужели ни малейшей придирки не будет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020718
					]
				},
				{
					"id": 737020718,
					"content": "Ах, я не такая злобная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020719
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020719,
					"content": "Об обязанностях Цветочной хранительницы... На самом деле я не получила никаких сведений от венца...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020720
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020720,
					"content": "Это потому, что я ещё не вполне достойна звания Цветочной хранительницы? Мне пока не хватает подготовки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020721
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020721,
					"content": "Титул Цветочной хранительницы может передаваться по наследству, но обязанности меняются в зависимости от требований времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020722
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020722,
					"content": "Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020723
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020723,
					"content": "Проще говоря, не существует фиксированных правил. Тем более нет конкретных стандартов оценки. Обычно выбор Хварны является окончательным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020724
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020724,
					"content": "Вы хотите сказать, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020725
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020725,
					"content": "Я не заберу у тебя Двурогий венец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020726,
						737020728
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020726,
					"content": "Больше тебе не придётся беспокоиться о том, что макушка замёрзнет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020727
					]
				},
				{
					"id": 737020727,
					"content": "Не это главное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020732,
					"content": "Знаю! Это, должно быть, также часть проверки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020733
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020733,
					"content": "Похоже, Соруш что-то поняла?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020734
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020734,
					"content": "Ты забыла, Белая Болталка. Я только что сказала! Для прохождения проверки, помимо компетентности и наблюдательности, важно осознание совершённых мною в прошлом ошибок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020735
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020735,
					"content": "Даже если исход уже предрешён, не будет ли проявлением безрассудства, если я отброшу всё, чему научилась за это время? Я думаю, что это последнее испытание первоявленной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020736
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020736,
					"content": "Для достойной Цветочной хранительницы это простое задание. Это знак вашего полного доверия ко мне, первоявленная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020737
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020737,
					"content": "Я и не ожидала, что ты видишь меня насквозь. Хварна сделала верный выбор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020738
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020738,
					"content": "#Но твои изменения... Я полагаю, что {NICKNAME} и Паймон тоже отчасти помогли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020739
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020739,
					"content": "Несомненно! Яснапати и Белая Болталка - достойные личности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020740
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020740,
					"content": "Хотя мне хотелось бы сказать, что я достаточно сильна и сама по себе... но без их помощи мне не удалось бы погасить Знамение Апаоши.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020741
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020741,
					"content": "Кто бы мог подумать, что за столь короткое время Соруш может стать такой ответственной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020742
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020742,
					"content": "Конечно! Раз это мои обязанности, первоявленная может не волноваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020743
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737020743,
					"content": "Паймон продолжает думать, что Зурван могла спланировать это... Но, видя радость Соруш, Паймон и возразить нечего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020728,
					"content": "Не планируешь забирать или не можешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020729
					]
				},
				{
					"id": 737020729,
					"content": "Да, как сказала сама Зурван, выбор Хварны окончателен. Это значит, что и Зурван не может его изменить, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020730
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737020730,
					"content": "Ха-ха... Вы действительно так думаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020731
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737020731,
					"content": "Мм... Звучит страшновато.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}