				"points": []
			},
			"dialogs": [
				{
					"id": 4851101,
					"content": "Здесь только одна дорога. Птеродактилю больше некуда деваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4851102,
					"content": "Чтобы поймать его, нам придётся немного полетать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4851103,
					"content": "Внизу полно чудовищ. Они постараются напасть на нас сразу после взлёта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4851104,
					"content": "Если мы действительно собираемся это сделать, то нам <color=#00E1FFFF>придётся победить их всех</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4851105,
					"content": "#{NICKNAME}, тебе осталось сдать ещё один этап экзамена, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4851106,
					"content": "Да, но что это за экзамен такой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4851107,
					"content": "Этот полёт будет твоим финальным заданием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4851108,
					"content": "Ты уверена, что так можно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4851109,
					"content": "#Это уникальное задание, разработанное мной специально для тебя, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4851110,
					"content": "Разве герой Мондштадта может сдавать стандартный экзамен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4851112,
					"content": "Я сдам экзамен.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4851113,
					"content": "Я поймаю Птеродактиля.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4851111,
					"content": "#Что скажешь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4851114,
					"content": "Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4851115,
					"content": "#{NICKNAME}, готовься ко взлёту! Птеродактиль и лётная лицензия ждут тебя. Тебе нужно <color=#00E1FFFF>победить всех врагов</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				}
			]
