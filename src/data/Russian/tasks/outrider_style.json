				"objectNames": [
					"Эмбер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850801,
					"content": "Поздравляю, вот твоя лицензия! У тебя получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850802
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4850802,
					"content": "#Хотя, я в этом не сомневалась ни минуты. Ты рожд{M#ён}{F#ена} для полётов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850803,
						4850804
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4850803,
					"content": "Это было несложно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850805
					]
				},
				{
					"id": 4850805,
					"content": "Тебе обязательно надо принять участие в мондштадтском чемпионате полётов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850806
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4850806,
					"content": "Я летаю слишком быстро, никто не может поспеть за мной. Становится скучно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850807,
						4850808
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4850807,
					"content": "Отлично! Я попробую победить тебя!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850809,
					"content": "Ха! Да ты даже представить себе не можешь насколько сложный маршрут на чемпионате!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850810
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4850810,
					"content": "Желаю тебе приятных, а главное законных, полётов! А потом я утру тебе нос на чемпионате!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850811
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4850811,
					"content": "Серьёзно, соблюдай правила! Иначе тебя лишат лётной лицензии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850812
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4850812,
					"content": "Кто бы говорил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4850808,
					"content": "Против меня у тебя нет ни единого шанса, Эмбер.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850804,
					"content": "Пришлось постараться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850805
					]
				}
			]
		},
