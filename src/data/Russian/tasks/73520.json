			"dialogs": [
				{
					"id": 735200101,
					"content": "Вы решили, что хотите купить у меня информацию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200102
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735200102,
					"content": "Ну... Паймон, конечно, хотела бы получить эксклюзивную информацию, о которой ты говоришь, но сначала назови цену! Если будет слишком дорого, мы ничего не купим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735200103,
					"content": "Миллион моры - моя последняя цена!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200104
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735200104,
					"content": "Ничего себе! Забудь об этом. За такие деньги можно столько вкусняшек накупить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735200105,
					"content": "Минутку, дайте подумать... Ого! Оказывается, Паймон стала нашим тысячным клиентом сегодня! Поэтому информация стоимостью миллион моры достанется ей совершенно бесплатно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200106
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735200106,
					"content": "Ой! Вот так удача!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735200107,
					"content": "Подожди, это же не ловушка какая-то? Первое предложение - бесплатно, а дальше будет за мору... Или что-то в этом роде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735200108,
					"content": "Не хочешь - не надо. Следующий!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200109
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735200109,
					"content": "Подожди, подожди, подожди! Забудь, что сказала Паймон. Мы хотим послушать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735200110,
					"content": "Эксклюзивная информация Дори номер один! Помните «Диадему знания»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200111
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735200111,
					"content": "Паймон помнит только, что лишь чемпион имел право носить диадему. Это была весьма ценная вещица!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735200112,
					"content": "Да, диадема, которую Сачин подарил Академии, древняя и дорогая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200113
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735200113,
					"content": "И это та самая диадема, которую Академия получила в дар и умудрилась потерять!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200114
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735200114,
					"content": "Что?! Почему мы об этом не слышали раньше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735200115,
					"content": "Ха-ха... Если бы об этом все знали, то эта информация не считалась бы эксклюзивной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200116
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735200116,
					"content": "Конечно, эта информация - не пустой звук, есть очевидцы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200117
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735200117,
					"content": "В южной части города есть человек по имени Кашмер. Если вам интересно, можете спросить у него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200118
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735200118,
					"content": "Пароль... «Событие двадцатилетней давности».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дори"
				}
			]
		},
