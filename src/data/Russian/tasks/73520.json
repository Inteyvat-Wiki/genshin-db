		{
			"id": 7352032,
			"completionStepIds": [
				7352002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352002",
							"2"
						],
						"stepId": 7352002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кашмер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735200203,
					"content": "«Событие двадцатилетней давности».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200204
					]
				},
				{
					"id": 735200204,
					"content": "Похоже, мне стоит держать язык за зубами. В тот раз я немного перебрал и наговорил лишнего, а теперь у меня постоянно об этом спрашивают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200205
					],
					"speakerTitle": "Кашмер"
				},
				{
					"id": 735200205,
					"content": "Если вам так уж интересно, я расскажу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200206
					],
					"speakerTitle": "Кашмер"
				},
				{
					"id": 735200206,
					"content": "Двадцать лет назад я был всего лишь шестилетним сорванцом. Я ничего не помню о событиях тех лет. Только прочитав дневник, который я вёл в детстве, я начал кое-что смутно припоминать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200207
					],
					"speakerTitle": "Кашмер"
				},
				{
					"id": 735200207,
					"content": "В тот год проводился турнир среди даршанов, состоящий из трёх этапов, последний из которых проходил за городом. Я умолял маму отвезти меня посмотреть на турнир, а когда она отказалась, я улизнул из дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200208
					],
					"speakerTitle": "Кашмер"
				},
				{
					"id": 735200208,
					"content": "Что было дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735200209,
					"content": "Я заблудился и очутился в глуши, где не было ни единой души. Я испугался и заплакал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200210
					],
					"speakerTitle": "Кашмер"
				},
				{
					"id": 735200210,
					"content": "А потом я увидел каких-то странных существ... Я не могу вспомнить, как они выглядели. Помню лишь, что я сразу перестал плакать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200211
					],
					"speakerTitle": "Кашмер"
				},
				{
					"id": 735200211,
					"content": "Странные существа... Неужели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735200212,
					"content": "(Должно быть, это аранары.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200213
					]
				},
				{
					"id": 735200213,
					"content": "Они отвели меня к месту проведения турнира. К сожалению, я добрался туда слишком поздно, и всё уже закончилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200214
					],
					"speakerTitle": "Кашмер"
				},
				{
					"id": 735200214,
					"content": "Я так расстроился, и вдруг увидел, как одно из этих странных существ медленно тащит за собой какую-то диадему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200215
					],
					"speakerTitle": "Кашмер"
				},
				{
					"id": 735200215,
					"content": "Диадема была прекрасна. Она сияла в лунном свете. Я был не в силах сдержать себя и пошёл вслед за этим странным существом. Я видел, как оно спрятало диадему в дупле дерева, а потом исчезло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200216
					],
					"speakerTitle": "Кашмер"
				},
				{
					"id": 735200216,
					"content": "Мне так хотелось подойти и потрогать диадему. Но в тот момент вдалеке раздался голос моей мамы. Она узнала, что я сбежал, и позвала соседей в помощь, чтобы меня отыскать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200217
					],
					"speakerTitle": "Кашмер"
				},
				{
					"id": 735200217,
					"content": "Я так и не прикоснулся к этому украшению. Лишь повзрослев, я увидел Диадему знания на Турнире даршанов и понял, что это та самая диадема.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200218
					],
					"speakerTitle": "Кашмер"
				},
				{
					"id": 735200218,
					"content": "А ты помнишь, где эту диадему тогда спрятали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735200219,
					"content": "Кажется, это был лес Авидья. Я приходил туда несколько раз, чтобы её отыскать, но ничего не нашёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200220
					],
					"speakerTitle": "Кашмер"
				},
				{
					"id": 735200220,
					"content": "Впрочем, всё равно мне никто не верит. Ведь я и сам не могу вспомнить подробностей. Возможно, это был всего лишь детский сон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200221
					],
					"speakerTitle": "Кашмер"
				},
				{
					"id": 735200221,
					"content": "#Хм... {NICKNAME}, может, пойдём поищем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
