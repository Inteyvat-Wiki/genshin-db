				]
			},
			"dialogs": [
				{
					"id": 735200301,
					"content": "Здесь как раз есть дупло... Но внутри совсем ничего нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735200302,
					"content": "Что? Кажется, здесь какая-то записка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735200303,
					"content": "«Аракасапа научился грамоте у нары, Аракасапа всегда будет помогать наре...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735200304,
					"content": "Что бы это значило?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
