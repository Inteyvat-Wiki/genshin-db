			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бэй Доу",
					"Нин Гуан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080101,
					"content": "#Эй, {NICKNAME}, вот так совпадение. Присядешь с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080102
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080102,
					"content": "Какой приятный сюрприз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080103
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080103,
					"content": "Что вы тут делаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080104
					]
				},
				{
					"id": 705080104,
					"content": "Стойте, а вы что, вместе пришли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705080105,
					"content": "Эта дама вдруг решила, что ей нужен отпуск, и мы отправились в путешествие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080106
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080106,
					"content": "Но, видимо, у нас слишком разные представления об отдыхе. И нескольких горных пиков не одолели, а уже прохлаждаемся тут. Вот так избалованность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080107
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080107,
					"content": "Твои слова ранят в самое сердце. А между прочим, я специально привела тебя сюда, потому что знаю, как ты любишь выпить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080108
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080108,
					"content": "Но наш капитан повидала весь свет, и маленькой таверной её не удивишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080109
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080109,
					"content": "Сойдёт. Сегодня пьём за мой счёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080110
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080110,
					"content": "Бэй Доу платит? А за нас тоже?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705080111,
					"content": "Мы бармены, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080112
					]
				},
				{
					"id": 705080112,
					"content": "Ах да. Хи-хи, извини... я по привычке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705080113,
					"content": "Что предпочитают две милые леди?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080114
					]
				},
				{
					"id": 705080114,
					"content": "Маленький Берёзовый сок, и покислее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080115
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080115,
					"content": "Большую Вечернюю мглу. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080116
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080116,
					"content": "Ясно. Мигом сделаем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7050802,
			"completionStepIds": [
				7050804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
