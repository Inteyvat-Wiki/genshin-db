				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нин Гуан",
					"Бэй Доу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080201,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080202
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080203
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080203,
					"content": "Ну? Как? Ваше молчание нервирует Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705080204,
					"content": "М-м-м... Сладко-горький вкус ностальгии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080205
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080205,
					"content": "Ты имеешь в виду вкус смены лохмотьев на роскошь? Что же это за вкус такой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080206
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080206,
					"content": "Хе-хе... Он такой кислый, с лёгким оттенком сладости и долгим послевкусием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080207
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080207,
					"content": "Интересно... Похоже ли это на то, когда ты начинаешь маленькое дело, а потом понимаешь, что продажа фруктов не приносит денег?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080208
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080208,
					"content": "Давай без подробностей. Прошлому место в прошлом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080209
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080209,
					"content": "Ха-ха, кто бы мог вообразить, что величественная Воля Небес когда-то продавала фрукты на улицах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080210
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080210,
					"content": "С другой стороны, держу пари, по мне никто не скажет, что я из обычной рыбацкой деревушки, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080211
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080211,
					"content": "Ну как же. Если бы спросили меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080212
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080212,
					"content": "Я бы сказала, что у капитана Бэй Доу глаза, способные пронзить море. Ты первопроходец, ищущий приключений, та, кто укрощает ветер и волны... А это явно говорит о том, что ты выросла у моря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080213
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080213,
					"content": "Эй, ты ведь не насмехаешься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080214
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080214,
					"content": "Ну что ты, сарказм ни к чему хорошему не приводит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080215
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080215,
					"content": "Мне ли не знать, как ты остра на язык. Сегодня я угощаю, так что полегче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080216
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080216,
					"content": "Ну хорошо, тогда я закажу ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080217,
						705080218
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080217,
					"content": "Ещё один напиток для милой госпожи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080218,
					"content": "Мы к вашим услугам!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080219,
					"content": "За работу, бармен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705080220,
					"content": "Мне нравится ваш энтузиазм! Налей-ка ещё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080221
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080234,
					"content": "...вы тут же подаёте им следующую порцию...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 705080221,
					"content": "Нет ничего лучше свежего фруктового сока Мондштадта. Вот бы каждый день так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080222
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080222,
					"content": "Серьёзно? Только не говори, что ты собираешься открыть торговый путь по продаже закатников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080223
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080223,
					"content": "Хм, звучит заманчиво.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080224
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080224,
					"content": "Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080225
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080225,
					"content": "Шучу, конечно. Торговля ими уже процветает вовсю. Мне не нужно прокладывать никакие пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080226
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080226,
					"content": "#Спасибо за напитки, {NICKNAME}. Если тебе когда-нибудь захочется непыльной работёнки - буду рада видеть тебя личным барменом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080227
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080227,
					"content": "А мы будем рады тебе на борту Алькора. Команда обожает выпивку. Закатим такую пирушку - век не забудешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080228
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 705080228,
					"content": "#Капитан Бэй Доу, ты пытаешься увести у меня работника? В этом нет необходимости. Ты всегда можешь посетить Нефритовый дворец и отведать напитков путешественни{F#цы}{M#ка}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080229
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 705080229,
					"content": "(А моя популярность растёт!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080230
					]
				},
				{
					"id": 705080230,
					"content": "Паймон только кажется, или они тебя считают своей собственностью?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080231,
						705080232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705080231,
					"content": "Если у меня будет возможность...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705080232,
					"content": "...я навещу вас обеих. Честное слово.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}