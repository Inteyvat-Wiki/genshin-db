				"points": []
			},
			"dialogs": [
				{
					"id": 705310101,
					"content": "Пожалуйста, подождите! Вы прибыли, чтобы принять участие в Гран-при Короля священного призыва?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310102
					],
					"speakerTitle": "Оннеа"
				},
				{
					"id": 705310102,
					"content": "Если есть минутка, я бы хотела посвятить вас в подробности события, которое проводит Гильдия искателей приключений. Оно называется «Путешествие по чудесам».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310103,
						705310104
					],
					"speakerTitle": "Оннеа"
				},
				{
					"id": 705310103,
					"content": "#Я... Да, {F#свободна}{M#свободен}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				},
				{
					"id": 705310105,
					"content": "Спасибо! Тогда я сразу перейду к основным правилам этого события.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310106
					],
					"speakerTitle": "Оннеа"
				},
				{
					"id": 705310106,
					"content": "В общем, Гильдия искателей приключений разместила несколько смотровых площадок по всему Мондштадту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310107
					],
					"speakerTitle": "Оннеа"
				},
				{
					"id": 705310107,
					"content": "Всё, что вам нужно сделать, - найти эти площадки и поставить памятную печать в блокноте туриста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310108
					],
					"speakerTitle": "Оннеа"
				},
				{
					"id": 705310108,
					"content": "Задание будет считаться выполненным, когда вы проставите все печати на всех смотровых площадках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310109
					],
					"speakerTitle": "Оннеа"
				},
				{
					"id": 705310109,
					"content": "Это событие... вполне в стиле Гильдии искателей приключений...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310110
					]
				},
				{
					"id": 705310110,
					"content": "Хе-хе... Мы хорошо продумали расположение смотровых площадок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310111
					],
					"speakerTitle": "Оннеа"
				},
				{
					"id": 705310111,
					"content": "Хотя... некоторые из них находятся в отдалении, и поблизости могут быть монстры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310112
					],
					"speakerTitle": "Оннеа"
				},
				{
					"id": 705310112,
					"content": "Я нисколько не сомневаюсь, что ваши навыки позволят вам без труда справиться с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310113
					],
					"speakerTitle": "Оннеа"
				},
				{
					"id": 705310113,
					"content": "Позвольте сразу отдать вам блокнот туриста. Желаю повеселиться от души!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Оннеа"
				},
				{
					"id": 705310104,
					"content": "Ладно, говори...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				}
			]
		}
	]
}