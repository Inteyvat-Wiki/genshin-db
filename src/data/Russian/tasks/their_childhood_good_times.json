						"stepId": 2400604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лави"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060401,
					"content": "Интересно, сможет ли Орель разобраться со своими мыслями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060402
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240060402,
					"content": "#Ого! Ты {M#нашёл}{F#нашла} это место! В самом деле, как долго ты играешь в прятки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060403
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240060403,
					"content": "Я вернусь к условленному месту. В следующий раз спрячусь получше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лави"
				}
			]
		},
		{
			"id": 2400606,
