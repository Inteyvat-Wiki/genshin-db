			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Верут",
					"Лави",
					"Орель"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060101,
					"content": "Теперь моя очередь ловить... Я тебя поймаю, Лави!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060102
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240060102,
					"content": "Рано радуешься! Есть такие места, куда и тебе не забраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060103
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240060103,
					"content": "Ну, это потому что у меня обувь неподходящая. Если я переобуюсь, то легко тебя достану!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060104
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240060104,
					"content": "Тогда давай мы оба разуемся, чтобы было честно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060105
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240060105,
					"content": "Эй, нельзя бегать босиком. Мало ли что на земле валяется. Вдруг порежетесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060106
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240060106,
					"content": "Хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060107
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240060107,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060108
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240060108,
					"content": "Хм, братец, когда ты пытался меня догнать, то тебя что-то отвлекло, так? Я мимо пробежал, а ты даже не обратил внимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060109
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240060109,
					"content": "А? В самом деле? Я не заметил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060110
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240060110,
					"content": "Вот-вот! Я целый круг оббежала, а ты вообще меня не видел!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060111
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240060111,
					"content": "#Но... Что? {M#Братец}{F#Сестрица}, что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060112,
						240060115
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240060112,
					"content": "Почему Лави здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060113
					]
				},
				{
					"id": 240060113,
					"content": "Папа сказал, что ему нужно по делам. И мама тоже работает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060114
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240060114,
					"content": "Орель заходил, чтобы вернуть книгу, и папа попросил посидеть со мной. Вот я и пришла поиграть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240060118,
					"content": "Но хватит об этом, давайте играть. Кто теперь будет искать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060119,
						240060120
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240060119,
					"content": "#Я думал{F#а}, что вы уже не играете в прятки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060121,
					"content": "Ну, кхм... Я пытался написать критический отзыв, и у меня появились вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060122
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240060122,
					"content": "Выяснилось, что мне лучше размышляется во время физической активности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060123
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240060123,
					"content": "Но иногда он так уходит в свои мысли, что может просто стоять и разговаривать сам с собой, никого вокруг не замечая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060124
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240060124,
					"content": "Хочешь поиграть с нами? У тебя получается куда лучше, чем у моего брата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060125,
						240060126
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240060125,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060127,
					"content": "Ха-ха, прятки - это наш конёк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060128
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240060128,
					"content": "Тогда начнём. Побежали, Лави! Нужно хорошенько спрятаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060129
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240060129,
					"content": "Лави и Верут убегают, а Орель в задумчивости уходит...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240060126,
					"content": "Вам придётся несладко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060120,
					"content": "Откуда снова любовь к пряткам?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060115,
					"content": "Опять в прятки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060116
					]
				},
				{
					"id": 240060116,
					"content": "Да. Господин Делерю отправился по делам, тётушке Дюмэ тоже нужно работать. Поэтому они попросили меня побыть с Лави.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060117
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240060117,
					"content": "Вот я и привёл её сюда, чтобы поиграть... Надеюсь, она не перепачкается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Орель"
				}
			]
		},
		{
			"id": 2400602,
			"completionStepIds": [
				2400602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
