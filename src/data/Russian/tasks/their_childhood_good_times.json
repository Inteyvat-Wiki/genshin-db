			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Верут"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060201,
					"content": "#{M#Нашёл меня, братец}{F#Нашла меня, сестрица}. Ты и правда играешь лучше меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240060202,
					"content": "Пойду к условленному месту. Надеюсь, мой брат спрятался получше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240060203,
					"content": "Почему ты на это надеешься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "Он ведь сам сказал, что его мозги после пряток шевелятся гораздо лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240060205,
					"content": "Но у него слишком много мыслей, так что ему приходится подолгу сидеть на земле и вспоминать их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240060206,
					"content": "Лави сказала, что его идеи - очень ценная вещь и что беспокоить его нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240060207,
					"content": "Вот потому мы с ним и играем. Даже если мы быстро его находим, то всё равно стараемся потянуть время, пока он не закончит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240060208,
					"content": "Потому что если братец будет искать нас, то ждать его придётся очень-очень долго...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верут"
				}
			]
		},
		{
			"id": 2400603,
			"completionStepIds": [
				2400603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400603",
							"2"
						],
						"stepId": 2400603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Орель"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060301,
					"content": "Нет... Эта логическая цепочка здесь не подходит. Нужно посмотреть на задачу с другой стороны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060302
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240060302,
					"content": "А что если... Нет, не так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060303
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240060303,
					"content": "А? Ой, вы меня нашли. Пойду обратно к условленному месту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060304
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240060304,
					"content": "Верен ли этот взгляд? Нет... А может быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Орель"
				}
			]
		},
		{
			"id": 2400604,
			"completionStepIds": [
				2400604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400604",
							"2"
