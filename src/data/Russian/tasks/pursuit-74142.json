						],
						"pointId": 6837
					}
				]
			},
			"dialogs": [
				{
					"id": 741420701,
					"content": "#А! Это же {NICKNAME}! Эй, а где же Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420702
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741420702,
					"content": "Куда это ты смотришь? На расщелину?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420703
					]
				},
				{
					"id": 741420703,
					"content": "Какую расщелину? Разве это не зеркало?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420704
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741420704,
					"content": "Что ж, раз так, я нашла то, что искала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420705
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741420705,
					"content": "Я искала разгадку для тайного зеркала... Это что-то вроде картины. Оно позволяет медитировать так же, как Книга Откровения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420706
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741420706,
					"content": "Расскажи о рисунке Четырёх ортантов и картине в Башне гештальта.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420707
					]
				},
				{
					"id": 741420707,
					"content": "#Вот как. Значит, это там. Да! Спасибо, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Канотила"
				}
			]
		},
