						],
						"pointId": 6836
					}
				]
			},
			"dialogs": [
				{
					"id": 741420401,
					"content": "#А, {NICKNAME}... мы ведь только что виделись, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420402
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741420402,
					"content": "Когда это было?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420403
					]
				},
				{
					"id": 741420403,
					"content": "Ну, точно не скажу... в конце концов, здесь время течёт совсем по-другому!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420404
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741420404,
					"content": "Канотила, пойдём со мной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420405
					]
				},
				{
					"id": 741420405,
					"content": "Странное здесь место.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420406
					]
				},
				{
					"id": 741420406,
					"content": "Разве не нам решать, что для нас странно, а что нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420407
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741420407,
					"content": "Ну... я ничего такого не имею в виду, но мне здесь очень даже нравится. Это место так и пестрит жизнью и красками. Никогда ничего подобного не видела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420408
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741420408,
					"content": "Я вижу только подсолнух...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420409
					]
				},
				{
					"id": 741420409,
					"content": "Правда? Ого! Где?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420410
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741420410,
					"content": "Там, где до этого собака была.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420411
					]
				},
				{
					"id": 741420411,
					"content": "Ага! Тогда я пойду первая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420412
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741420412,
					"content": "Погодите-ка...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7414207,
