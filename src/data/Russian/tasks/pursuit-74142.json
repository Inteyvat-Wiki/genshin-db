			},
			"dialogs": [
				{
					"id": 741421401,
					"content": "Ого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741421402,
					"content": "Паймон, я...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421403
					]
				},
				{
					"id": 741421403,
					"content": "В этот раз ты очень быстро! Паймон даже моргнуть не успела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741421404,
					"content": "Это хорошо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421405
					]
				},
				{
					"id": 741421405,
					"content": "#А вот и виновница вернулась. Канотила, {NICKNAME} за тебя {F#волновалась}{M#волновался}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741421406,
					"content": "Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421407
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741421407,
					"content": "*всхлипывает* Простите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421408
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741421408,
					"content": "Ох... Паймон ведь тебя ни в чём не обвиняет! Канотила, не плачь. Сейчас Паймон тебе что-нибудь вкусненькое даст...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741421409,
					"content": "(Что случилось?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741421410,
					"content": "(Внутри было множество опасностей.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421411
					]
				},
				{
					"id": 741421411,
					"content": "(Вот как...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741421412,
					"content": "Не плачь, не плачь. Ты же такая смелая, Канотила! Вот, Канотила, держи в награду куриный шашлычок с грибами! Паймон его обожает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741421413,
					"content": "*плачет* Спасибо, Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421414
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741421414,
					"content": "*жуёт*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421415
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741421415,
					"content": "Ой, какой странный вкус. Это что, человеческая еда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421416
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741421416,
					"content": "Чего?! Раз не нравится, давай обратно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741421417,
					"content": "#Но... всё равно спасибо, Паймон. И тебе спасибо, {NICKNAME}, за то, что спас{F#ла} меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421418
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741421418,
					"content": "Что теперь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421419
					]
				},
				{
					"id": 741421419,
					"content": "Не знаю. Но читать я больше ничего не буду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421420
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741421420,
					"content": "Канотила, а не слишком ли ты ударяешься в крайности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741421421,
					"content": "Но Книга Откровения такая страшная...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421422
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741421422,
					"content": "(Что же там всё-таки произошло?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741421423,
					"content": "#(Сам{F#а} не знаю...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421424,
						741421425
					]
				},
				{
					"id": 741421424,
					"content": "(Можешь сходить, посмотреть.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				},
				{
					"id": 741421426,
					"content": "(Что?! Как же бесит...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741421427,
					"content": "В общем, здесь я оставаться точно не хочу. Буду жить в деревне Меруси вместе со всеми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421428
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741421428,
					"content": "Вот и правильно! Мелюзины уж точно о тебе хорошо позаботятся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421429
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741421429,
					"content": "#Угу. Спасибо, {NICKNAME} и Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741421425,
					"content": "(Хорошо, что тебя там не было.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				}
			]
		},
