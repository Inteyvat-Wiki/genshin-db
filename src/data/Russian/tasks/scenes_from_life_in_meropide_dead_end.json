					"Гальварет"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740300101,
					"content": "Здравствуйте, что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300102,
						740300105
					],
					"speakerTitle": "Гальварет"
				},
				{
					"id": 740300102,
					"content": "Госпожа добрая волшебница, помоги нам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300103
					]
				},
				{
					"id": 740300103,
					"content": "#С чего это ты заговорил{F#а}, как Лануар? Просто переходи к делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300104
					],
					"speakerTitle": "Гальварет"
				},
				{
					"id": 740300104,
					"content": "Нам нужны купоны! Может, у тебя есть ли какая-нибудь работа, которую мы могли бы выполнить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740300107,
					"content": "Вы что, присоединились к игре Этьена? Во всякой забаве должна быть своя мера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300108
					],
					"speakerTitle": "Гальварет"
				},
				{
					"id": 740300108,
					"content": "...Тем не менее я действительно хотела бы попросить вас кое о чём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300109
					],
					"speakerTitle": "Гальварет"
				},
				{
					"id": 740300109,
					"content": "Клайнс сейчас как раз должен быть в Эрозийном разломе и ремонтировать там какое-то своё устройство... Отправляйтесь к нему и помогите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300110
					],
					"speakerTitle": "Гальварет"
				},
				{
					"id": 740300110,
					"content": "Что насчёт вознаграждения, то можете обговорить это с ним. Он точно не откажет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300111
					],
					"speakerTitle": "Гальварет"
				},
				{
					"id": 740300111,
					"content": "Отлично, мы всё сделаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740300105,
					"content": "Можем ли мы помочь с каким-нибудь делом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300106
					]
				},
				{
					"id": 740300106,
					"content": "Желательно за вознаграждение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7403002,
			"completionStepIds": [
				7403002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
