							4373.582,
							184.163,
							4784.226
						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300201,
					"content": "Вы как раз вовремя, мне нужна помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300202,
						740300206
					],
					"speakerTitle": "Клайнс"
				},
				{
					"id": 740300202,
					"content": "Ты умеешь читать мысли? Жутковато.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300203
					]
				},
				{
					"id": 740300203,
					"content": "Гальварет и правда отправила нас тебе помочь... но откуда ты об этом знаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740300204,
					"content": "А? Ну просто, кроме вас, тут помочь некому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300205
					],
					"speakerTitle": "Клайнс"
				},
				{
					"id": 740300205,
					"content": "...Тоже верно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740300210,
					"content": "В любом случае здесь нет ничего сложного. Для работы с исследовательским терминалом потребуются два человека одновременно. Я уже ввёл точные инструкции, так что просто идите туда и потяните за рычаг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300211
					],
					"speakerTitle": "Клайнс"
				},
				{
					"id": 740300211,
					"content": "Чуть не забыл... Где-то рядом должен быть накопитель энергии, установите его перед включением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300212
					],
					"speakerTitle": "Клайнс"
				},
				{
					"id": 740300212,
					"content": "И ещё... вы же, ребята, не какие-нибудь там убийцы машин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300213,
						740300214
					],
					"speakerTitle": "Клайнс"
				},
				{
					"id": 740300213,
					"content": "Смотря что под этим имеется в виду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300215,
					"content": "С чего вдруг такой вопрос?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740300216,
					"content": "Ранее я уже просил Гальвану помочь мне с работой, но стоило только отвести от неё взгляд, как исследовательский терминал сразу вышел из строя. Сколько бы я её ни расспрашивал, ничего толкового она ответить не смогла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300217
					],
					"speakerTitle": "Клайнс"
				},
				{
					"id": 740300217,
					"content": "Позже от её сестры я узнал, что ни одно механическое творение не выдерживает в её руках и полдня. Думаю, даже сам Ален Гильотен не сдержал бы эмоций при встрече с ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300218
					],
					"speakerTitle": "Клайнс"
				},
				{
					"id": 740300218,
					"content": "В тот раз мне самому пришлось возмещать стоимость ремонта... Если вы такие же, как она, то моя работа опять пропадёт, и я же ещё останусь должен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300219
					],
					"speakerTitle": "Клайнс"
				},
				{
					"id": 740300219,
					"content": "С трудом верится, что такое бывает... Эта история явно не про нас, можешь на нас положиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740300220,
					"content": "Хорошо, тогда рассчитываю на вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Клайнс"
				},
				{
					"id": 740300214,
					"content": "Если исследовательский терминал меня атакует, то вполне себе могу стать убийцей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300206,
					"content": "Но наша помощь будет не бесплатной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300207
					]
				},
				{
					"id": 740300207,
					"content": "Я попрошу Гальварет выписать вам вознаграждение позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300208
					],
					"speakerTitle": "Клайнс"
				},
				{
					"id": 740300208,
					"content": "А? Она сказала, что вознаграждение выдашь ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740300209,
					"content": "Она так сказала? Ну хорошо. А здесь добиться получения средств ещё сложнее, чем в Исследовательском институте Фонтейна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Клайнс"
				}
			]
		},
