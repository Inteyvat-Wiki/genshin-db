				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110601,
					"content": "#{NICKNAME}, мне кажется, я кое-что понял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110602
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110602,
					"content": "Можно попросить тебя глянуть в детектор нирнама?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110603
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110603,
					"content": "Что??? У Стэнли тоже есть воображаемый друг?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101110604,
					"content": "Его воображаемый друг похож на опытного воина, покрытого шрамами с ног до головы... И с лицом, полным решимости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110605,
						101110608
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110605,
					"content": "Таким Стэнли описывает себя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110606
					]
				},
				{
					"id": 101110606,
					"content": "Хочешь сказать, что опытный воин - это тот, кем он хочет видеть себя в будущем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110607
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110607,
					"content": "Интересное предположение. Но так ли это на самом деле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110611,
					"content": "Простите меня, но теперь я должен покинуть вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110612
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101110612,
					"content": "До свидания, мистер Стэнли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110613
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110613,
					"content": "Ребят, а у вас... не найдётся времени мне помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110614
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110614,
					"content": "С чем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110615
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110615,
					"content": "Пару дней назад Стэнли напился и рассказал мне кое-что, что он никому не рассказывал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110616
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110616,
					"content": "О легендарном оружии, которое он брал с собой в походы все те годы назад... Это было оружие великой героини Мондштадта, самой Веннессы! <color=#00E1FFFF>Меч ослепительной доблести</color> и <color=#00E1FFFF>Щит сияющей воли</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110617
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110617,
					"content": "Не знаю, верите ли вы, но... Он сказал, что эти меч и щит до сих пор лежат здесь, в Мондштадте! В <color=#00E1FFFF>ущелье Дадаупа</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110618
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110618,
					"content": "Вы ведь тоже опытные путешественники? Не могли бы вы помочь мне восстановить эти две легендарные вещи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110619,
						101110621
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110619,
					"content": "У него правда было такое оружие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110620
					]
				},
				{
					"id": 101110620,
					"content": "Конечно! Это ведь легендарный мистер Стэнли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110623,
					"content": "Если я смогу впечатлить свою семью этим оружием, то, надеюсь, они наконец поймут, что я готов быть настоящим искателем приключений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110624
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110624,
					"content": "А сам я не могу пойти искать оружие, ведь я всего лишь новичок. Я ничего не умею, а мои родители не хотят поддерживать мои стремления...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110625
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110625,
					"content": "Что скажете? Поможете бедняге?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110626
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110626,
					"content": "Я боюсь просить мистера Стэнли, потому что мои амбиции так трусливы... Но я обещаю, что верну ему оружие, как только всё сделаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110627
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110627,
					"content": "Ох, бедный Джек... Давайте ему поможем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110628,
						101110629
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101110628,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110630,
					"content": "Венти, ты пойдёшь с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110631
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101110631,
					"content": "Ммм... Я не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110632
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110632,
					"content": "Ох, точно! Пару лет назад кто-то подарил мне бутылку раритетного винтажного вина. Помогите найти оружие, и она ваша!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110633
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110633,
					"content": "<color=#00E1FFFF>Ущелье Дадаупа</color>, говоришь? Поспешим, нам нельзя терять ни минуты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110629,
					"content": "Тяжело отказать после такой истории.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110621,
					"content": "Зачем он оставил такое оружие не пойми где?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110622
					]
				},
				{
					"id": 101110622,
					"content": "Не знаю, у выдающихся личностей всегда есть какие-то свои странности, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110608,
					"content": "#Я подозревал{F#а} что-то неладное...",
