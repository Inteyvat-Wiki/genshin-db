		},
		{
			"id": 1011104,
			"completionStepIds": [
				1011104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011104",
							"2"
						],
						"stepId": 1011104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Стэнли",
					"Джек"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110401,
					"content": "Фух... Фух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110402
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101110402,
					"content": "Я был уверен, что мне конец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110403
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110403,
					"content": "Вам чудом удалось спастись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110404
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110404,
					"content": "А ты, предполагаю, искатель приключений Джек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110405
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110405,
					"content": "Да... А вы кто такие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110406
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110406,
					"content": "Мы пришли за тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101110407,
					"content": "Айлин попросила нас передать тебе сообщение. Сегодня она вместе с тобой обсудить план приключений не сможет, и присоединится к тебе в другой день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110408
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110408,
					"content": "Ох, понятно... Мне очень жаль, что вы проделали весь этот путь, чтобы найти меня, да и ещё пришлось меня спасать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110409
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101110409,
					"content": "А? Пустяки! Ничего такого, с чем бы не справился я, Стэнли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110410
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101110410,
					"content": "Ого, так это ты тот самый Стэнли, что бывал в Пепельном море и рассказывает об этом всему Мондштадту?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101110411,
					"content": "Вы совершенно правы! Я и есть тот самый Стэнли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110412
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101110412,
					"content": "Ха-ха-ха! Должен признать, это большая честь встретиться с такой легендарной личностью, как вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110413
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110413,
					"content": "Ну что ж, надо решить, идём ли мы дальше или поворачиваем назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110414,
						101110417
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110414,
					"content": "Что думает мистер Стэнли?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110415
					]
				},
				{
					"id": 101110415,
					"content": "Ха-ха, теперь вы в безопасности, ведь с вами оказался великий искатель приключений и сама легенда Мондштадта Стэнли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110416
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101110416,
					"content": "Поэтому нам незачем поворачивать назад!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101110419,
					"content": "Единогласно... Тогда двигаемся вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				},
				{
					"id": 101110417,
					"content": "Что думает Джек?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110418
					]
				},
				{
					"id": 101110418,
					"content": "Я считаю, что нам нужно идти дальше. Стэнли с нами, а значит, у нас не будет проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Джек"
				}
			]
		},
		{
			"id": 1011106,
			"completionStepIds": [
				1011106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011106",
