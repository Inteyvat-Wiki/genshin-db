			"dialogs": [
				{
					"id": 3071101,
					"content": "А вот и ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071102
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071102,
					"content": "Подойди поближе. Ты чувствуешь этот запах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071103,
						3071104
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071103,
					"content": "Я ничего не чувствую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				},
				{
					"id": 3071105,
					"content": "Этот <color=#00E1FFFF>храм</color> выглядит не таким уж и заброшенным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071106
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071106,
					"content": "Там, должно быть, слаймы, хиличурлы, и что-то, что подпитывает дракона...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071107
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071107,
					"content": "О, да... Там должно быть весело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071108,
						3071110
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071108,
					"content": "Там опасно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071109
					]
				},
				{
					"id": 3071109,
					"content": "Вряд ли. Скорее весело, чем опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071112,
					"content": "Жаль, что храм Волка Севера находится в таком состоянии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071113
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071113,
					"content": "#Пойдём, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071114
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071114,
					"content": "Уже давно никто не делает подношения Хранителям четырёх ветров, но ветра по-прежнему с нами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071115
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071115,
					"content": "Сейчас настало время навести порядок в храмах Хранителей четырёх ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071110,
					"content": "Самые обычные монстры.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071111
					]
				},
				{
					"id": 3071111,
					"content": "Ого! Да у нас тут храбрец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071104,
					"content": "Пахнет горелыми слаймами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				}
			]
		},
