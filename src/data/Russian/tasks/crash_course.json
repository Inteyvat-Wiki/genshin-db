			"dialogs": [
				{
					"id": 3071501,
					"content": "Браво!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071502
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071502,
					"content": "Кто бы мог подумать, что ты такой хороший боец?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071503
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071503,
					"content": "Наблюдать за тобой в храме было сплошное удовольствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071504,
						3071505
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071504,
					"content": "Спасибо. Мне приятно это слышать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				},
				{
					"id": 3071506,
					"content": "Ха-ха! Скромность, достойная рыцаря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071507
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071507,
					"content": "Спасённый Мондштадт будет слагать легенды о твоих подвигах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071508
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071508,
					"content": "Если у тебя найдётся время, найди меня в штабе Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071509
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071509,
					"content": "Или мы можем встретиться в одной отличной таверне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3071505,
					"content": "Ты преувеличиваешь.",
