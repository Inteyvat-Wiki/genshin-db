	"talks": [
		{
			"id": 2300302,
			"completionStepIds": [
				2300302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300302",
							"2"
						],
						"stepId": 2300302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хатим"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030201,
					"content": "#Путешественни{F#ца}{M#к}! Нет, посланни{F#ца}{M#к} богатства, моя путеводная звезда! Вот и ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030202
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030202,
					"content": "#Съев «золотое блюдо», которое ты приготовил{F#а}, я одерживал на Бирже победу за победой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030203
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030203,
					"content": "Все фьючерсы, которые я купил, оказались очень и очень прибыльными!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030204
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030204,
					"content": "Идём со мной! Я отведу вас в таверну Ламбада, выбирайте всё, что пожелаете! Хочу как следует вас отблагодарить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хатим"
				}
			]
		},
		{
			"id": 2300304,
			"completionStepIds": [
				2300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300303",
							"2"
						],
						"stepId": 2300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хатим"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030401,
					"content": "Без вашей помощи ничего бы не вышло! Так что заказывайте всё, что душе угодно, ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030402
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030402,
					"content": "Видно, ты в самом деле разжился большими деньгами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230030403,
					"content": "Да, для обычного человека это большие деньги, но для богача Хатима - так, ерунда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030404
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030404,
					"content": "Всё-таки я уже несколько десятков лет играю на бирже, изучил её вдоль и поперёк. Если вам тоже интересны фьючерсы, могу поделиться кое-какими соображениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030405
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030405,
					"content": "В прошлый раз мы условились, что если я получу прибыль, вас будет ждать дополнительное вознаграждение. Так что не стесняйтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030406
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030406,
					"content": "Так вот о каком вознаграждении ты говорил? Кажется, толку от него будет маловато.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230030407,
					"content": "Всё равно мы не играем на бирже...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030408
					]
				},
				{
					"id": 230030408,
					"content": "Чепуха! Конечно, мора вам тоже достанется, но советы Хатима - куда более ценный актив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030409
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030409,
					"content": "Тогда Паймон хочет спросить... Правда ли есть фьючерсы на слаймы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230030410,
					"content": "Нет, Паймон не будет покупать фьючерсы! Просто хотелось спросить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230030411,
					"content": "Фьючерсные сделки распространяются только на оборотные товары. Иными словами, если бы слаймовой слизи на рынке было так же много, как молока или муки, тогда она тоже была бы предметом фьючерсных сделок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030412
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030412,
					"content": "Но об этом мы уже говорили. Если торговать фьючерсами на слаймовую слизь, боюсь, диких слаймов скоро совсем не останется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030413
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030413,
					"content": "И наверняка появятся люди или целые компании, которые будут выращивать слаймы, чтобы непрерывно поставлять большие партии слаймовой слизи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030414
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030414,
					"content": "И цена на слаймовую слизь тогда возрастёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030415
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030415,
					"content": "Что? Паймон просто хотела купить немного слаймовой слизи, откуда столько сложностей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230030416,
					"content": "#Лучше... Лучше пусть {NICKNAME} просто раздобудет для Паймон парочку слаймов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230030417,
					"content": "#А ты, посланни{F#ца}{M#к} богатства, хочешь задать какой-нибудь вопрос?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030418
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030418,
					"content": "Как тебе пришла в голову идея о «золотом блюде»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030419
					]
				},
				{
					"id": 230030419,
					"content": "#Ха! Не зря я назвал тебя посланни{F#цей}{M#ком} богатства, твой вопрос попал в самое яблочко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030420
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030420,
					"content": "Нельзя сказать, что эта идея «пришла мне в голову»... Просто я очень давно играю на фьючерсной бирже и однажды заметил такую закономерность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030421
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030421,
					"content": "Хотя фьючерсный рынок весьма изменчив, но «золотые блюда» всегда помогают мне цепко держаться за штурвал корабля инвестиций!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030422,
						230030423
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030422,
					"content": "Значит, всё-таки суеверия...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				},
				{
					"id": 230030424,
					"content": "Ну, довольно разговоров! Прошу, угощайтесь! Не стесняйтесь, я ещё не раз прибегну к вашей помощи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030425
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030425,
					"content": "Возьмите эту шаурму! Одно из фирменных блюд Сумеру, его должен попробовать каждый, ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030426
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030426,
					"content": "Вы вкусно поели с Хатимом...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230030423,
					"content": "Кажется, ты просто принимаешь желаемое за действительное...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				}
			]
		},
		{
			"id": 2300307,
			"completionStepIds": [
				2300307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300307",
							"2"
						],
						"stepId": 2300307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хатим"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030701,
					"content": "Ведь я всё сделал правильно: съел «золотое блюдо» прямо в «Обители богатства»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030702
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030702,
					"content": "И что в итоге... Это не укладывается ни в какие рамки! Неужели этому рынку никакие правила не писаны?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030703
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030703,
					"content": "Хатим, мы так долго тебя искали. Всё в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230030704,
					"content": "Это вы... Я... Я в порядке... Всё хорошо. Видите, я цел, руки и ноги на месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030705
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030705,
					"content": "Просто лишился всей маржи, только и всего... Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030706
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030706,
					"content": "Ой. Извини...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030707
					]
				},
				{
					"id": 230030707,
					"content": "Нет, это не твоя вина! Не бери в голову.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030708
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030708,
					"content": "Конечно, это и не моя вина. Если кого и винить, то только прогнивший рынок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030709
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030709,
					"content": "Это абсурдно! Никакие правила не работают! Цены берут и валятся вниз, а потом берут и... И не поднимаются...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030710
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030710,
					"content": "Ох, я даже не знаю, как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030711
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030711,
					"content": "Ладно, пустое, не может такого быть... Я богатейший богач Хатим из Калими, и однажды фьючерсный рынок покорится мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030712
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030712,
					"content": "Ты ведь уже разорился...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030713
					]
				},
				{
					"id": 230030713,
					"content": "А, это не беда, у меня есть ещё резервный капитал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030714
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030714,
					"content": "И даже если я потеряю все наличные моры, у меня всё равно останется оборотный капитал и разные активы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030715
					],
					"speakerTitle": "Хатим"
				},
				{
					"id": 230030715,
					"content": "Жди, биржа Калими! Хатим ещё вернётся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хатим"
				}
			]
		}
	]
}