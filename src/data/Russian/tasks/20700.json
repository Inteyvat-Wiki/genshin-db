			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Царевич"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000201,
					"content": "С хиличурлами покончено.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000202
					]
				},
				{
					"id": 207000202,
					"content": "#Так быстро? Даже минуты не прошло! А ты хорош{F#а}. Очень хорош{F#а}, ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000203
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000203,
					"content": "Неплохо, неплохо... Вот, возьми, здесь ровно 5000 моры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000204
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000204,
					"content": "#Всего 5000 за то, что {NICKNAME} «очень хорош{F#а}»?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 207000205,
					"content": "Ну же, не пыжьтесь! Я очень тщательно рассчитал вознаграждение. Оно соответствует проделанной вами работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000206
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000206,
					"content": "Для большей награды нужно постараться. Вы можете попытать свою удачу в следующий раз, если я опять попаду в какую-нибудь неприятность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Царевич"
				}
			]
		},
