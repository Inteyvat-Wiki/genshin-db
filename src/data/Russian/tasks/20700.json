			"dialogs": [
				{
					"id": 207000304,
					"content": "С хиличурлами покончено.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000305
					]
				},
				{
					"id": 207000305,
					"content": "Вы тянете время точь-в-точь как эти Ордо Фавониус. Я ведь дал вам ровно минуту! Вы забыли или просто не слушали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000306
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000306,
					"content": "Вам нельзя доверить даже такое просто дело... Вот вам 1000 моры, делайте с ними что хотите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000307
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000307,
					"content": "Всего 1000 моры?! Почему так мало?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 207000308,
					"content": "А сколько вы хотите за такое качество работы? Это именно столько, сколько вы заслуживаете. Берите же!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Царевич"
				}
			]
		},
