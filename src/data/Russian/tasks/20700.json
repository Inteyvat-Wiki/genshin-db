	"talks": [
		{
			"id": 2070001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2070001",
							"2"
						],
						"stepId": 2070001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Царевич"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000101,
					"content": "Что ж за невезение такое! А эти рыцари из Ордо Фавониус, они...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000102
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000102,
					"content": "Что произошло?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000103
					]
				},
				{
					"id": 207000103,
					"content": "Да! Эти рыцари из Ордо Фавониус совершенно не могут ни с чем справиться! Они запрещают мне проезд, потому что чудовища на дороге устроили засаду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000104
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000104,
					"content": "И всё. От них больше нет никаких вестей. Как местные жители вообще могут доверять им свою безопасность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000105
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000105,
					"content": "Меня ждут срочные дела, а я тут простаиваю... Они хоть представляют, во сколько мне обходится каждая минута безделья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000106
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000106,
					"content": "Слушайте... А вы случайно не ищете приключений? Давайте, я вам заплачу, а вы поможете мне разобраться с этой проблемой. Что скажете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000107,
						207000109
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000107,
					"content": "По рукам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000108
					]
				},
				{
					"id": 207000108,
					"content": "Вот и славно. Уважаю людей, которые сразу берутся за дело, а не торгуются по полдня. Не волнуйтесь, я вас щедро вознагражу за выполненную работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000111,
					"content": "Возможно, я ошибаюсь, но мне кажется, что хиличурлов в Мондштадте стало в разы больше. Чем вообще занимается этот Ордо Фавониус?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000112
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000112,
					"content": "Приходится прибегать к помощи добровольцев. Но ведь вас самих не так уж и много, всего полтора. Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000113
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000113,
					"content": "Ладно, просто скажите, какое место вы сможете обезопасить от хиличурлов: подножие горы, склон или вершину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000114
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000114,
					"content": "Там всюду хиличурлы, поэтому нет никакой разницы. А теперь выбирайте, хватит тратить моё время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207000109,
					"content": "А сколько вы заплатите?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000110
					]
				},
				{
					"id": 207000110,
					"content": "Ха-ха! Это зависит от того, насколько хорошо вы справитесь с задачей. Если меня всё устроит, то я щедро вас вознагражу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Царевич"
				}
			]
		},
		{
