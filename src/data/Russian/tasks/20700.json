				{
					"id": 207004301,
					"content": "С хиличурлами покончено.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207004302
					]
				},
				{
					"id": 207004302,
					"content": "Знаешь... Я наблюдал за твоей работой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004303
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207004303,
					"content": "#Скажи, ты просто привык{F#ла} всё делать по-своему, или я непонятно объяснил тебе задачу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004304
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207004304,
					"content": "Знаешь, мы в Снежной любим фразу «сказано - сделано».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004305
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207004305,
					"content": "#Я плачу тебе деньги, а значит хочу, чтобы ты выполнил{F#а} мой запрос именно так, как я говорю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004306
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207004306,
					"content": "#Ты выполнил{F#а} задание, но посмотри на результат... Я не могу заплатить тебе больше 1000 моры. Возьми и иди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004307
					],
					"speakerTitle": "Царевич"
				},
				{
					"id": 207004307,
					"content": "Всего 1000 моры?! На них ведь даже ничего не купишь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 207004308,
					"content": "Считаете, что это мало? Но ведь вы даже не смогли сделать то, о чём я вас попросил. 1000 моры более чем достаточно за такую работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Царевич"
				}
			]
		},
