				"points": []
			},
			"dialogs": [
				{
					"id": 727320101,
					"content": "Банда Аратаки! Я здесь, чтобы сразиться с вами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320102
					],
					"speakerTitle": "Поставщица опасностей"
				},
				{
					"id": 727320102,
					"content": "О, что теперь? Гранд-мастер Ханакадо прислал ещё малышку, чтобы бросить мне вызов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320103
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727320103,
					"content": "У него не хватает людей? Подсылает кого попало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320104
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727320104,
					"content": "...Я не по твою душу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320105
					],
					"speakerTitle": "Поставщица опасностей"
				},
				{
					"id": 727320105,
					"content": "В пустой бочке звону больше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320106
					],
					"speakerTitle": "Поставщица опасностей"
				},
				{
					"id": 727320106,
					"content": "#А вот {M#золотоволосый}{F#золотоволосая} выглядит сильным и умелым воином. Я думаю, что {M#он}{F#она} настоящий главарь банды Аратаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320107
					],
					"speakerTitle": "Поставщица опасностей"
				},
				{
					"id": 727320107,
					"content": "#Ха-ха-ха! Настоящий знаток людского характера! Давай, восхваляй {M#его}{F#её} дальше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 727320108,
					"content": "Эй, эй! О чём вы говорите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320109
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727320109,
					"content": "#{M#Мой друг, конечно, силён}{F#Моя подруга, конечно, сильна}, но {M#он}{F#она} лишь помогает мне. Не заблуждайтесь, в банде Аратаки только один главарь. Ваш Аратаки Итто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320110,
						727320111
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727320110,
					"content": "А я Временная правая рука короля óни?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				},
				{
					"id": 727320112,
					"content": "Отличная идея! Может, банда Аратаки и не самая сильная в мире, но стать её главарём было бы круто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 727320113,
					"content": "Если ты не против, Паймон получит звание «Аратаки на три дня» или «Временный главарь банды Аратаки»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 727320114,
					"content": "Эй, эй! Не позволяй противнику сбить тебя с пути! Она явно просто... просто пытается посеять раздор! Всё это часть гнусного заговора, чтобы настроить нас друг против друга!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320115
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727320115,
					"content": "Только подождите, пока я одолею её босса! Она будет умолять взять свои слова обратно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320116
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727320116,
					"content": "Не льстите себе. Меня не волнуют внутренние дела банды Аратаки. Я просто хочу сразиться с сильными противниками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320117
					],
					"speakerTitle": "Поставщица опасностей"
				},
				{
					"id": 727320117,
					"content": "#Посмотрим, насколько {M#золотоволосый}{F#золотоволосая} хорош{F#а} в жучиных боях!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Поставщица опасностей"
				},
				{
					"id": 727320111,
					"content": "А может, позволишь мне побыть главарём пару дней?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				}
			]
		}
	]
}