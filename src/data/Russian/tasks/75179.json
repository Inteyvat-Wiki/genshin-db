				{
					"id": 751790201,
					"content": "Фух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790202,
						751790204
					],
					"speakerTitle": "Зашари"
				},
				{
					"id": 751790202,
					"content": "Ты как?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790203
					]
				},
				{
					"id": 751790203,
					"content": "Всё в порядке... Просто немного запыхался от бега. Надо перевести... дыхание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зашари"
				},
				{
					"id": 751790204,
					"content": "Хорошенько отдохни.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790205
					]
				},
				{
					"id": 751790205,
					"content": "Ага... спасибо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зашари"
				}
			]
		},
