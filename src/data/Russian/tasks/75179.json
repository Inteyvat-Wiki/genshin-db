				"objectNames": [
					"Тизло"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751790401,
					"content": "Эй! Да, я к тебе обращаюсь! Там опасно! Заходи сюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790402
					],
					"speakerTitle": "Тизло"
				},
				{
					"id": 751790402,
					"content": "Ты разве не видишь, что там творится? Началось извержение вулкана, потом дорогу запрудили монстры. Дальше идти нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790403
					],
					"speakerTitle": "Тизло"
				},
				{
					"id": 751790403,
					"content": "#Послушай, оставайся лучше здесь и подожди немного. А дальше пойдёшь вместе с остатками нашего каравана. Так мы сможем о тебе позаботиться. {F#Одной}{M#Одному} тут ходить опасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790404,
						751790408
					],
					"speakerTitle": "Тизло"
				},
				{
					"id": 751790404,
					"content": "Монстры?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790405
					]
				},
				{
					"id": 751790405,
					"content": "Да, целая стая фиолетовых тепетлизавров! Сразу видно, что они заражены Бездной! Крушат всё на своём пути. Я никогда ещё не видел таких ужасных тепетлизавров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790406
					],
					"speakerTitle": "Тизло"
				},
				{
					"id": 751790406,
					"content": "Им хватило одного взмаха хвостом, чтобы сломать наши повозки! Они даже сильнее татанказавров. С такими врагами обычному человеку не сладить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790407
					],
					"speakerTitle": "Тизло"
				},
				{
					"id": 751790407,
					"content": "Я серьёзно тебе говорю. Успокойся и даже не пытайся с ними сражаться. Держись от них подальше, целее будешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тизло"
				},
				{
					"id": 751790408,
					"content": "Не беспокойся, я справлюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790409
					]
				},
				{
					"id": 751790409,
					"content": "Ты... Эх, ладно. Береги себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тизло"
				}
			]
		},
