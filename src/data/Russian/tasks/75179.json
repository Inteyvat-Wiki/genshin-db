			"dialogs": [
				{
					"id": 751790701,
					"content": "Значит, они тебя и спасли, босс?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790702
					],
					"speakerTitle": "Тизло"
				},
				{
					"id": 751790702,
					"content": "Ха-ха, да! Видели бы вы, как они сражались! Разогнали этих монстров в два счёта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790703
					],
					"speakerTitle": "Ицайя"
				},
				{
					"id": 751790703,
					"content": "Вы спасли нашего босса! Я перед вами в неоплатном долгу. Прошу вас, примите это в знак моей благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790704
					],
					"speakerTitle": "Тизло"
				},
				{
					"id": 751790704,
					"content": "Тизло, ты серьёзно? Ты всегда такой жадный? Разве это достойная благодарность за спасение жизни?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ицайя"
				}
			]
		},
