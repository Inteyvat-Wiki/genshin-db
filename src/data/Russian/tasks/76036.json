			"dialogs": [
				{
					"id": 760360101,
					"content": "Не этот синий?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360102
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360103,
						760360104
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760360103,
					"content": "Коломбина?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				},
				{
					"id": 760360105,
					"content": "О! Это вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360106
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360106,
					"content": "Помогите мне. Я отблагодарю за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360107
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360107,
					"content": "Ох... Когда ты уже избавишься от этой привычки?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360108,
						760360109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360108,
					"content": "Ты много раз нам помогала...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360110,
					"content": "Мы бы помогли тебе, даже за просто так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360111,
					"content": "Какого рода помощь тебе нужна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360112,
					"content": "Вообще-то, помощь нужна ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360113
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360114
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760360114,
					"content": "Куухенки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360115,
					"content": "Эта малышка где-то раздобыла кисть и, весело ею размахивая, вернулась сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360116
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360116,
					"content": "Я нашла для неё холст и краски, но, хотя прошло уже некоторое время, её попытки смешать нужные цвета не увенчались успехом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360117
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360117,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360118
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 760360118,
					"content": "Эй, ты что здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360119,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360120
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 760360120,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360121
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760360121,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360122
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 760360122,
					"content": "Не забывай, мы не понимаем то, что ты пытаешься показать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360124
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 760360124,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360125
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 760360125,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360126
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760360126,
					"content": "Хм, похоже, она заинтересовалась твоим рюкзаком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360127,
					"content": "У вас с собой есть подходящие цвета?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360128
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360128,
					"content": "Нет... Кстати, где ты нашла краски? Без обид, но ты не похожа на художницу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360129,
					"content": "Эта малышка была нетерпеливой, поэтому я сделала для неё краски из ярких цветов, которые росли поблизости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360130
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360130,
					"content": "Хм, может быть, луоннотар ищет другие яркие предметы, чтобы сделать из них краски?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360131,
					"content": "Давай посмотрим, что у нас в рюкзаке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360109,
					"content": "Ты не раз даровала нам своё благословение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360104,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				}
			]
