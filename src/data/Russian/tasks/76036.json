			"dialogs": [
				{
					"id": 760360301,
					"content": "Этого хватит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360302,
					"content": "Кажется, она довольна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360303
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360303,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360304
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760360304,
					"content": "Паймон и подумать не могла, что куухенки умеют рисовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360305,
					"content": "На самом деле они очень похожи на нас. У каждой свой характер и свои увлечения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360306
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360306,
					"content": "Хочешь сказать, что различаешь всех куухенки в Нод-Крае?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360307,
					"content": "Тех, с кем я встречалась, да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360308
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360308,
					"content": "Впечатляет... Кроме луоннотар, все остальные куухенки выглядят одинаково...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360309,
					"content": "Как зовут эту маленькую художницу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360310,
					"content": "Как её зовут?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360311
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360311,
					"content": "У них нет имён?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360312,
					"content": "Я узнаю их, а они меня. Имена не нужны... у меня самой нет имени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360313
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360313,
					"content": "Это не повод поддерживать такие традиции!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360314,
					"content": "Хм... Тогда... Луоннотар означает «существо, рождённое под благословением Богини Луны»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360315,
					"content": "Как будет «живопись» на языке Детей Морозной Луны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360316,
					"content": "Думаю, это будет... Маа... наус? Маалаус? Да. Маалаус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360317
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360317,
					"content": "О, звучит неплохо! Пусть так и будет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360318,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360319
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760360319,
					"content": "Ну как, Маалаус? Ты закончила рисовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360320,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360321
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760360321,
					"content": "О! Посмотрим, посмотрим... Хм. Это!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360322,
					"content": "Что-то не так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360323
					]
				},
				{
					"id": 760360323,
					"content": "Это потрясающе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360324,
					"content": "Паймон ожидала увидеть более детский вариант... или, ну, знаешь, что-то в стиле мелюзины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360325,
					"content": "Куухенки прекрасно чувствуют окружающую среду, и когда воссоздают то, что видели, они склонны точно фиксировать свои ощущения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360326
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360326,
					"content": "Хм... Ты нарисовала Коломбину, Маалаус?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360327
					]
				},
				{
					"id": 760360327,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360328
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760360328,
					"content": "М?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360329
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360329,
					"content": "...Она похожа на Коломбину, когда она только родилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360330
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360330,
					"content": "А?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360331
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360331,
					"content": "Паймон помнит, как Лаума говорила, что твоё рождение было засвидетельствовано Детьми Морозной Луны... хотя эта картина выглядит немного иначе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360332,
						760360333
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360332,
					"content": "А куухенки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360334
					]
				},
				{
					"id": 760360334,
					"content": "Эта малышка... Маалаус была одной из первых куухенки, появившихся на свет. Возможно, она изобразила эту сцену по своим ощущениям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360335
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360335,
					"content": "Хм. Похоже, ты очень хочешь познакомить нас со своей богиней, да, Маалаус?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360336
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360336,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360337
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760360337,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360338
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360338,
					"content": "Не волнуйся, Маалаус. Мы отлично поладим с Коломбиной, вот увидишь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360339
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360339,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360340
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760360340,
					"content": "Ого, как быстро. Ты успела закончить ещё одну картину?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360341
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360341,
					"content": "?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360342
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360342,
					"content": "На ней, должно быть, изображены Дети Морозной Луны, поклоняющиеся Коломбине как своей богине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360343
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360343,
					"content": "Хм? Что она делает у алтаря? Детали слишком мелкие, сложно разглядеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360344
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360344,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360345
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760360345,
					"content": "О, она ест подношения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360346
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360346,
					"content": "...А разве нельзя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360347
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360347,
					"content": "Ой, нет-нет, это просто как-то... неожиданно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360348
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360348,
					"content": "Похоже, тебе понравилось...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360349
					]
				},
				{
					"id": 760360349,
					"content": "Они... очень вкусные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360350
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360350,
					"content": "Паймон тебя прекрасно понимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360351
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760360351,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360352
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760360352,
					"content": "...Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360353
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360353,
					"content": "Дай мне руку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360354,
						760360355
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360354,
					"content": "Мне не нужно ничего взамен...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360356
					]
				},
				{
					"id": 760360356,
					"content": "Это свидетельство того, что мы «поладили».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760360355,
					"content": "Только не ешь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360356
					]
				},
				{
					"id": 760360333,
					"content": "...появились на свет после рождения Богини Луны...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360334
					]
				}
			]
		}
