					}
				]
			},
			"dialogs": [
				{
					"id": 711270401,
					"content": "#{NICKNAME} и Паймон, привет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270402
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711270402,
					"content": "Лин Юань? Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711270403,
					"content": "Не могу попасть внутрь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270404
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711270404,
					"content": "Попасть внутрь? Куда ты не можешь войти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711270405,
					"content": "В Покои Карпа. Где отдыхает Фу Цзинь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270406
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711270406,
					"content": "Покои Карпа... Куда Фу Цзинь нас приводила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711270407,
					"content": "Это обитель, запечатанная её силой Адептов. У меня нет её силы, поэтому я не могу попасть туда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270408
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711270408,
					"content": "Что? Но ты не упоминала об этом до того, как она ушла отдыхать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711270409,
					"content": "Забыла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270410,
						711270412
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711270410,
					"content": "Нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270411
					]
				},
				{
					"id": 711270411,
					"content": "Силы Адептов, которой вы обладаете, достаточно, чтобы открыть врата Покоев Карпа. Так что да, мне нужна ваша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711270416,
					"content": "А? Погоди-ка, так ты всё это время ждала нас здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711270417,
					"content": "Я не ждала вас. Я ищу путь в Покои Карпа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270418
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711270418,
					"content": "Похоже, это почти одно и то же... Что ж, мы тоже немного обеспокоены состоянием Фу Цзинь. Почему бы нам не навестить её вместе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270419
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711270419,
					"content": "Хорошо. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270420
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711270420,
					"content": "Идите за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711270412,
					"content": "Поздно же ты спохватилась, Лазурь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270413
					]
				},
				{
					"id": 711270413,
					"content": "Да, как ты могла забыть о столь важном факте? Ну, правда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711270414,
					"content": "Это потому, что я зверь, мыслящий медленно. Видя её, я думаю о многом. Но и многое забываю. Это моя вина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270415
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711270415,
					"content": "Силы Адептов, которой вы обладаете, достаточно, чтобы открыть врата Покоев Карпа. Мне нужна ваша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Лин Юань"
				}
			]
		},
