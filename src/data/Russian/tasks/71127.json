			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мао",
					"Фу Цзинь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711271301,
					"content": "Сестрица Фу Цзинь! Поздравляю с возвращением в прежний облик!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271302
					],
					"speakerTitle": "Мао"
				},
				{
					"id": 711271302,
					"content": "Лазурь уже рассказала мне об этом! Ты очень любишь чай, поэтому я специально попросил дедушку Лу приготовить для тебя супер-пупер вкусное печенье!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271303
					],
					"speakerTitle": "Мао"
				},
				{
					"id": 711271303,
					"content": "Точно, я вернулась, полностью и окончательно! Мао, спасибо тебе большое за печенье. Я так счастлива!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271304
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711271304,
					"content": "#{NICKNAME}, Паймон, и вам угощений хватит! Полакомимся печеньем и отпразднуем выздоровление Фу Цзинь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271305,
						711271307
					],
					"speakerTitle": "Мао"
				},
				{
					"id": 711271305,
					"content": "(Взять одно печенье)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271306
					]
				},
				{
					"id": 711271306,
					"content": "Хе-хе, спасибо, Мао! Осталось ещё много, поэтому Паймон возьмёт два печенья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711271307,
					"content": "(Взять два печенья)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271308
					]
				},
				{
					"id": 711271308,
					"content": "Хе-хе, спасибо, Мао! Паймон возьмёт ещё два... А-а-а! Осталось только одно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
