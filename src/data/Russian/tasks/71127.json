				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711271201,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271202
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711271202,
					"content": "В чём дело, Лин Юань? Почему ты так на меня смотришь? У меня лицо испачкано?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271203
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711271203,
					"content": "Я тут подумала... Нет, ничего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271204
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711271204,
					"content": "Даже если ты и змея попросите меня об этом, я никогда больше не приму человеческий облик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271205
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711271205,
					"content": "Хе-хе. Я никогда раньше не просила тебя об этом. Зачем мне это сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271206
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711271206,
					"content": "...Забудь об этом. Пойдём. Ты сказала, что всё ещё хочешь увидеть чай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лин Юань"
				}
			]
		},
		{
			"id": 7112713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112713",
							"2"
						],
						"stepId": 7112713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
