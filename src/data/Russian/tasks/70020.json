			"dialogs": [
				{
					"id": 700200102,
					"content": "Odomu! Ya dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200103
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700200103,
					"content": "Подожди. Позволь мне всё уладить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200104
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700200104,
					"content": "Mimi tomo, Odomu nye! Muhe mani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200105
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700200105,
					"content": "Mani? Mani! Yoyo mani mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200106
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700200106,
					"content": "Dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200107
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700200107,
					"content": "Dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200108,
						700200109
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700200108,
					"content": "Кажется, всё идёт по плану.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				},
				{
					"id": 700200110,
					"content": "Я спросила, всё ли у него в порядке. Похоже, ему действительно нужна наша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200111
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700200111,
					"content": "Dada odomu! Kundala dada! Kundala zido, mi dada! Muhe yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200112
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700200112,
					"content": "Ой... Он имеет в виду, что ему нужна помощь, чтобы... Победить сильного врага.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200113
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700200113,
					"content": "Ya zido? Ye? Mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200114
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700200114,
					"content": "Mi! Mi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200115
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700200115,
					"content": "Ладно, место отмечено на карте. Твой выход!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200116
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700200116,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700200109,
					"content": "О чём вы говорите?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				}
			]
		},
