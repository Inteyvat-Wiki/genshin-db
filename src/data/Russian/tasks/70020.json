			"dialogs": [
				{
					"id": 700200208,
					"content": "Похоже, он пытался нам что-то сказать... Может ли это быть связано со странным хиличурлом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200201
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700200201,
					"content": "Yeye dada! Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200202
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700200202,
					"content": "Odomu tomo zido mi! Mi mani yeye! <color=#00E1FFFF>Unta nunu</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200203
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700200204,
					"content": "Э... Спасибо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200206
					]
				},
				{
					"id": 700200205,
					"content": "Tomo, valo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200206
					]
				},
				{
					"id": 700200203,
					"content": "<color=#00E1FFFF>Unta nunu</color>... Похоже, это связано со временем... Не забудь проверить в разговорнике!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200204,
						700200205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700200206,
					"content": "Valo, tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200207
					],
					"speakerTitle": "Хиличурл"
				},
				{
