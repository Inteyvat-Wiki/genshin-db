			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Утида Котаро"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090401,
					"content": "Это... это... мой «способ совершения преступления»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090402
					],
					"speakerTitle": "Утида Котаро"
				},
				{
					"id": 708090402,
					"content": "#{NICKNAME}! Он прямо взял и признался!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708090403,
					"content": "Ах, прошу, не поймите меня превратно! Это всего лишь сюжетный ход, который я собираюсь использовать в своём следующем романе. Идея пришла за бокалом вина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090404
					],
					"speakerTitle": "Утида Котаро"
				},
				{
					"id": 708090404,
					"content": "А когда протрезвел - лист исчез. Я уж было решил, что мне всё это померещилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090405
					],
					"speakerTitle": "Утида Котаро"
				},
				{
					"id": 708090405,
					"content": "Словом, огромное спасибо за помощь. Теперь точно допишу роман. Первый экземпляр непременно подарю тебе, и, разумеется, с автографом автора!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Утида Котаро"
				}
			]
		},
		{
			"id": 7080905,
			"completionStepIds": [
				7080906
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
