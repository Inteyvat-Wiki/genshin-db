						],
						"pointId": 16779
					}
				]
			},
			"dialogs": [
				{
					"id": 708090301,
					"content": "(В гнезде обрывки бумаги, на которых видны неаккуратные надписи...)",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090302
					]
				},
				{
					"id": 708090302,
					"content": "Эти клочки... Неужели птицы специально порвали их для строительства гнезда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708090303,
					"content": "Кажется, на них ещё что-то написано! Может, соберём их вместе и посмотрим, что там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708090304,
					"content": "Полдня собирать придётся...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090305
					]
				},
				{
					"id": 708090305,
					"content": "Разве тебе не любопытно? Вдруг это какая-нибудь карта сокровищ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708090306,
					"content": "Паймон уговаривает вас, и вы собираете записку...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090307
					]
				},
				{
					"id": 708090307,
					"content": "Дай-ка Паймон посмотрит... Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708090308,
					"content": "Это... Неужели это... «план преступления»?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090309,
						708090311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708090309,
					"content": "Кто же допустит, чтобы план преступления утащила птица!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090310
					]
				},
				{
					"id": 708090310,
					"content": "Но... но в романах же часто бывает такой сюжет! Безупречный план, который даёт сбой именно там, где этого меньше всего ожидаешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708090313,
					"content": "Может, пойти в ближайшую таверну и расспросить! Вдруг кто-то знает о готовящемся преступлении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708090311,
					"content": "Лучше верить, что это возможно, чем считать, что это невозможно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090312
					]
				},
				{
					"id": 708090312,
					"content": "#Т-ты... Ты прав{F#а}, надо быть готовым к любому повороту событий... Если кто-то правда задумал преступление, а мы не поверим, потом будет поздно жалеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7080904,
			"completionStepIds": [
				7080907
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
