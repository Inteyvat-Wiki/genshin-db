			"dialogs": [
				{
					"id": 741210301,
					"content": "Привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741210302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210303
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210304
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210304,
					"content": "Эй! Хватит вести себя так, словно Паймон тут нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741210305,
					"content": "...Привет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210306
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210306,
					"content": "Сегодня хорошая погода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210307
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210307,
					"content": "Вы знаете что-нибудь о том человеке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210308
					]
				},
				{
					"id": 741210308,
					"content": "Каком?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210309
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210309,
					"content": "Не знаю, о ком ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210310
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210310,
					"content": "Мы просто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210311
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210311,
					"content": "...гуляем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210312
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210312,
					"content": "Да. Мы просто гуляем. Вдвоём, как двое самых обычных людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210313
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210313,
					"content": "Погода сегодня хорошая. В такую очень приятно гулять. Вам не кажется?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210314
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210314,
					"content": "Гулять совершенно нормально. Вы наверняка и сами понимаете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210315
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210315,
					"content": "Э-э... Вы вообще о чём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741210316,
					"content": "Вы разве не слышали, как кто-то зовёт на помощь? Вон там в земле зарыт человек, которого чуть не съели крабы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741210317,
					"content": "Что? Подобное случилось в месте, где мы гуляем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210318
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210318,
					"content": "В такую прекрасную погоду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210319
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210319,
					"content": "Если бы его съели крабы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210320
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210320,
					"content": "Смешно бы вышло. То есть грустно, очень грустно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210321
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210321,
					"content": "Жаль, что ничего такого не произошло. В смысле, мы не позволим такому случиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210322
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210322,
					"content": "Если столкнёмся с подобным во время прогулки, мы этого так не оставим. Если столкнёмся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210323
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210323,
					"content": "Что вы здесь делаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210324
					]
				},
				{
					"id": 741210324,
					"content": "Гуляем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210325
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210325,
					"content": "Да, просто гуляем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210326
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210326,
					"content": "Вы правда не заметили ничего необычного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741210327,
					"content": "Нет, ничего такого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210328
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210328,
					"content": "Да, ничего. Кроме вас двоих, прервавших нашу прогулку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210329
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210329,
					"content": "Прогулки - это... очень личное. Мы не хотим, чтобы нам мешали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210330
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210330,
					"content": "Вам тоже лучше найти своё хорошее место для прогулок. Например, у фонтана Люсин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210331
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210331,
					"content": "А в этом месте гуляем мы. Наслаждаемся природой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210332
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210332,
					"content": "И мы не хотим, чтобы нам мешали. До свидания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тёрнер"
				}
			]
		},
