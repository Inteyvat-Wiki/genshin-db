			"dialogs": [
				{
					"id": 741210601,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210602
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210602,
					"content": "Ох, я ничего не... Последняя новинка в сфере красоты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210603
					],
					"speakerTitle": "Генри"
				},
				{
					"id": 741210603,
					"content": "Ого, когда это вы?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741210604,
					"content": "Мы гуляем. Прогулки - это такая физическая активность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210605
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210605,
					"content": "Во время которой люди двигаются. И это движение привело нас сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210606
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210606,
					"content": "Это вы сделали?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210607
					]
				},
				{
					"id": 741210607,
					"content": "А если даже и так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210608
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210608,
					"content": "#Хантер, я кое-что вспомнил. Посмотри-ка на {M#него}{F#неё} повнимательнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210609
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210609,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210610
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210610,
					"content": "#Это с {M#ним}{F#ней} нас просили не связываться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210611
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210611,
					"content": "Да, точно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210612
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210612,
					"content": "О чём вы там шепчетесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741210613,
					"content": "Ни о чём. Мы просто гуляем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210614
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210614,
					"content": "Да, мы гуляем. Если на этом всё, то мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210615
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210615,
					"content": "...пойдём гулять дальше. Куда-нибудь ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210616
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210616,
					"content": "Подождите, а вы не собираетесь сделать со мной что-нибудь ужасное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210617
					],
					"speakerTitle": "Генри"
				},
				{
					"id": 741210617,
					"content": "Этого урока достаточно, если ты понимаешь, о чём я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210618
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210618,
					"content": "Какого урока?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210619
					]
				},
				{
					"id": 741210619,
					"content": "Никакого. То есть... Жареные цыплята очень опасны и могут привлечь неприятности. Это очень важный урок. А мы пойдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210620
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210620,
					"content": "Но жареный цыплёнок... «Дебор»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210621
					],
					"speakerTitle": "Хантер"
				},
				{
					"id": 741210621,
					"content": "Довольно о жареных цыплятах! Мы продолжим прогулку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210622
					],
					"speakerTitle": "Тёрнер"
				},
				{
					"id": 741210622,
					"content": "«Попросим Сонни угостить нас жареным цыплёнком при следующей встрече».\\n- Сказал Тёрнер, удаляясь вместе с Хантером.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741210623
					]
				},
				{
					"id": 741210623,
					"content": "Спасибо! Огромное спасибо! Я знал, что вы всё поймёте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210624
					],
					"speakerTitle": "Генри"
				},
				{
					"id": 741210624,
					"content": "#Похоже, {NICKNAME} правильно {M#догадался}{F#догадалась}... Поможем Генри выбраться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210625
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741210625,
					"content": "Но выкапывать тебя - нелёгкая работа! Так что Паймон возьмёт жареного цыплёнка в качестве оплаты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210626
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741210626,
					"content": "А? Уф... Ладно, без проблем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210627
					],
					"speakerTitle": "Генри"
				},
				{
					"id": 741210627,
					"content": "У вас уходит какое-то время на то, чтобы вытащить Генри из песка и снять с него бочку.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741210628
					]
				},
				{
					"id": 741210628,
					"content": "Вы с Паймон берётесь за благоухающего жареного цыплёнка.\\nГенри, кажется, очень голоден, но он ничего не говорит, верный данному обещанию.\\nПаймон, глядя на изнывающего Генри, предлагает с ним поделиться.\\nЦыплёнок покрыт хрустящей корочкой, а его аромат просто бесподобен. Объеденье!",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
