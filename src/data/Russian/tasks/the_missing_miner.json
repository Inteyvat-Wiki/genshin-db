			"dialogs": [
				{
					"id": 710570201,
					"content": "Он с ним махом разобрался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710570202,
					"content": "Ого! Мощно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710570203,
					"content": "Хи-хи.. Грибы-грибочки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570204
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710570204,
					"content": "Как поем мяса грибов, так спина больше не болит, и сила появляется. Хи-хи, я чувствую себя таким молодым!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570205
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710570205,
					"content": "Монстрогриб лучше грибного мяса. Большие - вкуснее... Хи-хи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570206
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710570206,
					"content": "Может ли быть, что дядя Хэ стал таким сильным после того, как съел мясо грибов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710570207,
					"content": "#{NICKNAME}, раз мы можем стать сильными, то давай поедим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570208,
						710570210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710570208,
					"content": "Тебе просто хочется что-то пожевать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570209
					]
				},
				{
					"id": 710570209,
					"content": "Паймон просто любопытно, какие они на вкус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710570212,
					"content": "Но ведь теперь дядя Хэ согласится вернуться с нами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710570213,
					"content": "Грибное мясо... Хи-хи... вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570214
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710570214,
					"content": "Дядя Хэ, идём вместе с нами обратно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710570215,
					"content": "А? Вместе? Хорошо. Вместе поедим грибного мяса, хи-хи. А если его высушить, то надолго хватит... надолго...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570216
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710570216,
					"content": "Паймон говорит, в лагерь идём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710570217,
					"content": "А? Водоём? Ну ладно, грибов я поел, можно хоть на водоём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570218
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710570218,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710570219,
					"content": "#{NICKNAME}, нам нужно побыстрей отвести дядю Хэ к Цзинь У.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710570210,
					"content": "Нечего есть что попало!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570211
					]
				},
				{
					"id": 710570211,
					"content": "Уф... Паймон знает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
