			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дилюк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3770201,
					"content": "А вот и ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770202
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3770202,
					"content": "#{NICKNAME}? Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770203,
						3770204
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770203,
					"content": "Джинн? Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				},
				{
					"id": 3770205,
					"content": "Как я и обещал, я кое с кем связался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770206
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770206,
					"content": "Джинн присутствует здесь как частное лицо, а не как действующий магистр Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770207
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770207,
					"content": "Редкое зрелище, даже для самых почётных рыцарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770208
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770208,
					"content": "Вот так сюрприз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770209
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770209,
					"content": "#Я слышала про похищение Небесной лиры, но я и подумать не могла, что ты в этом замешан{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770210
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770210,
					"content": "Звуки Небесной лиры могут исцелить дракона. Это так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770211
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770211,
					"content": "#Всё верно! {NICKNAME} готов{F#а} на всё, чтобы спасти дракона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770212
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3770212,
					"content": "Настоящий рыцарь Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770213
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3770213,
					"content": "Кажется, мы замышляем что-то противозаконное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3770214,
					"content": "Я понимаю, что в такое объяснение сложно поверить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770215
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770215,
					"content": "Но мы можем попросить барда выступить ещё раз. Поёт он убедительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770216
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770216,
					"content": "Я верю вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770217
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770217,
					"content": "Чтобы убедить нашего упрямого магистра, тебе придётся... Погоди, что ты сказала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770218
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770218,
					"content": "В предательстве Двалина нет логики. Он был одним из Хранителей четырёх ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770219
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770219,
					"content": "Но если его разум отравлен уже столько лет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770220
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770220,
					"content": "А затем Маги Бездны взяли над ним контроль... Это многое объясняет. Дракон ни в чём не виноват.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770221
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770221,
					"content": "Но, как действующий магистр, я не могу публично делать подобные заявления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770222
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770222,
					"content": "Под давлением Фатуи сложно высказываться в пользу мирного решения проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770223
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770223,
					"content": "Горожане решат, что я теряю контроль над ситуацией. Теперь я буду действовать, как частное лицо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770224
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770224,
					"content": "Гм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770225
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770225,
					"content": "Ещё одна причина, по которой я не люблю рыцарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770226
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770226,
					"content": "Меня поражает, с какой лёгкостью ты готова довериться чужаку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770227
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770227,
					"content": "Но ведь даже ты, мой внимательный и осторожный <color=#00E1FFFF>старший</color>, доверился им, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770228
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770228,
					"content": "Я много раз просил не называть меня так. Ладно, мы не так уж и часто работаем вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770229,
						3770230
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770229,
					"content": "Старший?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770231,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770232
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770232,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770233
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770233,
					"content": "Ого! Эм... Неловко вышло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770234
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3770234,
					"content": "У меня есть идея о том, где нам искать Небесную лиру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770235
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770235,
					"content": "(Ого! А у неё неплохо получилось сменить тему разговора.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770236
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3770236,
					"content": "Конфликт между Мондштадтом и Снежной связан с противостоянием семи королевств и их Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770237
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770237,
					"content": "Фатуи вместе с Крио Архонтом хотят заполучить силу Анемо Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770238
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770238,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770239,
						3770240
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3770239,
					"content": "Поэтому они предложили взять на себя оборону города?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770241,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770242
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770242,
					"content": "Так как рыцари не дают им этого сделать, то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770243
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770243,
					"content": "Единственное, что им остаётся - украсть Небесную лиру, чтобы завладеть силой Анемо Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770244
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770244,
					"content": "В Мондштадте не так уж и много Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770245
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770245,
					"content": "Я уже... получил от них кое-какие сведения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770246
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770246,
					"content": "Дилюк убедился в том, что они не прячут небесную лиру в отеле «Гёте».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770247
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770247,
					"content": "Полагаю, они не настолько глупы, чтобы хранить похищенное в столь очевидном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770248
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3770248,
					"content": "Да-да! Паймон понимает, что будет большой дипломатический скандал, если выяснится, что Фатуи в этом замешаны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770249
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3770249,
					"content": "Такая уж дипломатия в семи королевствах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770250
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770250,
					"content": "#Чужезем{M#ец}{F#ка}, ты готов{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3770240,
					"content": "Они хотят убить Двалина?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770230,
					"content": "#(Сделать вид, что ничего не слышал{F#а})",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770204,
					"content": "Что здесь делают рыцари?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				}
			]
		},
