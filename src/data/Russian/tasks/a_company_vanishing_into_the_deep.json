	"talks": [
		{
			"id": 7106201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106201",
							"2"
						],
						"stepId": 7106201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Антон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620101,
					"content": "Ох... Прошу прощения, что вас задерживаю. Я старший сержант Антон Мельников, командир девятой роты... исполняющий обязанности командира роты. Зовите меня просто Антон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620102
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620102,
					"content": "А это Данила, Тимур, Радомир и... э-э-э... Романский сейчас в... санитарном лагере.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620103
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620103,
					"content": "Нет больше Романского, нет никакого санитарного лагеря, Антоха. Романский... не дожил до утра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620104
					],
					"speakerTitle": "Данила"
				},
				{
					"id": 710620104,
					"content": "Данила, сколько можно повторять, я - командир роты. Зови меня старший сержант Антон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620105
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620105,
					"content": "Ха! Командир! Старший сержант! Да что ты о себе возомнил, Антоха? Капитан исчез, а ты и хвост распустил! Ха! Ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620106
					],
					"speakerTitle": "Тимур"
				},
				{
					"id": 710620106,
					"content": "Хватит. Тимур, у тебя от голода ум за разум зашёл. Побереги-ка силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620107
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710620107,
					"content": "Есть, «исполняющий обязанности командира» Антоха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620149
					],
					"speakerTitle": "Данила"
				},
				{
					"id": 710620149,
					"content": "Тоже мне «исполняющий обязанности командира»! Сколько мы ещё будем носиться с этой пустышкой, как с писаной торбой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620150
					],
					"speakerTitle": "Тимур"
				},
				{
					"id": 710620150,
					"content": "Говорю тебе, Тимур, у тебя от голода мозги набекрень. Не отведать ли тебе кулака для ясности сознания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620151
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710620151,
					"content": "Ну давай! А я тебя пинками накормлю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620152
					],
					"speakerTitle": "Тимур"
				},
				{
					"id": 710620152,
					"content": "Прекрасно. Самое время проглотить здравомыслие и терпение... Просто прекрасно. Тратим последние силы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620108
					],
					"speakerTitle": "Данила"
				},
				{
					"id": 710620108,
					"content": "Кхм! Тихо! Хотите битв? Ну так давайте! Идите бейте тех тварей, что из грязи вылезают! Так и идите с пустым брюхом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620109
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620109,
					"content": "Если мы хотим выжить и выбраться отсюда, то нужно держаться вместе. Не заставляйте меня повторять, ясно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620110
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620110,
					"content": "Раз, два, девиз! Кто, если не мы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620111
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620111,
					"content": "Кто, если не мы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620112
					],
					"speakerTitle": "Данила"
				},
				{
					"id": 710620112,
					"content": "Кто, если не мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620113
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710620113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620153
					],
					"speakerTitle": "Тимур"
				},
				{
					"id": 710620153,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620114
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620114,
					"content": "Как видишь, мой друг, мы немного... кхм, не в боевой форме. У нас тут случилась небольшая накладка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620115
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620115,
					"content": "Угу... небольшая накладка! Ты просто вылитый капитан...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620116
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710620116,
					"content": "Капитана здесь нет, я - командир роты! Заткнись и побереги силы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620117
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620117,
					"content": "#Извини, {F#подруга}{M#друг}, нам сейчас нужна твоя помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Антон"
				}
			]
		},
		{
