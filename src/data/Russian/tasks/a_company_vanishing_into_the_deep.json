			"dialogs": [
				{
					"id": 710621001,
					"content": "В любом случае спасибо, что поделились едой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621002
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621002,
					"content": "Мы придумаем, как отсюда выбраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Антон"
				}
