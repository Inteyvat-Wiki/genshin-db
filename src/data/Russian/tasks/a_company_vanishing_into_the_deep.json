			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Антон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620118,
					"content": "Когда это мы стали друзьями?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620121
					]
				},
				{
					"id": 710620121,
					"content": "Что ты хочешь? Припасы, оружие, сведения, мора - у нас всего навалом. Если поможешь - хоть всё бери.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620122,
					"content": "Поглядите-ка, командир-попрошайка сам взялся за унизительную работу... Так чудесно потерять остатки достоинства...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "Тимур"
				},
				{
					"id": 710620123,
					"content": "Ты свои насмешки оставь при себе. Язвительностью сыт не будешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "Данила"
				},
				{
					"id": 710620124,
					"content": "«Стань одним из нас, и да содрогнётся земля от нашего марша. Мы не бросаем тех, кто следует с нами за звездой полярной ночи...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "Тимур"
				},
				{
					"id": 710620125,
					"content": "Заткните его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620126,
					"content": "Ох, они, конечно, злодеи, но они такие жалкие. До чего голод их довёл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710620127,
					"content": "Стыдно сказать... но, как видите, мы уже не способны сражаться. Нам бы немного еды выпросить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Антон"
				}
			]
		},
