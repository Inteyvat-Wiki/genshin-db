			"dialogs": [
				{
					"id": 710620202,
					"content": "Пожалуйста, обдумай просьбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620201
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620201,
					"content": "Вот ваша еда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106207,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106203",
							"2"
						],
						"stepId": 7106203,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7106202"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Антон",
					"Данила",
					"Тимур",
					"Радомир"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620701,
					"content": "Они такие немощные. Два тычка и спор решён!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710620702,
					"content": "Пожалуйста, хватит! Не бейте нас! Дайте нам немного еды, и мы сделаем всё, что захотите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620703
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620703,
					"content": "Хм... Кажется, эти парни и впрямь оголодали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620704,
						710620705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710620704,
					"content": "Сначала скажите вашу цель.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				},
				{
					"id": 710620706,
					"content": "Скажем так, какими бы ни были ваши подозрения... наше задание лишь в том, чтобы исследовать источник бедствия в Разломе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620707
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620707,
					"content": "Какого такого бедствия?.. Всё ведь прекрасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710620708,
					"content": "Бедствие, случившееся пятьсот лет назад, - это только начало. Война против тьмы никогда не прекращалась, и мы стоим на одном из полей её сражений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620709
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620709,
					"content": "Эх, да наш старший сержант доголодался до бахвальства...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620710
					],
					"speakerTitle": "Данила"
				},
				{
					"id": 710620710,
					"content": "Да он всегда любит преувеличивать... но такой бред несёт впервые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620711
					],
					"speakerTitle": "Тимур"
				},
				{
					"id": 710620711,
					"content": "Хватит, хватит... Антоха хочет сказать, что вы, жители Ли Юэ, нам не враги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620712
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710620712,
					"content": "По крайней мере, не враги девятой роты в этой операции... не могу ручаться за других соратников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620713
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620713,
					"content": "Ладно... Помогу тебе, но в виде исключения.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710620705,
					"content": "И почему мне нужно вам верить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				}
			]
		},
		{
			"id": 7106209,
			"completionStepIds": [
				7106205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106205",
							"2"
						],
						"stepId": 7106205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Антон",
					"Данила",
					"Тимур",
					"Радомир",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620901,
					"content": "Ох... Приношу извинения. В нашей командной сети произошла небольшая... накладка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620902
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620902,
					"content": "Небольшая? Накладка?! Да мы со своими же братьями воюем! На наших глазах чужаки обращают в бегство соратников!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620903
					],
					"speakerTitle": "Данила"
				},
				{
					"id": 710620903,
					"content": "И что, по-твоему, делать? Пусть поколотят нас и отберут еду? Советую сначала проглотить всё, что во рту, а потом говорить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620904
					],
					"speakerTitle": "Тимур"
				},
				{
					"id": 710620904,
					"content": "Антоха, не смеши меня... наша командная сеть уничтожена. Всё кончено. Все офицеры в звании выше капитана убиты или пропали без вести... у нас нет другого выбора. Придётся отступать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620905
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710620905,
					"content": "Но многие не желают отступать... Они лучше будут охранять то, что осталось от командиров и сражаться до последнего человека.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620906
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620906,
					"content": "Голодать они будут до последнего человека... Согласно договору о сотрудничестве сверху нам доставляли еду и приказы, но долгое время мы не получали вестей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620907
					],
					"speakerTitle": "Данила"
				},
				{
					"id": 710620907,
					"content": "Это правда, что наша преданность Фатуи и Предвестникам не подлежит сомнению, но мы не дураки... Сейчас мы можем только отступать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620908
					],
					"speakerTitle": "Тимур"
				},
				{
					"id": 710620908,
					"content": "Так что вы решили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620909
					]
				},
				{
					"id": 710620909,
					"content": "Ну... я знаю, что это вас не касается. Если вы хотите развернуться и уйти, это ваше дело, но мы в отчаянном положении и нуждаемся в вашей помощи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620910,
						710620912
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620910,
					"content": "Мне нужно подумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620911
					]
				},
				{
					"id": 710620911,
					"content": "Ладно... Только будьте осторожны в дороге. Наши боевые товарищи не будут такими дружелюбными, как мы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620913
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620913,
					"content": "Это, конечно, секретная информация, но... рядом с поверхностью находится пункт снабжения. Оттуда мы получаем припасы, а иногда и приказы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620914
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620914,
					"content": "Мы отправляли наверх несколько человек с просьбой о передаче продовольствия, но они так и не вернулись... Я не хочу рисковать ещё раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620915
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620915,
					"content": "И из пункта снабжения уже давно никто не спускался... мы бы хотели, чтобы вы пошли туда и всё разузнали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620916,
						710620917
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620916,
					"content": "Дайте мне немного подумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620918,
					"content": "Мне жаль, что приходится просить вас, но нам нужно понять, что происходит на поверхности... я не могу действовать наобум.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620919
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620919,
					"content": "Ладно! Хватит уже запутывать Паймон! Мы посмотрим по дороге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710620917,
					"content": "Я помогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620912,
					"content": "Нужна моя помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620913
					]
				}
			]
		},
		{
