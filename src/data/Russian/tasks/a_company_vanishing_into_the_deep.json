			"dialogs": [
				{
					"id": 710620137,
					"content": "Сначала скажите вашу цель.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620140
					]
				},
				{
					"id": 710620140,
					"content": "Скажем так, какими бы ни были ваши подозрения... наше задание лишь в том, чтобы исследовать источник бедствия в Разломе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620141
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620141,
					"content": "Какого такого бедствия?.. Всё ведь прекрасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620142
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710620142,
					"content": "Бедствие, случившееся пятьсот лет назад, - это только начало. Война против тьмы никогда не прекращалась, и мы стоим на одном из полей её сражений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620143
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620143,
					"content": "Эх, да наш старший сержант доголодался до бахвальства...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620144
					],
					"speakerTitle": "Данила"
				},
				{
					"id": 710620144,
					"content": "Да он всегда любит преувеличивать... но такой бред несёт впервые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620145
					],
					"speakerTitle": "Тимур"
				},
				{
					"id": 710620145,
					"content": "Хватит, хватит... Антоха хочет сказать, что вы, жители Ли Юэ, нам не враги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620146
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710620146,
					"content": "По крайней мере, не враги девятой роты в этой операции... не могу ручаться за других соратников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620147
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710620147,
					"content": "По доброте душевной я вам помогу, но это в последний раз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620148
					]
				},
				{
					"id": 710620148,
					"content": "Спасибо... Спасибо вам. Мы никогда не забудем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Антон"
				}
			]
