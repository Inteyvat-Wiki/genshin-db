						],
						"stepId": 7106207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Антон",
					"Радомир",
					"Данила",
					"Тимур"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621101,
					"content": "Вы вернулись! Ну как? Есть новости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621102
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621102,
					"content": "Пункт снабжения заброшен.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621103
					]
				},
				{
					"id": 710621103,
					"content": "Вот как... А вы что-нибудь нашли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621104
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621104,
					"content": "Вам больше не рады в Ли Юэ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621105
					]
				},
				{
					"id": 710621105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621106
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621106,
					"content": "Есть ли другие новости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621107
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621107,
					"content": "Э... Мы нашли письмо. Кажется, оно для тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710621108,
					"content": "Тут...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621109
					]
				},
				{
					"id": 710621109,
					"content": "Вы передаёте письмо Фатуи...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710621110
					]
				},
				{
					"id": 710621110,
					"content": "О, это от Янь Бо. Ясно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621111
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621111,
					"content": "Ну что? Миллелиты ушли? Дай посмотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621112
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710621112,
					"content": "Ох... Да как же так... Мы сражаемся за них! Мы же соратники!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621113
					],
					"speakerTitle": "Данила"
				},
				{
					"id": 710621113,
					"content": "Нет уже никаких соратников! Мы разорвали отношения... Точнее, мы, Фатуи, разорвали отношения с Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621131
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710621131,
					"content": "Это предательство! Нас предали жители Ли Юэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621132
					],
					"speakerTitle": "Тимур"
				},
				{
					"id": 710621132,
					"content": "Возможно, жители Ли Юэ видят это наоборот? Что это мы, Фатуи, их предали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621114
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710621114,
					"content": "Что за ерунда... Мы пришли защищать жителей Ли Юэ! Помните, что говорил капитан перед отправкой? Этот поход не имеет ничего общего с мелочными расчётами и интригами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621115
					],
					"speakerTitle": "Данила"
				},
				{
					"id": 710621115,
					"content": "Но мелочные расчёты и махинации не остановить... это не в нашей власти, Данила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621116
					],
					"speakerTitle": "Тимур"
				},
				{
					"id": 710621116,
					"content": "Ладно, я понял. Фух... Я принял решение. Нам нужно выбираться отсюда, и чем скорее, тем лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621117
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621117,
					"content": "Всё в порядке, я беру всю ответственность на себя. Если среди нас есть дезертир... дезертир, который опозорит девятую роту, то это я и никто другой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621118
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621118,
					"content": "Данила прав. Мы здесь, чтобы защищать жителей Ли Юэ от тёмного бедствия. Мы не можем просто уйти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621119
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710621119,
					"content": "Разве сейчас время говорить о личной гордости, Мирка? Раскрой глаза!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621120
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621120,
					"content": "Жители Ли Юэ не нуждаются в нашей защите, и они нам не рады! Не они ли погубили наших слишком самоуверенных товарищей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621121,
						710621122
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621121,
					"content": "Да, но вы обманули доверие жителей Ли Юэ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				},
				{
					"id": 710621123,
					"content": "Нам нужно отступать. Нужно двигаться как можно тише и не привлекать внимание местных Миллелитов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621124
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621124,
					"content": "Капитан сказал, что мы должны быть готовы положить здесь свои жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621125
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710621125,
					"content": "А ещё капитан сказал, что не допустит бессмысленных жертв! И что он не хотел бы, чтобы я погубил всю роту!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621126
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621126,
					"content": "Мы ещё живы, а значит девятая рота ещё существует, ясно?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621127
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621127,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621128
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710621128,
					"content": "Ясно, товарищ командир!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621129
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710621129,
					"content": "Хорошо, есть ли у кого-нибудь ещё вопросы? Я не хочу слышать никаких возражений. Разойдись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621130
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621130,
					"content": "#Как бы то ни было, спасибо за помощь, {NICKNAME}. Возьми эту мору и материалы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621122,
					"content": "Вам бы подумать о путях отступления.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				}
			]
		},
