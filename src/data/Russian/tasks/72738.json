					}
				]
			},
			"dialogs": [
				{
					"id": 727380101,
					"content": "Вот так. Всего лишь небольшая уборка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380102
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380102,
					"content": "#Ох, {M#малыш}{F#малышка}, ты как раз вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380103,
						727380104
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380103,
					"content": "Как раз вовремя... для чего?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				},
				{
					"id": 727380105,
					"content": "Полюбуйся на себя. Знаю, ты думаешь: «Только не это, опять она свалит на меня какую-нибудь противную работу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380106
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380106,
					"content": "Не беспокойся, я хотела сказать, что мы совсем недавно закончили реконструкцию святилища и готовимся открыть совершенно новое направление деятельности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380107
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380107,
					"content": "И я не успела даже объявить об этом во всеуслышание, а ты тут как тут. Разве не совпадение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380108
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380108,
					"content": "Видишь этот ящик для пожертвований? Скоро здесь тоже можно будет загадать желание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380109
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380109,
					"content": "У тебя ведь уже есть гадальные листки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380110
					]
				},
				{
					"id": 727380110,
					"content": "Это другое. Гадальные листки предсказывают судьбу, а здесь... можно будет загадать желание, чтобы оно исполнилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380111
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380111,
					"content": "Нужно закрыть глаза, загадать желание, записать его на молитвенной дощечке и повесить дощечку на стойку. И может быть, желание сбудется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380112
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380112,
					"content": "Я могу загадать что угодно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380113
					]
				},
				{
					"id": 727380113,
					"content": "Конечно. Но какое желание исполнить... решают боги, которые хранят нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380114
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380114,
					"content": "Я всего лишь слабая Гудзи и смогу помочь разве что в мирских заботах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380115,
						727380116
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380115,
					"content": "Я не против завести новых друзей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380117,
					"content": "Тогда почему бы тебе не попробовать? Вот, возьми гадательную бумагу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380118
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380118,
					"content": "Бумага осталась, когда я готовила гадательные листки. Бери.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380119
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380119,
					"content": "Напиши на ней своё желание. Тогда оно скорее исполнится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380120
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380120,
					"content": "Правда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380121
					]
				},
				{
					"id": 727380121,
					"content": "#Я тебя хоть однажды обманывала? Давай, {F#малышка}{M#малыш}, загадывай своё желание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380122
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380122,
					"content": "Не забудь: желание надо записать на гадательной бумаге, приклеить бумагу к дощечке, а дощечку повесить на стойку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380123
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380123,
					"content": "И тогда твоё желание исполнится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380124
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380124,
					"content": "Да. Желание, которое идёт от чистого сердца. Очень хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380125
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380125,
					"content": "Ты уверена, что это сработает?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380126
					]
				},
				{
					"id": 727380126,
					"content": "#Ну что, {F#малышка}{M#малыш}, теперь пора за работу. Держи ушки востро и не проморгай свою удачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380127
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380127,
					"content": "Кто знает, вдруг человек, с которым ты хочешь повстречаться, сидит сейчас в каком-нибудь ресторанчике и уплетает рамэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 727380116,
					"content": "Хочется встретиться со старыми друзьями...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380104,
					"content": "Подожди, ты к чему ведёшь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				}
			]
		}
	]
}