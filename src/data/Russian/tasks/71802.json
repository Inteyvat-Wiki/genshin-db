				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180207",
							"2"
						],
						"stepId": 7180207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103509",
							"3"
						],
						"stepId": 1103509,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718021001,
					"content": "Нелегко найти Адептов в Заоблачном пределе. И всё же вы пришли сюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021002
					],
					"speakerTitle": "Обитель Адепта",
					"speakerSubtitle": "...Но голос не тот?"
				},
				{
					"id": 718021002,
					"content": "Ох! А она р-разве не в гавани Ли Юэ? Неужели успела вернуться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718021003,
					"content": "Но... Голос не тот?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021004
					]
				},
				{
					"id": 718021004,
					"content": "Эм... Мы волновались, что к тебе кто-то пробрался. Мы не хотели тебя беспокоить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718021005,
					"content": "...Доброжелатель, что исполнит поручение бессмертного, да войдёт в обитель Адепта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021006,
						718021007
					],
					"speakerTitle": "Обитель Адепта",
					"speakerSubtitle": "...Но голос не тот?"
				},
				{
					"id": 718021006,
					"content": "Она как будто вообще нас не слышит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021008
					]
				},
				{
					"id": 718021008,
					"content": "Что? Хочешь сказать, с нами сейчас говорит не Хранитель Облаков, а её механизм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021009
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718021009,
					"content": "В прошлом я добилась значительных успехов в изучении механики и смогла построить себе Облачную обитель, парящую в небе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021010
					],
					"speakerTitle": "Обитель Адепта",
					"speakerSubtitle": "...Но голос не тот?"
				},
				{
					"id": 718021010,
					"content": "Завершив Облачную обитель, я задумалась о непостижимости пути Адепта и оставила чертежи тому, кому предначертано их отыскать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021011
					],
					"speakerTitle": "Обитель Адепта",
					"speakerSubtitle": "...Но голос не тот?"
				},
				{
					"id": 718021011,
					"content": "Найдите чертежи и возвращайтесь в обитель Адепта. Поговорим позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021012
					],
					"speakerTitle": "Обитель Адепта",
					"speakerSubtitle": "...Но голос не тот?"
				},
				{
					"id": 718021012,
					"content": "Госпожа Адепт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021013
					]
				},
				{
					"id": 718021013,
					"content": "Хранитель Облаков? Г-госпожа Сянь Юнь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
