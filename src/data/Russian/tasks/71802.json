					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020401,
					"content": "#Ты до сих пор не получил{F#а} чертежи? Они в Облачной обители.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020402
					],
					"speakerTitle": "Обитель Адепта"
				},
				{
					"id": 718020402,
					"content": "Эм... А откуда она знает, что у нас ещё нет чертежей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718020403,
					"content": "Я смогла создать эти чертежи. Думаешь, я не смогу почувствовать их приближение? Принеси мне чертежи и не задерживайся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Обитель Адепта"
				}
			]
		},
		{
			"id": 7180205,
			"completionStepIds": [
				7180204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180204",
							"2"
						],
						"stepId": 7180204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020501,
					"content": "Вы принесли чертежи. Скорей же отдайте их мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Обитель Адепта"
				}
			]
		},
		{
			"id": 7180210,
