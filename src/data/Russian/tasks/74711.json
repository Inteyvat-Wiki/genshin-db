			"dialogs": [
				{
					"id": 747110101,
					"content": "Да! Всё идёт отлично...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110102
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747110102,
					"content": "Теперь я могу сказать точно: работа по спасению агрессивных рыбок приближается к концу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110103
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747110103,
					"content": "Нужно разыскать ещё несколько заболевших рыб, чтобы все получили лечение. Но есть ещё одно особое задание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110104
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747110104,
					"content": "Найти в пострадавших акваториях главные подводные механизмы и извлечь данные, записанные их измерительными приборами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110105,
						747110106
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747110105,
					"content": "Потом проанализировать данные и выявить закономерности?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				},
				{
					"id": 747110107,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110108
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747110108,
					"content": "Ещё мы должны поговорить с владельцами судов и водолазами, чтобы подобное больше не повторялось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747110109,
					"content": "Да, а ещё с рыбаками, туристами, любителями отдыха на воде, ныряльщиками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110110
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747110110,
					"content": "Все, кто так или иначе имеет дело с водой, должны не выбрасывать мусор где попало. Иначе море станет непригодным для жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110111
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747110111,
					"content": "И какая-нибудь сердитая рыбка однажды приплывёт и опрокинет их лодочку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747110106,
					"content": "Чтобы предотвратить подобные инциденты в будущем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				}
			]
		}
	]
