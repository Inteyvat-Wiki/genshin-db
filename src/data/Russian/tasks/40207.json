			},
			"dialogs": [
				{
					"id": 402070201,
					"content": "Привет, Инеффа! Ой, и Ягода здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402070202,
					"content": "Я думаю, что заслужила пирожное за все мои хлопоты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070203
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 402070203,
					"content": "Пирожное? Где пирожные?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402070204,
					"content": "Да, вы как раз вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070205
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070205,
					"content": "Айно решила поблагодарить вас за помощь. Крум-Дзынь-Сладушок-70% вернулся домой целым и невредимым, и Айно хочет угостить вас его творением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070206
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070206,
					"content": "Звяк... звяк...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070207
					],
					"speakerTitle": "Крум-Дзынь-Сладушок-70%"
				},
				{
					"id": 402070207,
					"content": "Ого, так вот как должен выглядеть Сладушок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402070208,
					"content": "Да. К счастью, ядро уцелело, и Айно изготовила для него новый корпус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070209
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070209,
					"content": "Звяк... звяк...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070210
					],
					"speakerTitle": "Крум-Дзынь-Сладушок-70%"
				},
				{
					"id": 402070210,
					"content": "Уже готово?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402070211,
					"content": "Мням...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070212
					],
					"speakerTitle": "Крум-Дзынь-Сладушок-70%"
				},
				{
					"id": 402070212,
					"content": "Эй, он их съел!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402070213,
					"content": "Всё в порядке, повар должен попробовать, что у него получилось, перед тем как подавать блюдо гостям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070214
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 402070214,
					"content": "Не волнуйтесь, как только Сладушок наестся, он приготовит пирожные для гостей. Надо немного подождать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070215
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070215,
					"content": "Ладно... А где Айно? Мы собрались есть сладкое, а её нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402070216,
					"content": "У Айно появилась идея нового робота, и она немедленно заперлась в мастерской. Она всегда так делает, когда приходит вдохновение. В этом вся Айно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070217
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070217,
					"content": "Почему она так одержима роботами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402070218,
					"content": "Гм... Поиск ответа на вопрос. Извлекаю архивные записи из базы данных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070219
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070219,
					"content": "Наверное, поначалу Айно не могла поверить, что в мире существует некий объект, который интересует её больше, чем сладости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070220
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070220,
					"content": "Айно повезло: друзья поддержали её новое увлечение. Хотя всё их время в основном уходило на то, чтобы как-то свести концы с концами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070221
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070221,
					"content": "А потом у Айно появился хороший учитель, который разглядел в ней настоящий талант.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070222
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070222,
					"content": "Как и её друзья, Айно наконец нашла любимое занятие, которое у неё получалось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070223
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070223,
					"content": "Когда гений находит своё истинное призвание, его трудно остановить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070224
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070224,
					"content": "Айно оставила друзей детства и основала мастерскую крумкаке «Дзынь-Клац», чтобы создавать самых разных роботов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070225
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070225,
					"content": "Возможно, всё дело в природном инстинкте гения... Она мечтала увидеть, как её идеи воплощаются в жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070226
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070226,
					"content": "Поэтому она так полюбила создавать роботов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070227
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402070227,
					"content": "Однако мой личный опыт подсказывает, что такой ответ будет неполным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070228
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070228,
					"content": "Ещё до того, как приютить меня, Айно старательно оттачивала свои навыки, чтобы наделить каждого робота индивидуальностью, и считала их своими друзьями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070229
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070229,
					"content": "Я оказалась на особом положении в мастерской вовсе не потому, что у меня необычное прошлое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070230
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070230,
					"content": "Думаю, тропа гениальности увела её так далеко, что кругом не осталось друзей, и Айно почувствовала себя одиноко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070231
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070231,
					"content": "Поэтому мы со Сладушком и остальные роботы, которых сотворила Айно, служим не только доказательством её гениальности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070232
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070232,
					"content": "Мы её семья. Мы друзья, которые ей так нужны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070233
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070233,
					"content": "Насколько я понимаю, таковы отношения между Айно и её роботами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070234
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070234,
					"content": "Вот оно как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402070235,
					"content": "Поэтому Айно мало заботило, обладает ли Крум-Дзынь-Сладушок-70% силой, приводящей в трепет все группировки Нод-Края.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070236
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070236,
					"content": "Она решила, что он станет частью мастерской. А этого достаточно, чтобы Айно сделала всё возможное ради его спасения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070237
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070237,
					"content": "Да, теперь всё ясно! Но Паймон не понимает, почему Айно выбрала жить в Нод-Крае...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402070238,
					"content": "...Боюсь, мой логический модуль не может понять вопрос Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070239
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070239,
					"content": "Паймон имела в виду, что в Нод-Крае за каждым углом тебя поджидает обман и предательство. И люди, которые здесь преуспевают, чувствуют себя в такой среде как рыба в воде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070240
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402070240,
					"content": "Любой другой человек оснастил бы такими технологиями оружие, чтобы держать в страхе всех окружающих.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402070241,
					"content": "Но Айно делает всё наоборот... Мощнейшее оружие она превращает в робота, пекущего торты. Она как будто не отсюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070242
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402070242,
					"content": "Нет, мой логический модуль пришёл к заключению, что всё как раз наоборот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070243
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070243,
					"content": "Мне здесь встречались самые разные люди. Но большинство из них нельзя назвать настоящими нод-крайцами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070244
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070244,
					"content": "Паймон считает, что Айно не вписывается в Нод-Край. А мой логический модуль утверждает, что только такие люди, как Айно, и есть олицетворение Нод-Края.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070245
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070245,
					"content": "Дзынь... Дзынь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070246
					],
					"speakerTitle": "Крум-Дзынь-Сладушок-70%"
				},
				{
					"id": 402070246,
					"content": "Ой, пирожные уже готовы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070247
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 402070247,
					"content": "Да. Секундочку. Сейчас я всем раздам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070248
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070248,
					"content": "Мне то, где крема побольше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070249
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 402070249,
					"content": "Ну вот, угощайтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070250
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402070250,
					"content": "Ммм! Как вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}