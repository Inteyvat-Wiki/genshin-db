				]
			},
			"dialogs": [
				{
					"id": 711450101,
					"content": "#Спасибо вам, {F#советница}{M#советник} {NICKNAME} и {F#её}{M#его} талантливая помощница!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450102
					],
					"speakerTitle": "Су Дин"
				},
				{
					"id": 711450102,
					"content": "Благодаря этим военным играм мы получили множество примеров разных боевых стратегий и сложных сценариев, которые будет полезно проанализировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450103
					],
					"speakerTitle": "Су Дин"
				},
				{
					"id": 711450103,
					"content": "Осталось только расширить модель с учётом характеристик разных типов войск. Затем мы подготовим учебные пособия, в которых будут рассматриваться разные боевые сценарии, и выдадим нашему личному составу для изучения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450104
					],
					"speakerTitle": "Су Дин"
				},
				{
					"id": 711450104,
					"content": "Если хотите, к следующей нашей встрече я и для вас подготовлю новые учебные пособия, чтобы вы в свободное время могли опробовать новые сценарии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450105,
						711450107
					],
					"speakerTitle": "Су Дин"
				},
				{
					"id": 711450105,
					"content": "#И на этом всё? Я бы ещё поиграл{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711450106
					]
				},
				{
					"id": 711450106,
					"content": "Мы знаем, что у вас очень плотный график. Поэтому мы постарались исключить повторение сценариев. Конечно, если вам хочется продолжать военные игры, вам здесь всегда рады!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450109
					],
					"speakerTitle": "Су Дин"
				},
				{
					"id": 711450109,
					"content": "От лица всех Миллелитов и представителей других подразделений выражаю вам свою глубочайшую признательность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450110
					],
					"speakerTitle": "Су Дин"
				},
				{
					"id": 711450110,
					"content": "Надеемся, что в дальнейшем мы сможем продолжить наше сотрудничество, дабы усилить способности разных подразделений противостоять чудовищам и укрепить безопасность на наших землях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450111,
						711450112
					],
					"speakerTitle": "Су Дин"
				},
				{
					"id": 711450111,
					"content": "С превеликим удовольствием!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711450113
					]
				},
				{
					"id": 711450113,
					"content": "Хе-хе, всё прошло замечательно. Мы смогли укрепить связи со знакомыми подразделениями и помогли жителям самых разных уголков Тейвата!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711450114,
					"content": "Да и вообще, наблюдая за военными играми, Паймон и сама многому научилась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711450115,
					"content": "Если нам однажды станет скучно, сможем вернуться и разыграть новые сценарии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711450116,
					"content": "Например... кто победит, маг Бездны или Король снежных кабанов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711450117,
					"content": "Или... у кого голова тяжелее: у стража руин или у геовишапа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711450112,
					"content": "Если будет время!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711450113
					]
				},
				{
					"id": 711450107,
					"content": "Наконец-то всё! Тяжело нам с Паймон пришлось...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711450108
					]
				},
				{
					"id": 711450108,
					"content": "Хи-хи... Паймон ещё не до конца разобралась с правилами, но было весело! Похоже, у нас отлично получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450109
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}