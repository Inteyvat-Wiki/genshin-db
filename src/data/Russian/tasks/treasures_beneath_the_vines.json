			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ульман"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736740101,
					"content": "Ты же сама меня сюда привела, разве нет? Ну давай же, вперёд, вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740102
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740102,
					"content": "Эх, что поделать. Не хочешь, и ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740103,
						736740104
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740103,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740106
					]
				},
				{
					"id": 736740106,
					"content": "Ох, видимо, она опять обманула меня... Сейчас объясню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740107
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740107,
					"content": "Ты, наверное, не поверишь, но я почему-то постоянно привлекаю фей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740108
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740108,
					"content": "Среди всех фей, что летают за мной, я заметил особый вид, который привлекают сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740109
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740109,
					"content": "Так что я назвал их «поисковыми феями». Знаю, знаю, с фантазией у меня не очень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740110
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740110,
					"content": "Они отличные кладоискатели. С их помощью я раскопал уже много сундуков и заработал немного денег.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740111
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740111,
					"content": "Но порой меня будто не существует для них. То ли они устают искать сокровища, то ли я им надоел, не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740112
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740112,
					"content": "Когда это происходит, я ищу помощника, который им приглянется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740113
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740113,
					"content": "В его обязанности входит сопровождение фей на поиски сокровищ, а я, в свою очередь... превращаю эти сокровища в мору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740114
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740114,
					"content": "Говорят, что по всему Сумеру разбросаны руины и старинные реликвии. Вот я и решил испытать удачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740115
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740115,
					"content": "По приезде я снова привлёк к себе целую кучу фей, и несколько поисковых фей привели меня в это место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740116
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740116,
					"content": "Но стоило мне только пару раз копнуть, как эти проказницы опять начали меня игнорировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740117
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740117,
					"content": "Ой! Чего это она вдруг зашевелилась? Неужели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740118
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740118,
					"content": "#{F#Путешественница}{M#Путешественник}, не желаешь ли ты отправиться с ними на охоту за сокровищами? А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740119,
						736740120
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740119,
					"content": "Я?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740121,
					"content": "Да с ними и не нужно общаться. Просто иди за ними, а как остановятся, копай. Вот и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740122
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740122,
					"content": "Ну что? Попробуй! Хм... знаешь что? Мне нужны только древние монеты. Так что если ты найдёшь сокровища, всё остальное можешь оставить себе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740123
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740123,
					"content": "Кроме того, если тебе действительно удастся найти древние монеты, я хорошо за них заплачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740124,
						736740126
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740124,
					"content": "Можно попробовать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740125
					]
				},
				{
					"id": 736740125,
					"content": "Ура! Приятно иметь дела с такими людьми, как ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740130,
					"content": "В любом случае, теперь мы партнёры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740131
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740131,
					"content": "Вот, возьми этот блокнот. Здесь отмечены сокровища, которые я уже нашёл, но ещё не успел раскопать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740132
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740132,
					"content": "#Я рассчитываю на тебя, {F#путешественница}{M#путешественник}! Если найдёшь древние монеты, не забудь принести их мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740126,
					"content": "Что это за древние монеты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740127
					]
				},
				{
					"id": 736740127,
					"content": "Проще говоря, это необычный антиквариат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740128
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740128,
					"content": "С хорошими связями я смогу обменять эти древние монеты на множество отличных вещей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740129
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740129,
					"content": "Вот только со связями мне пока не везёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 736740120,
					"content": "Я с феями общаться не умею...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740104,
					"content": "Это... фея?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740105
					]
				},
				{
					"id": 736740105,
					"content": "Ты об этой крохе? Э... допустим, да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740106
					],
					"speakerTitle": "Ульман"
				}
			]
		},
		{
