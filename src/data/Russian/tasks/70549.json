						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490201,
					"content": "«Пылающая карамель» готова. Приятного аппетита...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490202
					]
				},
				{
					"id": 705490202,
					"content": "Уверена, напиток будет под стать названию... Цвет напоминает горящее пламя, и аромат такой насыщенный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490203
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490203,
					"content": "Кхм... Надо же, какой крепкий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490204,
						705490205
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490204,
					"content": "Всё хорошо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				},
				{
					"id": 705490206,
					"content": "Всё в порядке, это я с непривычки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490207
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490207,
					"content": "Если не ошибаюсь, в последний раз я пила алкоголь в прошлом году, когда Навия пригласила меня на дегустацию вин. Тогда я попробовала вино сорта «Сассика» - сделала всего один глоток, но оно было совсем не таким крепким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490208,
						705490209
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490208,
					"content": "То есть ты вообще не пьёшь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490210,
					"content": "С чисто рациональной точки зрения, алкоголь вызывает головокружение и мешает работе, так что лучше его не употреблять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490211
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490211,
					"content": "Провожая меня в порт, госпожа Фурина обмолвилась, что Мондштадт - «страна вина и поэзии». Я решила, стоит попробовать местные яства...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490212,
						705490213
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490212,
					"content": "Верно. Жаль отказываться от такой возможности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490214,
					"content": "К тому же у меня есть сведения, что капитан разведывательного отряда, с которой у меня будет дружеский поединок... превосходно разбирается в изысканных винах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490215
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490215,
					"content": "Её опубликованные боевые отчёты произвели на меня большое впечатление.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490216
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490216,
					"content": "К тому же капитан Эола, с которой мы недавно устроили дружеский поединок... превосходно разбирается в винах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490217
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490217,
					"content": "Она подарила мне бутылку сока из плодов ромарина. В Фонтейне такой сок больше не производят, сейчас его можно купить только за рубежом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490218
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490218,
					"content": "Глубокое уважение к этой искусной мечнице велит мне углубить свои познания о винах Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490219,
						705490220
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490219,
					"content": "Приготовлю тебе новый коктейль! Только надо подумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490221,
					"content": "Спасибо, я очень тебе признательна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490222
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490222,
					"content": "Ты уже успела прогуляться по Мондштадту?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490223
					]
				},
				{
					"id": 705490223,
					"content": "Да, в первый же день я немного прогулялась по городу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490224
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490224,
					"content": "Навия провела целое исследование. Многие локации и иллюстрации Настольной труппы были вдохновлены пейзажами Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490225
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490225,
					"content": "Правда, атмосфера мира в игре довольно сильно отличается от реального Мондштадта. Моё самое яркое впечатление от Мондштадта - мечи и щиты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490226,
						705490227
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490226,
					"content": "Мечи и щиты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490228,
					"content": "Возможно, потому что я пока видела только кузницы и тренировочные площадки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490229
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490229,
					"content": "В последнее время доспехи и оружие в Мондштадте изготавливаются с применением новой технологии термообработки, в корне отличающейся от фонтейнской, с более высоким содержанием углерода в поверхностном слое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490230
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490230,
					"content": "Новая технология несколько снизила общую прочность оружия, зато значительно повысила его ударостойкость. Мондштадтское оружие пахнет... переваренным кофе. Да, кофе с тремя ложками соли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490231,
						705490232
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490231,
					"content": "#Я... никогда этого не замечал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490233,
					"content": "Должно быть, этот запах запал мне в душу. Видишь ли, сплавы, созданные по фонтейнской технологии, обычно покрываются защитным составом с добавлением маркота.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490234
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490234,
					"content": "Со временем этот едва заметный аромат становится слишком приторным... и приедается. А вот запах мечей и щитов Мондштадта меня совсем не раздражает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490235,
						705490236
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490235,
					"content": "Моя копилка удивительных фактов пополнилась!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490237,
					"content": "Разумеется, эта проблема решается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490238
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490238,
					"content": "В следующий раз, когда окажешься в Фонтейне, я порекомендую тебе другое защитное средство: оно вообще без запаха, как вода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490239
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490239,
					"content": "Если ты тоже не любишь, когда тебя душат сладкими ароматами, оно наверняка тебе понравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490240
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490240,
					"content": "Что ты обычно пьёшь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490241
					]
				},
				{
					"id": 705490241,
					"content": "Обычно? В рабочее время я пью кофе. А с едой мне нравится пить разбавленный сок пузырина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490242
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490242,
					"content": "Я ем много мяса, и поначалу я выбирала пузыриновый сок, чтобы его кислинка уравновешивала жирность мяса. Со временем я полюбила и сам этот терпко-кислый вкус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490243
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490243,
					"content": "Сегодня после поединка гостеприимные рыцари пригласили меня попробовать фирменные блюда мондштадтской кухни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490244
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490244,
					"content": "Все восемь мясных блюд, которые я попробовала, очень мне понравились: большие порции, отменное мясо, идеальная прожарка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490245
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490245,
					"content": "Конечно, нет пределов совершенству. Например, для подачи туристам соус в медовом мясе с морковкой и блюде «Расти гора» лучше делать не таким насыщенным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490246,
						705490247
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490246,
					"content": "А ты успела перепробовать много блюд...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490248,
					"content": "Я попробовала все мясные блюда. Запаслась калориями на три дня вперёд, так что новые приглашения пообедать пришлось вежливо отклонить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490249
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490249,
					"content": "Сейчас главное - избавиться от ощущения тяжести... Не беда, что-нибудь придумаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490250
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490250,
					"content": "Это подарок от рыцарей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490251
					]
				},
				{
					"id": 705490251,
					"content": "Да, этот значок мне подарили рыцари с кодовыми именами «Фундук 3» и «Фундук 5». Очень искусная работа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490252
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490252,
					"content": "Они сказали, что разработали этот значок совсем недавно, чтобы дарить важным гостям. А над орденом, предназначенным специально для тебя, работа ещё не закончена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490253,
						705490254
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490253,
					"content": "Я впервые слышу о рыцарях с такими именами...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490255,
					"content": "...Да, я тоже не помню имена всех клерков из Дворца Мермония.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490256
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490256,
					"content": "Впрочем, ты ещё с ними познакомишься. Сразу видно, что это опытные воины: заняты кабинетной работой, но с боевым снаряжением расставаться не спешат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490257
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490257,
					"content": "Уладив мои дела, они отправились в таверну - сказали, что хотят продолжить вчерашнюю дуэль и всё-таки выяснить, кто может больше выпить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490258
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490258,
					"content": "Хоть и пьют пиво бочками, но на следующий день спокойно выходят на работу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490259,
						705490260
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490259,
					"content": "Да, это Мондштадт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490261,
					"content": "Да, на первый взгляд может показаться, что жители Мондштадта слишком беззаботны, однако они хорошо знают свою «меру» в выпивке. Качество, достойное уважения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490262
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490262,
					"content": "Кстати, госпожа Эмилия тоже сюда заходила...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490263
					]
				},
				{
					"id": 705490263,
					"content": "Да? Значит, поручение она уже выполнила. Как быстро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490264
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490264,
					"content": "Скорее всего, как вернусь в Фонтейн, можно будет обрадовать Сиджвин, что новые духи готовы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490265
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490265,
					"content": "Да? Вы с Эмилией хорошо знакомы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490266
					]
				},
				{
					"id": 705490266,
					"content": "Ну, не совсем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490267
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490267,
					"content": "По пути в Мондштадт я оказалась на одном корабле с госпожой Эмилией, и мы немного побеседовали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490268
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490268,
					"content": "Раньше я часто слышала, как Сиджвин хвалила её работы, но после нашего разговора поняла... что она очень скромный человек, при этом на редкость утончённый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490269,
						705490270
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490269,
					"content": "Скромный и утончённый?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490271,
					"content": "Госпожа Эмилия мягкая, спокойная, но она не подпускает людей слишком близко... Возможно, дело в её профессии. Кажется, она выработала идеальный подход к общению с людьми: он позволяет ей сохранять душевный покой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490272,
						705490273
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490272,
					"content": "Хочешь собраться и посидеть как-нибудь втроём?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490274,
					"content": "Спасибо, но не стоит специально пытаться нас подружить. По работе мы пересечься не можем, и наши социальные круги имеют мало общего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490275
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490275,
					"content": "Пусть всё идёт своим чередом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490276
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490276,
					"content": "Эмилия любит чай. А ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490277
					]
				},
				{
					"id": 705490277,
					"content": "То есть ты уже думаешь, чем будешь нас угощать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490278
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490278,
					"content": "Судя по опыту, у нас с Эмилией схожий уровень устойчивости к алкоголю. Наш максимум - фруктовые ликёры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490279
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490279,
					"content": "Так что, если встреча всё же случится, лучше приготовь для нас напитки одинаковой крепости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490280
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490280,
					"content": "Кажется, я знаю, как улучшить рецепт. Подожди немного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490281
					]
				},
				{
					"id": 705490281,
					"content": "Хорошо. Я тоже должна немного подготовиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490282
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490282,
					"content": "Даже если коктейль окажется слишком крепким, я постараюсь его допить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490273,
					"content": "Может, как-нибудь вместе прогуляемся по Фонтейну?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490270,
					"content": "Очень точная характеристика.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490260,
					"content": "Мондштадтцы привыкли расслабляться после работы с помощью выпивки!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490254,
					"content": "В ордене служит столько людей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490247,
					"content": "Ты попробовала все мондштадтские мясные блюда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490236,
					"content": "#Я не знал{F#а}, что в оружейном деле есть столько тонкостей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490232,
					"content": "Какое меткое сравнение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490227,
					"content": "Почему?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490220,
					"content": "Я немного изменю рецепт, чтобы ты осталась довольна!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490213,
					"content": "Если знать меру, всё должно быть в порядке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490209,
					"content": "Если ты не пьёшь алкоголь, не надо себя заставлять...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490205,
					"content": "Дать тебе воды?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				}
			]
		},
		{
			"id": 7054903,
