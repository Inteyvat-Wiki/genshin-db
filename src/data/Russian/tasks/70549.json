							-778.945
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490101,
					"content": "Догадка подтвердилась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490102
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490102,
					"content": "Прогуливаясь неподалёку, я почувствовала знакомую ауру, подошла ближе: так и есть, это ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490103,
						705490104
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490103,
					"content": "Привет, Клоринда!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				},
				{
					"id": 705490105,
					"content": "Если бы госпожа Шарлотта увидела эту сцену, она бы сделала сотню снимков, не меньше. И написала бы репортаж с таким заголовком:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490106
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490106,
					"content": "#«Тайная жизнь {F#блестящей фехтовальщицы}{M#блестящего фехтовальщика}: эксклюзивные коктейли от {F#искательницы}{M#искателя} приключений»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490107
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490107,
					"content": "#Завтра ты {F#оказалась}{M#оказался} бы на первых полосах всех газет, и вскоре здесь собралась бы целая толпа туристов из Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490108,
						705490109
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490108,
					"content": "Думаю, ты преувеличиваешь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490110,
					"content": "К счастью для тебя, я вежливо отказала госпоже Шарлотте, когда она предложила составить мне компанию, так что ничего подобного не случится. Можем наслаждаться тишиной и покоем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490111
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490111,
					"content": "Да, мне «Пылающую карамель», пожалуйста...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490112
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490112,
					"content": "...Судя по выражению лица, у тебя ко мне много вопросов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490113,
						705490114
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490113,
					"content": "Сначала приготовлю тебе коктейль.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490115,
					"content": "Ты держишься так непринуждённо... Не знала, что ты и в коктейлях профессионал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490114,
					"content": "Выпьешь, и ответишь на все вопросы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490109,
					"content": "#Я бы не {F#справилась}{M#справился} с таким наплывом клиентов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490104,
					"content": "Добро пожаловать! Присаживайся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				}
			]
		},
		{
			"id": 7054902,
