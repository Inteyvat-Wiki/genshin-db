						"position": [
							2194.696,
							230.219,
							-778.945
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490301,
					"content": "Итак, новый коктейль... под названием «Молния в час досуга».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490302
					]
				},
				{
					"id": 705490302,
					"content": "Эксклюзивный рецепт для судебных дуэлянтов. Угощайся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490303
					]
				},
				{
					"id": 705490303,
					"content": "Мм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490304
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490304,
					"content": "#Хм? Ты добавил{F#а} туда фруктовое вино? Очень приятный вкус, в самый раз для меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490305
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490305,
					"content": "Немного соли в сочетании с мягкой фруктовой кислинкой и нежной сладостью карамели: идеальный баланс вкусов в каждом глотке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490306
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490306,
					"content": "Цвет коктейля отлично гармонирует с названием, а образ молнии становится параллелью образу пламени в коктейле «Пылающая карамель»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490307
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490307,
					"content": "Но откуда взялся «час досуга»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490308,
						705490309
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490308,
					"content": "Мондштадт - страна, где очень заботятся об отдыхе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490310
					]
				},
				{
					"id": 705490310,
					"content": "Ясно... Да, очень похоже на ощущения от этого коктейля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490311
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490311,
					"content": "Его неповторимый вкус и аромат займут особое место в моих воспоминаниях о Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490312,
						705490313
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490312,
					"content": "#Я рад{F#а}, что тебе понравилось!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490314
					]
				},
				{
					"id": 705490314,
					"content": "Скажи, если появится такая возможность, тебе будет интересно поработать барменом в кафе или в «Дебор Отеле»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490315
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 705490315,
					"content": "А почему ты спрашиваешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490316
					]
				},
				{
					"id": 705490316,
					"content": "Я бы и сама хотела ещё раз попробовать твой шедевр, но вообще я интересуюсь для Навии и госпожи Фурины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
