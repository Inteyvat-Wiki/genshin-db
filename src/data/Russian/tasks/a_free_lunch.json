			"dialogs": [
				{
					"id": 741660601,
					"content": "Это подъёмник на производственный участок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660602
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660602,
					"content": "А об этом месте нет каких-нибудь слухов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741660603,
					"content": "Нет, никаких. Просто я ненавижу это место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660604
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660604,
					"content": "А? Почему же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741660605,
					"content": "Потому что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660606
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660606,
					"content": "Потому что?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741660607,
					"content": "Потому что я не хочу работать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660608
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660608,
					"content": "Я попал сюда потому, что не хотел работать и украл хлеб, когда был голоден. В итоге меня осудили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660609
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660609,
					"content": "Так почему теперь я должен работать в крепости Меропид?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660610
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660610,
					"content": "«Даже небольшая работа может сшибить меня с ног!» - таков мой жизненный девиз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660611
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660611,
					"content": "Ух! Похоже, здесь ему не по себе. Лучше пойдём куда-нибудь ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
