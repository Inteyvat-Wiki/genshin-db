				]
			},
			"dialogs": [
				{
					"id": 741660201,
					"content": "#Эй, {M#юноша}{F#барышня}! Да-да, ты! Иди сюда, давай, скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660202,
					"content": "А? Это ты нам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741660203,
					"content": "О, друзья мои, я сразу понял, что вы здесь новички. Наверное, вы ещё не слишком знакомы с крепостью Меропид?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660204,
					"content": "Поздравляю! Вам повезло встретиться с нужным человеком. Я добрейший обитатель крепости Меропид.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660205,
					"content": "Позвольте мне сегодня показать вам крепость. Разумеется, это всё «бесплатно».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660206,
					"content": "#Вообще-то я уже хорошо знаком{F#а} с этим местом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "О, не говори так!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660208,
					"content": "Может, тебе кажется, что ты всё здесь отлично знаешь, но уверен, под моим руководством ты обнаружишь немало нового.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660209,
					"content": "Совершенно бесплатно? Такое нечасто встретишь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "Конечно, конечно! Как я уже сказал, человека добрее меня в крепости не найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660211,
					"content": "Хм, этот тип какой-то подозрительный. Мы только познакомились, а он уже строит из себя нашего лучшего друга!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741660212,
					"content": "Ха-ха, вам не стоит тревожиться об этом, друзья. Давайте так: вы обсудите моё предложение, а я подожду здесь вашего решения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660213,
					"content": "Когда придёте к согласию, разыщите меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Странный человек"
				}
			]
		},
