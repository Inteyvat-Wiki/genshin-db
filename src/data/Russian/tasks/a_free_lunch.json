				]
			},
			"dialogs": [
				{
					"id": 741660401,
					"content": "Это купонная столовая, каждый день здесь можно получить одну порцию бесплатного питания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660402
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660402,
					"content": "Единственная проблема заключается в том, что лишь судьба решает, что вам попадёт на стол в этот день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660403
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660403,
					"content": "Это твоя экскурсия? Да это с первого дня все знают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741660404,
					"content": "Подождите, у меня есть секретная информация на этот счёт. Говорят, что если шепнуть Брану тайное слово при получении бесплатного питания, можно получить легендарное секретное блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660405
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660405,
					"content": "Правда? И что это за тайное слово?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741660406,
					"content": "Увы, мне оно неизвестно. Дождусь, когда вы сами его откроете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660407
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660407,
					"content": "Фразочка в стиле Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741660408,
					"content": "Не беспокойтесь о подобных пустяках. Далее по курсу Трёхкупонная труппа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Странный человек"
				}
			]
		},
