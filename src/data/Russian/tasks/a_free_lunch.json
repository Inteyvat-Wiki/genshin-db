			},
			"dialogs": [
				{
					"id": 741660301,
					"content": "Ну как? Всё обсудили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660302
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660302,
					"content": "Но ты сам сказал, это будет совершенно бесплатно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741660303,
					"content": "Разумеется, разумеется. Абсолютно «бесплатно».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "Странный человек"
				},
				{
					"id": 741660304,
					"content": "Идёмте, я покажу вам крепость Меропид во всей красе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Странный человек"
				}
			]
		},
