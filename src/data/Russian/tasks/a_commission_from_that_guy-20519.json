			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вэл"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190201,
					"content": "#Ты так быстро справил{F#ась}{M#ся}? Впечатляет. Теперь понятно, почему ты тому господину так нравишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190202,
						205190204
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205190202,
					"content": "Где деньги?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190203
					]
				},
				{
					"id": 205190203,
					"content": "А ты всё-таки бука. Награда твоя здесь. Но ты и меня пойми, я человек подневольный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205190204,
					"content": "Я ценю твою доброту.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190205
					]
				},
				{
					"id": 205190205,
					"content": "Взаимно. Вот, забери награду. И ещё... С тобой приятно работать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				}
			]
		},
		{
			"id": 2051903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
