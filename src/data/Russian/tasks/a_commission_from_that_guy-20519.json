			"dialogs": [
				{
					"id": 205190501,
					"content": "Ты... Чем я могу тебе помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190502
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 205190502,
					"content": "Я всё ещё ожидаю ответа сестры Виктории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
