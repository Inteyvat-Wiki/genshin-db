			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хоффман"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190301,
					"content": "Эти Похитители сокровищ... О, прости. Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190302
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 205190302,
					"content": "Вокруг Мондштадта промышляют банды Похитителей сокровищ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190303
					]
				},
				{
					"id": 205190303,
					"content": "Похитители сокровищ? Мы как раз напали на след одной из их групп. Хватило же этим негодяям наглости подобраться к Мондштадту. Вдобавок мы не знаем, что они задумали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190304
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 205190304,
					"content": "Наверняка что-то недоброе. Мы отправили много людей, чтобы дать им отпор... Боюсь, разбираться с твоим докладом сейчас некому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190305
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 205190305,
					"content": "Всё же я возьму его на заметку. Когда с Похитителями сокровищ будет покончено, то я передам его куда следует. Спасибо, что докладываешь нам о происходящем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хоффман"
				}
			]
		},
		{
			"id": 2051904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
