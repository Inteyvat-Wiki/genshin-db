						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051903",
							"2"
						],
						"stepId": 2051903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вэл"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190401,
					"content": "#Всё ещё готовишься? Ладно. Выдвигайся, как только будешь готов{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190402,
						205190406
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205190402,
					"content": "Кто всё-таки этот господин такой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190403
					]
				},
				{
					"id": 205190403,
					"content": "Сказать я тебе этого не могу, как ты меня ни расспрашивай. Таковы реалии нашей работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190404
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205190404,
					"content": "Если даже мы какие-либо из сведений и раскрываем, так только потому, что это нужно нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190405
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205190405,
					"content": "Вот, пораскинь мозгами: что из сказанного мною ранее подходит под эту категорию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205190406,
					"content": "Какова ваша цель?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190407
					]
				},
				{
					"id": 205190407,
					"content": "Цель... Чего добивается тот господин, я разгадать не смогла. Но наверняка он тоже желает защитить Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190408
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205190408,
					"content": "Скажем так... В столь важных делах он согласно своему увлечению действовать не станет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190409
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205190409,
					"content": "Так, стоп. Мне и задумываться о таком не стоит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				}
			]
		},
