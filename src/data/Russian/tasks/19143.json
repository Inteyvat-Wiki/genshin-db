						191431102
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 191431102,
					"content": "Х-хорошо. М-мы будем здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431103
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 191431103,
					"content": "Это пока что вы здесь будете. Знаю я вас. Как отдохнёте, так потом только сверкающие пятки вдалеке увидим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431104
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 191431104,
					"content": "М-мы не посмеем! Никогда-никогда больше!",
