			"dialogs": [
				{
					"id": 191430901,
					"content": "Подметал я, значит, себе, никому не мешал, как вдруг снаружи поднялся шум.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430902
					],
					"speakerTitle": "Айкава Сусуму"
				},
				{
					"id": 191430902,
					"content": "Вышел и вижу... <color=#00E1FFFF>Тень метнулась на дерево!</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430903
					],
					"speakerTitle": "Айкава Сусуму"
				},
				{
					"id": 191430903,
					"content": "Неужто воры какие пожаловали...",
