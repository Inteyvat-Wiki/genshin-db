				"points": []
			},
			"dialogs": [
				{
					"id": 735340901,
					"content": "Так это ты тот чудесный друг, о котором говорила Дхармакирти? Пиюш, рад знакомству. Я работаю в области архитектуры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340902
					],
					"speakerTitle": "Пиюш"
				},
				{
					"id": 735340902,
					"content": "Кавех рассказывал о тебе, но мне не довелось раньше с тобой познакомиться, так что можно считать это счастливым совпадением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340903
					],
					"speakerTitle": "Пиюш"
				},
				{
					"id": 735340903,
					"content": "Думаю, мне приснится проект, который я только что сдал. Это был сущий кошмар... Жаль, что наша первая встреча проходит в такой формальной обстановке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пиюш"
				}
			]
		},
