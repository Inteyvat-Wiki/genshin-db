			},
			"dialogs": [
				{
					"id": 735340101,
					"content": "Привет! Это ты помогаешь мне в терапии? Честно говоря, я не знаю, о чём будет мой сон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340102
					],
					"speakerTitle": "Коллингвуд"
				},
				{
					"id": 735340102,
					"content": "Я из Мондштадта, и у меня нет увлечений... Ну, кроме выпивки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340103
					],
					"speakerTitle": "Коллингвуд"
				},
				{
					"id": 735340103,
					"content": "И я из тех, кто иногда совершает ошибки, когда напивается, так что... Я рассчитываю на тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Коллингвуд"
				}
			]
		},
