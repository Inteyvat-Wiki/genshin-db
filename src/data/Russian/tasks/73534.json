			"dialogs": [
				{
					"id": 735340301,
					"content": "Приятно познакомиться. Скоро мы погрузимся в сон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340302
					],
					"speakerTitle": "Ю Гуан"
				},
				{
					"id": 735340302,
					"content": "Я Ю Гуан, стражница из Ли Юэ. Недавно на службе я столкнулась с чем-то... недобрым, и с тех пор не могу нормально спать. Поэтому я и обратилась за помощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340303
					],
					"speakerTitle": "Ю Гуан"
				},
				{
					"id": 735340303,
					"content": "Будет здорово, если я смогу избавиться от кошмаров с помощью этой терапии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ю Гуан"
				}
			]
		},
		{
