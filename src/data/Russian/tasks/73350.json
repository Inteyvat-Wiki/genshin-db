			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Август Лавлейс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500401,
					"content": "А... Апчхи! Ох, эти специи такие... А... Апчхи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500402
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500402,
					"content": "Давайте просто сделаем снимок и вернёмся в дом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500403
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500403,
					"content": "#{NICKNAME}! {NICKNAME}, постой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500404,
						733500405
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500404,
					"content": "Ты мне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500406
					]
				},
				{
					"id": 733500406,
					"content": "Я хотел попросить тебя сделать для меня снимок. Всего один. Это не займёт много времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500409
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500409,
					"content": "Я с трудом могу вынести запах этих пряностей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500410
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500410,
					"content": "В Фонтейне мы не добавляем в еду никаких специй. Максимум - соль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500411
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500411,
					"content": "Здесь я чихаю постоянно... Апчхи! Даже фотокамеру ровно держать сложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500412
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500412,
					"content": "Поэтому мне приходится обращаться за помощью, чтобы сделать снимок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500413
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500413,
					"content": "Ты добрый человек, поэтому прошу тебя помочь мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500414
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500414,
					"content": "Ты из Фонтейна?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500415
					]
				},
				{
					"id": 733500415,
					"content": "Да, так и есть. Простите, забыл представиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500416
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500416,
					"content": "Меня зовут Август Лавлейс. Я исследователь из Научно-исследовательского института кинетической энергии Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500417,
						733500418
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500417,
					"content": "Научно-исследовательский институт кинетической энергии Фонтейна?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500419
					]
				},
				{
					"id": 733500419,
					"content": "Название слишком длинное, не находите? Вы можете назвать его Исследовательским институтом Фонтейна, все в Фонтейне его так называют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500420
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500420,
					"content": "В былые времена можно было сказать, что Исследовательский институт Фонтейна был священным местом для учёных. Именно там мы создали значительную часть механизмов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500421
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500421,
					"content": "Но сейчас, под председательством талантливого месье Эдвина, большинство зданий института лежит в руинах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500422
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500422,
					"content": "А после того, как за реконструкцию принялись господа Раймонд и Шуазёль, упал и «исследовательский дух».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500423
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500423,
					"content": "Я из тех, кто любит чистоту. Я не захотел жить среди груды хлама, поэтому отправился в путешествие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500424
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500424,
					"content": "Не хмурьтесь, эти тревоги никак не связаны с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500425
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500425,
					"content": "Прошу, поскорее сделайте для меня фото. Когда Ксавье увидит красоты Сумеру, он не сможет дальше оставаться в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500426,
						733500436
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500426,
					"content": "У нас были кое-какие общие дела...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500427
					]
				},
				{
					"id": 733500427,
					"content": "#Вы... Так это вы {F#та}{M#тот} путешественни{F#ца}{M#к}, о котор{F#ой}{M#ом} говорил Ксавье?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500428
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500428,
					"content": "Вот так везение! Я знаю о вас из писем Ксавье, мне известно о ваших героических поступках в Горне Микагэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500429
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500429,
					"content": "Кроме того, каждый раз, когда речь заходит о фильмах, Ксавье отмечает ваше первоклассное актёрское мастерство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500430
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500430,
					"content": "Он утверждает, что вы бесстрашны и благородны. А кроме того, у вас прекрасное чувство юмора!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500431
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500431,
					"content": "Ах, когда сделаете снимок, обязательно подпишите его для меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500432
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500432,
					"content": "У Ксавье всё хорошо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500433
					]
				},
				{
					"id": 733500433,
					"content": "Хм... по правде говоря, не очень. Он всё время переживает из-за фильмов. Из его писем понятно, что последнее время ему никак не удаётся найти новый интересный материал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500434
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500434,
					"content": "Я посоветовал ему поступить так же, как сделал я: отложить на время работу и приехать в Сумеру развеяться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500435
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500435,
					"content": "Но он всё время говорит, что должен снять отличный фильм для комиссии Ясиро. А пока он не может уехать из Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500441
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500441,
					"content": "Но не будем об этом. Прошу вас, помогите мне сделать фотографию. Можно прямо здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500436,
					"content": "Как вы познакомились с Ксавье?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500437
					]
				},
				{
					"id": 733500437,
					"content": "Почти уверен, что вам известно, что Ксавье - один из учёных Исследовательского института Фонтейна. Когда-то мы работали в одной лаборатории, он наставлял меня и помогал с моей работой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500438
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500438,
					"content": "Он был одержим съёмками «фильмов», и хотел быть режиссёром. В те времена в Исследовательском институте Фонтейна подобное заявление восторгов не вызывало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500439
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500439,
					"content": "Несмотря на то, что позднее его привлекали к другим проектам, он по-прежнему записывал процесс исследований на камеру, снимал свои «документальные фильмы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500442
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500442,
					"content": "Так он переходил от проекта к проекту, от исследования к исследованию, пока его, в конце концов, не отправили в Инадзуму...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500440
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500440,
					"content": "Человек с блестящими идеями! Если бы он только родился в милосердном прошлом, когда исследования были передовыми, а финансирование щедрым, или в светлом будущем, он бы смог добиться ещё более выдающихся результатов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500441
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500418,
					"content": "Что это за место?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500419
					]
				},
				{
					"id": 733500405,
					"content": "Что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500406
					]
				}
			]
		}
	]
}