			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Август Лавлейс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500201,
					"content": "Вы сделали для меня фото?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500202
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500202,
					"content": "Ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500203
					]
				},
				{
					"id": 733500203,
					"content": "О, не торопитесь. Фотографирование - дело непростое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Август Лавлейс"
				}
			]
		},
		{
			"id": 7335003,
			"completionStepIds": [
				7335003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7335003",
							"2"
						],
						"stepId": 7335003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Август Лавлейс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500301,
					"content": "Это фото очень неплохое, у вас талант.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500302
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500302,
					"content": "С самого начала моего путешествия впервые вижу, чтобы кто-то настолько разбирался в цвете и композиции кадра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500303
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500303,
					"content": "Где ты бывал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500304
					]
				},
				{
					"id": 733500304,
					"content": "Ну, можно было напрямую из Фонтейна в Сумеру приехать... есть же прямая линия до гавани Бейда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500312
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500312,
					"content": "Но, как говорится, самое важное в путешествии - это процесс, поэтому я выбрал... более интересный маршрут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500313
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500313,
					"content": "Через порт Люмидус я попал в долину Чэньюй. Я побывал в деревне Цинцэ и оттуда добрался до Каменных врат, отделяющих Мондштадт и Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500310
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500310,
					"content": "Посетив винокурню «Рассвет», я решил продолжить путешествие на юг, чтобы лучше познакомиться с Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500305
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500305,
					"content": "Из Ли Юэ я на пароме добрался до Порт-Ормоса. Затем через реку на север - и вот я здесь встретил вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500306
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500306,
					"content": "В конце концов, целью этого путешествия был отдых. Если бы я любил риск и опасности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500311
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500311,
					"content": "...я бы начал с порта Ромарин, совершил паломничество на юг, вглубь пустыни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500307
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500307,
					"content": "...Кто знает? Может быть, на обратном пути я бы попробовал пересечь пустыню. А ведь у меня достаточно средств. Может, отправиться сквозь пустыню, чтобы посмотреть Натлан...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500308
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500308,
					"content": "Что ж, не буду задерживать вас. Благодарю за помощь, примите это в качестве благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500309
					],
					"speakerTitle": "Август Лавлейс"
				},
				{
					"id": 733500309,
					"content": "Мне нужно поскорее написать Ксавье. Если он не поторопится в Сумеру, мне придётся вернуться в Фонтейн...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Август Лавлейс"
				}
			]
		},
