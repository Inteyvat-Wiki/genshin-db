						"rawParams": [
							"7050404",
							"2"
						],
						"stepId": 7050404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Розария",
					"Кэйа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040201,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040202
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040202,
					"content": "Что такое, Розария? Тебе не нравится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705040203,
					"content": "Я могу переделать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040204
					]
				},
				{
					"id": 705040204,
					"content": "Нет, напиток хороший. Я просто редко пью чай, и его вкус навевает на меня воспоминания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040205
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040205,
					"content": "А, ты говоришь о церкви, полагаю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040206
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040206,
					"content": "Да. Однажды в церкви проходило мероприятие, на котором я не смогла присутствовать, но сестра Барбара всё равно оставила для меня немного чая и десерта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040207
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040207,
					"content": "Десерт уже зачерствел, поэтому она тайком его выбросила, но чай был на вкус точно таким же, как этот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040208
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040208,
					"content": "Хм, нечасто тебя увидишь такой, Розария.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705040209,
					"content": "Кажется, в Мондштадте появился ещё один любитель чая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040210
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040210,
					"content": "Хех, мне по душе что-нибудь покрепче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040211
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040211,
					"content": "Кэйа, а как тебе напиток?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040212
					]
				},
				{
					"id": 705040212,
					"content": "Ну, если я укажу на несколько недостатков, ты сделаешь мне другой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040213
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040213,
					"content": "Ха-ха-ха! Шутка! Конечно, я так с тобой не поступлю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040214
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040214,
					"content": "Ой! С этим Кэйей никогда не знаешь, что он выкинет! Розария, как ты можешь с ним пить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705040215,
					"content": "Хм? Да мне без разницы, что у него на уме, когда мы пьём, то мало что обсуждаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040216
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040216,
					"content": "Кроме того, у Кэйи в голове только то, что его заинтриговало, будь то вы или здешний трактирщик, или кто-то ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040217
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040217,
					"content": "Эй! Как ты можешь так просто сдать своего дорогого собутыльника?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040218
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040218,
					"content": "Сдать? Вот ещё придумал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040219
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040219,
					"content": "Мне и в жизни хватает ханжей вокруг, а в таверне я предпочитаю расслабляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040220
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040220,
					"content": "Ханжей? Посплетничаем о тех, кто старается всё делать правильно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040221
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040221,
					"content": "Кстати говоря, я знаю, кого с лёгкостью можно записать в тройку самых праведных людей в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040222
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040222,
					"content": "В такой степени, что... Да хоть в лицо такому человеку объяви о его праведности, а он и глазом не моргнёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040223
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040223,
					"content": "Ой, а есть такой список?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705040224,
					"content": "Конечно. У меня в голове есть куча списков: самых заядлых выпивох, самых трудолюбивых работников, худших поваров и даже... величайших хранителей тёмных тайн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040225
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040225,
					"content": "Паймон думает, что у мондштадтцев слишком много свободного времени!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705040226,
					"content": "Неужели и впрямь столько людей слоняются без работы, занимаясь всем этим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040227,
						705040228
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040227,
					"content": "Нет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				},
				{
					"id": 705040229,
					"content": "#Ой, а как же Паймон? Мы можем вместе с {F#путешественницей}{M#путешественником} попасть в какой-нибудь список?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040230
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705040230,
					"content": "Конечно. Например, лучших барменов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040231
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040231,
					"content": "П-правда?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705040232,
					"content": "#Как здорово, {NICKNAME}! Наши имена войдут в историю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705040233,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040234
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040234,
					"content": "Ну, признаюсь, атмосферка тут очень даже ничего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040235
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040235,
					"content": "#Ещё бы! Сплошная радость смотреть на Паймон и путешественни{F#цу}{M#ка}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040236
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040236,
					"content": "Такая тёплая и уютная атмосфера идёт на пользу любой таверне. Кажется, вы и правда заслуживаете звания лучших барменов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040237
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040237,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705040238,
					"content": "Хех, ничего. Спасибо за ваше гостеприимство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040239
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040239,
					"content": "Да, мне тоже пора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040240
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040240,
					"content": "Кстати, чай был великолепен. Когда-нибудь я себе сама такой приготовлю... Ну, если смогу встать пораньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040241
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040241,
					"content": "До встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040242
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040242,
					"content": "Приходите ещё.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705040228,
					"content": "Кажется, я знаю, о ком он говорит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				}
			]
		}
	]
}