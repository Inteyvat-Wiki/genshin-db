					"Розария"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040101,
					"content": "Вот так сюрприз. Не ожидал увидеть вас двоих за барной стойкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040102
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040102,
					"content": "Тогда мне стаканчик Полуденной смерти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040103
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040103,
					"content": "Кэйа - настоящий мастер усложнять другим жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040104
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040104,
					"content": "#Ой, да я просто хотел посмотреть, как отреагирует {NICKNAME}. Не ожидал встретить тебя здесь сегодня, Розария.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040105
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040105,
					"content": "#В таверну приходит так много привередливых посетителей. Так что я просто хочу помочь путешественни{F#це}{M#ку} набраться опыта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040106
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040106,
					"content": "И вот он опять всех заболтал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705040107,
					"content": "Не поймите меня неправильно, я всего лишь пытался быть полезным! Лучше бы спасибо сказали. Ладно, давай для начала что-то попроще. Например, Лунный переулок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040108
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040108,
					"content": "И, пожалуйста, большую кружку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040109
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 705040109,
					"content": "А мне сделай на своё усмотрение. Любой чай, только не в самой большой кружке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040110
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705040110,
					"content": "Ясно. Одну минуту.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040111
					]
				},
				{
					"id": 705040111,
					"content": "Не торопись. Предвкушение - половина удовольствия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэйа"
				}
			]
		},
		{
			"id": 7050402,
			"completionStepIds": [
				7050404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
