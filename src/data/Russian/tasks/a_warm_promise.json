					}
				]
			},
			"dialogs": [
				{
					"id": 765070101,
					"content": "#О, {NICKNAME}, посмотри, посмотри! Не успели мы и опомниться, как альбом заполнился фотографиями! И каждая из них прекрасна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070102,
						765070103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765070102,
					"content": "Да, как быстро летит время!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				},
				{
					"id": 765070104,
					"content": "Кто бы мог подумать, что мы найдём столько прекрасных мест и столько друзей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765070105,
					"content": "Только посмотри на это фото! Сколько усилий потребовалось, чтобы подобрать идеальный ракурс. Но результат того стоит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070106,
						765070107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765070106,
					"content": "Хвала таланту Паймон выбирать дорогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070108,
					"content": "Хи-хи, само собой. Паймон самый компетентный и заботливый проводник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765070109,
					"content": "Мы запечатлели столько счастливых воспоминаний. Оно того стоило.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765070110,
					"content": "#{NICKNAME}, как тебе фотокамера? Есть ли чувство, что твои навыки разительно улучшились и ты скоро сравняешься с мастером Ле Бланом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070111,
						765070112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765070111,
					"content": "Навыки... Надо ещё потренироваться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070113,
					"content": "#Да, верно говоришь, самое главное - это радость. Кроме того, Паймон кажется, что твои снимки, {NICKNAME}, ничуть не хуже фотографий великого мастера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765070114,
					"content": "Это потому, что за каждым из этих кадров скрыта история, и для Паймон это незаменимые шедевры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765070115,
					"content": "И потом, когда мы... Да, когда мы будем путешествовать где-нибудь ещё, будет здорово вспомнить эти моменты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765070116,
					"content": "И сделать ещё много новых фотографий.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070117
					]
				},
				{
					"id": 765070117,
					"content": "Хорошо! Значит, договорились! Следующий фотоальбом будет ещё ярче! Отправляемся создавать уникальные воспоминания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765070112,
					"content": "Самое главное - получать удовольствие от процесса.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070107,
					"content": "И спасибо «резерву на случай непредвиденных расходов».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070103,
					"content": "За каждой из этих фотографий таятся воспоминания.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				}
			]
		}
	]
}