			"dialogs": [
				{
					"id": 752520601,
					"content": "Ты был в баре. Мы уже виделись.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520602
					]
				},
				{
					"id": 752520602,
					"content": "Да? Неудивительно, что твоё лицо показалось мне знакомым. Но я сегодня повстречал много людей, так что не могу точно сказать... Но это неважно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Текутли"
				}
			]
		},
		{
			"id": 7525207,
			"completionStepIds": [
				7525205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
