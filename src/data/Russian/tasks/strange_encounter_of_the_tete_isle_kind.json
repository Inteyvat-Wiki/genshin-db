				"objectNames": [
					"Текутли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752520701,
					"content": "#Главное: не встречал{F#a} ли ты здесь лысого парня? Мне нужно с ним поговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520702,
						752520703
					],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752520702,
					"content": "Я тоже его ищу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520704
					]
				},
				{
					"id": 752520704,
					"content": "Он был здесь? Хм, похоже, он убежал. Наверное, понял, что я его ищу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520709
					],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752520709,
					"content": "Хм... тебе от меня не спрятаться, Икахуа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752520706,
					"content": "Раз уж судьба нас уже сводила, дам тебе совет: держись подальше и от меня, и от того лысого типа. А то придётся эти честные глазёнки выколоть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520707
					],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752520707,
					"content": "Это то, что я обнаружил в лагере. По-видимому, он не успел забрать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520708
					],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752520708,
					"content": "Бери, не стесняйся. Теперь это моё добро, и только мне решать, что с ним делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520710
					],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752520710,
					"content": "Рано или поздно, его жизнь тоже будет принадлежать мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752520703,
					"content": "#Нет, не встречал{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520705
					]
				},
				{
					"id": 752520705,
					"content": "Ты не обманываешь меня, верно? Я поверю тебе, потому что ты глаза у тебя честные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Текутли"
				}
			]
		}
