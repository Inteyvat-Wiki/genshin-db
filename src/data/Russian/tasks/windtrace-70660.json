			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гайгэкс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600201,
					"content": "Привет! Не хочешь сыграть в «По следам ветра»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600202,
						706600217
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600202,
					"content": "Что такое «По следам ветра»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600203
					]
				},
				{
					"id": 706600203,
					"content": "Хороший вопрос! «По следам ветра» - это замечательная игра, основанная на истории Мондштадта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600204
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600204,
					"content": "Ты, наверное, знаешь, что раньше в Мондштадте были аристократы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600205
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600205,
					"content": "Они бесчинствовали в Мондштадте, и многие люди страдали в те времена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600206
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600206,
					"content": "Чтобы дать отпор жестокости аристократов, несколько смелых людей из Мондштадта собрались вместе и создали тайную организацию сопротивления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600207
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600207,
					"content": "Эти рыцари всё время проводили операции в различных частях Мондштадта и причиняли аристократам немало бед.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600208
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600208,
					"content": "Но эти аристократы очень быстро подготовили группу своих приспешников, обученных подавлять действия рыцарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600209
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600209,
					"content": "И тогда рыцари и приспешники аристократов стали бороться друг с другом по всему Мондштадту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600210
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600210,
					"content": "Игра «По следам ветра» как раз основана на этих исторических событиях! Когда-то эта игра была очень популярна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600211
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600211,
					"content": "Когда-то?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600212
					]
				},
				{
					"id": 706600212,
					"content": "Да. Сейчас городская молодёжь не интересуется игрой «По следам ветра»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600213
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600213,
					"content": "Но я не могу допустить, чтобы игра «По следам ветра» оказалась забыта! Поэтому мне пришлось немного отредактировать прежние правила, чтобы игра стала интереснее и проще для понимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600214
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600214,
					"content": "Кроме того, теперь в игре есть несколько совершенно новых игровых карт. Мне кажется, благодаря этому гораздо больше людей захочет сыграть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600217,
					"content": "Как дела с игрой «По следам ветра»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600218
					]
				},
				{
					"id": 706600218,
					"content": "Мне уже удалось привлечь людей и провести пробную игру. Некоторые из них отлично показали себя. Я до сих пор под впечатлением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600219
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600219,
					"content": "Но также многие заметили, что игра чересчур сложная. Мятежники утверждали, что не могут убежать, а охотники - что нельзя никого найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600220
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600220,
					"content": "Некоторые жаловались даже, что для этой игры необходимо знать каждый участок карты, а ещё меня просили упростить игровой процесс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600221
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706600221,
					"content": "Ах, даже и не знаю, к кому прислушаться. Поэтому я и решил, что лучше будет созвать людей, сыграть ещё один пробный матч и посмотреть, что скажут они.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гайгэкс"
				}
			]
		},
