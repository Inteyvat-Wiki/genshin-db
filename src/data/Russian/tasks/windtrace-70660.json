					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600101,
					"content": "#Приветствую, путешественни{F#ца}{M#к}! Как проходят твои приключения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600102,
						706600105
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 706600102,
					"content": "Вполне себе хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600103
					]
				},
				{
					"id": 706600103,
					"content": "#Вот и славно. Продолжай оттачивать своё мастерство, и однажды ты обязательно станешь {F#великой искательницей приключений}{M#великим искателем приключений}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600104
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 706600104,
					"content": "Да, ещё кое-что. Гайгэкс проводит новую игру, «По следам ветра» называется. Если тебе интересно, загляни к нему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 706600108,
					"content": "Связана ли она с Гильдией искателей приключений?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600109
					]
				},
				{
					"id": 706600109,
					"content": "Видишь ли... Гайгэкс поручил гильдии подыскать для своей игры участников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600110
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 706600110,
					"content": "А так... Никакой связи между Гильдией и игрой нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600111
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 706600111,
					"content": "Словом, если есть желание - попробуй сыграть. По словам искателей приключений, которые уже приняли в ней участие, игра эта довольно занятная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				},
				{
					"id": 706600105,
					"content": "Будут ли для меня поручения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600106
					]
				},
				{
					"id": 706600106,
					"content": "Нет... пока никаких поручений нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600107
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 706600107,
					"content": "Гайгэкс проводит новую игру, «По следам ветра» называется. Если тебе интересно, загляни к нему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Катерина"
				}
			]
		},
		{
			"id": 7066002,
			"completionStepIds": [
				7066002,
				7066005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
