	"talks": [
		{
			"id": 2401504,
			"completionStepIds": [
				2401504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401504",
							"2"
						],
						"stepId": 2401504,
						"stateName": "QUEST_STATE_UNFINISHED"
