				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дэпьери"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150401,
					"content": "Нет, нет... Если убрать свет и тени, как же это отразится на слоях?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150402
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150402,
					"content": "Краскам недостаёт выразительности... И контраст весьма скудный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150403
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150403,
					"content": "Ох! Стоит убрать всего лишь пару элементов, и вся картина распадается на части!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150404,
						240150405
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150404,
					"content": "Что стряслось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				},
				{
					"id": 240150406,
					"content": "#Ах, {F#путешественница}{M#путешественник}, рад встрече...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150407
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150407,
					"content": "Прости за недоразумение. Я всего лишь размышлял над тем, что не так с картиной, поэтому ходил из стороны в сторону...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150408
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150408,
					"content": "Тебе, наверное, это сложно понять, но я просто не могу размышлять над задачей без движения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150409
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150409,
					"content": "Чем дольше сижу на одном месте, думая над проблемой, тем больше теряю самообладание. Поэтому я хожу туда-сюда и размышляю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150410
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150410,
					"content": "Я позволяю ногам нести меня, куда вздумается, лишь бы не застревать на одном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150411
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150411,
					"content": "Так что... Это со мной частенько. Прости, что заставил беспокоиться понапрасну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150412,
						240150413
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150412,
					"content": "И к какому выводу ты пришёл?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150414,
					"content": "Боюсь, никакого прогресса... Я просто не знаю, с чего начать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150415
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150415,
					"content": "Если убрать эффекты света и тени, то изображение сразу теряет многослойность. Но если сделать меньше контуров и форм, то объекты внутри картины теряют свою структуру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150416
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150416,
					"content": "Стоит хоть что-то убрать, как всё великолепие разваливается на части и становится грудой хлама.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150417
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150417,
					"content": "Это я говорю сам себе, если что. Я просто размышляю вслух, как решить эту проблему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150418
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150418,
					"content": "Надо вернуться за мольбертом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150413,
					"content": "И что же с решением твоей задачи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150405,
					"content": "Мне показалось, что ты в опасности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				}
			]
		},
		{
			"id": 2401506,
			"completionStepIds": [
				2401506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401506",
							"2"
						],
						"stepId": 2401506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дэпьери"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150601,
					"content": "Уф... Спасибо, большое спасибо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150602
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150602,
					"content": "Честное слово, я просто рисовал, а они внезапно меня окружили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150603
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150603,
					"content": "А потом набросились на мою картину, как будто хотели её съесть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150604
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150604,
					"content": "Но я, разумеется, этого позволить не мог, поэтому схватил картину и побежал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150605
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150605,
					"content": "#Они быстро настигли меня, а тут - хвала Архонтам! - и ты подоспел{F#а} на помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150606,
						240150607
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150606,
					"content": "Что-то не так с рисунком?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				},
				{
					"id": 240150608,
					"content": "Я и представить не могу! Я всегда использую краски из нектара попрыгуньи. Ну, помнишь, как те, что я просил тебя принести?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150609
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150609,
					"content": "Погоди-ка... Неужели их привлекают краски? Не может быть, ведь нектар попрыгуньи теряет запах, когда я делаю из него краску.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150610
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150610,
					"content": "Но и рецепт краски я поменять просто так не могу. Нужно что-то придумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150611
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150611,
					"content": "Кхм... Я уж было решил, что попрыгуньи почувствовали красоту моей картины и решили взглянуть поближе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240150607,
					"content": "Что ты сделал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				}
			]
		}
	]
}