				"points": []
			},
			"dialogs": [
				{
					"id": 721380701,
					"content": "Бр-р-ра-гх!!! Проклятье... ха... ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380702,
						721380703
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380702,
					"content": "С тобой всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380704
					]
				},
				{
					"id": 721380704,
					"content": "Что ж... Кхм, на вкус горькое, и у меня язык онемел. Местный паралич, должно быть, вызван Татаригами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380705
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380705,
					"content": "На вкус ужасно. Но думаю, опасного ничего нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380706
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380706,
					"content": "На наблюдение за эффектами лекарства может уйти много времени. Я не знаю... Эй?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380707
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380707,
					"content": "#Они... Они идут к нам! {NICKNAME}! Избавься от них!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380703,
					"content": "Выглядит не очень...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380704
					]
				}
			]
		}
