			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ясумото"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380401,
					"content": "#Спасибо, {NICKNAME}. Сожалею, что доставил тебе столько хлопот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380402,
						721380403
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380402,
					"content": "Ничего, пустяки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				},
				{
					"id": 721380404,
					"content": "Всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380405
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380405,
					"content": "#{NICKNAME}, тебя не затруднит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380406
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380406,
					"content": "Говори начистоту.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380407
					]
				},
				{
					"id": 721380407,
					"content": "#{NICKNAME}, не мог бы я проверить на тебе эффективность лекарства?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380408
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380408,
					"content": "Новый состав пока нестабилен, и нет никакой возможности предвидеть наихудшие последствия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380409
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380409,
					"content": "Поэтому я надеюсь, что кто-то может стать свидетелем моего успеха... или взять на себя последствия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380410
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380410,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721380403,
					"content": "Пустяки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				}
			]
		},
		{
			"id": 7213805,
			"completionStepIds": [
				7213806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213806",
