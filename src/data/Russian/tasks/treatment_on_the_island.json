	"talks": [
		{
			"id": 7213801,
			"completionStepIds": [
				7213801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213801",
							"2"
						],
						"stepId": 7213801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Ясумото"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380101,
					"content": "УХ ТЫ! Я... совсем не подозрительная личность. Я всего лишь местный врач!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380102
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380102,
					"content": "Если не верите мне, я могу отвести вас к себе домой. Если вам что-то нужно - берите. Только отпустите меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380103
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380103,
					"content": "Или отведите меня к вашему генералу, господину Кудзё! Он меня знает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380104,
						721380105
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380104,
					"content": "Возможно, вышло недоразумение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				},
				{
					"id": 721380106,
					"content": "Эй? Вы не похожи на поданного сёгуната... или Сангономии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380107
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380107,
					"content": "#Вы... чужестран{F#ка}{M#ец}? Что вы здесь делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380108,
						721380109
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380108,
					"content": "Наверное, ты прав...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380110,
					"content": "Но в любом случае вам лучше поскорее отсюда убраться. На острове Ясиори сейчас очень опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380111
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380111,
					"content": "Пока нет намёков на то, что Татаригами исчезнет. В ближайшее время комиссия Тэнрё не собирается выводить войска.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380112
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380112,
					"content": "Остров больше не пригоден для жилья, не говоря уж об осмотре достопримечательностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380113
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380113,
					"content": "#Если ты чужестран{F#ка}{M#ец}, сбежавш{F#ая}{M#ий} от ареста комиссара, иди на запад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380144
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380144,
					"content": "В комиссии Тэнрё неизвестным беженцам не рады. Но тебя могут забрать с собой пираты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380114,
						721380115
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380114,
					"content": "А что случилось на острове?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380116,
					"content": "#Хм-м... А ты сам{F#а} посуди. Посмотри, что горожане и люди из Сангономии сделали с нами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380117
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380117,
					"content": "Сначала был взрыв в Татарасуне. В ту ночь небо окрасилось в странные цвета...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380140
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380140,
					"content": "Многие мои родственники и друзья потеряли работу и сейчас живут в бедности. Многие другие были тяжело ранены и по возвращении домой выглядели ужасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380141
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380141,
					"content": "Многим моим друзьям... не удалось уйти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380118
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380118,
					"content": "А потом люди из Сангономии разрушили обереги, которые подавляли останки Змея. Поднялся Татаригами, и все спешно покинули остров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380119
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380119,
					"content": "Также распространяются странные болезни. Многие местные жители тяжело заболели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380142
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380142,
					"content": "Боюсь, что это лишь вопрос времени, пока это не распространится на лагеря обеих армий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380143
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380143,
					"content": "Где я?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380120
					]
				},
				{
					"id": 721380120,
					"content": "Именно здесь добывали кристаллы, используемые при выплавке нефритовой стали для Инадзумы. До тех пор, пока залежи кристаллов не иссякли бы, мы могли жить припеваючи, не страдая от притеснений городского люда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380121
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380121,
					"content": "А теперь? На острове едва найдёшь хоть одну живую душу... Я имею в виду, такую, как я, говорящую на человеческом языке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380122
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380122,
					"content": "Почему же ты не уедешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380123
					]
				},
				{
					"id": 721380123,
					"content": "Ты думаешь, я не хочу уехать? Этот молодой господин из комиссии Тэнрё ранее меня пригласил... Он всё ещё должен быть в армии и командовать битвами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380124
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380124,
					"content": "«У тебя есть познания в медицине, и ты отличаешься от обычных людей. На острове тебе оставаться опасно. Почему бы тебе не стать моим медиком? Я могу направить тебя к отцу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380145
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380145,
					"content": "По крайней мере, так он сказал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380125
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380125,
					"content": "До войны лечить члена комиссии было большой честью, о которой я, сельский врач, и мечтать не мог.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380126
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380126,
					"content": "Но теперь... Надо полагать, что у члена комиссии не было бы недостатка в хороших докторах. А как насчёт острова Ясиори? Я единственный врач, на которого здесь могут положиться пациенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380127
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380127,
					"content": "Поэтому я не уеду. Я не стану лечить ни одну из воюющих сторон. Мой единственный враг - Татаригами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380128
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380128,
					"content": "Я могу тебе чем-нибудь помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380129
					]
				},
				{
					"id": 721380129,
					"content": "Ничем... По правде сказать, мне нужна помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380130
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380130,
					"content": "Мне нужна кое-какая особая флора, чтобы изготовить средство для лечения странных болезней. Я не знаю, что из этого выйдет... Но попробовать никогда не помешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380131
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380131,
					"content": "Но... флора заражена Татаригами, и растёт она обычно в опасных местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380146
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380146,
					"content": "Разделенные рекой и морем, преследуемые монстрами повсюду, и вторжение Татаригами здесь также особенно сильно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380132
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380132,
					"content": "С моими храбростью и способностями справиться с этой задачей будет непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380133
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380133,
					"content": "И как доктор, я не смею идти на такой риск, как сбор флоры. Я вынужден использовать медленное консервативное лечение... Прошло столько времени, а я всё ещё не могу испытать ни одно новое назначение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380134
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380134,
					"content": "#Чужестран{F#ка}{M#ец}, вижу, у тебя при себе планер. По всему видать, ты опытн{F#ая}{M#ый} путешественни{F#ца}{M#к}. Тебе такие опасности по плечу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380135
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380135,
					"content": "Так что надеюсь, что ты поможешь мне собрать нужные ингредиенты на тех участках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380136
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380136,
					"content": "Когда соберёшь флору, приходи ко мне сюда. О награде не беспокойся. У меня остались кое-какие сбережения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380137
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380137,
					"content": "И хотя это поручение от незнакомца, я надеюсь, вы мне не откажете. Заранее большое вам спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380138
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380138,
					"content": "#Да, и будь осторож{F#на}{M#ен} в пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380115,
					"content": "У тебя удручённый вид.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380109,
					"content": "Долгая история...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380105,
					"content": "Как-то подозрительно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				}
			]
		},
