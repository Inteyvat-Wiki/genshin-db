			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ясумото"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380501,
					"content": "#Фух... Фух... Сердце того и гляди выскочит из груди. Спасибо, что спас{F#ла} мне жизнь. Я этого не забуду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380502
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380502,
					"content": "Это обычное явление. Существ, инфицированных Татаригами, бессознательно влечёт к злополучному источнику.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380503
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380503,
					"content": "Поскольку состав пропитан большим количеством энергии Татаригами, привлекать их - обычное явление.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380504
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380504,
					"content": "Ну, я хочу сказать, что теперь я знаю, как улучшить состав.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380505
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380505,
					"content": "Но на последнюю неудачу я потратил несколько свежих растений. И чтобы продолжить испытания состава, мне нужны ещё травы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380506
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380506,
					"content": "#В будущем путешествии, {NICKNAME}, пожалуйста, обращай внимание на травы, которые будут встречаться тебе на острове. Просто оставляй их в бамбуковой корзине перед домом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380511
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380511,
					"content": "Как и обещал, я дам вам награду. Но боюсь, вам придётся немного подождать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380507
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380507,
					"content": "#{NICKNAME}, это ничего, что ты занят{F#а}. Возможно, мне удастся найти для помощи кого-то другого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380508,
						721380509
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380508,
					"content": "Так точно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				},
				{
					"id": 721380510,
					"content": "#До свидания, путешественни{F#ца}{M#к} {NICKNAME}. Надеюсь, ты без приключений доберёшься до острова Ясиори.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380509,
					"content": "Конечно, я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				}
			]
		},
