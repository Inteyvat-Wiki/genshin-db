			"dialogs": [
				{
					"id": 721380301,
					"content": "Да, да, стебель и листья в целости и сохранности. А растения по-прежнему свежие... Спасибо тебе большое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380302
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380302,
					"content": "Это всё, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380303
					]
				},
				{
					"id": 721380303,
					"content": "Да, этого достаточно. Теперь я могу начать исследования новых лекарств.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380304
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380304,
					"content": "Спасибо тебе ещё раз за труд. Вот обещанная награда. Надеюсь, этого достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380305
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380305,
					"content": "#Кстати, чужестран{F#ка}{M#ец}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380306
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380306,
					"content": "Да, прости меня. Я доставил тебе столько неприятностей, но до сих пор не знаю, как тебя зовут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380307
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380307,
					"content": "#Меня зовут {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380308
					]
				},
				{
					"id": 721380308,
					"content": "#{NICKNAME}, если захочешь снова помочь мне, возвращайся попозже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380309
					],
					"speakerTitle": "Ясумото"
				},
				{
					"id": 721380309,
					"content": "Само собой, я справедливо тебя награжу. Ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясумото"
				}
			]
		},
		{
			"id": 7213804,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
