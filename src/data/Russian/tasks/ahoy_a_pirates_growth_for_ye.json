			"dialogs": [
				{
					"id": 210000201,
					"content": "Река уже близко? Надо выбрать подходящее место, где можно бросить бутылку в воду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000202
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000202,
					"content": "Чтобы бутылка уплыла подальше, бросим в верховье реки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Мэн"
				}
			]
		},
