				"points": []
			},
			"dialogs": [
				{
					"id": 210000301,
					"content": "Ого... Такие штуки существуют?.. Я ужасно испугался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000302
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000302,
					"content": "#Спасибо, {NICKNAME}. Пройдём дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000303
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000303,
					"content": "А где моя бутылка? Была со мной, а теперь её нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000304
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000304,
					"content": "Может быть, она выпала, когда напала попрыгунья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000305
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000305,
					"content": "#{NICKNAME}, помоги её найти, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Мэн"
				}
			]
		},
