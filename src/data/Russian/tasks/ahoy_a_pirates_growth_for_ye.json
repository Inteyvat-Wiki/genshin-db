				"points": []
			},
			"dialogs": [
				{
					"id": 210000101,
					"content": "Хм. А получится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000102,
					"content": "Малыш Мэн, ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "#{NICKNAME}, привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000104,
					"content": "Малыш Мэн, ты грустишь? Что-то не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210000105,
					"content": "Что случилось? Они не хотят играть с тобой в этих... в пиратов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210000106,
					"content": "А? Нет, Лулу и Фэй пошли домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000107,
					"content": "А я... хочу побыть один, поэтому гуляю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000108,
					"content": "Твои родители не будут переживать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210000109,
					"content": "Сейчас они ещё на работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000110,
					"content": "Давай не будем об этом. Можно задать тебе вопрос?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000111,
					"content": "Да, конечно. О чём?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "#{NICKNAME}, многие говорят о тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000115,
					"content": "#Ты путешественни{F#ца}{M#к}. Значит, у тебя большой опыт. Ты многое знаешь. Ответь на один вопрос...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000116,
					"content": "Малыш Мэн, ты говоришь так серьёзно. Что же у тебя за вопрос?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210000117,
					"content": "#{NICKNAME}, скажи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000118,
					"content": "Как стать взрослым?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000119,
					"content": "Чтобы вырасти, нужно время.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "Значит, люди взрослеют с возрастом - и всё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000121,
					"content": "Но не будет ли поздно взрослеть, когда вырастешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000124,
					"content": "Если хочешь отправиться за город, то мы можем пойти с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210000125,
					"content": "Не хочу доставлять вам хлопоты. Не думаю, что если выйду из города, то случится что-то особенное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000126,
					"content": "#{NICKNAME}, помоги мне с другим делом, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000127,
					"content": "Я слышал, что если есть неразрешимые проблемы, можно записать их, поместить в бутылку и бросить в реку - и пусть проблемы унесёт водой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000128,
					"content": "Может, так удастся избавиться от беспокойства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000129,
					"content": "Говорят, за городом много монстров. В одиночку ходить опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000130,
					"content": "#Прошу, {NICKNAME}, сходи со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000131,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "Спасибо. Я отдам тебе все свои сбережения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000134,
					"content": "Пойдём к реке Бишуй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000132,
					"content": "Доверься мне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "Взрослеешь благодаря опыту, когда происходит что-то необычное.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "Необычное... Эх, а я даже нигде, кроме Ли Юэ, не был.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210000112,
					"content": "У меня нет времени играть с тобой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "Ха-ха, я часто играю в эту игру с Лулу и Фэем. А сейчас их нет, не с кем играть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "Малыш Мэн"
				}
			]
		},
