					}
				]
			},
			"dialogs": [
				{
					"id": 746960101,
					"content": "Вспомнила, Ци Ци?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960102
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 746960102,
					"content": "Ох... извини...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960103
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960103,
					"content": "Не нужно извиняться, всё в порядке. До Дворца Мермония ещё идти и идти. Давай пройдёмся. Может, вспомнишь, где ты живёшь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960104
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 746960104,
					"content": "#{NICKNAME}, смотри, это Ци Ци! А с ней мелюзина. Какая необычная компания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746960105,
					"content": "#А! {NICKNAME} и... Пай... Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960106
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960106,
					"content": "Привет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960107
					]
				},
				{
					"id": 746960107,
					"content": "Вы знакомы с Ци Ци? Отлично! Я встретила её, когда проводила расследование возле порта Люмидус... Судя по телосложению, я решила, что она человеческий ребёнок... Она же ребёнок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960108
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 746960108,
					"content": "Ци Ци... Ци Ци...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960109
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960109,
					"content": "Наша подруга!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960110
					]
				},
				{
					"id": 746960110,
					"content": "Да-да! Мы знакомы уже очень давно. Мы лучшие друзья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746960111,
					"content": "Хе-хе! Отличная реакция! Если бы Ци Ци сказала, что она зомби, то мелюзина до полусмерти испугалась бы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746960112,
					"content": "Да... лучшие друзья... Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960113
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960113,
					"content": "Какое стечение обстоятельств! Честно говоря, я впервые в жизни оказалась в полной растерянности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960114
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 746960114,
					"content": "Я так понимаю, вы знаете о её проблемах с памятью? Она почти ничего не помнит, кроме своего имени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960115
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 746960115,
					"content": "С Ци Ци такое иногда случается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746960116,
					"content": "Бедняжка. Я собиралась отвести её в Сумеречный двор и оставить там на некоторое время, но надеялась, что по дороге к ней вернётся память, хотя бы частично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960117
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 746960117,
					"content": "Раз вы столь близки, то должны знать, где она живёт? Я могу отвести её прямо туда, это избавит нас всех от многих хлопот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960118
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 746960118,
					"content": "Мы знаем, но это очень далеко отсюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746960119,
					"content": "Очень... далеко?.. Ци Ци шла за феей... до порта Люмидус...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960120
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960120,
					"content": "Э? Ты вспомнила? А что было до этого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960121
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 746960121,
					"content": "До этого... господин Бай взял Ци Ци с собой в Ил... Ммм, в Ил... Ци Ци собирала травы, а потом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960122
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960122,
					"content": "О! Бай Чжу взял тебя в порт Илун? Детектив Паймон знает, что произошло!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746960123,
					"content": "Бай Чжу вместе с Ци Ци отправился в порт Илун, чтобы осмотреть пациентов. Ци Ци заблудилась, собирая лекарственные травы в тех краях, случайно встретила фею и последовала за ней до порта Люмидус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746960124,
					"content": "#Хм-хм, хорошо, что Паймон вместе с {F#путешественницей}{M#путешественником} читала «Бандитов и сыщиков»! Простые дедуктивные рассуждения для Паймон - пара пустяков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746960125,
					"content": "Но ведь это выдуманная история...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960126
					]
				},
				{
					"id": 746960126,
					"content": "О-о! Всё сходится! Я сейчас же отведу Ци Ци обратно в порт Илун. Доктор Бай Чжу - опекун Ци Ци? Он наверняка сильно переживает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960127,
						746960128
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 746960127,
					"content": "Постой. Среди тех, кого ждёт Барбелот...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				},
				{
					"id": 746960129,
					"content": "Точно! Паймон чуть не забыла об этом. Барбелот, ты здесь? Слышишь нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746960130,
					"content": "Не нужно так громко кричать. Я всегда здесь, просто не хотела прерывать ваш разговор. Умение слушать - неотъемлемая черта хорошего прорицателя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960131
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960131,
					"content": "Это так называемое руководство феи можно назвать волей судьбы. Хе-хе-хе... Раз уж ты здесь, Ци Ци, позволь погадать тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960132
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960132,
					"content": "По... гадать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960133
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960133,
					"content": "Барби, позволь перебить тебя. Ты совсем не умеешь разговаривать с детьми. Напугала бедную девочку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960134
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960134,
					"content": "Позволь мне. А теперь смотри и учись, как нужно преподносить такого рода сюрпризы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960135
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960135,
					"content": "Кхе-кхе! Юная участница Маленького ведьмина шабаша Ци Ци, я тётя Алиса, мама твоей союзницы Кли, величайшая ведьма в мире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960136
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960136,
					"content": "Здравствуйте... тётя Алиса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960137
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960137,
					"content": "Какая милая и воспитанная девочка. Позволь подруге тёти, ещё одной замечательной ведьме, устроить для тебя особую вечеринку с гаданием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960138
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960138,
					"content": "Вечеринка... с гаданием?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960139
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960139,
					"content": "Точно! Посмотри на карты перед собой. Красивые, да? Нравятся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960140
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960140,
					"content": "Очень... нравятся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960141
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960141,
					"content": "Замечательно! Тогда вытащи одну карту!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960142
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960142,
					"content": "Мм... эту... можно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960143
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960143,
					"content": "Конечно. А за то, что ты так хорошо себя вела, эта карта останется у тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960144
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960144,
					"content": "...Спасибо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960145
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960145,
					"content": "Ладно, Барби, перерыв окончен. Пришло время помочь малышке Ци Ци с толкованием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960146
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960146,
					"content": "Не нужно меня трясти. Я внимательно слушала... Ах, «Повешенный» в прямом положении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960147
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960147,
					"content": "Не многим попадается эта карта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960148
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960148,
					"content": "Это значит, что ты особенная, малышка Ци Ци.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960149
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960149,
					"content": "Она символизирует превосходство и ожидание, а также отрешённость от мирской суеты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960150
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960150,
					"content": "Ты находишься в определённых ограничениях, но сама ты не хочешь добровольно от них избавиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960151
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960151,
					"content": "Ограничения... это... приказы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960152
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960152,
					"content": "При поверхностном рассмотрении такое понимание ситуации является верным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960153
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960153,
					"content": "Что касается твоего будущего, тебе остаётся только ждать. Впрочем, времени у тебя предостаточно. Но... ой-ой, странно, очень странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960154
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960154,
					"content": "Подожди-ка! Ты слишком много болтаешь. Дай бедному ребёнку перевести дух.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960155
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960155,
					"content": "Позволим малышке Ци Ци как следует насладиться этим подарком. Нужно быть терпеливее с детьми...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960156
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960156,
					"content": "Ну что, малышка Ци Ци, тебе понравился этот маленький сюрприз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960157
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960157,
					"content": "Карта красивая... Спасибо, тётя Алиса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960158
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960158,
					"content": "Ой, какая хорошая девочка! Запомнила имя тёти. Тёте очень хотелось бы ещё поболтать с тобой, но тебе пора домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960159
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960159,
					"content": "Если тётя Барби хочет что-то добавить, то в следующий раз, когда Маленький ведьмин шабаш соберётся вместе, она сможет сделать предсказание для каждой маленькой ведьмы! Разве это не прекрасно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960160
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960160,
					"content": "...Не могла бы ты не увеличивать мою рабочую нагрузку, не спросив меня предварительно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960161
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960161,
					"content": "Вот и договорились! Увидимся в следующий раз, малышка Ци Ци и все присутствующие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960162
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746960162,
					"content": "Пока-пока... тётя Алиса и... хорошие друзья... тёти Алисы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960163
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960163,
					"content": "Фух... Мы закончили? Эти два голоса исходили из куклы? Что это за новая игрушка? Такая милая, где же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960164
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 746960164,
					"content": "Ах! Нет, нет, сейчас не время об этом думать. Ци Ци, давай сначала найдём господина Бай Чжу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960165
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 746960165,
					"content": "#...Да, время вышло, Ци Ци пора возвращаться. До встречи... {NICKNAME} и Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960166,
						746960167
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960166,
					"content": "Будь осторожна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960168,
					"content": "Карта... подарок... мм... красивая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 746960167,
					"content": "Береги себя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960128,
					"content": "...есть и Ци Ци.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				}
			]
		},
