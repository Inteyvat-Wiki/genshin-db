			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гуань Чуй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230101,
					"content": "Гости издалека? Добро пожаловать в деревню Цинцэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230102,
						705230103
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230102,
					"content": "Привет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				},
				{
					"id": 705230104,
					"content": "Нет, не так! Сначала надо представиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230105,
					"content": "#Это {F#всемогущая путешественница}{M#всемогущий путешественник} {NICKNAME}, а я {F#её}{M#его} лучшая подруга Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230106,
					"content": "Мы помогаем клиентам из далёких краёв закупать напитки к Празднику вина. Мы видели твоё поручение и пришли с тобой переговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230107,
					"content": "Вот как! Тогда не буду тратить время на болтовню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230109
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230109,
					"content": "Я повар Гуань Чуй, и мне нужны <color=#00E1FFFF>сто ящиков Праздничного сока</color>. Мои товарищи целыми днями тяжело работают, и чай с добавлением Праздничного сока поможет им восстановить силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230110
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230110,
					"content": "Хорошо! Тогда мы приступаем к работе! Приготовь нам средства для закупки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230111,
					"content": "Всё давно готово. Держите этот винный студень. Я уверен, что после выполнения заказа кое-что останется. Это будет награда за ваши труды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230112
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230112,
					"content": "Отлично, тогда мы скоро отправимся в путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230113,
					"content": "Великолепно! Жду от вас хороших новостей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230114,
						705230115
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230114,
					"content": "Как быстро договорились...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230116,
					"content": "#Не стой столбом, {NICKNAME}! Идём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230117,
					"content": "Если хочешь что-то сказать, давай сначала сделаем заказ, а уж потом поговорим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230118,
					"content": "Чем быстрее мы сделаем эту работу, тем скорее сможем открыть лавку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230119,
					"content": "Открыть лавку, ля-ля-ля!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230115,
					"content": "А Паймон постаралась...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230103,
					"content": "Скажи, пожалуйста...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				}
			]
		},
		{
			"id": 7052302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
