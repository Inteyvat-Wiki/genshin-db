							"7052303",
							"2"
						],
						"stepId": 7052303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гуань Чуй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230301,
					"content": "Гуань Чуй, мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230302,
					"content": "Заказ на сто ящиков Праздничного сока размещён. Вот документы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230303,
					"content": "Отлично! Вы так мне помогли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230304
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230304,
					"content": "Я изучу рецептуру Праздничного сока и смешаю его с чаем в особых пропорциях. Так его вкус лучше всего раскроется, и у моих товарищей появятся силы для работы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230305
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230305,
					"content": "Напоминает приготовление коктейля, только вместо алкоголя - чай... Неужели это вкусно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230306,
					"content": "Не переживайте, я ведь долго работал поваром. Такой напиток сочетает в себе прекрасный вкус и низкую стоимость. Я уже много раз его готовил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230307
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230307,
					"content": "Хотелось бы попробовать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230308
					]
				},
				{
					"id": 705230308,
					"content": "Как будете в следующий раз в деревне Цинцэ, я вас угощу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230309
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230309,
					"content": "#Хорошо! Пусть только {NICKNAME} попробует {F#первой}{M#первым}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230310,
					"content": "Удачи, мастер коктейлей!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230311
					]
				},
				{
					"id": 705230311,
					"content": "Спасибо! Заходите к нам в гости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гуань Чуй"
				}
			]
		},
		{
			"id": 7052304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052302",
							"2"
						],
						"stepId": 7052302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гуань Чуй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230401,
					"content": "Особый напиток, приготовленный к Празднику вина, идеально сочетается с чаем из деревни Цинцэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230402
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230402,
					"content": "Спасибо вам за хлопоты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230403,
						705230407,
						705230415
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230403,
					"content": "Расскажи о себе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230404
					]
				},
				{
					"id": 705230404,
					"content": "Мы с товарищами вернулись в деревню совсем недавно. Товарищи работают в поле, а я готовлю еду и отношу им.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230405
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230405,
					"content": "Готовлю я просто и сытно, неловко предлагать мою стряпню чужеземным гостям...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230406
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230406,
					"content": "Деревня Цинцэ, наверное, не самое оживлённое место, но деликатесов у нас предостаточно. Прогуляйтесь по деревне и убедитесь в этом сами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230407,
					"content": "Расскажи нам о чае...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230408
					]
				},
				{
					"id": 705230408,
					"content": "Мои товарищи, работая в поле, очень страдают от жажды - за полдня выпивают большой кувшин с чаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230409
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230409,
					"content": "От поля до чайной далеко, каждый день туда-сюда не находишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230410
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230410,
					"content": "Дядюшка Кай уже немолод, нельзя, чтобы он сам носил моим товарищам чай. Потому этим занимаюсь я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230411
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230411,
					"content": "Мы с товарищами долго пробыли на чужбине, и теперь местный чай кажется нам немного пресным. Иногда хочется попробовать напиток поинтересней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230412
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230412,
					"content": "Поэтому я добавляю в чай разные напитки, получаю новые вкусы и радую этим своих товарищей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230413
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230413,
					"content": "Конечно же, я готовлю такой чай только для своих друзей и не собираюсь отнимать клиентов у дядюшки Кая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230414
					],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230414,
					"content": "После работы мы идём к дядюшке Каю, пробуем его чай и помогаем по хозяйству.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гуань Чуй"
				},
				{
					"id": 705230415,
