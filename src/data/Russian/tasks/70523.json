			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Георг"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230201,
					"content": "О! Это снова вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230202
					],
					"speakerTitle": "Георг"
				},
				{
					"id": 705230202,
					"content": "Опять помогаете иноземцам размещать заказы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230203
					],
					"speakerTitle": "Георг"
				},
				{
					"id": 705230203,
					"content": "Точно! На этот раз нам нужно сто ящиков Праздничного сока. Заказчик - повар Гуань Чуй из деревни Цинцэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230204,
					"content": "Мы готовы назвать цену, Георг!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230205,
						705230206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705230205,
					"content": "Это напоминает какую-то дуэль...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				},
				{
					"id": 705230207,
					"content": "Ух! Задора вам хватает! Посмотрим, что вы предложите этот раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Георг"
				},
				{
					"id": 705230206,
					"content": "Получай, Георг!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				}
			]
		},
		{
			"id": 7052303,
			"completionStepIds": [
				7052303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
