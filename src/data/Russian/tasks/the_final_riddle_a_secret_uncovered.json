				"points": []
			},
			"dialogs": [
				{
					"id": 400130101,
					"content": "Кли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400130102,
					"content": "Мы разместили чешую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130103
					]
				},
				{
					"id": 400130103,
					"content": "Ура! Здорово! Хе-хе-хе, теперь моя очередь, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130104
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130104,
					"content": "Да, займись вон тем механизмом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400130105,
					"content": "Хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130106
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130106,
					"content": "Кли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130107
					]
				},
				{
					"id": 400130107,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130108,
						400130109
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130108,
					"content": "Будь осторожна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				},
				{
					"id": 400130110,
					"content": "Ага, я помню!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130111
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130112
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130112,
					"content": "Кли, что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130113
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400130113,
					"content": "Я-я боюсь... Вдруг Додокороль правда там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130114
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130114,
					"content": "А что, если он не разрешит мне стать семьёй Додоко, или я ему проиграю?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130115
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130115,
					"content": "Тогда мы с Додоко не сможем быть вместе, и мама тоже расстроится... Додоко - мой лучший друг, и его мне подарила мама.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130116
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130116,
					"content": "Мне слишком страшно нажимать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130117
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130117,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130118
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400130118,
					"content": "#{M#Дядя}{F#Тётя} почётный рыцарь, можешь нажать за меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130119
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130119,
					"content": "Кли, я не могу нажать за тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130120
					]
				},
				{
					"id": 400130120,
					"content": "Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130121
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130121,
					"content": "Потому что мне надо держать оружие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130122
					]
				},
				{
					"id": 400130122,
					"content": "Так я смогу тебя защитить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130123
					]
				},
				{
					"id": 400130123,
					"content": "Да, Кли, мы все здесь вместе с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130124
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400130124,
					"content": "Не волнуйся, Кли, мы все тебе поможем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400130125,
					"content": "Каким бы ни оказался враг, пока мы здесь, тебе нечего бояться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130126
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400130126,
					"content": "Прекрасно, я тоже хочу узнать, насколько сильны враги на этом острове.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130127
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 400130127,
					"content": "Давай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130128
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 400130128,
					"content": "Я здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130129
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 400130129,
					"content": "Ребята, не надо так говорить... Что если Додокороль просто хочет пригласил Кли к себе домой поговорить? Или... Точно! Может быть, он уже признал Кли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130130
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400130130,
					"content": "Он может признать Кли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130131
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130131,
					"content": "А почему не может? Ты очень старалась и у тебя всё получилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130132
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400130132,
					"content": "Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130133,
						400130134
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130133,
					"content": "Кли, ты моя лучшая подружка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130135,
					"content": "...Ладно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130136
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130136,
					"content": "Предоставьте это мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130137
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130137,
					"content": "Нажимаем, нажимаем... нажимаем кнопочку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130134,
					"content": "Он тебя признает, я верю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130109,
					"content": "Мы все пойдём с тобой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				}
			]
		},
		{
			"id": 4001302,
			"completionStepIds": [
				4001309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001309",
							"2"
						],
						"stepId": 4001309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джинн",
					"Барбара",
					"Альбедо",
					"Кли",
					"Алиса",
					"Паймон",
					"Кэйа",
					"Рэйзор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400130201,
					"content": "А? Это... Так, я ничего не понимаю. Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130202
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400130202,
					"content": "Весь остров будто гигантский подарок, спрятанный под энергетическим барьером...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130203
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400130203,
					"content": "Кажется, там что-то есть? Пойдём посмотрим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130204
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400130204,
					"content": "Да! Хочу посмотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130205
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130205,
					"content": "Порочная красная девчонка, ты наконец-то пришла. Я так долго ждал! Как скучно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130206
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130206,
					"content": "Ты смеешь противостоять мне, предводителю Додоклана? Додокоролю?! Какая похвальная смелость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130207
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130207,
					"content": "Хотя твоя храбрость заслуживает восхищения, это всё бессмысленно, потому что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130208
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130208,
					"content": "Потому что Додокороль - это я, твоя мама Алиса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130209
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130209,
					"content": "А? Мама?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130210
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130210,
					"content": "Что?! Алиса? Это которая написала «Путеводитель по Тейвату»?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400130211,
					"content": "Кли и её верные спутники, всем привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130212
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130212,
					"content": "Ну как вам тут? Было весело? Летнее солнце и пляж... Неплохой, наверное, отпуск, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130213
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130213,
					"content": "Нет смысла меня искать - меня здесь нет. Переговорное устройство на платформе перед вами - это моё личное изобретение, «фонограф Алисы»! Используется для передачи материнской любви!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130214
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130214,
					"content": "А? Ты, должно быть, шутишь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130215
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400130215,
					"content": "Ой, я вас не напугала, нет? Простите, моя Кли обожает играть со всякими маленькими игрушечками. И как её мать, я хочу поддержать её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130216
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130216,
					"content": "Эти игрушечки совсем не маленькие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400130217,
					"content": "Мама... Кли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130218
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 400130218,
					"content": "Жалко, что мы не можем встретиться, но, как и всегда, я буду издалека наблюдать за каждым вашим движением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130219
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130219,
					"content": "Так это была Алиса! Как я не обратила внимания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130220
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400130220,
					"content": "А? Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130221
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400130221,
					"content": "Вам это всё может показаться странным. Зачем матери так далеко от дома тратить столько сил, чтобы создать посреди моря парк развлечений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130222
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130222,
					"content": "Динь-динь! Всё верно, я лично была на этих островах, и мне безумно понравились древние руины и необычный ландшафт. Я всё подготовила, чтобы вы тоже смогли насладиться ими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130223
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130223,
					"content": "Мама Кли, похоже, очень свободный человек...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400130224,
					"content": "Хе-хе, там кто-то про меня гадости говорит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130225
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130225,
					"content": "А? Нет! Она нас подслушивает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400130226,
					"content": "Не надо беспокоиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130227
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400130227,
					"content": "В смысле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400130228,
					"content": "Мама Кли, Алиса, - крайне загадочная и чуть ли не всемогущая ведьма. Не стоит слишком удивляться. Просто у неё характер такой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130229
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400130229,
					"content": "Вам, наверное, интересно, а к чему все эти письма, лодки, буйки, энергетический барьер этот...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130230
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130230,
					"content": "Хм-хм... На самом деле мне тоже кажется, что это немного хлопотно, но только так вас можно было всех здесь собрать, да ведь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130231
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130231,
					"content": "Эти острова скрывают столько историй. Аборигены, кораблекрушения, загадочные механизмы... Здесь сошлись бесчисленные совпадения. Если бы не мои приготовления, то всё бы это было зря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130232
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130232,
					"content": "Дайте-ка угадаю... Все, кто получил письмо, должны быть здесь. Кэйа, Дилюк, Рэйзор, Джинн, Барбара...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130233
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130233,
					"content": "#Наконец верный и умный Альбедо, и... {M#загадочный путешественник}{F#загадочная путешественница} со своим компаньоном, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130234
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130234,
					"content": "Я всех вас пригласила, чтобы составить компанию Кли. Спасибо, благодаря вам, моя дочка провела незабываемое лето.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130235
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130235,
					"content": "Всё на этих островах - подарок вам. Спасибо, что были с моей маленькой Кли. Когда вы услышите эту запись, я буду уже очень далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130236
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130236,
					"content": "#Жизнь путешественника стремительна и увлекательна. Ха-ха, можете спросить {M#путешественника}{F#путешественницу} рядом с вами, он{F#а} вам расскажет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130237
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130237,
					"content": "То есть Алиса всё это затеяла просто потому, что слишком занята и не может сама быть с Кли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130238
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400130238,
					"content": "Нет, просто мама вот такая вот!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130239
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130239,
					"content": "А теперь, если вы пытаетесь найти во всём этом какой-то скрытый смысл, то я вам скажу - всё намного проще, чем вы думаете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130240
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130240,
					"content": "Именно за свободу, к которой мы с дочкой стремимся, я и полюбила Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130241
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130241,
					"content": "Моё желание очень простое: я надеюсь, что Кли вырастет любопытной и доброй. Если она захочет, то сможет сделать что угодно и отправиться куда угодно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130242
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130242,
					"content": "Вот оно как. Должна признать, что это вполне в стиле Алисы. Прошу прощения, я не так поняла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130243
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400130243,
					"content": "Здорово, когда у твоей мамы такой интересный характер!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130244
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400130244,
					"content": "Да! Мама - самая лучшая мама!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130245
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130245,
					"content": "Мам, мы ловили рыбу, катались на лодке, купались... Много во что играли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130246
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130246,
					"content": "Все были очень замечательные и добрые ко мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130247
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130247,
					"content": "Давай с нами в следующий раз. Опять приедем сюда играть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130248
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130248,
					"content": "У дочки такой же свободный дух, как и у мамы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130249
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400130249,
					"content": "Ах, лето... Кстати, когда я была на островах, это тоже было летом. Сидя на пляже и слушая шелест волн, плескавшихся у моих ног, я думала о тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130250
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130250,
					"content": "Кли, ты дитя лета, подарок маме от моря и ветра. Я благодарна за твоё рождение и хотела тебе что-нибудь дать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130251
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130251,
					"content": "Поэтому я нарядила эти острова, превратила древние руины в летний парк развлечений, и под именем Додокороля пригласила тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130252
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130252,
					"content": "В преданиях другого мира говорится о чудесном острове, названном в честь золотых яблок. У него много имён, он олицетворяет прекрасные картины человеческих грёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130253
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130253,
					"content": "Мама любит эту историю и хотела, чтобы ты могла насладиться прекрасными чудесами из неё. Поэтому мама дала тебе лазурные воды, жемчужные пески, сказочный рай...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130254
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130254,
					"content": "Для тебя и тех, кто тебя любит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130255
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130255,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130256
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400130256,
					"content": "Поэтому кристаллов было три... Светло-красный, как лепестки, голубой, как морская волна, и жёлтый, как осенние листья...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130257
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400130257,
					"content": "Возможно, Алиса считает, что этот архипелаг - природный четвёртый кристалл... Расположенный среди моря, покрытый растительностью, сверкающий, словно изумруд, «кристалл лета».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130258
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400130258,
					"content": "Кли, ты, как и мама, принадлежишь к расе долгожителей. Для нас время, словно порыв ветра, - мгновение пролетело и нет его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130259
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130259,
					"content": "В такой долгой жизни родители лишь первое звено для ребёнка. Хотя мы и не хотим расставаться, но день, когда ты должна идти своей дорогой, всё равно настанет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130260
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130260,
					"content": "Кли, мама всегда будет тебя любить, но вокруг тебя есть много других людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130261
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130261,
					"content": "Друзья, которые находятся с тобой; учителя, которые тебя наставляют; люди, которые согласны отправиться с тобой на остров, зная, какое странное это место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130262
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130262,
					"content": "Лето, оно для всех. Как бы жизнь ни менялась, сколько бы всего ни происходило за год, лето никогда не исчезнет, как любовь между людьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130263
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130263,
					"content": "Надеюсь, отныне, куда бы ты ни направилась, ты не забудешь, как много в мире людей любят тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130264
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130264,
					"content": "Ах, да, дома слушайся Альбедо. Мама будет регулярно вас навещать. На самом деле, когда у меня есть свободное время, я тайком возвращаюсь проведать Кли и всех остальных. Хи-хи, никто не заметил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130265
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130265,
					"content": "Тётушка Алиса всё такая же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130266
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400130266,
					"content": "Неужели Альбедо знал с самого начала?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130267
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400130267,
					"content": "А? Время почти вышло, так что на этом всё. Ах да, я много сил потратила, чтобы всё это создать, поэтому развлекайтесь на полную!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130268
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130268,
					"content": "Моя малышка Кли, все остальные, до встречи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130269
					],
					"speakerTitle": "Алиса"
				},
				{
					"id": 400130269,
					"content": "Пока, мама!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130270
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130270,
					"content": "Кли, похоже, очень рада.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130271
					]
				},
				{
					"id": 400130271,
					"content": "Хе-хе... Додокороль оказался мамой. Не знаю почему, но я очень рада!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130272
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130272,
					"content": "Неважно, взрывает ли мама ворота Мондштадта, наказывает ли она Кли или пишет странные письма... Кли очень её любит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130273
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130273,
					"content": "Тебе без неё не одиноко?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130274
					]
				},
				{
					"id": 400130274,
					"content": "Нет. Мама - самая сильная ведьма, где бы она ни была, она всегда со мной. Она никогда не даёт мне скучать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130275
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130275,
					"content": "Я таааак сильно люблю маму!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130276
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130276,
					"content": "#{M#Дядя}{F#Тётя} почётный рыцарь, ты любишь Кли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130277
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400130277,
					"content": "Ага!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130278
					]
				},
				{
					"id": 400130278,
					"content": "#Я тебя тоже очень люблю! Ты {M#должен}{F#должна} побольше играть с мной здесь, а то мама расстроится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130279
					],
					"speakerTitle": "Кли"
				},
				{
