			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзя Вэй",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726590201,
					"content": "Океан что красивая женщина - изредка увидеться и хватит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590202
					],
					"speakerTitle": "Цзя Вэй"
				},
				{
					"id": 726590202,
					"content": "Ты Цзя Вэй?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590203
					]
				},
				{
					"id": 726590203,
					"content": "Да, в чём дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590204
					],
					"speakerTitle": "Цзя Вэй"
				},
				{
					"id": 726590204,
					"content": "Ах... Лунный левиафан! Ну конечно, Лунный левиафан! Такое не забывается никогда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590205
					],
					"speakerTitle": "Цзя Вэй"
				},
				{
					"id": 726590205,
					"content": "И Кудзирай, конечно, тоже не забыла, ведь её желание... Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590206
					],
					"speakerTitle": "Цзя Вэй"
				},
				{
					"id": 726590206,
					"content": "Ну что ж, желаю вам удачи! Надеюсь, у вас всё получится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590207
					],
					"speakerTitle": "Цзя Вэй"
				},
				{
					"id": 726590207,
					"content": "А? Мы пришли, чтобы позвать тебя с нами. Ты не пойдёшь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726590208,
					"content": "А! В тот раз я чуть не умер. Океан что красивая женщина - изредка увидеться и хватит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590209
					],
					"speakerTitle": "Цзя Вэй"
				},
				{
					"id": 726590209,
					"content": "Да и теперь я женатый человек. Как я могу бросить свою семью? Я должен исполнять обязанности главы дома!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590210
					],
					"speakerTitle": "Цзя Вэй"
				},
				{
					"id": 726590210,
					"content": "Сколько я трудился и сколько пота пролил, чтобы жениться на такой щедрой и богатой девушке! Так что прошу прощения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590211
					],
					"speakerTitle": "Цзя Вэй"
				},
				{
					"id": 726590211,
					"content": "Момидзи расстроится...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590212
					]
				},
				{
					"id": 726590212,
					"content": "Не надо так говорить... Дай подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590213
					],
					"speakerTitle": "Цзя Вэй"
				},
				{
					"id": 726590213,
					"content": "Хоть я и не могу отправиться с вами, но я могу помочь другим образом. Я передам вам своё рыболовное мастерство и опыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590214
					],
					"speakerTitle": "Цзя Вэй"
				},
				{
					"id": 726590214,
					"content": "Такое легендарное существо, как Лунный левиафан, поймать очень непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590215
					],
					"speakerTitle": "Цзя Вэй"
				},
				{
					"id": 726590215,
					"content": "Так что позвольте обучить вас, примите мои знания и отправляйтесь на поиски загадочной рыбы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590216
					],
					"speakerTitle": "Цзя Вэй"
				},
				{
					"id": 726590216,
					"content": "Ах да, вы, наверное, хотите скорее найти Нантака? Не торопитесь, он впал в спячку, как старая морская черепаха. Сидит постоянно в Мондштадте и вроде книгу пишет какую-то?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590217
					],
					"speakerTitle": "Цзя Вэй"
				},
				{
					"id": 726590217,
					"content": "А теперь соберись! Волшебное обучение ловле рыбы от Цзя Вэя начинается! Как закончим с тренировкой, можешь пойти искать Нантака.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзя Вэй"
				}
			]
		},
