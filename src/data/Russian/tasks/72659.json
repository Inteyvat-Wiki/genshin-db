					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726590101,
					"content": "Лунный левиафан...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590102
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590102,
					"content": "Что Лунный левиафан?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590103
					]
				},
				{
					"id": 726590103,
					"content": "#О, привет! Должно быть, ты {F#та рыбачка}{M#тот рыбак} из Гильдии искателей приключений? Я Кудзирай Момидзи, местная мастерица рыбалки из Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590104
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590104,
					"content": "#Я уже слышала о тебе в Ассоциации рыболовов, а тут смотрю - {M#такой многообещающий молодой человек}{F#такая многообещающая молодая девушка}. Надеюсь, я не ошиблась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590105
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590105,
					"content": "Последнее время я ищу легендарную рыбу - Лунного левиафана. Говорят, что он может исполнять желания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590106
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590106,
					"content": "Ого! Рыба, исполняющая желания! Паймон любит такие легенды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726590107,
					"content": "Да... Хотя все считают это просто сказками, но... я верю, что это правда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590108
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590108,
					"content": "Потому что несколько лет назад я сама встретила Лунного левиафана...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590109
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590109,
					"content": "И он исполнил твоё желание?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590110
					]
				},
				{
					"id": 726590110,
					"content": "Ну... почти. Дело было так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590111
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590111,
					"content": "Несколько лет назад мы с моими друзьями решили поймать Лунного левиафана, чтобы он исполнил наши желания. Одного друга звали Цзя Вэй, а другого - Нантак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590112
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590112,
					"content": "Но наше путешествие не заладилось - мы попали в ужасный шторм. И хотя лодка выдержала, наш компас сломался. Мы оказались затеряны среди незнакомых вод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590113
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590113,
					"content": "Прошло несколько дней, и мы так и не нашли направление к дому. Запасы пресной воды иссякли, и мы уже отчаялись, хотя никто и не подавал виду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590114
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590114,
					"content": "Как-то ночью Цзя Вэй тихонько встал, написал предсмертную записку, засунул её в бутылку, кинул в море и хотел было кинуться вслед за ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590115
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590115,
					"content": "Он не знал, что мы тоже не спали. Мы услышали шорохи и успели затащить его обратно. Тогда-то мы и увидели, как под водой промелькнул огромный силуэт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590116
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590116,
					"content": "Он бледно сиял и весь переливался блёстками, будто кто-то разбил луну и бросил её в море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590117
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590117,
					"content": "Был ли это Лунный левиафан? От безысходности мы решили, что да, и попросили его в целости вернуть нас домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590118
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590118,
					"content": "Да, верьте или нет, но мы выжили. Силуэт, словно по волшебству, поплыл вдаль - а мы за ним. Так мы и вернулись домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590119
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590119,
					"content": "Ох... Какая трогательная история!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726590120,
					"content": "Нет! Это правда! Верьте мне, мы обязательно найдём его снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590121
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590121,
					"content": "Но как?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590122
					]
				},
				{
					"id": 726590122,
					"content": "Сначала надо найти моих старых товарищей. Они опытные рыболовы, и с ними будет намного проще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590123
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590123,
					"content": "<color=#00E1FFFF>Цзя Вэй живёт в Ли Юэ</color>. Я знаю, что он как вернулся в Ли Юэ, так и не покидал его. Я уверена, что он тоже всё думает о Лунном левиафане.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590124
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726590124,
					"content": "А про Нантака я только слышала, что он стал писателем-маринистом. Спросите у Цзя Вэя, когда встретитесь с ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кудзирай Момидзи"
				}
			]
		},
		{
			"id": 7265902,
			"completionStepIds": [
				7265902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
