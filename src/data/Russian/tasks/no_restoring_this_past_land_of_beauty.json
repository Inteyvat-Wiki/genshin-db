			"trigger": {
				"objectNames": [
					"Чжи Пин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710220101,
					"content": "В этот раз - долина Тяньцю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220102
					],
					"speakerTitle": "Чжи Пин"
				},
				{
					"id": 710220102,
					"content": "Что-то не так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220103
					]
				},
				{
					"id": 710220103,
					"content": "#О, здравия желаю, {NICKNAME}. Повстречать тебя сегодня - приятная неожиданность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220104
					],
					"speakerTitle": "Чжи Пин"
				},
				{
					"id": 710220104,
					"content": "Скажи, не довелось ли тебе недавно бывать в долине Тяньцю или у Южных небесных врат?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220107
					],
					"speakerTitle": "Чжи Пин"
				},
				{
					"id": 710220107,
					"content": "В гильдию постоянно приходят доклады о землетрясениях в этих местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220108
					],
					"speakerTitle": "Чжи Пин"
				},
				{
					"id": 710220108,
					"content": "Сначала это были незначительные толчки, но теперь они куда сильнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220109
					],
					"speakerTitle": "Чжи Пин"
				},
				{
					"id": 710220109,
					"content": "А ещё пару дней назад нам доложили, что из-за особо сильного землетрясения часть горы и руин обрушилась, открыв вход в огромную пещеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220110
					],
					"speakerTitle": "Чжи Пин"
				},
				{
					"id": 710220110,
					"content": "В докладе также говорится, что там видели неизвестных чудовищ. Судя по описанию, это могут быть некогда державшие в страхе весь Ли Юэ геовишапы и древние геовишапы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220111
					],
					"speakerTitle": "Чжи Пин"
				},
				{
					"id": 710220111,
					"content": "Чем я могу помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220112
					]
				},
				{
					"id": 710220112,
					"content": "Я хотел бы поручить тебе отправиться в долину Тяньцю, исследовать ту огромную пещеру и изучить влияние землетрясений на прилегающие территории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220113
					],
					"speakerTitle": "Чжи Пин"
				},
				{
					"id": 710220113,
					"content": "Что же до чудовищ... Если их много, то необходимо быстро что-нибудь предпринять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220114
					],
					"speakerTitle": "Чжи Пин"
				},
				{
					"id": 710220114,
					"content": "Это, конечно же, считается официальным поручением гильдии, и ты получишь должное вознаграждение. Возьмёшься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220115
					],
					"speakerTitle": "Чжи Пин"
				},
				{
					"id": 710220115,
					"content": "Сделаю в лучшем виде.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220116
					]
				},
				{
					"id": 710220116,
					"content": "#Спасибо. В тех местах будь крайне осторож{F#на}{M#ен}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Пин"
				}
			]
		},
