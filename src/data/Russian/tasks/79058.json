			},
			"dialogs": [
				{
					"id": 790580101,
					"content": "Это сцена из шоу «Великий побег»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580102
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790580102,
					"content": "Первоначальная история рассказывала о Гидро эйдолоне, оказавшемся в ловушке в одной пещере. Его ключом к спасению были инструменты, спрятанные в книге...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580103
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790580103,
					"content": "Но Идия отвергла эту идею.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580104
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790580104,
					"content": "И это было разумно. Гидро эйдолонам не нужны инструменты. Они могут отправиться туда, куда пожелают. Да и прятать инструменты в книге довольно нелепо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580105
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790580105,
					"content": "Но идея-то была хороша! Жаль, что Идия не смогла разглядеть в ней гениальный замысел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580106
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790580106,
					"content": "К сожалению, <color=#00E1FFFF>книгу с инструментами похитили хиличурлы</color>. Её необходимо вернуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580107
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790580107,
					"content": "Режиссёр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сценические заметки"
				}
			]
		},
