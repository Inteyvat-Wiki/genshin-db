			"dialogs": [
				{
					"id": 740870201,
					"content": "Здесь обычно отдыхают исследователи? Разве это гуманно? Исследовательский институт вообще думал о том, чтобы прежде всего отремонтировать это место?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870202
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740870202,
					"content": "...Здесь должен быть поисковый якорь. Как и намекнула госпожа Хрония, это место нуждается в ремонте, и энергия здесь в дефиците... А иногда и совсем пропадает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870203
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740870203,
					"content": "#И пока я буду отвечать на вопросы госпожи Хронии, задача по возвращению поискового якоря ложится на вас, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэкер"
				}
			]
		},
		{
			"id": 7408703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7408702",
							"3"
						],
						"stepId": 7408702,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нэкер",
					"Хрония"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740870301,
					"content": "По сравнению с другими участками, можно сказать, что общежития почти не пострадали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870302
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740870302,
					"content": "Общежитие? Но здесь даже кроватей нет, как же исследователи отдыхают? Не могут же они спать сидя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870303
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740870303,
					"content": "Госпожа Хрония, вы и исследователи немного по-разному трактуете понятие «отдых».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870304
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740870304,
					"content": "Когда кто-нибудь из учёных Исследовательского института Фонтейна говорит, что ему нужен отдых, на самом деле он просто хочет дать передохнуть своей голове.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870305
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740870305,
					"content": "Он обычно приходит сюда, чтобы помузицировать, почитать или выпить пару бокальчиков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870306
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740870306,
					"content": "Хм, но разве сон - это не лучший способ дать отдых голове?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870307
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740870307,
					"content": "Ваши слова справедливы. Но... для нас, исследователей, сон - это прежде всего пустая трата времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870308
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740870308,
					"content": "Сон - это пустая трата времени? Это же необходимый отдых!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870309
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740870309,
					"content": "Сон может полностью прервать наши размышления об исследовании, а в нашей работе это недопустимо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870310,
						740870311
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740870310,
					"content": "(Слушать дальше)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740870312
					]
				},
				{
					"id": 740870312,
					"content": "Ты шутишь? Если не спать, то лишь быстрее себя в могилу сведёшь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870313
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740870313,
					"content": "Вовсе нет. У Института прекрасная система медицинского обслуживания, которая гарантирует здоровье наших исследователей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870314
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740870314,
					"content": "Но это ведь не повод отказаться от сна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870315
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740870315,
					"content": "Кроме того, разве исследователи приходят сюда не для того, чтобы дать разуму отдохнуть? Это ведь всё равно прервёт мыслительный процесс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870316
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740870316,
					"content": "Не обязательно. Только кажется, что они отдыхают. На самом деле они продолжают биться над решением своих академических проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870317
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740870317,
					"content": "Это как океан, поверхность которого выглядит спокойной, а в глубине движутся огромные течения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870318
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740870318,
					"content": "Нередко такие невидимые течения куда сильнее, чем волны на поверхности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870319
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740870319,
					"content": "Кажется, я поняла. Когда исследователи из Института работают над проектом, они обязаны трудиться и не могут отдыхать, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870320
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740870320,
					"content": "Это довольно узкий взгляд на ситуацию. Если кому-то надо поспать, он может пойти домой и воплотить своё желание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870321
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740870321,
					"content": "Правильнее сказать, что пока исследователь находится в стенах Института, он обязан работать и не должен спать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870322
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740870322,
					"content": "Ваши рассуждения поражают меня, госпожа Хрония.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740870311,
					"content": "(Перестать слушать)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}