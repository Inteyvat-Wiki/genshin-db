				"points": []
			},
			"dialogs": [
				{
					"id": 10293301,
					"content": "Уси, тебе не кажется, что эта наша фиалковая дынька уснула? Видит ли она сны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293302
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10293302,
					"content": "Му? Му-у.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293303
					],
					"speakerTitle": "Уси"
				},
				{
					"id": 10293303,
					"content": "Уф, она выглядит измотанной. Тяжело видеть её такой, обычно-то она говорит без умолку... Эх, бедняжка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293304
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10293304,
					"content": "Да и паренёк наш выглядит таким изнурённым. Я так о них обоих беспокоюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293305
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10293305,
					"content": "Му-у, му-у.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293306
					],
					"speakerTitle": "Уси"
				},
				{
					"id": 10293306,
					"content": "Спит, как я в темнице? Ну ты и шутник. Да я сплю как король.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293307
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10293307,
					"content": "#{NICKNAME}?! Ты когда вернул{F#ась}{M#ся}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аратаки Итто"
				}
			]
		},
