				{
					"id": 10293201,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293202
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10293202,
					"content": "Ты в порядке? Такая молчаливая - совсем на тебя не похоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293203
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10293203,
					"content": "Тсс, потом поговорим. Сейчас я разбираю все зацепки, которые есть на данный момент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293204
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10293204,
					"content": "Возможно, ответ скрыт в каких-то деталях, которые я упустила. А для этого нужно всё проверить ещё раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293205
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10293205,
					"content": "Тогда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293206
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10293206,
					"content": "Не волнуйся, я не буду записывать твой рассказ о тех событиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293207
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10293207,
					"content": "Я имею в виду, если тебе нужно проанализировать что-то, то можешь рассчитывать на меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Е Лань"
				}
			]
		},
		{
			"id": 103202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
