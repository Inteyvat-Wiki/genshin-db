			},
			"dialogs": [
				{
					"id": 726990101,
					"content": "Я с нетерпением жду поединка. Интересно, насколько хороши твои навыки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990102
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726990102,
					"content": "Что ты здесь делаешь?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990103
					]
				},
				{
					"id": 726990103,
					"content": "На самом деле, когда я сказал, что воинов было четверо, я причислил себя к ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990104
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726990104,
					"content": "Я организатор, да, но участников было слишком мало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990105
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726990105,
					"content": "Неважно, я был рождён для битвы! И раз я столкнулся с могучим противником, то должен сразиться с ним!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990106
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726990106,
					"content": "Ха-ха, я так долго мечтал это сказать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990107
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726990107,
					"content": "Кажется, у него не все дома...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726990108,
					"content": "Лучше его не недооценивать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990109
					]
				},
				{
					"id": 726990109,
					"content": "Именно! Твоё отношение к противникам заставляет меня уважать тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990110
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726990110,
					"content": "Если бы я не смотрел свысока на нашего четвёртого участника, я бы не потерпел такого ужасного поражения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990111
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726990111,
					"content": "#Но сегодняшний я уже не такой, как вчера! Давай же, {NICKNAME}, сразимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990114,
						726990112
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726990114,
					"content": "Давай скрестим мечи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990115
					]
				},
				{
					"id": 726990115,
					"content": "Давай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726990112,
					"content": "Постой, мне нужно подготовиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990113
					]
				},
				{
					"id": 726990113,
					"content": "Понимаю. Приготовься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясухико Таро"
				}
			]
		}
	]
