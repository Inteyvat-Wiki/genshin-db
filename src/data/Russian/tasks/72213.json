					"Осима Дзюмпэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130301,
					"content": "Эх, и как же мне работать без молотка и зубила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130302
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130302,
					"content": "Что-то не так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130303
					]
				},
				{
					"id": 722130303,
					"content": "А, это ты. Ох... Я допустил оплошность - не проверил свои инструменты перед работой. И вот теперь сломал молоток и зубило...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130304
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130304,
					"content": "Я бы вернулся на остров Наруками, чтобы купить новые, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130305
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130305,
					"content": "...как бы сказать... Наверное, я просто привык заканчивать работу за один раз, понимаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130306
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130306,
					"content": "Инструменты, конечно, сломались, но я пока могу заняться измерениями и подумать о дальнейших шагах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130307
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130307,
					"content": "Если я сейчас отправлюсь на Наруками за инструментами, то потеряю «чувство камня»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130308
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130308,
					"content": "К тому же этот камень такой твёрдый, что обычные инструменты тут не подойдут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130309
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130309,
					"content": "Что ж... выхода нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130310
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130310,
					"content": "#Путешественни{F#ца}{M#к}, можешь найти для меня три куска железной руды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130311
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130311,
					"content": "Придётся сделать подходящие инструменты самому, так будет надёжнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130312,
						722130314
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130312,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130313
					]
				},
				{
					"id": 722130313,
					"content": "Отлично, тогда буду тебя ждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130314,
					"content": "Ты собираешься сам их выковать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130315
					]
				},
				{
					"id": 722130315,
					"content": "Я всё-таки работал в Татарасуне. Конечно, я кое-что смыслю в ковке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130316
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130316,
					"content": "Но думаю, не стоит разводить огонь в святилище. Подозреваю, что госпожа временная настоятельница будет недовольна. Она ведь всё-таки кошка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130317
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130317,
					"content": "В любом случае принеси мне три слитка железной руды, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осима Дзюмпэй"
				}
			]
		},
