				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130601,
					"content": "Мяу-мяу-мяу. Что-то случилось? Не волнуйтесь, «лопата» будет достойной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130602,
						722130603
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722130602,
					"content": "«Оплата».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130605
					]
				},
				{
					"id": 722130605,
					"content": "А, неважно. В общем, инструменты каменного человека... то есть господина Осимы сломались. Но мы принесли ему материалы, он всё починит, и никаких проблем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722130606,
					"content": "Проблемы? Какие проблемы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130607,
						722130608
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722130607,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130609,
					"content": "Вот и хорошо. Я очень хочу посмотреть на этот мой камень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
