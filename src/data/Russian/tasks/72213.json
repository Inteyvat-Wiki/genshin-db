			},
			"dialogs": [
				{
					"id": 722130501,
					"content": "Отлично! Думаю, этого хватит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130502
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130502,
					"content": "Я найду снаружи подходящее место для горна, а потом начну делать инструменты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130503
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722130503,
					"content": "Расскажите госпоже временной настоятельнице, а я пока начну собираться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осима Дзюмпэй"
				}
			]
		},
		{
			"id": 7221306,
			"completionStepIds": [
				7221304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221304",
