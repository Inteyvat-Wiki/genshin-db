			"dialogs": [
				{
					"id": 207411001,
					"content": "Вы собрали семена одуванчика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411002
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 207411002,
					"content": "Да, вот они.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207411003
					]
				},
				{
					"id": 207411003,
					"content": "Этого достаточно. Пожалуйста, подождите минуточку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411004
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 207411004,
					"content": "...О, Барбатос, прошу, услышь меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411005
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 207411005,
					"content": "Ого... Она такая набожная. Так много слов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411006
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 207411006,
					"content": "...Интересно, слышит ли это тот бард-бродяжка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411007
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 207411007,
					"content": "Ладно. Пожалуйста, возьмите эти семена одуванчика и рассейте их по ветру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411008
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 207411008,
					"content": "На самом деле, я должна сделать это сама, но... С моими физическими данными, даже если бы я смогла забраться на статую, вряд ли я сумела бы потом спуститься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411009
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 207411009,
					"content": "Поэтому, пожалуйста, помогите мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Грейс"
				}
			]
		},
