			},
			"dialogs": [
				{
					"id": 708250401,
					"content": "Эх, нам бы ещё парочку людей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250402,
						708250406
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 708250402,
					"content": "А чем заняты остальные рыцари?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250403
					]
				},
				{
					"id": 708250403,
					"content": "Приводят в порядок защитные сооружения, помогают отстраиваться и делают миллион других мелочей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250404
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 708250404,
					"content": "В ордене сейчас у каждого полно работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250405
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 708250405,
					"content": "Стоять на страже главных ворот по сравнению с этим легко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 708250406,
					"content": "Почему бы тебе не обратиться в Гильдию искателей приключений?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250407
					]
				},
				{
					"id": 708250407,
					"content": "Они с самого начала нам очень помогают. Сперва они искали и спасали в городе пострадавших, а позже следили за перемещениями монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250408
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 708250408,
					"content": "Когда чудовища стали собираться за городом, именно благодаря их докладам мы могли разрабатывать своевременные ответные меры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250409
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 708250409,
					"content": "А теперь они изо всех сил помогают городу восстановиться. Одному ордену такая ноша не по силам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250410
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 708250410,
					"content": "К слову, надо бы поблагодарить Сайруса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хоффман"
				}
			]
		},
