			},
			"dialogs": [
				{
					"id": 708250601,
					"content": "#Как дела? Ты разобрал{F#ась}{M#ся} с баррикадами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250602
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 708250602,
					"content": "Всё чисто.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250603
					]
				},
				{
					"id": 708250603,
					"content": "Отлично. Если бы не ты, кто знает, сколько бы это безобразие ещё стояло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250604
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 708250604,
					"content": "Это тебе, почётный рыцарь. Спасибо за твою помощь городу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хоффман"
				}
			]
		}
	]
