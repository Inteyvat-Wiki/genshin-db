			"dialogs": [
				{
					"id": 747090101,
					"content": "#Спасибо вам, {NICKNAME} и Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090102
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747090102,
					"content": "Я собрала симптомы больных рыбок и приготовила для них секретные мелюзинские снадобья...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090103
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747090103,
					"content": "Если добавить в аквариум эти травы, рыбки скоро успокоятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090104
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747090104,
					"content": "То есть наш аквариум превратится в лазарет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747090105,
					"content": "Да уж... такой план под силу провернуть одной Сиджвин!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090106,
						747090107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747090106,
					"content": "Но травы снимут симптомы лишь на время?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				},
				{
					"id": 747090108,
					"content": "Верно. А для этого нужно пригласить ко мне на медосмотр рыбок с разными характеристиками, тогда я смогу точно определить причины недуга...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090109
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747090109,
					"content": "Исходя из особенностей рыбок, я составлю список пациентов, которые нуждаются в обследовании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090110
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747090110,
					"content": "Пожалуйста, обращайте внимание на таких рыбок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747090107,
					"content": "Чтобы вылечить их, нужно найти причину...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				}
			]
		}
	]
