				"points": []
			},
			"dialogs": [
				{
					"id": 110450621,
					"content": "Простите, с исследованием возникло много проблем. Появившиеся путём сопоставления гипотезы с данными экспериментов совсем не совпадают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450622
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 110450622,
					"content": "С другой стороны, некоторые догадки господина Альбедо, которые он выдвинул благодаря своей интуиции, подкрепились фактами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450623
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 110450623,
					"content": "Я очень рад, что мы продвинулись в исследовании, так что... Нечего унывать! Господин Альбедо сказал, что я хорошо поработал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450624
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 110450624,
					"content": "За подробными результатами обратитесь к нему. Мне нужно продолжить работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимей"
				}
			]
		}
