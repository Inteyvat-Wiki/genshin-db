	"talks": [
		{
			"id": 1104501,
			"completionStepIds": [
				1104501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104501",
							"2"
						],
						"stepId": 1104501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450101,
					"content": "Уверен, во время странствий тебе довелось столкнуться с множеством загадок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450102
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450102,
					"content": "Как и с физическими способностями, я хотел бы понаблюдать за твоими умственными способностями в практических условиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450103,
						110450104
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450103,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				},
				{
					"id": 110450105,
					"content": "Тебе предстоит исследовать руины и вернуться с ответами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450106
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450106,
					"content": "С разных сторон руин находятся две головоломки. Когда ты их решишь, активируется механизм в центре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450107
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450107,
					"content": "Как и во время проверки физических возможностей, никаких ограничений нет. Я хочу наблюдать за всеми твоими действиями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450108,
						110450110
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450108,
					"content": "#Я неплохо научил{F#ась}{M#ся} решать головоломки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450109
					]
				},
				{
					"id": 110450109,
					"content": "Сразу видно опытного искателя приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450112,
					"content": "#Давай посмотрим на тебя в деле. Будешь готов{F#а} - начинай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450110,
					"content": "Если захотеть - всё получится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450111
					]
				},
				{
					"id": 110450111,
					"content": "Не забывай, что это тест на твои интеллектуальные способности. Везение не будет учитываться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450104,
					"content": "Нельзя ли обойтись письменным тестом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				}
			]
		},
		{
			"id": 1104504,
			"completionStepIds": [
				1104504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104504",
							"2"
						],
						"stepId": 1104504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450461,
					"content": "Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450462,
						110450463
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450462,
					"content": "Непонятные знаки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				},
				{
					"id": 110450401,
					"content": "Насколько я знаю, такие письмена встречаются по всему Тейвату. Их секреты остаются нераскрытыми по сей день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450402
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450402,
					"content": "Много чего о них неизвестно. Например, как они здесь оказались... Очень любопытно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450403
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450403,
					"content": "Позвольте мне их скопировать. Я займусь их изучением после того, как мы закончим наше исследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450404
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450404,
					"content": "Эх, ещё одна непонятная вещь. То нерешаемые загадки, то странные эксперименты... Когда уже будет результат?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450405,
					"content": "Похоже, награды не будет, пока не заплатишь цену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450406,
					"content": "В этот раз я извлёк очень многое. Ту мелочь, которую я подготовил в качестве вознаграждения, даже упоминать не стоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450407
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450407,
					"content": "Позвольте мне первому вернуться в лагерь. Надеюсь, к вашему возвращению я успею подготовить одно скоротечное чудо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450408,
						110450409
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450408,
					"content": "До встречи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450410,
					"content": "Паймон не терпится увидеть результат всей этой нервотрёпки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450411,
					"content": "Если больше никаких дел нет, отправляемся в лагерь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450412,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450413,
					"content": "Стоять. Вы останетесь здесь, пока я не удостоверюсь, что вы не представляете никакой опасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450414
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450414,
					"content": "А?! Откуда ты взялась? Ты всё это время была в горах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450415,
					"content": "Именно так. И я видела всё, чем вы с Альбедо занимались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450416
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450416,
					"content": "Должна сказать, бдительность вы потеряли. Или его вычурные размышления и дружелюбие одурманили вас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450417,
						110450418
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450417,
					"content": "О чём ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450419,
					"content": "Выполняешь приказы незнакомца, пьёшь непонятные зелья, участвуешь в странных экспериментах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450420
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450420,
					"content": "Таких наивных людей не бывает. Я скорее поверю, что тебя обманули. Или, может быть... вы с самого начала в сговоре?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450421
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450421,
					"content": "Сестра, мой датчик паранойи зашкалил и вот-вот взорвётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450422,
						110450423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450422,
					"content": "#Я просто помогал{F#а} ему с исследованием.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450424,
					"content": "#Неважно, что ты там себе думаешь. Да будь он хоть святой. Я знаю Альбедо куда лучше твоего, чужезем{F#ка}{M#ец}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450425
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450425,
					"content": "Меня беспокоит только одно: превратила ли тебя его алхимия в зловещее нечто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450426
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450426,
					"content": "Этого не может быть! Паймон бы почувствовала. И никакой алхимии он не применял...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450427,
					"content": "Алхимик такого уровня может сделать всё что угодно, а вы даже не заметите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450428
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450428,
					"content": "Я не позволю потенциальной угрозе вернуться в Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450429
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450429,
					"content": "И что ты сделаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450430
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450430,
					"content": "Ты хотела удостовериться? Делай, что нужно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450431
					]
				},
				{
					"id": 110450431,
					"content": "#Признаю, ты не безнадёж{F#на}{M#ен}. Мне достаточно будет знать, что ты не контактировал{F#а} ни с чем опасным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450432
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450432,
					"content": "Я уже всё осмотрела. Остались только эти знаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450433
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450433,
					"content": "Но мы понятия не имеем, что они означают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450451
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450451,
					"content": "Знаю. К тому же... Хм, кажется, ничего особенного в них нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450452
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450452,
					"content": "Лучше я на всякий случай их скопирую... Теперь это место представляет важность. Нужно организовать патрули.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450434
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450434,
					"content": "Итак, судя по всему, никакой угрозы ты не представляешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450435
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450435,
					"content": "На это я и надеялась. Мне бы очень не хотелось работать из-за тебя сверхурочно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450436
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450436,
					"content": "...Сверхурочно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450437
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450437,
					"content": "#Перед тем как мы расстанемся, мой тебе совет, чужезем{F#ка}{M#ец}. Не спеши доверять Альбедо, и постарайся больше не совершать необдуманных поступков. Сегодня ты наделал{F#а} много глупостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450439
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110450439,
					"content": "Ушла. Какая же упрямая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450440
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450440,
					"content": "В Мондштадте таких людей мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450441,
						110450442
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450441,
					"content": "Может, она просто не чувствует себя в безопасности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450443,
					"content": "Да ну её. Идём к Альбедо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450442,
					"content": "Может, она просто слишком чувствительна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450423,
					"content": "Не думаю, что он плохой человек.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450418,
					"content": "Он что-то скрывает?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450409,
					"content": "#Думаю, проверку умственных способностей я прош{F#ла}{M#ёл}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450463,
					"content": "#Кажется, я такое где-то уже видел{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				}
			]
		},
		{
			"id": 1104505,
			"completionStepIds": [
				1104505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104505",
							"2"
						],
						"stepId": 1104505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450501,
					"content": "Вы вернулись! Очень вовремя, заключение почти готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450502
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450502,
					"content": "Вас долго не было. По дороге что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450503,
						110450504
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450503,
					"content": "Нет, ничего.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450506
					]
				},
				{
					"id": 110450506,
					"content": "Пора огласить результаты. Сегодня мы добыли огромное количество информации. Завершить всё исследование за один подход было очень трудно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450507
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450507,
					"content": "Мой предварительный вывод таков: от людей этого мира ты почти ничем не отличаешься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450508,
						110450509
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450508,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450510,
					"content": "Это можно было увидеть с первого взгляда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450511,
					"content": "Мы столько горбатились ради вот этого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450512,
					"content": "Терпение, только терпение. Я понимаю, что вам это кажется очевидным, но на деле ничего очевидного в этом мире не существует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450513
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450513,
					"content": "Вы когда-нибудь рассматривали такую возможность, что среда Тейвата могла быть враждебной к чужакам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450514,
						110450515
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450514,
					"content": "Боги его знают.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450516,
					"content": "Я упоминал природные законы этого мира. Ты беседуешь со мной без каких-либо проблем. Кажется, так и должно быть, но это, возможно, маленькое чудо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450517
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450517,
					"content": "Семя, о котором я говорил ранее, как и ты, пришло сюда издалека. Условия Тейвата не позволяют ему прорасти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450518
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450518,
					"content": "Но, понаблюдав за тобой, я кое-что придумал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450519
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450519,
					"content": "Имитация твоей жизни вдохновила меня, и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450520
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450520,
					"content": "Ого! К-кажется, что-то появляется!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450521
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450521,
					"content": "Переход от небытия к существованию, от ростка до пышного цветка... к смерти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450522
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450522,
					"content": "Заботиться о жизни из другого мира - всё равно, что заботиться о самом мире, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450523
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450523,
					"content": "О...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450524,
						110450525
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450524,
					"content": "Как красиво.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450526,
					"content": "Эх... Похоже, на этом всё. На мгновения раскрывшийся цветок невероятной красоты... Вот в чём заключается высшее достижение жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450527
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450527,
					"content": "Паймон думала, что после всех наших стараний он будет цвести вечно. Никаких фруктов тоже нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450528
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450528,
					"content": "Жизнь - это всё многообразие её свободных форм. Её ценность не определить сроком. Бесценна даже секундная вспышка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450529
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450529,
					"content": "Короткая жизнь может быть хорошей. Её яркие, эффектные мгновения не будут омрачены одиночеством.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450530
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450530,
					"content": "Теперь вы понимаете, почему я говорил, что наша беседа может быть маленьким чудом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450531,
						110450532
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450531,
					"content": "#Я хотя бы ещё не увял{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450533,
					"content": "А? Почему все вдруг погрустнели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450534
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450534,
					"content": "#Хе-хе, выше нос, {NICKNAME}, у тебя есть Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450535
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450535,
					"content": "А ещё есть Альбедо. Паймон очень хочет с тобой дружить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450536
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110450536,
					"content": "Спасибо вам. Жить в одиночестве можно, но избавиться от него определённо не помешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450537
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450537,
					"content": "#{NICKNAME}, твоя помощь вдохновила меня на открытие, которое позволило этому цветку распуститься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450538
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450538,
					"content": "#Значит, я полезн{F#ая}{M#ый} подопытн{F#ая}{M#ый}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450539
					]
				},
				{
					"id": 110450539,
					"content": "Нет, что ты. Время, что я провёл с тобой в горах, оказалось бесценным путешествием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450540
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450540,
					"content": "Могу ли я... Если будет потребность... Рассчитывать на твою помощь в будущем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450541
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450541,
					"content": "Я с радостью составлю тебе компанию и без потребности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450542
					]
				},
				{
					"id": 110450542,
					"content": "Тогда... спасибо тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450543
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450543,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450544
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450544,
					"content": "#Хоть я и говорил е{M#му}{F#й}, что результаты опытов заурядны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450545
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450545,
					"content": "Но что это за осадок? Его здесь быть не должно... Что бы это значило?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450546
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450546,
					"content": "Порождённые землёй порочны, но те, которых породил мел, совершенны... Мы с тобой из одной материи, которая ещё не была полностью определена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450547
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450547,
					"content": "Если я однажды потеряю над собой власть... Разрушу Мондштадт... Разрушу всё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450548
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450548,
					"content": "Могу ли я рассчитывать, что ты меня остановишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110450532,
					"content": "#(Хотел{F#а} бы я знать, всё ли в порядке с {F#братом}{M#сестрой}...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450525,
					"content": "Он жил так недолго...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450515,
					"content": "Могло быть и так.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450509,
					"content": "И всё?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450504,
					"content": "Нас задержала сестра.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450505
					]
				},
				{
					"id": 110450505,
					"content": "Ничего, она просто делает свою работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450506
					],
					"speakerTitle": "Альбедо"
				}
			]
		},
		{
