			"dialogs": [
				{
					"id": 150450601,
					"content": "О, как красиво!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450602
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450602,
					"content": "Ребята! Сюда, нам нужно сфотографироваться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450603
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450603,
					"content": "Неплохо! Все выглядят бодрыми, никаких растрёпанных чёлок и чёрных кругов под глазами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450604
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450604,
					"content": "То есть ты даже за этим следишь, когда зовёшь людей фотографироваться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450605,
					"content": "Настоящий проводник обращает внимание на любые мелочи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450606
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450606,
					"content": "Да, а если ищешь интересного попутчика, тебе нужен бард, который всегда не прочь выпить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450607
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450607,
					"content": "...Это тут вообще при чём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450608,
					"content": "Ха-ха, а я понимаю Венти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450609
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450609,
					"content": "В кругу друзей можно болтать любую чепуху.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450610
					]
				},
				{
					"id": 150450610,
					"content": "#Ты уверен{F#а}? Или тоже пытаешься подыграть бродяжке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450611,
					"content": "Иногда немного чепухи не повредит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450612
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150450612,
					"content": "#Так, {NICKNAME}, давай ты наденешь бандану аш. Мы решили подарить её тебе на память!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450613
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450613,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450614
					]
				},
				{
					"id": 150450614,
					"content": "Тебе идёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450615
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450615,
					"content": "Итак...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450616
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450616,
					"content": "Три, два, один...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450617
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450617,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450618,
					"content": "Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450619
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450619,
					"content": "...Извините. Из-за всей этой чепухи Паймон будто заело. Ни одно слово в голову не приходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450620
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450620,
					"content": "Не хочется со всеми расставаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450621
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150450621,
					"content": "Но говорить об этом тоже не хочется: стоит только сказать, и каникулы сразу закончатся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450622
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150450622,
					"content": "Как ты... И ты ещё говоришь, что не умеешь читать мысли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450623
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450623,
					"content": "Ха-ха, Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450624
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450624,
					"content": "Не волнуйся, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450625
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450625,
					"content": "Лето непременно вернётся. Помнишь, ты сама загадывала желание Пиро Архонту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450626
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450626,
					"content": "У каждого из нас свой путь, но все мы ценим нашу дружбу, а значит, наши пути обязательно пересекутся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450627
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450627,
					"content": "Профессор Венти, а Беннет стал настоящим оратором!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450628
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450628,
					"content": "Я тут ни при чём! Хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450629
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450629,
					"content": "Тогда почему у тебя такой довольный голос? Ух... Паймон только расчувствовалась, а вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450630
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450630,
					"content": "Давайте попробуем ещё раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450631
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450631,
					"content": "Все вместе, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450632
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450632,
					"content": "Какое слово скажем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450633
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150450633,
					"content": "Звезда удачи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450634
					]
				},
				{
					"id": 150450634,
					"content": "Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450635
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450635,
					"content": "Три, два, один...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450636
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450636,
					"content": "Звезда удачи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450641
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450641,
					"content": "Вы весело проводите время с друзьями...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150450642
					]
				},
				{
					"id": 150450642,
					"content": "...Беннет, что ты собираешься делать дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450643
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150450643,
					"content": "Если пока трудно принять решение, давай к нам, в племя Народа Родников. И думай столько, сколько тебе нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450644
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450644,
					"content": "...Спасибо за заботу, Муалани.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450645
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450645,
					"content": "Я здесь встретился с Пиро Архонтом и поблагодарил её за всё, что она для меня сделала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450646
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450646,
					"content": "Она сказала, что мы попали в симуляцию Пепельного моря, созданную силой Бездны. Подземелье было очень нестабильно, а сейчас и вовсе исчезло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450647
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450647,
					"content": "Потом мы немного поговорили о моём будущем. Пиро Архонт предложила мне остаться в Натлане, но сказала, что примет любое моё решение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450648
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450648,
					"content": "Я много думал... и решил вернуться в Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450649
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450649,
					"content": "Ты скучаешь по своим папам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450650
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150450650,
					"content": "В том числе и поэтому. Я обещал рассказать папам истории о своих приключениях в Натлане, и не могу нарушить данное слово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450651
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450651,
					"content": "Но ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450652
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450652,
					"content": "Прощаясь с родителями, я пообещал, что стану легендарным искателем приключений, лучшим во всём Тейвате.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450653
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450653,
					"content": "А искатели приключений не могут долго сидеть на одном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450654
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450654,
					"content": "Беннет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450655
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450655,
					"content": "А если за пределами Натлана у тебя снова начнётся полоса неудач? Что тогда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450656
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450656,
					"content": "Ха-ха, ничего страшного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450657
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450657,
					"content": "Тепло, которым я напитался во время этого приключения, поможет мне справиться со всеми вызовами, которые ждут впереди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450658
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450658,
					"content": "Я хочу сам писать свою судьбу. А ещё хочу делиться теплом, которым окружили меня родители и друзья. Я всегда верил, что это правильно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450659
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450659,
					"content": "За нашего командира!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450660
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150450660,
					"content": "За командира Беннета!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450661
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450661,
					"content": "Ура!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450662
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450662,
					"content": "Ох... скоро утро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450663
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450663,
					"content": "Вот это я понимаю - веселье! Ну что, кто следующий?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450664
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450664,
					"content": "Беннет давно клюёт носом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450665
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150450665,
					"content": "Нет, я в порядке... Я держусь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450666
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150450666,
					"content": "Давайте спать! Муалани, раз ты до сих пор бодра и весела, уборка будет на тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450667
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150450667,
					"content": "А? Почему на мне?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450668
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150450668,
					"content": "#{NICKNAME}, не откажешься со мной прогуляться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450669
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450669,
					"content": "Я тут разведал одно место с красивым видом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		},
		{
			"id": 1504507,
			"completionStepIds": [
				1504507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1504507",
