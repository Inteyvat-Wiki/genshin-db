			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венти"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							984.35,
							298.017,
							14628.56
						],
						"pointId": 11712
					}
				]
			},
			"dialogs": [
				{
					"id": 150450701,
					"content": "А ты умеешь выбрать место, бродяжка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450702,
					"content": "Ха-ха, я рад, что тебе здесь нравится. Некоторые истории нельзя рассказывать птицам, они предназначены звёздам на небосводе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450703
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450703,
					"content": "Пришло время для сказки на ночь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450704
					]
				},
				{
					"id": 150450704,
					"content": "Ха-ха... скорее, это история, которая берёт своё начало во «Времени».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450705
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450705,
					"content": "Давным-давно «Вре{RUBY#[S]Астарот}мя» начало писать историю этого мира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450706
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450706,
					"content": "Ко всем живым существам она относилась одинаково. И ни одно из них не занимало места в её сердце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450707
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450707,
					"content": "Её память была подобна древнему свитку, на котором были запечатлены все люди, все события, все встречи и расставания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450708
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450708,
					"content": "Тогда я был Анемо духом и случайно встретил «Время» в храме Тысячи ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450709
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450709,
					"content": "Услышав моё желание, она даровала мне часть своей силы и власти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450710,
						150450711
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450710,
					"content": "Ветер приносит семена...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450712
					]
				},
				{
					"id": 150450712,
					"content": "Вижу, тебе знакома история «Время и Ветер».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450713
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450713,
					"content": "Красивая, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450714
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450714,
					"content": "Благодаря воспоминаниям, запечатлённым в ритуалах, стихах, руинах и древних письменах, существа, которых она считала столь незначительными, встречались ей... снова и снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450715
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450715,
					"content": "Эту историю ты и хотел нам рассказать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450716,
					"content": "Гм... Нет, это только начало истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450717
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450717,
					"content": "Загрязнение Пепельного моря неразрывно связано со временем. Другими словами, это бедствие существует в каждом моменте времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450718
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450718,
					"content": "Я отличался от «Времени», в моём сердце всегда было много желаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450719
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450719,
					"content": "Пять столетий назад, надеясь остановить загрязнение Пепельного моря и не дать ему перекинуться на земли за пределами Теночцитока, я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450720
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450720,
					"content": "Я сдул Пепельное море с оси времени, превратив его в Безветренную землю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450721
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450721,
					"content": "Вот кто стоит за исчезновением Пепельного моря...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450722
					]
				},
				{
					"id": 150450722,
					"content": "Ох, кажется, я тебя запутал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450723
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450723,
					"content": "Если хочешь узнать о том, как Пепельное море исчезло из Теночцитока два или три десятилетия назад, тебе лучше обратиться к кому-то другому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450724
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450724,
					"content": "Пепельное море хранит в себе слишком много историй, которые не должны были стать его частью... Я лишь появился в одной из глав.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450725
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450725,
					"content": "И мне пришлось заплатить свою цену за выбор, сделанный пять столетий назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450726
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450726,
					"content": "Некоторые души не смогли вернуться в Мондштадт... Другие осели на этой земле, слились с маниту и превратились в аш.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450727
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450727,
					"content": "То есть ты вернулся на Теночциток, чтобы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450728
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450728,
					"content": "Да, чтобы поработать с нынешним Пиро Архонтом, Мавуикой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450729
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450729,
					"content": "Значит, когда мы зажгли свечу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450730
					]
				},
				{
					"id": 150450730,
					"content": "Верно. Огонь был сигналом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450731
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450731,
					"content": "Мавуика должна была открыть разлом между тем пространством и настоящим Пепельным морем, чтобы я мог туда проникнуть. Это единственный способ вернуть все души, которые хотят вернуться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450732
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450732,
					"content": "А трюк с возвращением воспоминаний... Хе-хе, ты знаешь, мне это не впервой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450733
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450733,
					"content": "#Мавуика говорила, что ты хотел{F#а} нас познакомить. Видишь, а я тебя опередил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450734
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450734,
					"content": "Она тоже любит вино и свободу. Мы сразу отлично поладили, хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450735,
						150450736
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450735,
					"content": "Ты превзошёл самого себя...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450737
					]
				},
				{
					"id": 150450737,
					"content": "Я так вымотался в последние дни... едва держусь, чтобы снова не отключиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450738
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450738,
					"content": "Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450739
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450739,
					"content": "Но мысль о том, что впереди меня ждёт вкусное медовое вино и вино из одуванчиков, помогает держаться на плаву...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450740
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450740,
					"content": "Ты совсем не выглядишь уставшим. Не думай, будто стоит надавить немного на жалость, и мы побежим угощать тебя выпивкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450741
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150450741,
					"content": "Эй, ты слишком строга ко мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450742
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450742,
					"content": "Венти...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450743
					]
				},
				{
					"id": 150450743,
					"content": "#{NICKNAME}, ты ведь угостишь меня стаканчиком?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450744,
						150450745
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450744,
					"content": "Интересно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450746
					]
				},
				{
					"id": 150450746,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450747
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450747,
					"content": "Наверное... защищать Мондштадт. А ещё чтобы каждый, кто хочет остаться там, мог выбрать свой собственный путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				},
				{
					"id": 150450745,
					"content": "...чего бы ты пожелал сейчас?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450746
					]
				},
				{
					"id": 150450736,
					"content": "Это великий подвиг...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450737
					]
				},
				{
					"id": 150450711,
					"content": "...а время их взращивает.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450712
					]
				}
			]
		},
