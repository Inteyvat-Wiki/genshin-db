	"talks": [
		{
			"id": 1103202,
			"completionStepIds": [
				1103203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103203",
							"2"
						],
						"stepId": 1103203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хуэй Синь",
					"Гань Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320201,
					"content": "#Спасибо, что приняли моё приглашение, госпожа Гань Юй. Путешественни{F#ца}{M#к} и Паймон, здорово, что вы тоже пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320202
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320202,
					"content": "Мелочи, мелочи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110320203,
					"content": "Это так мило с твоей стороны, Хуэй Синь. Тебе стоило немалых хлопот всё устроить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320204
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320204,
					"content": "Хе-хе, если честно... Я не только хотела отблагодарить вас всех за помощь, но и кое-что сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320205
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320205,
					"content": "Да? Если тебе нужна помощь, просто скажи, не стесняйся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320206
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320206,
					"content": "Ах, нет... Помощь мне не нужна. Эм... Просто выслушайте меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320207
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320207,
					"content": "С удовольствием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320208
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320208,
					"content": "Хех... Когда я была маленькой, папа много мне рассказывал о госпоже Гань Юй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320209
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320209,
					"content": "Я всегда глубоко уважала своего отца, но не могла не восхищаться тем, какая вы мягкая и надёжная...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320210
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320210,
					"content": "Я решила работать в павильоне Лунного моря лишь потому, что вы были моим кумиром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320211
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320211,
					"content": "Я не думала, что ты такого высокого мнения обо мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320212
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320212,
					"content": "На деле работа секретаря в павильоне Лунного моря оказалась крайне изнурительной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320213
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320213,
					"content": "Мне до вас ещё так далеко, поэтому я часто в себе сомневаюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320214
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320214,
					"content": "Не согласна. Ты по-своему отличный секретарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320215
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320215,
					"content": "Хе-хе, спасибо, госпожа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320216
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320216,
					"content": "За эти годы у меня родилась дочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320217
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320217,
					"content": "Ох! Так дядюшка Тянь, оказывается, дедушка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110320218,
					"content": "Под влиянием моих идеалов она решила пойти по моим стопам и стать секретарём павильона Лунного моря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320219
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320219,
					"content": "Поначалу я за неё переживала, ведь служба эта нелёгкая. Я до сих пор не уверена, хватит ли ей сил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320220
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320220,
					"content": "Но после всего, что случилось, я решила во что бы то ни стало поддерживать её выбор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320221
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320221,
					"content": "Что заставило тебя передумать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320222
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320222,
					"content": "То, что вы, госпожа Гань Юй, будете её старшей коллегой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320223
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320223,
					"content": "Вы так же мягко будете направлять её и говорить: «Так делала твоя мама...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320224
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320224,
					"content": "Мне это представляется столь прекрасным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320225
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320225,
					"content": "Через двадцать лет ей могут понадобиться ваши наставления. Надеюсь, я не прошу чересчур многого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320226
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320226,
					"content": "Хуэй Синь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320227
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320227,
					"content": "Я... Я не думала, что столько значу для тебя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320228
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320228,
					"content": "Так же, как когда вы показали мне уловку моего отца. Люди чувствуют себя более непринуждённо, когда вы становитесь свидетелем их судеб.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320229
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320229,
					"content": "Свидетелем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320230
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320230,
					"content": "...Это правда, я была свидетелем тысяч лет истории гавани Ли Юэ. Всех её перемен, людских историй...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320231
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320231,
					"content": "Но я всегда считала её ничем иным, как источником одиночества.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320232
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320232,
					"content": "Хуэй Синь, ты не представляешь, насколько важны для меня эти слова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320233
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320233,
					"content": "Ты заставила меня понять, что помимо контракта Властелина Камня меня с людьми Ли Юэ связывает нечто большее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320234
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320234,
					"content": "Они полагаются на меня, признают меня, желают, чтобы я оставалась рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320235
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320235,
					"content": "Ну конечно! Второй такой госпожи Гань Юй у нас не будет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320236
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320236,
					"content": "Хе-хе... Верно. Поэтому мне нельзя вас разочаровывать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320237
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320237,
					"content": "Ура! Гань Юй наконец-то приободрилась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110320238,
					"content": "Даже если моё место заняли, я всё же хотела бы за него побороться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320239
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320239,
					"content": "Я не подведу вас. Я продолжу выполнять контракт и работать секретарём Цисин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320240,
						110320241
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320240,
					"content": "#Ух... Я ведь столько раз тебе уже говорил{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				},
				{
					"id": 110320242,
					"content": "В общем, я сейчас сама во всём разберусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320243
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320243,
					"content": "Боюсь, пока меня не было, дела здесь шли наперекосяк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320244
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320244,
					"content": "Работа не ждёт, скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320245
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320245,
					"content": "Удачи, госпожа Гань Юй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320246
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 110320246,
					"content": "Что-о-о? Уже уходишь? Паймон ещё не поела!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110320241,
					"content": "От тебя избавиться не пытались. Это просто недоразумение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				}
			]
		},
		{
			"id": 1103203,
			"completionStepIds": [
				1103204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103204",
							"2"
						],
						"stepId": 1103204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бай Сяо",
					"Бай Ши",
					"Бай Вэнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320301,
					"content": "Ах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320302
					],
					"speakerTitle": "Бай Ши"
				},
				{
					"id": 110320302,
					"content": "Бай Ши, ты как?.. Ты что, заснула стоя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320303
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 110320303,
					"content": "Смотрите! Смотрите, кто вернулся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320304
					],
					"speakerTitle": "Бай Сяо"
				},
				{
					"id": 110320304,
					"content": "У вас даже есть время на отдых? Похоже, вы втроём удачно меня заменяете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320305
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320305,
					"content": "Ох, нет! Мы просто... Работали столько, что не было времени перевести дух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320306
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 110320306,
					"content": "Мы уж думали, что не доживём до вашего возвращения, госпожа Гань Юй...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320307
					],
					"speakerTitle": "Бай Сяо"
				},
				{
					"id": 110320307,
					"content": "Госпожа Гань Юй, мы так по вам соскучились...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320308
					],
					"speakerTitle": "Бай Ши"
				},
				{
					"id": 110320308,
					"content": "Хм, такого тёплого приёма я от вас не ожидала. Виделись мы с вами лишь раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320309
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320309,
					"content": "Мы дни и ночи молились, чтобы вы пришли и вновь принялись за свои обязанности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320310
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 110320310,
					"content": "Для нас вы словно Адепт, сошедший спасти смертных...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320311
					],
					"speakerTitle": "Бай Ши"
				},
				{
					"id": 110320311,
					"content": "Давайте забудем былые обиды. Прошу, просто освободите нас от этой каторги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320312
					],
					"speakerTitle": "Бай Сяо"
				},
				{
					"id": 110320312,
					"content": "Хорошо, хорошо, я всё поняла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320313
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320313,
					"content": "Пожалуйста, разделите все имеющиеся дела на правительственные, торговые и социальные. На текущие и ещё не начатые нанесите отметки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320314
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320314,
					"content": "А остальное я возьму на себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320315
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320315,
					"content": "Конечно! Будет сделано!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320316
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 110320316,
					"content": "Наконец... Мы спасены...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320317
					],
					"speakerTitle": "Бай Ши"
				},
				{
					"id": 110320317,
					"content": "Ах, да, вот ещё что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320318
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320318,
					"content": "#Путешественни{F#ца}{M#к}, я хочу от всего сердца поблагодарить тебя. Без тебя я бы так и не избавилась от душевных терзаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320319,
						110320320
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320319,
					"content": "#Я был{F#а} рад{F#а} пройти с тобой этот путь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320321
					]
				},
				{
					"id": 110320321,
					"content": "Я на седьмом небе от счастья, что смогла подружиться с человеком вне работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320322
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320322,
					"content": "Я хотела бы отплатить тебе за добро, когда покончу с работой. Позволишь ли ты мне... Присоединиться к тебе в одном из твоих путешествий?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320323
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320323,
					"content": "Но ведь... Твоя работа никогда не кончается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110320324,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320325
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320325,
					"content": "Хм... Оставим этот вопрос на будущее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 110320320,
					"content": "Хорошо, что ты взяла себя в руки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320321
					]
				}
			]
		}
	]
}