					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181802",
							"2"
						],
						"stepId": 7181802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзян Чэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180201,
					"content": "Это ты, жена? Ты вернулась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180202
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180202,
					"content": "Простите, но вы меня с кем-то путаете...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180203
					]
				},
				{
					"id": 718180203,
					"content": "Ха, я ещё из ума не выжил... Чтоб я собственную жену не признал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180204
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180204,
					"content": "Мы ведь только что с тобой говорили, идёт большой праздник, и пора бы нашей дочурке прикупить платьице...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180205
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180205,
					"content": "Ой, с тобой гости... Так ты за швеёй ходила? Да ты читаешь мои мысли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180206
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180206,
					"content": "Дедушка Цзян Чэн, это я, мисс Бай. Я вам недавно тофу приносила, помните?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180207
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 718180207,
					"content": "А?.. Мисс Бай... Ну конечно же помню! Отец твой недавно рассказывал мне, какая ты у него хорошая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180208
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180208,
					"content": "Э... Когда это было-то?.. Жена, может, ты помнишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180209,
						718180210
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180209,
					"content": "...Я помню.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				},
				{
					"id": 718180211,
					"content": "Ха! Я же говорил, с головой у меня полный порядок... Ещё, ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180212
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180212,
					"content": "Дедушка Цзян Чэн, вы бы отдохнули. Не стоит так напрягаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180213
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 718180213,
					"content": "#Путешественни{F#ца}{M#к}, как насчёт того, чтобы помочь дедушке Цзян Чэну с уборкой? А я тем временем составлю ему компанию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180214
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 718180214,
					"content": "С удовольствием.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180215
					]
				},
				{
					"id": 718180215,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 718180210,
					"content": "Конечно, помню.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				}
			]
		},
