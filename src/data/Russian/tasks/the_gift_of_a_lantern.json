			},
			"dialogs": [
				{
					"id": 718180301,
					"content": "Жена, ты тоже иди сюда, поговори с мисс Бай... Отец её такой мастер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180302
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180302,
					"content": "Тофу, что они продают в Ли Юэ, высший сорт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180303
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180303,
					"content": "Да, а что тебя ко мне привело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180304
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180304,
					"content": "Мы принесли вам небесный фонарь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180305
					]
				},
				{
					"id": 718180305,
					"content": "Небесный фонарь... Ах, ты так о нас заботишься, каждый год их приносишь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180306
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180306,
					"content": "Жена, помнишь, какие отличные фонари я плёл? И все в округе просили, чтобы я им тоже сделал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180307
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180307,
					"content": "Небесные фонари так украшают праздник... Погоди, сейчас я его повешу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180308
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180308,
					"content": "Я повешу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180309
					]
				},
				{
					"id": 718180309,
					"content": "Хорошо, только осторожно, не упади...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзян Чэн"
				}
			]
		},
