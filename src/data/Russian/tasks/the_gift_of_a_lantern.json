				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мисс Бай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180101,
					"content": "#Привет, путешественни{F#ца}{M#к}! Спасибо, что помог{F#ла} мне в тот раз. В деревне Цинцэ уже давно не было так оживлённо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180102
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 718180102,
					"content": "Не за что.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180103
					]
				},
				{
					"id": 718180103,
					"content": "В прошлые годы здесь никого кроме Чжи и меня не было, и мы могли только сделать парочку небесных фонарей для детишек, обсудить со стариками дела житейские, да приготовить немного вкусностей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180104
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 718180104,
					"content": "С твоей помощью нам удалось устроить живой и весёлый Праздник морских фонарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180105
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 718180105,
					"content": "Веселье весельем... Но мне ещё нужно проведать стариков. Сегодня я иду к Цзян Чэну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180106
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 718180106,
					"content": "Сходишь со мной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180107
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 718180107,
					"content": "Давай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180108
					]
				},
				{
					"id": 718180108,
					"content": "Хорошо. Тогда идём к нему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Бай"
				}
			]
		},
		{
			"id": 7181802,
			"completionStepIds": [
				7181802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
