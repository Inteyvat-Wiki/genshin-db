			},
			"dialogs": [
				{
					"id": 718180401,
					"content": "Готово? Ой, какая прелесть. Следующий год обязательно будет хорошим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180402,
						718180403
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180402,
					"content": "Непременно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				},
				{
					"id": 718180404,
					"content": "Дедушка Цзян Чэн, нам пора. У нас ещё много дел. Я скоро загляну к вам ещё раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180405
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 718180405,
					"content": "Ладно, ладно... У вас, молодых, всегда полно дел... Целая прорва...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180406
					],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180406,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180407
					]
				},
				{
					"id": 718180407,
					"content": "Ах... Жена, ты за землёй-то нашей присматривай...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзян Чэн"
				},
				{
					"id": 718180403,
					"content": "Определённо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				}
			]
		},
