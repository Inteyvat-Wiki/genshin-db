			},
			"dialogs": [
				{
					"id": 200500101,
					"content": "Ох, какая головная боль! Что же мне с этим делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500102
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200500102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500103
					]
				},
				{
					"id": 200500103,
					"content": "Готовлюсь к отборочным соревнованиям в Ордо Фавониус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500104
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200500104,
					"content": "Ох... Мне никогда не стать такой же сильной, как Джинн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500105
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200500105,
					"content": "Нужно больше уделять внимание технике, а не силе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500106
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200500106,
					"content": "Например, я хочу срубить все эти деревянные чучела одним ударом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500107
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200500107,
					"content": "Если у тебя найдётся минутка, подскажи, как это сделать, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500108,
						200500109
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200500108,
					"content": "Надо подумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500110
					]
				},
				{
					"id": 200500110,
					"content": "Конечно, не спеши. Эти чучела никуда не денутся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500111
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200500111,
					"content": "Да и я тоже никуда не денусь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200500114,
					"content": "Говорят, что стихии взаимодействуют особым образом. Интересно, если мы применим элементальные силы к этой жаровне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500115
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200500115,
					"content": "Что? Жаровня потухла? Придётся придумать что-то ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200500109,
					"content": "Давай попробуем вместе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500112
					]
				},
				{
					"id": 200500112,
					"content": "Тебе нравится командный бой? Всегда приятно знать, что ты не один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500113
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200500113,
					"content": "Но я училась сражаться только в одиночку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Айлин"
				}
			]
		},
