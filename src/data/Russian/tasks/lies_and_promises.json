			"dialogs": [
				{
					"id": 750220404,
					"content": "Уф... Как же его разбудить? Это так раздражает! Он ведь не притворяется спящим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220405,
					"content": "Р-р-р?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220406,
						750220407
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220406,
					"content": "Он и правда спит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				},
				{
					"id": 750220408,
					"content": "(Вы понимаете, что он говорит во сне...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220409
					]
				},
				{
					"id": 750220409,
					"content": "Он намеренно перекрывает путь, чтобы получить еду? Значит, он обманом лишает людей еды... Паймон чувствует, что нас надули...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220410,
					"content": "Хм! В таком случае нам вовсе не обязательно с ним церемониться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220411,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} может обойти его и достать сундук!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220412,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220413,
					"content": "Наша очередь играть не по правилам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220407,
					"content": "...да ещё и разговаривает во сне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				}
			]
