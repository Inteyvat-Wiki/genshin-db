			"dialogs": [
				{
					"id": 750220703,
					"content": "Вы и моргнуть не успеваете, как голодный завриан заглатывает еду.\\nКак он это сделал?",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750220304,
					"content": "Ого! Да он сметает еду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220305,
						750220307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220305,
					"content": "У Паймон появился соперник.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220306
					]
				},
				{
					"id": 750220307,
					"content": "Одной порции, похоже, недостаточно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220308
					]
				},
				{
					"id": 750220306,
					"content": "Эй, ты это о чём?! Паймон - настоящий гурман, очень разборчива в еде и никогда бы не стала... Если ты будешь заглатывать еду не жуя, ты не почувствуешь её вкус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220308,
					"content": "#Д-да! Паймон и подумать не могла, что {REALNAME[ID(2)|SHOWHOST(true)]} на самом деле обжоразавр... Хорошо, что заврианчики не могут столько съесть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220309,
					"content": "С другой стороны, может быть, бедолага умирал с голоду! Бедняжка. Давай дадим ему ещё одну порцию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220310,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220311,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} тоже хочет кушать? Сначала накормим другого завриана, а потом дадим тебе что-нибудь вкусненькое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220312,
					"content": "Вы и моргнуть не успеваете, как голодный завриан заглатывает всё, что стоит перед ним.\\nСнова та же ситуация...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220313
					]
				},
				{
					"id": 750220313,
					"content": "Паймон надеется, что он наелся досыта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220314,
					"content": "Эй! Погоди-ка, почему ты снова сел? Двух порций тебе мало будет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220315,
					"content": "Он что, укладывается на послеобеденный сон прямо перед входом в пещеру? Не похоже, что он собирается впускать нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220316,
					"content": "#Что же делать, {NICKNAME}? Паймон не знает, как объяснить его поведение... Хочешь прилечь после сытного обеда - пожалуйста. Но вход-то зачем перекрывать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220317,
						750220318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220317,
					"content": "Не припомню, чтобы он обещал впустить нас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220318,
					"content": "Кажется, нас обвели вокруг пальца.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220319,
					"content": "Мы столько еды ему отдали... Паймон зла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750220320,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220321,
					"content": "#Даже {REALNAME[ID(2)|SHOWHOST(true)]} считает, что это переходит все границы! {NICKNAME}, надо его разбудить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
