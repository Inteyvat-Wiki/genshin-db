						"pointId": 910303069
					}
				]
			},
			"dialogs": [
				{
					"id": 761240301,
					"content": "Отлично, испытание закончено!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240302
					],
					"speakerTitle": "Цзин-гуй"
				},
				{
					"id": 761240302,
					"content": "#Большое вам спасибо, вы меня очень порадовали. Ты потрясающе владеешь мечом, {M#воин}{F#воительница}. Пожалуй, даже лучше, чем тот паренёк из Гухуа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240303,
						761240304
					],
					"speakerTitle": "Цзин-гуй"
				},
				{
					"id": 761240303,
					"content": "Ай да я!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240306
					]
				},
				{
					"id": 761240306,
					"content": "Благодаря вам у меня наконец случилось озарение. К рыбному соусу нужно добавлять немного рубленого сырого мяса, чтобы раскрыть его вкус. Иначе, если соус немного постоит, рыбный дух уже ничем не перебьёшь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240307
					],
					"speakerTitle": "Цзин-гуй"
				},
				{
					"id": 761240307,
					"content": "О, понятно... А? Слушай, а при чём тут это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761240308,
					"content": "Ха-ха, пустяки, не обращай внимания! В следующий раз попрошу Кастильоне нарисовать мне побольше рыбы, и тогда угощу вас рыбным соусом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзин-гуй"
				},
				{
					"id": 761240304,
					"content": "Ты мне льстишь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240305
					]
				},
				{
					"id": 761240305,
					"content": "Ха, не скромничай. Ты прекрасно фехтуешь, это я точно могу сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240306
					],
					"speakerTitle": "Цзин-гуй"
				}
			]
		},
