			"dialogs": [
				{
					"id": 230140401,
					"content": "Ого! Просто первоклассные печати!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140402
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140402,
					"content": "Сделаю из них новые шестерёнки. Хотя нет... Сперва надо выяснить, что там случилось с подшипниками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140403
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140403,
					"content": "#Путешественни{F#ца}{M#к}, вот ваше вознаграждение, спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140404
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230140404,
					"content": "Судя по всему, это далеко не последняя наша сделка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140405
					],
