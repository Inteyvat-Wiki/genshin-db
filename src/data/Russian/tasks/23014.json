			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гарсия",
					"Лу Тун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230145501,
					"content": "Ох... Лу Тун, подай мне руку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145502
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230145502,
					"content": "Господин, вам следует вернуться и отдохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145503
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230145503,
					"content": "#Путешественни{F#ца}{M#к}! Ты как раз вовремя! Окажешь мне услугу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145504
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230145504,
					"content": "Что с ним?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145505
					]
				},
				{
					"id": 230145505,
					"content": "Проще говоря... Господин Гарсия выпил слишком много кофе и теперь совсем мало спит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145506
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230145506,
					"content": "Хорошо хоть кофе, а не чего покрепче...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145507
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230145507,
					"content": "Лу Тун, послушай... Нам нужно больше тех брошей, с которыми ходят Похитители сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145508
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230145508,
					"content": "#Ох, путешественни{F#ца}{M#к}! Прощу прощения, я тебя совсем не заметил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145509
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230145509,
					"content": "Не поможешь ли мне раздобыть печати, которые носят похитители сокровищ? Нужно всего несколько штук.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145510,
						230145512
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230145510,
					"content": "Тебе следует отдохнуть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145511
					]
				},
				{
					"id": 230145511,
					"content": "Ничего, я знаю, что делаю. Просто руки иногда подводят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230145514,
					"content": "Вернёмся к делу. Принесите немного тех брошей, и я вам заплачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145515
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230145515,
					"content": "Неси сразу мне... Нужно хорошенько на них посмотреть... Детали должны получиться идеальными...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гарсия"
				},
				{
