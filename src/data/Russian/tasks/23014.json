			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лу Тун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230145001,
					"content": "Господин, мы должны найти какой-то заработок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230145002,
					"content": "Я слышал, в городе Сумеру есть театр, и многим труппам, которые там выступают, требуются бухгалтеры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230145003,
					"content": "И актёры в этих труппах... Вы же понимаете, они хорошо зарабатывают, но совершенно не умеют распоряжаться деньгами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230145004,
					"content": "Это наш шанс, господин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230145005,
					"content": "Дорогой Лу Тун, ты удивительно хорошо умеешь заключать сделки и вести бухгалтерию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230145006,
					"content": "Дай мне подумать, дай подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гарсия"
				}
			]
		},
		{
