		{
			"id": 2301450,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301402",
							"2"
						],
						"stepId": 2301402,
						"stateName": "QUEST_STATE_UNFINISHED"
