			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лу Тун",
					"Гарсия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230140101,
					"content": "Господин, прислушайтесь к моему совету. Лучше бы нам найти средства и заплатить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140102
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230140102,
					"content": "Но это же не продавцы, а настоящие грабители! Как может несколько брошей стоить таких денег?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140103
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140103,
					"content": "Наверное, они просто заметили, как загорелись ваши глаза, когда вы увидели эти печати.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140104
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230140104,
					"content": "Зачем тебе эти печати?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140105
					]
				},
				{
					"id": 230140105,
					"content": "#Путешественн{F#ица}{M#ик}! Вы всегда появляетесь в самое нужное время!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140106
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140106,
					"content": "В прошлый раз благодаря вам я смог приготовить подходящую смазку для подшипников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140107
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140107,
					"content": "Но тут появилась новая проблема: воспроизводя некоторые детали, я обнаружил... Что если использовать слишком твёрдый материал, они будут повреждать соседние детали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140108
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140108,
					"content": "И при малейшем ударе детали из слишком твёрдого материала начинают трескаться и даже раскалываться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140109
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140109,
					"content": "Поэтому я стал искать такой материал, который был бы достаточно твёрд, но при этом упруг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140110
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140110,
					"content": "Я не прекращал поиски...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140111
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140111,
					"content": "И не прекращал досаждать господину Ахангару...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140112
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230140112,
					"content": "И понял, что печати у Похитителей сокровищ обладают именно теми свойствами, которые мне нужны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140113
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140113,
					"content": "Но... Эти торговцы грабят народ почище похитителей сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140114,
						230140115
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140114,
					"content": "Снова настал мой звёздный час.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				},
				{
					"id": 230140116,
					"content": "#Путешественн{F#ица}{M#ик}! Я выгравирую ваше имя на главном подшипнике Числовой машины! Как же я вам благодарен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140115,
					"content": "Я тебе помогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				}
			]
		},
