			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гарсия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230140301,
					"content": "#Большое спасибо, путешественн{F#ица}{M#ик}. Этих брошей должно хватить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140302
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140302,
					"content": "Сделаю из них новые шестерёнки. Хотя нет... Сперва надо выяснить, что там случилось с подшипниками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140303
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230140303,
					"content": "#Путешественни{F#ца}{M#к}, вот ваше вознаграждение, спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140304
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230140304,
					"content": "Судя по всему, это далеко не последняя наша сделка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140305
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230140305,
					"content": "Эх, наводить порядок в счетах господина Гарсии - та ещё задачка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				}
			]
		},
