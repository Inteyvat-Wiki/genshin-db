			"dialogs": [
				{
					"id": 741700210,
					"content": "Пока давай оставим вопрос об испытании. Что с Кутро?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700211
					]
				},
				{
					"id": 741700211,
					"content": "Похоже, тот факт, что его выгнали из Исследовательского института Фонтейна, так и не привёл его в чувство. Он такой упрямый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700212
					],
					"speakerTitle": "Бриколь"
				},
				{
					"id": 741700212,
					"content": "Но на этот раз у него нет никаких гарантий. Можешь не сомневаться, творить зло он больше не сможет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бриколь"
				}
			]
		},
