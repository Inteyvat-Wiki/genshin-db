			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бриколь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741700401,
					"content": "У тебя получилось! Значит, это испытание вовсе не является невыполнимым! Думаю, теперь я могу подать предложение в Институт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700402
					],
					"speakerTitle": "Бриколь"
				},
				{
					"id": 741700402,
					"content": "Жаль, что я еще не закончил проверку всех активов, так что придётся вернуться сюда позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700403
					],
					"speakerTitle": "Бриколь"
				},
				{
					"id": 741700403,
					"content": "Но в любом случае спасибо тебе за помощь! Ах да, а вот твоя награда. Счастливого пути!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бриколь"
				}
			]
		},
		{
