			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бриколь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741701701,
					"content": "#О, ты {M#вернулся}{F#вернулась}. И я тоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701702
					],
					"speakerTitle": "Бриколь"
				},
				{
					"id": 741701702,
					"content": "После того как мой доклад был заслушан в Институте, мне предложили одновременно с моей работой по возвращению активов оценить, подходит ли это место в качестве тренировочной площадки для повышения квалификации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701703
					],
					"speakerTitle": "Бриколь"
				},
				{
					"id": 741701703,
					"content": "Ох, как мне всё это знакомо. Помню, как наш администратор одно время из кожи вон лез, чтобы все прошли водолазную подготовку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701704
					],
					"speakerTitle": "Бриколь"
				},
				{
					"id": 741701704,
					"content": "Лично я считаю, что во всём этом мало смысла, но работа есть работа, я полагаю, а задание есть задание... Не говоря уже о том, что это место довольно странное... Я имею в виду, уникальное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701705
					],
					"speakerTitle": "Бриколь"
				},
				{
					"id": 741701705,
					"content": "Так что я установил в этой области несколько якорей-имитаций. Это всего лишь копии, так что волноваться не о чем, они полностью безопасны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701706
					],
					"speakerTitle": "Бриколь"
				},
				{
					"id": 741701706,
					"content": "Сейчас я установил в качестве цели обучения <color=#00E1FFFF>собрать все якоря-имитации в здании за отведённое время</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701707
					],
					"speakerTitle": "Бриколь"
				},
				{
					"id": 741701707,
					"content": "Хочешь попробовать? За участие я могу выдать тебе компенсацию - всё-таки ты помогаешь в исследовании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бриколь"
				}
			]
		},
		{
			"id": 7417004,
			"completionStepIds": [
				7417004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
