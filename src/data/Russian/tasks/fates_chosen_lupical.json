			},
			"dialogs": [
				{
					"id": 4540101,
					"content": "Кто здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540102
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540102,
					"content": "Это мы! Не волнуйся, Рэйзор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4540103,
					"content": "Ты? Ты тоже рыцарь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540104
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540104,
					"content": "Так вы всё-таки не знакомы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540105,
						4540106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4540105,
					"content": "Красная девушка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				},
				{
					"id": 4540107,
					"content": "Нет. Эта тоже красная. Но та - другая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540108
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540108,
					"content": "#Ясно. Ты говорил{F#а} об этом парне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540109
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4540109,
					"content": "Да. Его зовут Рэйзор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4540110,
					"content": "Помоги нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540111
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540111,
					"content": "Гм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540112
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4540112,
					"content": "Мало времени. Я сказал Лупикал уйти. Люди приходят. Плохие люди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540113
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540113,
					"content": "Из деревни?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4540114,
					"content": "Понятно. Но сначала я хочу задать тебе несколько вопросов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540115
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4540115,
					"content": "Чую кровь. Надо спешить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540116
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540116,
					"content": "Кровь? Надеюсь, волки не напали на тех глупцов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4540106,
					"content": "Так это была не Эмбер?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				}
			]
		},
		{
