				{
					"id": 4540602,
					"content": "Грррх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540603
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 4540603,
					"content": "Как и было сказано, чужая стая вторглась на вашу территорию и нарушает кодекс. Они получат по заслугам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540604
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 4540604,
					"content": "Но Рэйзор не должен в это вмешиваться. Волки сами разберутся между собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540605
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 4540605,
					"content": "Твое оружие - меч, а не зубы. Ты ранишь молниями, а не когтями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540606
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 4540606,
					"content": "Ты человек, Рэйзор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540607
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 4540607,
					"content": "Я не такой. Мы разные! Они другие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540608
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540608,
					"content": "Это дело волков и только волков. Ты... не волк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540609
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 4540609,
					"content": "Но ты и не простой человек. Ты Лупикал. Это большая честь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540610
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 4540610,
					"content": "Если захочешь, я могу тренировать тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540611
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 4540611,
					"content": "На этом всё. До встречи, Рэйзор и компания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540612
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 4540612,
					"content": "Эй, Рэйзор! Почему бы тебе не провести несколько дней в городе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540613
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4540613,
					"content": "Да! У тебя же есть друзья в Мондштадте, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4540614,
					"content": "Красная девушка, например.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4540615,
					"content": "Тебе не безопасно оставаться здесь. На тебя могут напасть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540616
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4540616,
					"content": "Я не могу в городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540617
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540617,
					"content": "И здесь тоже не могу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540618,
						4540619
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540618,
					"content": "Рэйзор...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				},
				{
					"id": 4540621,
					"content": "#Спасибо вам. {NICKNAME}, Паймон, другая красная девушка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540622
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540622,
					"content": "Как же так?! Мы с тобой так долго разговариваем, а ты до сих пор не знаешь моего имени?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540623
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4540623,
					"content": "Прощайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540619,
					"content": "Не унывай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				}
			]
		},
		{
			"id": 45407,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
