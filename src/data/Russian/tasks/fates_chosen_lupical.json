			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рэйзор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4540301,
					"content": "Мы вернулись! Посмотри, столько достаточно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4540302,
					"content": "Достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540303
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540303,
					"content": "Рэйзор рассказал мне о волчьем кодексе чести. Это просто потрясающе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540304
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4540304,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540305
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540305,
					"content": "Мы не нашли ни одного волка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540307
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4540307,
					"content": "Волки обычно такие, но тот, которого мы поймали, какой-то дурной, что ли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540308
					],
					"speakerTitle": "Йотун"
				},
				{
					"id": 4540308,
					"content": "А ты что здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540309
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4540309,
					"content": "Ищу вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540310
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4540310,
					"content": "Ты! Мальчик, который рос с волками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540311
					],
					"speakerTitle": "Йотун"
				},
				{
					"id": 4540311,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540312
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4540312,
					"content": "Так это ты! Стоило бы догадаться, что это твоих рук дело. У волков не хватило бы ума организовать такие атаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540313
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4540313,
					"content": "Как ты мог помогать волкам нападать на людей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540314
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4540314,
					"content": "Ты забыл, кто ты на самом деле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540315
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4540315,
					"content": "Хватит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540316
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4540316,
					"content": "Если обидите Рэйзора, будете иметь дело с Паймон и компанией!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4540317,
					"content": "Рыцари собираются отпустить этого мальчишку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540318
					],
					"speakerTitle": "Йотун"
				},
				{
					"id": 4540318,
					"content": "Мы не нападали на деревню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рэйзор"
				}
			]
		},
