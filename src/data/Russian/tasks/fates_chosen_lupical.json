			"dialogs": [
				{
					"id": 4540202,
					"content": "Волчий крюк выглядит так. Он останавливает кровь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рэйзор"
				}
			]
		},
		{
			"id": 45411,
			"completionStepIds": [
				45411
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45411",
							"2"
						],
						"stepId": 45411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эмбер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541101,
					"content": "Капли крови!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541102
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4541102,
					"content": "Кровь не человека, кровь волка. Лупикал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541103
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541103,
					"content": "Лупикал. Что такое Лупикал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4541104,
					"content": "Лупикал. Моя семья. Человек выбрал волка. Волк выбрал человека. Это Лупикал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541105
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541105,
					"content": "Непонятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4541106,
					"content": "Это очень необычно. Откуда пришло это слово? Его точно не волки придумали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541107
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4541107,
					"content": "Так он назвал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541108
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541108,
					"content": "Назвал? Кто назвал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541109
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4541109,
					"content": "Хранитель этих мест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541110
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541110,
					"content": "Барбатос? Он вроде как главный в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4541111,
					"content": "Хватит. Я нашёл след. За мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541112
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541112,
					"content": "Эй! Мы же сможем доказать твою невиновность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541113
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4541113,
					"content": "Ох, Рэйзор уже ушёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 45413,
			"completionStepIds": [
				45413
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45413",
							"2"
						],
						"stepId": 45413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рэйзор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541301,
					"content": "Вот он. На него напали люди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541302
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541302,
					"content": "Это уже перебор...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4541303,
					"content": "Да, это выглядит отвратительно, но всё же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541304
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4541304,
					"content": "Мы не нападали на деревню! Это были не мы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541305
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541305,
					"content": "Это был чёрный волк со стаей. Чужак. Он хочет забрать нашу землю. Он нарушил правила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541306
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541306,
					"content": "<color=#00E1FFFF>Правила?</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4541307,
					"content": "Хранитель дал нам правила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541308
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541308,
					"content": "Ты уже второй раз говоришь о хранителе. Кого ты имеешь в виду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541309
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4541309,
					"content": "Мне нужно увести Лупикал подальше. Следуй за мной. Может быть, увидишь хранителя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рэйзор"
				}
			]
		},
		{
			"id": 45415,
			"completionStepIds": [
				45415
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45415",
							"2"
						],
						"stepId": 45415,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рэйзор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541501,
					"content": "Ой, где мы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4541502,
					"content": "#{NICKNAME}, мне нужна твоя помощь. Собери несколько таких ягод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541503
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541503,
					"content": "Это семена волчьего крюка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4541504,
					"content": "Если положить их на рану, кровь остановится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541505
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541505,
					"content": "Верно. На волчьих крюках есть вещество, которое обладает не только обезболивающим эффектом, но и усиливает свёртываемость крови.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541506
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4541506,
					"content": "Я читала об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541507
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4541507,
					"content": "Ух ты! А почему так происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4541508,
					"content": "Этого я не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541509
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4541509,
					"content": "Крючки помогают семенам цепляться, распространяться. Выделяемое ими вещество обезболивает и останавливает кровь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541510
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541510,
					"content": "Они цепляются за животных. Животные не чувствуют боль и разносят их на большие расстояния.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541511
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541511,
					"content": "Так мне говорил пурпурный учитель...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541512
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541512,
					"content": "Мы будем здесь. Я поговорю с другой красной девушкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541513
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4541513,
					"content": "Хорошо. Если эти деревенщины захотят вернуться, им придётся иметь дело с рыцарем Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541514
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4541514,
					"content": "#Но твой друг волк всё ещё под подозрением. {NICKNAME}, собери нужные семена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				}
			]
		}
	]
}