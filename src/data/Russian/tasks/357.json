				"points": []
			},
			"dialogs": [
				{
					"id": 3572301,
					"content": "Ужас Бури... В этот раз он напал на сам город!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572302
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3572302,
					"content": "#Кэйа, {NICKNAME}, вы появились вовремя. Мы должны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572303
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3572303,
					"content": "Постой, Эмбер. Мне кажется, ты забыла нас познакомить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572304
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3572304,
					"content": "Да... Точно. Это Кэйа, наш капитан кавалерии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572305
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3572305,
					"content": "#А это {NICKNAME} и Паймон. Путешественники из очень далёких мест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572306
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3572306,
					"content": "(Из далёких мест... И это всё, что ты о них знаешь?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572307
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3572307,
					"content": "Если вкратце...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572308
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3572308,
					"content": "Вот оно как... Ну что ж, добро пожаловать в Мондштадт, путешественники. К сожалению, сейчас не самое подходящее время для туристов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572309
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3572309,
					"content": "Я понимаю, как тяжела может быть разлука с семьёй...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572310
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3572310,
					"content": "Но мне не совсем ясно, зачем тебе нужен Анемо Архонт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572311
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3572311,
					"content": "Однако у каждого есть свои секреты, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572312
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3572312,
					"content": "Хех, конечно, я не собираюсь устраивать допрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572313
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3572313,
					"content": "Я просто хочу поблагодарить тебя от лица рыцарей Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572314,
						3572315
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3572314,
					"content": "#Не мог{F#ла} же я просто остаться в стороне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				},
				{
					"id": 3572318,
					"content": "#Мондштадтцы видели, как ты прогнал{F#а} дракона от стен города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572319
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3572319,
					"content": "Действующий магистр рыцарей Ордо Фавониус хотела бы поговорить с тобой. Прошу немедленно направиться в <color=#00E1FFFF>здание штаба</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3572315,
					"content": "Пожалуйста! А где моя награда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572316
					]
				},
				{
					"id": 3572316,
					"content": "Хм... Хочешь попробовать традиционное мондштадтское угощение? Медовое мясо с морковкой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572317
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3572317,
					"content": "#Где-то я это уже слышал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				}
			]
		}
	]
}