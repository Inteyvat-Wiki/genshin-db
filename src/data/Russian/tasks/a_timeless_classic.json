					"nextDialogs": [
						706590302,
						706590303
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706590302,
					"content": "Сыграть в «По следам ветра».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 706590303,
					"content": "Выйти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590304
					]
				},
				{
					"id": 706590304,
					"content": "Ладно. Если вдруг захочешь сыграть в «По следам ветра», отыщи меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гайгэкс"
				}
			]
