			},
			"dialogs": [
				{
					"id": 740290201,
					"content": "...Сработает ли прикормка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яра"
				}
			]
		},
		{
			"id": 7402903,
			"completionStepIds": [
				7402905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7402905",
							"2"
						],
						"stepId": 7402905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Яра"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290301,
					"content": "Яра опускает ослабевшего шаровидного осьминога в ведёрко рядом...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740290302
					]
				},
				{
					"id": 740290302,
					"content": "Такая блестящая техника рыбалки... Но это создание теперь утратило свою красоту. Как же так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290303
					],
					"speakerTitle": "Яра"
				},
				{
					"id": 740290303,
					"content": "Прости... Мы и не думали, что «то существо», о котором говорила Яра, - это шаровидный осьминог. Вот мы нечаянно и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290304,
						740290306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740290304,
					"content": "Если кого и винить, то только меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290305
					]
				},
				{
					"id": 740290305,
					"content": "#Да, это всё из-за того, что ты, {NICKNAME}, {M#поторопился}{F#поторопилась}! И Паймон тебя не остановила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740290308,
					"content": "#Наставник {NICKNAME}, наставник Паймон, вам не за что извиняться. Шаровидный осьминог уже в моём ведёрке, этого достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290309
					],
					"speakerTitle": "Яра"
				},
				{
					"id": 740290309,
					"content": "Ладно... Но откуда здесь шаровидный осьминог? Его случайно занесло сюда течением?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740290310,
					"content": "Это я принесла его сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290311
					],
					"speakerTitle": "Яра"
				},
				{
					"id": 740290311,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740290312,
					"content": "Я хотела изучить способы рыбалки... Поэтому я принесла то, что вы называете шаровидным осьминогом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290313
					],
					"speakerTitle": "Яра"
				},
				{
					"id": 740290313,
					"content": "Я оставила его здесь, чтобы можно было прийти в любое время и попрактиковаться в рыбной ловле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290314
					],
					"speakerTitle": "Яра"
				},
				{
					"id": 740290314,
					"content": "Это был замечательный план, но прошло столько времени, а он так и не клюнул.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290315
					],
					"speakerTitle": "Яра"
				},
				{
					"id": 740290315,
					"content": "Задумка забросить сюда шаровидного осьминога, чтобы попрактиковаться, конечно, интересная...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740290316,
					"content": "Но мы ведь сразу подманили его, стоило нам бросить немного прикормки. Ты не пыталась насыпать побольше прикормки, Яра?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740290317,
					"content": "Я перепробовала самые разные прикормки... Фарш, хлеб, червей, мяту, детальки... Он просто съедал всё это и больше не появлялся, я подумала, что в прикормке нет смысла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290318
					],
					"speakerTitle": "Яра"
				},
				{
					"id": 740290318,
					"content": "Де... детальки? ! Не самый удачный выбор для прикормки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290319,
						740290321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740290319,
					"content": "Не стоит подкармливать продукты водного промысла странными вещами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290320
					]
				},
				{
					"id": 740290320,
					"content": "Да! Погоди, что это за название такое - «продукты водного промысла»?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740290323,
					"content": "Детали - всё-таки важные вещи, а не прикормка, нужно придумать, как их оттуда достать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290324
					],
					"speakerTitle": "Яра"
				},
				{
					"id": 740290324,
					"content": "Ах да! Для того, чтобы отблагодарить уважаемых наставников за помощь, я хотела бы отдать эту запчасть вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290325
					],
					"speakerTitle": "Яра"
				},
				{
					"id": 740290325,
					"content": "...Нет, спасибо, не надо. Мы ничего особенного не сделали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740290326,
					"content": "А? Но Деларош говорила, что когда обращаешься к кому-то за помощью, нужно называть этого человека «наставник», а потом как следует отплатить за урок. Неужели это не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290327
					],
					"speakerTitle": "Яра"
				},
				{
					"id": 740290327,
					"content": "Возьмите эту высохшую запчасть. Она вам очень пригодится в деревне Меруси.",
					"roleType": "TALK_ROLE_NPC",
