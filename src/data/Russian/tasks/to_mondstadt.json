			"trigger": {
				"objectNames": [
					"Хуай Ань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010201,
					"content": "Здравствуйте, чем могу быть полезен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010202
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 105010202,
					"content": "Вы не могли бы одолжить нам кухню на время?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010203,
						105010204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 105010203,
					"content": "Мой друг хочет отведать особое блюдо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				},
				{
					"id": 105010205,
					"content": "Да, конечно. Можете воспользоваться нашей кухней, но только готовьте из собственных продуктов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010206
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 105010206,
					"content": "Рискну предположить, что вы, должно быть, очень хорошо готовите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010207,
						105010209
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 105010207,
					"content": "Конечно, я всё готовлю «идеально».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010208
					]
				},
				{
					"id": 105010208,
					"content": "Ха-ха, тогда вы очень талантливы. Но всё же, у меня есть одно предложение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 105010211,
					"content": "Судя по вашему виду, вы не из этих краёв. Но раз уж вы оказались в Ли Юэ, почему бы вам не попробовать приготовить что-нибудь из местной кухни?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010212
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 105010212,
					"content": "У меня тут есть рецепт золотистого краба, это классическое блюдо кухни Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010213
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 105010213,
					"content": "Блюдо из краба, приготовленное по древнему рецепту. Мясо краба обваливают в муке и опускают в кипящее масло, а затем быстро обжаривают на сковороде вместе с имбирём и чесноком. Поданный на стол краб словно купается в золоте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010214
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 105010214,
					"content": "Золотистый краб!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010215,
						105010216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 105010215,
					"content": "Звучит сложновато.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010217,
					"content": "#Золотистый краб, {NICKNAME}! Золотистый краб!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010218,
						105010219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 105010218,
					"content": "#Да понял{F#а} я... Золотистый краб.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010220,
					"content": "Хе-хе, тогда пойдём готовить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 105010221,
					"content": "С твоим талантом к готовке ты мигом выучишь этот рецепт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 105010219,
					"content": "Значит, я учу его ради тебя...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010216,
					"content": "Разучивать новый рецепт ради Моны как-то...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010209,
					"content": "Не всегда...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010210
					]
				},
				{
					"id": 105010210,
					"content": "Ха-ха, скромность на вес золота. В таком случае у меня есть одно предложение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 105010204,
					"content": "Мой друг хочет насладиться домашней кухней.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				}
			]
		},
		{
