				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010501,
					"content": "Ну как? Я смогла удовлетворить ваши ожидания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010502,
						105010503
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105010502,
					"content": "Твои боевые навыки бесподобны...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				},
				{
					"id": 105010504,
					"content": "Это всего лишь основы астрологии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010505
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105010505,
					"content": "У лжи нет шансов устоять перед истиной и судьбой, что диктуют звёзды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010506
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105010506,
					"content": "Конечно, рассмотреть все детали их преступлений заняло бы какое-то время, но общую картину я вижу сразу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010507
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105010507,
					"content": "Однако где-то ты всё-таки ошибалась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 105010508,
					"content": "Это потому что движение звёзд Тейвата может поведать только об истине и судьбе этого мира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010509
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105010509,
					"content": "Всё, что касается вас, - туман, сквозь который не могу видеть даже я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010510
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105010510,
					"content": "Именно поэтому я хочу встретиться с тем учеником. Надеюсь, что, объединив наши знания, мы сможем разглядеть вашу судьбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010511,
						105010512
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105010511,
					"content": "Жду с нетерпением.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010513,
					"content": "Ха-ха. В любом случае в конце этого путешествия ты не пожалеешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010514
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105010514,
					"content": "Хорошо, хватит отдыхать. Давайте соберёмся с силами и, наконец, дойдём до <color=#00E1FFFF>Мондштадта</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010515
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105010515,
					"content": "Эх, вот бы у нас сейчас была телега...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010516
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 105010516,
					"content": "Ты же сказала, что совсем не устала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				},
				{
					"id": 105010512,
					"content": "Мне вообще неинтересно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010503,
					"content": "Впечатляет, как ты увидела их замысел...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				}
			]
		},
