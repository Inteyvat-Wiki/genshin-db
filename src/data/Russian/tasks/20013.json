				"objectNames": [
					"Джек"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200130301,
					"content": "#Спасибо тебе, путешественн{F#ица}{M#ик}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130302
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200130302,
					"content": "Я всего лишь хотел посмотреть на места, по которым путешествовал Стэнли. Кто бы мог подумать, что по дороге на меня нападут монстры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130303
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200130303,
					"content": "Я слишком слаб... Уверен, что Стэнли справился бы с этим без особых проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130304
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200130304,
					"content": "Хочешь путешествовать со мной? Ах... Забудь... Не могу же я до конца своих дней просить других делать всё за меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130305
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200130305,
					"content": "Я отправляюсь в путь. Это тебе. У меня заготовлено много припасов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130306
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200130306,
					"content": "Если это вообще можно назвать припасами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джек"
				}
			]
		}
	]
