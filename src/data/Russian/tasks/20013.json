				"points": []
			},
			"dialogs": [
				{
					"id": 200130201,
					"content": "#Путешественн{F#ица}{M#ик}, это ты! Спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130202
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200130202,
					"content": "Могу я попросить тебя о небольшой услуге?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130203
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200130203,
					"content": "От приключений меня отделяет только этот завал на дороге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130204
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200130204,
					"content": "Поможешь мне расчистить путь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130205,
						200130206
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200130205,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130207
					]
				},
				{
					"id": 200130207,
					"content": "Эх, хотел бы я быть, как ты... Всё время путешествовать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джек"
				},
				{
					"id": 200130206,
					"content": "Мне некогда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130208
					]
				},
				{
					"id": 200130208,
					"content": "Прошу тебя, позволь моему путешествию продолжиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джек"
				}
			]
		},
		{
			"id": 2001303,
			"completionStepIds": [
