			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сара"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4890101,
					"content": "Я знаю! Я уже выхожу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890102
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4890102,
					"content": "Эмбер! Ты пришла помочь нам разобраться с делами Джинн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4890103,
					"content": "А? Да-да! Зачистить дороги от хиличурлов и обеспечить безопасные поставки продуктов в город! Звучит как работа для скаута Ордо Фавониус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890104
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4890104,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890105
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890105,
					"content": "Сара... Ну перестань волноваться. Я же скаут, я не разочарую тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890106
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4890106,
					"content": "Не пойми меня неправильно, я не сомневаюсь в твоих способностях. Я просто в шоке от того, сколько у меня заказов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890107
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890107,
					"content": "Вот новый заказ! Огромный банкет или что-то вроде того.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890108
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890108,
					"content": "Кхе-кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890109
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4890109,
					"content": "Тебе нужна моя помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890110
					]
				},
				{
					"id": 4890110,
					"content": "Я могу помочь на кухне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890111
					]
				},
				{
					"id": 4890111,
					"content": "Серьёзно? Ты умеешь готовить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890112
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890112,
					"content": "#Шикарно! Ты просто спас{F#ла} «Хорошего охотника»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890113
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890113,
					"content": "#Ну вот, украл{F#а} у меня всю славу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890114
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4890114,
					"content": "Посмотри вот этот заказ. Начни со сбора ингредиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890115
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890115,
					"content": "#Ты уверена, что {NICKNAME} умеет готовить? Может получиться что-то несъедобное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4890116,
					"content": "Сейчас нам не до стремления к совершенству. «Хороший охотник» на грани закрытия, и мы должны спасти его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890117
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890117,
					"content": "На грани закрытия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4890118,
					"content": "Для этого блюда нам понадобятся <color=#00E1FFFF>три цветка-сахарка и три порции мяса птицы</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890119
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890119,
					"content": "А теперь за дело! И ты тоже, Эмбер. Я буду ждать здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890120
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890120,
					"content": "Л-ладно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				}
			]
		},
