			"dialogs": [
				{
					"id": 4890301,
					"content": "Цыплёнок в медовом соусе готов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890302
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890302,
					"content": "Как вкусно пахнет! Ммм. То, что нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890303
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890303,
					"content": "Переходим к следующему заказу... <color=#00E1FFFF>медовое мясо с морковкой</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890304
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890304,
					"content": "<color=#00E1FFFF>Медовое мясо с морковкой</color>? Традиционное мондштадтское угощение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4890305,
					"content": "Всё верно! Это одно из фирменных блюд «Хорошего охотника»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890306
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890306,
					"content": "Рыцари всегда заказывают у нас сладкое мясо с морковкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890307
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890307,
					"content": "Давай я научу тебя, как готовить <color=#00E1FFFF>медовое мясо с морковкой</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890308
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890308,
					"content": "Ты вот так запросто научишь нас готовить фирменное блюдо «Хорошего охотника»?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4890309,
					"content": "Я сочту за честь поделиться рецептом с таким талантливым поваром, как ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890310
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890310,
					"content": "Как только <color=#00E1FFFF>медовое мясо с морковкой</color> будет готово, неси его сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сара"
				}
			]
		},
