			"dialogs": [
				{
					"id": 4890201,
					"content": "Вы вернулись! Все ингредиенты готовы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890202
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4890202,
					"content": "Да, всё готово.",
