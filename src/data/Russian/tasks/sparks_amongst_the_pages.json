			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лиза"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3081401,
					"content": "Дракон Востока, Лев Юга, Волк Севера, Сокол Запада...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081402
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081402,
					"content": "Это Хранители четырёх ветров Мондштадта, они подчиняются Барбатосу, Анемо Архонту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081403
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081403,
					"content": "Двалин. Вот настоящее имя дракона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081404
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081404,
					"content": "Он был Драконом Востока задолго до того, как его стали называть Ужасом Бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081405
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081405,
					"content": "Теперь вы знаете почему Двалин может полагаться только на три силы из четырёх ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081406
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081406,
					"content": "Свои собственные он уже исчерпал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081407,
						3081408
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081407,
					"content": "Почему он себя так ведёт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				},
				{
					"id": 3081409,
					"content": "Из-за ненависти. Я думаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081410
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081410,
					"content": "К кому?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3081411,
					"content": "Ненависти к Мондштадту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081412
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081412,
					"content": "Эта ненависть - источник его зловещих сил. Именно она сделала его Ужасом Бури!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081413
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081413,
					"content": "Но почему один из Хранителей четырёх ветров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3081414,
					"content": "Ненавидит город, который он должен защищать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3081415,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081416
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081416,
					"content": "Я дитя Мондштадта, мне очень сложно об этом говорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081417
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081417,
					"content": "Ты можешь прочесть об этом здесь. Это случилось несколько веков назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081408,
					"content": "Зачем он это делает?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				}
			]
		}
	]
