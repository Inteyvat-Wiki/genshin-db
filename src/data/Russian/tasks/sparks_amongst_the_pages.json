			"dialogs": [
				{
					"id": 3081101,
					"content": "Привет, милашка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081102
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081102,
					"content": "Ты поможешь мне? Как мило с твоей стороны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081103
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081103,
					"content": "Обращайся ко мне, если тебе что-то понадобится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081104,
						3081108
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081104,
					"content": "А чем обычно занят библиотекарь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081105
					]
				},
				{
					"id": 3081105,
					"content": "Хм... Это хороший вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081106
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081106,
					"content": "По большой части это не физический труд. Но и не интеллектуальный труд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081107
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081107,
					"content": "А какой тогда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3081111,
					"content": "Вам тоже стоит поверить мне на слово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081108,
					"content": "Что библиотекарь делает в руинах?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081109
					]
				},
				{
					"id": 3081109,
					"content": "Хм... И это тоже хороший вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081110
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081110,
					"content": "Джинн доверила мне эту миссию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "Лиза"
				}
			]
		},
