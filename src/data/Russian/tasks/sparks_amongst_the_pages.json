				"points": []
			},
			"dialogs": [
				{
					"id": 3081301,
					"content": "Из-за нарушенного потока элементов, я чувствую себя не очень хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081302
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3081302,
					"content": "Давай восстановим исходное состояние храма. Тогда мне станет чуть-чуть полегче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лиза"
				}
			]
		},
		{
			"id": 30814,
			"completionStepIds": [
				30814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
