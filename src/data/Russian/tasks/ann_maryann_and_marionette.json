			"dialogs": [
				{
					"id": 742530201,
					"content": "Тихая и спокойная жизнь... что может быть лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "Мари-Анн"
				},
				{
					"id": 742530202,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 742530204,
					"content": "Уже так поздно? Ха-ха. Нам надо почаще встречаться, госпожа Сандроне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мари-Анн"
				},
				{
					"id": 742530203,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
}