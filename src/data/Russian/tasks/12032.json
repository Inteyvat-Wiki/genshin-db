			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сёгун Райдэн",
					"Яэ Мико"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "Инадзуме предстоит ещё множество испытаний, но я готова к ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320102,
					"content": "Об испытаниях...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "Отмена указа Сакоку затронет многих. И не всем это принесёт одно лишь добро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320104,
					"content": "Например, я могу предвидеть, что внешний мир представляет угрозу для торговли Инадзумы. И я должна с этим разобраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320105,
					"content": "Основательный подход, Эи. А я пока только додумалась до идеи продавать входные билеты в Великий храм Наруками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120320106,
					"content": "Вообще-то, Мико...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320107,
					"content": "О внимании богов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "Взгляд Макото всегда был прикован к жителям Инадзумы. Я думала, что это просто её обязанность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320109,
					"content": "Но теперь я понимаю, что её взгляд был полон восторга и надежды. Это был не просто долг, но и радость. Она очень любила человечество.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320110,
					"content": "Если люди прошлого заслуживали внимания богов, то и люди будущего заслуживают того же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120320111,
					"content": "Именно так. Я больше не буду пренебрегать их страстями и мечтами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320112,
					"content": "О столетиях битв...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "Честно говоря, это нескончаемая пытка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320114,
					"content": "В этой бесконечной битве я всегда должна была быть начеку. Расслабься я хоть на мгновение, и клинок сёгуна лишил бы меня жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320115,
					"content": "Можно сказать, если бы не мой опыт битв, я не выдержала бы испытаний. И потерпела бы поражение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320116,
					"content": "И в этом есть и твой вклад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320117,
					"content": "О повреждениях на Священной сакуре...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "Не волнуйся, я ничего не забыла. Я передам комиссиям Тэнрё и Ясиро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320119,
					"content": "Меня беспокоят не только монстры, но и то, что ещё может вырваться из Священной сакуры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320120,
					"content": "Об этом сложно говорить... Кроме воспоминаний, артерии земли таят в себе ещё многое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120320121,
					"content": "Раз ты понимаешь, о чём я, то уж постарайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320122,
					"content": "Яэ Мико сказала, доверяет свою бо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "Кхм! Яэ Мико не могла сказать ничего подобного! И у вас хватает наглости сочинять разные небылицы прямо при ней!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120320124,
					"content": "Иногда стоит попридержать язык за зубами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120320125,
					"content": "Поверь мне: если предашь меня, тебе придётся заплатить серьёзную цену. Пусть мои слова будут нашим маленьким секретом. Ясно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120320126,
					"content": "О чём это вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120320127,
					"content": "Ни о чём. Просто захотелось жареного тофу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120320128,
					"content": "У меня больше нет вопросов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}