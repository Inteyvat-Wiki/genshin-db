			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ясмин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280501,
					"content": "Ясмин! Ого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280502
					]
				},
				{
					"id": 230280502,
					"content": "Я не могу дышать! Скорее уходим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280503
					]
				},
				{
					"id": 230280503,
					"content": "Что это?.. Кхе-кхе! Что за запах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230280504,
					"content": "Похоже, Ладеп проделал отличную работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280505
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280505,
					"content": "Здесь снадобья уже достаточно, идём к следующему месту. Оно неподалёку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясмин"
				}
			]
		}
	]
}