			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ясмин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280101,
					"content": "#Путешественни{F#ца}{M#к}, как хорошо, что ты здесь... Мне как раз нужна помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280102
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280102,
					"content": "Что-то случилось с корневой системой Священного древа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280103
					]
				},
				{
					"id": 230280103,
					"content": "С корнями Священного древа всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280104
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280104,
					"content": "Моя работа состоит в том, чтобы с ним всегда всё было в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280105
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280105,
					"content": "Говоря конкретно, я распыляю это снадобье вокруг корней Священного древа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280106
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280106,
					"content": "Однако я не могу принести так много снадобий в одиночку, а Ладеп и Фарез заняты своей работой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280107
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280107,
					"content": "#Поэтому не мог{F#ла} бы ты помочь мне принести немного снадобий?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280108,
						230280112
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280108,
					"content": "Ладеп и Фарез?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280109
					]
				},
				{
					"id": 230280109,
					"content": "Они тоже студенты, как и я, но Ладеп из Спантамада, а Фарез из Кшахревара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280110
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280110,
					"content": "Сейчас мы вместе проводим исследование по общей теме, несмотря на разные ценности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280111
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280111,
					"content": "Это снадобье, например, результат нашей совместной работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280113
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280113,
					"content": "Ладно, я перенесу этот кувшин, но остальное на тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280114
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280114,
					"content": "Осторожно. Ладеп сказал, что снадобье специально изготовлено с неприятным запахом, чтобы никто случайно его не выпил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280115
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280115,
					"content": "Если оно попадёт на одежду, то этот запах ещё долго не смоется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280112,
					"content": "Тогда вперёд.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280113
					]
				}
			]
		},
		{
			"id": 2302804,
			"completionStepIds": [
				2302804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302804",
							"2"
						],
						"stepId": 2302804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аван",
					"Ясмин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280401,
					"content": "Ясмин... Что ты здесь делаешь? Ты пришла, чтобы снова распылить своё снадобье?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280402
					],
					"speakerTitle": "Аван"
				},
				{
					"id": 230280402,
					"content": "Корни Священного древа в порядке, поэтому им не нужно снадобье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280403
					],
					"speakerTitle": "Аван"
				},
				{
					"id": 230280403,
					"content": "Тщательный уход всё равно не помешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280404
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280404,
					"content": "Поиск решения только после возникновения проблемы напоминает приготовление рыбного рулета. Когда тесто уже раскатано, а рыба, оказывается, не готова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280405
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280405,
					"content": "Переделать рулет или убрать уже раскатанное тесто одинаково сложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280406
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280406,
					"content": "Ладно, ты действительно умеешь убеждать... Но в прошлый раз я уже говорил о запахе этого снадобья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280407
					],
					"speakerTitle": "Аван"
				},
				{
					"id": 230280407,
					"content": "Я живу неподалёку и не хочу засыпать, ощущая этот странный запах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280408
					],
					"speakerTitle": "Аван"
				},
				{
					"id": 230280408,
					"content": "Не беспокойся, я уже велела Ладепу исправить рецептуру, поэтому запах не будет очень резким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280409
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280409,
					"content": "Хорошо, тогда я ухожу. Не смей распылять это своё снадобье рядом со мной. Я не смогу этого вынести...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280410
					],
					"speakerTitle": "Аван"
				},
				{
					"id": 230280410,
					"content": "#Хорошо. Путешественни{F#ца}{M#к}, передай мне снадобье, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280411
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280411,
					"content": "Вы распылили снадобье вместе с Ясмин...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230280412
					]
				},
				{
					"id": 230280412,
					"content": "Это снадобье действительно дурно пахнет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230280413,
					"content": "Кажется, ты ничего не почувствовала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280414
					]
				},
				{
					"id": 230280414,
					"content": "Если ты имеешь в виду запах... то я встречала и куда более неприятные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280415
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280415,
					"content": "Хорошо, этого достаточно. Ещё я собрала много данных, Фарез определённо будет в восторге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280416
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280416,
					"content": "#Вот твоя награда, путешественни{F#ца}{M#к}. Спасибо за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280417
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230280417,
					"content": "Интересно, как там работа Ладепа и Фареза...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясмин"
				}
			]
		},
		{
			"id": 2302805,
