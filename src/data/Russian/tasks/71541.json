			"completionStepIds": [
				7154101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7154101",
							"2"
						],
						"stepId": 7154101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мин Лань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715410101,
					"content": "Неужели этот сержант там не главный. Ох, остаётся только пожелать им удачи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410102
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410103
					]
				},
				{
					"id": 715410103,
					"content": "#А?! Это ты, {NICKNAME}... Фух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410104
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410104,
					"content": "#Ты до смерти перепугал{F#а} меня! Я думал, это сержант. Если он услышит, меня опять на тренировку потащат...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410105,
						715410106
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410105,
					"content": "Вы... всё ещё тренируетесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410107
					]
				},
				{
					"id": 715410107,
					"content": "Чем больше праздник, тем больше у нас дел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410108
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410108,
					"content": "Гавань Ли Юэ огромна, туристы приезжают со всех уголков мира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410109
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410109,
					"content": "Чтобы поддерживать порядок и обеспечивать безопасность, Миллелиты организовали несколько мобильных патрулей как в городе, так и в дикой местности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410110
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410110,
					"content": "Знаешь, что такое мобильный патруль? Хм... считай, что это команда Миллелитов, которые оказывают помощь, где бы они ни находились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410111
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410111,
					"content": "Если понадобится помощь, достаточно обратиться к отряду, и они не подведут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410112
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410112,
					"content": "К ним можно обратиться, если находишься в опасности, потерял что-то или же заблудился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410113
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410113,
					"content": "Но... поскольку область, которую им нужно охватить, слишком велика, сержант вывел резервные подразделения, изначально находившиеся в состоянии готовности к тренировкам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410114
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410114,
					"content": "Но эти резервные соединения состоят из новичков, которые не проходили специальной подготовки. Поэтому сержант предложил провести учения, чтобы отточить их навыки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410115
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410115,
					"content": "Говорят... сержант суров. Любой, кто проходил у него обучение, содрогается, услышав его имя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410116
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410116,
					"content": "Ты тоже проходил эту тренировку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410117
					]
				},
				{
					"id": 715410117,
					"content": "Можно и так сказать. Его тренировки действительно очень эффективны, но стоит мне вспомнить об этом, как у меня ноги подкашиваются...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410118
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410118,
					"content": "Тоже хочешь попробовать? Во время обучения сержант часто упоминал твоё имя. Он говорил, что ты не только разбираешься в боевом построении, но и прекрасно владеешь рукопашным боем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410119
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410119,
					"content": "#Ты бы точно показал{F#а} лучший результат!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410120,
						715410122
					],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410120,
					"content": "Я хочу попробовать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410121
					]
				},
				{
					"id": 715410121,
					"content": "Отлично! Твоя храбрость под стать герою Ли Юэ. Следуй за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410122,
					"content": "Надо подумать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410123
					]
				},
				{
					"id": 715410123,
					"content": "Дай знать, когда захочешь попробовать. Без сомнения, сержант тебе обрадуется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мин Лань"
				},
				{
					"id": 715410106,
					"content": "Разве сейчас не Праздник морских фонарей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410107
					]
				}
			]
		}
	]
}