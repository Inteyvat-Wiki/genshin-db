			"dialogs": [
				{
					"id": 732050401,
					"content": "Сначала полейте три семечка, а я придумаю, как их удобрить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050402
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050402,
					"content": "Даже спустя столько лет я помню, как сделать простое удобрение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аффан"
