			"trigger": {
				"objectNames": [
					"Аффан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040701,
					"content": "Ах, я не успел ничего приготовить, поэтому мне даже нечем вас угостить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040702,
						732040703
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040702,
					"content": "Не стоит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				},
				{
					"id": 732040704,
					"content": "Эта малышка - твоя подруга, не так ли? Она довольно милая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040705
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040705,
					"content": "Хотите посмотреть на цветы, когда они расцветут?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040706
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040706,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040707
					]
				},
				{
					"id": 732040707,
					"content": "Скорее всего, они зацветут через несколько дней. Приходите позже, чтобы посмотреть на цветы, которые вы помогли посадить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040708
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040708,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040709
					]
				},
				{
					"id": 732040709,
					"content": "Хорошо, я понял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040710
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040710,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040703,
					"content": "Мы не голодны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				}
			]
		},
		{
			"id": 7320501,
			"completionStepIds": [
				7320501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320501",
							"2"
						],
						"stepId": 7320501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Аффан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050101,
					"content": "Подойдите и посмотрите на эти семена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050102
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050102,
					"content": "Кажется, ничего не изменилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050103
					]
				},
				{
					"id": 732050103,
					"content": "Да, хотя я много лет занимаюсь сельским хозяйством, но выращивание цветов всё же имеет свои отличия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050104
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050104,
					"content": "Иначе, почему они так долго не растут?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050105
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050105,
					"content": "Сейчас Паймон посмотрит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732050106,
					"content": "Дедушка Аффан, в твоём питомнике слишком сухо. Кроме того, в почве возле деревни Аару может не хватать питательных веществ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732050107,
					"content": "Недавно мы помогли одному человеку в деревне вырастить цветы, так что у нас есть опыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732050108,
					"content": "Вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050109
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050109,
					"content": "Это имеет смысл. Такой редкий вид цветка более хрупкий, чем обычные растения. Я действительно недостаточно их поливал и удобрял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050110
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050110,
					"content": "Однако этот питомник находится далековато от источника воды. Добыть воду здесь непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050111
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050111,
					"content": "Я сам использую каждый день совсем немного воды, а часто поливать растения для меня и вовсе тяжело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050112
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050112,
					"content": "Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050113
					]
				},
				{
					"id": 732050113,
					"content": "Хорошо, тогда, пожалуйста, сначала полейте эти три семечка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аффан"
				}
			]
		},
		{
			"id": 7320503,
			"completionStepIds": [
				7320503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
