			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аффан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050301,
					"content": "Отлично! Вы очень изобретательны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050302
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050302,
					"content": "Мне кажется, что на этот раз они будут хорошо расти под присмотром профессионалов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050303
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050303,
					"content": "Вам понравились шаурма и тахчин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050304,
						732050306
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050304,
					"content": "Да, очень вкусно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050305
					]
				},
				{
					"id": 732050305,
					"content": "Раз вкусно, то приготовлю для вас ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050307
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050307,
					"content": "Извините, я готовлю не так хорошо, как моя покойная жена. Вот, возьмите. На этот раз немного меньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050308
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050308,
					"content": "Это очень вкусно! Ты так добр к нам, дедушка Аффан. Мы будем часто тебя навещать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732050309,
					"content": "Ха-ха. Разве вы не хотели спросить меня, что это за цветок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050310
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050310,
					"content": "Могу сказать только то, что выращиваю розы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050311
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050311,
					"content": "Такие же, как сумерские розы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050312
					]
				},
				{
					"id": 732050312,
					"content": "Этот цветок называется «золотая роза». О, они более ценны, чем сумерские розы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050313
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050313,
					"content": "Я уже говорил, что эти семена дал мне друг. Вы помните?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050314
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050314,
					"content": "На самом деле, эти семена и старый дом, в котором я сейчас живу, оставил мне проклятый старик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050315
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050315,
					"content": "Ах, я забыл, что вы не местные, поэтому наверняка не слышали это имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050316
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050316,
					"content": "И хорошо, что вы не слышали. Просто запомните его, как старика, умевшего выращивать цветы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050317
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050317,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050318
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050318,
					"content": "Дедушка Аффан вдруг замер. Дедушка Аффан, дедушка Аффан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732050319,
					"content": "Ой, кажется, я отвлёкся на мгновение. В моём возрасте тяжело сконцентрироваться. Опять выставил себя посмешищем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050320
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050320,
					"content": "Я должен ещё раз вас поблагодарить. Если хотите осмотреться, то можете пройтись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050321
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050321,
					"content": "Я больше не буду выгонять отсюда людей. Но будьте осторожны и не наступайте на растения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732050306,
					"content": "Ещё не пробовали.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050307
					]
				}
			]
		},
