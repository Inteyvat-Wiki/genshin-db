			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сантон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760301,
					"content": "Ну как? Встретили свирепых животных?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760302
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760302,
					"content": "Если встретите, то, пожалуйста, помогите их прогнать. Профилактика свирепых животных создана во благо и жителей, и животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760303,
						730760305,
						730760309,
						730760313
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760303,
					"content": "О Крокодиле-радже...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760304
					]
				},
				{
					"id": 730760304,
					"content": "Говорят, что Крокодил-раджа обитает в водах к востоку от города... Но, похоже, он очень хитрый. Я был там несколько раз, но так и не нашёл его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760305,
					"content": "Расскажи мне о ришболанд-радже...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760306
					]
				},
				{
					"id": 730760306,
					"content": "По округе ходят истории о ришболанд-радже. Он в полночь выходит из западного леса, чтобы поймать непослушных детей, которые не хотят спать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760307
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760307,
					"content": "Конечно, последнее придумали родители, чтобы быстрее укладывать детей. Тем не менее поговаривают, что тигр ришболанд действительно более активен ночью...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760308
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760308,
					"content": "Рассказывали, что как-то один путник ночью увидел тигра ришболанда, и свирепый зверь погнался за человеком. Хорошо, что всё обошлось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760309,
					"content": "Расскажи мне о Короле вьючных яков...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760310
					]
				},
				{
					"id": 730760310,
					"content": "Говорят, что у некоторых диких вьючных яков сильно развито чувство территории. И чужак на их землях будет немедленно атакован. Боюсь, что то же самое относится и к Королю вьючных яков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760311
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760311,
					"content": "Его территория где-то на востоке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760312
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760312,
					"content": "Мне интересно, насколько огромным должен быть як, чтобы его назвали Королём вьючных яков...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760313,
					"content": "Мы всё ещё выясняем...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760314
					]
				},
				{
					"id": 730760314,
					"content": "Ладно, тогда вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сантон"
				}
			]
		},
		{
			"id": 7307604,
