			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сантон",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760701,
					"content": "Что? Уже прогнали свирепых животных?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760702
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760702,
					"content": "Я ещё ни одного не видел... Эти животные и правда такие неукротимые?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760703,
						730760705
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760703,
					"content": "Не совсем...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760704
					]
				},
				{
					"id": 730760704,
					"content": "Ха-ха. Похоже, вы справились с ними без труда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760707,
					"content": "Такое облегчение, что свирепые звери изгнаны. Жаль только, что это сделал не я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760708
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760708,
					"content": "Что поделать? Так заведено в природе: добыча уходит сильнейшему охотнику.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760709
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760709,
					"content": "Ха-ха. В следующий раз я вам точно не уступлю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760710
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760710,
					"content": "Мы тоже не сдадимся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760711
					]
				},
				{
					"id": 730760711,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730760712,
					"content": "Разве за профилактику свирепых животных в Сумеру отвечает не Лесной дозор?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760713
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730760713,
					"content": "Мм... Это дело мне поручил мой знакомый из Лесного дозора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760714
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760714,
					"content": "Я точно не знаю, но они, похоже, потратили немало сил на расследование событий в зоне Увядания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760715
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760715,
					"content": "Поэтому и поручили мне профилактику свирепых животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760716
					],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760716,
					"content": "Вот оно как.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760717
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730760717,
					"content": "Спасибо тебе большое! Вот твоё вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сантон"
				},
				{
					"id": 730760705,
					"content": "Ещё какие!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760706
					]
				},
				{
					"id": 730760706,
					"content": "Да? Хотел бы я сам на них поглядеть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "Сантон"
				}
			]
		},
