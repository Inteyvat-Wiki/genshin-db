			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760401,
					"content": "Король вьючных яков? Несколько дней назад я пошёл за гору в поисках особой руды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760402
					],
					"speakerTitle": "Хун"
				},
				{
					"id": 730760402,
					"content": "Там я и увидел большого вьючного яка. Он действительно огромный. Я ещё таких не видел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760403
					],
					"speakerTitle": "Хун"
				},
				{
					"id": 730760403,
					"content": "Как только увидел меня, сразу бросился в мою сторону. Хорошо, что я быстро бегаю....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760404
					],
					"speakerTitle": "Хун"
				},
				{
					"id": 730760404,
					"content": "С какой стороны горы? Так, должно быть, на западе. Подробнее не скажу, но точно на западе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хун"
				}
			]
		},
		{
			"id": 7307605,
			"completionStepIds": [
				7307609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307601",
