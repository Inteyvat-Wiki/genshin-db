			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Наджиб",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760501,
					"content": "А, Король вьючных яков? Вы говорите про того огромного вьючного яка, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760502
					],
					"speakerTitle": "Наджиб"
				},
				{
					"id": 730760502,
					"content": "Два дня назад я отправился в Ли Юэ и увидел его прямо у Разлома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760503
					],
					"speakerTitle": "Наджиб"
				},
				{
					"id": 730760503,
					"content": "Мне повезло, что он спал. Я тихонечко его обошёл и убежал. Когда он спит, может показаться, что это несколько холмов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760504
					],
					"speakerTitle": "Наджиб"
				},
				{
					"id": 730760504,
					"content": "Где я его видел? Ли Юэ находится к югу отсюда. Где-то в том направлении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760505
					],
					"speakerTitle": "Наджиб"
				},
				{
					"id": 730760505,
					"content": "Хм. Но ведь наилучший путь из Сумеру в Ли Юэ по воде. Зачем понадобилось идти к Разлому?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730760506,
					"content": "Это... личное. Не имеет никакого отношения к тому, о чём вы спрашиваете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760507
					],
					"speakerTitle": "Наджиб"
				},
				{
					"id": 730760507,
					"content": "Ладно, это всё, что я знаю. У меня есть дела поважнее. Уходите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наджиб"
				}
			]
		},
		{
			"id": 7307606,
			"completionStepIds": [
				7307609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307601",
							"3"
						],
						"stepId": 7307601,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307606",
							"2"
						],
						"stepId": 7307606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Анайя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760601,
					"content": "А, о Короле вьючных яков... Пару дней назад я видела его вечером в лесу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760602
					],
					"speakerTitle": "Анайя"
				},
				{
					"id": 730760602,
					"content": "Было облачно. Я уже прошла половину пути, как вдруг увидела, как ко мне с грохотом устремилась тень размером с холм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760603
					],
					"speakerTitle": "Анайя"
				},
				{
					"id": 730760603,
					"content": "Я потеряла сознание от испуга. Когда пришла в себя на следующий день, парень, который меня нёс, сказал, что я потеряла сознание у подножия горы. К счастью, обошлось без серьёзных травм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760604
					],
					"speakerTitle": "Анайя"
				},
				{
					"id": 730760604,
					"content": "Спрашиваете, где это произошло? Я точно не помню. Наверное, на востоке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анайя"
				}
			]
		},
		{
			"id": 7307607,
			"completionStepIds": [
				7307607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307607",
