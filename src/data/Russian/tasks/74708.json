				]
			},
			"dialogs": [
				{
					"id": 747080101,
					"content": "#{NICKNAME} и Паймон, привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080102
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747080102,
					"content": "Госпожа Гильотен сказала, что вы недавно занялись обустройством океанариума. Она пригласила меня на должность консультанта по рыбам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080103,
						747080104
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747080103,
					"content": "Добро пожаловать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				},
				{
					"id": 747080105,
					"content": "Отлично! Когда медсестра Сиджвин рядом, можно не волноваться, что рыбки заболеют!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747080106,
					"content": "Хе-хе, а всё благодаря тому, что вы пригласили меня присматривать за зоопарком в «Стране кинофантазий Шевальмарин». Там я набралась опыта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080107
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747080107,
					"content": "Оказалось, между заботой о животных и уходом за больными есть много общего. Ну, по крайней мере, если животные ведут себя смирно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080108
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747080108,
					"content": "Но в том-то и дело: не вся рыба смирная. Поэтому, помимо ухода за имеющимися подопечными, можно подумать насчёт «стационарного лечения». Хотела бы с вами обсудить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080109
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747080109,
					"content": "Давай, мы слушаем!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080110
					]
				},
				{
					"id": 747080110,
					"content": "Офицер Сия рассказала мне, что в последнее время некоторые рыбы стали вести себя очень агрессивно. Они нападают на других существ поблизости, атакуют даже водолазов и небольшие лодки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080111
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747080111,
					"content": "Я подумала: а если пригласить их в океанариум? Тут они успокоятся и хотя бы не будут больше вредить окружающим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080112
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747080112,
					"content": "А потом я придумаю, как вылечить их от агрессии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080113
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747080113,
					"content": "Так мы поможем рыбкам, восстановим здоровую среду в воде, а ещё добудем уникальных актёров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080114
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747080114,
					"content": "Какая классная идея!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747080115,
					"content": "Поддерживаю!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080116
					]
				},
				{
					"id": 747080116,
					"content": "Тогда я назову вам места, где появляются буйные рыбки, а дальше всё в ваших руках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747080104,
					"content": "Ты очень нам поможешь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				}
			]
		}
	]
}