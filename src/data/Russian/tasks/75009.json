			"dialogs": [
				{
					"id": 750090101,
					"content": "Триста моры за вход?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090102,
						750090103
					],
					"speakerTitle": "Квипия"
				},
				{
					"id": 750090102,
					"content": "А можно подешевле?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090105
					]
				},
				{
					"id": 750090105,
					"content": "Цену устанавливает Ассоциация реликвий заврианов, и она не обсуждается. Насколько я знаю, это самое дешёвое место раскопок, поскольку оно существует дольше всех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090106
					],
					"speakerTitle": "Квипия"
				},
				{
					"id": 750090106,
					"content": "Но иногда к нам приходят мечтатели вроде вас, которые хотят попытать счастья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090107
					],
					"speakerTitle": "Квипия"
				},
				{
					"id": 750090107,
					"content": "Кто знает, может быть, никто из сотен и даже тысяч людей, что приходили до вас, не обладал зорким глазом на сокровища и не заметил бесценную реликвию, которая внешне выглядит совершенно обычной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090108
					],
					"speakerTitle": "Квипия"
				},
				{
					"id": 750090108,
					"content": "Найдётся немало людей, готовых заплатить триста моры за эту прекрасную мечту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090109
					],
					"speakerTitle": "Квипия"
				},
				{
					"id": 750090109,
					"content": "Как думаешь, тебе повезёт? Сумеешь разбогатеть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090110
					],
					"speakerTitle": "Квипия"
				},
				{
					"id": 750090110,
					"content": "Р-р, р-р, р-р! Ра-а-ав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090111,
						750090112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090111,
					"content": "Удача никогда не подводила меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090113,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, хочешь испытать свою удачу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750090114,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090115,
					"content": "Кажется, он не против. Хе-хе, всего триста моры, Паймон может себе это позволить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750090116,
					"content": "Приобрести три лучика надежды всего за триста моры - выгодная сделка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750090117,
					"content": "Желаю вам удачи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Квипия"
				},
				{
					"id": 750090112,
					"content": "У меня есть приносящий удачу завриан.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090103,
					"content": "Вход бесплатный, если я тебя одолею.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090104
					]
				},
				{
					"id": 750090104,
					"content": "Эй, мы таким не занимаемся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090105
					],
					"speakerTitle": "Паймон"
				}
			]
		},
