					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090202,
					"content": "Этот шарик... Похож на какую-то деталь. Тебе нравится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750090203,
					"content": "Р-р... Р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090204,
					"content": "Но мы его не откопали, а нашли... А вдруг это всё-таки что-то ценное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750090205,
					"content": "Давай спросим, когда будем уходить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
