					"Цзян Сюэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030701,
					"content": "Ты всё ещё здесь? Я бы на твоём месте поторопился. Он сам не свой, когда голоден.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030702
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220030702,
					"content": "Почему он кормит тебя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030703
					]
				},
				{
					"id": 220030703,
					"content": "Мы с ним... старые друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030704
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220030704,
					"content": "Я... Эм... На Тростниковых островах сделал... кое-что нехорошее. Но я должен был это сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030705
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220030705,
