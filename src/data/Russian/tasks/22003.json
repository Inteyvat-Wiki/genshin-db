			},
			"dialogs": [
				{
					"id": 220030501,
					"content": "Привет! Ты меня ищешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030502
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220030502,
					"content": "Это тебе от Улыбчивого Янь Сяо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030503
					]
				},
				{
					"id": 220030503,
					"content": "А, вот что так вкусно пахнет! Янь Сяо - потрясающий повар!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030504
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 220030504,
					"content": "Спасибо тебе! И обязательно поблагодари его от меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзян Сюэ"
				}
			]
		},
		{
			"id": 2200306,
			"completionStepIds": [
				2200305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
