			"trigger": {
				"objectNames": [
					"Улыбчивый Янь Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030301,
					"content": "Постой пока здесь. Я приготовлю еду, а ты отнесешь её ему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030302
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030302,
					"content": "Не переживай! Я не оставлю тебя с пустыми руками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030303
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030303,
					"content": "Готово! Теперь отнеси это глупцу, который не осознаёт своего счастья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030304
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030304,
					"content": "Зовут его <color=#00E1FFFF>Цзян Сюэ</color>. Он постоянно пропадает на рыбалке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030305
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
			]
		},
		{
			"id": 2200304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
