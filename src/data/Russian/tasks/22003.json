			"trigger": {
				"objectNames": [
					"Улыбчивый Янь Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030101,
					"content": "И хватает же ему наглости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030102
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030103
					]
				},
				{
					"id": 220030103,
					"content": "Что я делаю? Готовлю еду тому, кто этого совершенно не заслуживает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030104
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030104,
					"content": "Это просто невероятно. Он отлынивает от любой работы при первой возможности и совсем не помогает по хозяйству.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030105
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030105,
					"content": "Целый день проводит на рыбалке, но ловит только всякую мелочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030106
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030106,
					"content": "Если бы не я, то он уже умер бы с голоду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030107
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030107,
					"content": "Какой толк от моих жалоб? Он меня не услышит, а если и услышит, то сделает вид, что не услышал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030108
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030108,
					"content": "Если тебе нечем заняться, то помоги мне раздобыть некоторые ингредиенты. Мне кое-чего не хватает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030109
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030109,
					"content": "Мне нужно совсем немного. Всего лишь один <color=#00E1FFFF>заоблачный перчик</color> и одна <color=#00E1FFFF>чашечка лотоса</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030110,
						220030112
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030110,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030111
					]
				},
				{
					"id": 220030111,
					"content": "Поторапливайся. Я хочу поскорее с этим покончить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030112,
					"content": "Но здесь так много разных продуктов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030113
					]
				},
				{
					"id": 220030113,
					"content": "Босс заплатил за них. Думаешь, что этот халявщик вернёт ему деньги? Я так не думаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030114
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030114,
					"content": "Все расходы на его еду идут из моего кармана... Мы и так уже по уши в долгах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030115
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030115,
					"content": "Просто принеси мне эти продукты, пожалуйста. Я не прошу тебя о многом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
			]
		},
