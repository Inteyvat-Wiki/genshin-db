				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030601,
					"content": "#Ты отн{F#есла}{M#ёс} еду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030602
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030602,
					"content": "Да, он попросил...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030603
					]
				},
				{
					"id": 220030603,
					"content": "Отблагодарить меня? Не утруждайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030604
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030604,
					"content": "Я уже столько раз слышал его благодарности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030605
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030605,
					"content": "Он только и делает, что рыбачит да благодарит меня! Лучше бы помог на кухне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030606
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030606,
					"content": "#Эх... Зачем мне тебя грузить своими проблемами... Вот твоя награда! Ты её заслужил{F#а}, в отличие от некоторых. Давай, до свидания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
			]
		},
		{
			"id": 2200307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
