			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Улыбчивый Янь Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030401,
					"content": "Поторопись. Сытый жмот лучше, чем голодный жмот. Поверь мне, я в этом разбираюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030402
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030402,
					"content": "Зачем ты его кормишь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030403
					]
				},
				{
					"id": 220030403,
					"content": "Потому что у него нет никого, кроме меня. Я единственный человек во всё Ли Юэ, который с ним общается. И единственный человек, которому он умудрился сесть на шею.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030404
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030404,
					"content": "Зачем? Да какая разница? Ладно... Потому что мне нравится для него готовить. Понятно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030405
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030405,
					"content": "Если бы я не хотел для него готовить, то он опять наделал бы глупостей на тростниковых островах. А это никому не нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030406
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 220030406,
					"content": "Ну чего ты стоишь?! Пошевеливайся, еда стынет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
			]
		},
