				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751480101,
					"content": "Избранник драконов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751480102,
					"content": "Взойди на вершину короны и прыгни в огонь Священной горы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751480103,
					"content": "Иди и открой его - сломай золотую печать, яви сияние несметных оставшихся огней!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751480104,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480105,
					"content": "#Что случилось? Ты снова {F#видела}{M#видел} что-то странное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480106,
						751480107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751480106,
					"content": "Теперь более чётко...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				},
				{
					"id": 751480108,
					"content": "О, может, это потому, что мы теперь рядом с вулканом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751480109,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480110,
					"content": "...Такое ощущение, что тот, кто говорил с вами всё это время, находится внутри той горы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751480111,
					"content": "Но мы видели эти штуки, когда приблизились к вулкану. Значит, мы шли в верном направлении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751480112,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480107,
					"content": "Кажется, мы приближаемся...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				}
			]
		},
