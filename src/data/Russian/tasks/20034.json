			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Анна",
					"Энтони"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340101,
					"content": "Что же... Поработаем сегодня как следует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340102,
						200340106
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340102,
					"content": "Вижу, ты полна энтузиазма.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340103
					]
				},
				{
					"id": 200340103,
					"content": "Ну конечно! Быть искательницей приключений так увлекательно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340104
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340104,
					"content": "Только вот... Хе-хе, мне ещё предстоит узнать о поручениях так много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340105
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340105,
					"content": "#Путешественни{F#ца}{M#к}, сходишь со мной ещё раз? Я хотела бы спросить тебя о некоторых вещах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340108,
					"content": "Тогда в путь. Сегодняшнее поручение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340109
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340109,
					"content": "Хм... Опять товарный аэростат...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340106,
					"content": "#Хочешь, чтобы я {F#составила}{M#составил} тебе компанию?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340107
					]
				},
				{
					"id": 200340107,
					"content": "Так сходишь? Хе-хе, я ещё многому хотела бы у тебя научиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "Анна"
				}
			]
		},
		{
			"id": 2003402,
			"completionStepIds": [
				2003406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003405",
							"3"
						],
						"stepId": 2003405,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003406",
							"2"
						],
						"stepId": 2003406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Беннет",
					"Фишль",
					"Анна",
					"Оз"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340201,
					"content": "Фишль, зачем ты убежала так быстро? Это же опасно!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340202
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 200340202,
					"content": "Моя божественная молния не пощадит ни один росток зла на своём пути...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340203
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 200340203,
					"content": "Да это же Фишль и Беннет! Привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340204
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340204,
					"content": "#Привет, Анна. И тебе привет, путешественни{F#ца}{M#к}. Вы выполняете поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340205
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 200340205,
					"content": "Вы прибыли, благословлённые принцессой! Вас привели сюда судьбы шёлковые нити.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340206
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 200340206,
					"content": "Госпожа хочет сказать, что очень рада этой случайной встрече.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340207
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 200340207,
					"content": "Я сопровождаю Анну на её задании.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340208
					]
				},
				{
					"id": 200340208,
					"content": "#Так и есть. Мы с путешественни{F#цей}{M#ком} сопровождали товарный аэростат...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340209
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340209,
					"content": "Когда на нас вдруг напали Похитители сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340210
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340210,
					"content": "Простите, простите меня. Это я виноват...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340211
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 200340211,
					"content": "Мы с Фишль взяли поручение. Нам необходимо было выяснить местонахождение одной банды Похитителей сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340212
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 200340212,
					"content": "Оз напал на след, и мы чуть было не схватили их... как вдруг я споткнулся о ветку и упал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340213
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 200340213,
					"content": "Похитители сокровищ услышали шум и сбежали, а нам ничего не оставалось, как погнаться за ними...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340214
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 200340214,
					"content": "Нет нужды для беспокойства. Лучам фиолетовой кары было суждено отсечь судьбы этих злодеев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340215
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 200340215,
					"content": "#Но госпожа, со злодеями {F#расправилась путешественница}{M#расправился путешественник}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340216
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 200340216,
					"content": "О-оз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340217
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 200340217,
					"content": "В общем, спасибо вам. Нам повезло, что вы остановили их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340218
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 200340218,
					"content": "Кажется, сегодня удача на моей стороне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340219
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 200340219,
					"content": "Мы были рады помочь вам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340220
					]
				},
				{
					"id": 200340220,
					"content": "Хе-хе, теперь мы поведём этих Похитителей сокровищ в Гильдию. Будьте осторожны и смотрите под ноги!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Беннет"
				}
			]
		},
