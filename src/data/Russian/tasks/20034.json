					"Анна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340301,
					"content": "Беннет надёжен, как и всегда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340302
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340302,
					"content": "А Фишль... Её слова как никогда сильны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340303,
						200340308
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340303,
					"content": "Что ты думаешь о Беннете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340304
					]
				},
				{
					"id": 200340304,
					"content": "Хм, что я о нём думаю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340305
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340305,
					"content": "Когда я только вступила в Гильдию, он отвечал на все мои вопросы и много помогал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340306
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340306,
					"content": "Но также я слышала, что Беннет особенно невезуч.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340307
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340307,
					"content": "Какая несправедливость. Он же такой хороший человек...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340313,
					"content": "#Ух... Во всяком случае, поручение выполнено. Спасибо тебе, путешественни{F#ца}{M#к}. Я вернусь доложить в Гильдию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340314
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340314,
					"content": "Только почему мне несколько дней подряд достаётся сопровождение товарного аэростата? Других поручений нет, что ли?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340308,
					"content": "Как тебе Фишль?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340309
					]
				},
				{
					"id": 200340309,
					"content": "Фишль? Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340310
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340310,
					"content": "Она тоже очень хороша! Метко стреляет, и множество поручений выполнила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340311
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340311,
					"content": "Только разговаривает она... немного непонятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340312
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200340312,
					"content": "Но всё же она... очень опытная искательница приключений. Ой, н-нет, она следователь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Анна"
				}
			]
		},
		{
			"id": 2003404,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003401",
							"3"
						],
						"stepId": 2003401,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Энтони"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340401,
					"content": "#Путешественни{F#ца}{M#к}, прошу тебя, присмотри за Анной. Последнее время она так взволнована...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340402
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200340402,
					"content": "Ты не хочешь, чтобы она была искателем приключений?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340403
					]
				},
				{
					"id": 200340403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340404
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200340404,
					"content": "Я уважаю мечты Анны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340405
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200340405,
					"content": "Она наконец переборола болезнь, и у неё появилась возможность осуществить свою мечту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340406
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200340406,
					"content": "Я её брат, и я... полностью поддерживаю её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340407
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200340407,
					"content": "Вот так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		}
	]
}