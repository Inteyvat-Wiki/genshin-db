				"objectNames": [
					"Энтони"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200520301,
					"content": "#Путешественни{F#ца}{M#к}, прошу тебя, присмотри за Анной. Последнее время она так взволнована...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520302
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200520302,
					"content": "Ты не хочешь, чтобы она была искателем приключений?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520303
					]
				},
				{
					"id": 200520303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520304
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200520304,
					"content": "Я уважаю мечты Анны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520305
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200520305,
					"content": "Она наконец переборола болезнь, и у неё появилась возможность осуществить свою мечту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520306
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200520306,
					"content": "Я её брат, и я... полностью поддерживаю её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520307
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200520307,
					"content": "Вот так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		}
	]
