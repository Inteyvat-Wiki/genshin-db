				"points": []
			},
			"dialogs": [
				{
					"id": 200520101,
					"content": "Что же... Поработаем сегодня как следует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520102,
						200520106
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200520102,
					"content": "Вижу, ты полна энтузиазма.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520103
					]
				},
				{
					"id": 200520103,
					"content": "Ну конечно! Быть искательницей приключений так увлекательно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520104
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200520104,
					"content": "Только вот... Хе-хе, мне ещё предстоит узнать о поручениях так много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520105
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200520105,
					"content": "#Путешественни{F#ца}{M#к}, сходишь со мной ещё раз? Я хотела бы спросить тебя о некоторых вещах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520108
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200520108,
					"content": "Тогда в путь. Сегодняшнее поручение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520109
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200520109,
					"content": "Хм... Опять товарный аэростат...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				},
				{
					"id": 200520106,
					"content": "#Хочешь, чтобы я {F#составила}{M#составил} тебе компанию?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520107
					]
				},
				{
					"id": 200520107,
					"content": "Так сходишь? Хе-хе, я ещё многому хотела бы у тебя научиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520108
					],
					"speakerTitle": "Анна"
				}
			]
		},
		{
			"id": 2005202,
			"completionStepIds": [
				2005204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2005203",
							"3"
						],
						"stepId": 2005203,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2005204",
							"2"
						],
						"stepId": 2005204,
						"stateName": "QUEST_STATE_UNFINISHED"
