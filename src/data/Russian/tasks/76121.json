			"dialogs": [
				{
					"id": 761210101,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210102
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210102,
					"content": "Привет, Коломбина! Паймон видит, что ты сегодня в хорошем настроении!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761210103,
					"content": "Ха... Поднимайтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210104
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210104,
					"content": "О! Ты что, снова хочешь поиграть в лунные шахматы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761210105,
					"content": "Да, давно не играла и немного соскучилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210106
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210106,
					"content": "Правила всё те же?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210107
					]
				},
				{
					"id": 761210107,
					"content": "Не думай, что раз ты стала Богиней Трёх Лун, то сможешь за ход передвигать больше фигур!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761210108,
					"content": "Это было бы жульничеством, я не хочу побеждать таким способом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210109
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210109,
					"content": "Хе-хе, Паймон пошутила!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761210110,
					"content": "Начнём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				}
			]
		},
		{
			"id": 7612102,
