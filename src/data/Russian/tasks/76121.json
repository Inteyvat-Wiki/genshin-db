				]
			},
			"dialogs": [
				{
					"id": 760540301,
					"content": "Так... правильно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540302,
					"content": "Нужно подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540303,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540304,
					"content": "Луны... Луны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540305,
					"content": "Может, вот так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540306,
					"content": "Похоже, в этом раунде я выиграла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540307,
					"content": "Мои три Луны соединились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540308,
					"content": "Да, победа за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540309,
					"content": "Луны растут и убывают в бесконечном цикле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540310,
					"content": "Похоже, наши с тобой Луны не хотят затмеваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540311,
					"content": "Мы приближаемся к ничьей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540312,
					"content": "Оказывается, ты тщательно всё взвешиваешь, прежде чем принять решение. Не торопись, время есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540313,
					"content": "#Ты забыл{F#а}, как размещать Луны на ночном небе? Помочь тебе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540314,
					"content": "Тебе не нравится эта игра? Хм... Мне она кажется довольно забавной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540315,
					"content": "Мм? Ты на меня глазеешь? Я чувствую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540316,
					"content": "Ты глазеешь... Правда о Лунах написана на моём лице?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540317,
					"content": "Доска там...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540318,
					"content": "Хм, твои Луны сошлись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540319,
					"content": "Ночное небо принадлежит тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540320,
					"content": "Ах... Я... где-то промахнулась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540321,
					"content": "Вы приятно проводите время за игрой...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "Три луны выстроились в линию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210203,
					"content": "Что такое? Думаешь о том, кто выиграл в прошлой партии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761210204,
					"content": "О, нет. Но... когда смотрю на эту игру, у меня возникает особое чувство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210205,
					"content": "Точно! Ты получила силу Трёх Лун, это уже не просто способность повелевать ночным небом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761210206,
					"content": "Да, я тоже думаю, что если бы между тремя богинями не возникли разногласия, судьба мира могла бы сложиться иначе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210207,
					"content": "Какими они были?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "Хм... Первой я встретила богиню Радужной Луны, Сонет. Она была более жизнерадостной, чем я себе представляла, словно озорная девчушка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210209,
					"content": "Ария, Богиня Вечной Луны - самая сдержанная из трёх богинь, обладает лидерскими качествами и очень добра к другим. Ах, прямо как Лаума.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210210,
					"content": "Канон, Богиня Морозной Луны... кажется мудрой и дальновидной богиней. Именно она отдала мне свою луну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210211,
					"content": "Похоже, они все очень добрые божества.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "Верно, несмотря на разногласия, они любили Тейват и считали его своим домом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210213,
					"content": "Когда я говорила о будущем, они выглядели счастливыми. Словно радовались тому, что у этого мира такое богатое будущее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210214,
					"content": "Именно поэтому они дали мне силу и помогли вернуться «домой».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210215,
					"content": "Хм... Паймон очень хочет встретиться с ними и отблагодарить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761210216,
					"content": "Согласна, но... Вряд ли это возможно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210217,
					"content": "К счастью, этот мир продолжает двигаться вперёд, а люди, которых они защищали, выжили и продолжают рассказывать истории о них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210218,
					"content": "Точно! Лучшая благодарность трём богиням - это правильно жить и не позволять злодеям разрушить этот мир!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761210219,
					"content": "А ты умеешь красиво говорить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "Отныне каждый день для тебя - это день, за который нужно быть благодарной...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "Конечно! Паймон всегда старается наслаждаться жизнью в полной мере!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761210222,
					"content": "И ты тоже, Коломбина! Каждый день нужно хорошо кушать и высыпаться, а когда захочешь поиграть - приходи к нам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761210223,
					"content": "Ха-ха, хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761210224,
					"content": "Когда я буду играть в лунные шахматы, всегда буду вспоминать трёх добрых богинь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				}
			]
		},
		{
			"id": 7612103,
			"completionStepIds": [],
