			"dialogs": [
				{
					"id": 710390101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390102,
						710390103
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710390102,
					"content": "Привет, Цзинь У!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				},
				{
					"id": 710390104,
					"content": "?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390105
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710390105,
					"content": "Ай, ты меня напугала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710390106,
					"content": "Простите. Если вы ищете Чжи Цюн... она ушла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390107,
						710390109
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710390107,
					"content": "Куда она пошла?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390108
					]
				},
				{
					"id": 710390108,
					"content": "Я не знаю... Я отвлеклась ненадолго, а потом она исчезла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710390112,
					"content": "Я говорила с ней... Она настаивала на том, чтобы уйти. Её невозможно было удержать ни добрыми словами, ни угрозами. Никак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390113
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710390113,
					"content": "Ах, надеюсь, она знает, что делает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390114
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710390114,
					"content": "Да, очень надеюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390115
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710390115,
					"content": "Ох, нужно сказать Му Нину, чтобы он как можно скорее организовал поисково-спасательную команду, чтобы отыскать её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390116,
						710390117
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710390116,
					"content": "Мы сходим к Му Нину.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390118,
					"content": "Р-р, Чжи Цюн опять ушла! Поднимемся и найдём Му Нина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710390117,
					"content": "Пожалуйста, не переживай так сильно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390109,
					"content": "Каким было её состояние, когда она ушла?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390110
					]
				},
				{
					"id": 710390110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390111
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710390111,
					"content": "Хедив осмотрел её. Состояние было не очень...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710390103,
					"content": "Как дела?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				}
			]
		},
		{
			"id": 7103902,
			"completionStepIds": [
				7103903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103903",
							"2"
						],
						"stepId": 7103903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Му Нин",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710390201,
					"content": "Хм? Чжи Цюн не с тобой? Мы получили новости из Департамента по делам граждан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390202
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390202,
					"content": "Поскольку карты, которые она нарисовала, очень помогли залу Хуэйшань, Департамент по делам граждан официально назначил её в порядке исключения... ммм... консультантом-проводником.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390203
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390203,
					"content": "Передай мои поздравления Чжи Цюн, не зря она трудилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390204
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390204,
					"content": "Она ушла.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390205
					]
				},
				{
					"id": 710390205,
					"content": "Ушла? Как это?.. Она ушла? Но Миллелиты не сказали мне, что кто-то покинул Разлом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390206
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390206,
					"content": "Она покинула отряд георазведки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390207
					]
				},
				{
					"id": 710390207,
					"content": "Что?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390208
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390208,
					"content": "Подожди! Подожди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390209
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390209,
					"content": "Нет, нет, нет... она... Говоришь, ушла из отряда георазведки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390210
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390210,
					"content": "Чжи Цюн ушла?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390211
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390211,
					"content": "Да! Что именно тут непонятного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710390212,
					"content": "...Понял. Я немедленно организую поисково-спасательную команду. Если она всё ещё в Разломе, мы сможем найти её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390213
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390213,
					"content": "Может, это её очередная глупость или что-то другое... В любом случае её нужно найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390214
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390214,
					"content": "В её нынешнем состоянии покинуть отряд - это полное безрассудство...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390215,
						710390217
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390215,
					"content": "Нужна моя помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390216
					]
				},
				{
					"id": 710390216,
					"content": "На этот раз нет... Пора мне заняться этим самому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390233,
					"content": "Если понадобится моя помощь, то скажи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390234
					]
				},
				{
					"id": 710390234,
					"content": "Да, Паймон тоже готова помочь! Мы должны заботиться о юных искателях приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710390235,
					"content": "Будем по дороге смотреть по сторонам. Вдруг встретим её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710390217,
					"content": "Расскажи о Чжи Цюн...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390218
					]
				},
				{
					"id": 710390218,
					"content": "Она неугомонная, но как бы там ни было, мы друзья. Возможно, я не самый дружелюбный человек на свете, но о своих друзьях я не забываю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390219
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390219,
					"content": "Она всегда говорит о какой-то великой мечте искателя приключений. А сама уже несколько раз довольно серьёзно пострадала. И однажды чуть не погибла. А только я решил, что она немного остепенилась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390220
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390220,
					"content": "Я надеялся, что она уже забыла свои несбыточные мечты. Роальд... Стэнли... Приключения - это не только вино и розы, знаете ли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390221
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390221,
					"content": "Эх, но я не ожидал... Честно говоря, может, зря я попросил тебя приехать в Разлом... Так бы в ней не вспыхнула снова тяга к приключениям...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390222,
						710390226
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390222,
					"content": "Но её усилия всё же принесли некоторые результаты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390223
					]
				},
				{
					"id": 710390223,
					"content": "Результаты?.. Звучит, холодно и эгоистично. Мы очень благодарны за карты, на которых она нарисовала большие участки Разлома, да...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390224
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390224,
					"content": "Но должны ли ставиться выше жизни такие неосязаемые, иллюзорные вещи, как «мечты» и стремление к ним?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390225
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390225,
					"content": "Я просто не могу этого понять. Мне сложно осознать, что кто-то бросается навстречу опасностям из таких побуждений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390232,
					"content": "Так что, её поисками я сам займусь... Точнее поисково-спасательный отряд Миллелитов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390226,
					"content": "Это её выбор.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390227
					]
				},
				{
					"id": 710390227,
					"content": "Выбор... Отговорки! Она отправилась на верную смерть, неужели ты не понимаешь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390228
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390228,
					"content": "Кхе-кхе... Прости, я немного резко выразился. Но всё же... Не могла бы она быть чуть более смиренной в тех случаях, когда мы, смертные, не можем ничего изменить?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390229
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390229,
					"content": "Через тридцать... может быть, даже двадцать лет у нас будет более безопасное подземное оборудование! Тогда ей не нужно будет заниматься георазведкой местности для составления подземных карт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390230
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390230,
					"content": "Но она не хочет ждать! Нет, ей хочется, видите ли, завершить дело всей своей жизни, пока она молода!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390231
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710390231,
					"content": "Это глупость, говорю я. Как друг, я не могу просто оставить её в покое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "Му Нин"
				}
			]
		}
	]
}