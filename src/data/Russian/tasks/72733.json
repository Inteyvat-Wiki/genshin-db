			"dialogs": [
				{
					"id": 727330101,
					"content": "Покорительница небес Железная фиалковая дыня! Я пришёл отомстить за Эликтру! Готовь своего оникабуто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727330102
					],
					"speakerTitle": "Жуколов"
				},
				{
					"id": 727330102,
					"content": "Победив тебя, я уничтожу всю банду Аратаки, по одному за раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727330103
					],
					"speakerTitle": "Жуколов"
				},
				{
					"id": 727330103,
					"content": "В этот раз... взрослый? Почему этот парень ещё более увлечён, чем дети?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727330104,
						727330105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 727330104,
					"content": "Спокойно, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727330106
					]
				},
				{
					"id": 727330106,
					"content": "Железная фиалковая дыня! Похоже, этот парень вызывает тебя на бой. Отступать нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727330107
