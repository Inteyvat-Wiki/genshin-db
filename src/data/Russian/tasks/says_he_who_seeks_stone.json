				},
				{
					"id": 710740212,
					"content": "Так значит тебе нужны красивые разноцветные камешки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710740213,
					"content": "Не просто красивые камешки. Это должен быть особенный камень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740214
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710740214,
					"content": "#Ну так как, {NICKNAME}? Ты найдёшь мне камни по моему описанию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740215
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710740215,
					"content": "Принеси мне, и я хорошо заплачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740216
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710740216,
					"content": "Хм? А моры у тебя на такие камни хватит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740217
					],
