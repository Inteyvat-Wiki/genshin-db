			"trigger": {
				"objectNames": [
					"Паймон",
					"Арапас"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210101,
					"content": "Ой, а что это там в котелке готовится? Так вкусно пахнет! У Паймон уже слюнки текут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210102,
					"content": "Кажется, это суп, но... Паймон не понимает, из чего он.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210103,
					"content": "#Ой, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210104,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210105
					]
				},
				{
					"id": 730210105,
					"content": "Смотри, тут никого нет, а суп так вкусно пахнет. Давай попробуем, пока никто не видит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210106,
						730210108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210106,
					"content": "Ну давай, только тихонько...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210107
					]
				},
				{
					"id": 730210107,
					"content": "Хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210112,
					"content": "Котелок оказался меньше, чем на первый взгляд.\\nСодержимое котелка исчезло.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210113
					]
				},
				{
					"id": 730210113,
					"content": "Пфф... Этот суп так прекрасно пах, а на вкус никакой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210114,
					"content": "А вот и Арамухукунда! А вы, нары, что тут делаете?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210115
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210115,
					"content": "Аранара? Откуда он взялся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210116,
					"content": "Из-под земли! Это неважно! Зачем вы съели мой суп? Арапасу непросто было его приготовить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210117,
						730210120
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210117,
					"content": "Извини...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210118
					]
				},
				{
					"id": 730210118,
					"content": "Извини...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210119,
					"content": "Хм! Одним «извини» суп не вернёшь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210123,
					"content": "Да вы вообще знаете, как сложно тут готовить? То дождь, то солнцепёк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210124
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210124,
					"content": "И вот я наконец приготовил котелок супа, только отлучился за фруктом харра, а вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210125
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210125,
					"content": "Твой суп так вкусно пах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210126,
					"content": "Но если это так сложно, то почему ты готовишь здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210127,
					"content": "Хм! Потому что самое важное для готовки нужно собирать каждый день...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210128,
						730210129
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210128,
					"content": "Это такая поварская причуда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210130,
					"content": "Вода! Всё дело в воде! Вкус супа зависит от воды, поэтому она должна быть лучшей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210131
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210131,
					"content": "Я набирал воду по всей чаще Апам и варил суп. А воды я собрал столько раз, сколько листьев растёт на деревьях. И тогда я нашёл лучший живой источник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210132
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210132,
					"content": "#Это единственный источник воды, пригодный для «величайшего лакомства» Праздника Утсава! Но тебе этого не понять... Только {F#та}{M#тот} нара бы понял{F#а}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210133
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210133,
					"content": "Кстати, на самом деле нас послала Арапакати...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210134,
					"content": "Вы объясняете ситуацию Арапасу.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210135
					]
				},
				{
					"id": 730210135,
					"content": "А, так вы, нары, друзья моей сестрёнки! И скоро Праздник Утсава!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210136
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210136,
					"content": "Но я не об этом. Я уже нашёл живой источник и приготовил «величайшее лакомство». Вот в этом котелке... А потом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210137
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210138
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210138,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210139
					]
				},
				{
					"id": 730210139,
					"content": "Хи-хи... Но ты не расстраивайся, суп вышел очень ароматным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210140,
					"content": "Ах! Мой живой источник! Там живут апшваны. Я так долго ждал, пока они уйдут, и набрал лишь котелок воды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210141
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210141,
					"content": "Так не пойдёт! Вы должны принести мне ещё один котелок из живого источника!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210142
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210142,
					"content": "Апшваны? Это кто такие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210143,
					"content": "Хм! Вы, нары, совершенно ничего не знаете о лесе. Они живут в воде, у них четыре ноги, хвост и они кусаются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210144
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210144,
					"content": "Собаки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210145,
						730210146
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210145,
					"content": "Собаки не живут в воде.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210147,
					"content": "Да кто такие апшваны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210148
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210148,
					"content": "Неважно! Достаньте мне воду! Из того живого источника!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210149
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210149,
					"content": "#Ладно, ладно... {NICKNAME}, придётся нам идти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210150,
						730210151
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210150,
					"content": "Ох.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210152,
					"content": "Только обязательно из живого источника!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210151,
					"content": "Идём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210146,
					"content": "Водяные собаки? Такие водные миражи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210129,
					"content": "Это чтобы не забывать свои мечты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210120,
					"content": "Это всё Паймон!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210121
					]
				},
				{
					"id": 730210121,
					"content": "#Эй! {NICKNAME}, ты вот так просто сдашь Паймон?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210122,
					"content": "Мне без разницы, кто съел суп! Супа-то нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730210108,
					"content": "Так нехорошо делать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210109
					]
				},
				{
					"id": 730210109,
					"content": "Паймон так интересно! Паймон только чуточку попробует! Самую чуточку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730210110,
					"content": "А если он испортился, то у тебя живот разболится...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210111
					]
				},
				{
					"id": 730210111,
					"content": "Эй, ты недооцениваешь Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "Паймон"
				}
			]
		},
