			},
			"dialogs": [
				{
					"id": 200620501,
					"content": "Как же тренироваться наиболее эффективно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620502
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200620502,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620503
					]
				},
				{
					"id": 200620503,
					"content": "Я готовлюсь к испытаниям Ордо Фавониус. Но у меня пока не очень получается. А всё потому, что у меня нет хорошего учителя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620504
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200620504,
					"content": "Папа постоянно предлагает помощь. Он всё время твердит, что когда-то был искателем приключений... Бла-бла-бла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620505
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200620505,
					"content": "Но на самом деле, он просто бесполезный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620506
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200620506,
					"content": "Пообещал раздобыть для меня тренировочное оборудование. Даже боюсь представить, что он выдумал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айлин"
				}
			]
		},
