			"trigger": {
				"objectNames": [
					"Герман"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620101,
					"content": "Что же делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620102
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620103
					]
				},
				{
					"id": 200620103,
					"content": "Моя дочь, Айлин, хочет стать рыцарем Ордо Фавониус. Сейчас она готовится к испытаниям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620104
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620104,
					"content": "Эх, я так хочу стать её наставником. Но она не верит, что когда-то я был искателем приключений... Она хочет тренироваться сама.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620105
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620105,
					"content": "И я никак не могу показать ей, на что способен. Когда у тебя семья и дети, рисковать жизнью в глупых приключениях - крайне неразумно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620106
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620106,
					"content": "Моя ответственность перед близкими важнее, чем эгоистичное желание приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620107
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620107,
					"content": "Но в душе я по-прежнему искатель приключений. У меня можно кое-чему научиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620108
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620108,
					"content": "Однажды я заметил, что хиличурлы используют деревянные чучела для практики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620109
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620109,
					"content": "Они выглядят достаточно крепкими. Уверен, что Айлин такое бы пригодилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620110
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620110,
					"content": "Ты сможешь достать для меня тренировочное чучело хиличурлов? Конечно же, я щедро вознагражу тебя. Договорились?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620111,
						200620112
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620111,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620113
					]
				},
				{
					"id": 200620113,
					"content": "Мне нравится твой подход. Я когда-то был таким же, когда только вступил в Гильдию искателей приключений. Я был готов на всё. Абсолютно на всё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620114
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620114,
					"content": "Эх... Ну ладно. За дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620112,
					"content": "Это всего лишь хиличурлы! Ты с ними справишься!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620115
					]
				},
				{
					"id": 200620115,
					"content": "Но я не могу. Каждому из нас отведено ограниченное количество приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620116
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620116,
					"content": "Поверь, в семейной жизни тоже предостаточно приключений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620117
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620117,
					"content": "Поэтому... Я предоставлю вам самим разобраться с хиличурлами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Герман"
				}
			]
		},
		{
			"id": 2006202,
			"completionStepIds": [
				2006204
