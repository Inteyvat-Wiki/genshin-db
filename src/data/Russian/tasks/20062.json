			},
			"dialogs": [
				{
					"id": 200620201,
					"content": "Вы нашли чучела для тренировки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620202
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620202,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620203
					]
				},
				{
					"id": 200620203,
					"content": "Отлично. Выглядят достаточно крепкими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620204
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620204,
					"content": "Если уж хиличурлам не удалось их размолотить, то они точно выдержат тренировки Айлин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620205
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620205,
					"content": "Спасибо. Вот твоя награда, искатель приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Герман"
				}
			]
		},
