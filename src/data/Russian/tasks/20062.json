			"dialogs": [
				{
					"id": 200620301,
					"content": "Вы нашли чучела для тренировки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620302
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620302,
					"content": "Нашли, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620303
					]
				},
				{
					"id": 200620303,
					"content": "Ого... Похоже, кто-то перестарался! Не знаю, как вам удалось сломать такое крепкое чучело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620304
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620304,
					"content": "Конечно, в пылу сражения сложно заботиться о сохранности деревянной куклы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620305
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620305,
					"content": "Я не могу подарить его Айлин в таком виде. Но древесина довольно крепкая. Возможно, у меня получится его починить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620306
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620306,
					"content": "Это было непросто, но привёл его в... кхм... человеческий вид. Не так уж и плохо, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620307
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620307,
					"content": "У меня ничего бы не вышло без твоей помощи. Держи, как я и обещал, это твоя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620308
					],
					"speakerTitle": "Герман"
				},
				{
					"id": 200620308,
					"content": "Пускай я уже не состою в Гильдии искателей приключений, но я по-прежнему уважаю правила Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Герман"
				}
			]
		},
