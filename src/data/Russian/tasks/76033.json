			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Одержимый едой призрак"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330101,
					"content": "#Эй, {F#новенькая}{M#новичок}! Так дело не пойдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330102
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330102,
					"content": "Мы готовим еду для ратников на острове и должны учитывать их вкусы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330103
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330103,
					"content": "Такую стряпню ратникам подавать нельзя. Всё сырое, надо было огня подбавить, да и вообще, они такое не едят. Будем переделывать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330104
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330104,
					"content": "Тебе надо тренироваться. Начни с самых простых блюд Нод-Края, например, попробуй сделать нод-крайский хот-дог. Как приготовишь, покажи мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Одержимый едой призрак"
				}
			]
		},
		{
			"id": 7603302,
			"completionStepIds": [
				7603304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603304",
							"2"
						],
						"stepId": 7603304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Одержимый едой призрак"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330201,
					"content": "Гм, сосиска в хот-доге у тебя хорошо прожарилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330202
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330202,
					"content": "В ресторане на большой земле из тебя вышел бы толковый помощник повара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330203
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330203,
					"content": "Но мы готовим для всех ратников на острове. Так что плюнь на высокую кухню, главное - еды должно быть много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330204
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330204,
					"content": "Хлеб надо брать потолще, овощей побольше, и лучше добавить к сосиске ещё что-нибудь мясное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330205
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330205,
					"content": "Тебе надо ещё потренироваться. В следующий раз попробуй приготовить мясо с ягодным соусом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Одержимый едой призрак"
				}
			]
		},
		{
			"id": 7603303,
			"completionStepIds": [
				7603306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603306",
							"2"
						],
						"stepId": 7603306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Одержимый едой призрак"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330301,
					"content": "Ммм. Толстые ломтики мяса с идеальной прожаркой. Неплохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330302
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330302,
					"content": "Но дай я тебе напомню. Когда готовишь мясо, очень важно выбрать правильный гарнир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330303
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330303,
					"content": "Мясо тяжёлая еда. Поэтому его заправляют ягодами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330304
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330304,
					"content": "Мы отвечаем за здоровое питание на острове, поэтому необходимо соблюдать верный баланс между овощами и мясом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330305
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330305,
					"content": "У тебя гарнира к мясу почти нет. Так дело не пойдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330306
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330306,
					"content": "Тебе надо ещё потренироваться. В следующий раз попробуй приготовить цыплёнка с ягодами лакка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Одержимый едой призрак"
				}
			]
		},
		{
			"id": 7603304,
			"completionStepIds": [
				7603308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
