						],
						"stepId": 7603308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Одержимый едой призрак"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330401,
					"content": "#Цыплёнок удался тебе на славу, и гарнира тут достаточно. Ты будто специально {F#постаралась}{M#постарался}, чтобы я не смог найти ни одного изъяна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330402
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330402,
					"content": "Ну и хорошо. Я здесь не затем, чтобы изводить придирками новичков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330403
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330403,
					"content": "Я повар. Я делаю свою работу, и у меня неплохо получается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330404
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330404,
					"content": "Даже если в самом деле начнётся Дикая Охота, у меня всё готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330405
					],
					"speakerTitle": "Одержимый едой призрак"
				},
				{
					"id": 760330405,
					"content": "Жаль только... Я не успел отнести им еду... всё разлилось по земле... разлилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Одержимый едой призрак"
				}
			]
		}
	]
}