			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мацудзака",
					"Сайка",
					"Ивао"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100101,
					"content": "#{NICKNAME}, мы ищем Великого Мудзину Ёкая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100102
					],
					"speakerTitle": "Мацудзака"
				},
				{
					"id": 120100102,
					"content": "Ты случайно не знаешь, где он живёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100103
					],
					"speakerTitle": "Сайка"
				},
				{
					"id": 120100103,
					"content": "Кто такой Великий Мудзина Ёкай?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100104,
					"content": "Ты о нём не слышала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100105
					],
					"speakerTitle": "Мацудзака"
				},
				{
					"id": 120100105,
					"content": "Это очень сильный и очень хитрый монстр, который любит морочить людям голову! Он обладает магическими способностями и умеет превращаться во что угодно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100106
					],
					"speakerTitle": "Мацудзака"
				},
				{
					"id": 120100106,
					"content": "Однажды Великий Мудзина Ёкай украл рис из нашего дома. А в другой раз он столкнул моего отца в реку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100107
					],
					"speakerTitle": "Ивао"
				},
				{
					"id": 120100107,
					"content": "Какой шалун...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100108,
					"content": "Зачем вы его ищете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100109
					]
				},
				{
					"id": 120100109,
					"content": "Мы наконец-то нашли способ его прогнать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100110
					],
					"speakerTitle": "Сайка"
				},
				{
					"id": 120100110,
					"content": "Мой папа говорит, что Великий Мудзина Ёкай любит потешаться над людьми, которые не приходят домой вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100111
					],
					"speakerTitle": "Ивао"
				},
				{
					"id": 120100111,
					"content": "Нам нужно прогнать его, и тогда мы сможем гулять сколько захотим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100112
					],
					"speakerTitle": "Ивао"
				},
				{
					"id": 120100112,
					"content": "Судя по вашему описанию, это очень сильный монстр. Вы не боитесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100113,
					"content": "Наверное, родители беспокоятся за вас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100114,
					"content": "Не очень. Я сказал отцу, что мы с друзьями отправляемся на поиски Великого Мудзины Ёкая, а он даже ничего не ответил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100115
					],
					"speakerTitle": "Ивао"
				},
				{
					"id": 120100115,
					"content": "Поэтому мы думаем, что сейчас Великий Мудзина Ёкай очень слаб! И спрятался где-то, чтобы набраться сил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100116
					],
					"speakerTitle": "Мацудзака"
				},
				{
					"id": 120100116,
					"content": "Да! Если вернуться домой до того, как он снова станет сильным, с нами всё будет в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100117
					],
					"speakerTitle": "Сайка"
				},
				{
					"id": 120100117,
					"content": "Странная какая-то история... Но Паймон не может объяснить, что тут не так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100118,
						120100119,
						120100120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100118,
					"content": "От настоящего монстра дома не спрятаться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				},
				{
					"id": 120100121,
					"content": "Да... Паймон думает, что Великий Мудзина Ёкай - придуманный монстр, а на самом деле его не существует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100122,
						120100123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100122,
					"content": "Я тоже так думаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100124
					]
				},
				{
					"id": 120100124,
					"content": "Мы должны сказать им, чтобы не тратили впустую время на поиски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100125,
					"content": "Дети, послушайте тётю Паймон! Не нужно искать Великого Мудзину Ёкая, ясно? Потому что его не существует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100126,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100127
					],
					"speakerTitle": "Мацудзака"
				},
				{
					"id": 120100127,
					"content": "Не может быть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100128
					],
					"speakerTitle": "Сайка"
				},
				{
					"id": 120100128,
					"content": "Мой папа никогда не врёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100129
					],
					"speakerTitle": "Ивао"
				},
				{
					"id": 120100129,
					"content": "Ваши родители просто беспокоятся за вас, вот и всё. Они не хотят, чтобы вы уходили далеко от дома, потому что это очень опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100130,
					"content": "Нет! Мы тебе не верим! Великий Мудзина Ёкай настоящий!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100131
					],
					"speakerTitle": "Ивао"
				},
				{
					"id": 120100131,
					"content": "Да, тётя Ёимия даже сделала нам особое оружие. И покажет, как им пользоваться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100132
					],
					"speakerTitle": "Мацудзака"
				},
				{
					"id": 120100132,
					"content": "Ёимия? Та самая Ёимия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100133,
					"content": "Мы рассказали ей о Великом Мудзине Ёкае. Она говорит, что бояться тут нечего, наоборот, нам нужно научиться его прогонять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100134
					],
					"speakerTitle": "Сайка"
				},
				{
					"id": 120100134,
					"content": "Мы долго ждали, и наконец тётя Ёимия сказала, что сегодня тот самый день. Поэтому мы и вышли на поиски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100135
					],
					"speakerTitle": "Мацудзака"
				},
				{
					"id": 120100135,
					"content": "Да! Тётя Ёимия часто играет с нами и рассказывает разные истории. Она бы не стала нас обманывать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100136
					],
					"speakerTitle": "Ивао"
				},
				{
					"id": 120100136,
					"content": "Да, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100137,
					"content": "Пойдём найдём тётю Ёимию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100138
					],
					"speakerTitle": "Ивао"
				},
				{
					"id": 120100138,
					"content": "Стойте, куда вы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100139,
					"content": "Ну вот, обиделись... А Паймон хотела как лучше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100140,
					"content": "И какое отношение к этой истории имеет Ёимия? Пойдём за ними!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100123,
					"content": "Родители просто не хотят, чтобы дети целыми днями бегали неизвестно где.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100124
					]
				},
				{
					"id": 120100119,
					"content": "Мы никогда не видели такого монстра.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				},
				{
					"id": 120100120,
					"content": "Странно, что папа ничего не сказал...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				}
			]
		},
		{
			"id": 1201002,
			"completionStepIds": [
				1201002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201002",
							"2"
						],
						"stepId": 1201002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ёимия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100201,
					"content": "#Не унывайте, ребята. Путешественни{F#ца}{M#к} просто пошутил{F#а}. Великий Мудзина Ёкай настоящий, а как же иначе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100202
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100202,
					"content": "Да, но... Мы и правда никогда его не видели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100203
					],
					"speakerTitle": "Мацудзака"
				},
				{
					"id": 120100203,
					"content": "Просто у него есть сверхспособности. Именно поэтому мне нужна ваша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100204
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100204,
					"content": "Ага...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100205
					],
					"speakerTitle": "Мацудзака"
				},
				{
					"id": 120100205,
					"content": "Всё в порядке, не отчаивайтесь. Помните: настоящие герои должны быть мудрыми и терпеливыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100206
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100206,
					"content": "Даже если вы не найдёте Великого Мудзину Ёкая прямо сейчас, он обязательно появится перед началом фейерверка. Так что не забудьте забрать у меня оружие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100207
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100207,
					"content": "Особый фейерверк Ёимии способен отпугнуть любого монстра, даже самого сильного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100208
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100208,
					"content": "Так что защита дома, урожая и родителей ложится на ваши плечи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100209
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100209,
					"content": "Спасибо, тётя Ёимия, мы постараемся запастись терпением!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100210
					],
					"speakerTitle": "Мацудзака"
				},
				{
					"id": 120100210,
					"content": "Подождите секунду. У меня есть несколько листков бумаги для вас, ребята, по одному на каждого. Отдайте их родителям и скажите, чтобы они их берегли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100211
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100211,
					"content": "Просто скажите им, что это от Ёимии. Они поймут, о чём речь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100212
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100212,
					"content": "Хорошо! Спасибо, тётя Ёимия. Тогда мы пойдём домой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100213
					],
					"speakerTitle": "Ивао"
				},
				{
					"id": 120100213,
					"content": "Спасибо, тётя Ёимия. Приходи с нами поиграть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100214
					],
					"speakerTitle": "Сайка"
				},
				{
					"id": 120100214,
					"content": "Конечно, обязательно! Берегите себя и до встречи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100215
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100215,
					"content": "Так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100216,
						120100217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100216,
					"content": "Давно не виделись.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100218
					]
				},
				{
					"id": 120100218,
					"content": "Значит, это вы! По описаниям детей я так и поняла. Не переживайте, я вас не виню!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100219
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100219,
					"content": "Великий Мудзина Ёкай очень популярен среди детей. Конечно, они расстроятся, если кто-то скажет, что его не существует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100220
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100220,
					"content": "Но его ведь действительно не существует?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100221,
					"content": "Да, впервые услышав о нём, я сразу поняла: родители выдумали его, чтобы дети не убегали из дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100222
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100222,
					"content": "Но когда дети спросили, я решила не говорить правду. Просто сказала, что Великий Мудзина Ёкай - милый монстр, который любит проказничать, но не причиняет людям большого вреда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100223
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100223,
					"content": "Так что они верят в Великого Мудзину Ёкая, которого придумала я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100224
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100224,
					"content": "Значит, это плод твоего творчества...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100225,
					"content": "Но ведь нельзя продолжать врать детям!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100226
					]
				},
				{
					"id": 120100226,
					"content": "Не знаю. Как бы там ни было, я не собираюсь рассказывать им, что Великого Мудзины Ёкая не существует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100227
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100227,
					"content": "Может быть, родители не хотели, чтобы дети целыми днями пропадали на улице. А может, у них были и другие причины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100228
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100228,
					"content": "Если я, не зная всей истории, просто скажу детям, что Великого Мудзины Ёкая не существует, то принесу больше вреда, чем пользы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100229
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100229,
					"content": "Да и потом, они ведь дети. Дети должны верить в то, что делает их счастливыми, и сомнениям тут не место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100230
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100230,
					"content": "У меня тоже полно разных фантазий... Я верю в Огненный алмаз, который вращается и испускает огни всех цветов радуги... И в Духа тумана - он прячется далеко в горах и может показать путнику дорогу в волшебную страну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100231
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100231,
					"content": "Я знаю, что это выдумка, но мне нравится в неё верить. Если бы кто-то подошёл ко мне и сказал: «Брось выдумывать, на самом деле никаких духов нет...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100232
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100232,
					"content": "Я бы злобно на него посмотрела и велела поскорее убраться! Потому что это бесит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100233,
						120100235
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100233,
					"content": "Я понимаю, о чём ты говоришь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100234
					]
				},
				{
					"id": 120100234,
					"content": "Ну вот! Какая разница, выдумка это или нет? Главное, что фантазии дарят мне радость и волшебство. И никто не вправе меня их лишать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100237
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100237,
					"content": "Всё, во что мы верили и что пережили в детстве, становится нашим бесценным сокровищем, когда мы вырастаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100238
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100238,
					"content": "В детстве вы наверняка верили в героев, которые сражаются со злыми драконами, и в священные мечи, рассекающие тьму? Вот и здесь то же самое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100239
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100239,
					"content": "Если уничтожить магию сказок, что мы будем рассказывать детям вместо них? Про указ Сакоку? Про Охоту на Глаза Бога? Детям ещё рано думать о таком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100240
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100240,
					"content": "Хм... Да, ещё слишком рано!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100241,
						120100242
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100241,
					"content": "Из всего сказанного ты запомнила только последние слова, правда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100243
					]
				},
				{
					"id": 120100243,
					"content": "Ха-ха, неважно! Не волнуйтесь, я позабочусь о детях и прослежу, чтобы они были в безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100244
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100244,
					"content": "Так, мне пора возвращаться. Фестиваль фейерверков Наганохары скоро начнётся, а мне ещё нужно много всего подготовить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100245
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100245,
					"content": "Фестиваль фейерверков Наганохары? Их устраивает ваша семья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100246
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100246,
					"content": "Конечно, поэтому в названии наша фамилия... Фестиваль знают во всей Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100247
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100247,
					"content": "К слову о фейерверках, есть ли у вас планы на ближайшие дни? Если нет, вы обязательно должны прийти. Я подготовлю очень красивый фейерверк. Специально для вас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100248,
						120100249
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100248,
					"content": "Жду с нетерпением.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100250
					]
				},
				{
					"id": 120100250,
					"content": "Тогда пойдём со мной в Наганохару, навестим моего папу! Надо успеть доделать несколько фейерверков до начала представления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100249,
					"content": "Я с радостью!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100250
					]
				},
				{
					"id": 120100242,
					"content": "Не нужно изображать согласие, если ты ничего не поняла.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100243
					]
				},
				{
					"id": 120100235,
					"content": "Почему ты ведёшь себя так по-детски...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100236
					]
				},
				{
					"id": 120100236,
					"content": "Потому что не так уж важно, выдумка это или нет. Если фантазии дарят мне радость и волшебство, значит, в них стоит верить. И никто не вправе меня их лишать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100237
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100217,
					"content": "Вот мы и встретились вновь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100218
					]
				}
			]
		},
		{
			"id": 1201003,
			"completionStepIds": [
				1201003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201003",
							"2"
						],
						"stepId": 1201003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Наганохара Рюносукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100301,
					"content": "Папа, я вернулась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100302
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100302,
					"content": "Фестиваль скоро начнётся, и фейерверки для каждой семьи почти готовы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100303
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120100303,
					"content": "О, кажется, мы не знакомы. Вы наши новые друзья? Или покупатели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100304
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120100304,
					"content": "И то и другое. Они недавно прибыли в Инадзуму. Мы не можем позволить, чтобы они пропустили фестиваль фейерверков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100305
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100305,
					"content": "Ха-ха-ха, тогда проходите, присаживайтесь. Меня зовут Наганохара Рюносукэ, и я расскажу вам долгую историю семьи Наганохара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100306
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120100306,
					"content": "История пока подождёт. У меня к тебе есть вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100307
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100307,
					"content": "Давным-давно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100308
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120100308,
					"content": "Ох, опять папа со своими историями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100309
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100309,
					"content": "Извините за это. С тех пор как с папой произошёл несчастный случай, он стал плохо слышать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100310
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100310,
					"content": "Правда? Но Паймон показалось, что вы ведёте связный разговор...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100311,
					"content": "Много позже люди поняли, что если размолоть определённые минералы в пыль, то они загораются множеством красивых цветов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100312
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120100312,
					"content": "Папа, подожди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100313
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100313,
					"content": "А? Что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100314
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120100314,
					"content": "Те материалы для фейерверков, которые мы заказали, уже доставили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100315
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100315,
					"content": "Вчерашние фейерверки мы отправили по адресам, как и позавчерашние, и позапозавчерашние.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100316
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120100316,
					"content": "Нет, пап. Я про материалы. Материалы, которые мы заказывали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100317
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100317,
					"content": "Сегодняшние фейерверки тоже почти готовы. Не волнуйся, я не растерял свои навыки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100318
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120100318,
					"content": "Да нет же, я говорю о материалах! Чтобы сделать фейерверки, нам нужны материалы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100319
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100319,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100320
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120100320,
					"content": "Материалы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100321
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100321,
					"content": "А-а-а, материалы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100322
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120100322,
					"content": "Да-да-да! Материалы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100323,
					"content": "Извини... Паймон просто обрадовалась, что вы наконец поняли друг друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100324,
					"content": "Материалы ещё не привезли. Приходил курьер и объяснил причину задержки, но я не расслышал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100325
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120100325,
					"content": "Всё в порядке, не волнуйся. Тогда займёмся фейерверками позже. Не забудь получить материалы, когда их доставят, хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100326
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100326,
					"content": "Хорошо, не волнуйся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100327
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120100327,
					"content": "Прошу прощения за эти крики. Но если нужно о чём-то спросить папу, по-другому нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100328,
						120100330
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100328,
					"content": "Он производит впечатление гостеприимного хозяина.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100329
					]
				},
				{
					"id": 120100329,
					"content": "Да, так и есть. Он очень хороший человек, все его уважают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100332,
					"content": "Мой папа глуховат, поэтому никогда ни с кем не спорит и никому не перечит. Просто слушает с довольным лицом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100333
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100333,
					"content": "В детстве я думала, что папа по-настоящему меня понимает и потому во всём со мной соглашается. Я рассказывала ему обо всём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100334
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100334,
					"content": "Позже я узнала, что он просто плохо слышит. Но я всё равно продолжала рассказывать ему свои истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100335
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100335,
					"content": "Да? Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100336
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100336,
					"content": "Мне просто приятно видеть, как он улыбается. И он не чувствует себя одиноким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100337
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100337,
					"content": "Но вернёмся к делу. Фестиваль вот-вот начнётся, а материалы ещё не пришли. Нам нужно придумать альтернативу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100338
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100338,
					"content": "Ёимия, это ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100339
					],
					"speakerTitle": "Сакудзиро"
				},
				{
					"id": 120100339,
					"content": "А?! Ты меня до смерти напугал! Я ведь говорила тебе сидеть тихо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100340
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100340,
					"content": "П-прости...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100341
					],
					"speakerTitle": "Сакудзиро"
				},
				{
					"id": 120100341,
					"content": "Подожди, я сейчас подойду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100330,
					"content": "Мне кажется, вы очень похожи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100331
					]
				},
				{
					"id": 120100331,
					"content": "Да, мне часто об этом говорят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "Ёимия"
				}
			]
		},
		{
			"id": 1201004,
			"completionStepIds": [
				1201004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201004",
							"2"
						],
						"stepId": 1201004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100401,
					"content": "Здесь нас никто не увидит. Выходи тут, сбоку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100402
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100402,
					"content": "Хорошо, что рядом не было никого из комиссии Тэнрё! Иначе у нас были бы большие проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100403
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100403,
					"content": "Прости, я не подумал. Просто я услышал, что ты вернулась, и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100404
					],
					"speakerTitle": "Сакудзиро"
				},
				{
					"id": 120100404,
					"content": "Не волнуйся, Сакудзиро. Пока что всё идёт по плану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100405
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100405,
					"content": "Чуть позже мы пойдём за материалами для фейерверков, а заодно решим вопрос с лодкой, как я тебе и обещала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100406
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100406,
					"content": "Спасибо тебе за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100407,
						120100408
					],
					"speakerTitle": "Сакудзиро"
				},
				{
					"id": 120100407,
					"content": "А это?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100409
					]
				},
				{
					"id": 120100409,
					"content": "Это один из наших старых клиентов. Он не так давно вернулся в Инадзуму. Комиссия Тэнрё обнаружила его, когда он нелегально пересекал границу, и выписала ордер на его арест...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100410
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100410,
					"content": "Ордер на арест?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100411,
					"content": "Тише, тише! Нас могут услышать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100412
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100412,
					"content": "Если Сакудзиро поймают, неизвестно, в каких преступлениях его могут обвинить. Так что мы должны найти лодку, чтобы он мог выбраться из Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100413
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100413,
					"content": "Но в океане бушует шторм...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100414
					]
				},
				{
					"id": 120100414,
					"content": "Да, это очень опасно, но другого выхода нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100415
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100415,
					"content": "А если лодка перевернётся? Тонуть очень-очень страшно. Паймон знает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100416,
					"content": "Если риск так велик, зачем ты вообще вернулся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100417,
					"content": "У меня остались незаконченные дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100418
					],
					"speakerTitle": "Сакудзиро"
				},
				{
					"id": 120100418,
					"content": "Но после возвращения мне рассказали обо всех этих невероятных переменах. Изначально я принял решение, но теперь не знаю, как быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100419
					],
					"speakerTitle": "Сакудзиро"
				},
				{
					"id": 120100419,
					"content": "Не хочется доставлять неприятности Ёимии и господину Рюносукэ. Я очень признателен им за то, что они приютили меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100420
					],
					"speakerTitle": "Сакудзиро"
				},
				{
					"id": 120100420,
					"content": "Эй, хватит уже меня благодарить. Помнишь, что я сказала? Пока у тебя есть наш листок, ты всегда будешь клиентом дома Наганохара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100421
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100421,
					"content": "Листок?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100422,
						120100423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100422,
					"content": "Что-то такое припоминаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100424
					]
				},
				{
					"id": 120100424,
					"content": "Да, детям я раздала точно такие же листки. Каждый раз, когда клиент заказывает фейерверк для памятного события, мы прилагаем к товару маленький листок бумаги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100425
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100425,
					"content": "Только моя семья может понять, что на нём написано. Это формула заказанного фейерверка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100426
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100426,
					"content": "Если нам покажут этот листок, мы гарантируем, что сделаем точно такой же фейерверк. Даже спустя десять или сто лет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100427
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100427,
					"content": "Ух ты, это так круто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100428
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100428,
					"content": "Старая семейная традиция. Все постоянные клиенты знают о ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100429
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100429,
					"content": "Мой листок остался с тех времён, когда родители заказывали фейерверк у господина Рюносукэ. Представляете, это было почти двадцать лет назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100430
					],
					"speakerTitle": "Сакудзиро"
				},
				{
					"id": 120100430,
					"content": "Кто бы мог подумать, что всё так обернётся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100431
					],
					"speakerTitle": "Сакудзиро"
				},
				{
					"id": 120100431,
					"content": "Всё будет в порядке. Побег на лодке - это крайняя мера. Я постараюсь найти другой выход. Будет гораздо лучше, если ты останешься в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100432
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100432,
					"content": "Что бы ни случилось, если наши клиенты приходят за помощью, мы не бросим их на произвол судьбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100433
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100433,
					"content": "Спасибо! Так у меня будет немного времени, чтобы обдумать разные варианты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100434
					],
					"speakerTitle": "Сакудзиро"
				},
				{
					"id": 120100434,
					"content": "Хорошо, давай не будем долго задерживаться снаружи. Возвращайся в дом. Я дам знать, как только у меня появятся новости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100435
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100435,
					"content": "Спасибо! Ещё раз большое спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100436
					],
					"speakerTitle": "Сакудзиро"
				},
				{
					"id": 120100436,
					"content": "Так жаль, что ему не разрешают вернуться. А ведь он родился и вырос в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100437
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100437,
					"content": "Кстати, вы приехали сюда совсем недавно - как вам удалось получить разрешение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100438
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100438,
					"content": "Мы долго оформляли все формальности на острове Рито.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100439
					]
				},
				{
					"id": 120100439,
					"content": "И даже после этого нам удалось получить разрешение только благодаря госпоже Хийраги Тисато из комиссии Кандзё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100440
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120100440,
					"content": "Понятно, значит, вам помогали влиятельные люди. У Сакудзиро нет таких помощников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100441
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100441,
					"content": "Жаль, что комиссия совсем не готова идти на уступки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100442
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100442,
					"content": "Наверное, во всех остальных землях, где вы побывали, царят совсем другие порядки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100443,
						120100444
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100443,
					"content": "Так и есть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100445
					]
				},
				{
					"id": 120100445,
					"content": "Эх... Как бы там ни было, я должна найти способ ему помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100446
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100446,
					"content": "Простите, я пригласила вас полюбоваться фейерверком, но сначала мне нужно закончить несколько дел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100447
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100447,
					"content": "Вам необязательно идти со мной. Я сама найду материалы для фейерверков и лодку. Мы можем встретиться дома чуть позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100448,
						120100449
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100448,
					"content": "Я не против составить тебе компанию.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100450
					]
				},
				{
					"id": 120100450,
					"content": "Отлично! Тогда давай начнём с лодки для Сакудзиро. Можем поговорить по дороге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120100449,
					"content": "Хочется посмотреть, как делают фейерверки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100450
					]
				},
				{
					"id": 120100444,
					"content": "У каждого Архонта своё представление о том, как управлять своей землёй.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100445
					]
				},
				{
					"id": 120100423,
					"content": "Такие же листки ты раздала детям?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100424
					]
				},
				{
					"id": 120100408,
					"content": "Почему ты прячешься в доме Ёимии?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100409
					]
				}
			]
		},
		{
			"id": 1201005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201004",
							"2"
						],
						"stepId": 1201004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Наганохара Рюносукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100501,
					"content": "Не беспокойся обо мне, сначала закончи свои дела. А истории я могу рассказать и в другой раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100502
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120100502,
					"content": "У меня много времени и много историй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наганохара Рюносукэ"
				}
			]
		}
	]
}