			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сакуя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726580101,
					"content": "Здравствуйте! Хотите попробовать самостоятельно вырастить цветы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580102
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580102,
					"content": "Какие цветы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580103
					]
				},
				{
					"id": 726580103,
					"content": "Интересно, правда? Не волнуйтесь, если не всё поймёте с первого раза. Давайте я вам вкратце объясню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580104
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580104,
					"content": "Меня зовут Сакуя, я садовник. А ещё я торгую цветами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580105
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580105,
					"content": "Я называю это торговлей, но на самом деле чаще всего я просто подбираю цветы в подарок или делаю икебаны для других магазинов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580106
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580106,
					"content": "Что такое икебана?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580107
					]
				},
				{
					"id": 726580107,
					"content": "Разве вы не знаете? Икебана - очень важное искусство в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580108
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580108,
					"content": "Проще говоря, икебану можно рассматривать как процесс аккуратного подрезания и обработки цветов и растений перед тем, как скомпоновать их подходящим образом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580109
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580109,
					"content": "Однако следует внимательно следить за состоянием растений и обрезать только те части, которые выглядят менее презентабельно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580110
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580110,
					"content": "Кроме того, их сочетание и даже угол, под которым цветы устанавливают, должны соответствовать окружающей обстановке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580111
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580111,
					"content": "Эти детали должны быть тщательно продуманы, поэтому процесс может быть очень трудоёмким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580112
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580112,
					"content": "Даже для таких любителей икебаны, как я, это самая утомительная часть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580113
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580113,
					"content": "Раньше у меня был магазин в городе, на улице было слишком шумно, и я не могла сосредоточиться на работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580114
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580114,
					"content": "Поэтому я закрыла магазин и теперь принимаю клиентов рядом с моим цветочным полем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580115
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580115,
					"content": "Здесь тихое место, поэтому и торговля идёт не так бойко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580116
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580116,
					"content": "Именно поэтому я специально разработала рекламную стратегию для своего магазина «Цветы Сакуи».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580117
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580117,
					"content": "Я называю этот план «Цветущие мечты»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580118
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580118,
					"content": "В чём заключается план?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580119
					]
				},
				{
					"id": 726580119,
					"content": "Речь идёт о том, чтобы позволить клиентам самим выращивать цветы, а затем создавать свои уникальные цветочные композиции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580120
					],
					"speakerTitle": "Сакуя"
				},
				{
					"id": 726580120,
					"content": "Если вам интересно попробовать, просто дайте мне знать. Выращивание и компоновка цветов - это очень интересное занятие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сакуя"
				}
			]
		}
	]
}