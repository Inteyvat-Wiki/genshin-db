			"trigger": {
				"objectNames": [
					"Юэ Чуань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210260101,
					"content": "Почерк, которым написана записка, похож на детский.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260102
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260102,
					"content": "Малыш Мэн... Кто это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260103
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260103,
					"content": "Хм? Эта бутылка...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260104
					]
				},
				{
					"id": 210260104,
					"content": "#{NICKNAME}, судя по твоему тону, ты знаешь отправителя письма?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260105,
						210260106
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260105,
					"content": "Немного...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				},
				{
					"id": 210260107,
					"content": "Этот ребёнок много размышляет и хочет повзрослеть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260108
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260108,
					"content": "На мой взгляд, ему нужно путешествовать и открывать для себя новое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260109
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260109,
					"content": "Кстати, малыш Мэн говорил, что хотел бы отправиться куда-нибудь за пределы гавани Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210260110,
					"content": "Мы ведь его звали. Почему он не согласился?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210260111,
					"content": "Ха-ха, может, он немного своевольный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260112
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260112,
					"content": "Поскольку это его личные проблемы, то он хочет решать их сам, без помощи других людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260113
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260113,
					"content": "Малыш Мэн лишь бросил бутылку в реку. Его проблемы не решены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210260114,
					"content": "Ему нужна помощь надёжного взрослого человека.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260115
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260115,
					"content": "#Путешественни{F#ца}{M#к}, давай напишем письмо малышу Мэну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260116
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260116,
					"content": "Напишем, что интересного его ждёт в большом мире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260117
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260117,
					"content": "Но... я мало где был. Так что лучше, если ты решишь, о чём писать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260118,
						210260119,
						210260120
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260118,
					"content": "О башне, где постоянно бушуют ураганы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260121,
					"content": "Помедленнее, помедленнее. Я ещё не записал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260122
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260122,
					"content": "Ммм, здесь... надо написать так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260123
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260123,
					"content": "Закончил. Даже не думал, что напишу так много...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260124
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260124,
					"content": "Ха-ха-ха. Послушал тебя - и теперь меня тоже тянет путешествовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260125
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260125,
					"content": "Путешествовать здорово.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260126
					]
				},
				{
					"id": 210260126,
					"content": "Я уже в том возрасте, когда появляется слишком много дел. Невозможно путешествовать, когда вздумается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260127
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260127,
					"content": "Я засунул письмо в бутылку. Кинь её в реку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210260119,
					"content": "Об островах, окружённых бурями и штормами...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260120,
					"content": "Об ущелье, созданном ударом меча...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260106,
					"content": "Это мальчик из Ли Юэ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				}
			]
		},
