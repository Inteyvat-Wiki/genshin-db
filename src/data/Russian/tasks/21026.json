					"Юэ Чуань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210261001,
					"content": "Ну как? Бутылка уже в реке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261002
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210261002,
					"content": "Сможет ли Малыш Мэн её подобрать?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261003
					]
				},
				{
					"id": 210261003,
					"content": "Хм... Дело сложное. Вряд ли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261004
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210261004,
					"content": "Тогда всё напрасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210261005,
					"content": "Не беспокойся. Какой-нибудь взрослый может ему помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261006
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210261006,
					"content": "Слышали про Сумеру?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261007
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210261007,
					"content": "Мои друзья занимаются бизнесом. Планируют начать грибное дело. Хотят съездить туда, чтобы изучить рынок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261008
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210261008,
					"content": "Ха-ха, поехать в Сумеру, чтобы «изучить рынок», означает поехать туда, чтобы повеселиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261009
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210261009,
					"content": "Поскольку малыш Мэн хочет отправиться в путешествие, я свяжусь с друзьями и спрошу, могут ли они взять его с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261010
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210261010,
					"content": "Не переживайте. Я постараюсь договориться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261011
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210261011,
					"content": "Я переписал себе это письмо. Ему найдётся применение. Что касается бутылки... Будь что будет. Не думаю, что кто-то её подберёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261012,
						210261013
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210261012,
					"content": "Спасибо, что хочешь помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				},
				{
					"id": 210261014,
					"content": "Разве взрослые не помогают детям исполнять мечты? Не волнуйтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261015
					],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210261015,
					"content": "Да, нужно будет попросить моих знакомых одеться поприличнее, чтобы не напугать малыша Мэна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Юэ Чуань"
				},
				{
					"id": 210261013,
					"content": "Почему ты хочешь помочь Малышу Мэну?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				}
			]
		},
