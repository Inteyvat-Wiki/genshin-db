			"dialogs": [
				{
					"id": 207010101,
					"content": "Почему опять хочется есть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010102
					],
					"speakerTitle": "Зигфрия"
				},
				{
					"id": 207010102,
					"content": "О, это ты! Замечательно! Помнишь меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010103
					],
					"speakerTitle": "Зигфрия"
				},
				{
					"id": 207010103,
					"content": "Сян Лин, кулинарный поединок?.. Это я, Зигфрия!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010104
					],
					"speakerTitle": "Зигфрия"
				},
				{
					"id": 207010104,
					"content": "#Ха-ха, вспомнил{F#а}? Ты как раз вовремя! Могу я... Попросить тебя кое о чём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010105
					],
					"speakerTitle": "Зигфрия"
				},
				{
					"id": 207010105,
					"content": "Чем я могу помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207010106
					]
				},
				{
					"id": 207010106,
					"content": "#Помнишь, в прошлый раз ты делал{F#а} «Нефритовые мешочки»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010107
					],
					"speakerTitle": "Зигфрия"
				},
				{
					"id": 207010107,
					"content": "Я до сих пор помню их вкус. Они были прекрасны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010108
					],
					"speakerTitle": "Зигфрия"
				},
				{
					"id": 207010108,
					"content": "Поэтому я хотела попробовать сделать их сама, но... Такое чувство, что в них постоянно чего-то не хватает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010109
					],
					"speakerTitle": "Зигфрия"
				},
				{
					"id": 207010109,
					"content": "Я думаю, что если продегустирую ещё несколько раз, то смогу воссоздать тот вкус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010110
					],
					"speakerTitle": "Зигфрия"
				},
				{
					"id": 207010110,
					"content": "#Ты не мог{F#ла} бы снова сделать для меня несколько «Нефритовых мешочков» на пробу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зигфрия"
				}
			]
		},
