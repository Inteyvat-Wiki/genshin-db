					{
						"sceneId": 3,
						"position": [
							-418.421,
							281.227,
							2772.651
						],
						"pointId": 330201420
					}
				]
			},
			"dialogs": [
				{
					"id": 401020201,
					"content": "Давно не виделись! Могу я чем-то вам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020202
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401020202,
					"content": "Вы рассказываете Аараву всё, что узнали от Дэхьи и Кандакии.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401020203
					]
				},
				{
					"id": 401020203,
					"content": "Кто-то намеревается похитить Сачина? Нет слов... Но если подумать, это не так уж и странно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020204
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401020204,
					"content": "Популярность Фестиваля Академии растёт, а Сачин - главный спонсор события. Люди о нём наслышаны, многие считают его настоящим толстосумом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020205
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401020205,
					"content": "Если его задумали похитить, наверное, стоит выделить ему охрану?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020206,
					"content": "Честно говоря, мы об этом уже думали. Но Сачин посвящает много времени полевым исследованиям и почти не появляется в городе. Мы так и не смогли с ним связаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020207
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401020207,
					"content": "У нас есть только одна зацепка... Однажды он сказал: «Каждый год я буду следить за Турниром даршанов, чтобы выбрать достойного человека, который унаследует моё состояние».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020208
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401020208,
					"content": "Если Сачин остаётся верен своему слову, сейчас он где-то в городе. И Пустынники наверняка слышали о его обещании, потому и вышли в город на охоту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020209
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401020209,
					"content": "Получается, эти негодяи тоже не знают, где сейчас Сачин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020210,
					"content": "Скорее всего, так и есть. Господин Сайно сейчас в отпуске, так что этим делом займусь я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020211
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401020211,
					"content": "Не беспокойтесь. Шайка похитителей не представляет никакой опасности для города. Я знаю, как вывести их на чистую воду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020212
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401020212,
					"content": "Но если вас интересует вся эта история с Сачином... может, попробуете его разыскать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020213
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401020213,
					"content": "Чем раньше мы выясним, где он сейчас, тем быстрее обеспечим его безопасность. Матры и Бригада тридцати могут творить настоящие чудеса, но даже они не в силах защитить человека, который находится неизвестно где.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020214
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401020214,
					"content": "Ладно, попробуем его найти. Но с чего нам лучше начать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020215,
					"content": "Матры располагают какой-то информацией о Сачине?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020216
					]
				},
				{
					"id": 401020216,
					"content": "Нет. Сачин никогда не нарушал правил и законов Академии, так что у нас нет о нём никакой информации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020217
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401020217,
					"content": "Я слышал, господин аль-Хайтам ушёл в отставку с поста исполняющего обязанности великого мудреца и вернулся на должность секретаря. Может быть, стоит спросить у него?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020218
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401020218,
					"content": "Точно. Давай вернёмся на главную площадку и поговорим с аль-Хайтамом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
