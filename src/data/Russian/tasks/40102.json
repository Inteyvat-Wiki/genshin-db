				"points": []
			},
			"dialogs": [
				{
					"id": 401025001,
					"content": "Не думала, что они посмеют провернуть подобное во время Фестиваля. Видимо, богатство Сачина не даёт им покоя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025002
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 401025002,
					"content": "Что бы ты сделала, если бы у тебя вдруг появилась целая гора моры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025003
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 401025003,
					"content": "Не знаю. Никогда об этом не думала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025004
					],
					"speakerTitle": "Кандакия"
				},
				{
					"id": 401025004,
					"content": "Вот и подумай. Куда бы ты пустила такие средства?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025005
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 401025005,
					"content": "Гм... На покупку продуктов и поиск источников воды... Как-то так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кандакия"
				}
			]
		},
