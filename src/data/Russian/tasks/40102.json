					"content": "Сначала надо постучать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020402,
					"content": "(Тук-тук...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020403
					]
				},
				{
					"id": 401020403,
					"content": "Молчание. Наверное, дома никого нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020404,
					"content": "(Тук-тук...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020405
					]
				},
				{
					"id": 401020405,
					"content": "Эй, аль-Хайтам! Ты дома? Нам нужна твоя помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020406,
					"content": "Это вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020407
					],
					"speakerTitle": "Кавех"
				},
				{
					"id": 401020407,
					"content": "Кавех! Значит, ты дома!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020408,
					"content": "...Ладно, заходите. Я открою.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кавех"
				}
			]
		},
		{
			"id": 4010205,
			"completionStepIds": [
				4010205
			],
