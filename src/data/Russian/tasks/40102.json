							-387.838,
							244.751,
							2659.268
						],
						"pointId": 330201423
					}
				]
			},
			"dialogs": [
				{
					"id": 401020301,
					"content": "Фух... Нилу, привет! Ты не видела аль-Хайтама?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020302,
					"content": "Аль-Хайтама? А что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020303
					],
					"speakerTitle": "Нилу"
				},
				{
					"id": 401020303,
					"content": "Мы ищем информацию об одном человеке. Хотим попросить его заглянуть в архив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020304,
					"content": "Вот оно что... Извините, я не знаю, где он.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020305
					],
					"speakerTitle": "Нилу"
				},
				{
					"id": 401020305,
					"content": "После окончания раунда он всегда уходит с площадки первым. И ни перед кем не отчитывается, куда идёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020306
					],
					"speakerTitle": "Нилу"
				},
				{
					"id": 401020306,
					"content": "Ладно. Вообще-то он и в обычной жизни ведёт себя так же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020307,
					"content": "Дайте подумать... Если честно, мне показалось, его не особенно интересует Фестиваль Академии. Так что вряд ли вы найдёте его здесь поблизости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020308
					],
					"speakerTitle": "Нилу"
				},
				{
					"id": 401020308,
					"content": "К обязанностям приглашённого обозревателя он относится как к сверхурочной работе. Вы знаете, куда он обычно идёт после работы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020309,
						401020312
					],
					"speakerTitle": "Нилу"
				},
				{
					"id": 401020309,
					"content": "В таверну?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020310
					]
				},
				{
					"id": 401020310,
					"content": "Гм... Но впереди ещё третий раунд. Думаешь, он пошёл в таверну, не дожидаясь окончания турнира?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020311
					],
					"speakerTitle": "Нилу"
				},
				{
					"id": 401020311,
					"content": "Есть идея! А вдруг он просто пошёл домой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020314,
					"content": "Помнишь, аль-Хайтам живёт недалеко отсюда! Давай сходим к нему домой, вдруг он там!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020312,
					"content": "Домой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020313
					]
				},
				{
					"id": 401020313,
					"content": "Точно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
