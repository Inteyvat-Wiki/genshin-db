			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 401020101,
					"content": "#{NICKNAME}, тебя как будто что-то беспокоит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020102,
						401020103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020102,
					"content": "(Человек с седыми волосами, появившийся перед началом турнира...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				},
				{
					"id": 401020104,
					"content": "#{NICKNAME}, Паймон! Наконец мы вас нашли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020105
					],
					"speakerTitle": "Кандакия"
				},
				{
					"id": 401020105,
					"content": "«Наконец»? А что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020106,
					"content": "Вам не кажется, что в этом году с Фестивалем Академии что-то не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020107
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 401020107,
					"content": "Мы с Кандакией сейчас сидели в кафе и видели наёмников. Они явно прибыли в город по делу, но почему-то прикидываются туристами. Даже переоделись специально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020108
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 401020108,
					"content": "Но въевшийся в кожу запах крови выдаёт их нутро. Выглядят они очень подозрительно, наверняка выполняют какую-то грязную работу. Похищение или даже убийство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020109
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 401020109,
					"content": "Из обрывков разговоров мы поняли, что их цель - человек по имени Сачин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020110
					],
					"speakerTitle": "Кандакия"
				},
				{
					"id": 401020110,
					"content": "Сачин? Тот самый, о ком Карина рассказывала на церемонии открытия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020111,
					"content": "Сачин подарил Академии Диадему знания и обеспечил призовой фонд Турнира даршанов. Но сам он на празднике до сих пор не появился...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020112,
					"content": "Судя по всему, он очень богатый человек. Это многое объясняет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020113
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 401020113,
					"content": "В последнее время дела у Пустынников идут из рук вон плохо, многие наёмники берутся за «подработку»: охотятся на богатых и влиятельных людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020114
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 401020114,
					"content": "Как они говорят, один «выход» кормит тебя полгода. Получив богатый выкуп, они могут на какое-то время расслабиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020115
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 401020115,
					"content": "На Фестиваль в город Сумеру прибыло много туристов. И Пустынники решили, что смогут смешаться с толпой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020116
					],
					"speakerTitle": "Кандакия"
				},
				{
					"id": 401020116,
					"content": "Мы с Дэхьей хотели схватить их прямо там, но они нас заметили и скрылись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020117
					],
					"speakerTitle": "Кандакия"
				},
				{
					"id": 401020117,
					"content": "Не хочется устраивать в городе побоище. А так бы я их сразу повязала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020118
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 401020118,
					"content": "Кто должен решать такие проблемы по закону? Матры? Или Бригада тридцати?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020119
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 401020119,
					"content": "Гм... Если бы Сайно был тут, он не остался бы в стороне, это точно. Может, сходим в Академию и расскажем обо всём матрам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020120,
					"content": "Дэхья, Кандакия, спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020121,
					"content": "Да не за что! Мы случайно об этом узнали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020122
					],
					"speakerTitle": "Кандакия"
				},
				{
					"id": 401020122,
					"content": "Да, тут не за что благодарить. Если не помешать им, репутация Пустынников пострадает ещё больше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020123
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 401020123,
					"content": "Всё-таки это не пустыня, а город Сумеру, мы с Кандакией не должны вмешиваться в дела города. Так что поручаем это дело вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020124
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 401020124,
					"content": "А если понадобится помощь, мы будем в кафе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020125
					],
					"speakerTitle": "Кандакия"
				},
				{
					"id": 401020125,
					"content": "Тебя что-то явно беспокоит. Ты думаешь о Фестивале? Просто после разговора с Кандакией и Дэхьей Паймон тоже кажется, что с этим Фестивалем не всё ладно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020126,
					"content": "Гм... Но какой прок думать и гадать. Идём! Надо рассказать обо всём матрам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401020103,
					"content": "#(Секретный разговор, который я слышал{F#а} после первого раунда...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				}
			]
		},
		{
			"id": 4010202,
