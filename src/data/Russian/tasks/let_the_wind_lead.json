			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730201,
					"content": "А вы что здесь делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730202
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730202,
					"content": "Хотя, если честно, то я ожидал, что вы последуете за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730203
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730203,
					"content": "#Я хотел{F#а} бы узнать больше об Анемо Архонте.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730204
					]
				},
				{
					"id": 3730204,
					"content": "Ты имеешь в виду Барбатоса?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730205
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730205,
					"content": "Гео Архонт находится в Ли Юэ, а Электро Архонт всё ещё в Инадзуме. Но жители Мондштадта уже много лун не видели своего Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730206
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730206,
					"content": "Почему тебя интересует Анемо Архонт? Это как-то связано с Двалином?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730207
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730207,
					"content": "Ммм... Потому что Архонт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3730208,
					"content": "Мы знаем про прошлое дракона.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730209
					]
				},
				{
					"id": 3730209,
					"content": "О, да? И как же сейчас все относятся к Ужасу Бури? Очень интересно послушать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730210
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730210,
					"content": "Нам некуда спешить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730211
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730211,
					"content": "Я очень давно здесь не был. Похоже, что всё идёт не так гладко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		},
		{
			"id": 37304,
			"completionStepIds": [
				37304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37304",
							"2"
						],
						"stepId": 37304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730401,
					"content": "Видимо, изменения затронули не только дракона...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730402
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730402,
					"content": "#Ты сказал{F#а}, что вы знаете о прошлом дракона...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730405,
					"content": "Значит, так это видит Лиза, библиотекарь из Мондштадта... Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730406
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730406,
					"content": "В принципе, всё верно. Тем временем, обе стороны готовы применить силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730407
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730407,
					"content": "Однако его ненависть не проистекает из того, что люди перестали делать подношения Хранителям четырёх ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730408
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730408,
					"content": "Дракон не всегда был таким. Он страдает от тяжёлого проклятья...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730409
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730409,
					"content": "Какого проклятья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3730410,
					"content": "Заражённая кровь течёт по его венам. Она не даёт ему покоя уже долгие годы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730411
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730412,
					"content": "Маг Бездны. Кто это?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730413
					]
				},
				{
					"id": 3730414,
					"content": "#Кажется, я что-то слышал{F#а} о них в Мондштадте.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730415
					]
				},
				{
					"id": 3730411,
					"content": "Это позволило магу Бездны затуманить его рассудок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730412,
						3730414
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730413,
					"content": "Маги из ордена Бездны. Чудовища, которым ненавистно всё человеческое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730415,
					"content": "Может быть. Маги из ордена Бездны известны своими злодеяниями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730416,
					"content": "Я не знаю откуда они берутся, но одно можно сказать наверняка. Их ненависть к человечеству не знает границ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730417
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730417,
					"content": "Маги Бездны часто контролируют разум хиличурлов и используют их в качестве оружия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730418
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730418,
					"content": "До того, как я пришёл сюда, я страдал от проклятья, так же, как и Двалин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730419
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730419,
					"content": "А вот и Древо истоков. Здесь начался Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730420
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730420,
					"content": "Ты только послушай, как ветер колышет листву. Как же мне нравится здешний запах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730421
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730421,
					"content": "#Я чувствую себя так же, как когда ты очищал{F#а} слезу Двалина. Яд покидает моё тело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730422
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730423,
					"content": "О, да... Так намного лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730424
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730424,
					"content": "А как получилось, что ты тоже отравился?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730425
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3730425,
					"content": "Я пытался установить с Двалином контакт, но... Нам помешали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730426
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730427,
					"content": "Ох...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730428,
					"content": "Это мы вам помешали?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730426,
					"content": "Я собирался исцелить его, но вместо этого заразился сам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730427,
						3730428
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730429,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730430
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730431,
					"content": "#И теперь, чтобы загладить свою вину, {NICKNAME}, ты пойдёшь со мной в собор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730432
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3730432,
					"content": "Собор? Но зачем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730433
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3730433,
					"content": "За Небесной лирой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		}
	]
}