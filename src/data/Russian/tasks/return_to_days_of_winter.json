					"Виктор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290701,
					"content": "#Ну как? {M#Нашёл}{F#Нашла} подарок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290702
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290702,
					"content": "Ага.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290703
					]
				},
				{
					"id": 200290703,
					"content": "А ты дельный человек. Дай-ка взглянуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290704
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290704,
					"content": "Что... это?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290705
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290705,
					"content": "Какая-то кривая кукла, и выкрашена непонятно чем... но пахнет неплохо, это да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290706
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290706,
					"content": "Слушай, разве можно дарить такое детям?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290707,
						200290708
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290707,
					"content": "Это порекомендовала Марджори.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290710
					]
				},
				{
					"id": 200290710,
					"content": "Ладно, эта кукла тоже сойдёт. Так, куда бы вложить письмо... Ага, вот сюда снизу положу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290711,
						200290712
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290711,
					"content": "Ты Лили даже письмо написал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290713,
					"content": "Так, ерунда всякая. Оно тебе не надо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290714
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290714,
					"content": "Пожалуйста, возьми этот подарок и передай его Лили. Она должна быть <color=#00E1FFFF>где-то в районе площади</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290715
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290715,
					"content": "Хе, как бы вытаращился на меня Рудольф, если бы я вручил Лили подарок лично...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290712,
					"content": "Что в письме?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290708,
					"content": "Тогда пришли в подарок что-нибудь из Снежной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290709
					]
				},
				{
					"id": 200290709,
					"content": "Я так и хотел поступить, но, полагаю, посылки от Фатуи в Мондштадте сразу же арестует Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290710
					],
					"speakerTitle": "Виктор"
				}
			]
		},
