			},
			"dialogs": [
				{
					"id": 200290601,
					"content": "#Путешественни{F#ца}{M#к}, ты {F#нашла}{M#нашёл} Шустера?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290602
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290602,
					"content": "Конечно. Он велел передать эти волчьи крюки тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290603
					]
				},
				{
					"id": 200290603,
					"content": "О, спасибо большое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290604
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290604,
					"content": "А когда Шустер вернётся, я заплачу ему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290605
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290605,
					"content": "#Ах да, ты ведь {F#искала}{M#искал} подарок для ребёнка. Секундочку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290606
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290606,
					"content": "Марджори начала делать подарок...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200290607
					]
				},
				{
					"id": 200290607,
					"content": "#Готово! Вот, это тебе. Спасибо, что {F#принесла}{M#принёс} волчьи крюки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290608
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290608,
					"content": "Такая кукла с приятным ароматом обязательно понравится детям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марджори"
				}
			]
		},
		{
			"id": 2002907,
