			},
			"dialogs": [
				{
					"id": 200291701,
					"content": "Пожалуйста, передай этот подарок Лили. Она должна быть <color=#00E1FFFF>где-то в районе площади</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200291702
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200291702,
					"content": "Как бы вытаращился на меня Рудольф, если бы я вручил Лили подарок лично...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				}
			]
		},
		{
