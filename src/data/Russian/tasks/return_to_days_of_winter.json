			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Марджори"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290201,
					"content": "#Здравствуй, путешественни{F#ца}{M#к}! Что я могу сделать для тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290202
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290202,
					"content": "У тебя есть подарки для детей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290203
					]
				},
				{
					"id": 200290203,
					"content": "Для детей?.. Минуточку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290204
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290204,
					"content": "Хм... Вообще-то недавно я пробовала мастерить детские игрушки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290205
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290205,
					"content": "Вот только на игрушки эти уходит много краски из волчих крюков, а они у меня закончились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290206
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290206,
					"content": "Я попросила Шустера принести мне их, но он до сих пор не вернулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290207
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290207,
					"content": "#Путешественни{F#ца}{M#к}, отыщешь для меня Шустера?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290208
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290208,
					"content": "Когда волчьих крюков будет достаточно, я сделаю для тебя такую игрушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290209,
						200290210
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290209,
					"content": "Я займусь этим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				},
				{
					"id": 200290211,
					"content": "Он сказал, что будет собирать волчьи крюки рядом с <color=#00E1FFFF>Вольфендомом</color>. Можешь посмотреть там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290212
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290212,
					"content": "#Я рассчитываю на твою помощь, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200290210,
					"content": "Куда ушёл Шустер?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				}
			]
		},
		{
