			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Виктор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290401,
					"content": "#Ты уже {F#достала}{M#достал} подарок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290402,
						200290406,
						200290409,
						200290412
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290402,
					"content": "Что ты будешь делать, когда вернёшься домой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290403
					]
				},
				{
					"id": 200290403,
					"content": "Что я буду делать? Ну... буду ждать приказа о переводе, конечно же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290404
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290404,
					"content": "Эх, если не повезёт, меня опять забросят в какую-нибудь Архонтами забытую дыру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290405
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290405,
					"content": "Но я согласен на что угодно кроме Инадзумы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290406,
					"content": "Почему тебя вдруг решили перевести?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290407
					]
				},
				{
					"id": 200290407,
					"content": "Разве это не очевидно? Всё из-за госпожи Синьоры... ну... её жертвы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290408
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290408,
					"content": "А вообще моё дело маленькое. Я исполняю приказы и много думать мне ни к чему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290409,
					"content": "Где Лили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290410
					]
				},
				{
					"id": 200290410,
					"content": "Я слышал, что Рудольф собирался отвести её погулять на площадь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290411
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290411,
					"content": "Хе, наверное, не хочет, чтобы его доченька водилась со злым Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				},
				{
					"id": 200290412,
					"content": "До скорого.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290413
					]
				},
				{
					"id": 200290413,
					"content": "Ладно. Спасибо, что помогаешь с подарком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				}
			]
		},
		{
			"id": 2002905,
			"completionStepIds": [
				2002905
			],
