				"points": []
			},
			"dialogs": [
				{
					"id": 200290501,
					"content": "#С-спасибо тебе, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290502
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 200290502,
					"content": "Эти чудовища не прекратили преследовать меня даже после того, как я добежал досюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290503
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 200290503,
					"content": "Ты пришёл собирать волчьи крюки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290504
					]
				},
				{
					"id": 200290504,
					"content": "Хм? Да, меня об этом попросила Марджори...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290505,
						200290507
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 200290505,
					"content": "Почему ты пошёл один?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290506
					]
				},
				{
					"id": 200290506,
					"content": "Да ладно, кто пойдёт вместе со мной выполнять такое простое поручение, как сбор растений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290508
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 200290508,
					"content": "#Да, ты прав{F#а}, я и сам понимаю. Но волчьи крюки есть только в Вольфендоме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290509
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 200290509,
					"content": "К тому же в местах, что побезопаснее, все волчьи крюки уже сорвали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290510
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 200290510,
					"content": "Мне ничего не оставалось, как пройти вглубь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290511
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 200290511,
					"content": "#Впрочем, не будем об этом. Ты не {F#могла}{M#мог} бы передать эти волчьи крюки Марджори?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290512
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 200290512,
					"content": "Мне нужно передохнуть. Меня эта беготня здорово вымотала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 200290507,
					"content": "Не стоит заходить так далеко в одиночку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290508
					]
				}
			]
		},
