			"dialogs": [
				{
					"id": 200290801,
					"content": "Лили, не разговаривай с этим дядей Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290802
					],
					"speakerTitle": "Рудольф"
				},
				{
					"id": 200290802,
					"content": "Почему? Мы с дядей Фатуи рассказали друг другу столько разных историй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290803
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 200290803,
					"content": "Лили, это тебе подарок от Виктора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290804
					]
				},
				{
					"id": 200290804,
					"content": "Ух ты, подарок от дяди Фатуи! Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290805
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 200290805,
					"content": "Постой. Зачем Фатуи дарить что-то Лили? Что это он задумал?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290806
					],
					"speakerTitle": "Рудольф"
				},
				{
					"id": 200290806,
					"content": "Затем, что я... приглашала его поесть! Потому он и дарит мне подарок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290807
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 200290807,
					"content": "Лили, дядя Фатуи - нехороший человек...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290808
					],
					"speakerTitle": "Рудольф"
				},
				{
					"id": 200290808,
					"content": "Но он рассказывал мне истории! Он хороший!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290809,
						200290810
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 200290809,
					"content": "Это прощальный подарок Виктора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				},
				{
					"id": 200290811,
					"content": "Ах... Почему дядя Фатуи уезжает?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290812
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 200290812,
					"content": "Ух... Ладно. Хорошо, что он уезжает. Не нравится мне, что Лили каждый день разговаривает с ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290813
					],
					"speakerTitle": "Рудольф"
				},
				{
					"id": 200290813,
					"content": "Папа, я хочу попрощаться с дяденькой Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290814
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 200290814,
					"content": "Ох... Лили, лучше держись от него подальше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290815
					],
					"speakerTitle": "Рудольф"
				},
				{
					"id": 200290815,
					"content": "Но почему? Этот Фатуи... он добр ко мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290816
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 200290816,
					"content": "Он рассказывает мне истории. Много историй! Он правда хороший!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290817
					],
					"speakerTitle": "Лили"
				},
				{
					"id": 200290817,
					"content": "Лучше слушай папу... Не всё так просто. Подрастёшь, и я всё тебе расскажу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рудольф"
				},
				{
					"id": 200290810,
					"content": "Виктор скоро покинет Мондштадт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				}
			]
		},
