					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "«...Я с самого начала опасался, что там будут монстры, но...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "Чьи-то записи"
				},
				{
					"id": 711050502,
					"content": "«...так много... рана на ноге...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "Чьи-то записи"
				},
				{
					"id": 711050503,
					"content": "«...клонит в сон... Но гора Сюаньлянь совсем близко... Сян Цзюнь... Я принесу священную воду...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "Чьи-то записи"
				},
				{
					"id": 711050504,
					"content": "«Сян Цзюнь... Я принесу священную воду...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050505
					],
					"speakerTitle": "Чьи-то записи"
				},
				{
					"id": 711050505,
					"content": "Ох, нет... На него напали монстры! Он тяжело ранен. И неужели в таком состоянии он собирается продолжать путь к горе Сюаньлянь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050506,
					"content": "Давай поспешим! Паймон надеется, мы успеем ему помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
