			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "«Я проспал! Надо вернуться домой до завтра, иначе кто позаботится о Сян Цзюнь... Какой же я дурень!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "Чьи-то записи"
				},
				{
					"id": 711050202,
					"content": "«Если я правильно помню, здесь должен быть короткий путь. Тропинка, которая соединяет долину Яоде с горой Сюаньлянь... Потом останется только пройти через пещеру, и я буду на месте...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "Чьи-то записи"
				},
				{
					"id": 711050203,
					"content": "«Я слышал, там водятся монстры. Но ничего не остаётся, придётся идти коротким путём...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "Чьи-то записи"
				},
				{
					"id": 711050204,
					"content": "Наверное, эти записки оставил дедушка Сян Цзюнь? Значит, он пошёл по тропинке! Давай пойдём за ним!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110505",
							"2"
						],
						"stepId": 7110505,
