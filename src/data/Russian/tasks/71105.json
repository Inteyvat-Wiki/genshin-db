			"dialogs": [
				{
					"id": 711050101,
					"content": "Дедушка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050102
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050102,
					"content": "М? Привет, малышка! Ты что здесь делаешь одна так поздно? Как тебя зовут?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050103,
					"content": "Меня зовут Сян Цзюнь... Я ищу дедушку, его похитили демоны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050104
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050104,
					"content": "Демоны? Здесь водятся демоны? Какие демоны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050105,
					"content": "Я... я и сама не знаю. Дедушка говорил, что мне нельзя ходить одной по горам, потому что тут полно демонов... Но он ушёл в горы три дня назад и до сих пор не вернулся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050106
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050106,
					"content": "Наверное, он просто хотел тебя запугать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050107
					]
				},
				{
					"id": 711050107,
					"content": "Паймон тоже так думает... А он сказал, зачем ему понадобилось идти в горы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050108,
					"content": "Дедушка собирает в горах целебные травы. Недавно он принёс из гор чудесные травы, их нужно поливать священной водой, которую дедушка набирает у горы Сюаньлянь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050109
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050109,
					"content": "И я думаю... Вдруг его похитили демоны, которые охраняют священную воду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050110
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050110,
					"content": "Не волнуйся, Сян Цзюнь. Возможно, твоего дедушку задержало в горах что-то другое. Но уже поздно, давай мы отведём тебя домой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050111,
					"content": "Но я должна его спасти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050112
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050112,
					"content": "Мы тебе поможем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050113
					]
				},
				{
					"id": 711050113,
					"content": "Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050114
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050114,
					"content": "Да! Но если ты сейчас не вернёшься домой, очень может быть, что неприятностей у твоего дедушки только прибавится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050115,
					"content": "Мне бы этого не хотелось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050116
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050116,
					"content": "Тогда давай ты будешь ждать дома, а мы отправимся на поиски! Мы проводим тебя домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050117,
					"content": "Не надо! Я живу в деревне Цяоин, здесь близко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050118
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050118,
					"content": "Но... Вы сможете прямо сейчас отправиться на поиски? Я очень волнуюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050119
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050119,
					"content": "Конечно, без проблем. А ты знаешь, куда именно он направился?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050120,
					"content": "Я знаю только, что он пошёл в ту сторону...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050121
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050121,
					"content": "Тогда начнём поиски оттуда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050122
					]
				},
				{
					"id": 711050122,
					"content": "Спасибо вам! Тогда я иду домой, не хочу добавлять вам хлопот... Буду сидеть дома и ждать хороших новостей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7110502,
			"completionStepIds": [
				7110502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
