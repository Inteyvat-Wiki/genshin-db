			},
			"dialogs": [
				{
					"id": 711050601,
					"content": "Хм, мы на месте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050602,
					"content": "Но почему здесь никого нет? И никаких следов поблизости...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050603,
					"content": "Вдруг он уже вернулся домой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050604
					]
				},
				{
					"id": 711050604,
					"content": "Это вряд ли. Дедушка Сян Цзюнь ранен, далеко он уйти не мог.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050605,
					"content": "Но нигде поблизости его нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050606
					]
				},
				{
					"id": 711050606,
					"content": "А если его спас какой-нибудь прохожий? Такое вполне могло случиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050607,
					"content": "Может, вернёмся в деревню Цяоин и спросим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050608,
					"content": "Давай сначала наберём немного «священной воды».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050609
					]
				},
				{
					"id": 711050609,
					"content": "Священной воды? Давай. Даже если дедушку Сян Цзюнь уже спасли, вода ему наверняка понадобится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050610,
					"content": "#И поможем заодно! {NICKNAME}, ты {M#такой предупредительный}{F#такая предупредительная}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7110508,
			"completionStepIds": [
				7110508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110508",
							"2"
						],
						"stepId": 7110508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дядюшка Ло"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050801,
					"content": "#Это же наши {M#путешественники}{F#путешественницы}! Куда так спешите? Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050802
					],
					"speakerTitle": "Дядюшка Ло"
				},
				{
					"id": 711050802,
					"content": "Мы... Дядюшка Ло, ты знаешь, где живут Сян Цзюнь с дедушкой? Они нам нужны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050803,
					"content": "Сян Цзюнь? Впервые слышу. Она из нашей деревни? Всех деревенских стариков я знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050804
					],
					"speakerTitle": "Дядюшка Ло"
				},
				{
					"id": 711050804,
					"content": "Впервые слышишь? Как же так... Мы встретили в горах маленькую девочку, она сказала, что её зовут Сян Цзюнь, что она живёт в деревне Цяоин. Она попросила нас помочь отыскать её дедушку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050805,
					"content": "И у неё есть большой бамбуковый плот!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050806,
					"content": "Бамбуковых плотов тут полно, а вот девочка по имени Сян Цзюнь... Нет, у нас в деревне такой нет, я уверен. А как зовут её дедушку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050807
					],
					"speakerTitle": "Дядюшка Ло"
				},
				{
					"id": 711050807,
					"content": "Её дедушка собирает целебные травы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050808
					]
				},
				{
					"id": 711050808,
					"content": "Целебные травы? Дай-ка подумать... Да, раньше в деревне жил один травник... Но его уже три года как нет с нами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050809
					],
					"speakerTitle": "Дядюшка Ло"
				},
				{
					"id": 711050809,
					"content": "Он умер?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050810,
					"content": "Напоролся в горах на монстров... Эх... но я не думаю, что это тот человек, которого вы ищете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050811
					],
					"speakerTitle": "Дядюшка Ло"
				},
				{
					"id": 711050811,
					"content": "Он всегда был чудаком, семьёй не обзавёлся, поэтому ни детей, ни внуков у него не осталось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050812
					],
					"speakerTitle": "Дядюшка Ло"
				},
				{
					"id": 711050812,
					"content": "Подождите... Как же так? Значит, Сян Цзюнь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050813
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050813,
					"content": "Она что, сама была демоном?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050814
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050814,
					"content": "А что за травы он собирал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050815
					]
				},
				{
					"id": 711050815,
					"content": "Разные редкие растения. Я только в чае разбираюсь, а в травах ничего не смыслю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050816
					],
					"speakerTitle": "Дядюшка Ло"
				},
				{
					"id": 711050816,
					"content": "Но я помню, что мы нашли его у горы Сюаньлянь. В его руке была зажата бутылка с водой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050817
					],
					"speakerTitle": "Дядюшка Ло"
				},
				{
					"id": 711050817,
					"content": "Он говорил, что у него в саду есть какие-то чудесные травы, которые растут, только если поливать их священной водой. Думаю, он совсем спятил, это ведь просто речная вода, что в ней такого особенного? И он ради неё погиб...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050818
					],
					"speakerTitle": "Дядюшка Ло"
				},
				{
					"id": 711050818,
					"content": "Эх... Но воля покойного - закон. После похорон мы взяли воду, которую он собрал, и полили растения в его саду. Надеюсь, он покоится с миром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050819
					],
					"speakerTitle": "Дядюшка Ло"
				},
				{
					"id": 711050819,
					"content": "Священная вода, которую он брал у горы Сюаньлянь? Мы тоже набрали там воды... Этот травник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050820
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711050820,
					"content": "Я думаю, это он.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050821
					]
				},
				{
					"id": 711050821,
					"content": "Какое странное совпадение. Тогда... идите за мной, я отведу вас в его сад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050822
					],
					"speakerTitle": "Дядюшка Ло"
				},
				{
					"id": 711050822,
					"content": "Если вы тоже набрали воды, думаю, можете полить растения в его саду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дядюшка Ло"
				}
			]
		},
