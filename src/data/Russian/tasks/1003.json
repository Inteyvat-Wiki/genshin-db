					"nextDialogs": [
						10031713
					]
				},
				{
					"id": 10031713,
					"content": "Адепты не откажутся от своих обязанностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031714
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 10031714,
					"content": "Я не хочу вмешиваться в жизни смертных, но долг есть долг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031715
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 10031715,
					"content": "В конце концов, наш Архонт - бог контрактов.",
