						],
						"stepId": 100306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Улыбчивый Янь Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10030601,
					"content": "Не видите, что ли, у меня перекур? Идите играть в другом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030602
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 10030602,
					"content": "Простите за беспокойство. Мы бы хотели заказать миндальный...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030603
					]
				},
				{
					"id": 10030603,
					"content": "Пе-ре-кур.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030604
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 10030604,
					"content": "Да уж... Этот шеф-повар такой же дружелюбный, как кузнец Вагнер в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10030605,
					"content": "Этот заказ для вашей хозяйки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030606
					]
				},
				{
					"id": 10030606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030607
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 10030607,
					"content": "Для хозяйки, говоришь? Ну что ж... Значит, пора браться за работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030608
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 10030608,
					"content": "Я бы с удовольствием приготовил вам миндальный тофу, но, видите ли, есть небольшая проблема.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030609
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 10030609,
					"content": "Какая?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10030610,
					"content": "Когда орудуешь ножом, рука повара должна быть так же тверда, как и рука мечника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030611
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 10030611,
					"content": "А мои руки сейчас... Охватила дрожь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030612
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 10030612,
					"content": "Потому что... Потому что постояльцы рассказывают, что на этом постоялом дворе водится... Привидение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030613
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 10030613,
					"content": "И вот... Только что... Я увидел на кухне что-то странное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030614
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 10030614,
