					"Верр Голдет"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10039401,
					"content": "Кто вы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039402
					]
				},
				{
					"id": 10039402,
					"content": "Меня зовут Верр Голдет. Я из Мондштадта, и это моя гостиница.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039403
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 10039403,
					"content": "Не думай, что я просто «жена владельца».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039404
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 10039404,
					"content": "Я тут хозяйка, запомни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039405,
						10039410
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 10039405,
					"content": "Ходят слухи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039406
					]
				},
				{
					"id": 10039406,
					"content": "Ха-ха! Вряд ли бы у нас получилось открыть гостиницу в таком месте без связей в Цисин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039407
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 10039407,
					"content": "Я имею в виду, без разрешения Цисин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039408
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 10039408,
					"content": "Остальные слухи - просто слухи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039409
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 10039409,
					"content": "Кстати, может быть, и ты расскажешь мне что-нибудь интересное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 10039410,
					"content": "Чья это кошка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039411
					]
				},
				{
					"id": 10039411,
					"content": "Эх... Ничья, сама пришла сюда... Мы её оставили себе, потому что она такая милая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039412
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 10039412,
					"content": "Как зовут? Ванилька. Первое, что в голову пришло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039413
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 10039413,
					"content": "Иногда она шалит и доставляет неприятности постояльцам. Не будь как Ванилька. Веди себя хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верр Голдет"
				}
			]
		},
