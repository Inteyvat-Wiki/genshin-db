			"dialogs": [
				{
					"id": 10039301,
					"content": "Расскажите о своём муже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039302
					]
				},
				{
					"id": 10039302,
					"content": "Он работает здесь управляющим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039303
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 10039303,
					"content": "Не дай его дружелюбной мордашке себя обмануть. На самом деле, он первоклассный боец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039304
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 10039304,
					"content": "Я сама увлекаюсь боевыми искусствами. И наш повар тоже. Это обязательное условие для работы здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039305
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 10039305,
					"content": "Чтобы обслуживать гостей, надо уметь работать руками и ногами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верр Голдет"
				}
			]
		},
		{
			"id": 100394,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
