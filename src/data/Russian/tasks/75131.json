			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310301,
					"content": "Биологический... огненный... дождь?! То есть огонь будет литься на наши головы как живой? Почему вулканы Натлана такие страшные!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751310302,
					"content": "#{NICKNAME}, Паймон немного любопытно. Хе-хе, почему бы нам не исследовать, что там впереди?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7513104,
			"completionStepIds": [
				7513102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513102",
							"2"
						],
						"stepId": 7513102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
