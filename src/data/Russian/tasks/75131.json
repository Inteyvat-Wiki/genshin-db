				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310401,
					"content": "Гм, пламя, движущееся как живое, странные призраки, автоматические фотокамеры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751310402,
					"content": "Чутьё подсказывает, что здесь кроется какая-то необъяснимая тайна! И наверняка в деле как-то замешаны сокровища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751310403,
					"content": "Паймон, что ты увидела?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310404
					]
				},
				{
					"id": 751310404,
					"content": "Честно говоря... Паймон понятия не имеет! Но... если хозяин камеры оставил её здесь, наверное, он хотел заснять происходящее во время колебаний земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751310405,
					"content": "Значит, нам нужно поставить фотокамеру на место и подождать, когда земля начнёт колебаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751310406,
					"content": "Хе-хе! И тогда путеводная нить, которая приведёт нас к сокровищу, появится прямо перед нами, как этот призрак!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7513106,
