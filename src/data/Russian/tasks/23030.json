					"Фарез"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300201,
					"content": "Ого! Смотрите, в этом ящике уже лежат снадобья. Значит, Ясмин уже была здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300202
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300202,
					"content": "Хм, но крышку ещё никто не открывал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300203
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300203,
					"content": "Не открывай крышку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300204
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300204,
					"content": "Ой! Обернитесь, там появилось много плесенников!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230300205,
					"content": "Что? Но раньше их не было! Что здесь происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300206
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300206,
					"content": "#Не слушай их нытьё, {NICKNAME}. Пойдём скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 2303004,
			"completionStepIds": [
				2303004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303004",
							"2"
						],
						"stepId": 2303004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ладеп",
					"Фарез"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300401,
					"content": "К счастью, кувшин в ящике не разбился, иначе нас бы сильно тошнило...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300402
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300402,
					"content": "Разве ты не привык к этому запаху? Ты же сам его сделал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300403
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300403,
					"content": "Сколько раз я тебе объяснял, что добавил туда рвотное средство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300404
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300404,
					"content": "Неважно, привык ты к этому запаху или нет, почувствуешь его, и тебя сразу начнёт тошнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300405
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300405,
					"content": "И зачем я это повторяю, ты же совершенно не понимаешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300406
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300406,
					"content": "А куда делась Ясмин? Она даже не распылила снадобье...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300407
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300407,
					"content": "Должно быть, она снова нашла какое-то редкое растение и пошла собирать образцы. Это типичное поведение студентки Амурты, разве ты не знаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300408
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300408,
					"content": "#Хорошо, мы заберём кувшин со снадобьем. Спасибо за помощь, путешественни{F#ца}{M#к}, пожалуйста, возьми это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300409
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300409,
					"content": "Эти студенты из Амурты... в самом деле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фарез"
				}
			]
		},
		{
			"id": 2303005,
			"completionStepIds": [
				2303005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303005",
							"2"
						],
						"stepId": 2303005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ладеп",
					"Фарез",
					"Ясмин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300501,
					"content": "Кхе-кхе, кхе-кхе... Это подходящее место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300502
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300502,
					"content": "У-у-у... Тьфу... Ты... Это всё твоих рук дело! Неужели тебя тоже тошнит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300503
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300503,
					"content": "Фу... кхе... кхе-кхе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300504
					]
				},
				{
					"id": 230300504,
					"content": "С-сколько раз я т-тебе объяснял, что добавил рвотное средство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300505
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300505,
					"content": "Неважно, привык ты к этому запаху или нет, почувствуешь его, и тебя сразу начнёт тошнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300506
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300506,
					"content": "И зачем я это повторяю, ты же совершенно не понимаешь... тьфу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300507
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300507,
					"content": "#А? Ладеп, Фарез и путешественни{F#ца}{M#к}? Что вы здесь делаете?",
					"roleType": "TALK_ROLE_NPC",
