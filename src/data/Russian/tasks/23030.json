			"trigger": {
				"objectNames": [
					"Ладеп",
					"Фарез"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300101,
					"content": "Нам нужно больше данных!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300102
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300102,
					"content": "Как твои устройства могут нормально работать без базы данных?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300103
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300103,
					"content": "Ты не начнёшь работать, пока не получишь все данные, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300104
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300104,
					"content": "Будешь ли ты разглядывать каждую волну во время рыбалки? Всё, что тебе нужно сделать, это найти ту, под которой есть рыба!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300105
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300105,
					"content": "Вот почему ты никогда не поймаешь рыбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300106
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300106,
					"content": "Брось, ты же не учился в Хараватате! Хватит каламбурить! Работа не ждёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300107
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300107,
					"content": "Если мы будем затягивать, наша с Ясмин научная работа может потерять свою актуальность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300108
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300108,
					"content": "О чём спорите?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300109
					]
				},
				{
					"id": 230300109,
					"content": "Ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300110
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300110,
					"content": "#Должно быть, это путешественни{F#ца}{M#к}, о которой упоминала Ясмин. Вы нам очень помогли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300111
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300111,
					"content": "#Рад встрече! Путешественни{F#ца}{M#к}, приятно познакомиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300112
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300112,
					"content": "Меня зовут Фарез, я учусь в Кшахреваре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300113
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300113,
					"content": "Меня зовут Ладеп, я студент Спантамада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300114
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300114,
					"content": "#Путешественни{F#ца}{M#к}, мы тоже хотели попросить тебя о помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300115
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300115,
					"content": "Ты же знаешь, что Ясмин в последнее время распыляет снадобье вокруг корневой системы Священного древа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300116
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300116,
					"content": "Однако... Эм... Кажется, со снадобьем Ясмин что-то произошло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300117
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300117,
					"content": "Вокруг области, где она применяет снадобье, всегда появляются различные монстры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300118
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300118,
					"content": "Клянусь, что я не менял рецептуру или пропорции в снадобье. Должно быть... эм, случилось что-то странное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300119
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300119,
					"content": "#Как скажешь... Но в любом случае, путешественни{F#ца}{M#к}, пожалуйста, пойдём с нами к тому месту, где Ясмин распыляет снадобье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300120
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300120,
					"content": "Не исключено, что там появилось много монстров, поэтому мы боимся идти туда одни... Нам нужен сильный помощник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300121
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300121,
					"content": "Может, эти плесенники не слишком опасны, но если учитель узнает, что с нашим снадобьем что-то не так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300122
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300122,
					"content": "То тема нашей научной работы определённо будет отклонена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300123
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300123,
					"content": "Особенно в Спантамаде. За ошибку в представленных данных учитель раскритикует нас до смерти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300124,
						230300125
					],
					"speakerTitle": "Ладеп"
				},
				{
					"id": 230300124,
					"content": "Я обо всём позабочусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230300125,
					"content": "Как вы раньше решали эту проблему?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300126
					]
				},
				{
					"id": 230300126,
					"content": "Обычно мы нанимали искателей приключений или обращались к нашему наставнику, чтобы он нанял нескольких надёжных Пустынников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300127
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300127,
					"content": "Но терпение нашего наставника тоже не вечно. Учитывая обстоятельства, мы боимся просить его о помощи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300128
					],
					"speakerTitle": "Фарез"
				},
				{
					"id": 230300128,
					"content": "#Поэтому нам ничего не остаётся, как просить тебя о помощи, путешественни{F#ца}{M#к}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ладеп"
				}
			]
		},
		{
			"id": 2303002,
