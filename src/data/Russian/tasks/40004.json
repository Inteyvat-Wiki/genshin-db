			"dialogs": [
				{
					"id": 400040301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040302
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040302,
					"content": "Эй! Ты тот самый парень? Осведомитель Кэйи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040303,
					"content": "Осведомитель? Нет, не я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040304
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040304,
					"content": "Но... Мы договорились встретиться здесь... И кроме тебя тут никого нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040305,
					"content": "Встретиться здесь? Я не понимаю, о чём вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040306
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040307,
					"content": "«Истина в вине!»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040308
					]
				},
				{
					"id": 400040310,
					"content": "Что-то там в вине!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040311
					]
				},
				{
					"id": 400040306,
					"content": "Ох, ну и вредина же этот тип...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040307,
						400040310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040308,
					"content": "Да. Я ваш человек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040309
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040309,
					"content": "Обязательно нужно было так себя вести?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040311,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040312
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040312,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040313,
					"content": "Ну ладно. Не «что-то там», а «истина»! «Истина в вине»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040314
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040314,
					"content": "Да. Я ваш человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040315
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040315,
					"content": "Зачем нужно было всё это устраивать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040316,
					"content": "Что вы хотите узнать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040317
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040317,
					"content": "Дело вот в чём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040318,
					"content": "Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040319
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040319,
					"content": "Ну и что вы можете нам рассказать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040320,
					"content": "Не думаю, что в этом замешаны Похитители сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040321
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040321,
					"content": "Огромная преступная группировка до сих пор существует и действует в нескольких королевствах только потому, что неукоснительно соблюдает главное правило игры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040322
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040322,
					"content": "Они осторожны. Всегда действуют по плану и не любят крупно рисковать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040323
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040323,
					"content": "За Ли Юэ присматривает один из Адептов, верно? Защитник Якса. А во время Праздника морских фонарей он будет особенно бдителен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040325
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040324,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040325,
					"content": "Поэтому мы не посмели бы... То есть они, Похитители сокровищ, не посмели бы ничего предпринимать во время Праздника морских фонарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040326
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040326,
					"content": "К тому же ячейка Похитителей сокровищ в Ли Юэ недавно получила анонимное письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040327
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040327,
					"content": "Анонимное письмо? Кто-то хочет подставить Похитителей сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040328
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040328,
					"content": "Сложно сказать. Но я могу рассказать вам, у какой из групп Похитителей сокровищ находится письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040329
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040329,
					"content": "...Вот. Я отметил их лагерь на вашей карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040330
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 400040330,
					"content": "#Отлично! Встреча прошла продуктивно. У нас появилась ценная зацепка. {NICKNAME}, за дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040331
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040331,
					"content": "Если у вас больше нет вопросов, я возвращаюсь к Похитителям сокровищ. Вернее, к наблюдению за Похитителями сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нимрод"
				}
			]
		},
		{
			"id": 4000408,
			"completionStepIds": [
				4000408
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
