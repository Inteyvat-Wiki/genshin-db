			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бэй Эр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400040801,
					"content": "Прошу, пощади! Великий Адепт! Защитник Якса! Друг всего живого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040802
					],
					"speakerTitle": "Бэй Эр"
				},
				{
					"id": 400040802,
					"content": "В этом письме всё равно нет ничего полезного. Оно не стоит пролитой крови... Просто заберите его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040803
					],
					"speakerTitle": "Хитрюга"
				},
				{
					"id": 400040803,
					"content": "Отлично. Я знала, что так и будет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040804,
					"content": "#{NICKNAME}, давай прочитаем письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040805,
					"content": "Понятно... Пусть эти двое отправятся на встречу вместо вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040806
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400040806,
					"content": "Похоже, что автор письма планирует поджечь город во время Праздника морских фонарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040807
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400040807,
					"content": "Ой как хорошо! И нам хорошо, и вам тоже. Однако...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040808
					],
					"speakerTitle": "Бэй Эр"
				},
				{
					"id": 400040808,
					"content": "Эти двое... Они ведь совсем на нас непохожи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040809
					],
					"speakerTitle": "Хитрюга"
				},
				{
					"id": 400040809,
					"content": "Не переживай. Мы так замаскируемся, что никто и в жизни не догадается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040810,
					"content": "Ну не знаю, всё равно как-то не то... Надеюсь, что с помощью Адепта у нас всё получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040811
					],
					"speakerTitle": "Бэй Эр"
				},
				{
					"id": 400040811,
					"content": "Получается... Безопасность Ли Юэ в ваших руках. Удачи! Даже Похитители сокровищ не хотят, чтобы город сгорел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040812
					],
					"speakerTitle": "Хитрюга"
				},
				{
					"id": 400040812,
					"content": "Значит, с этим разобрались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040813
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400040813,
					"content": "Подожди!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040814
					]
				},
				{
					"id": 400040814,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040815
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400040815,
					"content": "Наша следующая встреча...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040816
					]
				},
				{
					"id": 400040816,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040817
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400040817,
					"content": "Давай встретимся там, откуда видно лунный фонарь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040818
					]
				},
				{
					"id": 400040818,
					"content": "...Я не очень люблю людные места, особенно в это время года.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040819
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400040819,
					"content": "Это действительно необходимо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040820
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400040820,
					"content": "Да!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040821
					]
				},
				{
					"id": 400040821,
					"content": "...Хорошо. Я буду ждать вас там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сяо"
				}
			]
		},
