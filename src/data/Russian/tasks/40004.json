				"points": []
			},
			"dialogs": [
				{
					"id": 400040201,
					"content": "#Давно не виделись, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040202
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040202,
					"content": "Кэйа, мы были в Ли Юэ на Празднике морских фонарей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040203,
					"content": "И как вам праздник? Понравился?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040204
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040204,
					"content": "Там очень вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040205,
					"content": "Тогда вы просто обязаны посетить Луди Гарпастум в Мондштадте. Уверен, что он вам тоже понравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040206
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040206,
					"content": "Ближе к делу, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040207
					]
				},
				{
					"id": 400040207,
					"content": "Ах, точно! Кэйа, нам нужно кое-что тебе рассказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040208,
					"content": "Хм... Строительные материалы... Древесина, бумага, масло... Это может плохо кончиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040209
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040209,
					"content": "Ха-ха! Как интересно. С чего вы взяли, что мне знаком этот символ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040210,
						400040215
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040210,
					"content": "Ты хорош во всём, и мы тебе доверяем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040211
					]
				},
				{
					"id": 400040211,
					"content": "Верно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040212,
					"content": "Я, конечно, польщён, но вам не кажется, что вы меня переоцениваете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040213
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040213,
					"content": "#Ты слышал{F#а}? Кэйа только что продемонстрировал одну из рыцарских добродетелей - скромность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040214,
					"content": "Ничего себе. Стоило вам всего лишь раз побывать в Ли Юэ, и вы уже стали неплохо разбираться в риторике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040220,
					"content": "Вернёмся к вашему вопросу. Этот символ принадлежит преступной группировке, известной как Похитители сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040221
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040221,
					"content": "Если вы хотите узнать больше, я могу устроить для вас встречу со своим осведомителем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040222
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040222,
					"content": "Я думала, что рыцари не ведут никаких дел с врагами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040223,
					"content": "...Это мой личный осведомитель. Никакого отношения к ордену он не имеет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040224
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040224,
					"content": "Отправляйтесь в долину Ветров. Там вы встретите моего осведомителя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040225
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040225,
					"content": "Спасибо тебе, Кэйа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040226,
					"content": "Ох, и запомните: «Истина в вине!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040227
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040227,
					"content": "Гм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040215,
					"content": "Ты на короткой ноге с «тёмной стороной».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040216
					]
				},
				{
					"id": 400040216,
					"content": "Верно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400040217,
					"content": "Кхм. Тебе следует быть осторожнее в выборе слов, почётный рыцарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040218
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040218,
					"content": "О какой «тёмной стороне» ты говоришь? Ордо Фавониус не ведёт никаких дел с врагами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040219
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 400040219,
					"content": "Это связано с другой рыцарской добродетелью - порядочностью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "Кэйа"
				}
			]
		},
