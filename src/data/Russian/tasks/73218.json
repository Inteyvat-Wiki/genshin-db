			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180301,
					"content": "В Море красных песков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180302
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180302,
					"content": "Оставайтесь здесь те, кто не трепещет перед усопшими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321804,
			"completionStepIds": [
				7321804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321804",
							"2"
						],
						"stepId": 7321804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180401,
					"content": "Академия настрого запрещает разрушать Стену Самиэль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180402
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180402,
					"content": "Любое нарушение будет наказано.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321805,
			"completionStepIds": [
				7321805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321805",
							"2"
						],
						"stepId": 7321805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180501,
					"content": "«Продаём засахаренные фрукты, ингредиенты для десертов и другие диковинки пустыни».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180502
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180502,
					"content": "«Для оптовых заказов возможна доставка».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180503
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180503,
					"content": "«Хм, неплохо. Что насчёт данго? Вы доставляете до Инадзумы?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180504
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180504,
					"content": "«Извините, на данный момент доставка осуществляется только до Ли Юэ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321806,
			"completionStepIds": [
				7321806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321806",
							"2"
						],
						"stepId": 7321806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180601,
					"content": "Хоть особая реклама «Позолоченному путешествию» и не нужна, знайте, что это единственная гостиница в Караван-рибате.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180602
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180602,
					"content": "У нас самое вкусное барбекю, вы ощутите настоящий вкус пустыни. Здесь готовят правильнее, чем в городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180603
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180603,
					"content": "Приходите к нам после долгой и утомительной дороги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321807,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
							"2"
						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180701,
					"content": "«Надеюсь, махамата подумает над ужесточением таможенных правил Караван-рибата».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180702
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180702,
					"content": "«Сейчас только жители пустыни могут свободно проходить. Всякого рода разбойники пользуются этой возможностью, чтобы спрятаться в джунглях. К тому же они занимают рабочие места жителей Сумеру».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180703
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180703,
					"content": "«Сейчас для жителей пустыни пока недоступна Акаша, однако поручения, выдаваемые Цитаделью Регзара, могут выполнять не только наёмники. Если так продолжится, то всё равно кто-то останется безработным, даже если все пойдут учиться в Академию».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180704
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180704,
					"content": "«О чём ты? Жители пустыни изначально подчинялись великой властительнице Руккхадевата. Они также являются жителями Сумеру, поэтому они имеют полное право входить в город».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180705
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180705,
					"content": "«Думай, о чём ты здесь говоришь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321808,
			"completionStepIds": [
				7321808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321808",
							"2"
						],
						"stepId": 7321808,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180801,
					"content": "Учёные, собирающиеся надолго остаться в Караван-рибате, должны зарегистрироваться у махаматы, после чего они могут заселиться в гостиницу. Это делается для избежания утечки знаний и прочих форс-мажорных обстоятельств.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321809,
			"completionStepIds": [
				7321809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321809",
							"2"
						],
						"stepId": 7321809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180901,
					"content": "Торговцы должны зарегистрироваться у махаматы, и после одобрения они могут въехать на наши земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180902
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180902,
					"content": "Запрещается провозить незарегистрированные или запрещённые товары. При обнаружении таких товаров вся партия будет конфискована, а причастные лица изгнаны в пустыню, согласно закону.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180903
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180903,
					"content": "Кроме того, жители деревни Аару могут пересекать границу, имея соответствующие документы, выданные Академией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321810,
			"completionStepIds": [
				7321810
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321810",
							"2"
						],
						"stepId": 7321810,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181001,
					"content": "«Продаются наборы для путешествия по пустыне. Они помогут торговцам справиться с любыми неприятностями, которые могут встретиться в пустыне».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181002
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181002,
					"content": "«Для покупателей, купивших набор, компания гарантирует безопасное возвращение. В противном случае мы компенсируем вам в десятикратном объёме. А если вы закажете прямо сейчас, то ещё получите скидку».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321811,
			"completionStepIds": [
				7321811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321811",
							"2"
						],
						"stepId": 7321811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181101,
					"content": "«Говорят, в пустыне находится созданная Академией больница, где лечат элеазар. Но по неизвестным причинам она оказалась заброшенной».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181102
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181102,
					"content": "«Жители деревни Аару рассказывали, что оттуда сбежали больные, исцелённые от элеазара».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181103
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181103,
					"content": "«Возможно, там ещё осталась информация о том, как победить эту болезнь...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321812,
			"completionStepIds": [
				7321812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321812",
							"2"
						],
						"stepId": 7321812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181201,
					"content": "«Говорят, кто-то из жителей деревни Аару занял высокий пост в Академии. Возможно, теперь дела у жителей пустыни пойдут в гору».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181202
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181202,
					"content": "«Я целыми днями перевожу эти камни и толком ничего не зарабатываю. Вот если бы мне повезло перевозить пилюли знаний или что-то типа этого, то после первого же заказа я бы вернулся к себе домой и женился».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181203
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181203,
					"content": "«Но мне сказали, что этот господин занимается борьбой с контрабандой. Думаю, он ничем нам не поможет».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181204
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181204,
					"content": "«Мы, жители пустыни, стали такими, потому что среди нас нет единства».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321813,
			"completionStepIds": [
				7321813
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321813",
							"2"
						],
						"stepId": 7321813,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181301,
					"content": "Внимание, искатели приключений, отправляющиеся в пустыню! Согласно правилам Академии, вся ваша деятельность в Море красных песков должна быть зарегистрирована в Академии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181302
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181302,
					"content": "Все найденные в пустыне реликвии являются собственностью Академии. Никто не вправе присваивать их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181303
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181303,
					"content": "Из соображений безопасности Академия ввела запрет на посещение Моря красных песков и других мест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181304
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181304,
					"content": "Академия не несёт ответственности за любые происшествия в той местности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321814,
			"completionStepIds": [
				7321814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321814",
							"2"
