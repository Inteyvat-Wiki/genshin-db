			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181401,
					"content": "«Говорят, люди разбогатели на продаже жира от куколок в городе. Они не только смогли приобрести в городе роскошное жильё, но ещё и претендуют на то, что являются кланом. А людей из Академии называют братьями и сёстрами».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181402
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181402,
					"content": "«А я тут полжизни горбачусь, перевозя камни, и ничего не заработал».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181403
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181403,
					"content": "«Ничего ты не понимаешь! Торговать жиром куколок можно только с разрешения Академии. Поэтому даже и не думай туда соваться».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181404
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181404,
					"content": "«Если хочешь разбогатеть, то давай вместе будем торговать книгами. Если у нас всё получится, то нам не придётся больше возить булыжники».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321815,
			"completionStepIds": [
				7321815
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321815",
							"2"
						],
						"stepId": 7321815,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
