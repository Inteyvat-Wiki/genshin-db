				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180101,
					"content": "Караван-рибат является важным проходом в Сумеру. Здесь установлена эта доска объявлений для информирования торговцев и туристов о важных делах. Обращайте внимание на эти объявления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321802,
			"completionStepIds": [
				7321802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321802",
							"2"
						],
						"stepId": 7321802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180201,
					"content": "«Любимый мой, где бы ты ни был, моё сердце всегда будет принадлежать тебе».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180202
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180202,
					"content": "«Я знаю, что у тебя есть очень важные дела. И чем выше твоя должность, тем их становится больше».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180203
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180203,
					"content": "«Мне некому рассказать о моих печалях, и я никому не могу сказать твоё имя».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180204
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732180204,
					"content": "«Я надеюсь, что однажды смогу поведать всем, какой ты у меня мудрый и умный».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7321803,
			"completionStepIds": [
				7321803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
