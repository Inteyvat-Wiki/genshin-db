				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181801,
					"content": "«Надеюсь, махамата подумает над ужесточением таможенных правил Караван-рибата».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181802
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181802,
					"content": "«Сейчас только жители пустыни могут свободно проходить. Всякого рода разбойники пользуются этой возможностью, чтобы спрятаться в джунглях. К тому же они занимают рабочие места жителей Сумеру».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181803
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181803,
					"content": "«Сейчас для жителей пустыни пока недоступна Акаша, однако поручения, выдаваемые Цитаделью Регзара, могут выполнять не только наёмники. Если так продолжится, то всё равно кто-то останется безработным, даже если все пойдут учиться в Академию».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181804
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181804,
					"content": "«О чём ты? Жители пустыни изначально подчинялись Дендро Архонту. Они также являются жителями Сумеру, поэтому они имеют полное право входить в город».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181805
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181805,
					"content": "«Думай, о чём ты здесь говоришь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
