			},
			"dialogs": [
				{
					"id": 732181601,
					"content": "Постоянно ищем мастеров для обслуживания Стены Самиэль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181602
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181602,
					"content": "Предоставляем проживание и питание. Достойный заработок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181603
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732181603,
					"content": "А самых усердных работников мы можем порекомендовать на учёбу в Академию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
