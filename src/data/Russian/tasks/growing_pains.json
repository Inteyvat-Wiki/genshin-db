			"dialogs": [
				{
					"id": 225000601,
					"content": "#{F#Сестрёнка}{M#Братик}, ты прин{F#есла}{M#ёс} мои духи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000602
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 225000602,
					"content": "Да. Вот они.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000603
					]
				},
				{
					"id": 225000603,
					"content": "#Спасибо, {F#сестрёнка}{M#братик}! Духи, которые делает Ин Эр, правда очень вкусно пахнут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000604
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 225000604,
					"content": "Интересно, что подумают Мэн и Фэй, когда почувствуют их запах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000605
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 225000605,
					"content": "Думаю, их реакция будет очень забавной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000606,
						225000608
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 225000606,
					"content": "Надеюсь, им понравится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000607
					]
				},
				{
					"id": 225000607,
					"content": "Я очень на это рассчитываю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000610
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 225000610,
					"content": "#Большое спасибо за помощь, {F#сестрёнка}{M#братик}. Я скоро пойду домой и попробую свои новые духи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000611
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 225000611,
					"content": "Если они правда вкусные, то я буду пользоваться ими постоянно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 225000608,
					"content": "С кем тебе больше нравится играть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000609
					]
				},
				{
					"id": 225000609,
					"content": "Больше? Я не знаю, они оба мои лучшие друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000610
					],
					"speakerTitle": "Малышка Лулу"
				}
			]
		},
