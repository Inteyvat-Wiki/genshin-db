			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ин Эр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000301,
					"content": "Скажем, три тысячи моры?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000302
					]
				},
				{
					"id": 225000302,
					"content": "Похоже, тебе действительно нужен этот парфюм... Ладно, я немедленно займусь духами для малышки Лулу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000303
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000303,
					"content": "Однако днём я должна заниматься магазином. Все личные дела я оставляю на ночь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000304
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000304,
					"content": "Загляни ко мне после заката, и я приготовлю всё необходимое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ин Эр"
				}
			]
		},
		{
			"id": 2250004,
			"completionStepIds": [
				2250002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ин Эр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000401,
					"content": "Я помогу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000402
					]
				},
				{
					"id": 225000402,
					"content": "Неплохая идея. У тебя ведь есть опыт в подобных делах. В прошлый раз тебе удалось меня впечатлить, хи-хи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000403
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000403,
					"content": "Так получилось, что у меня есть некоторые из необходимых ингредиентов. Я буду ждать тебя на кухне шеф-повара Мао.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000404
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000404,
					"content": "Собери три листка мяты, используй верстак, чтобы создать эфирное масло. Я полагаю, что ты помнишь, как это делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000405
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000405,
					"content": "Принеси мне мятное эфирное масло, а я займусь всем остальным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ин Эр"
				}
			]
		},
		{
			"id": 2250005,
			"completionStepIds": [
				2250004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
