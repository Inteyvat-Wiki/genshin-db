					"nextDialogs": [
						225001205
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225001205,
					"content": "У каждой девушки есть свои секреты. Что-то мы выставляем напоказ, а что-то держим в тайне. Так работает женское обаяние.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001206
					],
					"speakerTitle": "Ин Эр"
				},
