				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ин Эр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000201,
					"content": "О, привет! Что тебе нужно на этот раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000202
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000202,
					"content": "#Я приш{F#ла}{M#ёл} забрать кое-что для малышки Лулу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000203
					]
				},
				{
					"id": 225000203,
					"content": "Малышка Лулу? Ах, да. Она просила приготовить для неё парфюм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000204
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000204,
					"content": "Но сейчас не самое лучшее время... Почему-то после нашей прошлой встречи спрос на мои услуги значительно вырос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000205
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000205,
					"content": "У меня поразительно много заказов. Слишком много, чтобы справиться с ними в одиночку. А ещё мне нужно заниматься магазином.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000206
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000206,
					"content": "К тому же малышка Лулу ещё совсем ребёнок. Было бы неправильно предлагать ей парфюм, подходящий взрослой женщине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000207
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000207,
					"content": "Поэтому я долго ломала голову над тем, как сделать парфюм более «детским». Я вывела новую формулу, но ещё не успела её опробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000208
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000208,
					"content": "Если дело действительно не терпит промедления, то приготовить парфюм всё-таки возможно, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000209
					],
					"speakerTitle": "Ин Эр"
				}
			]
		},
		{
			"id": 2250003,
			"completionStepIds": [
				2250002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
