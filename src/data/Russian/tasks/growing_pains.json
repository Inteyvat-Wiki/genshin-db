				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ин Эр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000501,
					"content": "Парфюм готов. Аромат на основе мятного эфирного масла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000502
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000502,
					"content": "Держи. Отнеси его малышке Лулу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000503,
						225000504
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000503,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 225000504,
					"content": "Но почему именно мята?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000505
					]
				},
				{
					"id": 225000505,
					"content": "Своим спокойным запахом она нейтрализует более... стимулирующие элементы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000506
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000506,
					"content": "Если честно, для меня удивительно получить заказ от малышки Лулу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000507
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000507,
					"content": "Это напоминает мне о нежном возрасте, о первой любви, о трепещущем сердце... Эх, если бы я была тогда чуточку умнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000508
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225000508,
					"content": "Кхм... Ладно, тебе пора возвращаться к Лулу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ин Эр"
				}
			]
		},
