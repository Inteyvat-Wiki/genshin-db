			"dialogs": [
				{
					"id": 225001001,
					"content": "#Мятное эфирное масло, запомнил{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001002,
						225001006
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225001002,
					"content": "А как приготовить мятное эфирное масло?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225001003
					]
				},
				{
					"id": 225001003,
					"content": "#Мы же совсем недавно делали его вместе. Уже забыл{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001004
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225001004,
					"content": "Давай я тебе напомню. Собери три листика мяты и с помощью верстака приготовь эфирное масло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001005
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225001005,
					"content": "Принеси эфирное масло мне, и я сделаю всё остальное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225001006,
					"content": "А для чего нужно мятное эфирное масло?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225001007
					]
				},
				{
					"id": 225001007,
					"content": "Как бы сказать... Оно обладает стабилизирующими свойствами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001008
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225001008,
					"content": "Но самое главное, что этот аромат подходит такой девочке, как Лулу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001009
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225001009,
					"content": "Аромат девушки - это гораздо больше, чем просто запах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001010
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 225001010,
					"content": "Парфюм должен говорить о наивной жизнерадостности Лулу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ин Эр"
				}
			]
