			"dialogs": [
				{
					"id": 190010101,
					"content": "Надеюсь, с сестрой Барбарой всё в порядке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010102
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190010102,
					"content": "А что случилось с Барбарой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010103
					]
				},
				{
					"id": 190010103,
					"content": "Сестра Барбара сказала, что пойдёт собирать целебные травы, и до сих пор не вернулась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010104
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190010104,
					"content": "Ох... Может быть, стоит обратиться за помощью к Ордо Фавониус?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010105
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190010105,
					"content": "Я поищу Барбару.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010106
					]
				},
				{
					"id": 190010106,
					"content": "Ты? Гм... Кажется, это подходящая задача для почётного рыцаря...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010107
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190010107,
					"content": "А мне не придётся обращаться в Ордо Фавониус...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010108
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190010108,
					"content": "Хорошо. Давай этим займёшься ты. Барбара собиралась отправиться в Вольфендом за целебными травами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010109
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190010109,
					"content": "Можешь начать поиски там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Виктория"
				}
			]
		},
