				}
			]
		},
		{
			"id": 7104602,
			"completionStepIds": [
				7104602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104602",
							"2"
						],
						"stepId": 7104602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Те Хун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "Остановитесь! Разлом закрыт! Посторонним... А, это ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "Те Хун"
				},
				{
					"id": 710460202,
					"content": "О нет, бежим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710460203,
					"content": "Паймон, прекрати.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "Ха-ха-ха... Простите, не хотел вас напугать. Разве можно забыть своих спасителей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "Те Хун"
				},
				{
					"id": 710460207,
					"content": "#Меня недавно сюда перевели. Не ожидал, что случайно встречу здесь {F#свою благодетельницу}{M#своего благодетеля}. Какая удача!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "Те Хун"
				},
				{
					"id": 710460208,
					"content": "#{F#Благодетельницу?}{M#Благодетеля?} Мы сделали что-то хорошее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710460209,
					"content": "Конечно! Я был в Нефритовом дворце, когда все сражались с морским чудовищем. Я получил ранение и только недавно поправился...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "Те Хун"
				},
				{
					"id": 710460210,
					"content": "Возможно, ты не помнишь меня, но я не забыл тебя. Братья, которые сражались бок о бок с нами, были свидетелями твоей преданности Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "Те Хун"
				},
				{
					"id": 710460211,
					"content": "Расскажи мне о Разломе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "Два года назад шахты закрыли по приказу Цисин после необъяснимого несчастного случая. Шахтёры были эвакуированы и в основном не пострадали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "Те Хун"
				},
				{
					"id": 710460213,
					"content": "Жаль, что такая крупная шахта прекратила производство. Рабочие получили полагающиеся выплаты и разошлись кто куда. Когда люди разбредаются, их трудно вновь собрать вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "Те Хун"
				},
				{
					"id": 710460214,
					"content": "Извини, я отвлёкся. Уверен, что тебя сюда привело важное дело, не буду мешаться под ногами. Если тебе что-то понадобится, обращайся сразу к Му Нину. Ты найдёшь его у входа в лагерь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "Те Хун"
				},
				{
					"id": 710460215,
					"content": "#Долг зовёт! Всё же я должен предупредить, чтобы ты не делал{F#а} ничего противозаконного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "Те Хун"
				},
				{
					"id": 710460216,
					"content": "Неужели ты нам не доверяешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710460204,
					"content": "Мы знакомы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "Нас узнали! Бежим!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
}