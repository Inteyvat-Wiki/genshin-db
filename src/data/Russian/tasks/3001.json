				"points": []
			},
			"dialogs": [
				{
					"id": 30011101,
					"content": "#Путешественни{F#ца}{M#к}, ты вернул{F#ась}{M#ся}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011102
					],
					"speakerTitle": "Насрин"
				},
				{
					"id": 30011102,
					"content": "Привет! Ты не видела Коллеи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30011103,
					"content": "Она пошла в свою комнату.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011104
					],
					"speakerTitle": "Насрин"
				},
				{
					"id": 30011104,
					"content": "Ну... Тогда, думаю, мы сможем поговорить с ней завтра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 300151,
