				{
					"id": 30010609,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010610
					]
				},
				{
					"id": 30010610,
					"content": "Подожди, что это было? Или Паймон привиделось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010611,
						30010613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010611,
					"content": "Ты тоже это видела?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010612
					]
				},
				{
					"id": 30010612,
					"content": "Да! Такое маленькое и кругленькое. Очень похоже на овощ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010615,
					"content": "Паймон до смерти перепугалась. Надо выяснить, что это было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010616
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010616,
					"content": "Но давай сначала приступим к работе. Паймон полетит наверх, а ты почисти внизу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010617
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010617,
					"content": "Вы с Паймон тщательно очистили статую...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30010613,
					"content": "Это что, капуста?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010614
					]
				},
				{
					"id": 30010614,
					"content": "Да, точно! Маленькое, круглое и похоже на капусту. Но оно явно живое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010605,
					"content": "Малая властительница Кусанали?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010606
					]
				},
				{
					"id": 30010606,
					"content": "Внешний вид статуи вполне соответствует имени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010607
					],
					"speakerTitle": "Паймон"
				}
			]
		},
