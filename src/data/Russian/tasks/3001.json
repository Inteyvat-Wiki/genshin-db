			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Коллеи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30015101,
					"content": "Я не очень хороша в скалолазании, поэтому помогите с чисткой статуи, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30015102
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30015102,
					"content": "Я пока проверю один объект. Если не возражаете, мы поговорим, когда все дела будут сделаны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Коллеи"
				}
			]
		}
