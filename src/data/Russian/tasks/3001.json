			"dialogs": [
				{
					"id": 30010601,
					"content": "Присмотревшись, Паймон заметила, что фигурка Архонта на этой статуе такая... маленькая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010602,
					"content": "Как думаешь, это великая властительница Руккхадевата или малая властительница Кусанали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010603,
						30010605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010603,
					"content": "Великая властительница Руккхадевата?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010604
					]
				},
				{
					"id": 30010604,
					"content": "Очень даже может быть. Статуя выглядит древней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010607,
					"content": "Мы узнаем о них обеих позже, а сейчас давай займёмся уборкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010608,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010609
					],
					"speakerTitle": "Аранара А"
