			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Коллеи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010101,
					"content": "Хорошо, теперь правая рука... Кажется, всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010102
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30010102,
					"content": "Но будь осторожна, поняла?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010103
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30010103,
					"content": "Да, я поняла. Кстати, наставник, у меня нет маршрута сегодняшнего обхода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010104
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010104,
					"content": "Послушай, Коллеи. Сегодня нам предстоит долгое патрулирование, так что ты в этот раз с нами не пойдёшь. К тому же по пути мы можем столкнуться... В общем, ты поняла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010105
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30010105,
					"content": "Но у меня есть Глаз Бога. Неужели я теперь совсем бесполезна?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010106
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010106,
					"content": "Не говори так. Тебе сейчас о другом нужно думать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010107
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30010107,
					"content": "А, это вы. Как самочувствие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010108
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30010108,
					"content": "Нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010109
					]
				},
				{
					"id": 30010109,
					"content": "Раз уж мы здесь, мы подумали, что могли бы быть полезны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010110,
					"content": "Вы из тех, кто не может спокойно сидеть на месте? В таком случае позвольте Коллеи провести с вами обзорное патрулирование по южной границе Гандхарвы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010111
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30010111,
					"content": "Если самочувствие позволяет, можете почистить статую семи Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010112
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30010112,
					"content": "Тигнари, мы готовы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010113
					],
					"speakerTitle": "Амир"
				},
				{
					"id": 30010113,
					"content": "Скоро буду. Нам пора в патруль, а Коллеи всё вам объяснит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010114
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30010114,
					"content": "Без проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010115
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010115,
					"content": "Коллеи, что мы будем делать сегодня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010116,
					"content": "Тигнари сказал, что нужно почистить статую семи Архонтов. Вот только не пойму, это тоже входит в обязанности лесных дозорных?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010117,
					"content": "Да, у лесных дозорных широкий круг обязанностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010118
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010118,
					"content": "Проверка состояния дорог, обслуживание лесных сооружений, ликвидация угрозы пожара, оказание помощи путешественникам и местным жителям...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010119
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010119,
					"content": "А ещё наставнику часто приходится иметь дело с опасными участками тропического леса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010120
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010120,
					"content": "По пути к статуе семи Архонтов нам также нужно проверить уличное освещение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Коллеи"
				}
			]
		},
		{
			"id": 300105,
			"completionStepIds": [
				300103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300103",
							"2"
						],
						"stepId": 300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Коллеи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010501,
					"content": "Статуя стоит на вершине этого большого скального образования. Вы наверняка видели её, когда шли по этой дороге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010502
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010502,
					"content": "Высоко, правда? Если тебе тяжело подниматься, статую можно не чистить. Наставник не будет ругаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010503,
						30010504
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010503,
					"content": "#Я {F#чемпионка}{M#чемпион} по скалолазанию.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				},
				{
					"id": 30010505,
					"content": "#Тогда не буду тебе мешать. Будь {F#осторожна}{M#осторожен}, вокруг статуи очень мало места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010506
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010506,
					"content": "#{NICKNAME}, я с тобой. Помогу тебе очистить самые высокие места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010507,
					"content": "Кстати, Коллеи, ты знаешь что-нибудь о Дендро Архонте? Какая она?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010508,
					"content": "Ты спрашиваешь о великой властительнице Руккхадевате или о малой властительнице Кусанали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010509
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010509,
					"content": "Что за великая властительница Руккхадевата?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010510,
					"content": "А, это имя прежнего Дендро Архонта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010511,
					"content": "Великая властительница Руккхадевата была первым Дендро Архонтом Сумеру. Она создала тропический лес и воздвигла Стену Самиэль на границе с пустыней, чтобы все жили в мире и спокойствии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010512
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010512,
					"content": "Для жителей Сумеру она символ не только мудрости, но и доброты и всемогущества. Она исчезла в результате катастрофы много веков назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010513,
						30010514
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010513,
					"content": "(Как Райдэн Макото...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010515,
					"content": "Наставник рассказывал, что позже мудрецы нашли нового Дендро Архонта и привезли её в Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010516
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010516,
					"content": "В честь обретения Архонта мудрецы назвали её малой властительницей Кусанали и поселили в Храме Сурастаны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010517
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010517,
					"content": "Что было потом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010518
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010518,
					"content": "Потом... Я мало что знаю об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010519
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010519,
					"content": "Ты не знаешь? Разве ты не из Сумеру?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010520,
					"content": "Я из Сумеру, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010521
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010521,
					"content": "Может, тебе не хочется это обсуждать с чужаками? Не волнуйся, мы всё понимаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010522
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010522,
					"content": "Нет-нет, вы неправильно меня поняли, я ничего не скрываю. И вы не чужаки нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010523
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010523,
					"content": "Ммм... вы ведь знакомы с Эмбер?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010524
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010524,
					"content": "Подожди, ты говоришь о...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010525,
						30010526
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010525,
					"content": "Эмбер, скауте Ордо Фавониус?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010527,
					"content": "Да, это она! Я провела некоторое время в Мондштадте, и Эмбер мне очень помогла. Благодаря ей я стала другим человеком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010528
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010528,
					"content": "Эмбер удивительная! Увлечённая жизнью, с чувством справедливости. Она полна энергии, а ещё она понимающая и способна зажечь огонь в других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010529
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010529,
					"content": "По-моему, она идеально подходит на роль скаута. Каждый, кто попадает в Мондштадт, сначала встречает Эмбер, а потом влюбляется в эту землю благодаря её энтузиазму...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010530
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010530,
					"content": "Ах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010531,
						30010532
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010531,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010533,
					"content": "Вряд ли задачи скаута заключаются именно в этом. Хи-хи, но кое-что Паймон поняла! Тебе нравится Эмбер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010534
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010534,
					"content": "Кхе-кхе... простите, кажется, я неправильно выразилась. Наверно, это звучало странно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010535
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010535,
					"content": "Хи-хи, всё в порядке. Теперь, когда мы знаем, что ты подруга Эмбер, Паймон чувствует, что мы стали ближе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010536
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010536,
					"content": "Откуда ты знаешь, что мы знакомы с Эмбер?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010537
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010537,
					"content": "Дело в том, что я переписываюсь с Эмбер после возвращения в Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010538
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010538,
					"content": "#В одном из писем она рассказывала о нападении ужасного дракона на Мондштадт и что {F#светловолосая путешественница и её}{M#светловолосый путешественник и его} компаньон помогли справиться с бедствием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010539
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010539,
					"content": "#Я сразу узнала вас вчера, но я не сказала об этом, потому что ты только {F#пришла}{M#пришёл} в сознание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010540
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010540,
					"content": "Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010541
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010541,
					"content": "Не волнуйтесь, я полностью вам доверяю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010542
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010542,
					"content": "Я бы хотела рассказать вам больше про Дендро Архонта, но я некоторое время жила вдалеке от Сумеру, да и книг особо не читала... Простите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010543
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010543,
					"content": "Ты уже рассказала нам много полезного. Ведь раньше мы даже не слышали о великой властительнице Руккхадевате или о Храме Сурастаны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010544
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010544,
					"content": "Рада, что смогла вам помочь. Почему вас интересует Дендро Архонт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010545
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010545,
					"content": "Вы вкратце рассказываете Коллеи о цели своего путешествия...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010546
					]
				},
				{
					"id": 30010546,
					"content": "Так вот в чём дело! Спасибо, что поделились со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010547
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010547,
					"content": "Мы же друзья. Не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010548
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010548,
					"content": "Паймон всё правильно говорит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010549
					]
				},
				{
					"id": 30010549,
					"content": "Нам пора идти наверх чистить статую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010550
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30010550,
					"content": "Спасибо за помощь! Я тем временем проверю навес от дождя. Встретимся здесь чуть позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30010532,
					"content": "Так вот оно как...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010526,
					"content": "О чемпионе полётов из Мондштадта?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010514,
					"content": "(Это было во времена Каэнри'ах?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010504,
					"content": "Пара пустяков.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				}
			]
		},
