	"talks": [
		{
			"id": 7066401,
			"completionStepIds": [
				7066401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066401",
							"2"
						],
						"stepId": 7066401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хун Лан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706640101,
					"content": "Почему именно я должен разбираться с этими проблемами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640102,
						706640103
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640102,
					"content": "А? Ты ведь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640104
					]
				},
				{
					"id": 706640104,
					"content": "Это ты! Надо же, не ожидал тебя здесь увидеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640105
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640105,
					"content": "Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640106
					]
				},
				{
					"id": 706640106,
					"content": "Ох, даже не спрашивай. Помнишь то странное подземелье? Ну, которое менялось по воле человека.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640107
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640107,
					"content": "Тогда благодаря тебе я проник в это подземелье и получил много полезной информации. После его исчезновения я отправился к мисс Лань, чтобы отчитаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640108
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640108,
					"content": "Я с самого начала говорил ей, что разведка подземелья - целиком и полностью твоя заслуга. А я всего лишь немного помог.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640109
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640109,
					"content": "Но мисс Лань ничего не хотела слушать, только благодарила меня за работу. А потом ещё поставила меня во главе отряда, чтобы исследовать другие подобные подземелья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640110,
						706640111
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640110,
					"content": "Звучит неплохо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640112
					]
				},
				{
					"id": 706640112,
					"content": "Ничего хорошего! Ведь я был обычным искателем приключений, вольной птицей, которая делает что хочет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640113
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640113,
					"content": "Да, я зарабатывал меньше, зато был свободен. А теперь мисс Лань навесила на меня это звание, от которого я никак не могу отделаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640114
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640114,
					"content": "Ладно, довольно об этом. Лучше сразу перейду к делу. Видишь эту дверь? За ней находится ещё одно странное подземелье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640115
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640115,
					"content": "В этом подземелье полно ветряных потоков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640116
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640116,
					"content": "Тех самых ветряных потоков?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640117
					]
				},
				{
					"id": 706640117,
					"content": "Да, самые обычные ветряные потоки - воют, свистят... Их ещё любят оседлать искатели приключений, чтобы залететь на планере как можно выше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640118
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640118,
					"content": "Но в подземелье ветряные потоки расположены довольно беспорядочно. Некоторые сталкиваются друг с другом, образуя зоны, через которые невозможно пролететь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640119
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640119,
					"content": "Я пригласил несколько искателей приключений, которые умеют управляться с планером, разведать это подземелье. Но все они очень скоро вернулись назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640120
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640120,
					"content": "По их словам, ещё в подземелье находятся какие-то механизмы. Их запуск изменяет некоторые ветряные потоки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640121
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640121,
					"content": "Они как раз хотели выяснить предназначение этих механизмов, но тут на них напали монстры, и искателям приключений пришлось уйти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640122
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640122,
					"content": "Мы подумали, что если научиться управлять этими механизмами, разведка подземелья существенно упростится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640123,
						706640124
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640123,
					"content": "Ты сам заходил в это подземелье?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640125
					]
				},
				{
					"id": 706640125,
					"content": "Ну, ты же знаешь - я сейчас не в лучшей форме, да и планером управляю плохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640126
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640126,
					"content": "Для обычного полёта я ещё гожусь, но эти ветряные потоки в подземелье...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640127
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640127,
					"content": "Если я войду туда, меня просто сдует, и я упаду прямо в лапы к монстрам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640128
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640128,
					"content": "#Путешественни{F#ца}{M#к}, я помню тебя в деле. Ты очень {F#сильная}{M#сильный}, да и соображаешь быстро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640129
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640129,
					"content": "Поможешь мне разведать это подземелье?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640130
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640130,
					"content": "Насчёт вознаграждения не беспокойся. Заплачу хорошо, как и в прошлый раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640131,
						706640133
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640131,
					"content": "Ладно, я попробую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640132
					]
				},
				{
					"id": 706640132,
					"content": "Замечательно! Я рассчитываю на тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640133,
					"content": "Там есть сокровища?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640134
					]
				},
				{
					"id": 706640134,
					"content": "Не знаю, мы ведь не смогли разведать его как следует...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640135
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640135,
					"content": "Но не переживай, если найдёшь там сокровища, можешь забрать их себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640136
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640136,
					"content": "#Я рассчитываю на твою помощь, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706640124,
					"content": "Ты не был там во главе своей команды?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640125
					]
				},
				{
					"id": 706640111,
					"content": "Это же хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640112
					]
				},
				{
					"id": 706640103,
					"content": "Снова встретились.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640104
					]
				}
			]
		}
	]
}