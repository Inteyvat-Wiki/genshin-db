			"trigger": {
				"objectNames": [
					"Каябуки Иккэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820101,
					"content": "#Эй, белокур{F#ая}{M#ый} чужезем{F#ка}{M#ец}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820102,
						726820103
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820102,
					"content": "И снова здравствуй.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				},
				{
					"id": 726820104,
					"content": "Хм... Твои светлые волосы кого-то мне напоминают...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820105
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820105,
					"content": "#Точно! Ты ведь «Золотое торнадо»! Ты блистательно выступил{F#а} на прошлом Хякунин икки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820106
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820106,
					"content": "Золотое торнадо?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820107
					]
				},
				{
					"id": 726820107,
					"content": "#В прошлый раз я наблюдал за выступлениями участников с края арены, чтобы собрать материалы для книги. И ты {F#была подобна}{M#был подобен} Золотому торнадо, который сметает всё на своём пути...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820108,
						726820109
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820108,
					"content": "Прошу, обойдёмся без лести.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820113
					]
				},
				{
					"id": 726820113,
					"content": "В общем, недавно снова устроили Хякунин икки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820114,
						726820118
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820114,
					"content": "Напомни, что такое Хякунин икки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820115
					]
				},
				{
					"id": 726820115,
					"content": "Это свободный турнир, на котором люди весёлыми поединками отмечают праздники и изгоняют неудачу. Во время этого турнира мастера боевых искусств и монстры забывают о старых обидах, чтобы насладиться чистым азартом схватки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820116
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820116,
					"content": "Говорят, что лучшие бойцы получают в награду сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820117
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820117,
					"content": "Хотя до сих пор остаётся загадкой, кто является организатором и спонсором.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820119
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820119,
					"content": "Как бы там ни было, такое лучше не обсуждать на людях. Идём со мной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820118,
					"content": "Всё понятно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820119
					]
				},
				{
					"id": 726820109,
					"content": "Продолжай!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820110
					]
				},
				{
					"id": 726820110,
					"content": "Кхм... «Внимательные зрители уже наверняка заметили, что светловолосый чужак использует Коранка дайтацумаки, которое считается табу в древних боевых искусствах!..»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820111
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820111,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820112
					]
				},
				{
					"id": 726820112,
					"content": "Я написал это под вдохновением от твоего боевого стиля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820113
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820103,
					"content": "Есть какие-нибудь поручения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				}
			]
		},
		{
			"id": 7268202,
			"completionStepIds": [
				7268202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268202",
							"2"
						],
						"stepId": 7268202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каябуки Иккэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820201,
					"content": "Вот мы и пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820202
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820202,
					"content": "Пройдя через эти крайне подозрительные двери, ты попадёшь на арену битвы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820203,
						726820204
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820203,
					"content": "Как интересно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				},
				{
					"id": 726820205,
					"content": "Правила те же, что и в прошлый раз. Монстры, искатели приключений и воины со всех уголков мира принимают участие в задорном побоище на этой арене.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820206
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820206,
					"content": "Как и в прошлый раз, ты можешь привести друзей и товарищей! Ведь «хякунин» в названии означает, что чем больше народу, тем веселее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820207
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820207,
					"content": "Жду не дождусь твоего выступления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820208
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820208,
					"content": "А ты опять не участвуешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820209
					]
				},
				{
					"id": 726820209,
					"content": "Я? Я участвую в роли зрителя. Я буду за тебя болеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820210
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820210,
					"content": "В конце концов, моя цель - написать самую эпичную книгу о сражениях, а не стать столь блистательным воином, как ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820211
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820211,
					"content": "И интуиция подсказывает мне, что ты станешь самой яркой звездой этой арены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820212,
						726820213
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820212,
					"content": "Я сделаю всё, что в моих силах.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820214,
					"content": "Уверен, ты сможешь поразить меня своими талантами фехтовальщика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 726820213,
					"content": "Я тебя не разочарую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820204,
					"content": "Очередные хлопоты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				}
			]
		}
	]
}