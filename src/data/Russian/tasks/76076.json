			"dialogs": [
				{
					"id": 760761101,
					"content": "Здравствуй, дорогой друг. Рад снова встретиться с тобой на кладбище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761102
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760761102,
					"content": "Вы описываете Флинсу «Фонарь клятвы» и непонятные слова, которые были на нём начертаны.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760761103
					]
				},
				{
					"id": 760761103,
					"content": "«Ветры пробуждаются, кружатся листья...» Это слова из клятвы, которую приносят Светоносцы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761104
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760761104,
					"content": "Обычно каждый из нас держит свой фонарь при себе и расстаётся с ним, только если нет иного выбора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761105
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760761105,
					"content": "Поэтому за каждым фонарём без хозяина кроется несчастье, и вид одинокого фонаря вселяет в человека печаль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761106
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760761106,
					"content": "Но они знали, какая судьба их ждёт, с того самого дня, как дали клятву.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761107
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760761107,
					"content": "Если и можно что-то для них сделать, так это не забывать клятву, которую они принесли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761108
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760761108,
					"content": "«Стоять на страже неугасимой надежды»... То, чего они больше всего хотели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флинс"
				}
			]
		}
	]
