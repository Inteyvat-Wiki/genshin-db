				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжун Ли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230301,
					"content": "Посмотрите. Эта чаша наполовину заполнена солью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230302
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230302,
					"content": "Это просто солонка. Похоже, Архонт Соли был божеством нищим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230303
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230303,
					"content": "Насколько я знаю, чаша эта необычная. Хоть она полна лишь наполовину, но она полна всегда - то есть соль в ней не кончается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230304
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230304,
					"content": "Что?! Даже если её высыпать, она всё равно будет наполовину полная?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230305
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230305,
					"content": "Именно так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230306
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230306,
					"content": "Она способна производить неистощимые запасы соли... Архонт Соли воистину могуч!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230307
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230307,
					"content": "После всех неприятностей я наконец нашёл сокровище! Чур эта вещица моя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230308
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230308,
					"content": "Чтобы разбогатеть, мне всего лишь нужно насыпать тысячу... Нет, десять тысяч мешков соли и продать их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230309
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230309,
					"content": "Эй! Как ты смеешь использовать реликвию Архонта Соли для таких низменных целей?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230310
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230310,
					"content": "Если господин Климент желает эту соляную чашу, то согласно контракту следующий предмет будет принадлежать госпоже Вань Янь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230311
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230311,
					"content": "Конечно, ничего не имею против. Хе-хе. Разве что-то может быть ценнее этой находки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230312
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230312,
					"content": "Раз у нас контракт, мне с ним спорить нечего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230313
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230313,
					"content": "Тогда идём дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				}
			]
		},
		{
			"id": 1102305,
			"completionStepIds": [
				1102305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102305",
							"2"
						],
						"stepId": 1102305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжун Ли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230501,
					"content": "Это что, каменная линейка? Вряд ли она чего-нибудь стоит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230502
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230502,
					"content": "Это... Если меня не подводит память, это такой инструмент для измерений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230503
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230503,
					"content": "Так и есть. Но Архонт Соли наделила его особой силой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230504
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230504,
					"content": "Если погрузить эту планку в землю, то всё вокруг, словно приливная волна, покроет соль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230505
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230505,
					"content": "Чем глубже её погрузить, тем больше прибудет соли. Другими словами, она позволяет получить богатый урожай соли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230506
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230506,
					"content": "Она... она... она даже лучше соляной чаши!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230507
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230507,
					"content": "По контракту соляная планка переходит к госпоже Вань Янь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230508
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230508,
					"content": "Нет! Я не согласен! Экспедицию оплачивал и организовывал я, так почему я должен терпеть убыток?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230509
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230509,
					"content": "К тому же эта дамочка совершенно бесполезна. Зачем ей что-то давать?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230510
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230510,
					"content": "Ну всё, началось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230511,
						110230512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110230511,
					"content": "Эх...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				},
				{
					"id": 110230513,
					"content": "То есть вы хотите нарушить контракт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230514
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230514,
					"content": "Ну и что с того, если нарушу? Как работает механизм, я видел, и больше ты мне не нужен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230515
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230515,
					"content": "Не забывай, что я тебя нанял. Так почему я должен следовать твоим правилам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230516
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230516,
					"content": "Потому что ты заключил контракт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230517
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230517,
					"content": "Властелин Камня когда-то сказал: «На того, кто нарушит договор, обрушится гнев Камня».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230518
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230518,
					"content": "Это ваш бог, а я из Снежной. Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230519
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230519,
					"content": "Вряд ли тебе понравится «гнев Камня».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230512,
					"content": "Кто бы говорил о бесполезных людях...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				}
			]
		},
		{
			"id": 1102307,
			"completionStepIds": [
				1102307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102307",
							"2"
						],
						"stepId": 1102307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжун Ли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230701,
					"content": "Ещё будут изъяты твои сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230702
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230702,
					"content": "Идти дальше в руины ты не достоин. Покинь это место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230703
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230703,
					"content": "Чтоб тебя... Ну, погоди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230704
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230704,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230705
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110230705,
					"content": "Тоже мне археолог. Недолго ему хватило сил притворяться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230706,
						110230708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110230706,
					"content": "Хорошо, что мы оставались настороже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230707
					]
				},
				{
					"id": 110230707,
					"content": "И хорошо, что у Паймон нюх на лжецов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110230710,
					"content": "Проступок Климента породила жадность. Но нарушить контракт людей толкает много чего другого помимо жадности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230711
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230711,
					"content": "Сколько людей смогут подчинить себе свою алчность и продолжить следовать контракту, оказавшись перед предметом своих вожделений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230712
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230712,
					"content": "Давайте воспользуемся этой возможностью и будем друг перед другом честны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230713
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230713,
					"content": "А? В смысле, честны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110230714,
					"content": "Ни один из членов этой археологической экспедиции не пришёл сюда ради археологии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230715
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230715,
					"content": "Ч-что вы такое говорите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230716
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230716,
					"content": "Вот вы, госпожа, не имеете элементарных знаний в археологии, и можете распознать лишь пару простых реликвий, но по части Архонта Соли вы просто-таки знаток.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230717
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230717,
					"content": "Вас не заботят ни археология, ни реликвии. Только Архонт Соли является вашим подлинным интересом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230718
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230718,
					"content": "Насколько я знаю, легенды об Архонте Соли, которые вы упомянули на Бисерном пароме, передаются из поколения в поколение в зале Иньюань...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230719
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230719,
					"content": "Всё, хватит, замолчите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230720
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230720,
					"content": "...Вы, господин, человек большого ума и таланта. Я не ошиблась, когда собралась с духом и обратилась к вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230721
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230721,
					"content": "Вы правы, никакой я не археолог. Я из ведающего соляным промыслом зала Иньюань, который подчиняется Цисин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230722
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230722,
					"content": "Мои предки были людьми, которых Архонт Соли защитила во время Войны Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230723,
						110230724
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230723,
					"content": "Если подумать, ты ни разу не произнесла «Гео Архонт»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230725,
					"content": "Точно. Раз уж об этом зашла речь, то в Ли Юэ почти никто не употребляет имя «Моракс»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230726
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110230726,
					"content": "Во время Войны Архонтов Моракс убил нашу богиню из-за зависти к её силам, лишив нас опоры и оставив на произвол судьбы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230727
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230727,
					"content": "Мы... мы ненавидим его! Но Ли Юэ - это Ли Юэ Моракса, и он пишет историю так, как ему хочется...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230728
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230728,
					"content": "Поэтому я ищу доказательства злодеяния Моракса! Руки у него в крови, а в сердце жестокость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230729
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230729,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230730
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230730,
					"content": "Мы заключили контракт и обязались посмотреть правде в лицо. Ведь так, господин Чжун Ли?! Вы должны рассудить это дело по справедливости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230731
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230731,
					"content": "Разумеется. Добавлю только, что Ли Юэ - больше не Ли Юэ Моракса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230732
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230732,
					"content": "Следуйте за мной. Впереди нас ждут ответы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230724,
					"content": "#Хм, я ни разу не слышал{F#а}, чтобы ты сказала «Властелин Камня»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230708,
					"content": "Надеюсь, ты никогда не станешь такой же жадиной, как он, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230709
					]
				},
				{
					"id": 110230709,
					"content": "Паймон нравится мора, но Паймон не делает ничего плохого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1102309,
			"completionStepIds": [
				1102309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102309",
							"2"
						],
						"stepId": 1102309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжун Ли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230901,
					"content": "Это... меч?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230902
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230902,
					"content": "А! Сломанный меч! Это доказательство того, что Архонту Соли пришлось отбиваться! Но против Моракса она не выстояла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230903
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230903,
					"content": "Этот меч куда могущественнее соляной чаши и соляной планки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230904
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230904,
					"content": "Если его починить, то мир вновь увидит могущество Архонта Соли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230905
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230905,
					"content": "Хм... И правда похоже, что его бросили после поражения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230906
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110230906,
					"content": "Два обломка меча. С точки зрения археологии, это две отдельные реликвии. По контракту ты можешь взять себе только одну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230907
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230907,
					"content": "П-почему? Мы можем брать реликвии по очереди, но Климента здесь уже нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230908
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230908,
					"content": "Да. Но пункт про «один предмет из сокровищ» остаётся в силе. Нельзя сразу взять две реликвии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230909
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230909,
					"content": "Но, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230910
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230910,
					"content": "Эм... Чжун Ли, она, кажется, человек хороший, и за сокровище никто не дерётся. Так почему бы на этот раз не уступить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230911
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110230911,
					"content": "Нельзя идти на уступки, когда есть контракт. Если контракту не следовать, он будет нарушен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230912
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230912,
					"content": "Не пойдёт! Без другой части меч восстановить будет нельзя и силу Архонта Соли вернуть не получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230913
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230913,
					"content": "Я должна оставаться верной ей до конца, невзирая ни на что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230914
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230914,
					"content": "Пусть я нарушу контракт, мне всё равно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230915
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230915,
					"content": "Так ты уже решила? Тогда заплати цену за нарушение контракта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230916
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230916,
					"content": "Чжун Ли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230917
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110230917,
					"content": "А именно, на тебя «обрушится гнев Камня»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230918
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230918,
					"content": "Ничего страшного... Архонт Соли умерла, чтобы защитить свой народ. Моя жертва по сравнению с этим незначительна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230919
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230919,
					"content": "Наказывай меня как хочешь, лишь позволь взять доказательство моей веры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230920
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230920,
					"content": "Нет, девочек бить нельзя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230921
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110230921,
					"content": "...Возможно, такое наказание ты бы перенесла легче. Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230922
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230922,
					"content": "В качестве наказания я расскажу тебе правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230923
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230923,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230924
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230924,
					"content": "Правду... Вы хотите сказать, что правда будет моим наказанием?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230925
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230925,
					"content": "Да. Я расскажу тебе, как всё было на самом деле, и это станет ценой нарушенного контракта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230926
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230926,
					"content": "К сожалению, Архонт Соли, Хеврия, не была какой-то могущественной богиней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230927
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230927,
					"content": "Напротив, она была слабым божком и подчинялась остальным Архонтам. Она была такой немощной, что не смогла завоевать себе место среди семи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230928
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230928,
					"content": "Что вы такое говорите?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230929
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230929,
					"content": "Во время Войны Архонтов ради власти над Тейватом боги использовали всю свою силу и мудрость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230930
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230930,
					"content": "Но Хеврия предпочла сбежать. Она полагала, что спасёт себя и свой народ, если перед боем просто сдастся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230931
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230931,
					"content": "Война, однако, была долгой, и нападениям не было конца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230932
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230932,
					"content": "После бесчисленных уступок Хеврия потеряла все свои земли, кроме последнего пристанища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230933
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230933,
					"content": "Нет... Нет... Этого не может быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230934
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230934,
					"content": "В последние мгновенья у неё не было даже клинка, чтобы защитить свой народ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230935
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230935,
					"content": "Не было клинка? Но этот меч...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230936
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230936,
					"content": "Да. Этот меч - не реликвия Архонта Соли... Этим мечом богиня была убита.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230937
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230937,
					"content": "Убита этим мечом?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230938
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230938,
					"content": "Нет! Ты лжёшь! Это всё ложь! Ты пытаешься подорвать мою веру в Архонта Соли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230939
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230939,
					"content": "Я предупреждал, что расскажу тебе всё так, как было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230940
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230940,
					"content": "Вздор! Ты... У тебя не выйдет одурачить меня, последователь Моракса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230941
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230941,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230942
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110230942,
					"content": "Эй! Эй, постой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230943,
						110230945
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110230943,
					"content": "Похоже, для неё это было слишком.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230944
					]
				},
				{
					"id": 110230944,
					"content": "Таково наказание. Не нарушь она контракт, я бы не стал рассказывать ей эту жестокую историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230947,
					"content": "Давайте проследуем за ней. Боюсь, что в глубине руин будет нечто, что заставит её принять правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110230945,
					"content": "Всё, что ты сказал, правда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230946
					]
				},
				{
					"id": 110230946,
					"content": "Да. Иначе зачем мне было наказывать истиной? Я бы не стал рассказывать эту жестокую историю, не нарушь она контракт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Чжун Ли"
				}
			]
		},
		{
			"id": 1102310,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102310",
							"2"
						],
						"stepId": 1102310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вань Янь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231131,
					"content": "...Что же всё это?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231132
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110231132,
					"content": "Что они видели?.. Что они чувствовали?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231133
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110231133,
					"content": "Что... Что с ними случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231134
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110231134,
					"content": "Раз ты мне не веришь, давай идти дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231135
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231135,
					"content": "Открой эту дверь, и перед тобой предстанет всё, что тогда случилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				}
			]
		},
		{
			"id": 1102311,
			"completionStepIds": [
				1102311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102311",
							"2"
						],
						"stepId": 1102311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вань Янь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231101,
					"content": "На этом самом месте убили Хеврию. От неё ничего не осталось кроме соляных следов. Её предсмертные мгновения застыли навечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231102
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231103
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110231103,
					"content": "Далее было так. Однажды кто-то из её народа понял, что их милосердное, но слабое божество во время войны не способно защитить никого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231104
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231104,
					"content": "Война Архонтов была крайне жестокой. Они подумали, что чем мучиться от горечи очередного поражения, богине лучше было бы принять скорую кончину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231105
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231105,
					"content": "Но... что с этими статуями такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110231106,
					"content": "Каким бы ни было слабым божество, силу, которая вырывается из него в момент смерти, простым смертным не вынести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231107
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231107,
					"content": "Все, кто не смог убежать, превратились в эти изваяния.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231108
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231108,
					"content": "Те же, кого это бедствие обошло стороной, ушли в Ли Юэ, где попросили Властелина Камня об убежище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231109
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231109,
					"content": "Их потомки боялись останков Хеврии, и жили они под страхом вечного проклятия богини...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231110
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231110,
					"content": "Невзирая на опасность, они вернулись сюда, чтобы сломать меч и принести жертву в надежде задобрить разъярённую богиню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231111
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231111,
					"content": "Но в этом не было необходимости. Как могла смиренная до самого конца богиня гневаться на собственный народ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231112
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231112,
					"content": "Я... Я... Даже если так, я не могу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231113
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110231113,
					"content": "Это обман... Выдуманная история... Всё это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231114
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110231114,
					"content": "Даже не пытайся... поколебать мою веру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231115
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110231115,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231116
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110231116,
					"content": "На этот раз Чжун Ли был вовсе не милосерден...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110231117,
					"content": "Такова цена, которую она должна заплатить... И это необязательно плохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231118
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231118,
					"content": "Судя по её виду, боюсь, что ещё некоторое время её будут терзать сомнения... И даже если она не сможет сразу от них избавиться, то просто знать правду уже хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231119,
						110231121
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231119,
					"content": "Почему тебе столько всего известно о кончине Архонта Соли?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231120
					]
				},
				{
					"id": 110231120,
					"content": "В те далёкие времена история Хеврии также послужила мне предостережением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231123,
					"content": "Вера в давно погибшее божество ничего хорошего не принесёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231124
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231124,
					"content": "...Будь то вера в Хеврию, или Моракса, не важно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231125
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231125,
					"content": "Однажды народ Ли Юэ это поймёт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231126
					]
				},
				{
					"id": 110231126,
					"content": "#Здесь больше не на что смотреть. {NICKNAME}, пройдёшься со мной в каменный лес Гуюнь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231127
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231127,
					"content": "Хм? Чжун Ли, что ты затеял?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110231128,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231129
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231129,
					"content": "Посетить старые места, рассказать старые истории...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231130
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231130,
					"content": "Волей-неволей мысли порой уносят тебя к старым друзьям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110231121,
					"content": "Ты знал, как сломать печать, не из слухов, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231122
					]
				},
				{
					"id": 110231122,
					"content": "#Ты очень проницател{F#ьна}{M#ен}. Но дело тут не в мудрости, а в одном лишь возрасте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Чжун Ли"
				}
			]
		}
	]
}