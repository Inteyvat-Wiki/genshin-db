		{
			"id": 201901,
			"completionStepIds": [
				201901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201901",
							"2"
						],
						"stepId": 201901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Синьора",
					"Паймон",
					"Сёгун Райдэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20190101,
					"content": "Кто хочет, тот и заходит. Никаких приличий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190102
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190102,
					"content": "Не знала бы я, что это Тэнсюкаку, можно было бы подумать, что это какой-нибудь рынок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190103
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190103,
					"content": "#Теперь-то ты усвоил{F#а} урок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190104
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190104,
					"content": "О, нет... что она сделала с Кудзё Сарой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20190105,
					"content": "Наказывать инадзумцев за их проступки могу только я. У тебя нет такого права, Синьора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190106
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20190106,
					"content": "...Тогда мне очень жаль, сёгун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190107
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190107,
					"content": "Синьора!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190108
					]
				},
				{
					"id": 20190108,
					"content": "Знаю, знаю, всё не можешь меня забыть. Но не надо постоянно выкрикивать моё имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190109
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190109,
					"content": "#Понимаю, ты ненавидишь меня... И я не удивлена видеть тебя здесь. Ты следуешь за мной, словно дурная тень, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190110,
						20190111
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190110,
					"content": "Ты исподтишка распространяешь Глаза Порчи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				},
				{
					"id": 20190112,
					"content": "О, хочешь изобличить меня перед сёгуном?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190113
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190113,
					"content": "Хе-хе-хе... Я всего лишь дипломат из Снежной, и не имею ни малейшего понятия, о чём ты говоришь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190114
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190114,
					"content": "Да мы для неё пустое место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190115,
						20190116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20190115,
					"content": "За всех тех, кто лишился Глаз Бога...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190117,
					"content": "Довольно говорить о людях и вещах, которые меня не волнуют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190118
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190118,
					"content": "Они все были ничтожествами, чьи имена никто не вспомнит. У них хотя бы появилась возможность послужить великой революции на пути к вечности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190119
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190119,
					"content": "Разве это не величайшая честь, которая озарит их жалкие жизни?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190120
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190120,
					"content": "Поправьте меня, если я неправа, всемогущий сёгун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190121
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190121,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190122,
						20190123
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20190122,
					"content": "А ещё Сердце Бога Венти...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190124,
					"content": "#Зачем поминаешь старое? {F#Какая же ты злопамятная}{M#Какой же ты злопамятный}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190125
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190125,
					"content": "В мире нет ничего чище и возвышеннее идеалов Царицы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190126
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190126,
					"content": "#А все те мелочи, которые ты {F#упомянула}{M#упомянул}... всего лишь незначительные жертвы, не больше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190127
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190127,
					"content": "Пора положить всему этому конец.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190128
					]
				},
				{
					"id": 20190128,
					"content": "И кто же это сделает? Ты? Ха-ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190129
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190129,
					"content": "#Ты, знаешь ли, тоже мне {F#поднадоела}{M#поднадоел}. Но я не ожидала, что ты окажешься {F#такой безрассудной}{M#таким безрассудным}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190130
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190130,
					"content": "#Прежде чем ты скажешь что-нибудь, о чём пожалеешь, не забывай - ты {F#самая разыскиваемая преступница}{M#самый разыскиваемый преступник} Инадзумы... Так что хорошенько обдумай своё положение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190131
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190131,
					"content": "#Без приглашения {F#ворвалась}{M#ворвался} в резиденцию, отчитываешь меня перед сёгуном... Ты загоняешь себя в ловушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190132
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190132,
					"content": "Надеюсь, ты понимаешь, какая между нами пропасть, как в статусе... так и в силе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190133
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190133,
					"content": "Я вызываю тебя...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190134
					]
				},
				{
					"id": 20190134,
					"content": "На дворцовую дуэль!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190135
					]
				},
				{
					"id": 20190135,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190136
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190136,
					"content": "Приступайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190137
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20190137,
					"content": "#Ты не прекращаешь удивлять меня... {F#Научилась}{M#Научился} использовать законы страны себе на руку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190138
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190138,
					"content": "Оказаться с тобой на равных... признаться, такого я не ожидала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190139
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190139,
					"content": "Ты ведь знаешь, что... проигравший умирает? Ты точно хочешь этого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190140
					],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190140,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190141
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20190141,
					"content": "Хе-хе-хе... Тогда я снизойду и разделю с тобой этот танец... пока смерть не разлучит нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Синьора"
				},
				{
					"id": 20190123,
					"content": "И за людей Ли Юэ, жизни которых ты подвергла опасности...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190116,
					"content": "За всех тех, кто пострадал от Глаз Порчи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190111,
					"content": "Ты стремишься захватить власть над Инадзумой...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				}
			]
		}
	]
}