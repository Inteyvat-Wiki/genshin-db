				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727270101,
					"content": "#Послушай, чужезем{F#ка}{M#ец}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270102,
						727270104
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270102,
					"content": "Снова встретились.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270103
					]
				},
				{
					"id": 727270103,
					"content": "Рад тебя видеть! Ты по-прежнему в отличной форме...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270106
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270106,
					"content": "Гм, в общем, похоже, кто-то тайно устраивает очередной Хякунин икки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270107,
						727270112
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270107,
					"content": "Напомни, что такое Хякунин икки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270108
					]
				},
				{
					"id": 727270108,
					"content": "Хякунин икки изначально был праздником, проводимым кланом Тэнгу в виде весёлых боёв, чтобы отпраздновать памятные события и поднять всем настроение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270109
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270109,
					"content": "Во время этого турнира мастера боевых искусств и монстры забывают о старых обидах, чтобы насладиться чистым азартом схватки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270110
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270110,
					"content": "Говорят, что лучших бойцов ждёт награда - разные сокровища...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270111
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270111,
					"content": "Как бы там ни было, клан Тэнгу теперь вне закона, и я не знаю, кто проводит этот праздник сейчас, откуда берутся призы для победителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270115
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270115,
					"content": "Здесь слишком много людей, нас могут подслушать. Следуй за мной, как и в прошлый раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270116
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270116,
					"content": "Каябуки Иккэй приводит вас на небольшой остров в окрестностях Инадзумы...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 727270112,
					"content": "Новый Хякунин икки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270113
					]
				},
				{
					"id": 727270113,
					"content": "Да, возможно, твои подвиги так понравились публике, что многие зрители загорелись и решили сами поучаствовать в боях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270114
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270114,
					"content": "Честно говоря, я сам не ожидал, что новый Хякунин икки состоится так скоро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270115
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270104,
					"content": "А ты кто?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270105
					]
				},
				{
					"id": 727270105,
					"content": "Ты меня не помнишь? Гм, во время прошлого Хякунин икки я был занят тем, что записывал твои боевые подвиги, и не успел как следует тебя поздравить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270106
					],
					"speakerTitle": "Каябуки Иккэй"
				}
			]
		},
		{
			"id": 7272702,
			"completionStepIds": [
				7272702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7272702",
							"2"
						],
						"stepId": 7272702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каябуки Иккэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727270201,
					"content": "Ну, вот мы и на месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270202
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270202,
					"content": "Всё как в прошлый раз: проходишь через эти ворота, очень подозрительные на вид, и оказываешься на арене.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270203,
						727270204
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270203,
					"content": "Всё опять так подозрительно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270207
					]
				},
				{
					"id": 727270207,
					"content": "В общем, на этот раз я опять собираюсь запечатлеть твои невероятные подвиги. И буду болеть только за тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270208,
						727270209
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270208,
					"content": "Хорошо, жду не дождусь начала.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270210
					]
				},
				{
					"id": 727270210,
					"content": "Да, ещё на этот раз я надеюсь увидеть, как ты блестяще владеешь мечом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270209,
					"content": "Какой-то утомительный праздник...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270210
					]
				},
				{
					"id": 727270204,
					"content": "А каковы правила Хякунин икки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270205
					]
				},
				{
					"id": 727270205,
					"content": "Правила те же, что и в прошлый раз. Монстры, искатели приключений и воины со всех уголков Тейвата выходят на эту арену, чтобы принять участие в суровой битве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270206
					],
					"speakerTitle": "Каябуки Иккэй"
				},
				{
					"id": 727270206,
					"content": "Разумеется, как и в прошлый раз, ты можешь привести друзей и товарищей! Ведь «хякунин» в названии праздника означает, что чем больше народу, тем веселее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270207
					],
					"speakerTitle": "Каябуки Иккэй"
				}
			]
		}
	]
}