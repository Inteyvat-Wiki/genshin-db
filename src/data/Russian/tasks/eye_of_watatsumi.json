			"dialogs": [
				{
					"id": 721450101,
					"content": "«...Говорится, что у посланника Омиками три глаза: один - душа, один - зеркало, один - истина...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450102
					],
					"speakerTitle": "Древняя стела"
				},
				{
					"id": 721450102,
					"content": "«...Из пучин он поднялся, с <color=#00E1FFFF>юга</color>, перешёл <color=#00E1FFFF>север</color>, задержался на <color=#00E1FFFF>западных</color> холмах...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450103
					],
					"speakerTitle": "Древняя стела"
				},
				{
					"id": 721450103,
					"content": "«...Три глаза беспощадно сияли, отпугивая дракона...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450104
					],
					"speakerTitle": "Древняя стела"
				},
				{
					"id": 721450104,
					"content": "Паймон знакомы все эти слова, но вместе они как будто совсем ничего не значат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721450105,
					"content": "Похоже, что поблизости нет никаких зацепок... Давай попробуем использовать <color=#00E1FFFF>чувство стихий</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
