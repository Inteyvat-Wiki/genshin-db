			"dialogs": [
				{
					"id": 3180201,
					"content": "#Ого! Ты... почувствовал{F#а} мощь Гео?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3180202,
					"content": "Твоя связь со стихиями совсем не такая, как у носителей Глаза Бога. Похоже, что ты можешь переключаться между элементами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3180203,
					"content": "В таком случае тебе нужно помолиться статуе семи Архонтов, и стихии ответят тебе. Так же, как это случилось в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3180204,
					"content": "Мы в Ли Юэ. Это земля Гео Архонта. Поэтому статуя здесь выглядит немного иначе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3180205,
					"content": "Если снова захочешь использовать Анемо силы, можешь вернуть их себе у статуи семи Архонтов в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
