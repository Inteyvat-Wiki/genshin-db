			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чуно"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880601,
					"content": "О, это ты. Спасибо за фрагменты радужной надписи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880602
					],
					"speakerTitle": "Чуно"
				},
				{
					"id": 750880602,
					"content": "Но прогресс расшифровки небыстрый. Похоже на флогистоновую гравировку. Всё оказалось куда сложнее, чем я думал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880603
					],
					"speakerTitle": "Чуно"
				},
				{
					"id": 750880603,
					"content": "Я непременно должен расшифровать это, ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чуно"
				}
			]
		}
	]
}