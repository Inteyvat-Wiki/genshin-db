			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350101,
					"content": "Эх, сестрица...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350102,
						210350103
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350102,
					"content": "А? Сунь Юй?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				},
				{
					"id": 210350104,
					"content": "#Путешественни{F#ца}{M#к}! Какая удача! Не ожидал тебя здесь встретить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350105
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350105,
					"content": "Я... я тренируюсь. Скоро мне предстоит уехать из Ли Юэ и отправиться в странствие по далёким краям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350106,
						210350107
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350106,
					"content": "Почему ты вдруг решил уехать из Ли Юэ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350108,
					"content": "Эх, стыдно в этом признаться... Я всё время твердил, что хочу возродить школу Гухуа, но слова оставались словами... Я говорил, что ищу наставления у Адептов, а сам просто слонялся без дела по Заоблачному пределу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350109
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350109,
					"content": "Цю Эр не оставляет надежды, и я ей очень благодарен, но в глубине души понимаю, что так я никогда не смогу возродить школу Гухуа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350110
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350110,
					"content": "Недавно я ходил в город за покупками и повстречал там одного странствующего купца из Фонтейна. Мы с ним разговорились...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350111
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350111,
					"content": "И он сказал мне: «Ты никогда не найдёшь решения в том же месте, где возникла проблема».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350112
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350112,
					"content": "Я долго думал над его словами... Должно быть, купец посоветовал мне отправится в путешествие за пределы Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350113,
						210350114
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350113,
					"content": "Посмотреть мир - тоже неплохо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350115,
					"content": "Я тоже так думаю. Но... Цю Эр не хочет покидать Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350116
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350116,
					"content": "Обычно она сердится на меня только для вида, и я всегда знаю, как её успокоить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350117
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350117,
					"content": "Но теперь она рассердилась по-настоящему. Что бы я ни говорил, она отказывалась слушать, а кончился наш разговор тем, что она убежала в город одна... Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350118
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350118,
					"content": "#Ладно, тебе эти житейские мелочи едва ли интересны... Путешественни{F#ца}{M#к}, могу я попросить тебя об одном одолжении?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350119
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350119,
					"content": "Я владею некоторыми приёмами самообороны, но почти не использовал их на практике. Если я отправлюсь путешествовать, рано или поздно мне придётся показать, на что я способен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350120
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350120,
					"content": "#Путешественни{F#ца}{M#к}, я много слышал о твоих приключениях. Наверняка тебе известны разные способы, как обезвредить монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350121
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350121,
					"content": "Надеюсь, ты согласишься составить мне компанию? Мы отыщем каких-нибудь монстров в округе и сразимся с ними, а ты заодно дашь мне пару ценных советов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350122,
						210350123
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350122,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350125
					]
				},
				{
					"id": 210350125,
					"content": "Давай посмотрим... Поблизости есть одно местечко, где собралось много монстров. Давай пойдём туда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350123,
					"content": "Только боюсь, ты не успеешь разглядеть моих приёмов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350124
					]
				},
				{
					"id": 210350124,
					"content": "П-правда? Ха-ха-ха, тогда мне придётся просить тебя ещё об одном одолжении: действуй не так быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350125
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350114,
					"content": "Да, тебе надо развеяться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350107,
					"content": "Ты ведь хотел возродить школу Гухуа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350103,
					"content": "Ты что делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				}
			]
		},
		{
			"id": 2103502,
			"completionStepIds": [
				2103503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2103503",
							"2"
						],
						"stepId": 2103503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350201,
					"content": "Уф... Это и правда непросто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350202
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350202,
					"content": "Извини... Только выставил себя дураком. Не думал, что буду так нервничать перед лицом настоящего противника...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350203
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350203,
					"content": "#Словом... Мне нужно ещё тренироваться. Спасибо, путешественни{F#ца}{M#к}! Вот твоё вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350204
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210350204,
					"content": "Ты правда собираешься покинуть Ли Юэ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350205
					]
				},
				{
					"id": 210350205,
					"content": "Я пока не решил окончательно. Нужно всё как следует обдумать и... попытаться уговорить Цю Эр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				}
			]
		}
	]
}