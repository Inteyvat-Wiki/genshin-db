			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200101,
					"content": "#Хм. Каковы шансы, а, путешественни{F#ца}{M#к}? Санго была права насчёт того, что мы снова встретимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200102
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200102,
					"content": "Что привело тебя сюда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200103
					]
				},
				{
					"id": 220200103,
					"content": "Санго попросила меня помочь закончить то дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200104
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200104,
					"content": "Что по сути подразумевает просто принести досинам десерт, чтобы поблагодарить их за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200105,
						220200106
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200105,
					"content": "Это они должны нас благодарить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				},
				{
					"id": 220200107,
					"content": "Это правда. Но взгляни на это, как на лёгкий способ улучшить наши отношения с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200108
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200108,
					"content": "В конце концов, когда-нибудь нашему детективному агентству может понадобиться их помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200109,
						220200110
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200109,
					"content": "Напоминает способ мышления Санго...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200111,
					"content": "Ха-ха, да. Твоя интуиция верна, как никогда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200112
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200112,
					"content": "А что думаешь обо всем этом лично ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200113
					]
				},
				{
					"id": 220200113,
					"content": "Я? Амано и Анду... Мы были коллегами, так что это нормально - проявить немного доброты, угостив их десертом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200114
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200114,
					"content": "Но... Санго также попросила меня расследовать еще одно дело сегодня, так что время немного поджимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200115
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200115,
					"content": "#Путешественни{F#ца}{M#к}, ты не мог{F#ла} бы помочь мне доставить эти десерты трём людям?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200116,
						220200118
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200116,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200117
					]
				},
				{
					"id": 220200117,
					"content": "Спасибо за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200121,
					"content": "Вот три упаковки десертов для Амано, Андо и господина Овады.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200122
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200122,
					"content": "Господина Овады?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200123
					]
				},
				{
					"id": 220200123,
					"content": "Он также мой... бывший коллега. Он был добр ко мне, когда я служил в полиции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200124
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200124,
					"content": "Он также помог нам наладить сотрудничество с полицией в одном из прошлых дел о серийных кражах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200125
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200125,
					"content": "#Тогда я оставляю это на тебя, Путешественни{F#ца}{M#к}. После того, как ты доставишь десерты, встретимся снова на этом же месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200118,
					"content": "Я думаю, будет лучше, если ты сам их доставишь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200119
					]
				},
				{
					"id": 220200119,
					"content": "Но... Просьба Санго важнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200120
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200120,
					"content": "Я найду время, чтобы посетить их троих немного позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220200110,
					"content": "Санго, должно быть, научила тебя этому.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200106,
					"content": "Это разве не мы им помогали?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				}
			]
		},
		{
			"id": 2202002,
			"completionStepIds": [
				2202002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202002",
							"2"
						],
						"stepId": 2202002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Амано",
					"Андо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200201,
					"content": "#А, это ты, путешественни{F#ца}{M#к}. Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200202
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220200202,
					"content": "Это вам от Рюдзи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200203
					]
				},
				{
					"id": 220200203,
					"content": "О? Давайте посмотрим... Ух ты, моти с сакурой... Ах, этот Рюдзи, право, не стоило...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200204
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220200204,
					"content": "#Эй, Андо. Перестань так осторожничать. Путешественни{F#ца}{M#к} может быть и чужезем{F#ка}{M#ец}, но {F#она}{M#он} недавно очень помог{F#ла} нам, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200205
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220200205,
					"content": "Удивлён, что Рюдзи все ещё помнит, что нам нравится. То, что мы с ним бывшие коллеги, имеет свои плюсы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200206
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220200206,
					"content": "Вы работали вместе с Рюдзи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200207
					]
				},
				{
					"id": 220200207,
					"content": "А? Он не рассказывал тебе об этом? Мы работали с ним в течение небольшого промежутка времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200208
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220200208,
					"content": "Но потом он вдруг оказался втянутым в один инцидент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200209
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220200209,
					"content": "Благодаря Санго настоящий преступник был пойман, а Рюдзи оправдан. Позже он ушёл из полицейского участка и стал работать на Санго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200210
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220200210,
					"content": "Это всё, что мне известно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200211
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220200211,
					"content": "Ладно. Не будем больше об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200212
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220200212,
					"content": "Правда. В любом случае с Санго ему живётся гораздо лучше, чем с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200213
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220200213,
					"content": "Если бы я мог, я бы тоже хотел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200214
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220200214,
					"content": "Ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200215
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220200215,
					"content": "#Гм! Кстати, спасибо, Путешественни{F#ца}{M#к}. Я позабочусь об этих десертах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200216
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220200216,
					"content": "Передавай от меня привет Рюдзи и Санго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Амано"
				}
			]
		},
		{
			"id": 2202003,
			"completionStepIds": [
				2202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202003",
							"2"
						],
						"stepId": 2202003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Овада",
					"Уэсуги"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200301,
					"content": "#А? Ты... и есть т{F#а}{M#от} сам{F#ая}{M#ый} Путешественни{F#ца}{M#к}, да? Я слышал, как Амано упоминал тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200302
					],
					"speakerTitle": "Овада"
				},
				{
					"id": 220200302,
					"content": "У тебя ко мне есть какое-то дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200303
					],
					"speakerTitle": "Овада"
				},
				{
					"id": 220200303,
					"content": "Это от Рюдзи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200304
					]
				},
				{
					"id": 220200304,
					"content": "Ух ты, моти с сакурой... Ну, тогда я не могу просто так взять и съесть его. Мне нужно найти хорошее место, чтобы вдоволь насладиться им.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200305
					],
					"speakerTitle": "Овада"
				},
				{
					"id": 220200305,
					"content": "Уэсуги, пожалуйста, подмени меня ненадолго. Если кто-нибудь придёт ко мне, попроси их немного подождать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200306
					],
					"speakerTitle": "Овада"
				},
				{
					"id": 220200306,
					"content": "Но сейчас рабочее время, господин Овада...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200307
					],
					"speakerTitle": "Уэсуги"
				},
				{
					"id": 220200307,
					"content": "А-ха-ха, всё в порядке. Я просто выйду на минутку подышать воздухом. Скоро вернусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200308
					],
					"speakerTitle": "Овада"
				},
				{
					"id": 220200308,
					"content": "Эх... хорошо, но, пожалуйста, возвращайтесь скорее. Если зайдёт кто-нибудь из высшего руководства...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200309
					],
					"speakerTitle": "Уэсуги"
				},
				{
					"id": 220200309,
					"content": "Не волнуйся, мы только что раскрыли дело, так что если кто и зайдёт то лишь за тем, чтобы похвалить нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200310
					],
					"speakerTitle": "Овада"
				},
				{
					"id": 220200310,
					"content": "Всё остальное оставляю на твое усмотрение, Уэсуги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200311
					],
					"speakerTitle": "Овада"
				},
				{
					"id": 220200311,
					"content": "#Путешественни{F#ца}{M#к}, пройдись со мной немного. Я знаю идеальное место, где можно насладиться этими моти с сакурой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Овада"
				}
			]
		},
