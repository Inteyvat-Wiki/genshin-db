			"dialogs": [
				{
					"id": 706960101,
					"content": "#Давно не виделись, малыш. Где ты путешествовал{F#а} в последнее время?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960102
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 706960102,
					"content": "Вы рассказываете Мико о Минни, Легионе Пылких Сердец и о забеге на Драконьем хребте.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960103
					]
				},
				{
					"id": 706960103,
					"content": "О, как мило.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960104
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 706960104,
					"content": "Для них это было настоящим приключением - приехать издалека, пересечь границы стран, чтобы встретиться с единомышленниками... Ах, эта история наполнена романтикой молодости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960105
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 706960105,
					"content": "Похоже, у «Саги Пылких Сердец» довольно много поклонников. Может, пора выпустить ещё один тираж?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960106
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 706960106,
					"content": "Когда есть такая преданная армия поклонников, вполне справедливо выразить им свою благодарность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960107
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 706960107,
					"content": "Как насчёт бесплатных комиксов? Хм... Вас довольно много, нужно убедиться, что на всех хватит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960108,
						706960109
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 706960108,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				},
				{
					"id": 706960110,
					"content": "Это первые издания - их нигде не купишь. Береги их, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 706960109,
					"content": "Обязательно поделюсь со всеми.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				}
			]
		},
