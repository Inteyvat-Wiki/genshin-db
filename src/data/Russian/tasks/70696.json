			"dialogs": [
				{
					"id": 706960201,
					"content": "Мико дала нам целую кучу комиксов. Раз мы собираемся поделиться ими с остальными, давай выставим где-нибудь, чтобы все могли их видеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706960202,
					"content": "Давай поставим их рядом с книжным киоском в лагере Легиона Пылких Сердец. Так всем будет удобно их просматривать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706960203,
					"content": "Вы расставляете комиксы от Мико на полках книжного шкафа.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960204
					]
				},
				{
					"id": 706960204,
					"content": "Отлично, смотрится хорошо! Теперь все смогут подойти и выбрать что-то, когда у них будет свободное время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
