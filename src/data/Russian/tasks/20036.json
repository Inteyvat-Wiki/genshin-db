					"Глория"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360301,
					"content": "Вы всё сделали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360302
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360302,
					"content": "Очень сильный ветер...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360303
					]
				},
				{
					"id": 200360303,
					"content": "Так даже лучше, семена одуванчиков разлетятся далеко-далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360304
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360304,
					"content": "Надеюсь, они найдут Годвина, и он услышит мои слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360305
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360305,
					"content": "Дайте мне руку... Это вам. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360306
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360306,
					"content": "Я хочу ещё многое сказать Годвину. В будущем, мне понадобится ваша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Глория"
				}
			]
		}
	]
