				"points": []
			},
			"dialogs": [
				{
					"id": 200360101,
					"content": "Годвин! Почему так долго?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360102
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360102,
					"content": "Привет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360103
					]
				},
				{
					"id": 200360103,
					"content": "#Мне знаком ваш голос... Путешественн{F#ица}{M#ик} из далёких стран! Хвала Анемо Архонту, ибо ветер направил вас в эти места. У меня есть к вам одна просьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360104
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360104,
					"content": "Годвин - мой парень! Он рыцарь Ордо Фавониус. Когда-то давно он покинул город и с тех пор так и не возвращался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360105
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360105,
					"content": "Больше я его не видела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360106
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360106,
					"content": "Я так переживаю! Бедный Годвин... Что, если на него напали хиличурлы или орден Бездны? А вдруг он поранился? Его нет уже очень давно... Вдруг он нашёл себе другую?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360107
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360107,
					"content": "Ох, это уже перебор. Простите меня, пожалуйста. Матушка говорит, что одуванчики могут унести мысли человека далеко-далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360108
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360108,
					"content": "Прошу тебя, собери для меня три семечка одуванчика в долине Ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360109,
						200360110
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360109,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360111
					]
				},
				{
					"id": 200360111,
					"content": "Спасибо тебе! Да хранит тебя ветер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360110,
					"content": "Мне некогда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360112
					]
				},
				{
					"id": 200360112,
					"content": "Подожди! Умоляю, помоги мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Глория"
				}
			]
		},
