				"points": []
			},
			"dialogs": [
				{
					"id": 200360201,
					"content": "С возвращением! Вы принесли семена одуванчика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360202
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360202,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360203
					]
				},
				{
					"id": 200360203,
					"content": "Спасибо! Положите их мне прямо в руку, иначе я их потеряю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360204
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360204,
					"content": "Тебе столько хватит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360205
					]
				},
				{
					"id": 200360205,
					"content": "Положите мне их в руку, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360206
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360206,
					"content": "Этого хватит. Теперь я могу сказать им всё то, что я собиралась сказать Годвину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360207
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360207,
					"content": "Пожалуйста, закройте уши и не подслушивайте! Это личные разговорчики влюблённых, ну вы поняли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360208
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360208,
					"content": "Я закончила. А теперь, отнесите их к статуе Анемо Архонта и развейте по ветру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360209
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 200360209,
					"content": "Ветер донесёт мои слова до Годвина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Глория"
				}
			]
		},
		{
			"id": 2003603,
