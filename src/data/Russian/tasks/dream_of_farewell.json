			"dialogs": [
				{
					"id": 130150701,
					"content": "Оказывается, мы с Нассером отлично ладим. Мы оба очень прямолинейны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150702
					],
					"speakerTitle": "Дебби"
				},
				{
					"id": 130150702,
					"content": "А ещё мы оба действовали наперекор Дендро Архонту: один наяву, а другой во сне. Ха-ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нассер"
				}
			]
		},
		{
			"id": 1301508,
