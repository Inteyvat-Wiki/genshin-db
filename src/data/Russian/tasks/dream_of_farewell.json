			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Петруш",
					"Нахида"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150101,
					"content": "Отлично, вы тоже проснулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150102
					],
					"speakerTitle": "Петруш"
				},
				{
					"id": 130150102,
					"content": "Все просыпаются один за другим. Мы слышали подобные новости и в городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150103
					],
					"speakerTitle": "Петруш"
				},
				{
					"id": 130150103,
					"content": "Похоже, проблема решена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150104
					],
					"speakerTitle": "Петруш"
				},
				{
					"id": 130150104,
					"content": "Угу, правда, без трудностей не обошлось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150105
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150105,
					"content": "Скоро здесь соберётся много народу. Пожалуйста, помоги поддержать здесь порядок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150106
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150106,
					"content": "А мы сходим в Академию и вернёмся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нахида"
				}
			]
		},
		{
			"id": 1301502,
			"completionStepIds": [
				1301502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301502",
							"2"
						],
						"stepId": 1301502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ситт",
					"Нахида"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150201,
					"content": "О, великий Дендро Архонт. Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150202
					],
					"speakerTitle": "Ситт"
				},
				{
					"id": 130150202,
					"content": "Я хочу проверить списки учёных Кшахревара. Мне нужен учёный, который впал в забытье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150203
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150203,
					"content": "Хорошо, секундочку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150204
					],
					"speakerTitle": "Ситт"
				},
				{
					"id": 130150204,
					"content": "Некоторое время спустя...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130150205
					]
				},
				{
					"id": 130150205,
					"content": "Извините за долгое ожидание, Дендро Архонт. Действительно, есть один учёный, впавший в кому из-за небрежного обращения с Акашей. Его зовут Бейнуни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150206
					],
					"speakerTitle": "Ситт"
				},
				{
					"id": 130150206,
					"content": "Он до сих пор без сознания и находится на лечении в Бимарстане.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150207
					],
					"speakerTitle": "Ситт"
				},
				{
					"id": 130150207,
					"content": "Разве его зовут не Мозеис?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130150208,
					"content": "Видимо, он не хотел, чтобы его узнали и побеспокоили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150209
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150209,
					"content": "Передай, пожалуйста, хранящиеся здесь знания матрам. Пусть они импортируют их в мозг Бейнуни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150210
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150210,
					"content": "Хорошо, но, исходя из соображений безопасности, мне нужно знать причину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150211
					],
					"speakerTitle": "Ситт"
				},
				{
					"id": 130150211,
					"content": "Всё просто. Это его сознание, которое было заперто во сне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150212
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150212,
					"content": "Своими действиями во сне он нарушил порядок в Сумеру. После его пробуждения я расскажу обо всём генералу махаматре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150213
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150213,
					"content": "Ясно, я всё сделаю. Спасибо, Дендро Архонт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150214
					],
					"speakerTitle": "Ситт"
				},
				{
					"id": 130150214,
					"content": "Да, хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150215
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150215,
					"content": "Думаю, участники Мгновения сновидений уже собрались. Пора возвращаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нахида"
				}
			]
		},
		{
			"id": 1301503,
			"completionStepIds": [
				1301503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301503",
							"2"
						],
						"stepId": 1301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нахида"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150301,
					"content": "Давай тихонько послушаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130150302,
					"content": "Интересно, что она собирается сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130150303,
					"content": "Приветствую всех, кто только что пробудился!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150304
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150304,
					"content": "Мне жаль, что пришлось потревожить ваши сладкие сны. Я также хочу извиниться за несколько суровое обращение во сне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150305
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150305,
					"content": "Сны обладают удивительной силой. Они вдохновляют нас стойко переносить невзгоды и помогают достичь желаемого тем, кто имеет большие стремления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150306
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150306,
					"content": "Но они также могут пользоваться слабостью, спутать сознание и извращать истину. К сожалению, вы стали жертвами изощрённого заговора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150307
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150307,
					"content": "Я уже говорила, что только учусь, и пока не могу прочувствовать всю боль вашей утраты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150308
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150308,
					"content": "Но если оглянуться вокруг, можно увидеть людей, переживших нечто подобное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150309
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150309,
					"content": "Вы должны гордиться тем, что собрались здесь и вместе смотрите в будущее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150310
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150310,
					"content": "Дорога жизни очень длинная, и трудно предвидеть её конец. Из-за этого может возникнуть множество вопросов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150311
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150311,
					"content": "«В чём смысл жизни? Какова моя цель? Почему я должен страдать?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150312
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150312,
					"content": "Остановиться, перестать размышлять, снова и снова повторять привычные действия - это путь наименьшего сопротивления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150313
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150313,
					"content": "Каждый раз, когда возникают подобные мысли, просто посмотрите на людей и события, которые вас окружают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150314
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150314,
					"content": "Кто-то трудится весь день, чтобы у его семьи был горячий ужин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150315
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150315,
					"content": "Кто-то колесит по свету, чтобы создавать произведения искусства, находящие отклик по всему Тейвату.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150316
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150316,
					"content": "Кто-то ищет тайны мира, чтобы предотвратить стремительно надвигающуюся катастрофу, о которой ещё никто не ведает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150317
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150317,
					"content": "Смысл жизни состоит не только в зацикленности на себе. Каждым своим действием мы формируем себя и окружающий мир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150318
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150318,
					"content": "Ваши поступки сохранятся в памяти друзей и родных и, возможно, станут благом для незнакомцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150319
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150319,
					"content": "Вот почему многие люди не боятся выбирать новый путь, даже если ради этого им приходится терпеть мучения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150320
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150320,
					"content": "Если вы пойдёте по тому же тернистому, но наполненному смыслом пути, ответы на эти жизненные вопросы вы постепенно узнаете, но они перестанут быть судьбоносными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150321
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150321,
					"content": "Но если вы считаете, что жизнь пуста и эфемерна, то рано или поздно она такой и станет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150322
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150322,
					"content": "Вы вольны выбирать свой жизненный путь, но как Архонт, я должна сначала пробудить вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150323
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150323,
					"content": "Захотите ли вы погрузиться в сладкие сны, отказавшись от реальности, зависит только от вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нахида"
				}
			]
		},
		{
			"id": 1301504,
			"completionStepIds": [
				1301504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301504",
							"2"
						],
						"stepId": 1301504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нахида"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150401,
					"content": "Молодец! Во сне этот учёный чуть не переспорил даже Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130150402,
					"content": "Он умело манипулирует человеческими слабостями, но, возможно, он уже и сам давно стал их пленником.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150403
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150403,
					"content": "Этот сон был невероятно прекрасен и притягателен. Он туманил разум обычных людей, и они погрязали в нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150404
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150404,
					"content": "Но пока есть силы проснуться, ты можешь идти по жизни вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150405
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150405,
					"content": "Ты тоже многому научилась, Нахида.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150406
					]
				},
				{
					"id": 130150406,
					"content": "Что? Почему ты так говоришь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150407
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150407,
					"content": "Теперь ты по-настоящему сочувствуешь другим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150408
					]
				},
				{
					"id": 130150408,
					"content": "Верно! Хоть ты и говоришь, что тебе чужды человеческие чувства, но видно, как ты внимательна к людям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130150409,
					"content": "Ты произнесла эту речь, словно встала на их место. Это же здорово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130150410,
					"content": "Спасибо! За всё это время я услышала столько печальных историй, и некоторые поразили меня в самое сердце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150411
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150411,
					"content": "Поступки жертв сна нельзя назвать предосудительными, нельзя сказать, что они многого хотели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150412
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150412,
					"content": "И я понимаю, почему они пытались бороться с нами и защитить сон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150413
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150413,
					"content": "Но моё понимание и ощущения не сравнятся даже с сотой долей тех мучений, которые они испытывают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150414
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150414,
					"content": "Я не могу называть эту сотую долю сочувствием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150415
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150415,
					"content": "Конечно, можешь. У тебя слишком высокие требования к себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150416,
						130150417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130150416,
					"content": "Абсолютного сочувствия не бывает.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				},
				{
					"id": 130150418,
					"content": "Хи-хи, ладно. Наверное, прогулка и в самом деле пойдёт мне на пользу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150419
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150419,
					"content": "Эмоции разительно отличаются от знаний, потому мне порой сложно описать их словами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150420
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150420,
					"content": "Бейнуни... или Мозеис считает, что я не знаю, что такое горечь утраты, но у меня есть смутное чувство, что это не так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150421
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150421,
					"content": "Войдя в сон, я ощутила, как меня обволакивает поток тепла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150422
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150422,
					"content": "Это тепло словно вернуло меня к началу моей жизни, и мне не хотелось просыпаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150423
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150423,
					"content": "(Неужели она что-то видела?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150424
					]
				},
				{
					"id": 130150424,
					"content": "Но как только я открыла глаза, это ощущение исчезло без следа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150425
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150425,
					"content": "Это было похоже на стёртые с листа надписи: я не видела слов, но могла разобрать оставшиеся от них следы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150426
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150426,
					"content": "После этого сна я могу с уверенностью сказать, что значение этого потока тепла не так уж и важно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150427
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150427,
					"content": "Ясно одно: когда-то эта тёплая сила меня поддерживала. Я здесь благодаря ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150428
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150428,
					"content": "Углубляться в его истинную природу будет неправильно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150429
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150429,
					"content": "Моя речь должна вдохновить людей. Будет прискорбно, если я не последую собственным идеалам, хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150430
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150430,
					"content": "(Великая властительница Руккхадевата сформировала Нахиду своими деяниями.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150431
					]
				},
				{
					"id": 130150431,
					"content": "(Даже если мир забудет о ней, разум и воля Нахиды будут доказательством её существования.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150432
					]
				},
				{
					"id": 130150432,
					"content": "(Лучше будет отнестись с уважением к их решению, чем сказать ей правду.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150433
					]
				},
				{
					"id": 130150433,
					"content": "Что с тобой? У тебя такой серьёзный вид.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150434
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130150434,
					"content": "Ты уже не первый раз хочешь что-то сказать, но останавливаешься на полуслове. Может, поделишься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150435,
						130150436
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150435,
					"content": "#Я {F#забыла}{M#забыл}, что {F#хотела}{M#хотел} сказать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150437,
					"content": "Ха-ха, вот как.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150438
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150438,
					"content": "Как насчёт потягушек после пробуждения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150439
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150439,
					"content": "Начинается новый день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130150436,
					"content": "Это неважно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150417,
					"content": "Не сомневайся в себе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				}
			]
		},
