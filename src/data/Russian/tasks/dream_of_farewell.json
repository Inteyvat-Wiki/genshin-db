			"dialogs": [
				{
					"id": 130150901,
					"content": "Раз уж мы соседи во сне, может, будем жить вместе? Что скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150902
					],
					"speakerTitle": "Инас"
				},
				{
					"id": 130150902,
					"content": "Договорились. Похоже, арендная плата мне тоже не по карману... Но всё наладится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тана"
