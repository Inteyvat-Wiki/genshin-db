			},
			"dialogs": [
				{
					"id": 130150601,
					"content": "Я собираюсь отправиться в путешествие, а это растение захвачу с собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150602
					],
					"speakerTitle": "Катия"
				},
				{
					"id": 130150602,
					"content": "Я больше не могу ждать. Раз это была тайна, которую профессор Аиша хотела найти любой ценой, я тоже должна до неё добраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150603
					],
					"speakerTitle": "Катия"
				},
				{
					"id": 130150603,
					"content": "Спасибо вам. Надеюсь, мы ещё встретимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катия"
				}
			]
		},
