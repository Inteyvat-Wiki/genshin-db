				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Отчаянный Паллад",
					"Джоэль",
					"Йозерф",
					"Сайрус"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708030101,
					"content": "А? Это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030102,
						708030103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708030102,
					"content": "Это отец Джоэля?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				},
				{
					"id": 708030104,
					"content": "#{NICKNAME}, ты {F#вернулась}{M#вернулся}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030105
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708030105,
					"content": "Позвольте представить Йозерфа, отца Джоэля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030106
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708030106,
					"content": "#Папа! Это {F#та самая путешественница}{M#тот самый путешественник}, о {F#которой}{M#котором} я тебе рассказывал. {NICKNAME} много раз помогал{F#а} мне, а в этот раз мы даже вместе слепили снеговика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030107
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 708030107,
					"content": "Джоэль рассказал мне о тебе. Даже не знаю, как отблагодарить тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030108,
						708030109
					],
					"speakerTitle": "Йозерф"
				},
				{
					"id": 708030108,
					"content": "#Я рад{F#а}, что вы наконец-то воссоединились...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030110,
					"content": "Это просто потрясающе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708030111,
					"content": "Неплохо, Паллад, совсем неплохо! В этот раз ты отлично поработал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030112
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708030112,
					"content": "«В этот раз»? Что случилось в прошлый раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708030113,
					"content": "Помните, я говорил про человека, которого видел на Драконьем хребте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030114
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708030114,
					"content": "После того как вы проводили меня на гору и победили тех монстров, я продолжил прочёсывать местность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030115
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708030115,
					"content": "Тогда я поскользнулся и скатился с горы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030116
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708030116,
					"content": "Скатился с горы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708030117,
					"content": "Я упал в сугроб, поэтому не поранился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030118
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708030118,
					"content": "Я уже собирался возвращаться, когда услышал шум в стороне... а потом кто-то выскочил прямо на меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030119
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708030119,
					"content": "Я не сразу понял, что это тот человек, которого я искал. Я подумал, что он один из искателей приключений, которые участвуют в поисково-спасательной операции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030120
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708030120,
					"content": "Но потом мне стало понятно, что у него проблемы с памятью. Он даже не помнил своё собственное имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030121
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708030121,
					"content": "Было очень холодно, я предложил спуститься в лагерь и уже там поговорить более обстоятельно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030122
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708030122,
					"content": "Мы вернулись в лагерь, столкнулись с Джоэлем. Он застыл на секунду с совершенно ошеломлённым выражением лица, а затем начал кричать: «Папа! Папа!». В этот момент к Йозерфу вдруг начала возвращаться память.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030123
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708030123,
					"content": "Папа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030124
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 708030124,
					"content": "Джоэль, папа здесь, папа вернулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030125
					],
					"speakerTitle": "Йозерф"
				},
				{
					"id": 708030125,
					"content": "Йозерф, ты больше ничего не помнишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708030126,
					"content": "«Принцесса-кабан», кормление лис на Драконьем хребте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708030127,
					"content": "Простите, я ничего не помню. Может быть, это из-за травмы головы? Я не уверен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030128
					],
					"speakerTitle": "Йозерф"
				},
				{
					"id": 708030128,
					"content": "Очнувшись, я обнаружил, что весь в крови. Мои вещи исчезли, и ничто не указывало на то, кто я и как я здесь оказался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030129
					],
					"speakerTitle": "Йозерф"
				},
				{
					"id": 708030129,
					"content": "Я заполз в пещеру и устроился там, чтобы постепенно восстановиться. После того как мои ноги и ступни немного окрепли, мои охотничьи навыки помогли мне выжить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030130
					],
					"speakerTitle": "Йозерф"
				},
				{
					"id": 708030130,
					"content": "Папа... я так переживал за тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030131
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 708030131,
					"content": "Джоэль, всё хорошо, не плачь. Папа рядом, папа с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030132
					],
					"speakerTitle": "Йозерф"
				},
				{
					"id": 708030132,
					"content": "Йозерф, что ты будешь делать дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708030133,
					"content": "Я... я просто хочу побыть со своей семьёй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030134
					],
					"speakerTitle": "Йозерф"
				},
				{
					"id": 708030134,
					"content": "Очень хорошо, что ты вернулся целым и невредимым. Можно сказать, что это история со счастливым концом, ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030135
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708030135,
					"content": "Потерять опору и скатиться с горы... Паллад, тебе ещё предстоит пройти долгий путь, прежде чем твои навыки искателя приключений достигнут совершенства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030136
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708030136,
					"content": "По возвращении в Гильдию тебя ждёт ряд дополнительных занятий со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030137
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708030137,
					"content": "Н-но, господин Сайрус, по-моему, я в полной мере исправил свою ошибку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030138
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708030138,
					"content": "Никаких возражений! Мы возвращаемся в Гильдию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030139
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708030139,
					"content": "Но, Господин Сайрус! Дайте мне хотя бы отдохнуть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708030109,
					"content": "Хорошо, что хорошо кончается...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030103,
					"content": "Они похожи как две капли воды, только этот повыше...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				}
			]
		}
	]
}