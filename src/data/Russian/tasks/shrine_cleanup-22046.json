			"dialogs": [
				{
					"id": 220460101,
					"content": "В святилище опять бардак...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460102
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220460102,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460103
					]
				},
				{
					"id": 220460103,
					"content": "Мяу, это снова ты? Ты вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460104
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220460104,
					"content": "Если в святилище не убираться постоянно, то грязь скапливается очень быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460105
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220460105,
					"content": "Нельзя, чтобы люди, желающие выразить своё почтение, приходили в грязное святилище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460106
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220460106,
					"content": "Можно попросить тебя прибраться в святилище, как прежде?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460107,
						220460112
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220460107,
					"content": "Разве ты не можешь попросить Тайсукэ и Эйко?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460108
					]
				},
				{
					"id": 220460108,
					"content": "Я ни за что первая не заговорю с теми людьми в зелёном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460109
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220460109,
					"content": "Тот высокий человек всегда странно на меня смотрит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460110
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220460110,
					"content": "А другой человек в зелёном никогда не выглядит особенно... заинтересованным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460111
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220460111,
					"content": "Мяу-мяу, они не очень благонадёжны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220460115,
					"content": "В этом деле я могу положиться только на тебя. Просто используй длинную палку и воду для уборки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460116,
						220460117
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220460116,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460118,
					"content": "Как бы там ни было, я поручаю это тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460119
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220460119,
					"content": "Я буду ждать тебя здесь, мяу-мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220460117,
					"content": "Более-менее понятно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460112,
					"content": "Можно попросить господина Осиму...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460113
					]
				},
				{
					"id": 220460113,
					"content": "Человек с камнями только и занят, что своим постукиваниями. Кто знает, что он делает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460114
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220460114,
					"content": "В конце концов, он закончил с камнем. Что он там стучит на этот раз... Надоело...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "Нэко"
				}
			]
		},
