					}
				]
			},
			"dialogs": [
				{
					"id": 60031101,
					"content": "Пусть даже рукотворный Лунный Светоч ещё не готов, сейчас Дотторе сильнее нас... Сражаться с ним бесполезно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031102
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 60031102,
					"content": "Быстро!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031103
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 60031103,
					"content": "Идём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031104
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60031104,
					"content": "Я всегда считал, что бежать разумнее, чем сдаваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031105
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60031105,
					"content": "Это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60031106
					]
				},
