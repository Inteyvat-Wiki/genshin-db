			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Йотаутас"
				],
				"points": [
					{
						"sceneId": 20322,
						"position": [
							309.422,
							310.76,
							540.634
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 60030501,
					"content": "Вы... Как вы посмели сюда заявиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030502
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030502,
					"content": "Насколько нам известно, Доктор может находиться в этой лаборатории. А ты явно пытаешься бежать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030503
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60030503,
					"content": "Ха, если вы пришли устроить неприятности господину Доктору... сомневаюсь, что у вас что-нибудь получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030504
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030504,
					"content": "Возможно. Но вы можете сберечь себе жизнь. Если начнёте говорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030505
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60030505,
					"content": "До вас здесь уже были две Предвестницы. И что с того? Если господин Доктор пошёл на такой шаг, он не мог не подготовиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030506
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030506,
					"content": "Вот как? А по-моему, тебе не очень нравится быть его подчинённым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030507
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030507,
					"content": "К тому же здесь повсюду видны следы монстров, чувствуется их дыхание. Тебе по нутру соседство с монстрами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030508
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030508,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030509
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030509,
					"content": "Нам нужно знать, что именно замышляет Доктор. Ты должен рассказать, если тебе хоть что-то известно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030510
					]
				},
				{
					"id": 60030510,
					"content": "И дело не только в наших интересах. Его действия могут отразиться на всём Нод-Крае. И даже на Снежной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030511
					]
				},
				{
					"id": 60030511,
					"content": "...Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030512
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030512,
					"content": "Господин... он создаёт нечто абсолютно невероятное. Я думаю, этот план зрел у него уже давно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030513
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030513,
					"content": "Недавно господин Дотторе сказал, что собирается в Снежную, но я не ожидал, что он вернётся так скоро. И ещё он привёз с собой два ярких самоцвета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030514
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030514,
					"content": "...Это Лунные Светочи. Доктор отнял у Коломбины то, что принадлежало ей по праву.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030515
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60030515,
					"content": "Вы о госпоже Субретке? Она давно нас покинула. Перед уходом она сказала, что выполнила поручение её величества Царицы и теперь собирается заняться собственными делами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030516
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030516,
					"content": "Я всегда знал, что выход из рядов Фатуи до добра не доводит. Возьмите хоть господина Капитана, которым я так восхищался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030517
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030517,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030518
					]
				},
				{
					"id": 60030518,
					"content": "Во исполнение плана высшее командование направило в Нод-Край три отряда, один подчинялся Доктору, второй Марионетке, а третий - Субретке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030519
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030519,
					"content": "В то время я прибыл сюда с отрядом госпожи Субретки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030520
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030520,
					"content": "Она редко с нами общалась. Её... не особенно заботило происходящее вокруг, и вовсе не потому, что она была поглощена своими мыслями. Нет, у меня сложилось ощущение, будто ей вообще всё равно, что станет с этим миром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030521
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030521,
					"content": "Как будто она так и не нашла ничего, ради чего стоило жить, и потому целыми днями смотрела в далёкое небо... Да, она всегда смотрела на небо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030522
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030522,
					"content": "Господин Доктор часто наблюдал за ней издали. Говорили, некогда у него были дружеские отношения с госпожой Субреткой, но после госпожа Субретка отчего-то стала его избегать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030523
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030523,
					"content": "После ухода госпожи Субретки меня перевели под начало господина Доктора. Он... тоже не особенно интересовался окружающим миром, и все его ожидания были сосредоточены на Лунах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030524
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030524,
					"content": "Доктор задался целью во что бы то ни стало завладеть Тремя Лунами. Он сказал даже, что если одной Луны будет не хватать, он запросто создаст новую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030525
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030525,
					"content": "Рукотворный Лунный Светоч? Наверное, здесь не обошлось без знаний, полученных от фантомов Гипербореи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030526
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030526,
					"content": "Весьма подробный рассказ. Благодарю вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030527
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60030527,
					"content": "Мне показалось, вы бы предпочли оставаться в подчинении у Коломбины?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030528
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60030528,
					"content": "...Нет, она больше не Предвестница. К тому же Фатуи присягают на верность только её величеству Царице.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030529
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030529,
					"content": "Я рассказал вам всё, потому что не могу полностью доверять господину Доктору. Его действия не соответствуют изначальной цели, с которой мы прибыли в Нод-Край.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030530
					],
					"speakerTitle": "Йотаутас",
					"speakerSubtitle": "Подчинённый Доктора"
				},
				{
					"id": 60030530,
					"content": "Понятно. Мы сделаем всё возможное, чтобы его остановить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030531
					]
				},
				{
					"id": 60030531,
					"content": "Подчинённые Слуги сейчас в Экспериментальном конструкторском бюро куувяки. Можешь присоединиться к ним.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030532
					]
				},
				{
					"id": 60030532,
					"content": "Вы всё слышали. Искусственный Лунный Светоч... который почти готов. Не могу поверить, что Дотторе так продвинулся в своих технологиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030533
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030533,
					"content": "Нас ждёт жестокая битва. Всем нужно подготовиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флинс"
				}
			]
		},
