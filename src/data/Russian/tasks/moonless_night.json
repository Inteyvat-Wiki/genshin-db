			"dialogs": [
				{
					"id": 60030101,
					"content": "Кажется, все в сборе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60030102,
					"content": "#Да, мы готовы. {NICKNAME}, Паймон, а вы как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030103
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 60030103,
					"content": "Паймон готова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030104,
						60030106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60030104,
					"content": "#Я тоже готов{F#а}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030105
					]
				},
				{
					"id": 60030105,
					"content": "Отлично, тогда давайте сразу перейдём к делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030113
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 60030113,
					"content": "Итак, в первую очередь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030114
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 60030114,
					"content": "Подождите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030115
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 60030115,
					"content": "Здесь кто-то есть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030116
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030116,
					"content": "Мы слышали твои шаги, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030117
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030117,
					"content": "#Я заметил вас некоторое время назад. Наверное, вы прошли сюда вместе с {F#путешественницей}{M#путешественником}? Но я не чувствую, чтобы у вас были дурные намерения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030118
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60030118,
					"content": "Входи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030119
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030119,
					"content": "Так я и думал. Быстрая у вас реакция.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030120
					],
					"speakerTitle": "Гедимин",
					"speakerSubtitle": "Подчинённый Слуги"
				},
				{
					"id": 60030120,
					"content": "Госпожа Слуга отправила меня сюда, чтобы я передал вам сообщение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030121
					],
					"speakerTitle": "Гедимин",
					"speakerSubtitle": "Подчинённый Слуги"
				},
				{
					"id": 60030121,
					"content": "Все приготовления Дотторе к возвращению в Снежную были сделаны только для отвода глаз. Но он не вернулся в Экспериментальное конструкторское бюро куувяки и не появлялся в Нашгороде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030122
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 60030122,
					"content": "Значит, он может быть только в своей лаборатории на севере. Ха, так вот зачем он затребовал себе отдельную лабораторию... Он всё спланировал с самого начала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030123
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 60030123,
					"content": "Передай им, что мы с Сандроне отправляемся в путь. Если они хотят знать, чем всё закончится, предлагаю встретиться в лаборатории на северной оконечности Нод-Края.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030124
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 60030124,
					"content": "Обе Предвестницы - близкие подруги госпожи Коломбины, но перед отправлением они всё же решили поставить нас в известность... Мы искренне благодарны Фатуи за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030125
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 60030125,
					"content": "Хотя госпожа Субретка покинула ряды Фатуи... госпожа Слуга и госпожа Марионетка продолжают искренне о ней заботиться. Кроме того, противоречивые действия господина Доктора не могут не вызывать тревогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030126
					],
					"speakerTitle": "Гедимин",
					"speakerSubtitle": "Подчинённый Слуги"
				},
				{
					"id": 60030126,
					"content": "У нас много врагов, но никаких личных счётов между нами нет, мы всего лишь преследуем разные интересы. Фатуи всегда уважали моральные принципы и дружеские связи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030127
					],
					"speakerTitle": "Гедимин",
					"speakerSubtitle": "Подчинённый Слуги"
				},
				{
					"id": 60030127,
					"content": "Вы друзья госпожи Субретки, а значит, имеете право знать, что происходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030128
					],
					"speakerTitle": "Гедимин",
					"speakerSubtitle": "Подчинённый Слуги"
				},
				{
					"id": 60030128,
					"content": "Да, Арлекино лучше всех умеет оценить ситуацию. Она сэкономила нам уйму времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030129
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030129,
					"content": "Я оставлю карту здесь. Если решите отправиться в лабораторию, будьте осторожны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030130
					],
					"speakerTitle": "Гедимин",
					"speakerSubtitle": "Подчинённый Слуги"
				},
				{
					"id": 60030130,
					"content": "И помните, что подручные госпожи Слуги готовы быть вашими союзниками. По крайней мере, в Нод-Крае.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030131
					],
					"speakerTitle": "Гедимин",
					"speakerSubtitle": "Подчинённый Слуги"
				},
				{
					"id": 60030131,
					"content": "Благодарю вас за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030132
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60030132,
					"content": "Это моя работа. Что ж, мне пора идти. Если что-то понадобится, обращайтесь в Экспериментальное конструкторское бюро куувяки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030133
					],
					"speakerTitle": "Гедимин",
					"speakerSubtitle": "Подчинённый Слуги"
				},
				{
					"id": 60030133,
					"content": "Доктор покинул Экспериментальное конструкторское бюро куувяки и отправился в лабораторию на севере...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60030134,
					"content": "Марионетка сказала, что он давно к этому готовился. Неужели его план созрел ещё до прибытия в Нод-Край?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030135
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 60030135,
					"content": "Скорее всего, его служба Царице всего лишь фикция. На словах он подчиняется приказам, а делает всё по-своему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030136
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60030136,
					"content": "Доктор решительный и жестокий противник, с ним будет непросто сладить. Нам нужно подготовиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030137
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030137,
					"content": "Мы не можем предсказать, как он будет действовать. Я предлагаю разделиться на две группы: одна группа останется здесь для защиты Нашгорода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030138
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60030138,
					"content": "Гм... Мне очень хочется помочь, но я не уверена, что от меня там будет много толку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030152
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 60030152,
					"content": "Хотя бы возьмите с собой Охладительного утёнка! Он поможет вам в бою!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030139
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 60030139,
					"content": "Госпожа Инеффа наверняка останется здесь, чтобы защищать госпожу Айно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030140
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60030140,
					"content": "Обнаружена логическая цепочка: защищать Айно. Приоритет: высокий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030141
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 60030141,
					"content": "На всякий случай господину Варке тоже стоит остаться. А мы займёмся лабораторией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030142
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60030142,
					"content": "В такой час Рыцарь Бореалис не может оставаться в стороне, но... ладно, как скажете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030143
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 60030143,
					"content": "Я позабочусь о Нашгороде. Только прошу вас, будьте осторожны. Если ситуация выйдет из-под контроля, сразу отступайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030144
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 60030144,
					"content": "Ягода тоже остаётся с вами. Пока меня не будет, она отвечает за сбор сведений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030145
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030145,
					"content": "Есть, босс. Ждём вас всех целыми и невредимыми!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030146
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 60030146,
					"content": "Обязательно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030147
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60030147,
					"content": "Медлить нельзя. Предлагаю как можно скорее выступить в путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030148,
						60030149
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60030148,
					"content": "Нас может ждать серьёзная опасность...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030150,
					"content": "Проникнуть в секретную лабораторию или... Ладно, Паймон останется. Судя по всему, вас ждёт большая заварушка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030151
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60030151,
					"content": "Противостояние с Доктором потребует от нас отдачи всех сил. Может, у тебя остались неоконченные дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030401,
						60030601
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030401,
					"content": "Да, мне надо кое-что закончить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030402
					]
				},
				{
					"id": 60030402,
					"content": "#Тогда отправимся в путь, когда будешь готов{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030601,
					"content": "#Я всегда готов{F#а}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030602
					]
				},
				{
					"id": 60030602,
					"content": "Тогда вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60030603,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030149,
					"content": "Паймон, тебе лучше остаться и помогать друзьям в Нашгороде.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030106,
					"content": "Хорошо, предлагаю ещё раз уточнить повестку дня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030107
					]
				},
				{
					"id": 60030107,
					"content": "Ха-ха, нервничаешь немного? Ничего удивительного. Мы все впервые с таким сталкиваемся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030108
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 60030108,
					"content": "#Когда Доктор напал на госпожу Коломбину... ты успел{F#а} увидеть, как она исчезла в «отражении Луны».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030109
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 60030109,
					"content": "#Да. Мы видели только, как Доктор появился и пустил в ход некую силу. Затем Коломбина исчезла, а ты упал{F#а} в море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030110
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60030110,
					"content": "Мы должны спасти Коломбину. Кроме того, Доктор явно неспроста решил завладеть властью Трёх Лун. Мы должны остановить его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030111
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 60030111,
					"content": "Спасать Богиню Луны должны Дети Морозной Луны. Я не ожидала, что столько друзей вызовется помочь... Примите мою благодарность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030112
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60030112,
					"content": "(Удалено)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030113
					]
				}
			]
		},
