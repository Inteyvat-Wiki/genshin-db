			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20322,
						"position": [
							335.674,
							288.735,
							245.957
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 60030901,
					"content": "Добро пожаловать, а я вас заждался. Надеюсь, вам понравилась моя лаборатория.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030902
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030902,
					"content": "Да, нам очень понравилось пробиваться через полчище монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030903
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030903,
					"content": "Думаешь, мы поверим, что ты сидел здесь и преспокойно нас дожидался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030904
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60030904,
					"content": "Ну да. А куда мне спешить? Всё идёт точно по плану, и вы явились как раз вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030905
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030905,
					"content": "Сначала Сандроне с Арлекино, теперь вы. Столько гостей сегодня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030906
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030906,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030907
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 60030907,
					"content": "Если вы их искали, должен вам сказать, что Арлекино исчезла сразу после того, как вошла в лабораторию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030908
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030908,
					"content": "А Сандроне вот только что стояла здесь и во весь голос выкрикивала свои вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030909
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030909,
					"content": "Это в её стиле, никакого представления о хороших манерах. Но, должен признать, я и подумать не мог, что Сандроне будет так беспокоиться о посторонних людях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030910
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030910,
					"content": "Неужели это участь всех, кто с вами сближается? Но для исследователя это качество не несёт ничего хорошего. Исследователь должен сохранять объективность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030911
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030911,
					"content": "Где Сандроне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030912
					]
				},
				{
					"id": 60030912,
					"content": "Как тебе сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030913
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030913,
					"content": "Думаешь, получил Лунный Светоч и можешь строить из себя бога? Спустись на землю, Дотторе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030914
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 60030914,
					"content": "Должен сказать, мне не нравится такая формулировка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030915
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030915,
					"content": "Я никого из себя не строю, я констатирую факт. Ты ведь сама занимаешься исследованиями, должна бы понимать разницу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030916
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030916,
					"content": "Ха, ты что - серьёзно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030917
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 60030917,
					"content": "Даже настоящие леди иногда ведут себя не по этикету, прошу прощения. Но мы с тобой коллеги и прекрасно знаем, что ты за человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030918
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 60030918,
					"content": "Да, мы коллеги. И я заранее знал, что ты скажешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030919
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030919,
					"content": "Мы с тобой понимаем, что факты красноречивее всяких слов. Поэтому я отправил тебе с нарочным небольшой подарок, чтобы наглядно показать моё нынешнее положение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030920
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030920,
					"content": "Какой ещё подарок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030921
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 60030921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030922
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 60030922,
					"content": "И куда подевались твои люди?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030923
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 60030923,
					"content": "Кто знает? Может, они идут в новый мир вслед за неведомым божеством...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030924
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030924,
					"content": "Ты очень груба и заносчива, моя дорогая Сандроне, но я не стану отыгрываться на твоих подчинённых. У всех будут равные права.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030925
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030925,
					"content": "Ты отправил своих людей в Экспериментальное конструкторское бюро куувяки? Но это территория её величества Царицы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030926
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 60030926,
					"content": "Разумеется, я помню приказы её величества. Но тебе прекрасно известно, что они не противоречат моей нынешней цели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030927
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030927,
					"content": "А стало быть, я провожу те эксперименты, которые считаю нужными. В чём проблема?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030928
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030928,
					"content": "Ну что, тебе нужно принять решение. Возможно, я лгу, чтобы отвлечь тебя. Или говорю правду, но это значит, что твои подчинённые в опасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030929
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030929,
					"content": "Напасть на своих... Да ты совсем спятил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030930
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 60030930,
					"content": "Я установил для себя новое правило: давать шанс каждому. Разумеется, это правило распространяется и на тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030931
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030931,
					"content": "Если захочешь уйти, я не стану тебя останавливать. В конце концов, мы ведь коллеги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030932
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030932,
					"content": "...Мразь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030933
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 60030933,
					"content": "И всё равно я никак не ожидал, что Сандроне придёт в голову о ком-то заботиться. Какая жалость. Я считал эгоцентризм её единственным достоинством.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030934
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030934,
					"content": "Защищать какое-то Экспериментальное конструкторское бюро... Да, если размениваться на такие мелочи, о настоящем величии не стоит и мечтать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030935
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030935,
					"content": "Рассуждать о величии, захватив людей в заложники, это попросту низость. Неужели честь для вас - пустой звук?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030936
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60030936,
					"content": "Честь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030937
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030937,
					"content": "У меня в руках два Лунных Светоча, а третий почти готов. Скоро я стану богом нового мира. И ты хочешь поговорить со мной о чести? Какая наивность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030938
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030938,
					"content": "Это священные реликвии! Ты их недостоин!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030939
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60030939,
					"content": "А по-моему, в мире полно людей, недостойных жить. Но я милосерден и позволяю им дальше коптить небо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030940
					],
					"speakerTitle": "Доктор"
				},
				{
					"id": 60030940,
					"content": "Ты пожалеешь о содеянном.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030941
					]
				},
				{
					"id": 60030941,
					"content": "Правда? Посмотрим, сможете ли вы заставить меня пожалеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доктор"
				}
			]
		},
