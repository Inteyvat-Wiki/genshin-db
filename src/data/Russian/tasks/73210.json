			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732100501,
					"content": "Хм... Интересно, какие сокровища здесь можно найти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732100502,
					"content": "В шкафу полно тетрадей. Вы просмотрели их. Похоже, это больничные документы, вроде медицинских карт и бухгалтерских ведомостей.\\nВы разочарованно закрываете шкаф.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732100503
					]
				},
				{
					"id": 732100503,
					"content": "Пфф, Паймон подумала, что внутри спрятаны какие-то особенные сокровища... Лучше уж деревянные бочки и ящики, которые мы обычно находим в наших приключениях! Там хоть капуста и мясо птицы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732100504,
					"content": "Что это? Паймон думает, что это выпало отсюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732100505,
					"content": "Дай Паймон посмотреть... Может быть, это ключ к поиску сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732100507,
					"content": "Ой, «элеазар» выглядит довольно страшно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732100508,
					"content": "Что написано в другом документе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732100510,
					"content": "Хм... Паймон ничего не поняла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100511,
						732100513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732100511,
					"content": "Это Паймон тоже не поняла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732100512,
					"content": "Паймон поняла только ту часть, где говорится о «божественном голосе»... Неужели странный голос действительно руководил людьми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732100515,
					"content": "Может быть, это были «звуки подземных вод или животных»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100516
					]
				},
				{
					"id": 732100516,
					"content": "Да точно! Возможно, под землёй есть какие-то руины! Если услышишь какие-нибудь звуки, то пойдём посмотрим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732100513,
					"content": "Лучше бы этого не понимать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100514
					]
				},
				{
					"id": 732100514,
					"content": "Что? Тебе всё понятно? Паймон поняла только о «божественном голосе»... Неужели странный голос действительно руководил людьми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
