				]
			},
			"dialogs": [
				{
					"id": 240040501,
					"content": "Что вы на меня так смотрите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040502
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240040502,
					"content": "Спрятался где-то и сел за книжку, не так ли, братец? Кто же так играет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040503
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240040503,
					"content": "Вот-вот. Давай играть по-настоящему!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040504
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240040504,
					"content": "Вы разобрали самые интересные места, а у меня находить такие не получается... Вот я и принялся за книжку, чтобы скоротать время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040505
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240040505,
					"content": "Ой, ну ты и врунишка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040506
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240040506,
					"content": "Книжный червь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040507
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240040507,
					"content": "Ну зачем так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040508,
						240040509
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240040508,
					"content": "Полегче, ребята.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040510
					]
				},
				{
					"id": 240040510,
					"content": "Хе-хе... Лави хорошо прячется. Она все места знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040517
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240040517,
					"content": "С Лави здесь так здорово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040511
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240040511,
					"content": "Верут очень сильный и отлично взбирается по стенам. Он не раз мне помогал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040512
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240040512,
