			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лави"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040401,
					"content": "#Ой, ты {M#нашёл}{F#нашла} меня! А ты кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040402
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240040402,
					"content": "Друг Ореля и Верута.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040403
					]
				},
				{
					"id": 240040403,
					"content": "Да, они говорили о тебе... Верут сказал, что ты хорошо играешь в прятки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040404
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240040404,
					"content": "#Ну вот я и убедилась в этом сама. Здорово {M#справился}{F#справилась}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040405
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240040405,
					"content": "#Ты меня {M#нашёл}{F#нашла}. Пойду к назначенному месту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лави"
				}
			]
		},
