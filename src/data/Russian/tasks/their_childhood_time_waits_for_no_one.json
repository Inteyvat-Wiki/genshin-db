					"Орель"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040201,
					"content": "Так... Это я, кажется, уже читал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240040202,
					"content": "Читаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "Ох, не ожидал тебя так быстро. Я только начал книгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240040205,
					"content": "Это передал мне отец Лави. Он даже пообещал, что ответит на любой вопрос, если я чего-то не пойму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240040206,
					"content": "По правде сказать... Мне бы здесь хоть слово понять...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240040207,
					"content": "#Впрочем, не будем об этом. Я пойду к назначенному месту, ведь ты {M#нашёл}{F#нашла} меня. Правила есть правила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Орель"
				},
				{
					"id": 240040203,
					"content": "Любишь учиться, не так ли?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
		},
		{
			"id": 2400403,
			"completionStepIds": [
				2400403
