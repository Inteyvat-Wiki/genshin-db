			"dialogs": [
				{
					"id": 240040301,
					"content": "Ой, как ты меня так быстро находишь? Только собирался спрятаться в другом месте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040302
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240040302,
					"content": "Придётся идти к назначенному месту...",
