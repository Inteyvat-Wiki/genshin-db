			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"С виду умный мужчина",
					"С виду умная женщина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070401,
					"content": "Ты утверждаешь, что «колебания эмоций могут повлиять на точность исследований и анализа»? У этого утверждения нет достаточных оснований.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070402
					],
					"speakerTitle": "С виду умная женщина"
				},
				{
					"id": 700070402,
					"content": "Мне это известно. Я столкнулся со странным препятствием в своих исследованиях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070403
					],
					"speakerTitle": "С виду умный мужчина"
				},
				{
					"id": 700070403,
					"content": "Вы как раз вовремя. Я столкнулся с небольшим затруднением и хотел бы услышать мнение со стороны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070404
					],
					"speakerTitle": "С виду умный мужчина"
				},
				{
					"id": 700070404,
					"content": "Если я хочу доказать обоснованность своей теории, я должен убедиться, что у меня нет эмоциональных колебаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070405
					],
					"speakerTitle": "С виду умный мужчина"
				},
				{
					"id": 700070405,
					"content": "Но я не могу этого сделать, особенно, когда я с ней спорю. Мне не удаётся мыслить рационально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070406
					],
					"speakerTitle": "С виду умный мужчина"
				},
				{
					"id": 700070406,
					"content": "Мне тоже кажется немного странным. Это недостаток сна или чрезмерное употребление алкоголя прошлым вечером?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070407,
						700070408
					],
					"speakerTitle": "С виду умная женщина"
				},
				{
					"id": 700070407,
					"content": "В библиотеке нельзя громко разговаривать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070408
					]
				},
				{
					"id": 700070408,
					"content": "Говорите тише.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070409
					]
				},
				{
					"id": 700070409,
					"content": "Простите, но я не успокоюсь, пока не разберусь с этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070410
					],
					"speakerTitle": "С виду умный мужчина"
				},
				{
					"id": 700070410,
					"content": "Ох, он ничегошеньки не понимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700070411,
					"content": "Нельзя причинять неудобства другим людям. И нельзя ставить прочитанные книги на полку задом наперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700070412,
					"content": "Уф... Похоже, они не обращают на нас внимания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7000707,
			"completionStepIds": [
