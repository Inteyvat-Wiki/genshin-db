					"Вират"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070801,
					"content": "В библиотеке чересчур шумно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070802
					]
				},
				{
					"id": 700070802,
					"content": "Я всё понял... Думаю, пришло время использовать «тот самый метод».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070803
					],
					"speakerTitle": "Вират"
				},
				{
					"id": 700070803,
					"content": "Госпожа Лиза упоминала, что нарушение правил библиотеки повлечёт за собой последствия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070804
					],
					"speakerTitle": "Вират"
				},
				{
					"id": 700070804,
					"content": "Вас не затруднит зайти в библиотеку и передать сообщение госпожи Лизы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070805
					],
					"speakerTitle": "Вират"
				},
				{
					"id": 700070805,
					"content": "Делать загибы на страницах, класть розы в книги, ставить книги на полки перевёрнутыми... Это определенно нарушение правил библиотеки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700070806,
					"content": "Давай передадим сообщение Лизы всем тем в библиотеке, кто читает не так, как следует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
