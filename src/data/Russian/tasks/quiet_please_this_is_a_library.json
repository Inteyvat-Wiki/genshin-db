				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Элла Маск"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070101,
					"content": "Ye ika gusha mosi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070102,
						700070103
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700070102,
					"content": "Кажется, у тебя плохое настроение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				},
				{
					"id": 700070104,
					"content": "Прошу прощения... Это потому что в последнее время в библиотеке слишком громко, и я не могу спокойно изучать хиличурлский язык.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070105
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700070105,
					"content": "С тех пор как начался Праздник ветряных цветов, это место стало пользоваться популярностью у влюблённых парочек. Сначала они просто молчали и читали книги, но потом начали... болтать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070106
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700070106,
					"content": "А ещё они делают всякие ужасные вещи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070107
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700070107,
					"content": "Загибают страницы, кладут странные предметы в книги... Они дошли до того, что ставят книги на полки корешками внутрь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070108
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700070108,
					"content": "Библиотека не место для свиданий! По крайней мере, до тех пор, пока вы мешаете тем, кто действительно учится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070109,
						700070111
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700070109,
					"content": "Вират должен навести здесь порядок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070110
					]
				},
				{
					"id": 700070110,
					"content": "Что он может сделать? Выставить их вон? Это не решит проблему в корне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700070113,
					"content": "Помоги мне, пожалуйста! Успокой их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070114,
						700070115
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700070114,
					"content": "Я сделаю это!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070116,
					"content": "Спасибо! Больше всего шума от тех трёх парочек. Если ты объяснишь им, как их болтовня отвлекает, я смогу продолжить свои исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070117
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700070117,
					"content": "#Только будь осторож{F#на}{M#ен}. С ними не так уж и легко будет справиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700070115,
					"content": "Я попробую...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070111,
					"content": "Можно было бы обратиться к Лизе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070112
					]
				},
				{
					"id": 700070112,
					"content": "Я слышала, что она сейчас в дозоре с действующим магистром Джинн. Если бы она была здесь, эти влюблённые парочки не вели бы себя так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700070103,
					"content": "Зачем ты кричишь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				}
			]
		},
		{
			"id": 7000702,
			"completionStepIds": [
				7000702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000702",
							"2"
						],
						"stepId": 7000702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Влюблённый юноша",
					"Влюблённая девушка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070201,
					"content": "Какая трогательная история! Жаль, что у неё не было счастливого конца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070202
					],
					"speakerTitle": "Влюблённый юноша"
				},
				{
					"id": 700070202,
					"content": "С нами ведь такого никогда не случится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070203
					],
					"speakerTitle": "Влюблённая девушка"
				},
				{
					"id": 700070203,
					"content": "Конечно. Я верну тебя, даже если мы окажемся на разных концах света.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070204,
						700070205
					],
					"speakerTitle": "Влюблённый юноша"
				},
				{
					"id": 700070204,
					"content": "Соблюдайте тишину в библиотеке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				},
				{
					"id": 700070206,
					"content": "А? Я и так всё время вполголоса говорила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070207
					],
					"speakerTitle": "Влюблённая девушка"
				},
				{
					"id": 700070207,
					"content": "Может быть, это одно из тех препятствий на пути любви...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070208
					],
					"speakerTitle": "Влюблённый юноша"
				},
				{
					"id": 700070208,
					"content": "Также следует положить книги на место после прочтения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700070209,
					"content": "Посмотрите, в каком беспорядке лежат книги. Можно сойти с ума прежде, чем удастся разложить их все по нужным полкам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700070210,
					"content": "Ладно-ладно, я всё понял... Не могли бы вы оставить нас? Начинается самое интересное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070211
					],
					"speakerTitle": "Влюблённый юноша"
				},
				{
					"id": 700070211,
					"content": "Самое интересное?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700070212,
					"content": "Какие бы трудности ни постигли нас, обещаешь ли ты оставаться таким же, как сейчас, и никогда не меняться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070213
					],
					"speakerTitle": "Влюблённая девушка"
				},
				{
					"id": 700070213,
					"content": "Клянусь жизнью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070214
					],
					"speakerTitle": "Влюблённый юноша"
				},
				{
					"id": 700070214,
					"content": "Прошу, не клянись жизнью. Мысль о том, что я могу потерять тебя, разбивает мне сердце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070215
					],
					"speakerTitle": "Влюблённая девушка"
				},
				{
					"id": 700070215,
					"content": "Твоя нежность опьяняет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070216
					],
					"speakerTitle": "Влюблённый юноша"
				},
				{
					"id": 700070216,
					"content": "Похоже, они нас вообще не слышали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700070205,
					"content": "Посетители жалуются, что вы слишком громко себя ведёте.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				}
			]
		},
		{
			"id": 7000703,
