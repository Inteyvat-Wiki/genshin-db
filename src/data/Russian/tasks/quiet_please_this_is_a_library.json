				{
					"id": 700070701,
					"content": "Уф, похоже, никто нас не слушает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700070702,
					"content": "Никто из них не уважает правила библиотеки. Единственное, что мы можем сделать, - это рассказать всё Вирату.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7000708,
			"completionStepIds": [
				7000708
			],
			"beginWay": "TALK_BEGIN_NONE",
