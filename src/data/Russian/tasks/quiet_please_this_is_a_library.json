			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Фокусник",
					"Влюблённая женщина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070301,
					"content": "Да-да? Что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070302,
						700070303
					],
					"speakerTitle": "Влюблённая женщина"
				},
				{
					"id": 700070302,
					"content": "Соблюдайте тишину в библиотеке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				},
				{
					"id": 700070304,
					"content": "Прошу прощения. Я стараюсь быть тише, но иногда я всё равно не могу сдержать своё восхищение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070305
					],
					"speakerTitle": "Влюблённая женщина"
				},
				{
					"id": 700070305,
					"content": "Например, когда вы отвлеклись, я вытащил розу, скрывающуюся меж страниц этой книги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070306
					],
					"speakerTitle": "Фокусник"
				},
				{
					"id": 700070306,
					"content": "Рождённая из книги роза, как и вы, полна нежности и интеллектуальной красоты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070307
					],
					"speakerTitle": "Фокусник"
				},
				{
					"id": 700070307,
					"content": "Что? Невероятно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070308
					],
					"speakerTitle": "Влюблённая женщина"
				},
				{
					"id": 700070308,
					"content": "Вы слишком шумите! К тому же книги не используют для фокусов! Ты порвёшь их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700070309,
					"content": "Паймон, ты тоже шумишь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070310
					]
				},
				{
					"id": 700070310,
					"content": "Ах! Простите, я не нарочно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700070311,
					"content": "Теперь вы понимаете... Есть вещи, которые тяжело контролировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070312
					],
					"speakerTitle": "Влюблённая женщина"
				},
				{
					"id": 700070312,
					"content": "Простите ещё раз, мне действительно жаль. Я постараюсь восхищаться потише.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070313
					],
					"speakerTitle": "Влюблённая женщина"
				},
				{
					"id": 700070313,
					"content": "Похоже, они всё пропустили мимо ушей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700070303,
					"content": "Посетители жалуются, что вы слишком громко себя ведёте.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				}
			]
		},
		{
			"id": 7000704,
			"completionStepIds": [
				7000704
			],
