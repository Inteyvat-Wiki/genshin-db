			},
			"dialogs": [
				{
					"id": 700071001,
					"content": "Что?! Лиза скоро возвращается?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700071002,
					"content": "Только не это! Если она узнает, что они испортили книги и повредили страницы, она будет в ярости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700071003,
					"content": "Это точно. Что же нам делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071004
					]
				},
				{
					"id": 700071004,
					"content": "Что же делать? Давай поскорее начнём уборку, а то не успеем к её приходу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700071005,
					"content": "Никогда бы не подумала, что вы придёте к такому гениальному решению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071006
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700071006,
					"content": "Это Вират придумал...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071007
					]
				},
				{
					"id": 700071007,
					"content": "Спасибо Лизе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071008
					]
				},
				{
					"id": 700071008,
					"content": "Если бы госпожа Лиза увидела это зрелище, она была бы в ярости. Это библиотека, храм знаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071009
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700071009,
					"content": "Я наконец-то смогу спокойно проводить свои исследования. Вот ваша награда. Большое спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элла Маск"
				}
			]
