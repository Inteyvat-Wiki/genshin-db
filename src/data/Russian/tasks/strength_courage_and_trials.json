			"dialogs": [
				{
					"id": 706940101,
					"content": "Бам-бам, как твоя спина? Ещё болит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940102
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706940102,
					"content": "Всё в порядке... Горячий компресс быстро помог!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940103
					],
					"speakerTitle": "Бам-бам-боец"
				},
				{
					"id": 706940103,
					"content": "Хех, чтобы сделать такой компресс, нужно нагревать мокрую повязку с медленно горящим порохом ровно столько времени, сколько нужно, иначе она может загореться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940104
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706940104,
					"content": "Только Ёимия могла придумать такой способ нагревать повязки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706940105,
					"content": "#Секундочку... Смотрите, кто к нам пожаловал! {F#Наша прославленная героиня и её}{M#Наш прославленный герой и его} спутница собственной персоной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940106
					],
					"speakerTitle": "Бам-бам-боец"
				},
				{
					"id": 706940106,
					"content": "Прямо передо мной разворачивается классическая сцена из комиксов?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940107,
						706940108
					],
					"speakerTitle": "Бам-бам-боец"
				},
				{
					"id": 706940107,
					"content": "Вы лечите раны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				},
				{
					"id": 706940109,
					"content": "Не беспокойся о нас! Мы бродили по дикой местности в поисках новых сильных противников, на которых можно было бы потренироваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940110
					],
					"speakerTitle": "Бам-бам-боец"
				},
				{
					"id": 706940110,
					"content": "На самом деле, Ёимия очень мне помогла, особенно когда я случайно повредила спину и скатилась с холма как снежок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940111
					],
					"speakerTitle": "Бам-бам-боец"
				},
				{
					"id": 706940111,
					"content": "Ой-ой... Паймон даже слушать больно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706940112,
					"content": "Ха, как говорится в «Саге Пылких Сердец», «я обычный воин, который случайно проходил мимо»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940113
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706940113,
					"content": "А теперь мы можем стать «свободными наёмниками»! Рыцари позволили мне действовать по своему усмотрению и бороться с монстрами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940114,
						706940115
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706940114,
					"content": "Здесь всё ещё бродят монстры?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940116,
					"content": "Плохи дела! Может, стоит сообщить ордену, чтобы прислали подкрепление?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706940117,
					"content": "Да, нужно заняться этим в ближайшее время, но это не срочно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940118
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706940118,
					"content": "Рыцари почти избавились от монстров вокруг места проведения Международного забега по Драконьему хребту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940119
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706940119,
					"content": "И, честно говоря, большинство участников забега вполне способны постоять за себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940120
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706940120,
					"content": "У них есть сила, навыки и смелость. Если мы будем относиться к ним как к обычным людям, они могут почувствовать себя оскорблёнными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940121
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706940121,
					"content": "Поэтому, в соответствии с обычной практикой Гильдии искателей приключений, мы рассматриваем это как испытание и сформировали команду на месте, чтобы справиться с монстрами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940122
					],
					"speakerTitle": "Бам-бам-боец"
				},
				{
					"id": 706940122,
					"content": "Именно в этом и заключается суть «Испытания доблести»: уничтожать монстров, подражать боевым стилям различных героев и преодолевать себя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940123
					],
					"speakerTitle": "Бам-бам-боец"
				},
				{
					"id": 706940123,
					"content": "Такой тип мышления вполне в духе Удела Благодатных Земель!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940124,
						706940125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706940124,
					"content": "Тогда я тоже участвую!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940126,
					"content": "#Отлично! Давно не видела, как {NICKNAME} демонстрирует свои навыки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940127
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706940127,
					"content": "Не терпится увидеть тебя в действии... Интересно, с каким фейерверком можно сравнить твои ослепительные движения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706940125,
					"content": "Я не могу пропустить это!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940115,
					"content": "Нужно соблюдать осторожность, поблизости есть мирные жители.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940108,
					"content": "Вы были в бою?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				}
			]
		}
	]
}