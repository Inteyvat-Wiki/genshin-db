				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Айюн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240110101,
					"content": "Чайки, милые чайки. Знаю, вы голодны, но и я отчаянно нуждаюсь в пище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110102
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110102,
					"content": "Впрочем, это неважно, коли вы счастливы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110103
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110103,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110104
					]
				},
				{
					"id": 240110104,
					"content": "#О, {F#путешественница}{M#путешественник}! Какой приятный сюрприз. Если у тебя ко мне дело, боюсь, придётся подождать. Я ещё не решил вопрос с картофелем во фритюре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110105,
						240110107
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110105,
					"content": "Мы здесь не по делу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110106
					]
				},
				{
					"id": 240110106,
					"content": "В самом деле? Славно. А то мне нужно поторопиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110108
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110108,
					"content": "Это мой основной приём пищи. Мне нужно поторопиться, ведь меня ждёт встреча с Роялтом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110109
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110109,
					"content": "Мне непривычно есть во Дворце Мермония, поэтому я принимаю пищу в спешке снаружи, в каком-нибудь укромном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110110
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110110,
					"content": "Но сегодня... Не знаю, почему чайки так взбесились, но они так и кидаются на мою картошку. И сколько их не корми, всё им мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110111,
						240110112
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110111,
					"content": "Да, чаек здесь больше, чем картошки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110113,
					"content": "Верно. Но и у меня картошки не хватит на всех чаек в мире...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110114
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110114,
					"content": "Это ведь твоя картошка. Не позволяй чайкам так с тобой обходиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240110115,
					"content": "Так ты сам останешься голодным, понимаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110116,
						240110117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240110116,
					"content": "Ты выглядишь невесёлым.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110118,
					"content": "Тебе так кажется? Ну, это отчасти правда. От тебя ничего не утаишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110119
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110119,
					"content": "Просто... Я больше не вижу смысла в работе. Целый день тружусь в Палате Жестьон, но никакой пользы это не приносит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110120
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110120,
					"content": "Помочь я никому до сих пор не смог, облегчить жизнь тоже. Роялт говорит, что моя работа очень важна, однако...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110121
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110121,
					"content": "Я просто сижу за печатной машинкой и стучу по клавишам изо дня в день. В чём суть такого труда? Я мог бы ещё одну клавишу потерять, чтобы хоть Эстель заработала немного моры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110122
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110122,
					"content": "Прости. Мне не следовало этого говорить. Но что бы я ни делал, в душе ощущаю большую растерянность. Возможно... мне просто нужно время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110123,
						240110124
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110123,
					"content": "Сначала поешь спокойно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110125,
					"content": "Верно. Но времени совершенно недостаточно, чтобы добыть ещё одну порцию картошки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110126
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110126,
					"content": "Забудь, я просто отдам остатки птицам. Найду себе еду, когда закончим дела с Роялтом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110127
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110127,
					"content": "Это займёт... всего лишь половину дня. Ничего страшного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110128
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110128,
					"content": "Ты продержишься так долго без еды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110129,
						240110130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240110129,
					"content": "Я разберусь с чайками.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110131,
					"content": "Но... Не будет ли это слишком в тягость? Столько проблем из-за картошки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110132
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240110132,
					"content": "Ты займись своим обедом. Нельзя быть голодным, даже если очень много дел!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240110130,
					"content": "Чайками займусь я.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110124,
					"content": "Сначала разберёмся с чайками.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110117,
					"content": "Ты как будто растерян.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110112,
					"content": "Наверное, ещё не все получили свою порцию...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110107,
					"content": "Почему ты ешь картофель во фритюре именно здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110108
					]
				}
			]
		},
