					"Айюн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111201,
					"content": "Пробовал есть в другом месте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111202
					]
				},
				{
					"id": 240111202,
					"content": "Не могу найти места лучше. Если сидеть слишком близко ко дворцу, то можно нечаянно встретиться с коллегами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111203
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240111203,
					"content": "И тогда они опять заведут разговор о работе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111204
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240111204,
					"content": "Но если уйти слишком далеко, то не успею вернуться вовремя и что-нибудь важное пропущу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111205
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240111205,
					"content": "С учётом всех этих факторов, это единственное подходящее место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				}
			]
		},
		{
			"id": 2401113,
			"completionStepIds": [],
