				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111301,
					"content": "Чайки, чайки. Доедайте картошку и улетайте прочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111302,
						240111303
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240111302,
					"content": "Как обстоят дела?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				},
				{
					"id": 240111304,
					"content": "Нисколько. Едва чайки приблизились к моему картофелю, как пёсик спрятался за мою спину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111305
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240111305,
					"content": "Эх... Я его не виню. В его породе главное качество - любить и быть любимым. Нападать он ни на кого не обучен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111306
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240111306,
					"content": "И у нас есть такое качество.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111307
					]
				},
				{
					"id": 240111307,
					"content": "Может и так. Но иногда «любовь» - это право. А как только любовь начинают считать «правом», то всё сразу становится сложнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111308
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240111308,
					"content": "Прошу простить, я уже много наговорил. Сегодня приходилось сталкиваться с разбирательствами эмоциональной природы, и я ещё не успел отойти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111309
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240111309,
					"content": "Эх... Но сейчас меня беспокоит один вопрос: как же доесть эту картошку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240111303,
					"content": "Помог щеночек?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				}
			]
		},
