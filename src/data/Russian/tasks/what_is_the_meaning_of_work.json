			"dialogs": [
				{
					"id": 240111101,
					"content": "Пробовал завести собаку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111102
					]
				},
				{
					"id": 240111102,
					"content": "Ты имеешь в виду... чтобы собака их отгоняла?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111103
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240111103,
					"content": "А что, интересная мысль. Может, возьму собаку у кого-то на время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				}
			]
		},
		{
			"id": 2401112,
			"completionStepIds": [
