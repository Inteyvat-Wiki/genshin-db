			"dialogs": [
				{
					"id": 240111401,
					"content": "Мы их прогоним.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111402
					]
				},
				{
					"id": 240111402,
					"content": "#Но не мог{F#ла} бы ты просто прогнать их, не нанося вреда? Ведь они не желают зла, а просто хотят есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111403
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240111403,
					"content": "Понимаю, что это моя забота, а не ваша, но всё же... Прошу, прогони их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				}
			]
		},
