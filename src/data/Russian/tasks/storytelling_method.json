			"dialogs": [
				{
					"id": 728120201,
					"content": "Ладно, на этом мы закончим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120202
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 728120202,
					"content": "Я никогда так не уставал. Неужели эта история должна быть такой сложной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120203
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 728120203,
					"content": "Вот что получается, когда ты не продумываешь всё заранее. Без структуры повествования различные элементы просто сталкиваются друг с другом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120204
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 728120204,
					"content": "Когда это происходит, ты полностью потеряешь контроль над сюжетом. Ты выдохнешься, что бы ты ни писал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120205
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 728120205,
					"content": "#Ладно, ладно... У меня не осталось сил спорить с тобой. Путешественни{F#ца}{M#к}, спасибо, что рассудил{F#а} нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120206
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 728120206,
					"content": "Я извлёк многое из этой ситуации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120207
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 728120207,
					"content": "Прими это как знак моей благодарности. Я напишу больше в ближайшее время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120208
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 728120208,
					"content": "Средства повествования или сюжет... что важнее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				}
			]
		}
