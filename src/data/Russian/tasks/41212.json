				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120301,
					"content": "Хм? Кажется, никого нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120302
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120302,
					"content": "Монстры тоже могут ходить к кому-нибудь в гости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120303,
					"content": "Раз их пока нет, что вы предпочтёте: быстро осмотреться или отдохнуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120304,
						412120306
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120304,
					"content": "Давай передохнём и поболтаем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120305
					]
				},
				{
					"id": 412120305,
					"content": "Я так и думал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120309,
					"content": "О, вы собираетесь поболтать? Паймон с вами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120310,
					"content": "Я знаю, у тебя много вопросов ко мне и по поводу этого дела. Спрашивай, и я отвечу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120311
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120311,
					"content": "Но я не собираюсь обманывать тебя. Есть некоторые вещи, о которых я пока не могу говорить, поэтому позволь мне не отвечать на определённые вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120312
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120312,
					"content": "Ого. Оказывается, господин Альбедо может быть очень прямолинейным, когда захочет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120313,
						412120314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120313,
					"content": "#Да, и он гораздо честнее, чем я думал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120315,
					"content": "Tiga plata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120316
					],
					"speakerTitle": "???"
				},
				{
					"id": 412120316,
					"content": "Да-да! Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120317,
					"content": "Odomu Movo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120318,
						412120320
					],
					"speakerTitle": "???"
				},
				{
					"id": 412120318,
					"content": "Альбедо, это ты издаёшь странные звуки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120319
					]
				},
				{
					"id": 412120319,
					"content": "По-твоему, это возможно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120322,
					"content": "А! Это хиличурлы!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120320,
					"content": "Паймон, это ты издаёшь странные звуки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120321
					]
				},
				{
					"id": 412120321,
					"content": "Конечно, нет! И почему это ты спрашиваешь меня, а не Альбедо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120314,
					"content": "#Да, и он гораздо менее замкнутый, чем я думал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120306,
					"content": "У меня как раз накопились вопросы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120307
					]
				},
				{
					"id": 412120307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120308
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120308,
					"content": "Хорошо. О чём ты хочешь узнать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "Альбедо"
				}
			]
		},
