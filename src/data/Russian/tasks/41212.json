				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120501,
					"content": "Вы видели? Тот хиличурл сбежал с какой-то книгой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120502,
					"content": "Проклятье... Это был мой альбом с рисунками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120503,
						412120504
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120503,
					"content": "Может, он мечтает стать художником?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				},
				{
					"id": 412120505,
					"content": "Паймон думает, что это просто обычный воришка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120506,
					"content": "Он должен быть очень храбрым, раз осмелился взять мой альбом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120507
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120507,
					"content": "Кажется Альбедо злится, просто очень сдержанно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120508,
					"content": "Я помогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120504,
					"content": "Он хочет научиться алхимии?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				}
			]
		},
