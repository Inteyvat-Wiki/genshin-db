			},
			"dialogs": [
				{
					"id": 412120601,
					"content": "Дальше пути нет, только огромный вход в пещеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120602,
					"content": "Он побежал туда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120603
					]
				},
				{
					"id": 412120603,
					"content": "Судя по следам - да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120604
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120604,
					"content": "Так чего же мы ждём?! Нельзя дать ему уйти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120605,
					"content": "Подождите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120606
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120606,
					"content": "Эти горы необъятны. Даже если здесь есть проход, пройти по нему будет нелегко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120607
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120608
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120608,
					"content": "Чувствуете? Ветер дышит холодом камней... Судя по эху, пространства внутри огромны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120609
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120609,
					"content": "И правда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120610,
					"content": "Поэтому никакой пользы в поспешных действиях нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120611
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120611,
					"content": "Но... Мы прошли весь этот путь не для того, чтобы отступить сейчас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120612,
					"content": "Но ведь твой альбом очень важен для тебя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120613
					]
				},
				{
					"id": 412120613,
					"content": "Конечно. Но это не значит, что мы можем действовать необдуманно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120614
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120614,
					"content": "Есть другой путь. Просто он требует чуть больше усилий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120615
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120615,
					"content": "Если я не ошибаюсь, эта пещера ведёт на другую сторону горы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120616
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120616,
					"content": "Ты прекрасно управляешься с планером, да и я кое-что умею. Приготовься. Придётся немного полетать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				}
			]
		},
