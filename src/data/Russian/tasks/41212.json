					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120101,
					"content": "Альбедо! Мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120102,
					"content": "Ой, да у нас гости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120103,
						412120104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120103,
					"content": "Знакомое лицо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				},
				{
					"id": 412120105,
					"content": "Пожалуй, позволить новичкам исследовать эти горы было слишком поспешным решением...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120106
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120106,
					"content": "Но разве приключения - это не постоянный вызов самому себе? Какой смысл в путешествии без борьбы и потрясений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120107
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120107,
					"content": "Ну и что, что здесь полно злобных хиличурлов, бандитов и снега по колено! Это вовсе не препятствие для искателя приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120108
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120108,
					"content": "Сайрус, переходите к делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120109
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120109,
					"content": "Ха-ха, да ладно тебе! Общение - это как приключение, важен процесс, а не результат!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120110
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120110,
					"content": "Даже если тебя обобрали до нитки, разведи огонь посреди снегов и приготовь поесть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120111
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120111,
					"content": "Для новичков Гильдии искателей приключений путешествие сюда станет незабываемым опытом, ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120112
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120112,
					"content": "М-хм, конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120113
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120113,
					"content": "Даже если сейчас они упрекают меня, ненавидят меня, когда они будут вспоминать об этом потом, они скажут мне спасибо за то, что я передал им дух приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120114
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120114,
					"content": "Да, замечательно, продолжайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120115
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120115,
					"content": "Грешок Альбедо во всей красе - он всегда так безразличен к тому, что его не интересует...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120116,
					"content": "Кажется, он не очень заинтересован в искателях приключений.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120117
					]
				},
				{
					"id": 412120117,
					"content": "Да? Зато он явно заинтересован в тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120118,
					"content": "Конечно, можно возразить, что новички ещё слишком неопытны, а горы слишком жестоки. Можно понести серьёзные убытки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120119
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120119,
					"content": "Что ты подразумеваешь под «серьёзными убытками»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120120,
					"content": "О! Вы же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120121
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120121,
					"content": "Привет, Сайрус.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120122
					]
				},
				{
					"id": 412120122,
					"content": "Давно не виделись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120123,
					"content": "#Ах, юн{M#ый}{F#ая} искатель{F#ница} приключений и {M#его}{F#её} компаньон! Рад вас видеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120124
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120124,
					"content": "Надеюсь, здешний лютый мороз не доставляет вам слишком много неудобств.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120125
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120125,
					"content": "Мы со всем справимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120126,
					"content": "Ха-ха, отлично сказано! Обожаю вашу веру в себя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120127
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120127,
					"content": "Но у вас, должно быть, важное дело, раз вы пробились сюда сквозь снег и бурю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120128
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120128,
					"content": "#Я прибыл сюда, чтобы собрать самые свежие данные о хиличурлах, и попросил е{M#го}{F#ё} помочь мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120129,
						412120130
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120129,
					"content": "(Хм, вот как...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120131,
					"content": "Вот оно как. Группа мечтателей собралась здесь в погоне за своими идеалами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120132
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120132,
					"content": "Тогда я желаю вам удачи. Мне нужно взглянуть на новобранцев. До встречи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120201
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 412120201,
					"content": "Хе-хе, кажется, мы кое-что узнали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120202,
					"content": "Альбедо ничего не рассказал Сайрусу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120203
					]
				},
				{
					"id": 412120203,
					"content": "Что ж, это магический меч, как ни крути. Желание Альбедо сохранить всё в тайне можно понять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120204,
					"content": "Я всё слышу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120205
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120205,
					"content": "Мне не следует спрашивать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120206
					]
				},
				{
					"id": 412120206,
					"content": "«Следует» или «не следует» тут ни при чём. Я расскажу тебе всё, что ты хочешь знать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120207
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120207,
					"content": "...Но не сейчас. Сейчас у меня есть более важное дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120208
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120208,
					"content": "Важное дело? Дай Паймон угадает... Опять не обойдётся без нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120209,
					"content": "Паймон, ты умнеешь на глазах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120210
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120210,
					"content": "Что?! Паймон всегда очень умна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412120211,
					"content": "Я обнаружил неподалёку новую среду обитания отличных от своих сородичей монстров. Мы можем получить от них новые данные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120212
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120212,
					"content": "Тебе нравятся эксперименты, не так ли?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120213
					]
				},
				{
					"id": 412120213,
					"content": "Для проведения экспериментов требуется решимость, а упорство лежит в основе работы алхимика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120214
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120214,
					"content": "Вы готовы? Тогда в путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412120130,
					"content": "(Кажется, он не хочет, чтобы другие знали о мече.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120104,
					"content": "#Где же я его видел{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				}
			]
		},
