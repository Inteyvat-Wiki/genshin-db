			},
			"dialogs": [
				{
					"id": 10020501,
					"content": "#Прошу прощения. Так что же привело тебя сюда, путешественни{F#ца}{M#к}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020502
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020502,
					"content": "На самом деле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10020503,
					"content": "Безобразие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020504
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020504,
					"content": "БЕЗОБРАЗИЕ!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020505
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020505,
					"content": "Группировка Цисин... Какое разочарование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020506
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020506,
					"content": "Они допустили убийство Властелина Камня во время Церемонии Сошествия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020507
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020507,
					"content": "А затем осмелились обвинить в этом поступке присутствующих на церемонии людей?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020508
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020508,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020509
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020509,
					"content": "Я знаю, что вас осудили несправедливо, Путешественники.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020510
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020510,
					"content": "И я имею некоторое представление о настоящем убийце, но мне необходимо посоветоваться с другими Адептами, чтобы подтвердить, что интуиция меня не подводит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020511
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020511,
					"content": "А теперь иди. Возьми с собой Печать согласия и передай от меня сообщение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020512,
						10020513
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020512,
					"content": "Кому?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020513
					]
				},
				{
					"id": 10020513,
					"content": "Куда мне идти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020514
					]
				},
				{
					"id": 10020514,
					"content": "Здесь обитают Творец Гор и Хранитель Облаков. Только судьба решит, сможешь ли ты встретиться с ними... Только судьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020515
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020515,
					"content": "Помимо того, ступай на постоялый двор «Ваншу». Отыщи следы Охотника на демонов, Защитника Яксы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Владыка Лун"
				}
			]
		}
	]
