			"dialogs": [
				{
					"id": 10020201,
					"content": "Кто посмел ступить на священные земли Заоблачного предела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020202,
						10020203
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020202,
					"content": "Я исполняю поручение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020203
					]
				},
				{
					"id": 10020203,
					"content": "Вот, взгляните...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020204
					]
				},
				{
					"id": 10020204,
					"content": "Печать согласия... Я не видел такую уже очень давно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020205
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020205,
					"content": "#Вы находитесь в присутствии одного из просветлённых Адептов - Владыки Лун. Что привело тебя сюда, путешественни{F#ца}{M#к}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020206
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020206,
					"content": "На самом деле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10020207,
					"content": "Убийца бежал в эту сторону!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020208
					],
					"speakerTitle": "Сержант Миллелитов"
				},
				{
					"id": 10020208,
					"content": "Это Заоблачный предел, сержант. Мы зашли слишком далеко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020209
					],
					"speakerTitle": "Солдат Миллелитов"
				},
				{
					"id": 10020209,
					"content": "Мы... У нас нет выбора! Наш приказ - поймать убийцу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020210
					],
					"speakerTitle": "Сержант Миллелитов"
				},
				{
					"id": 10020210,
					"content": "...пересекли нашу границу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020211
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10020211,
					"content": "Избавьтесь от них... Я не потерплю вторжения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Владыка Лун"
				}
			]
		},
