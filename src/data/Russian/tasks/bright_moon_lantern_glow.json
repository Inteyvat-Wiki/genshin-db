				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Пин Си"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711490101,
					"content": "В этом году всё сложилось довольно удачно. Наконец-то не придётся беспокоить госпожу Кэ Цин, чтобы она лично проверяла расчёты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490116
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490116,
					"content": "Уф! Нужно перестать об этом думать! Я бог богатства, я бог богатства, я бог богатства...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490103
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490103,
					"content": "Простите, вы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490117
					]
				},
				{
					"id": 711490117,
					"content": "Я бог богатства!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490118,
						711490119
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490118,
					"content": "П-понятно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490120
					]
				},
				{
					"id": 711490120,
					"content": "#А? Это же {NICKNAME}! Привет, если бы я знала, что ты придёшь, мне не пришлось бы учить столько слов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490121
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490121,
					"content": "#Могу предположить, что ты прибыл{F#а} на Праздник морских фонарей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490122
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490122,
					"content": "Хорошо, что ты здесь. Посмотри вокруг - создаётся ощущение, что на этот Праздник морских фонарей собралось ещё больше людей, чем на прошлый?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490123,
						711490124
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490123,
					"content": "Праздник морских фонарей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490125
					]
				},
				{
					"id": 711490125,
					"content": "Как говорят, небесный фонарь поднимается всё выше и выше, в любом деле нужно стремиться к прогрессу. Вот мы и стараемся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490126
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490126,
					"content": "Ой, давай не будем об этом в праздник. Лучше я подскажу, где можно хорошо провести время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490127
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490127,
					"content": "Дай подумать... Точно! На Праздник морских фонарей обязательно нужно запустить в небо небесные фонари.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490128
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490128,
					"content": "А ещё в этом году мы разместили по всей гавани Ли Юэ множество Счастливых деревьев. Если правильно обрезать ветви, то монеты удачи, спрятанные внутри, станут твоими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490129
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490129,
					"content": "Сколько же мы их разместили? Кажется... двадцать одно. Да, точно двадцать одно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490130
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490130,
					"content": "И кстати... поблизости есть одно Счастливое дерево. Если интересно, можешь пойти и подстричь его. Это очень просто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490131
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490131,
					"content": "И наконец... можешь посмотреть доску объявлений. Вон она, прямо возле меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490132
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490132,
					"content": "В последние годы много иностранных туристов посещает Праздник морских фонарей, и Департамент по делам граждан специально установил для них доску объявлений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490102
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490102,
					"content": "Какие бы проблемы ни возникли, или если им нужна помощь, они могут описать их и разместить на доске объявлений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490133
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490133,
					"content": "Кхе-кхе, Департамент по делам граждан обязательно сделает так, чтобы все, кто приехал в Ли Юэ на Праздник морских фонарей, уехали довольными!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490134,
						711490135
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490134,
					"content": "Вы молодцы!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490136
					]
				},
				{
					"id": 711490136,
					"content": "Так и есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490137
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490137,
					"content": "#Кстати, {NICKNAME}, я помню, что у тебя получаются прекрасные снимки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490138,
						711490139
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490138,
					"content": "Есть такое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490140
					]
				},
				{
					"id": 711490140,
					"content": "Ха-ха-ха, не скромничай. Я... хочу попросить тебя о небольшой услуге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490141
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490141,
					"content": "Ничего сложного! Нужно сделать памятные снимки для туристов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490142
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490142,
					"content": "Мы наняли несколько фотографов, чтобы делать памятные снимки, но не ожидали, что в этом году будет так много туристов, и фотографов на всех не хватило.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490143
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490143,
					"content": "#Слишком поздно искать новых, поэтому вся надежда на тебя, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490144
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490144,
					"content": "Прошу! Ради туристов, ради Праздника морских фонарей, ради Ли Юэ! Только ты можешь помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490145,
						711490146
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490145,
					"content": "Я всё сделаю!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490147
					]
				},
				{
					"id": 711490147,
					"content": "#О! Я в тебе не сомневалась, {NICKNAME}. Я дам тебе имена туристов и локации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490148
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490148,
					"content": "Я рассчитываю на тебя! С твоей помощью Праздник морских фонарей в этом году будет идеальным!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490149
					],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490149,
					"content": "Вот, возьми эти фонари. С Праздником морских фонарей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пин Си"
				},
				{
					"id": 711490146,
					"content": "Ради Праздника морских фонарей!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490147
					]
				},
				{
					"id": 711490139,
					"content": "Вовсе нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490140
					]
				},
				{
					"id": 711490135,
					"content": "Ли Юэ выше всяких похвал...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490136
					]
				},
				{
					"id": 711490124,
					"content": "...становится всё лучше с каждым годом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490125
					]
				},
				{
					"id": 711490119,
					"content": "Очень удачный наряд...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490120
					]
				}
			]
		}
	]
}