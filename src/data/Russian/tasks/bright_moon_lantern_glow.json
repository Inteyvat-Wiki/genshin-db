			"completionStepIds": [
				7114901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7114901",
							"2"
						],
						"stepId": 7114901,
						"stateName": "QUEST_STATE_UNFINISHED"
