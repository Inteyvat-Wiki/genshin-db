					"nextDialogs": [
						223051405
					]
				},
				{
					"id": 223051405,
					"content": "Хм? Ах, да! Конечно! Вот, прошу вас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051406
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223051406,
					"content": "#Увидимся в следующий раз, {F#госпожа}{M#господин}!",
