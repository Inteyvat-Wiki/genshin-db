			"dialogs": [
				{
					"id": 223050501,
					"content": "600 мора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050502
					]
				},
				{
					"id": 223050502,
					"content": "А вы знаете толк в камнях. С таким подходом вы обязательно приумножите своё богатство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050503
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050503,
					"content": "Пожалуйста, вот наши лучшие камни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050504
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050504,
					"content": "Не спешите. Уверяю вас, это камни высочайшего качества.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050505
					],
					"speakerTitle": "Ши Тоу"
				},
