					"nextDialogs": [
						223050302
					]
				},
				{
					"id": 223050302,
					"content": "#Отличный выбор, {F#госпожа}{M#господин}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050303
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050303,
					"content": "Выбирайте с умом. Вы же не хотите выбросить две сотни монет на ветер?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050304
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050304,
					"content": "Сообщите мне, когда определитесь с выбором.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ши Тоу"
				}
			]
		},
