					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ши Тоу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050101,
					"content": "#{F#Госпожа}{M#Господин}! Испытайте свою удачу! Сделайте ставку на один из камней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						223050104,
						223050108
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050102,
					"content": "Давай попробуем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050103
					]
				},
				{
					"id": 223050103,
					"content": "#Отличное решение, {F#госпожа}{M#господин}! Я уверен, что вы не пожалеете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050116
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050116,
					"content": "#Прошу, пройдите сюда, {F#госпожа}{M#господин}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050104,
					"content": "О каких камнях идёт речь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050105
					]
				},
				{
					"id": 223050105,
					"content": "Отборные необработанные камни из моего магазина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050106
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050106,
					"content": "#Вы покупаете камень, и если внутри окажется нефрит, то вас ожидает щедрый приз. Разумеется, если нет нефрита, нет денег, {F#госпожа}{M#господин}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050107
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050107,
					"content": "Но не верьте мне на слово. Попробуйте сами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						22305108
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050108,
					"content": "Откуда эти камни?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050109
					]
				},
				{
					"id": 223050109,
					"content": "Все камни, которые вы найдёте в этом магазине, были добыты в Разломе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050110
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050110,
					"content": "Уверяю вас, «Загадка нефрита» уже несколько поколений занимается нефритом. Мы точно знаем, какие камни обладают ценностью, а какие нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050111
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050111,
					"content": "Но за последнее время многое поменялось... Департамент по делам граждан решил закрыть Разлом и запретить там добычу руды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050112
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050112,
					"content": "Когда поставки новых камней прекратились, наши запасы начали истощаться. Невероятно, но сейчас камни стоят дороже, чем нефритовые украшения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050113
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050113,
					"content": "И я подумал, почему бы не продавать сами камни? Можно неплохо сэкономить на обработке. К тому же появляется элемент неожиданности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050114
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050114,
					"content": "#Изволите ли испытать судьбу, {F#госпожа}{M#господин}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050115
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050115,
					"content": "Я попробую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050116
					]
				}
			]
		},
		{
