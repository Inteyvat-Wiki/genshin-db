			"dialogs": [
				{
					"id": 223050401,
					"content": "400 мора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050402
					]
				},
				{
					"id": 223050402,
					"content": "Именно такую сумму я рекомендую тратить новичкам. Это не слишком много, но и не мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050403
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050403,
					"content": "Прошу вас, выберите один из камней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050404
					],
					"speakerTitle": "Ши Тоу"
				},
				{
					"id": 223050404,
					"content": "Дайте мне знать, когда сделаете выбор. Я вскрою для вас камень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ши Тоу"
				}
			]
		},
