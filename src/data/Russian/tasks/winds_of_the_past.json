			"dialogs": [
				{
					"id": 3061101,
					"content": "Вот он! Один из заброшенных <color=#00E1FFFF>храмов Хранителей четырёх ветров</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061102
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061102,
					"content": "Эти храмы пустуют уже давно. Жители Мондштадта сюда не ходят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061103
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061103,
					"content": "Есть вероятность, что внутри нас ждут хиличурлы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061104
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061104,
					"content": "Даже Ужас Бури покинул свой храм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061105,
						3061106
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061105,
					"content": "Ужас Бури?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				},
				{
					"id": 3061107,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061108
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061108,
					"content": "В это сложно поверить, но когда-то Ужас Бури был одним из Хранителей четырёх ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061109
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061109,
					"content": "Не может быть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3061110,
					"content": "#Погоди! Ты тоже это почувствовал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061111
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061111,
					"content": "С этим ветром что-то не так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061112
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061112,
					"content": "#Надо проверить, {NICKNAME}. Осторожнее, я чувствую присутствие дракона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061106,
					"content": "Свой храм?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				}
			]
		},
