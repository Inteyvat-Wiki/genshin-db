			"dialogs": [
				{
					"id": 3061001,
					"content": "Ух... Я устала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061002
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061002,
					"content": "Но мы должны помочь Джинн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061003
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061003,
					"content": "Раньше мы могли поручиться за безопасность Мондштадта и его жителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061004
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061004,
					"content": "Благодаря Джинн, конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061005
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061005,
					"content": "Но сейчас, когда Ужас Бури напрямую атакует город...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061006
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061006,
					"content": "Ветра изменили направление, а мы должны поменять тактику.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061007,
						3061008
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061007,
					"content": "Неплохо сказано!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				},
				{
					"id": 3061009,
					"content": "Лиза любит так говорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061010
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061010,
					"content": "Кстати! О Хранителях четырёх ветров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061011
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061011,
					"content": "Если хочешь узнать побольше о нашей истории, лучше поговори с Лизой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061012
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061012,
					"content": "Не то что бы я не знала нашу историю! Просто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061013
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061013,
					"content": "В смысле, библиотекарь наверняка должен знать больше, чем простой скаут!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3061008,
					"content": "Ты сама это придумала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				}
			]
		},
