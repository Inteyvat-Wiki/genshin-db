			"trigger": {
				"objectNames": [
					"Ксавье"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721190101,
					"content": "#Ох! А, путешественни{F#ца}{M#к}... Дело, кажется, плохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190102
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190102,
					"content": "Фатуи внутри собрались вокруг ядра. Похоже, они что-то обнаружили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190103
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190103,
					"content": "Вряд ли они собираются нарушить защиту ядра... Нет, мы больше не можем медлить. Мы должны приступить к испытаниям работоспособности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190104
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190104,
					"content": "Испытаниям работоспособности?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190105
					]
				},
				{
					"id": 721190105,
					"content": "Я имею в виду, что мы должны испытать очистительные способности нашего машинного друга. Я не собираюсь отправить его в печь только для того, чтобы узнать, что он не работает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190106
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190106,
					"content": "А потому помоги мне, пожалуйста, найти трёх оникабуто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190107
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190107,
					"content": "Я размещу их вокруг горна, и они пропитаются его энергией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190108
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190108,
					"content": "А потом мы применим это устройство, чтобы очистить их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190109
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190109,
					"content": "Вот такое испытание я придумал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190110
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190110,
					"content": "А где мне искать этих оникабуто?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190111
					]
				},
				{
					"id": 721190111,
					"content": "Хм-м, припоминаю, что обычно их можно было найти в районах, богатых Электро элементом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190112
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190112,
					"content": "А ещё говорят, что они способны выжить рядом с горном Микагэ. Суровые же они ребята...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190113
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190113,
					"content": "Почему я не могу просто поймать их в горне Микагэ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190114
					]
				},
				{
					"id": 721190114,
					"content": "Можно было бы поступить и так, но если ты заберёшь оникабуто непосредственно из горна Микагэ для испытаний...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190115
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190115,
					"content": "Честно говоря, я переживаю за надёжность своей машинки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190116
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190116,
					"content": "Ведь испытания лучше проводить одно за другим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190117
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190117,
					"content": "Кхе-кхе. Ну ладно... Помоги мне, пожалуйста, найти трёх оникабуто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190118,
						721190120
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190118,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190119
					]
				},
				{
					"id": 721190119,
					"content": "Прошу тебя. Трёх будет достаточно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190120,
					"content": "#Я могу войти в горн и сам{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190121
					]
				},
				{
					"id": 721190121,
					"content": "Ну... Ты действительно можешь выступить подопытным субъектом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190122
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190122,
					"content": "Но как я уже говорил, надёжность моего устройства может не оправдать ожидания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190123
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190123,
					"content": "Если во время процесса очистки произойдёт что-то неожиданное, у вас тоже... ну, могут случиться непредвиденные трудности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190124
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190124,
					"content": "Кхм. Давай пока просто придерживаться моего плана с оникабуто, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190125
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721190125,
					"content": "Трёх будет достаточно! Когда поймаешь, просто принеси их сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				}
			]
		},
