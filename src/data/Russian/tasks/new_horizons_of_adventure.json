				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221110101,
					"content": "Новые поручения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110102
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110102,
					"content": "Ох, это ты! В Мондштадте уже все знают о твоих подвигах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110103
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110103,
					"content": "#Продолжай в том же духе - и обязательно станешь {M#величайшим искателем}{F#величайшей искательницей} приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110104,
						221110107
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110104,
					"content": "У тебя есть для меня задания?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110105
					]
				},
				{
					"id": 221110105,
					"content": "Если хочешь стать по-настоящему великим искателем приключений, тебе придётся исследовать новые места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110106
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110106,
					"content": "#Ты уже успел{F#а} накопить достаточно опыта, возможно, настала пора отправиться в другой город?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110110,
					"content": "Пожалуйста, отнеси это письмо Катерине в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110111,
						221110113
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110111,
					"content": "Катерине... в Ли Юэ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110112
					]
				},
				{
					"id": 221110112,
					"content": "Да. Я уверена, что ты без проблем узнаешь её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110115,
					"content": "Доставь это письмо Катерине в Ли Юэ. Она поможет тебе с поиском приключений на новом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110116
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110116,
					"content": "Но если ты вернёшься в Мондштадт, я буду рада тебе помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110117
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110117,
					"content": "Убедительно прошу тебя не вскрывать письмо. Если его содержимое будет потеряно, могут возникнуть ненужные трудности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110118
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110118,
					"content": "#Настало время сделать ещё один шаг навстречу к звёздам и к безднам, искатель{F#ница} приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110113,
					"content": "А тебя теперь называть «Катерина в Мондштадте»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110114
					]
				},
				{
					"id": 221110114,
					"content": "Можешь называть меня как угодно. Главное, чтобы тебе было удобно искать приключения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110107,
					"content": "Но я знаю только Мондштадт и его окрестности...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110108
					]
				},
				{
					"id": 221110108,
					"content": "Это потому что у тебя был доступ к приключениям только в этом регионе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110109
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110109,
					"content": "Но скоро это изменится. Тебе будет открыт весь мир!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Катерина"
				}
			]
		},
		{
			"id": 2211102,
			"completionStepIds": [
				2211102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211102",
							"2"
						],
						"stepId": 2211102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221110201,
					"content": "Вам письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110202
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110202,
					"content": "К звёздам и к безднам!\\nДобро пожаловать в Гильдию искателей приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110203
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110203,
					"content": "Я думаю, что это письмо адресовано вам...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110204
					]
				},
				{
					"id": 221110204,
					"content": "Письмо? Мне? Вы искатели приключений из Мондштадта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110205
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110205,
					"content": "Что это? Одуванчик? Что означает одуванчик в конверте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110206
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110206,
					"content": "Вы положили одуванчик в конверт, чтобы доказать, что вы из Мондштадта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110207
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110207,
					"content": "Это было совсем необязательно. В этом письме вполне достаточно информации о вашей личности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110208,
						221110210
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110208,
					"content": "#Я этого не делал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110209
					]
				},
				{
					"id": 221110209,
					"content": "Ничего страшного. Это не имеет значения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110214,
					"content": "#В этом письме говорится, что ты очень опытн{F#ая}{M#ый} искатель{F#ница} приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110215
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110215,
					"content": "#Если это правда, тогда ты {F#готова}{M#готов} к поручениям от Гильдии искателей приключений Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110216
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110216,
					"content": "Новые приключения ждут вас! Вперёд, к звёздам и к безднам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110210,
					"content": "Должно быть, это сделала Катерина...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110211
					]
				},
				{
					"id": 221110211,
					"content": "Катерина? Ах, вы имеете в виду Катерину в Мондштадте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110212
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110212,
					"content": "Зачем она положила одуванчик в конверт? Очень странно... Зачем искателю приключений одуванчик?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110213
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 221110213,
					"content": "Не будем обращать внимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "Катерина"
				}
			]
		}
	]
}