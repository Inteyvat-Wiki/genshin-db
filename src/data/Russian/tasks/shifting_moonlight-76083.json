					"nextDialogs": [
						760830611
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760830611,
					"content": "Объекты, построенные Фатуи в Нод-Крае, настолько заметны, что даже куухенки их запомнили...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830612
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760830612,
					"content": "Возвращайтесь. Вы превзошли самих себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760830613,
					"content": "Зонт.",
