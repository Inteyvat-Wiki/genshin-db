				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аффан",
					"Саббах"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070321,
					"content": "Через некоторое время из земли медленно появились ростки...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732070301
					]
				},
				{
					"id": 732070301,
					"content": "Метод Саббах действительно эффективен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732070302,
					"content": "Наконец взошло! Наконец-то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070303
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732070303,
					"content": "Похоже, желание господина Шафаката исполнилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070304
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732070304,
					"content": "Господин Аффан, ты говорил, что этот вид роз он вывел сам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070305
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732070305,
					"content": "Раз он вывел новый вид, то мог ли он быть, как и я, изгнанным сюда учёным?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070306
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732070306,
					"content": "Да... Он был изгнан в эту деревню и провёл всю свою жизнь в доме позади нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070307
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732070307,
					"content": "Вот оно что. Действительно, всех, кто стал изгнанником, ждёт одна и та же участь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070308
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732070308,
					"content": "Кстати говоря, вывести новые виды могут только лучшие учёные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070309
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732070309,
					"content": "Очень жаль, что такой человек, как он, за пределами Академии оказался никому не известен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070310
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732070310,
					"content": "Саббах думает о своём будущем, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070311,
						732070314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732070311,
					"content": "Выше нос!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070312
					]
				},
				{
					"id": 732070312,
					"content": "Верно, тебе ещё предстоит пройти долгий путь и многое сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070313
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732070313,
					"content": "Не унывай. Я не хочу, чтобы ты стала вторым проклятым стариком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732070317,
					"content": "Вы правы. Я не могу грустить в такое счастливое время. Вернёмся к делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070318
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732070318,
					"content": "Эти золотые розы пока только проросли, но ещё не расцвели. Я хочу наблюдать, пока они не расцветут. А вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070319
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732070319,
					"content": "Я тоже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070320
					]
				},
				{
					"id": 732070320,
					"content": "Давайте дадим им больше времени на усвоение питательных веществ, и тогда через некоторое время мы увидим, как они расцветут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732070314,
					"content": "(Даже не знаю, как успокоить Саббах...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070315
					]
				},
				{
					"id": 732070315,
					"content": "Не грусти. В конце концов он всё же оставил нам золотые розы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070316
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732070316,
					"content": "Они являются доказательством того, что дядя Шафакат существовал в этом мире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Аффан"
				}
			]
		},
