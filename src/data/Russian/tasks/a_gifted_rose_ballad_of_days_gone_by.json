			"dialogs": [
				{
					"id": 732900101,
					"content": "#Это сумерская роза, которую я сорвал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7329002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329002",
							"2"
						],
						"stepId": 7329002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Саббах"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732900201,
					"content": "Эти цветы вызывают у меня множество воспоминаний. Я приготовила для тебя подарок. Пожалуйста, прими его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900202
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732900202,
					"content": "Это семена растений, которые здесь не вырастут. Если у тебя есть дом в другом месте, то сможешь увидеть, как они вырастут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900203
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732900203,
					"content": "Гляди, как я разболталась! Зато на душе сразу стало легче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900204
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732900204,
					"content": "До вашего появления у меня здесь совсем не было друзей, поэтому я чувствовала себя одиноко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900207
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732900207,
					"content": "В деревне почти никто не разводит цветы для своего удовольствия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900208
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732900208,
					"content": "Хотя нет... Старик, что живёт к северу от деревни, тоже распахал участок для цветника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900209
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732900209,
					"content": "Я ходила к нему. Он довольно странный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900210
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732900210,
					"content": "Он сажал в землю камни, но уверял меня, что это цветы, а потом и вовсе выгнал меня оттуда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900211
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732900211,
					"content": "Человеку, который живёт без семьи, может быть одиноко. Я понимаю это чувство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900212
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732900212,
					"content": "#Если ты помог{F#ла} мне с сумерскими розами, то, может быть, поможешь и ему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900213
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732900213,
					"content": "Вы с Паймон можете навестить его, если найдётся время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Саббах"
				}
			]
		}
	]
