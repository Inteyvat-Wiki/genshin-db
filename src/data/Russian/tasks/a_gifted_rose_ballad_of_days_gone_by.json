					"Аффан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070501,
					"content": "«О, роза-роза, желанье исполни».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070502
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732070502,
					"content": "«Роза златая из камня росла и пела мне песни».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070503
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732070503,
					"content": "Она пела:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070504
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732070504,
					"content": "«Песни мне дали сил для рожденья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070505
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732070505,
					"content": "Песни одни лишь превыше судьбы и удела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070506
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732070506,
					"content": "«Победят меня, победят время и вечное увядание жизни...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070507
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732070507,
					"content": "Это песня, которой дядя Шафакат когда-то научил нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аффан"
				}
			]
		},
