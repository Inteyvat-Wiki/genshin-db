			"dialogs": [
				{
					"id": 751200101,
					"content": "Можно прыгать с любой высоты. Главное - выбрать, куда приземлиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200104
					],
					"speakerTitle": "Бицин",
					"speakerSubtitle": "Эксперт по тренировкам Повелителей Ночного Ветра"
				},
				{
					"id": 751200104,
					"content": "#Вот для чего нужно наше испытание воина. Как бы высоко тебя ни занесло, надо смотреть под ноги... Хочешь попробовать, {F#воительница}{M#воин} из далёких земель?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200102,
						751200103
					],
					"speakerTitle": "Бицин",
					"speakerSubtitle": "Эксперт по тренировкам Повелителей Ночного Ветра"
				},
				{
					"id": 751200102,
					"content": "Начнём!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Эксперт по тренировкам Детей Эха"
				},
				{
					"id": 751200103,
					"content": "Мне нужно подготовиться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Эксперт по тренировкам Детей Эха"
				}
			]
		},
		{
