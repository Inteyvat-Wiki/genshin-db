			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сангономия Кокоми"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210101,
					"content": "Похоже, это лагерь Фатуи, о котором говорил купец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210102
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210102,
					"content": "Выглядит так, будто это был лагерь хиличурлов. Зачем Фатуи заняли его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210103
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210103,
					"content": "Ох, сколько охраны... Как нам проникнуть внутрь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120210104,
					"content": "Уж точно не посредством силы. Ничего, рельеф этой местности нам на руку, и нас ещё не обнаружили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210105
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210105,
					"content": "Враг на свету, пока мы в тени. У нас тактическое преимущество.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210106
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210106,
					"content": "И какие у нашего великого стратега идеи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210107
					]
				},
				{
					"id": 120210107,
					"content": "Думаю, у нас три варианта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210108
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210108,
					"content": "Вариант первый. Начнём с главаря. Силы Фатуи в Инадзуме особой угрозы уже не представляют. Они всего лишь недобитые остатки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210109
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210109,
					"content": "Нападём с воздуха и ликвидируем их командующего, а остальные в сумятице не смогут оказать должного сопротивления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210110
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210110,
					"content": "#Вариант второй. Ударим по слабому месту. Вон там, {NICKNAME}, к примеру, пороховые бочки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210111
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210111,
					"content": "Если бы мы смогли подорвать бочки и не выдать себя, это нанесло бы им сокрушительный удар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210112
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210112,
					"content": "Боевой дух и боеспособность застигнутого врасплох противника будут сломлены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210113
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210113,
					"content": "Вариант третий. Применим против них окружение. Рядом море, поэтому воздух влажный. Я могла бы сконцентрировать водяной пар, и вместе с твоей молнией мы бы парализовали их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210114
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210114,
					"content": "Вот так стратег! Сразу столько способов... какой же нам выбрать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120210115,
					"content": "Это уже зависит от того, как вы оцениваете свои способности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210116
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210116,
					"content": "Атака с воздуха - самая быстрая, но требует выдающихся боевых навыков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210117
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210117,
					"content": "Взрывом мы быстро сократим их ряды без тяжёлых боёв. Но тогда нужно быть максимально незаметными, чтобы не дать им обнаружить нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210118
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210118,
					"content": "#Если будем использовать окружение, бой может затянуться. Что предпочитаешь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210119,
						120210123,
						120210127
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210119,
					"content": "Внезапную атаку с воздуха.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210120
					]
				},
				{
					"id": 120210120,
					"content": "Ха-ха... Узнаю командира Рыбы-меча II. Ни тени сомнения в собственных силах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210121
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210121,
					"content": "#Значит, решено. Будем сражаться вместе. Я не воин, но поддержу тебя, и уж точно не отправлю в бой {F#одну}{M#одного}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210122
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210122,
					"content": "Расправимся с ними как можно скорее и заберём товары купца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210123,
					"content": "Подорвём пороховые бочки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210124
					]
				},
				{
					"id": 120210124,
					"content": "Ха-ха... Кажется, наши взгляды на тактики сходятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210125
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210125,
					"content": "Я тоже предпочитаю этот вариант. Так мы рискуем меньше всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210126
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210126,
					"content": "Устроим же им сюрприз, который они запомнят до самой смерти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210127,
					"content": "Удивим их молниями.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210128
					]
				},
				{
					"id": 120210128,
					"content": "Хорошо. Для начала оттащим их от лагеря, чтобы оставить его в целости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210129
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210129,
					"content": "У меня ещё не было особой возможности сражаться рядом с тобой. Не знаю, поспею ли я за тобой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210130
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210130,
					"content": "Но ты не беспокойся. Я хоть и не смею называть себя воином, на поле боя я как дома. Этот бой определённо мне по плечу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210131
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210131,
					"content": "Ладно. Зачистим лагерь и посмотрим, что они там затеяли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				}
			]
		},
		{
			"id": 1202102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сангономия Кокоми"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210201,
					"content": "Удивительно, что Фатуи укрывались в лагере хиличурлов. Полагаю, они действовали отсюда втайне уже давно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210202
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210202,
					"content": "Какова их цель? Неужели солдаты правы? Они и в самом деле вступили в сговор с комиссией Тэнрё?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210203
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210203,
					"content": "Обыщем лагерь на предмет улик. Если купец не солгал, его товар тоже должен быть здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210204
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210204,
					"content": "Ладно! Пора хорошенько осмотреться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1202103,
			"completionStepIds": [
				1202108,
				1202118
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202108",
							"2"
						],
						"stepId": 1202108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сангономия Кокоми"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210301,
					"content": "Кокоми!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120210302,
					"content": "Кокоми, мы нашли товар купца. Посмотри!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120210303,
					"content": "Хм... Ясно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210304,
						120210305
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210304,
					"content": "Что-то не так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				},
				{
					"id": 120210306,
					"content": "Нет, ничего. Я просто немного отвлеклась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210307
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210307,
					"content": "Посмотрим, что здесь... Да, это украденные товары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210308
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210308,
					"content": "Еда, лекарства, орудия земледелия... Всё, что нужно для восстановления после войны. Видимо, он собирал их, чтобы продать подороже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210309
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210309,
					"content": "Вряд ли всё это понадобится комиссии Тэнрё. Не думаю, что он поставлял эти товары им.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210310
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210310,
					"content": "Скорее всего, он просто спекулянт. Вопреки ожиданиям Мацуды и Утимуры, ничего преступного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210311
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210311,
					"content": "Ух... Но ведь этот гад собирался нажиться на вещах, в которых так отчаянно нуждаются люди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120210312,
					"content": "Мы же их не отдадим ему? Это как-то неправильно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120210313,
					"content": "Не волнуйся, я уже всё предусмотрела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210314
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210314,
					"content": "В недавнем Временном послевоенном указе я ограничила цены на товары первой необходимости. Все эти вещи достанутся людям по умеренной цене.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210315
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210315,
					"content": "Потрудись он прочесть этот указ, то не оказался бы в таком затруднительном положении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210316
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210316,
					"content": "Хе-хе, как здорово, что ты всё продумала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120210317,
					"content": "Ах, если бы. Взять слухи о сговоре Фатуи и комиссии Тэнрё. Я до сих пор сбита с толку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210318
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210318,
					"content": "Такое бывает, когда мало энергии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210319
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210319,
					"content": "Хм? О чём ты, Кокоми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120210320,
					"content": "Ни о чём. Давайте отнесём товары обратно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210321
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210321,
					"content": "Скоро начнётся пир в честь победы. Необходимо как можно скорее разобраться со всем этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210322
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210322,
					"content": "Хорошо! Сначала восстановим мир, а потом пойдём на пир!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120210305,
					"content": "Тебя что-то беспокоит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				}
			]
		},
		{
			"id": 1202104,
			"completionStepIds": [
				1202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202109",
							"2"
						],
						"stepId": 1202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нарусэ",
					"Мацуда",
					"Сангономия Кокоми",
					"Утимура"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210401,
					"content": "Мои товары! Вы их вернули!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210402
					],
					"speakerTitle": "Нарусэ"
				},
				{
					"id": 120210402,
					"content": "Спасибо, ваше превосходительство! Спасибо и вам, командир!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210403
					],
					"speakerTitle": "Нарусэ"
				},
				{
					"id": 120210403,
					"content": "Видите? А я вам говорил, что невиновен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210404
					],
					"speakerTitle": "Нарусэ"
				},
				{
					"id": 120210404,
					"content": "Хм... Кто тебя знает. Ты мог обо всём договориться с Фатуи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210405
					],
					"speakerTitle": "Мацуда"
				},
				{
					"id": 120210405,
					"content": "Согласно сведениям из лагеря Фатуи, у него с ними связи не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210406
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210406,
					"content": "В противном случае с учётом того, как ведут дела Фатуи, в лагере остались бы доказательства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210407
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210407,
					"content": "Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210408
					],
					"speakerTitle": "Утимура"
				},
				{
					"id": 120210408,
					"content": "Никаких «но». Товары мы вернули. Это доказывает его невиновность, как мы и договаривались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210409
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210409,
					"content": "Простите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210410
					],
					"speakerTitle": "Мацуда"
				},
				{
					"id": 120210410,
					"content": "Мы, наверное, увлеклись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210411
					],
					"speakerTitle": "Утимура"
				},
				{
					"id": 120210411,
					"content": "Хе-хе! Что я вам говорил, солдафоны? Вместо того, чтобы исполнять долг, решили меня помурыжить. Теперь вы понимаете, что не правы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210412
					],
					"speakerTitle": "Нарусэ"
				},
				{
					"id": 120210412,
					"content": "Вы, господин купец, тоже не слишком радуйтесь. Может, изначальные обвинения с вас и сняты, но по последнему указу злостное накопление предметов первой необходимости с целью наживы является преступлением. Вы понесёте наказание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210413
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210413,
					"content": "Вы уже признали, что являетесь владельцем этих товаров, поэтому в отношении вас будут приняты соответствующие меры. Вы не только продадите эти товары по приемлемой цене, но и оплатите штраф, размер которого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210414
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210414,
					"content": "Постойте, постойте! Ваше превосходительство, вы на чьей стороне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210415
					],
					"speakerTitle": "Нарусэ"
				},
				{
					"id": 120210415,
					"content": "Ни на чьей. Как Божественная Жрица острова Ватацуми, я следую принципам справедливости в награждении и в наказании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210416
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210416,
					"content": "Заслуги следует награждать, а проступки наказывать. Более серьёзные обвинения с вас были сняты, но это не освобождает вас от ответственности за содеянное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210417
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210417,
					"content": "Я... но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210418
					],
					"speakerTitle": "Нарусэ"
				},
				{
					"id": 120210418,
					"content": "Чего уставились? Уведите его. Настал час преступления и наказания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210419
					],
					"speakerTitle": "Мацуда"
				},
				{
					"id": 120210419,
					"content": "Ваше превосходительство, он хоть и утверждает, что эти товары его, но что-то тут не сходится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210420
					],
					"speakerTitle": "Утимура"
				},
				{
					"id": 120210420,
					"content": "Те, что с эмблемой комиссии Тэнрё, наверняка его, но не остальные. Особенно эти. Они явно принадлежат святилищу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210421
					],
					"speakerTitle": "Утимура"
				},
				{
					"id": 120210421,
					"content": "Хм... Видимо, Фатуи сбрасывали всё краденое в одну кучу. Имущество святилища предоставьте мне. Остальное просмотрите и постарайтесь вернуть законным владельцам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210422
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210422,
					"content": "Знаю, я требую многого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210423
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210423,
					"content": "Вовсе нет, ваше превосходительство. Мы всё сделаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210424
					],
					"speakerTitle": "Утимура"
				},
				{
					"id": 120210424,
					"content": "Всё же, ваше превосходительство, хоть и признаков сговора обнаружено не было, но что-то между комиссией Тэнрё и Фатуи творится неладное. Солдаты собственными глазами видели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210425
					],
					"speakerTitle": "Утимура"
				},
				{
					"id": 120210425,
					"content": "Грядут переговоры о мире, поэтому... прошу учесть это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210426
					],
					"speakerTitle": "Утимура"
				},
				{
					"id": 120210426,
					"content": "Твои опасения мне понятны. Я обязательно обдумаю это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210427
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210427,
					"content": "#{NICKNAME}, я отнесу эти предметы в святилище Сангономии. Пройдёшься со мной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				}
			]
		},
		{
			"id": 1202108,
			"completionStepIds": [
				1202114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202114",
							"2"
						],
						"stepId": 1202114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сангономия Кокоми"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210804,
					"content": "Знаешь ли, самое старое святилище на Ватацуми было не в Сангономии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210805
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210805,
					"content": "Оно находилось рядом со статуей семи Архонтов. В те времена народ Ватацуми признавал существование сёгуна, хоть и не почитал её подобно сёгунату.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210806
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210806,
					"content": "Но когда она сразила покровительствующее нам божество, святилище забросили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210807
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210807,
					"content": "С тех самых пор отношения между Ватацуми и сёгунатом испортились. Недоверие пустило глубокие корни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210808
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210808,
					"content": "Я намеревалась обсудить это на переговорах о мире. Старые обиды однажды придётся оставить в стороне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210809
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210809,
					"content": "Ваше превосходительство, как вам удалось выкроить время и почтить нас визитом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210810
					],
					"speakerTitle": "Ёко"
				},
				{
					"id": 120210810,
					"content": "У вас усталый вид. Вам следует заботиться о себе. В ваших руках судьбы всех нас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210811
					],
					"speakerTitle": "Ёко"
				},
				{
					"id": 120210811,
					"content": "Да, благодарю за беспокойство, но я в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210812
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210812,
					"content": "Ваше превосходительство, прислушайтесь к моему совету. После этой долгой войны с сёгуном мир не установится, если его просто провозгласить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210813
					],
					"speakerTitle": "Юна"
				},
				{
					"id": 120210813,
					"content": "Если мы заключим с ними перемирие, выйдет, что защищавшее нас божество погибло зря...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210814
					],
					"speakerTitle": "Юна"
				},
				{
					"id": 120210814,
					"content": "Что ты, всё это в далёком прошлом. К тому же бои только закончились. Мы должны быть благодарны, что вновь установился мир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210815
					],
					"speakerTitle": "Ёко"
				},
				{
					"id": 120210815,
					"content": "Знаю, просто... Ах, в этих переговорах нужно оставаться сильными. Нельзя сразу же идти на уступки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210816
					],
					"speakerTitle": "Юна"
				},
				{
					"id": 120210816,
					"content": "Мне понятны ваши опасения. Я всё рассмотрю и приступлю к ним должным образом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210817
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210817,
					"content": "Замечательно... Мы рассчитываем на вас, ваше превосходительство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210818
					],
					"speakerTitle": "Юна"
				},
				{
					"id": 120210818,
					"content": "Ваше превосходительство? Ой, такая честь встретиться с вами здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210819
					],
					"speakerTitle": "Сиори"
				},
				{
					"id": 120210819,
					"content": "Вы знаете, моя дочь записалась на отбор в жрицы святилища. Если она попадёт в Сангономию, я буду так рада! Вы добры и милосердны. Она окажется в хороших руках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210820
					],
					"speakerTitle": "Сиори"
				},
				{
					"id": 120210820,
					"content": "Эх, я всегда говорю дочери, что следует использовать любую возможность учиться у вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210821
					],
					"speakerTitle": "Сиори"
				},
				{
					"id": 120210821,
					"content": "Вы ещё так молоды, но столь зрелы и мудры. Для моей дочери вы всегда были образцом для подражания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210822
					],
					"speakerTitle": "Сиори"
				},
				{
					"id": 120210822,
					"content": "Если она прибудет в Сангономию, я присмотрю за ней...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210823
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210823,
					"content": "Ах, ваше превосходительство! Как же я рад, что вы пришли. Как вам известно, у нас пострадала урожайность. Позвольте ввести вас в курс дела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210824
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 120210824,
					"content": "#Ваше превосходительство, это командир Рыбы-меча II? {F#Она}{M#Он} останется жить на Ватацуми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210825
					],
					"speakerTitle": "Рёко"
				},
				{
					"id": 120210825,
					"content": "Ваше превосходительство...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210826
					],
					"speakerTitle": "Юкия"
				},
				{
					"id": 120210826,
					"content": "Ух... Пожалуйста, чуть тише. Я выслушаю все ваши запросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210827
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210827,
					"content": "Если запрос у вас длинный, предлагаю написать доклад и отправить его в святилище. Когда у меня будет время, я на всё отвечу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210828
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210828,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210829
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210829,
					"content": "#{NICKNAME}, ты в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210830,
						120210832
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210830,
					"content": "В полном.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210831
					]
				},
				{
					"id": 120210831,
					"content": "Хех... Тебе наверняка такое нипочём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210834,
					"content": "Ваше превосходительство, вот вы где.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210835
					],
					"speakerTitle": "Идзуми Наки"
				},
				{
					"id": 120210835,
					"content": "У нас инцидент. До сих пор не пришла партия церемониальной утвари. Я начинаю беспокоиться, что её украли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210836
					],
					"speakerTitle": "Идзуми Наки"
				},
				{
					"id": 120210836,
					"content": "О, не стоит, мы её уже вернули.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210837
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210837,
					"content": "Правда? Вы удивительный человек, ваше превосходительство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210838
					],
					"speakerTitle": "Идзуми Наки"
				},
				{
					"id": 120210838,
					"content": "Я рассортировала все недавно поступившие бумаги и оставила их у вас на столе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210839
					],
					"speakerTitle": "Идзуми Наки"
				},
				{
					"id": 120210839,
					"content": "К тому же вы как раз успели на встречу по вопросам развития текстильной отрасли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210840
					],
					"speakerTitle": "Идзуми Наки"
				},
				{
					"id": 120210840,
					"content": "Встреча... прямо сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210841
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210841,
					"content": "Да. Две госпожи уже прибыли и ожидают вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210842
					],
					"speakerTitle": "Идзуми Наки"
				},
				{
					"id": 120210842,
					"content": "#Понятно... {NICKNAME}, я вообще-то собиралась погулять с тобой по острову, но пока это придётся отложить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210843
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210843,
					"content": "Давай встретимся завтра у входа в святилище Сангономии и пойдём готовиться к пиру в честь победы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210844
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210844,
					"content": "Ура, пир в честь победы! Будет много всего вкусного, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210845
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120210845,
					"content": "Ха-ха... А как же. Будут также особые лакомства Ватацуми, которые обязательно вам понравятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210846
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210846,
					"content": "Ура! Тогда до завтра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210847
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120210847,
					"content": "М-м...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120210832,
					"content": "Это несколько утомляет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210833
					]
				},
				{
					"id": 120210833,
					"content": "Меня тоже. У меня уже голова болит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Сангономия Кокоми"
				}
			]
		},
