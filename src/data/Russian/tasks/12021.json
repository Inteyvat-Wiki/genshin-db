			},
			"dialogs": [
				{
					"id": 120211101,
					"content": "Хм. Мы, мягко говоря, отклонились от плана...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211102
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120211102,
					"content": "Ничего, случается и подобное. Обстановка на поле боя вещь сложная и изменчивая. Не обязательно всегда строго придерживаться принятой тактики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211103
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120211103,
					"content": "Хи-хи... Кажется, когда началась схватка, все о плане забыли, и пришлось импровизировать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120211104,
					"content": "Тем не менее результат вполне удовлетворителен. Это доказывает, что вы прекрасно умеете действовать сообразно обстановке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211105
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120211105,
					"content": "Удивительно, что Фатуи укрывались в лагере хиличурлов. Полагаю, они действовали отсюда втайне уже давно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211106
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120211106,
					"content": "Какова их цель? Неужели солдаты правы? Они и в самом деле вступили в сговор с комиссией Тэнрё?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211107
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120211107,
					"content": "Обыщем лагерь на предмет улик. Если купец не солгал, его товар тоже должен быть здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211108
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120211108,
					"content": "Ладно! Пора хорошенько осмотреться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
