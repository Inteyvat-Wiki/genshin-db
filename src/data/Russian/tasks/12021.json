				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120211001,
					"content": "#Отлично сработано, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211002
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120211002,
					"content": "Хи-хи, всё благодаря твоей гениальной тактике!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120211003,
					"content": "Успех даже лучших из тактик всецело зависит от сил исполнителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211004
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120211004,
					"content": "Для победы необходимы слаженные действия всех участников. Битвы не выигрывают в одиночку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211005
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120211005,
					"content": "К слову, Паймон тоже приложила немало усилий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211006
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120211006,
					"content": "Осмелюсь не согласиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120211007
					]
				},
				{
					"id": 120211007,
					"content": "Эй! Паймон помогала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211008
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120211008,
					"content": "Удивительно, что Фатуи укрывались в лагере хиличурлов. Полагаю, они действовали отсюда втайне уже давно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211009
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120211009,
					"content": "Какова их цель? Неужели солдаты правы? Они и в самом деле вступили в сговор с комиссией Тэнрё?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211010
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120211010,
					"content": "Обыщем лагерь на предмет улик. Если купец не солгал, его товар тоже должен быть здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211011
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120211011,
					"content": "Ладно! Пора хорошенько осмотреться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
