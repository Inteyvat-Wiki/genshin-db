			"dialogs": [
				{
					"id": 150421401,
					"content": "Как ощущения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421402,
						150421404,
						150421406
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421402,
					"content": "#Хорошо {F#расслабилась}{M#расслабился}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421403
					]
				},
				{
					"id": 150421403,
					"content": "#Ха, смело. Но ты и правда показал{F#а} отличный уровень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421408,
					"content": "Наверное, я дам пару советов работникам и предложу внести некоторые изменения в правила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421409
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421409,
					"content": "Всё равно... нужно, чтобы стрелки могли соревноваться друг с другом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421404,
					"content": "В глазах рябит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421405
					]
				},
				{
					"id": 150421405,
					"content": "Ха-ха, фокусировка внимания отнимает много сил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421406,
					"content": "Было весело.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421407
					]
				},
				{
					"id": 150421407,
					"content": "Да? Значит, мы пришли к одинаковому выводу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Часка"
				}
			]
		},
