			"trigger": {
				"objectNames": [
					"Часка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150421301,
					"content": "Глаз-алмаз. Не думала, что ты заметишь меня здесь, наверху.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421302
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421302,
					"content": "#Тоже обратил{F#а} внимание на местные аттракционы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421303,
						150421305
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421303,
					"content": "Они интересные?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421304
					]
				},
				{
					"id": 150421304,
					"content": "#Мне кажется, да. Но дело это субъективное, надо {F#самой}{M#самому} попробовать, чтобы узнать наверняка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421307,
					"content": "Видишь там рельсы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421308
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421308,
					"content": "Стреляй шариками с краской в шары, выстроенные в ряд на рельсах. Как только все шары станут одного цвета, они лопнут и исчезнут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421309
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421309,
					"content": "Но очень может быть, что исчезнут они только после того, как тебя сменит другой стрелок со своим пистолетом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421310,
						150421311
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421310,
					"content": "Круто...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421312,
					"content": "Может, попробуешь? Пистолет тебя ждёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421313
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421313,
					"content": "Я буду смотреть, как у тебя получается. Удачи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421311,
					"content": "Тебе почти удалось меня запугать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421305,
					"content": "Они сложные?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421306
					]
				},
				{
					"id": 150421306,
					"content": "Расслабься. Мы на курорте «Оазис отдыха», всё «сложное» и «утомительное» здесь под запретом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Часка"
				}
			]
