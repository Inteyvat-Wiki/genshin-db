			"dialogs": [
				{
					"id": 150421701,
					"content": "Молодец, Муалани!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150421702,
					"content": "Уф... Вот это веселье! Что скажете? Я молодец?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421703
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150421703,
					"content": "Вот это да! А чего ещё ожидать от героини Натлана!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421704
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150421704,
					"content": "Пока тебя не было, Паймон рассказала мне о тебе, и твои подвиги так меня впечатлили! Я едва не вспыхнул от восторга, серьёзно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421705
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150421705,
					"content": "Ха-ха, спасибо! Теперь от радости мне хочется прямо здесь устроить вечеринку в горячих источниках и позвать всех друзей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421706
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150421706,
					"content": "Ого! Смотрите, это сотрудники залива Прибоя! Они столько трудились, что теперь собираются наконец-то включить музыку и устроить себе настоящий праздник!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421707
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150421707,
					"content": "Думаю, ты не угадала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421708
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150421708,
					"content": "Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421709
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150421709,
					"content": "Муалани, Муалани! Можете оставить мне автограф?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421710
					],
					"speakerTitle": "Туксина"
				},
				{
