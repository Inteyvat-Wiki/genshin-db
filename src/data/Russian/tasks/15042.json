			"dialogs": [
				{
					"id": 150420101,
					"content": "Ура-а-а-а!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420102
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420102,
					"content": "Солнце! Море! Кохолазавры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420103
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420103,
					"content": "Она от радости даже забыла, что её древнее имя - Умо{RUBY#[S]Единство}джа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150420104,
					"content": "Сюда, сюда! Ну же, скорее! Побежали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420105
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420105,
					"content": "Идём, идём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420106
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150420106,
					"content": "Смотрите! Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420107
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420107,
					"content": "Деревянная доска.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150420108,
					"content": "Читайте, что написано!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420109
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420109,
					"content": "Ага, это карта достопримечательностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150420110,
					"content": "Именно так! И ценность её не уступает ключу от сокровищницы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420111
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420111,
					"content": "Я понимаю! Карта всегда означает начало нового приключения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420112
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150420112,
					"content": "А ещё её можно сравнить с пылающей флогистоновой частицей, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420113
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420113,
					"content": "Флогистон? Эм... Это такой вид энергии? То есть... один взгляд на карту заряжает тебя безграничной энергией?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420114
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150420114,
					"content": "Так и есть! А ещё она обладает огромной важностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420115
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420115,
					"content": "Если у вас есть карта, с которой можно сверяться, вы всегда сможете проложить собственный путь, полный свободы и приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420116
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420116,
					"content": "Хе-хе! Свобода! Приключения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420117
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150420117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420118
					],
					"speakerTitle": "Аша"
				},
				{
					"id": 150420118,
					"content": "Подожди... Не торопись сразу соглашаться. Почему Паймон кажется, что в словах Муалани есть скрытый смысл?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150420119,
					"content": "Ну что, теперь каждый отправляется в собственное приключение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420120
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420120,
					"content": "Что это за проводник, который отправляет туристов в свободное плавание, едва добравшись до красивого места?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420121,
						150420122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150420121,
					"content": "Может, Муалани хочется погулять одной...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				},
				{
					"id": 150420123,
					"content": "#Хе-хе, ты отличный друг! Я запомню, что ты меня {M#прикрыл}{F#прикрыла}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420124
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420124,
					"content": "Хе-хе, смотрите! Возле двух больших аттракционов написано: «Ожидает проверки». Наверное, там случились какие-то неполадки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420125
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420125,
					"content": "Давайте разделимся и опробуем те аттракционы, которые больше нравятся? Развлечёмся, а заодно поможем сотрудникам с отладкой. Кто знает, вдруг благодаря нам залив Прибоя раньше откроется для посетителей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420126
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420126,
					"content": "А Паймон думала, ты бросишь нас ради своих любимых водных развлечений. Значит, ты всё-таки думаешь о группе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150420127,
					"content": "Хе-хе, когда закончим, встречаемся у здания в виде гигантского кохолазавра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420128
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420128,
					"content": "Интуиция, приобретённая за годы работы проводником, подсказывает, что проход к главному испытанию должен быть где-то рядом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420129
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420129,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420130
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150420130,
					"content": "Тогда давайте разделимся! Не забывайте сверяться с картой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150420122,
					"content": "Ясно. У нашего проводника сегодня выходной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				}
			]
		},
		{
