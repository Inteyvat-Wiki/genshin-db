				]
			},
			"dialogs": [
				{
					"id": 756690101,
					"content": "#{NICKNAME}, иди сюда! Паймон хочет тебе кое-что показать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690102,
					"content": "Смотри, все эти фото Паймон сделала, пока мы путешествовали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690103,
					"content": "#Мы много где побывали. Пока ты всё исследовал{F#а}, Паймон тоже не сидела сложа руки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690104,
					"content": "Вот. Всё это Паймон сняла на собственную фотокамеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690105,
					"content": "Кстати, помнишь, мы в «Галерее Дамовиль» купили два фотоальбома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690106,
						756690108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690106,
					"content": "Помню.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690107
					]
				},
				{
					"id": 756690107,
					"content": "#Паймон так и знала, что ты не забыл{F#а}! Паймон тогда долго, очень долго копила мелочь, чтобы заказать их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690111,
					"content": "Оба фотоальбома в одном стиле, один был для тебя, другой для меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690112,
					"content": "Не знаю, как твой, а фотоальбом Паймон уже раздулся от фотографий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690113,
					"content": "Паймон недавно купила новый фотоальбом, запасной, но если в твоём уже нет места, то можешь его использовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690114,
						756690117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690114,
					"content": "Паймон, тебе нравится делать фото?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690115
					]
				},
				{
					"id": 756690115,
					"content": "Конечно! Подумай только, сколько мы с тобой обошли самых разных мест, сколько видели такого, о чём обычные люди и не догадываются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690116,
					"content": "Было бы жалко не оставить фото на память.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690121,
					"content": "Более того, это важные воспоминания и для тебя, и для Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690122,
					"content": "Нужно дорожить воспоминаниями прошлого и опытом будущего, как верно заметил когда-то дядюшка Пакаль из племени Детей Эха, где живут тепетлизавры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690123,
					"content": "#Паймон одолжит тебе свою фотокамеру, чтобы ты смог{F#ла} ещё пофотографировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690124,
					"content": "Совсем скоро нас ждёт Снежная, и у Паймон такое ощущение, что это будет не самое лёгкое путешествие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690125,
					"content": "А пока можно вспомнить, что мы уже пережили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690126,
					"content": "Тогда, с какими бы трудностями мы ни столкнулись, накопленный опыт придаст нам смелости идти дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690117,
					"content": "Паймон такая щедрая!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690118
					]
				},
				{
					"id": 756690118,
					"content": "Хе-хе, ну разумеется. Щедрость - это одно из многих достоинств Паймон, лучшего проводника и компаньона во всём Тейвате.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690119,
					"content": "Паймон намеренно купила лишний фотоальбом, потому что любит фотографировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690120,
					"content": "За время нашего путешествия мы видели столько уникальных пейзажей, что было бы упущением не сделать фото на память.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690108,
					"content": "Не помню.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690109
					]
				},
				{
					"id": 756690109,
					"content": "#Эй, ты уже забыл{F#а}? Паймон тогда долго, очень долго копила мелочь, чтобы заказать их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756690110,
					"content": "Ладно-ладно. Тебе и так много чего надо в голове постоянно держать. Твой великодушный проводник Паймон не станет принимать это близко к сердцу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690111
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}