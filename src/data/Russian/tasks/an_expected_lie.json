						],
						"stepId": 7413611,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7413611",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эдвин Истингхаус",
					"Лемарк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741363401,
					"content": "Как ты... Вернулся, значит? Хи-хи. Я же сказал, что ничего вы там не найдёте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363402
					],
					"speakerTitle": "Эдвин Истингхаус"
				},
				{
					"id": 741363402,
					"content": "Вы в безнадёжном положении. Садитесь, выпейте чайку. Я тут как раз пять чашечек прикупил... и несколько блюдец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363403
					],
					"speakerTitle": "Эдвин Истингхаус"
				},
				{
					"id": 741363403,
					"content": "Как же вам всё-таки нравится число пять, господин Эдвин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363404
					],
					"speakerTitle": "Лемарк"
				},
				{
					"id": 741363404,
					"content": "О, это волшебное число. При правильном подходе оно способно открыть для тебя двери к вдохновению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363405
					],
					"speakerTitle": "Эдвин Истингхаус"
				},
				{
					"id": 741363405,
					"content": "Отмечу, что всего у этих дверей пять створок. А значит, пять раз нужно опустить дверную ручку... пять! Понимаешь? Пять раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363406
					],
					"speakerTitle": "Эдвин Истингхаус"
				},
				{
					"id": 741363406,
					"content": "Если бы вы знали, как сильно мне хочется врезать вам пять раз. Так что прошу, помолчите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лемарк"
				}
			]
		}
	]
}