			"dialogs": [
				{
					"id": 741360401,
					"content": "Так вот почему он постоянно число пять упоминал... Он подсказывал нам, как решить загадку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741360402,
					"content": "Неужто сразу прямо нельзя было сказать? Зачем эти сложности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741360403,
					"content": "Хм, кто знает, что у него на уме. Однако он и впрямь всеми силами вёл нас по следу Нэкера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360404
					],
					"speakerTitle": "Шоссивер"
				},
				{
					"id": 741360404,
					"content": "Эти водолазные костюмы будто бы специально для нас подготовили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360405,
						741360406
					],
					"speakerTitle": "Шоссивер"
				},
				{
					"id": 741360405,
					"content": "Похоже, это он нашёл нас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				},
				{
					"id": 741360407,
					"content": "Нет никакой ценности... н-но я ведь чуть ли не душу в этот проект вложила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360408
					],
					"speakerTitle": "Фузилье"
				},
				{
					"id": 741360408,
					"content": "Бедняжка Фузилье... всю дорогу что-то себе под нос бормочет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741360409,
					"content": "#Кстати, {NICKNAME}, тебе не кажется, что за нами кто-то наблюдает? У Паймон по спине то и дело пробегает холодок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741360410,
					"content": "Я пойду вперёд. Посмотрю, что нас ждёт дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шоссивер"
				},
				{
					"id": 741360406,
					"content": "Сперва Нэкер, а потом остальное.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				}
			]
		},
