			"dialogs": [
				{
					"id": 741361101,
					"content": "#Фузилье! {NICKNAME}, вы вернулись! Всё улажено...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361102
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741361102,
					"content": "О... нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361103
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741361103,
					"content": "А-а-а! Господин Шуазёль вот-вот в обморок упадёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741361104,
					"content": "Не знал, что ты вернулся в Институт, Шуазёль. Мне казалось, твоя жизнь навеки связана с бюрократией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361105
					],
					"speakerTitle": "Эдвин Истингхаус"
				},
				{
					"id": 741361105,
					"content": "Э-это невозможно! Архонт меня забери!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361106
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741361106,
					"content": "Раймондо, как вам на моей должности? Не хотите ли мне что-нибудь сообщить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361107
					],
					"speakerTitle": "Эдвин Истингхаус"
				},
				{
					"id": 741361107,
					"content": "Приятно вновь вас увидеть, господин Эдвин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361108
					],
					"speakerTitle": "Раймондо"
				},
				{
					"id": 741361108,
					"content": "Ха! Оглянись вокруг! Работа уборщиком прямо-таки создана для тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361109
					],
					"speakerTitle": "Эдвин Истингхаус"
				},
				{
					"id": 741361109,
					"content": "Пф... Не так уж хорошо он и убирается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361110
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 741361110,
					"content": "Да, а то ты бы уже давно где-нибудь на помойке валялся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361111
					]
				},
				{
					"id": 741361111,
					"content": "#Благодарим вас за то, что доставили их в целости и сохранности, {M#почётный старший исследователь}{F#почётная старшая исследовательница} {NICKNAME} и госпожа Фузилье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361112
					],
					"speakerTitle": "Раймондо"
				},
				{
					"id": 741361112,
					"content": "С сегодняшнего дня для Исследовательского института наконец-то наступит белая полоса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361113
					],
					"speakerTitle": "Раймондо"
				},
				{
					"id": 741361113,
					"content": "Ха-ха-ха, да уж. Скоро Институт погрузится в мертвецкую тишину. Ни следа вдохновения тут не останется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361114
					],
					"speakerTitle": "Эдвин Истингхаус"
				},
				{
					"id": 741361114,
					"content": "Ты уже успел в Институте проявить себя. Настало время уступить дорогу и другим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361115
					],
					"speakerTitle": "Раймондо"
				},
				{
					"id": 741361115,
					"content": "Раймондо Хавенпорт, ты недостаточно хорошо разбираешься в исследованиях, чтобы возглавить Научно-исследовательский институт кинетической энергии Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361116
					],
					"speakerTitle": "Эдвин Истингхаус"
				},
				{
					"id": 741361116,
					"content": "Однако я знаю, как правильно и грамотно тут работать, Эдвин Истингхаус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361117
					],
					"speakerTitle": "Раймондо"
				},
				{
					"id": 741361117,
					"content": "Вам остаётся лишь держаться подальше от исследований и архиума. Так будет лучше для всех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361118
					],
					"speakerTitle": "Раймондо"
				},
				{
					"id": 741361118,
					"content": "Спустя какое-то время сюда приходят люди из Палаты Жардинаж и уводят Нэкера с Эдвином. К счастью, они наконец-то навсегда покидают Институт...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741361119
					]
				},
				{
					"id": 741361119,
					"content": "Слава Архонтам, я наконец-то проснулся от этого кошмарного сна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361120
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741361120,
					"content": "Господин Шоссивер и господин Лемарк, верно? Я наслышан о том, какой вклад вы внесли в то, чтобы помочь нашему Институту. В настоящий момент мы подготавливаем для вас благодарственные награды, а потому настоятельно просим вас дождаться их здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361121
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741361121,
					"content": "Ха-ха-ха! Вот уж не думал, что такой, как я, когда-нибудь свяжется с Институтом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361122
					],
					"speakerTitle": "Шоссивер"
				},
				{
					"id": 741361122,
					"content": "Полно вам на себя наговаривать! Вы, уважаемые господа, оба невероятно искренние, душевные и замечательные люди! Быть может, ваша помощь понадобится нам и в будущем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361123
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741361123,
					"content": "#Что касается вас, {M#почётный старший исследователь}{F#почётная старшая исследовательница}... как я могу отблагодарить вас за то, что вы в очередной раз помогли Институту?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361124,
						741361125
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741361124,
					"content": "Главное, не взрывайте здесь больше ничего.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361128
					]
				},
				{
					"id": 741361128,
					"content": "Ой, кстати... где Фузилье?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741361129,
					"content": "Дайте ей время. Пусть успокоится. Похоже, розовые очки, сквозь которые она смотрела на Эдвина Истингхауса, разбились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361130
					],
					"speakerTitle": "Раймондо"
				},
				{
					"id": 741361130,
					"content": "Эдвину и Нэкеру тоже надо бы остыть... Надеюсь, скоро они признают свои ошибки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361131
					],
					"speakerTitle": "Раймондо"
				},
				{
					"id": 741361131,
					"content": "Они проведут оставшиеся дни в крепости Меропид?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361132
					]
				},
				{
					"id": 741361132,
					"content": "Принимая во внимание их опасность для общества, я надеюсь, что они оттуда никогда больше не выйдут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361133
					],
					"speakerTitle": "Раймондо"
				},
				{
					"id": 741361133,
					"content": "Что же касается дел Института... эх, надеюсь, мне не придётся столкнуться с ситуацией, которая заставит прибегнуть к их помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361134
					],
					"speakerTitle": "Раймондо"
				},
				{
					"id": 741361134,
					"content": "#Ещё раз благодарю вас от имени Исследовательского института Фонтейна, {M#почётный старший исследователь}{F#почётная старшая исследовательница}. Если у вас остались какие-то вопросы, я с удовольствием на них отвечу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Раймондо"
				},
				{
					"id": 741361125,
					"content": "Может, дадите мне звание позначимее?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361126
					]
				},
				{
					"id": 741361126,
					"content": "Ну, вообще-то ваше звание и так является у нас самым высоким. Однако я могу попробовать подать заявку на создание для вас специального звания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361127
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741361127,
					"content": "#Например, {M#главнейший почётный старший исследователь}{F#главнейшая почётная старшая исследовательница}? Ха-ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361128
					],
					"speakerTitle": "Шуазёль"
				}
			]
		},
		{
			"id": 7413634,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
