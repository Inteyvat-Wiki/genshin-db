			"trigger": {
				"objectNames": [
					"Нэко"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160101,
					"content": "А вот и вы. Каменный человек говорит, у него уже почти всё готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160102
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160102,
					"content": "Скорее, идёмте вместе. Каменный человек вон там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				}
			]
		},
		{
			"id": 7221602,
			"completionStepIds": [
				7221602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"2"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Осима Дзюмпэй",
					"Нэко",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160201,
					"content": "Уф, почти закончено. Крупный проект.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160202
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722160202,
					"content": "А, это вы. И госпожа временная настоятельница тоже здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160203
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722160203,
					"content": "Ну что? Готово?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160204
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160204,
					"content": "Да, как вы можете видеть. На самом деле, я специально оставил небольшой кусочек, чтобы сколоть его, когда придёт госпожа временная настоятельница.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160205
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722160205,
					"content": "Это было очень заботливо с твоей стороны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160206
					]
				},
				{
					"id": 722160206,
					"content": "Хе-хе, ну конечно. К такому важному делу, как создание статуи для святилища, нужно относиться серьезно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160207
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722160207,
					"content": "Мяу-мяу. Стучать по камню - это так важно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160208
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160208,
					"content": "Хм, ну как сказать. Обычно мы делаем статуи в честь тех вещей, которые очень важны для нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160209
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722160209,
					"content": "Паймон, тогда тебе стоит воздвигнуть статую в честь еды!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160210
					]
				},
				{
					"id": 722160210,
					"content": "Эй! Это грубо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722160211,
					"content": "То есть вы делаете статуи в честь хороших вещей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160212
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160212,
					"content": "Ха-ха-ха, не просто хороших, а самых лучших! Всё же не зря статуи называют «памятью на века»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160213
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722160213,
					"content": "Нет-нет, мне не надо никакой «памяти на века»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160214
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160214,
					"content": "Я просто хочу, чтобы Хибики смогла увидеть статую, когда вернётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160215
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160215,
					"content": "Так она сразу поймёт, куда идти, и не заблудится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160216
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160216,
					"content": "Ах, вот как. Госпожа временная настоятельница, вы очень заботитесь об этой Хибики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160217
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722160217,
					"content": "Нэко...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160218
					]
				},
				{
					"id": 722160218,
					"content": "Хибики может вернуться в любой момент. И они с Домэки говорили, что, когда моя статуя будет закончена, случится что-то хорошее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160219
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160219,
					"content": "Кстати, вернёмся к делу: каменный человек, я что-то должна сделать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160220
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160220,
					"content": "Да нет... Госпожа временная настоятельница, раз вы уже здесь, я могу отколоть последний кусочек камня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160221
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722160221,
					"content": "Три... два... один!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160222
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722160222,
					"content": "Что... что это за облако?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160223,
						722160224
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722160223,
					"content": "Оно приняло форму кошки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				},
				{
					"id": 722160225,
					"content": "Это Хибики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160226
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160226,
					"content": "Почему?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160227
					]
				},
				{
					"id": 722160227,
					"content": "Хибики?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160228
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722160228,
					"content": "Мяу-мяу! Это точно Хибики! Хибики говорила об этом! Случится что-то хорошее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160229
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160229,
					"content": "Она говорила, она мне говорила! Нужно только хорошенько постучать по камню, и случится что-то хорошее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160230
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160230,
					"content": "Как здорово! Хибики была права!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160231
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160231,
					"content": "Она обязательно вернётся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160232
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160232,
					"content": "Э-э... Ура! Ха-ха-ха, я не знаю, что происходит. Но судя по поведению госпожи временной настоятельницы, определённо что-то хорошее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160233
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722160233,
					"content": "Нэко...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160234
					]
				},
				{
					"id": 722160234,
					"content": "Благодаря вам святилище стало гораздо красивее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160235
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160235,
					"content": "И ящик для подношений цел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160236
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160236,
					"content": "Стойка для молитвенных дощечек тоже в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160237
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160237,
					"content": "А теперь у нас есть ещё и моя статуя. Теперь Хибики обязательно вернётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160238
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160238,
					"content": "А ещё Домэки, Дзяномэ и другие друзья Хибики! Они все вернутся вместе с ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160239
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160239,
					"content": "Ты хороший человек! Ты даже лучше, чем еда! Хибики ты понравишься!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160240
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160240,
					"content": "Пойду созову этих маленьких негодников, нужно обсудить с ними возвращение Хибики. А ещё посетители святилища... нужно и про них тоже дать указания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160241
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160241,
					"content": "А перед этим мне нужно уладить ещё несколько дел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160242
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160242,
					"content": "Хибики, мяу-мяу-мяу! Как чудесно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722160224,
					"content": "Что происходит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				}
			]
		},
		{
			"id": 7221603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Осима Дзюмпэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160301,
					"content": "Госпожа временная настоятельница так рада. Похоже, речь идёт о важном для неё человеке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160302
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722160302,
					"content": "Ещё бы знать, где этот человек...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7221604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эйко",
					"Тайсукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160401,
					"content": "Хибики, святилище Асасэ, Домэки... Все эти имена заставляют задуматься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160402,
						722160407
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160402,
					"content": "Откуда вы здесь взялись?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160403
					]
				},
				{
					"id": 722160403,
					"content": "Вы так шумели, сложно было пройти мимо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160404
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160404,
					"content": "Я думаю, нам нужно кое-что обсудить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160405
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160405,
					"content": "Тайсукэ, рассказывай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160406
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160406,
					"content": "Хорошо, Эйко. Вот какое дело... Это касается истории Сэйрая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160408
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722160408,
					"content": "История Сэйрая уходит своими корнями слишком глубоко в прошлое. Несмотря на все предпринятые Гильдией усилия, полезной информации обнаружилось очень мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160409
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722160409,
					"content": "Судя по тому, что мы нашли, несколько веков назад этот остров был гнездом пиратов. Позже сёгунат уничтожил всех пиратов, а простых жителей перевезли в другие места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160410
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722160410,
					"content": "Если я не ошибаюсь, Домэки - это Ако Домэки, глава пиратов, сражавшихся против сёгуната. Его имя совершенно точно упоминается в рукописях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160411
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722160411,
					"content": "Судя по нашей информации, этот Ако Домэки возглавлял флот в войне с сёгунатом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160412
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722160412,
					"content": "Сёгунат очень скоро отбил его атаки, и Ако Домэки пришлось бежать на Сэйрай...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160413
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722160413,
					"content": "Но когда корабли сёгуната бросились за ним в погоню, над Сэйраем поднялась грозовая буря неизвестного происхождения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160414
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722160414,
					"content": "Корабли Ако Домэки и флот сёгуната попали в грозу... и их следов больше никто никогда не видел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160415
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722160415,
					"content": "Грозовая буря...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160416
					]
				},
				{
					"id": 722160416,
					"content": "Я продолжу. Главная загадка во всей этой истории - откуда взялась гроза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160417
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160417,
					"content": "Хотя буря задела и корабли Ако Домэки и даже почти полностью уничтожила их, но урон отправленному на Сэйрай флоту сёгуната был огромен. Почти все корабли утонули. Остатки флота отступили к Наруками. На полное восстановление ушло много времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160418
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160418,
					"content": "Гроза возникла как раз вовремя, словно бы... кто-то ей управлял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160419
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160419,
					"content": "Ты же помнишь, что печати всех «запирающих камней» были сняты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160420
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160420,
					"content": "А после того, как мы снова наложили печати, гроза над островом стихла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160421
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160421,
					"content": "Не хочу спешить с выводами, но у меня есть стойкое чувство, что эти события связаны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160422
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160422,
					"content": "Мы можем спросить госпожу Нэко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160423
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722160423,
					"content": "Не стоит. В записях говорится, что Ако Домэки пропал во время той грозы. Там, конечно, сказано «пропал», но если он оказался в центре грозы, то скорее всего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160424
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160424,
					"content": "Мы продолжим исследовать остров и собирать информацию об этой истории, а потом отправим отчёт в Гильдию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160425
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160425,
					"content": "#Кхм-кхм, путешественни{F#ца}{M#к}, может быть, когда-нибудь мы ещё поработаем вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160426
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160426,
					"content": "#Буду рад{F#а} снова поработать с вами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160427
					]
				},
				{
					"id": 722160427,
					"content": "Взаимно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160428
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160428,
					"content": "Тайсукэ, приготовься. Продолжим работу с нашим планом исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160429
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160429,
					"content": "Эйко, а как же госпожа Нэко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160430
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722160430,
					"content": "Для вас с ней ничего не изменится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160431
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160431,
					"content": "Просто помалкивай о том, о чём не стоит говорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160432
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160432,
					"content": "Она сейчас так радуется. Ни к чему портить ей настроение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160433
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160433,
					"content": "Я понимаю! Ха-ха, Эйко, а ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160434
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722160434,
					"content": "Я просто хочу хорошо выполнить поручение. За работу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160435
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160435,
					"content": "Сэйрай... Похоже, этот остров полон загадок и тайн...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722160407,
					"content": "Вам что-то известно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160408
					]
				}
			]
		}
	]
}