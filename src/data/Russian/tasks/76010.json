							10671.01
						],
						"pointId": 12598
					}
				]
			},
			"dialogs": [
				{
					"id": 760100601,
					"content": "Эй, вы видели это? Только что произошло странное: я лишь на секунду отвлёкся, а этот большой булыжник вдруг взял да улетел!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100602
					],
					"speakerTitle": "Пеккани"
				},
				{
					"id": 760100602,
					"content": "Вы рассказываете, что произошло...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760100603
					]
				},
				{
					"id": 760100603,
					"content": "Ох! Произошедшее мне совсем не понятно, но раз вы способны творить такие чудеса, вы, должно быть, избранники Девы{RUBY#[D]Куутар} Луны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100604
					],
					"speakerTitle": "Пеккани"
				},
				{
					"id": 760100604,
					"content": "Слава Богине Луны! Теперь я смогу здесь рыбачить сколько душе угодно! Если только тот надоедливый бард не придёт снова со своим питомцем петь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100605
					],
					"speakerTitle": "Пеккани"
				},
				{
					"id": 760100605,
					"content": "Вот, как и обещал, ваше вознаграждение! Хоть я в последнее время и не поймал ни одной рыбы, зато выловил много всяких мелочей, некоторые из них должны быть довольно ценными...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100606
					],
					"speakerTitle": "Пеккани"
				},
				{
					"id": 760100606,
					"content": "На острове Хийси мора не особо нужна, так что я отдам всё вам. Спасибо за помощь, а теперь дайте мне спокойно порыбачить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пеккани"
				}
			]
		}
	]
