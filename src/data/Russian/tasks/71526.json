					}
				]
			},
			"dialogs": [
				{
					"id": 716663001,
					"content": "Оникабуто - наши друзья! Как кошечки и собачки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663002
					],
					"speakerTitle": "Лютик ужаса"
				},
				{
					"id": 716663002,
					"content": "Ещё один ребёнок? Мы это уже проходили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663003
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716663003,
					"content": "Да, но ведь гранд-мастер Ханакадо тоже ребёнок. И в прошлый раз был ещё один участник, который оказался весьма неплох. Так что возраст не показатель мастерства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663004
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716663004,
					"content": "Несмотря на то, что Лютик ужаса не имеет опыта в боях жуков, выбранный ею оникабуто производит впечатление грозного воина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663005
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 716663005,
					"content": "Я не понимаю, о чём вы говорите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663006
					],
					"speakerTitle": "Лютик ужаса"
				},
				{
					"id": 716663006,
					"content": "Мой оникабуто - подарок папы. Он получил его от нового друга, с которым познакомился в своей прошлой поездке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663007
					],
					"speakerTitle": "Лютик ужаса"
				},
				{
					"id": 716663007,
					"content": "Хо-хо, похоже, твой отец разбирается!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663008
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716663008,
					"content": "Хорошо, на этот раз я отправлю сражаться Покорительницу небес Железную фиалковую дыню! Не хочу, чтобы меня обвинили в жестоком обращении с детьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663009
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716663009,
					"content": "Хм, ты говоришь так, будто Паймон - самая слабая в нашей команде...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663010
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716663010,
					"content": "И всё же Паймон, пожалуй, самый безопасный выбор... но только потому, что вы, одержимые, представляете опасность для себя и окружающих, когда жаждете посоревноваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663011
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716663011,
					"content": "Не волнуйтесь, юная барышня! Это всего лишь игра, и она предназначена исключительно для развлечения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7166631,
			"completionStepIds": [
				7152603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
