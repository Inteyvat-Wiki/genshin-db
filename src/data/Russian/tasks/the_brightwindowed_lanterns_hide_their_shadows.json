			"dialogs": [
				{
					"id": 400400101,
					"content": "Подходите, подходите! Не проходите мимо, а то пропустите! Представляем вам удивительный Фонарь теней!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400102
					],
					"speakerTitle": "Юань Жун"
				},
				{
					"id": 400400102,
					"content": "Фонарь теней? Паймон никогда о нём не слышала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400400103,
					"content": "Кажется, вы двое хотите повеселиться! Не хотите опробовать Фонарь теней? Моё последнее изобретение, созданное, чтобы удивлять и забавлять!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400104
					],
					"speakerTitle": "Юань Жун"
				},
				{
					"id": 400400104,
					"content": "Всё очень просто. Нужно лишь повернуть детали внутри Фонаря теней так, чтобы тени слились определённым образом, и вашим глазам предстали удивительные картины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400106
					],
					"speakerTitle": "Юань Жун"
				},
				{
					"id": 400400106,
					"content": "Заинтригованы? Тогда попробуйте сами! Фонарь находится вон там. Пожалуйста, не стесняйтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400107
					],
					"speakerTitle": "Юань Жун"
				},
				{
					"id": 400400107,
					"content": "Надеюсь, Фонарь теней сможет вас впечатлить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400108
					],
					"speakerTitle": "Юань Жун"
				},
				{
					"id": 400400108,
					"content": "Звучит здорово! Давай попробуем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
