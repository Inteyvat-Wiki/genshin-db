					"Алрани"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130601,
					"content": "Я... Я здесь, чтобы написать диссертацию. Почему я опять оказалась взаперти?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Алрани"
				}
			]
		},
		{
			"id": 7281307,
			"completionStepIds": [
				7281308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7281308",
							"2"
						],
						"stepId": 7281308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каушик"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130701,
					"content": "#Значение этого тотема... Хм? {NICKNAME}, у тебя ко мне какое-то дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130702
					],
					"speakerTitle": "Каушик"
				},
				{
					"id": 728130702,
					"content": "Кое-что случилось с Алрани...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130703
					]
				},
				{
					"id": 728130703,
					"content": "Алрани на острове Ватацуми? Что она здесь делает? Она ведь должна быть в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130704
					],
					"speakerTitle": "Каушик"
				},
				{
					"id": 728130704,
					"content": "Её арестовали солдаты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130705
					]
				},
				{
					"id": 728130705,
					"content": "Что? Хотя... ничего удивительного в сложившейся ситуации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130706
					],
					"speakerTitle": "Каушик"
				},
				{
					"id": 728130706,
					"content": "Не бери в голову. Давайте пойдём и поможем этой безрассудной девчонке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каушик"
				}
			]
		},
		{
			"id": 7281308,
			"completionStepIds": [
				7281309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7281309",
							"2"
						],
						"stepId": 7281309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каушик",
					"Алрани",
					"Горо",
					"Хироюки",
					"Окубо Дайсукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130801,
					"content": "Алрани! Это действительно ты! Но почему ты здесь, в Инадзуме? Разве ты не должна быть в Ли Юэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130802
					],
					"speakerTitle": "Каушик"
				},
				{
					"id": 728130802,
					"content": "Это... это очень длинная история...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130803
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130803,
					"content": "Господин Каушик, вы знаете Алрани?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130804
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130804,
					"content": "Вы генерал Горо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130805
					],
					"speakerTitle": "Каушик"
				},
				{
					"id": 728130805,
					"content": "Вы правильно поняли. Мы с Алрани исследователи из Академии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130806
					],
					"speakerTitle": "Каушик"
				},
				{
					"id": 728130806,
					"content": "Мы покинули Академию и занялись разными исследовательскими темами. Я не думал, что встречу её здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130807
					],
					"speakerTitle": "Каушик"
				},
				{
					"id": 728130807,
					"content": "Но... Разве исследователи могут так просто покинуть Академию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130808
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130808,
					"content": "Я бы не сказал, что это просто. Дело в том, что мы с Алрани дриоши.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130809
					],
					"speakerTitle": "Каушик"
				},
				{
					"id": 728130809,
					"content": "Для нас обучение в путешествии - это часть исследовательского процесса. В этом случае нам разрешено покидать Академию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130810
					],
					"speakerTitle": "Каушик"
				},
				{
					"id": 728130810,
					"content": "Генерал Горо, я могу поручиться за Алрани.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130811
					],
					"speakerTitle": "Каушик"
				},
				{
					"id": 728130811,
					"content": "Тогда всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130812
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130812,
					"content": "Вы спасли меня... Спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130813
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130813,
					"content": "Хироюки, Окубо, возвращайтесь к своим обязанностям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130814
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130814,
					"content": "Да, генерал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130815
					],
					"speakerTitle": "Хироюки"
				},
				{
					"id": 728130815,
					"content": "Да, генерал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130816
					],
					"speakerTitle": "Окубо Дайсукэ"
				},
				{
					"id": 728130816,
					"content": "Простите, мисс Алрани. Мы отнеслись к вам с подозрением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130817
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130817,
					"content": "И хотя ваша репутация чиста, ваше вторжение на остров Ватацуми доставило нам немало хлопот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130818
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130818,
					"content": "А? Вы... собираетесь оштрафовать меня? У меня не так много моры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130819
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130819,
					"content": "Поскольку ранее вы утверждали, что являетесь продавцом удобрений, да ещё и исследователем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130820
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130820,
					"content": "Вы можете кое-что для нас сделать. Здесь живёт человек по имени Ивата, который исследует удобрения. Пожалуйста, помогите ему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130821
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130821,
					"content": "Если вы поможете ему произвести удобрение, которое не будет доставлять неудобства людям, тогда вы можете свободно заниматься здесь исследованиями, как и господин Каушик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130822
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130822,
					"content": "Удобрения? Нет... я не...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130823,
						728130824
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130823,
					"content": "Она справится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				},
				{
					"id": 728130825,
					"content": "Алрани, это хорошая возможность собрать материал для исследования. Раз ты здесь, в Инадзуме, значит, твоя диссертация...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130826
					],
					"speakerTitle": "Каушик"
				},
				{
					"id": 728130826,
					"content": "Хм-м... хм-м...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130827
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130827,
					"content": "Вы знаете выпускные стандарты в Академии. Если вы не можете выпуститься несколько лет подряд...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130828
					],
					"speakerTitle": "Каушик"
				},
				{
					"id": 728130828,
					"content": "Я сделаю это! Я сделаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130829
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130829,
					"content": "Я изучала удобрения у господина Вахида... Я сделаю всё, вы и оглянуться не успеете!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130830,
						728130831
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130830,
					"content": "Выпускной порождает взросление характера...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130832,
					"content": "Этот вопрос решён. Мисс Алрани, вопрос с удобрениями в ваших руках. У меня есть другие дела. Так что если позволите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130833
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130833,
					"content": "Ах да, пожалуйста, напомните Ивате, чтобы он... убрал своё удобрение подальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130834
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130834,
					"content": "А я продолжу свои исследования. Если у тебя есть вопросы, Алрани, не стесняйся, спрашивай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каушик"
				},
				{
					"id": 728130831,
					"content": "Для выпуска требуется сильная воля...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130824,
					"content": "Предоставляю это тебе, Алрани.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				}
			]
		},
