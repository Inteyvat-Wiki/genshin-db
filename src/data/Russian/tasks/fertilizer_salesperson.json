				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130901,
					"content": "#Ты вернул{F#ась}{M#ся}! Я избавился от этой кучи удобрений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130902
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130902,
					"content": "Полагаю, мне придётся найти другое место для экспериментов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130903
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130903,
					"content": "Хм? Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130904,
						728130906
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130904,
					"content": "Помощница, которую нашёл генерал Горо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130905
					]
				},
				{
					"id": 728130905,
					"content": "Здравствуйте! Меня зовут Алрани...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130909,
					"content": "Генерал Горо попросил меня помочь вам с исследованием удобрений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130910
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130910,
					"content": "Мне очень приятно работать с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130911
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130911,
					"content": "Отлично! Если у нас получится, то мы сможем посадить больше урожая здесь, на острове Ватацуми!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130912
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130912,
					"content": "Только не забывайте убирать удобрения подальше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130913
					]
				},
				{
					"id": 728130913,
					"content": "А? О! Всё понял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130914
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130914,
					"content": "Словом, мне тоже очень приятно работать с вами, мисс Алрани!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130915
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130915,
					"content": "Я сделаю всё возможное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130916
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130916,
					"content": "Ради своей диссертации я горы сверну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130906,
					"content": "Она специалист по удобрениям из Сумеру.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130907
					]
				},
				{
					"id": 728130907,
					"content": "Здравствуйте! Меня зовут Алрани... Подождите. Специалист по удобрениям?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130908
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130908,
					"content": "Ну... Я немного знакома с удобрениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "Алрани"
				}
			]
