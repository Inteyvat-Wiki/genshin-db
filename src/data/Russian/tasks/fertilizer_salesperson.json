					"Окубо Дайсукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130301,
					"content": "#Спасибо, путешественн{F#ица}{M#ик}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130302
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130302,
					"content": "Я делал удобрения, когда вдруг не пойми откуда напали чудовища...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130303
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130303,
					"content": "#Это всё очень странно... Но хорошо, что ты {F#появилась}{M#появился} вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130304
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130304,
					"content": "Возможно, это удобрения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130305
					]
				},
				{
					"id": 728130305,
					"content": "Правда? Я слышал, что этот запах - признак успеха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130306
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130306,
					"content": "Ну да ладно. Подойди и посмотри, какую я сотворил кучу. Сейчас открою её и всё расскажу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130307
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130307,
					"content": "Подожди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130308
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130308,
					"content": "Господин Горо? Я не знал, что вы сегодня будете проезжать рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130309
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130309,
					"content": "В дозоре, Горо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130310
					]
				},
				{
					"id": 728130310,
					"content": "Я... Не бери в голову.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130311
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130311,
					"content": "Эта куча... Твоих рук дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130312
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130312,
					"content": "#Ха-ха-ха, да. Это мы с {F#путешественницей}{M#путешественником} сделали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130313
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130313,
					"content": "Господин Горо, вы тоже пришли, чтобы проверить удобрение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130314
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130314,
					"content": "Вы как раз вовремя. Мы собирались...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130315
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130315,
					"content": "Подожди! Подожди минутку. Я здесь не для этого. Подожди, вообще-то, я здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130316
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130316,
					"content": "Что у него с лицом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 728130317,
					"content": "Давайте... переместимся куда-нибудь подальше...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130318
					]
				},
				{
					"id": 728130318,
					"content": "Хорошо, давайте так и сделаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130319
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130319,
					"content": "Господин Горо, зачем вы здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130320
					],
					"speakerTitle": "Ивата"
				},
				{
					"id": 728130320,
					"content": "В последнее время многие жители жалуются на ужасающую вонь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130321
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130321,
					"content": "Поэтому в целях безопасности я отправился на разведку, и в итоге проследовал по запаху до этого места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130322
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130322,
					"content": "Так я нашёл вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130323
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130323,
					"content": "Ивата, я слышал, что ты занимаешься исследованием удобрений, но то, как ты это делаешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130324,
						728130325
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130324,
					"content": "Нарушает спокойствие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				},
				{
					"id": 728130326,
					"content": "Именно. Ивата, не мог бы ты утилизировать это удобрение? Мы постараемся помочь тебе найти другой способ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130327
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130327,
					"content": "Генерал! Генерал Горо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130328
					],
					"speakerTitle": "Окубо Дайсукэ"
				},
				{
					"id": 728130328,
					"content": "Я здесь. В чём дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130329
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130329,
					"content": "Генерал, мы поймали подозрительного человека на окраине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130330
					],
					"speakerTitle": "Окубо Дайсукэ"
				},
				{
					"id": 728130330,
					"content": "Она вела себя очень скрытно, называет себя... продавцом удобрений, или что-то в этом роде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130331
					],
					"speakerTitle": "Окубо Дайсукэ"
				},
				{
					"id": 728130331,
					"content": "Мне показалось это крайне подозрительным, поэтому я задержал эту особу. Я подумал, что вам будет интересно присутствовать на допросе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130332
					],
					"speakerTitle": "Окубо Дайсукэ"
				},
				{
					"id": 728130332,
					"content": "Снова удобрения... За что мне всё это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130333
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130333,
					"content": "Я скоро подойду. Возвращайтесь к своим обязанностям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130334
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130334,
					"content": "Ивата, пожалуйста, реши вопрос с удобрениями. Мы обсудим это позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130335
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130335,
					"content": "#{NICKNAME}, пойдём со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130336,
						728130337
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130336,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130338,
					"content": "Продавец удобрений? Паймон всё это кажется очень знакомым... Вот только не могу вспомнить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130339
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 728130339,
					"content": "Ладно, проехали. Пойдём посмотрим, что случилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 728130337,
					"content": "Продавец удобрений?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130325,
					"content": "Провокационно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				}
			]
		},
