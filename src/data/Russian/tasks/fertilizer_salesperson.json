		{
			"id": 7281305,
			"completionStepIds": [
				7281306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7281306",
							"2"
						],
						"stepId": 7281306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хироюки",
					"Алрани",
					"Горо",
					"Окубо Дайсукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130501,
					"content": "Стой на месте и не двигайся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130502
					],
					"speakerTitle": "Хироюки"
				},
				{
					"id": 728130502,
					"content": "Я... я не двигаюсь! Вы попросили меня объясниться, и я объяснила, что я исследователь из Академии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130503
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130503,
					"content": "Разве ты не говорила, что рекламируешь удобрения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130504
					],
					"speakerTitle": "Хироюки"
				},
				{
					"id": 728130504,
					"content": "Я... Разве научный сотрудник из Академии не может одновременно рекламировать удобрения? Просто послушайте меня минутку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130505
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130505,
					"content": "Это она?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130506
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130506,
					"content": "Да, генерал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130507
					],
					"speakerTitle": "Окубо Дайсукэ"
				},
				{
					"id": 728130507,
					"content": "Когда мы её поймали, она бродила по округе и что-то записывала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130508
					],
					"speakerTitle": "Окубо Дайсукэ"
				},
				{
					"id": 728130508,
					"content": "Генерал, я уверен, что она шпион сёгуната.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130509
					],
					"speakerTitle": "Окубо Дайсукэ"
				},
				{
					"id": 728130509,
					"content": "Нет! И никогда им не была! Я уже говорила, что я научный сотрудник! Я просто собирала материал для своей диссертации!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130510
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130510,
					"content": "Не говори чепуху! Ты правда думаешь, что мы поверим, что ты вышла на поле боя ради диссертации? Ты определённо что-то замышляешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130511
					],
					"speakerTitle": "Хироюки"
				},
				{
					"id": 728130511,
					"content": "Единственное, что я замышляю, это написать диссертацию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130512,
						728130513
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130512,
					"content": "Ты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				},
				{
					"id": 728130514,
					"content": "#{NICKNAME}! Как хорошо, что ты здесь. Объясни им уже, что я пишу диссертацию и не замышляю ничего плохого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130515
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 728130515,
					"content": "Вы знакомы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130516
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130516,
					"content": "Можно и так сказать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130517
					]
				},
				{
					"id": 728130517,
					"content": "Неужели выпускные экзамены загоняют исследователей из Сумеру так далеко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130518
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130518,
					"content": "Учитывая вашу манеру общения, вы в лучшем случае просто знакомые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130519
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130519,
					"content": "Что касается её статуса исследователя из Сумеру, то это она сама тебе сказала, так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130520
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130520,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130521
					]
				},
				{
					"id": 728130521,
					"content": "Хм... Боюсь, что у нас нет ни одного убедительного доказательства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130522
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130522,
					"content": "#Но если ты уверен{F#а}, что она не шпионка, я тебе поверю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130523
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130523,
					"content": "Генерал, позвольте высказать предложение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130524
					],
					"speakerTitle": "Окубо Дайсукэ"
				},
				{
					"id": 728130524,
					"content": "Вы помните Каушика? Того исследователя, который изучает культуру и историю нашего острова?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130525
					],
					"speakerTitle": "Окубо Дайсукэ"
				},
				{
					"id": 728130525,
					"content": "Он здесь уже достаточно долго, и мы точно знаем, что он учёный. Почему бы нам не попросить его сказать, является ли эта... продавщица удобрений исследователем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130526
					],
					"speakerTitle": "Окубо Дайсукэ"
				},
				{
					"id": 728130526,
					"content": "#Хорошая идея. {NICKNAME}, можно попросить тебя привести сюда Каушика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130527
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130527,
					"content": "На всякий случай я останусь здесь и буду охранять эту... продавщицу удобрений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130528
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130528,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130529
					]
				},
				{
					"id": 728130529,
					"content": "Возвращайся как можно скорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Горо"
				},
				{
					"id": 728130513,
					"content": "Алрани?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				}
			]
		},
		{
			"id": 7281306,
			"completionStepIds": [],
