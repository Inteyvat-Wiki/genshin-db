			"dialogs": [
				{
					"id": 220450401,
					"content": "Ну как? Получилось сделать фотографии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450402
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450402,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450403
					]
				},
				{
					"id": 220450403,
					"content": "Дай мне посмотреть... О-о-о! Этот ракурс... Эта поза... Очень хорошо! Действительно, очень хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450404,
						220450405
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450404,
					"content": "Ты выглядишь взволнованным...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				},
				{
					"id": 220450406,
					"content": "Эти снимки мне отлично подходят!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450407
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450407,
					"content": "#Спасибо тебе за помощь, путешественн{F#ица}{M#ик}. Возьми это в качестве награды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450408
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450408,
					"content": "Хорошо! Очень хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450405,
