			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Осима Дзюмпэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220450101,
					"content": "Нет... Это не совсем то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450102
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450102,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450103
					]
				},
				{
					"id": 220450103,
					"content": "#{NICKNAME}! Я как раз вспоминал о тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450104
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450104,
					"content": "В последнее время у меня появилось ощущение, что резьбе по дереву, которую я делаю... не хватает... ну, знаешь, жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450105,
						220450107
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450105,
					"content": "Она же деревянная, что ты хочешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450106
					]
				},
				{
					"id": 220450106,
					"content": "Я не об этом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450108
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450108,
					"content": "Как мне это объяснить? Я стремлюсь к...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450109
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450109,
					"content": "Видишь ли, временная настоятельница в основном спит, но временами она просыпается и бодрствует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450110
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450110,
					"content": "Когда она бодрствует, то может прыгать, играть с опавшими листьями, потягиваться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450111
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450111,
					"content": "Я хочу запечатлеть эти движения в дереве. Вот что я имею в виду под словом жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450112,
						220450113
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450112,
					"content": "Тогда тебе нужно больше наблюдать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450114,
					"content": "Я... немного стесняюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450115
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450115,
					"content": "Временная настоятельница - моя начальница. Я боюсь, что моё пристальное внимание к её особе может разозлить настоятельницу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450116
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450116,
					"content": "С другой стороны твои дружеские отношения с ней могут мне помочь. Помоги мне сделать несколько фотографий временной настоятельницы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450117,
						220450118
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450117,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450121
					]
				},
				{
					"id": 220450121,
					"content": "#Спасибо, что согласил{F#ась}{M#ся} помочь мне. Когда сделаешь фотографии - возвращайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450118,
					"content": "Я не могу обещать, что смогу сфотографировать её в движении...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450119
					]
				},
				{
					"id": 220450119,
					"content": "Тебе не обязательно фотографировать её в движении. Я не думаю, что моя техника резьбы сейчас может позволить мне запечатлеть движение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450120
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450120,
					"content": "Просто сфотографируй её в разных позах. Этого будет достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450121
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220450113,
					"content": "Разве Нэко не где-то поблизости?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450107,
					"content": "Какого рода жизнь ты хочешь привнести в своё творчество?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450108
					]
				}
			]
		},
