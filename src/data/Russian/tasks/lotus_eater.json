				"points": []
			},
			"dialogs": [
				{
					"id": 722391901,
					"content": "После заката наступает тьма...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391902
					]
				},
				{
					"id": 722391902,
					"content": "...но истинный свет дают наши сердца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391903
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391903,
					"content": "Ого! Давненько я не слышал этой фразы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391904
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391904,
					"content": "Скажи мне, мой добрый товарищ, кто тебя послал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391905
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391905,
					"content": "Супада но Хико.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391906
					]
				},
				{
					"id": 722391906,
					"content": "Спартак?! Тебя послал сам наставник?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391907
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391907,
					"content": "Где он? Я знаю только, что во время восстания он был схвачен приспешниками Сына Солнца. Затем мы ничего больше о нём не слышали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391908
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391908,
					"content": "Он заперт в алтаре в Сердце змея, и, судя по всему, не сможет выбраться. Вот почему он послал нас на поиски вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391909
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722391909,
					"content": "Проклятый Сын Солнца...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391910
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391910,
					"content": "Что передал нам наставник?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391911
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391911,
					"content": "Он попросил нас передать послание:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391912
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722391912,
					"content": "«Никогда не сдавайтесь, дети. Вся Бякуякоку возлагает на вас свои надежды...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391913
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722391913,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391914
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391914,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391915
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391915,
					"content": "Простите! Мы подвели вас, наставник!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391916
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391916,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391917
					]
				},
				{
					"id": 722391917,
					"content": "Нет больше сопротивления...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391918
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391918,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391919
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722391919,
					"content": "После того как наставник был захвачен, костяк сопротивления полностью развалился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391920
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391920,
					"content": "Обычные ученики, кто следовал за ним, спаслись благодаря тому, что находились далеко от эпицентра событий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391921
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391921,
					"content": "После этого те из нас, кому посчастливилось спастись, бежали в заранее подготовленные укрытия, надеясь вновь набраться сил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391922
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391922,
					"content": "Среди нас есть отличные стратеги, профессиональные учёные, искусные мистики и хорошие врачи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391923
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391923,
					"content": "Звучит многообещающе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391924
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722391924,
					"content": "Мы тоже так думали. Мы верили, что нужно время - и мы сможем опять возглавить движение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391925
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391925,
					"content": "Но на всё это нужны деньги... которых у нас нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391926
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391926,
					"content": "Потом кто-то предложил продавать жемчужины Драконьего цветка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391927
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391927,
					"content": "А что это?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391928
					]
				},
				{
					"id": 722391928,
					"content": "Это редкий плод, который появляется изредка из Драконьих цветов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391929
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391929,
					"content": "Его аромат способен расслабить и успокоить тревожные мысли, сметая все заботы. Поэтому на рынке он стоит очень дорого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391930
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391930,
					"content": "Действительно ли он обладает этими волшебными свойствами? Это точно не мошенничество?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391931
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722391931,
					"content": "Если бы... Я был наивен и не понимал, какие опасности подстерегают на этом пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391932
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391932,
					"content": "Я не знаю, откуда взялся рецепт, но он принёс нам настоящее богатство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391933
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391933,
					"content": "Всё шло так хорошо... Но вскоре мы обнаружили, что некоторые из наших товарищей вдруг стали избегать конфликтов и сражений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391934
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391934,
					"content": "Число таких людей увеличивалось с каждым днём. И однажды они попросили разрешения покинуть наши ряды. Я был не в состоянии остановить их...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391935
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391935,
					"content": "Как это произошло? Это потому, что жемчужины принесли столько денег, что у большинства людей пропало желание бороться дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391948
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722391948,
					"content": "Ты про развращающий соблазн денег? Хм... Я... Я не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391949
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391949,
					"content": "Я знаю только, что когда угнетённые становятся довольны своей жизнью, они перестают сопротивляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391936
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391936,
					"content": "Это было начало конца. И ничего невозможно было сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391947
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391947,
					"content": "Иногда я задаюсь вопросом, не презренные правители ли передали нам этот рецепт намеренно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391950
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391950,
					"content": "Иногда я задаюсь вопросом, может, это правители-угнетатели подстроили, чтобы жемчужины так хорошо продавались?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391937
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391937,
					"content": "Эх... Если бы наставник был здесь, я уверен, он смог бы взять контроль над ситуацией. Возможно, даже пресёк бы это ещё в зародыше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391938
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391938,
					"content": "Мне жаль, наставник. Мы не оправдали надежд...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391939,
						722391940
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391939,
					"content": "Очень печально...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391941
					]
				},
				{
					"id": 722391941,
					"content": "Я не смогу посмотреть ему в глаза...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391942
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391942,
					"content": "#Но всё равно, я благодарю тебя за то, что {M#принёс}{F#принесла} вести о нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391943
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391943,
					"content": "Мне нечем отблагодарить тебя. Но если не возражаешь, могу открыть секрет жемчужины Драконьего цветка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391944
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391944,
					"content": "Они могут быть созданы только с помощью вод Токоё Рэйсэн, то есть вод Реки забвения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391945
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391945,
					"content": "Вы сможете обменять жемчужины на деньги или оставить себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391946
					],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391946,
					"content": "Тем не менее будьте осторожны. Сохраняйте желание стремиться вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Адонис"
				},
				{
					"id": 722391940,
					"content": "Хотел бы ты увидеться с наставником?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391950
					]
				}
			]
		},
		{
			"id": 7223924,
			"completionStepIds": [
				7223903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 722392401,
					"content": "(На надгробии две строки текста. Верхняя написана на языке Бякуякоку, невозможно разобрать.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392402
					],
					"speakerTitle": "Древняя каменная табличка"
				},
				{
					"id": 722392402,
					"content": "(А вторая строка гласит:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392403
					],
					"speakerTitle": "Древняя каменная табличка"
				},
				{
					"id": 722392403,
					"content": "«Здесь покоится Спартак Праведный, известный теперь как Супада но Хико. Ниже перечисляются его преступления. Прочтите и помните нашу историю».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392404
					],
					"speakerTitle": "Древняя каменная табличка"
				},
				{
					"id": 722392404,
					"content": "«Супада но Хико, отъявленный разбойник, организатор великих преступлений, сеявший смуту. Во имя великого бога Токоё, да будет лишён он зрения и сокрушена его душа. И брошен он будет в глубокую тюрьму навечно».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Древняя каменная табличка"
				}
			]
		}
	]
}