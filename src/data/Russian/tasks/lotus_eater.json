			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Супада но Хико",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390101,
					"content": "Никогда не сдавайтесь, дети. Мы возлагаем на вас наши надежды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390102
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390102,
					"content": "Это вы? Вы преуспели, дети мои?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390103
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390103,
					"content": "Нет... Я чувствую это. Вам не...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390104
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390104,
					"content": "#{NICKNAME}, этот человек, похоже, ослеп, прежде чем стал призраком...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722390105,
					"content": "#Кем бы ты ни {M#был}{F#была}, пожалуйста, помоги мне. Помоги найти моих детей! Мне нужно им кое-что передать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390106
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390106,
					"content": "Сперва скажи, кто ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390107
					]
				},
				{
					"id": 722390107,
					"content": "Меня... меня зовут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390108
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390108,
					"content": "Я... забыл своё имя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390109
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390109,
					"content": "Я только помню... Когда-то я защищал Бякуякоку и боролся за надежду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390110
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390110,
					"content": "По сей день я остаюсь членом сопротивления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390111
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390111,
					"content": "Но чему ты сопротивляешься здесь, в Бякуякоку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722390112,
					"content": "Грязным храмовникам, конечно же!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390113
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390113,
					"content": "Они утверждают, что получили некий божественный указ и выступают под флагом богов, но при этом стремятся лишь к удовлетворению своих низменных желаний!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390114
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390114,
					"content": "Якобы они охраняют Сына Солнца, но на самом деле сами всем управляют. Они паразитические черви, сосущие кровь народа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390115
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390115,
					"content": "Они должны быть уничтожены!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390116
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390116,
					"content": "Так хорошо всё это помнишь, но забыл собственное имя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722390117,
					"content": "Это только показывает, насколько жестоки их методы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390118
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390118,
					"content": "Я был схвачен после того, как наши планы провалились, заключён здесь, в этом алтаре, и подвергнут пыткам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390119
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390119,
					"content": "Эта тюрьма - ужасная вещь. Даже сейчас я чувствую, как мою душу перемалывают, отнимая у меня самое ценное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390120
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390120,
					"content": "Прошу тебя, добрая душа, умоляю! Пока я ещё помню, помоги мне найти моих детей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390121
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390121,
					"content": "Скажи им, чтобы они никогда не сдавались, ибо надежда живёт среди них...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390122
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390122,
					"content": "Дети?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390123
					]
				},
				{
					"id": 722390123,
					"content": "Молодые светлые умы, которые сами последовали за мной. Это мои ученики и наш резерв. Я отношусь к ним как к своим детям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390124
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390124,
					"content": "Эти злые правящие люди использовали все способы, чтобы заставить меня разговориться и сдать моих детей, но я не сделал этого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390125
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390125,
					"content": "В конце концов я знаю, что среди них живёт надежда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390126
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390126,
					"content": "К этому моменту их вероятно уже больше нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722390127,
					"content": "Нет! Они хорошие дети. Они обязательно будут придерживаться наших идеалов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390128
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390128,
					"content": "Я не сдался... И я верю, что они тоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390129
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390129,
					"content": "Как нам их найти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390130
					]
				},
				{
					"id": 722390130,
					"content": "Я помню. Конечно, помню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390131
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390131,
					"content": "Я расскажу тебе, где они скрываются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390132
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390132,
					"content": "Но если мы их найдём, как мы объясним им, кто мы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722390133,
					"content": "«Мы пришли сюда, потому что член сопротивления, который забыл своё имя, рассказал нам о вас?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722390134,
					"content": "Нет, так не пойдёт. Я хорошо их обучил. Пока вы не докажете, что вы на нашей стороне, они не поверят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390135
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390135,
					"content": "Но я даже не могу вспомнить своё имя... Проклятие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390136
					],
					"speakerTitle": "Супада но Хико"
				},
				{
					"id": 722390136,
					"content": "#Этот парень, похоже, когда-то был разыскиваемым преступником в Бякуякоку, {NICKNAME}. Один из тех, кого вписывают в учебники истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722390137,
					"content": "Паймон думает, что нам не составит труда найти какие-нибудь записи о нём. Возможно, даже поблизости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390138
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722390138,
					"content": "Если история помнит моё имя, я молюсь, чтобы эта история была написана теми, кто следует нашим принципам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Супада но Хико"
				}
			]
		},
		{
			"id": 7223902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223903",
