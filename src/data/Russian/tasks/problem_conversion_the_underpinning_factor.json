				"points": []
			},
			"dialogs": [
				{
					"id": 230220101,
					"content": "Если увеличить прочность здесь, то понадобится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220102
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230220102,
					"content": "Этот проект не сильно отличается от предыдущего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220103
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230220103,
					"content": "Вы всё ещё проектируете судно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220104
					]
				},
				{
					"id": 230220104,
					"content": "#А, путешественни{F#ца}{M#к}! Да, после испытаний мы с Ци Шань снова решили обсудить некоторые важные моменты проектирования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220105
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230220105,
					"content": "И вот, после... Эм, всестороннего обсуждения мы готовы ещё раз попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220106
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230220106,
					"content": "Но у нас всё ещё есть некоторые разногласия по поводу материалов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220107
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230220107,
					"content": "Но в этот раз я послушал Ци Шань и купил очень дорогие качественные материалы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220108
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230220108,
					"content": "#Путешественни{F#ца}{M#к}, я их сам не подниму, Ци Шань тоже не такая сильная. Может, ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220109,
						230220110
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230220109,
					"content": "Давай вместе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				},
				{
					"id": 230220111,
					"content": "Отлично! Тогда пошли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220112
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230220112,
					"content": "На этот раз материалы выбирала лично Ци Шань. Никаких проблем возникнуть не должно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220113
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230220113,
					"content": "А ещё я подготовил большое вознаграждение. Спасибо за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230220110,
					"content": "#Понял{F#а}, пошли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				}
			]
		},
