			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Застрельщик Фатуи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "Мне даже в голову не пришло, что наши планы могут быть раскрыты. Вот же невезуха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "Застрельщик Фатуи"
				},
				{
					"id": 722740202,
					"content": "Верно! Наставник получил срочный приказ вернуться в Снежную, но мы продолжим следовать нашим планам на Ватацуми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "Застрельщик Фатуи"
				},
				{
					"id": 722740203,
					"content": "Не слишком ли Наставник самоуправствует? Он ведь даже не отчитался об операции леди Арлекино?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "Застрельщик Фатуи"
				},
				{
					"id": 722740204,
					"content": "Это правда. Это была его идея. И знаешь, чую я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "Застрельщик Фатуи"
				},
				{
					"id": 722740205,
					"content": "Ты хочешь сказать, что в случае неудачи Наставник всё свалит на нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Застрельщик Фатуи"
				}
			]
		}
	]
}