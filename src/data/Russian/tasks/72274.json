			"trigger": {
				"objectNames": [
					"Паймон",
					"Застрельщик Фатуи",
					"Ронин-тень"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740110,
					"content": "Кажется, у этого места есть свои секреты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722740111,
					"content": "Тсс! На той стороне кто-то разговаривает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740101
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722740101,
					"content": "Тц! Эта дамочка оказалась такой неразговорчивой. До сих пор не проронила ни слова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740102
					],
					"speakerTitle": "Застрельщик Фатуи"
				},
				{
					"id": 722740102,
					"content": "Ничего, начальник, уж мы-то допрашивать умеем! Вы пока отдохните, а потом мы вместе спустимся в камеру ещё раз и зададим ей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740103
					],
					"speakerTitle": "Ронин-тень"
				},
				{
					"id": 722740103,
					"content": "Время на исходе. Мы должны как можно скорее выведать для Наставника, что ей известно о наших планах. А если не справимся, перепадёт и нам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740104
					],
					"speakerTitle": "Застрельщик Фатуи"
				},
				{
					"id": 722740104,
					"content": "Ох, ну крутой же у него нрав... Чем она его так разозлила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740105
					],
					"speakerTitle": "Ронин-тень"
				},
				{
					"id": 722740105,
					"content": "Важной частью плана Наставника была пешка по имени Людочка, но эта женщина из Сюмацубан убрала её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740106
					],
					"speakerTitle": "Застрельщик Фатуи"
				},
				{
					"id": 722740106,
					"content": "К счастью, когда мы прорвались к ней, огонь ещё не потух. Наставник опознал Людочку по одежде и понял, что наши планы могут быть под угрозой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740107
					],
					"speakerTitle": "Застрельщик Фатуи"
				},
				{
					"id": 722740107,
					"content": "Хоть с этим повезло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740108
					],
					"speakerTitle": "Ронин-тень"
				},
				{
					"id": 722740108,
					"content": "Но мы не знаем, что ей известно о наших планах и успела ли она что-то рассказать Сюмацубан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740109
					],
					"speakerTitle": "Застрельщик Фатуи"
				},
				{
					"id": 722740109,
					"content": "Похоже, Момоё заключена в камере под землёй. Скорее освободим её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7227402,
			"completionStepIds": [
				7227402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
