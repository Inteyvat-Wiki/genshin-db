			"dialogs": [
				{
					"id": 752440101,
					"content": "О, тоже на рыбалку? Без надёжной шляпы в этом деле не обойтись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440106
					],
					"speakerTitle": "Ранти"
				},
				{
					"id": 752440106,
					"content": "А зачем тебе шляпа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440102
					]
				},
				{
					"id": 752440102,
					"content": "Потому что головушку надо беречь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440107
					],
					"speakerTitle": "Ранти"
				},
				{
					"id": 752440107,
					"content": "Но ты без шляпы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440103
					]
				},
				{
					"id": 752440103,
					"content": "Собственно, о чём я и хотел попросить... У меня ветром шляпу сдуло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440104
					],
					"speakerTitle": "Ранти"
				},
				{
					"id": 752440104,
					"content": "Поможешь мне найти её?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440108
					],
					"speakerTitle": "Ранти"
				},
				{
					"id": 752440108,
					"content": "Почему ты сам не можешь её найти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440105
					]
				},
				{
					"id": 752440105,
					"content": "Если я пойду искать шляпу, придётся бросить удочку. А если держу удочку, как мне тогда искать шляпу?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440109
					],
					"speakerTitle": "Ранти"
				},
				{
					"id": 752440109,
					"content": "Пожалуйста, помоги мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ранти"
				}
			]
		},
