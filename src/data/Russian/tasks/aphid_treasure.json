			"dialogs": [
				{
					"id": 755050301,
					"content": "Фух! Мы справились! И хотя эта негодница выглядит большой, поймать её оказалось довольно просто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755050302,
					"content": "Она совсем не опасна, если не считать того, что любит убегать. Сеть для насекомых и дурманящие ягоды тоже пригодились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755050303,
					"content": "Но раз тля заражена Бездной, она может привлечь монстров. Лучше быть начеку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050304
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755050304,
					"content": "Да, ты права! И раз уж эти ягоды весьма кстати оказались здесь... На месте противников Паймон бы держалась подальше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755050305,
					"content": "#Находиться рядом с подобными ягодами ненормально и неестественно! {NICKNAME}, нужно сохранять бдительность. Здесь определённо творится что-то неладное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755050306,
					"content": "Паймон стала экспертом по странностям.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050307
					]
				},
				{
					"id": 755050307,
					"content": "#Хе-хе, это ты научил{F#а} Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755050308,
					"content": "Ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050309
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755050309,
					"content": "Спасибо, что решили пойти со мной. Мы разобрались с одной областью, самое время сделать небольшой перерыв.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050310
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755050310,
					"content": "В ближайшие несколько дней мне понадобится ваша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шилонен"
				}
			]
		}
