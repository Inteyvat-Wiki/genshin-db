			"dialogs": [
				{
					"id": 755050201,
					"content": "Пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050202
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755050202,
					"content": "Видите это? Тля, загрязнённая силой Бездны. Она намного больше обычной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050203
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755050203,
					"content": "Ух ты, какая огромная букашка... Она опасна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755050204,
					"content": "Не волнуйся. Она заражена Бездной, но её поведение, похоже, ничуть не изменилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050205
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755050205,
					"content": "Тем не менее я специально приготовила очень большую сеть для насекомых, чтобы всё прошло гладко. Вот, держи. Она скоро пригодится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050206
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755050206,
					"content": "Кстати, Кинич упомянул нечто весьма необычное. Он обнаружил, что существует особая ягода, которая всегда растёт вблизи мест, где водятся тли Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050207
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755050207,
					"content": "Ягода содержит токсин, который парализует тлю, поэтому если мы распределим её по сетке, тля перестанет сопротивляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050208
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755050208,
					"content": "Хм? Почему тля живёт рядом с ягодой, которая её парализует? Паймон это кажется странным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755050209,
					"content": "Я с тобой согласна. Впервые слышу, чтобы живность обитала рядом с чем-то, что для неё опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050210
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755050210,
					"content": "Это противоестественно! Подождите... Может, кто-то специально заразил их Бездной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755050211,
					"content": "В последние дни Паймон очень настороженна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050212
					]
				},
				{
					"id": 755050212,
					"content": "Эй! Даже самые бестолковые проводники со временем обучаются! А Паймон никогда не была бестолковой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755050213,
					"content": "Единственная проблема заключается в том, что мы обыскали всё вокруг, но не нашли следов участия человека.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050214
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755050214,
					"content": "Предлагаю пока считать это неизвестным ранее естественным поведением тли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050215
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755050215,
					"content": "Ладно, но нам надо поймать их несмотря ни на что! Мы ведь не хотим, чтобы люди болели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755050216,
					"content": "Охотники за насекомыми, вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
