			"trigger": {
				"objectNames": [
					"Отто"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270801,
					"content": "Здравствуй. Я Отто из Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270802
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 4270802,
					"content": "Что происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4270803,
					"content": "Пожалуйста, предъявите свою лётную лицензию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270804,
						4270805
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 4270804,
					"content": "Лё... лётную лицензию?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				},
				{
					"id": 4270806,
					"content": "Пункт седьмой статьи двенадцатой гражданского кодекса Мондштадта гласит, что полёты над городом без лётной лицензии запрещены. Вы арестованы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270807
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 4270807,
					"content": "У вас есть право хранить молчание. Всё сказанное вами запомнит ветер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270808
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 4270808,
					"content": "Подождите! Я инструктор по полётам, мы сейчас сдаём экзамен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270809
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4270809,
					"content": "Хм. Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270810
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 4270810,
					"content": "Не лучшее время вы выбрали для своего экзамена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270811
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 4270811,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270812
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4270812,
					"content": "#Одна из сестёр рассказала рыцарям ордена, что видела, как Птеродактиль парит вокруг собора. Я принял тво{M#его}{F#ю} учени{M#ка}{F#цу} за его подельника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270813
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 4270813,
					"content": "Птеродактиля?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270814
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4270814,
					"content": "Известный мондштадтский преступник. Он всегда парит на планере, поэтому его называют Птеродактилем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270815
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 4270815,
					"content": "Должно быть, он летает очень быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270816
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4270816,
					"content": "Пока что нам не удалось его поймать. Мы хотели заманить его в собор и устроить там засаду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270817
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 4270817,
					"content": "Но он смог улизнуть с награбленным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270818
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 4270818,
					"content": "К счастью, сестра отметила артефакты специальными магическими знаками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270819
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 4270819,
					"content": "Но Птеродактиль слишком быстр, мы не смогли его догнать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270820
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 4270820,
					"content": "Погоня за летающим преступником! Я могу помочь! В какую сторону он полетел?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270821
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4270821,
					"content": "В последний раз его видели недалеко от Спрингвейла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270822
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 4270822,
					"content": "#Доверь эту работу нам! {NICKNAME} и я не оставим ему никаких шансов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270823,
						4270824
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4270823,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270825,
					"content": "Не переживай, мы закончим с этим, как только поймаем Птеродактиля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270826
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4270826,
					"content": "Мне нужно поговорить с Джинн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4270824,
					"content": "#Получается, я сдал{F#а} экзамен?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270805,
					"content": "Её съел Барон Зайчик!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				}
			]
		},
