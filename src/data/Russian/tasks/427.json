			"dialogs": [
				{
					"id": 4270201,
					"content": "Эй! Я здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270202
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4270202,
					"content": "Всё готово. Мы можем продолжать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270203
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4270203,
					"content": "Условия те же. Тебе нужно пролететь через отметки и добраться до финиша без остановок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270204
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4270204,
					"content": "#Я готов{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42704,
			"completionStepIds": [
				42704
