			"trigger": {
				"objectNames": [
					"Эмбер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270401,
					"content": "А у тебя неплохо получается! Остался последний этап.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270402
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4270402,
					"content": "#Проще простого. Ты уже здесь парил{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4270403,
					"content": "Последний этап! Как только ты его пройдёшь, рыцари выдадут тебе лётную лицензию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270404
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4270404,
					"content": "Думай о лицензии. Приготовились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270405
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4270405,
					"content": "Начали!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42708,
			"completionStepIds": [
				42708
