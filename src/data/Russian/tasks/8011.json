					"Эйде"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110401,
					"content": "Кто это был? Он... он...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110402,
						80110403
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80110402,
					"content": "Страшно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				},
				{
					"id": 80110404,
					"content": "...Он настолько совершенен, что вызывает благоговение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110405
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80110405,
					"content": "Что?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110406
					]
				},
				{
					"id": 80110406,
					"content": "Он обладал поистине чарующей силой, гибельной и прекрасной одновременно... Это завораживает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110407
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80110407,
					"content": "И всё же тебе удалось победить его. Ты сильнее, чем я думал. Хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110408,
						80110409
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80110408,
					"content": "У тебя очень необычные взгляды.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110410,
					"content": "Давайте двигаться дальше. С каждой секундой мне становится всё любопытнее... и волнительнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80110409,
					"content": "У меня просто большой боевой опыт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110403,
					"content": "Мне уже встречались подобные персонажи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				}
			]
		},
