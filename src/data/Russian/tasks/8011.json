				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110301,
					"content": "Люди, стойте. Судьба не дала вам права войти в это место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110302
					],
					"speakerTitle": "Вестник судьбы"
				},
				{
					"id": 80110302,
					"content": "(Вестник Бездны? Нет, он не похож на члена ордена Бездны...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "Хм, вы настаиваете на аудиенции?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "Вестник судьбы"
				},
				{
					"id": 80110304,
					"content": "...Хорошо. Тогда я дарую вам испытание судьбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вестник судьбы"
				}
			]
		},
		{
			"id": 801104,
			"completionStepIds": [
				801108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
