			"dialogs": [
				{
					"id": 120030601,
					"content": "Не слишком увлекайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030602
					],
					"speakerTitle": "Агент"
				},
				{
					"id": 120030602,
					"content": "Ой! Он же проглотит нас и даже не заметит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1200308,
			"completionStepIds": [
				1200308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200308",
							"2"
						],
						"stepId": 1200308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Син Цю"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030801,
					"content": "Впечатляет. Вы умеете сражаться. Я не вижу смысла продолжать эту битву.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030802
					],
					"speakerTitle": "Агент"
				},
				{
					"id": 120030802,
					"content": "Их силы уже на исходе! Прикончи их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030803
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 120030803,
					"content": "Позволь мне напомнить, что с Фатуи тебя связывают исключительно деловые отношения. Я не позволю тебе решать личные проблемы руками моих людей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030804
					],
					"speakerTitle": "Агент"
				},
				{
					"id": 120030804,
					"content": "Что?! Но г-господин, я всего лишь пытаюсь выполнить наш контракт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030805
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 120030805,
					"content": "Занимайся этим сам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030806
					],
					"speakerTitle": "Агент"
				},
				{
					"id": 120030806,
					"content": "Н-нет! Не уходите! Постойте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030807
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 120030807,
					"content": "Господин?! Что вы здесь делаете? Вы ранены?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030808
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 120030808,
					"content": "Я в порядке, спасибо. Я цел только благодаря этим ребятам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030809
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030809,
					"content": "Господин?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030810,
						120030811
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120030810,
					"content": "Господин?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				},
				{
					"id": 120030812,
					"content": "Ты... Ты наследник торговой гильдии «Фэйюнь»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030813
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 120030813,
					"content": "Я не скрываю своего имени и положения. Я Син Цю, последователь школы Гухуа, второй сын главы торговой гильдии «Фэйюнь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030814
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030814,
					"content": "Проклятье! Меня обвели вокруг пальца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030815
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 120030815,
					"content": "Маоцай Гун, уважающие себя бизнесмены считают недостойными такие методы, как запугивание и вымогательство. Предлагаю теперь вести дела по моим правилам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030816
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030816,
					"content": "Даже боюсь представить, что с тобой сделают Фатуи, если ты не доставишь им руду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030817
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030817,
					"content": "Ах ты грязный... Не тяни! Называй свою цену!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030818
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 120030818,
					"content": "Ты заставлял Чана Девятого продать руду за треть от рыночной цены...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030819
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030819,
					"content": "Будет честно выставить тебе тройную цену!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030820
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030820,
					"content": "Что? Это просто грабёж! Ты... Ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030821
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 120030821,
					"content": "Спокойствие. Мне нужен от тебя простой ответ. Ты покупаешь руду? Да или нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030822
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030822,
					"content": "Я... Аргх... Ладно, пусть будет по-твоему! Где-нибудь раздобуду деньги. Ну что, доволен?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030823
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 120030823,
					"content": "Благодарю тебя от лица торговой гильдии «Фэйюнь». Надеюсь на плодотворное сотрудничество в будущем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030824
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030824,
					"content": "Подумать только! Книжный червь оказался наследником торговой гильдии «Фэйюнь»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030825
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120030825,
					"content": "Значит та куча денег, которую мы потратили на руду, - это твои карманные расходы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030826
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120030826,
					"content": "Мы сделали серьёзные инвестиции в руду и поставили Маоцай Гуна на место. Один выстрел - две птицы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030827,
						120030829
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030827,
					"content": "Внешность действительно бывает обманчива.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030828
					]
				},
				{
					"id": 120030828,
					"content": "Я тобой восхищаюсь. Твоё сердце исполнено доблести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030831,
					"content": "Упс... А я его всё время дразнила книжным червём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030832
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120030832,
					"content": "В одном из романов о странствующих мастерах боевых искусств была история о богатеньком наследнике. Он приказывал отрубать ноги всем, кто ему не нравился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030833
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120030833,
					"content": "Что?! ЧТО?! Мне крышка... Прости! Прости меня! Пожалуйста, не делай мне больно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030834
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120030834,
					"content": "Успокойся, Паймон. Зачем тебе ноги? Ты же умеешь летать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030835
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030835,
					"content": "#ААА!!! {NICKNAME}, помоги мне! Это не учебная тревога! Повторяю: это не учебная тревога!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030836,
						120030837
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120030836,
					"content": "Он шутит. Это же очевидно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030838,
					"content": "Шутки в сторону. Я хочу поблагодарить вас за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030839
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030839,
					"content": "Я насладился «Легендой о разбитой алебарде» от первой до последней страницы. А теперь будьте добры, верните книгу Чану Девятому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030840
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030840,
					"content": "Снова заставляешь нас побегать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030841
					]
				},
				{
					"id": 120030841,
					"content": "Я не сделал ровным счётом ничего и поэтому не заслуживаю его благодарности. А вы явились из ниоткуда и решили все проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030842
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030842,
					"content": "Ваша дружба будет для меня лучшей наградой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030843
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030843,
					"content": "Господин, простите, что перебиваю вас, но... Ваш отец...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030844
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 120030844,
					"content": "Пожалуйста, сообщите моему отцу, что мне удалось предотвратить катастрофу и попутно заработать большую сумму денег.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030845
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030845,
					"content": "Быть может, эти благородные дела даруют мне ещё несколько дней свободы. В книге упоминается таинственный город, который мне не терпится посетить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030846
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030846,
					"content": "За этими длинными вычурными словами прячется лентяй, который делает всё возможное, лишь бы не работать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030847
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120030847,
					"content": "Ха-ха! Кстати, вас ждут не только благодарность Чана Девятого, но и ценная награда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030848
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030848,
					"content": "Награда! Хм... Это совсем другое дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030849
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120030849,
					"content": "Эх... Боюсь, что никакие слова не в силах вас удержать, мой господин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030850
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 120030850,
					"content": "Почему вы сразу не сказали, что Син Цю - ваш господин?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030851
					]
				},
				{
					"id": 120030851,
					"content": "Я был уверен, что вы в курсе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030852
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 120030852,
					"content": "Заранее благодарю вас за то, что вернёте книгу! Я отправляюсь в путь. До скорой встречи, друзья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030837,
					"content": "А в каком романе ты это прочитала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030829,
					"content": "Разве богатеньких детишек не учат каллиграфии с самого детства?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030830
					]
				},
				{
					"id": 120030830,
					"content": "Ха-ха-ха! Отлично подмечено! Моя семья всегда сможет узнать меня по почерку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120030811,
					"content": "Вот это поворот...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				}
			]
		},
		{
			"id": 1200309,
			"completionStepIds": [
				1200309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200309",
							"2"
						],
						"stepId": 1200309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чан Девятый"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030901,
					"content": "Вот вы и вернулись. Сегодня утром я выкупил всю свою коллекцию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030902
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030902,
					"content": "Я уверен, что вы приложили к этому руку. Спасибо! Благодарю вас от всей души!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030903,
						120030904
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030903,
					"content": "Это пустяки, рады помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				},
				{
					"id": 120030905,
					"content": "Не говори так! Вы даже не представляете, как много для меня это значит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030906
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030906,
					"content": "В былые времена семья Чан была одной из богатейших в Ли Юэ. Но когда я принял по наследству управление семейными делами, череда финансовых неудач поглотила наше богатство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030907
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030907,
					"content": "С тех пор я годами пытаюсь восстановить былое состояние семьи. От продажи этой партии руды зависело всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030908
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030908,
					"content": "Если бы не вы, моё бренное тело уже покоилось бы где-то на горных утёсах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030909
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030909,
					"content": "Ещё один наследник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030910
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120030910,
					"content": "Что ты имеешь в виду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030911
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030911,
					"content": "Нет-нет, ничего. Кстати, вот ваша книга!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030912
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120030912,
					"content": "О! «Легенда о разбитой алебарде»! Я уже начал думать, что этот юнец из Гухуа решил меня обмануть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030913
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030913,
					"content": "Почему все так относятся к Гухуа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030914
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120030914,
					"content": "История этого древнего искусства насчитывает несколько веков. Некогда искусство Гухуа ценилось и почиталось повсеместно, но теперь Гухуа практически предано забвению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030915
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030915,
					"content": "Чтобы возродить былую славу, Гухуа нужны новые последователи. Но кого заинтересует позабытое искусство?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030916
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030916,
					"content": "А нынешняя ребятня из Гухуа... Взять хоть этого сорванца Син Цю. Столько болтает о том, что за добро надо платить добром, а сам-то он что сделал? У вас вот, например, хватило чувства ответственности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030917,
						120030918
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030917,
					"content": "Син Цю не так уж плох...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030919,
					"content": "Впрочем, это не имеет большого значения. Вы искали выпуск «Путеводителя по Тейвату», посвящённый Ли Юэ, верно? Я приготовил для вас один экземпляр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030920
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030920,
					"content": "Можете оставить его себе. И ещё кое-что. Возьмите это в знак моей благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030921,
						120030922
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030921,
					"content": "Спасибо! Не зря мы сюда вскарабкались, в конце концов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030923,
					"content": "Поверить не могу... Руда продана, книги на месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030924
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030924,
					"content": "Но как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030925
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030925,
					"content": "Что случилось? Кажется, что-то упало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030926
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120030926,
					"content": "Ничего, ничего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030927
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030927,
					"content": "(Ох уж этот маленький сорванец.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120030922,
					"content": "#Ах, да. Чуть не забыл{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030918,
					"content": "Возможно, возрождение школы Гухуа не за горами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030904,
					"content": "На самом деле, мы тут ни причём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				}
			]
		}
	]
}