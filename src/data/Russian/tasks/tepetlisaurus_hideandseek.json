			"dialogs": [
				{
					"id": 750250101,
					"content": "Ух ты, что это за удивительное место? Здесь так много тепетлизавриков...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750250102,
					"content": "Неужели это какое-то место сбора тепетлизавров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750250103,
					"content": "А! У-а!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250104
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250104,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} тоже в восторге. Нечасто встретишь столько заврианов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750250105,
					"content": "Р-р?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250106,
					"content": "#Хочешь поиграть с ними? {NICKNAME}, а ведь {REALNAME[ID(2)|SHOWHOST(true)]} и правда довольно редко общается с тепетлизавриками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250107,
						750250108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750250107,
					"content": "Только осторожнее!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				},
				{
					"id": 750250109,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250110,
					"content": "#Паймон немного тревожится, но всё же давай найдём место, где можно спокойно перекусить и поговорить, пока {REALNAME[ID(2)|SHOWHOST(true)]} играет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750250111,
					"content": "#Вы с Паймон находите неплохое место для отдыха и ждёте, когда {REALNAME[ID(2)|SHOWHOST(true)]} наиграется и вернётся к вам.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250112
					]
				},
				{
					"id": 750250112,
					"content": "Вот только ожидание затянулось...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250113
					]
				},
				{
					"id": 750250113,
					"content": "#А? {REALNAME[ID(2)|SHOWHOST(true)]} ещё не вернулся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750250114,
					"content": "Может, что-то случилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750250115,
					"content": "Может, он заигрался?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250116
					]
				},
				{
					"id": 750250116,
					"content": "Даже если так, нужно хорошенько с ним поговорить и объяснить правила поведения. Уже стемнело, а его всё нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750250117,
					"content": "Пойдём поищем его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750250108,
					"content": "Не задерживайся надолго!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				}
			]
		},
