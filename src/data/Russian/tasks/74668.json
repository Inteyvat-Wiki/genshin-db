			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746680101,
					"content": "А? Статуя семерых Архонтов вдруг засияла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746680102,
					"content": "Как странно! Разве раньше с нами такое случалось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680103,
						746680105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746680103,
					"content": "Для статуй семи Архонтов сиять - обычное дело.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680107
					]
				},
				{
					"id": 746680107,
					"content": "#{NICKNAME}, как ты себя чувствуешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680108,
						746680110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746680108,
					"content": "А? Вода... Вода говорит со мной...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680109
					]
				},
				{
					"id": 746680109,
					"content": "Говорящая вода могла бы нам пригодиться! Ну, раз ты шутишь, значит, с тобой точно всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746680112,
					"content": "И всё же... После того странного свечения воздух стал более влажным. Может быть, это связано с высвободившейся энергией Гидро?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746680113,
					"content": "Паймон слышала, что в Фонтейне, если правильно использовать элементальную энергию, можно даже плавать под водой! Хе-хе, а вдруг у тебя получится найти затонувшие сокровища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746680114,
					"content": "Но удовольствие нырять за сокровищами Паймон предоставит тебе. Паймон лучше будет... ждать тебя на берегу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680115,
						746680116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746680115,
					"content": "Мне будет одиноко под водой без тебя...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680117,
					"content": "Но... но... Паймон боится воды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746680118,
					"content": "А что, если Паймон случайно угодит в течение, оно её завертит, голова закружится и Паймон не сможет взлететь?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746680119,
					"content": "Как тогда, в Мондштадте, когда мы встретились...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746680120,
					"content": "Тогда я снова выловлю тебя из воды!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680121
					]
				},
				{
					"id": 746680121,
					"content": "Правда? Тогда, может быть, Паймон попробует спуститься под воду вместе с тобой. Ты ведь не откажешься от своих слов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746680116,
					"content": "Попробуй хоть раз что-нибудь сделать, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680110,
					"content": "Ого! Чувствую, что теперь могу дышать жабрами...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680111
					]
				},
				{
					"id": 746680111,
					"content": "Хорошо, отрасти жабры, и тогда посмотришь. Пф, прекрасное настроение! Получается, Паймон зря переживала!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746680105,
					"content": "Ты про поток воды?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680106
					]
				},
				{
					"id": 746680106,
					"content": "Ну да, конечно, это же страна Гидро Архонта. Здесь даже статуи семи Архонтов - фонтаны. И да! Сияние статуи вовсе не походило на обычное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680107
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}