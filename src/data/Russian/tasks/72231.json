			"trigger": {
				"objectNames": [
					"Осима Дзюмпэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722310101,
					"content": "Госпожа временная настоятельница так рада. Похоже, речь идёт о важном для неё человеке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310102
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722310102,
					"content": "Ещё бы знать, где этот человек...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7223102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223101",
							"2"
						],
						"stepId": 7223101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эйко",
					"Тайсукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722310201,
					"content": "Хибики, святилище Асасэ, Домэки... Все эти имена заставляют задуматься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310202,
						722310207
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310202,
					"content": "Откуда вы здесь взялись?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310203
					]
				},
				{
					"id": 722310203,
					"content": "Вы так шумели, сложно было пройти мимо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310204
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310204,
					"content": "Я думаю, нам нужно кое-что обсудить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310205
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310205,
					"content": "Тайсукэ, рассказывай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310206
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310206,
					"content": "Хорошо, Эйко. Вот какое дело... Это касается истории Сэйрая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310208
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722310208,
					"content": "История Сэйрая уходит своими корнями слишком глубоко в прошлое. Несмотря на все предпринятые Гильдией усилия, полезной информации обнаружилось очень мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310209
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722310209,
					"content": "Судя по тому, что мы нашли, несколько веков назад этот остров был гнездом пиратов. Позже сёгунат уничтожил всех пиратов, а простых жителей перевезли в другие места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310210
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722310210,
					"content": "Если я не ошибаюсь, Домэки - это Ако Домэки, глава пиратов, сражавшихся против сёгуната. Его имя совершенно точно упоминается в рукописях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310211
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722310211,
					"content": "Судя по нашей информации, этот Ако Домэки возглавлял флот в войне с сёгунатом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310212
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722310212,
					"content": "Сёгунат очень скоро отбил его атаки, и Ако Домэки пришлось бежать на Сэйрай...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310213
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722310213,
					"content": "Но когда корабли сёгуната бросились за ним в погоню, над Сэйраем поднялась грозовая буря неизвестного происхождения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310214
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722310214,
					"content": "Корабли Ако Домэки и флот сёгуната попали в грозу... и их следов больше никто никогда не видел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310215
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722310215,
					"content": "Грозовая буря...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310216
					]
				},
				{
					"id": 722310216,
					"content": "Я продолжу. Главная загадка во всей этой истории - откуда взялась гроза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310217
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310217,
					"content": "Хотя буря задела и корабли Ако Домэки и даже почти полностью уничтожила их, но урон отправленному на Сэйрай флоту сёгуната был огромен. Почти все корабли утонули. Остатки флота отступили к Наруками. На полное восстановление ушло много времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310218
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310218,
					"content": "Гроза возникла как раз вовремя, словно бы... кто-то ей управлял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310219
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310219,
					"content": "Ты же помнишь, что печати всех «запирающих камней» были сняты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310220
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310220,
					"content": "А после того, как мы снова наложили печати, гроза над островом стихла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310221
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310221,
					"content": "Не хочу спешить с выводами, но у меня есть стойкое чувство, что эти события связаны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310222
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310222,
					"content": "Мы можем спросить госпожу Нэко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310223
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722310223,
					"content": "Не стоит. В записях говорится, что Ако Домэки пропал во время той грозы. Там, конечно, сказано «пропал», но если он оказался в центре грозы, то скорее всего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310224
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310224,
					"content": "Мы продолжим исследовать остров и собирать информацию об этой истории, а потом отправим отчёт в Гильдию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310225
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310225,
					"content": "#Кхм-кхм, путешественни{F#ца}{M#к}, может быть, когда-нибудь мы ещё поработаем вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310226
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310226,
					"content": "#Буду рад{F#а} снова поработать с вами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310227
					]
				},
				{
					"id": 722310227,
					"content": "Взаимно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310228
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310228,
					"content": "Тайсукэ, приготовься. Продолжим работу с нашим планом исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310229
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310229,
					"content": "Эйко, а как же госпожа Нэко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310230
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722310230,
					"content": "Для вас с ней ничего не изменится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310231
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310231,
					"content": "Просто помалкивай о том, о чём не стоит говорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310232
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310232,
					"content": "Она сейчас так радуется. Ни к чему портить ей настроение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310233
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310233,
					"content": "Я понимаю! Ха-ха, Эйко, а ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310234
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722310234,
					"content": "Я просто хочу хорошо выполнить поручение. За работу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310235
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310235,
					"content": "Сэйрай... Похоже, этот остров полон загадок и тайн...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722310207,
					"content": "Вам что-то известно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310208
					]
				}
			]
		}
	]
}