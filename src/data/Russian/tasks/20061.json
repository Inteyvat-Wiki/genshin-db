			"dialogs": [
				{
					"id": 200610401,
					"content": "Расскажи о голубях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610402
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610402,
					"content": "Может быть, теперь они начнут доставлять письма по адресу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610403
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610403,
					"content": "В любом случае, у меня нет времени следить за каждым голубем. И так сойдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610404
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610404,
					"content": "Спасибо! Вот твоя награда. Если тебе понадобится отправить письмо, ты знаешь, к кому обращаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Драфф"
				}
			]
		},
		{
