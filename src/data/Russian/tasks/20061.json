			},
			"dialogs": [
				{
					"id": 200610501,
					"content": "Расскажи о голубях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610502
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610502,
					"content": "#Что? ЧТО ТЫ НАДЕЛАЛ{F#А}?! Это были мои почтовые голуби!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610503
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610503,
					"content": "Ты тупее самого тупого хиличурла! Что же мне теперь делать со всеми этими письмами?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610504,
						200610506
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610504,
					"content": "Прости, пожалуйста...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610505
					]
				},
				{
					"id": 200610505,
					"content": "И это всё? Это и есть извинения от почётного рыцаря Ордо Фавониус?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610508,
					"content": "Теперь тебе придётся возместить мне ущерб. Мозгов у тебя не больше, чем у птицы, поэтому будешь моим новым почтовым голубем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610506,
					"content": "#Не рассчитал{F#а} немного свою силу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610507
					]
				},
				{
					"id": 200610507,
					"content": "Может стоило всё-таки поаккуратнее обращаться с ними?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "Драфф"
				}
			]
		},
