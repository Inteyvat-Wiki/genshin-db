				"points": []
			},
			"dialogs": [
				{
					"id": 200610101,
					"content": "Расскажи о голубях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610102
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610102,
					"content": "Зажарить бы их с лесными грибами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610103
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610103,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610104
					]
				},
				{
					"id": 200610104,
					"content": "Я хотел, чтобы они стали почтовыми голубями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610105
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610105,
					"content": "Но они становятся всё менее и менее надёжными. Почему? Не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610106
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610106,
					"content": "Они теряют сообщения или доставляют их не по адресу. Иногда они просто ходят кругами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610111
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610111,
					"content": "Если встретишь по пути моих голубей, поторопи их, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610107,
						200610109
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610107,
					"content": "Буду смотреть в оба.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610108
					]
				},
				{
					"id": 200610108,
					"content": "#Если увидишь, что они слоняются где-то без дела, будь добр{F#а}, поторопи их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610109,
					"content": "Возможно, голубям это не понравится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610110
					]
				},
				{
					"id": 200610110,
					"content": "Не переживай! У этих птиц мозгов не хватит, чтобы на тебя обидеться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610112
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 200610112,
					"content": "Я не думал, что тебе так сильно нравятся голуби...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Драфф"
				}
			]
		},
