					"Мацумото"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721850201,
					"content": "Эх... Есть ли в мире хоть что-нибудь, что удовлетворит мои вкусовые рецепторы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850202
					],
					"speakerTitle": "Мацумото"
				},
				{
					"id": 721850202,
					"content": "Насчёт пиццы из ресторана Киминами...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850203
					]
				},
				{
					"id": 721850203,
					"content": "Да, эта пицца очень вкусная, и в ней много местных ингредиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850204
					],
					"speakerTitle": "Мацумото"
				},
				{
					"id": 721850204,
					"content": "Однако настоящую грибную пиццу я уже пробовала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850205
					],
					"speakerTitle": "Мацумото"
				},
				{
					"id": 721850205,
					"content": "Я помню, что та пицца была с сыром, капустой и грибами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850206
					],
					"speakerTitle": "Мацумото"
				},
				{
					"id": 721850206,
					"content": "Ха-ха-ха, мне просто кажется, что в таких иностранных деликатесах лучше сохранить аутентичный вкус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мацумото"
				}
			]
		},
		{
			"id": 7218503,
			"completionStepIds": [
				7218503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
