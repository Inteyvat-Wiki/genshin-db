			"dialogs": [
				{
					"id": 721850501,
					"content": "Спасибо, этого будет достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850502
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850502,
					"content": "Оригинальная грибная пицца из Мондштадта... Не знаю, смогу ли я успешно ее приготовить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850503
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850503,
					"content": "Готово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850504
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850504,
					"content": "Эта пицца выглядит... довольно хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850505
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850505,
					"content": "#Спасибо за помощь, путешественни{F#ца}{M#к}. Вот, возьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850506
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850506,
					"content": "Я обязательно буду смаковать вкус этой пиццы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850507
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850507,
					"content": "Если получилось неплохо... Скоро она официально станет новым блюдом нашего меню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Киминами Анна"
				}
			]
