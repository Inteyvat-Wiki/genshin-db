			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Киминами Анна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721850301,
					"content": "#Путешественни{F#ца}{M#к}, ты вернул{F#ась}{M#ся}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850302
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850302,
					"content": "Как всё прошло, есть отзывы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850303
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850303,
					"content": "Что касается отзывов клиентов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850304
					]
				},
				{
					"id": 721850304,
					"content": "Оригинальная грибная пицца... Хм, стоит попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850305
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850305,
					"content": "Ингредиенты: сыр, капуста и грибы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850306
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850306,
					"content": "У нас есть все ингредиенты, кроме сыра...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850307
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850307,
					"content": "#Путешественни{F#ца}{M#к}, ты не принесешь мне кусок сыра?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850308,
						721850310
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850308,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850309
					]
				},
				{
					"id": 721850309,
					"content": "Тогда я рассчитываю на тебя. Достаточно одной порции сыра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850310,
					"content": "Ты правда не используешь в своём ресторане сыр?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850311
					]
				},
				{
					"id": 721850311,
					"content": "Не то, чтобы мы им вообще не пользовались, просто мы используем его очень редко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850312
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850312,
					"content": "У нас в ресторане не так много блюд, для которых требуется сыр, поэтому мы не держим больших запасов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850313
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721850313,
					"content": "#В любом случае я рассчитываю на тебя, путешественни{F#ца}{M#к}. Пожалуйста, принеси мне порцию сыра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Киминами Анна"
				}
			]
		},
