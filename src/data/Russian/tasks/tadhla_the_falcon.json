					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7327906",
							"2"
						],
						"stepId": 7327906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тадлэ",
					"Лилупар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790602
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790602,
					"content": "Мм... Тадлэ? Мы пришли освободить тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790603,
					"content": "Да?.. О, хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790604
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790604,
					"content": "#Ты их упустил{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790605,
						732790606
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790605,
					"content": "Они нам больше не угроза.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				},
				{
					"id": 732790607,
					"content": "Они предупредят своих товарищей. Скоро они все узнают, что мы здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790608
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790608,
					"content": "У мудрецов мысли сходятся. Мне нравится эта девушка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790609
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790609,
					"content": "Это не имеет значения. Если они вернутся за нами, мы снова их побьём! Но ты ранена. Тебе нужна помощь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790610,
					"content": "Я в порядке. Я держусь на ногах, так что смогу найти себе достойное место, чтобы спокойно умереть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790611
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790611,
					"content": "Отлично, она держится на ногах и сможет найти себе достойное место, чтобы... Эй! Ты что такое говоришь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790612,
					"content": "Шучу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790613
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790613,
					"content": "Ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790614
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790614,
					"content": "Мне нравятся её шутки... Забавная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790615
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790615,
					"content": "Спасибо. Вернёмся к племени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790616,
						732790618
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790616,
					"content": "Тебе трудно идти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790617
					]
				},
				{
					"id": 732790617,
					"content": "Да, но я сама справлюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790618,
					"content": "Может, передохнём вместе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790619
					]
				},
				{
					"id": 732790619,
					"content": "Совместный отдых?.. Мы едва знакомы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790620
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790620,
					"content": "Так, может, надо познакомиться получше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790621
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790621,
					"content": "Спасибо, но не сейчас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790606,
					"content": "Необязательно их убивать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				}
			]
		},
		{
			"id": 7327907,
			"completionStepIds": [
				7327907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7327907",
							"2"
						],
						"stepId": 7327907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Массейра",
					"Тадлэ",
					"Лилупар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790701,
					"content": "А вот и мой сокол! Спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790702
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790702,
					"content": "#Простите, я попала в засаду. Только благодаря {M#ему}{F#ей} и смогла вернуться к вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790703
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790703,
					"content": "#{M#Ему}{F#Ей}? Это {M#уважаемый повелитель}{F#уважаемая повелительница} джиннов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790704
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790704,
					"content": "Простите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790705
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790705,
					"content": "Да ладно, всё в порядке! Тадлэ ранена, будь с ней помягче!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790706,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790707
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790707,
					"content": "Ты ранена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790708
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790708,
					"content": "Простите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790709
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790709,
					"content": "Кто виноват в этом? Животное или человек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790710
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790710,
					"content": "Северяне. Они устроили засаду, когда поняли, что за ними следят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790711
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790711,
					"content": "Это ты должна была устроить засаду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790712
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790712,
					"content": "Быть атакованным добычей. Позор для сокола.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790713
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790713,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790714
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732790714,
					"content": "Иди отдыхай. Обработаю твою рану позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790715
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790715,
					"content": "Тадлэ молча кивает и медленно уходит, превозмогая боль.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732790716
					]
				},
				{
					"id": 732790716,
					"content": "Массейра слишком строг с Тадлэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790717,
						732790720
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790717,
					"content": "Вы не ладите?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790718
					]
				},
				{
					"id": 732790718,
					"content": "Хм? Нет, конечно. Она мой любимый сокол. Я люблю её, но не балую. Будешь ли ты кормить лакомствами сокола, если он вернулся без добычи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790719
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790719,
					"content": "Ах, вот оно что... Бедняжка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790723,
					"content": "#Вот знак моей благодарности. Примите, {M#уважаемый повелитель}{F#уважаемая повелительница} джиннов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790724
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790724,
					"content": "#Гм. Ты ничего не забыл? Тут ещё два человека, помимо {M#твоего повелителя}{F#твоей повелительницы} джиннов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790725
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790725,
					"content": "Хе-хе, ну одна из этих двоих не совсем «человек»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790726
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790726,
					"content": "А... Да, конечно. Это летающее существо, строго говоря, не является человеком. Не задумывалась об этом раньше. Но, возможно, остальных людей вы всё же должным образом вознаградите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790727
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790727,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790728
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790728,
					"content": "Ха-ха, извините. Пожалуйста, примите это в качестве дополнительной оплаты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790729
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790729,
					"content": "О, дополнительная награда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790730
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790730,
					"content": "#Меньше, чем я ожидала... Но я приму, если вы не возражаете, {M#повелитель}{F#повелительница}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790731
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790731,
					"content": "Хорошо. Если будет время, приходите ещё. Думаю, моему соколу понадобится ваша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790720,
					"content": "Пожалуйста, не будь слишком суров к ней.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790721
					]
				},
				{
					"id": 732790721,
					"content": "Суров? Нет, наоборот, я был слишком добр к ней. Вот почему она стала такой неосторожной. Я обучаю её. Она выдающийся сокол. С чего бы мне вредить ей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790722
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790722,
					"content": "Какова же обычно судьба сокола?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Лилупар"
				}
			]
		}
	]
}