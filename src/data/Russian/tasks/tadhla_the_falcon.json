			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Массейра",
					"Лилупар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790101,
					"content": "#А, {NICKNAME}, {M#уважаемый повелитель}{F#уважаемая повелительница} джиннов. Что привело вас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790102
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790102,
					"content": "#Великолепно. Ещё один пустынник. {M#Повелитель}{F#Повелительница}, я... Эх, неважно. Я доверяю вашему суждению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790103
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790103,
					"content": "Не могли бы вы уделить мне минутку? Для меня сия встреча с вами столь же долгожданна, сколь желанны луна и дождь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790104
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790104,
					"content": "Не дай нам усомниться в твоих намерениях. Переходи к делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790105
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790105,
					"content": "#Хорошо, {M#повелитель}{F#повелительница} джиннов, у меня просьба...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790106
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790106,
					"content": "Ха-ха, ничего серьёзного. Дело в моём соколе Тадлэ. Я думаю, она в опасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790107
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790107,
					"content": "Эх, если бы мои ноги не были слабы, я бы не беспокоил вас по этому поводу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790108
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790108,
					"content": "Поправь, если Паймон ошибается. Ты хочешь, чтобы мы спасли её. И тогда ты отблагодаришь нас, заплатишь нам кучу моры и угостишь, не скупясь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790109,
					"content": "Э... Да, да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790110
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790110,
					"content": "Ну, раз так, то мы согласны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790111,
					"content": "В таких случаях логика никогда не подводит Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790112
					]
				},
				{
					"id": 732790112,
					"content": "Эх, хорошо. Давайте согласимся, чтобы Паймон смогла наесться вдоволь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790113
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790113,
					"content": "Спасибо большое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790114
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790114,
					"content": "Позвольте отметить её последнее местонахождение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790115
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790115,
					"content": "Тадлэ - высокая, загорелая, с длинными волосами светлого цвета, её оружие - лук. Да, этой информации о ней должно быть достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790116
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790116,
					"content": "Запомнили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790117
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790117,
					"content": "Хм... Высокая, загорелая девушка со светлыми длинными волосами, носит с собой лук! Хе-хе, у Паймон отличная память!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790118,
					"content": "Пусть ветер ведёт вас через песчаные бури, прочь от опасностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790119
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790119,
					"content": "Спасибо. Увидимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7327902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
