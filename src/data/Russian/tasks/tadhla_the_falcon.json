			},
			"dialogs": [
				{
					"id": 732790201,
					"content": "Нашли её?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790202
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790202,
					"content": "Вам ещё нужно время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790203
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732790203,
					"content": "Найдите её поскорее. Время не ждёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Массейра"
				}
			]
		},
		{
			"id": 7327904,
			"completionStepIds": [
				7327904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7327904",
							"2"
						],
						"stepId": 7327904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лилупар",
					"Застрельщик Фатуи А",
					"Застрельщик Фатуи Б",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790401,
					"content": "Тсс... Видишь? Там кто-то есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790402,
					"content": "#Хм... {F#Повелительница}{M#Повелитель}, это те люди, о которых вы говорили? «Балдуи»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790403
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790403,
					"content": "Фатуи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790404
					]
				},
				{
					"id": 732790404,
					"content": "А в чём разница?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790405
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790405,
					"content": "Тсс! Потише! Если они нас увидят...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790406,
					"content": "Спокойно. Они меня не слышат. Вот, убедитесь сами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790407
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790407,
					"content": "Эй! Толстяк! Сюда! Обед!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790408
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790408,
					"content": "Хм? Ты что-нибудь слышишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790409
					],
					"speakerTitle": "Застрельщик Фатуи А"
				},
				{
					"id": 732790409,
					"content": "Нет. А что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790410
					],
					"speakerTitle": "Застрельщик Фатуи Б"
				},
				{
					"id": 732790410,
					"content": "Хм... Будто кто-то звал обедать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790411
					],
					"speakerTitle": "Застрельщик Фатуи А"
				},
				{
					"id": 732790411,
					"content": "Хе-хе, видишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790412
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790412,
					"content": "Лилупар тоже иногда любит побаловаться! Хе-хе, как мило.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790413,
					"content": "Смотри! Вон там! Они поймали Тадлэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790414,
					"content": "Хм... Высокая, загорелая, светлые длинные волосы... Похоже, это она.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732790415,
					"content": "#Молодец, малышка. Пора за дело, {M#повелитель}{F#повелительница}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790416
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732790416,
					"content": "#{NICKNAME}, вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7327906,
			"completionStepIds": [
				7327906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
