				]
			},
			"dialogs": [
				{
					"id": 740590101,
					"content": "А, это вы! Поставщики драгоценной руды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590102
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590102,
					"content": "Да! Помнишь, в прошлый раз ты говорил, что сделаешь из неё прекрасные украшения... Ну, как идут дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740590103,
					"content": "Нам ужасно хочется посмотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740590104,
					"content": "Эм... Придётся мне вас разочаровать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590105
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590105,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740590106,
					"content": "Я очень хотел сделать из чудесной руды украшения, но руда оказалась такой твёрдой, что её невозможно качественно обработать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590107
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590107,
					"content": "И это ещё полбеды. Главное, что после резки и шлифовки руда теряет весь свой блеск!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590108
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590108,
					"content": "Одним словом, украшений из такой руды не получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590109
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590109,
					"content": "Ох, Паймон не ожидала, что так выйдет. Мы надеялись, что камни окажутся тебе полезны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740590110,
					"content": "Полезны... Ну, нельзя сказать, что они вовсе бесполезны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590126
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590126,
					"content": "С этими словами Чесил ставит на прилавок механические часы.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590111
					]
				},
				{
					"id": 740590111,
					"content": "Смотрите, вашей руде нашлось применение в новых механических часах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590112
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590112,
					"content": "Я корил себя за ошибку и хотел вовсе избавиться от руды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590113
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590113,
					"content": "Но потом кто-то из часовщиков увидел руду, оставшуюся после неудачных попыток обработки. Часовщикам понравилось, что ваша руда очень прочная, и они изготовили из неё детали для часового механизма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590114
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590114,
					"content": "Оказалось, за счёт своей твёрдости и прочности ваша руда подходит для изготовления часовых механизмов лучше всех остальных материалов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590115
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590115,
					"content": "Но если использовать руду для изготовления часов, поставки должны быть бесперебойными...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590116,
						740590117
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590116,
					"content": "Думаю, мы справимся...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				},
				{
					"id": 740590118,
					"content": "Вы рассказываете Чесилу о Пуке и рудных жилах.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590119
					]
				},
				{
					"id": 740590119,
					"content": "Вот оно что! Какое совпадение! Дело в том, что образец новых часов выполнен в устричном стиле и обладает водонепроницаемыми свойствами. Иными словами, такие часы изначально разработаны для мелюзин!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590120
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590120,
					"content": "Не могли бы вы отнести образец госпоже Пуке и рассказать ей, что нам нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590121
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590121,
					"content": "Всё-таки я никогда прежде не вёл дел с мелюзинами... Если госпожа Пука сможет обеспечить бесперебойные поставки руды, мы создадим новую производственную линию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590122
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590122,
					"content": "Предупредите госпожу Пуку, а потом я навещу её лично! Гм... И в новом дизайне часов можно использовать элементы стиля мелюзин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590123
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590123,
					"content": "Ха-ха, если всё получится, Пука тоже останется в выигрыше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740590124,
					"content": "Теперь она сможет открыть свою собственную мастерскую! Давай вернёмся в деревню и всё ей расскажем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740590125,
					"content": "Спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590117,
					"content": "Ты можешь напрямую обратиться к Пуке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				}
			]
		},
