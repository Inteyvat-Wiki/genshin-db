			"dialogs": [
				{
					"id": 740590201,
					"content": "#{NICKNAME} и Паймон! Давно не виделись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590202
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740590202,
					"content": "Снова ищете странные камешки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590203
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740590203,
					"content": "Эм, да... но тут долгая история...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740590204,
					"content": "Вы вручаете Пуке часы, которые дал вам Чесил, и рассказываете ей о намерении Чесила использовать чудесную руду в часовых механизмах.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590205
					]
				},
				{
					"id": 740590205,
					"content": "Ого, ничего себе! Значит, из камешков можно смастерить такую вот штуковину?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590206
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740590206,
					"content": "А? Ну, часы не целиком сделаны из руды, только часть механизма...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740590207,
					"content": "Они тикают даже под водой! Впервые вижу такие часы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590208
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740590208,
					"content": "Чесил что-то говорил про устричный стиль... Или ракушечный?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740590209,
					"content": "Хе-хе, мне нравится просто слушать, как они тикают под водой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590210
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740590210,
					"content": "Никогда не думала, что самым обычным камешкам может найтись такое применение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590211
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740590211,
					"content": "Я была уверена, что разные классные вещи могут получиться только из редких самоцветов, как у сестрицы. Не ожидала, что из обычных камней получится смастерить такие часы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590212
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740590212,
					"content": "У каждой вещи своё применение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590213
					]
				},
				{
					"id": 740590213,
					"content": "Ага! Знаете, я теперь куда больше верю в свои силы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590214
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740590214,
					"content": "Пука осторожно ставит часы в красивое место.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590215
					]
				},
				{
					"id": 740590215,
					"content": "Ну что, тогда тебе остаётся приготовить побольше руды, чтобы продать её Чесилу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740590216,
					"content": "И ты сможешь открыть свою мастерскую, совсем как сестрица!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740590217,
					"content": "У тебя ведь уйма разных камней в коллекции! Наверняка из них тоже можно что-нибудь смастерить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740590218,
					"content": "Да! Я должна как следует приготовиться! Спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590219
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740590219,
					"content": "Если вам понадобятся ещё какие-нибудь камешки, всегда рада помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590220
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740590220,
					"content": "Хе-хе, не за что!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
