			"dialogs": [
				{
					"id": 740590401,
					"content": "Если госпожа Пука сможет обеспечить бесперебойные поставки руды, мы запустим часы в серийное производство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590402
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740590402,
					"content": "Я на вас рассчитываю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
