			},
			"dialogs": [
				{
					"id": 761860201,
					"content": "Отменный травяной чай, госпожа Сандроне. Я чувствую, сколько заботы ты в него вложила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761860202,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761860204,
					"content": "Хорошо. В следующий раз я сама приглашу тебя на чай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761860203,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
