			"dialogs": [
				{
					"id": 761860101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860102
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761860102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860103
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761860103,
					"content": "...Как поживают в последнее время Дети Морозной Луны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860104
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761860104,
					"content": "Неплохо. Возвращение Богини Луны укрепило нашу верность избранному пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860105
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761860105,
					"content": "Правда? Рада слышать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860106
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761860106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860107
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761860107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860108
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761860108,
					"content": "Ха... Наверное, нам в самом деле не о чем разговаривать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860109
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761860109,
					"content": "Боюсь дело в том, что у Детей Морозной Луны слишком много неприятных воспоминаний, связанных с Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860110
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761860110,
					"content": "Разумеется, лично я глубоко признательна тебе, госпожа Сандроне, за всё, что ты сделала ради защиты Нод-Края и возвращения Богини Луны. Но вот твои коллеги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860111
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761860111,
					"content": "Я понимаю. В силу разных причин в прошлом нам не удалось построить дружеские отношения. Даже партнёрских отношений между нами не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860112
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761860112,
					"content": "Но теперь Фатуи больше ничего не хотят от Детей Морозной Луны, и я предупредила своих подчинённых не чинить Детям Морозной Луны никаких препятствий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860113
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761860113,
					"content": "С моей личной точки зрения, раз уж мы соседи, лучше общаться друг с другом со взаимным уважением, даже если дружба пока не складывается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860114
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761860114,
					"content": "Боюсь, на это потребуется время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860115
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761860115,
					"content": "Конечно. Но для начала можно хотя бы попытаться. Попробуешь травяной чай, который я приготовила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860116
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761860116,
					"content": "Травяной чай? Ого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860117
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761860117,
					"content": "Мм... Невероятно насыщенный вкус. Ты заварила его по рецепту Детей Морозной Луны? Обычно чужаки не любят такой чай. Как тебе удалось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860118
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761860118,
					"content": "Я училась. И не забывала об уважении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860119
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761860119,
					"content": "Ха... Неплохая попытка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860120
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761860120,
					"content": "Надеюсь, тебе нравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860121
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761860121,
					"content": "Да, очень нравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860122
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761860122,
					"content": "Чаепитие в ответ на чаепитие - испытанный способ завязать добрососедские отношения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860123
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761860123,
					"content": "Думаю, наш случай не будет исключением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лаума"
				}
			]
		},
