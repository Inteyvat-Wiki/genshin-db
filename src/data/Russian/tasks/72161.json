			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Инаба Кюдзо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610101,
					"content": "Хм, какое унижение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610102
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610102,
					"content": "Эй! Мы спасли тебе жизнь! Что значит «унижение»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610103,
						721610104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721610103,
					"content": "Это он о себе, Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				},
				{
					"id": 721610105,
					"content": "Подумать только, мало того, что меня спасли чужестранцы, так они еще и осуждают меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610106
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610106,
					"content": "А... Так это, господин самурай, с тобой всё в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721610107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610108,
						721610109
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610108,
					"content": "Кажется, он цел...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610110,
					"content": "#Я в долгу перед тобой, чужестран{F#ка}{M#ец}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610111
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610111,
					"content": "#И сражал{F#ась}{M#ся} ты отлично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610112
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610112,
					"content": "#Меня зовут {NICKNAME}. Приятно познакомиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610113
					]
				},
				{
					"id": 721610113,
					"content": "#Не смотри на меня свысока, чужестран{F#ка}{M#ец}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610114
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610114,
					"content": "Инаба Тосабуро Кюдзо... Зови меня просто Кюдзо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610115,
						721610116
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610115,
					"content": "Итак, кто были эти люди?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610117,
					"content": "Это пираты. У них много крепостей на побережье Надзути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610118
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610118,
					"content": "Бандиты, безработные шахтёры, рыбаки, беглецы, спасающиеся от Охоты на Глаза Бога, и дезертиры с обеих воюющих сторон иногда собираются в группы и превращаются в разбойников и пиратов... Они тщетно пытаются вырваться из-под власти её превосходительства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610119
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610119,
					"content": "Как их ни называй - бродяги, кайраги - они все бандиты и преступники... Мы держали их под контролем, пока мятежники не уничтожили оберег на острове...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610120
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610120,
					"content": "Беженцы из Татарасуны и шахт спасались в большом количестве, и некоторые из этих крыс попали сюда, пополнив ряды пиратских банд, отчего те стали ещё наглее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610121
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610121,
					"content": "Ранее группа пиратов вышла из лагеря на юге, и они внимательно следили за грузом на борту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610122
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610122,
					"content": "Какая жалость, что я разрушил их планы, хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610123
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610123,
					"content": "Значит, это не твой корабль?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610124
					]
				},
				{
					"id": 721610124,
					"content": "Этот? Он принадлежал мятежникам Сангономии, но точно сказать нельзя... Когда я пришёл, на борту уже никого не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610125
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610125,
					"content": "Так что я остался и до сих пор жил на нём, как краб-отшельник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610126
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610126,
					"content": "Ха, я уже давно так много не говорил. Это так утомительно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610127
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610127,
					"content": "Если ты не против, мне понадобится твоя помощь. Как только мои раны заживут, я в долгу перед тобой не останусь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610128
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610128,
					"content": "#Мне нужно, чтобы ты помог{F#ла} мне очистить пиратский лагерь неподалёку, о котором я упоминал ранее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610129
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610129,
					"content": "Это единственный способ убедиться, что они не вернутся сюда и не нападут на меня, как стая бродячих собак. Может, заодно и пиратам из других лагерей неповадно будет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610130
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610130,
					"content": "Также я увижу, на что ты годишься. Идёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610131,
						721610132
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610131,
					"content": "Проще простого.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610133,
					"content": "Ха-ха, а ты не из скромных...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610134
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610134,
					"content": "#Кстати, чужестран{F#ка}{M#ец}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610135
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610135,
					"content": "Ты не слишком задавайся. Оступишься и сломаешь ещё ногу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610132,
					"content": "Скоро вернусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610116,
					"content": "Почему на тебя напали?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610109,
					"content": "Но пострадала его гордость...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610104,
					"content": "Такие уж они, самураи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				}
			]
		},
		{
			"id": 7216102,
