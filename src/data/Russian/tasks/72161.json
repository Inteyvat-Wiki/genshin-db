			},
			"dialogs": [
				{
					"id": 721610601,
					"content": "#Чужестран{F#ка}{M#ец}, как поживаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610602
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610602,
					"content": "Прошу прощения. Это неподходящее место, чтобы принимать гостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610603
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610603,
					"content": "#Тем не менее... Я рад, что ты {F#пришла}{M#пришёл}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610604
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610604,
					"content": "Ты выглядишь намного лучше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610605
					]
				},
				{
					"id": 721610605,
					"content": "Да, я обязан тебе и этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610606
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610606,
					"content": "Ха-ха, разве не жаль, что я снова выжил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610607
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610607,
					"content": "Так это ведь хорошо! Почему тебе жаль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610608,
						721610609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721610608,
					"content": "Что вы будете делать дальше?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				},
				{
					"id": 721610610,
					"content": "Что делать дальше, я не знаю, но вряд ли я вернусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610611
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610611,
					"content": "Господин Кудзё Масахито неплохой человек, но его отец призывает ловить и наказывать дезертиров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610612
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610612,
					"content": "Лучше мне его гнев не навлекать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610613
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610613,
					"content": "Может, я сниму доспехи. Жить здесь одному было совсем неплохо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610614
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610614,
					"content": "Но пока не будет мира, нет смысла себя обманывать. Память говорит мне, что я всё тот же раненый, окровавленный солдат...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610615
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610615,
					"content": "Эх... Кто знает, что нам принесёт будущее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610616,
						721610617
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610616,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610618,
					"content": "Ну, как я уже говорил, я никогда не сомневался в решениях её превосходительства, поэтому думаю, что даже если я умру, то умру без сожалений, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610619
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610619,
					"content": "Хм... какой мрачный поворот...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610620
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721610620,
					"content": "Кстати, мне пора навестить старых товарищей по оружию, которые всё ещё со мной на этом острове.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610621
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610621,
					"content": "По традиции Инадзумы, мы подносим павшим товарищам кровоцвет - нежный и очаровательный цветок, символ судьбы всех самураев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610622
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610622,
					"content": "Кстати, если по пути встретишь моих старых товарищей по оружию, пожалуйста, остановись на минутку и познакомься с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610617,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610609,
					"content": "Ты не думал вернуться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				}
			]
		},
