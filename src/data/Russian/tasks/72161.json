			"dialogs": [
				{
					"id": 721611301,
					"content": "#Чужестран{F#ка}{M#ец}? Интересно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611302
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721611302,
					"content": "#Если ты турист{F#ка}, то явно попал{F#а} не туда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611303
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
