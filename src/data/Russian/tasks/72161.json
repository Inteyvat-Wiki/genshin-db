				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610505,
					"content": "Чтобы сделать из травы пасту, потребуется много времени. Ты можешь идти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610506
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610506,
					"content": "Нет, не пойми меня неправильно. Я тебя не прогоняю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610507
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610507,
					"content": "Возвращайся через некоторое время. Хорошо, когда есть с кем поговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610508,
						721610509
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610508,
					"content": "Я понимаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610510
					]
				},
				{
					"id": 721610510,
					"content": "#Удачи, чужестран{F#ка}{M#ец}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610509,
					"content": "Позаботься о своей ране.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610510
					]
				}
			]
		},
