		},
		{
			"id": 7216103,
			"completionStepIds": [
				7216114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216114",
							"2"
						],
						"stepId": 7216114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Инаба Кюдзо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610301,
					"content": "#Ты вернул{F#ась}{M#ся}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610302,
						721610303
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610302,
					"content": "#И убил{F#а} их всех.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				},
				{
					"id": 721610304,
					"content": "Ха, как-то даже неловко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721610305,
					"content": "Прошу прощения, что попросил незнакомого человека выполнить такую грязную работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610306,
						721610307
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610306,
					"content": "Что ж, при первой нашей встрече вы были вовсе не так вежливы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610309
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610309,
					"content": "У меня закончились лечебные травы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610310
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610310,
					"content": "Травы, которые я прикладывал, кончились, но воспаление не прошло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610311
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610311,
					"content": "Но... Не стоит обо мне беспокоиться. Я потерплю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610312
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610312,
					"content": "Займись своими делами. Давай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610313
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610313,
					"content": "Прямо как ребенок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610314
					]
				},
				{
					"id": 721610314,
					"content": "?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610315
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610315,
					"content": "#Что ты сказал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610316
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610316,
					"content": "Я говорю, что ты совсем как ребенок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721610317,
					"content": "Видно же, дело плохо, и ты чуть не кричишь о помощи, но пытаешься выглядеть крутым... Это так неискренне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721610318,
					"content": "Так ведут себя только дети.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721610319,
					"content": "А ещё, Кюдзо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610320,
						721610321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721610320,
					"content": "Ты перед нами в долгу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610322,
					"content": "Хм... И что мне теперь делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610323
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610323,
					"content": "В таком случае, пожалуйста, помогите мне достать траву наку. Она растёт повсюду на этом острове. Целые листья - самые лучшие. Из них нужно изготовить пасту и нанести на рану...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610324
					],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610324,
					"content": "Это всё. Теперь дайте мне немного вздремнуть в покое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Инаба Кюдзо"
				},
				{
					"id": 721610321,
					"content": "Мы пришли помочь тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610307,
					"content": "Как твоя рана?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610303,
					"content": "Теперь тебя какое-то время никто не потревожит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				}
			]
		},
