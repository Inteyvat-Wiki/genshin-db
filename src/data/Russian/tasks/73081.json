			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Аракави",
					"Арама"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730810301,
					"content": "#Арама и {F#золотая}{M#золотой} нара. Ты {F#такая высокая}{M#такой высокий}. А вот эта серебряная...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810302
					],
					"speakerTitle": "Аракави"
				},
				{
					"id": 730810302,
					"content": "Что серебряная?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730810303,
					"content": "Ну как бы выразиться... Ты сможешь пробраться в очень узкое дупло. Тебе будет очень просто это сделать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810304
					],
					"speakerTitle": "Аракави"
				},
				{
					"id": 730810304,
					"content": "#Давайте я вас познакомлю, как это делают нары. Это нара {NICKNAME} и Паймон, а это Аракави. Пожмите друг другу руки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810305
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730810305,
					"content": "Вы в недоумении пожимаете руку Аракави...\\nНе очень сильно.\\nНо прикосновение получилось особенным.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730810306
					]
				},
				{
					"id": 730810306,
					"content": "Я много слышал о нарах раньше, но впервые прикасаюсь к наре. Невероятные ощущения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810307
					],
					"speakerTitle": "Аракави"
				},
				{
					"id": 730810307,
					"content": "#Когда-то к нам тоже {F#приезжал}{M#приезжала} нара. С тех пор маленькие семечки выросли в могучие деревья, а многие истории превратились в легенды. Говорят, {F#тот}{M#та} нара тоже {F#был очень хорошим}{M#была очень хорошей}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810308
					],
					"speakerTitle": "Аракави"
				},
				{
					"id": 730810308,
					"content": "#Нара {NICKNAME} тоже {F#хорошая}{M#хороший}, а также {F#смелая}{M#смелый} и {F#сильная}{M#сильный}. Прямо как деревце, растущее на скале. А ещё, они пришли помочь Аране.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810309
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730810309,
					"content": "Давно я не видел Арану. Надеюсь, у него всё хорошо, как и у маленьких нар из деревни Вимара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810310
					],
					"speakerTitle": "Аракави"
				},
				{
					"id": 730810310,
					"content": "Ты знаком с детьми из деревни Вимара?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810311
					]
				},
				{
					"id": 730810311,
					"content": "Конечно, знаком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810312
					],
					"speakerTitle": "Аракави"
				},
				{
					"id": 730810312,
					"content": "Мы все знакомы. Арана вернулась и всё нам рассказала про детишек. Поэтому нара Иотам, нара Бахрам и нара Рана - наши друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810313
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730810313,
					"content": "Но это не значит, что вы знакомы с ними...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730810314,
					"content": "А как тогда познакомиться? Сначала нужно представиться, а потом пожать руку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810315
					],
					"speakerTitle": "Аракави"
				},
				{
					"id": 730810315,
					"content": "А, я знаю, что Паймон имеет в виду. Нары должны вместе поесть, поискать сокровища, после чего они могут считаться знакомыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810316,
						730810317,
						730810318
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730810316,
					"content": "Ну, не всё так просто...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810321,
					"content": "А у нас за знакомство считается знание историй. Потому что мир аранар состоит из песен и сновидений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810322
					],
					"speakerTitle": "Аракави"
				},
				{
					"id": 730810322,
					"content": "#Аракави говорит правду. Нара {NICKNAME}, если аранары услышали песню про тебя или увидели тебя во сне, то это считается за знакомство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810323
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730810323,
					"content": "Паймон считает, что на этом можно не зацикливаться. Потому что мы уже стали друзьями аранар!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730810324,
					"content": "Лучшими друзьями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810325,
						730810327
					],
					"speakerTitle": "Арама и Аракави"
				},
				{
					"id": 730810325,
					"content": "Лучшими друзьями!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810328,
					"content": "Ах да, мы должны провести Праздник Утсава, поэтому Аракави нужно подготовиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730810329,
					"content": "Так вот, в чём дело. Всё это ради биджи? Я уже отправил Араясу, Арадасу и Арасудраку на поиски Зала Ашваттхи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810330
					],
					"speakerTitle": "Аракави"
				},
				{
					"id": 730810330,
					"content": "Всё именно так... Вот только Паймон никак не поймёт, почему вы не знаете, где находится Зал Ашваттхи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810331
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730810331,
					"content": "Зал Ашваттхи - священное место, куда мы обычно не ходим. Пусть васары спокойно спят и видят сны, пока все воспоминания не соберутся в сарве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810332
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730810332,
					"content": "Лес помнит всё. Всё прекрасное никогда не исчезнет, а все страдания превратятся в питательную среду для прекрасного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810333
					],
					"speakerTitle": "Аракави"
				},
				{
					"id": 730810333,
					"content": "В общем, Араяса, Арадаса и Арасудрака отправились на поиски Зала Ашваттхи. Арама, помоги им.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810334
					],
					"speakerTitle": "Аракави"
				},
				{
					"id": 730810334,
					"content": "#Хорошо, я помогу им. Если нара {NICKNAME} и Паймон встретят нас в лесу, давайте вместе отправимся на поиски приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810335
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730810335,
					"content": "#Прекрасно! Я очень рад нашему знакомству, нара {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аракави"
				},
				{
					"id": 730810327,
					"content": "Давайте перейдём к делу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810317,
					"content": "Как же объяснить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810318,
					"content": "Мы с Паймон вместе поели и поискали сокровища.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810319
					]
				},
				{
					"id": 730810319,
					"content": "Ага! Но мы не только знакомы, мы лучшие друзья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730810320,
					"content": "#Какие вы молодцы, нара {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810321
					],
					"speakerTitle": "Арама"
				}
			]
		},
