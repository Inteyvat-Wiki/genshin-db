			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ситлали"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752380201,
					"content": "#Хм... В следующий раз я {M#его}{F#её} проучу как следует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380202,
						752380203
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 752380202,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 752380204,
					"content": "Уже пора? Что ж, госпожа Гильотен, будь осторожна на обратной дороге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 752380203,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
}