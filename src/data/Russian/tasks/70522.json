			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цюй Цин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220101,
					"content": "Добро пожаловать, дорогие гости! Что желаете выпить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220102
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220102,
					"content": "Эм... Судя по виду, вы из далёких краёв. Не уверена, что вам придётся по вкусу мой чай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220103
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220103,
					"content": "Я заварю байховый чай Юньлай. Если вам такой не нравится, приходите немного погодя. Я пошлю кого-нибудь за особыми напитками в Мондштадт на Праздник вина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220104,
						705220105
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220104,
					"content": "Спасибо, но мы пришли не для того, чтобы угоститься напитками.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				},
				{
					"id": 705220106,
					"content": "Верно, мы надёжные посыльные! До Паймон дошли слухи, что на Празднике вина тебе была нужна помощь специалистов в закупке напитков. Вот мы и пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705220107,
					"content": "Опиши подробно, какие напитки тебе нужны, и мы поможем тебе сделать заказ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705220108,
					"content": "Вы отправились в Ли Юэ, чтобы помочь другим с заказами?.. Вот это отзывчивость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220109
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220109,
					"content": "А я переживала, что не смогу никому это поручить... Вот спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220110
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220110,
					"content": "Моряки, побывавшие в Мондштадте, рассказывали, что «Мятные ягоды», особый напиток таверны <color=#00E1FFFF>«Кошкин хвост»</color>, утоляет жажду и успокаивает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220111
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220111,
					"content": "Поэтому я хочу заказать <color=#00E1FFFF>65 ящиков Мятных ягод</color> и вместе с другими напитками продать морякам. Это поднимет им настроение и повысит работоспособность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220112
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220112,
					"content": "Раньше торговцы из Мондштадта по моему запросу готовили равноценные товары. В этот раз в преддверии Праздника вина мы собрали винный студень. Вот, возьмите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220113
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220113,
					"content": "Денег, приготовленных для покупки, хватит с лихвой, а всё, что останется, - вознаграждение за вашу помощь. Хоть этого и недостаточно, чтобы выразить мою благодарность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220114,
						705220115
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220114,
					"content": "Не беспокойся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220116,
					"content": "#Не волнуйся! 65 ящиков Мятных ягод? Паймон и {NICKNAME} не подведут. Мы в этом деле эксперты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705220117,
					"content": "Скоро вернёмся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705220115,
					"content": "Пустяки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220105,
					"content": "Мы по поручению помогаем закупать напитки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				}
			]
		},
		{
			"id": 7052202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052202",
							"2"
						],
						"stepId": 7052202,
						"stateName": "QUEST_STATE_UNFINISHED"
