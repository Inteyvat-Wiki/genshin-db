			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Диана"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220201,
					"content": "Добро пожаловать в таверну «Кошкин хвост»! Что желаете купить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220202
					],
					"speakerTitle": "Диана"
				},
				{
					"id": 705220202,
					"content": "Привет, Диана! У нас для тебя есть отличное предложение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705220203,
					"content": "Вы сообщаете Диане о запросе на закупку от Цюй Цин.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705220204
					]
				},
				{
					"id": 705220204,
					"content": "Что? Это та небольшая лавка у северного причала в Ли Юэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220205
					],
					"speakerTitle": "Диана"
				},
				{
					"id": 705220205,
					"content": "Моряки из Тернового порта говорили о хозяйке этой лавки. Кажется, госпожа Маргарита тоже покупала у неё ингредиенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220206
					],
					"speakerTitle": "Диана"
				},
				{
					"id": 705220206,
					"content": "В последнее время, когда госпожа Цюй Цин продаёт морякам в порту напитки, она также просит их рекламировать родниковую воду из деревни Цинцэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220207
					],
					"speakerTitle": "Диана"
				},
				{
					"id": 705220207,
					"content": "Она покупает воду в деревне Цинцэ по высокой цене и продаёт её там, где на неё есть спрос, лишь с трудом окупая этим собственный труд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220208
					],
					"speakerTitle": "Диана"
				},
				{
					"id": 705220208,
					"content": "Благодаря установленным ей контактам иноземцы могут производить особые напитки на основе чистой родниковой воды из деревни Цинцэ, а пожилые жители деревни получают хороший доход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220209
					],
					"speakerTitle": "Диана"
				},
				{
					"id": 705220209,
					"content": "Вот как...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220210
					]
				},
				{
					"id": 705220210,
					"content": "Так значит, Цюй Цин такой хороший человек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705220211,
					"content": "Да. Возможно, «Кошкин хвост» установит с ней долгосрочное сотрудничество.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220212
					],
					"speakerTitle": "Диана"
				},
				{
					"id": 705220212,
					"content": "Ладно, теперь перейдём к делу. Сколько Мятных ягод вам нужно купить, и на какую сумму вы рассчитываете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Диана"
				}
			]
		},
		{
			"id": 7052203,
