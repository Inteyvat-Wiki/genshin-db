			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цюй Цин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220301,
					"content": "Цюй Цин, мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705220302,
					"content": "Напитки заказаны. Завтра их погрузят на корабль, скоро они уже будут в порту! Держи документы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705220303,
					"content": "Договорились? Как вы быстро!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220304
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220304,
					"content": "Сейчас-сейчас, я заварю вам чай на самой лучшей родниковой воде...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220305,
						705220306
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220305,
					"content": "Спасибо, не надо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				},
				{
					"id": 705220307,
					"content": "Да-да, нам ещё нужно заняться другими заказами, так что не отвлекайся на нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705220308,
					"content": "Желаем тебе успехов в делах! Как будем здесь в следующий раз, обязательно попробуем твои вкусные напитки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705220309,
					"content": "Тогда к следующему разу обязательно приготовлю то, что вам понравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220310
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220310,
					"content": "Заходите почаще!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220306,
					"content": "Мы ведь получили плату за хлопоты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				}
			]
		},
		{
			"id": 7052204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
