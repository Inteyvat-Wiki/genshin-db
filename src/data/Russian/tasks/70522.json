			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цюй Цин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220401,
					"content": "Спасибо за помощь с заказом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220402
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220402,
					"content": "С этим ассортиментом напитков моряки смогут утолить жажду, попробовав разные вкусы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220403,
						705220406,
						705220409
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220403,
					"content": "Вкусы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220404
					]
				},
				{
					"id": 705220404,
					"content": "У моряков разные предпочтения. Кто-то любит лёгкий чай, кто-то - кисло-сладкий сок... да и вообще, пить всё время один и тот же напиток со временем может надоесть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220405
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220405,
					"content": "Я всё время закупаю напитки с разными вкусами, стараясь как можно лучше угодить морякам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220406,
					"content": "Расскажи о магазине...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220407
					]
				},
				{
					"id": 705220407,
					"content": "Когда-то моряки очень мне помогли, и потому я открыла в порту этот магазин, в котором продаю им напитки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220408
					],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220408,
					"content": "Но пока что я ещё недостаточно опытна, и дела идут не очень...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цюй Цин"
				},
				{
					"id": 705220409,
					"content": "До встречи!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220410
					]
				},
				{
					"id": 705220410,
					"content": "До свидания! Удачной дороги!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цюй Цин"
				}
			]
		},
		{
