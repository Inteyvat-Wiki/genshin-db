			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сорайя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220101,
					"content": "Гора Тяньхэн... Могучий Повелитель Небесных Пределов... Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220102
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220102,
					"content": "Чего ты бормочешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220103
					]
				},
				{
					"id": 718220103,
					"content": "Ах, я просто исследую историю и легенды Праздника морских фонарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220104
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220104,
					"content": "Говорят, что в этом году лунный фонарь сделан по подобию Адепта, которого звали Могучим Повелителем Небесных Пределов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220105
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220105,
					"content": "Согласно собранным мною легендам, этот Адепт также некоторое время сражался на стороне Властелина Камня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220106
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220106,
					"content": "Вот только время сражений и враги в каждом источнике указаны разные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220107
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220107,
					"content": "Но все они сходятся на том, что он уже погиб. Также утверждается, что он своими горами подпирал гору Тяньхэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220108
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220108,
					"content": "Поэтому я и пришла осмотреть гору Тяньхэн. Вдруг мне посчастливится что-нибудь найти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220109
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220109,
					"content": "Но здесь полно чудовищ. Из-за них к месту, которое я наметила для исследований, не подойти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220110
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220110,
					"content": "#Путешественни{F#ца}{M#к}, если у тебя есть время и желание, не мог{F#ла} бы ты помочь мне с исследованием и принести образцы почвы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220111
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220111,
					"content": "Образцы... почвы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220112
					]
				},
				{
					"id": 718220112,
					"content": "Ну... Так говорят у нас в Академии. На деле это куски земли из исследуемой области.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220113
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220113,
					"content": "Поскольку местные предания гласят, что Могучий Повелитель Небесных Пределов удерживал своими рогами гору Тяньхэн...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220114
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220114,
					"content": "То с точки зрения науки в местной почве могут оказаться необычные составляющие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220115
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220115,
					"content": "Поэтому, пожалуйста, принеси мне оттуда один образец почвы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				}
			]
		},
		{
			"id": 7182202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
