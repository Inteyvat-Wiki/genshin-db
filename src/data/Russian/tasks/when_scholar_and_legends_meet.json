			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сорайя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220201,
					"content": "Рога... Гора Тяньхэн... Если всё это правда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				}
			]
		},
		{
			"id": 7182203,
			"completionStepIds": [
				7182203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182203",
							"2"
						],
						"stepId": 7182203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сорайя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220301,
					"content": "#Ты прин{F#есла}{M#ёс} образец?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220302
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220302,
					"content": "Да, вот он.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220303
					]
				},
				{
					"id": 718220303,
					"content": "Благодарю. Дай взглянуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220304
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220304,
					"content": "...Хм. Кажется, ничего особенного в нём нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220305
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220305,
					"content": "А что именно ты ожидала обнаружить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220306
					]
				},
				{
					"id": 718220306,
					"content": "Согласно легендам, Могучий Повелитель Небесных Пределов подпирал гору Тяньхэн своими рогами, чтобы та не рухнула на гавань Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220307
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220307,
					"content": "Я предполагала, что смогу хотя бы найти немного фрагментов рогов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220308
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220308,
					"content": "Конечно же, это всего лишь легенды... Или прошло столько времени, что все следы попросту исчезли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220309
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220309,
					"content": "Но получить образец почвы уже неплохо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220310
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220310,
					"content": "#Путешественни{F#ца}{M#к}, пройдёшь со мной ещё немного? Я хотела бы подняться в гору, это недалеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220311,
						718220312
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220311,
					"content": "Хорошо, я пройдусь вместе с тобой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				},
				{
					"id": 718220313,
					"content": "На этот раз... Я хотела бы забраться на возвышенность, с которой можно было бы осмотреть рельеф горы Тяньхэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220314
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220314,
					"content": "По легенде, Властелин Камня и множество Адептов сражались в битве, из-за которой чуть не обрушилась гора Тяньхэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220315
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220315,
					"content": "Столь яростная схватка непременно оставила бы след на местном ландшафте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220312,
					"content": "Что ты хочешь найти на этот раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				}
			]
		},
		{
			"id": 7182206,
			"completionStepIds": [
				7182206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182206",
							"2"
						],
						"stepId": 7182206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сорайя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220601,
					"content": "Наконец-то добрались... Поход выдался нелёгким даже без чудовищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220602
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220602,
					"content": "В окружающем ландшафте нет ничего необычного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220603
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220603,
					"content": "Там что-то на дереве. Небесный фонарь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220604
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220604,
					"content": "Откуда он тут взялся? Неужто кто-то пришёл сюда, чтобы воздать почести погибшему Адепту?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220605
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220605,
					"content": "Там что-то написано...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220606
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220606,
					"content": "«Мир и благодать всем поколениям».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220607,
						718220608
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220607,
					"content": "Величественное желание.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				},
				{
					"id": 718220609,
					"content": "И в самом деле. Слишком уж это желание... грандиозное, что ли? Ни на почести, ни на желание непохоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220610
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220610,
					"content": "Что-нибудь подобное скорее мог загадать Адепт из легенд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220611
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220611,
					"content": "Интересно, кто вложил это желание в фонарик? Как странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220612
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220612,
					"content": "Как бы то ни было, кто-то сберёг память о былом и пришёл запустить небесный фонарь. Тот Адепт был бы этому рад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220613
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220613,
					"content": "#Спасибо, что прош{F#ла}{M#ёл} со мной такой путь. Я останусь здесь и продолжу исследование...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220614
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220614,
					"content": "Да, это тебе в благодарность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220615
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220615,
					"content": "Эх, в Ли Юэ столько легенд, а моё исследование не продвинулось ни на шаг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 718220608,
					"content": "На воздаяние почестей непохоже...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				}
			]
		}
	]
}