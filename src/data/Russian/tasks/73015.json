			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Аранакула"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730150301,
					"content": "А ты, наверное, Аранакула!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150302,
					"content": "#Ой! Нара {M#нашёл}{F#нашла} Аранакулу... Ч-ч-что же делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150303
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150303,
					"content": "Погоди, не убегай! Арапанду сказал нам, что ты здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150304,
					"content": "А-а-арапанду... Значит, вы хорошие нары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150305
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150305,
					"content": "#Гм, Аранакула, веришь на слово? А вдруг {NICKNAME} - {M#плохой}{F#плохая} нара, вдруг мы просто знаем имя Арапанду и воспользовались этим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150306,
					"content": "#А? Зна-значит, {M#золотой}{F#золотая} нара обманывает Аранакулу? {M#Золотой}{F#Золотая} нара {M#плохой}{F#плохая}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150307
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150307,
					"content": "Паймон чувствует себя виноватой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150308,
					"content": "#Не слушай Паймон, я {M#хороший}{F#хорошая} нара.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150309
					]
				},
				{
					"id": 730150309,
					"content": "#Как хорошо! Слава Арамухукунде, {M#золотой}{F#золотая} нара {M#оказался}{F#оказалась} {M#хорошим}{F#хорошей} нарой. {NICKNAME} намного больше Аранакулы, но Аранакула не боится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150310
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150310,
					"content": "Паймон... Паймон - кроха, её Аранакула тоже не боится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150311
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150311,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150312,
						730150314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150312,
					"content": "Паймон и правда кроха...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150313
					]
				},
				{
					"id": 730150313,
					"content": "Кто обижает Паймон, тому несдобровать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150316,
					"content": "Но вернёмся к делу! Мы пришли исцелить машину Варуны. В этой части ваны тоже спрятаны её листья и ветви?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150317,
					"content": "Арапанду отправил нас посмотреть, как тут дела, и помочь тебе, если нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150318,
					"content": "О, в ване развелось много негодяев... Есть безопасная тропа, но нужно быть начеку. И повсюду скверные семена, даже там, где мы воздвигли для нары Варуны... У-у-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150319
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150319,
					"content": "#Нара {NICKNAME} - {M#большой}{F#большая} нара, {M#высокий}{F#высокая} нара. Наверное, даже не слабее Арабалики... Вдруг нара {NICKNAME} сможет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150320
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150320,
					"content": "#... Вдруг нара {NICKNAME} сможет помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150321
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150321,
					"content": "#Так мы и пришли помочь, правда же, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150322,
					"content": "Мы займёмся этим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150323
					]
				},
				{
					"id": 730150323,
					"content": "У Аранакулы есть другая просьба. Прежде чем исцелять машину Варуны, я хочу отыскать каменные воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150324
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150324,
					"content": "«Каменные воспоминания»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150325
					]
				},
				{
					"id": 730150325,
					"content": "Вана ничего не забывает, аранары ничего не забывают, но аранары умеют оставлять видимую память. С тех пор как сюда пришли негодяи, вместо видимой памяти остались одни лишь скверные семена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150326
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150326,
					"content": "Разговаривать с аранарами как загадки разгадывать... Наверное, когда мы придём на место, всё станет понятнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150327,
					"content": "В общем, Аранакула, веди нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150328
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150328,
					"content": "#{M#Хороший}{F#Хорошая} нара, хорошая Паймон! Есть безопасная тропа, чтобы негодяи нас не заметили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150329
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150329,
					"content": "А? «Негодяи»? Это, наверное, плесенники? Тебе не о чем беспокоиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150330
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150330,
					"content": "#Хе-хе, Аранакула! Паймон ведь не зря говорила: {NICKNAME} - {M#сильный}{F#сильная} нара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150331
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150331,
					"content": "#И не просто {M#сильный}{F#сильная}! А ОЧЕНЬ {M#сильный}{F#сильная}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150332
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150332,
					"content": "Вместе с Арапанду мы одолели столько плесенников! Так что даже Арапанду признал нашу силу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150333
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150333,
					"content": "#Значит, нара {NICKNAME} {M#такой же сильный}{F#такая же сильная}, как Арабалика. А Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150334
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150334,
					"content": "Паймон? А что Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150335
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150335,
					"content": "Послушай, как было дело... Аранакула убегал от негодяя, зарылся под землю, но его откопали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150336
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150336,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150337
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150337,
					"content": "Из пастей у негодяев капает горячее, там пахнет гнилыми фруктами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150338
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150338,
					"content": "О-о...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150339
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150339,
					"content": "Если бы Арабалика не пришёл на помощь, Аранакула...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150340
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150340,
					"content": "Хнык-хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150341
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150341,
					"content": "Потом Арапанду долго говорил наставления, солнце зашло и снова поднялось. Даже семена в питомнике успели прорасти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150342
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150342,
					"content": "...Слишком долго!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150343
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150343,
					"content": "Но при чём здесь Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150344
					]
				},
				{
					"id": 730150344,
					"content": "Да, да! При чём здесь Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150345
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150345,
					"content": "Аранакула сильнее Паймон, и то чуть не угодил в пасть к негодяю. А Паймон такая кроха... Опасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150346
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150346,
					"content": "#Вроде дело говоришь... Эй, нет! {NICKNAME} {M#сильный}{F#сильная}, он{F#а} защитит Паймон! Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150347,
						730150349
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150347,
					"content": "Ну конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150348
					]
				},
				{
					"id": 730150348,
					"content": "#Хи-хи, ведь {NICKNAME} и Паймон - лучшие друзья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150351,
					"content": "#Но негодяев так много, и Аранакула против них бессилен... Ох... {M#Золотой}{F#Золотая} нара очень {M#силён}{F#сильна}, но всё равно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150352
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150352,
					"content": "Аранакула знает безопасную тропу. Пойдём по ней?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150353
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150353,
					"content": "А?.. Может... Может, всё дело в том, что Аранакула сам до ужаса боится плесенников?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150354
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150354,
					"content": "Хнык-хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150355
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150355,
					"content": "Хи-хи, вот оно что! А сам прикрывался заботой о Паймон. Нехорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150356
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150356,
					"content": "#Раз так, {NICKNAME}, пусть Аранакула ведёт нас безопасной тропой, только будь {M#осторожен}{F#осторожна}, чтобы плесенники нас не заметили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150357
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150357,
					"content": "Это я умею.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150358
					]
				},
				{
					"id": 730150358,
					"content": "Ага, привычное дело для нас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150359
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150359,
					"content": "Хорошо! Аранакула поведёт нару безопасной тропой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730150349,
					"content": "Паймон может удрать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150350
					]
				},
				{
					"id": 730150350,
					"content": "#Нет уж, {NICKNAME}, Паймон тебя не бросит! Наверное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730150314,
					"content": "Крошечная Паймон наделена огромной силой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150315
					]
				},
				{
					"id": 730150315,
					"content": "Да! Паймон ещё всем покажет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7301509,
			"completionStepIds": [
				7301509
			],
			"beginWay": "TALK_BEGIN_AUTO",
