					"Паймон",
					"Аранакула"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730151601,
					"content": "Аранакула, а вот и мы! Но дальше твоя очередь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730151602,
					"content": "#Спасибо, Паймон, спасибо, нара {NICKNAME}! Аранакула знает, что делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151603
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730151603,
					"content": "О! Кажется, и здесь теперь всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730151604,
					"content": "Надеюсь, лес скоро станет таким, как прежде.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151605
					]
				},
				{
					"id": 730151605,
					"content": "Обязательно, как только исцелится машина Варуны. Но Марана... должна быть устранена во имя ваны и сарвы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151606
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730151606,
					"content": "Как стела, созданная для нары Варуны, была покрыта скверными семенами, так и Зал Ашваттхи страдает из-за Мараны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151607
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730151607,
					"content": "#Это был питомник, созданный нарами и аранарами задолго до того, как нара Варуна {M#прибыла}{F#прибыл} в Ванарану. Но сейчас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151608
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730151608,
					"content": "Только дети деревни Вимара способны увидеть аранар, а для взрослых вы существа из сказок... И питомник пришёл в запустение из-за Мараны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730151609,
					"content": "Аранакула хочет посадить в питомнике много цветов. Нары забыли аранар, но это не беда, ведь нары увидят цветы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151610
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730151610,
					"content": "Аранакула...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730151611,
					"content": "#Нара {NICKNAME}, Паймон, спасибо! Аранакула вас не забудет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151612
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730151612,
					"content": "Теперь Аранакуле пора в Уголок отдыха. Арапанду очень обрадуется, когда узнает, что стела очищена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151613
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730151613,
					"content": "#Нара {NICKNAME} и Паймон, хотите отправиться в Уголок отдыха вместе с Аранакулой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151614,
						730151616
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730151614,
					"content": "Давай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151615
					]
				},
				{
					"id": 730151615,
					"content": "#С {M#золотым}{F#золотой} нарой дорога куда безопаснее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730151616,
					"content": "Нас ещё ждут другие дела.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151617
					]
				},
				{
					"id": 730151617,
					"content": "#{NICKNAME} и Паймон, да хранит вас Арамухукунда, будьте осторожны, чтобы не угодить в пасти к негодяям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранакула"
				}
			]
		},
