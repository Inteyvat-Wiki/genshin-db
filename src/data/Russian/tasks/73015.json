				"points": []
			},
			"dialogs": [
				{
					"id": 730151301,
					"content": "Вот они где! Если бы не Аранакула, мы бы их ни за что не отыскали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730151302,
					"content": "Но здесь нет листьев? Паймон не видит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730151303,
					"content": "Листья... Они рядом с деревом, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151304
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730151304,
					"content": "Гм... Плесенники сюда не доберутся, пусть Аранакула ждёт нас в безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730151305,
					"content": "Арапанду говорил, что нужно повернуть три каменных листа в сторону ветви, так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730151306,
					"content": "#Нара {NICKNAME} и Паймон, спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранакула"
				}
			]
		},
