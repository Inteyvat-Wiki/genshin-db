			},
			"dialogs": [
				{
					"id": 4260101,
					"content": "Надо немного отдохнуть. Что ты собираешься делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260102,
					"content": "Хочу выполнить задание.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260103
					]
				},
				{
					"id": 4260103,
					"content": "Это просто! Нажми на восклицательный знак в верхнем левом углу экрана, и ты увидишь, какие у тебя есть задания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260104,
					"content": "Некоторые задания очень сложные. Чтобы их выполнить, тебе нужно достигнуть определённого уровня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260117,
					"content": "Хочешь узнать что-нибудь ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260105,
					"content": "Хочу посмотреть, что находится вокруг.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260106
					]
				},
				{
					"id": 4260106,
					"content": "Некоторые районы более опасны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260107,
					"content": "Для начала стоит исследовать более спокойные районы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260108,
					"content": "Элфри из Гильдии искателей приключений знает Тейват как свои пять пальцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260109,
					"content": "Она живёт в центре Мондштадта, недалеко от ворот. Можешь спросить у неё, какие районы для тебя подходят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260110,
					"content": "Я хочу стать сильнее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260111
					]
				},
				{
					"id": 4260111,
					"content": "Чтобы стать сильнее, тебе понадобятся редкие артефакты и мощное оружие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260112,
					"content": "Всё это можно найти в подземельях, но там может быть очень опасно! Скорее всего, тебя побьют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260113,
					"content": "Если боишься рисковать, то можешь обратиться к купцам в Мондштадте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260114,
					"content": "Не забывай, что оружие и артефакты можно улучшать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260115,
					"content": "#Я думаю, ты сам{F#a} разберёшься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260116,
					"content": "Ах, да! Не забывай про уровень персонажа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4260118,
					"content": "Нет, спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260119
					]
				},
				{
					"id": 4260119,
					"content": "Ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
