			"dialogs": [
				{
					"id": 210330401,
					"content": "#Ну как, путешественни{F#ца}{M#к}? Наш{F#ла}{M#ёл} что-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330402
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210330402,
					"content": "#Я наш{F#ла}{M#ёл} вот эту рукоять...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 2103306,
			"completionStepIds": [
				2103306
