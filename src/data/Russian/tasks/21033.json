					"Мисс Лань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210330101,
					"content": "Не знаю... Поможет ли это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210330102,
					"content": "Ты всё ищешь свой меч?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "#Путешественни{F#ца}{M#к}, это ты? Да, я до сих пор ищу Скрытый клинок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210330104,
					"content": "Но у меня нет ни одной сколько-нибудь ценной подсказки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210330105,
					"content": "Вряд ли из этого что-то получится. Искать меч в Ли Юэ - всё равно что искать иголку в стогу сена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210330106,
					"content": "Говорят, мой меч давно уничтожили монстры... Но даже если от него остались одни осколки, я хочу отыскать их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210330107,
					"content": "#Извини, я только и говорю, что о своём мече. Я отметила на карте место, которое нужно проверить. Благодарю тебя за помощь, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210330108,
					"content": "Надеюсь, что он всё-таки цел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				}
			]
		},
