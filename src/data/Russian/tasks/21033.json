					"Мисс Лань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210330403,
					"content": "Рукоять... Надо же, почти целая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330404
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210330404,
					"content": "Это рукоять Скрытого клинка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330405
					]
				},
				{
					"id": 210330405,
					"content": "Чтобы сказать наверняка, нужно внимательно её изучить... Да, забыла тебе рассказать: некоторое время назад я развернула поиски фрагментов этого оружия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330406
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210330406,
					"content": "Я собрала уже немало фрагментов, часть купила на рынке, часть нашла в полях, кое-чем со мной поделились искатели приключений. Я надеялась, что эти поиски приведут меня к Скрытому клинку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330407
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210330407,
					"content": "Но мне до сих пор так и не удаётся напасть на его след...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330408
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210330408,
					"content": "Ничего. В Ли Юэ есть поговорка: «Будет воля - будет и успех». Я не брошу поисков... пока не отыщу свой Скрытый клинок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330409
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210330409,
					"content": "#Вот твоя награда. Спасибо за помощь, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				}
			]
		}
	]
