			"dialogs": [
				{
					"id": 760520501,
					"content": "Буль-буль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520502
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520502,
					"content": "Выпила залпом! Похоже, ей понравилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520503,
					"content": "Хм... совершенно безвкусный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520504
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520504,
					"content": "Б-безвкусный?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520505,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520506,
						760520507
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520506,
					"content": "Может, это потому, что ты слишком быстро пила?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				},
				{
					"id": 760520508,
					"content": "О... Не надо, спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520509
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520509,
					"content": "Было время, когда я не понимала, почему люди испытывают такую радость во время сбора урожая. Но однажды я протянула руку, чтобы дотронуться до спелого плода, висящего на ветке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520510
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520510,
					"content": "Я почувствовал жизненную силу в самой текстуре его кожицы - органическом воплощении солнечного света, воды, земли и воздуха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520511
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520511,
					"content": "С каждым укусом я чувствовала, как освежающая сладость волнами проникает в меня, подобно прохладной белой пене.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520512
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520512,
					"content": "И так я поняла неотразимую силу аромата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520513,
					"content": "Очень интересно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520514,
					"content": "Мы завершаем цикл природы, принимая эту жизненную силу в себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520515
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520515,
					"content": "Э-э, вдруг стало мрачновато...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520516
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520516,
					"content": "Вот почему я предпочитаю свежие фрукты. Они позволяют мне увидеть то, что я взяла из этого мира, в точности таким, каким оно было до того, как я его взяла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520517
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520517,
					"content": "И напоминают мне о том, чем я обязана этому миру взамен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520507,
					"content": "Ещё стаканчик?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				}
			]
		},
