				]
			},
			"dialogs": [
				{
					"id": 760520101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520102,
					"content": "Коломбина, ты в порядке? Ты как будто не в себе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520103,
					"content": "О, это вы. Я в порядке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520104,
					"content": "(Она опять думает о Луне?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "Мы можем чем-нибудь помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520108,
					"content": "Поделись с нами! Даже если это что-то незначительное, тебе станет гораздо легче, когда выговоришься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520109,
					"content": "Я... хочу попробовать напиток из таверны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520110,
					"content": "...Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520111,
					"content": "...Ох.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520112,
					"content": "Извини... Паймон немного удивилась. Ты никогда не говоришь о том, что хочешь для себя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520113,
					"content": "И это всё? Просто... выпить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520114,
					"content": "Ты ожидала, что она подумает о чём-то большем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "Ну да. По крайней мере, о чём-то более значительном... Например, «принеси мне Луну».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520116,
					"content": "Но, если подумать, это вполне логично. Коломбина не может свободно передвигаться, а значит, пойти в таверну для неё сродни путешествия на Луну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520117,
					"content": "Дело не только в том, как обстоят дела сейчас. Даже когда я была с Фатуи, когда не было приказа схватить меня... все держались на расстоянии, когда я выходила на прогулку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520118,
					"content": "(Третий из Предвестников Фатуи... Одного этого достаточно, чтобы отпугнуть людей, которые её не знают.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "Если подумать... Может, всё не так сложно, как Паймон сперва показалось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520120,
					"content": "#Таверна, конечно, не вариант, но выпить... Это мы можем! {NICKNAME} всё уладит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520121,
					"content": "...Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520122,
					"content": "Но не жди слишком многого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520123,
					"content": "Есть какие-то предпочтения по вкусу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "Вкус...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520125,
					"content": "Я плохо разбираюсь в напитках, так что не знаю, с чего начать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520126,
					"content": "Может, что-нибудь не слишком... тяжёлое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520127,
					"content": "Хм, что ты имеешь в виду под «тяжёлым»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520128,
					"content": "Тяжёлый, как... шинель Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520129,
					"content": "Это сравнение ещё больше сбивает с толку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520130,
					"content": "Может, что-нибудь лёгкое и нежное.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "Хорошо. Я на тебя рассчитываю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520131,
					"content": "Предоставь выбор мне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
		{
			"id": 7605202,
