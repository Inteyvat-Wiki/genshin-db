			"dialogs": [
				{
					"id": 752500101,
					"content": "Гости, купившие игрушки, один за другим уходят... И тут в Парк альпак заявляются несколько незваных посетителей...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500102
					]
				},
				{
					"id": 752500102,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500103
					]
				},
				{
					"id": 752500103,
					"content": "Это вы... Фатуи, что ограбили меня вчера?! Вы... вы ещё что задумали?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500104
					],
					"speakerTitle": "Алоха"
				},
				{
					"id": 752500104,
					"content": "Не беспокойся, я разберусь с этим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752500105
					]
				},
				{
					"id": 752500105,
					"content": "Нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500106
					]
				},
				{
					"id": 752500106,
					"content": "Предводитель Фатуи махнул рукой и протянул вам смятую записку. Вы разворачиваете её. На листе бумаги коряво выведены несколько строк.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500107
					]
				},
				{
					"id": 752500112,
					"content": "Так вот оно что... Выходит, вчера они на самом деле хотели заплатить?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500113
					],
					"speakerTitle": "Алоха"
				},
				{
					"id": 752500113,
					"content": "П-простите... Я совсем вас неправильно понял... Прошу прощения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500114
					],
					"speakerTitle": "Алоха"
				},
				{
					"id": 752500114,
					"content": "Вот, забирайте все игрушки в знак благодарности вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500115
					],
					"speakerTitle": "Алоха"
				},
				{
					"id": 752500115,
					"content": "Предводитель Фатуи покачал головой и жестом показал число три.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500116
					]
				},
				{
					"id": 752500116,
					"content": "Понятно... Вы такие же достойные воины, как и герои Натлана! Настоящие образцы доблести!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500117
					],
					"speakerTitle": "Алоха"
				},
				{
					"id": 752500117,
					"content": "Тогда подберу для вас три игрушки по цвету. Такие, которые вам больше всего подойдут. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Алоха"
				}
			]
		},
