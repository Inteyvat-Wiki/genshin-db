			"dialogs": [
				{
					"id": 752420401,
					"content": "Добро пожаловать на курорт «Оазис отдыха»! Я помогу вам зарегистрироваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420402
					],
					"speakerTitle": "Укуча"
				},
				{
					"id": 752420402,
					"content": "Возьмите карту нашего курорта и специальный альбом, который мы приготовили для гостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420403
					],
					"speakerTitle": "Укуча"
				},
				{
					"id": 752420403,
					"content": "Курорт «Оазис отдыха» состоит из четырёх зон: Пёстрые скалы, гряда Гуицтли, залив Прибоя и остров Тете. Можете отправиться куда пожелаете. Приятного отдыха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420404
					],
					"speakerTitle": "Укуча"
				},
				{
					"id": 752420404,
					"content": "Итак, можете пройти туда, чтобы заселиться. А если захотите сделать покупки, добро пожаловать на Беззаботную ярмарку. Это самая оживлённая зона нашего курорта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Укуча"
				}
