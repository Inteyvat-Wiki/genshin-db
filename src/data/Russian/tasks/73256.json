				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732561001,
					"content": "Энергетические ядра заряжены. Теперь мы сможем активировать системы управления...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561002
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732561002,
					"content": "А? Это не то, чего я ожидал. Что могло пойти не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561003
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732561003,
					"content": "Похоже, надо проверить центр управления, где находятся реле. Он расположен на пути к полигону.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561004
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732561004,
					"content": "Я понял! Центр управления находится в том месте, откуда вы пришли. В таком случае предлагаю пойти вместе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наседжуна"
				}
			]
		},
		{
			"id": 7325612,
			"completionStepIds": [
				7325612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
