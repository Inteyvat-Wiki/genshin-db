					}
				]
			},
			"dialogs": [
				{
					"id": 732562001,
					"content": "Эта странная пушка поднялась из земли! Это означает, что мы должны выстрелить вон в того большого робота?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732562002,
					"content": "Хм... Очень продуманная конструкция.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732562003,
					"content": "Твоё воображение не знает границ, Белая Болталка. Назорей ведь сказал, что это место сильно изменилось и что раньше здесь был полигон для испытания механизмов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562004
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732562004,
					"content": "Похоже, устройство, которое мы разблокировали ранее, использовалось для активации этого полигона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562005
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732562005,
					"content": "Похоже, изменения не включали в себя демонтаж прежних устройств. Очень ценное открытие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562006
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732562006,
					"content": "#В таком случае, {F#моя}{M#мой} яснапати, честь управлять этой пушкой принадлежит тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Соруш"
				}
			]
		},
		{
			"id": 7325623,
			"completionStepIds": [
				7325623
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325623",
							"2"
						],
						"stepId": 7325623,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Наседжуна",
					"Соруш"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562301,
					"content": "#Великая посланница и её {F#досточтимая}{M#досточтимый} яснапати, боюсь, что более я не могу вас сопровождать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562302
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732562302,
					"content": "Что на этот раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732562303
					]
				},
				{
					"id": 732562303,
					"content": "Согласно текстам, дорога впереди полна опасностей, которые не по силам простому смертному.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562304
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732562304,
					"content": "Там находится полигон дахрийцев, который они когда-то использовали для испытания своих творений. Среди них даже найдётся незавершённый прототип гигантского механизма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562305
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732562305,
					"content": "В копиях дахрийских записей говорится, что это место когда-то было переделано в опорный пункт, с которого можно было атаковать монстров, хотя в этом отношении оно не получило должного развития.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562306
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732562306,
					"content": "Странно, не правда ли? Зачем дахрийцам, спровоцировавшим бедствие, создавать машины для борьбы с монстрами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562307
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732562307,
					"content": "Итак, мы активировали системы управления руинами, значит, защитные механизмы на полигоне тоже включились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562308
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732562308,
					"content": "Великая песнь, которую мы ищем, должна быть внутри этого голема. Я пребываю в замешательстве, но полагаю, что вам не составит труда достать её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562309
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732562309,
					"content": "Позвольте мне дождаться вашего возвращения здесь, дабы мы могли обрести все великие песни Хварны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562310
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732562310,
					"content": "Ты ведь всего лишь человек. Твоя просьба вполне ожидаема.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562311
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732562311,
					"content": "С вашего милостивого позволения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562312
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732562312,
					"content": "Наседжуна снова струсил в решающую минуту. Это даже к лучшему, Паймон не придётся терпеть вас обоих.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
