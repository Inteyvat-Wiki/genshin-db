					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Наседжуна",
					"Соруш",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560401,
					"content": "Настал судьбоносный момент!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560402
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732560402,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560403
					]
				},
				{
					"id": 732560403,
					"content": "Это просто механическая дверь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732560404,
					"content": "Кхе, я хочу сказать, что как только мы откроем эту механическую дверь, мы сможем войти в руины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560405
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732560405,
					"content": "Нет ничего удивительного в том, что я взволнован, ведь я впервые вхожу в руины дахрийцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560406
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732560406,
					"content": "А? Ты говорил так уверенно, что Паймон подумала, что ты наверняка исследовал множество руин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732560407,
					"content": "Ха! Я не могу утверждать, что лично исследовал их, но благодаря этим «Исследовательским записям Рене», написанным великим учёным древности, я будто сам побывал там!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560408
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732560408,
					"content": "«Исследовательские записи Рене»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560409
					]
				},
				{
					"id": 732560409,
					"content": "Вы не слышали о них? Мне казалось, что только такой человек, как я, живущий глубоко в пустыне, мог не слышать о столь выдающемся учёном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560410
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732560410,
					"content": "В этих записках содержится множество сведений, оставленных дахрийцами. По словам автора, однажды он обнаружил в этих руинах знания, «превосходящие представления смертных».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560411
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732560411,
					"content": "Звучит как-то неправдоподобно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732560412,
					"content": "Как бы то ни было, у нас есть эти записи, а это значит, что мы сможем без труда войти в дахрийские руины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560413
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732560413,
					"content": "Если вы мне не верите, давайте проведём эксперимент! Например, чтобы разблокировать это устройство... Нашёл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560414
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732560414,
					"content": "<color=#00E1FFFF>«Поверните шестерни так, чтобы появились три типа рун. Не меняя треугольник в основании, убедитесь, что он соединён с квадратом».</color> Сделайте всё в соответствии с моими инструкциями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наседжуна"
				}
			]
		},
