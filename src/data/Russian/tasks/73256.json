			},
			"dialogs": [
				{
					"id": 732562701,
					"content": "Всё в точности так, как написано в записях... Хм? Вы уже вернулись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562702
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732562702,
					"content": "Судя по вашему виду, я могу предположить, что вы нашли энергетический блок, который нам так нужен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562703
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732562703,
					"content": "Я исследовал эти энергетические ядра... Они очень хорошо сохранились. Нужно просто установить в них энергетический блок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562704
					],
					"speakerTitle": "Наседжуна"
				},
				{
					"id": 732562704,
					"content": "Я рассчитываю на вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наседжуна"
				}
			]
		},
