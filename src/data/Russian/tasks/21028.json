			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Малыш Мэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "#Ты вовремя, {NICKNAME}! Мне нужна помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "Папа сказал, что путь до Сумеру долгий и нужно запастись лекарствами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280106,
					"content": "От головной боли, диареи, теплового удара... похмелья, несварения желудка... и ещё много чего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280107,
					"content": "А зачем им лекарство от похмелья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210280108,
					"content": "Наверное, на случай важных переговоров.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "А? Какая связь между деловыми разговорами и лекарствами от похмелья? Будет ли бизнес процветать, если вы слишком много пьёте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210280110,
					"content": "В общем папа отправил меня в хижину «Бубу» спросить, готовы ли лекарства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280111,
					"content": "#{NICKNAME}, можешь сходить со мной? Я хочу, чтобы ты мне кое с чем помог{F#ла}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280112,
					"content": "Пойдём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "#Пойдём, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280113,
					"content": "Чем я могу тебе помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "Поговорим, когда придём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280103,
					"content": "Как ты готовишься к поездке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "Основной подготовкой занимались папа и те дяди... но папа и мне дал парочку заданий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "Малыш Мэн"
				}
			]
		},
		{
