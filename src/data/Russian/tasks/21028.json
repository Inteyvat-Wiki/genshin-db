			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Травник Гуй",
					"Малыш Мэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "Привет! Нужны лекарства?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280202,
					"content": "О, малыш Мэн? Ты по какому поводу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280203,
					"content": "А, ты, наверное, хочешь о лекарствах спросить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280204,
					"content": "Не переживай. Как только приготовлю лекарства, отправлю их твоему отцу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280205,
					"content": "Но твой отец попросил очень много лекарств. Некоторые почти закончились. Возможно, изготовлю их не так быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280206,
					"content": "Дай-ка посмотреть... Мяты осталось маловато, так что не смогу сделать лекарство от солнечного удара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280207,
					"content": "Мы изготавливаем лекарства не только для твоего отца, но и для других покупателей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280208,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280209,
					"content": "Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "#Ах, спасибо, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280213,
					"content": "Тогда, пожалуйста, поищи ингредиенты. Я останусь и тщательно проверю лекарства, как мне папа сказал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280214,
					"content": "Какой серьёзный парнишка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280215,
					"content": "Тогда пойдём со мной. Я покажу тебе список.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280216,
					"content": "Ого... Многовато...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280217,
					"content": "Вот это изучи, сейчас принесу ещё партию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280218,
					"content": "А? Ещё?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280211,
					"content": "Но не забудь мне заплатить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "#Хорошо! Спасибо, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Малыш Мэн"
				}
			]
		},
