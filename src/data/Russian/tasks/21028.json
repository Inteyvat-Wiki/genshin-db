			"dialogs": [
				{
					"id": 210280401,
					"content": "#Спасибо, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280402
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280402,
					"content": "Этого должно хватить для приготовления лекарства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280403,
					"content": "Лекарство от теплового удара отправлю со следующей партией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280404,
					"content": "Спасибо, травник Гуй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280405,
					"content": "#Вот, это тебе. Спасибо за помощь, {NICKNAME}! Пойдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280406,
					"content": "Когда папа узнает, будет очень рад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280407,
					"content": "Малыш Мэн, подожди немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280408,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280409,
					"content": "Проверишь лекарства? Следующий список ты ещё не смотрел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280410,
					"content": "Как? Я ведь уже так долго проверял...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210280411,
					"content": "Да, вот это проверил, но нужно проверить ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 210280412,
					"content": "Хо-хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Мэн"
				}
			]
