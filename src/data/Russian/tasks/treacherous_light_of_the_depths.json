							3834.281
						],
						"pointId": 5247
					},
					{
						"sceneId": 3,
						"position": [
							4411.186,
							372.68,
							3835.364
						],
						"pointId": 6385
					},
					{
						"sceneId": 3,
						"position": [
							4411.186,
							372.68,
							3834.401
						],
						"pointId": 6386
					}
				]
			},
			"dialogs": [
				{
					"id": 740811701,
					"content": "Э... у-у нас ведь никаких неприятностей не возникнет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740811702,
					"content": "Странно. Мне кажется, я почувствовала какое-то колыхание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811703,
						740811704
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811703,
					"content": "Я тоже чувствую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				},
				{
					"id": 740811705,
					"content": "Может быть, это потому, что мы только что привели в движение устройство на верхнем уровне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740811706,
					"content": "Эта дверь ведь была заперта, верно? Все эти меки размещены здесь специально для её защиты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811707,
						740811708
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811707,
					"content": "#Я попросил{F#а} меков немного отдохнуть и открыл{F#а} дверь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811709,
					"content": "Ничего уже не поделать. Они ведь первыми на нас напали. Мы просто защищались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740811710,
					"content": "Прототипы наставника Майарде... должны быть в режиме ожидания. С тех пор как он отыскал хорошее место на острове Эриний, он почти никогда не возвращался сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811711
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811711,
					"content": "Сами посудите. Кому захочется возвращаться в эту мрачную и полуразрушенную лабораторию, если можно представлять результаты своих исследований публике в таком прекрасном месте, как танцплощадка в саду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811712
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811712,
					"content": "Как только господин Боссюэ ушёл в отставку, все разбрелись по Исследовательскому институту, здесь всё пришло в запустение, материалы в беспорядке. Даже ни одного дивана не осталось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811713
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811713,
					"content": "Не ушли лишь прототипы. Так и стоят они здесь, ожидая тех, кто больше никогда не вернётся. Застыли в режиме ожидания. Для них так даже лучше, хотя самим им разницы никакой нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811714
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811714,
					"content": "Смотрите, до какого ужасного состояния вы их довели. Пружины вот-вот выскочат. Если об этом узнает Майарде...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811715,
						740811716
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811715,
					"content": "Это всё моя вина. Прости.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811718
					]
				},
				{
					"id": 740811718,
					"content": "Нам очень жаль... А эти прототипы дорогие? Если нужно компенсировать ущерб...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811719
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740811719,
					"content": "Не переживайте. Если бы наставник Майарде узнал об этом, он бы точно расхохотался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811720
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811720,
					"content": "Раньше он ведь и сам любил мешать танцам прототипов, а потом смеяться, когда его сбивали с ног.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811721
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811721,
					"content": "Кстати, я ведь до сих пор вам не представилась. Я научная сотрудница Исследовательского института Фонтейна. Можете звать меня Севинье. А как зовут вас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811722
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811722,
					"content": "#Паймон зовут Паймон, а это {NICKNAME}. Мы... э...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811723,
						740811725
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740811723,
					"content": "Просто мимо проходили, вот и забрели сюда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811724
					]
				},
				{
					"id": 740811724,
					"content": "Да! Мы просто гуляли! И вовсе не думали о том, что здесь могут быть какие-то сокровища...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811726
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740811726,
					"content": "О, вы имеете в виду, будут ли организованы поиски сокровищ во время экскурсии по руинам? Нет, вы не там ищете. Это место, конечно, похоже на руины... точнее, это и есть руины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811727
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811727,
					"content": "Однако оно не вошло в рекомендуемые места для проведения туров по руинам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811728
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811728,
					"content": "Ладно, тогда мы пойдём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811729
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740811729,
					"content": "Подождите... вы же знаете про Исследовательский институт? Не могли бы вы сделать мне одолжение? Сходите в Исследовательский институт и отыщите Киссери...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811730,
						740811731
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811730,
					"content": "Но нам ведь вообще в другую сторону.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811732,
					"content": "Что же мне тогда делать? У меня ещё столько работы, а тут ещё и прототипы наставника Майарде сломались. Нужно, чтобы кто-нибудь поскорее их отсюда забрал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811733
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811733,
					"content": "#Хм-м... {NICKNAME}, может, всё-таки поможем ей?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811734
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740811734,
					"content": "Отлично! Раз уж вы согласились передать моё сообщение, вернуть перфоленты я тоже поручаю вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811735,
						740811736
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811735,
					"content": "И зачем только нам вздумалось эти прототипы трогать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811746
					]
				},
				{
					"id": 740811746,
					"content": "Не говори так, это ведь не сложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811737
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811737,
					"content": "А за помощь в возвращении исследовательских материалов вы можете претендовать на награду от Института.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811738
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811738,
					"content": "А? Так разве можно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811739
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740811739,
					"content": "Вы ведь содействуете исследовательской работе. Если правильно подать им эту информацию, проблем с получением вознаграждения возникнуть не должно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811740
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811740,
					"content": "Если же информация не будет соответствовать действительности, служащий отклонит ваше прошение. В этом случае расходы на ваше вознаграждение мне придётся взять на себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811741
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811741,
					"content": "И часто вы такое проворачиваете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811742
					]
				},
				{
					"id": 740811742,
					"content": "Лично я - нет. Про остальных я не знаю. До меня доходили слухи, но... ой, об этом посторонним лучше не рассказывать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811743
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811743,
					"content": "Нужно вернуть три перфоленты. Они на книжных полках лежат. Найти их легко будет. Не думаю, что это станет для вас большой проблемой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811744
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811744,
					"content": "Я же пока ещё раз проверю все прототипы. За ними давным-давно не ухаживали... Нехорошо получится, если они выйдут из-под контроля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811745
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811745,
					"content": "Ладно. Как найдём все перфоленты, вернёмся к тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740811736,
					"content": "Без проблем, мы всё сделаем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811737
					]
				},
				{
					"id": 740811731,
					"content": "Нас ждут другие сокровища.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811725,
					"content": "К слову, а сокровища тут какие-нибудь есть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811726
					]
				},
				{
					"id": 740811716,
					"content": "А вы не задумывались о том, чтобы повысить их прочность?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811717
					]
				},
				{
					"id": 740811717,
					"content": "Именно так и поступит Майарде. Возможно, конечный продукт сумеет оправдать ваши ожидания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811718
					],
					"speakerTitle": "Севинье"
				},
				{
					"id": 740811708,
					"content": "Да, странно. Почему же она открылась...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811704,
					"content": "Тебе точно не показалось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				}
			]
		},
