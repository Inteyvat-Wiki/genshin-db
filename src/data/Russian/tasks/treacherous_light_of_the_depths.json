			"dialogs": [
				{
					"id": 740813101,
					"content": "Приветствую! Расскажи о Севинье...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740813102,
					"content": "Вы рассказываете обо всём Киссери и отдаёте ей три перфоленты...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740813103
					]
				},
				{
					"id": 740813103,
					"content": "Я ведь переживать за неё начала. Уже хотела сходить её проведать, а оно вон как. Спасибо, что передали её сообщение... и перфоленты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813104
					],
					"speakerTitle": "Киссери"
				},
				{
					"id": 740813104,
					"content": "Не думала, что прототипы Майарде всё работают. А Севинье ведь совсем одна осталась работать в такой опасной обстановке. Нужно срочно пойти к служащему и обсудить вопрос о перемещении прототипов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813105
					],
					"speakerTitle": "Киссери"
				},
				{
					"id": 740813105,
					"content": "Спрошу про вознаграждение для вас... а ещё о том, не утратила ли Севинье остатки своего разума... Вопрос о вознаграждении будет зависеть от решения служащего, поэтому я лучше заплачу вам из своего кармана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813106
					],
					"speakerTitle": "Киссери"
				},
				{
					"id": 740813106,
					"content": "Спасибо за вашу помощь. Пожалуйста, возьмите эту награду за труды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Киссери"
