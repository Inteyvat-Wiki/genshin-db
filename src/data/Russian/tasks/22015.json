				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Санго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150701,
					"content": "Мне довелось лишь встретить одного юридического консультанта...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150702
					]
				},
				{
					"id": 220150702,
					"content": "Юридического консультанта? Ах... Слышала, что... взаимодействовать с ними достаточно сложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150703
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150703,
					"content": "Подозреваю, что истинный род занятий этих людей - усложнять простые проблемы. Они берутся за простое дело и делают его до невозможного запутанным, а затем превращают всё это в сбивающие с толку контракты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150704
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150704,
					"content": "Надеюсь, что мне не суждено повстречаться с одним из них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				}
			]
		},
		{
			"id": 2201508,
			"completionStepIds": [
				2201501
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201501",
							"2"
						],
						"stepId": 2201501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Санго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150801,
					"content": "Я смотрю, тебя заинтересовало моё детективное агентство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150802,
						220150807
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150802,
					"content": "А я могу стать детективом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150803
					]
				},
				{
					"id": 220150803,
					"content": "Ты хочешь быть детективом? Это тяжелая работа, не стоит принимать то, что описывается в художественной литературе за действительность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150804
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150804,
					"content": "На настоящих расследованиях не встретишь захватывающих погонь и решений вопросов жизни и смерти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150805
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150805,
					"content": "Настоящая детективная работа - это папки, заполняющие целую комнату, грязные горные дороги и подозреваемые, которые практически не оставляют никаких следов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150806
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150806,
					"content": "Может быть, это трудно понять из моего описания.. Так случилось, что у меня как раз открыто небольшое дело. Почему бы тебе не обзавестись чуточкой твоего собственного опыта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150815,
					"content": "Мой помощник, Рюдзи, некоторое время назад отправился на поиски улик и до сих пор не вернулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150816
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150816,
					"content": "К этому времени он уже должен был собрать достаточно улик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150817
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150817,
					"content": "#Не мог{F#ла} бы ты сходить за ним?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150818,
						220150821
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150818,
					"content": "Ему ведь ничего не угрожает?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150819
					]
				},
				{
					"id": 220150819,
					"content": "Я заранее всё с ним обсудила. Даже если случится что-то непредвиденное, он должен быть в состоянии справиться с этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150820
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150820,
					"content": "Меня больше интересует, нашёл ли он то, за чем я его посылала или нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150826,
					"content": "Так что я буду ждать от тебя новостей, и, конечно, хорошо тебе за них заплачу. К тому же... для тебя это хороший шанс на собственном опыте испробовать жизнь детектива.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150821,
					"content": "Ведь с ним ничего не могло случиться?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150822
					]
				},
				{
					"id": 220150822,
					"content": "Маловероятно. Я полностью посвятила его в суть дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150823
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150823,
					"content": "Даже если произойдет что-то непредвиденное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150824
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150824,
					"content": "С его-то навыками он должен быть в состоянии без проблем позаботиться о себе сам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150825
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150825,
					"content": "Меня больше интересует, нашёл ли он то, за чем я его посылала или нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150807,
					"content": "Звучит не очень захватывающе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150808
					]
				},
				{
					"id": 220150808,
					"content": "Именно так. Детективы - профессиональные решатели проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150809
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150809,
					"content": "Оставим увлекательные погони и решения, принятые на лезвии ножа между жизнью и смертью, для художественных произведений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150810
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150810,
					"content": "Настоящая детективная работа - это папки, заполняющие целую комнату, грязные горные дороги и подозреваемые, которые практически не оставляют никаких следов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150811
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150811,
					"content": "Но в этих романах есть и доля истины: у детективов всегда есть множество помощников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150812
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150812,
					"content": "Значит у тебя тоже есть помощники?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150813
					]
				},
				{
					"id": 220150813,
					"content": "Конечно. Мой помощник сейчас как раз на задании. А теперь... мне требуется ещё один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150814
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150814,
					"content": "#Ты не был{F#а} бы против немного мне подсобить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Санго"
				}
			]
		},
