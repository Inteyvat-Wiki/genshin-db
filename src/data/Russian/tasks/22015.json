					"Санго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150901,
					"content": "Так что я буду ждать от тебя новостей, и, конечно, хорошо тебе за них заплачу. К тому же... для тебя это хороший шанс на собственном опыте испробовать жизнь детектива.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150902,
						220150905
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150902,
					"content": "Ты не волнуешься за него?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150903
					]
				},
				{
					"id": 220150903,
					"content": "Он очень умелый и стойкий, нет повода за него волноваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150904
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150904,
					"content": "Всё-таки он когда-то был досином.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150905,
					"content": "А почему ты не пошла вместе с ним?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150906
					]
				},
				{
					"id": 220150906,
					"content": "Ну, как бы это сказать... у нас у каждого своя роль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150907
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150907,
					"content": "Он отвечает за сбор доказательств и улик, а я - за их анализ с целью раскрытия правды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150908
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150908,
					"content": "Разумное разделение труда является основой для нормального функционирования агентства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				}
			]
		}
