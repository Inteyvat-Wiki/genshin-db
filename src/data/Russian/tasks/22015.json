						],
						"stepId": 2201501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Санго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150101,
					"content": "Давно пора...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150102
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150102,
					"content": "Ой, добро пожаловать. У тебя какие-нибудь неприятности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150103
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150103,
					"content": "Хм, понятно. У тебя нет никаких неприятностей... тебе просто захотелось немного побродить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150104
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150104,
					"content": "Что же, так или иначе, это - скромное детективное агентство Бантан Санго. А я детектив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150105,
						220150108
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150105,
					"content": "Как тебя зовут?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150106
					]
				},
				{
					"id": 220150106,
					"content": "Меня зовут Санго, и я глава этого детективного агентства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150107
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150107,
					"content": "То есть я, конечно, называю себе главой, но на деле в нашем агентстве всего два служащих.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150113,
					"content": "Получается, тебе раньше не доводилось бывать в детективном агентстве?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150108,
					"content": "А чем занимается детектив?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150109
					]
				},
				{
					"id": 220150109,
					"content": "Ух, хороший вопрос. С точки зрения широкой публики, работа детектива должна казаться довольно особенной и таинственной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150110
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150110,
					"content": "Но для меня она, как и любая другая работа, является средством заработка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150111
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150111,
					"content": "При этом сама работа иногда бывает немного необычной, а клиенты - очень интересными личностями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150112
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150112,
					"content": "Но по факту это - абсолютно такой же способ заработать себе на жизнь, как и многие другие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "Санго"
				}
			]
		},
		{
			"id": 2201502,
			"completionStepIds": [
				2201504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201504",
							"2"
						],
						"stepId": 2201504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150205,
					"content": "Ах, ты и есть тот ассистент, о котором говорила Санго?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150206
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150206,
					"content": "Ты меня ждал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150207
					]
				},
				{
					"id": 220150207,
					"content": "Ну... не совсем. Просто Санго сказала, что кое-кто придёт помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150208
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150208,
					"content": "Привет! Что делаете, ребята?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150209
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220150209,
					"content": "Это Похитители сокровищ? Почему они так близко к городу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150210
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220150210,
					"content": "#Рюдзи, почему ты здесь? А ещё и с эт{F#ой}{M#им} подозрительн{F#ой}{M#ым} чужезем{F#кой}{M#цем}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150211,
						220150213
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220150211,
					"content": "Это ты обо мне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150212
					]
				},
				{
					"id": 220150212,
					"content": "Да, кроме тебя тут как бы и нет других чужеземцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220150215,
					"content": "Ладно тебе, не обижайся. Рюдзи, что привело тебя сюда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150216
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220150216,
					"content": "Согласно указаниям Санго, я выслеживал здесь одного подозрительного человека, но потом наткнулся на Похитителей сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150217
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150217,
					"content": "#Путешественни{F#ца}{M#к} - приглашённ{F#ая}{M#ый} Санго помощни{F#ца}{M#к}. Мы только что прогнали Похитителей сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150218
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150218,
					"content": "Понятно... Но с чего бы здесь быть Похитителям сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150219
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220150219,
					"content": "Рюдзи, ты только что упомянул, что преследовал некоторых подозрительных личностей... Эй! Так ты начал слежку за Похитителями сокровищ, когда они были еще в городе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150220
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220150220,
					"content": "Думаю, да. В последнее время Санго расследует дело о серийном воровстве. Основываясь на её догадках, я для начала прочесал весь город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150221
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150221,
					"content": "Вскоре после этого, я заметил подозрительного мужчину около Ханамидзаки. Он в панике бросился бежать после всего лишь пары моих вопросов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150222
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150222,
					"content": "Я следил за ним до тех пор, пока он не покинул город, а все остальное произошло вскоре после этого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150223
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150223,
					"content": "Хм... Рюдзи, откуда у тебя неожиданно появился такой талант рассказчика? Что-то не помню, чтобы раньше ты особо отличался умением так хорошо изъясняться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150224
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220150224,
					"content": "Работая с Санго, невозможно не перенять у неё чуточку её искусства красноречия, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150225,
						220150228
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220150225,
					"content": "Что вы здесь делаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150226
					]
				},
				{
					"id": 220150226,
					"content": "#Андо сказал, что тут по городу расхаживает как{F#ая-то}{M#ой-то} подозрительн{F#ая}{M#ый} светловолос{F#ая}{M#ый} чужестран{F#ка}{M#ец}, вот мы и пришли посмотреть, в чем дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150227
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220150227,
					"content": "Вот почему мы тайно следовали за тобой, но оказывается, ты помогаешь Санго. Извини за это небольшое недопонимание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220150232,
					"content": "Ах... Рюдзи, ты сказал, что ты обнаружил некую подозрительную личность в городе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150233
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220150233,
					"content": "Именно так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150234
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150234,
					"content": "С чего у них вдруг хватило наглости протянуть свои лапы прямо к нашему городу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150235
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220150235,
					"content": "Да. Но когда есть только мы... кто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150236,
						220150237
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150236,
					"content": "(Почему он вдруг запнулся и словно потерял дар речи?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150238,
					"content": "Хм... Так или иначе, в одиночку мы можем прогнать только одного или, может, двух Похитителей сокровищ. Чтобы полностью от них избавиться, нам потребуется ваша помощь, ребята.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150239
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150239,
					"content": "Если вы хотите увидеть доказательства, вы можете пойти в город и найти Санго. Она объяснит вам все в деталях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150240
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150240,
					"content": "Хм... Амано, давай пойдем найдем Санго. Если в городе действительно завелись Похитители сокровищ, нужно что-то делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150241
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220150241,
					"content": "Да... да, конечно! Пойдем к Санго. Рюдзи, тебе тоже следует поскорее возвращаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150242
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220150242,
					"content": "...Ух.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150243
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150243,
					"content": "Тогда мы пошли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150244
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150244,
					"content": "То, что ты только что сказал...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150245
					]
				},
				{
					"id": 220150245,
					"content": "Санго наказала мне сказать это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150246
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150246,
					"content": "Мы сделали, что могли. Пошли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150237,
					"content": "(Он, похоже, забыл, о чём только что говорил...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150228,
					"content": "Так вы тоже оказались здесь, преследуя подозрительную личность?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150229
					]
				},
				{
					"id": 220150229,
					"content": "#Можно и так сказать. Правда, этой подозрительной личностью на деле оказа{M#лся}{F#лась} ты. Кхм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150230
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220150230,
					"content": "#Андо сказал, что тут по городу расхаживает как{F#ая-то}{M#ой-то} подозрительн{F#ая}{M#ый} светловолос{F#ая}{M#ый} чужестран{F#ка}{M#ец}, вот мы и пришли посмотреть, в чем дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150231
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220150231,
					"content": "Вот почему мы тайно следовали за тобой, но оказывается, ты помогаешь Санго. Извини за это небольшое недопонимание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220150213,
					"content": "Я помогаю Санго.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150214
					]
				},
				{
					"id": 220150214,
					"content": "Санго? Теперь всё кажется ещё более подозрительным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "Андо"
				}
			]
		},
		{
