				"points": []
			},
			"dialogs": [
				{
					"id": 220150501,
					"content": "#За всё время пребывания в Мондштадте я не встречал{F#а} ни одного детектива.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150502
					]
				},
				{
					"id": 220150502,
					"content": "Мондштадт... А ты о городе. Слышала о нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150503
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150503,
					"content": "Две самые известные вещи в Мондштадте - это вино и свобода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150504
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150504,
					"content": "Ха-ха, и эти две вещи неплохо дополняют друг друга... Подозреваю, что если бы в Мондштадте были детективы, их услуги пользовались бы большим спросом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				}
			]
		},
		{
			"id": 2201506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201501",
							"2"
						],
						"stepId": 2201501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Санго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150601,
					"content": "#Никогда не видел{F#а} в Ли Юэ детектива.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150602
					]
				},
				{
					"id": 220150602,
					"content": "Ли Юэ не нужны детективы. Я слышала, о том, какое уважение выказывается тамошним населением к однажды заключенным контрактам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150603
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150603,
					"content": "К тому у них есть Миллелиты, которые быстро решают абсолютно любые проблемы - от мала до велика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150604
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150604,
					"content": "Даже если бы там и существовало детективное агентство, подозреваю, что оно было бы вынуждено закрыться из-за отсутствия спроса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				}
			]
		},
		{
			"id": 2201507,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201501",
							"2"
						],
						"stepId": 2201501,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100801",
