				"objectNames": [
					"Санго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150301,
					"content": "Мисс Санго, это правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150302
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220150302,
					"content": "Действительно ли серийные кражи в городе - дело рук Похитителей сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150303
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220150303,
					"content": "Без тени сомнения. Я только что показала вам доказательства, уверена, что с вашим профессиональным чутьем вы и сами уже должны были догадаться об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150304
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150304,
					"content": "Похитители сокровищ... как они посмели?! Они нас вообще ни во что не ставят, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150305
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220150305,
					"content": "Амано! Вернёмся и сообщим об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150306
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220150306,
					"content": "Мы должны усилить патрулирование. Мы не должны давать этим придуркам ни единого шанса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150307
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220150307,
					"content": "Госпожа Санго, мы не могли бы позаимствовать улики? Они нужны нам, чтобы убедить высшее руководство принять меры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150308
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220150308,
					"content": "Без проблем, милости прошу. Боюсь, наше агентство всё равно не в состоянии самостоятельно разобраться с Похитителями сокровищ. Нам так или иначе придётся прибегнуть к помощи полиции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150309
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150309,
					"content": "Будьте уверены! От нас не уйдёт ни один Похититель сокровищ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150310
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220150310,
					"content": "Спасибо за ваши старания. Теперь... всё должно быть готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150311,
						220150313
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150311,
					"content": "Готово?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150312
					]
				},
				{
					"id": 220150312,
					"content": "Ага. Эти два досина из полицейского участка - важные «помощники», нужные нам, чтобы закрыть это дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150316,
					"content": "После того, как эта парочка поспособствует усилению патрулей в городе, Похитители сокровищ станут еще осторожнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150317
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150317,
					"content": "Рюдзи, ты подрался с Похитителями сокровищ там, куда я тебя отправила, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150318
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150318,
					"content": "#Да. Мы с путешественни{F#цей}{M#ком} задали им неплохую взбучку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150319
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220150319,
					"content": "Хм... это хорошо. И таким образом вы, должно быть, наделали немало шума.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150320
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150320,
					"content": "Теперь нам остаётся только ждать новой возможности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150321
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150321,
					"content": "#Благодарю за помощь, путешественни{F#ца}{M#к}. Вот твоё вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150322
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150322,
					"content": "#Не уверен{F#а}, что я действительно сделал{F#а} что-нибудь, чтобы помочь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150323
					]
				},
				{
					"id": 220150323,
					"content": "#Не говори так. Будучи неместн{F#ой}{M#ым}, ты привл{M#ёк}{F#екла} внимание Андо, они с Амано решили тебя выследить, что в свою очередь привело их к встрече с Рюдзи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150324
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150324,
					"content": "Затем они собственными глазами увидели угрозу, которую представляют Похитители сокровищ, что заставит их усилить патрулирование города...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150325
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150325,
					"content": "#Такое мог{F#ла} сделать только ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150326
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150326,
					"content": "В конце концов, гораздо эффективнее было позволить досинам самим увидеть Похитителей сокровищ, чем мне просто рассказать им о них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150327
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150327,
					"content": "Так или иначе, возьми вот это. Кто знает, может, мне ещё потребуется когда-нибудь твоя помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150313,
					"content": "Что ты планируешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150314
					]
				},
				{
					"id": 220150314,
					"content": "Я детектив, так что я планирую раскрыть это дело! Что же ещё?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150315
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220150315,
					"content": "Эти два досина из полицейского участка - важные «помощники», нужные нам, чтобы закрыть это дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Санго"
				}
			]
		},
		{
			"id": 2201505,
