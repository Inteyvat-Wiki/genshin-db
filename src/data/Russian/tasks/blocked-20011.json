					"Энтони"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200110301,
					"content": "#Теперь дорога свободна. Спасибо, путешественн{F#ица}{M#ик}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110302
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200110302,
					"content": "Болезнь Анны невозможно полностью исцелить. Нам не хватает денег на лекарства, поэтому в свободное время я собираю целебные травы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110303
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200110303,
					"content": "#Я собрал нужные травы, но потом на меня внезапно напали. Ты спас{F#ла} меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110304
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200110304,
					"content": "Это тебе! Я добавляю это в чай для Анны. Хорошо помогает от кашля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110305
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200110305,
					"content": "Похоже, тебе тоже нравится на природе. Береги себя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		}
	]
