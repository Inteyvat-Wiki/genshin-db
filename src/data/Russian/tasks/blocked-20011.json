			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Энтони"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200110201,
					"content": "#Спасибо, путешественн{F#ица}{M#ик}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110202
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200110202,
					"content": "Дорога заблокирована. Мне не проехать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110203
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200110203,
					"content": "Ох... я и сам бы справился, если бы хиличурлы не задали мне взбучку. До сих пор всё болит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110204
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200110204,
					"content": "Но всё не так уж плохо. У меня ещё есть целебные травы, которые я собрал для Анны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110205
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200110205,
					"content": "#Прости, я знаю, что ты и так уже много для меня сделал{F#а}, но не мог{F#ла} бы ты расчистить дорогу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110206,
						200110207
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200110206,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110208
					]
				},
				{
					"id": 200110208,
					"content": "Спасибо! Наконец-то я смогу передохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200110207,
					"content": "У меня нет на это времени, прости.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110209
					]
				},
				{
					"id": 200110209,
					"content": "Но Анна ждёт меня дома... Прошу, помоги мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		},
		{
			"id": 2001103,
			"completionStepIds": [
				2001104
