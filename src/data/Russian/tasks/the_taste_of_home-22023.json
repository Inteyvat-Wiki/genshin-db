				},
				{
					"id": 220230202,
					"content": "Мм... Не могу дождаться, так хочется попробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230203,
						220230204
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220230203,
					"content": "Милости прошу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220230204,
					"content": "Посмотрим... О каких блюдах мы только что говорили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230205
					]
				},
				{
					"id": 220230205,
					"content": "А, верно... Лепёшка «Мора», ветчина на сковородке и томатное рагу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220230206,
					"content": "Давай выберем одно и подадим его мисс Тан Вэнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
