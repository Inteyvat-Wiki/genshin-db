				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бенуа Леруа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490201,
					"content": "Рубашка Атоса - тысяча моры, ожерелье Мортиши... Ох, какая же молодёжь нынче расточительная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490202
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490202,
					"content": "Здравствуйте, господин Леруа.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490203
					]
				},
				{
					"id": 741490203,
					"content": "Здравствуйте! Мы от госпожи Евфрасии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741490204,
					"content": "Вы рассказываете господину Леруа, зачем пришли.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741490205
					]
				},
				{
					"id": 741490205,
					"content": "Ха-ха, это было полгода назад. Не ожидал, что госпожа Евфрасия до сих пор хранит мой запрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490206
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490206,
					"content": "Всё верно. Я действительно решил, что мне нужно нанять помощника. Как бы энергичен ты ни был в молодости, в старости тебе всё равно понадобится помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490207
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490207,
					"content": "Я всю жизнь зарабатывал на этот дом, а в итоге оказался в нём совсем один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490208
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490208,
					"content": "Я очень печалился из-за этого, но хорошо, что моя дочь с её мужем наконец приехали присматривать за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490209
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490209,
					"content": "Дети очень добры ко мне и любят друг друга. О большем я и мечтать не мог.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490210
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490210,
					"content": "Так что, молодёжь, помощники у меня уже есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490211,
						741490212
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490211,
					"content": "Как обидно, что мы зря пришли...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				},
				{
					"id": 741490213,
					"content": "Не расстраивайтесь. Молодёжь не должна грустить! Улыбайтесь и наслаждайтесь каждым мгновением!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490214
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490214,
					"content": "Раз уж вы проделали такой путь и за вас поручилась Евфрасия, я вам и правда могу дать кое-какую работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490215
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490215,
					"content": "Как раз детей нет дома, а я один не справлюсь. Я вам, конечно же, заплачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490216
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490216,
					"content": "Ох, господин Леруа! Вы так добры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741490217,
					"content": "Ха-ха, не льсти старику.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490218
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490218,
					"content": "Тогда за работу! Помогите мне убраться вокруг дома. А ещё покормите Нану рыбой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490219
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490219,
					"content": "Ах, чуть не забыл сказать. Нана - это моя кошка. Вон она, возле двери. Заранее передаю вам от неё спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490220
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490220,
					"content": "Звучит проще простого! Мы справимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741490212,
					"content": "Ох уж эта Евфрасия...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				}
			]
		},
		{
			"id": 7414905,
			"completionStepIds": [
				7414905
			],
