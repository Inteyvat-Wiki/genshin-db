			"dialogs": [
				{
					"id": 741490701,
					"content": "Забыли, что нужно делать? Какая забывчивая пошла молодёжь, хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490702
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490702,
					"content": "Нужно убраться вокруг дома. А ещё покормить кошку Нану рыбой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бенуа Леруа"
				}
			]
		}
	]
