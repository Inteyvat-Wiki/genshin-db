			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Евфрасия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490101,
					"content": "Есть ли для меня новая работа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490102
					]
				},
				{
					"id": 741490102,
					"content": "Новая? Поручения в «Историях из жизни» слишком просты для тебя? Или тебе срочно нужна мора?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490103,
						741490105
					],
					"speakerTitle": "Евфрасия"
				},
				{
					"id": 741490103,
					"content": "Моры никогда не бывает достаточно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490104
					]
				},
				{
					"id": 741490104,
					"content": "Хм, пожалуй. Многие руководствуются этим принципом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Евфрасия"
				},
				{
					"id": 741490107,
					"content": "Поручений у нас всегда достаточно. Если не считать Гильдию искателей приключений, можно сказать, что в «Паровой птице» собрано больше всего информации о возможных подработках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490108
					],
					"speakerTitle": "Евфрасия"
				},
				{
					"id": 741490108,
					"content": "Но вообще-то даже в теории мы не обязаны отвечать за трудоустройство жителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490109
					],
					"speakerTitle": "Евфрасия"
				},
				{
					"id": 741490109,
					"content": "Как бы то ни было, если нужна мора, я могу порекомендовать тебе одну работёнку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490110
					],
					"speakerTitle": "Евфрасия"
				},
				{
					"id": 741490110,
					"content": "Эту записку больше полугода назад оставил для «Историй из жизни» господин Леруа. Все на этой улице знают его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490111
					],
					"speakerTitle": "Евфрасия"
				},
				{
					"id": 741490111,
					"content": "Хоть в молодости у него и была сомнительная репутация, но в последние годы я не слышала о нём никаких дурных слухов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490112
					],
					"speakerTitle": "Евфрасия"
				},
				{
					"id": 741490112,
					"content": "Он живёт один, а его единственная дочь далеко, так что о нём некому позаботиться. Вот он и ищет помощника за почасовую оплату.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490113
					],
					"speakerTitle": "Евфрасия"
				},
				{
					"id": 741490113,
					"content": "Насколько мне известно, господин Леруа не из бедных. Так что жалование должно быть приличным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490114
					],
					"speakerTitle": "Евфрасия"
				},
				{
					"id": 741490114,
					"content": "И плюс ко всему эта работа вряд ли подразумевает какой-либо риск. Звучит как вариант достойный твоего внимания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490115
					],
					"speakerTitle": "Евфрасия"
				},
				{
					"id": 741490115,
					"content": "Нужно будет помогать ему по хозяйству? Отличная работа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741490116,
					"content": "Дайте мне его адрес, пожалуйста.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490117
					]
				},
				{
					"id": 741490117,
					"content": "Да, конечно. Тебе нужно дважды повернуть за угол, затем обойти... Ай, ладно, я лучше нарисую карту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490118
					],
					"speakerTitle": "Евфрасия"
				},
				{
					"id": 741490118,
					"content": "Только не забудь ему сказать, что это я порекомендовала вам эту работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Евфрасия"
				},
				{
					"id": 741490105,
					"content": "И то и то.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490106
					]
				},
				{
					"id": 741490106,
					"content": "#А ты {F#упорная девушка}{M#упорный молодой человек}. Это хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Евфрасия"
				}
			]
		},
		{
			"id": 7414902,
			"completionStepIds": [
				7414902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
