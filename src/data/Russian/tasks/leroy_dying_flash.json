				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бенуа Леруа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490501,
					"content": "Вы закончили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490502
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490502,
					"content": "Да, господин Леруа. И...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741490503,
					"content": "Что? Хочешь конфетку или уже не терпится поскорее получить своё вознаграждение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490504
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490504,
					"content": "И то и то, если честно... Хи-хи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741490505,
					"content": "Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490506
					]
				},
				{
					"id": 741490506,
					"content": "Ха-ха, какая жадина! Ничего, дети всегда такие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490507
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490507,
					"content": "Такая милая девчушка, как ты, Паймон, должна есть вкусные макароны, носить красивые платьица и жить в красивом домике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490508
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490508,
					"content": "#Паймон согласна! {NICKNAME}, а мы можем купить мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741490509,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490510
					]
				},
				{
					"id": 741490510,
					"content": "Бе-бе-бе, жадина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490511,
						741490512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741490511,
					"content": "Паймон, мы же искатели приключений...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				},
				{
					"id": 741490513,
					"content": "Но это ведь никак не мешает есть макароны, носить красивые платьица и жить в красивом домике...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741490514,
					"content": "Ну чего вы спорите? Совсем как маленькие. Хотя иногда перепалки даже нужны. Так детки показывают свой характер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490515,
						741490516
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490515,
					"content": "Но я вообще-то уже взрос...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490517,
					"content": "Глазом не моргнёте, как детство пролетит. Цените это время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490518
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490518,
					"content": "Ладненько, вот ваше вознаграждение и сладости. Только не вредничайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490519
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490519,
					"content": "Сладости! Спасибо, господин Леруа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741490520,
					"content": "Называйте меня Бенуа. Леруа - моя фамилия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490521
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490521,
					"content": "Я последний представитель фамилии Леруа в Фонтейне, поэтому, когда меня называют по фамилии, я сразу ощущаю себя одиноким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490522
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490522,
					"content": "Господин Ле... Ой, Бенуа! А разве у вашей дочери не ваша фамилия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490523
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741490523,
					"content": "Мортиша не моя родная дочь. Я приютил её полгода назад. Но для меня она уже как родная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490524
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490524,
					"content": "Если хотите, приходите завтра тоже. Мортиша и Атос к тому времени уже вернутся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490525
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490525,
					"content": "Я приглашаю вас на чай со сладостями. Уверен, Мортиша не будет против.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490526
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490526,
					"content": "Сюда иногда приходят и другие ребята, вы можете вместе играть. Я люблю, когда в доме много детей: чем больше детей, тем в доме больше жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490527
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490527,
					"content": "Если, когда вы придёте в следующий раз, меня не будет, то постучитесь в дверь и скажите, что вы ко мне. Атос вам откроет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490528
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490528,
					"content": "Хорошо! Тогда мы ещё придём завтра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490529
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741490529,
					"content": "Отлично. Ну а мне уже пора возвращаться в дом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490530
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490530,
					"content": "До завтра!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490531
					]
				},
				{
					"id": 741490531,
					"content": "До завтра, молодёжь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490516,
					"content": "Споры - главный показатель крепкой дружбы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490512,
					"content": "Не забывай о цели наших путешествий.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				}
			]
		},
