			},
			"dialogs": [
				{
					"id": 1903203101,
					"content": "У... у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203102
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203102,
					"content": "#{NICKNAME}, мне нужна... твоя помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203103,
						1903203104
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203103,
					"content": "Моя помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				},
				{
					"id": 1903203105,
					"content": "Этот экзорцист с синими волосами очень страшный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203106
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203106,
					"content": "#Я его боюсь. Не мог{F#ла} бы ты увести его отсюда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203107,
						1903203108
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203107,
					"content": "На тебя подействовала его энергия Ян?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203109,
					"content": "Я бы ни за что не посмела подойти к нему. Его энергия... Она ужасна! Из-за неё я погибну!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203110
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203110,
					"content": "Я не хочу погибать. Прошу тебя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203111,
						1903203112
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203111,
					"content": "Интересно, счёл бы он тебя злым духом или нет?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203113,
					"content": "Тогда у меня есть идея.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203114
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203114,
					"content": "Я только что видела, как синеволосый экзорцист с кем-то поругался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203115
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203115,
					"content": "Я отпугну тех, кто ему докучает, а взамен он меня отпустит, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203116,
						1903203118
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203116,
					"content": "Уж не лжёшь ли ты мне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203117
					]
				},
				{
					"id": 1903203117,
					"content": "Я всегда говорю правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203120,
					"content": "Что скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203121
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203121,
					"content": "Я поясню ему ситуацию, но решение остаётся за ним.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203122
					]
				},
				{
					"id": 1903203122,
					"content": "Хорошо. Я приму это за согласие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203123
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203123,
					"content": "Надеюсь, экзорцист с синими волосами добрый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203124
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203124,
					"content": "Я помогу ему, потом ты поговоришь с ним, а потом... поможешь мне. Хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203118,
					"content": "#Я и сам{F#а} могу его выручить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203119
					]
				},
				{
					"id": 1903203119,
					"content": "Да, но это будет непросто, а у меня уже готов план. Поверь мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Цянь Цянь"
				},
				{
					"id": 1903203112,
					"content": "Как поступить, решать ему.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203108,
					"content": "Так вот почему мы тебя не видели.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203104,
					"content": "Почему именно моя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				}
			]
		}
	]
}