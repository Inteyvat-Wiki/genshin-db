				"objectNames": [
					"Арапанду"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141301,
					"content": "#Нужно повернуть три листа в сторону ветви. Пожалуйста, нара {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арапанду"
				}
			]
		},
		{
			"id": 7301415,
			"completionStepIds": [
				7301415
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301415",
							"2"
						],
						"stepId": 7301415,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арапанду",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141501,
					"content": "#Благодарю, нара {NICKNAME}. Остальное сделает Арапанду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141502
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141502,
					"content": "Правда, прошло слишком много времени. Не знаю, получится ли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141503
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141503,
					"content": "А?! Может ещё и не получиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141504,
					"content": "Раньше всегда получалось. Что будет теперь, не знаю. Это как солнце - вчера и сегодня оно выходило на небо, но выйдет ли завтра, никто не знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141505
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141505,
					"content": "И только увидев солнце на небе, Паймон сможет сказать: «Ага, солнце снова взошло!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141506
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141506,
					"content": "Ого... Страх-то какой... А если солнце в самом деле больше не взойдёт?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141507,
					"content": "#Не бойся, Паймон. Нара {NICKNAME} {M#золотой}{F#золотая}, словно солнце, и {M#храбрый}{F#храбрая}, как нара Варуна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141508
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141508,
					"content": "#Нара Варуна {M#вернула}{F#вернул} нам солнце и луну. Значит, и нара {NICKNAME} сумеет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141509
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141509,
					"content": "#Да! Паймон тоже верит, что {NICKNAME} справится с любыми напастями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141510,
					"content": "Да, не беспокойтесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141511
					]
				},
				{
					"id": 730141511,
					"content": "Но теперь за дело возьмётся Арапанду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141512
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141512,
					"content": "О, кажется... Получилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141513,
					"content": "Да, здесь листья и ветви исцелены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141514
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141514,
					"content": "Здорово! А танец аранар просто удивительный!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141515,
					"content": "Паймон, возьмёшь у аранар пару уроков?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141516
					]
				},
				{
					"id": 730141516,
					"content": "Неплохая мысль!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141517,
					"content": "С таким аппетитом, как у Паймон, надо побольше двигаться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141518
					]
				},
				{
					"id": 730141518,
					"content": "#Хм! {NICKNAME}, Паймон и так постоянно носится с тобой повсюду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141519
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141519,
					"content": "Но этого недостаточно, чтобы полностью исцелить машину Варуны, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141520,
					"content": "В ване ещё три места. У Арабалики есть силы, Арабалика справится. А вот Аранакула и Аракунти... Из-за этих странных дождей в ване стало ещё опаснее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141521
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141521,
					"content": "#Давай Паймон и {NICKNAME} проверят, как у них дела? Ведь если не исцелить машину Варуны, как тогда готовиться к Празднику Утсава?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141522
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141522,
					"content": "#Паймон и {NICKNAME}, с вашей помощью машина Варуны очень скоро исцелится. В вану вернётся жизненная сила, и всё будет, как раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141523
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141523,
					"content": "Аранакула отправился в <color=#00E1FFFF>Монумент ясны</color>. В глубинах ваны хранится память аранар о наре Варуне, но из-за «плесенников» и «спор» туда давно никто не ходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141524
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141524,
					"content": "Аранакуле привычнее иметь дело с землёй и семенами. Аранакула знает всё о том, что рождается из земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141525
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141525,
					"content": "Отыщите Аранакулу. Назовите ему имя Арапанду. Тогда Аранакула не будет бояться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141526
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141526,
					"content": "Хех, какой трусишка-аранара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141527
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141527,
					"content": "#Араракалари Арабалики очень сильный! Но... всё же, {NICKNAME} и Паймон, проведайте Арабалику...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141528
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141528,
					"content": "#Арабалика сейчас в <color=#00E1FFFF>руинах Дахри</color>. Там сильно пахнет железом... Паймон и {NICKNAME}, будьте осторожны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141529
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141529,
					"content": "Да, мы будем осторожны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141530
					]
				},
				{
					"id": 730141530,
					"content": "Аракунти находится в <color=#00E1FFFF>роще Сновидений</color>. Оттуда можно войти в мир снов. Аракунти сторонится нар. Если Аракунти спрячется, сыграй нашу музыку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141531
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141531,
					"content": "А кстати, у нас ведь есть ноты аранар. Если не найдём Аракунти, опробуем их в деле!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141532
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141532,
					"content": "Арапанду будет ждать в Уголке отдыха и наблюдать за ваной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141533
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141533,
					"content": "Аранакула, Арабалика и Аракунти знают, что после исцеления ветвей и листьев мы встречаемся в Уголке отдыха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141534
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141534,
					"content": "#{M#Золотой}{F#Золотая} и {M#храбрый}{F#храбрая} нара {NICKNAME}, да благословит тебя Арамухукунда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141535
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141535,
					"content": "Мы обо всём позаботимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7301417,
			"completionStepIds": [
				7301417
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301417",
							"2"
						],
						"stepId": 7301417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Арапанду"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141701,
					"content": "Эй! Что там?! Это великолепно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141702,
					"content": "#Теперь нара {NICKNAME} и Паймон знают. Это Варунастра. Но машина Варуны ещё глубже - там, где корни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141703
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141703,
					"content": "Судя по всему, мы недооценивали нару Варуну. Паймон не ожидала увидеть такую громадину...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141704,
					"content": "Такую силу нельзя недооценивать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141705
					]
				},
				{
					"id": 730141705,
					"content": "Ещё до чёрных дождей и прихода нары Варуны в вану Арамухукунда и властительница Дендро создали машину Варуны. Дождь дал жизнь многому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141706
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141706,
					"content": "Чёрные дожди, чёрная грязь и много плохого изменили вану до неузнаваемости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141707
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141707,
					"content": "#Раньше мы никогда не встречали {M#такую храбрую}{F#такого храброго} нару. Нара Варуна вместе с аранарами {M#исцелила}{F#исцелил} машину Варуны, как изгоняющее мглу солнце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141708
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141708,
					"content": "#Теперь же нара Варуна {M#покинула}{F#покинул} Ванарану. Арамухукунды тоже нет... Но аранары вновь исцелят машину Варуны, ради Праздника Утсава и ваны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141709
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141709,
					"content": "Мы обещали Арадже и Араме помочь подготовиться к Празднику Утсава. Как говорится, чем больше нар собирают хворост, тем выше костёр, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141710,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141711
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141711,
					"content": "Ой, нет, не так! Паймон хотела сказать: чем больше нар возьмётся за дело, тем быстрее оно сделается! Не бойся, никакого пламени не будет! Ничего такого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141712,
					"content": "Паймон, что-то ты перемудрила.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141713
					]
				},
				{
					"id": 730141713,
					"content": "Ах... Паймон, раз она уж оказалась в Сумеру, просто захотела блеснуть познаниями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141714,
					"content": "#Арапанду не боится. У Паймон доброе сердце. Она такая же добрая, как нара {NICKNAME} и нара Варуна. Паймон - друг аранар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141715
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141715,
					"content": "Аранакула, Арабалика и Аракунти вместе с Арапанду хотят исцелить машину Варуны, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141716
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141716,
					"content": "Спор и плесенников слишком много. Ничего не получается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141717
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141717,
					"content": "Араракалари Арапанду не такой сильный, как у Арабалики. А из-за странных дождей плесенники сделались свирепей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141718
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141718,
					"content": "Погоди. «Араракалари»... По словам Араны, араракалари помогает противостоять Маране...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141719
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141719,
					"content": "Сильный араракалари может прогнать плесенников. Араракалари, которым владеет Арапанду, слишком слаб и плесенникам ничего не сделает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141720
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141720,
					"content": "Что? Араракалари можно использовать и так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141721
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141721,
					"content": "Наверное, так они называют некую способность...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141722
					]
				},
				{
					"id": 730141722,
					"content": "#Нара {NICKNAME} умнее Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141723
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141723,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141724
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141724,
					"content": "У каждого из аранар свой араракалари. Но только травы и деревья ваны наделили всех аранар способностью использовать эту силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141725
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141725,
					"content": "У Арабалики сильный араракалари. Арабалике не страшны даже огромные плесенники и большие железные нары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141726
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141726,
					"content": "Большие железные нары?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141727
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141727,
					"content": "#Большие железные нары - очень большие, с двумя руками и ногами, как {NICKNAME}, но всего с одним глазом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141728
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141728,
					"content": "А, так это ведь стражи руин!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141729
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141729,
					"content": "Умница, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141730
					]
				},
				{
					"id": 730141730,
					"content": "Хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141731
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141731,
					"content": "Ох! На тех деревьях плесенники... Арабалике под силу с ними справиться, но Арапанду не может...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141732
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141732,
					"content": "#Нара {NICKNAME} тоже не боится плесенников. Даже без араракалари силы твои огромны. Ты как страшный ветер, что срывает листья с деревьев. Фью-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141733
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141733,
					"content": "#Если ничего не предпринять, спор и плесенников будет становиться всё больше... Нара {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141734
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141734,
					"content": "#Поручи это нам! Нара {NICKNAME} справится с ними в один миг. Вжух, и готово! Правда же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}