			"trigger": {
				"objectNames": [
					"Паймон",
					"Арапанду"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141201,
					"content": "Ого... Так вот где они!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141202,
					"content": "Погодите... Это и есть ветви и листья? Больше похоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141203,
					"content": "На узор из камней, составленный аранарами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141204
					]
				},
				{
					"id": 730141204,
					"content": "Каменные листья и каменные ветви - творение Арамухукунды и властительницы Дендро. Они собирают силу ваны в машину Варуны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141205
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141205,
					"content": "Машина Варуны - что-то вроде большого дерева.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141206
					]
				},
				{
					"id": 730141206,
					"content": "Вот оно что!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141207,
					"content": "Три листа нужно повернуть в сторону ветви, но у Арапанду слишком мало сил... Беда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141208
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141208,
					"content": "#Что же, аранары такие маленькие. Пусть лучше за дело возьмётся нара {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730141209,
					"content": "Арабалика, пожалуй, справится, а вот Аранакула и Аракунти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141210
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730141210,
					"content": "#Но сначала надо закончить здесь. Нара {NICKNAME}, прошу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арапанду"
				}
			]
		},
		{
			"id": 7301413,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
