						],
						"stepId": 7301401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Арапанду",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730140301,
					"content": "#О, это нара. {M#Золотой и храбрый}{F#Золотая и храбрая} нара...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140302
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730140302,
					"content": "#Паймон - это Паймон, а это {NICKNAME}. Все в Ванаране готовится к Празднику Утсава. Что ты здесь делаешь в одиночку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730140303,
					"content": "У Арапанду важное задание. Я здесь ради Праздника Утсава, ради чащи Апам и нары Варуны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140304
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730140304,
					"content": "Ага, значит, ты и есть Арапанду. «Нара Варуна», говоришь? Знакомое имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730140305,
					"content": "#Нара Варуна... Это {M#золотая}{F#золотой} и {M#храбрая}{F#храбрый} нара, совсем как нара {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140306
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730140306,
					"content": "Когда не было видно ни луны, ни солнца, даже ветры обрывали листья с больших деревьев ваны, а чёрные дожди терзали их ветви.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140307
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730140307,
					"content": "Боль ваны капля за каплей утекала в землю. Повсюду стоял запах железа и соли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140308
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730140308,
					"content": "Ого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730140309,
					"content": "#Не знаю, сколько раз вставало и заходило солнце. {M#Явилась}{F#Явился} нара Варуна. {M#Золотая}{F#Золотой} нара {M#говорила}{F#говорил} золотые речи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140310
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730140310,
					"content": "#Вместе с аранарами {M#она вернула}{F#он вернул} на небо солнце и луну. Машина нары Варуны смыла боль ваны. С тех пор больше не было чёрных дождей, не было запаха железа и соли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140311
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730140311,
					"content": "Все в Ванаране были благодарны наре Варуне. Все полюбили нару Варуну, как любят солнце, землю, дождь и росу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140312
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730140312,
					"content": "#Ого, звучит здорово! Наверное, {M#она}{F#он} очень {M#хорошая}{F#хороший} нара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730140313,
					"content": "#Хе-хе, но и нара {NICKNAME} тоже {M#помог}{F#помогла} многим. Многие {M#ему}{F#ей} благодарны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730140314,
					"content": "#Нара {NICKNAME} тоже обязательно тебе понравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730140315,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140316
					]
				},
				{
					"id": 730140316,
					"content": "#После {M#её}{F#его} ухода из Ванараны многое родилось из земли, и многое в землю вернулось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140317
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730140317,
					"content": "Ветви и листья машины Варуны утратили свою силу. Варунастра суматошно хлопала крыльями, как испуганный зяблик. Дожди потом стали слишком частыми. Очень странно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140318
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730140318,
					"content": "В ване поселились бегающие грибы. Повсюду незнакомые семена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140319
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730140319,
					"content": "...Наверное, это плесенники и споры. Но что это за машина Варуны и Варунастра?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730140320,
					"content": "Может, какое-нибудь мощное оружие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140321,
						730140323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730140321,
					"content": "Клинок, способный разрубить валуку пополам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140322
					]
				},
				{
					"id": 730140322,
					"content": "Это будет слишком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730140327,
					"content": "#О... Нет, нара {NICKNAME} и Паймон ошибаются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140328
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730140328,
					"content": "Поднимемся повыше. Арапанду всё расскажет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730140323,
					"content": "Может, это не оружие...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140324
					]
				},
				{
					"id": 730140324,
					"content": "Тогда что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730140325,
					"content": "Может, крылатый аранара, сотворённый из воды...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140326
					]
				},
				{
					"id": 730140326,
					"content": "Так это Гидро мимик!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Паймон"
				}
			]
		},
