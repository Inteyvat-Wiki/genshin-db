				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рикору",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450101,
					"content": "Что? Не мешай мне. Я думаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450102
					],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450102,
					"content": "Я думаю об очень важных вещах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450103
					],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450103,
					"content": "О чём это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450104,
					"content": "#{M#Видел}{F#Видела} эту штуку, которую называют Дайнити Микоси?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450105
					],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450105,
					"content": "Самое высокое строение в Бякуякоку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450106
					],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450106,
					"content": "Я думал о том, как создать строение ещё выше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450107
					],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450107,
					"content": "Но ведь оно такое высокое, чтобы освещать Бякуякоку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450108,
					"content": "А твоему зданию зачем быть высоким?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450109,
					"content": "Чтобы восславить меня, конечно! Слава Рикору Великому!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450110
					],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450110,
					"content": "Это покажет старику Абэраку, кто здесь хозяин!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450111,
						722450112
					],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450111,
					"content": "Ты знаешь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				},
				{
					"id": 722450113,
					"content": "Конечно. Он построил Дайнити Микоси и спас Бякуякоку. Раньше я преклонялся перед ним...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450114
					],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450114,
					"content": "Но, как оказалось, у него были планы захватить трон. Если бы не вмешательство взрослых, я бы мог лишиться жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450115
					],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450115,
					"content": "Поэтому я построю что-то, что будет выше Дайнити Микоси.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450116
					],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450116,
					"content": "Долго будешь строить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450117,
					"content": "Это неважно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450118
					],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450118,
					"content": "Жители Бякуякоку должны быть счастливы, что я попросил их построить для меня такое историческое чудо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450119
					],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450119,
					"content": "Ладно, хватит меня доставать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450120
					],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450120,
					"content": "Дай подумать. Если балки такой длины... Если мы сделаем это таким образом, то нагрузка и несущая конструкция...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рикору"
				},
				{
					"id": 722450112,
					"content": "...Абэраку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				}
			]
		},
		{
			"id": 7224502,
			"completionStepIds": [
				7224502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224502",
							"2"
						],
						"stepId": 7224502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Исумэнасу",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450201,
					"content": "Хм? Я никогда раньше не встречал людей, одетых так, как ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450202
					],
					"speakerTitle": "Исумэнасу"
				},
				{
					"id": 722450202,
					"content": "Вы... спустились с небес?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450203
					],
					"speakerTitle": "Исумэнасу"
				},
				{
					"id": 722450203,
					"content": "В мире есть что-то ещё, а не только наша славная страна! Что ж, тогда дайте мне вашу карту, я изучу её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450204
					],
					"speakerTitle": "Исумэнасу"
				},
				{
					"id": 722450204,
					"content": "(Вы даёте ему свою карту...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450205
					]
				},
				{
					"id": 722450205,
					"content": "Ах, как замысловато. Не только рельеф местности точно прорисован, но даже видны линии гор и рек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450206
					],
					"speakerTitle": "Исумэнасу"
				},
				{
					"id": 722450206,
					"content": "И насколько велика эта страна, которую вы называете «Тейват»? Она больше или меньше Бякуякоку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450207
					],
					"speakerTitle": "Исумэнасу"
				},
				{
					"id": 722450207,
					"content": "Тейват - это целый континент...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450208,
					"content": "А Энканомия... То есть Бякуякоку, это небольшой участок в южной части карты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450209,
					"content": "Чепуха! Наши земли обширны! Как они могут занимать такое ничтожное пространство?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450210
					],
					"speakerTitle": "Исумэнасу"
				},
				{
					"id": 722450210,
					"content": "Эта карта может показаться тщательно прорисованной, но на самом деле это выдумка, подделка. Заберите её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450211
					],
					"speakerTitle": "Исумэнасу"
				},
				{
					"id": 722450211,
					"content": "Подумать только! Я на мгновение восхитился этим дешёвым шарлатанством, осквернившим мои глаза!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450212
					],
					"speakerTitle": "Исумэнасу"
				},
				{
					"id": 722450212,
					"content": "Ну, как хочешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7224503,
			"completionStepIds": [
				7224503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
