			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сурэпио",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450301,
					"content": "#Путешественни{M#к}{F#ца}... Кхе-кхе... Ты выглядишь {M#уставшим}{F#уставшей}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450302
					],
					"speakerTitle": "Сурэпио"
				},
				{
					"id": 722450302,
					"content": "Не надо так. Многие болезни развиваются именно от истощения сил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450303
					],
					"speakerTitle": "Сурэпио"
				},
				{
					"id": 722450303,
					"content": "Обязательно отдыхайте каждый день, чтобы... кхе-кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450304
					],
					"speakerTitle": "Сурэпио"
				},
				{
					"id": 722450304,
					"content": "...кхе-кхе... быть здоровыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450305
					],
					"speakerTitle": "Сурэпио"
				},
				{
					"id": 722450305,
					"content": "Знаешь, что-то ты сам выглядишь не очень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450306,
					"content": "Ха-ха, это мой старый недуг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450307
					],
					"speakerTitle": "Сурэпио"
				},
				{
					"id": 722450307,
					"content": "#Поддерживай здоровое тело, чтобы душа была здорова, путешественни{M#к}{F#ца}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450308
					],
					"speakerTitle": "Сурэпио"
				},
				{
					"id": 722450308,
					"content": "Эх... Если бы только у меня было больше времени, я бы стал величайшим врачом в мире...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450309
					],
					"speakerTitle": "Сурэпио"
				},
				{
					"id": 722450309,
					"content": "Даже с этим моим телом я бы смог выйти из своей комнаты в добром здравии и развлекаться в своё удовольствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сурэпио"
				}
			]
		},
		{
			"id": 7224504,
			"completionStepIds": [
				7224504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224504",
							"2"
						],
						"stepId": 7224504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рисутайосу",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450401,
					"content": "Не двигайся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450402
					],
					"speakerTitle": "Рисутайосу"
				},
				{
					"id": 722450402,
					"content": "О, прекрати! Остановись, я говорю! Стоп! Слышишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450403
					],
					"speakerTitle": "Рисутайосу"
				},
				{
					"id": 722450403,
					"content": "Паймон не может перестать двигаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450404,
						722450405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450404,
					"content": "Если попросить Паймон не двигаться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				},
				{
					"id": 722450406,
					"content": "Нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450407,
					"content": "Уф, ладно, уж. Я никогда в жизни не видел таких одежд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450408
					],
					"speakerTitle": "Рисутайосу"
				},
				{
					"id": 722450408,
					"content": "Они не совсем эстетичны, но в некоторой степени интересны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450409
					],
					"speakerTitle": "Рисутайосу"
				},
				{
					"id": 722450409,
					"content": "Если не нравится, зачем смотришь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450410,
					"content": "Подумать только, когда-то дамы позировали для меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450411
					],
					"speakerTitle": "Рисутайосу"
				},
				{
					"id": 722450411,
					"content": "И мне уже надоело смотреть на то, как одеваются наши жители.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450412
					],
					"speakerTitle": "Рисутайосу"
				},
				{
					"id": 722450412,
					"content": "А ваши вещи - это что-то новенькое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450413
					],
					"speakerTitle": "Рисутайосу"
				},
				{
					"id": 722450413,
					"content": "Хм, да. Вот вы как сочетаете одежду... Вы, чужестранцы, действительно бесстыдны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450414
					],
					"speakerTitle": "Рисутайосу"
				},
				{
					"id": 722450414,
					"content": "Если одежда сшита именно так, то форма тела должна быть такой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450415
					],
					"speakerTitle": "Рисутайосу"
				},
				{
					"id": 722450415,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450416,
					"content": "Создаю статуи. Я смешиваю глину и воду, а затем руками разминаю их, придавая форму. Это помогает мне успокоиться. То редкое, что помогает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450417
					],
					"speakerTitle": "Рисутайосу"
				},
				{
					"id": 722450417,
					"content": "И знаете, что меня точно не успокаивает? Посещение регулярных собраний и зачитывание вслух речей, заранее написанных этими взрослыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450418
					],
					"speakerTitle": "Рисутайосу"
				},
				{
					"id": 722450418,
					"content": "Ну, неважно. Мне уже надоело тебя созерцать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450419
					],
					"speakerTitle": "Рисутайосу"
				},
				{
					"id": 722450419,
					"content": "Перестань меня отвлекать. Иди и займись своими делами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рисутайосу"
				},
				{
					"id": 722450405,
					"content": "...Паймон упадёт?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				}
			]
		},
		{
			"id": 7224505,
			"completionStepIds": [
				7224505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224505",
							"2"
						],
						"stepId": 7224505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ион",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450501,
					"content": "#О, путешественни{M#к}{F#ца}, ты выглядишь необычно. Что скажешь, если я попробую прочесть твою судьбу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450502
					],
					"speakerTitle": "Ион"
				},
				{
					"id": 722450502,
					"content": "Я Ион. Я никогда не упускаю случая погадать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450503
					],
					"speakerTitle": "Ион"
				},
				{
					"id": 722450503,
					"content": "Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450504,
					"content": "Ты говоришь как шарлатан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450505,
					"content": "(Кроме того, Паймон помнит, что было написано на его надгробии...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450506,
					"content": "Да ладно, что за недоверчивый взгляд? Я всегда читаю судьбы людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450507
					],
					"speakerTitle": "Ион"
				},
				{
					"id": 722450507,
					"content": "И всё же... Немногих из жителей Бякуякоку ждёт счастливая судьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450508
					],
					"speakerTitle": "Ион"
				},
				{
					"id": 722450508,
					"content": "Поэтому я часто обманываю их, говоря, что их ждёт удача.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450509
					],
					"speakerTitle": "Ион"
				},
				{
					"id": 722450509,
					"content": "Я думаю, что таким образом могу подарить им немного счастья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450510
					],
					"speakerTitle": "Ион"
				},
				{
					"id": 722450510,
					"content": "А потом они говорят, что я вообще не умею гадать. Печально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450511
					],
					"speakerTitle": "Ион"
				},
				{
					"id": 722450511,
					"content": "Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450512,
					"content": "Малышка, я докажу тебе это прямо сейчас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450513
					],
					"speakerTitle": "Ион"
				},
				{
					"id": 722450513,
					"content": "Давай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450514,
					"content": "Хм, хорошо... Сейчас попробую... Почему так много помех?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450515
					],
					"speakerTitle": "Ион"
				},
				{
					"id": 722450515,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450516
					],
					"speakerTitle": "Ион"
				},
				{
					"id": 722450516,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450517,
					"content": "Я... не могу прочитать твою судьбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450518
					],
					"speakerTitle": "Ион"
				},
				{
					"id": 722450518,
					"content": "Как это возможно? Обычно у меня не получается точно предсказать, но хоть что-то я вижу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450519
					],
					"speakerTitle": "Ион"
				},
				{
					"id": 722450519,
					"content": "Видимо, ты не так уж хорош в своём деле, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450520,
					"content": "Видимо. Мне надо продолжить учиться со всей серьёзностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ион"
				}
			]
		},
		{
			"id": 7224506,
			"completionStepIds": [
				7224506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224506",
							"2"
						],
						"stepId": 7224506,
						"stateName": "QUEST_STATE_UNFINISHED"
