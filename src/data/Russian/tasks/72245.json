			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Пирамумон",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450601,
					"content": "#О-хо! Судя по твоему виду, ты, должно быть, путешественни{M#к}{F#ца} из другого государства!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450602
					],
					"speakerTitle": "Пирамумон"
				},
				{
					"id": 722450602,
					"content": "Откуда ты родом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450603
					],
					"speakerTitle": "Пирамумон"
				},
				{
					"id": 722450603,
					"content": "Мы из Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450604,
					"content": "Мондштадт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450605
					],
					"speakerTitle": "Пирамумон"
				},
				{
					"id": 722450605,
					"content": "Вы вкратце описываете Пирамумону природу и нравы Мондштадта...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722450606
					]
				},
				{
					"id": 722450606,
					"content": "Я никогда не слышал о таком городе. Подумать только, что такое место существует...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450607
					],
					"speakerTitle": "Пирамумон"
				},
				{
					"id": 722450607,
					"content": "Ха-ха! Всё так, как я и говорил! Мир не может ограничиваться одной Бякуякоку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450608
					],
					"speakerTitle": "Пирамумон"
				},
				{
					"id": 722450608,
					"content": "Я имею в виду, если бы в мире существовала только Бякуякоку, было бы одиноко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450609
					],
					"speakerTitle": "Пирамумон"
				},
				{
					"id": 722450609,
					"content": "В древних текстах рассказывается о временах до основания нашего государства. Прочитав те книги, я начал верить, что существуют земли за пределами нашей страны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450610
					],
					"speakerTitle": "Пирамумон"
				},
				{
					"id": 722450610,
					"content": "Но мне всё равно было страшно, понимаешь? Я боялся, вдруг там действительно больше ничего нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450611
					],
					"speakerTitle": "Пирамумон"
				},
				{
					"id": 722450611,
					"content": "#Ты даже не представляешь, {M#путешественник}{F#путешественница}, насколько твоё появление успокаивает моё сердце. Ха-ха, значит, в этом мире есть ещё много увлекательных мест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450612
					],
					"speakerTitle": "Пирамумон"
				},
				{
					"id": 722450612,
					"content": "Жаль только, что мне нужно быть на празднике под названием «Обряд возвращения к солнцу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450613
					],
					"speakerTitle": "Пирамумон"
				},
				{
					"id": 722450613,
					"content": "#Расскажи, пожалуйста, как ты {M#попал}{F#попала} сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450614
					],
					"speakerTitle": "Пирамумон"
				},
				{
					"id": 722450614,
					"content": "Как только праздник закончится, я постараюсь улизнуть из Дайнити Микоси.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450615
					],
					"speakerTitle": "Пирамумон"
				},
				{
					"id": 722450615,
					"content": "Давай вместе выпьем сока! Ха-ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пирамумон"
				}
			]
		},
		{
			"id": 7224507,
			"completionStepIds": [
				7224507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224507",
							"2"
						],
						"stepId": 7224507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Орупэусу",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450701,
					"content": "Итак, ты из далёких земель...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450702
					],
					"speakerTitle": "Орупэусу"
				},
				{
					"id": 722450702,
					"content": "#Что ты ищешь? Ты как-то грустно {M#выглядел}{F#выглядела}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450703
					],
					"speakerTitle": "Орупэусу"
				},
				{
					"id": 722450703,
					"content": "Грустно? Чего грустить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722450704,
					"content": "Для барда от всего в этом мире веет скорбью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450705
					],
					"speakerTitle": "Орупэусу"
				},
				{
					"id": 722450705,
					"content": "Где есть встречи, там должны быть и расставания. Те, кто родился, однажды вернутся в землю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450706
					],
					"speakerTitle": "Орупэусу"
				},
				{
					"id": 722450706,
					"content": "#Воссоединения слишком коротки, чтобы смягчить боль от долгой разлуки... А что касается тебя, {M#путешественник}{F#путешественница}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450707
					],
					"speakerTitle": "Орупэусу"
				},
				{
					"id": 722450707,
					"content": "...путешествуют по разным странам только ищущие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450708
					],
					"speakerTitle": "Орупэусу"
				},
				{
					"id": 722450708,
					"content": "Местные жители, которые живут здесь уже долгое время, сочтут такое путешествие романтичным, но для самого путешественника оно может означать боль и страдания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450709
					],
					"speakerTitle": "Орупэусу"
				},
				{
					"id": 722450709,
					"content": "#Если бы ты {M#прибыл}{F#прибыла} раньше, я, возможно, спел бы для тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450710
					],
					"speakerTitle": "Орупэусу"
				},
				{
					"id": 722450710,
					"content": "Но я поклялся кое-кому, что не буду больше петь, пока не услышу её голос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450711
					],
					"speakerTitle": "Орупэусу"
				},
				{
					"id": 722450711,
					"content": "Я могу только пожелать тебе добиться успехов, хоть ты и выглядишь намного старше меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450712
					],
					"speakerTitle": "Орупэусу"
				},
				{
					"id": 722450712,
					"content": "Надеюсь, твои мечты исполнятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Орупэусу"
				}
			]
		}
	]
}