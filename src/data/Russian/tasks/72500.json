			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мамору",
					"Акира",
					"Гэнта"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 725000101,
					"content": "Беда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000102
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000102,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000103
					]
				},
				{
					"id": 725000103,
					"content": "Босс снова попал в переплёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000104
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000104,
					"content": "Всё произошло только что. Комиссия Тэнрё прислала указание временно приостановить наш фестиваль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000105
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000105,
					"content": "Не знаю что да как, но только кажется, что босс направил в Тэнсюкаку рекламную листовку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000106
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000106,
					"content": "Ещё и сказал, что сёгун, хоть ты тресни, должна посетить Грандиозный барабанный фестиваль великолепного Аратаки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000107
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000107,
					"content": "Хм. Думаю, что босс прав. Уверен, что сёгун действительно хотела бы принять участие в фестивале.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000108
					],
					"speakerTitle": "Акира"
				},
				{
					"id": 725000108,
					"content": "Именно! А ты разве не согласен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000109
					],
					"speakerTitle": "Гэнта"
				},
				{
					"id": 725000109,
					"content": "Ай, да кому есть дело до того, что мы думаем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000110
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000110,
					"content": "В общем, Окудзумэсю прям там и арестовали босса и отправили его в комиссию Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000111
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000111,
					"content": "И что же нам делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000112
					]
				},
				{
					"id": 725000112,
					"content": "Да Синобу, должно быть, уже со всем разобралась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000113
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000113,
					"content": "Говорят, что Окудзумэсю обвинили босса в разжигании беспорядков в военной зоне ограниченного доступа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000114
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000114,
					"content": "А потом Кудзё Сара заменила обвинение нарушением общественного порядка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000115
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000115,
					"content": "Ой-ёй-ёй! Эта ужасная тэнгу Кудзё предъявила боссу настолько серьёзное обвинение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000116
					],
					"speakerTitle": "Гэнта"
				},
				{
					"id": 725000116,
					"content": "Эх ты, голова два уха! Кудзё наоборот смягчила наказание, тебя что учи, что не учи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000117
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000117,
					"content": "А что касается фестиваля... нам остаётся только дожидаться возвращения босса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000118
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000118,
					"content": "#{NICKNAME}, не о чем переживать! Синобу обязательно всё уладит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000119
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000119,
					"content": "#Ты столько {F#помогала}{M#помогал} нам с фестивалем! Как только босс вернётся, он обязательно тебя отблагодарит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000120
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000120,
					"content": "Надеюсь, что твоё путешествие, как и наш фестиваль, со временем будет становиться всё лучше и лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000121
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 725000121,
					"content": "Лучше и лучше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мамору"
				}
			]
		}
	]
}