			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230201,
					"content": "Хм, всё-таки трав маловато...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230202
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230202,
					"content": "Тебе нужно собрать больше трав?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230203
					]
				},
				{
					"id": 718230203,
					"content": "Ага, я как раз собиралась идти. Каждый год в эти дни я стараюсь собрать про запас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230204
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230204,
					"content": "Да и не сильнодействующих, а самых основных трав... От лихорадки там, или несварения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230205
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230205,
					"content": "Почему бы просто не купить лекарств в хижине «Бубу»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230206
					]
				},
				{
					"id": 718230206,
					"content": "Проблема в том, что до неё очень далеко ходить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230207
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230207,
					"content": "К тому же в деревне Цинцэ одни дети и старики. В отличие от такого искателя приключений, как ты, им такой путь не одолеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230208
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230208,
					"content": "Поэтому я заготавливаю травки для лечения незначительных недугов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230209
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230209,
					"content": "Но если кого-нибудь сразит серьёзная болезнь, нам понадобятся соответствующие лекарства, которые можно достать только в хижине «Бубу». Ах, надеюсь, такого не произойдёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230210
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230210,
					"content": "Поговорим позже, мне нужно собрать больше трав, а потом вернуться и обработать их...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230211
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230211,
					"content": "Я помогу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230212
					]
				},
				{
					"id": 718230212,
					"content": "Что? Правда? Это просто замечательно! Я уже думала, что буду веки вечные собирать травы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230213
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230213,
					"content": "Так... Мне ещё нужно три вида трав.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230214
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230214,
					"content": "Хм... Один из них - цветки цинсинь, которые растут в горах. Они полезны для пищеварения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230215
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230215,
					"content": "Другой - лилия калла, которая растёт у берегов рек. Она помогает устранить лишнюю влагу и застой крови.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230216
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230216,
					"content": "Лилии калла растут и в других местах, но с той, что у рек, им по эффективности не сравниться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230217
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230217,
					"content": "И, наконец, чашечка лотоса. Она укрепляет сердце и успокаивает разум. Растёт в водоёмах поблизости, и собирать её нужно в определённое время - между полуночью и шестью утра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи"
				}
			]
		},
		{
			"id": 7182307,
