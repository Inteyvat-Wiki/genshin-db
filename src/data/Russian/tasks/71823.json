			},
			"dialogs": [
				{
					"id": 718230701,
					"content": "Погоди... Сейчас не лучшее время собирать чашечки лотоса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718230702,
					"content": "Насколько Паймон помнит... Чжи велела собирать их между полуночью и шестью утра. Надо подождать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7182308,
			"completionStepIds": [
				7182306,
				7182308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
