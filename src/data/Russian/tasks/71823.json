			},
			"dialogs": [
				{
					"id": 718230801,
					"content": "Теперь у нас всё есть. Отнесём травы Чжи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7182309,
			"completionStepIds": [
				7182309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182309",
							"2"
						],
						"stepId": 7182309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230901,
					"content": "#С возвращением! Ты все травы собрал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230902
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718230902,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230903
					]
				},
				{
					"id": 718230903,
					"content": "Спасибо за помощь. Я также попросила мисс Бай помочь с обработкой трав. Давай отнесём их на мельницу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи"
				}
			]
		},
		{
			"id": 7182310,
			"completionStepIds": [
				7182310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182310",
							"2"
						],
						"stepId": 7182310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мисс Бай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718231001,
					"content": "...О, я сейчас же позабочусь о травах. Когда я закончу, ты сможешь сразу же вернуться и приступить к приготовлению лекарств.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231002
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 718231002,
					"content": "Спасибо. Как бы эти лекарства подсластить?.. Иначе дети ни за что их принимать не станут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231003
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718231003,
					"content": "У тебя в эту пору всегда так много забот?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231004
					]
				},
				{
					"id": 718231004,
					"content": "Да, более или менее... Всё-таки в деревне Цинцэ молодёжи почти нет, и мы помогаем, чем можем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231005
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 718231005,
					"content": "Ничего, что в эти дни много работы. К тому же твоя помощь здорово нам всё облегчила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231006
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718231006,
					"content": "Раньше у меня много дней уходило на сбор трав, не говоря уже об изготовлении лекарств...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231007
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718231007,
					"content": "Ну, спасибо, что помогли. Я обработаю травы, а потом подготовлю свой небесный фонарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231008
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718231008,
					"content": "Надо бы не забыть запустить его, а не как в прошлом году...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231009
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718231009,
					"content": "Какое желание ты загадаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231010
					]
				},
				{
					"id": 718231010,
					"content": "Хм... Здоровья всем в деревне Цинцэ? Хе-хе, что-нибудь в этом роде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231011
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718231011,
					"content": "Но если рассказать о своём желании, то оно не исполнится, поэтому больше я ничего не скажу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231012
					],
					"speakerTitle": "Чжи"
				},
				{
					"id": 718231012,
					"content": "#А это тебе. Спасибо, что выручил{F#а} меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи"
				}
			]
		},
