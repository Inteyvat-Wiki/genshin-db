					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890101,
					"content": "Ого, какое длинное письмо! Наверное, Чжи Цюн его тут оставила!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710890102,
					"content": "Да, это её...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890103
					]
				},
				{
					"id": 710890103,
					"content": "Хм, а куда же она подевалась? Давай сначала расскажем о случившемся Цзинь У.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7108902,
			"completionStepIds": [
				7108903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108903",
							"2"
						],
						"stepId": 7108903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзинь У"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "Цзинь У, смотри, что мы нашли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710890202,
					"content": "Ладно-ладно, что вы там нашли? И как это связано с исчезновением Чжи Цюн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710890203,
					"content": "Это её письмо. Она ушла ещё глубже в Разлом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "Спасибо! Дайте-ка я гляну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710890205,
					"content": "Цзинь У внимательно читает письмо.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "Ох уж эта девчонка... Я никогда не задумывалась над такими большими проблемами, так что не мне критиковать её выбор. Но, возможно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710890207,
					"content": "Возможно, я не признала её открытия вовремя или не проявила к ней столько уважения или понимания, сколько следовало бы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710890208,
					"content": "Было бы несоизмеримо труднее завершить наше исследование без её карт... Но я лишь заботилась о её здоровье и не обращала внимание на то, как тяжело она работает и сколько всего она сделала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710890209,
					"content": "Ах, как я раньше не понимала, что её работа отличалась от нашей, шахтёрской работы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710890210,
					"content": "Она просто не хочет быть забыта.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "Разве не все мы - люди, не пользующиеся благосклонностью богов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710890212,
					"content": "Разве не все мы... Но был ли кто-нибудь так же одержим, как она?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710890213,
					"content": "Но как только я думаю, что в какой-то момент отказалась от своей навязчивой идеи стать великой... как только я понимаю, что привыкла к повседневной обыденности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710890214,
					"content": "Я чувствую, что просто не имею права судить Чжи Цюн...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзинь У"
				}
			]
		}
	]
}