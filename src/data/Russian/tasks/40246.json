			},
			"dialogs": [
				{
					"id": 402460901,
					"content": "И всё?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460902,
					"content": "Всё. Я же говорила, это будет проще простого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460903
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460903,
					"content": "Как тебе это удалось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460904
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402460904,
					"content": "То скопление обид было лишь результатом соединения множества бездомных душ. К нему примешивалось много скверны и злых помыслов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460905
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460905,
					"content": "Я всего лишь отделила изначальные души от скверны, чтобы правила нынешнего мира могли принять их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460906
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460906,
					"content": "Мировая формула работает по принципу дивергенции. Отправляясь от одной точки отсчёта, она деконструирует и перестраивает возможности мира, чтобы найти среди них ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460907
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460907,
					"content": "Отсюда следует, что обратное вычисление мировой формулы позволяет нам достичь стяжения и восстановления. Иными словами, это технологическая инверсия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460908
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460908,
					"content": "Это похоже на концепцию гомологической реверсии в математике: не меняя сущность группы, я привела её к более простой и субстанциональной форме существования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460909
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460909,
					"content": "Так что... э-э, неважно. Судя по вашим лицам, вы и не хотите во всём этом разбираться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460910
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460910,
					"content": "Кажется, я понимаю, каково это - слушать объяснения шамана Повелителей Ночного Ветра, когда ты чужестранец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460911
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402460911,
					"content": "Э... В общем, Паймон поняла, это что-то невероятное! Ты и правда крутая, Сандроне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460912
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460912,
					"content": "Ещё бы, я всегда была крутой! Ха-ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460913
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460913,
					"content": "А что ещё ожидать от Деконструктора Всех Законов Мироздания...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460914
					]
				},
				{
					"id": 402460914,
					"content": "Так, хватит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460915
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460915,
					"content": "Ладно, нам пора! Я верну механизмы внутри Башни гештальта в исходное состояние. Увидимся на берегу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марионетка"
				}
			]
		},
