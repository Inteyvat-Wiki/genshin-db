			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Субретка"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3537.532,
							452.648,
							4178.716
						],
						"pointId": 16568
					},
					{
						"sceneId": 3,
						"position": [
							3538.825,
							452.648,
							4179.689
						],
						"pointId": 16573
					}
				]
			},
			"dialogs": [
				{
					"id": 402460201,
					"content": "Вчера Ситлали столько выпила... Интересно, она уже проснулась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460202,
					"content": "Доброе утро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460203
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460203,
					"content": "А-а-а! Коломбина! Ты... ты как здесь оказалась? Нет, постой, что ты здесь делаешь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460204,
					"content": "Сегодня утром мы пришли сюда все вместе доснять последние кадры, вот только что закончили. А теперь я решила подняться на палубу и подышать свежим воздухом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460205
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460205,
					"content": "Наша группа до сих пор обсуждает внизу финальную сцену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460206
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460206,
					"content": "Финальную сцену?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460207,
					"content": "Да, концовку фильма. Гадают, нашла ли в итоге главная героиня свою подругу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460208
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460208,
					"content": "Вот оно что... Паймон была так занята последние пару дней, что совсем забыла! Ведь наш фильм о том, как героиня отправляется в родной город пропавшей подруги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460209,
					"content": "Угу. Режиссёр Фурина и госпожа Тиори считают, что с точки зрения глубины истории трагический финал, где они так и не встретились, тронет зрителей сильнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460210
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460210,
					"content": "А режиссёр Ксавье считает, что, если героини встретятся, такая концовка будет более трогательной и утешительной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460211
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460211,
					"content": "А ты сама как думаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460212
					]
				},
				{
					"id": 402460212,
					"content": "Я? Я... не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460213
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460213,
					"content": "Если речь обо мне, я бы, конечно, выбрала встречу... Так хочется, чтобы она могла со мной встретиться... пусть даже в фильме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460214
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460214,
					"content": "Но ведь это значит, что её будет играть кто-то другой. И при мысли об этом я чувствую...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460215
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460216,
					"content": "Ты пока об этом не думай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460217
					]
				},
				{
					"id": 402460217,
					"content": "М?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460218
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460218,
					"content": "Да, не расстраивайся раньше времени. Кино надо снимать с удовольствием!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460219,
					"content": "И ещё... всё обязательно будет хорошо! Паймон гарантирует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460220,
					"content": "Хорошо? Что ты имеешь в виду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460221
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460221,
					"content": "Эм, ну... то есть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460222,
					"content": "Концовка будет хорошей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460223
					]
				},
				{
					"id": 402460223,
					"content": "Да-да! Вот именно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460224,
					"content": "Ха... ладно. Я вам верю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460225
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460225,
					"content": "Тогда я прислушаюсь к вашему совету и буду радоваться съёмкам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460226
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460226,
					"content": "#О? Да это же {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460227
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 402460227,
					"content": "Да? А я думала, это светотехник и кинохлопушка, которые прогуливают работу без уважительной причины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460228
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 402460228,
					"content": "#Эм... Простите... На этот раз мы с {M#путешественником}{F#путешественницей} в самом деле слишком часто отпрашивались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460229,
					"content": "Хе-хе, шучу. Не принимайте близко к сердцу. В этот раз съёмки идут вполне неплохо, так что можете спокойно заниматься своими делами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460230,
						402460231
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 402460230,
					"content": "Спасибо за понимание...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				},
				{
					"id": 402460232,
					"content": "О? Госпожа Коломбина, кажется, повеселела! Прости. Наверное, мы расстроили тебя, когда обсуждали концовку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460233
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 402460233,
					"content": "#Ничего страшного, со мной всё в порядке. {NICKNAME} и Паймон помогли мне отогнать мрачные мысли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460234
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460234,
					"content": "Да? Так какую концовку ты хотела бы снять? С встречей подруг или без?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460235
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 402460235,
					"content": "Хочу, чтобы концовка была хорошей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460236
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 402460236,
					"content": "...А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фурина"
				},
				{
					"id": 402460231,
					"content": "Мы обязательно отработаем...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				}
			]
		},
