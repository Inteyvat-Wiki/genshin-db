					}
				]
			},
			"dialogs": [
				{
					"id": 402460501,
					"content": "Кажется, никого нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460502
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460502,
					"content": "Мне начинать ритуал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460503
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402460503,
					"content": "Погодите, сначала надо спустить воду с этого этажа Башни гештальта. Так нам будет проще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460504
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460504,
					"content": "Воду можно спустить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460505,
					"content": "Конечно. Когда Ален и Рене независимо друг от друга увидели, что ждёт Фонтейн в будущем, они поделились друг с другом некоторыми методами гидроизоляции зданий. Принцип заключается в...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460506
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460506,
					"content": "Кхм, я отвлеклась. Короче говоря, делайте, как я говорю, и активируйте механизмы в правильном порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марионетка"
				}
			]
		},
		{
			"id": 4024607,
			"completionStepIds": [
				4024607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4024607",
							"2"
						],
						"stepId": 4024607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20359,
						"position": [
							2652.556,
							253.937,
							3640.104
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 402460701,
					"content": "Ты готова?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460702
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402460702,
					"content": "Да. Сначала я попробую с ними поговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460703
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460703,
					"content": "Но я боюсь, что эти сгустки душ уже потеряли рассудок. Если с ними не удастся договориться, возможно, нас ждёт сражение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460704
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460704,
					"content": "Ладно, тогда Паймон найдёт себе укромное местечко и будет сидеть там тихонько.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460705,
					"content": "Да, если дело дойдёт до драки, последний удар оставьте мне. Не вмешивайтесь. Доверьтесь мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460706
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460706,
					"content": "Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402460707,
					"content": "Хорошо, пока что мне нужна тишина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402460708,
					"content": "...Блуждающие души, плывущие по течению, я взываю к вам. Разделённые, покинутые, обречённые на молчание осколки душ, услышьте дыхание былых дней и вернитесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402460709,
					"content": "...Пусть безымянные обиды узнают друг друга, пусть запретная скверна притянется друг к другу. Соберитесь воедино и обретите форму!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402460710,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460712,
					"content": "(...А дальше? Или это всё?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460713,
					"content": "(Эх... вот почему я не умею работать со всей этой магией и тайными искусствами... Понятия не имею, на каком этапе находится алгоритм, да и логика заклинаний остаётся неясной.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460714,
					"content": "(Вот механика - другое дело...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460715,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460716
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460716,
					"content": "Осторожно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460717
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402460717,
					"content": "..!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460718
					],
					"speakerTitle": "Злоба блуждающих душ"
				},
				{
					"id": 402460718,
					"content": "Эй, ты! Или кто бы ни был внутри тебя... Слушайте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460719
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460719,
					"content": "Я наследница Алена Гильотена, Отца Механизмов. Я знаю, как восстановить вас и вернуть в артерии земли. Но вы должны мне помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460720
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460720,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460721
					],
					"speakerTitle": "Злоба блуждающих душ"
				},
				{
					"id": 402460721,
					"content": "Сандроне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460722
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402460722,
					"content": "Хм... Переубеждать вас бесполезно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460723
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402460723,
					"content": "Ладно, переходим к плану Б. Сейчас я помогу вам выпустить пар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марионетка"
				}
			]
		},
		{
			"id": 4024609,
			"completionStepIds": [
				4024609
			],
