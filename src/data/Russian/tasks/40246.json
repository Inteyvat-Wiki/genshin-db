						],
						"stepId": 4024612,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ситлали"
				],
				"points": [
					{
						"sceneId": 1161,
						"position": [
							120.083,
							16.223,
							67.002
						],
						"pointId": 23
					},
					{
						"sceneId": 1161,
						"position": [
							117.987,
							16.223,
							73.794
						],
						"pointId": 24
					}
				]
			},
			"dialogs": [
				{
					"id": 402461201,
					"content": "Ситлали, вот и мы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402461202,
					"content": "Ого. Вы даже не опоздали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461203
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402461203,
					"content": "Ну да... Это ведь ты вчера налегала на спиртное. Сама-то как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402461204,
					"content": "Что? Ты считаешь, бабуля не может позволить себе лишнюю рюмочку? Я от такой малости даже не опьянела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461205
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402461205,
					"content": "Да? Но ты несла всякий бред...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402461206,
					"content": "Ч-что? Я вот не помню. Я ведь не сказала ничего... такого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461207
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402461207,
					"content": "Ну... Полчаса ругала Оророна, ещё полчаса жаловалась на работу, час рассказывала содержание лёгкого романа... а потом... эм, кажется, потом Паймон заснула.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402461208,
					"content": "...Они ушли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461209
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402461209,
					"content": "Они? Ты про съёмочную группу? Да, мы как раз на палубе их встретили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402461210,
					"content": "Но раз ты решила свои проблемы, почему не идёшь к Коломбине? Она ведь очень хочет тебя увидеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402461211,
					"content": "Я... я хочу сначала разобраться с этим бардаком, а потом уже встретиться с ней. И вообще, мне выдалась возможность здоровски её напугать. Я обязана хорошенько всё спланировать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461212
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402461212,
					"content": "Но об этом потом. Ты выяснила, где находится скопление скверны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461213
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402461213,
					"content": "Конечно. Бабушка Ицтли всегда держит слово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461214
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402461214,
					"content": "Прекрасно. Посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461215
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402461215,
					"content": "Район Морт... Что? Это ведь Башня гештальта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461216
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402461216,
					"content": "Место иссечения душ. Значит, они затаили обиду на башню? Или на весь Ордо Нарциссенкрейц?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461217
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402461217,
					"content": "Я пойду с вами. Оно не всегда появляется на одном и том же месте. И если его там не окажется, я смогу призвать его с помощью кое-какого ритуала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461218
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402461218,
					"content": "Правда? Но мы и так добавили тебе работы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461219
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402461219,
					"content": "Ерунда. Моим старым косточкам полезно иногда потрудиться. И мне совсем не трудно помочь вам с этим ритуалом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461220
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402461220,
					"content": "(Если я не пойду, кто знает, о чём вы там будете разговаривать без меня?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461221
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 402461221,
					"content": "Хорошо, спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461222
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 402461222,
					"content": "Хе-хе, тогда не будем терять время. Отправляемся прямо сейчас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}