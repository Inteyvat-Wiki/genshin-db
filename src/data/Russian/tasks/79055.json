			},
			"dialogs": [
				{
					"id": 790550101,
					"content": "Это сцена из шоу «Косматая волна»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550102
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790550102,
					"content": "Изначально это была история крепкой дружбы двух Гидро эйдолонов, оказавшихся вдвоём на разбитом корабле посреди бушующих волн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550103
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790550103,
					"content": "Признавшись друг другу в своих чувствах, пара стоит на носу корабля в свете лучей заката. Это очень чувственная сцена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550104
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790550104,
					"content": "К сожалению, эту сцену пришлось исключить по причине чрезвычайной энергичности этих двух эйдолонов, которые буквально не могли стоять на месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550105
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790550105,
					"content": "Вот бы кто-то смог запечатлеть эту <color=#00E1FFFF>пару на носу корабля</color>. Получилась бы отличная сцена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550106
					],
					"speakerTitle": "Сценические заметки"
				},
				{
					"id": 790550106,
					"content": "Режиссёр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сценические заметки"
				}
			]
