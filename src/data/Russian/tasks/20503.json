				"points": []
			},
			"dialogs": [
				{
					"id": 205030201,
					"content": "Чем могу вам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030202,
						205030204
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030202,
					"content": "Я хочу новое оружие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030203
					]
				},
				{
					"id": 205030203,
					"content": "Посмотри вон там. Может, выберешь себе что-нибудь подходящее. Если нет, то я могу выковать тебе оружие на заказ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030207,
					"content": "Вы делаете оружие на заказ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 205030208,
					"content": "Конечно! Я продаю оружие, делаю оружие на заказ, чиню оружие. Я же кузнец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030209
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030209,
					"content": "Но главное в этом деле - руда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030210,
						205030212
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030210,
					"content": "Откуда вы её берёте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030211
					]
				},
				{
					"id": 205030211,
					"content": "Отовсюду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030214,
					"content": "У скал неподалёку есть месторождение железной руды. Могу отметить на твоей карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030215
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030215,
					"content": "Если принесёшь мне несколько кусков железной руды, я смогу для тебя что-нибудь выковать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030216
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030216,
					"content": "Понятно. Спасибо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030217
					]
				},
				{
					"id": 205030217,
					"content": "Не за что. А теперь перестаньте отвлекать меня от работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030212,
					"content": "Вы её продаёте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030213
					]
				},
				{
					"id": 205030213,
					"content": "Нет, зачастую мне самому её не хватает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030204,
					"content": "Паймон хочет оружие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030205
					]
				},
				{
					"id": 205030205,
					"content": "Что?! Зачем мне оружие? Ты хочешь, чтобы я тоже сражалась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 205030206,
					"content": "Какая малышка! Для неё только на заказ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "Вагнер"
				}
			]
		},
