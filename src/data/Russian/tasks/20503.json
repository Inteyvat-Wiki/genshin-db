			},
			"dialogs": [
				{
					"id": 205030601,
					"content": "Если найдёшь ещё руду, то знаешь, где меня искать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030602
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030602,
					"content": "Лучше, если я буду в это время свободен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030603
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030603,
					"content": "Почему у вас плохое настроение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030604
					]
				},
				{
					"id": 205030604,
					"content": "Потому что у кузнеца нет времени на пустую болтовню!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030605
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030605,
					"content": "Чем усерднее я работаю, тем лучше получается товар и тем лучше идёт торговля. Это самое главное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030606
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030606,
					"content": "#Ты всё сказал{F#а}? Мне нужно работать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вагнер"
				}
			]
		}
