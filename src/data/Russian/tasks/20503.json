			"dialogs": [
				{
					"id": 205030501,
					"content": "Что вам нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030502,
						205030503
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030502,
					"content": "Мы собрали железо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				},
				{
					"id": 205030504,
					"content": "Точно, совсем забыл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030505
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030505,
					"content": "Пойдёт. Может быть, из этих кусков что-нибудь и выйдет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030506
					],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030506,
					"content": "Что вы можете выковать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вагнер"
				},
				{
					"id": 205030503,
					"content": "Вы же сами отправили нас искать железо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				}
			]
		},
		{
			"id": 2050306,
			"completionStepIds": [
