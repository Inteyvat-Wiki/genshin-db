					"nextDialogs": [
						220360509,
						220360510,
						220360511
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 220360509,
					"content": "Сначала добавьте воду, затем добавьте измельченные листья, после чего перемешайте.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360512,
					"content": "Такая запутанная процедура... Хорошо, я понял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 220360510,
