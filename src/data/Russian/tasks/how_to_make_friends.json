			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тламот"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260101,
					"content": "Бедный маленький юмказавр... Я им покажу. Я проучу этих негодяев!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260102
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260102,
					"content": "Вы можете бежать, ничтожества, но вам не спрятаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260103
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260103,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260104
					]
				},
				{
					"id": 250260104,
					"content": "#Ты... {F#путешественница}{M#путешественник} из далёких земель? Приветствую! Прости, но сейчас я не могу оказать тебе должного гостеприимства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260105
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260105,
					"content": "Эти жалкие Похитители сокровищ снова вознамерились поймать детёныша юмказавра. К счастью, я успел вовремя и прогнал их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260106
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260106,
					"content": "Но бедняжка до смерти перепугался. Он отказывается подходить ближе, как бы я его ни звал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260107
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260107,
					"content": "Я нашёл их убежище и собираюсь преподать им урок, после чего привяжу их к дереву и хорошенько высеку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260108
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260108,
					"content": "А ещё нужно найти что-нибудь вкусненькое, чтобы утешить бедного испуганного юмказаврика...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тламот"
				}
			]
		},
		{
			"id": 2502602,
			"completionStepIds": [
				2502601,
				2502606
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502601",
							"2"
						],
						"stepId": 2502601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тламот"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260201,
					"content": "#Я бы для начала успокоил{F#а} его.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260202
					]
				},
				{
					"id": 250260202,
					"content": "#Хм... Ты прав{F#а}.... Бедняжка очень напуган. Хорошо. Пойдём сначала успокоим его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260203
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260203,
					"content": "#Тогда следуй за мной. Ты выглядишь как {F#опытная искательница}{M#опытный искатель} приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260204
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260204,
					"content": "Пока нас двое, эти разбойники не посмеют ничего предпринять. И не беспокойся об оплате. Я знаю правила Гильдии и буду им следовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260206
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260206,
					"content": "Этот малыш просто обожает свечевики... И, насколько я помню, их много вон под тем деревом. Пожалуйста, собери несколько.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260205
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260205,
					"content": "Я соберу свечевики на другой стороне. Когда закончишь, встретимся на утёсе возле стадиона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260207
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260207,
					"content": "Обычно малыш-завриан отдыхает в том месте. Возможно, мы найдём его там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тламот"
				}
			]
		},
		{
			"id": 2502603,
			"completionStepIds": [
				2502603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502603",
							"2"
						],
						"stepId": 2502603,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_LESS",
						"rawParams": [
							"2502601",
							"2"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тламот"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260301,
					"content": "Именно здесь он обычно проводит время, но сегодня его нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260302
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260302,
					"content": "Должно быть, он спрятался после того случая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260303
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260303,
					"content": "Поищем его?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260304
					]
				},
				{
					"id": 250260304,
					"content": "Нет. Оставим его в покое на некоторое время. Давай положим грибы здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260305
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260305,
					"content": "У тебя немало опыта, как я погляжу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260306
					]
				},
				{
					"id": 250260306,
					"content": "В заботе о малыше? Безусловно. Я довольно давно ухаживаю за ним, поэтому знаю, что он очень чувствителен. Он может испугаться при виде незнакомцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260307
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260307,
					"content": "Я довольно долго подкармливал его, пока он не решился подойти поближе... Но из-за этих негодяев он наверняка ещё долго не захочет выходить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260308
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260308,
					"content": "Нужно оставить его в покое на некоторое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260309
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260309,
					"content": "#Спасибо, что составил{F#а} мне компанию. Вот твоя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260310,
						250260311
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260310,
					"content": "Жаль, что мы его не увидели.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				},
				{
					"id": 250260312,
					"content": "Не волнуйся, он помнит тех, кто был добр к нему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260311,
					"content": "#Я бы с удовольствием {F#познакомилась}{M#познакомился} с ним.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				}
			]
		},
		{
			"id": 2502604,
