				"objectNames": [
					"Тламот"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260401,
					"content": "Пойдём, проучим этих Похитителей сокровищ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260402
					]
				},
				{
					"id": 250260402,
					"content": "#Хочешь пойти со мной? Спасибо! Твоя помощь не помешает. Сразу видно, что ты {F#опытная искательница}{M#опытный искатель} приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260403
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260403,
					"content": "Я вознагражу тебя по правилам Гильдии. Идём, покажем этим негодяям что к чему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тламот"
				}
			]
		},
		{
			"id": 2502605,
			"completionStepIds": [
				2502605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502605",
							"2"
						],
