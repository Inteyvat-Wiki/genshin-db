				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тламот"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1635.08,
							126.53,
							8876.872
						],
						"pointId": 350100057
					}
				]
			},
			"dialogs": [
				{
					"id": 250260501,
					"content": "Посмотрим, посмеют ли они ещё хоть раз обидеть моего юмказаврика!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260502
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260502,
					"content": "Такое ощущение, что произошло недопонимание...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260503
					]
				},
				{
					"id": 250260503,
					"content": "Не обращайте внимания на их благозвучные речи. Я своими глазами видел, как они привязали верёвку к хвосту несчастного юмказаврика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260504
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260504,
					"content": "Кто знает, что могло бы случиться, если бы я не появился вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260505
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260505,
					"content": "В любом случае спасибо за помощь. Вот, возьми свою награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260506
					],
					"speakerTitle": "Тламот"
				},
				{
					"id": 250260506,
					"content": "Жаль только, что они так быстро сбежали. Если бы мы их поймали, то смогли бы раз и навсегда покончить с их бесчинствами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тламот"
				}
			]
		},
