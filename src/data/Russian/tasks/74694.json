			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Барбелот"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3498.274,
							451.958,
							4735.029
						],
						"pointId": 17224
					}
				]
			},
			"dialogs": [
				{
					"id": 746940101,
					"content": "Значит, карту, которую я вытащила, всё-таки можно считать хорошей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940102
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940102,
					"content": "Хе-хе, судьба - это просто судьба. Она не делает различия между плохим и хорошим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940103
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940103,
					"content": "Однако, если говорить о выпавшей тебе карте «Сила» в прямом положении, то одно из её толкований отлично подходит твоему роду занятий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940104
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940104,
					"content": "Эта карта символизирует страсть, храбрость, уверенность и стремление, а также совершенную, непоколебимую любовь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940105
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940105,
					"content": "Какие бы сюрпризы ни подготовила тебе судьба, я уверена, что ты возьмёшь ситуацию под свой контроль и будешь уверенно идти к цели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940106
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940106,
					"content": "Ха-ха-ха-ха! Ты меня захвалила! По нашим правилам, если предсказание благоприятное, за гадание нужно платить больше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940107
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940107,
					"content": "Вот, я оставлю тебе свой кошелёк. Если найдётся время, не могла бы ты погадать моей команде?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940108
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940108,
					"content": "Хе-хе, я впервые слышу такую просьбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940109
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940109,
					"content": "Мы пересекли на этом корабле весь Тейват вдоль и поперёк, преодолевая ветры и волны. За все эти годы у каждого накопилась куча проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940110
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940110,
					"content": "Я их капитан, но некоторые проблемы даже я не в силах им помочь решить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940111
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940111,
					"content": "Встретив тебя, искусную предсказательницу, я подумала, что вдруг ты сможешь помочь им обрести душевное спокойствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940112
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940112,
					"content": "Что касается вознаграждения, не волнуйся, мы провернули несколько крупных сделок и неплохо заработали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940113
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940113,
					"content": "Звучит заманчиво, но я воздержусь. В моей колоде не так много карт, сколько у тебя подчинённых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940114
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940114,
					"content": "#О, {NICKNAME}, Паймон? Сколько лет, сколько зим! Вы тоже пришли погадать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940115,
						746940116
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940115,
					"content": "П-погадать?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940117
					]
				},
				{
					"id": 746940117,
					"content": "Я здесь по делам. И заодно помогаю одной особе найти новые торговые возможности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940118,
						746940119
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940118,
					"content": "Эта особа...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940120
					]
				},
				{
					"id": 746940120,
					"content": "Конечно же, госпожа Воля Небес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940121
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940121,
					"content": "Кто знает, какую авантюру она на этот раз придумала? Пару дней назад, совершенно неожиданно, она сказала мне, что в Фонтейне можно неплохо заработать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940122
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940122,
					"content": "Не успела я и слова сказать, как она достала подробный маршрут и велела мне следовать указанным торговым путям. Оказалось, что она уже послала людей на разведку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940123
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940123,
					"content": "В последнее время у меня не было никаких срочных дел, так что я последовала её совету, и знаешь что? Всё прошло как по маслу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940124
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940124,
					"content": "Дела, на которые я планировала потратить две недели, уладились всего за неделю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940125
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940125,
					"content": "Я подумала, раз уж мы оказались здесь, то почему бы не задержаться и не повеселиться. Поэтому я дала команде увольнение на берег, чтобы они могли отдохнуть и расслабиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940126
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940126,
					"content": "Вот вчера как раз забронировала зал в «Дебор Отеле», и мы отлично повеселились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940127
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940127,
					"content": "Они отсыпаются в гостинице, а я вышла подышать свежим воздухом, чтобы протрезветь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940128
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940128,
					"content": "Но не успела я пройти и пары шагов, как эта... эм, предсказательница остановила меня и предложила вытянуть карту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940129
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940129,
					"content": "Ты уже вытянула карту?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940130
					]
				},
				{
					"id": 746940130,
					"content": "Вот, это карта «Сила»... Выглядит как хорошая карта, а раз она в прямом положении, то, наверное, это делает её ещё лучше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940131
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940131,
					"content": "«Сила» в прямом положении... как бы это сказать, действительно очень похоже на Бэй Доу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746940132,
					"content": "Верно. А теперь я расскажу о другом значении...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940133
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940133,
					"content": "Только не говори, что оно плохое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940134
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940134,
					"content": "Я бы не сказала, что это хорошо или плохо, и... хе-хе, это не имеет прямого отношения к твоему будущему. Считай это «внеклассными размышлениями» после завершения гадания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940135
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940135,
					"content": "Очевидно, что ты обладаешь как огромной физической силой, так и непоколебимым духом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940136
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940136,
					"content": "Если проводить аналогию, ты подобна фонарю в ночи - рассеиваешь тьму и указываешь путь заблудшим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940137
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940137,
					"content": "Но знай, что свет притягивает не только заблудших и слабых. К фонарю слетаются насекомые, борясь за свет и тепло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940138
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940138,
					"content": "Пламя уверено, что способно согреть их всех, и потому готово гореть ещё ярче. Только так свет не потускнеет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940139
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940139,
					"content": "Вот бы кто-нибудь прогнал этих насекомых...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940140
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940140,
					"content": "Но если этого не произойдёт, то, возможно, однажды фонарь сгорит дотла, и всё ради нескольких недостойных паразитов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940141
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940141,
					"content": "...Но если подумать, то волноваться не о чем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940142
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940142,
					"content": "У меня есть подруга, которая знает, как помочь людям разобраться в ситуации, и... Ха-ха-ха, ей нравится избавляться от вредителей, прячущихся в укромных уголках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940143
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940143,
					"content": "Такие друзья - большая редкость. Судя по твоим словам, ты очень доверяешь своей подруге, и она не из тех, кто легко собьётся с пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940144
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940144,
					"content": "Она? Ха-ха-ха, если уж она собьётся с пути, то в Ли Юэ не останется никого, кто способен остаться на правильном пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940145
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940145,
					"content": "Возьмём, к примеру, эту поездку. Именно она указала путь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940146
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940146,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940147
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940147,
					"content": "Ха, теперь всё стало ясно! Я тут как раз подумала: если бы она и правда хотела заняться торговлей, она бы ни за что не позволила мне расслабляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940148,
						746940149
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940148,
					"content": "Это определённо в стиле Воли Небес.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940150
					]
				},
				{
					"id": 746940150,
					"content": "Хе-хе-хе, если коротко, Нин Гуан хотела, чтобы Бэй Доу взяла отпуск, но... но почему она пошла окольным путём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940151
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746940151,
					"content": "Уверена, она бы сказала что-то вроде: «Иногда приходится идти окольными путями. Только так можно найти кратчайшую дорогу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940152
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940152,
					"content": "Мне никогда не удастся разгадать все хитросплетения её ума. Ха... Да и ладно, она же рассчитывает на мою помощь в расширении торговых путей, так что вряд ли навредит мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940153
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940153,
					"content": "Моя карта «Сила» позволяет мне рассекать волны и смело двигаться вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940154
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940154,
					"content": "...Ох! Уже поздно. Пора вернуться и проверить ребят, а заодно помочь им протрезветь. Пора готовиться к отплытию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940155
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940155,
					"content": "#{NICKNAME}, Паймон, и вы, госпожа гадалка, ещё увидимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940156
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940156,
					"content": "Эта карта - редкое сокровище... Можно ли её подарить? Наверное, не стоит... Хм... Хотя можно дать посмотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940157
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 746940157,
					"content": "Свет, указывающий путь заблудшим... и тем, кто пришёл не только за его сиянием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940158
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940158,
					"content": "Интересно. Если будет время, стоит снова посетить Ли Юэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746940149,
					"content": "Даже чтобы отправить кого-то в отпуск, приходится прибегать к уловкам...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940150
					]
				},
				{
					"id": 746940119,
					"content": "Должно быть, это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940120
					]
				},
				{
					"id": 746940116,
					"content": "Что ты делаешь в Фонтейне, Бэй Доу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940117
					]
				}
			]
