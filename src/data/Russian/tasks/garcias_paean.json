			"trigger": {
				"objectNames": [
					"Гарсия",
					"Лу Тун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710981501,
					"content": "А вкус действительно не плох, но должен признаться, что это совершенно не похоже на то, что готовит господин Янь Сяо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981502
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710981502,
					"content": "Простите мое любопытство, но как?.. Как вы приготовили это блюдо? Каково было точное количество ингредиентов? Какие приправы вы использовали и как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981503,
						710981504
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710981503,
					"content": "Эй-эй! Полегче!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				},
				{
					"id": 710981505,
					"content": "Ах, да... приношу свои извинения. И всё же я хотел бы знать, как вы приготовили это блюдо. Пожалуйста, поподробнее - никогда не знаешь, откуда может прийти вдохновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981506
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710981506,
					"content": "Вы в подробностях описываете приготовление овощного супа...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710981507
					]
				},
				{
					"id": 710981507,
					"content": "Понятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981508
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710981508,
					"content": "Ох, слишком много переменных определяют вкус одного лишь блюда. Потребуется больше вычислений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981509
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710981509,
					"content": "Но, чтобы производить больше вычислений, мне нужно будет улучшить свою Числовую машину...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981510
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710981510,
					"content": "Надеюсь, в библиотеке Академии я найду вдохновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981511
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710981511,
					"content": "Зачем тебе вообще создавать эту машину?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981512
					]
				},
				{
					"id": 710981512,
					"content": "Хм, это хороший вопрос. Но прежде, чем я отвечу, позвольте мне спросить самому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981513
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710981513,
					"content": "Вы полагаете, что Числовая машина обладает сознанием?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981514,
						710981515
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710981514,
					"content": "Что ты имеешь в виду?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981516,
					"content": "Именно. Пожалуйста, задумайтесь над этим вопросом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981517
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710981517,
					"content": "Когда мы встретимся в следующий раз, то сможем обсудить оба вопроса - ваш и мой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981518
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710981518,
					"content": "А сейчас мне необходимо упорядочить некоторые данные... Лу Тун, приступим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981519
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710981519,
					"content": "Да, господин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981520
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710981520,
					"content": "#Пожалуйста, прими это, путешественни{F#ца}{M#к}. И не держи зла на господина Гарсию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981521
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710981521,
					"content": "Вы собираетесь в Сумеру?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981522
					]
				},
				{
					"id": 710981522,
					"content": "Да. Господин Гарсия желает изучить некоторые ресурсы в Академии, а меня наняли его сопровождать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981523
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710981523,
					"content": "#До встречи, путешественни{F#ца}{M#к}. Я был бы счастлив увидеться с тобой в Сумеру... Я полагаю, что господин Гарсия тоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710981515,
					"content": "Обладает ли Числовая машина... сознанием?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981504,
					"content": "Эм, мне бы хотелось немного личного пространства!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				}
			]
