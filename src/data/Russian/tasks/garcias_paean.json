						710980702
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980702,
					"content": "Господин Гарсия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980703
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980703,
					"content": "Нет, нет, ну почти... Погодите-ка, ещё нет. Очаровательно. Просто очаровательно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980704
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980704,
					"content": "Господин Гарсия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980705
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980705,
					"content": "А, Лу Тун. Мой дорогой Лу Тун. Ты заказал блюдо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980706
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980706,
					"content": "Да, господин, я уже заказал овощной суп.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980707
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980707,
					"content": "Замечательно! Обо всём-то ты подумал, дорогой Лу Тун. Я уверен, что на этот раз мы получим формулу обработки этого блюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980708
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980708,
					"content": "Я очень на это надеюсь, господин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980709
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980709,
					"content": "А? О чём это они? И что за формула обработки такая?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980710,
						710980712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710980710,
					"content": "Мне тоже непонятно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980711
					]
				},
				{
					"id": 710980711,
					"content": "Тогда давай спросим у них. Может быть, они исследуют новое блюдо, а мы будем пробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710980712,
					"content": "Давай их спросим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980713
					]
				},
