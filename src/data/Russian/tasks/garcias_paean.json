				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лу Тун",
					"Гарсия",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980101,
					"content": "Господин, стоит отметить, что если принять во внимание сегодняшний день, то мы уже шесть дней кряду едим только овощной суп.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980102
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980102,
					"content": "Мы считаем, что несмотря на тяжёлое положение, нельзя пренебрегать обязательствами перед нашими желудками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980103
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980103,
					"content": "Верно, Лу Тун! В самое яблочко! Ты всегда такой проницательный!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980104
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980104,
					"content": "Может быть, именно из-за проблем с желудком мы не можем оценить вкус этого блюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980105
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980105,
					"content": "Нам нужны свидетели, Лу Тун! Нам нужно найти кого-то третьего!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980106
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980106,
					"content": "Вы мне льстите, господин. Но мысль моя была в том, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980107,
						710980108
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980107,
					"content": "Позвольте спросить, чем вы тут занимаетесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				},
				{
					"id": 710980109,
					"content": "Ага! А вот и наш свидетель и даже не один! Великолепно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980110
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980110,
					"content": "А? Что? Какой свидетель?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710980111,
					"content": "Это ты о нас?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980112
					]
				},
				{
					"id": 710980112,
					"content": "Именно! Вы когда-нибудь ели овощной суп? Знаете его вкус? А как его готовить, знаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980113
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980113,
					"content": "Господин, полагаю, сперва нужно проинформировать их о причинах возникшей ситуации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980114
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980114,
					"content": "#О да, мы ели! И вкус знаем! {NICKNAME} умеет его готовить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710980115,
					"content": "Паймон, нас сперва должны проинформировать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980116
					]
				},
				{
					"id": 710980116,
					"content": "Да, позвольте мне рассказать вам о поручении... Надеюсь, вы будете склонны принять его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980117
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980117,
					"content": "Меня зовут Лу Тун, а это мой начальник господин Гарсия из Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980118
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980118,
					"content": "Господин Гарсия сейчас разрабатывает некую... эм... так называемую Числовую машину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980119
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980119,
					"content": "Точнее, это такой инструмент, который позволит выполнять вычисления. Я прав, господин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980120
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980120,
					"content": "Точнее и быть не может, мой дорогой Лу Тун. Ты очень чётко и лаконично описал функции Числовой машины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980121
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980121,
					"content": "Верно, лаконично... Мы должны быть лаконичны. Эти преобразования такие сложные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980122
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980122,
					"content": "Но при чём тут овощной суп?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710980123,
					"content": "А об этом нам сейчас расскажет господин Гарсия. Верно, господин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980124
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980124,
					"content": "Как бы это попроще объяснить... О, сейчас я вам расскажу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980125
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980125,
					"content": "Хм... Давайте начнём с элементарного. Знакомы ли вы с формулами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980126
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980126,
					"content": "Формулы?.. Ну... Э...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710980127,
					"content": "Я тоже не совсем понимаю, что вы хотите сказать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980128
					]
				},
				{
					"id": 710980128,
					"content": "Ладно, ничего... Можно сказать, формула - это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980129
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980129,
					"content": "Уравнение, которое используется для выражения взаимосвязи между различными величинами и которое обладает определённой общей применимостью...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980130
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980130,
					"content": "Э?.. Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710980131,
					"content": "Звучит солидно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980132
					]
				},
				{
					"id": 710980132,
					"content": "Проще говоря, мы намерены использовать Числовую машину, чтобы попытаться составить рецептурную формулу овощного супа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980133
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980133,
					"content": "Господин Гарсия полагает, что если мы получим правильную формулу, мы сможем преобразовать метод приготовления овощного супа в...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980134
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980134,
					"content": "...своего рода стандартную процедуру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980135
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980135,
					"content": "...своего рода процедуру для самых глупых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980136
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980136,
					"content": "При соблюдении этой процедуры любой желающий сможет приготовить вкусный овощной суп.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980137
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980137,
					"content": "Звучит заманчиво... А вы не можете просто попросить кого-нибудь научить вас готовить этот суп?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980138
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710980138,
					"content": "К сожалению, такой метод слишком сильно зависит от природного таланта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980139
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980139,
					"content": "Для таких людей, как мистер Гарсия и я, у которых вообще отсутствует какая-либо кулинарная предрасположенность, маловероятно, что мы смогли бы понять суть каких-либо уроков, которые мог бы преподать нам любой повар, каким бы терпеливым он ни был.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980140
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980140,
					"content": "На самом деле, я полагаю, что господин улыбчивый Янь Сяо из этой самой гостиницы глубоко это прочувствовал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980141,
						710980143
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980141,
					"content": "Вы хотите, чтобы мы помогли вам с формулой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980142
					]
				},
				{
					"id": 710980142,
					"content": "Отнюдь. Я ни в коем случае не стал бы вас так утруждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980145,
					"content": "Точнее сказать, мы бы хотели, чтобы вы выступили нашей третьей стороной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980146
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980146,
					"content": "Проще говоря, нужно, чтобы вы попробовали овощной суп, который приготовит по формуле господин Гарсия, и сказали нам своё мнение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980147
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980147,
					"content": "Значит, вы позвали нас покушать, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980148
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710980148,
					"content": "Ты немножечко всё упростила, Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980149
					]
				},
				{
					"id": 710980149,
					"content": "Ну и ладно! Вообще-то, Паймон никогда не ела овощной суп, приготовленный по формуле! Давайте пробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980150
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710980150,
					"content": "Значит, решено. В таком случае прошу на кухню. Господин Янь Сяо любезно разрешил ею воспользоваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980151
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980151,
					"content": "Господин Гарсия? Мы придерживаемся старой последовательности в эксперименте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980152
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 710980152,
					"content": "Хм? Ох, прошу прощения, я немного отвлёкся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980153
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980153,
					"content": "Никак не могу сладить с параметрами, что всплывают у меня в голове... Впрочем, да, давайте продолжим наш предыдущий трёхэтапный процесс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980143,
					"content": "Значит, вы хотите, чтобы мы научили вас готовить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980144
					]
				},
				{
					"id": 710980144,
					"content": "Ну... не совсем так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 710980108,
