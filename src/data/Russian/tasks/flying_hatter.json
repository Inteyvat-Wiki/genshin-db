			"dialogs": [
				{
					"id": 790720101,
					"content": "#Какая честь! Вы, должно быть, {NICKNAME}, а рядом с вами ваша спутница Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720102
					],
					"speakerTitle": "Девитт"
				},
				{
					"id": 790720102,
					"content": "Хи-хи, верно, это мы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790720103,
					"content": "Неужели мы настолько знамениты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720104
					]
				},
				{
					"id": 790720104,
					"content": "Новости в Столице Созвездия распространяются быстрее, чем где бы то ни было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720105
					],
					"speakerTitle": "Девитт"
				},
				{
					"id": 790720105,
					"content": "Вы как раз вовремя, я только что закончил работу над игрой, которая называется «Летающая шляпа».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720106
					],
					"speakerTitle": "Девитт"
				},
				{
					"id": 790720106,
					"content": "К сожалению, я не могу, подобно шляпнику из «Летающей шляпы», сделать так, чтобы у каждого была красивая шляпа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720107
					],
					"speakerTitle": "Девитт"
				},
				{
					"id": 790720107,
					"content": "Но зато я уверен, что игра «Летающая шляпа» доставит радость всем, кто в неё сыграет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720108
					],
					"speakerTitle": "Девитт"
				},
				{
					"id": 790720108,
					"content": "К тому же я придумал три разных способа ведения игры... Ах да! Правила элементарные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720109
					],
					"speakerTitle": "Девитт"
				},
				{
					"id": 790720109,
					"content": "Уверен, вы разберётесь, что к чему, уже после первой партии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720110,
						790720112
					],
					"speakerTitle": "Девитт"
				},
				{
					"id": 790720110,
					"content": "Я хочу сыграть!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720111
					]
				},
				{
					"id": 790720111,
					"content": "Легко! Сюда, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Девитт"
				},
				{
					"id": 790720112,
					"content": "К сожалению, у меня сейчас нет времени...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720113
					]
				},
				{
					"id": 790720113,
					"content": "Ничего страшного. Приходите, когда будете свободны. Я буду здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Девитт"
				}
			]
		}
	]
