					}
				]
			},
			"dialogs": [
				{
					"id": 745140101,
					"content": "Так холодно... Мне определённо не следовало выходить в такую ветреную погоду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140102
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140102,
					"content": "#А? {NICKNAME}! Паймон! Вы... Апчхи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140103
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140103,
					"content": "Асагири, откуда ты здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140104
					]
				},
				{
					"id": 745140104,
					"content": "Как ты себя чувствуешь? Ты проделала такой долгий путь в одиночку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745140105,
					"content": "Я... Ну... Вроде бы лучше! Видишь, кашель уже не беспокоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140106
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140106,
					"content": "Ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140107,
						745140108
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140107,
					"content": "Правда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				},
				{
					"id": 745140109,
					"content": "Не надо! Признаюсь, я сама сбежала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140110
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140110,
					"content": "У меня не было выбора. Как можно писать прекрасные картины, сидя всё время в Инадзуме?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140111
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140111,
					"content": "Даже если я попрошу тебя фотографировать для меня, фотографии не сравнятся с тем, что видишь своими глазами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140112
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140112,
					"content": "Поэтому я попросила автора, с которым работала раньше, договориться с торговым судном, незаметно села на корабль и отправилась в путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140113
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140113,
					"content": "И ты даже взяла с собой всё, необходимое для рисования...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140114
					]
				},
				{
					"id": 745140114,
					"content": "Ну, конечно же! Холсты - это моя душа! Как мне без них?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140115
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140115,
					"content": "К тому же мои картины продаются в Фонтейне очень хорошо. Несколько фонтейнских авторов даже попросили меня создать обложки для их романов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140116
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140116,
					"content": "Хотя... Видимо, иллюстрации к романам для них пока в новинку! Очень странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140117
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140117,
					"content": "#Ах да, раз уж ты здесь, {NICKNAME}... Поможешь собрать кое-какие справочные материалы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140118,
						745140120
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140118,
					"content": "Я помогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140119
					]
				},
				{
					"id": 745140119,
					"content": "Отлично! С твоей помощью я точно справлюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140123,
					"content": "Хорошо, так-так. У меня есть несколько заказов от авторов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140120,
					"content": "Хорошо, но не убегай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140121
					]
				},
				{
					"id": 745140121,
					"content": "Да, мне не справиться с меками в одиночку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140122
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140122,
					"content": "Тебе нет равных в сражениях со всякими странными монстрами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 745140108,
					"content": "Мне нужно написать письмо и узнать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				}
			]
		}
	]
}