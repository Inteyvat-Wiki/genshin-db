				]
			},
			"dialogs": [
				{
					"id": 741401101,
					"content": "Ну вот мы и снова встретились. О, так в этот раз здесь ещё и Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401102
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401102,
					"content": "Эй, Паймон была здесь в прошлую нашу медитацию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741401103,
					"content": "Правда? Должно быть, из головы вылетело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401104
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401104,
					"content": "Благодаря вам я смогла отыскать место с тайным зеркалом и место, где распускаются цветы. Теперь я лучше понимаю окружающий мир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401105
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401105,
					"content": "Мда... а говорит она всё так же странно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741401106,
					"content": "Гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401107
					]
				},
				{
					"id": 741401107,
					"content": "А? Но ведь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401108
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401108,
					"content": "У-у-у! Гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401109
					]
				},
				{
					"id": 741401109,
					"content": "Ладно, ладно, я поняла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401110
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401110,
					"content": "(Хм... о чём она говорит со щенком? Может быть, все мелюзины понимают язык животных?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741401111,
					"content": "(Это невероятно.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401112
					]
				},
				{
					"id": 741401112,
					"content": "Ничего не поделать. Встретимся в следующий раз. Пф, и несмотря на все твои слова я всё равно вернусь, чтобы с тобой поиграть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401113
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401113,
					"content": "#Идём, {NICKNAME}, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Канотила"
				}
			]
		},
		{
			"id": 7414013,
			"completionStepIds": [
				7414013
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
