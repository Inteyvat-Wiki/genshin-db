						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Канотила"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2560.912,
							232.03,
							4709.944
						],
						"pointId": 6282
					},
					{
						"sceneId": 3,
						"position": [
							2560.522,
							232.133,
							4711.404
						],
						"pointId": 6283
					}
				]
			},
			"dialogs": [
				{
					"id": 741401301,
					"content": "А? Мы опять здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401302
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401302,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741401303,
					"content": "Если честно, мне и самой кажется, что говорить так - немного своевольно. Все ведь были так ко мне добры, да и вы тоже. Однако...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401304
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401304,
					"content": "Вам не кажется, что реальный мир ужасно скучен? Что в книгах всё как-то прекраснее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401305,
						741401307,
						741401309
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401305,
					"content": "#Да, соглас{M#ен}{F#на}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401306
					]
				},
				{
					"id": 741401306,
					"content": "Ты и правда так думаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741401311,
					"content": "Мне вот кажется, что самый прекрасный мир именно в Книге Откровения. Кругом увенчанные росой лепестки, и я наконец-то подружилась с собачкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401312
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401312,
					"content": "Собачка... кстати, Канотила, ты что, понимаешь их язык?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741401313,
					"content": "Конечно, нет. Просто собаки в Книге Откровения особенные. Или, быть может, особенная я?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401314
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401314,
					"content": "Я постоянно медитировала и перемещалась в мир книги, чтобы поиграть с ними. Пока однажды очередное «гав» не зазвучало для меня как что-то осмысленное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401315
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401315,
					"content": "С щеночком мы говорили вот о чём... Он уговаривал меня уйти и больше не возвращаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401316
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401316,
					"content": "Эх, но разве могу я расстаться с прекрасными подсолнухами, распускающимися на лугу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401317
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401317,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401318
					]
				},
				{
					"id": 741401318,
					"content": "Д-да уж... Ну, береги себя, Канотила! Нам надо спешить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741401307,
					"content": "Я так не думаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401308
					]
				},
				{
					"id": 741401308,
					"content": "Вот как... наверное, это правильно. Мои же мысли несколько странные для остальных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741401309,
					"content": "Мне мир и там, и там нравится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401310
					]
				},
				{
					"id": 741401310,
					"content": "#Похоже, ты очень тв{F#ерда}{M#ёрд} в своих идеях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Канотила"
				}
			]
		}
	]
}