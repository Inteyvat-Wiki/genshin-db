					},
					{
						"sceneId": 3,
						"position": [
							3590.907,
							435.092,
							4531.985
						],
						"pointId": 7520
					},
					{
						"sceneId": 3,
						"position": [
							3591.538,
							435.092,
							4530.267
						],
						"pointId": 7521
					}
				]
			},
			"dialogs": [
				{
					"id": 741510501,
					"content": "Атос, которого вы видели раньше, открывает дверь и выходит из дома.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510502
					]
				},
				{
					"id": 741510502,
					"content": "Опять вы? Что вам нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510503
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741510503,
					"content": "Скажите, пожалуйста, Бенуа дома? Мы слышали, что он заболел, и мы волнуемся за него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510504,
					"content": "Мой отец дома, но он не в состоянии принимать гостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510505
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741510505,
					"content": "Можно узнать, чем он болен? Я могу попросить своих родителей достать ему лекарство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510506
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510506,
					"content": "Не нужно. Мы сами купим все необходимые лекарства. Отец не испытывает в них недостатка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510507
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741510507,
					"content": "Мы беспокоимся о нём. Не надо быть таким суровым...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510508,
					"content": "(Атос наотрез отказывается пускать нас к Бенуа!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510509,
						741510510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510509,
					"content": "(Его холодность совершенно излишня...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				},
				{
					"id": 741510511,
					"content": "Вас не должны волновать чужие дела. Ясно? Что-нибудь ещё? Если нет, то я вернусь в дом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510512
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741510512,
					"content": "Подожди.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510513
					]
				},
				{
					"id": 741510513,
					"content": "Что тебе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510514,
						741510516
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741510514,
					"content": "Бенуа правда болен?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510515
					]
				},
				{
					"id": 741510515,
					"content": "Конечно. Причём очень серьёзно. Но мы с Мортишей найдём способ ему помочь. Вам не стоит беспокоиться. И другим тоже, если уж на то пошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741510518,
					"content": "Атос, что за шум?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510519
					],
					"speakerTitle": "Мортиша"
				},
				{
					"id": 741510519,
					"content": "Ничего, Мортиша, детишки говорят, что хотят увидеть папу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510520
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741510520,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510521
					],
					"speakerTitle": "Мортиша"
				},
				{
					"id": 741510521,
					"content": "А ты хорошо ладишь с детьми, да, папа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510522
					],
					"speakerTitle": "Мортиша"
				},
				{
					"id": 741510522,
					"content": "Ну, раз дети хотят тебя видеть, почему бы тебе не поздороваться с ними?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510523
					],
					"speakerTitle": "Мортиша"
				},
				{
					"id": 741510523,
					"content": "...Я бы очень хотел... А можно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510524
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741510524,
					"content": "Конечно, можно, папа. Ты ведь главный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510525
					],
					"speakerTitle": "Мортиша"
				},
				{
					"id": 741510525,
					"content": "Дверь открывается, и из неё медленно выходит Бенуа.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741510526
					]
				},
				{
					"id": 741510526,
					"content": "#А, это снова вы, {F#малышки}{M#малыши}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510527
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741510527,
					"content": "У вас всё в порядке, господин Леруа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510528
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510528,
					"content": "У меня? Кхе... Не совсем, но не волнуйтесь, я делаю всё возможное, чтобы отдохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510529
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741510529,
					"content": "Дочь и зять очень хорошо обо мне заботятся, так что всё в порядке. Идите домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510530
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741510530,
					"content": "Ты уверен, что с тобой всё в порядке, отец? Если тебе тяжело, лучше вернись в дом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510531
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741510531,
					"content": "Бенуа внимательно смотрит в глаза Атоса и молча возвращается в дом.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510532
					]
				},
				{
					"id": 741510532,
					"content": "Ну? Вот вы его и увидели. Мой отец правда нездоров. Теперь вы довольны? Если вам больше ничего не нужно, я пойду в дом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510533
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741510533,
					"content": "Мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510534
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510534,
					"content": "Атос вас игнорирует.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510535
					]
				},
				{
					"id": 741510535,
					"content": "По крайней мере, мы смогли сказать несколько слов господину Леруа. Ох, надеюсь, он скоро поправится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510536
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510536,
					"content": "Кажется, я доставила им хлопоты, сестрица Паймон. Это... я не этого хотела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510537
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510537,
					"content": "Не надо так думать! Ты не доставила никаких хлопот! На самом деле, Паймон считает, что Атос - самая настоящая проблема!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510538
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510538,
					"content": "Хм. Всё это время он...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510539,
						741510540
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510539,
					"content": "Иди домой, Молли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510541,
					"content": "#А? {NICKNAME}, ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510542
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510542,
					"content": "И правда, мне пора возвращаться. Родители не любят, когда я прихожу сюда. Они разозлятся, если узнают, где я сегодня была...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510543
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510543,
					"content": "Не знаю, удастся ли нам снова увидеть господина Леруа. Мне очень хочется сказать ему, что его угощение было очень вкусным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510544
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510544,
					"content": "Не могли бы вы передать ему это при встрече? Когда он поправится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510545,
						741510546
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510545,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510547,
					"content": "Паймон тоже обещает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510548
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510548,
					"content": "#Ура! Спасибо, {M#братец}{F#сестрица} {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510549
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510549,
					"content": "Мне пора домой. До встречи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510550
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510550,
					"content": "#Что скажешь, {NICKNAME}? Похоже, тебе есть что сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510551,
						741510552
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510551,
					"content": "Давай отойдём в сторонку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510553,
					"content": "Конечно, давай найдём подходящее место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510552,
					"content": "Это разговор не для чужих ушей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510546,
					"content": "Обещаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510540,
					"content": "Мы с Паймон тоже пойдём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510516,
					"content": "Почему ты не хочешь, чтобы мы навестили Бенуа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510517
					]
				},
				{
					"id": 741510517,
					"content": "С какой стати я должен пускать к отцу посторонних людей? Как я уже говорил, он не в том состоянии, чтобы принимать гостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741510510,
					"content": "(Он быстро сбавил накал...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				}
			]
		},
