			"dialogs": [
				{
					"id": 741511001,
					"content": "В их отношениях с Бенуа есть что-то неправильное.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511002
					]
				},
				{
					"id": 741511002,
					"content": "Когда мы встретили их пару дней назад, всё казалось в порядке, но то, как они говорили сегодня, да, что-то настораживает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511003,
						741511005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741511003,
					"content": "Зять запугивает его.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511004
					]
				},
				{
					"id": 741511004,
					"content": "Ты имеешь в виду то, как зять посмотрел на него и заставил уйти в дом после того, как он сказал всего пару слов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511007
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741511007,
					"content": "Благодаря твоему анализу Паймон отчасти понимает, что это было за чувство неловкости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741511005,
					"content": "Дочь Бенуа запугивает его.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511006
					]
				},
				{
					"id": 741511006,
					"content": "Паймон не задумывалась об этом, но от того, как она говорила, у Паймон по коже побежали мурашки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511007
					],
					"speakerTitle": "Паймон"
				}
			]
