			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500501,
					"content": "Как у тебя со сном в последнее время, отец? Бессонница всё ещё бывает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741500502,
					"content": "Мне гораздо лучше. Кошмары почти не беспокоят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741500503,
					"content": "(Вам становится сложно разобрать, что говорят в доме Леруа...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Постучать"
				}
			]
		},
		{
			"id": 7415101,
			"completionStepIds": [
				7415101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415101",
							"2"
						],
						"stepId": 7415101,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415104",
							"3"
						],
						"stepId": 7415104,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Молли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510101,
					"content": "О, это вы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510102
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510102,
					"content": "#Паймон - это Паймон, а {M#его}{F#её} зовут {NICKNAME}. Впредь называй нас так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510103,
					"content": "Ты пришла к Бенуа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510104
					]
				},
				{
					"id": 741510104,
					"content": "Верно, но я не смогла с ним поговорить... Ох, похоже, мне не удастся так написать сочинение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510105
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510105,
					"content": "Твоё сочинение? О, точно! Ты совершала добрые дела, чтобы сделать домашнее задание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510106,
					"content": "Не поэтому! Мне очень нравится господин Бенуа. Он очень... добробеспечный? Да, точно, добробеспечный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510107
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510107,
					"content": "Что ты имеешь в виду? Он добросердечный, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510108,
					"content": "В общем, прошу, сестрица Паймон, помогите мне, пожалуйста. Если не поможете, я не смогу написать сочинение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510109
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510109,
					"content": "Мой репетитор сказала, что моё сочинение о помощи в кормлении кошки «безыскусственное и переполнено эмоциями», и попросила написать другое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510110
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510110,
					"content": "Безыскусственное? Что это значит? Ты хотела сказать безыскусное? В общем, Паймон всё поняла. Так вот почему ты вернулась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510111,
					"content": "Да, это касается моей домашней работы, но мне правда очень нравится господин Леруа. Он попросил меня передать привет родителям от него, что я и сделала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510112
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510112,
					"content": "Им было не очень приятно слышать его имя, и они не хотят, чтобы я приходила сюда. Сама не знаю почему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510113
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510113,
					"content": "Ну, тема сочинения достаточно простая. Ты можешь рассказать о том, как вновь покормила кошку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510114,
					"content": "Но ведь это будет только одна строка! Слишком мало, ничего не получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510115
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510115,
					"content": "Мы можем пойти с тобой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510116
					]
				},
				{
					"id": 741510116,
					"content": "Да, точно. Ты покормишь кошку, а мы уберёмся вокруг дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510117,
					"content": "А когда мы закончим, то постучим в дверь и поговорим с Бенуа. Тебе ведь именно это нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510118,
					"content": "Да, верно, так и поступим! Ты такая умная, сестрица Паймон. Я сейчас же пойду кормить кошку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Молли"
				}
			]
		},
		{
			"id": 7415103,
			"completionStepIds": [
				7415103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
