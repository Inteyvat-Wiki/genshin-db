			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Молли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510301,
					"content": "#Сестрица Паймон, {M#братец}{F#сестрица} {NICKNAME}, я покормила кошку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510302
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510302,
					"content": "Отлично! Тогда пойдёмте к господину Леруа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510303,
					"content": "Я боюсь, а вдруг он не выйдет? Я недавно приходила, но он не стал со мной говорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510304
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510304,
					"content": "Я постучала перед вашим приходом, но как только он вышел, появился страшный дяденька зять и затащил его обратно в дом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510305
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510305,
					"content": "Затем он дал мне немного сладостей, сказал, чтобы я шла домой к родителям, и закрыл дверь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510306
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510306,
					"content": "Ну и дела. Бенуа такой дружелюбный, почему члены его семьи необщительные?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510307,
					"content": "Зять господина Леруа сказал, что его тесть болен и к нему нельзя в гости. Хотя мне показалось, что он выглядит вполне здоровым. Почему он не мог поговорить со мной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510308
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510308,
					"content": "Честно говоря, я волнуюсь за господина Леруа больше, чем за своё сочинение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510309
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510309,
					"content": "Он, наверное, ужасно себя чувствует, если болеет. Мама говорила, что больным людям нужна забота и уход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510310
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510310,
					"content": "Не могли бы вы пойти со мной и спросить у его зятя, чем болен господин Леруа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510311
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510311,
					"content": "Может, он съел слишком много сладостей или не укрылся потеплее, когда спал? Я могу спросить у родителей, что делать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510312,
						741510313
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510312,
					"content": "Давайте сначала постучим в дверь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				},
				{
					"id": 741510314,
					"content": "Я знаю, но... я немного боюсь этого страшного дяденьку зятя, потому что он... страшный. Не могли бы вы поговорить с ним?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510315
					],
					"speakerTitle": "Молли"
				},
				{
					"id": 741510315,
					"content": "Не бойся, Молли. Мы поможем тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741510313,
					"content": "Мы ведь договорились, разве нет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				}
			]
		},
