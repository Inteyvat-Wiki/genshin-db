			"dialogs": [
				{
					"id": 700650101,
					"content": "Некоторые совсем не желают слушать. Говорю же, сейчас не лучшее время для восхождения на гору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650102
					],
					"speakerTitle": "Манн"
				},
				{
					"id": 700650102,
					"content": "Эй-эй, Манн, не надо так волноваться. Успокойся и давай поговорим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650103
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 700650103,
					"content": "Мы только что прекрасно общались в «Ночном настое».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650104
					],
					"speakerTitle": "Липпхарт"
				},
				{
					"id": 700650104,
					"content": "Но как только я упомянула, что направляюсь на Пик ветров, он схватил меня и притащил сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650105
					],
					"speakerTitle": "Липпхарт"
				},
				{
					"id": 700650105,
					"content": "Ой, это же Хоффман! Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700650106,
					"content": "Как видишь, Манн настоятельно рекомендует держаться подальше от Пика ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650107
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 700650107,
					"content": "Позвольте представить. Липпхарт, искательница приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650108
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 700650108,
					"content": "То, что я видел... То, что я чувствовал... Это было ужасно! Поверьте, вы не захотите это испытать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650109
					],
					"speakerTitle": "Манн"
				},
				{
					"id": 700650109,
					"content": "Сегодня я никуда уже не пойду, так что давайте послушаем. Считайте это продолжением застольной беседы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650110
					],
					"speakerTitle": "Липпхарт"
				},
				{
					"id": 700650110,
					"content": "Итак, насколько это опасно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650111
					],
					"speakerTitle": "Липпхарт"
				},
				{
					"id": 700650111,
					"content": "В санатории и правда есть призраки! Я видел их своими глазами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650112
					],
					"speakerTitle": "Манн"
				},
				{
					"id": 700650112,
					"content": "Призраки?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700650113,
					"content": "Это случилось прошлой ночью...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Манн"
				}
			]
		}
	]
