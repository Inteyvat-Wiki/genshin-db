					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "Уважаемая посетительница, что вы такое говорите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "Аруэ"
				},
