			},
			"dialogs": [
				{
					"id": 748000501,
					"content": "Ах, да... Ты права...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000502,
						748000503
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000502,
					"content": "Кофе остывает.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000503,
					"content": "Мы свой уже выпили.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000504,
					"content": "#Спасибо тебе, {NICKNAME}. И спасибо, что доставил{F#а} меня сюда в целости и сохранности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000505
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000505,
					"content": "#Ты говоришь «доставил{F#а}», но мы ничего особенно не сделали, просто шли рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000506,
						748000507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 748000506,
					"content": "Ничего плохого не случилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000507,
					"content": "Тебе не угрожала опасность.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000508,
					"content": "#Ты прав{F#а}. Я всё надумала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000509
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000509,
					"content": "Кофе здесь великолепный, ха-ха... Ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000510
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000510,
					"content": "...А вдруг он отравлен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000511,
						748000512
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000511,
					"content": "...Кхе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000512,
					"content": "Ты что, умрёшь, если не будешь нести чушь хотя бы секунду?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000513,
					"content": "Хватит говорить всякую ерунду! Мы допили свой кофе, с нами всё в порядке. Видишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 748000514,
					"content": "Не-нет, может быть, это... особый способ отравления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000515
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000515,
					"content": "Сначала отравитель подмешивает в кофе лекарство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000516
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000516,
					"content": "Само по себе лекарство не оказывает никакого эффекта на человека.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000517
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000517,
					"content": "После того, как человек выпивает отравленный напиток и идёт домой, отравитель следует за ним...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000518
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000518,
					"content": "И, пока он спит, отравитель подмешает второе лекарство ему в воду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000519
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000519,
					"content": "На следующий день человек собирается выйти из дома и пьёт воду перед уходом. Оба лекарства смешиваются в его организме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000520
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000520,
					"content": "И тогда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000521
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000599,
					"content": "Вдруг послышались торопливые шаги...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "Уважаемая посетительница, что вы такое говорите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "Аруэ"
				},
				{
					"id": 748000522,
					"content": "Кофе? Отравлен? Прошу воздержаться от подобных шуток в моём заведении!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000523
					],
					"speakerTitle": "Аруэ"
				},
				{
					"id": 748000523,
					"content": "Если эти разговоры отпугнут клиентов, я буду вынужден попросить вас удалиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000524,
						748000525
					],
					"speakerTitle": "Аруэ"
				},
				{
					"id": 748000524,
					"content": "Позвольте мне всё объяснить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000525,
					"content": "Она моя подруга.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
