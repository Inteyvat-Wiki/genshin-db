						],
						"pointId": 5782
					}
				]
			},
			"dialogs": [
				{
					"id": 748000401,
					"content": "Почему ты опять прячешься? Здесь нет ничего опасного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 748000402,
					"content": "Разве ты не видишь этого жандарматона? Прямо перед нами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000403,
						748000404
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000403,
					"content": "И что с ним не так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				},
				{
					"id": 748000405,
					"content": "Тсс! Быстрее, уходим! Что, если он выйдет из-под контроля?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000406
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000406,
					"content": "Или... Его энергетическое ядро внезапно взорвётся! Или тот, кто управляет им дистанционно, использует его, чтобы напасть на нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000407
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000407,
					"content": "На мой взгляд, он выглядит исправным.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000408
					]
				},
				{
					"id": 748000408,
					"content": "Именно это меня и пугает! Нормально работающий мек внезапно выходит из-под контроля, и какой-нибудь бедный несчастный человек внезапно лишается жизни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000409
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000409,
					"content": "Никто и никогда не понесёт ответственности за это! Возможно, истинного виновника так и не найдут... Нет, это слишком опасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000410
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000410,
					"content": "Он ушёл, можешь выходить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 748000411,
					"content": "Фух... Он не вышел из-под контроля, какая неожиданность. Наши жизни в очередной раз были спасены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000412,
						748000413
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000412,
					"content": "Такого рода неожиданность просто не может произойти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000414,
					"content": "Я, скорее, подумала о преднамеренном несчастном случае.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000415
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000415,
					"content": "Преступные деяния, в которых нет виновного... и никто не несёт ответственность за случившееся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000416
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000416,
					"content": "Вот оно! Вдохновение нахлынуло! Быстрее, поспешим в кафе! Я должна это записать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000417
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000417,
					"content": "Эй, ты куда так бежишь? Не боишься, что кто-нибудь бросит камень и собьёт тебя с ног или что-то в этом роде?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 748000413,
					"content": "Он вообще не собирался выходить из под контроля?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000404,
					"content": "Ох... и что?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				}
			]
		},
		{
