				},
				{
					"id": 748000502,
					"content": "Кофе остывает.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000503,
					"content": "Мы свой уже выпили.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000504,
					"content": "#Спасибо тебе, {NICKNAME}. И спасибо, что доставил{F#а} меня сюда в целости и сохранности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000505
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000505,
					"content": "#Ты говоришь «доставил{F#а}», но мы ничего особенно не сделали, просто шли рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
