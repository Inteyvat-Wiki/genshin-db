			"dialogs": [
				{
					"id": 748000801,
					"content": "...Эй! Почему ты сидишь на корточках, держась за голову?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 748000802,
					"content": "Ты ударилась головой? Но поблизости нет ничего, обо что можно удариться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 748000803,
					"content": "Тсс! Идите сюда, скорее! Здесь опасно!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000804
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000804,
					"content": "Опять началось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 748000805,
					"content": "У аквабуса нет никакого ограждения! Если поставить два столба по обе стороны и натянуть между ними леску...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000806
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000806,
					"content": "То, когда аквабус будет проходить мимо, эта леска превратится в нож, который...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000807
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000807,
					"content": "А-а-а! Замолчи! Ни слова больше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000808
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 748000808,
					"content": "Даже одного столба будет достаточно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000809
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000809,
					"content": "И, если повесить на него леску, чтобы крюк просто болтался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000810
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000810,
					"content": "Тогда люди на аквабусе попадут на крючок в прямом смысле этого слова и будут висеть в воздухе, а потом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000811
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 748000811,
					"content": "Паймон не слушает... Паймон не слушает... Ла-ла-ла-ла-ла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000812
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 748000812,
					"content": "Паймон всю дорогу слушала эти теории и теперь боится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000813
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 748000813,
					"content": "Нам нужно как можно скорее сойти, как только прибудем на станцию...",
