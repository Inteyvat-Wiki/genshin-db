			},
			"dialogs": [
				{
					"id": 705450101,
					"content": "Мяу, мяу-мяу... Мяу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450102,
					"content": "Мяу! Мяу-мяу-мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "Зайчиш"
				},
				{
					"id": 705450103,
					"content": "Хм... Так вот что говорили Зайчиш и Эмбер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705450104,
					"content": "О, вот оно как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705450105,
					"content": "И правда...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "На самом деле Паймон тоже не всё понимает, но такое ощущение, что Зайчиш и Эмбер нашли общий язык!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705450108,
					"content": "#{NICKNAME} и Паймон! Вы пришли! А я как раз хотела идти вас искать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450109,
					"content": "Госпожа Валерина рассказала мне, как вы помогли «Замку котиков».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450110,
					"content": "#Меньшего я от вас и не ожидала, {NICKNAME}. Только с дороги, а уже помогаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450111,
					"content": "Как почётному рыцарю, мне любое задание по плечу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "Кстати, а о чём Зайчиш и ты только что говорили? Похоже, вам было весело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705450114,
					"content": "Мяу, мяу-мяу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "Зайчиш"
				},
				{
					"id": 705450115,
					"content": "Эм... Я уточняла у Зайчиша, не будет ли сегодня дождя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450116,
					"content": "А? С каких пор кошки научились погоду предсказывать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705450117,
					"content": "Хе-хе, это всё госпожа Лиза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450118,
					"content": "Она прочитала в одной книге, что кошки очень чувствительны к влаге и не любят мокнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450119,
					"content": "Почувствовав, что воздух стал влажнее, они начинают беспокойно тереть свои мордочки и вылизываться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450120,
					"content": "Когда кошки так себя ведут, это говорит о том, что скоро может пойти дождь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450121,
					"content": "Кто бы мог подумать... Какой интересный факт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705450122,
					"content": "#{NICKNAME}, в наших путешествиях посматривай на кошек. Тогда проливные дожди не застанут нас врасплох!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705450123,
					"content": "Будем обращать внимание.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "Вообще-то я пришла, чтобы кое-что спросить у госпожи Валерины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450126,
					"content": "Пока мы с ней разговаривали, подошла эта кошечка, забралась ко мне и ка-а-ак зевнёт. Милашка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450127,
					"content": "Она так мне доверяет... Мне тоже захотелось как-то показать, что я хочу дружить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450128,
					"content": "Тогда я вспомнила слова госпожи Лизы и спросила у Зайчиша про погоду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450129,
					"content": "И вот он потёр мордочку, мотнул хвостом и снова прижался к моей руке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450130,
					"content": "Хм, пойдёт ли дождь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705450124,
					"content": "А я всегда по пути наблюдаю за кошками!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "Защищать котят Мондштадта - мой долг.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "Подождите, я не понимаю!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}