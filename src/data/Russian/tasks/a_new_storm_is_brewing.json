			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Винд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400401,
					"content": "Море спокойно. Абсолютный штиль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400402
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400402,
					"content": "Моя семья из поколения в поколение следит за приближающимися штормами. Сама леди Веннесса доверила нам это ответственное задание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400403
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400403,
					"content": "С тех пор как Барбатос стал покровительствовать Мондштадту, в городе не было ни одного шторма. Дозорные башни стали ненужными и пришли в запустение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400404
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400404,
					"content": "Но я не перестаю приходить сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400405,
						200400408
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400405,
					"content": "Какая преданность и самоотверженность!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400406
					]
				},
				{
					"id": 200400406,
					"content": "Спасибо, но мой долг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400407
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400407,
					"content": "Я бы хотела, чтобы мне никогда не пришлось его выполнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400410,
					"content": "Спасибо за помощь! Вот вам ветряные астры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400411
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400411,
					"content": "Раньше моя семья выращивала их, чтобы определить силу ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400412
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400412,
					"content": "Ветряные астры не могут расти в местах, где совсем нет ветра, или там, где постоянные бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400413
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400413,
					"content": "Они хорошо себя чувствуют только в таких местах, как Мондштадт, где ветер нежный и спокойный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400414
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400414,
					"content": "Надеюсь, что ветряные астры и дальше будут тут цвести...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400408,
					"content": "Какая трогательная история!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400409
					]
				},
				{
					"id": 200400409,
					"content": "Надеюсь, эта история больше не повторится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Винд"
				}
			]
		},
		{
			"id": 2004005,
