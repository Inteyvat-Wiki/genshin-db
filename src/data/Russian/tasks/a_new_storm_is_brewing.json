			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400501,
					"content": "Она думает, что у неё получится, но... Там ОЧЕНЬ много монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200400502,
					"content": "Давай расчистим дорогу для мисс Винд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200400503,
					"content": "Посмотри, она и в самом деле собирается прорываться к башне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400504,
						200400505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200400504,
					"content": "Да, давай ей поможем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400506
					]
				},
				{
					"id": 200400506,
					"content": "Мы должны ей помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200400505,
					"content": "Какая решительность!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400507
					]
				},
				{
					"id": 200400507,
					"content": "Боюсь представить, что случится, если она действительно побежит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200400508,
					"content": "Мы не можем этого допустить. Давай избавимся от монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
