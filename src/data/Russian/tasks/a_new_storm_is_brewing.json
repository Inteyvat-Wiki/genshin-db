					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2004003",
							"2"
						],
						"stepId": 2004003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Винд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400201,
					"content": "Что-нибудь ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400202
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400202,
					"content": "Монстры тебя не потревожат.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400203
					]
				},
				{
					"id": 200400203,
					"content": "Правда? Хвала Архонтам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400204
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400204,
					"content": "Прости, конечно же, мне стоит благодарить тебя, а не Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400205
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400205,
					"content": "Как я могу отплатить тебе? Придумала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400206
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400206,
					"content": "Я буду ждать тебя на вершине дозорной башни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Винд"
				}
			]
		},
		{
			"id": 2004003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
