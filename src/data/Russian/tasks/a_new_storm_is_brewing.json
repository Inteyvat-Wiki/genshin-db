					"Винд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400101,
					"content": "Эх, как же мне пройти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400102
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400102,
					"content": "Здравствуй! Чем я могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400103
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400103,
					"content": "Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400104
					]
				},
				{
					"id": 200400104,
					"content": "Я пытаюсь добраться до дозорной башни на пике Буревестника. Хочу посмотреть, не собирается ли шторм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400105
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400105,
					"content": "Но группа монстров заблокировала дорогу. Я не знаю, как мне пройти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400106
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400106,
					"content": "Не переживай, провожать меня до дозорной башни не нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400107
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400107,
					"content": "Это мой долг, и я должна выполнить его любой ценой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400108
					],
					"speakerTitle": "Винд"
				},
				{
					"id": 200400108,
					"content": "Не переживай за меня. Я справлюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Винд"
				}
			]
		},
		{
			"id": 2004002,
			"completionStepIds": [
				2004003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2004002",
