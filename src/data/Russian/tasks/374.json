			"dialogs": [
				{
					"id": 3740701,
					"content": "Ты говорил о Небесной лире...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3740702,
					"content": "Самое драгоценное сокровище Мондштадта. На этой лире играл сам Барбатос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740703
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740703,
					"content": "Возможно, музыка Небесной лиры поможет Двалину пробудиться от его чудовищного кошмара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740704
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740704,
					"content": "Ты правда думаешь, что музыка поможет остановить Ужас Бури?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3740705,
					"content": "Я уверен в этом. Ты сейчас говоришь с лучшим бардом в мире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740706
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740706,
					"content": "Мне знакомы все песни древности и современности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740707
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740707,
					"content": "Что? Ты не веришь мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740708,
						3740709,
						3740710
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740708,
					"content": "Звучит сомнительно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740711,
					"content": "Ха! С бардом такие штучки не пройдут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740712
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740712,
					"content": "Как же мы добудем Небесную лиру?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740713
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3740713,
					"content": "Говорят, что она надёжно спрятана где-то в соборе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740714
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740714,
					"content": "Я собираюсь наведаться туда. Вы со мной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740709,
					"content": "Я тебе, конечно, верю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740710,
					"content": "Твои глаза, такого же цвета, как и небо над моим родным городом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				}
			]
		},
