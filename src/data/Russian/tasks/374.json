				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3740201,
					"content": "Предоставьте это мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740202
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740202,
					"content": "Добрый день, сестра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740203
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740203,
					"content": "Да хранит тебя ветер, юный бард! Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740204
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740204,
					"content": "Знаете что? Мне известна тайна, которая может спасти Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740205
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740205,
					"content": "Ох! Хвала Анемо Архонту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740206
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740206,
					"content": "Но тебе следует обратиться по этому вопросу к рыцарям Ордо Фавониус. Почему ты пришёл сюда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740207
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740207,
					"content": "Сестра, конечно же, я пришёл сюда не просто так. Ты можешь мне помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740208
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740208,
					"content": "Я хотел бы одолжить Небесную лиру. Она может помочь Ужасу Бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740209
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740209,
					"content": "Пожалуйста, покиньте помещение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740210
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740210,
					"content": "Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740211
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740211,
					"content": "Рыцари сами будут решать, что им делать с драконом. Мы не вправе стоять у них на пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740212
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740212,
					"content": "Но они убьют его! Мы не можем этого допустить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740213
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740213,
					"content": "Это глупое создание предало восточные ветра. Он не заслуживает прощения Анемо Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740214
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740214,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740215
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740215,
					"content": "Пожалуйста...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740216
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740216,
					"content": "Нет, юный бард.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740217
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740217,
					"content": "(Странно... Почему-то мне кажется, что не стоит отказывать этому мальчику...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740218
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740218,
					"content": "Эх... Ничего не поделаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740219
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740219,
					"content": "Я не могу больше скрывать свою подлинную сущность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740220
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740220,
					"content": "Возрадуйтесь, правоверные! Узрите явление <color=#00E1FFFF>Барбатоса</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740221
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740221,
					"content": "Я напугал тебя? Разве ты не хочешь расплакаться от радости? Тебе явилось божество, которому ты служила всю свою жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740222
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740222,
					"content": "Как я понимаю, тебе больше нечего сказать. Прошу прощения, но у меня ещё много работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740223
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740223,
					"content": "Эй, постой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		},
