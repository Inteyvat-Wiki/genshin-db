			},
			"dialogs": [
				{
					"id": 3740401,
					"content": "Да хранит тебя ветер!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740402,
						3740404
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740402,
					"content": "Здравствуйте!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740403
					]
				},
				{
					"id": 3740403,
					"content": "Ты же новобранец Ордо Фавониус, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740406,
					"content": "Что привело тебя к нам? Поручение действующего магистра?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740411
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740411,
					"content": "Ммм, да! Рыцарям понадобилась Небесная лира.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740412
					]
				},
				{
					"id": 3740412,
					"content": "Действительно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740413
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740413,
					"content": "Странно. Этот подозрительный бард тоже приходил за лирой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740414
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740414,
					"content": "Он нёс какую-то чушь и даже притворялся Барбатосом. Точно что-то недоброе задумал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740415
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740415,
					"content": "Использование Небесной лиры строго регламентировано. Сейчас мы достаём её только на Луди Гарпастум.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740416
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740416,
					"content": "Чтобы получить доступ к лире, тебе понадобятся подписанные документы от магистра Ордо Фавониус, от сенешаля и народного представителя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740417
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740417,
					"content": "У тебя есть все необходимые бумаги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740418,
						3740419,
						3740420
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740418,
					"content": "Действующий магистр наверное забыла о них...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740422,
					"content": "В любом случае тебе понадобятся подписанные документы. Если у тебя нет бумаг, я ничем не могу тебе помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740423
					],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740423,
					"content": "Если тебе нечего больше сказать, то прошу меня извинить. У меня много работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Геттлинда"
				},
				{
					"id": 3740419,
					"content": "#Простите, я забыл{F#а} их принести.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740420,
					"content": "Паймон их съела.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740421
					]
				},
				{
					"id": 3740421,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3740404,
					"content": "#Я почётный рыцарь Ордо Фавониус {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740405
					]
				},
				{
					"id": 3740405,
					"content": "Я слышала о тебе. Ты и Эмбер спасли Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Геттлинда"
				}
			]
		},
