			},
			"dialogs": [
				{
					"id": 3740301,
					"content": "Как же так? Она и бровью не повела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740302
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740302,
					"content": "Но я узнал всё, что хотел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740303
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740303,
					"content": "Небесная лира находится в соборе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740304
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740304,
					"content": "#{NICKNAME}! Ты звезда Ордо Фавониус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740305
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3740305,
					"content": "Может быть, ты тоже попробуешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		},
		{
			"id": 37404,
