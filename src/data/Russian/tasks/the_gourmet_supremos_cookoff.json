						220210316
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210316,
					"content": "Вкусные тройные шашлычки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210317
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210317,
					"content": "Стремление к «экстремуму», к предельности, означает, что твоё сердце никогда не удовлетворится простой «приемлемостью». Вместо этого целью является наивысшее совершенство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210318
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210318,
					"content": "Даже в кулинарии нужно стремиться к совершенству. Только так можно стать мастером кулинарного искусства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210319
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
