			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сюй Дун",
					"Камэи Мунэхиса"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210101,
					"content": "Приготовься, это блюдо будет потрясающим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210102
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210102,
					"content": "Мое блюдо будет таким же фантастическим, так что приготовься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210103
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210103,
					"content": "Чем это вы таким занимаетесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210104
					]
				},
				{
					"id": 220210104,
					"content": "#Здравствуй, путешественни{F#ца}{M#к}. Парвана и Джули собирают ингредиенты, а мы должны были приготовить для них еду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210105
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210105,
					"content": "Но у нас с дядей Мунэхисой возникли небольшие разногласия по поводу того, что приготовить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210106
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210106,
					"content": "Поэтому мы решили каждый придумать своё блюдо и сделать из этого соревнование. Победитель выберет тему для остальных сегодняшних блюд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210107
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210107,
					"content": "Я готовлю одно из фирменных блюд Ли Юэ - суп из украшений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210108
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210108,
					"content": "А я приготовлю своё лучшее блюдо - тройные шашлычки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210109,
						220210111
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210109,
					"content": "Я могу чем-нибудь помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210110
					]
				},
				{
					"id": 220210110,
					"content": "Ну, если у тебя есть время... в итоге нам потребуется судья...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210113,
					"content": "Но поскольку нам обоим нужно приготовить по четыре порции каждого блюда, несмотря на то, что у нас всего по две руки, мы немного перегружены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210114
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210114,
					"content": "Пока не наступил момент судейства, ты можешь помочь нам подготовить еду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210115
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210115,
					"content": "И, конечно, ты можешь выбрать, с каким из наших блюд помочь, ведь у тебя всего лишь две руки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210116,
						220210119
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210116,
					"content": "Сюй Дун, ты сможешь справиться в одиночку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210117
					]
				},
				{
					"id": 220210117,
					"content": "За меня не волнуйся. Я работал в ресторане в Ли Юэ, поэтому мне это будет несложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210118
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210118,
					"content": "При этом, с небольшой помощью, я мог бы сделать еду ещё лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210122,
					"content": "В любом случае просто выбери блюдо, которое тебя больше интересует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210123,
						220210126
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210123,
					"content": "Сюй Дун, я помогу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210124
					]
				},
				{
					"id": 220210124,
					"content": "О! Замечательно, дядя Мунэхиса, готовься к поражению!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210125
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210125,
					"content": "Я не из тех, кто легко сдаётся. Не разочаруйте меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210126,
					"content": "Дядя Мунэхиса, я помогу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210127
					]
				},
				{
					"id": 220210127,
					"content": "Благодарю. Будь готов, Сюй Дун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210128
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210128,
					"content": "Не проблема. Жду вашего блюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210119,
					"content": "Дядя Мунэхиса, ты сможешь справиться один?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210120
					]
				},
				{
					"id": 220210120,
					"content": "Не волнуйся. Выбирай то блюдо, которое тебе более интересно. Когда я был в сёгунате, я в одиночку готовил еду сразу для огромной толпы. А тут нужно всего лишь четыре порции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210121
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210121,
					"content": "Но если ты захочешь помочь мне, уверен, что вместе мы сможем сделать моё блюдо ещё вкуснее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210111,
					"content": "Полагаю, вам не хватает одного судьи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210112
					]
				},
				{
					"id": 220210112,
					"content": "Ха-ха, точно. Нам нужен судья, который попробует каждое из них и вынесет вердикт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Сюй Дун"
				}
			]
		},
		{
			"id": 2202102,
			"completionStepIds": [
				2202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202109",
							"2"
						],
						"stepId": 2202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сюй Дун",
					"Камэи Мунэхиса"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210201,
					"content": "#Готово. Спасибо, путешественни{F#ца}{M#к}. Пахнет просто волшебно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210202
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210202,
					"content": "Попробую его первым... Ого, здорово. Ингредиенты приготовлены как надо, и пахнет действительно превосходно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210203
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210203,
					"content": "Это даже заслуживает титула «Идеального супа из украшений».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210204
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210204,
					"content": "#А как продвигается твоя стряпня, дядя Мунэхиса? Готов показать своё блюдо путешественни{F#це}{M#ку}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210205
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210205,
					"content": "Ну... Я совершил ошибку. Я понял, что у меня недостаточно птичьих яиц фактически сразу после начала готовки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210206
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210206,
					"content": "Хотя я сразу же отправился за птичьими яйцами в лес, остальные ингредиенты к тому времени уже были не в лучшем виде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210207
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210207,
					"content": "Тройные шашлычки, приготовленные из несвежих ингредиентов, не могут считаться хорошим блюдом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210208
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210208,
					"content": "Мне стыдно, что я был так небрежен. Мне нужно чаще совершенствовать свои навыки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210209
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210209,
					"content": "На этот раз ты выиграл. Но в следующий раз, Сюй Дун, победа будет за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210210,
						220210214
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210210,
					"content": "Хороший настрой, дядя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210211
					]
				},
				{
					"id": 220210211,
					"content": "Ха-ха, обещаю, в следующий раз победить меня будет не так легко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210212
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210212,
					"content": "#Кстати, путешественни{F#ца}{M#к}, это тебе. Спасибо, что уделил{F#а} так много времени на помощь нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210213
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210213,
					"content": "Тебе стоит прийти и в следующий раз, когда мы будем соревноваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220210214,
					"content": "В принципе, я думаю, что вкус ничего так...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210215
					]
				},
				{
					"id": 220210215,
					"content": "Меня не устраивает просто «ничего так». Даже в кулинарии нужно стремиться к совершенству.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210216
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220210216,
					"content": "Только так можно стать мастером кулинарного искусства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210217
					],
