				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200101,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200102
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200102,
					"content": "А! Это же нары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200103
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200103,
					"content": "Кхе-кхе. Как стыдно, что нары увидели меня таким жалким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200104
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200104,
					"content": "Добрые нары, я Арачатора. А вы кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200105
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200105,
					"content": "#Меня зовут {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200106
					]
				},
				{
					"id": 730200106,
					"content": "Паймон зовут Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200107,
					"content": "#Нара {NICKNAME} и Паймон. Ясно. Я вам очень благодарен. Если бы судьба не свела нас здесь, я бы ещё долго не смог прийти в себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200108
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200108,
					"content": "Насколько долго?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200109,
					"content": "Стыдно признаться, но подобное уже случалось из-за испорченных грибов. Я поправился лишь тогда, когда лотосы нилотпала в пруду расцвели и закрылись дважды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200110
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200110,
					"content": "Расцвели и закрылись... Это два дня получается?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200111,
					"content": "Ох, два дня. Вот что означает слово «день». Вы, нары, такие занятные. А два дня - это много или мало?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200112
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200112,
					"content": "#Хм... {NICKNAME}, как думаешь, два дня - это много или мало?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200113,
						730200116,
						730200120,
						730200123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200113,
					"content": "Вроде много.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200114
					]
				},
				{
					"id": 730200114,
					"content": "Ага, сложно вообразить, что Арачатора выл два дня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200115,
					"content": "Правда? Значит, это долго? Скверно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200126,
					"content": "Но если ты Арачатора, то ты родственник Арапакати?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200127,
					"content": "Нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200128
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200128,
					"content": "Да? Но... ты ведь брат Арапакати?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200129,
					"content": "Ой, а вы откуда знаете? Арапакати - моя сестрёнка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200130
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200130,
					"content": "И как же так получилось?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200131,
					"content": "Наверное, у аранар всё иначе устроено...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200132
					]
				},
				{
					"id": 730200132,
					"content": "В общем, дело такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200133,
					"content": "Вы объясняете ситуацию Арачаторе.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730200134
					]
				},
				{
					"id": 730200134,
					"content": "Снова Праздник Утсава?.. Что же делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200135
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200135,
					"content": "А ведь мне ещё нужно подготовить ингредиенты, чтобы на Празднике Утсава доказать Арасаке, Арапасу и Арафале, что грибные блюда самые вкусные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200136
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200136,
					"content": "Значит, Ара... Арапа... Арафа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200137,
					"content": "Арасака, Арапас и Арафала.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200138
					]
				},
				{
					"id": 730200138,
					"content": "Ай! У аранар такие сложные имена! Арачатора, так где твой брат?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200139,
					"content": "Каждый избрал свой путь для практик, как река в половодье разделилась на ручьи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200140
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200140,
					"content": "В общем, вы разошлись, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200141
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200141,
					"content": "Мы занимаемся кулинарными практиками, чтобы приготовить «величайшее лакомство», а они не признают блюда из грибов. Но понятно же, что Главный гриб не имеет себе равных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200142
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200142,
					"content": "И вот мы решили приготовить свои блюда и сравнить их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200143
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200143,
					"content": "О, Паймон прекрасно понимает стремление к вкусной еде!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200144
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200144,
					"content": "А где же твой Главный гриб?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200145,
					"content": "В последнее время Марана так сильно разрослась, что захватила всё пространство у Главного гриба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200146
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200146,
					"content": "Это же зона Увядания... Паймон надеется, что с Раной всё хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200147
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200147,
					"content": "Её когти вырвали драгоценные грибы. Уверен, вам известно, насколько опасна и жестока Марана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200148
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200148,
					"content": "А без Главного гриба не удастся попробовать странные грибы, коих раньше не пробовали аранары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200149
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200149,
					"content": "И?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200150,
						730200151
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200150,
					"content": "И мы видели итог.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200152,
					"content": "Мне очень неловко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200153
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200153,
					"content": "Паймон думает, эта мёртвая зона... Марана... Мы уже с таким сталкивались, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200154,
						730200155
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200154,
					"content": "Это была ерунда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200156,
					"content": "Вот это да! Невероятно! Вы можете противостоять Маране?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200157
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200157,
					"content": "#В этом есть смысл. Если нара {NICKNAME} может исцелить меня силой Кусанали, то сможет и от Мараны избавиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200158
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200158,
					"content": "#Нара {NICKNAME}, прошу тебя, отведи меня туда, где растёт Главный гриб.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200159
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200159,
					"content": "#Это наш шанс попробовать невероятно вкусное грибное блюдо! {NICKNAME}, давай поможем братьям и сёстрам собраться вместе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200160,
						730200161
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200160,
					"content": "Ладно, мы уже пообещали Арапакати.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200163
					]
				},
				{
					"id": 730200163,
					"content": "Ладно, вон там впереди пещера. Идите за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200161,
					"content": "Ты просто есть хочешь, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200162
					]
				},
				{
					"id": 730200162,
					"content": "А что такого? Так мы двух зайцев убьём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200163
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200155,
					"content": "Чудом тогда спаслись.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200151,
					"content": "«У-у-у»!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200116,
					"content": "Вроде мало.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200117
					]
				},
				{
					"id": 730200117,
					"content": "И правда... Если так подумать, то мы давно уже знакомы, а как будто это случилось только вчера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200118,
					"content": "Ну тогда я спокоен. В лесу потерять разум на два дня - невелик срок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200119
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200119,
					"content": "Мы не то имели в виду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200120,
					"content": "Смотря что делать в это время.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200121
					]
				},
				{
					"id": 730200121,
					"content": "Да, правда. Если два дня выть, то это долго. А в жизни лесного кабана два дня - короткий миг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200122,
					"content": "Правда? Значит, это долго? Скверно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200123,
					"content": "Время субъективно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200124
					]
				},
				{
					"id": 730200124,
					"content": "#Да. Нара {NICKNAME}, ты хорошо понимаешь лес. В лесу зарождается жизнь, в лесу жизнь развивается и в там же она возвращается в землю. Для этого не нужны никакие «дни».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200125
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200125,
					"content": "Что за ерунда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7302002,
			"completionStepIds": [
				7302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302005",
							"2"
						],
						"stepId": 7302005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арачатора",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200201,
					"content": "Ох! Вот Главный гриб, о котором я так мечтал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200202
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200202,
					"content": "Главный гриб, остался бы ты собой без своего прекрасного аромата?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200203
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200203,
					"content": "Хи-хи, а гриб и правда так вкусно пахнет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200204,
					"content": "Давайте уйдём отсюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7302003,
			"completionStepIds": [
				7302010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302010",
							"2"
						],
						"stepId": 7302010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арачатора",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200301,
					"content": "Мне так повезло, что я встретил вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200302
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200302,
					"content": "Это аромат созревшего Главного гриба. Ещё насыщеннее, чем в прошлый раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200303
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200303,
					"content": "И ты вырос, даже когда Марана захватила твою среду обитания. Невероятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200304
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200304,
					"content": "Так... мы можем попробовать Главный гриб?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200305,
					"content": "Разумеется. Целью моих кулинарных практик было угостить нар самым вкусным грибным блюдом. К тому же вы мне очень помогли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200306
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200306,
					"content": "Ура! Главный гриб!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200307,
					"content": "Арачатора тут же приступает к готовке...\\nИз котелка доносится утончённый аромат грибов.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200308
					]
				},
				{
					"id": 730200308,
					"content": "Когда блюдо готово, Арачатора угощает вас и Паймон.\\n...Что это - разочарование или закономерный результат? Ведь блюдо вышло совершенно безвкусным.\\nБолее того, оно наполнено такой мощной жизненной силой, что его просто невозможно жевать.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200309
					]
				},
				{
					"id": 730200309,
					"content": "Готово. Мои кулинарные практики завершены. Что вы думаете? Уверен, это наилучший деликатес для нар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200310
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200310,
					"content": "Ням-ням... Уф... Как бы это сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200311,
					"content": "(С усилием жевать)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200312
					]
				},
				{
					"id": 730200312,
					"content": "(С усилием проглотить)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200313,
						730200314,
						730200315
					]
				},
				{
					"id": 730200313,
					"content": "Это съедобно. Если постараться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200316,
					"content": "Ну... это очень ароматный гриб, но его вкус и текстура нам не по вкусу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200317,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200318
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200318,
					"content": "#Как же так? Однажды я угостил этим блюдом нару, и {M#ему}{F#ей} понравилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200319
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200319,
					"content": "Однажды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200320,
					"content": "#Когда-то я приготовил для нары грибное блюдо. И оно было таким вкусным, что {M#он}{F#она} его проглотил{F#а} с большим аппетитом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200321
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200321,
					"content": "Наверняка было очень вкусно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200322
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200322,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200323,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200324
					]
				},
				{
					"id": 730200324,
					"content": "Ох, наверное, раз у аранар бывает разная листва, то и вкусы у них тоже бывают разные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200325
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200325,
					"content": "Кстати, о листьях... А вы, аранары, не боитесь огня? Ты ведь тоже весь покрыт листьями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200326,
					"content": "Огонь - это страшно. Порой лесной пожар может превратить зелёный холм в выжженную землю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200327
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200327,
					"content": "Но это же для моих кулинарных практик. А обуздать страх и контролировать температуру пламени - часть практик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200328
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200328,
					"content": "Вот, значит, как... Ну, пора возвращаться. Арапакати уже всех заждалась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200329,
					"content": "Да, я немедленно отправляюсь в Ванарану. Я не хочу заставлять мою дорогую сестрёнку волноваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200330
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200330,
					"content": "А остальные... Арасака, Арапас и Арафала <color=#00E1FFFF>возле Гандхарвы</color>, <color=#00E1FFFF>чащи Апам</color> и <color=#00E1FFFF>горы Девантаки</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200331
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200331,
					"content": "#Спасибо вам. Золот{F#ая}{M#ой} нара {NICKNAME} сияет как солнце. И Паймон тоже невероятна. А просьбу сестры я поручу вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200332
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200332,
					"content": "И почему это Паймон «тоже невероятна»?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200333
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200333,
					"content": "Ой, не бери в голову... В общем, я даже не знаю, как отплатить вам за помощь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200334
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200334,
					"content": "Хм, пожалуй, я поделюсь с вами рецептом «величайшего лакомства». Возможно, с возрастом вы поймёте его вкус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200335
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200335,
					"content": "#({NICKNAME}, надо мне этот рецепт чуть подправить. Наверняка получится неплохое авторское блюдо!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730200314,
					"content": "Ну хоть не ядовито.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200315,
					"content": "Кажется, мне рановато есть безвкусные блюда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				}
			]
		},
		{
			"id": 7302004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302010",
							"3"
						],
						"stepId": 7302010,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арачатора"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200401,
					"content": "#Я счастлив, что нашёл Главный гриб, закончил кулинарные практики и познакомился с высок{F#ой}{M#им} и надёжн{F#ой}{M#ым} нарой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200402
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200402,
					"content": "#Арапакати, Арасака, Арапас и Арафала тоже будут вам благодарны. Нара {NICKNAME}, ты хорош{F#ая}{M#ий} нара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200403
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730200403,
					"content": "Благодарны? За что?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200404
					]
				},
				{
					"id": 730200404,
					"content": "Потому что благодаря твоей помощи они смогут отведать Главного гриба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арачатора"
				}
			]
		},
		{
			"id": 7302005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302004",
							"2"
						],
						"stepId": 7302004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200501,
					"content": "(Выглядит покрупнее, чем обычный гриб. Лучше собрать его попозже, после уничтожения зоны Увядания.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Главный гриб"
				}
			]
		}
	]
}