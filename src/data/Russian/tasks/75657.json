			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756570201,
					"content": "#{NICKNAME}, сюда, сюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570202,
					"content": "Помнишь? Здесь началось наше путешествие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570203,
					"content": "И вот мы сами не заметили, как обошли столько разных мест! От одной мысли Паймон охватывает волнение. Хочется даже стихотворение сочинить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570204,
						756570205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570204,
					"content": "Порадуй меня своими стихами, великий бард Паймон!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570207
					]
				},
				{
					"id": 756570205,
					"content": "Хи-хи!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570206
					]
				},
				{
					"id": 756570206,
					"content": "Не перебивай! Дай лучше Паймон собраться с мыслями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570207,
					"content": "О Тейват, какой ты огромный!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570208,
					"content": "Мы много где побывали, но не обошли тебя целиком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570209,
						756570210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570209,
					"content": "(Промолчать)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570210,
					"content": "Это было вообще не в рифму.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570211,
					"content": "О! О... Ну всё, мысль улетела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570212,
						756570214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570212,
					"content": "Ха-ха-ха!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570213
					]
				},
				{
					"id": 756570214,
					"content": "Ты хочешь рассказать о тяготах, которые мы пережили в пути?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570215
					]
				},
				{
					"id": 756570213,
					"content": "Конечно, смейся над Паймон. Паймон уже привыкла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570215,
					"content": "Да! Точно! Ха-ха, ты хорошо знаешь Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570216,
					"content": "Но если серьёзно, когда путешествуешь так долго, легко позабыть, с чего начинался твой путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570217,
					"content": "Например, Паймон успела забыть вкус цыплёнка в медовом соусе. А ведь это было любимое блюдо Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570218,
					"content": "Вот почему Паймон решила купить эти альбомы. Чтобы сфотографировать на память людей, которых мы встретили, и места, где успели побывать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570219,
					"content": "Знаешь, в фильмах и лёгких романах часто встречается такой сюжетный поворот: герои возвращаются к началу своего пути, где их ждёт захватывающий финал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570220,
					"content": "Вот почему Паймон решила, что мы должны здесь сфотографироваться. Не ради ностальгии, а чтобы всегда помнить о пройденном пути и продолжать твёрдо идти по нему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570221,
						756570222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570221,
					"content": "Ты подслушала мой разговор с Кадзухой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570224
					]
				},
				{
					"id": 756570222,
					"content": "Что? Нет, просто Паймон растёт над собой!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570223
					]
				},
				{
					"id": 756570223,
					"content": "Ну... да, Паймон подслушала ваш разговор с Кадзухой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570224,
					"content": "#Знаешь, Паймон хотела создать торжественную атмосферу, а ты всё испортил{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570225,
					"content": "Не переживай, я понимаю, что ты хотела сказать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570226
					]
				},
				{
					"id": 756570226,
					"content": "Мы будем идти дальше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570227
					]
				},
				{
					"id": 756570227,
					"content": "Ха-ха, вот и хорошо, что понимаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570228,
					"content": "Ну что! Теперь твоей моделью будет лучший проводник во всём Тейвате! Как Паймон встать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570229,
						756570230,
						756570231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570101,
					"content": "#Стоп. А где фотокамера, которую давала тебе Паймон? Ты ведь её не потерял{F#а}? Проверь немедленно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
