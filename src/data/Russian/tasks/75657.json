					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756570229,
					"content": "Прими забавную позу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570232
					]
				},
				{
					"id": 756570230,
					"content": "Прими серьёзную позу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570232
					]
				},
				{
					"id": 756570231,
					"content": "Прими расслабленную позу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570232
					]
				},
				{
					"id": 756570232,
