				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380201,
					"content": "#Большое спасибо, путешественн{F#ица}{M#ик}. Эта фотография отлично подойдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380202
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380203
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380203,
					"content": "Ах, вот и пришло время уезжать. Раньше когда я слышал выражения «устремления благородного мужа простираются далеко» и «лучше пройти тысячи миль, чем прочесть тысячи книг», меня всегда переполняло воодушевление...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380204
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380204,
					"content": "Но когда наступила пора уезжать, то никакого вдохновения и воодушевления не осталось. Я только и думаю, как бы задержаться здесь подольше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380205
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380205,
					"content": "#Путешественни{F#ца}{M#к}, думаешь, в дороге я смогу найти то, что ищу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380206,
						210380208
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380206,
					"content": "Я не знаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380207
					]
				},
				{
					"id": 210380207,
					"content": "Ха-ха... Чего же я хочу? Я даже сам не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380210,
					"content": "#Что ж, время настало. Мне пора встретиться с торговцем. А ты возьми эту награду, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380211
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380211,
					"content": "Цю Эр... Она так и не пришла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380208,
					"content": "Всё зависит от тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380209
					]
				},
				{
					"id": 210380209,
					"content": "Это звучит... практически как «будь что будет»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Сунь Юй"
				}
			]
		},
