						],
						"stepId": 2103801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380101,
					"content": "#Путешественни{F#ца}{M#к}, хорошо, что ты здесь. Я уже думал, что не дождусь тебя сегодня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380102
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380102,
					"content": "#Сегодня я уезжаю из Ли Юэ. Ты мне во многом помогал{F#а}... Хочу тебя как следует отблагодарить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380103
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380104
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380104,
					"content": "Хм... Я даже заранее подготовил благодарственную речь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380105
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380105,
					"content": "Но когда наступила пора говорить, я всё начисто забыл. Выставил себя на посмешище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380106,
						210380107
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380106,
					"content": "Ничего, мы ещё встретимся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				},
				{
					"id": 210380108,
					"content": "Правда? Ха-ха-ха, отлично. Когда приедешь, я покажу тебе окрестности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380109
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380109,
					"content": "Кстати, хочу попросить тебя о последнем одолжении. Помнится, у тебя была фотокамера? Можешь сфотографировать меня на память?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380110
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380110,
					"content": "Один матрос сказал, что на чужбине лучше иметь при себе фотографию родных мест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380111
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380111,
					"content": "Но у меня нет фотокамеры, поэтому остаётся просить тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380112,
						210380113
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380112,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 210380113,
					"content": "Прими красивую позу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380114
					]
				},
				{
					"id": 210380114,
					"content": "Ну, какую же мне позу принять? Ах, главное, заснять фон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210380107,
					"content": "Я навещу тебя в Фонтейне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				}
			]
		},
		{
			"id": 2103802,
			"completionStepIds": [
				2103803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2103803",
							"2"
						],
						"stepId": 2103803,
						"stateName": "QUEST_STATE_UNFINISHED"
