					"Сонни"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3586.289,
							506.535,
							4623.4
						],
						"pointId": 4314
					},
					{
						"sceneId": 3,
						"position": [
							3586.379,
							506.535,
							4624.633
						],
						"pointId": 4315
					},
					{
						"sceneId": 3,
						"position": [
							3587.523,
							506.535,
							4624.111
						],
						"pointId": 4321
					}
				]
			},
			"dialogs": [
				{
					"id": 740090101,
					"content": "Надо же, какое удивительное совпадение. Не правда ли, Люка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090102
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090103
					],
					"speakerTitle": "Люка"
				},
				{
					"id": 740090103,
					"content": "А вы кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090104,
					"content": "О, прошу прощения. Как же это я забыл представиться. Меня зовут Сонни по прозвищу Белая Перчатка. А это мой друг Люка Рыбак. Он очень известен в определённых кругах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090105
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090105,
					"content": "А, привет! Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090106,
					"content": "#О, можете не продолжать. Я уже знаю, что вас зовут Паймон, а {M#вашего белокурого спутника}{F#вашу белокурую спутницу} - {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090107
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090107,
					"content": "Что? Ты нас знаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090108,
					"content": "Ну разумеется. Но до этого дня наше знакомство было односторонним. Я знал о вас, а вы обо мне нет. Подобное знакомство я вожу с господином Нёвиллетом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090109
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090109,
					"content": "С учётом вашей славы и достижений, вполне естественно, что стоило вам прибыть в Фонтейн, как слухи об этом распространились повсюду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090110
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090110,
					"content": "Мы настолько известны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090111
					]
				},
				{
					"id": 740090111,
					"content": "Ах, не скромничайте! Как бы это получше выразить? Для многих людей ваш приезд в Фонтейн подобен взрыву бомбы на сцене оперного театра «Эпиклез».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090112
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090112,
					"content": "Только, конечно, в положительном смысле! Правда ведь, мой милый Люка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090113
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090113,
					"content": "Эм, но как бомба может взорваться в положительном смысле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090114,
					"content": "Хм, я не силён в игре словами. Может, у моего дорогого Люки получится лучше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090115
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090115,
					"content": "Магическое шоу Лини и Линетт. Взорвать всё, чтобы сделать невозможное. Бомбические новости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090116
					],
					"speakerTitle": "Люка"
				},
				{
					"id": 740090116,
					"content": "Именно! Ах, я бы ни за что не смог так точно всё описать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090117
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090117,
					"content": "Н-ну, пусть будет по-твоему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090118,
					"content": "А почему тебя называют «Белая Перчатка»? Паймон не видит у тебя никаких перчаток...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090119,
					"content": "О, это сложный вопрос. Как бы мне получше объяснить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090120
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090120,
					"content": "Представьте, что на вас надеты белые перчатки. Если вы дотронетесь до чего-то грязного, то перчатка сразу испачкается, верно? Так вот моя работа состоит в том, чтобы находить грязь и убирать её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090121
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090121,
					"content": "Ты... кто-то вроде уборщика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090122,
					"content": "Отличная формулировка, милая Паймон! Вот видите, а я бы ни за что не смог так идеально точно сконцентрировать суть моей работы всего в одном слове.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090123
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090123,
					"content": "Так это благодаря таким, как ты, улицы Кур-де-Фонтейна блистают чистотой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090124,
					"content": "Ха-ха, ваши слова тешат мне душу! Да, можно понять это и так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090125
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090125,
					"content": "Ладно... А зачем уборщику нож?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090126,
					"content": "Скажем так, этот маленький инструмент бывает очень удобен, когда нужно удалить особенно неподатливое загрязнение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090127
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090127,
					"content": "Ага, теперь Паймон всё ясно! А... твоего друга зовут Рыбаком, потому что он хорошо ловит рыбу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090128,
					"content": "Мм, не совсем так. Видите ли, в Фонтейне немало самых разных видов рыб.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090129
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090129,
					"content": "И Люке нет равных, когда надо обучить кого-то, как такому множеству разноцветных рыбок жить вместе в мире и согласии. Я верно изложил, милый Люка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090130
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090130,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090131
					],
					"speakerTitle": "Люка"
				},
				{
					"id": 740090131,
					"content": "А? Что-то Паймон не очень понимает. Тогда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090132,
					"content": "Должен сказать, милая Паймон, что вы действительно умеете задавать невероятно сложные и увлекательные вопросы. Как было бы чудесно побеседовать с вами подольше, чтобы полностью удовлетворить ваш интерес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090133,
						740090135
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090133,
					"content": "Паймон, остановись с вопросами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090134
					]
				},
				{
					"id": 740090134,
					"content": "А? Ну ладно... Сонни и Люка, вы хотели нас о чём-то попросить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090136,
					"content": "Видите ли, мы интересуемся подводным плаванием. Воды Фонтейна полны сокровищ, оставленных нашими предками и самой природой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090137
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090137,
					"content": "Наши приятели поведали, что недавно вы обзавелись новым другом и даже ныряли с ним. Вы настолько искусны, что вам для этого не понадобилось специальное оборудование. Так ведь, милый Люка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090138
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090139
					],
					"speakerTitle": "Люка"
				},
				{
					"id": 740090139,
					"content": "Вы хотите узнать о Виржиле.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090140
					]
				},
				{
					"id": 740090140,
					"content": "О да. Мы очень хотим кое-что узнать о Виржиле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090141
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090141,
					"content": "Виржиль... Лжец и предатель! Ух, Паймон жутко сердится, стоит только о нём подумать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090142
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090142,
					"content": "Вы рассказываете Сонни Белой Перчатке и Люке Рыбаку о том, во что вас втянул Виржиль.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740090143
					]
				},
				{
					"id": 740090143,
					"content": "...Ясно. Большое спасибо, что всё рассказали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090144
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090144,
					"content": "На здоровье! Уф, Паймон всё про этого типа помнит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090145,
					"content": "Разумеется, мы чрезвычайно благодарны за то, что вы поделились с нами этой историей. Но должен сказать, что ещё больше меня радует, что вы не считаете Виржиля другом. В противном случае...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090146
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090146,
					"content": "Хм, скажем так, будь он вашим другом, для нас с вами дела могли бы сложиться не самым приятным образом. Не так ли, милый Люка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090147
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090147,
					"content": "Мы могли бы с ними не справиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090148
					],
					"speakerTitle": "Люка"
				},
				{
					"id": 740090148,
					"content": "Да-да, вот и я так думаю. Безмерно вам благодарен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090149
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090149,
					"content": "О чём ты?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090150
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090150,
					"content": "Это враги Виржиля.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090151
					]
				},
				{
					"id": 740090151,
					"content": "А!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090152
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090152,
					"content": "#О, {M#достопочтенный сударь}{F#милостивая сударыня}, ваши слова ранят меня. У меня нет врагов, зато есть множество друзей. И Виржиль входит в их число. Вот только милый Виржиль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090153
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090153,
					"content": "#Думаю, нам стоит серьёзно с ним побеседовать. Вы ведь понимаете, о чём я, {M#милый}{F#милая} {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090154
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090154,
					"content": "Разумеется, ему придётся объясниться на тему того, что он позволил себе по отношению к вам и Паймон. Это самое малое, что мы можем сделать для наших почётных гостей, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090155
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090155,
					"content": "Паймон что-то уже совсем ничего не понимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090156,
						740090158
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090156,
					"content": "Он Белая Перчатка. Это всё, что тебе нужно знать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090157
					]
				},
				{
					"id": 740090157,
					"content": "Эм... Ладно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090160,
					"content": "Мы нашли базу Виржиля и его оставшихся друзей. Может, устроим встречу там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090161,
						740090165
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090161,
					"content": "А мы тут при чём?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090162
					]
				},
				{
					"id": 740090162,
					"content": "#Ну же, {M#достопочтенный сударь}{F#милостивая сударыня}. Виржиль так сильно вас обидел. Разве можем мы провести... беседу, не уведомив вас о наших планах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090163
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090163,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090164
					],
					"speakerTitle": "Люка"
				},
				{
					"id": 740090164,
					"content": "Вот, и Люка согласен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090166
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090166,
					"content": "Хм! Паймон тоже хочет побеседовать с Виржилем. Он должен принести нам официальные извинения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090167
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090167,
					"content": "Ха-ха, вы слишком добры. Встретимся на месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090165,
					"content": "Ладно, идём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090166
					]
				},
				{
					"id": 740090158,
					"content": "Это нормально, что ты не понимаешь, Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090159
					]
				},
				{
					"id": 740090159,
					"content": "#Жизнь была бы такой скучной, если бы всё в мире было нам заранее известно. Не правда ли, {M#достопочтенный сударь}{F#милостивая сударыня}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090135,
					"content": "Мы можем вам чем-то помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090136
					]
				}
			]
		},
