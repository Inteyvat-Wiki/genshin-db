			"dialogs": [
				{
					"id": 740090201,
					"content": "#Милая Паймон и {M#достопочтенный сударь}{F#милостивая сударыня}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090202
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090202,
					"content": "Это место Виржиль в последнее время использует в качестве базы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090203
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090203,
					"content": "Да где же этот Виржиль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090204
					],
					"speakerTitle": "Подозрительная с виду личность"
				},
				{
					"id": 740090204,
					"content": "Если он не придёт в ближайшее время, я не удержусь... и сам попробую апсинтион...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090205
					],
					"speakerTitle": "Опасная с виду личность"
				},
				{
					"id": 740090205,
					"content": "Эй, даже не думай! Этот груз дорого нам обошёлся. Виржиль тебя не пощадит, если ты возьмёшь его без разрешения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090206
					],
					"speakerTitle": "Жуликоватая с виду личность"
				},
				{
					"id": 740090206,
					"content": "Какая жалость. Похоже, мой дорогой друг Виржиль ещё не вернулся. Но ничто не мешает нам побеседовать с этими ребятами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090207
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090207,
					"content": "Вот только Паймон кажется, что они не в настроении общаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090208,
					"content": "Ничего, думаю, они могут вскоре изменить мнение. А вы как полагаете, Люка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090209
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090209,
					"content": "Без проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090210
					],
					"speakerTitle": "Люка"
				},
				{
					"id": 740090210,
					"content": "А вы уверены, что проблем не будет? Паймон беспокоится, вдруг они начнут драку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740090211,
					"content": "О нет! Вы зря переживаете, милая Паймон. Подобное было бы крайне несчастливым стечением обстоятельств.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090212
					],
					"speakerTitle": "Сонни"
				},
				{
					"id": 740090212,
					"content": "...Для них, конечно же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сонни"
				}
			]
		},
