						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чайльд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10230501,
					"content": "Фух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230502
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230502,
					"content": "Смотри! Он возвращает первоначальную форму!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230546
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230546,
					"content": "Ладно... Давай немного остынем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230503
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230503,
					"content": "Эта Форма духа тяжёлой ношей сдавила всё тело. У меня не было даже секунды для размышлений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230504
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230504,
					"content": "Но если подумать, то вы бы никогда не заполучили Сердце Бога раньше меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230505
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230505,
					"content": "Куда бы ни делось Сердце Бога... Вы к этому не имеете никакого отношения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230506
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230506,
					"content": "Мы же говорили тебе, но ты не слушал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230507,
					"content": "#Путешественни{F#ца}{M#к}, ты гораздо сильнее, чем тебя оценила Синьора в Мондштадте. Скажи мне, как такое возможно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230508,
						10230509
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230508,
					"content": "(Потому что я собираю силу семи элементов...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				},
				{
					"id": 10230510,
					"content": "Ты знаешь правильный ответ. Я вижу его в твоих глазах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230511
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230511,
					"content": "Но если ты хочешь сохранить его в тайне, то я постараюсь унять своё любопытство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230512
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230512,
					"content": "Наша схватка уже превзошла мои самые смелые ожидания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230513
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230513,
					"content": "Тех, кто стремится стать сильнее, я считаю своими друзьями. Хотя такая дружба и проявляется только в схватке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230514
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230514,
					"content": "Странная получается дружба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230515,
					"content": "К сожалению, настал момент прервать нашу любезную беседу. Я должен вернуться к заданию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230516
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230516,
					"content": "Если никто не забирал Сердце Бога, то... может быть, его не было в экзувии с самого начала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230517
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230517,
					"content": "А вдруг экзувия нужна была только для отвлечения внимания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230518
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230518,
					"content": "Ты хочешь сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230519,
						10230520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230519,
					"content": "Властелин Камня жив?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230521,
					"content": "Боюсь, что так. Занимательно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230522
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230522,
					"content": "Видимо, божество торговли умеет виртуозно выходить за рамки контрактов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230523
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230523,
					"content": "Настало время перейти к запасному плану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230524
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230524,
					"content": "Запасному плану?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230525
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230525,
					"content": "Я надеялся, что до этого не дойдёт. Я ненавижу работать с теми, кто слабее меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230526
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230526,
					"content": "Мир принадлежит сильным! Я избегаю общения со скучными слабаками, которые считают иначе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230527
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230527,
					"content": "К сожалению, Предвестники Фатуи не могут быть привередливыми в методах. Дети должны есть овощи, даже если они им не нравятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230528
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230528,
					"content": "И что ты собираешься делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230529
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230529,
					"content": "Я собираюсь пробудить божество, что дремлет в каменном лесу Гуюнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230530
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230530,
					"content": "Божество?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230531
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230531,
					"content": "<color=#00E1FFFF>Осиал, Архонт Вихрей</color>. Моракс победил его во время Войны Архонтов. C тех пор копьё Гео Архонта удерживает Осиала в море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230532
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230532,
					"content": "Если древнее божество нападёт на город, лишённый своего защитника...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230533
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230533,
					"content": "Неужели вы думаете, что лукавый Властелин Камня станет безучастно смотреть, как он будет разрушен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230534
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230534,
					"content": "Но Война Архонтов закончилась две тысячи лет назад! Как может древний бог появиться в мире семи Архонтов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230535
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230535,
					"content": "Очень просто! Я уже приготовил всё для его пробуждения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230536
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230536,
					"content": "А! Это Печати согласия!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230537
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230537,
					"content": "А! Паймон вспомнила! Фатуи исследовали их...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230538,
						10230539
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230538,
					"content": "#Я видел{F#а} исследование своими глазами!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230540,
					"content": "Верно. Мы даже вручили тебе результат наших исследований.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230541
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230541,
					"content": "Если к мощи Печати согласия добавить силу Предвестников Фатуи, дарованную Царицей... То сломать копьё Гео Архонта не составит ни малейшего труда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230544
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230544,
					"content": "Обычно в подобных случаях я стараюсь не прибегать к помощи древних божеств. Это против моих правил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230545
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230545,
					"content": "Но если это не только раскроет планы Гео Архонта, но и заставит вас действовать... Я готов пренебречь правилами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10230539,
					"content": "Вы пытались копировать их.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230520,
					"content": "Тело Архонта ненастоящее?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230509,
					"content": "(Потому что я постепенно восстанавливаю былую силу...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				}
			]
		}
	]
}