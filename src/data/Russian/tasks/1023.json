				"points": []
			},
			"dialogs": [
				{
					"id": 10230301,
					"content": "Ух ты... Это <color=#00E1FFFF>Золотая палата</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230302,
					"content": "Снаружи это место выглядит внушительно... Кто бы мог подумать, что внутри оно ещё роскошнее? Здесь так много моры!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230303,
					"content": "Раз уж здесь чеканят всю мору Тейвата... Никто не заметит, если мы возьмём немного себе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230304,
						10230305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230304,
					"content": "Возьмёшь хоть одну мору, и тебе крышка!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				},
				{
					"id": 10230306,
					"content": "#Ох, так это, оказывается, ловушка! Хитро... Хорошо, что ты меня предупредил{F#а}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230307,
					"content": "Если трогать нельзя, может, хотя бы посмотрим поближе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230308,
					"content": "А ещё мы можем зарыться в гору моры и немного вздремнуть! Мечты сбываются! Хе-хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230309,
						10230310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230309,
					"content": "Давай сначала проверим экзувию.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230311,
					"content": "Точно! У нас же есть задание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230312,
					"content": "Здесь так тихо... Слишком тихо. Экзувия - очень важная штука. Кто-то же должен её охранять, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230313,
					"content": "#Что?! {NICKNAME}, смотри! Что это там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230314,
						10230315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230314,
					"content": "Миллелит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230315
					]
				},
				{
					"id": 10230315,
					"content": "Кажется, он без сознания.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230316
					]
				},
				{
					"id": 10230316,
					"content": "Ох... У меня плохое предчувствие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230317,
					"content": "Скорее! Мы должны убедиться, что экзувия в порядке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10230310,
					"content": "Что-то тут не так...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230305,
					"content": "Если бы всё было так просто, здесь не осталось бы ни одной монеты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				}
			]
		},
		{
			"id": 102305,
			"completionStepIds": [
				102305
			],
