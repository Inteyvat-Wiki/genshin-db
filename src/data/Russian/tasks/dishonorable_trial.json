			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рэйзор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020301,
					"content": "Здесь... вам не рады!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020302
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 80020302,
					"content": "Ха-ха-ха... Значит, дух несчастного волка начал растить щенят?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020303
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80020303,
					"content": "Он считает себя стражем? Его острые когти явно стёрлись со времён былой божественной славы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020304
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80020304,
					"content": "Мы можем восстановить божественные силы, которыми ты обладал в прошлом. Тебе нужно всего лишь служить нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020305
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80020305,
					"content": "Ложь... Ложь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020306
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 80020306,
					"content": "Что это за ритуал? Кажется, ему больно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020307,
					"content": "О нет... Они пытаются отравить его ум так же, как и Двалина?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020308,
					"content": "Волки... не сдаются. Но... продолжать нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020309,
						80020310
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 80020309,
					"content": "Нужно его остановить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				},
				{
					"id": 80020311,
					"content": "Неважно, сколько вы будете противиться нашей воле. Ваши усилия напрасны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80020310,
					"content": "Пора сразиться с Вестником Бездны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				}
			]
		},
		{
			"id": 800204,
			"completionStepIds": [
				800209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800209",
							"2"
						],
						"stepId": 800209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дайнслейф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020401,
					"content": "Величественная статуя, грандиозный собор... Очевидно, что жители Мондштадта потратили огромные усилия и ресурсы на их постройку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020402
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020402,
					"content": "Но осознавал ли это Анемо Архонт, когда получал дары? И сколько он отдал жителям взамен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020403
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020403,
					"content": "Но ведь вера не требует ничего взамен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020404,
					"content": "Хм, пока у богов спокойно на совести, я ничего не могу сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020405
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020405,
					"content": "Тсс! Мы переступаем порог собора. Не говори ничего плохого об Анемо Архонте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020406,
					"content": "Да и к тому же сам Анемо Архонт... Ай, неважно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020407,
					"content": "Я не говорил, что переступлю порог собора вместе с вами. Вы сами сможете разобраться с сёстрами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020408
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020408,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020409,
						80020410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020409,
					"content": "Но мы всё делали вместе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				},
				{
					"id": 80020411,
					"content": "Ты почётный рыцарь Мондштадта. Они обязательно отнесутся к твоей просьбе с полным доверием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020412
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020412,
					"content": "Увидев меня с вами, они могут что-нибудь заподозрить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020413,
						80020414
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020413,
					"content": "Потому что они не знают тебя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020415,
					"content": "Верно. Да и как подметил твой маленький друг... Я могу случайно сказать что-то плохое о церкви.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020416
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020416,
					"content": "Когда неверующий ступает на святую землю, беды не избежать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020417
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020417,
					"content": "Я никогда не испытывал благосклонности богов. И я не думаю, что она может понадобиться мне сейчас или в будущем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020418
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020418,
					"content": "Но хватит об этом. Пока мы болтаем, орден Бездны продолжает действовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020419
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020419,
					"content": "#Ну ладно, {NICKNAME}, пошли сами всё поспрашиваем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020420,
					"content": "Я должен вас кое о чём предупредить. Не следует болтать перед служителями церкви об осквернённой статуе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020421
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020421,
					"content": "Церковь Фавония не сможет обойти эту тему стороной. Их поспешные действия против ордена Бездны лишат нас элемента неожиданности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020422
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020422,
					"content": "К тому же... Вмешательство в дела Бездны ни для кого не заканчивается хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020414,
					"content": "Боишься не понравиться сёстрам?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020410,
					"content": "Тебе не любопытно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				}
			]
		},
		{
			"id": 800205,
