		{
			"id": 800207,
			"completionStepIds": [
				800208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800208",
							"2"
						],
						"stepId": 800208,
						"stateName": "QUEST_STATE_UNFINISHED"
