				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Борей"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020701,
					"content": "Хмпф... Церемония была прервана. Как же вам повезло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020702
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80020702,
					"content": "Как древний дух может иметь столь сильную волю?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020703
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80020703,
					"content": "Не имеет значения. Это всего лишь небольшая переменная, которая никак не повлияет на общий план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020704
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80020704,
					"content": "Опять исчез...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020705,
						80020706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020705,
					"content": "Мы его хотя бы остановили.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				},
				{
					"id": 80020707,
					"content": "Спасибо. Вы пришли... вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020708
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 80020708,
					"content": "Человеческие Лупикал... Мне стыдно представать пред вами в таком обличье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020709
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 80020709,
					"content": "Но всё же Вестник Бездны недооценил мою силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020710
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 80020710,
					"content": "Борей всегда принимает вызов. Но мрачный чужак... не уважает правила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020711
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 80020711,
					"content": "Я тоже не ждал... западню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020712
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 80020712,
					"content": "Ты хочешь сказать, что орден Бездны подготовил всё для порчи сознания Борея, а потом заманил его под предлогом вызова на битву?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020713,
						80020714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020713,
					"content": "Ты не виноват, Рэйзор.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020715,
					"content": "#Спасибо, {NICKNAME}. Потом, мои когти... должны стать острее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020716
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 80020716,
					"content": "#Ты... поймал{F#а} запах беды, поэтому приш{F#ла}{M#ёл}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020717
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 80020717,
					"content": "Нет, мы просто услышали о беде. Носик Паймон даже не знает, как пахнет беда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020718
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020718,
					"content": "И кстати, мы пришли не только помочь. Мы ещё хотим кое о чём спросить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020719
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020719,
					"content": "Эм... Простите, господин Бог Волков. Вы знаете что-нибудь о самом первом культиваторе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020720
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020720,
					"content": "Никакие человеческие механизмы не достойны моего внимания. Я не знаю, что есть «культиватор», но существует одна машина, сделанная руками человека, которую я никогда не забуду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020721
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 80020721,
					"content": "Она случайно оказалась на моей арене, и я принял её за бросившего мне вызов храбреца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020722
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 80020722,
					"content": "Но она не могла думать, лишь сражаться. Все её части с ног до головы могли только убивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020723
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 80020723,
					"content": "В конце концов одна из моих атак сильно повредила её, но перед тем, как упасть, она успела покинуть мою арену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020724
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 80020724,
					"content": "Хмм... Судя по описанию, это мог быть самый первый культиватор, да ведь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020725,
						80020727
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020725,
					"content": "Она могла крутиться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020726
					]
				},
				{
					"id": 80020726,
					"content": "Да. Она могла вращаться, взмывать высоко в воздух и даже пускать огненные шары. Она была сильнее многих, кто владел Глазом Бога, но всё же не была ровней самому богу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 80020730,
					"content": "Огненные шары?.. Постой, мы же недавно где-то такое уже слышали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020731
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020731,
					"content": "Всё намекает на то, что первый культиватор оказался в Мондштадте, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020732
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020732,
					"content": "Судя по историям, первый культиватор был намного сильнее, чем все другие стражи руин с конвейера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020733
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020733,
					"content": "Но в этой истории он оказался повреждён в бою с Волком Севера...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020734
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020734,
					"content": "Не знаю... Но... мы помогли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020735
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 80020735,
					"content": "Да, вы очень помогли нам! Спасибо большое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020736
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020736,
					"content": "Нам нужно продолжить наше суперважное расследование. Хоть Вестник Бездны и ушёл, но силы ордена Бездны продолжают нападать. Берегите себя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020737
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020737,
					"content": "Да, я чувствую... запах беды. Ещё большей беды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020738
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 80020738,
					"content": "Вы двое... тоже осторожно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 80020727,
					"content": "Она могла пускать ракеты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020728
					]
				},
				{
					"id": 80020728,
					"content": "«Ракеты»? Такое слово мне неведомо... Как и было сказано, механизмы людей не достойны моего внимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020729
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 80020729,
					"content": "Она могла вращаться, взмывать высоко в воздух и даже пускать огненные шары. Она была сильнее многих, кто владел Глазом Бога, но всё же не была ровней самому богу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 80020714,
					"content": "Не унывай, всё будет хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020706,
					"content": "Да уж, сбегает он быстро.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				}
			]
		}
	]
}