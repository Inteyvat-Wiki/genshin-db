			},
			"dialogs": [
				{
					"id": 80020501,
					"content": "Орден Бездны уже успел начать проведение новой операции?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020502
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020502,
					"content": "Это может быть связано с осквернённой статуей. Нам тоже следует пойти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020503
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020503,
					"content": "Но зачем ордену Бездны собираться в Вольфендоме? Они собираются повторить то же, что они сделали с Двалином? А-а-а-а! Нам не нужен ещё один Ужас Бури!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80020504,
					"content": "Нет, я так не думаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020505
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020505,
					"content": "В отличие от недавно подавленного Осиала, Андриус уже давно умер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020506
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020506,
					"content": "Сейчас Вольфендом охраняет только лишь его дух.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020507
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80020507,
					"content": "Возможно, Вестник Бездны заинтересовался духом Андриуса, чтобы получить информацию у духа старого друга Анемо Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дайнслейф"
				}
			]
		},
		{
			"id": 800206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
