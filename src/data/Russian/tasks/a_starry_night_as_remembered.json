				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Джерони"
				],
				"points": [
					{
						"sceneId": 10,
						"position": [
							-86.963,
							390.917,
							1393.968
						],
						"pointId": 69
					}
				]
			},
			"dialogs": [
				{
					"id": 790540101,
					"content": "О, как вы здесь оказались? Здесь высоко, да и рельсовых путей нет. Это ведь самый край Миража Велуриям!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540102
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540102,
					"content": "Люди сюда редко захаживают. Даже Идия... Эх, сомневаюсь, что она вообще знает о существовании этого места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540103
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540103,
					"content": "Но здесь же совсем ничего нет. Что ты здесь вообще забыл, Джерони?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790540104,
					"content": "Да просто вышел прогуляться... Эй, не смотрите на меня так, как будто я ушёл из дома, потому что поругался с Фердинандом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540105
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540105,
					"content": "Да не ссорились мы, честно! А прогуливаюсь я просто... э-э... из интереса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540106
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540106,
					"content": "Думаю, вы знаете, что идея с Таратайкой Чух-Чух принадлежит мне. Тогда я всё ходил и мечтал, как было бы хорошо, если бы можно было с лёгкостью подниматься сюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540107
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540107,
					"content": "Поэтому я... поэтому Джерони и придумал повозку Чух-Чух и рельсы. Всё благодаря любви к небу и высотам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540108
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540108,
					"content": "Звучит глупо, да? Слышал я как-то в Инадзуме одну фразу. Звучит как-то так: «покорить небеса стремятся только дым да безумцы»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540109,
						790540110
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540109,
					"content": "Удивительно, что в голову тебе пришла идея сотворить Чух-Чух.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				},
				{
					"id": 790540111,
					"content": "Вот только существует Чух-Чух лишь в Мираже Велуриям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540112
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540112,
					"content": "Ну, не будем об этом... Сюда я пришёл ещё по одной причине - полюбоваться звёздами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540113
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540113,
					"content": "Я знаю, что здешние звёзды - просто отражения своих сестёр за пределами Миража. Однако для меня они всё равно красивы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540114
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540114,
					"content": "Каждую ночь, что я смотрю на звёзды... моё сердце наполняют покой и безмятежность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540115
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540115,
					"content": "Это точно Джерони? Такая любовь к звёздному небу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540116
					]
				},
				{
					"id": 790540116,
					"content": "Такое прекрасное небо не оставит равнодушным никого. Жаль только, что днём звёзды прячутся за облаками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540117
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540117,
					"content": "Но было бы ещё чудеснее, если бы мне не нужно было каждый раз взбираться сюда ради этого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540118
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540118,
					"content": "О! У Паймон появилась идея!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790540119,
					"content": "Ого, неужели есть способ решить эту проблему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540120
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540120,
					"content": "Просто сфотографируй небо и любуйся себе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540121
					]
				},
				{
					"id": 790540121,
					"content": "С...сфотографировать? Вот до чего техника дошла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540122
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540122,
					"content": "Ага! Почему бы нам не сфотографировать звёздное небо для Джерони?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790540123,
					"content": "Вы правда сделаете это для меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540124
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540124,
					"content": "С радостью.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540125
					]
				},
				{
					"id": 790540125,
					"content": "Но сперва нужно найти хороший ракурс...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790540126,
					"content": "Здесь! Ночью с этой платформы открывается чудесный вид на ночное небо! Поэтому я и прихожу именно сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540127
					],
					"speakerTitle": "Джерони"
				},
				{
					"id": 790540127,
					"content": "В самом деле? Отлично! Подожди, мы сделаем фотографию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790540110,
					"content": "Это очень интересная идея.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				}
			]
		},
