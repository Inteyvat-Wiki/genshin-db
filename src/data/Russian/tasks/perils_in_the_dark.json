	"talks": [
		{
			"id": 7104301,
			"completionStepIds": [
				7104305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710430101,
					"content": "«...Старший сержант Антон нашёл на юго-востоке большой колокол... На каменных стенах была \"их\" надпись...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430102
					],
					"speakerTitle": "Дневник Фатуи"
				},
				{
					"id": 710430102,
					"content": "«...Похоже на большой колокол, который капитан видел ранее в руинах на северо-западе. Возможно...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430103
					],
					"speakerTitle": "Дневник Фатуи"
				},
				{
					"id": 710430103,
					"content": "«...Мы послали Снежневну и Фадейку звонить в колокола с двух сторон...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430104
					],
					"speakerTitle": "Дневник Фатуи"
				},
				{
					"id": 710430104,
					"content": "«...Жуткий звук эхом прокатился в горах, чёрный туман рассеялся. Загадочно... Кажется, будто колокола возвещают о прибытии кого-то...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430105
					],
					"speakerTitle": "Дневник Фатуи"
				},
				{
					"id": 710430105,
					"content": "«...Десять человек погибли, оба отряда первопроходцев понесли большие потери. Капитан приказал отступить...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430106
					],
					"speakerTitle": "Дневник Фатуи"
				},
				{
					"id": 710430106,
					"content": "(Из дневника выпадает простая карта, на которой отмечены два больших колокола на северо-западе и юго-востоке, а рядом зловещие черепа.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дневник Фатуи"
				}
			]
		},
