				{
					"id": 200260401,
					"content": "Плата за еду",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260402
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260402,
					"content": "#А вот и ты! Доставил{F#а} еду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260403
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260403,
					"content": "Вот плата за еду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260404
					]
				},
				{
					"id": 200260404,
					"content": "Так, что тут у нас... Да, всё верно. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260405
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260405,
					"content": "<color=#00E1FFFF>Запеканка с овощами, ветчиной и крабом</color> для вас! Прямо из печи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сара"
				}
			]
