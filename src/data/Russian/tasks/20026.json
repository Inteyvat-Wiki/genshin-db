			"dialogs": [
				{
					"id": 200260301,
					"content": "Ваша еда, сэр!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260302
					]
				},
				{
					"id": 200260302,
					"content": "О! Мои <color=#00E1FFFF>жареные редисовые шарики</color>! Вы добавили яйца, как я и просил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260303
					],
					"speakerTitle": "Эрнест"
				},
				{
					"id": 200260303,
					"content": "Ммм... Яйца в этом блюде просто творят чудеса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260304
					],
					"speakerTitle": "Эрнест"
				},
				{
					"id": 200260304,
					"content": "О, да! Поверь мне, я отлично разбираюсь в еде!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260305
					],
					"speakerTitle": "Эрнест"
				},
				{
					"id": 200260305,
					"content": "Благодарю тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эрнест"
				}
			]
		},
