				"points": []
			},
			"dialogs": [
				{
					"id": 200260101,
					"content": "Заказ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260102
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260102,
					"content": "#О, путешественн{F#ица}{M#ик}! Ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260103
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260103,
					"content": "#Ты говоришь, что приш{M#ё}л{F#а} поесть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260104
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260104,
					"content": "Я понимаю твоё желание, но... Давай я приготовлю тебе самое вкусное блюдо на свете, а ты поможешь мне кое-что сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260105
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260105,
					"content": "Эрнест с винокурни «Рассвет» часто заказывает у нас еду, которая должна хорошо сочетаться с вином. Его запросы часто бывают очень специфичны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260106
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260106,
					"content": "На этот раз он заказал <color=#00E1FFFF>жареные редисовые шарики</color>, но непременно с добавлением яиц. А у меня как раз закончились свежие яйца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260107
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260107,
					"content": "Буду бесконечно благодарна, если ты принесёшь мне парочку яиц.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260108,
						200260111
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260108,
					"content": "Хорошо, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260109
					]
				},
				{
					"id": 200260109,
					"content": "Их несложно будет найти в районе долины Ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260110
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260110,
					"content": "Спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260111,
					"content": "Мы просто пришли поесть. Умираем с голоду!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260112
					]
				},
				{
					"id": 200260112,
					"content": "Их несложно будет найти в районе долины Ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260113
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260113,
					"content": "Как только вы вернётесь, я позабочусь о том, чтобы вам накрыли стол в «Хорошем охотнике». Я в долгу не останусь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сара"
				}
			]
		},
