			"dialogs": [
				{
					"id": 200260201,
					"content": "Вот яйца.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260202
					]
				},
				{
					"id": 200260202,
					"content": "Отлично. Одну секунду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260203
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260203,
					"content": "Готово! Теперь отнеси эти <color=#00E1FFFF>жареные редисовые шарики</color> Эрнесту! Скорей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260204
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260204,
					"content": "Не смотри на меня так! Я знаю, что ты хочешь есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260205
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200260205,
					"content": "Когда вернёшься, тебя будет ждать сюрприз от «Хорошего охотника».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сара"
				}
			]
		},
