				"points": []
			},
			"dialogs": [
				{
					"id": 708020101,
					"content": "Найдётся ли папа на этот раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020102
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 708020102,
					"content": "Есть новости о твоём папе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020103
					]
				},
				{
					"id": 708020103,
					"content": "А, это ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020104
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 708020104,
					"content": "Паллад сказал, что дядя Сайрус, кажется, узнал что-то о моём папе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020105
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 708020105,
					"content": "Но он не уверен... Паллад сказал, что они нашли следы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020106
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 708020106,
					"content": "Я хотел пойти с ними на Драконий хребет, но дядя Сайрус сказал мне остаться в лагере. И ещё сказал, что если они что-то узнают, то непременно скажут мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020107
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 708020107,
					"content": "Помоги мне, пожалуйста, найти дядю Сайруса и спросить, есть ли новости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020108,
						708020109
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 708020108,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				},
				{
					"id": 708020110,
					"content": "Я боюсь... что новости будут плохими...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020111
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 708020111,
					"content": "Я рассчитываю на тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 708020109,
					"content": "Почему ты сам не пойдёшь и не спросишь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				}
			]
		},
		{
			"id": 7080202,
