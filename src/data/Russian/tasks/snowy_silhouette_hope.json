			"trigger": {
				"objectNames": [
					"Сайрус",
					"Отчаянный Паллад"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020201,
					"content": "Паллад, ты уверен, что он находится в этом районе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020202,
					"content": "Да, господин Сайрус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708020203,
					"content": "Вы говорите об отце Джоэля?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "#Путешественни{F#ца}{M#к}? Тебя прислал Джоэль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020205,
					"content": "Он каждый день присылает кого-нибудь узнать последние новости...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020206,
					"content": "На это раз у меня для него хорошие новости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020207,
					"content": "Некоторое время назад Гильдия искателей приключений проводила особую тренировку на Драконьем хребте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020208,
					"content": "Господин Сайрус, позвольте мне рассказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708020209,
					"content": "Так вот, участвуя в этой тренировке, я сбился с намеченного пути из-за сильной метели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708020210,
					"content": "Когда я пытался найти обратный путь, я увидел размытый силуэт на скале.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708020211,
					"content": "И подумал, что это такой же заблудившийся искатель приключений, как и я. Я крикнул, чтобы привлечь его внимание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708020212,
					"content": "Но, прежде чем я смог привлечь внимание этого человека... Мои крики привлекли монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708020213,
					"content": "Я не был уверен, что смогу дать им отпор в условиях Драконьего хребта, поэтому поспешно ретировался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708020214,
					"content": "По возвращении я рассказал господину Сайрусу о случившемся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708020215,
					"content": "Тем человеком был отец Джоэля?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "Мы не уверены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020218,
					"content": "В любом случае нам известно, что кто-то заблудился на Драконьем хребте и нуждается в помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020219,
					"content": "Лишь Архонтам известно, кто это человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020220,
					"content": "Я уже отправил на поиски всех, у кого есть возможность исследовать Драконий хребет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020221,
					"content": "Я тоже подготовлюсь и позже присоединюсь к поисково-спасательным работам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708020222,
					"content": "Я пойду с тобой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "Ты хочешь помочь? Отлично! Тогда пойдём вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708020223,
					"content": "Я хорошо справляюсь с монстрами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "Это мог быть заблудившийся искатель приключений...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
				}
			]
		},
