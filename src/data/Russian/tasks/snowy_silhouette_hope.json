			"dialogs": [
				{
					"id": 708020301,
					"content": "Теперь мы знаем, что это безопасный район. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020302
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708020302,
					"content": "О Йозерфе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020303
					]
				},
				{
					"id": 708020303,
					"content": "К сожалению, ранее я тоже ничего не нашёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020304
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708020304,
					"content": "Теперь район чист, и я могу продолжить свои поиски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020305
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 708020305,
					"content": "Скажи, пожалуйста, господину Сайрусу, что я приступил к поисковым работам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Отчаянный Паллад"
				}
			]
		},
