			"dialogs": [
				{
					"id": 708020401,
					"content": "#Путешественни{F#ца}{M#к}, ты вернул{F#ась}{M#ся}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020402,
						708020404
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020402,
					"content": "Паллад начал поиски.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020403
					]
				},
				{
					"id": 708020403,
					"content": "Неужели? Я знал, что в нём есть малая толика ответственности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020406,
					"content": "Как только я закончу текущие дела, то отправлюсь на Драконий хребет, чтобы лично проведать Джоэля и сообщить ему новости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020407
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020407,
					"content": "#Будь {F#добра}{M#добр}, передай Джоэлю, что я скоро навещу его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020408
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020408,
					"content": "Мне понадобится время, чтобы закончить все дела. Не заставляй его ждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 708020404,
					"content": "Вы правда сможете найти того человека?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020405
					]
				},
				{
					"id": 708020405,
					"content": "Ничего не могу обещать, но мы сделаем всё возможное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Сайрус"
				}
			]
