			"dialogs": [
				{
					"id": 722050701,
					"content": "#Здравствуй, {F#сестрёнка}{M#братик}! Мы снова встретились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050702
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050702,
					"content": "Кито сегодня не хочет разговаривать.",
