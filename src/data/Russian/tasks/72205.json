				},
				{
					"id": 722050703,
					"content": "Почему?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050705
					]
				},
				{
					"id": 722050705,
					"content": "Всё в порядке. Сегодня я хочу поиграть один. Не волнуйся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050706
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050706,
					"content": "Посмотри на него, он опять дуется в одиночестве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050707,
						722050708
					],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050707,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050709
					]
				},
				{
					"id": 722050709,
					"content": "Кито, не надо злиться на чужака...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050710
					],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050710,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050711
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050711,
					"content": "Прости, мне не следовало злиться на тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050712,
						722050713
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050712,
					"content": "Ничего страшного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050714
					]
				},
				{
					"id": 722050714,
					"content": "Золотой дядя снова уговаривает нас сесть в лодку... Он говорит, что направляется в сияющее золотое место, где нет тумана! Я не хочу туда! Я хочу остаться с бабушкой Уной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050715
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050715,
					"content": "Он не хочет играть с нами или объяснять, что он имеет в виду. Он просто настаивает, что мы должны уйти... Я боюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050716
					],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050716,
					"content": "Не то, чтобы мы не умели уходить! Мы просто боимся, что бабушка Уна будет волноваться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050713,
					"content": "Расскажи, что случилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050714
					]
				},
				{
					"id": 722050708,
					"content": "Я могу помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050709
					]
				},
				{
					"id": 722050704,
					"content": "Кажется, он грустит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050705
					]
				}
			]
		},
