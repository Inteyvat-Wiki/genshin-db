						722050903,
						722050904
					],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050903,
					"content": "Здравствуйте, Кито, Кина!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050905
					]
				},
				{
					"id": 722050905,
					"content": "Спасибо, но в этот раз нам ничего не нужно. Мы скоро уйдём... Мы отправимся в страну без тумана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050906
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050906,
					"content": "Мы отправимся в большой, блестящий, золотой дом. И мы поплывем туда на лодке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050907
					],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050907,
					"content": "#Прежде чем мы уйдем, мы должны поблагодарить тебя... И ещё, не мог{F#ла} бы ты передать это бабушке Уне от нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050908
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050908,
					"content": "Вложи это в её руку. Тогда она перестанет беспокоиться и пойдёт с нами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050909
					],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050909,
					"content": "Мы надеемся на тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050910
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050910,
					"content": "#Спасибо, {F#сестрёнка}{M#братик}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050904,
					"content": "Вам ещё нужны лепестки сакуры?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050905
					]
				}
