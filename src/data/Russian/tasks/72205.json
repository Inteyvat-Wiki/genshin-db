	"talks": [
		{
			"id": 7220501,
			"completionStepIds": [
				7220501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220501",
							"2"
						],
						"stepId": 7220501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кито",
					"Кина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050101,
					"content": "Странно... Я был уверен, что они у меня в сумке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050102,
						722050103
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050102,
					"content": "Привет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				},
				{
					"id": 722050104,
					"content": "Так не пойдёт, мы должны были отнести их бабушке Уне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050105
					],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050105,
					"content": "Бабушка старенькая, у неё плохая память... В последнее время она снова стала вспоминать молодость...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050106
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050106,
					"content": "Она всегда говорит о цветах... Она даже сказала, что это были цветы с другого берега туманного моря. Они другие, очень красивые...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050107
					],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050107,
					"content": "Однажды мне приснился сон. Мне приснилось, что туман, покрывавший остров, исчез в один миг! И там, на другом берегу моря, стоял большой, красивый дом. Он был сделан не из дерева... или из золота...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050108
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050108,
					"content": "И мне, и мне тоже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050109
					],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050109,
					"content": "В этом сне я взбирался на высокие горы, карабкался по большим деревьям и собирал много-много красивых цветов. Я никогда не видел их прежде, но я знал, что именно их искала бабушка Уна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050110
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050110,
					"content": "Но цветы были слишком тяжелыми, и я упал с дерева. Я падал, падал и падал... а потом проснулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050111
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050111,
					"content": "Это потому, что ты пожадничал. Я говорила, что мы сорвали достаточно цветов, но ты не послушал! И в итоге я упала с дерева вместе с тобой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050112
					],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050112,
					"content": "А теперь у нас ничего нет. Как мы пойдём к бабушке с пустыми руками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050103,
					"content": "Нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				}
			]
		},
		{
			"id": 7220503,
			"completionStepIds": [
				7220512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
