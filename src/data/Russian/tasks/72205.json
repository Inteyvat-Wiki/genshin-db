					"Кито",
					"Кина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050301,
					"content": "#Здравствуй, {F#сестрёнка}{M#братик}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050302,
						722050303
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050302,
					"content": "Привет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				},
				{
					"id": 722050304,
					"content": "#Спасибо, что помог{F#ла} нам достать цветы в прошлый раз. Но... у меня странное ощущение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050305
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050305,
					"content": "И у меня. Очень странное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050306
					],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050306,
					"content": "Куда бы мы ни пошли, мы встречаем грустных людей... и никто нас не слышит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050307
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050307,
					"content": "И каждый раз, когда мы находим красивый цветок, срываем его и кладём в сумку, он очень быстро пропадает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050308,
						722050309
					],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050308,
					"content": "Это потому, что...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050310,
					"content": "Я не понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050311
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050311,
					"content": "Нам нужно уйти?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050312
					],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050312,
					"content": "Золотой дядя тоже говорил что-то подобное... Но мы пока не можем пойти с ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050313
					],
					"speakerTitle": "Кито"
				},
				{
					"id": 722050313,
					"content": "Нам нужно отнести красивые цветы бабушке Уне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кина"
				},
				{
					"id": 722050309,
					"content": "Пришло время уйти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050303,
					"content": "Вы хорошо выглядите.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				}
			]
		},
		{
			"id": 7220505,
			"completionStepIds": [
				7220513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
