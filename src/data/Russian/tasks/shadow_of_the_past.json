			},
			"dialogs": [
				{
					"id": 101200701,
					"content": "Насчёт Шуберта...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200702
					]
				},
				{
					"id": 101200702,
					"content": "Ты имеешь в виду того странного аристократа? Прощу прощения, я его не видела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200703
					],
					"speakerTitle": "Герта"
				},
				{
					"id": 101200703,
					"content": "Люди из клана Лоуренсов часто не хотят добровольно показываться на глаза Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200704
					],
					"speakerTitle": "Герта"
				},
				{
					"id": 101200704,
					"content": "Но это тоже хорошо. Было бы трудно, если бы они влияли на распределение военного снаряжения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200705
					],
					"speakerTitle": "Герта"
				},
				{
					"id": 101200705,
					"content": "Посмотрите наверху. Кто знает, может, он там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Герта"
				}
			]
		},
