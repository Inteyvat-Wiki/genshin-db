			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джинн",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200101,
					"content": "#Почётный рыцарь, спасибо, что наш{F#ла}{M#ёл} время прийти. Знаю, что у тебя много дел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200102
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200102,
					"content": "Коротко говоря, есть одно специфическое дело, в котором ордену требуется твоя помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200103,
						101200105
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200103,
					"content": "Рыцари, как обычно, очень заняты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200104
					]
				},
				{
					"id": 101200104,
					"content": "Да. В последнее время проблемы возникают одна за другой. Ни я, ни другие рыцари в Мондштадте не могут позволить себе ни минуты отдыха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200107,
					"content": "Недавно я получила доклады от рыцарей о том, что некто из клана Лоуренсов тесно контактирует с Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200108
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200108,
					"content": "Фатуи! Опять?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200109,
					"content": "Но кто входит в клан Лоуренсов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200110,
					"content": "В истории Мондштадта был тёмный период, когда городом правили аристократы. Свобода, с таким трудом вырванная у Декарабиана, была вновь утрачена, и рабовладельческий строй распространился повсеместно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200111
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200111,
					"content": "Веннесса, первый Рыцарь Одуванчик, возглавила революцию, свергла аристократов и учредила Ордо Фавониус. Так был создан Мондштадт, который ты можешь видеть сегодня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200112
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200112,
					"content": "Аристократами, что в те годы принесли Мондштадту так много горя, были именно Лоуренсы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200113
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200113,
					"content": "О, Паймон поняла. Сейчас потомки тех плохих людей замышляют что-то недоброе вместе с Фатуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200114,
					"content": "Мы подозреваем, что это так, но у нас нет доказательств. Я позвала тебя сегодня, чтобы попросить помочь нам расследовать это дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200115,
						101200116
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200115,
					"content": "Почему именно я?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200117,
					"content": "Эх... К несчастью, рыцари ордена и аристократы давно враждуют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200118
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200118,
					"content": "Мы долго старались всеми средствами сгладить противоречия. Но потомки аристократов по-прежнему видят в рыцарях врагов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200119
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200119,
					"content": "Что бы мы ни делали, результат всегда один... Наши усилия лишь добавляют масла в огонь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200120
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200120,
					"content": "Хотя мы можем прямо прийти к ним с обыском, но если мы ничего не обнаружим, то вражда и недоверие лишь обострятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200121
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200121,
					"content": "Все наши усилия пойдут прахом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200122
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200122,
					"content": "Но ведь я тоже почётный рыцарь Ордо Фавониус...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200123
					]
				},
				{
					"id": 101200123,
					"content": "Ты лучший кандидат для действий от лица Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200124
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200124,
					"content": "#Не стоит акцентировать внимание на том, что ты почётный рыцарь. Ты путешественни{F#ца}{M#к} из дальних краёв, а это удобная позиция для общения с аристократами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200125
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200125,
					"content": "Когда ты выстроишь дружеские отношения с кланом Лоуренсов, то сможешь выяснить, связаны ли они с Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200126
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200126,
					"content": "Ого, магистр Джинн уже всё продумала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200127,
					"content": "Это всего лишь опыт, полученный после решения ряда дипломатических вопросов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200128
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200128,
					"content": "Нас интересует некто по имени Шуберт из клана Лоуренсов. Он часто прогуливается у северной городской стены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200129
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200129,
					"content": "Говорят, у него непростой характер, но, если сохранять спокойствие при общении с ним, то проблем не должно возникнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200130,
						101200131
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200130,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200132,
					"content": "Спасибо за помощь. Если столкнётесь с трудностями, я сделаю всё, что в моих силах, чтобы помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джинн"
				},
				{
					"id": 101200131,
					"content": "Надеюсь, всё пройдёт гладко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200116,
					"content": "Звучит как дело для рыцаря ордена.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200105,
					"content": "Узнаю действующего магистра Джинн.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200106
					]
				},
				{
					"id": 101200106,
					"content": "Я была бы не против пообщаться с тобой, если бы была возможность, но безопасность Мондштадта стоит превыше всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "Джинн"
				}
			]
		},
		{
			"id": 1012002,
			"completionStepIds": [
				1012003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012003",
							"2"
						],
						"stepId": 1012003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200201,
					"content": "Хм? Кто ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200202
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200202,
					"content": "Привет! Позволь представиться! Мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200203,
					"content": "«Привет»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200204,
						101200206
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200204,
					"content": "П-привет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200205
					]
				},
				{
					"id": 101200205,
					"content": "Я не ослышался? «Привет»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200208,
					"content": "Пф-ф! Ты считаешь, что можешь просто взять и поздороваться со мной в такой грубой манере?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200209
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200209,
					"content": "#Я не знаю тебя, поэтому полагаю, что ты путешественни{F#ца}{M#к} из далёких краёв. Так знай же, что говоришь с Шубертом Лоуренсом, истинным потомком аристократов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200210
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200210,
					"content": "Если ты желаешь поздороваться со мной, тебе следует правильно подбирать слова. Такая фривольная речь режет мне слух.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200211
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200211,
					"content": "#Если ты способ{F#на}{M#ен} осознать хоть часть из того, что я сказал, то долж{F#на}{M#ен} преклонить колено, скромно представиться и извиниться. Так в соответствии с этикетом полагается вести себя в присутствии знатной особы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200212
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200212,
					"content": "Чего? Паймон никогда не слышала о таком сложном этикете!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200213,
					"content": "Пф-ф. В былые времена, когда простолюдины знали своё место и чтили традиции, строгое соблюдение всех правил этикета было единственно верным способом поздороваться с аристократом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200214
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200214,
					"content": "Того, кто не соблюдает этикет перед аристократом, следует по меньшей мере выпороть кнутом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200215
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200215,
					"content": "Но взгляните на современный мир! Мы отказались от правил, позабыли этикет... Эта деградация невыносима!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200216,
						101200217
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200216,
					"content": "Это слишком утомительно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200218,
					"content": "#Что ты сказал{F#а}? Ты смеешь ставить под сомнение достоинство аристократии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200219
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200219,
					"content": "Послушай, что я тебе скажу... Хотя клан Лоуренсов сейчас в упадке, но и я, и другие потомки аристократов ищут шанс, чтобы восстановить нашу былую славу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200220
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200220,
					"content": "Оглянись вокруг: люди совсем распустились. Я же стремлюсь сохранить изящество и манеры аристократов. В конце концов, мы с самого рождения абсолютно разные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200221
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200221,
					"content": "#Я даже слова не успел{F#а} сказать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200222
					]
				},
				{
					"id": 101200222,
					"content": "И не говори. Я нахожу твои действия и манеры отвратительными. Мне нечего обсуждать с такими, как ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200223
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200223,
					"content": "К тому же я не обязан учить простолюдинов вежливости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200224
					],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200224,
					"content": "У меня есть другие важные дела. Прощай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шуберт"
				},
				{
					"id": 101200217,
					"content": "Неудивительно, что аристократы пали.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200206,
					"content": "Что не так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200207
					]
				},
				{
					"id": 101200207,
					"content": "«Что не так?» Ты спрашиваешь, что не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "Шуберт"
				}
			]
		},
		{
			"id": 1012003,
			"completionStepIds": [
				1012005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012005",
							"2"
						],
						"stepId": 1012005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эмбер",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200301,
					"content": "Это же почётный рыцарь! Я как раз собиралась провести разведку, а тут ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200302
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200302,
					"content": "Хм? Судя по выражению твоего лица, что-то случилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200303
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200303,
					"content": "Магистр Джинн дала нам поручение, но... Кажется, мы потерпели фиаско.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200304,
						101200305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200304,
					"content": "Долгая история...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				},
				{
					"id": 101200306,
					"content": "Не падай духом! Иногда что-то идёт не по плану. Я тоже не каждый раз нахожу полезные сведения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200307
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200307,
					"content": "Поэтому продолжай и никогда не сдавайся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200308,
						101200309
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200308,
					"content": "Спасибо тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200310,
					"content": "Хе-хе. Кстати, может, я смогу тебе помочь? Что у вас за проблема?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200311
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200311,
					"content": "Магистр Джинн попросила нас наладить контакт с одним человеком. Его зовут Шуберт Лоуренс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200312,
					"content": "Но оказалось, что он очень эксцентричный и никого не слушает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200313,
					"content": "А-а, Шуберт! Я знаю его! Дай угадаю: он сказал, что у тебя ужасные манеры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200314,
						101200315
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200314,
					"content": "Так ты всё слышала...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200316,
					"content": "Ха-ха, он и мне такое много раз говорил. Лоуренсы удивительно разборчивы в таких вещах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200317
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200317,
					"content": "Что? Хочешь сказать, все в клане Лоуренсов такие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200318,
					"content": "Они, будучи аристократами, считают, что должны держаться с простолюдинами на определённой дистанции. Я понимаю, почему они так думают, но сейчас уже не те времена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200319
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200319,
					"content": "Однако в клане Лоуренсов есть исключение. Это мой хороший товарищ - Эола!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200320
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200320,
					"content": "Т-товарищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200321,
					"content": "Да! Она не только выходец из клана Лоуренсов, но и капитан четвёртой роты Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200322,
						101200323
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200322,
					"content": "Но магистр Джинн сказала, что рыцари для Лоуренсов враги.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200324,
					"content": "Потому что Эола особенная! Она не такая, как другие члены её семьи. У неё свой образ мышления и действий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200325
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200325,
					"content": "Иными словами, она не особо придерживается строгих правил и устоев её семьи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200326
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200326,
					"content": "Но она хорошо знает, как общаться с семьёй Лоуренсов. Ты поймёшь, что я имею в виду, как только увидишь её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200327
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200327,
					"content": "Хм. Это странно. Раз уж Эола принадлежит клану Лоуренсов, почему магистр Джинн попросила нас заняться этим делом? Разве она не могла спросить Эолу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200328
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200328,
					"content": "Ну... Это сложно. Коротко говоря, из-за того, что Эола вступила в ряды рыцарей Ордо Фавониус, остальные члены семьи не очень любят её...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200329
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200329,
					"content": "Для них это выглядит так, будто Эола предала семью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200330,
						101200331
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200330,
					"content": "Она действительно с характером.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200332,
					"content": "Хе-хе, но с ней очень легко общаться. Просто расскажите ей о своих проблемах, и я уверена, что она поможет вам поладить с Шубертом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200333
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200333,
					"content": "Утром она вроде бы патрулирует окрестности. Думаю, ты сможешь найти её у гор Буревестника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200334
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200334,
					"content": "Спасибо, Эмбер! Давай же, пойдём искать Эолу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200335
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200335,
					"content": "Удачи! Мне тоже пора на разведку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 101200331,
					"content": "Наверное, их можно понять...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200323,
					"content": "Как мог член клана Лоуренсов вступить в Орден?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200315,
					"content": "Похоже, ты тоже с этим сталкивалась.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200309,
					"content": "Узнаю Эмбер.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200305,
					"content": "Это не наша вина.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				}
			]
		},
		{
			"id": 1012004,
			"completionStepIds": [
				1012009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012009",
							"2"
						],
						"stepId": 1012009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эола",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200401,
					"content": "А ты сначала бьёшь, потом думаешь, да? Ты хоть представляешь, как долго я их выслеживала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200402
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200402,
					"content": "#И теперь ты заберёшь себе всю славу. Думаешь, ты сильнее просто потому что успел{F#а} перв{F#ой}{M#ым}? Пф-ф. Возмездие настигнет тебя, запомни это!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200403
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200403,
					"content": "...Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200404,
					"content": "Погоди, возмездие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200405
					]
				},
				{
					"id": 101200405,
					"content": "#Точно. Я услышала шум и прибежала так быстро, как только могла, лишь для того, чтобы увидеть, как ты разделал{F#ась}{M#ся} с Фатуи. Должна признать, у тебя это не заняло много времени!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200406
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200406,
					"content": "Если бы я не вмешалась, вы бы забрали себе всю славу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200407
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200407,
					"content": "Хорошо, что вы не пострадали. Бросать вызов нескольким Фатуи одновременно может быть опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200408,
						101200409
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200408,
					"content": "#Я привык{F#ла} сражаться с Фатуи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200410
					]
				},
				{
					"id": 101200410,
					"content": "Хотя Паймон не совсем понимает, о чём речь, но спасибо за то, что беспокоишься за нашу безопасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200411,
					"content": "А? Почему это я должна интересоваться безопасностью моих заклятых врагов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200412
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200412,
					"content": "Но ты только что сказала, «хорошо что вы не пострадали»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200413,
					"content": "А, я имела в виду, что если бы вас ранили, то я бы не только потеряла славу, но и вынуждена была бы сопровождать вас в Мондштадт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200414
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200414,
					"content": "И тем самым вы бы только добавили мне хлопот! И моя месть была бы ещё страшнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200415
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200415,
					"content": "Так вот как ты видишь ситуацию?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200416,
					"content": "Ты Эола?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200417
					]
				},
				{
					"id": 101200417,
					"content": "Точно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200418
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200418,
					"content": "Паймон считает, что она странная! Но с ней хотя бы можно общаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200419
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200419,
					"content": "Ты смеешь называть человека, с которым ты только что встретилась, «странным»? Это не только по аристократическим, но даже и по обычным меркам грубо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200420
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200420,
					"content": "Кстати, откуда вы знаете моё имя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200421
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200421,
					"content": "#Как раз из-за проблем с вежливостью. {NICKNAME} - почётный рыцарь Ордо Фавониус, и мы расследуем дело аристократа по имени Шуберт Лоуренс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200422,
					"content": "Но он очень серьёзно относится к этикету и даже говорить с нами не хочет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200423,
					"content": "Ха-ха-ха! Поняла. Таков уж мой дядя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200424
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200424,
					"content": "Что за дело, связанное с ним, вы расследуете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200425
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200425,
					"content": "Он может иметь тайные связи с Фатуи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200426
					]
				},
				{
					"id": 101200426,
					"content": "Вот оно что, ха-ха. Нужно иметь некоторую смелость, чтобы оклеветать члена моей семьи, глядя прямо мне в глаза. За это я тоже отомщу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200427
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200427,
					"content": "Нет-нет! Это поручение магистра Джинн! И это просто расследование!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200428,
						101200429
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200428,
					"content": "Тебе не любопытно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200430
					]
				},
				{
					"id": 101200430,
					"content": "В глазах жителей Мондштадта, все в клане Лоуренсов негодяи. Естественно, что слухи и сплетни порождают подобные подозрения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200431
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200431,
					"content": "Сложно избежать подобной репутации, если в прошлом ты был известен, как тиран.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200432
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200432,
					"content": "Вот как, да? Ну что ж, моя месть будет жестокой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200433
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200433,
					"content": "Н-но ты же сама это сказала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200434
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200434,
					"content": "Ха-ха-ха, как интересно. Впервые встретились, а у меня уже появилось три повода для мести. Давненько я не встречала таких интересных людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200435,
						101200436
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200435,
					"content": "Твоё понимание «интересного» очень... Интересное.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200437
					]
				},
				{
					"id": 101200437,
					"content": "Значит, вы пришли, чтобы я научила вас этикету клана Лоуренсов, и вы смогли поговорить с моим дядей, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200438
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200438,
					"content": "Да. Эмбер посоветовала нам найти тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200439
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200439,
					"content": "Хорошо, давайте приступим к обучению. Будет проще, если сначала мы вернёмся в Мондштадт. В людных местах удобнее тренироваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200440,
						101200441
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200440,
					"content": "Разве ты не собиралась нам мстить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200442
					]
				},
				{
					"id": 101200442,
					"content": "Эти две вещи никак не связаны. Раз уж таково задание действующего магистра и Эмбер посоветовала обратиться ко мне, то я должна сделать это из уважения к ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эола"
				},
				{
					"id": 101200441,
					"content": "Значит, ты не собираешься воспользоваться случаем, чтобы отомстить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200442
					]
				},
				{
					"id": 101200436,
					"content": "Почему ты выглядишь такой счастливой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200437
					]
				},
				{
					"id": 101200429,
					"content": "Ты не волнуешься за дядю?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200430
					]
				},
				{
					"id": 101200409,
					"content": "Я хорошо сражаюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200410
					]
				}
			]
		},
