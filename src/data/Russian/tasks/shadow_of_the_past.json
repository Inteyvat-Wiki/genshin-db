			"dialogs": [
				{
					"id": 101200801,
					"content": "Привет! Ты не видела здесь аристократа по имени Шуберт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101200802,
					"content": "Хм... Это имя мне ни о чём не говорит, но здесь неподалёку беспрестанно бродит какой-то непонятный человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200803
					],
					"speakerTitle": "Мишель"
				},
				{
					"id": 101200803,
					"content": "Он всё время осматривается, а иногда что-то записывает или зарисовывает. Я не знаю, чем он занимается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200804
					],
					"speakerTitle": "Мишель"
				},
				{
					"id": 101200804,
					"content": "Если это тот, кого вы ищете, направляйтесь к городской стене. Там вы, скорее всего, с ним встретитесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мишель"
				}
			]
		},
