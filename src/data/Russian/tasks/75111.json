			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мичик"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110201,
					"content": "Похоже на экспресс-посылку для Акаты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110202
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 751110202,
					"content": "...Упаковка повреждена. Если мы отправим её в таком виде, содержимое может пострадать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110203
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 751110203,
					"content": "Мне ещё нужно разобраться с экспресс-посылками. Можно попросить тебя доставить её Акате?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110204
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 751110204,
					"content": "Она владелица «Палитры Фриды» на стадионе Священного пламени. Не волнуйся, её вывеску даже при всём желании невозможно не заметить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мичик"
				}
			]
		},
		{
			"id": 7511103,
			"completionStepIds": [
				7511103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7511103",
