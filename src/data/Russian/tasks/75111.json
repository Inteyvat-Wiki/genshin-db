			"dialogs": [
				{
					"id": 751110401,
					"content": "«Самоцветы Мухуру»... Имиш? Она отправила накладную, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110402
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 751110402,
					"content": "Если она потеряется при пересылке, Имиш получит нагоняй от Чивень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110403
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 751110403,
					"content": "Мне ещё нужно разобраться с экспресс-посылками. Можно попросить тебя доставить это Имиш?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110404
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 751110404,
					"content": "«Самоцветы Мухуру» находятся на территории племени Детей Эха. Найти их будет несложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мичик"
				}
			]
		},
