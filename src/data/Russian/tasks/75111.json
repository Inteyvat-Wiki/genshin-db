			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мичик"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110301,
					"content": "Похоже... на почерк Чанки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110302
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 751110302,
					"content": "...Наверняка ещё одна накладная. Конверт повреждён, и мы не можем доставить письмо в таком виде. Придётся вернуть его отправителю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110303
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 751110303,
					"content": "Мне ещё нужно разобраться с экспресс-посылками. Можно попросить тебя доставить письмо Чанке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110304
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 751110304,
					"content": "Она хозяйка «Обители усталости» рядом со стадионом Священного пламени. Её сложно не заметить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мичик"
				}
			]
		},
		{
			"id": 7511104,
