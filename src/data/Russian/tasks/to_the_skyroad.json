			"dialogs": [
				{
					"id": 751350201,
					"content": "Эй, Бона! Летела бы ты помедленнее! Мы не успеваем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751350202,
					"content": "Ха-ха, простите! Не смогла удержаться, когда увидела впереди Алтарь Первозданного огня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350203
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751350203,
					"content": "Значит, Алтарь должен помочь нам попасть на «Тонатиу»? Но даже если нас поднимет мощным порывом ветра, мы ведь не знаем, сколько нужно туда лететь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751350204,
					"content": "Ох, у Паймон от одной мысли об этом сердце не на месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350205,
						751350207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751350205,
					"content": "Паймон, не бойся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350206
					]
				},
				{
					"id": 751350206,
					"content": "Ну ладно. Только не отлетай далеко от Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751350209,
					"content": "Итак, мы должны положить пирофосфорит на Алтарь? Но у нас два пирофосфорита... Гм. Давайте на всякий случай положим оба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бона"
				},
				{
					"id": 751350207,
					"content": "Как волнующе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350208
					]
				},
				{
					"id": 751350208,
					"content": "Ну да, и Паймон тоже взволнована! Ни один настоящий искатель приключений не пропустит такое испытание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Бона"
				}
			]
		}
