			"dialogs": [
				{
					"id": 751350101,
					"content": "Это и есть Алтарь? Ого, добраться туда будет непросто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751350102,
					"content": "#Мы с тобой можем летать, а как же {REALNAME[ID(2)|SHOWHOST(true)]} и Бона?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751350103,
					"content": "Вы что, забыли? Я искательница приключений из клана Цветочного Пера! У меня богатый лётный опыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350104
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751350104,
					"content": "Я долечу туда даже с вашим заврёнком на буксире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350105
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751350105,
					"content": "У меня тоже есть лётная лицензия.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350106
					]
				},
				{
					"id": 751350106,
					"content": "Вот и отлично. Я буду показывать дорогу, а вы постарайтесь не отстать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350107
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751350107,
					"content": "Устроим испытание на скорость?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350108
					]
				},
				{
					"id": 751350108,
					"content": "Сейчас не время для соревнований. Я буду показывать дорогу, а вы постарайтесь не отстать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350109
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751350109,
					"content": "#Как-то это опасно. И непонятно, что нас там ждёт. {REALNAME[ID(2)|SHOWHOST(true)]}, держись за нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751350110,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
