					"Микоси Гэнитиро"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722720102,
					"content": "Хочу продать кое-какие сокровища.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720103
					]
				},
				{
					"id": 722720103,
					"content": "А? Ну, по правде говоря, нам удалось восстановить регулярные поставки товаров, и у нас нет привычки собирать всякую всячину...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720104
					],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720104,
					"content": "Но, судя по твоему виду, вещица стоящая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720105
					],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720105,
					"content": "Ладно... Не позволишь взглянуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720106
					],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720106,
					"content": "Вы рассказываете Микоси Гэнитиро историю жемчужины Драконьего цветка.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722720107
					]
				},
				{
					"id": 722720107,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720108
					],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720108,
					"content": "Честно говоря, это история очень занимательна, но, на мой взгляд, немного причудлива...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720109
					],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720109,
					"content": "Такие вещи находятся за гранью моего понимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720110
					],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720110,
					"content": "Не насмехайся, пожалуйста. Я лишь простой ремесленник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720120
					],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720120,
					"content": "Как насчёт 80 000 моры? Могу добавить ещё пять порций ассорти из сашими. Отнюдь не дешёвое блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720111,
					"content": "Если цена тебя устраивает, то по рукам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720112,
						722720115,
						722720117
					],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720112,
					"content": "Что ты будешь с ней делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720113
					]
				},
				{
					"id": 722720113,
					"content": "Ещё не знаю. Мне нужно поразмыслить над этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720114
					],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720114,
					"content": "При благоприятном исходе я смогу изготовить из неё нэцке и продать за хорошую цену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720115,
					"content": "Справедливая цена. Договорились.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720116
					]
				},
				{
					"id": 722720116,
					"content": "Тогда держи свою мору, а я займусь изучением этого сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720117,
					"content": "Мне нужно ещё подумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720118
					]
				},
				{
					"id": 722720118,
					"content": "Ну да... И мне тоже не помешает ещё немного поразмыслить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720119
					],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720119,
					"content": "Приходи, когда всё обдумаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Микоси Гэнитиро"
				}
			]
		},
