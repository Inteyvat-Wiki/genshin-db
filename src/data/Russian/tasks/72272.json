					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720207
					]
				},
				{
					"id": 722720207,
					"content": "Ну да... И мне тоже не помешает ещё немного поразмыслить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720208
					],
