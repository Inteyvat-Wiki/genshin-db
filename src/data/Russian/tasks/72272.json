					"speakerTitle": "Микоси Гэнитиро"
				},
				{
					"id": 722720204,
					"content": "Тогда забирай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720205
					]
				},
				{
					"id": 722720205,
					"content": "Тогда держи свою мору, а я займусь изучением этого сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Микоси Гэнитиро"
				},
				{
