			},
			"dialogs": [
				{
					"id": 200280101,
					"content": "#Спасибо, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280102
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 200280102,
					"content": "Хоть я и охотник, но со слаймами мне не справиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280103
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 200280103,
					"content": "Из-за этих дурацких слаймов я остался с пустыми руками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280104
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 200280104,
					"content": "Надеюсь, что другим повезло больше, чем мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280105
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 200280105,
					"content": "Кстати, можешь помочь мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280106
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 200280106,
					"content": "Возможно, мне просто показалось, но вроде бы слаймов становится всё больше и больше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280107
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 200280107,
					"content": "Пожалуйста, посмотри, ждут ли нас впереди слаймы. Если ждут, ты знаешь, что делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280108,
						200280109
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 200280108,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280110
					]
				},
				{
					"id": 200280110,
					"content": "Спасибо за помощь! Надо скорее рассказать Драффу о случившемся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280111
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 200280111,
					"content": "Надеюсь, что он ещё достаточно трезв, чтобы выслушать меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 200280109,
					"content": "Мне некогда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280112
					]
				},
				{
					"id": 200280112,
					"content": "Прошу, сделай это! Если не для меня, то ради Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Робкий Морро"
				}
			]
		}
	]
