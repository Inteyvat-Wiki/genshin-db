	"talks": [
		{
			"id": 7280402,
			"completionStepIds": [
				7280404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280404",
							"2"
						],
						"stepId": 7280404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кайраги",
					"Асакура"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040206,
					"content": "А-а... П-пощади! И откуда у тебя такие помощники...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040207
					],
					"speakerTitle": "Кайраги"
				},
				{
					"id": 728040207,
					"content": "Бесчестный негодяй! А ну, отдавай мне моё оружие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040208
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040208,
					"content": "Ты... ты всё никак не забудешь о нём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040209
					],
					"speakerTitle": "Кайраги"
				},
				{
					"id": 728040209,
					"content": "Я здесь лишь для того, чтобы вернуть своё оружие. Если скажешь, где оно, я пощажу тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040210
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040210,
					"content": "Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040211,
						728040212
					],
					"speakerTitle": "Кайраги"
				},
				{
					"id": 728040211,
					"content": "Не трать на него слова.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				},
				{
					"id": 728040213,
					"content": "Н-нет, прошу вас! Стойте! Не нужно горячиться! Я... Я не говорил, что буду молчать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040214
					],
					"speakerTitle": "Кайраги"
				},
				{
					"id": 728040214,
					"content": "Э-это оружие находится в коллекции нашего главаря. Если вы хотите забрать его, вы можете пройти в наш лагерь - вон там, - и забрать его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040215
					],
					"speakerTitle": "Кайраги"
				},
				{
					"id": 728040215,
					"content": "Хм... А ты не такой уж и глупый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040216
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040216,
					"content": "П-пожалуйста, добрые люди, я сказал вам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040217
					],
					"speakerTitle": "Кайраги"
				},
				{
					"id": 728040217,
					"content": "Прочь с моих глаз!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040218
					]
				},
				{
					"id": 728040218,
					"content": "Есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040219
					],
					"speakerTitle": "Кайраги"
				},
				{
					"id": 728040219,
					"content": "Боец он, конечно, неважный, зато как бегает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040220
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040220,
					"content": "И когда друзей закладывал, тоже не мешкал.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040221
					]
				},
				{
					"id": 728040221,
					"content": "По сути дела, кайраги - это свора разношёрстных негодяев, которых объединяет лишь жажда наживы. Преданность и убеждения для них - пустой звук.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040222
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040222,
					"content": "Один лишь намёк на неприятности - и их уже и след простыл. Обычное дело, впрочем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040223
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040223,
					"content": "И всё же мне повезло, что вы со мной. Думаю, иначе он бы так просто не сдался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040224
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040224,
					"content": "Итак, дальше мы направляемся в их основной лагерь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040225
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040225,
					"content": "Будем придерживаться прежнего плана. Я беру на себя их главаря, а вам оставляю всю мелкую рыбёшку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040226,
						728040227
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040226,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040228,
					"content": "Благодарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040227,
					"content": "Без проблем, я могу десять человек в одиночку положить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040212,
					"content": "Найдём кого-нибудь другого.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				}
			]
		},
		{
			"id": 7280403,
			"completionStepIds": [
				7280405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280405",
							"2"
						],
						"stepId": 7280405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лидер Кайраги"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040301,
					"content": "Ты? Ха, неужто тот самый маленький негодник? Пришёл снова пополнить мою коллекцию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040302
					],
					"speakerTitle": "Лидер Кайраги"
				},
				{
					"id": 728040302,
					"content": "Нет. Я здесь за своим оружием!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040303
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040303,
					"content": "Хе-хе, ну, по крайней мере, ты не трус. Но всего лишь один союзник? Серьёзно? Ты меня совсем ни во что не ставишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040304
					],
					"speakerTitle": "Лидер Кайраги"
				},
				{
					"id": 728040304,
					"content": "Впрочем, я вознагражу тебя за твою смелость. Идём! Уладим этот вопрос в другом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040305
					],
					"speakerTitle": "Лидер Кайраги"
				},
				{
					"id": 728040305,
					"content": "Однако... Как-то нехорошо оставлять моих ребяток здесь без дела... Может, твоя помощница, поиграет с ними?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040306,
						728040307
					],
					"speakerTitle": "Лидер Кайраги"
				},
				{
					"id": 728040306,
					"content": "Ну? Кто на меня?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				},
				{
					"id": 728040308,
					"content": "Ха-ха! Напрашиваешься! Ребята, вы слышали? Задайте трёпку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040309
					],
					"speakerTitle": "Лидер Кайраги"
				},
				{
					"id": 728040309,
					"content": "А ты... С тобой мы пока отойдём в сторонку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040310
					],
					"speakerTitle": "Лидер Кайраги"
				},
				{
					"id": 728040310,
					"content": "В таком случае я оставляю их на вас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040311
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040311,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040312
					]
				},
				{
					"id": 728040312,
					"content": "Покорно благодарю за помощь! Я быстро с ним расправлюсь и присоединюсь к вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040313
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040313,
					"content": "И ты бахвалишься? Что ж, я дам тебе возможность показать себя в деле!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лидер Кайраги"
				},
				{
					"id": 728040307,
					"content": "Эх, надеюсь, будет не слишком скучно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				}
			]
		},
		{
			"id": 7280404,
			"completionStepIds": [
				7280407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280407",
							"2"
						],
						"stepId": 7280407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Асакура"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040406,
					"content": "Судя по тому, что у вас даже не сбилось дыхание, эти кайраги вам совсем не ровня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040407
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040407,
					"content": "Ты тоже, похоже, возвращаешься с победой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040408
					]
				},
				{
					"id": 728040408,
					"content": "Так и есть. Правда, должен признать, что, к моему стыду, будучи обманут отвлекающим ударом, я позволил ему сбежать. Однако я успел пронзить его копьём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040409
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040409,
					"content": "И всё же, ранил я его тяжело. Не думаю, что в ближайшие пару лет он будет доставлять неприятности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040410
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040410,
					"content": "А главное, я сам победил его и вернул своё оружие. Наконец-то я смыл с себя это пятно позора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040411
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040411,
					"content": "Поздравляю, Асакура.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040412
					]
				},
				{
					"id": 728040412,
					"content": "Я действительно признателен вам! Однако мне пока что ещё рано расслабляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040413
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040413,
					"content": "Эта ситуация возникла из-за недостатка моего мастерства. Я должен продолжать тренироваться и оттачивать свои навыки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040414
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040414,
					"content": "Поэтому... Я буду рассчитывать на совместные тренировки с вами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040415
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040415,
					"content": "Ах да... Пожалуйста, примите это в знак моей благодарности. Здесь немного, но это от чистого сердца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040416
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 728040416,
					"content": "Ещё раз спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асакура"
				}
			]
		}
	]
}