			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Саборн",
					"Суфаш",
					"Симест"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700101,
					"content": "Приветствую вас в Королевстве ветров и колоколов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700102
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700102,
					"content": "Что дальше?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700103
					]
				},
				{
					"id": 790700103,
					"content": "Хм... Прежде всего, я объявлю всем, что реликвия сделала свой выбор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700104
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700104,
					"content": "А Защитником оказался... прибывший издалека господин Форобер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700105
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700105,
					"content": "Почему ты приняла такое решение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790700106,
					"content": "Пытаться объяснить всем то, через что мы прошли, слишком сложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700107
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700107,
					"content": "Кроме того, вряд ли все смогут сразу понять, почему я и принцесса, и Защитник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700108
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700108,
					"content": "Когда придёт время, я всё подробно запишу и расскажу народу в письменном виде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700109
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700109,
					"content": "До тех пор я буду руководить делами королевства как принцесса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700110
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700110,
					"content": "Как только площадки испытания официально станут тренировочными площадками, я уеду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700111,
						790700112
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700111,
					"content": "Уедешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				},
				{
					"id": 790700113,
					"content": "Ваше высочество, разве вы забыли... для кого реликвия засветилась в пещере?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700114
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700114,
					"content": "Для кого же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700115
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700115,
					"content": "Да, ведь в тот момент рядом были мы все. Ваше высочество, конечно, заслуживает признания, но я... я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700116
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700116,
					"content": "Ты чемпион, признанный чемпионом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700117
					]
				},
				{
					"id": 790700117,
					"content": "Ага. И этот чемпион пришёл со своей просьбой. Тебе нужны доказательства признания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790700118,
					"content": "Возможно, это сияние принцессы нас ослепило, и произошла ошибка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700119
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700119,
					"content": "Итак, господин Чемпион, согласен ли ты пройти ещё одно испытание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700120
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700120,
					"content": "Я, принцесса Симест Королевства ветров и колоколов, лично засвидетельствую твои деяния перед реликвией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700121
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700121,
					"content": "Конечно! Я согласен, согласен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700122,
						790700123
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700122,
					"content": "Не волнуйся так.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700124,
					"content": "Так волнуется, когда дело касается принцессы. Хе-хе, Форобер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790700125,
					"content": "Не поймите меня неправильно! Это всё ради миссии пруда! Я столько тренировался, чтобы спасти... эм, защитить принцессу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700126
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700126,
					"content": "Учитывая важность миссии, само собой, я хочу исключить возможность ошибки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700127
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700127,
					"content": "Хочешь отправиться в путешествие вместе с принцессой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700128
					]
				},
				{
					"id": 790700128,
					"content": "Х-хочу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700129
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700129,
					"content": "Ха, вот и отлично. Тогда, господин Чемпион Форобер, ты готов к моему испытанию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700130
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700130,
					"content": "Да, ваше высочество! Всегда готов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700131
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700131,
					"content": "Ого! Реликвия снова засветилась! Как ярко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790700123,
					"content": "Мои уши!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700112,
					"content": "Что ты планируешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				}
			]
		},
		{
			"id": 7907002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Форобер",
					"Ореллу",
					"Эстамп"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700201,
					"content": "Эстамп! Где ты был?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700202
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700202,
					"content": "Эм, я бродил по округе и попробовал пройти то испытание. Было весело, но мне нужно использовать другой подход, чтобы его пройти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700203
					],
					"speakerTitle": "Эстамп"
				},
				{
					"id": 790700203,
					"content": "Ореллу мне всё про тебя рассказал. Неплохо, господин Защитник. Ты очень талантлив, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700204
					],
					"speakerTitle": "Эстамп"
				},
				{
					"id": 790700204,
					"content": "Т-ты! Будь ты рядом, я бы тебя выпихнул! Хоть десять раз, если понадобится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700205
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700205,
					"content": "Поэтому я и пошёл тренироваться. Форобер, друг мой, я в тебя верю. Видишь, вопрос уже решён.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700206
					],
					"speakerTitle": "Эстамп"
				},
				{
					"id": 790700206,
					"content": "Ха-ха-ха-ха, добрые господа, сегодня счастливый день для Пруда песни дождя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700207
					],
					"speakerTitle": "Ореллу"
				},
				{
					"id": 790700207,
					"content": "У нас наконец-то появился настоящий чемпион. Пусть у господина Форобера ещё и не было шанса спасти принцессу, однако я уверен, что у него будет шанс показать, на что он способен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700208
					],
					"speakerTitle": "Ореллу"
				},
				{
					"id": 790700208,
					"content": "Увы! Я ничего такого не сделал, господин Ореллу. Просто стоял рядом, пока принцесса была занята делом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700209
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700209,
					"content": "Так это же отлично. Или вы предпочли бы, чтобы принцессе угрожала опасность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700210
					],
					"speakerTitle": "Ореллу"
				},
				{
					"id": 790700210,
					"content": "Ну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700211
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700211,
					"content": "Ох, ладно. Господин Форобер, вам поручил миссию сам Сибрелус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700212
					],
					"speakerTitle": "Ореллу"
				},
				{
					"id": 790700212,
					"content": "Я даже не знаю, точно ли он Сибрелус! Я слышал о нём, но его голос мне незнаком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700213
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700213,
					"content": "К тому же ты принял испытание от принцессы. Ты достоин звания чемпиона!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700214
					],
					"speakerTitle": "Эстамп"
				},
				{
					"id": 790700214,
					"content": "Мы можем пока не говорить об этом? Пожалуйста...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700215
					],
					"speakerTitle": "Форобер"
				},
				{
					"id": 790700215,
					"content": "В любом случае будущее Пруда песни дождя в твоих лапках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700216
					],
					"speakerTitle": "Ореллу"
				},
				{
					"id": 790700216,
					"content": "Теперь, когда мы наконец-то можем прыгать просто так, я вернусь в комитет и предложу добавить больше весёлых элементов в соревнования по прыжкам в длину!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700217
					],
					"speakerTitle": "Ореллу"
				},
				{
					"id": 790700217,
					"content": "Это отличная идея, поддерживаю. Давайте возвращаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700218
					],
					"speakerTitle": "Эстамп"
				},
				{
					"id": 790700218,
					"content": "Не оставляйте меня здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Форобер"
				}
			]
		},
		{
			"id": 7907003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Симест",
					"Саборн",
					"Суфаш"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700301,
					"content": "И вы, и эта бумажная лягушка были признаны Защитниками, ваше высочество?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700302
					],
					"speakerTitle": "Саборн"
				},
				{
					"id": 790700302,
					"content": "Невозможно! Неслыханно! Такого не было никогда ранее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700303
					],
					"speakerTitle": "Суфаш"
				},
				{
					"id": 790700303,
					"content": "И вы собираетесь превратить испытание в... Не может быть! Нет! Ваше высочество!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700304
					],
					"speakerTitle": "Саборн"
				},
				{
					"id": 790700304,
					"content": "Вы не можете просто так поменять столь древнее наследие! Ваше высочество!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700305
					],
					"speakerTitle": "Суфаш"
				},
				{
					"id": 790700305,
					"content": "Ладно-ладно, потише. У меня в ушах звенит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700306
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700306,
					"content": "Итак, решено. Я принцесса и Защитник, признанный реликвией. Вы не сможете меня остановить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700307
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700307,
					"content": "Но, ваше высочество...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700308
					],
					"speakerTitle": "Саборн"
				},
				{
					"id": 790700308,
					"content": "Не волнуйтесь. Я буду руководить тренировками и подготовлю множество надёжных белок-летяг для защиты королевства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700309
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700309,
					"content": "И только после этого уйду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700310
					],
					"speakerTitle": "Симест"
				},
				{
					"id": 790700310,
					"content": "Ваше высочество, мы... Ох. Вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700311
					],
					"speakerTitle": "Суфаш"
				},
				{
