	],
	"talks": [
		{
			"id": 7052001,
			"completionStepIds": [
				7052001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052001",
							"2"
						],
						"stepId": 7052001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бернхард",
					"Матс",
					"Полин",
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705200101,
					"content": "Почётный рыцарь, Паймон! У меня для вас хорошая новость! У нас появились новые помощники!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200102
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705200102,
					"content": "Услышав про благотворительную ярмарку, к нам захотели присоединиться два владельца магазинов и даже хотят пожертвовать мору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200103
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705200103,
					"content": "Что? Пожертвовать? Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200104,
					"content": "Да, да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200105
					],
					"speakerTitle": "Матс"
				},
				{
					"id": 705200105,
					"content": "Чем больше средств, тем больше людей получат помощь. Мы с Полин считаем, что это куда важнее, чем просто зарабатывать деньги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200106
					],
					"speakerTitle": "Матс"
				},
				{
					"id": 705200106,
					"content": "В этом году Праздник вина посетило больше людей, так что мы раньше срока выполнили свой план, и я очень довольна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200107
					],
					"speakerTitle": "Полин"
				},
				{
					"id": 705200107,
					"content": "Вы столько делаете ради детей и стариков. Мы тоже хотим помогать по мере возможности. Пусть это вас не беспокоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200108
					],
					"speakerTitle": "Полин"
				},
				{
					"id": 705200108,
					"content": "Искренне благодарю вас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200109
					]
				},
				{
					"id": 705200109,
					"content": "Ага, Паймон на душе так хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200110,
					"content": "Но тогда Паймон думает, что нужно сменить название! Пусть наша лавка будет называться «Вкуснота и милота от Фавониуса».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200111,
						705200112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200111,
					"content": "Становится всё веселее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200113
					]
				},
				{
					"id": 705200113,
					"content": "Мы очень постараемся и сделаем благотворительную ярмарку потрясающей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200114,
					"content": "Два владельца лавки присоединяются к команде, и масштаб вашей ярмарки расширяется...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705200115
					]
				},
				{
					"id": 705200115,
					"content": "Подходите, не стесняйтесь! Особые закуски, повседневные товары и цветы во «Вкусноте и милоте от Фавониуса»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200116,
					"content": "А? Смотри, Альбедо пришёл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200117,
					"content": "#{NICKNAME} и Паймон, привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200118,
						705200119
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200118,
					"content": "Добро пожаловать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200120
					]
				},
				{
					"id": 705200120,
					"content": "Ты что-то ищешь, Альбедо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200121,
					"content": "Ничего конкретного. Я просто услышал, что орден открыл лавку, которой заведуете вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200122
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200122,
					"content": "Мы с Тимеем как раз добились значительных результатов в исследовании, поэтому привезли вам нашу продукцию. Считайте, что это наша помощь для благотворительной ярмарки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200123
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200123,
					"content": "Ты специально приехал сюда, чтобы помочь нам? Как мило!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200124,
					"content": "Дай-ка посмотреть, у нас тут бутылочки... А что там внутри?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200125,
					"content": "Это отрезвляющее зелье. Оно помогает от похмелья и снимает головную боль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200126
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200126,
					"content": "Раздайте эти бутылки нуждающимся. Надеюсь, эти подарки привлекут к вам больше клиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200127
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200127,
					"content": "Ой, на такую полезную вещь вы, наверное, потратили столько сил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200128,
					"content": "Хм? Может быть, я слишком долго не проявлял своих способностей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200129
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200129,
					"content": "Раньше я бы и не занялся таким исследованием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200130
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200130,
					"content": "Но ведь это здорово, что алхимия может облегчить жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200131
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200131,
					"content": "Ага! Паймон никогда не напивалась, но Паймон представляет, как полезно это зелье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200132,
					"content": "Если упасть в озеро или поскользнуться на камне после хорошего вина, то радостное настроение сразу улетучится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200133,
					"content": "Мы должны тебя отблагодарить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200134
					]
				},
				{
					"id": 705200134,
					"content": "Ага. Альбедо, возьми вот эти вкусности и угости Кли. Считай, что мы в расчёте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200135,
					"content": "Хорошо, тогда не откажусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200136
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200136,
					"content": "Не ожидал, что вы обладаете такой деловой хваткой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200137
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200137,
					"content": "Идея открыть закусочную довольно остроумна и вписывается в праздничную атмосферу. А то, как вы разделили обязанности, выше всяких похвал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200138
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200138,
					"content": "Если бы другие члены ордена занимались этим делом, то они бы просто продавали всякую мелочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200139
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200139,
					"content": "Ого, не так уж часто Альбедо раздаёт комплименты. Паймон как будто того зелья хлебнула.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200140,
					"content": "Хм, кажется, ты довольно много знаешь о благотворительных ярмарках, Альбедо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200141
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200141,
					"content": "Ага, прошлый раз, когда орден продавал всякую мелочь во время благотворительной ярмарки, я передал десяток своих пейзажей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200142
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200142,
					"content": "Вот это да! Рисунки Альбедо должны стоить кучу денег!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200143,
					"content": "Ну, покупателям, похоже, так кажется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200144
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200144,
					"content": "Действительно есть люди, которые считают мои рисунки произведением искусства и предметом для инвестиций. Поэтому они купили их за очень хорошую сумму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200145
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200145,
					"content": "Этот факт, а также значительная прибыль от продажи моих картин на аукционе, натолкнули Алису на одну мысль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200146
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200146,
					"content": "Она через свои каналы зарегистрировала право на мои работы. Кажется, оно называется «авторское право».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200147
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200147,
					"content": "Потом многие художники стали подражать моему стилю, и в результате в Мондштадте такие картины распространились повсюду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200148,
						705200149
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200148,
					"content": "Что-то припоминаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200150
					]
				},
				{
					"id": 705200150,
					"content": "Согласно авторскому праву, за каждую картину, нарисованную в таком стиле, художники должны платить мне определённую часть выручки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200151
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200151,
					"content": "Стать богатым никогда не было моей целью. Меня не волнует, откуда появляется мора, поэтому все свои права я передал ордену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200152
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200152,
					"content": "Я полагаю, было бы уместно использовать эти средства, чтобы заплатить за разрушения, которые устроила Алиса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200153
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200153,
					"content": "Но я слышал, что в конечном итоге они использовали всё это на благотворительность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200154,
						705200155
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200154,
					"content": "Ты никогда не участвовал в благотворительной ярмарке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200156
					]
				},
				{
					"id": 705200156,
					"content": "Ты такой замечательный, Альбедо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200157
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200157,
					"content": "Сначала я не хотел этого, но неожиданно став филантропом, я потихоньку научился это принимать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200158,
						705200160
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200158,
					"content": "#Я очень рад{F#а} за тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200159
					]
				},
				{
					"id": 705200159,
					"content": "#Спасибо, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200162
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200162,
					"content": "Что ж, мне пора вернуться в мастерскую. Всего вам хорошего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200163
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200163,
					"content": "Спасибо за поддержку, Альбедо. Мы тоже желаем тебе успехов в исследованиях!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200164
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200164,
					"content": "Вы лично готовите закуски для Альбедо...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705200165
					]
				},
				{
					"id": 705200165,
					"content": "Будет время, заходи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705200160,
					"content": "Я хочу научиться рисовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200161
					]
				},
				{
					"id": 705200161,
					"content": "Разумеется, я с удовольствием поделюсь своим опытом. Однако придётся много тренироваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200162
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 705200155,
					"content": "Но сделал для бедных больше нас...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200156
					]
				},
				{
					"id": 705200149,
