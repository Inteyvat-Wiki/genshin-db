			"order": 1,
			"listShowType": "QUEST_SHOW",
			"description": "Вернитесь в лавку и узнайте, как проходит благотворительная ярмарка",
			"finishConditions": [
				{
					"type": "QUEST_CONTENT_COMPLETE_TALK",
