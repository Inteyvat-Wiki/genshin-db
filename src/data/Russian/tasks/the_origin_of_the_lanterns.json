			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Верр Голдет"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110101,
					"content": "Праздник морских фонарей уже скоро. Может, стоит украсить постоялый двор?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110102
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 413110102,
					"content": "Праздник морских фонарей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110103
					]
				},
				{
					"id": 413110103,
					"content": "Ты не знаешь? Праздник морских фонарей проходит в Ли Юэ каждый год и начинается в ночь первого полнолуния.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110104
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 413110104,
					"content": "Это день памяти героев. Ночью жители города запускают в небо небесные фонари и лунный фонарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110105
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 413110105,
					"content": "Эти фонари означают вот что: «Пусть пламя добродетели разносится по миру и никогда не погаснет». Мы верим, что свет фонарей в ночи, словно сияние маяка, укажет душам погибших героев дорогу домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110106
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 413110106,
					"content": "Ух ты... Звучит как большой праздник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110107,
					"content": "А где большой праздник... Там много вкусной еды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110108,
					"content": "#{NICKNAME}, ты ведь понимаешь, к чему Паймон клонит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110109,
					"content": "Хотите принять участие в празднике? Это замечательно! Весь день до запуска фонарей тоже считается праздничным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110110
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 413110110,
					"content": "В это время мы молимся, чтобы на нас снизошло благополучие, а беды ушли. Местные говорят так: «Простись со старым и встречай новое».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110111
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 413110111,
					"content": "Ещё не поздно принять участие в празднике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110112
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 413110112,
					"content": "Ах, да...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110113
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 413110113,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110114
					]
				},
				{
					"id": 413110114,
					"content": "Могу я попросить вас... Хм... Может, вы сможете убедить Сяо пойти с вами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110115
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 413110115,
					"content": "Мы с ним не особо близки, и я не знаю, как пригласить его. Но вы, похоже, стали хорошими знакомыми, поэтому...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110116
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 413110116,
					"content": "Но учитывая его настроение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110117
					]
				},
				{
					"id": 413110117,
					"content": "Да, Паймон думает, что его лучше на несколько дней оставить в покое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110118,
					"content": "Вам виднее... Ну да ладно! Я сказала это к слову. Скорее идите в <color=#00E1FFFF>Ли Юэ</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110119
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 413110119,
					"content": "Если придёте поздно, на улицах будет много людей и не протолкнуться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110120
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 413110120,
					"content": "Идите! Счастливого Праздника морских фонарей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верр Голдет"
				}
			]
		},
		{
			"id": 4131103,
			"completionStepIds": [
				4131103
