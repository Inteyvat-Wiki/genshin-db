			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзян Чжоу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110601,
					"content": "#Смотри, {NICKNAME}! Камень действительно парит в воздухе! Цепь так туго натянута...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110602,
					"content": "Если бы не цепь, кто знает, куда бы он улетел?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110603,
					"content": "Плаустрит поднимет в воздух лунный фонарь. Весь Ночной рынок расположился вокруг него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110604
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 413110604,
					"content": "Привет. Кто вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110605,
					"content": "Меня зовут Цзян Чжоу. Я слежу за ходом строительства лунного фонаря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110606
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 413110606,
					"content": "Вы здесь новенькие? Первый раз на Празднике Морских Фонарей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110607
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 413110607,
					"content": "Верно... Как вы догадались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110608,
					"content": "Не припомню, чтобы в прошлом году на фестивале были такие странные создания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110609
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 413110609,
					"content": "Так что же такое лунный фонарь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110610
					]
				},
				{
					"id": 413110610,
					"content": "Вы увидите, как люди будут запускать в небо множество маленьких фонарей. Эти фонари называются «небесные фонари». Ещё есть один огромный фонарь, его собирают все жители Ли Юэ. Мы зовём его «лунный фонарь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110611
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 413110611,
					"content": "На Ночном рынке ты встретишь торговцев со всего Ли Юэ. Но они здесь не для того, чтобы заработать денег. Все вырученные средства пойдут на постройку лунного фонаря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110612
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 413110612,
					"content": "На Ночном рынке есть вкусная еда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110613,
					"content": "Конечно, и много! Я считаю, что Праздник морских фонарей - это лучший праздник для того, чтобы попробовать деликатесы Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110614
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 413110614,
					"content": "Это самый крупный праздник в Ли Юэ, и поэтому, продемонстрировав на нём продукт своего ремесла, можно заработать славу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110615
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 413110615,
					"content": "Поэтому, хотя денег здесь не заработаешь, каждый торговец всё равно тайно старается показать свою продукцию на Празднике морских фонарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110616
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 413110616,
					"content": "Ого, люди в Ли Юэ такие сметливые...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110617
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110617,
					"content": "Если у вас будут ещё вопросы, ищите заведующую праздником госпожу <color=#00E1FFFF>Ван Я</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110618
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 413110618,
					"content": "Обычно её можно найти около Ночного рынка. Если что, обращайтесь к ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110619
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 413110619,
					"content": "А она знает, где тут самая вкусная еда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110620
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110620,
					"content": "Конечно, она знает всё об этом Празднике морских фонарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110621
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 413110621,
					"content": "#Понятно! {NICKNAME}, скорее, пойдём на Ночной рынок и найдём <color=#00E1FFFF>Ван Я</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110622
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110622,
					"content": "А потом... Пойдём в закусочную с самой вкусной едой и объедимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4131107,
			"completionStepIds": [
				4131107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131107",
							"2"
						],
						"stepId": 4131107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ван Я"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110701,
					"content": "Привет. Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110702
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413110702,
					"content": "#Судя по твоему виду, ты не из Ли Юэ. Значит, ты путешественни{F#ца}{M#к}? Добро пожаловать на Ночной рынок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110703
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413110703,
					"content": "Здравствуйте. Вы заведуете Праздником морских фонарей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110704
					]
				},
				{
					"id": 413110704,
					"content": "Заведую?.. Не совсем так. Праздник морских фонарей - это праздник всех жителей Ли Юэ, и ни один человек не сможет сам заведовать им.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110705
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413110705,
					"content": "Я лишь занимаюсь некоторыми пустяками. Стараюсь, чтобы все получили ещё больше удовольствия от праздника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110706
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413110706,
					"content": "У меня есть несколько вопросов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110707
					]
				},
				{
					"id": 413110707,
					"content": "Мы хотим узнать, где на Ночном рынке самая вкусная еда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110708,
					"content": "Самая вкусная еда? Сказать сложно, ведь у каждого свои вкусы. Но могу сказать, что последнее время лавка <color=#00E1FFFF>И Няня</color> самая популярная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110709
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413110709,
					"content": "Если очередь к нему станет ещё больше, мне придётся доложить Миллелитам, чтобы они навели порядок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110710
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413110710,
					"content": "Если хотите туда сходить, то идите прямо сейчас, пока людей на улицах не так много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110711
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413110711,
					"content": "Если ищете И Няня, пожалуйста, окажите мне услугу и передайте ему этот документ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110712
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413110712,
					"content": "Это обзор данных, полученных Департаментом по делам граждан за прошлый год. Он содержит советы по ведению дел для каждого торговца. Раз уж вы всё равно туда идёте, вы могли бы заодно помочь мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110713
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413110713,
					"content": "Когда вернётесь, я подарю вам кое-что в качестве вознаграждения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ван Я"
				}
			]
		},
		{
			"id": 4131108,
			"completionStepIds": [
				4131108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131108",
							"2"
						],
						"stepId": 4131108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"И Нянь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110801,
					"content": "Нам действительно не хватает рабочих рук. Знай я заранее, что так будет, я бы привлёк ещё кого-нибудь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110802
					],
					"speakerTitle": "И Нянь"
				},
				{
					"id": 413110802,
					"content": "Что у вас тут самое вкусненькое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110803,
					"content": "А, новые клиенты? Вот, ознакомьтесь с меню. Я могу приготовить всё, что здесь указано. Или, если вы хотите заказать что-то конкретное, скажите, и я приготовлю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110804
					],
					"speakerTitle": "И Нянь"
				},
				{
					"id": 413110804,
					"content": "Ух ты! Паймон будет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110805,
					"content": "Хм, хотя это и лавка быстрых блюд, но здесь подают любые блюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110806,
					"content": "Конечно! Если я не могу что-то приготовить, значит, я ещё даже не слышал о таком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110807
					],
					"speakerTitle": "И Нянь"
				},
				{
					"id": 413110807,
					"content": "Это документ от Ван Я.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110808
					]
				},
				{
					"id": 413110808,
					"content": "А, каждый год одно и то же. Мне не нужны советы, прекрасный вкус - вот моё главное оружие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110809
					],
					"speakerTitle": "И Нянь"
				},
				{
					"id": 413110809,
					"content": "Эх, ладно. Давай мне документ, я его позже в печь брошу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110810
					],
					"speakerTitle": "И Нянь"
				},
				{
					"id": 413110810,
					"content": "Ну, заказывайте что-нибудь. Неужели вы пришли не ради еды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110811
					],
					"speakerTitle": "И Нянь"
				},
				{
					"id": 413110811,
					"content": "Здесь столько всего вкусного! Вот это хорошо выглядит. Это Паймон тоже хочет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110812
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110812,
					"content": "Ой, Жареная рыба-тигр? Паймон помнит, Бронзовый Воробей очень любил это блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110813
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110813,
					"content": "Хм... Раз уж Праздник морских фонарей - это день памяти героев, давай закажем это блюдо, чтобы почтить его память.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110814,
						413110815
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110814,
					"content": "Ты просто сама хочешь её съесть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110816
					]
				},
				{
					"id": 413110816,
					"content": "У этой малышки хороший вкус. Это моё коронное блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110817
					],
					"speakerTitle": "И Нянь"
				},
				{
					"id": 413110817,
					"content": "Подождите немного, я скоро приготовлю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110819
					],
					"speakerTitle": "И Нянь"
				},
				{
					"id": 413110819,
					"content": "Так, вот ваша жареная рыба-тигр. Как вам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110820
					],
					"speakerTitle": "И Нянь"
				},
				{
					"id": 413110820,
					"content": "Вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110821
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110821,
					"content": "Паймон знает толк в еде...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110822
					]
				},
				{
					"id": 413110822,
					"content": "Конечно! Иначе какой из Паймон был бы проводник?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110823
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413110823,
					"content": "Ха-ха-ха, приятного аппетита. А я пойду обслуживать других клиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110824
					],
					"speakerTitle": "И Нянь"
				},
				{
					"id": 413110824,
					"content": "Если снова проголодаетесь, вы знаете, где меня искать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "И Нянь"
				},
				{
					"id": 413110815,
					"content": "Да, узнаю Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110816
					]
				}
			]
		},
		{
			"id": 4131111,
			"completionStepIds": [
				4131111
			],
