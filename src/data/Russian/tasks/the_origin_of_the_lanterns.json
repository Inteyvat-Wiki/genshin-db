			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чан Чан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010901,
					"content": "Меня зовут Чан Чан! Я пожертвовала свою куклу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010902
					],
					"speakerTitle": "Чан Чан"
				},
				{
					"id": 400010902,
					"content": "Вчера мне приснилось, что кукла хочет полетать высоко-высоко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010903
					],
					"speakerTitle": "Чан Чан"
				},
				{
					"id": 400010903,
					"content": "Поэтому я отдала её женщине рядом с большим фонарём-оленем. Она же полетит высоко-высоко, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010904
					],
					"speakerTitle": "Чан Чан"
				},
				{
					"id": 400010904,
					"content": "Я ведь сделала хорошее дело, да? В праздники желания должны сбываться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чан Чан"
				}
			]
		},
