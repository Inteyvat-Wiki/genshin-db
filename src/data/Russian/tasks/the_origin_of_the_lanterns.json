			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мадам Пин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "В этом году лунный фонарь посвящён Могучему Повелителю Небесных Пределов... Уверена, что ему бы это понравилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010602,
					"content": "Расскажи мне про Могучего Повелителя Небесных Пределов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "Когда фонарь достроят, он будет выглядеть в точности как Могучий Повелитель Небесных Пределов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010604,
					"content": "Надеюсь, что рога получатся достаточно большими. Адепт ими очень гордился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010605,
					"content": "Согласно легенде его рога - дар Властелина Камня, Гео Архонта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010606,
					"content": "Но во время схватки ему пришлось пожертвовать всем. Когда гора треснула и накренилась, друг Адепта отрубил ему рога, чтобы спасти жителей деревни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010607,
					"content": "Он вбил клином свои рога в горную расщелину, а затем продолжил сражаться с демоном до последней капли крови...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010608,
					"content": "Благодаря его подвигу гора Тяньхэн гордо высится до сих пор, а его кровь, пролитая в схватке с демоном, превратилась в реку Бишуй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010609,
					"content": "Хе-хе... Верить в эту историю или нет, решать тебе. Спасибо за внимание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010610
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010610,
					"content": "Праздник морских фонарей существует потому, что люди на протяжении долгих веков предпочитают жить в мире и согласии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010611,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010612
					]
				},
				{
					"id": 400010612,
					"content": "Пока! Пусть пламя добродетели разносится по миру и никогда не погаснет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мадам Пин"
				}
			]
		},
		{
			"id": 4131106,
			"completionStepIds": [
				4131106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
