					"Ван Я"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413111101,
					"content": "Ох, вы вернулись. Ну как, у И Няня неплохие блюда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111102
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413111102,
					"content": "Очень вкусные!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413111103,
					"content": "Он сказал, что не будет читать документ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413111104
					]
				},
				{
					"id": 413111104,
					"content": "Да? В прошлом году он сказал то же самое... Если бы он разместил рекламу согласно нашим рекомендациям, его выручка бы увеличилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111105
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413111105,
					"content": "Ладно, не обращайте внимания. Вот ваш подарок. Это небесный фонарик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111106
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413111106,
					"content": "Ух ты, Какой красивый! Как его сделали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413111107,
					"content": "Хм... Боюсь, я не смогу объяснить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111108
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413111108,
					"content": "Если вы заинтересованы в небесных фонарях, спросите <color=#00E1FFFF>Цзин Мина</color>, он тут неподалёку. Он отвечает за небесные фонарики и лунный фонарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111109
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413111109,
					"content": "Он ответственен за тот большой-пребольшой фонарь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413111110,
					"content": "Да. Он где-то недалеко, вы легко его найдёте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111111
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 413111111,
					"content": "Если мы сделаем небесный фонарь для Сяо, может, он немного развеселится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413111112,
					"content": "Давай поскорее найдём этого <color=#00E1FFFF>Цзин Мина</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4131112,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
