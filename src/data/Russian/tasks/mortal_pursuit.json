				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Пума",
					"Шилонен"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1374.526,
							169.17,
							7678.847
						],
						"pointId": 350400214
					}
				]
			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "Некоторое время спустя в мастерской Шилонен...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "Я вернулась. Позвольте познакомить вас с матерью Тепала, Пумой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220203,
					"content": "Здравствуйте, мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150220204,
					"content": "Оставьте любезности. Я не хочу говорить об этом мальчишке дольше, чем нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "Пума"
				},
				{
					"id": 150220205,
					"content": "А?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150220206,
					"content": "Я давно отреклась от него... Он не мой сын!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "Пума"
				},
				{
					"id": 150220207,
					"content": "Всё, что его волновало, - его несбыточная мечта достичь неба... Мы пытались образумить его, но он был словно одержим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "Пума"
				},
				{
					"id": 150220208,
					"content": "Хмф... Потом, когда он покинул нас, он говорил какую-то чушь о том, что построит мастерскую в небе, чтобы избежать постоянной критики со стороны нас, жителей земли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "Пума"
				},
				{
					"id": 150220209,
					"content": "Он оставил этот блокнот. Какие бы вопросы у вас ни возникли, там вы можете отыскать ответы. Больше не хочу говорить о нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "Пума"
				},
				{
					"id": 150220210,
					"content": "Он мне не сын... Он никогда не называл меня «мамой»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "Пума"
				},
				{
					"id": 150220211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220212,
					"content": "Паймон и подумать не могла, что у них такие плохие отношения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150220213,
					"content": "Её муж, отец Тепала... он недавно скончался, а Тепал даже не удосужился прийти на похороны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220214,
					"content": "По-моему, для Пумы это стало последней каплей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220215,
					"content": "Я пойду успокою её. Вы знаете, где меня искать, если что.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220216,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220217,
					"content": "Итак, этот блокнот - единственная зацепка, которая у нас есть? Что там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150220218,
					"content": "Хм... несколько ранних эскизов флогистоновых крыльев... и размышления о воздушной мастерской.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220219,
					"content": "Очканатлан, сожжённый город... Похоже, именно оттуда он черпал своё технологическое вдохновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220220,
					"content": "Значит, он всерьёз задумался о мастерской в небе? Но это слишком большой проект для одного человека... как думаете, он его осуществил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150220221,
					"content": "Посмотрите на эскиз воздушного шара...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "...О! Да! Тот, что на месте испытания. Он был очень высоко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150220224,
					"content": "Этот шар висит там уже давно, и всем интересно, как он взлетел так высоко. Но... что, если это неправильный вопрос?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220225,
					"content": "Что, если он спустился с ещё более высокой точки, выше облаков и вне зоны видимости, и оказался на этой высоте исключительно в результате какой-то неисправности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220226,
					"content": "Значит, он может быть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "...частью мастерской Тепала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150220228,
					"content": "Похоже на то. Если база Тепала всё это время скрывалась за облаками, то это объясняет, почему Исидор не мог её найти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220229,
					"content": "Паймон сразу догадалась... Но как мы туда заберёмся? Часка, ты сможешь взлететь так высоко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150220230,
					"content": "В одиночку... возможно. Но с пассажиром - без шансов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220231,
					"content": "Сомневаюсь, что даже флогистоновые крылья смогут поднять вас так высоко... по крайней мере, без той «реликвии», о которой Тепал упоминал в своём блокноте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220232,
					"content": "Да, и он, наверняка, держит её при себе... Придётся искать другой способ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150220233,
					"content": "Ты можешь взлететь так высоко, Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "Нет, это намного выше возможностей Паймон! Кроме того, неужели вы думаете, что Паймон поднимется туда и в одиночку справится с Тепалом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150220235,
					"content": "Давайте не будем расстраиваться. Если мы не можем придумать решение, это не значит, что никто другой не может. Я не единственный эксперт по полётам в своём племени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220236,
					"content": "О, хорошая мысль. Нужно спросить старейшину Альпу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150220237,
					"content": "И Мутоту. В своё время он был настоящим асом. Давайте вернёмся и посмотрим, что они посоветуют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220222,
					"content": "Кажется, мы его уже где-то видели...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
		{
			"id": 1502203,
