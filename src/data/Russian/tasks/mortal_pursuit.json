				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Шилонен"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "Альпа сказала, что Тепал из Детей Эха. Но как нам его разыскать? Ходить по округе и расспрашивать всех, пока не найдём его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150220102,
					"content": "Давайте для начала поговорим с кем-нибудь из знакомых - так будет быстрее. В это время и в этом месте проще всего будет найти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220103,
					"content": "Шилонен, пора вставать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220104,
					"content": "*зевает* А, это вы... Уф... Дайте мне секундочку, сейчас спущусь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220105,
					"content": "*зевает*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220106,
					"content": "Похоже, вам обеим нравится лазить по деревьям...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "Я лазаю по деревьям, чтобы летать дальше и видеть дальше. Обычно я не сплю там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220108,
					"content": "Ну, не все, как ты, всегда полны энергии, даже когда целый день летали... Итак. Вы проделали долгий путь и прервали мой драгоценный сон. Могу я поинтересоваться, зачем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220109,
					"content": "Прости, Шилонен, но дело не терпит отлагательств. Имя Тепал тебе о чём-нибудь говорит? Судя по всему, он ремесленник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220110,
					"content": "Тепал? Да, мне знакомо это имя... Это сын Пумы, если я не ошибаюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220111,
					"content": "Он сейчас в племени?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "Нет, боюсь, вы опоздали на несколько лет... Почему вы его ищете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220113,
					"content": "Это долгая история...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "Вы пытаетесь коротко и доступно объяснить, что произошло...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "Флогистоновые крылья? Ну и ну. У парнишки и правда получилось... Похоже, сегодня мне не удастся отдохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220116,
					"content": "И правда получилось? Хочешь сказать, что он уже пытался сделать что-то подобное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150220117,
					"content": "Да, он начал пытаться построить летательный аппарат сразу после возвращения из клана Цветочного Пера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220118,
					"content": "Значит, сразу после того, как стал бескрылым... Значит, этот летающий аппарат был похож на оружие, которое вы для меня смастерили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150220119,
					"content": "Ты о своём оружии, которое приручить сложнее, чем самого гордого кукузавра? Нет, он хотел создать нечто такое, что позволит любому человеку свободно летать, даже если у него нет врождённых способностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220120,
					"content": "Но в те времена ему так и не удалось преуспеть. Несколько раз его мастерская взрывалась, и он едва выжил. После этого я потеряла его из виду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220121,
					"content": "В молодости его родители много путешествовали и вернулись в племя только после его рождения. Но они поселились в отдалённом районе и мало общались с другими людьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220122,
					"content": "А это значит, что большинство соплеменников знают их не очень хорошо... Лучше всего побеседовать с его семьёй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 150220123,
					"content": "Я схожу за Пумой. Жди меня в мастерской, я скоро буду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шилонен"
				}
			]
		},
		{
			"id": 1502202,
