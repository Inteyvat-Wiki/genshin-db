				"points": []
			},
			"dialogs": [
				{
					"id": 726640101,
					"content": "Хм... Надо ещё сундуков с сокровищами расставить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640102
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640102,
					"content": "Каких-каких сундуков?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640103
					]
				},
				{
					"id": 726640103,
					"content": "#А?! А, путешественни{F#ца}{M#к}, это ты. Тоже будешь участвовать в Лунной охоте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640104
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640104,
					"content": "Ага.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640105
					]
				},
				{
					"id": 726640105,
					"content": "Тогда ты очень вовремя! Гильдия искателей приключений как раз сейчас готовит мероприятия для праздника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640106
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640106,
					"content": "Хочешь узнать побольше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640107,
						726640108
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640107,
					"content": "А какие мероприятия будут?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640110
					]
				},
				{
					"id": 726640110,
					"content": "Во время Лунной охоты Гильдия искателей приключений повсюду раскладывает амулеты Лунной охоты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640111
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640111,
					"content": "Те кто их найдёт, могут прийти в Гильдию и обменять амулеты на награды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640112
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640112,
					"content": "А ещё мы отправили несколько искателей приключений расставить по пустошам кучу особых сундуков с сокровищами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640113
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640113,
					"content": "Эти сундуки битком набиты сокровищами, которые мы подготовили специально к празднику.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640114
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640114,
					"content": "А кроме этих двух событий мы ещё подготовили особенно сложные испытания для самых наших элитных искателей приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640115
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640115,
					"content": "Короче говоря... Есть несколько лагерей монстров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640116,
						726640117
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640116,
					"content": "Какое отношение это имеет к Лунной охоте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640118,
					"content": "А... Ха-ха, ну... Это... Не надо так говорить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640119
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640119,
					"content": "За победу над этими монстрами Гильдия награды даёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640120
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640120,
					"content": "Ну это же то же самое, что и обычные поручения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640121
					]
				},
				{
					"id": 726640121,
					"content": "Пожалуйста, помоги нам! Почти все искатели приключений на празднике, и никто не берёт наши поручения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640122
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640122,
					"content": "Ну что? С твоими навыками ты легко справишься с этими монстрами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640123,
						726640124
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640123,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640125,
					"content": "#Награда тебя не разочарует! Не волнуйся, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640126
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640126,
					"content": "Весь праздник Лунной охоты я буду здесь. Если появятся вопросы - спрашивай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640127
					],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640127,
					"content": "#Мы рассчитываем на тебя, путешественни{F#ца}{M#к}. Ну... хорошего праздника!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Ян"
				},
				{
					"id": 726640124,
					"content": "Готовь награду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640117,
					"content": "Никакого отношения к Лунной охоте не имеет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640108,
					"content": "Только бы не ежедневные задания опять...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640109
					]
				},
				{
					"id": 726640109,
					"content": "Нет-нет! В этот раз будут прямо приключенческие мероприятия!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640110
					],
					"speakerTitle": "Линь Ян"
				}
			]
		}
	]
}