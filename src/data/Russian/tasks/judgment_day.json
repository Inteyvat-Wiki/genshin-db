							4470.388
						],
						"pointId": 8397
					}
				]
			},
			"dialogs": [
				{
					"id": 140310101,
					"content": "...Ничего не получилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310102
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310102,
					"content": "Нет, я опросила почти всех в Кур-де-Фонтейне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310103
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310103,
					"content": "Линетт поникла, когда услышала, что ей предстоит несколько дней подряд быть вне дома. А Фремине... надел шлем, как только понял, что его будут окружать незнакомцы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310104
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310104,
					"content": "А как насчёт Тиори и Шарлотты? Думаю, они справятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310105
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310105,
					"content": "Я спросила их, но они сейчас очень заняты. Я дала членам Спина-ди-Росула несколько выходных и не хочу их беспокоить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310106
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310106,
					"content": "...Непростая задача.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310107
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310107,
					"content": "Навия! Клоринда! Привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310108,
					"content": "#Ого! Это же {M#мой напарник}{F#моя напарница} и Паймон! Привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310109
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310109,
					"content": "Навия!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310110
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310110,
					"content": "А? О! Ты хочешь сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310111
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310111,
					"content": "Да, это наш шанс!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310112,
						140310113
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310112,
					"content": "Что это вы затеяли?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310114
					]
				},
				{
					"id": 140310114,
					"content": "У вас что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310115,
					"content": "Определённо! Мои дорогие партнёры, у нас возникла огромная проблема, и только вы можете её разрешить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310116
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310116,
					"content": "Ого! А ты не преувеличиваешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310117,
					"content": "Категорически нет. Мы уже исчерпали все другие варианты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310118,
						140310119
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310118,
					"content": "Что за проблема?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310120
					]
				},
				{
					"id": 140310120,
					"content": "#{NICKNAME}, Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310121
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310121,
					"content": "Хотите вместе с нами сыграть в игру «Охотник Сумеречного двора: Судный день»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310122
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310122,
					"content": "Это что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310123,
					"content": "Это новый сценарий игры, который написала «Настольная труппа», местный ролевой клуб.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310124
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310124,
					"content": "Вы слышали о «Настольной труппе»? Они создают игры, которые позволяют погрузиться в историю и разыгрывать роли вместе с друзьями. Я люблю их игры с самого детства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310125
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310125,
					"content": "Звучит очень интересно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310126,
					"content": "Мы с Клориндой - давние члены клуба. Недавно они придумали новый сценарий и ищут желающих его протестировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310127
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310127,
					"content": "Разумеется, я не могла им отказать. Ведь это же совершенно новый сценарий! Никто и никогда прежде его не разыгрывал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310128
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310128,
					"content": "Как правило, в сценариях такого уровня содержится много недоработок. Но этот сценарий, на мой взгляд, получился довольно добротным. Автор явно вложил много труда в сюжет, да и мироустройство вполне правдоподобно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310129
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310129,
					"content": "Эй, эй, эй! Я сама ещё не читала сценарий, так что давай без спойлеров, пожалуйста!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310130
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310130,
					"content": "...В общем, по сценарию команда должна состоять из четырёх человек. Нам не хватает одного игрока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310131
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310131,
					"content": "И правда огромная проблема!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310132
					]
				},
				{
					"id": 140310132,
					"content": "#Значит... ты поможешь нам? Я знала, что могу рассчитывать на тебя, {M#напарник}{F#напарница}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310133
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310133,
					"content": "#Паймон тоже можно поучаствовать? Паймон и {NICKNAME} неразлучны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310134,
					"content": "Конечно. Я буду корректировать темп в зависимости от фактического количества игроков и следить за тем, чтобы все хорошо провели время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310135
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310135,
					"content": "#{NICKNAME}, что скажешь? Хочешь сыграть? Паймон сделает всё, что пожелаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310136,
						140310137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310136,
					"content": "Не могу бросить друзей в беде.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310138
					]
				},
				{
					"id": 140310138,
					"content": "Значит, проблема решена. Спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310139
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310139,
					"content": "Ву-ху! Пойду приведу сценариста из клуба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310140
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310140,
					"content": "Сценариста? Ты же сказала, что отдала сценарий Клоринде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310141
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310141,
					"content": "Клуб представил совершенно новый вид игрового процесса по этому сценарию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310142
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310142,
					"content": "В этой модификации версия сценария для ведущего является неполной. Сценарист предоставляет следующую часть сценария только после того, как игроки выполнят все текущие задачи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310143
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310143,
					"content": "Кроме того, для более полного погружения в игру клуб создал декорации и сцены в реальной жизни. Мы узнаем, куда нам нужно отправиться, только когда сценарист объявит начальную локацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310144
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310144,
					"content": "Ух ты, автор сценария и правда приложил немало усилий!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310145,
					"content": "Хе-хе, и в нём присутствует здоровая доля интриги, верно? Я хочу сказать, что даже ведущий не знает, чем закончится сюжет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310146
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310146,
					"content": "Мне не терпится окунуться в эту атмосферу вместе с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310147
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310147,
					"content": "Почему бы вам для начала не встретиться с остальными? Они должны быть в «Доме Тиори». Я зайду за сценаристом, и мы присоединимся к вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310148
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310148,
					"content": "Хорошо. Помни, всегда смотри, куда идёшь, и не спеши.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310149
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310149,
					"content": "Почему ты говоришь со мной, как с ребёнком?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310150
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310150,
					"content": "Хм... Дай-ка подумать, за кого из персонажей мне сыграть на этот раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310151
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310151,
					"content": "...Надеюсь, что на этот раз ты приобретёшь полезные навыки. О, и хватит пытаться «убедить» каждое встречное животное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310137,
					"content": "Разве можно отказаться от интересного сценария?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310138
					]
				},
				{
					"id": 140310119,
					"content": "Расскажи поподробнее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310120
					]
				},
				{
					"id": 140310113,
					"content": "Мы просто проходили мимо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310114
					]
				}
			]
		},
