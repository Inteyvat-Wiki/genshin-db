							4438.059
						],
						"pointId": 8402
					}
				]
			},
			"dialogs": [
				{
					"id": 140310201,
					"content": "Прошу прощения, что заставили себя ждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310202
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310202,
					"content": "#А, вы уже вернулись! {NICKNAME} и Паймон тоже здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310203
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 140310203,
					"content": "Какой приятный сюрприз. Полагаю, вы присоединитесь к игре?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310204
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 140310204,
					"content": "Лини! Фурина! Паймон не знала, что вы тоже играете! Вы члены «Настольной труппы»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310205,
					"content": "Привет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310206
					]
				},
				{
					"id": 140310206,
					"content": "Хм, я по большому счёту случайно тут оказался. Я не принимал участия в официальных мероприятиях клуба. Линетт, Фремине и я иногда играем в нечто подобное в особняке «Буфф д'эте», но обычно я ведущий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310207
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 140310207,
					"content": "Я впервые разыгрываю сценарий в роли игрока. Надеюсь, мне понравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310208
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 140310208,
					"content": "Ну, я вовсе не член клуба. Клоринда разбудила меня сегодня утром и сказала, что есть хороший сценарий, который стоит того, чтобы его разыграть, и спросила, не хочу ли я принять участие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310209
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 140310209,
					"content": "Если хочешь, я могу дать тебе рекомендацию. В этом случае ты получишь скидку в сорок процентов на членские взносы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310210
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310210,
					"content": "Пожалуй, я сперва оценю сценарий, посмотрю насколько он качественный. Если будет достаточно увлекательно, то я вступлю в клуб.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310211
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 140310211,
					"content": "Клоринда, ты часто участвуешь в мероприятиях «Настольной труппы»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310212,
					"content": "Можно и так сказать. По сути, она одна из немногих главных ведущих в труппе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310213
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 140310213,
					"content": "Да, точно. Я знала об этом, ещё когда она была моей подчинённой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310214
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 140310214,
					"content": "...Ничего выдающегося, правда. Маленькое хобби.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310215
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310215,
					"content": "Ух ты, Паймон настолько привыкла видеть тебя в образе грозного судебного дуэлянта, что не может представить тебя частью «Настольной труппы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310216,
						140310217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310216,
					"content": "Значит, если у нас возникнут сложности с толкованием правил...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310218
					]
				},
				{
					"id": 140310218,
					"content": "Шутишь? Я бы никогда не стала специально усложнять жизнь игрокам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310219
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310219,
					"content": "Я соблюдаю границы профессиональной и личной жизни. В суде я олицетворяю закон и порядок Фонтейна. Я отбрасываю все личные чувства в сторону и предоставляю право на честный поединок всем, кто стремится защитить свою честь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310220
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310220,
					"content": "Но в личной жизни я обычный человек и испытываю гнев и печаль, как и все остальные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310221
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310221,
					"content": "Хоть ты и говоришь так, но за всё то время, что я тебя знаю, мне кажется, я ни разу не видела, чтобы ты плакала... Я видела, как ты злишься, но... интересно, на самом ли деле ты злишься или это только со стороны так кажется?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310222
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 140310222,
					"content": "Вероятно, в такие моменты я находилась в рабочем режиме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310223
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310223,
					"content": "Правда? Так или иначе, мне кажется, что даже в личной жизни ты не так часто проявляешь эмоции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310224
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 140310224,
					"content": "Значит, ты хочешь увидеть меня в слезах? Это будет непросто. А вот в гневе... Пожалуй, могу продемонстрировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310225
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310225,
					"content": "Нет-нет-нет, я не это имела в виду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310226
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 140310226,
					"content": "А вот и я! Позвольте представить вам сценариста, господина Флориана!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310227
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140310227,
					"content": "Рад знакомству.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310228
					],
					"speakerTitle": "Флориан"
				},
				{
					"id": 140310228,
					"content": "Привет-привет. А? Ты тоже судебный дуэлянт, Флориан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310229,
					"content": "О, нет. Это всего лишь костюм, выданный клубом. Я играю разные роли в своих сценариях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310230
					],
					"speakerTitle": "Флориан"
				},
				{
					"id": 140310230,
					"content": "Непростая у тебя работа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310231
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 140310231,
					"content": "Пустяки. Это самое малое, что мы можем сделать, чтобы дать игрокам как можно больше впечатлений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310232
					],
					"speakerTitle": "Флориан"
				},
				{
					"id": 140310232,
					"content": "Итак, позвольте мне вкратце познакомить вас со сценарием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310233
					],
					"speakerTitle": "Флориан"
				},
				{
					"id": 140310233,
					"content": "Сценарий игры основан на реальной истории Охотников Сумеречного двора. Вам всем предстоит сыграть роль Охотников из давно минувшей эпохи и урегулировать ряд событий, происходящих в столице.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310234
					],
					"speakerTitle": "Флориан"
				},
				{
					"id": 140310234,
					"content": "Э-э... Паймон не очень хорошо знакома с историей Охотников Сумеречного двора. Это может стать помехой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310235,
					"content": "Вовсе нет. Я могу вкратце рассказать. Итак, Охотники Сумеречного двора посвятили себя охоте на монстров и защите города, используя особую технику владения мечом, которая передавалась из поколения в поколение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310236
					],
					"speakerTitle": "Флориан"
				},
				{
					"id": 140310236,
					"content": "Их история восходит к древней династии ремурийцев и первому охотнику Кассиодору...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310237
					],
					"speakerTitle": "Флориан"
				},
				{
					"id": 140310237,
					"content": "Чуть позже я расскажу подробности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310238
					],
					"speakerTitle": "Флориан"
				},
				{
					"id": 140310238,
					"content": "А я буду давать дополнительные комментарии по мере развития сюжета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310239
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310239,
					"content": "В таком случае... Кхе! Отважные Охотники, готовы ли вы к неведомым доселе приключениям?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310240
					],
					"speakerTitle": "Флориан"
				},
				{
					"id": 140310240,
					"content": "Ого! Всего одна фраза способна перенести в историю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310241,
					"content": "Ха, я вижу перед собой полные решимости лица. Очень хорошо. Отправляйтесь в эту локацию и начните свой героический путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310242
					],
					"speakerTitle": "Флориан"
				},
				{
					"id": 140310242,
					"content": "То есть по мере того, как мы следуем за сюжетом, он приводит нас к определённым местам? Звучит довольно инновационно. А что написано в послании в конверте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310243
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 140310243,
					"content": "Это точное местоположение эпизода, а также официальное разрешение на использование площадки. Похоже, они подготовили всё необходимое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310244
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310244,
					"content": "Проверьте свои вещи и убедитесь, что вы ничего не забыли. Как только будете готовы, следуйте за мной в указанное место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310245
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140310245,
					"content": "Отлично! Охотники Сумеречного двора, вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140310217,
					"content": "...нам нужно будет вызвать тебя на дуэль?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310218
					]
				}
			]
		}
	]
}