					}
				]
			},
			"dialogs": [
				{
					"id": 150290501,
					"content": "Вы всё ему рассказали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290502
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290502,
					"content": "Конечно! Мы не стали говорить про тебя, но, кажется, вождь Бирам нас раскусил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290503,
					"content": "Могли бы сказать, что это «дар духов»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290504
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290504,
					"content": "Да, но вождь заслужил немного честности за свои старания.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290505
					]
				},
				{
					"id": 150290505,
					"content": "...Пожалуй, он отличается от прежних вождей. Но если он догадается, что всё время это была я, у меня будут проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290506
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290506,
					"content": "Вот вы где! Я повсюду вас искал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290507
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150290507,
					"content": "О, это же тот исследователь из Фонтейна... Его не забрали вместе с боссом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290508,
					"content": "Зовите меня Алье... После допроса племя сняло с меня обвинения. Так что я здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290509
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150290509,
					"content": "Скоро я вернусь в Фонтейн. Без нанимателя нет и финансирования. Но я хочу завершить своё расследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290510
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150290510,
					"content": "У меня есть несколько вопросов об Уитцилин. Я хочу, чтобы за пределами Натлана узнали её историю, но я не всё понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290511
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150290511,
					"content": "Вопросы? Почему я должна позволить чужаку рассказывать наши истории?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290512
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290512,
					"content": "Не поймите неправильно. Я не собираюсь искажать вашу историю или извлекать из неё выгоду. Чистое любопытство, клянусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290513
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150290513,
					"content": "Я считаю, что великие истории должны быть известны во всём мире. Благодаря подобному общению и процветает культура.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290514
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150290514,
					"content": "А в этом что-то есть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290515
					]
				},
				{
					"id": 150290515,
					"content": "Хорошо, задавай свои вопросы, но покороче. У меня есть важные дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290516
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290516,
					"content": "Важные дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290517,
					"content": "Большое спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290518
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150290518,
					"content": "Алье задаёт множество вопросов, наконец терпение Ситлали иссякает, и ему приходится уйти.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290519
					]
				},
				{
					"id": 150290519,
					"content": "Сегодня лимит общения снова превысил норму...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290520
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290520,
					"content": "Нам, пожалуй, тоже пора идти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290521
					]
				},
				{
					"id": 150290521,
					"content": "Хм... Постойте. Вы же мне книги должны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290522
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290522,
					"content": "Ах да, точно. Когда дело доходит до лёгких романов, твоя память работает безотказно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290523
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290523,
					"content": "Такие редкие книги непросто найти...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290524
					]
				},
				{
					"id": 150290524,
					"content": "Ты это мне говоришь? Да, будет непросто. Возможно, тебе придётся лично посетить издательский дом Яэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290525
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290525,
					"content": "Но мне они не нужны прямо сейчас. Не забудь, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290526
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290526,
					"content": "Конечно! Мы отправим их тебе, как только сможем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290527
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290527,
					"content": "Отправите мне? Нет уж, я не хочу, чтобы какой-то незнакомец стучал ко мне в дверь, когда у меня похмелье. Вот, возьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290528
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290528,
					"content": "Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290529
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290529,
					"content": "Ключ от моего дома. В следующий раз не стучись. Мешаешь мне спать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ситлали"
				}
			]
		},
