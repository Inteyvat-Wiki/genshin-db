							11.813
						],
						"pointId": 4
					}
				]
			},
			"dialogs": [
				{
					"id": 150290101,
					"content": "#Тебе не придётся делать всё {F#самой}{M#самому}, чтобы соткать свиток. Но твоё участие необходимо, чтобы передать технику Уитцилин дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290102
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290102,
					"content": "О чём ты, Ситлали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290103,
					"content": "Следуйте за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290104
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290104,
					"content": "Ого, только посмотрите... Ты тоже занимаешься созданием свитков?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290105,
					"content": "Свитки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290106
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290106,
					"content": "Свитки? Я думала, ты покажешь мне своё произведение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290107
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290107,
					"content": "Именно это я и собираюсь сделать, подруга. Эта техника напрямую связана с созданием свитков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290108
					],
					"speakerTitle": "Уитцилин"
				},
				{
					"id": 150290108,
					"content": "Эх... Ладно, что там за техника? Она способна перевернуть ход войны или предотвратить катастрофу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290109
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290109,
					"content": "Ты, наверное, хочешь бросить мне вызов? Знаю, у тебя нет сил для настоящего боя, так что дам тебе шанс победить меня словами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290110
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290110,
					"content": "Кхе-кхе... Подруга, моя жизнь подходит к концу. Боюсь, у меня нет времени для поединка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290111
					],
					"speakerTitle": "Уитцилин"
				},
				{
					"id": 150290111,
					"content": "Эй...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290112
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290112,
					"content": "Не переживай. Я верю в заветы нашего племени. Смерть - это не конец, а начало новой жизни в Царстве Ночи, где всё состоит из воспоминаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290113
					],
					"speakerTitle": "Уитцилин"
				},
				{
					"id": 150290113,
					"content": "Ты знаешь, почему наши предки настаивали на использовании разноцветных свитков для записи истории?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290114
					],
					"speakerTitle": "Уитцилин"
				},
				{
					"id": 150290114,
					"content": "Потому что история - это память народа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290115
					],
					"speakerTitle": "Уитцилин"
				},
				{
					"id": 150290115,
					"content": "Мы добавляем оранжевый оттенок свиткам, чтобы умершие могли чувствовать тепло заката.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290116
					],
					"speakerTitle": "Уитцилин"
				},
				{
					"id": 150290116,
					"content": "Мы украшаем их зёрнами злакофруктов, чтобы умершие могли наслаждаться изобилием урожая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290117
					],
					"speakerTitle": "Уитцилин"
				},
				{
					"id": 150290117,
					"content": "Я знаю. Но почему ты решила доверить нечто столь важное мне, а не своим ученикам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290118
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290118,
					"content": "Хе-хе, как твоя подруга признаю... Я поступаю немного эгоистично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290119
					],
					"speakerTitle": "Уитцилин"
				},
				{
					"id": 150290119,
					"content": "Кхе-кхе... Мне осталось недолго, Ситлали. Не уверена, что смогу объяснить своё решение. Но я знаю, ты поймёшь всё со временем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290120
					],
					"speakerTitle": "Уитцилин"
				},
				{
					"id": 150290120,
					"content": "А пока... исполнишь мою последнюю просьбу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290121
					],
					"speakerTitle": "Уитцилин"
				},
				{
					"id": 150290121,
					"content": "...Только в этот раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290122
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290122,
					"content": "Теперь я всё понимаю, Уитцилин. Как ты и говорила... Коготь, помоги вынести свиток наружу. Я собираюсь придать ему цвет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290123
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290123,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290124
					],
					"speakerTitle": "Тлапо"
				},
				{
					"id": 150290124,
					"content": "#{NICKNAME}, Паймон, пойдёмте со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ситлали"
				}
			]
		},
		{
