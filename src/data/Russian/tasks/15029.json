			"dialogs": [
				{
					"id": 150295101,
					"content": "Победа Натлана над Бездной! Идеальный сюжет для такого свитка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295102
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150295102,
					"content": "Интересно, как скоро старейшина Тлапо назначит следующего избранного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295103
					],
					"speakerTitle": "Айвастин"
				},
				{
					"id": 150295103,
					"content": "Кстати, о старейшине Тлапо. Говорят, он вчера пропал! Ты знаешь, что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295104
					],
					"speakerTitle": "Бесучи"
				},
				{
					"id": 150295104,
					"content": "Старейшина Тлапо всегда был загадочным. Со временем мы поймём смысл его исчезновения, но сейчас этого не постичь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чоган"
				}
			]
		}
