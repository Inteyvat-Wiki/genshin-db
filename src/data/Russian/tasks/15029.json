							-2002.646,
							176.821,
							9639.377
						],
						"pointId": 9679
					}
				]
			},
			"dialogs": [
				{
					"id": 150290201,
					"content": "Мы словно птицы, парящие в горизонтах времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290203
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290203,
					"content": "(Видео)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290204
					]
				},
				{
					"id": 150290204,
					"content": "Я знала, что ты поймёшь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290205
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290205,
					"content": "Это... Тот самый особый свиток! Откуда ты узнала, как его соткать, Ситлали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290206,
					"content": "Помнишь про «дар духов»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290207
					]
				},
				{
					"id": 150290207,
					"content": "Постой, ты живёшь больше двухсот лет и умеешь создавать такие свитки... Значит, это ты стоишь за «дарами духов»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290208,
					"content": "Ну, мне не очень хотелось общаться с избранными. Поэтому, передавая свитки, я использовала иллюзии, чтобы их запутать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290209
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290209,
					"content": "Люди стали считать это «вмешательством духов», потому что у них было недостаточно опыта, чтобы распознать мой обман...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290210
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290210,
					"content": "Почему не сказать им правду?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290211
					]
				},
				{
					"id": 150290211,
					"content": "Ты столько лет несла этот груз одна? Даже если ты не любишь общение, почему не научить технике кого-нибудь ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290212,
					"content": "#...{NICKNAME}, ты же видишь этот особый цвет, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290213
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290213,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290214
					]
				},
				{
					"id": 150290214,
					"content": "Суть этого цвета - воспоминания. Создание особого свитка связано с процессом поиска цвета в своих воспоминаниях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290215
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290215,
					"content": "Передача этой техники означает обмен воспоминаниями. Ты оставляешь след своего цвета в воспоминаниях ученика, а он - в твоих воспоминаниях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290216
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290216,
					"content": "Хотя я узнала об этом только сегодня. Но я давно подозревала что-то подобное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290217
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290217,
					"content": "И, ну... после смерти Уитцилин я больше не хотела создавать такие связи с людьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290218
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290218,
					"content": "Вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290219,
					"content": "Это было её последнее желание. Я смирилась с тем, чтобы нести этот груз вечно. Всё равно у меня полно времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290220
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290220,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290221
					],
					"speakerTitle": "Тлапо"
				},
				{
					"id": 150290221,
					"content": "Но Коготь продолжал назначать новых кандидатов для создания свитка, несмотря на то, что знал, как я к этому отношусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290222
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290222,
					"content": "Значит, всё это время он пытался найти тебе новых друзей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290223
					]
				},
				{
					"id": 150290223,
					"content": "...Я прекрасно понимала, что он делает. И да, если бы я поделилась воспоминаниями, этот человек стал бы моим другом. Но до этого так и не дошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290224
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290224,
					"content": "Но в этот раз ты победил, Коготь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290225
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290226
					],
					"speakerTitle": "Тлапо"
				},
				{
					"id": 150290226,
					"content": "#Держи. Думаю, это мой ответ на то, что ты {F#сказала}{M#сказал} мне тем вечером.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290227
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290227,
					"content": "Что это?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290228,
					"content": "Если бы я выбрала свой цвет, это был бы цвет этого платка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290229
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290229,
					"content": "В моей памяти живёт бесчисленное количество людей, и я знаю, что однажды это станет и моей судьбой... остаться чьим-то воспоминанием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290230
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290230,
					"content": "Впереди у тебя долгая жизнь. Ты идеально подходишь, чтобы сохранить это воспоминание... Надеюсь, ты сохранишь и мой цвет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290231
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290231,
					"content": "Значит, теперь мы друзья?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290232
					]
				},
				{
					"id": 150290232,
					"content": "...Береги это. И не смей забывать мой цвет, когда меня не станет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290233
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290233,
					"content": "Ого, не рановато ли говорить о смерти? Мы ведь только что официально подружились...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290234
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290234,
					"content": "Разве не для этого нужны друзья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290235
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290235,
					"content": "#Ладно, серьёзное обещание... Ну, Ситлали, если {NICKNAME} и оставит цвет в твоей памяти, он, наверное, будет золотым, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290236
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290236,
					"content": "На самом деле он уже там. Помнишь, почему я не могла устранить эффект чтения мыслей? Я наконец поняла, в чём дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290237
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290237,
					"content": "Заклинание обмена чувствами позволяет сознаниям разных людей общаться. Естественно, в этом процессе задействованы и воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290238
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290238,
					"content": "Хотя тогда я не знала этого. У нас есть способность видеть «цвет воспоминаний». Значит, когда я поделилась чувствами с тобой, между нашими воспоминаниями установилась связь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290239
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290239,
					"content": "Именно эта связь и вызвала сбой моего заклинания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290240
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290240,
					"content": "#Значит, ты слышишь мысли {F#путешественницы}{M#путешественника}, потому что вы оставили свой цвет в памяти друг друга?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290241,
					"content": "#И именно поэтому {NICKNAME} слышит твои мысли, верно? Потому что связь работает в обе стороны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290242
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290242,
					"content": "Ловко подмечено. Но поддерживать такую связь могут только те, кто на высоком уровне владеет мистическим искусством.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290243
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290243,
					"content": "#Вот почему я слышу мысли {F#путешественницы}{M#путешественника}, а не наоборот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290244
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290244,
					"content": "Не волнуйся. Теперь, когда я поняла, как это работает, я быстро всё исправлю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290245
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290245,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290246
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290246,
					"content": "(Я соврала. Возможность слышать чужие мысли зависит от силы связи между нашими общими воспоминаниями.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290247
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290247,
					"content": "(Так что, после всего, что мы пережили, ты, наверное, снова можешь слышать мои мысли.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290248
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290248,
					"content": "(!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290249
					]
				},
				{
					"id": 150290249,
					"content": "Я так и знала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290250
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290250,
					"content": "(Получается, это никак не остановить?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290251
					]
				},
				{
					"id": 150290251,
					"content": "(Нужно, чтобы один из нас забыл о другом. Только так можно избавиться от этого эффекта.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290252
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290252,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290253
					]
				},
				{
					"id": 150290253,
					"content": "(Шучу. Я легендарная шаманка Повелителей Ночного Ветра. Зная причину, само собой, я найду способ всё исправить.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290254
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290254,
					"content": "(Но, думаю, на это понадобится время. Потерпи немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290255
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290255,
					"content": "(И вообще, я открытая книга. Мне не страшно делиться с тобой мыслями... ну, если я трезвая.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290256,
						150290259
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290256,
					"content": "(О, так ты можешь это отключить? Какая жалость...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290257
					]
				},
				{
					"id": 150290257,
					"content": "(Жалость? Если вдруг соскучишься по этому телепатическому хаосу, я могу снова задействовать заклинание.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290258
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290258,
					"content": "(Хотя не обещаю. Некоторые мысли лучше держать при себе.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150290261,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150290259,
					"content": "(О, ты можешь это отключить? Отлично.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290260
					]
				},
				{
					"id": 150290260,
					"content": "(Да, я понимаю. Некоторые мысли лучше не озвучивать.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Ситлали"
				}
			]
		},
