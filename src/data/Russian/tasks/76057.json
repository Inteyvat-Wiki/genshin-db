				"points": []
			},
			"dialogs": [
				{
					"id": 760570101,
					"content": "Может, в следующий раз устроим командный бой? Или дуэль? О, это вы! Добро пожаловать на тренировочную площадку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570102,
						760570105,
						760570109
					],
					"speakerTitle": "Вайно"
				},
				{
					"id": 760570102,
					"content": "Расскажи о тренировочной площадке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570103
					]
				},
				{
					"id": 760570103,
					"content": "Посетителей стало гораздо больше. Всё благодаря вам. А ещё детям и «Подземному обществу» - они тоже постарались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570104
					],
					"speakerTitle": "Вайно"
				},
				{
					"id": 760570104,
					"content": "Я тут понял: площадка - отличное место для встреч. Когда вдруг видишь старых друзей после долгих лет, и слов-то сразу не найти, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вайно"
				},
				{
					"id": 760570105,
					"content": "Расскажи о «Подземном обществе»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570106
					]
				},
				{
					"id": 760570106,
					"content": "Эх... Пока ничего не нашёл лучше мишеней для кротовьих подстилок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570107
					],
					"speakerTitle": "Вайно"
				},
				{
					"id": 760570107,
					"content": "Мы с детьми перепробовали много всего, но больше всего им понравились именно мишени. Вот и приходится меняться ими...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570108
					],
					"speakerTitle": "Вайно"
				},
				{
					"id": 760570108,
					"content": "Но ничего, со временем мы поднаторели в обмене сокровищ и даже немного на этом заработали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вайно"
				},
				{
					"id": 760570109,
					"content": "Я как-нибудь к тебе загляну.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570110
					]
				},
				{
					"id": 760570110,
					"content": "Конечно, приходите в любое время! Для вас всё бесплатно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вайно"
				}
			]
		},
		{
