				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Фусидзомэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870101,
					"content": "Здравствуйте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870102
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870102,
					"content": "Ах, от вас исходит такой аромат. Вы, должно быть, настоящие ценители прекрасного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870103
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870103,
					"content": "#Мы и правда вкусно пахнем, {NICKNAME}? Дай-ка Паймон понюхать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726870104,
					"content": "Ты пахнешь голубцами с грибами! Девушка не ошиблась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870105,
						726870106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726870105,
					"content": "Не думаю, что она имела в виду именно этот запах, Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870107
					]
				},
				{
					"id": 726870107,
					"content": "А, точно, такое знакомое начало... Паймон поняла! Этой девушке тоже понадобится наша помощь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726870108,
					"content": "Вы и правда смогли бы стать превосходными гидами и завлечь сюда больше покупателей, но я бы хотела, чтобы вы насладились праздником в качестве посетителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870109
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870109,
					"content": "Если у вас есть время, не хотите попробовать «Подворье цветов»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870110
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870110,
					"content": "Что такое «Подворье цветов»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726870111,
					"content": "Да, с удовольствием.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870112
					]
				},
				{
					"id": 726870112,
					"content": "Как видите, я цветочница. Подставки для цветов рядом со мной - это «Подворье цветов», сделанное по принципам икебаны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870113
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870113,
					"content": "Нужно поместить тщательно обрезанные цветы в соответствующие сосуды и добавить различные аксессуары, чтобы создать нечто похожее на цветочный дворик. «Подворье цветов» - вершина цветочного искусства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870114
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870114,
					"content": "С помощью комиссии Ясиро я принимаю участие в празднике Иродори с различными «Подворьями цветов» в надежде, что мы сможем познакомить гостей с красотой цветочного искусства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870115
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870115,
					"content": "Если вы заинтересованы, пожалуйста, попробуйте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870116
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870116,
					"content": "Хм... Эти цветочные произведения искусства действительно очень красивы и выглядят весьма элегантно. Но, кажется, сделать такое непросто. Получится ли у нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870117,
						726870118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726870117,
					"content": "У Паймон плохо с рукоделием.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870119
					]
				},
				{
					"id": 726870119,
					"content": "Не волнуйтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870120
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870120,
					"content": "Чтобы помочь нашим гостям по-настоящему оценить очарование этого искусства, я подготовила множество вещей, которые могут упростить процесс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870121
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870121,
					"content": "Вам всего лишь необходимо выбрать основной цветок, цветочную сцену и основу, а затем соединить их, чтобы создать «Подворье цветов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870122
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870122,
					"content": "Конечно, важно почувствовать «выразительность» цветочной композиции, поэтому я дам вам четыре загадки цветов, чтобы немного проверить ваше мышление.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870123
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870123,
					"content": "Если будете решать загадки каждый день, то сможете забрать «Подворье цветов» и цветы с собой, а также получите дополнительные награды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870124
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870124,
					"content": "Правда? Потрясающе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726870125,
					"content": "#Хе-хе, ну же, {NICKNAME}, эта девушка так старалась, давай поможем ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870126,
						726870127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726870126,
					"content": "Ради искусства...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870128
					]
				},
				{
					"id": 726870128,
					"content": "Ладно, тогда начинаем! Давай сделаем... э-э, как там его?.. Точно! «Подворье цветов»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726870129,
					"content": "Ха-ха-ха. Благодарю вас за рвение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870130
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870130,
					"content": "Тогда приступим? Сегодняшняя загадка цветов - «Пышная пурпурная вишня, душистый прозрачный песок».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870131
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870131,
					"content": "Обдумайте значение этого и сосредоточьтесь на цветах, чтобы создать своё «Подворье цветов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870127,
					"content": "Ради награды...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870128
					]
				},
				{
					"id": 726870118,
					"content": "У Паймон плохо с терпением.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870119
					]
				},
				{
					"id": 726870106,
					"content": "Паймон, ты не понимаешь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870107
					]
				}
			]
		},
		{
			"id": 7268705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268702",
							"2"
						],
						"stepId": 7268702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Фусидзомэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "Я останусь здесь и буду направлять тех, кто придёт на праздник Иродори, чтобы они могли насладиться красотой «Подворья цветов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870202,
					"content": "Не забывайте возвращаться ежедневно, чтобы получать новые загадки. Всего их будет четыре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870203,
					"content": "Конечно же, если у вас есть другие вопросы, я с удовольствием на них отвечу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870204,
					"content": "Об этих цветах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "Цветы, которые я использую, предоставлены цветочницей Сакуей. Её цветы отличаются безупречным качеством и доступными ценами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870206,
					"content": "Возможно, вы уже встречались с Сакуей. Мы изучали искусство икебаны у одного мастера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870207,
					"content": "Сакуя очень хорошо разбирается в цветочном искусстве, но когда она услышала, что на празднике Иродори будет много людей, она, похоже, немного испугалась. Она сказала, что в такой обстановке ей будет трудно успокоиться и сосредоточиться на своей работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870208,
					"content": "Поэтому я рекламирую её работу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870209,
					"content": "Мы тоже можем помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726870219,
					"content": "У вас есть другие вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870220,
					"content": "Спасибо, госпожа Фусидзомэ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "Не за что. Можете обратиться ко мне в любое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870210,
					"content": "О комиссии Ясиро...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "Комиссия Ясиро всегда поддерживала цветочное искусство Инадзумы. Сама Сирасаги Химэгими спонсировала это событие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870212,
					"content": "С самого юного возраста она была весьма талантлива. Однажды я видела её икебану, и мне даже посчастливилось поделиться с ней своими впечатлениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870213,
					"content": "Пусть я и старше её, она превосходит меня в вопросах икебаны и понимания цветочного искусства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870214,
					"content": "Если обстоятельства позволяли, она ежегодно выделяла деньги на популяризацию икебаны. Говорят, что она даже использовала для этого свои сбережения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870215,
					"content": "Однажды она выразила своё искреннее желание, чтобы как можно больше людей понимали икебану и проявляли к ней больший интерес, чтобы больше людей захотело практиковать это искусство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870216,
					"content": "Цветочное искусство Инадзумы многим обязано Аяке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726870217,
					"content": "Надеюсь, её мечта сбудется.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "Благодарю вас обоих. Вы очень добры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870222,
					"content": "У меня больше нет вопросов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "Хорошо. Можете обратиться ко мне в любое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фусидзомэ"
				}
			]
		}
	]
}