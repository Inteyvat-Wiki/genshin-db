						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7214001"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тёдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721971801,
					"content": "#{NICKNAME}, вы вернулись. Вы принесли кристаллы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721971802,
						721971803
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721971802,
					"content": "Да, вот.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721971803,
					"content": "Ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721971804
					]
				},
				{
					"id": 721971804,
					"content": "Не торопись. Передохни, если надо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тёдзи"
				}
			]
		},
		{
			"id": 7219719,
			"completionStepIds": [
				7219721
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7219721",
							"2"
						],
						"stepId": 7219721,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тёдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721401901,
					"content": "Этого кристального костного мозга хватит. Итак, я готов отправиться в собственное странствие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401902
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401903,
					"content": "Береги себя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401904,
					"content": "Не пропадай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401902,
					"content": "Паймон всё равно как-то за него неспокойно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401903,
						721401904
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401905,
					"content": "Ага!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401906
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401906,
					"content": "А ещё... Тёдзи, давай больше без вранья. Тебе повезло, что ты встретил нас, иначе... тебя и побить могли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401907
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401907,
					"content": "А ещё... Если кто будет допытываться, ничего им не говори! Придумай что-нибудь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401908
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401909,
					"content": "Чего заладила, Паймон? Как старая бабка, ей-богу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401910
					]
				},
				{
					"id": 721401908,
					"content": "А ещё... ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401909
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401911,
					"content": "У него всё получится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401912
					]
				},
				{
					"id": 721401910,
					"content": "А как тут не беспокоиться? Такой маленький, и в странствия! Одинёшенек!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401911
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401912,
					"content": "...Ага, ну конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401913
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401913,
					"content": "Ха-ха-ха-ха! Спасибо, спасибо вам обоим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401914
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401914,
					"content": "Надеюсь, мы еще встретимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401915
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401915,
					"content": "Обещай Паймон, что будешь осторожен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401916
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401916,
					"content": "Все будет хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401917
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401917,
					"content": "Далее я отправлюсь в Татарасуну, где раньше работала мама. Может, кто-нибудь подскажет, не была ли она там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401918
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401918,
					"content": "Потом... Как-нибудь доберусь до Наруками. После этого на корабль и в Снежную... а там посмотрим по ситуации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401919
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401920,
					"content": "Ты хоть понимаешь, о чём говоришь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401921,
					"content": "Ты понимаешь, какие опасности могут тебя ожидать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401919,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401920,
						721401921
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401922,
					"content": "Если бы все сидели по домам только из-за того, что не знали всех опасностей... не было бы искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401923
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401924,
					"content": "Понятно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401925,
					"content": "Просто будь осторожен.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401923,
					"content": "Какой же он упрямый...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401924,
						721401925
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401926,
					"content": "Ха-ха-ха, не волнуйтесь за меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401927
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401927,
					"content": "#Удачной вам поездки! Кстати, {NICKNAME}, я надеюсь, что вы тоже скоро найдете свою семью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401928
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401928,
					"content": "Ага! Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
