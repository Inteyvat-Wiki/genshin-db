				{
					"id": 721402001,
					"content": "Привет! Вот мы и встретились снова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402002
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721402003,
					"content": "«Пожалуйста, принесите мне еще кристального костного мозга...»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402004
					]
				},
				{
					"id": 721402002,
					"content": "Постой. Паймон сейчас угадает, что ты собираешься сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721402005,
					"content": "Вот что ты хочешь сказать, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402006
					]
				},
				{
					"id": 721402004,
					"content": "«...И поскорее, у-у-у...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721402007,
					"content": "Как твоё странствие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402008
					]
				},
				{
					"id": 721402006,
					"content": "Ха-ха-ха, конечно же нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402007
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721402008,
					"content": "Хорошо. Но я до сих пор не нашёл ни следа мамы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402009
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721402010,
					"content": "Мы сделаем всё, что в наших силах.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402011
					]
				},
				{
					"id": 721402009,
					"content": "#Ничего. Мы тебе тоже поможем, да, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402010
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721402011,
					"content": "#Ага! Я знал, что могу положиться на вас, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тёдзи"
				}
			]
		},
