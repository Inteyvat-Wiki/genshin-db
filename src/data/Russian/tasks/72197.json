						721402105
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721402106,
					"content": "Но, пожалуйста, не вини ее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402107
					]
				},
				{
					"id": 721402107,
					"content": "...Я понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402108
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721402108,
					"content": "Но я продолжу искать её. Всё это обретёт смысл, только когда я найду её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402109
					],
					"speakerTitle": "Тёдзи"
				},
				{
