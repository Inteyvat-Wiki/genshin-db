			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тёдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721401701,
					"content": "#Здравствуйте, {NICKNAME}! Как поживаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401702
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401703,
					"content": "Эй, это обычно говорю я!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401704
					]
				},
				{
					"id": 721401702,
					"content": "У нас всё отлично. А у тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401705,
					"content": "Паймон, думаешь, нужна еще еда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401706
					]
				},
				{
					"id": 721401704,
					"content": "Ха-ха, в следующий раз соображай быстрее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401707,
					"content": "Постой, Паймон. Ты не в счёт - ты и есть закуска.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401708
					]
				},
				{
					"id": 721401706,
					"content": "Паймон! Паймон хочет закусок! Всегда хочет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401708,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401709,
					"content": "П-ф-ф... ха-ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401710
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401710,
					"content": "Ох, умора... Только не ссорьтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401711
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401712,
					"content": "Рассказывай, в чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401713,
					"content": "Я сделаю всё, что в моих силах.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401711,
					"content": "У меня всё нормально, но я хотел бы попросить вас ещё об одном одолжении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401712,
						721401713
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401714,
					"content": "#Да ничего особенного. Мне просто нужно, чтобы вы, {NICKNAME}, помогли мне добыть ещё кристаллов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401715
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401716,
					"content": "Я тебе, конечно, верю, но ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401717
					]
				},
				{
					"id": 721401715,
					"content": "И я награжу тебя за помощь... Просто поверь мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401716
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401718,
					"content": "Почему?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401719,
					"content": "Ты обещал объясниться с нами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401717,
					"content": "Но?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401718,
						721401719
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401720,
					"content": "Точно. Мы до сих пор не знаем, зачем тебе столько кристального костного мозга Дзякоцу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401721
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401722,
					"content": "Но весь рынок кристаллов принадлежит сёгунату.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401723,
					"content": "Ты ведь знаешь, что эти кристаллы трудно продать, или нет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401721,
					"content": "Что ж... Мне нужны деньги на дорогу, чтобы найти маму. Поэтому я обмениваю кристаллы на деньги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401722,
						721401723
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401725,
					"content": "Опасное дело ты затеял.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401726,
					"content": "Как бы с тобой ничего не случилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401724,
					"content": "Знаю. Но я найду способ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401725,
						721401726
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401727,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401728
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401728,
					"content": "Тёдзи, мы с тобой друзья, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401729
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401729,
					"content": "Может быть, мы сможем снова тебе помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401730
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401731,
					"content": "Солдатам удачи есть чему поучиться у Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401732
					]
				},
				{
					"id": 721401730,
					"content": "Кроме того, ты пообещал награду. Значит, у нас есть право знать, что угрожает тебе, и, соответственно, нашей награде, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401731
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401732,
					"content": "Пфф... Однако Паймон права.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401733
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401733,
					"content": "Я собираю кристаллы не только ради денег.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401734
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401734,
					"content": "Я подумал... Что, если мама и папа заболеют, как и все остальные, той заразой, что принёс Татаригами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401735
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401735,
					"content": "Может быть, из этих кристаллов можно сделать лекарство. Они всё же выросли из костей гигантского змея...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401736
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401736,
					"content": "И господин Ясумото тоже говорил, что эти кристаллы могут быть полезны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401737
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401737,
					"content": "Но... нельзя быть уверенным на все сто, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401738
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721401738,
					"content": "Да, но ничего больше пока у нас нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401739
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401739,
					"content": "Когда я найду маму... или, может быть, даже папу, я отведу их в Сумеру. Говорят, что там есть лекарство от этой странной болезни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401740
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401740,
					"content": "А до тех пор нельзя терять надежду найти лекарство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401741
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401742,
					"content": "Не вопрос.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401743,
					"content": "Надеюсь, найдёшь кристаллам хорошее применение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401741,
					"content": "Ну, я всё сказал. Ты мне поможешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401742,
						721401743
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721401744,
					"content": "Спасибо! Я этого не забуду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тёдзи"
				}
			]
		},
		{
			"id": 7219718,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7219712",
