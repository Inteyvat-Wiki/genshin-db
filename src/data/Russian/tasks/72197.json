			"dialogs": [
				{
					"id": 721402301,
					"content": "#Здравствуйте, {NICKNAME}, я не ожидал, что увижу вас снова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402302
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721402302,
					"content": "Давно не виделись! Как мир за пределами Ясиори?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721402303,
					"content": "Намного богаче, чем мой родной город. У них много вкусной еды и развлечений. Но... не так уж мне это и нравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402304
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721402304,
					"content": "Да? И почему же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721402305,
					"content": "Кажется, что всем там чего-то не хватает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402306
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721402306,
					"content": "Когда мы жили на острове Ясиори, её превосходительство была где-то далеко, но мы знали, что она есть, она наблюдает за нами, защищает нас, решает наши судьбы, и от этого было спокойно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402307
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721402307,
					"content": "Здесь же она всё контролирует и подавляет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402308
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721402308,
					"content": "Эх... Не знаю, как объяснить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402309
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721402310,
					"content": "Мы все еще пытаемся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402311
					]
				},
				{
					"id": 721402309,
					"content": "Кстати, вам что-нибудь удалось разузнать про мою маму?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402310
					],
					"speakerTitle": "Тёдзи"
				},
				{
					"id": 721402311,
					"content": "Ладно. Если будут новости, скажите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тёдзи"
				}
			]
