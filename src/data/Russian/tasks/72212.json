			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тайсукэ",
					"Эйко"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120201,
					"content": "О, привет, как дела сегодня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120202
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722120202,
					"content": "Занимаюсь статуей для Нэко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120203
					]
				},
				{
					"id": 722120203,
					"content": "Э... что? Статуя, здесь? Ты серьёзно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120204
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722120204,
					"content": "Я... я сейчас же начинаю учиться резать по камню!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120205
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722120205,
					"content": "Боюсь, что ты вряд ли успеешь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120206
					]
				},
				{
					"id": 722120206,
					"content": "Ещё одна задачка от Нэко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120207
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722120207,
					"content": "С учётом произошедшего в Татарасуне не думаю, что вам будет так уж трудно найти ремесленника, готового взяться за работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120208
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722120208,
					"content": "Гильдия получила довольно много заказов из-за этого кризиса. Я слышала, что в Татарасуне многие всё ещё ищут работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120209
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722120209,
					"content": "Я видела лагерь рабочих, когда выполняла поручение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120210
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722120210,
					"content": "Если хотите, можете попытать там удачи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120211,
						722120212
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722120211,
					"content": "Спасибо тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120214
					]
				},
				{
					"id": 722120214,
					"content": "Да ладно, это было несложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120215
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722120215,
					"content": "Знаешь, мне тоже интересно, что будет, когда это святилище вернётся к жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120216
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722120216,
					"content": "Особенно меня занимает эта «Хибики», о которой всё время говорит Нэко. Кто она? И почему кошка так к ней привязана?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120217
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722120217,
					"content": "Ладно, не бери в голову, я просто говорю сама с собой. Ступай, разыщи мастера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120218
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722120218,
					"content": "А вот умеют ли эти ребята резать по камню или нет - ну тут уж как вам повезёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120219
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722120219,
					"content": "Ну же, Эйко, ты просто тоже хочешь помочь госпоже Нэко, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120220
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722120220,
					"content": "Хм, Тайсукэ, а ты дописал наш план исследований?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120221
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722120221,
					"content": "Э-э, почти. Извините, мне пора...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722120212,
					"content": "Эйко, ты на себя не похожа...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120213
					]
				},
				{
					"id": 722120213,
					"content": "#Что не привык{F#ла}, что я выдаю информацию по собственной инициативе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120214
					],
					"speakerTitle": "Эйко"
				}
			]
		},
		{
			"id": 7221203,
			"completionStepIds": [
				7221204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
