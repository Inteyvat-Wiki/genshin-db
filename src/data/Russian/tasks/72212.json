				"points": []
			},
			"dialogs": [
				{
					"id": 722120601,
					"content": "Но мне всё-таки любопытно: как такая твёрдая штука, как камень, может стать похожей на меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120602
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120602,
					"content": "Этот каменный человек такой могущественный? Он может использовать магию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120603,
						722120605
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120603,
					"content": "Очень могущественный.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120604
					]
				},
				{
					"id": 722120604,
					"content": "Поняла, буду ждать с нетерпением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120605,
					"content": "Это как с готовкой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120606
					]
				},
				{
					"id": 722120606,
					"content": "Понимаю. Еда, которую вы с Хибики приготовили, была хорошей. И камень, который сделает каменный человек, тоже будет хорошим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120607
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120607,
					"content": "Люди и правда кое в чём разбираются. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				}
			]
		}
