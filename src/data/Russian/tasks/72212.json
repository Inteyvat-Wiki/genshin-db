			"trigger": {
				"objectNames": [
					"Нэко",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120101,
					"content": "Вы как раз вовремя. Мне нужна ваша помощь с одним делом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120102
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120102,
					"content": "Что за дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120103
					]
				},
				{
					"id": 722120103,
					"content": "Мне бы хотелось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120104
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120104,
					"content": "...чтобы вы поставили рядом со святилищем высокий большой камень в форме меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120105
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120105,
					"content": "И где же мы такой найдём, интересно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722120106,
					"content": "Это называется «статуя».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120107
					]
				},
				{
					"id": 722120107,
					"content": "Я хочу что-то вроде тех лисьих камней на далёком-далёком острове.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120108
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120108,
					"content": "Хибики говорила, на том острове много таких камней. И спрашивала, не хочу ли я себе такой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120109
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120109,
					"content": "Раз Хибики этого хотела, это наверняка хорошая мысль. Так что я прошу вас сделать такой камень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120110,
						722120113
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120110,
					"content": "У меня нет таланта к резьбе по камню...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120111
					]
				},
				{
					"id": 722120111,
					"content": "Хм-м, что же нам делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722120112,
					"content": "Так, а почему бы нам не спросить Тайсуке? Он очень любит кошек. Может, он и резьбе по камню выучится, чтобы помочь Нэко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722120113,
					"content": "Мы попросим помощи у Тайсукэ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120114
					]
				},
				{
					"id": 722120114,
					"content": "Отличная мысль! Он так любит кошек. Может, он нам поможет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7221202,
			"completionStepIds": [
				7221202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
