						"stepId": 7221205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нэко",
					"Осима Дзюмпэй",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120401,
					"content": "А, вы вернулись. Это, значит, каменный человек, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120402,
						722120403
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120402,
					"content": "Это мастер, которого мы пригласили для работы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				},
				{
					"id": 722120404,
					"content": "Что? Кошка... разговаривает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120405
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722120405,
					"content": "Мяу-мяу-мяу, столько шума из ничего... Что такого удивительного в том, что я разговариваю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120406,
						722120407
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120406,
					"content": "Не стоит так переживать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120408,
					"content": "Подожди. Ты хочешь сказать, что для тебя это абсолютно обыкновенная вещь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120409
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722120409,
					"content": "Совершенно заурядная.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120410
					]
				},
				{
					"id": 722120410,
					"content": "Должно быть, тебе немало пришлось повидать на своём веку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120411
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722120411,
					"content": "Хорошо-хорошо, хватит болтать попусту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120412
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120412,
					"content": "Вернёмся к делу. Каменный человек, ты можешь постучать по камню, чтобы он стал таким, как я?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120413
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120413,
					"content": "А? Каменный человек? Это я?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120414
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722120414,
					"content": "«Постучать по камню», значит... Ну да, скульптура. Я могу попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120415
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722120415,
					"content": "Да? Замечательно. Мяу-мяу-мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120416
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120416,
					"content": "Вот оно как всё обернулось. Ну, иметь работу всегда лучше, чем не иметь. Я просто никогда раньше не работал на кошку, так что... Думаю, оплату мы обсудим позже, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120417
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722120417,
					"content": "В любом случае для начала мне нужно сделать кое-какие приготовления. На этом острове довольно много камней. Мне нужно выбрать подходящий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120418
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722120418,
					"content": "Ах да, как мне к тебе обращаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120419
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722120419,
					"content": "Меня зовут Нэко. Я временная настоятельница святилища Асасэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120420
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120420,
					"content": "А обращаться можешь, как тебе больше нравится, высокий человек, который умеет стучать по камню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120421
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120421,
					"content": "Да? Ну тогда я буду обращаться к тебе «госпожа временная настоятельница». Всё-таки ты мой работодатель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120422
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722120422,
					"content": "Что такое «робокопатель»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120423
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722120423,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120424
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722120424,
					"content": "Пожалуй, я лучше осмотрюсь и выберу подходящий камень. А вы подождите здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120425
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722120425,
					"content": "Работа на кошку! Ну такое у меня точно впервые...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120426
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722120426,
					"content": "Господин Осима, похоже, забыл об оплате.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722120407,
					"content": "Это просто говорящая кошка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120403,
					"content": "Да, это каменный человек.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				}
			]
		},
