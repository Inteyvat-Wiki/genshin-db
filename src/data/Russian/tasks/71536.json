			"dialogs": [
				{
					"id": 715360301,
					"content": "#Так вот как это делается... Он прекрасен! Спасибо, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360302
					],
					"speakerTitle": "Кандакия"
				},
				{
					"id": 715360302,
					"content": "Осталось сделать ещё несколько и подарить их вместе с сувенирами, которые я купила. Уверена, жители деревни будут в восторге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360303
					],
					"speakerTitle": "Кандакия"
				},
				{
					"id": 715360303,
					"content": "А этот конверт я оставлю себе.",
					"roleType": "TALK_ROLE_NPC",
