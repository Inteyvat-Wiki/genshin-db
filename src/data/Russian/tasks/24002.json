			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Айседора"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240020101,
					"content": "Хм, куда же они подевались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020102
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020102,
					"content": "Ох, заново всё написать мне не удастся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020103
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020103,
					"content": "Ты что-то потеряла?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020104
					]
				},
				{
					"id": 240020104,
					"content": "Надеюсь, что всего лишь не могу найти. Стараюсь быть оптимисткой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020105,
						240020106
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020105,
					"content": "Ты это называешь оптимизмом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				},
				{
					"id": 240020107,
					"content": "Ну... И так бывает. Особенно если не можешь найти бухгалтерские записи по служебным расходам за полгода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020108
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020108,
					"content": "Книгу учёта вскоре нужно передать госпоже Кайзер... А тут, как назло, из неё пропало 5 страниц.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020109
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020109,
					"content": "Страницы относятся к пяти разным месяцам и содержат множество записей о расходах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020110
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020110,
					"content": "Я заметила пропажу только при последней сверке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020111
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020111,
					"content": "Лишь бы только не оказалось, что я всё перепутала и вообще их не сделала... Как же теперь окончательно подсчитать наши служебные расходы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020112
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020112,
					"content": "Даже и подумать страшно. Если я вовсе забыла их написать, то госпожа Кадми наверняка заставит меня поднять записи за последние 10 лет и всё перепроверить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020113
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020113,
					"content": "Всё настолько серьёзно?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020114
					]
				},
				{
					"id": 240020114,
					"content": "Да. Если документы не оформили или потеряли, у множества сотрудников будут проблемы с оплатой уже в следующем месяце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020115
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020115,
					"content": "Вот незадача... Я всю ночь корпела над бухгалтерской книгой, чтобы отдать её во Дворец сегодня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020116
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020116,
					"content": "А здесь меня напугала большая стая чаек, и от страха мои руки ослабели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020117
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020117,
					"content": "Возможно, в тот момент я и потеряла документы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020118,
						240020119
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020118,
					"content": "Я помогу с поиском.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020120,
					"content": "Правда? Как здорово! Тогда сперва пойдём вот этой дорогой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020121
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020121,
					"content": "Информация в документах не является секретной, так что можешь спокойно собирать записи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020122
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020122,
					"content": "Ах, да! Я ещё встретила офицера Мюрн! Она даже помогла прогнать чаек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020123
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020123,
					"content": "Может быть, она видела пропавшую бухгалтерскую книгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020119,
					"content": "Давайте искать вместе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020106,
					"content": "Разве хорошо, когда не можешь что-то найти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				}
			]
		},
