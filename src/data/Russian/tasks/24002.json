					}
				]
			},
			"dialogs": [
				{
					"id": 240020401,
					"content": "Ах, вот они, мои документы! Хвала Архонту, они все здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020402
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020402,
					"content": "Почему ты занималась бухгалтерией в кафе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020403
					]
				},
				{
					"id": 240020403,
					"content": "Н-ну... Мне нужно много кофе, чтобы сосредоточиться и всё подсчитать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020404
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020404,
					"content": "Тут ведь расходы всего Дворца Мермония. Такую работу должны делать пять человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020405
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020405,
					"content": "Но всех, кроме меня, привлекают к другим задачам, визитам и поездкам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020406
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020406,
					"content": "И когда пришло время для подсчёта всех расходов, я осталась совсем одна. Ох, эти бессонные ночи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020407
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020407,
					"content": "Мне поручен не только подсчёт, но и сверка бухгалтерских записей. У меня уже в глазах рябит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020408
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020408,
					"content": "Хорошо, что мы нашли документы. Госпожа Айседора, позвольте проводить вас во Дворец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020409
					],
					"speakerTitle": "Мюрн"
				},
				{
					"id": 240020409,
					"content": "#Спасибо, офицер Мюрн. Клянусь, вы и {F#путешественница}{M#путешественник} - единственные добрые люди, которых я встретила за последние месяцы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020410
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020410,
					"content": "Остальные только и делают, что кричат на меня или нагружают новой работой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020411
					],
					"speakerTitle": "Айседора"
				},
				{
					"id": 240020411,
					"content": "Ох, нет же, я не должна жаловаться. Мне нужно идти, иначе госпожа Кайзер устроит мне взбучку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айседора"
				}
			]
		}
	]
}