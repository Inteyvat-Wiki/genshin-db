			},
			"dialogs": [
				{
					"id": 750791601,
					"content": "Не трогай! Это приз. Если хочешь приз, заверши тренировочную трассу, которую подготовил Темач.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ламизана"
				}
			]
		},
		{
