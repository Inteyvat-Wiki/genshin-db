					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7507907"
						],
						"stepId": 7507907
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ламизана",
					"Тарука"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791701,
					"content": "Хех, тебе бы поработать над характером. Я для твоего же блага говорю, понял? Ты уже взрослый, пора стать разумнее, хотя бы ради сестры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791702
					],
					"speakerTitle": "Ламизана"
				},
				{
					"id": 750791702,
					"content": "Ру-у-у-у, Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791703
					],
					"speakerTitle": "Оберон"
				},
				{
					"id": 750791703,
					"content": "Видишь? И он согласен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791704
					],
					"speakerTitle": "Ламизана"
				},
				{
					"id": 750791704,
					"content": "Если уж кто-то из нас неразумен, то это точно не я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791705
					],
					"speakerTitle": "Тарука"
				},
				{
					"id": 750791705,
					"content": "Ах! Ты, маленький...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ламизана"
				}
			]
		},
		{
			"id": 7507918,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
