			"dialogs": [
				{
					"id": 130280113,
					"content": "Они столько времени здесь провели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280101
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280101,
					"content": "Мне так хочется помочь им встретиться снова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280102
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280102,
					"content": "Эти плесенники остались совсем одни... И за лагерь парящих Анемо плесенников Паймон тоже тревожно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130280103,
					"content": "Да, и мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280104
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280104,
					"content": "Есть идея! Может, отведём их туда? Пусть живут вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280105
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280105,
					"content": "Они все жили бок о бок с элементальными существами. Думаю, в результате у них выработались похожие повадки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280106
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280106,
					"content": "Точно! Они смогут друг о друге позаботиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130280107,
					"content": "Ну что, пойдёте с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280108
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280108,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280109
					],
					"speakerTitle": "Парящий Гидро плесенник"
				},
				{
					"id": 130280109,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280110
					],
					"speakerTitle": "Парящий Гидро плесенник"
				},
				{
					"id": 130280110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280111
					],
					"speakerTitle": "Парящий Гидро плесенник"
				},
				{
					"id": 130280111,
					"content": "Похоже, ты их уговорила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130280112,
					"content": "Что ж, идём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нахида"
				}
			]
