			"dialogs": [
				{
					"id": 130280201,
					"content": "Два одиноких плесенника получили в лагере тёплый приём.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130280202
					]
				},
				{
					"id": 130280202,
					"content": "Кажется, эти плесенники нас помнят. Они такие милые и дружелюбные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130280203,
					"content": "Видимо, элементальный сородич был очень значимым членом их стаи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280204
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280204,
					"content": "Эй, что вы делаете? Хотите поиграть с Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130280205,
					"content": "♩~♩~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280206
					],
					"speakerTitle": "Парящий Анемо плесенник"
				},
				{
					"id": 130280206,
					"content": "#Ну ладно, ладно! {NICKNAME}, можно Паймон с ними поиграет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280207,
						130280208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130280207,
					"content": "Конечно, иди.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				},
				{
					"id": 130280209,
					"content": "Я должна перед тобой извиниться. Когда мы были внутри Апеп и Семя огня разрушилось... Я решила принести в жертву свою силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280210
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280210,
					"content": "Паймон тебе говорила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280211,
						130280212
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280211,
					"content": "Да, мне пришлось за тебя побеспокоиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280213,
					"content": "Я поторопилась, надо было как следует подумать и принять более взвешенное решение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280214
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280214,
					"content": "Но все мои мысли были об одном: Дендро дракон на краю гибели, жители Сумеру в опасности. Я не находила себе места от тревоги и страха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280215
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280215,
					"content": "Если бы я упустила время, когда ещё можно было что-то сделать, если бы опустила руки и не попыталась его спасти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280216
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280216,
					"content": "Потратить свою силу - самый простой выход. Но в то же время - самый трудный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280217
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280217,
					"content": "Тебе ещё есть куда «расти».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280218
					]
				},
				{
					"id": 130280218,
					"content": "Да. Они многому меня научили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280219
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280219,
					"content": "Я понимаю, что их желание исполнилось, но всё ещё не могу этого принять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280220
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280220,
					"content": "Его голос звучал так легко и радостно... Но мне хотелось плакать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280221
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280221,
					"content": "Видимо, я ещё не до конца понимаю, что такое «сочувствие».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280222,
						130280223
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280222,
					"content": "Дело не в тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280224,
					"content": "Спасибо тебе за утешение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280225
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280225,
					"content": "Чувства - сложная штука. Мне ещё многому надо научиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280226
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280226,
					"content": "Мм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280227
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280227,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280228
					],
					"speakerTitle": "Парящий Гидро плесенник"
				},
				{
					"id": 130280228,
					"content": "♪~♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280229
					],
					"speakerTitle": "Парящий Гидро плесенник"
				},
				{
					"id": 130280229,
					"content": "Оказывается, они знают, как обрабатывать землю... Может, просто повторяют движения за людьми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280230
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280230,
					"content": "Но тот плесенник даже научился говорить. Скорее всего, всё это результат длительного воздействия силы элементов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280231
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280231,
					"content": "Время наделено огромной силой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280232
					]
				},
				{
					"id": 130280232,
					"content": "Точно. Теперь два одиноких плесенника в безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280233
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280233,
					"content": "Я позабочусь об этом лагере, буду их навещать, проверять, как идут дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280234
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280234,
					"content": "Я хочу сохранить следы, оставленные элементальными существами, чтобы в будущем они могли встретиться со своими сородичами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280235
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280235,
					"content": "Ведь в конце прозвучало имя «Нур». Значит, воспоминания вернулись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280236,
						130280237
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280236,
					"content": "Я верю в связь между родными.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280238,
					"content": "Да. Не будем терять надежду раньше времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280239
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280239,
					"content": "Нахида, плесенники принесли нам фруктов! Угощайся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280240
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130280240,
					"content": "Хорошо, иду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нахида"
				},
				{
					"id": 130280237,
					"content": "Я верю в чудеса.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280223,
					"content": "Я чувствую то же самое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280212,
					"content": "#Да, я тогда немного {F#рассердилась}{M#рассердился}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280208,
					"content": "Повеселись как следует!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				}
			]
		}
	]
}