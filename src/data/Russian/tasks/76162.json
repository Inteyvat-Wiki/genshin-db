						"pointId": 14831
					}
				]
			},
			"dialogs": [
				{
					"id": 761001601,
					"content": "...Что с Бьорном?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001602
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761001602,
					"content": "...Он тяжело ранен. Всё произошло так внезапно... Он пытался защитить нас... *плачет*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001603
					],
					"speakerTitle": "Эгле"
				},
				{
					"id": 761001603,
					"content": "...Обстановка на поле боя слишком опасная, да и он не выдержит тряски при транспортировке. Нам приходится оказывать экстренную помощь на месте, но с нашими текущими возможностями мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001604
					],
					"speakerTitle": "Эгле"
				},
				{
					"id": 761001604,
					"content": "...Командир...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001605
					],
					"speakerTitle": "Бьорн"
				},
				{
					"id": 761001605,
					"content": "Бьорн!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001606
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761001606,
					"content": "...прости... я не смог выполнить задание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001607
					],
					"speakerTitle": "Бьорн"
				},
				{
					"id": 761001607,
					"content": "Ты отлично справился! Позиция удержана, и все целы и невредимы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001608
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761001608,
					"content": "Правда?.. Значит, у меня получилось... Как хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001609
					],
					"speakerTitle": "Бьорн"
				},
				{
					"id": 761001609,
					"content": "Не разговаривай. Побереги силы для выздоровления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001610
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761001610,
					"content": "Если не сейчас... потом уже не будет шанса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001611
					],
					"speakerTitle": "Бьорн"
				},
				{
					"id": 761001611,
					"content": "Это приказ командира! Я запрещаю тебе говорить такие вещи! С тобой всё будет хорошо... обязательно будет хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001612
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761001612,
					"content": "Хех... хорошо... слушаюсь... я больше не буду об этом говорить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001613
					],
					"speakerTitle": "Бьорн"
				},
				{
					"id": 761001613,
					"content": "Но... я смогу смотреть в глаза Вейде с чистой совестью...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001614
					],
					"speakerTitle": "Бьорн"
				},
				{
					"id": 761001614,
					"content": "Он часто говорил... мы, Светоносцы, как шпороцветник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001615
					],
					"speakerTitle": "Бьорн"
				},
				{
					"id": 761001615,
					"content": "Перед лицом Дикой Охоты... мы все очень хрупкие... как цветы шпороцветника... легко опадаем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001616
					],
					"speakerTitle": "Бьорн"
				},
				{
					"id": 761001616,
					"content": "Но... пока листья ещё есть... пока корни крепко держатся в земле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001617
					],
					"speakerTitle": "Бьорн"
				},
				{
					"id": 761001617,
					"content": "В следующем сезоне... и после... обязательно распустятся новые цветы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001618
					],
					"speakerTitle": "Бьорн"
				},
				{
					"id": 761001618,
					"content": "Мы не потерпим поражения... верно... командир?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001619
					],
					"speakerTitle": "Бьорн"
				},
				{
					"id": 761001619,
					"content": "Конечно! Мы не потерпим поражения! Я собственными руками уничтожу это чудовище!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001620
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761001620,
					"content": "Ты самый сильный среди нас... я верю в тебя... командир...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001621
					],
					"speakerTitle": "Бьорн"
				},
				{
					"id": 761001621,
					"content": "Не беспокойся, Бьорн, я обязательно сдержу обещание! А теперь отдыхай. Всё будет хорошо, ты скоро поправишься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001622
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761001622,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001623
					],
					"speakerTitle": "Бьорн"
				},
				{
					"id": 761001623,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001624
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761001624,
					"content": "#...{NICKNAME}, Паймон, нам пора идти. Задание ещё не выполнено, мы не можем здесь задерживаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001625
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761001625,
					"content": "Иллуги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001626,
						761001627
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761001626,
					"content": "Мы должны двигаться вперёд, хотя бы ради Бьорна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001627,
					"content": "Мы обязательно одолеем врага. Победа будет за нами!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001628,
					"content": "...Что ж, тогда вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иллуги"
				}
			]
		}
	]
}