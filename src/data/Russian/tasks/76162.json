			"dialogs": [
				{
					"id": 761000701,
					"content": "С дороги, прочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761000702,
					"content": "Хи-хи... Куда ты так торопишься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "Голос монстра"
				},
				{
					"id": 761000703,
					"content": "Всё равно вы... все умрёте рано или поздно... только... кому-то придётся отправиться в путь пораньше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "Голос монстра"
				},
				{
					"id": 761000704,
					"content": "Он сам жаловался... что не умер три года назад... теперь... я исполню его желание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "Голос монстра"
				},
				{
					"id": 761000705,
					"content": "...Бьорн? Что ты с ним сделал?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761000706,
					"content": "Он был слишком слаб... слабак... жалкое ничтожество...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "Голос монстра"
				},
				{
					"id": 761000707,
					"content": "...Удел слабака - смерть. Разве нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "Голос монстра"
				},
				{
					"id": 761000708,
					"content": "Не смей так говорить! Он никакой не слабак!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761000709,
					"content": "О... По-твоему... он сильный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "Голос монстра"
				},
				{
					"id": 761000710,
					"content": "Но... сильные всё равно умирают...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "Голос монстра"
				},
				{
					"id": 761000711,
					"content": "Мне казалось... ты прекрасно это понимаешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "Голос монстра"
				},
				{
					"id": 761000712,
					"content": "Те, кто был сильнее тебя... все они умерли... три года назад... десять лет назад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "Голос монстра"
				},
				{
					"id": 761000713,
					"content": "...Заткни свою поганую пасть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761000714,
					"content": "Да... оказывается, настоящий слабак... это ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "Голос монстра"
				},
				{
					"id": 761000715,
					"content": "Почему же... почему каждый раз... каждый раз выживаешь ты один?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "Голос монстра"
				},
				{
					"id": 761000716,
					"content": "...Ты бежишь с поля боя? Жалкий трус, для которого нет ничего дороже своей шкуры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "Голос монстра"
				},
				{
					"id": 761000717,
					"content": "Иллуги! Не слушай эту чушь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761000718,
					"content": "Довольно! Умри!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#...{NICKNAME}! Давай скорее покончим с этим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иллуги"
				}
			]
		},
