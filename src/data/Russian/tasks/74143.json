							4863.15
						],
						"pointId": 6521
					},
					{
						"sceneId": 3,
						"position": [
							4211.379,
							517.961,
							4863
						],
						"pointId": 6522
					},
					{
						"sceneId": 3,
						"position": [
							4210.927,
							518.389,
							4864.287
						],
						"pointId": 6841
					}
				]
			},
			"dialogs": [
				{
					"id": 741430401,
					"content": "Так это вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430402
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430402,
					"content": "Что?! Так значит, это Катерпиллер! Паймон уже чуть со страху не померла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430403,
					"content": "#Ого! {M#Братец}{F#Сестрица} {NICKNAME}, сестрица Паймон! Я так рада, что сегодня здесь собрались все мои самые близкие люди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430404
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430404,
					"content": "А ещё дедушка испёк мне большущий и сладкий праздничный торт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430405
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430405,
					"content": "О-о-о! Так значит, сегодня у Лануар день рождения. С днём рождения тебя! А... торт ещё остался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430406,
					"content": "Э... мы его уже съели!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430407
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430407,
					"content": "К-как?! Ну вот...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430408,
					"content": "Катерпиллер...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430409
					]
				},
				{
					"id": 741430409,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430410
					]
				},
				{
					"id": 741430410,
					"content": "Обо мне не переживайте. Сегодня праздник, так что давайте не будем его портить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430411
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430411,
					"content": "#Ах, спасибо тебе, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430412
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430412,
					"content": "Вы о чём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430413,
					"content": "Ха-ха, ни о чём. Такое чувство, что в последний раз Отряд друзей собирался вместе... очень и очень давно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430414
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430414,
					"content": "Но почему братик Катерпиллер привёл меня сюда? Так странно. И дедушка Эрншоу почему-то испугался, когда его увидел. Храбрец, Принц и Принцесса тоже напугались!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430415
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430415,
					"content": "Но ведь каждый раз, когда я рассказываю дедушке о тебе, Катерпиллер, он отвечает, что хотел бы пригласить тебя в гости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430416
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430416,
					"content": "Ну, всё же выглядит он довольно... Кстати, Катерпиллер, почему ты не хочешь вновь принять человеческий облик?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430417,
					"content": "Не то чтобы не хочу. Просто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430418
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430418,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430419
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430419,
					"content": "Братик Катерпиллер прекрасен таким, какой он есть! Когда он посадил меня на плечи, я сразу все пузырины собрать смогла. Братик Катерпиллер бегает так быстро, словно ветер! Это восхитительно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430420
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430420,
					"content": "Лануар, тебе следует быть осторожной. Если вдруг увидишь кого-то, похожего на меня, не подходи к нему и сразу же убегай. Те, кто выглядят как я, могут быть опасны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430421
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430421,
					"content": "Правда? Но ведь братик Катерпиллер не опасен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430422
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430422,
					"content": "Лануар, пожалуйста. Обещай мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430423
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430423,
					"content": "Казалось, что Катерпиллер может применить какой-то трюк, чтобы повлиять на Лануар.\\nОднако он этого не сделал, а просто терпеливо ждал её ответа.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741430424
					]
				},
				{
					"id": 741430424,
					"content": "Но... хорошо. Я обещаю тебе, братик Катерпиллер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430425
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430425,
					"content": "Н-но как же я смогу узнать, ты это или нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430426
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430426,
					"content": "Точно! Только после выхода из крепости Меропид я поняла, насколько мир вокруг большой, братик Катерпиллер. Как далеко бы я ни ушла, на стену так и не наткнулась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430427
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430427,
					"content": "Когда на небе солнце - жарко, а когда его нет и наступает ночь - становится прохладно. Точно! Ещё вечером в сторону озера начинает дуть ветерок. Холодный такой, не похож на вентилятор. Почему так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430428
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430428,
					"content": "А ещё Храбрец почему-то частенько на нас поглядывает, когда лежит рядом со мной и дедушкой. А когда Принц спит, то его задние ноги подрагивают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430429
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430429,
					"content": "А ещё... я заметила, что когда я иду босиком по траве, она щекочет, попадая между пальцами ног. Когда я читала книги, мне казалось, что трава очень мягкая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430430
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430430,
					"content": "А цветы, которые мне дядя Этьен подарил? Оказалось, их так много растёт в природе. Но у тех цветов корни есть, с помощью которых они за землю держатся. Почему так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430431
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430431,
					"content": "Мир такой большой и странный. Даже свет тут разноцветный! Обо всём этом я хочу рассказывать братику Катерпиллеру. А ещё хочу слушать и твои рассказы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430432
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430432,
					"content": "Вот только как я смогу тебя найти? Так же, как ученик, который очень-очень хотел отыскать рыбку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430433
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430433,
					"content": "Ты помнишь эту историю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430434
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430434,
					"content": "Конечно, помню! Я всё ждала, когда же ты наконец вернёшься и дорасскажешь мне. Удалось ли ученику отыскать рыбку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430435
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430435,
					"content": "Ну... Спустя много-много лет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430436
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430436,
					"content": "Глупый ученик наконец набрался храбрости, попрощался с великим волшебником, покинул мастерскую и отправился на поиски рыбки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430437
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430437,
					"content": "Однако прежде он никогда не видел бескрайнего моря и не понимал, где именно искать её дом. Поэтому ему пришлось расспрашивать об этом всех в округе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430438
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430438,
					"content": "Обратился он к речным камышам. Выслушав его, они сразу же согнулись от смеха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430439
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430439,
					"content": "«Тебе нужно море», - и добавил камыш: «Место это в сто... нет, в тысячу раз шире реки. Именно туда-то она и бежит».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430440
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430440,
					"content": "Погнался ученик за рекой и наконец нашёл море. Но оно оказалось огромным, и юноша не знал, куда идти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430441
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430441,
					"content": "Выслушав его рассказ, чайки клювы пораскрывали от удивления. Да так, что из них на землю вывалился доставшийся им с таким трудом картофель во фритюре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430442
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430442,
					"content": "«Не получится у тебя ничего, братец», - сказала чайка. - «Никому бы и в голову не пришло искать малюсенькую рыбку в таком огромном море. Да и вообще, может, она уже...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430443
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430443,
					"content": "Подмастерье заткнул клюв чайки хлебом, не обращая внимания ни на неё, ни на её возмущённого товарища, и продолжил спрашивать всех вокруг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430444
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430444,
					"content": "Всё потому, что он глупый ученик, которому ведомы только самые простецкие способы отыскать рыбку. Долго-долго он учился подводному плаванию, снова и снова заплывая всё глубже в океан...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430445
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430445,
					"content": "Уверена, что в конце концов он её всё-таки нашёл! Если чего-то сильно-пресильно хотеть и не сдаваться, обязательно всё получится! Мне так дедушка говорил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430446
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430446,
					"content": "Вижу, тебе нравятся истории с хорошим концом... Что ж, дедушка Эрншоу прав. Ученику всё-таки удалось найти рыбку, пусть его глупый способ и занял очень много времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430447
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430447,
					"content": "Когда он увидел её, та плавала в косяке со своими сородичами, которые то и дело передвигались, образуя всё новые замысловатые фигуры. Но ученик сразу же узнал её среди множества таких же рыбок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430448
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430448,
					"content": "«Наконец-то я нашёл тебя...» Желание ученика исполнилось. Однако вместо неимоверной радости от встречи, которую он представлял у себя в голове множество раз, он ощутил растерянность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430449
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430449,
					"content": "Рыбки с любопытством окружили ученика, желая выслушать его историю. Он смущённо рассказал обо всём, что произошло с ним за эти дни, а затем облегчённо вздохнул, создав вокруг себя поток мелких пузырьков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430450
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430450,
					"content": "«Я должен извиниться перед тобой. Дважды». И сказал подмастерье: «Во-первых, за то, что не смог набраться храбрости и помочь, когда ты так нуждалась в этом. А, во-вторых, за мой неожиданный визит...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430451
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430451,
					"content": "«Лишь только увидев тебя, я наконец понял, каким был эгоистом... Мне казалось, что если я извинюсь перед тобой лично, то смогу простить себя за свой проступок».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430452
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430452,
					"content": "«Ну и что?» - ответ рыбки оказался очень неожиданным. - «Да, ты не сумел помочь мне в прошлом, однако теперь я уже вернулась домой к своей семье».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430453
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430453,
					"content": "«В итоге со мной всё хорошо, а значит, тебе не нужно молить меня о прощении».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430454
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430454,
					"content": "«Ты потратил столько времени и сил ради такого пустяка. Даже не знаю, кто ты после этого: упрямец или глупец. Но даже если ты глупец, мы не против дружить с тобой...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430455
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430455,
					"content": "Ого! Значит, они всё-таки подружились? А что случилось потом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430456
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430456,
					"content": "Что дальше? Они... стали лучшими друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430457
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430457,
					"content": "Нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430458
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430458,
					"content": "Неужели история вот так закончилась, братик Катерпиллер?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430459
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430459,
					"content": "Угу, это конец истории. Истории нужно уметь вовремя заканчивать. Иначе они станут плохими. Например, герой превратится в злого дракона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430460
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430460,
					"content": "Ещё я слышал истории, которые тянулись очень и очень медленно, а в конце заканчивались грустно. Главные герои сильно страдали, а значит, это плохие истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430461
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430461,
					"content": "Но твоя история под названием «жизнь» продолжается, дорогая Лануар. С днём рождения! Однажды ты расскажешь мне и свою историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430462
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430462,
					"content": "Угу. Да... я обещаю тебе, братик Катерпиллер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430463
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430463,
					"content": "Я найду тебя и расскажу целую гору историй. А потом я испеку для тебя большой и сладкий праздничный торт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430464
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430464,
					"content": "Ха-ха-ха, торт печь вовсе не обязательно. Я даже не знаю, когда у меня день рождения. Помню только день, когда я очнулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430465
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741430465,
					"content": "Спасибо, Лануар. За то, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерпиллер"
				}
			]
		},
