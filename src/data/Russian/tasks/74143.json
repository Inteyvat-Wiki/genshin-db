				]
			},
			"dialogs": [
				{
					"id": 741430501,
					"content": "Лануар! Лануар! Ты не пострадала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430502
					],
					"speakerTitle": "Эрншоу"
				},
				{
					"id": 741430502,
					"content": "Дедушка! Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430503
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430503,
					"content": "А...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430504,
					"content": "#Ах... Отлично! Спасибо вам, {NICKNAME}, Паймон. Спасибо большое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430505,
						741430506
					],
					"speakerTitle": "Эрншоу"
				},
				{
					"id": 741430505,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430507
					]
				},
				{
					"id": 741430507,
					"content": "Но... это был всего лишь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430508,
					"content": "Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430509
					]
				},
				{
					"id": 741430509,
					"content": "Да... но... Паймон знает-знает! Ух! Хорошо хоть, что Лануар не пострадала. Это самое главное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430510,
					"content": "#...Спасибо, дедушка. И спасибо вам, {M#братец}{F#сестрица} {NICKNAME}, сестрица Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430511
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430511,
					"content": "Не убегай больше так! Я чуть с ума не сошёл от волнения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430512
					],
					"speakerTitle": "Эрншоу"
				},
				{
					"id": 741430512,
					"content": "Простите! Ещё и вам пришлось переживать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430513
					],
					"speakerTitle": "Эрншоу"
				},
				{
					"id": 741430513,
					"content": "Всё хорошо, ребёнок в безопасности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430514
					],
					"speakerTitle": "Шарлен"
				},
				{
					"id": 741430514,
					"content": "(Лануар, ты точно в порядке?..)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430515,
					"content": "#(Я поняла, что значили слова братца Катера и почему {M#братец}{F#сестрица} {NICKNAME} ничего не рассказал{F#а} дедушке.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430516
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430516,
					"content": "(Поэтому... поэтому я тоже ничего ему не скажу. Я не хочу, чтобы он распереживался. Я хорошая девочка.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430517
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430517,
					"content": "(Лануар - умница.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430518
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430518,
					"content": "(...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430519
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430519,
					"content": "(Нет-нет, и вовсе я не умница. Я совершенно не понимаю, что значили те последние слова братца Катера и за что он благодарил меня. Ведь это он всё время помогал мне.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430520
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430520,
					"content": "(Когда я стану чуть старше, я сама разыщу братца Катера и обо всём его расспрошу. Нам будет о чём поговорить, а ещё я приготовлю ему торт.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430521
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430521,
					"content": "#({M#Братец}{F#Сестрица} {NICKNAME}, сестрица Паймон, давайте, когда я вырасту, мы все вместе пойдём к братцу Катеру?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430522,
						741430523
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430522,
					"content": "Поговорим об этом, когда подрастёшь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430524
					]
				},
				{
					"id": 741430524,
					"content": "Отлично, значит, договорились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430525
					],
					"speakerTitle": "Лануар"
				},
				{
					"id": 741430525,
					"content": "Они ушли.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741430523,
					"content": "Хорошо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430524
					]
				},
				{
					"id": 741430506,
					"content": "Не стоит благодарить нас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430507
					]
				}
			]
		}
	]
