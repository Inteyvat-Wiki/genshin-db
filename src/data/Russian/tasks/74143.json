				]
			},
			"dialogs": [
				{
					"id": 741430201,
					"content": "#{F#Девочки}{M#Ребята}! Вы... вы... я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430202
					],
					"speakerTitle": "Эрншоу"
				},
				{
					"id": 741430202,
					"content": "Ой, дедушка Эрншоу, что случилось? Отдышись сперва...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430203,
					"content": "Лануар... Лануар схватил хиличурл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430204
					],
					"speakerTitle": "Эрншоу"
				},
				{
					"id": 741430204,
					"content": "Как это случилось?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741430205,
					"content": "Он пошёл туда! Я позову на помощь. Прошу вас, скорее идите за ним! Вдруг беда случилась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430206
					],
					"speakerTitle": "Эрншоу"
				},
				{
					"id": 741430206,
					"content": "Хорошо! Мы уже спешим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7414304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
