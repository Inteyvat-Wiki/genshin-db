					{
						"sceneId": 3,
						"position": [
							-306.286,
							274.946,
							2159.712
						],
						"pointId": 330201530
					}
				]
			},
			"dialogs": [
				{
					"id": 735300101,
					"content": "Ха-ха... Ох... Ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300102
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300102,
					"content": "#{NICKNAME}, смотри, там кто-то плачет... и смеётся. О, это наш знакомый?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735300103,
					"content": "Давно не виделись. Помните меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300104,
						735300106
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300104,
					"content": "Ты кто?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300105
					]
				},
				{
					"id": 735300105,
					"content": "Это же я! Джами, учёный из Амурты. Я ещё варил снадобье Фаиз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300108
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300108,
					"content": "О-о, кажется, Паймон припоминает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735300109,
					"content": "Как твои исследования?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735300110,
					"content": "Ха-ха... Это... Ну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300111
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300111,
					"content": "Видимо, не очень?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300112
					]
				},
				{
					"id": 735300112,
					"content": "Нет-нет, благодаря вам я добился неплохих успехов в изучении снадобья Фаиз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300113
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300113,
					"content": "Раньше я безумно боялся обмануть ожидания своего наставника. Никак не ожидал, что он прочитает моё исследование и рассыплется в похвалах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300114
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300114,
					"content": "«Джами, отличная работа. Я горжусь тем, что ты мой ученик!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300115
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300115,
					"content": "Так это же отлично? Поздравляем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735300116,
					"content": "Если бы на этом всё закончилось, то да... Эх, жаль, что затем начался мой самый страшный кошмар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300117
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300117,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300118
					]
				},
				{
					"id": 735300118,
					"content": "Похоже, результаты моих последних экспериментов превзошли все ожидания. Наставник, обрадовавшись, решил опробовать всё сам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300119
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300119,
					"content": "Я помог ему организовать площадку для эксперимента и старательно приготовил самое эффективное снадобье Фаиз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300120
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300120,
					"content": "А потом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735300121,
					"content": "Как вам сказать... За ним наблюдала целая толпа студентов, когда он торжественно выпил снадобье Фаиз перед чудовищем и не выдержал даже одного удара...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300122
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300122,
					"content": "К счастью, всё обошлось, и ему просто пока нельзя вставать с постели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300123
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300123,
					"content": "Пф, ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735300124,
					"content": "Ха-ха... Кхм, как бы там ни было, я опозорил моего наставника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300125
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300125,
					"content": "Потом сварливый старик раскритиковал меня за то, что я «не взял в расчёт запросы потребителя», «не учёл реальные обстоятельства». Ругался на чём свет стоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300126
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300126,
					"content": "Но его же никто не заставлял, он сам полез!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735300127,
					"content": "А кто спорит? Поэтому у меня к вам просьба. Пожалуйста, помогите мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300128,
						735300129
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300128,
					"content": "Преподать ему урок?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300130
					]
				},
				{
					"id": 735300130,
					"content": "Нет, нет же! Я ни о чём таком не думал! По крайней мере, сейчас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300131
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300131,
					"content": "Хе-хе, а значит, раньше подумывал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735300132,
					"content": "Ну... немного. Это неважно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300133
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300133,
					"content": "Я хотел сказать, что пересмотрел результаты своих экспериментов и придумал снадобье Фаиз длительного действия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300134
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300134,
					"content": "Длительного действия? Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735300135,
					"content": "Я вспомнил реакцию наставника, когда на него напали, и кое-что понял. Когда мы, обычные люди, оказываемся в опасности, мы застываем, голова пустеет, мы не знаем, что делать дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300136
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300136,
					"content": "Если выпить снадобье Фаиз уже после столкновения с опасностью, то не факт, что оно успеет подействовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300137
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300137,
					"content": "В отличие от снадобья Фаиз длительного действия. Если его выпить, то оно сразу начнёт действовать тогда, когда вы окажетесь в опасной ситуации. Это позволит обычному человеку выиграть время, дав шанс среагировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300138
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300138,
					"content": "А как оно определит опасную ситуацию?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300139
					]
				},
				{
					"id": 735300139,
					"content": "Как я и сказал, когда обычные люди оказываются в опасности, они застывают. Если выпить снадобье Фаиз длительного действия, оно не активируется, пока испытуемый ведёт себя как обычно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300140
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300140,
					"content": "Но стоит застыть на месте, как снадобье начнёт действовать и ускорит субъективное восприятие времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300141
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300141,
					"content": "Вот оно как, теперь понятно. Итак... Ты хотел попросить нас помочь тебе с экспериментом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300142
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735300142,
					"content": "Всё верно. Хотя снадобье Фаиз длительного действия и разрабатывалось для обычных людей, но эксперименты слишком опасны, поэтому нужны люди с боевым опытом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300143
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300143,
					"content": "Хм, дай-ка подумать. А хотим ли мы помогать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300144
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735300144,
					"content": "#Паймон вдруг проголодалась. Так потянуло в таверну Ламбада... {NICKNAME}, а моры нам хватит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300145,
						735300146
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735300145,
					"content": "К сожалению...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300147
					]
				},
				{
					"id": 735300147,
					"content": "Кхм. По правде говоря, наставник меня отругал, конечно, но всё равно одобрил кругленькую сумму на расходы по экспериментам. Я бы хотел предложить эту мору вам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300148
					],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300148,
					"content": "Раз так, то рады тебе помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300149
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735300149,
					"content": "Огромное спасибо! Вы меня очень выручите, если получится восстановить мою подорванную репутацию учёного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джами"
				},
				{
					"id": 735300146,
					"content": "...в этом месяце у нас перерасход средств.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300147
					]
				},
				{
					"id": 735300129,
					"content": "Подкупить его?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300130
					]
				},
				{
					"id": 735300106,
					"content": "Ты ворчащий учёный?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300107
					]
				},
				{
					"id": 735300107,
					"content": "Ты и прозвище моё помнишь. Верно, я учёный из Амурты, что вечно вздыхал, потому что не оправдал ожидания своего наставника. Я Джами, хоть мне и стыдно называть своё имя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300108
					],
					"speakerTitle": "Джами"
				}
			]
		}
	]
}