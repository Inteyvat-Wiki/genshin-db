					"content": "(Она сказала об этом вслух...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610511
					]
				},
				{
					"id": 4610511,
					"content": "Сокровища? Охота за сокровищами?",
					"roleType": "TALK_ROLE_NPC",
