			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кэйа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610101,
					"content": "Плохо, плохо, всё очень плохо... Что же делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610102,
						4610103
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610102,
					"content": "Что случилось, Кэйа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				},
				{
					"id": 4610104,
					"content": "О, тысячи ветров! Хвала Архонтам, я так рад, что вы здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610105
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610105,
					"content": "#Послан{M#ец}{F#ница} Анемо Архонта, найдётся ли у тебя минута свободного времени?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610106
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610106,
					"content": "Какая откровенная лесть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610107,
						4610109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610107,
					"content": "Может быть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610108
					]
				},
				{
					"id": 4610108,
					"content": "Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610110
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610110,
					"content": "Рыцари не должны об этом узнать. Кроме тебя, никто не сможет мне помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610111
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610111,
					"content": "Давай обсудим это в более подходящем месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610112
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610112,
					"content": "Встретимся в саду рядом со штабом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610113
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610113,
					"content": "К чему эта таинственность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610109,
					"content": "Расскажи, что произошло.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610110
					]
				},
				{
					"id": 4610103,
					"content": "Обычно ты выглядишь гораздо спокойнее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				}
			]
		},
		{
			"id": 46102,
			"completionStepIds": [
				46109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46109",
							"2"
						],
						"stepId": 46109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кэйа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610201,
					"content": "Здесь мы можем поговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610202
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610202,
					"content": "В чём дело? Говори уже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610203,
					"content": "С чего бы начать... Я расскажу вам один секрет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610204
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610204,
					"content": "Он касается моего прошлого. Надеюсь, вы никому не расскажете...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610205
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610205,
					"content": "Не переживай! Мы никому не расскажем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610206,
					"content": "В общем... Мой дед был пиратом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610207
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610207,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610208,
					"content": "Эй! Вы не верите мне? Я говорю правду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610209
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610209,
					"content": "Эта повязка досталась мне по наследству от деда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610210,
						4610213
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610210,
					"content": "#Не знал{F#а}, что повязки передают по наследству.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610211
					]
				},
				{
					"id": 4610211,
					"content": "#Ха-ха! {NICKNAME}, это знают все!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610212
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610212,
					"content": "Также все знают, что причёски дети получают от родителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610214
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610214,
					"content": "Вчера я копался в старых бумагах деда и обнаружил записку, в которой упоминались какие-то <color=#00E1FFFF>сокровища</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610215
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610215,
					"content": "Сокровища?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610216,
					"content": "Если верить записке, сокровища спрятаны в «затерянных руинах Аркадии».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610217
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610217,
					"content": "Сокровища...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610218,
					"content": "Точное расположение этих руин неизвестно, но я навёл кое-какие справки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610219
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610219,
					"content": "Сокровища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610220,
					"content": "Кэйа! Что это за сокровища? Золото или алмазы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610221,
					"content": "Ха-ха! Настоящие сокровища - это не золото и не алмазы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610222
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610222,
					"content": "Сокровище моего деда - это легендарный меч!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610223
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610223,
					"content": "Магический меч, дарующий хозяину безграничную силу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610224
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610224,
					"content": "Ого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610225,
					"content": "Этот меч упал с Селестии и ушёл на морское дно. Там его случайно обнаружили мой дед и его команда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610226
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610226,
					"content": "В тот момент, когда дедушка взял меч в руки, раздался гром, поднялись волны и задул ужасный ветер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610227
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610227,
					"content": "С этим мечом мой дед победил восьмиглавую гидру, сребровласую банши, жуткого дракона Бездны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610228
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610228,
					"content": "Но огромная сила меча привлекла внимание других жадных пиратов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610229
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610229,
					"content": "Чтобы избежать ненужных конфликтов, мой дед спрятал меч.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610230,
						4610232
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610230,
					"content": "Гидра, банши... Они существуют?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610231
					]
				},
				{
					"id": 4610231,
					"content": "Наш потрясающий мир полон необъяснимого и невероятного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610233
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610233,
					"content": "Только пираты могут рассказать о таких захватывающих приключениях!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610234
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610234,
					"content": "С ума сойти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610235,
					"content": "Недавно в руинах неподалёку заметили <color=#00E1FFFF>шайку мародёров</color>. Они уже похитили немало сокровищ. Поэтому их называют Похитители сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610236
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610236,
					"content": "Вскоре они могут обнаружить руины Аркадии, и тогда магический меч будет потерян навсегда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610237
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610237,
					"content": "Мы этого не допустим! Мы должны найти меч первыми!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610238,
					"content": "#Не сомневайся, что {NICKNAME} и я поможем тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610239
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610239,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610240
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610240,
					"content": "Замечательно! Но, пожалуйста, никому об этом не рассказывайте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610241
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610241,
					"content": "#Эй, {NICKNAME}! Здорово, да? Невероятно крутой меч!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610242,
						4610243
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610242,
					"content": "Он существует?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610244,
					"content": "Ну... Давай для начала посмотрим, что мы можем узнать в <color=#00E1FFFF>Гильдии искателей приключений</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610245
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610245,
					"content": "Искатели приключений ведь должны много знать о руинах, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610243,
					"content": "Он правда существует?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610232,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610233
					]
				},
				{
					"id": 4610213,
					"content": "Невероятно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
