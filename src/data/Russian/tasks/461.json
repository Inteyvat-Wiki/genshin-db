					"nextDialogs": [
						4610805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4610805,
					"content": "Тебе не кажется, что это было бы слишком просто? Узнать о руинах от других путешественников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610806
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4610806,
					"content": "Но у меня есть несколько зацепок.",
