				"points": []
			},
			"dialogs": [
				{
					"id": 210229601,
					"content": "Ещё две таблички.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229602
					]
				},
				{
					"id": 210229602,
					"content": "Давай посмотрим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229603
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210229603,
					"content": "«...И воевали они на просторах долины Гуйли, где чёрная пыль душила небеса и где раскололись тысяча камней...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229604
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210229604,
					"content": "Ох... Вероятно, когда-то здесь произошла битва... Грандиозная битва...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229605
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210229605,
					"content": "В этой битве была разрушена ассамблея Гуйли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229606
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210229606,
					"content": "Кто-то отказался покинуть ассамблею Гуйли и остался защищать свой дом... А ещё здесь остались...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229607
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210229607,
					"content": "Сокровища!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210220502
					]
				},
				{
					"id": 210220502,
					"content": "Я понимаю твой интерес. Если воспринимать это послание буквально, то в долине Гуйли можно найти сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220503
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220503,
					"content": "Здесь написано «Четыре завета Гуй Чжун», а дальше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220504
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220504,
					"content": "«Обучай мудростью, следуй добродетели, укрепляй свои кости, преследуй амбиции - слияние этих четырёх заветов известно как \"Ассамблея Гуйли\"».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220505
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220505,
					"content": "Что же это значит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220506
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220506,
					"content": "Давайте вернёмся на постоялый двор «Ваншу». Перед тем как попытаться решить загадку заветов Гуй Чжун, стоит хорошенько передохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				}
			]
		}
	]
}