							"2"
						],
						"stepId": 2102209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сорайя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210220301,
					"content": "Удалось найти что-нибудь интересное в руинах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229501
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210229501,
					"content": "#Я наш{F#ла}{M#ёл} пять каменных табличек.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229502
					]
				},
				{
					"id": 210229502,
					"content": "Отлично! Позволь мне взглянуть... Хм... Здесь всё перепутано. Интересно, получится ли у меня восстановить верную последовательность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220302
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220302,
					"content": "Значительная часть текста утеряна, поэтому прочесть его непросто. Я не уверена, что фрагменты расположены в правильном порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220303
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220303,
					"content": "Я думаю, что последовательность такая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220304
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220304,
					"content": "«...В давние времена, когда народы собирались воедино, чтобы возделывать землю, с небес сошла богиня по имени Гуй Чжун, чьим доменом была Пыль и чья власть покрывала небеса на тысячи ли...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220305
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220305,
					"content": "«...Богиня даровала людям Четыре завета... Потом на землю сошёл другой бог, господство которого было над землёй и скалами, и повёл тот бог нацию Ли Юэ в эти земли. И защищали они этот народ вместе...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220306
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220306,
					"content": "«...И союз их был назван \"Гуйли\", по именам обоих богов...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220307
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220307,
					"content": "Видимо, здесь идёт речь об истории ассамблеи Гуйли. А также об Архонте Пыли, который защищал это место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220308
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220308,
					"content": "Однако здесь упоминается ещё один Архонт, который привёл в эти края часть своего народа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220309
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220309,
					"content": "По всей видимости, название Гуйли состоит из частей имён двух Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220310
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220310,
					"content": "Удивительно. Мне никогда раньше не попадались исторические свидетельства о мирном сосуществовании Архонтов... Тем более об их сотрудничестве...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220311
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220311,
					"content": "Судя по всему, они были хорошими друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220312
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220312,
					"content": "Но что же произошло? Внезапно они... исчезли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220313
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220313,
					"content": "Почему же ассамблея пришла в запустение? Два Архонта смогли бы защитить эту землю от любого бедствия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220314
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220314,
					"content": "Значит произошла катастрофа, которую даже Архонты не смогли предотвратить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220315
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220315,
					"content": "#Путешественн{F#ица}{M#ик}, могу ли я попросить тебя продолжить поиски? Если я не ошибаюсь, в округе есть ещё много таких каменных табличек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220316
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220316,
					"content": "Возможно, они помогут нам понять, что случилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220317
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220317,
					"content": "Письмена на этих каменных табличках отличаются от тех, которые были изучены ранее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220318
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210220318,
					"content": "Ах, сколько легенд, сколько версий... Какой же из них верить?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				}
			]
		},
