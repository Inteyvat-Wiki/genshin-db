			"dialogs": [
				{
					"id": 760320201,
					"content": "Эй ты, знаешь, что бывает за незаконное проникновение в запретную зону?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320202
					],
					"speakerTitle": "Опричник Фатуи"
				},
				{
					"id": 760320202,
					"content": "...Откуда же мне знать?! Это же моё первое нарушение, ещё нет опыта. Дайте мне ещё один шанс!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320203
					],
					"speakerTitle": "Подозрительный человек"
				},
				{
					"id": 760320203,
					"content": "Дайте мне ещё один шанс. В следующий раз обещаю, меня не поймают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320204
					],
					"speakerTitle": "Подозрительный человек"
				},
				{
					"id": 760320204,
					"content": "Что за шутки, <color=#00E1FFFF>ни одна крыса, жаждущая сокровищ</color>, не уйдёт отсюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320205
					],
					"speakerTitle": "Опричник Фатуи"
				},
				{
					"id": 760320205,
					"content": "Эй! Та девчонка, наверное, уже всё вынесла, пока ты тут со мной пререкаешься!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320206
					],
					"speakerTitle": "Подозрительный человек"
				},
				{
					"id": 760320206,
					"content": "Не твоё дело, что с ней будет. Сдавайся. Сопротивление бесполезно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Опричник Фатуи"
				}
			]
		}
	]
