			"dialogs": [
				{
					"id": 760300501,
					"content": "Хнык-хнык... А? Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300502
					],
					"speakerTitle": "Риека"
				},
				{
					"id": 760300502,
					"content": "Как красиво...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300503
					],
					"speakerTitle": "Риека"
				},
				{
					"id": 760300503,
					"content": "Вот и славно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300504
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760300504,
					"content": "И вот она уходит. Дорожка из камней приведёт её в Анклав Морозной Луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760300505,
					"content": "(Коломбина говорит, что не хочет, чтобы к ней относились как к богине, но тем не менее она помогает тем, кто в беде...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300506
					]
				},
				{
					"id": 760300506,
					"content": "Ах, но как же картина?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760300507,
					"content": "Ничего страшного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300508
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760300508,
					"content": "Недостающие детали можно добавить позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300509
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760300509,
					"content": "Мне нравится смотреть, как люди находят дорогу и возвращаются домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				}
			]
		}
