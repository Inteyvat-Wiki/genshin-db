			"dialogs": [
				{
					"id": 760300101,
					"content": "Хм. Сегодня атмосфера такая необычная. Коломбина, ты украшаешь цветочный луг?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760300102,
					"content": "Не я. Они.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760300103,
					"content": "Они... это куухенки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760300104,
					"content": "Эти камни излучают слабый свет, поглощая куувяки. Куухенки очень любят их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760300105,
					"content": "То есть... они кладут камни на землю и играют?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760300106,
					"content": "Подойдите сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760300107,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760300108,
					"content": "Ого! Сверху это похоже на картину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760300109,
					"content": "Кажется, одного не хватает...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "Да, не хватает. Я пойду соберу ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760300111,
					"content": "Хм? Ты выйдешь ради этого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760300112,
					"content": "Я знаю подходящее место, освещённое Луной и изобилующее такими камнями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760300113,
					"content": "Мы можем пойти с тобой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760300115,
					"content": "Ладушки, тогда давайте наберём побольше. Мы с нетерпением ждём, чтобы увидеть готовую работу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
