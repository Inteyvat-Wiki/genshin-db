			"dialogs": [
				{
					"id": 250350801,
					"content": "#Два... Три... Это всё! Отличная работа, ты {M#нашёл}{F#нашла} все пропавшие посылки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350802
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350802,
					"content": "...Погоди-ка, а разве эту посылку не Тундама должен был доставить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350803
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350803,
					"content": "Вот оплата за твой труд. Спасибо за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350804
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350804,
					"content": "Мне придётся серьёзно поговорить с Тундамой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мичик"
				}
			]
		},
