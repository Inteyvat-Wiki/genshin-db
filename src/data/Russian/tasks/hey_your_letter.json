	"talks": [
		{
			"id": 2503501,
			"completionStepIds": [
				2503501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2503501",
							"2"
						],
						"stepId": 2503501,
						"stateName": "QUEST_STATE_UNFINISHED"
