				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мичик"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250350101,
					"content": "Вот дурачки... Как же они опять потеряли посылки? Я же говорил им не использовать все эти модные штучки, когда они занимаются курьерской доставкой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350102
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350102,
					"content": "Что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350103
					]
				},
				{
					"id": 250350103,
					"content": "Несколько наших курьеров снова проигнорировали инструкции и в результате потеряли кучу посылок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350104
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350104,
					"content": "Эх, неужели они не понимают, что подобная беспечность вредит репутации Потомков Крон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350105
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350105,
					"content": "На работе надо уметь сосредоточиться на выполнении поставленных задач! Если спускаешься по склону, иди, как обычно. Зачем скользить, как будто ты в отпуске?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350106
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350106,
					"content": "Я много раз говорил им, но эти юнцы не слушают. Они хотят лишь дешёвых острых ощущений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350107
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350107,
					"content": "Ох, а теперь мне надо просить кого-то собрать посылки. Дай-ка подумать, кто сейчас свободен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350108,
						250350111
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350108,
					"content": "Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350109
					]
				},
				{
					"id": 250350109,
					"content": "Правда? Ты поможешь мне? Да это же замечательно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350110
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350110,
					"content": "Мне потребуется немало времени, чтобы найти кого-нибудь, кто мог бы помочь, а если я сам отправлюсь на поиски, то некому будет присматривать за Курьерским представительством.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350117,
					"content": "И не волнуйся, ты не будешь искать иголку в стоге сена. Я знаю маршруты, по которым обычно ходят курьеры, так что могу предположить, где примерно посылки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350118
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350118,
					"content": "Я отмечу для тебя возможные места, где пропали посылки. Надеюсь на твою помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350111,
					"content": "Посылки большие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350112
					]
				},
				{
					"id": 250350112,
					"content": "Нет, но именно поэтому их всегда трудно найти. Ох уж, эти беспечные маленькие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350113
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350113,
					"content": "...Так что, если у тебя есть время, поможешь разыскать посылки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350114
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350114,
					"content": "В Курьерском представительстве сейчас не хватает людей, так что если бы я отправился на поиски сам, то некому было бы остаться здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350115
					],
					"speakerTitle": "Мичик"
				},
				{
					"id": 250350115,
					"content": "Ничего, я всё сделаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350116
					]
				},
				{
					"id": 250350116,
					"content": "Отлично! Спасибо большое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Мичик"
				}
			]
		},
