			},
			"dialogs": [
				{
					"id": 741411001,
					"content": "Правда? Золотые слова. Как тебя зовут?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411002
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741411002,
					"content": "Катерпиллер.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411003
					]
				},
				{
					"id": 741411003,
					"content": "#{NICKNAME}. Интересно, как ты сюда попал{F#а}. А где же Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411004
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741411004,
					"content": "Подожди-ка... ты же не какой-нибудь монстр, который решил принять облик знакомого мне человека ради забавы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411005
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741411005,
					"content": "Мы не так уж и давно знакомы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411006
					]
				},
				{
					"id": 741411006,
					"content": "Вот как? Кажется, мы и правда расстались с тобой совсем недавно. Ну, неважно. Наверное, с возрастом у меня и память ухудшилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411007
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741411007,
					"content": "Ты ведь точно не монстр, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411008
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741411008,
					"content": "Ты всё помнишь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411009,
						741411010
					]
				},
				{
					"id": 741411009,
					"content": "Расскажи историю про сад великана.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				},
				{
					"id": 741411011,
					"content": "Я помню. Помню. Ты и правда ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411012
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741411012,
					"content": "Прости за подозрительность. Мне тут всякое повидать пришлось. Да ещё и сражаться с теми, кого одолеть мне точно не под силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411013
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741411013,
					"content": "Что-то здесь и правда изменилось. Небо озарили золотые лучи, к которым потянулись раскрывшиеся подсолнухи. Возможно, изменилось и всё созданное древними мироздание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411014
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741411014,
					"content": "Всё изменилось. Может быть, я смогу понять и принять это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411015
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741411015,
					"content": "Катерпиллер...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411016
					]
				},
				{
					"id": 741411016,
					"content": "Пойдём со мной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411017
					]
				},
				{
					"id": 741411017,
					"content": "#Ха-ха-ха, похоже, это действительно ты. Я помню. Мы с тобой знакомы. И ты совсем не изменил{F#ась}{M#ся}. Никогда не пройдёшь мимо, потому что ты порядочный и добрый человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411018
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741411018,
					"content": "#Но обо мне тебе беспокоиться не стоит. Мне помощь не нужна. Ты же видел{F#а} мои способности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411019
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741411019,
					"content": "Кроме того... я знаю о том, что здесь происходит, намного больше, чем ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411020
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741411020,
					"content": "#Хиличурл, скажи {F#ей}{M#ему}, чтобы уходил{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411021
					]
				},
				{
					"id": 741411021,
					"content": "Хочешь мне что-то сказать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411022
					]
				},
				{
					"id": 741411022,
					"content": "Ты понимаешь меня? Хорошо, тогда я задам тебе вопрос. Кем ты меня видишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411023
					]
				},
				{
					"id": 741411023,
					"content": "Собакой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411024
					]
				},
				{
					"id": 741411024,
					"content": "Вот как... значит, ещё не слишком поздно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411025
					]
				},
				{
					"id": 741411025,
					"content": "#Ради твоего же блага... Уходи отсюда, {M#юноша}{F#девушка}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411026
					]
				},
				{
					"id": 741411026,
					"content": "#Да. {NICKNAME}, ты принадлежишь к миру света.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411027
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741411027,
					"content": "Но у меня столько вопросов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411028
					]
				},
				{
					"id": 741411028,
					"content": "Забудь о них. До свидания. И больше не возвращайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741411010,
					"content": "Расскажи историю про подмастерье и рыбку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				}
			]
		},
