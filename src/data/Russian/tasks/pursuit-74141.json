			"dialogs": [
				{
					"id": 741411101,
					"content": "#Ой! Ты вернул{F#ась}{M#ся}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741411102,
					"content": "Как долго меня не было?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411103
					]
				},
				{
					"id": 741411103,
					"content": "Ну, пару секунд точно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741411104,
					"content": "Если для тебя это был всего лишь миг...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411105
					]
				},
				{
					"id": 741411105,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741411106,
					"content": "Ничего. Здесь очень опасно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411107
					]
				},
				{
					"id": 741411107,
					"content": "Вот как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741411108,
					"content": "Тогда почему же Канотила до сих пор не вернулась? Неужто в Фонтейн отправилась жандармом служить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741411109,
					"content": "Вернёмся сюда попозже. У меня немного кружится голова.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411110
					]
				},
				{
					"id": 741411110,
					"content": "Вот как. Может, пойдём перекусим? Паймон так о тебе беспокоилась, что аж с голоду пухнуть начала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741411111,
					"content": "#Я ведь всего на пару секунд пропал{F#а}, нет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411112
					]
				},
				{
					"id": 741411112,
					"content": "Ну, Паймон сильно-сильно-сильно переживала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
