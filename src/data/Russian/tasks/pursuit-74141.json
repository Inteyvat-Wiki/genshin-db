			},
			"dialogs": [
				{
					"id": 741410801,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410802
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410802,
					"content": "Катерпиллер.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410803
					]
				},
				{
					"id": 741410803,
					"content": "Кто здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410804
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410804,
					"content": "Так это ты... Я тебя помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410805
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410805,
					"content": "Откуда ты здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410806
					]
				},
				{
					"id": 741410806,
					"content": "#Ты меня опередил{F#а}. То же самое я хотел спросить у тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410807
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410807,
					"content": "Ну да ладно, я просто подумал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410808
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410808,
					"content": "#Ты ведь {NICKNAME}, верно? А та мелкая девчушка с белыми волосами... как её там звали? Почему она не с тобой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410809,
						741410811
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410809,
					"content": "Паймон ждёт меня снаружи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410810
					]
				},
				{
					"id": 741410810,
					"content": "Так вот как её зовут. Ну, неважно. Ты хороший человек. Паймон тоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410812
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410812,
					"content": "Я пришёл сюда, чтобы найти кое-что очень важное. Знаешь, что именно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410813
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410813,
					"content": "#Ладно. Забудь этот вопрос. Как ты сюда попал{F#а}? Лучше уходи поскорее. Здесь опасно. Приходили сюда уже всякие испытать себя, да только заблудились и получили вместо мозга одну только кашу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410814
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410814,
					"content": "Помнится, раньше мы с тобой столько всего крутого успели сделать. Это единственное в моей жизни, чем я могу гордиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410815
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410815,
					"content": "Ты имеешь в виду...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410816,
						741410818
					]
				},
				{
					"id": 741410816,
					"content": "...нашу победу над Нарциссенкрейцом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410817
					]
				},
				{
					"id": 741410817,
					"content": "Что стало с мастером? Ты тоже в Ордо Нарциссенкрейц состоишь... или же ты работаешь на Гильотена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410820,
					"content": "О, золотая бабочка. Словно маленькое сияющее солнышко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410821
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410821,
					"content": "Осталось только схватить его, и всё будет... всё будет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410818,
					"content": "...спасение Лануар?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410819
					]
				},
				{
					"id": 741410819,
					"content": "Точно! Да, я помню, как мы сбежали из морской тюрьмы вместе с Лануар. Дети в таком месте жить точно не должны. Ей лучше быть в окружении цветов и солнечных лучей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741410811,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410812
					]
				}
			]
		},
