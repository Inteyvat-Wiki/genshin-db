					}
				]
			},
			"dialogs": [
				{
					"id": 790750101,
					"content": "О чём думает Шовинье? Ах, он даже не хочет со мной разговаривать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750102
					],
					"speakerTitle": "Пануэль"
				},
				{
					"id": 790750102,
					"content": "Расскажи о Шовинье...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750103
					]
				},
				{
					"id": 790750103,
					"content": "Здравствуйте. Простите... Шовинье всё ещё сердится на меня, поэтому не приходит, чтобы поговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750104
					],
					"speakerTitle": "Пануэль"
				},
				{
					"id": 790750104,
					"content": "Но внизу нет ни ветра, ни солнца. Что, если он засохнет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750105
					],
					"speakerTitle": "Пануэль"
				},
				{
					"id": 790750105,
					"content": "Ну, раз это цветок в горшке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790750106,
					"content": "...мы можем вынести его.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750107
					]
				},
				{
					"id": 790750107,
					"content": "Я пытался. Но Шовинье был в таком штормовом настроении, что я не мог подступиться к нему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750108
					],
					"speakerTitle": "Пануэль"
				},
				{
					"id": 790750108,
					"content": "Он так зол, что меня чуть не сдуло!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750109
					],
					"speakerTitle": "Пануэль"
				},
				{
					"id": 790750109,
					"content": "Подожди, а разве от чьего-то гнева может сдуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750110,
						790750111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790750110,
					"content": "Впечатляющий штормовой гнев.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				},
				{
					"id": 790750112,
					"content": "Может быть, он рассержен из-за того, что я отказался отправиться с ним в странствия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750113
					],
					"speakerTitle": "Пануэль"
				},
				{
					"id": 790750113,
					"content": "Дорогие гости, почему бы вам не сходить к Шовинье? Вдруг вы сможете его убедить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750114
					],
					"speakerTitle": "Пануэль"
				},
				{
					"id": 790750114,
					"content": "Хорошо, давай попробуем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750115
					]
				},
				{
					"id": 790750115,
					"content": "Да, мы побывали во многих местах и знакомы с разными людьми... Возможно, нам и правда удастся его убедить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790750116,
					"content": "Отлично! Шовинье сейчас в пещере на острове. Сходите туда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750117
					],
					"speakerTitle": "Пануэль"
				},
				{
					"id": 790750117,
					"content": "Я... я уберусь здесь, найду местечко, где Шовинье сможет погреться на солнышке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пануэль"
				},
				{
					"id": 790750111,
					"content": "Да, в таком случае приблизиться сложно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				}
			]
		},
