			"dialogs": [
				{
					"id": 790750201,
					"content": "Я... я уберусь здесь, найду местечко, где Шовинье сможет погреться на солнышке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750202
					],
					"speakerTitle": "Пануэль"
				},
				{
					"id": 790750202,
					"content": "Надеюсь, вам удастся убедить Шовинье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750203
					],
					"speakerTitle": "Пануэль"
				},
				{
					"id": 790750203,
					"content": "Если я пойду к Шовинье, он, наверное, опять меня отчитает и начнёт злиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пануэль"
				}
			]
		},
