				]
			},
			"dialogs": [
				{
					"id": 760290201,
					"content": "Айно, ты дома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290202,
					"content": "Ой! Это же голос Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290203
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290203,
					"content": "Привет, привет! Вы пришли в гости? Принесли угощение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290204
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290204,
					"content": "Паймон знала, что ты так скажешь! Вот, мы купили это по дороге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290205,
					"content": "Хе-хе, давай сюда, быстрее! Инеффа скоро вернётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290206
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290206,
					"content": "Во что сегодня поиграем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290207
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290207,
					"content": "Хе-хе... На самом деле, нам нужна твоя помощь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290208,
					"content": "А-а-а! Убери... Убери от меня эту странную штуку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290209
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290209,
					"content": "«Странную штуку»? Ты имеешь в виду лиру?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290210,
					"content": "Я не раз говорила, что ненавижу вещи, которые не могут объяснить наука или механика...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290211
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290211,
					"content": "Говорю тебе, эта лира... буквально материализуется у меня на пороге, когда ей вздумается. И после того, как я её починю, она исчезает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290212
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290212,
					"content": "Но... это вовсе не значит, что я верю во всякие суеверия!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290213
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290213,
					"content": "Похоже, произошло недопонимание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290214,
					"content": "Недопонимание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290215,
						760290216
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290215,
					"content": "Эта лира принадлежит нашей подруге...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				},
				{
					"id": 760290217,
					"content": "Да. Она не хочет никому навредить, просто у неё есть свои причины незаметно забирать лиру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290218,
					"content": "Правда? Вы меня не разыгрываете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290219
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290219,
					"content": "Если так, то я... я вам верю! Я починю её... лучше, чем обычно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290220
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290220,
					"content": "Подождите минутку, пока я закончу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290221
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290221,
					"content": "На Айно можно положиться, как всегда. Жаль, что таинственные посылки так её пугали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290222,
					"content": "Да, она должна получить заслуженное вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290223
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290223,
					"content": "Именн... А-а-а! Как ты здесь оказалась?! Ты нас напугала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290224,
					"content": "Я хотела дать вам кое-что, прежде чем уйти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290225
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290225,
					"content": "Хм? Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290226,
					"content": "«Сокровища», которые собрала куухенки. Она хотела поблагодарить мастера и подумала, что ей это понравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290227
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290227,
					"content": "Ого... Как много странных комплектующих. Конечно, мы их возьмём и передадим Айно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290228,
					"content": "Будь осторожна на обратном пути! Старайся, чтобы тебя никто не увидел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290229,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290230
					]
				},
				{
					"id": 760290230,
					"content": "Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290231
					]
				},
				{
					"id": 760290231,
					"content": "А? Что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290232,
					"content": "Там...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290233
					]
				},
				{
					"id": 760290233,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290234
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290234,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290235
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760290235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290236
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290236,
					"content": "...Сопоставление внешности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290237
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760290237,
					"content": "Сопоставление? С чем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290238,
					"content": "Сходство со статуей Богини Луны Нод-Края... 95%...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290239,
						760290241
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760290239,
					"content": "Она... актриса!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290240
					]
				},
				{
					"id": 760290240,
					"content": "#{NICKNAME}, сердцебиение учащается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760290243,
					"content": "Готово! Я всё починила! Я очень постаралась, так что больше ничего не должно сломаться! Кстати, о сла... О-о! Инеффа!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290244
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290244,
					"content": "Что ты не договорила, Айно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290245
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760290245,
					"content": "Э-э, сла... женно работают новые компоненты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290246
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290246,
					"content": "?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290247
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760290247,
					"content": "Хм? А кто это с вами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290248
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290248,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290249,
						760290250
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290249,
					"content": "Та, кому нужно было починить лиру!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290251,
					"content": "(Она кажется знакомой... Я её раньше видела? Ладно, неважно. Главное, мне кажется, я спрятала те угощения, которые принесла Паймон...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290252
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290252,
					"content": "Да, точно! Она также принесла эти компоненты, чтобы поблагодарить тебя за помощь в починке лиры, Айно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290253
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290253,
					"content": "Хм? Дайте посмотреть... Ого! Какие старые и редкие детали! Мне... можно их взять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290254
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290254,
					"content": "...Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290255
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290255,
					"content": "Спасибо, спасибо! Если понадобится что-нибудь починить, приходи ко мне - не стесняйся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290256
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290256,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290257
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760290257,
					"content": "Ну, тогда мы пойдём! Как-нибудь в другой раз поиграем, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290258
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290258,
					"content": "(Надо увести Субретку отсюда, а то Инеффа её точно узнает!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290259
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290259,
					"content": "Конечно! До встречи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290260
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290260,
					"content": "(Нужно быстро прибраться, а то Инеффа найдёт крошки!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290261
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290261,
					"content": "Принято к сведению. До скорой встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290262
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760290262,
					"content": "...Айно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290263
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760290263,
					"content": "Ч-что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290264
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290264,
					"content": "Хочешь сохранить эти компоненты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290265
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760290265,
					"content": "Зачем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290266
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290266,
					"content": "Кажется, это дары Богини Луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290267
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760290267,
					"content": "Что? Ты о чём? Позже я проверю твои схемы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айно"
				},
				{
					"id": 760290250,
					"content": "Наша застенчивая клиентка!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290241,
					"content": "А как насчёт, э-э, погрешности?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290242
					]
				},
				{
					"id": 760290242,
					"content": "Погрешность минимальна. Оценка: вывод точный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760290216,
					"content": "Она немного боится незнакомцев...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				}
			]
		},
