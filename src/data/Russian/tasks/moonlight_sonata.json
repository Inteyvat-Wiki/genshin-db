			"dialogs": [
				{
					"id": 760290101,
					"content": "Приветствую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290102,
					"content": "Что? Ты уходишь, Коломбина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290103,
					"content": "Да. Я собираюсь починить лиру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290104,
					"content": "...Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290105,
					"content": "Одна из лир куухенки сломалась. Лира ей очень дорога, поэтому я хочу починить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290106,
					"content": "Куухенки очень талантливы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290107,
					"content": "Бесспорно. Она часто выступает здесь, и я иногда подпеваю ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290108,
					"content": "Знаешь, Паймон уже давно думает, что ты определённо балуешь куухенки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290109,
					"content": "Всё это время они составляли мне компанию и часто приносили мне забавные предметы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290110,
					"content": "(Лаума говорила об этом - о естественном инстинкте куухенки радовать Богиню Луны.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "Если не возражаешь, у Паймон вопрос: как ты собираешься починить эту лиру? Ты говорила, что не хочешь, чтобы тебя видели другие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290112,
					"content": "Хм... Раньше я просила мелких животных или куухенки оставлять предметы, требующие ремонта, у порога мастера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290113,
					"content": "Обнаружив предмет, мастер часто ремонтировала его. Однако иногда это занимало несколько дней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290114,
					"content": "Кажется, не очень действенный метод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290115,
					"content": "Давай мы тебе поможем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290117,
					"content": "Не переживай. Кто знает, может, мы успеем всё сделать сегодня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290118,
					"content": "...Хорошо. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290119
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290119,
					"content": "Да ладно, не стоит благодарности! Кстати, кому ты обычно относишь вещи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760290120,
					"content": "Я не знаю её имени. Живёт она в круглом доме, похожем на раковину. Его легко узнать по механической руке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290121
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290121,
					"content": "(Это же...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290122
					]
				},
				{
					"id": 760290122,
					"content": "Изнутри часто доносится аромат крумкаке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290123
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760290123,
					"content": "Кажется, Паймон знает, кто нам нужен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
