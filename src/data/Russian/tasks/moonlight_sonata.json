			"dialogs": [
				{
					"id": 760290401,
					"content": "(Что? Музыка? Коломбина играет на лире для куухенки.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290402
					]
				},
				{
					"id": 760290402,
					"content": "(В прошлый раз, когда мы заглядывали к ней, лиру ещё не починили. Это было задолго до того, как Коломбина познакомилась со всеми...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290403
					]
				},
				{
					"id": 760290403,
					"content": "Незадолго до этого...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
