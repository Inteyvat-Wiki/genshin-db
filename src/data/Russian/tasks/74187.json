					}
				]
			},
			"dialogs": [
				{
					"id": 741870601,
					"content": "Кхе-кхе, солдаты Девятого легиона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741870602,
					"content": "А? Кто вы такие? Помощники Эста?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870603,
						741870605,
						741870607
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870603,
					"content": "Да, всё верно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870604
					]
				},
				{
					"id": 741870604,
					"content": "Мы не просто помощники! Мы могущественные помощники, прибывшие вместе с доминусом Кассиодором, чтобы служить и помогать ему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741870609,
					"content": "#(Похоже, {NICKNAME} и Паймон обладают врождённым актёрским талантом.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870610
					],
					"speakerTitle": "Осси"
				},
				{
					"id": 741870610,
					"content": "Доминус Кассиодор? Я слышал, что севаст отправил его в Ареморику. Он уже вернулся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870611
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870611,
					"content": "На самом деле рядом с нами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741870612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870613
					],
					"speakerTitle": "Осси"
				},
				{
					"id": 741870613,
					"content": "Кхм, в общем, мы пришли проверить обстановку легионов на передовой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741870614,
					"content": "Ладно, я так и думал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870615
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870615,
					"content": "Хотя мы и не пошли в форт Харибда вместе с основным отрядом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870616
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870616,
					"content": "Остаться здесь в качестве тыловой охраны, чтобы завершить «зачистку», тоже вполне логично, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870617
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870617,
					"content": "Это очередной приказ Фобоса?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870618
					]
				},
				{
					"id": 741870618,
					"content": "Как сказать... Фобос должен был руководить каждым нашим шагом, но с приходом сюда было много случаев, когда мы не могли услышать его мелодию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870619
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870619,
					"content": "В связи с этим мы следовали указаниям доминуса Боэция.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870620,
						741870623
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870620,
					"content": "Вот же грубиян...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870621
					]
				},
				{
					"id": 741870621,
					"content": "Кем ты себя возомнил?! Как ты смеешь говорить неуважительно о доминусе Боэции!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870622
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870622,
					"content": "Будучи уважаемым гармостом, доминус Боэций беспрекословно следует указаниям севаста. Его слово равнозначно слову самого Фобоса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870626,
					"content": "Фобос тоже может ошибаться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870627
					]
				},
				{
					"id": 741870627,
					"content": "Ха! Вы точно из Ремурии? Разве вы не знаете, что Фобос был создан всемогущим севастом и непогрешимым оракулом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870628,
					"content": "Но вы не слышите мелодию.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870629
					]
				},
				{
					"id": 741870629,
					"content": "Эм... это так. Но на что нам полагаться, если не на Фобоса?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870630
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870630,
					"content": "Он же не оставит нас в беде, если мы собьёмся с пути, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870623,
					"content": "Севаст не разрешал причинять вред невинным.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870624
					]
				},
				{
					"id": 741870624,
					"content": "Невинным? Да, он поручил нам помогать этим несчастным перед началом войны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870625
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870625,
					"content": "У наших действий молчаливое одобрение Фобоса. Могут ли его указы противоречить священному слову севаста?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870605,
					"content": "Мы особые посланники севаста.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870606
					]
				},
				{
					"id": 741870606,
					"content": "Что это за звание... Да, частично это так. Мы действительно с доминусом Кассиодором.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741870607,
					"content": "Мы слуги Кассиодора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870608
					]
				},
				{
					"id": 741870608,
					"content": "Да. Мы верные слуги доминуса Кассиодора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Паймон"
				}
			]
		},
