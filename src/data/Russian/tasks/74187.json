			"dialogs": [
				{
					"id": 741870701,
					"content": "Хорошо... Всё верно. Нам нужно переосмыслить наши действия. Я... честно говоря, не понимаю, как дошло до такого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870702
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870702,
					"content": "С начала этой войны в моём сердце поселилось странное чувство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870703
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870703,
					"content": "Мы стремились к свободе и счастью, но из-за Фобоса мы оказались здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870704
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870704,
					"content": "Что же пошло не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870705
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870705,
					"content": "Если встретите севаста, расскажите ему о нашем положении и сомнениях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870706
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870706,
					"content": "Мы будем очень благодарны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870707
					],
					"speakerTitle": "Лидер"
				},
				{
					"id": 741870707,
					"content": "Конечно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
