			"dialogs": [
				{
					"id": 741870901,
					"content": "Кажется, вы решили нашу проблему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870902
					],
					"speakerTitle": "Эст"
				},
				{
					"id": 741870902,
					"content": "Значит, теперь у вас новая цель?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870903
					],
					"speakerTitle": "Эст"
				},
				{
					"id": 741870903,
					"content": "Да. Позаботься об этом месте, Эст...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870904
					],
					"speakerTitle": "Осси"
				},
				{
					"id": 741870904,
					"content": "И помни, слушай своё сердце, а не Фобоса или гармостов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870905
					],
					"speakerTitle": "Осси"
				},
				{
					"id": 741870905,
					"content": "Севаст создал Фобоса, чтобы избавить нас от оков судьбы, но слепая вера людей погрузила нас в ещё более ужасное рабство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870906
					],
					"speakerTitle": "Осси"
				},
				{
					"id": 741870906,
					"content": "Возможно, в будущем тебя ждёт похожий выбор. Надеюсь, когда придёт время, ты не ошибёшься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870907
					],
					"speakerTitle": "Осси"
				},
				{
					"id": 741870907,
					"content": "Доминус Кассиодор, почему вы вдруг заговорили об этом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870908
					],
					"speakerTitle": "Эст"
				},
				{
					"id": 741870908,
					"content": "Но я запомню ваши слова. Я, Эст, буду придерживаться своего чувства справедливости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870909
					],
					"speakerTitle": "Эст"
				},
				{
					"id": 741870909,
					"content": "Отлично. До встречи, Эст. Уверен, мы ещё встретимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осси"
				}
			]
