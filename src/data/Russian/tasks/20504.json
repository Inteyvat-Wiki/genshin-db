				"points": []
			},
			"dialogs": [
				{
					"id": 205040301,
					"content": "В Мондштадте <color=#00E1FFFF>печати Анемо</color> можно найти повсюду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040302
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040302,
					"content": "Они правда нужны тебе только для украшения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040303
					]
				},
				{
					"id": 205040303,
					"content": "Конечно! Что может быть красивее подарка от Анемо Архонта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 205040304,
					"content": "Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040305
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040305,
					"content": "На самом деле, всё немного сложнее. Но давай договоримся, что они для украшения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040306
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040306,
					"content": "Конечно же, меня интересуют сверхъестественные свойства <color=#00E1FFFF>печатей Анемо</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040307,
						205040309
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040307,
					"content": "Можно будет посмотреть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040308
					]
				},
				{
					"id": 205040308,
					"content": "Конечно! Готова поспорить, ты удивишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040312,
					"content": "Заходи ещё и приноси побольше <color=#00E1FFFF>печатей Анемо</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040313
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040313,
					"content": "Если найдёшь какие-нибудь крутые и странные сокровища, то помни, что их тоже можно обменять на товары в моей лавке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040309,
					"content": "#Я уверен{F#а}, что ты преувеличиваешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040310
					]
				},
				{
					"id": 205040310,
					"content": "Как интересно! Я очень хочу посмотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 205040311,
					"content": "Ха-ха-ха! Подожди, пока я закончу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Марджори"
				}
			]
		}
	]
}