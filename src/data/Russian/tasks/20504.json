				"points": []
			},
			"dialogs": [
				{
					"id": 205040101,
					"content": "Добро пожаловать! Каждое сокровище здесь единственное в своем роде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040102
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040102,
					"content": "Да... Я никогда раньше таких не видела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 205040103,
					"content": "Всё это я нашла во время приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040104
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040104,
					"content": "Что-нибудь привлекло твоё внимание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040105,
						205040106
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040105,
					"content": "Всё такое интересное.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				},
				{
					"id": 205040107,
					"content": "Мора здесь не в ходу. Я меняю трофеи на другие трофеи. Только честный бартер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040108
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040108,
					"content": "Сейчас я работаю над одним необычным проектом. Хочу украсить его <color=#00E1FFFF>печатями Анемо</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040109
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040109,
					"content": "У тебя есть <color=#00E1FFFF>печати Анемо</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040110,
						205040112
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040110,
					"content": "Есть несколько.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040111
					]
				},
				{
					"id": 205040111,
					"content": "Ха-ха-ха! Значит Анемо Архонт присматривает за тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040114,
					"content": "В моей лавке ты можешь поменять <color=#00E1FFFF>печати Анемо</color> на разные товары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040115
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040115,
					"content": "Изучить товары.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205040112,
					"content": "А что это?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040113
					]
				},
				{
					"id": 205040113,
					"content": "Это знаки отличия, которыми Анемо Архонт награждает искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 205040106,
					"content": "Боюсь представить, сколько всё это стоит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				}
			]
		},
		{
			"id": 2050403,
