							3944.917
						],
						"pointId": 6694
					}
				]
			},
			"dialogs": [
				{
					"id": 240160101,
					"content": "Так, тут закончила... Надеюсь, эти материалы и правда пригодятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160102,
					"content": "Ты всё ещё разбираешь дела?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "#Ах! Это вы, {M#почётный старший исследователь}{F#почётная старшая исследовательница}, какая честь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160104,
					"content": "Вы правы! Я продолжаю упорядочивать материалы и документы в соответствии с указаниями месье Раймондо. Постойте, я ведь уже говорила об этом прежде?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160105,
					"content": "Но это место такое огромное! Для одного человека тут слишком много работы. Почему Раймондо не назначил кого-нибудь тебе в помощь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240160106,
					"content": "У Исследовательского института много неотложных дел. Это нормально, что никто сейчас не может мне помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160107,
					"content": "Ты ведь и сама руководительница...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "Вы имеете в виду мою должность руководителя Отдела сбора документации в Исследовательском институте Фонтейна? Ох, не смейтесь надо мной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160109,
					"content": "Какой из меня руководитель? С самого начала я была всего лишь рядовой сотрудницей, отвечающей за разбор документов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160110,
					"content": "Мне сообщили о новой должности, после того как месье Раймондо назначил меня сюда на разбор архива.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160111,
					"content": "Кто-то говорил, что это идея месье Шуазёля. Наверное, он думает, что это облегчит нам получение финансовой компенсации за утомительную работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160112,
					"content": "Ох, только никому не рассказывайте! Как я могла вот так высказать это вслух?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160113,
					"content": "Не переживай, я не из болтливых.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "Звучит обнадёживающе! Да и, в конце концов, справедливо, что те, кто делает всю работу, должны получать большее вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240160115,
					"content": "Но зачем все эти хитрости? Они что, не могут просто дать всем побольше моры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240160116,
					"content": "В Исследовательском институте это обычное дело.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "Ох... Мне никогда не понять, как мыслят месье Раймондо и Шуазёль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160119,
					"content": "Но что бы там ни было, я должна продолжать работать! Слишком много всего нужно сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160120,
					"content": "#{M#Почётный старший исследователь}{F#Почётная старшая исследовательница}, может, вы найдёте время мне помочь? Если желаете, конечно же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160121,
					"content": "Это мой долг.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "Тогда, пожалуйста, помогите мне очистить это место от грязи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160125,
					"content": "Постарайтесь <color=#00E1FFFF>не трогать книги и документы вокруг</color>. Было бы ужасно обидно повредить их при уборке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160126,
					"content": "Тогда это я оставляю на вас! А я продолжу приводить в порядок документы. Ох, я и не замечала раньше, сколько их в Институте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160122,
					"content": "#Так я сделаюсь ещё более {M#почётным исследователем}{F#почётной исследовательницей}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "Ха-ха-ха, вот уж с этим проблем не будет! Я всем расскажу о вашей доброте и вкладе в общее дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160117,
					"content": "Но лишь бы в итоге можно было получить свою мору.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
		{
