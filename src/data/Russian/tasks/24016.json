				"points": []
			},
			"dialogs": [
				{
					"id": 240160301,
					"content": "Фух... Спасибо за помощь. Если бы не вы, кто знает, сколько бы времени у меня на это ушло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160302
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160302,
					"content": "#Вы по праву носите звание {M#почётного старшего исследователя}{F#почётной старшей исследовательницы}. За что ни возьмётесь - всё делаете хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160303,
						240160304
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160303,
					"content": "#Я с рождения {M#экстраординарен}{F#экстраординарна}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160306
					]
				},
				{
					"id": 240160306,
					"content": "#Должна ещё раз поблагодарить вас за помощь, {M#почётный старший исследователь}{F#почётная старшая исследовательница}. Прошу, возьмите вот это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160304,
					"content": "У меня есть кое-какой опыт в уборке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160305
					]
				},
				{
					"id": 240160305,
					"content": "#Вот как? Значит, вы и правда наделены многими талантами - {M#настоящий почётный старший исследователь}{F#настоящая почётная старшая исследовательница}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160306
					],
					"speakerTitle": "Шалме"
				}
			]
		},
		{
			"id": 2401604,
