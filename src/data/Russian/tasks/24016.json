			"dialogs": [
				{
					"id": 240160401,
					"content": "Фух... Спасибо за помощь. Если бы не вы, кто знает, сколько бы времени у меня на это ушло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160402
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160402,
					"content": "Хотя было бы ещё лучше, если бы вы убирались чуть аккуратнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160403,
						240160404
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160403,
					"content": "Мне очень жаль...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				},
				{
					"id": 240160405,
					"content": "Не поймите меня неправильно! Я вовсе не виню вас, напротив, вы оказали мне огромную услугу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160406
					],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160406,
					"content": "#Это вам. Спасибо за помощь, {M#почётный старший исследователь}{F#почётная старшая исследовательница}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шалме"
				},
				{
					"id": 240160404,
					"content": "В следующий раз не буду так налегать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				}
			]
		}
	]
}