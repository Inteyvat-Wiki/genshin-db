				"points": []
			},
			"dialogs": [
				{
					"id": 191079701,
					"content": "Эльзер, а не слишком ли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079702
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 191079702,
					"content": "Коннор, самое главное сейчас, чтобы Диона почувствовала нашу искренность, понимаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079703
					],
					"speakerTitle": "Эльзер"
				},
				{
					"id": 191079703,
					"content": "Да, Эльзер, я понимаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Коннор"
				}
			]
		},
		{
			"id": 1910798,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
