			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эльзер",
					"Коннор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191079801,
					"content": "Коннор, ты отлично справляешься. Продолжай в том же духе, и мы определённо уговорим Диону стать барменом на винокурне «Рассвет»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079802
					],
					"speakerTitle": "Эльзер"
				},
				{
					"id": 191079802,
					"content": "Надеюсь, что это действительно сработает. Я ждал несколько недель и не упущу эту возможность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079803
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 191079803,
					"content": "Большое спасибо, Коннор! Ты молодец! Теперь надо уговорить Диону приехать к нам, и тогда наши усилия не пропадут даром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079804
					],
					"speakerTitle": "Эльзер"
				},
				{
					"id": 191079804,
					"content": "Самое главное - дать Дионе почувствовать нашу искренность и энтузиазм! Но нельзя быть слишком настойчивыми...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079805
					],
					"speakerTitle": "Эльзер"
				},
				{
					"id": 191079805,
					"content": "Эльзер, мы репетировали много раз. В этот раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079806
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 191079806,
					"content": "О чём вы говорите?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191079807
					]
				},
				{
					"id": 191079807,
					"content": "Нет-нет, ни о чём. Мы... Обсуждаем винодельческий бизнес...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079808
					],
					"speakerTitle": "Эльзер"
				},
				{
					"id": 191079808,
					"content": "Да... Мы обсуждаем винодельческий бизнес. Эльзер, давай ещё раз обсудим недавние расходы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Коннор"
				}
			]
		},
