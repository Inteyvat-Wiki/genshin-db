			"dialogs": [
				{
					"id": 3090201,
					"content": "Фух! Наконец-то мы со всем закончили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090202,
					"content": "Будем надеяться, что теперь поток стихий в Мондштадте восстановлен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090203,
					"content": "Вернёмся к <color=#00E1FFFF>рыцарям Ордо Фавониус</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090204,
					"content": "#Но если ты придумал{F#а} что-то поинтереснее, то, конечно же, я пойду с тобой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090205,
					"content": "Как сходить за покупками... или получить благословение у <color=#00E1FFFF>статуи семи Архонтов</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090206,
					"content": "В одном из храмов Хранителей четырёх ветров мы нашли что-то похожее на... затвердевший ветер, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090207,
					"content": "В Мондштадте такие штуки называют анемокулами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090208,
					"content": "Это глаза статуи Анемо Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090209,
					"content": "Рассказывают, что ласточки выклевали глаза у статуй и разнесли их по всему континенту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090210,
					"content": "Но, на самом деле, у статуй никогда не было глаз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090212,
					"content": "Те, у кого есть Глаз Бога, могут совершать подношения <color=#00E1FFFF>статуям семи Архонтов</color> и получать благословения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090213,
					"content": "У тебя нет Глаза Бога, но возможно, что и это правило нашего мира не применимо к тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090214,
					"content": "Давай пойдём и проверим прямо сейчас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090215,
					"content": "Долина Ветров к нам ближе всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3090216,
					"content": "Мне не терпится посмотреть, что Архонты сделают с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
