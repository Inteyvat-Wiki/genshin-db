							375.311,
							9961.593
						],
						"pointId": 361100061
					}
				]
			},
			"dialogs": [
				{
					"id": 761011301,
					"content": "Врата в демоническое небо открыты, никакая куувяки меня не остановит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011302
					],
					"speakerTitle": "Профессор"
				},
				{
					"id": 761011302,
					"content": "Но почему я застрял здесь?.. Понимаю, Мельница САМПО снова меня отвергла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011303
					],
					"speakerTitle": "Профессор"
				},
				{
					"id": 761011303,
					"content": "Гляньте-ка, кто пришёл! Какой редкий гость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011304
					],
					"speakerTitle": "Алия"
				},
				{
					"id": 761011304,
					"content": "...Кто здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011305
					],
					"speakerTitle": "Профессор"
				},
				{
					"id": 761011305,
					"content": "Это... Это ты, Реля? Как хорошо. Приятно знать, что ты жив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011306
					],
					"speakerTitle": "Профессор"
				},
				{
					"id": 761011306,
					"content": "А теперь подчини силу Мельницы САМПО моей воле! Ты сможешь, ведь в твоих жилах течёт кровь священного наследника. Ты мой самый любимый ученик, не то что те ничтожества...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011307
					],
					"speakerTitle": "Профессор"
				},
				{
					"id": 761011307,
					"content": "Ха, он принял меня за Релю... Забавно... Бойкий на язык юродивый старец теперь не видит дальше собственного носа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011308
					],
					"speakerTitle": "Алия"
				},
				{
					"id": 761011308,
					"content": "Не сомневайся, Реля. Неужели ты забыл о наших общих идеалах? Неужели не хочешь вернуть себе имя и положение, которые принадлежат тебе по праву?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011309
					],
					"speakerTitle": "Профессор"
				},
				{
					"id": 761011309,
					"content": "Представь: мы создадим рай для униженных и оскорблённых, где гордые альвы-аристократы преклонят перед тобою колени. Во всём дворе Бледной звезды только я готов тебе помочь, ведь я тоже человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011310
					],
					"speakerTitle": "Профессор"
				},
				{
					"id": 761011310,
					"content": "Я всего в одном шаге от восхождения к звёздам... Когда занебесный Рай спустится на землю, выживут лишь избранные, такие как мы с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011311
					],
					"speakerTitle": "Профессор"
				},
				{
					"id": 761011311,
					"content": "И тогда порок и гниль будут смыты чистой волной. Неужели не этого мира ты жаждешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011312
					],
					"speakerTitle": "Профессор"
				},
				{
					"id": 761011312,
					"content": "Нет. Мир, который ты рисуешь, никогда не был его мечтой... Неужели даже в такой момент ты продолжаешь плести свою ложь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011313
					],
					"speakerTitle": "Алия"
				},
				{
					"id": 761011313,
					"content": "С самого начала ты использовал его, все твои посулы были лишь для того, чтобы он добыл для тебя Мельницу САМПО. А Рай, о котором ты твердил, предназначался только для тебя одного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011314
					],
					"speakerTitle": "Алия"
				},
				{
					"id": 761011314,
					"content": "Даже то, что он лишился офицерского звания и стал вором, было частью ловушки, которую вы устроили вместе с герцогом Альвисом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011315
					],
					"speakerTitle": "Алия"
				},
				{
					"id": 761011315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011316
					],
					"speakerTitle": "Профессор"
				},
				{
					"id": 761011316,
					"content": "Ты обознался, но я, унаследовавшая его личность и волю, не стану отказываться от имени Рида Миллера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011317
					],
					"speakerTitle": "Алия"
				},
				{
					"id": 761011317,
					"content": "Раутванги, юродивый старец, Профессор, Бессмертный змей... Позволь мне поставить точку в твоей истории. Во имя Рида Миллера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011318
					],
					"speakerTitle": "Алия"
				},
				{
					"id": 761011318,
					"content": "У нас получилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011319
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761011319,
					"content": "Наконец-то мы окончательно упокоили этого бессмертного демона!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011320
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761011320,
					"content": "«Бессмертный змей восстанет дважды и трижды будет поражён... пока героями подлунного мира не будет навсегда погребён...»\\nПлечом к плечу с доблестными ратниками мы наконец уничтожили Профессора.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761011321
					]
				},
				{
					"id": 761011321,
					"content": "После этого вы провели несколько дней в Пирамиде...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}