			"dialogs": [
				{
					"id": 761010201,
					"content": "Иллуги! Наконец-то ты вернулся! Старшина Никита ждёт тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010202
					],
					"speakerTitle": "Олаф"
				},
				{
					"id": 761010202,
					"content": "А? Старшина... Никита?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761010203,
					"content": "#{NICKNAME}, разве Никита - это не тот дедушка, который поручил нам найти Серебряный фитиль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761010204,
					"content": "Паймон помнит, как он назвал себя обычным ратником...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010205,
						761010206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761010205,
					"content": "И правда...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				},
				{
					"id": 761010207,
					"content": "Вот старик даёт! Эх, считайте, что он пошутил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010208
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761010208,
					"content": "Но оставим это. Сейчас нам нужно доложить ему о ситуации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761010206,
					"content": "Нет, он совсем не похож на обычного ратника.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				}
			]
		},
