			"dialogs": [
				{
					"id": 761010101,
					"content": "#{NICKNAME}! Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010102
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761010102,
					"content": "Хе-хе, а вот и мы! Как тут оживлённо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761010103,
					"content": "За последнее время все здорово устали, и наконец, когда последствия почти устранены, у нас появилось время попировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010104
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761010104,
					"content": "Ты тоже потрудился на славу!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010105
					]
				},
				{
					"id": 761010105,
					"content": "На самом деле, я не сделал ничего особенного. И потом, если бы не ваша помощь, даже в случае победы, боюсь, нам бы пришлось заплатить куда более высокую цену...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010106
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761010106,
					"content": "Мы же твои соратники! Все свои.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761010107,
					"content": "Да, ты права. О, старик готов выступать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010108
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761010108,
					"content": "Товарищи по оружию, братья и сёстры, сегодня мы собрались здесь не просто для празднования, а чтобы отметить эту доставшуюся нам нелёгкой ценой победу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010109
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010109,
					"content": "Поднимая кружки, вспомним о тех, кто уже никогда не сможет поднять их вместе с нами, - тех, кто ценой своей крови и плоти исполнил данную клятву.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010110
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010110,
					"content": "В этой битве исследовательский отряд «Соловьи Ночного Кошмара» под командованием Иллуги взял на себя самую сложную задачу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010111
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010111,
					"content": "#Особенное спасибо вам, {NICKNAME} и Паймон. Несмотря на опасность, вы без колебаний присоединились к нам и сыграли неоценимую роль в операции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010112
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010112,
					"content": "Они бесстрашно шли на жертвы, смело встречали трудности и проложили нам путь к победе через опасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010113
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010113,
					"content": "Их подвиги, как и подвиги всех тех, кто боролся за живых и за будущее, навсегда останутся в истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010114
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010114,
					"content": "Да, мы победили! Несмотря на огромную цену. Мы можем плакать, можем скорбеть, но не должны позволить горю сломить нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010115
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010115,
					"content": "Потому что будущее, за которое мы боролись, вот-вот наступит. И чтобы передать искру жизни, чтобы путеводный свет продолжал сиять, мы не должны опускать руки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010116
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010116,
					"content": "Но сегодня давайте выпьем за победу, за наших храбрых и бессмертных товарищей и за будущее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Никита"
				}
			]
		},
