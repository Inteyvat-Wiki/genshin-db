			"dialogs": [
				{
					"id": 761010301,
					"content": "Старик, мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010302
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761010302,
					"content": "С возвращением! Как обстановка на скале Кипумаки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010303
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010303,
					"content": "Вы кратко описываете ситуацию...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761010304
					]
				},
				{
					"id": 761010304,
					"content": "Вот оно что... Теперь понятно, что Столб Эмблы оказался под влиянием Бездны... и бессмертного демона, которого называют Профессором.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010305
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010305,
					"content": "Но пока он не проявляет особой активности. Видимо, госпожа Алия изо всех сил сдерживает его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010306
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010306,
					"content": "Мы не можем тратить ни секунды драгоценного времени, которое она выиграла для нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010307
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010307,
					"content": "К счастью, благодаря помощи Флинса и остальных, подготовительная работа почти завершена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010308
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010308,
					"content": "Вы принесли Спиральный меч, Стрела Терпикераунаса наконец обрела форму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010309
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010309,
					"content": "Э-э... А что такое Стрела Терпикераунаса? Это такая же могущественная реликвия, как Серебряный фитиль и Спиральный меч?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761010310,
					"content": "Ха-ха, это нечто гораздо более могущественное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010311
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010311,
					"content": "Пятьсот лет назад Литейщик факелов не смог полностью уничтожить бессмертного демона и лишь запечатал его под скалой Кипумаки. Но после этого ни Литейщик факелов, ни первый Голос Лунного Гимна не сдались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010312
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010312,
					"content": "Чтобы однажды окончательно уничтожить его, используя древние технологии, они создали лук и стрелы, и мы, Светоносцы, передавали их из поколения в поколение вплоть до сегодняшнего дня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010313
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010313,
					"content": "И теперь настал момент исполнить предназначение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010314
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010314,
					"content": "О-о... Оказывается, существует такая могущественная стрела! Паймон так интересно! А как она выглядит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761010315,
					"content": "Глупышка, вы уже давно видите её! Точнее сказать, мы находимся внутри Стрелы Терпикераунаса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010316,
						761010318
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010316,
					"content": "Что?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010317
					]
				},
				{
					"id": 761010317,
					"content": "Н-неужели нас собираются запустить в... Это же невозможно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761010320,
					"content": "Этот Медовый зал был построен вокруг Стрелы Терпикераунаса, а Спиральный меч, который вы принесли, является её недостающим наконечником.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010321
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010321,
					"content": "Как только мы вставим Спиральный меч сюда, Стрела Терпикераунаса будет готова к запуску.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010322
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010322,
					"content": "Но разве это не камин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761010323,
					"content": "Да, камин, а также специальное устройство, превращающее Спиральный меч в наконечник Стрелы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010324
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761010324,
					"content": "Пока Яйцо бедствия не вылупилось... пора покончить с ним раз и навсегда, воспользовавшись луком и стрелой, что хранились много веков!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010325
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010325,
					"content": "Бессмертный демон будет отчаянно сопротивляться, но сколько бы приспешников он ни послал, мы оградим вас от них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010326
					],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010326,
					"content": "Запуск Стрелы Терпикераунаса возлагается на вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Никита"
				},
				{
					"id": 761010318,
					"content": "Вы и меня запустите?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010319
					]
				},
				{
					"id": 761010319,
					"content": "#Так значит {NICKNAME} - наше секретное оружие для финальной битвы?! Да ну, не может быть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Паймон"
				}
			]
		},
