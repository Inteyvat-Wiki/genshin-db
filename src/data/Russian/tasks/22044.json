			"trigger": {
				"objectNames": [
					"Осима Дзюмпэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220440101,
					"content": "#{NICKNAME}, что ты здесь делаешь? {F#Пришла}{M#Пришёл} помолиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440102
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440102,
					"content": "Как обстоят дела с резьбой по дереву?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440103
					]
				},
				{
					"id": 220440103,
					"content": "О, я бы сказал, что у меня всё хорошо. Хотя мне ещё нужно поработать над размерами резьбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440104
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440104,
					"content": "Согласно моей первоначальной идее, статуэтки должны помещаться в руке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440105
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440105,
					"content": "Таким образом с ними будет удобно играть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440106
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440106,
					"content": "Кроме того, я думаю, что мне следует сделать какие-нибудь украшения, помимо самой резьбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440107
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440107,
					"content": "Я видел, что когда делают такую резьбу, также добавляют украшения по бокам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440108
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440108,
					"content": "Такие, как цветы, животные, основания с цветочными орнаментами и тому подобное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440109
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440109,
					"content": "Я бы тоже хотел сделать такие декоративные основы для своих статуэток. Однако из-за проблем с размерами на одной статуэтке я могу разместить только одно украшение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440110
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440110,
					"content": "Но я думаю, что если украшения будут съёмными, я смогу поставить те основы, которые попросят мои клиенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440111
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440111,
					"content": "Я хочу начать с простых орнаментов. Например, с травы наку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440112
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440112,
					"content": "#{NICKNAME}, ты не принесешь мне три пучка травы наку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440113,
						220440114
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440113,
					"content": "Не вопрос.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440117
					]
				},
				{
					"id": 220440117,
					"content": "#Я рассчитываю на тебя, {NICKNAME}. Принеси мне траву наку. Я буду ждать тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440114,
					"content": "Почему именно три?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440115
					]
				},
				{
					"id": 220440115,
					"content": "Это позволит мне наблюдать траву наку в трёх разных состояниях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440116
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440116,
					"content": "И я смогу вырезать самую лучшую траву наку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440117
					],
					"speakerTitle": "Осима Дзюмпэй"
				}
			]
		},
