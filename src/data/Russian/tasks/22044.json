			"dialogs": [
				{
					"id": 220440301,
					"content": "Этого достаточно. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440302
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440302,
					"content": "Теперь пришло время провести небольшое исследование. Как же мне вырезать статуэтку в форме травы наку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440303
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440303,
					"content": "Если я сделаю много красивых разнообразных украшений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440304
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220440304,
					"content": "Возможно, мне удастся продать их отдельно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осима Дзюмпэй"
				}
			]
		}
