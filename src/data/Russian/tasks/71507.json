			"dialogs": [
				{
					"id": 715070101,
					"content": "Получилось лучше, чем я представлял. Все данные внесены в журнал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070102
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715070102,
					"content": "А главное - удалось очистить всё от чёрной грязи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070103
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715070103,
					"content": "Вот только...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070104
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715070104,
					"content": "Почему ты выглядишь недовольным? Разве плохо, что шахта теперь чиста?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 715070105,
					"content": "Дай подумать, ранее мы с Хедивом предполагали, что местом выхода чёрной грязи из артерий земли является шахта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070106
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715070106,
					"content": "Нельзя так просто очистить выход из артерий земли. Значит, выход находится где-то в другом месте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070107
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715070107,
					"content": "Разлив чёрной грязи оказал влияние не только на шахту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070108
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715070108,
					"content": "... но и на штольни.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715070109
					]
				},
				{
					"id": 715070109,
					"content": "Да... Это показывает, что выход чёрной грязи из артерий земли находится в районе штолен. Они узкие, чёрная грязь там легко скапливается, привлекая монстров и создавая куда более серьёзные проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070110
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715070110,
					"content": "Но я верю в шип Пурсины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070111
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715070111,
					"content": "Госпожа Пурсина создала действительно великий прибор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070112
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715070112,
					"content": "Но сначала я должен проверить и настроить его, а затем шахтёры доставят шип в штольню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуссени"
				}
			]
		}
	]
}