			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340201,
					"content": "А? На что ты смотришь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340202,
					"content": "В блокноте записаны способы ухода за цветами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340203
					]
				},
				{
					"id": 730340203,
					"content": "Правда? Дай посмотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340204,
					"content": "«Разместить на открытом пространстве, где много солнца...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340205,
					"content": "Скорее всего, Коллеи не успела убрать его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340206,
					"content": "Хе-хе, давай поможем ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340207,
					"content": "Хм... В любом случае, сначала надо переставить цветок. Давай поставим его рядом с домом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340208,
					"content": "Не надо ставить его слишком далеко, иначе Коллеи не найдёт горшок и будет переживать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7303406,
			"completionStepIds": [
				7303406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303406",
							"2"
						],
						"stepId": 7303406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340601,
					"content": "Хм, это письмо, похоже, оставила Коллеи. Давай проверим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340602,
					"content": "Но почему она ещё не вернулась...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340603
					]
				},
				{
					"id": 730340603,
					"content": "Возможно, она занята с Тигнари. Они всё время над чем-то работают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340604,
					"content": "Давай скорее прочтём письмо. Судя по почерку, Коллеи писала с усилием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340605,
					"content": "#«{NICKNAME}, Паймон, спасибо, что позаботились о цветке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340606,
					"content": "У меня так много дел в лесу, что я совсем забыла о нём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340607,
					"content": "Ещё раз спасибо. Как только освобожусь, я обязательно приглашу вас в ресторанчик Джахангира на картофельную лодочку!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340608,
					"content": "Ух, Коллеи хочет угостить нас чем-то вкусненьким. Надо запомнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340609,
					"content": "Не знаю, чем там Коллеи занимается, но, похоже, она очень занята.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730340610,
					"content": "Надеюсь, она не переутомится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}