			"dialogs": [
				{
					"id": 732750102,
					"content": "Семена проросли и превратились в саженцы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750103
					]
				},
				{
					"id": 732750103,
					"content": "О... Где тебе удалось достать семена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750104
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732750104,
					"content": "Очень далеко отсюда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750105
					]
				},
				{
					"id": 732750105,
					"content": "Семена, которые посеял дядюшка Шафакат, разнеслись по всей пустыне, но в итоге их всё равно принесло сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750107
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732750107,
					"content": "Эти саженцы требуют особого ухода. Я намерен оставить их Саббах. Когда меня не станет, эти цветы станут её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750108
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732750108,
					"content": "Спасибо тебе, дитя! Мне нечего дать тебе взамен, кроме этих плодов и цветов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аффан"
				}
			]
		},
