				"points": []
			},
			"dialogs": [
				{
					"id": 732750501,
					"content": "Расскажи о песне...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750502
					]
				},
				{
					"id": 732750502,
					"content": "Ты помнишь ту песню... О, ещё кто-то из молодёжи её знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750503
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732750503,
					"content": "«О, роза-роза, желанье исполни. Роза златая из камня росла и пела мне песни».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750504
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732750504,
					"content": "«Песни мне дали сил для рожденья. Песни одни лишь превыше судьбы и удела».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750505
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732750505,
					"content": "«Победят меня, победят время и вечное увядание жизни...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аффан"
				}
			]
		},
