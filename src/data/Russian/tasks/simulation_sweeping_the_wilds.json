				"points": []
			},
			"dialogs": [
				{
					"id": 745040101,
					"content": "О, вам так не терпится приступить к работе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040102
					],
					"speakerTitle": "Альберре"
				},
				{
					"id": 745040102,
					"content": "Если позволите высказать своё мнение, то у этого проекта нет будущего. Лучше уж сразу идите в Часовую мастерскую Лепота и повеселитесь там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040103
					],
					"speakerTitle": "Альберре"
				},
				{
					"id": 745040103,
					"content": "Вау! Неужели ты способен на честность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745040104,
					"content": "Тсс! Тише! Если кто-нибудь услышит, то примет меня за вражеского шпиона!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040105
					],
					"speakerTitle": "Альберре"
				},
				{
					"id": 745040105,
					"content": "Ха-ха, давайте сменим тему. Я здесь работаю, так что поговорим о работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040106
					],
					"speakerTitle": "Альберре"
				},
				{
					"id": 745040106,
					"content": "Позвольте сразу оговориться, что сбор данных будет разделён на две части. Одной будет руководить Арбон, а другой - я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040107
					],
					"speakerTitle": "Альберре"
				},
				{
					"id": 745040107,
					"content": "С моей стороны требуется смоделировать силу судебного дуэлянта, поэтому нужно, чтобы вы совершили несколько боевых подвигов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040108
					],
					"speakerTitle": "Альберре"
				},
				{
					"id": 745040108,
					"content": "Мы нашли места, где часто встречаются монстры, и установили поблизости устройства для сбора данных. Вам нужно отправиться туда и расправиться с врагами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040109
					],
					"speakerTitle": "Альберре"
				},
				{
					"id": 745040109,
					"content": "Я отметил точные места на вашей карте. Что касается других важных моментов, они записаны в этой памятке. Можете ознакомиться на досуге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040110
					],
					"speakerTitle": "Альберре"
				},
				{
					"id": 745040110,
					"content": "Итак, у вас есть вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040111
					],
					"speakerTitle": "Альберре"
				},
				{
					"id": 745040111,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745040112
					]
				},
				{
					"id": 745040112,
					"content": "В таком случае надеюсь, что процесс сбора данных пройдёт удачно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альберре"
				}
			]
		}
	]
}