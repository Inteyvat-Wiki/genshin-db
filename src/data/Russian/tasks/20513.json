			"dialogs": [
				{
					"id": 205130301,
					"content": "#Ну как, наш{F#ла}{M#ёл}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130302
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130302,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130303
					]
				},
				{
					"id": 205130303,
					"content": "Ого, эта ветряная астра и впрямь необычная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130304
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130304,
					"content": "Не знаю почему, но мне кажется, что от этого лекарства Анне станет намного лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130305
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130305,
					"content": "Анна идёт на поправку, и, наверное, поэтому у меня отличное настроение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130306
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130306,
					"content": "Спасибо тебе большое. Вот, прими в награду за свои труды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130307
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130307,
					"content": "Надеюсь, Анна выздоровеет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130308
					]
				},
				{
					"id": 205130308,
					"content": "Спасибо. Она обязательно выздоровеет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130309
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130309,
					"content": "Я никогда не терял надежды.",
					"roleType": "TALK_ROLE_NPC",
