				"points": []
			},
			"dialogs": [
				{
					"id": 205130101,
					"content": "Этот кажется вполне нормальным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130102
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130102,
					"content": "У тебя всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130103
					]
				},
				{
					"id": 205130103,
					"content": "Да. Я было не на шутку перепугался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130104
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130104,
					"content": "Анна с каждым днём идёт на поправку. Слух о искусном целителе оказался правдой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130105
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130105,
					"content": "Как насчёт того, чтобы достать другие ингредиенты? Теперь нам нужны ветряные астры, овеянные Анемо слаймом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130106,
						205130111,
						205130115
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130106,
					"content": "На лекарство это непохоже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130107
					]
				},
				{
					"id": 205130107,
					"content": "Ну, из ветряных астр иногда готовят снадобья, но лечат ими только лёгкие недомогания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130108
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130108,
					"content": "Возможно, дело в Анемо слаймах, но ветряные астры обычно их не интересуют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130109
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130109,
					"content": "К счастью, Джек несколько раз собственными глазами видел, как слайм дул на астру. Самое близкое из мест, где это случилось, я отмечу на твоей карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130110
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130110,
					"content": "Анемо слаймы умеют летать, и мне ни за что с ними не справиться. Поэтому я вынужден просить тебя об одолжении...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130111,
					"content": "Это так... по-мондштадтски.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130112
					]
				},
				{
					"id": 205130112,
					"content": "Не спорю. Но ветряные астры Анемо слаймов интересуют мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130113
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130113,
					"content": "К счастью, Джек несколько раз собственными глазами видел, как слайм дул на астру. Самое близкое из мест, где это случилось, я отмечу на твоей карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130114
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130114,
					"content": "Анемо слаймы умеют летать, и мне правда ни за что с ними не справиться. Поэтому я вынужден просить тебя об одолжении...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130115,
					"content": "Почему бы мне не поймать Анемо слайма и принести его тебе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130116
					]
				},
				{
					"id": 205130116,
					"content": "Тебе хочется выставить меня на посмешище, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130117
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130117,
					"content": "Тем не менее ветряные астры Анемо слаймов интересуют мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130118
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130118,
					"content": "К счастью, Джек несколько раз собственными глазами видел, как слайм дул на астру. Самое близкое из мест, где это случилось, я отмечу на твоей карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130119
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205130119,
					"content": "Ну а если не найдёшь, тащи Анемо слайма сюда. Я ради Анны пойду на что угодно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		},
