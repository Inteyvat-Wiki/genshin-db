			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Айюн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "Отдал им всё, что было. Надеюсь, теперь они наелись...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "Кормлю чаек. Смотри, они почти наелись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190104,
					"content": "Ух ты... Когда вы успели подружиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240190105,
					"content": "Они не воруют твою картошку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "Нет. Похоже, люди специально приходят сюда, чтобы кормить чаек. Потому они и не заинтересовались моей едой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190107,
					"content": "Но ведь нельзя уходить далеко от работы, иначе можно опоздать. Ты ведь так говорил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240190108,
					"content": "Ха-ха, ничего страшного. Сегодня у меня выходной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190109,
					"content": "Здесь коллеги не заведут со мной разговоров о работе, и картошку никто не украдёт... Да, это отличное место для отдыха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190110,
					"content": "Чайки весьма дружелюбны. Они не воруют картошку и не нападают на меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190111,
					"content": "Стоило покормить их самому несколько раз, как они меня запомнили. Теперь они даже позволяют погладить их пёрышки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190112,
					"content": "Я даже называю их джентльменами. Они этого заслуживают, в отличие от господ у Дворца Мермония.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190113,
					"content": "Если бы они своими лапками могли стучать по клавишам печатной машинки, то, не ровен час, оставили бы нас без работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190114,
					"content": "Чайки не смогут решать проблемы за нас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "Но хуже бы они точно не сделали. Да и всякий знает, что чайка не с каждым делом может справиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190118,
					"content": "Но довольно об этом. Хотите сами подружиться с этими джентльменами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190119,
					"content": "Ох, ты и правда называешь их джентльменами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240190120,
					"content": "Могу ли я просто подойти к ним?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "Конечно, они очень добры. Просто не ерошь их перья, и всё будет в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190124,
					"content": "Вот, эту рыбу я особым образом приготовил для чаек. Положи её в ту миску.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190125,
					"content": "Не бойся. Они достаточно дружелюбны к тем, кто их кормит. И они не станут выяснять, откуда у тебя рыба и кто её готовил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190122,
					"content": "Что мне нужно знать, чтобы подружиться с ними?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "Ничего особенного. Не трогай их перья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190116,
					"content": "Чайки не разговаривают.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "Как знать. Возможно, они притворяются, чтобы жизнь оставалась беззаботной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Айюн"
				}
			]
		},
