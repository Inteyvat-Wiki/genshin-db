					"Айюн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190801,
					"content": "Как... Как ты можешь так поступить? Это ведь совсем не те грубияны у Дворца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190802
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190802,
					"content": "Прости, это было не нарочно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190803
					]
				},
				{
					"id": 240190803,
					"content": "Эх... Я даже не успел тебя остановить. Зачем ты... Кто-то из них на тебя напал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190804
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190804,
					"content": "Впрочем, неважно. Они улетели. Придётся задобрить их чем-то вкусным через несколько дней...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				}
			]
		},
