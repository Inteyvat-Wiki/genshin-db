			},
			"dialogs": [
				{
					"id": 240190301,
					"content": "Видишь? Настоящие джентльмены. Куда воспитаннее, чем те, что около Дворца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190302
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190302,
					"content": "Они очень воспитанные.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190303
					]
				},
				{
					"id": 240190303,
					"content": "Я же говорил! Рядом с ними даже посидеть приятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190304
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190304,
					"content": "Представь, как здорово быть чайкой. Тебя приходят кормить, а ты только грейся на солнышке и размышляй о смысле жизни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190305
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240190305,
					"content": "Эх... Почему я чиновник, а не сиреневая чайка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				}
			]
		},
