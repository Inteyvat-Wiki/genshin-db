				{
					"id": 10220402,
					"content": "Кхе-кхе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220403
					]
				},
				{
					"id": 10220403,
					"content": "♪...♪♪♪...♪♪♪...♪♪",
					"roleType": "TALK_ROLE_PLAYER",
