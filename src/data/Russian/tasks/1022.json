			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Феликс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220801,
					"content": "А вы консультант ритуального бюро «Ваншэн», господин Чжун Ли, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220802
					],
					"speakerTitle": "Феликс"
				},
				{
					"id": 10220802,
					"content": "Миллелиты следят за каждым моим шагом. В столь отчаянные времена мы не должны действовать поспешно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220803
					],
					"speakerTitle": "Феликс"
				},
				{
					"id": 10220803,
					"content": "Отчаянные времена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220804
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220804,
					"content": "Адепты Заоблачного предела уже отправились в путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220805
					],
					"speakerTitle": "Феликс"
				},
				{
					"id": 10220805,
					"content": "Они собираются применить силу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220806
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220806,
					"content": "Скорее всего. Я слышал, что некоторые из Цисин уже отправились, чтобы их встретить... Под «встретить» подразумевается «задержать Адептов за городом».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220807
					],
					"speakerTitle": "Феликс"
				},
				{
					"id": 10220807,
					"content": "Обе стороны настроены крайне решительно. Им будет непросто договориться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220808
					],
					"speakerTitle": "Феликс"
				},
				{
					"id": 10220808,
					"content": "Ситуация выглядит безвыходной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220809
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220809,
					"content": "Адепты не признают власть Цисин. Они уважают лишь контракты Гео Архонта. Если Адепты нападут на город, остановить их будет невозможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220810
					],
					"speakerTitle": "Феликс"
				},
				{
					"id": 10220810,
					"content": "Но и Цисин не собирается просто так сдаваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220811
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220811,
					"content": "Хм. Всем известно, как упрямы могут быть члены Цисин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220812
					],
					"speakerTitle": "Феликс"
				},
				{
					"id": 10220812,
					"content": "И что теперь? Почему Фатуи оказались под прицелом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220813
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220813,
					"content": "Эх... Это дело рук Нин Гуан...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220814
					],
					"speakerTitle": "Феликс"
				},
				{
					"id": 10220814,
					"content": "В конце концов, именно она заявила: «В эти беспокойные времена Миллелиты должны пресекать действия Фатуи любой ценой!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220815
					],
					"speakerTitle": "Феликс"
				},
				{
					"id": 10220815,
					"content": "Ха! Они решили принять меры против Фатуи только сейчас? Всё, что нужно знать о Цисин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220816
					],
					"speakerTitle": "Феликс"
				},
				{
					"id": 10220816,
					"content": "Господин Чжун Ли, вы один из ближайших соратников Чайльда. Пожалуйста, помните, что ваши действия влияют на нашу организацию. Будьте начеку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220817
					],
					"speakerTitle": "Феликс"
				},
				{
					"id": 10220817,
					"content": "Ли Юэ находится на грани взрыва...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220818,
						10220819
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220818,
					"content": "Что мы можем сделать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				},
				{
					"id": 10220820,
					"content": "Ты собираешься выступить под нейтральным флагом? Или поддержишь одну из сторон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220821
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220821,
					"content": "Непростой выбор...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220822
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220822,
					"content": "Кстати, господин Чжун Ли... Мы слышали, что ритуальное бюро «Ваншэн» тоже замешано в этом деле. Они уже столкнулись с Миллелитами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220823
					],
					"speakerTitle": "Феликс"
				},
				{
					"id": 10220823,
					"content": "Это не к добру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220824
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220824,
					"content": "Я должен немедленно отправиться в ритуальное бюро. Надеюсь, у госпожи Ху пока ещё получается держать ситуацию под контролем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220825
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220825,
					"content": "#{NICKNAME}, тщательно обдумай свой следующий шаг. Чтобы спасти город от взрыва, нужно найти фитиль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220827
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220827,
					"content": "Уф... Связь с Фатуи может нам навредить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220828
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220828,
					"content": "Чжун Ли сказал что-то про фитиль... Какой фитиль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220829,
						10220830,
						10220831
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220829,
					"content": "Чайльд.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220832,
					"content": "Паймон поняла! Если кто-то и хочет перевернуть всё в городе с ног на голову, то это Тарталья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220833
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220833,
					"content": "Он наверняка поджидает подходящего момента, чтобы сделать что-то гнусное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220834
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220834,
					"content": "Где же его теперь искать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220835
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220835,
					"content": "Куда бы он мог пойти в такое время?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220836,
						10220837
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220836,
					"content": "Следуй за мной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220837,
					"content": "Он мог отправиться только в одно место.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220830,
					"content": "Парень с рыжими волосами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220831,
					"content": "Богатенький придурок, который заваливал нас деньгами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220819,
					"content": "Мы не можем просто остаться в стороне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				}
			]
		}
