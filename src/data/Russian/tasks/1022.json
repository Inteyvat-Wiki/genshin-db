				}
			]
		},
		{
			"id": 102206,
			"completionStepIds": [
				102206
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102206",
							"2"
						],
						"stepId": 102206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220601,
					"content": "Это не глазурные лилии. Глазурные лилии не нападают на людей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220602,
					"content": "Немыслимые враги...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220603
					]
				},
				{
					"id": 10220603,
					"content": "Этого маленького монстра называют «попрыгунья».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220604
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220604,
					"content": "Хм... Странно, какие интересные лепестки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220605
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220605,
					"content": "Эти глазурные лилии слишком долго росли с попрыгуньями. В результате цветы получили удивительные целебные свойства. Давай соберём эти лепестки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220606
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220606,
					"content": "Это всё здорово, но помогут ли эти лепестки провести Церемонию Вознесения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220607,
					"content": "К сожалению, нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220608
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220608,
					"content": "Ох... Как же так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220609,
					"content": "Прошу прощения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220610
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220610,
					"content": "Вы ищете глазурные лилии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220611
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220611,
					"content": "Хэй! Это ты! Не могу вспомнить, как тебя зовут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220612,
						10220614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220612,
					"content": "Привет, Гань Юй.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220613
					]
				},
				{
					"id": 10220613,
					"content": "#Привет, путешественн{F#ица}{M#ик}. Удивительно, что ты до сих пор помнишь моё имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220617,
					"content": "Кстати, как прошёл ваш визит в Нефритовый дворец?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220618
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220618,
					"content": "Он прошёл бы гораздо лучше, если бы ты сказала, как туда попасть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220619
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220619,
					"content": "Ой... Я разве не сказала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220620
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220620,
					"content": "Нет! Нам пришлось самим искать дорогу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220621,
						10220622
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220621,
					"content": "Это не секрет, поэтому ты, наверное, подумала, что мы знаем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220623,
					"content": "А... Ну да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220624
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220624,
					"content": "(Эх... Я действительно забыла им рассказать...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220625
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220625,
					"content": "Хм... Гань Юй ведёт себя немного странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220626
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220626,
					"content": "Она не такая серьёзная, как при нашей первой встрече...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220627
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220627,
					"content": "В прошлый раз я общалась с вами как посланник Воли Небес. А сейчас я просто прогуливаюсь и любуюсь цветами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220628
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220628,
					"content": "Любуешься цветами? Зачем идти так далеко, чтобы просто полюбоваться цветами? Они же растут в городских садах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220629
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220629,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220630
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220630,
					"content": "Терраса Юйцзин - это место, где скончался Властелин Камня. Я не могу больше гулять в тех опустевших садах, это просто невыносимо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220631
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220631,
					"content": "Когда мне приходится работать в кабинете на террасе Юйцзин, я задёргиваю шторы на окнах, которые выходят в сады.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220632
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220632,
					"content": "Прости. Не стоило поднимать эту тему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220633
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220633,
					"content": "Всё в порядке. Мне нужно разобраться со своими чувствами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220634
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220634,
					"content": "Война Архонтов завершилась две тысячи лет назад. Первые семеро Архонтов собирались в Ли Юэ и пировали с Властелином Камня. Пятеро из них уже оставили нас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220635
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220635,
					"content": "Это значит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220636
					]
				},
				{
					"id": 10220636,
					"content": "Да. После того как дух Властелина Камня отправился на небеса, Барбатос из Мондштадта остался последним Архонтом из первой семёрки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220666
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220666,
					"content": "Оставшиеся пятеро, включая сёгуна Инадзумы Райдэн, уже не те, кого две тысячи лет назад Властелин Камня называл друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220637
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220637,
					"content": "Самый юный из современных Архонтов - это Дендро Архонт в Сумеру. Ей едва исполнилось пять сотен лет, а возраст Властелина Камня превышал шесть тысяч лет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220638
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220638,
					"content": "Следовательно, Властелин Камня правил Ли Юэ с момента основания города 3700 лет назад. Ли Юэ ещё ни разу не прощался со своим божеством.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220639
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220639,
					"content": "Что ты думаешь об этом «прощании»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220640
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220640,
					"content": "Ох... Неожиданный вопрос... Я не...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220641
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220641,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220642
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220642,
					"content": "Как простая смертная, я и представить себе не могла Ли Юэ без Властелина Камня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220643
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220643,
					"content": "Но как Адепт... Я когда-нибудь приму новую реальность. После смерти Властелина Камня контракт божества Ли Юэ и Адептов подошёл к концу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220644
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220644,
					"content": "Адепт? Ты Адепт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220645
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220645,
					"content": "Да... Во мне течёт и человеческая кровь, и кровь цилиня. Я сражалась на стороне Властелина Камня во время Войны Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220646
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220646,
					"content": "Когда война закончилась, я заключила контракт с Властелином Камня и получила должность секретаря Цисин. Я продолжаю занимать эту должность по сей день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220647,
						10220648
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220647,
					"content": "Теперь понятно, откуда у тебя рога.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220649,
					"content": "Эм... Давай продолжим эту беседу в другой раз. Вы ищете глазурные лилии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220650
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220650,
					"content": "Я знаю, где можно найти дикие глазурные лилии. Смотри, я уже сорвала один цветок. Можешь забрать его себе, если захочешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220651
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220651,
					"content": "Мы не посмеем отказаться от такого предложения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220652
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220652,
					"content": "А ты спела цветку перед тем, как его сорвать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220653
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220653,
					"content": "Да. Я хорошо знакома с этой традицией. Я спела цветку народную песню Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220654
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220654,
					"content": "Ого! А ты в этом неплохо разбираешься. Спасибо, Гань Юй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220655
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220655,
					"content": "О, не стоит. Это я должна вас отблагодарить. Я рада сделать вклад в предстоящую церемонию прощания с нашим древним властелином.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220656
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220656,
					"content": "Мне пора возвращаться на работу. Удачи вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220657
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220657,
					"content": "Вот и всё. Приготовления к Церемонии Вознесения завершены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220658
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220658,
					"content": "Срывать цветы просто и приятно. Я подумал, что это было бы подходящее завершение наших дел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220659
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220659,
					"content": "Чжун Ли подошло бы заниматься земледелием.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220660
					]
				},
				{
					"id": 10220660,
					"content": "Паймон так и видит, как он занимается бизнесом в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220661
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220661,
					"content": "Ха-ха... В моей жизни уже было достаточно разных начинаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220662
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220662,
					"content": "Начинать дело с нуля всегда сложно. А когда твой бизнес вырастает до крупных размеров, количество забот перевешивает получаемую выгоду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220663
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220663,
					"content": "Поэтому не стоит принимать поспешных решений о создании бизнеса. Эмоциональное истощение может привести к весьма плачевным последствиям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220664
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10220664,
					"content": "Ух ты... Судя по его словам, Чжун Ли через многое прошёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220665
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220665,
					"content": "Ладненько. Нам пора возвращаться в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10220648,
					"content": "Неудивительно, что ты постоянно что-то забываешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220622,
					"content": "Надо было нам не бродить самим, а просто спросить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220614,
					"content": "Привет, Сяо Мэй.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220615
					]
				},
				{
					"id": 10220615,
					"content": "Сяо Мэй? Кто такая Сяо Мэй?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220616
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 10220616,
					"content": "#Ты забыл{F#а}, как меня зовут?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "Гань Юй"
				}
			]
		},
		{
			"id": 102208,
			"completionStepIds": [
				102208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
