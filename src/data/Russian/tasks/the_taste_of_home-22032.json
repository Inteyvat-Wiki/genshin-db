					"Тан Вэнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320601,
					"content": "Хм? Почему у этого блюда такой... такой интересный вкус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320602
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320602,
					"content": "Нет, скорее не интересный, а... уникальный, что ли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320603
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320603,
					"content": "#Как ты додумал{F#ась}{M#ся} до чего-то подобного? Твои кулинарные умения действительно... не от мира сего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320604
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320604,
					"content": "Спасибо тебе за твои старания! Пожалуйста, возьми. Я, ммм, наслажусь этим блюдом попозже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тан Вэнь"
				}
			]
		},
		{
			"id": 2203207,
			"completionStepIds": [
				2203207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203207",
