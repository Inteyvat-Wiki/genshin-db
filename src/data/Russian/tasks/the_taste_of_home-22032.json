			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тан Вэнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320801,
					"content": "Ах, как было бы хорошо поесть что-нибудь из кухни Ли Юэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320802
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320802,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320803
					]
				},
				{
					"id": 220320803,
					"content": "#Ты кто? Глядя на твою одежду... Ты, должно быть, т{F#а}{M#от} сам{F#ая}{M#ый} путешественни{F#ца}{M#к}, верно? Прошу меня извинить, просто соскучилась немного по дому...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320804,
						220320805
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320804,
					"content": "Ты только что говорила, что хочешь поесть чего-нибудь из кухни Ли Юэ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				},
				{
					"id": 220320818,
					"content": "А? Не верю своим ушам... Ты знаешь, как готовить блюда из Ли Юэ? Это просто великолепно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320819
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320819,
					"content": "Тогда, пожалуйста, помоги мне! Приготовь для меня какое-нибудь настоящее угощение из Ли Юэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320820
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320820,
					"content": "Дай подумать... Чего бы мне хотелось сейчас больше всего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320821
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320821,
					"content": "Хм... Так хочется рыбки! Я скучаю по рыбе, которую готовила мне моя мама, когда я была ребенком...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320822
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320822,
					"content": "Вымыть рыбу, сделать надрезы с обеих сторон, начинить специями и выдержанным вином и слегка замариновать, обжарить на сковороде до золотистой корочки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320823
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320823,
					"content": "Затем добавить горячую воду и довести соус до кипения, и в завершение приправить на сильном огне, загустить соус, разложить по тарелкам и подавать... Вот это настоящее блюдо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320824
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320824,
					"content": "Мой младший брат всё время путался под ногами, прыгая и восклицая: «Как здорово! Еда готова!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320825
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320825,
					"content": "Эх... Моя мама так хорошо готовит рыбу, но когда же я смогу вернуться и поесть её?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320805,
					"content": "Тебе не нужна помощь с чем-нибудь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320806
					]
				},
				{
					"id": 220320806,
					"content": "Позволь мне представиться. Я Тан Вэнь, историк из Ли Юэ. Я проводила здесь полевые исследования уникальных обычаев Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320807
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320807,
					"content": "Я уже собиралась вернуться в Ли Юэ, так как уже почти закончила сбор информации. Но в последнее время в Инадзуме произошло слишком много всего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320808
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320808,
					"content": "Я чувствую, что наблюдаю за историческими событиями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320809
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320809,
					"content": "События этого периода, безусловно, войдут в анналы истории Тейвата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320810
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320810,
					"content": "Быть свидетелем подобных событий, а затем достоверно, полно и ясно зафиксировать их для потомков - вот что должен делать историк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320811
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320811,
					"content": "Но... какой бы захватывающей ни была для меня эта моя миссия, она не удовлетворит мой желудок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320812
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320812,
					"content": "Ты проголодалась?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320813
					]
				},
				{
					"id": 220320813,
					"content": "Не могу сказать... что это потому что я голодна... А-ха-ха, инадзумская еда тоже довольно вкусная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320814
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320814,
					"content": "Мне очень нравится тэмпура, хотя кажется, что тут абсолютно всё жарят в кляре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320815
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320815,
					"content": "Но после того, как я долгое время питалась инадзумской кухней, я начала скучать по блюдам из Ли Юэ. К сожалению, я не смогла найти ресторан, где бы готовили настоящую еду из Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320816
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320816,
					"content": "Несколько дней назад я, наконец, решила разместить кулинарное поручение в Гильдии искателей приключений, но ответа пока не последовало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320817
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320817,
					"content": "Могу ли я помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				}
			]
		}
	]
}