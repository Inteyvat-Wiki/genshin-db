				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320701,
					"content": "Итак, какое блюдо мы должны приготовить из рыбы? Как насчёт того, чтобы выбрать одно из них для неё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220320702,
					"content": "Так, посмотрим... В последнее время мои любимые рыбные блюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220320703,
					"content": "Чёрный окунь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220320704,
					"content": "Кисло-сладкая рыба-белка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220320705,
					"content": "И божественный мондштадтский рыбный шашлычок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220320706,
					"content": "Это всё - твои любимые блюда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320707
					]
				},
				{
					"id": 220320707,
					"content": "Хе-хе, доверься моему вкусу! Поспеши и выбери одно из них...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320708,
						220320710,
						220320712,
						220320714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220320708,
					"content": "Что ж, пусть это будет чёрный окунь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320709
					]
				},
				{
					"id": 220320709,
					"content": "Великолепно! Тогда давай быстрее готовить чёрного окуня для мисс Тан Вэнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220320710,
					"content": "Что ж, пусть это будет рыба-белка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320711
					]
				},
				{
					"id": 220320711,
					"content": "Ура! Скорее готовить рыбу-белку для мисс Тан Вэнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220320712,
					"content": "Что ж, пусть это будет мондштадтский рыбный шашлычок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320713
					]
				},
				{
					"id": 220320713,
					"content": "Класс! Скорее приступаем к приготовлению мондштадтского рыбного шашлычка для мисс Тан Вэнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220320714,
					"content": "Дай ещё подумаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320715
					]
				},
				{
					"id": 220320715,
					"content": "Мм, давай решим и скорее приступим к приготовлению блюда для мисс Тан Вэнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
