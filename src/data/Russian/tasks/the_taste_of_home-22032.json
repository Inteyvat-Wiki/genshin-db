					"Тан Вэнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320201,
					"content": "Уже готово? Ты, часом, не повар под прикрытием?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320202
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320202,
					"content": "Мм... Не могу дождаться, так хочется попробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320203,
						220320204
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220320203,
					"content": "Милости прошу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220320204,
					"content": "Посмотрим... О каких блюдах мы только что говорили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320205
					]
				},
				{
					"id": 220320205,
					"content": "Верно... Рыба-белка, чёрный окунь и мондштадтский рыбный шашлычок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220320206,
					"content": "Давай выберем одно и подадим его мисс Тан Вэнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 2203203,
			"completionStepIds": [
				2203203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
