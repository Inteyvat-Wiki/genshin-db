			"dialogs": [
				{
					"id": 761420301,
					"content": "Эй, Чернов, ты как там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420302
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420302,
					"content": "Клинок ещё могу держать... командир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420303
					],
					"speakerTitle": "Чернов"
				},
				{
					"id": 761420303,
					"content": "Шонокович... Филаев... вы в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420304
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420304,
					"content": "Ух... кажется, я ногу сломал. Зато живой! Ты считал? Сколько врагов я положил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420305
					],
					"speakerTitle": "Шонокович"
				},
				{
					"id": 761420305,
					"content": "Сколько же здесь монстров... К-командир, неужели здесь мы все и поляжем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420306
					],
					"speakerTitle": "Филаев"
				},
				{
					"id": 761420306,
					"content": "Что ты болтаешь, малыш? Мы выберемся отсюда живыми! Не волнуйся, разведчик наверняка добрался до города и рассказал обо всём Старшине. Подкрепление уже в пути!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420307
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420307,
					"content": "Опять они. Когда же уймётся эта Дикая Охота.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420308
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420308,
					"content": "Эй! Оружие к бою, фонари повыше! Нам предстоит тяжёлое сражение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
