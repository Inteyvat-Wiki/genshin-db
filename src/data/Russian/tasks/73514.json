			"trigger": {
				"objectNames": [
					"Шрия",
					"Винаяк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735140101,
					"content": "Это было опасно... Даже унуты пытаются нам помешать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140102
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735140102,
					"content": "Эй! Если бы мы не отключили зажигание, мы могли бы его прикончить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140103
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735140103,
					"content": "А теперь он сбежал, и придётся ждать как минимум день, пока он снова ослабит бдительность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140104
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735140104,
					"content": "Ты же не собираешься завтра опять полдня спорить о пустяках, а потом дать ему уйти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140105
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735140105,
					"content": "Но параметры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140106
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735140106,
					"content": "Я всё проверил. Хотя скорость зарядки ниже расчётной, на использование это не влияет, никаких рисков тоже нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140107
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735140107,
					"content": "Шрия, я знаю, что ты хочешь как следует всё обдумать и проанализировать, а только потом действовать. Но знаешь, не всегда всё идёт по плану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140108
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735140108,
					"content": "Пока ты до бесконечности перепроверяешь планы, можешь упустить хорошую возможность. И потом опять получится как в тот раз, когда ты отложила промежуточную защиту работы... Вечные оглядки назад приносят одни разочарования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140109
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735140109,
					"content": "Ох, ладно. Вот твой модуль зажигания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140110
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735140110,
					"content": "Отлично! Завтра мы наконец пустим в ход унутобойную пушку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140111
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735140111,
					"content": "Я хочу отнести компоненты в деревню Аару, ещё немного поколдовать над ними. К первому официальному запуску унутобойной пушки мы должны быть готовы как следует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140112
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735140112,
					"content": "...Но с чем связаны отклонения в параметрах окружающей среды? Из-за чего унуты так разбушевались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140113
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735140113,
					"content": "#Я не могу перестать об этом думать... {M#Уважаемый искатель}{F#Уважаемая искательница} приключений, вы можете прийти завтра?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140114
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735140114,
					"content": "К тому времени мы уже наверняка столкнёмся с унутом. И надеюсь, у нас появится хоть какая-то зацепка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шрия"
				}
			]
		}
	]
}