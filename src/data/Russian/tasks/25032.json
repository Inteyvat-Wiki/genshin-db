				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзы Чэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320101,
					"content": "Хм. Поэзия через картины... Нет, не так! Должно быть так: поэзия в картинах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320102
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320102,
					"content": "Хм... Что-то тут не так... Эти два предложения означают одно и то же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320103,
						250320104
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320103,
					"content": "О чём ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				},
				{
					"id": 250320105,
					"content": "Приветствую вас! Верно. Я как раз пытаюсь написать стихотворение о пейзажах Натлана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320106
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320106,
					"content": "Но, по правде говоря, пейзажи Натлана и Ли Юэ вообще не похожи. Я совсем не разбираюсь в историях Натлана. Вообще не знаю, что писать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320107
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320107,
					"content": "К тому же я не специалист по поэзии, да и рифма у меня хромает. Мне очень далеко до стихов Ху Тао...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320108
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320108,
					"content": "Увы, я не могу вернуться из этого путешествия с пустыми руками. Мои коллеги из Департамента по делам граждан точно скажут, что я «фольклорист без фольклора».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320109
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320109,
					"content": "Ты работаешь в Департаменте по делам граждан?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320110
					]
				},
				{
					"id": 250320110,
					"content": "Можно и так сказать. Департамент недавно нанял меня для обследования земель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320111
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320111,
					"content": "Эх, на самом деле я вожу людей по окрестностям Ли Юэ. Мы отслеживаем изменения воды и почвы, а затем корректируем карту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320112
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320112,
					"content": "Поездка вымотала меня до ужаса. Я потерял счёт изношенным ботинкам. Поэтому взял отпуск, чтобы отдохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320113
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320113,
					"content": "Не знаю, о чём я вообще думал в тот момент, когда написал в бланке заявления на отпуск «Еду изучать фольклор, чтобы поймать поэтическое вдохновение».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320114
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320114,
					"content": "Кто бы мог подумать, что сотрудник Департамента, ответственный за предоставление отпусков, отнесётся к этому серьёзно и ответит «Удачи с поэзией!», предоставив мне полмесяца на отдых...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320115,
						250320117
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320115,
					"content": "Это ведь здорово?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320116
					]
				},
				{
					"id": 250320116,
					"content": "Здорово? Здорово-то оно здорово, но весь Департамент по делам граждан знает о моём разрешении на отпуск.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320119,
					"content": "Ах, в Натлане так здорово! Прекрасные виды, чудесная еда, интересные существа. Особенно эти милые заврята...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320120
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320120,
					"content": "Но я так и не написал ни строчки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320121
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320121,
					"content": "Я даже специально одолжил фотокамеру, чтобы собрать материал. А оказалось, что я совсем не умею фотографировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320122
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320122,
					"content": "Если снимки природы получились ещё более-менее, то на сделанные мной фотографии магазинов и людей вообще невозможно смотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320123,
						250320124
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320123,
					"content": "Нужна моя помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320125,
					"content": "Правда?! Слава всем Архонтам! Наконец хоть кто-то может мне помочь... В любом случае мне сначала нужно собрать материал для стихов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320126
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320126,
					"content": "Дай-ка подумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320124,
					"content": "Я отлично фотографирую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320117,
					"content": "Так ты преуспел в написании стихов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320118
					]
				},
				{
					"id": 250320118,
					"content": "Нет. Преуспел только в написании разрешения на отпуск. Весь Департамент знает, что я поехал в Натлан собирать фольклор и писать стихи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Цзы Чэн"
				},
				{
					"id": 250320104,
					"content": "Ты пытаешься сочинить стихотворение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				}
			]
		},
		{
			"id": 2503206,
			"completionStepIds": [
				2503206,
				2503210,
				2503217
			],
			"beginWay": "TALK_BEGIN_MANUAL",
