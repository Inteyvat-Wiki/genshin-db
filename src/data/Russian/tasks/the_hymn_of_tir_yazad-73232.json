					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"10010",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Зурван",
					"Соруш"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732321801,
					"content": "Завершив обряд Аб-Зохр, вы следуете за потоком амриты и покидаете Харвисптохм вместе с Соруш, чтобы вернуться в оазис Вурукаша...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732321802
					]
				},
				{
					"id": 732321802,
					"content": "Зурван ждёт вас там.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732321803
					]
				},
				{
					"id": 732321803,
					"content": "Подумать только, вы смогли завершить обряд Аб-Зохр. Ваши деяния не уступают подвигам древних героев. Я поражена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321804
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321804,
					"content": "Ты вовсе не выглядишь удивлённой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732321805,
					"content": "Знамение Апаоши потушено, а земля очищена. И всё это удалось сделать без жертв...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321806
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732321806,
					"content": "Дождь был очень сильным! Большая дыра в небе исчезла, а засохший пень снова вырос в огромное дерево!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321807
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732321807,
					"content": "Теперь ваша богиня не будет так страдать, ведь её больше не разъедает скверна разложения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321808
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732321808,
					"content": "К слову, что произошло пятьсот лет назад?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321809
					]
				},
				{
					"id": 732321809,
					"content": "Да! В воспоминаниях, которые видела Соруш, в числе ордена скептиков были жители Каэнри'ах, и они в числе первых сражались с монстрами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732321810,
					"content": "Не переживайте так. Раз вы видели воспоминания о прошлом, я больше не буду потчевать вас байками и расскажу правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321811
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321811,
					"content": "Давным-давно, когда я только пробудилась в оазисе Вурукаша, небо было залито мраком, и повсюду были чудовища. Монстры заполонили всю землю, кроме этого маленького убежища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321812
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321812,
					"content": "Согласно последнему желанию божественной птицы я собрала всю мощь Хварны и отправилась усмирять чудовищ, пока однажды не встретила в пустыне человека с волосами цвета золота.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321813
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321813,
					"content": "Половина его тела превратилась в чудовище, но я не почувствовала в нём монстра. Когда я нашла его, он крепко сжимал в руке кольцо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321814
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321814,
					"content": "Я вернулась с ним в оазис Вурукаша, и, когда он очнулся, то заявил, что он дахрийский мечник, который выжил только благодаря тому, что был проклят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321815
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321815,
					"content": "Некоторое время я путешествовала с этим мечником в маске, и мы противостояли дэвам, вторгшимся в оазис Вурукаша.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321816
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321816,
					"content": "Проклят?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321817
					]
				},
				{
					"id": 732321817,
					"content": "Да. Говорят, что все дахрийцы были в той или иной степени прокляты во время того великого бедствия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321818
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321818,
					"content": "Спустя некоторое время из земель к востоку от пустыни пришли люди в одеяниях учёных во главе с одноруким мудрецом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321819
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321819,
					"content": "Они утверждали, что когда-то сражались плечом к плечу с дахрийскими героями и что эти герои прошли предназначенный им путь, несмотря на дурную славу, которую они приобрели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321820
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321820,
					"content": "Они также сказали, что проследовали сюда по пути героев для того, чтобы исполнить их волю и положить конец бедствию из тёмных глубин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321821
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321821,
					"content": "Позже мы вместе вошли в руины, оставшиеся от дахрийцев, и нашли там машины, которые противостояли монстрам. Машины, принадлежавшие отряду, который сражался вместе с этими учёными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321822
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321822,
					"content": "И наконец, однорукий мудрец использовал записи, оставленные дахрийцами, чтобы найти путь сквозь тьму к Харвисптохм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321823
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321823,
					"content": "Так мы вошли в дерево, и с помощью амриты очистили небо и землю от скверны. После этого оазис Вурукаша стал постоянно порождать пари, а чудовища постепенно исчезли с лица земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321824
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321824,
					"content": "#Позже мечник в маске покинул оазис Вурукаша вместе с {M#девушкой}{F#юношей} с такими же золотыми волосами, как у тебя, а мудрец ушёл в подземные руины и больше не вернулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321825
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321825,
					"content": "Оставшиеся люди скрепили узы с новорождёнными пари, назвали себя орденом скептиков и поселились здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321826
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321826,
					"content": "#И вот {M#герой}{F#героиня} с золотыми волосами {M#вернулся}{F#вернулась} в оазис Вурукаша, и, хотя ты не {M#она}{F#он}, я ощутила начало чего-то нового.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321827
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321827,
					"content": "Вот почему я решила обратиться к вам за помощью. С вами мне больше не нужно было искать героев для сражений вместе с пари.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321828
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321828,
					"content": "Обучать людей - самая сложная задача.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321829
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321829,
					"content": "Это потому, что вы, пари, очень ленивые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321830
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732321830,
					"content": "Не обобщай, Белая Болталка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321831
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732321831,
					"content": "Вы завершили обряд Аб-Зохр, и скверна некоторое время не будет угрожать этому месту, а я могу немного отдохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321832
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321832,
					"content": "Что касается Соруш, я оставляю её на ваше попечение. Наставьте её на путь истинный, ведь это тоже входит в обязанности яснапати.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321833
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321833,
					"content": "Я не намерена слушать наставления Белой Болталки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321834
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732321834,
					"content": "#Хе-хе, слушай своих {F#наставниц}{M#наставников}, Соруш! Зурван, ты так говоришь, будто мы больше не встретимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321835
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732321835,
					"content": "Ну, вы ведь не собираетесь остаться здесь со мной? Люди все такие неугомонные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321836,
						732321837
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321836,
					"content": "Мы ещё вернёмся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321838
					]
				},
				{
					"id": 732321838,
					"content": "Ха-ха! Позволь не поверить тебе. Я не в первый раз слышу эти слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321839
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321839,
					"content": "Интересно, как поживает тот мечник в маске... Передай ему привет от меня, если увидишь его снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321840
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321840,
					"content": "Вы оба путешественники. Я уверена, что вы обязательно встретитесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321841
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321841,
					"content": "Всё, всё, идите туда, где должны быть. Не скучайте по мне слишком сильно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732321837,
					"content": "Мы встретимся снова.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321838
					]
				}
			]
		},
