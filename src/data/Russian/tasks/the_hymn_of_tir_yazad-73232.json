			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Соруш",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732320301,
					"content": "Мы на вершине гигантского пня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732320302,
					"content": "Мы потратили столько усилий, чтобы пройти через пещеру только для того, чтобы снова застрять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732320303,
					"content": "С точки зрения логики, я уже получила Двурогий венец. Почему же Харвисптохм отвергает меня? У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320304
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732320304,
					"content": "Что с тобой, Соруш? Ты выглядишь неважно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732320305,
					"content": "У-у... Это Двурогий венец... Что-то... приближается!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320306
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732320306,
					"content": "Соруш!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732320380,
					"content": "Корни древнего дерева переплетаются, и каждое соединение излучает слабый свет.\\nПо мере того, как свет и тень соединяются, перед глазами один за другим мелькают образы.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320381,
					"content": "Среди пустынных гор стоят герои с оружием в руках, а за ними выстроились пари.\\nТёмные тучи окутывают их, но они не отступают ни на шаг.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320382,
					"content": "В самых тёмных глубинах мерцают титанические механизмы.\\nОни защищают бегущих людей от бушующего чёрного пламени.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320383,
					"content": "На бескрайних безжизненных просторах спина к спине стоят мечник в маске и однорукий мудрец.\\nПод началом Хварны они противостоят натиску чудовищ, которые устремляются на них подобно приливу.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320384,
					"content": "Хварна направляет их всех вперёд, одновременно являясь конечной целью их возвращения.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320385,
					"content": "Бесчисленные огоньки сливаются в крошечные точки, белое сияние поднимается от основания дерева.\\nНекогда тёмное небо озаряется светом.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7323206,
			"completionStepIds": [
				7323206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323206",
							"2"
						],
						"stepId": 7323206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Соруш"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732320601,
					"content": "Эй, Соруш! Очнись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732320602,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320603
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732320603,
					"content": "Наконец очнулась! Ты очень напугала Паймон, упав в обморок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732320604,
					"content": "Я... в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320605
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732320605,
					"content": "Потом дерево открылось, и мы попали внутрь. Это... гигантский лотос Гаокерена, о котором говорила Зурван?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732320606,
					"content": "Что с тобой случилось? Что-то не так с венцом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732320607,
					"content": "Я увидела воспоминания Харвисптохм. Я видела множество пари, дахрийские механизмы и людей-героев. Они все пожертвовали собой в борьбе с монстрами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320608
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732320608,
					"content": "Мечник в маске, однорукий мудрец и наши древние предшественницы победили чудовищ, восставших из Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320609
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732320609,
					"content": "Затем их сознания и Хварна соединились с Харвисптохм, превратившись в дождь, низвергшийся с небес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320610
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732320610,
					"content": "Дахрийские механизмы... Неужели всё было так, как говорит Наседжуна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732320611,
					"content": "Нужно спросить Зурван.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732320612
					]
				},
				{
					"id": 732320612,
					"content": "Да, но что нам делать? Помнится, Зурван говорила, что нужно смыть какую-то там скверну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732320613,
					"content": "Мы должны войти в осквернённую палату внутри сознания нашего божества, чтобы спасти сердца Спенты, попавшие в ловушку скверны. Только тогда божественное сознание вновь пробудится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320614
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732320614,
					"content": "В воспоминаниях это место было бескрайней пустотой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320615
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732320615,
					"content": "Как нам попасть внутрь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320616
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732320616,
					"content": "Следуйте за мной. Нужно идти по следам, ведущим к сердцам героев древности, и мы достигнем цели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Соруш"
				}
			]
		},
