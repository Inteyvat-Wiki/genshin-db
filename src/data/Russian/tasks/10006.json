			"dialogs": [
				{
					"id": 100060101,
					"content": "Привет, Дурин! Вот где ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100060102,
					"content": "#{NICKNAME}, Паймон... Что вы здесь делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060103
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060103,
					"content": "Хе-хе, вопрос в другом: почему ты тут в полном одиночестве читаешь книгу? На улице такая хорошая погода!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100060104,
					"content": "Дело в том, что с тех пор, как в Мондштадте у меня появилось больше возможностей для «общения» с людьми, я часто стал воспринимать их шутки всерьёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060105
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060105,
					"content": "Например, однажды я увидел в цветочном магазине очень красивый букет и сказал об этом хозяйке, а она ответила:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060106
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060106,
					"content": "«Хе-хе, если тебе так нравятся эти сорняки, добавь к ним немного мяты и цветков-сахарков и сделай букет».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060107
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060107,
					"content": "Я последовал её совету и сделал букет. Когда она увидела его, у неё сделалось очень странное выражение лица...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060108,
						100060109
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060108,
					"content": "У тебя своеобразный вкус.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				},
				{
					"id": 100060110,
					"content": "Позже Альбедо объяснил, что это потому, что я пока не понимаю «скрытый смысл» в словах людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060111
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060111,
					"content": "После того как я научился читать на языке Мондштадта, он сказал мне, что я могу читать здешние книги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060112
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060112,
					"content": "Я родился из книги сказок и должен быть в состоянии извлечь из них знания о законах этого мира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060113
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060113,
					"content": "Кажется, я потерял счёт времени... Кстати, зачем вы меня искали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060114,
						100060117
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060114,
					"content": "Друзья должны чаще навещать друг друга.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060115
					]
				},
				{
					"id": 100060115,
					"content": "Вот оно что. Видимо, это тоже часть правил. Каждый день узнаю что-то новое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060116
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060116,
					"content": "Это так, но мы по важному делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100060118,
					"content": "Мы принесли «послание» от Рэйндоттир для тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100060119,
					"content": "Так это от... тёти Рэйндоттир?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060120,
						100060121
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060120,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060122,
					"content": "Хм, я немного удивлён... Рэйндоттир - подруга моей мамы и мать дракона, который когда-то существовал в этом мире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060123
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060123,
					"content": "Я вытеснил его - присвоил его судьбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060124
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060124,
					"content": "Если она возненавидит меня... я даже не знаю, что мне тогда делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060125,
						100060126
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060125,
					"content": "Она не столь мелочна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060127,
					"content": "Да, Дурин, не волнуйся, ничего плохого не случится. К тому же мы рядом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100060128,
					"content": "Вы меня успокоили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060129
					],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060129,
					"content": "Давайте посмотрим, что внутри...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дурин"
				},
				{
					"id": 100060126,
					"content": "Мы с тобой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060121,
					"content": "Не надо так волноваться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060117,
					"content": "Мы здесь из-за ведьмы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060118
					]
				},
				{
					"id": 100060109,
					"content": "Дело не в тебе, дело в ней.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				}
			]
		},
