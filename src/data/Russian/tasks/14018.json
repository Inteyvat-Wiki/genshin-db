			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Навия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140180901,
					"content": "Я дала волю своим сомнениям. Но быстро возьму себя в руки и стану таким боссом, на которого все могут положиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180902
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140180902,
					"content": "Честно говоря, мне стыдно за то, как я себя сегодня вела. Ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180903,
						140180907,
						140180912
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140180903,
					"content": "Подарок от жителей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180904
					]
				},
				{
					"id": 140180904,
					"content": "Часто бывает так, что совершенно обычные и ничем не примечательные вещи для кого-то оказываются несбыточной мечтой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180905
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140180905,
					"content": "У меня так с семейными фотографиями. Я с детства завидовала людям, рассматривая снимки, на которых они сняты всей семьёй...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180906
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140180906,
					"content": "Я никогда не думала, что тоже смогу быть запечатлена рядом с родителями. Похоже, иногда удача всё-таки мне улыбается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Навия"
				},
				{
					"id": 140180907,
					"content": "Расскажи о Клементине...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180908
					]
				},
				{
					"id": 140180908,
					"content": "Знаешь, я вот о чём думала... Мама хотела, чтобы я была счастлива, но на самом деле это тоже совсем не просто. По крайней мере, ничуть не проще, чем оправдать ожидания отца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180909
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140180909,
					"content": "Мои родители были очень разными, но они всегда уважали друг друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180910
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140180910,
					"content": "Аквабусы оказались монументальным проектом, который принёс пользу всему Фонтейну. Мне кажется неправильным оценивать его, учитывая исключительно пользу или убыток для нашего «клана».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180911
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140180911,
					"content": "Наверное, поэтому она не стала участвовать в переговорах и останавливать моего отца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Навия"
				},
				{
					"id": 140180912,
					"content": "Почему ты спросила, считаю ли я тебя своей напарницей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180913
					]
				},
				{
					"id": 140180913,
					"content": "Ой, зачем ты вспоминаешь? Не надо, замолчи сейчас же! Мне очень неловко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180914
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140180914,
					"content": "Пожалуйста, немедленно забудь мои слова! Ой, нет... Будет плохо, если ты забудешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180915
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140180915,
					"content": "Ладно, давай это будет наш секрет! Но больше не напоминай мне о нём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Навия"
				}
			]
		}
	]
}