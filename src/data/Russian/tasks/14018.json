	"talks": [
		{
			"id": 1401809,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1401801",
							"2"
						],
						"stepId": 1401801,
						"stateName": "QUEST_STATE_UNFINISHED"
