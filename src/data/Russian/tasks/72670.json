				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726700101,
					"content": "Кхм-кхм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700102
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700102,
					"content": "Здравствуйте.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700103
					]
				},
				{
					"id": 726700103,
					"content": "И тебе не хворать. Ну наконец-то прибыл кто-то подходящий, я надеюсь. Кхе-кхе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700104
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700104,
					"content": "Знакомое лицо! Теперь я могу забыть о тревогах по поводу нехватки данных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700105
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700105,
					"content": "Мне так долго пришлось ждать, но приходили то старики, то дети... Это просто никуда не годится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700106,
						726700109
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700106,
					"content": "А ты кто?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700107
					]
				},
				{
					"id": 726700107,
					"content": "Ты что, меня уже не помнишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700108
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700108,
					"content": "Да ладно тебе, я же не какой-нибудь гнусный злодей, ни к чему притворяться, что мы не знакомы и всё такое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700111
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700111,
					"content": "Смотри, это же я! Мы познакомились на Рито, помнишь? Кхе-кхе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700112
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700112,
					"content": "Ты кажешься мне подозрительным.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700113
					]
				},
				{
					"id": 726700113,
					"content": "#Уф, ладно, может, ты и правда меня забыл{F#а}. Ладно, позволь мне представиться снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700114
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700114,
					"content": "Я Хуссени, учёный из Академии Сумеру. После множества испытаний я наконец добрался до Инадзумы, чтобы провести исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700115
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700115,
					"content": "К сожалению, на этих островах действует слишком много ограничений на исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700116
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700116,
					"content": "Конечно, я ушёл не с пустыми руками. Но учитывая все те неприятности, через которые мне пришлось пройти, я должен сказать, что в конечном итоге это не совсем того стоило.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700117
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700117,
					"content": "Поскольку средств на исследования оставалось мало, мне пришлось отправиться назад в Сумеру через Ли Юэ. Я понадеялся, что смогу спасти ситуацию во время своего путешествия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700118
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700118,
					"content": "И тогда я подумал - почему бы не вернуться к теме Диска усиления, ведь Академия уже признала мои успехи на этом поприще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700119
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700119,
					"content": "Не знаю, помнишь ли ты эту историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700120
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700120,
					"content": "Но Диск усиления - это ценный древний артефакт, который может дать пользователю силу вездесущих артерий земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700121
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700121,
					"content": "Кхе-кхе. Исследование всё ещё находится на начальной стадии, и мой прошлый отчёт о нём можно считать лишь кратким обзором.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700122
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700122,
					"content": "Предстоит ещё много работы, чтобы полностью понять принципы действия и возможности Диска усиления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700123
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700123,
					"content": "Из-за этого я набираю добровольцев, которые использовали бы Диск усиления, чтобы получить новые данные для исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700124
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700124,
					"content": "Так что, кхе-кхе, я не какой-то подозрительный тип, не думай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700125
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700125,
					"content": "Вот значит как.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700126
					]
				},
				{
					"id": 726700126,
					"content": "#Именно. Кхе-кхе, путешественни{F#ца}{M#к}, может быть, ты согласишься стать моим добровольцем и помочь испытать Диск усиления?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700127
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700127,
					"content": "Можно попробовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700128
					]
				},
				{
					"id": 726700128,
					"content": "Тогда позволь мне выразить благодарность за твою готовность идти на жертвы ради обретения мудрости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700129
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700129,
					"content": "Но перед тем как я передам Диск усиления в твоё распоряжение, не могли бы мы провести небольшую разминку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700130
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700130,
					"content": "Это необходимая процедура - сначала нужно выяснить, может ли доброволец защитить себя... Кхе-кхе. В конце концов, ни одно ответственное академическое исследование не должно ставить под угрозу жизни своих добровольцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700131
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700131,
					"content": "#Как только ты будешь готов{F#а}, отправляйся в указанные места и зачисти там лагеря монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700132
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700132,
					"content": "Я буду ждать твоего возвращения. Не забывай о безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700109,
					"content": "Что ты затеял?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700110
					]
				},
				{
					"id": 726700110,
					"content": "Ой, да ладно! Я что, похож на безумного ученого, который похищает прохожих, чтобы использовать их для опытов? Откуда этот осторожный тон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700111
					],
					"speakerTitle": "Хуссени"
				}
			]
		},
		{
			"id": 7267002,
			"completionStepIds": [
				7267003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267003",
							"2"
						],
						"stepId": 7267003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хуссени"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726700201,
					"content": "Вы вернулись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700202
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700202,
					"content": "И без единой царапины!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700203
					]
				},
				{
					"id": 726700203,
					"content": "Ха-ха... Кхм, наверное, я зря так переживал. Твоя сила и впрямь велика, тебе нестрашно доверить Диск усиления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700204
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700204,
					"content": "Диском усиления очень легко управлять, надеюсь, обучение для тебя не составит никакого труда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700205
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700205,
					"content": "Но учти, что это настоящая древняя реликвия. Если ты её потеряешь или сломаешь, мне придётся несладко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700206
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700206,
					"content": "Так что сначала пообвыкнись с ним, а уж потом берись за проверки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700301
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700301,
					"content": "Как у тебя дела? Понятно ли, как пользоваться Диском усиления?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700302,
						726700304
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700302,
					"content": "Это не так уж сложно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700303
					]
				},
				{
					"id": 726700303,
					"content": "Это уж точно. По сравнению с некоторыми инструментами, которые мы используем в Академии, Диск усиления довольно прост в эксплуатации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700306
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700306,
					"content": "С твоим уровнем более масштабные испытания не должны составить труда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700307
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700307,
					"content": "Я слышал, как проходящие мимо искатели приключений упоминали, что недавно обнаружили новое необычное подземелье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700308
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700308,
					"content": "Люди там ещё не бывали, поэтому место кишит монстрами сильнее тех, что можно встретить в окрестностях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700309
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700309,
					"content": "Я считаю, что если ты используешь его в качестве тестовой площадки, мы сможем получить более точные данные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700310
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700310,
					"content": "Я имею в виду, твои предыдущие результаты... Кхм, должен признать, они были очень впечатляющими. Но в том, что касается записей, у Диска усиления есть свои ограничения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700311
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700311,
					"content": "Думаю, для тебя это подземелье не будет таким уж сложным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700312
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700312,
					"content": "Ну это уж наверняка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700313
					]
				},
				{
					"id": 726700313,
					"content": "Знаешь, я бы не поверил, если бы мне это сказал кто-то другой. Но я уверен, у тебя всё получится. Кхе-кхе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700314
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700314,
					"content": "Давай я отмечу тебе это место на карте. Хорошего испытания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 726700304,
					"content": "Мне пока не всё понятно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700305
					]
				},
				{
					"id": 726700305,
					"content": "Ну, это нормально. Не волнуйся, поскольку ты обычный пользователь, тебе нужны только базовые операции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700306
					],
					"speakerTitle": "Хуссени"
				}
			]
		}
	]
}