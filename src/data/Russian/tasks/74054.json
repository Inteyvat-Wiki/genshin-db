			"dialogs": [
				{
					"id": 740540801,
					"content": "Потянуть за рычаг.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740540802
					]
				},
				{
					"id": 740540802,
					"content": "#А-а-а-а! {NICKNAME}, что ты делаешь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740540803,
					"content": "Вы без колебаний тянете за рычаг.\\nВ следующее мгновение раздаётся оглушительный грохот, и вся башня начинает раскачиваться из стороны в сторону, словно бы наступил конец света...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540804
					]
				},
				{
					"id": 740540804,
					"content": "После этого... машина с шумом выдаёт стопку перфолент...\\nВсё снова затихает.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540805
					]
				},
				{
					"id": 740540805,
					"content": "Что... это было?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740540806,
					"content": "Ох... Паймон ничего не может тут разобрать, но, похоже, это какая-то важная штука...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540807
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740540807,
					"content": "#{NICKNAME}, давай возьмём перфоленты? Вдруг однажды пригодятся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
