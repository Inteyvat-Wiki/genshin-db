			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Грейс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200701,
					"content": "#Уже вернул{F#ась}{M#ся}? Всех удалось оповестить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200702
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 411200702,
					"content": "#Я предупредил{F#а} всех, но пока никто возвращаться в город не собирается...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200703
					]
				},
				{
					"id": 411200703,
					"content": "Что значит пока? Что у них за дела такие, что в такие времена они готовы оставаться снаружи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200704
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 411200704,
					"content": "Видать, таковы люди города свободы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200705
					]
				},
				{
					"id": 411200705,
					"content": "Ха-ха-ха... И то правда. Куда уж свободнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200706
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 411200706,
					"content": "Но сейчас свободой можно было бы немного поступиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200707
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 411200707,
					"content": "Эх... У рыцарей тоже, должно быть, полно дел. Ладно, я подумаю, как ещё нам убедить этих людей. Благодарю тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200708
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 411200708,
					"content": "Надеюсь, все останутся целы и невредимы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Грейс"
				}
			]
		},
