			"dialogs": [
				{
					"id": 411200801,
					"content": "А-а-а! Ох, ты... ты не чудовище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200802
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 411200802,
					"content": "Пожалуйста, вернись в Мондштадт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200803
					]
				},
				{
					"id": 411200803,
					"content": "Я... я так и сделаю! Но я должен предупредить остальных. Я, может, и заплутал, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200804
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 411200804,
					"content": "Чего это ты тут прячешься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200805
					]
				},
				{
					"id": 411200805,
					"content": "Я... отдыхаю! Нельзя передохнуть? Не беспокойся за меня! Поскорее возвращайся в Мондштадт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200806
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 411200806,
					"content": "Метеориты, чудовища... У тех, кто всё ещё вне городских стен, плохо с головой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200807
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 411200807,
					"content": "В округе остался кто-то ещё?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200808
					]
				},
				{
					"id": 411200808,
					"content": "Я пытался отыскать Винд - сестру, которая всегда у пика Буревестника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200809
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 411200809,
					"content": "Я везде искал, но так её и не нашёл. Потом я решил попытать удачу в других местах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200810
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 411200810,
					"content": "Но вместо неё набрёл на кучу кровожадных монстров. Еле от них убежал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200811
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 411200811,
					"content": "Потом я снова пошёл сюда, до самого пика Буревестника, но её всё равно нигде не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200812
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 411200812,
					"content": "Эх, я могу лишь надеяться, что она уже в Мондштадте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200813
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 411200813,
					"content": "Ладно, я возвращаюсь в город, и вам советую. Сейчас снаружи делать нечего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Испуганный Шустер"
				}
			]
		},
