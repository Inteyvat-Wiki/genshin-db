				"points": []
			},
			"dialogs": [
				{
					"id": 710070101,
					"content": "Как продвигается картина?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710070102
					]
				},
				{
					"id": 710070102,
					"content": "С тех пор как у статуй загорелись глаза, я не могу оторваться от работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070103
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710070103,
					"content": "Но... Как бы корректнее выразиться? Кажется, я так и не смог написать идеальную картину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070104
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710070104,
					"content": "Этой картине чего-то не достаёт... Ты понимаешь меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070105
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710070105,
					"content": "Словно блюдо, приготовленное из отличных продуктов, но... но чего-то всё равно не хватает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070106
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710070106,
					"content": "Я не знаю, как описать это чувство... Я могу только продолжить работу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070107
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710070107,
					"content": "Ты можешь посмеяться надо мной. От красок у меня уже начинает кружиться голова. Надо бы немного отдохнуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070108
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710070108,
					"content": "Но стоит мне закрыть глаза, как я вижу сияющий взор статуи. Они словно живые и смотрят прямо на меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070109
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710070109,
					"content": "Поэтому я вернулся сюда, чтобы хоть чуть-чуть перевести дух. С этого ракурса глаза статуй не видны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070110
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710070110,
					"content": "Ах, да... Возьми эту картину. Это лучшее, что я смог написать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070111
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710070111,
					"content": "Я очень устал. Если позволишь, я хочу немного отдохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070112
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710070112,
					"content": "Чего же не хватает моей картине...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вермеер"
				}
			]
		}
	]
}