				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205200301,
					"content": "Я приготовлю тебе чего-нибудь горячего.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200302
					]
				},
				{
					"id": 205200302,
					"content": "Х-хорошо... П-поспеши... Ещё немного, и я превращусь в с-с-сосульку...",
					"roleType": "TALK_ROLE_NPC",
