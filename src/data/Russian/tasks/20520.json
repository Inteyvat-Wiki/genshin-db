			},
			"dialogs": [
				{
					"id": 205200501,
					"content": "#Ну как, наш{F#ла}{M#ёл} цельномороженое мясо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200502
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200502,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200503
					]
				},
				{
					"id": 205200503,
					"content": "Замечательно. Вот оно какое, цельномороженое мясо. Совсем как обычное, только цельномороженое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200504
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200504,
					"content": "Впрочем, какая разница. Главное - что поручение выполнено...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200505
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200505,
					"content": "#Благодарю тебя, путешественни{F#ца}{M#к}. Не знаю, что бы я без тебя делал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200506
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200506,
					"content": "Вот, прими это в качестве награды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Томми"
				}
			]
		},
