			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Томми"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205200401,
					"content": "#Фух... Кажись, согрелся... Спасибо тебе, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200402
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200402,
					"content": "Что тебя сюда привело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200403
					]
				},
				{
					"id": 205200403,
					"content": "Поручение, что ж ещё... Я торчал в том лагере из-за одного непростого поручения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200404
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200404,
					"content": "Но долго задерживаться на одном месте мне не хотелось, и я решил чем-нибудь заняться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200405
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200405,
					"content": "Харрис, тот повар из базового лагеря, ищет кого-нибудь, кто добыл бы ему в горах какое-то «цельномороженое мясо».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200406
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200406,
					"content": "Он сказал, что достаточно будет отыскать замёрзших поросят, и даже заходить в опасные места не нужно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200407
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200407,
					"content": "Я подумал, дело плёвое, и взялся за это поручение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200408
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200408,
					"content": "К тому же я потихоньку тренировался, изучал горную местность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200409
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200409,
					"content": "Всё для того, чтобы наконец выполнить поручение, которое мне дала та девушка алхимик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200410
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200410,
					"content": "#Но не прошёл я по горам и нескольких шагов, как потерялся и чуть не замёрз. Как хорошо, что рядом оказал{F#ась}{M#ся} ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200411
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200411,
					"content": "Я лишь жалею, что так и не выполнил своё поручение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200412
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200412,
					"content": "#Путешественни{F#ца}{M#к}... Кажется, ты уже хорошо ориентируешься в этих горах. Можно попросить тебя об услуге?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200413
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200413,
					"content": "Чтобы выполнить поручение, мне нужен всего лишь один кусок цельномороженого мяса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200414
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200414,
					"content": "Хорошо, я помогу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200415
					]
				},
				{
					"id": 205200415,
					"content": "Прекрасно. Тогда позволь мне отметить на твоей карте, где именно по словам Харриса должны быть замороженные поросята.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200416
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200416,
					"content": "А я тем временем спущусь в базовый лагерь у подножия и буду ждать тебя там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Томми"
				}
			]
		},
