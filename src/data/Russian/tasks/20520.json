			},
			"dialogs": [
				{
					"id": 205200101,
					"content": "#П-п-путешественни{F#ца}{M#к}... П-п-помоги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200102
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200102,
					"content": "Что с тобой случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200103
					]
				},
				{
					"id": 205200103,
					"content": "В-выручи... Помоги согреться... Н-не то околею...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200104
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200104,
					"content": "Иии-ли д-д-дай съесть чего-нибудь г-горячего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200105
					],
					"speakerTitle": "Томми"
				},
				{
					"id": 205200105,
					"content": "П-п-прошу... К-к-как холодно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Томми"
				}
			]
		},
		{
			"id": 2052002,
