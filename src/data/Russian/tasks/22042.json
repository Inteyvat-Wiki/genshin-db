			"dialogs": [
				{
					"id": 220420301,
					"content": "#Вы вернулись. Ты накормил{F#а} этих негодников?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420302
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420302,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420303
					]
				},
				{
					"id": 220420303,
					"content": "Хорошо. Благодарю тебя. Без твоей помощи эти дети играли бы и играли... а потом остались бы голодными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420304
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420304,
					"content": "Что за непослушные дети. Как они могут принимать людей, которые приходят в святилище, таким образом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				}
			]
		},
