			},
			"dialogs": [
				{
					"id": 220420401,
					"content": "Вы вернулись. Странно. Эти дети внезапно вернулись, и они выглядели испуганными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420402
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420402,
					"content": "Неужели они встретили тех волосатых существ с палками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420403
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420403,
					"content": "Но, по крайней мере, они вернулись... Подожди, что с тобой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420404
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420404,
					"content": "Вообще-то, я...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420405
					]
				},
				{
					"id": 220420405,
					"content": "Ты... непостижимый человек! Что заставило тебя сделать это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420406
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420406,
					"content": "#Ты мог{F#ла} бы просто играть с этими детьми, как обычно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420407
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420407,
					"content": "#Мяу! Неудивительно, что они так испугались... Ты {F#должна}{M#должен} утешить их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420408
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420408,
					"content": "Было ошибкой требовать от всех людей, чтобы они были похожи на Хибики...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				}
			]
		}
