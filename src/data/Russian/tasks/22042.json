			"dialogs": [
				{
					"id": 220420101,
					"content": "Какие вредные котята...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420102
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420102,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420103
					]
				},
				{
					"id": 220420103,
					"content": "А, это ты. Малыши опять сбежали. С каждым днём они всё хуже меня слушаются...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420104,
						220420105
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420104,
					"content": "Нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				},
				{
					"id": 220420106,
					"content": "Теперь, когда вы развесили металлические шарики вокруг святилища, Нэко верит, что они смогут найти дорогу обратно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420107
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420107,
					"content": "Может быть, для них не так уж и плохо немного одичать, чтобы не выставить себя дураками перед людьми и не опозорить святилище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420108
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420108,
					"content": "Но если они переборщат и будут голодать с утра до ночи... Это не очень хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420109
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420109,
					"content": "Отнеси рыбу этим маленьким негодникам, пусть поедят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420110,
						220420113
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420110,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420111
					]
				},
				{
					"id": 220420111,
					"content": "Давай дадим карту Нэко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220420112,
					"content": "Похоже, что у вас нет недостатка в понимании...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420115,
					"content": "Хорошо. Иди, и побыстрее. У Нэко ещё есть дела в святилище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420113,
					"content": "Вот наша карта...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420114
					]
				},
				{
					"id": 220420114,
					"content": "Похоже, что у вас нет недостатка в понимании...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220420105,
					"content": "Нужно их вернуть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				}
			]
		},
