				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940401,
					"content": "Как идёт сбор?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940402
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940402,
					"content": "Мы закончили.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940403
					]
				},
				{
					"id": 726940403,
					"content": "Хорошо, сейчас я помещу материалы в Уникальную Безотказную В Эксплуатации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940404
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940404,
					"content": "В Великолепную машину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940405,
					"content": "Как скажешь. Сейчас мы поместим материалы в нашу Великолепную машину...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940406
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940406,
					"content": "Бертран вставляет коллектор в Великолепную машину.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726940407
					]
				},
				{
					"id": 726940407,
					"content": "Ого! А что потом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940408,
					"content": "А потом эта машина такая вжух-вжух, а игрушки из неё как посыпятся тыщ-тыщ-тыщ, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940409,
					"content": "Ха-ха-ха, это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940410
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940410,
					"content": "...совершенно невозможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940411
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940411,
					"content": "О чём ты думаешь? Это первый этап из трёх, мы ещё далеки от завершения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940412
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940412,
					"content": "Значит, нам надо сначала закончить все этапы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940413,
					"content": "Да, завершить все три этапа. И только тогда получатся игрушки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940414,
						726940415
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940414,
					"content": "Столько хлопот...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				},
				{
					"id": 726940416,
					"content": "Вы только и думаете, как бы поскорее закончить. Чтобы изготовлять игрушки, нужно терпение. Мы должны наполнить каждый этап...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940417
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940417,
					"content": "Наполнить чем? О, Паймон поняла! Мы должны наполнить процесс любовью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940418,
					"content": "Да, моей любовью к море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940419
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940419,
					"content": "Хоть это не то, о чём Паймон подумала, но Паймон любит и мору!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940420,
					"content": "Эй...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940421
					]
				},
				{
					"id": 726940421,
					"content": "Хе-хе, Паймон просто хотела тему поддержать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940422,
					"content": "Бертран, а что нам дальше делать? Приступать к следующему этапу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940423,
					"content": "Не спешите. Я только недавно настроил машину и ещё не до конца её опробовал. Нужно сначала проверить, как она работает с материалами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940424
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940424,
					"content": "Это займёт какое-то время. Приходите попозже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940415,
					"content": "Всё так сложно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				}
			]
		},
