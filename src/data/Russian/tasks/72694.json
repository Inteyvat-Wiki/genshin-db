			"dialogs": [
				{
					"id": 726940501,
					"content": "За одну такую штуку можно выручить немного моры. Мне нужно продать двадцать тысяч, чтобы расплатиться с долгами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940502
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940502,
					"content": "Не так-то просто... У вас есть вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940503,
						726940505
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940503,
					"content": "А что ты будешь продавать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940504
					]
				},
				{
					"id": 726940504,
					"content": "Я собираюсь продавать игрушки... Вот только они ещё не готовы. Приходите, когда они будут сделаны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940505,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940506
					]
				},
				{
					"id": 726940506,
					"content": "Если вам нечего сказать, то не мешайте мне. Я готовлю важные товары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бертран"
				}
			]
		}
