			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940101,
					"content": "#Это же путешественни{F#ца}{M#к} и Паймон! Очень кстати!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940102
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 726940102,
					"content": "Для чего это мы кстати?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940103,
					"content": "Для поручения, которое очень вам подойдёт. Я как раз собиралась вас разыскать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940104
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 726940104,
					"content": "Поручение, которое нам подойдёт... Только не говори Паймон, что ты опять хочешь, чтобы мы что-то нашли или прогнали хиличурлов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940105,
						726940106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940105,
					"content": "Или какой-то мусор подняли с крыши...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				},
				{
					"id": 726940107,
					"content": "Нет-нет, поручение и правда вам очень подходит, и под «подходит» я имею в виду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940108
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 726940108,
					"content": "...что оно не только интересное, но ещё и с щедрой наградой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940109
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 726940109,
					"content": "Щедрая награда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940110,
					"content": "А интересное или нет - уже неважно. Да, Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940111
					]
				},
				{
					"id": 726940111,
					"content": "К-конечно, важно! Так что там за поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940112,
					"content": "Заказчик - торговец игрушками из Фонтейна по имени Бертран. Он приехал продавать свои игрушки в Инадзуме и теперь ищет того, кто бы помог с их изготовлением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940113
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 726940113,
					"content": "Он же торговец, поэтому он назначил солидное вознаграждение, когда отправлял поручение в Гильдию искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940114
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 726940114,
					"content": "Но пока он не может покинуть Рито. Так что если хотите узнать подробности, придётся вам отправиться к нему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940115
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 726940115,
					"content": "Ясно. Тогда мы отправляемся на Рито!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940106,
					"content": "Или посылку странную отвезли...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				}
			]
		},
		{
			"id": 7269402,
			"completionStepIds": [
				7269402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269402",
							"2"
						],
						"stepId": 7269402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бертран"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940201,
					"content": "Ха-ха! Всё готово! Каждую игрушку я буду продавать за тысячи моры... Я продам их десятки тысяч!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940202
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940202,
					"content": "Я с лёгкостью заработаю миллионы... Ха-ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940203
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940203,
					"content": "Привет! Ты Бертран?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940204,
					"content": "Да, он самый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940205
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940205,
					"content": "Вы покупатели, которые прослышали о моих игрушках?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940206
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940206,
					"content": "Жаль, но я не могу пока ничего предложить. Я ещё не запустил производство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940207
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940207,
					"content": "Но не беспокойтесь. Производство сейчас налаживается. Если вы заинтересованы, вы можете внести аванс. Я сообщу вам, когда игрушки будут готовы, и тогда вы заплатите остаток...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940208
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940208,
					"content": "Погоди! Мы не собираемся ничего покупать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940209,
					"content": "О, вот оно как... Тогда говорите быстрее, что хотели, и не отвлекайте меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940210
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940210,
					"content": "Вообще-то моё время стоит дорого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940211
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940211,
					"content": "Ого... Как он резко переменился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940212,
						726940213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940212,
					"content": "Мы пришли тебе помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				},
				{
					"id": 726940214,
					"content": "Так вы мои помощники из Гильдии? Добро пожаловать! Что же вы сразу-то не сказали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940215
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940215,
					"content": "Да, я передал им поручение. Как могу к вам обращаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940216
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940216,
					"content": "(Кажется, он снова сменил тон...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940217,
					"content": "Паймон зовут... Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940218,
					"content": "А тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940219
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940219,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940220
					]
				},
				{
					"id": 726940220,
					"content": "#{NICKNAME}? Где-то я уже слышал это имя. А вы тоже... беглые преступники?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940221,
						726940223
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940221,
					"content": "Бывало и такое...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940222
					]
				},
				{
					"id": 726940222,
					"content": "Наверное, я слышал твоё имя в тюрь... кхм... в гостях у комиссии Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940225,
					"content": "Что ты такого натворил, что тебя схватила комиссия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940226,
					"content": "Ох, ничего такого. Во время последнего производства игрушек возникла малюсенькая проблема...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940227
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940227,
					"content": "Ничего такого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940228,
					"content": "Малюсенькая проблема?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940229
					]
				},
				{
					"id": 726940229,
					"content": "Хи-хи, игрушки взрывались, если случайно задеть запускающее устройство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940230
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940230,
					"content": "Взрывались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940231,
					"content": "Совершенно ничего страшного, и никто не пострадал даже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940232
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940232,
					"content": "Но досины из комиссии Тэнрё без лишних слов конфисковали все мои игрушки... А ведь их можно было продать как милые бомбочки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940233
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940233,
					"content": "Эх, когда я приехал из Фонтейна, я взял заём в Международной торговой ассоциации. Я даже не думал, что меня запрут на Рито и не пустят в другие районы Инадзумы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940234
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940234,
					"content": "Ну эту кашу теперь тебе самому и расхлёбывать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940235,
					"content": "Погоди-ка, ты ещё и Ассоциации денег должен? А как собираешься платить нам за поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940236
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940236,
					"content": "Это ерунда, я ещё не потратил все деньги. Как только я снова начну продавать игрушки, я смогу выплатить долг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940237
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940237,
					"content": "И, конечно же, щедро вас отблагодарю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940238
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940238,
					"content": "А это сработает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940239
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940239,
					"content": "Чуть больше уверенности в инадзумском рынке игрушек! До того, как они начали взрываться, они были популярны... А после этого стали просто нарасхват.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940240
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940240,
					"content": "В любом случае, если мой план провалится, я просто отдам все игрушки Курису.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940241
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940241,
					"content": "Помогите мне, пожалуйста. Хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940242
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940242,
					"content": "А что нам нужно делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940243
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940243,
					"content": "Ну, все мои игрушки производятся машиной, которую я создал, и называется она «Уникальная Безотказная В Эксплуатации Теплотехнологическая Машина Второго Поколения».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940244
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940244,
					"content": "Так вот, что я хочу сказать об Уникальной Безотказной В Эксплуатации Теплотехнологической Машине Второго Поколения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940245
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940245,
					"content": "Язык сломать можно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940246
					]
				},
				{
					"id": 726940246,
					"content": "Ага, Паймон будет звать её...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940247
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940247,
					"content": "Великолепная машина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940248
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940248,
					"content": "Нет-нет, это слишком короткое название! Совершенно не впечатляет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940249
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940249,
					"content": "Бывает, что короткое легче запомнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940250
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940250,
					"content": "Великолепная машина... Паймон так приятно произносить эти слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940251
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940251,
					"content": "Ох... Ну ладно. Мне говорили, что я совершенно не умею придумывать названия. Доверюсь лучше тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940252
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940252,
					"content": "Не скажу, что у Паймон это получается лучше...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940253
					]
				},
				{
					"id": 726940253,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940254
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940254,
					"content": "Ха-ха, в любом случае, моя Великолепная машина может автоматически анализировать добавленные в неё материалы, а затем выбирать наиболее подходящий метод их сборки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940255
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940255,
					"content": "Но в прошлый раз я кое-что намудрил, и из-за этого игрушки взрывались. Но на этот раз я поразмыслил над ошибкой и перестроил машину... Теоретически, всё должно быть в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940256
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940256,
					"content": "Теоретически...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940257
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726940257,
					"content": "Поэтому мне нужны помощники, чтобы её опробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940258
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940258,
					"content": "В целом, процесс подготовки включает в себя три этапа: «Сбор материалов», «Наполнение энергией» и «Активация ядра».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940259
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940259,
					"content": "Сначала соберём сырьё. Нужны первичные или базовые материалы: минералы, фрукты, цветы и так далее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940260
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940260,
					"content": "Затем мы наполним материалы элементарной энергией, чтобы запустить процесс. И, наконец, мы напитаем материалы энергией, извлекаемой из ядер элементарных форм жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940261
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940261,
					"content": "Сегодня мы начнём с первого шага - Сбора материалов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940262
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940262,
					"content": "Вот вам коллектор материалов. Всё, что вы соберёте, помещайте сразу в коллектор, чтобы не загрязнить другими элементами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940263
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940263,
					"content": "Я возьмусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940264
					]
				},
				{
					"id": 726940264,
					"content": "Спасибо. Сейчас я только настрою устройство и можешь приступать к сбору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940223,
					"content": "Что значит, тоже беглые преступники?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940224
					]
				},
				{
					"id": 726940224,
					"content": "Ха-ха, это долгая история. Однажды меня пригласили в комиссию Тэнрё из-за небольшого происшествия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726940213,
					"content": "Ты передавал поручение в Гильдию искателей приключений?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				}
			]
		},
