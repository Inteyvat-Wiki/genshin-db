				"points": []
			},
			"dialogs": [
				{
					"id": 210080000,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080001
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 210080001,
					"content": "Что случилось с факелами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080002
					]
				},
				{
					"id": 210080002,
					"content": "#Привет, путешественн{F#ица}{M#ик}! Видишь три сторожевые башни? На них должны гореть фонари.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080003
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 210080003,
					"content": "По долине Гуйли было непросто передвигаться и в лучшие времена, но сейчас дороги буквально кишат монстрами. Горящие факелы нужны не только, чтобы указывать направление путешественникам. Они означают, что дорога безопасна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080004
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 210080004,
					"content": "Но... Я так сильно увлёкся битвами с монстрами, что совсем забыл заправить факелы... Когда я опомнился, факелы уже потухли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Син Хуо"
				}
			]
		},
		{
			"id": 2100801,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Син Хуо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080101,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080102
					]
				},
				{
					"id": 210080102,
					"content": "Скоро придут проверять факелы... Я смогу их задержать и выиграть немного времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080103
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 210080103,
					"content": "Чего стоишь без дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080104
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 210080104,
					"content": "Передай-ка мне факел, пожалуйста!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Син Хуо"
				}
			]
		},
		{
			"id": 2100802,
			"completionStepIds": [
				2100801
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Син Хуо"
