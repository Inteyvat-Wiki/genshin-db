				"points": []
			},
			"dialogs": [
				{
					"id": 210080201,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080202
					]
				},
				{
					"id": 210080202,
					"content": "Славно. Спасибо тебе большое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080203
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 210080203,
					"content": "Вдоль дороги стоят три сторожевых башни. На каждой башне есть факел. Возвращайся ко мне, когда все факелы будут гореть, хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080204
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 210080204,
					"content": "В конце дороги ты найдёшь статую семи архонтов. Советую тебе навестить гео архонта, может быть, он наградит тебя своей силой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080205
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 210080205,
					"content": "Проще простого, но это всё равно нужно сделать. Пожалуйста, не забудь об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Син Хуо"
				}
			]
		},
		{
