					"nextDialogs": [
						210080502
					]
				},
				{
					"id": 210080502,
					"content": "Они должны были заправить факелы топливом, а я - поджечь их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080503
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 210080503,
					"content": "Звучит несерьёзно, но очень важно, чтобы каждый выполнял свою работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Син Хуо"
				}
			]
		},
