				{
					"id": 210080401,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080402
					]
				},
				{
					"id": 210080402,
					"content": "Долина Гуйли расположена в гористой местности. Некоторые места более холмистые, чем другие. Например, путь к тем сторожевым башням.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080403
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 210080403,
					"content": "Однако восточная сторона долины, которая ближе к морю, более плоская. Если у тебя найдётся время, рекомендую посетить отмель Яогуан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Син Хуо"
				}
			]
		},
		{
			"id": 2100805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
