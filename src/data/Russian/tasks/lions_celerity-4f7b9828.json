			"dialogs": [
				{
					"id": 761480101,
					"content": "А-а-а! Где вы были? Вы Паймон до смерти напугали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761480102,
					"content": "Паймон всё время звала вас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761480103,
					"content": "Почему малышку Паймон не затянуло в Зал безучастия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480104
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480104,
					"content": "Может, потому что кроме еды и сна...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480105
					]
				},
				{
					"id": 761480105,
					"content": "...она больше ни о чём не думает?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480106
					]
				},
				{
					"id": 761480106,
					"content": "Логично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480107
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480107,
					"content": "Похоже, Меланта сильно разозлился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480108
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480108,
					"content": "#Нам нужно срочно отправить {F#путешественницу}{M#путешественника} к Меланте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480109
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480109,
					"content": "Давайте поговорим в другом месте. Здесь небезопасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480110
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480110,
					"content": "Кхе, хотя всем всё равно, но я всё же представлюсь. Привет! Меня зовут Аларэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аларэ"
				}
			]
		},
