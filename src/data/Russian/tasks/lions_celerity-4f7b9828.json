							252.49,
							-645.37,
							394.33
						],
						"pointId": 119
					}
				]
			},
			"dialogs": [
				{
					"id": 761480701,
					"content": "Мы вернулись сюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480702,
					"content": "В прошлый раз я был здесь... если мерить человеческой жизнью, то это было... много-много жизней назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480703,
					"content": "Похоже, мы снова оказались в Зале безучастия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480704,
					"content": "Как же нам выбраться отсюда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "Обычно это достигается с помощью медитации. Научитесь контролировать свой ум и мысли, а затем откажитесь от всех желаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480706,
					"content": "Одним словом, мы должны поддерживать состояние полной пустоты разума.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480707,
					"content": "Звучит довольно просто, но в зависимости от характера человека и степени его желаний, на это может уйти от нескольких лет до нескольких веков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480708,
					"content": "Такой человек, как ты, несёт на плечах судьбу мира. Боюсь, ты не сможешь отказаться от своих желаний. Да и не следует от них отказываться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480709,
					"content": "Что нам теперь делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "Сначала найдём Цайтлинд, а потом придумаем план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "Декс"
				},
				{
					"id": 761480712,
					"content": "Что ты подобрал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "Декс, тебя тоже сюда затянуло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480714,
					"content": "Тогда, возможно, есть шанс всё изменить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480715,
					"content": "Декс созерцатель, а значит, он должен иметь возможность использовать силу, заключённую в этих фрагментах, чтобы открыть путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480716,
					"content": "Им нужно дать название для удобства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480717
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480717,
					"content": "Я слышал об этих изысканных гробах. Их изготовила одна из сестёр хозяйки храма... Кажется, они называются Гробы маранасати.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480718
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761480718,
					"content": "Тогда эти фрагменты будут называться фрагментами забвения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Историй"
				}
			]
		}
	]
}