				"objectNames": [
					"Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030501,
					"content": "Вы собрали предметы для ритуала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030502
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030502,
					"content": "Так, посмотрим... Курильница и лампы семизвездия великолепны. Они будто специально были сделаны для Искусства Адепта. Откуда они у вас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030503
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030503,
					"content": "От Яксы по имени Бронзовый Воробей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030504
					]
				},
				{
					"id": 111030504,
					"content": "А ещё Бронзовый Воробей передаёт тебе привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111030505,
					"content": "Бронзовый Воробей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030506
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030506,
					"content": "...Да, это в его духе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030507
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030507,
					"content": "Я знал, что он не сможет расстаться с Ли Юэ... Надеюсь, теперешнее положение Ли Юэ его утешит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030508
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030508,
					"content": "Ну, давайте начнём подготовку к ритуалу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030509
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030509,
					"content": "В центр поставьте курильницу, а вокруг неё - лампы семизвездия. Украсьте всё холодными растениями. Когда закончите, мы продолжим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030510
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030510,
					"content": "Отлично. Мы подошли к важнейшему шагу «Странствия по снам»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030511
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030511,
					"content": "Ритуал состоит из четырёх частей: подношение благовоний, медитация, заклинание и выпуск стрелы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030512
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030512,
					"content": "Ой... Зачем же всё так сложно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111030513,
					"content": "Искусство Адепта - результат тысяч лет трудов и исследований. К их таинству должно отнестись со всей серьёзностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030514
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030514,
					"content": "В противном случае душа того, кто проводит ритуал, покинет его тело навеки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030515
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030515,
					"content": "Ой, прости! Паймон опять сказала не то!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030516
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111030516,
					"content": "Чтобы поднести благовония, нужно просто их воскурить, мысленно преклоняясь пред Властелином Камня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030517
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030517,
					"content": "Медитация избавит от мыслей и сосредоточит разум на объекте Искусства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030518
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030518,
					"content": "Потом мы должны громко и отчётливо распевать заклинание: «Деваякса, принеси трёх демонов!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030519
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030519,
					"content": "После этого мы выпустим в изваяния Якс по стреле, тем самым скрепляя договор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030520
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030520,
					"content": "Если всё пройдёт по плану, то душа того человека вскоре появится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030521,
						111030522
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030521,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				},
				{
					"id": 111030523,
					"content": "Если вопросов у вас не осталось, приступим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030524
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111030524,
					"content": "Так, сначала подносим благовония? С уважением к Властелину Камня и всё такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111030522,
					"content": "Уф...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				}
			]
		},
