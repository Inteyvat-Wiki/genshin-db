					"nextDialogs": [
						111030707
					]
				},
				{
					"id": 111030707,
					"content": "Искусством Адепта? Ха-ха-ха! Да как ты смеешь притворяться передо мной Адептом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030708
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111030708,
					"content": "Это место... Мне незнакомо. Только что я мирно почивал на постоялом дворе «Ваншу»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111030712,
					"content": "А, это, должно быть... Ну конечно... Ведь я же Адепт. Ха-ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030713
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111030713,
					"content": "И Адепту просто снится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030714
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111030714,
					"content": "Хм... Кажется, этот парень безнадёжен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030715,
						111030716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111030715,
					"content": "Нет, это не сон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030717,
					"content": "А? Сон Адепта священен! Я не потерплю такой наглости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030718
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111030718,
					"content": "Ладно, пора ему навалять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111030716,
					"content": "Во сне не может быть больно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030709,
					"content": "Всё потому, что ты уже мёртв.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030710
					]
				},
				{
					"id": 111030710,
					"content": "М-м-мёртв?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
