				"objectNames": [
					"Верр Голдет"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111031001,
					"content": "Привет, босс! А Звездолов ещё здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031002,
					"content": "Звездолов... Ты имеешь в виду того ненастоящего Адепта в маске?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031003
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 111031003,
					"content": "Он зарегистрировался на имя Ван Пинъань.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031004,
						111031005
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 111031004,
					"content": "Это... Очень обычное имя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				},
				{
					"id": 111031006,
					"content": "Он уже съехал. Сказал, что собирается отправиться в одиночное паломничество.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031007
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 111031007,
					"content": "#Ах, да... Ещё он просил передать это письмо путешественни{F#це}{M#ку} с маленькой говорящей феей, если они придут его искать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031008
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 111031008,
					"content": "Говорящая фея? Это ещё кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031009
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031009,
					"content": "#Эм... Как бы то ни было, {M#путешественник}{F#путешественница} - это ты. Держи письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031010
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 111031010,
					"content": "Он даже оставил нам письмо? Может, это очередная уловка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031011
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031011,
					"content": "Скорее открывай письмо! Паймон сгорает от любопытства!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031019
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031019,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031012
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031012,
					"content": "Ох, кажется он действительно нам кое-что оставил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031013
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031013,
					"content": "И ещё тут... Это же Печать согласия!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031014
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031014,
					"content": "Давненько Паймон не встречала такого тактичного плохого парня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031015,
						111031016
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031015,
					"content": "#Я тронут{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031017,
					"content": "Да... Точно, давай скорее отдадим печать Сяо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031016,
					"content": "Всё благодаря Сяо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031005,
					"content": "Похоже на имя обычного человека.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				}
			]
		},
		{
			"id": 1110311,
			"completionStepIds": [
				1110311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
