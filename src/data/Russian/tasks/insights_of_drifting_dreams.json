			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111031101,
					"content": "А вот и ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031102,
					"content": "Мы принесли Печать согласия обратно. Ты заберёшь её?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031103,
					"content": "Благодарю вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031104
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111031104,
					"content": "Можно принять ваш заказ, господин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031105
					],
					"speakerTitle": "Сю Хуа"
				},
				{
					"id": 111031105,
					"content": "Одну жареную рыбу-тигр, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031106
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111031106,
					"content": "Отлично. Ваш заказ скоро будет готов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031107
					],
					"speakerTitle": "Сю Хуа"
				},
				{
					"id": 111031107,
					"content": "Хм. Ты не заказал миндальный тофу? Странно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031108,
					"content": "Бронзовый Воробей любил есть жареную рыбу-тигр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031109
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111031109,
					"content": "Я хотел... Попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031110
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111031110,
					"content": "Вот...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031111,
					"content": "«Штормом в море рыбу ловлю, бурей в горах зло убиваю...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031112
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111031112,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031113
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111031113,
					"content": "Вам что-то ещё надо? Я привык есть в одиночестве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031114,
						111031115
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111031114,
					"content": "Тогда не будем тебе мешать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				},
				{
					"id": 111031116,
					"content": "#Ага! И вот Паймон и путешественни{F#ца}{M#к} красиво и тихо уходят в закат...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111031115,
					"content": "Пойдём, Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				}
			]
		},
