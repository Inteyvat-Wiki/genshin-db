			"dialogs": [
				{
					"id": 765040701,
					"content": "#{NICKNAME}, Паймон, здравствуйте. Как дела? Что у вас запланировано на сегодня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040702,
						765040703
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 765040702,
					"content": "Да мы просто осматриваемся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "Понятно. Прогулки и фотографирование - отличный способ отвлечься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 765040705,
					"content": "Но я не вижу у вас фотокамеры. Слишком торопились, когда выходили из дома, и забыли взять с собой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 765040703,
					"content": "Заодно ищем места для хороших кадров.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				}
			]
