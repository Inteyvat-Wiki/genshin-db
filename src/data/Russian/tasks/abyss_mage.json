	"talks": [
		{
			"id": 39702,
			"completionStepIds": [
				39702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39702",
							"2"
						],
						"stepId": 39702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дилюк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970201,
					"content": "Орден Бездны... Даже моим осведомителям известно про него совсем немного. Мы знаем, что они считают человечество своим главным врагом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970202
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3970202,
					"content": "Но всё же у меня есть несколько зацепок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970203
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3970203,
					"content": "Так быстро? Ваши осведомители хорошо поработали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970204
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970204,
					"content": "Я не могу понять, почему великий и могучий Анемо Архонт Барбатос нуждается в помощи простых смертных?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3970205,
					"content": "Хм... С чего бы начать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970206
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970206,
					"content": "Люди часто говорят о Семерых, подразумевая семерых Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970207
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970207,
					"content": "Тейват был поделён на семь частей, каждой из которых управлял свой Архонт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970208
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970208,
					"content": "Сила Архонта напрямую зависит от того, как хорошо он управляет своей территорией. Хотя мне лично не очень близка идея «управления». Жителям свободного Мондштадта тоже, я полагаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970209
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970209,
					"content": "«Постройте свободный город, которым будут править свободные люди». Мы не забыли слова Барбатоса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970210
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3970210,
					"content": "Отлично сказано, магистр Джинн!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3970211,
					"content": "Но, возможно, кое-кто почувствовал себя чересчур свободным и совсем перестал уделять внимание городу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3970212,
					"content": "Кхм... Кхе-кхе... Мне пришлось покинуть Мондштадт на долгое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970213
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970213,
					"content": "Так что сейчас я слабейший из семи Архонтов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970214,
						3970215
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970214,
					"content": "Как будто здесь есть, чем гордиться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				},
				{
					"id": 3970216,
					"content": "Я польщён.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970217
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970217,
					"content": "С таким Архонтом и не знаешь, смеяться или плакать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970218
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3970218,
					"content": "Давайте оставим в покое Архонтов и займёмся врагами человечества.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970219
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3970219,
					"content": "<color=#00E1FFFF>Следы мага Бездны</color> обнаружили на <color=#00E1FFFF>винокурне</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970220
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3970220,
					"content": "Не дадим ему далеко уйти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970221
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3970221,
					"content": "Охота начинается.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3970215,
					"content": "Не зря его называют богом свободы!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				}
			]
		},
		{
			"id": 39704,
			"completionStepIds": [
				39704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39704",
							"2"
						],
						"stepId": 39704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970401,
					"content": "А это ещё что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970402
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970402,
					"content": "Странная энергия исходит от мага Бездны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970403
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970403,
					"content": "Кажется, что именно она помогла мне установить контакт с Двалином.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970404
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970405
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970405,
					"content": "#{NICKNAME}, ты знаешь о <color=#00E1FFFF>логове Ужаса Бури</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970406,
						3970408
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970406,
					"content": "Нет, не знаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970407
					]
				},
				{
					"id": 3970407,
					"content": "Но Джинн и господин Дилюк должны знать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970410
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970410,
					"content": "После пробуждения Двалин обосновался в древних руинах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970411
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970411,
					"content": "Особая магия преграждала вход в руины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970412
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970412,
					"content": "Но после того как рассеялась энергия мага Бездны, я услышал магическую мелодию, из которой сотворён тот барьер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970413
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970413,
					"content": "Звучит это хуже, чем хор хиличурлов, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970414
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970414,
					"content": "...но должно помочь нам прорваться через ветряные барьеры и добраться до <color=#00E1FFFF>логова Ужаса бури</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970415
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970415,
					"content": "Это значит, что мы собираемся сразиться с драконом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970416
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3970416,
					"content": "Я не против... Это Джинн хочет избежать прямого столкновения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970417
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3970417,
					"content": "Нет. Если у нас не остаётся иного выбора, мы должны это сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970418
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3970418,
					"content": "Я готова лично повести рыцарей в атаку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970419
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3970419,
					"content": "К счастью, мы можем этого избежать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970420
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970420,
					"content": "Гм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970421
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3970421,
					"content": "Венти, ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970422
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3970422,
					"content": "Я хочу сказать, что ещё не всё потеряно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970423
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970423,
					"content": "#У нас есть {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970424
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970424,
					"content": "#{NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970425,
						3970427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3970425,
					"content": "Из-за того, что я могу очищать кристаллы в форме слезы от мути, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970426
					]
				},
				{
					"id": 3970426,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970430,
					"content": "Муть в кристаллах и проклятие, которое сковывает Двалина, состоят из одной и той же злой энергии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970431
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970431,
					"content": "А это значит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970432
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970432,
					"content": "Это слишком опасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970433
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3970433,
					"content": "Ты не успеешь и глазом моргнуть, как дракон перекусит тебя пополам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970434,
						3970435
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3970434,
					"content": "Спасибо, что веришь в мои силы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970436,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970437
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3970437,
					"content": "Хороший план. Стоит попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970438
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3970438,
					"content": "Почётный рыцарь, я с тобой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970439
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3970439,
					"content": "Рыцари ордена против чудовищ из Бездны и настоящего дракона. Как круто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970440
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3970440,
					"content": "Чувства - это то, что делает нас людьми. К оружию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970441
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3970441,
					"content": "Тогда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970442
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970442,
					"content": "Заключительный акт нашей героической эпопеи начинается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970435,
					"content": "#Я готов{F#а} пожертвовать всем ради победы!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970427,
					"content": "Ты хочешь сказать, что я непобедимый воин?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970428
					]
				},
				{
					"id": 3970428,
					"content": "Ммм, да! Твоя сила в бою впечатляет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970429
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970429,
					"content": "Но у тебя есть ещё одна уникальная способность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3970408,
					"content": "#Кажется, я слышал{F#а}, как в Мондштадте говорили о нём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970409
					]
				},
