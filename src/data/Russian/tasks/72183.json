				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мадарамэ Хякубэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721830101,
					"content": "Это... семена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721830102,
					"content": "Это семена травы наку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830103
					],
					"speakerTitle": "Мадарамэ Хякубэй"
				},
				{
					"id": 721830103,
					"content": "Вам знакомо это растение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830104
					]
				},
				{
					"id": 721830104,
					"content": "Ну, оно мне немного знакомо. Я его раньше видел и слышал, как люди рассказывали о его чудесах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830105
					],
					"speakerTitle": "Мадарамэ Хякубэй"
				},
				{
					"id": 721830105,
					"content": "Я помню... Даже в безветренную погоду это растение слегка подрагивает со звуком грома...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830106
					],
					"speakerTitle": "Мадарамэ Хякубэй"
				},
				{
					"id": 721830106,
					"content": "Оно красивое, когда вырастает?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830107
					]
				},
				{
					"id": 721830107,
					"content": "Говоря только о внешнем виде... Да, думаю, оно очень красивое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830108
					],
					"speakerTitle": "Мадарамэ Хякубэй"
				},
				{
					"id": 721830108,
					"content": "Вам хотелось бы попробовать вырастить траву наку? Увы, но подходящей земли поблизости нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830109
					],
					"speakerTitle": "Мадарамэ Хякубэй"
				},
				{
					"id": 721830109,
					"content": "У меня есть своя собственная земля.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830110
					]
				},
				{
					"id": 721830110,
					"content": "О, правда? Как и следовало ожидать... Вам уже даровали землю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830111
					],
					"speakerTitle": "Мадарамэ Хякубэй"
				},
				{
					"id": 721830111,
					"content": "Тогда прошу прощения за вопрос. Ваша земля, она...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830112,
						721830115
					],
					"speakerTitle": "Мадарамэ Хякубэй"
				},
				{
					"id": 721830112,
					"content": "Она не в Инадзуме.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830113
					]
				},
				{
					"id": 721830113,
					"content": "#А! {F#Госпожа}{M#Господин}, я также наслышан о ваших подвигах в Мондштадте и Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830114
					],
					"speakerTitle": "Мадарамэ Хякубэй"
				},
				{
					"id": 721830114,
					"content": "#{F#Госпожа}{M#Господин}, за такие подвиги немудрено получить землю, так что ничего удивительного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "Мадарамэ Хякубэй"
				},
				{
					"id": 721830120,
					"content": "#Эй, {NICKNAME}, земля, о которой ты говоришь, - это чайник безмятежности, что подарила нам бабушка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721830121,
					"content": "Неужели в нём и правда можно что-то вырастить? Бабушка об этом ничего не говорила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830122,
						721830124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721830122,
					"content": "Вернёмся и спросим у неё.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830123
					]
				},
				{
					"id": 721830123,
					"content": "Ладно, вернёмся и спросим у бабушки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721830124,
					"content": "В конце концов, Адепты очень могущественны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830125
					]
				},
				{
					"id": 721830125,
					"content": "Правда? Но бабушка и правда очень сильна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721830126,
					"content": "Ладно, вернёмся и спросим у бабушки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721830115,
					"content": "На самом деле, она в чайнике.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830116
					]
				},
				{
					"id": 721830116,
					"content": "#В ч-чайнике? {F#Госпожа}{M#Господин}, не шутите так со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830117
					],
					"speakerTitle": "Мадарамэ Хякубэй"
				},
				{
					"id": 721830117,
					"content": "#{F#Госпожа}{M#Господин}, я также слышал о ваших подвигах в Мондштадте и Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830118
					],
					"speakerTitle": "Мадарамэ Хякубэй"
				},
				{
					"id": 721830118,
					"content": "Полагаю, ваша земля либо в Ли Юэ, либо в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830119
					],
					"speakerTitle": "Мадарамэ Хякубэй"
				},
				{
					"id": 721830119,
					"content": "#{F#Госпожа}{M#Господин}, иного от вас нельзя было ожидать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "Мадарамэ Хякубэй"
				}
			]
		},
		{
			"id": 7218302,
			"completionStepIds": [
				7218302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7218302",
							"2"
						],
						"stepId": 7218302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мадам Пин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721830201,
					"content": "Хм-м? Здравствуйте, детки! Вы пришли повидать меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830202
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 721830202,
					"content": "Хотим спросить о семенах травы наку...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830203
					]
				},
				{
					"id": 721830203,
					"content": "О семенах... Что, хотите вырастить эти семена в чайнике безмятежности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830204
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 721830204,
					"content": "Думаю, это вполне возможно, ведь чайник безмятежности - это маленькое королевство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830205
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 721830205,
					"content": "Но сегодня вы принесли лишь этот мешочек с семенами. Вы собираетесь посадить только семена из этого мешочка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830206
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 721830206,
					"content": "О, точно! Мы даже не знаем, как собирать семена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721830207,
					"content": "Когда мы высадим этот мешочек семян, где нам взять ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721830208,
					"content": "Хорошо, хорошо, не волнуйтесь. У меня как раз есть коробочка, которой я пользовалась много лет назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830209
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 721830209,
					"content": "Когда раньше я сажала цветы, я держала их все в этой коробочке. Выращенные в ней цветы можно сохранить надолго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830210
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 721830210,
					"content": "А кроме того, если поместить цветок в коробочку, он может дать несколько семян... Это очень удобно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830211
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 721830211,
					"content": "И хотя сейчас от коробочки проку мало... Но, по крайней мере, она сохранила способность «производить семена».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830212
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 721830212,
					"content": "Хм-м... Я сейчас всё равно почти не пользуюсь коробочкой... Так что отдаю её вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830213
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 721830213,
					"content": "Эта коробочка придётся кстати, если вы захотите выращивать цветы, растения или ещё какие-нибудь культуры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830214
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 721830214,
					"content": "Спасибо вам, бабушка!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830215
					]
				},
				{
					"id": 721830215,
					"content": "Спасибо вам, бабушка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721830216,
					"content": "О детки, вовсе необязательно быть такими вежливыми. Берите и пробуйте. Но хочу предостеречь вас, что заботиться о цветах и растениях - дело непростое, так что будьте к этому готовы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830217
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 721830217,
					"content": "Бабушка и правда мощная... Но прежде чем мы попробуем коробочку, давай вернёмся к чайнику и посадим семена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721830218,
					"content": "Хм-м, Паймон действительно надеется, что эти семена скоро взойдут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}