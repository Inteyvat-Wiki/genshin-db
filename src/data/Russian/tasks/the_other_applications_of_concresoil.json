			"dialogs": [
				{
					"id": 230090201,
					"content": "А мне нужно купить кое-какой материал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090202
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230090202,
					"content": "Как твой глинобетон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090203
					]
				},
				{
					"id": 230090203,
					"content": "Просто великолепно! Его область применения превзошла все мои ожидания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090204
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230090204,
					"content": "Такую глину можно использовать в гончарном деле, а также для устранения протечек в доме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090205
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230090205,
					"content": "А если немного подправить пропорции смеси, из неё можно строить здания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090206
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230090206,
					"content": "Но поскольку все её заказывают, у меня стало не хватать материала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090207
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230090207,
					"content": "#Самое главное - у меня закончилась слизь слайма. Путешественни{F#ца}{M#к}, ты можешь снова принести мне три порции слизи слайма?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090208,
						230090209
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230090208,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090212
					]
				},
				{
					"id": 230090212,
					"content": "#Прошу тебя, путешественни{F#ца}{M#к}, принеси мне три порции слизи слайма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аким"
				},
				{
					"id": 230090209,
					"content": "А другие материалы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090210
					]
				},
				{
					"id": 230090210,
					"content": "Другие материалы я уже заказал или попросил друзей найти их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090211
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230090211,
					"content": "Однако слизь слайма расходуется быстрее, чем я думал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090212
					],
					"speakerTitle": "Аким"
				}
			]
		},
