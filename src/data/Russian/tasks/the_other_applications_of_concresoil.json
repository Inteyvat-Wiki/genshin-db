			"dialogs": [
				{
					"id": 230091401,
					"content": "Проклятье, где же я ошибся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091402
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091402,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091403
					]
				},
				{
					"id": 230091403,
					"content": "#А, это ты, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091404
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091404,
					"content": "Ох, с моим глинобетоном случилась беда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091405
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091405,
					"content": "То ли с моей формулой что-то не так, то ли я провёл недостаточно испытаний...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091406
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091406,
					"content": "Немало людей, купивших глинобетон, пожаловались, что после возведения кухни через несколько дней он потрескался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091407
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091407,
					"content": "Возможно, высокая температура повлияла на структуру глины...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091408
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091408,
					"content": "В общем, мне нужно помочь им в исправлении недостатков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091409
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091409,
					"content": "Поскольку слишком многим требуется ремонт, я не успевал забрать оставшийся глинобетон и попросил их поместить материал в горшки. Эх, несколько больших горшков...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091410
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091410,
					"content": "#Путешественни{F#ца}{M#к}, помоги мне забрать выброшенный глинобетон из этого дома, а я поспешу к другим покупателям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091411
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091411,
					"content": "Эх, так в чём же причина проблемы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аким"
				}
			]
		},
