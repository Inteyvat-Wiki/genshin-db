			},
			"dialogs": [
				{
					"id": 230091701,
					"content": "Спасибо тебе. Ну вот, материал весь собран.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091702
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091702,
					"content": "Подожди немного. Я сейчас приготовлю глинобетон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091703
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091703,
					"content": "Аким начинает готовить глину...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230091704
					]
				},
				{
					"id": 230091704,
					"content": "#Готово! Путешественни{F#ца}{M#к} отнеси эту глину Ниме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091705
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091705,
					"content": "Он давно её ждёт, поэтому поспеши.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091706
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091706,
					"content": "У этого ребёнка богатое воображение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091707
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091707,
					"content": "Нима сказал мне, что хочет сделать глиняных воинов, которые будут разговаривать, сражаться с врагами и применять необычные способности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091708
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091708,
					"content": "А способности глиняных воинов будут зависеть от материалов, которыми он их наполнит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091709
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091709,
					"content": "Он даже дал им имена. Одного зовут как-то на «А»... Не помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091710
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091710,
					"content": "Ха-ха, у мальчика действительно богатое воображение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091711
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091711,
					"content": "Поэтому я подумал, раз у него такая интересная идея, то почему бы не подарить ему глину...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091712
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091712,
					"content": "Так он сможет собственными руками слепить глиняных воинов и побыть их полководцем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091713
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091713,
					"content": "Ну всё, а теперь отнеси эту глину Ниме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091714
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230091714,
					"content": "Пусть он лепит своих глиняных воинов. Кто знает, может, он присвоит тебе и мне звание глиняного генерала, ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аким"
				}
			]
		},
