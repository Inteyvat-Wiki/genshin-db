				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзя И"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411260101,
					"content": "Эх... Что же мне делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260102
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260102,
					"content": "Что произошло?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260103
					]
				},
				{
					"id": 411260103,
					"content": "#Должно быть, ты видел{F#а} метеориты, которые упали с небес. К счастью, город не пострадал, но за пределами города царит настоящий хаос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260104
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260104,
					"content": "Метеориты не только заблокировали дороги, но и разозлили местных монстров. Теперь они нападают на торговцев и путешественников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260105
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260105,
					"content": "Департамент по делам граждан уже задействовал всех Миллелитов, но территория Ли Юэ просто огромна. Мы можем обеспечить безопасность только лишь на главных дорогах и в крупных деревнях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260106
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260106,
					"content": "Я подал заявление на перевод в деревню Цинцэ, чтобы продолжить караульную службу там. Но меня почему-то пока не торопятся переводить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260107
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260107,
					"content": "#Путешественн{F#ица}{M#ик}, можешь передать это письмо малышке Лю из деревни Цинцэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260108
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260108,
					"content": "Она моя дочурка. Я уже договорился об увольнительной и собирался провести с ней несколько дней. Но из-за непредвиденных обстоятельств, я уже и не знаю, когда смогу вернуться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260109,
						411260111
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260109,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260110
					]
				},
				{
					"id": 411260110,
					"content": "#Спасибо, путешественни{F#ца}{M#к}! Ох, как же всё это не кстати...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260115,
					"content": "Коллеги, которые пришли со смены, говорят, что у деревни Цинцэ собралось много монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260116
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260116,
					"content": "#Эм... Не хочу навязываться, но... Судя по твоей экипировке, ты искатель{F#ница} приключений, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260117
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260117,
					"content": "#Когда ты придёшь в Цинцэ с письмом, не мог{F#ла} бы ты заодно очистить окрестности деревни от монстров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260118
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260118,
					"content": "Обычно Миллелиты охраняют дороги и важные переходы... Если монстры проникнут в деревню Цинцэ, будет беда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260119,
						411260121
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260119,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260120
					]
				},
				{
					"id": 411260120,
					"content": "Спасибо! Для меня это важно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260121,
					"content": "Тогда будь готов приплатить сверху.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260122
					]
				},
				{
					"id": 411260122,
					"content": "Э, ну... Не волнуйся, я позабочусь о соответствующей награде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260123
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260123,
					"content": "Благодарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260111,
					"content": "От тебя это не зависит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260112
					]
				},
				{
					"id": 411260112,
					"content": "Я знаю, но... Почему всегда так? Каждый раз, когда я беру увольнительную, обязательно что-то случается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260113
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260113,
					"content": "Назвать это совпадением язык уже не поворачивается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260114
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 411260114,
					"content": "Спасибо, что помогаешь мне. Пожалуйста, отнеси это письмо малышке Лю в деревню Цинцэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Цзя И"
				}
			]
		},
