			},
			"dialogs": [
				{
					"id": 705170101,
					"content": "Здесь всё выглядит довольно обычным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170102,
					"content": "Не могу найти ничего съестного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170103,
						705170104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170103,
					"content": "Вот ты и проболталась.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				},
				{
					"id": 705170105,
					"content": "Кхм, во время расследования разных тайн никогда не помешает подкрепиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170106,
					"content": "#Ты ведь тоже немного устал{F#а} от всех этих перекусов на ходу, которые мы устраиваем в последнее время, чтобы сэкономить время?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170107,
					"content": "Если соберём на пляже ракушки, то сможем потушить их с фруктами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170108,
					"content": "Свежие, сладкие, упругие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170109,
						705170111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170109,
					"content": "Звучит не очень аппетитно, есть сразу расхотелось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170110
					]
				},
				{
					"id": 705170110,
					"content": "Попробуй, возможно, ты откроешь для себя новый дивный мир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170113,
					"content": "#{NICKNAME}, посмотри туда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170114,
					"content": "Там внезапно появился какой-то механизм... Очень странные дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170115,
					"content": "Ещё и вещи какие-то везде разбросаны. Это вещи Фатуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170116,
					"content": "Паймон проявляет чудеса сообразительности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170117
					]
				},
				{
					"id": 705170117,
					"content": "Ура! Паймон угадала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170118,
					"content": "Хотя чему я радуюсь? У нас же снова проблемы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170119,
					"content": "Вещи Фатуи кругом... А где Фатуи, там и разные тёмные делишки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170120,
					"content": "Если оставить всё как есть, они наберутся сил, и с ними потом не оберёшься хлопот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170121,
					"content": "Так что давай посмотрим, что можно сделать с этим механизмом, поковыряемся в вещичках Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170122,
					"content": "#{NICKNAME}, покажем класс, как всегда. А когда разберёмся с ними, можно смело вернуться к поиску вкусняшек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170111,
					"content": "Чем-то похоже на Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170112
					]
				},
				{
					"id": 705170112,
					"content": "Что? Паймон не еда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705170104,
					"content": "Теперь понятно, с чего ты такая деятельная.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				}
			]
		}
	]
}