			"dialogs": [
				{
					"id": 4630001,
					"content": "Нам пришлось хорошенько постараться, чтобы разгадать все эти загадки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630014
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630014,
					"content": "Не хочу никого обидеть, но эта карта выглядит ужасно... Словно её пират нарисовал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630002,
					"content": "Значит мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630003,
						4630005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630003,
					"content": "Кэйа ждёт наш доклад.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630004
					]
				},
				{
					"id": 4630004,
					"content": "Ну... Можно же НЕ ДЕЛАТЬ ЭТОТ ДОКЛАД!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630006
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630006,
					"content": "Ты читаешь мои мысли! Пойдём скорей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630007
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630007,
					"content": "Поспешим! Не хочу, чтобы кто-то нашёл сокровища раньше нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630008
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630008,
					"content": "Например, те самые Похитители сокровищ, о которых рассказывал Кэйа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630009
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630009,
					"content": "В любом случае мне нужен этот меч, чтобы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630010
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630010,
					"content": "Нет-нет! Паймон только посмотрит. Мы только хотим его увидеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630011
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630011,
					"content": "Мы хотим стать самыми могущественными, и сильными, и ничего потом не делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630012
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630012,
					"content": "Хорошо. Поболтаем позже. Когда заберём нашу прелесть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630013
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630013,
					"content": "Охота за сокровищами Аркадии продолжается!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630005,
					"content": "Пойдём за сокровищами!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630006
					]
				}
			]
		},
