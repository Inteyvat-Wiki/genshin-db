			"dialogs": [
				{
					"id": 4630101,
					"content": "А вот и руины Аркадии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630102,
					"content": "Слишком просто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630103,
					"content": "А, я поняла! Если хочешь что-то спрятать, положи это на самое видное место!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630104,
					"content": "Дедушка Кэйи отлично придумал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630105,
					"content": "*Топот*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630106
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630106,
					"content": "Паймон, ты это слышала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630107
					]
				},
				{
					"id": 4630107,
					"content": "Это мышь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630108,
					"content": "Послушай!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630109
					]
				},
				{
					"id": 4630109,
					"content": "На это нет времени. Нас ждут сокровища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630110,
					"content": "Поспешим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 46303,
			"completionStepIds": [
				46303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
