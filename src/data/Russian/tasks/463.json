					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4630301,
					"content": "Это всё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630302,
					"content": "Сокровище! Где ты, моя прелесть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630303,
					"content": "#{NICKNAME}, давай поищем повнимательнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630304,
					"content": "Ха-ха-ха! Не тратьте своё время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630305
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630305,
					"content": "Теперь этим займусь я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630306,
						4630308
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630306,
					"content": "Похитители сокровищ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630307
					]
				},
				{
					"id": 4630307,
					"content": "#Ты догадал{M#ся}{F#ась}, но уже слишком поздно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630311
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630311,
					"content": "Приветствую! Моё имя - Иззард.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630312
					],
					"speakerTitle": "Иззард"
				},
				{
					"id": 4630312,
					"content": "От имени Похитителей сокровищ я благодарю вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630313
					],
					"speakerTitle": "Иззард"
				},
				{
					"id": 4630313,
					"content": "Ах вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630314,
					"content": "Как вы узнали? Мы старались всё сделать по-тихому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630315,
					"content": "Неудивительно, что вы об этом узнали.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630316
					]
				},
				{
					"id": 4630316,
					"content": "Я не отдам сокровище без боя! Это моя прелесть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630317,
					"content": "Не стоит нас недооценивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630318
					],
					"speakerTitle": "Иззард"
				},
				{
					"id": 4630318,
					"content": "Снаружи меня ждёт моя банда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630319
					],
					"speakerTitle": "Иззард"
				},
				{
					"id": 4630319,
					"content": "Не думаю, что они захотят с вами разговаривать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630320
					],
					"speakerTitle": "Иззард"
				},
				{
					"id": 4630320,
					"content": "(Заходят Кэйа и рыцари Ордо Фавониус)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630321
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4630321,
					"content": "Извините, что без приглашения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630322
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4630322,
					"content": "Что касается твоей банды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630323
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4630323,
					"content": "Ты сможешь навестить их в мондштадтской тюрьме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630324
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4630324,
					"content": "А ещё лучше - поселиться там вместе с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630325
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4630325,
					"content": "Рыцари?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630326
					],
					"speakerTitle": "Иззард"
				},
				{
					"id": 4630326,
					"content": "Кэйа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630327,
					"content": "Кэйа, он хочет украсть сокровища, арестуй его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630328
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630328,
					"content": "Почти... получилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630329
					],
					"speakerTitle": "Иззард"
				},
				{
					"id": 4630329,
					"content": "Сокровища...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630330
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4630330,
					"content": "Прости, но нет никаких сокровищ. И никогда не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630331
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4630331,
					"content": "Вы проделали всю эту работу... Напрасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630332
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4630332,
					"content": "ЧТО?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630333
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630333,
					"content": "Нет... сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630334
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630334,
					"content": "Кэйа сказал, что сокровищ нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630335
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4630335,
					"content": "Ха-ха-ха! Здорово вам удалось провести меня. Не думал, что рыцари пойдут на такое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630336
					],
					"speakerTitle": "Иззард"
				},
				{
					"id": 4630336,
					"content": "Вор не имеет никакого права критиковать методы рыцарей ордена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630337
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4630337,
