			"dialogs": [
				{
					"id": 250200501,
					"content": "Уй, у-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200502
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250200502,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200503
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250200503,
					"content": "Довольный Хора схватил дрифтбол и нырнул в пруд. Вода смыла с него всю грязь...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250200504
					]
				},
				{
					"id": 250200504,
					"content": "Ха-ха-ха, похоже, дрифтбол пришёлся этому негоднику по вкусу. Он играет с ним прямо в пруду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200505
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250200505,
					"content": "Пойдёмте. Неплохая вышла помывка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200506
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250200506,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200507
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250200507,
					"content": "Ну что, малыш, нравится мой подарок? Он твой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200508
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250200508,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200509
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250200509,
					"content": "Да, непросто тебя искупать... Но теперь, ха-ха-ха, я, похоже, знаю, как с тобой справляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200510
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250200510,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200511
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250200511,
					"content": "Зачем ты прикасаешься к моей руке? Эти раны... Ерунда, не переживай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200512
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250200512,
					"content": "Уй, у-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200513
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250200513,
					"content": "Ты чего приуныл? Разве тебе невесело? Уже надоело играть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200514
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250200514,
					"content": "Спасибо! Держи, это тебе. Считай это вознаграждением. Внутри нет ничего ценного, так что бери, не думай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200515
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250200515,
					"content": "Уй, у-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200516
					],
					"speakerTitle": "Хора"
				},
				{
