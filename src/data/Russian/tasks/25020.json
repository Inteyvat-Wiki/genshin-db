				"points": []
			},
			"dialogs": [
				{
					"id": 250201001,
					"content": "Это то, что нужно. Спасибо! Я... Уф!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201002
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250201002,
					"content": "Прошу прощения... Я повредил палец, когда вязал каркас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201003
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250201003,
					"content": "Я плохо справляюсь с такой филигранной работой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201004
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250201004,
					"content": "Минутку, я привяжу стебли пепельника к каркасу и накрою их тканью...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201005
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250201005,
					"content": "Кацкаль продолжал бороться с дрифтболом... и после трёх новых ран на руке он наконец-то одержал над дрифтболом верх...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250201006
					]
				},
				{
					"id": 250201006,
					"content": "Отлично! Теперь отыщем Хору, он наверняка опять роет землю под тем деревом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201007
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250201007,
					"content": "Было бы неплохо перевязать руку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250201008
					]
				},
				{
					"id": 250201008,
					"content": "Не стоит беспокоиться, это всего лишь царапина, я потом просто чем-нибудь её оберну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201009
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250201009,
					"content": "Давайте отыщем Хору, пока он не обезумел от веселья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кацкаль"
				}
			]
		},
