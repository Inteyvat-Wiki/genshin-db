			"dialogs": [
				{
					"id": 200650101,
					"content": "Ох, какая головная боль! Что же мне с этим делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650102
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200650102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650103
					]
				},
				{
					"id": 200650103,
					"content": "Готовлюсь к отборочным соревнованиям в Ордо Фавониус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650104
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200650104,
					"content": "Ах... Но мне никогда не стать такой же сильной, как Джинн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650105
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200650105,
					"content": "Нужно больше уделять внимание технике, а не силе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650106
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200650106,
					"content": "Например, я хочу срубить все эти деревянные чучела одним ударом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650107
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200650107,
					"content": "Ого! А они крепче, чем кажется. Уж не знаю, где папаша их достал, но он неплохо постарался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айлин"
				}
			]
		},
