				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200120201,
					"content": "#Спасибо, путешественн{F#ица}{M#ик}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120202
					],
					"speakerTitle": "Паникующая Мирана"
				},
				{
					"id": 200120202,
					"content": "Эх... Дорогу перекрыли, на меня напали... А мне дома и так хлопот хватает, я хотела всего лишь немного развеяться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120203
					],
					"speakerTitle": "Паникующая Мирана"
				},
				{
					"id": 200120203,
					"content": "Ты поможешь мне расчистить дорогу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120204,
						200120205
					],
					"speakerTitle": "Паникующая Мирана"
				},
				{
					"id": 200120204,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120206
					]
				},
				{
					"id": 200120206,
					"content": "Спасибо тебе! Надеюсь, мои дети будут похожи на тебя, когда вырастут!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паникующая Мирана"
				},
				{
					"id": 200120205,
					"content": "Мне некогда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120207
					]
				},
				{
					"id": 200120207,
					"content": "Пожалуйста, помоги мне... Это не займёт много времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паникующая Мирана"
				}
			]
		},
