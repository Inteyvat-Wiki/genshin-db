					"Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350301,
					"content": "#Благодарю тебя, могущественный Адепт! И тебе спасибо, {M#всесильный герой}{F#всесильная героиня}! Какое совпадение, что мы снова встретились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350302
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350302,
					"content": "Мы знакомы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350303,
					"content": "Разве можно забыть лик Адепта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350304
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350304,
					"content": "Ты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350305
					]
				},
				{
					"id": 710350305,
					"content": "Я Ван Пинъань, разве вы не помните меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350306,
						710350308
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350306,
					"content": "Небесный Император Звездолов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350307
					]
				},
				{
					"id": 710350307,
					"content": "А?! Звездолов? Смерти моей хочешь? Адепт всё ещё здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350310,
					"content": "Я готовился сделать подношение в храме Бронзового Воробья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350311
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350311,
					"content": "Но вскоре после того, как я поднялся в горы, на меня напали эти Похитители сокровищ. Спасибо, что спасли меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350312
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350312,
					"content": "Минуточку, зачем ты шёл в храм Бронзового Воробья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350313,
					"content": "Ты собирался сделать что-то плохое с его статуей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350314,
					"content": "Нет! Даже в мыслях не было!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350315
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350315,
					"content": "Тогда что ты собирался делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350316
					]
				},
				{
					"id": 710350316,
					"content": "Я... хотел восстановить храм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350317
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350317,
					"content": "Сегодня я планировал оценить состояние храма и купить необходимые материалы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350318
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350318,
					"content": "Не думал, что по пути на меня нападут Похитители сокровищ и придётся спасаться бегством.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350319
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350319,
					"content": "Я бежал куда глаза глядят и... заблудился. Дальше вы всё знаете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350320
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350320,
					"content": "Давай продолжим разговор в храме.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350321
					]
				},
				{
					"id": 710350321,
					"content": "Согласен, это не лучшее место для разговора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350322
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350322,
					"content": "Поговорим в храме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350323
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350323,
					"content": "Вы идите, а у меня есть другие дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350324
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 710350324,
					"content": "А? Уже уходишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350325,
					"content": "Ушёл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350308,
					"content": "Я помню тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350309
					]
				},
				{
					"id": 710350309,
					"content": "Слава Архонтам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "Ван Пинъань"
				}
			]
		},
		{
			"id": 7103504,
			"completionStepIds": [
				7103508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103508",
							"2"
						],
						"stepId": 7103508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ван Пинъань",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350401,
					"content": "Подумать только, храм в таком ужасном состоянии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350402
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350402,
					"content": "Итак, с чего у тебя вдруг возникла идея восстановить храм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350403,
					"content": "Ну... Это долгая история...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350404
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350404,
					"content": "Пока я притворялся Адептом, я собрал для этого много материалов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350405
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350405,
					"content": "Но после того урока, который преподал мне Адепт, я поклялся творить добро. Я уже приготовился уничтожить эти материалы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350406
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350406,
					"content": "Как вдруг мне в голову пришла идея. Вместо того чтобы просто уничтожить их, я мог бы поделиться этими материалами, включая мой справочник шарлатанства, с другими людьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350407
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350407,
					"content": "Я могу помочь другим распознавать мошенников и обманщиков...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350408
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350408,
					"content": "Я не ожидал, что написанный мною справочник поможет стольким людям. Даже в Департаменте по делам граждан сказали, что это очень полезная книга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350409
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350409,
					"content": "Они не только поделились со мной методами борьбы с мошенниками, которые я добавил в справочник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350410
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350410,
					"content": "...но и заплатили мне приличную сумму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350411
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350411,
					"content": "В ближайшее время я планирую написать книгу о Защитнике Яксе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350412
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350412,
					"content": "Её целью будет рассказать всем о его подвигах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350413
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350413,
					"content": "Я смогу с пользой использовать свои знания фольклора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350414
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350414,
					"content": "Я обнаружил храм Бронзового Воробья, когда собирал материалы для второй книги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350415
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350415,
					"content": "Здесь написано, что храм был построен в память о Яксе по имени Бронзовый Воробей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350416
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350416,
					"content": "Но я никак не ожидал найти храм в таком плачевном состоянии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350417
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350417,
					"content": "Когда я подумал об этом, то решил профинансировать ремонт этого храма из своего кармана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350418
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350418,
					"content": "В конце концов, меня тоже наставил на путь истинный один из Адептов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350419
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350419,
					"content": "Полагаю, ремонт этого храма можно считать искуплением моих прежних проступков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350420
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350420,
					"content": "Похоже, он не врёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350421,
					"content": "#Как ты думаешь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350422,
						710350424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350422,
					"content": "Звучит вполне искренне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350423
					]
				},
				{
					"id": 710350423,
					"content": "Что значит вполне искренне? Это чистейшая правда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350426,
					"content": "А, неважно. Думайте, что хотите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350427
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350427,
					"content": "Если не верите, то приходите, когда работы по восстановлению храма начнутся. Сами всё увидите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350424,
					"content": "Ну, совсем недавно ты был мошенником...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350425
					]
				},
				{
					"id": 710350425,
					"content": "Я изменился! Я теперь добропорядочный гражданин! Разве я не поклялся стать таким перед Адептом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Ван Пинъань"
				}
			]
		},
