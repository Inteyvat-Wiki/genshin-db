				"points": []
			},
			"dialogs": [
				{
					"id": 710350201,
					"content": "А вы что здесь делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350202
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 710350202,
					"content": "Ты тоже пришёл навестить Бронзового Воробья?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350203
					]
				},
				{
					"id": 710350203,
					"content": "Просто проходил мимо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350204
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 710350204,
					"content": "А вы здесь зачем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350205
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 710350205,
					"content": "Мы пришли навестить Бронзового Воробья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350206,
					"content": "Здесь всё та же разруха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350207,
					"content": "Ведь построили храм, сделали статую... Почему же никто не ухаживает за этим местом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350208,
					"content": "Наверное, о нём все забыли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350209
					]
				},
				{
					"id": 710350209,
					"content": "Но как так? Яксы ведь герои, защитившие Ли Юэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350211
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 710350211,
					"content": "Сяо, ты... злишься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350212,
					"content": "Нет. Яксы выполняют свой долг не ради признания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350213
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 710350213,
					"content": "Давайте не будем об этом. Нас ждёт жареная рыба-тигр!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350214,
					"content": "Сяо, мы можем разделить с тобой наши порции, если хочешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350215,
					"content": "Не нужно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350216
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 710350216,
					"content": "Спасите! На помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350217
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 710350217,
					"content": "Кажется, Паймон что-то слышала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350218,
					"content": "Кто-то зовёт на помощь! Вон там!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350219
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 710350219,
					"content": "Нужно помочь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350220
					]
				},
				{
					"id": 710350220,
					"content": "А как же рыба-тигр? Паймон ещё не поела!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
