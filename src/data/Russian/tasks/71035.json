				"points": []
			},
			"dialogs": [
				{
					"id": 710350101,
					"content": "Что желаете заказать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 710350102,
					"content": "Три порции жареной рыбы-тигра на вынос.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "Хорошо! Скоро будет готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 710350104,
					"content": "Три порции? Одну тебе, одну Паймон... а кому ещё одну?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350105,
					"content": "Хочу навестить Бронзового Воробья.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "Это тот Бронзовый Воробей, который дал нам лампы семизвездия и курильницу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350108,
					"content": "А, точно. Он правда говорил, что ему нравится жареная рыба-тигр...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350109,
					"content": "Разве он не покинул этот мир?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350110,
					"content": "Проверить всё равно можно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "Хм, правда. Тогда пойдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350112,
					"content": "Когда мы в прошлый раз встретили Бронзового Воробья, храм находился в довольно плачевном состоянии, а в округе было полно Похитителей сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350113,
					"content": "Надеюсь, его статую не поломали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350114,
					"content": "Ваша жареная рыба-тигр готова. Приятного аппетита!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 710350115,
					"content": "#Как вкусно пахнет! {NICKNAME}, пойдём скорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710350106,
					"content": "Жареная рыба-тигр - его любимое блюдо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				}
			]
		},
