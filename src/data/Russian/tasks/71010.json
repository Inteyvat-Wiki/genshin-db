				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100101,
					"content": "Мы с партнёром занимаемся боевыми искусствами с самого детства. Мы хотели бороться со злом и защищать заветы предков, но без помощи Глаза Бога это оказалось непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100102
					],
					"speakerTitle": "Сокровища руин"
				},
				{
					"id": 710100102,
					"content": "В этих краях мы тренировались в уединении, надеясь получить желанные Глаза Бога. Мы возвели этот памятник в подтверждение наших усилий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100103
					],
					"speakerTitle": "Сокровища руин"
				}
			]
		},
		{
			"id": 7101002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101006",
							"3"
						],
						"stepId": 7101006,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100201,
					"content": "Но когда мой партнёр наконец получил Глаз Бога, он не стал сражаться с чудовищами. Вместо этого он спросил: «Рождены ли чудовища для того, чтобы творить зло?» И я ответил ему: «Они сеют хаос по всему миру, невинные люди страдают от их действий. Неужели этого недостаточно, чтобы поднять против них оружие?» Полагаю, что от долгой медитации у него помутился рассудок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100202
					],
					"speakerTitle": "Сокровища руин"
				},
				{
					"id": 710100202,
					"content": "Но задача остаётся неизменной. Я уничтожу всех чудовищ, даже если мне придётся сделать это без партнёра и без Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100203
					],
					"speakerTitle": "Сокровища руин"
				}
			]
		},
		{
			"id": 7101003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101007",
							"3"
						],
						"stepId": 7101007,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100301,
					"content": "Чудовища - это угроза всему живому. Те, кто умеет держать в руках оружие, обязаны истреблять чудовищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100302
					],
					"speakerTitle": "Сокровища руин"
				},
				{
					"id": 710100302,
					"content": "Чудовища - это зло! Они не заслуживают ничего, кроме беспощадного истребления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100303
					],
					"speakerTitle": "Сокровища руин"
				}
			]
		},
