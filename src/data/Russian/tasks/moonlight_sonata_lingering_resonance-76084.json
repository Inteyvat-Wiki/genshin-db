			"dialogs": [
				{
					"id": 760840101,
					"content": "Это вы? Сегодня куухенки снова играют на лире. Можешь сыграть для них что-нибудь, как в прошлый раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840102
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760840102,
					"content": "Мне как раз хотелось бы послушать другие мелодии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840103
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760840103,
					"content": "(Хм, что же сыграть?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7608402,
			"completionStepIds": [],
