				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нахида",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320101,
					"content": "#Добро пожаловать назад, {NICKNAME}, Паймон, Сказитель!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320102
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320102,
					"content": "Фух! Такое ощущение, что мы проделали очень долгий путь... Паймон устала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30320103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320104
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320104,
					"content": "Тебе не нравится, когда тебя так называют?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320105
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320105,
					"content": "Нет, просто я подумал, что мне стоит поменять имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320106,
					"content": "Ты больше не хочешь называться Сказителем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320107
					]
				},
				{
					"id": 30320107,
					"content": "После того как я узнал обо всех деяниях Доктора, я не хочу называться именем, которое связано с ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320108,
					"content": "Я не планирую возвращаться к Фатуи, и они всё равно не приняли бы меня обратно. Недавние события затронули очень многих, они могут даже не вспомнить про номер шесть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320109
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320109,
					"content": "Ты решил навсегда попрощаться с Фатуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30320110,
					"content": "Назовём это тактическим отступлением...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320111
					]
				},
				{
					"id": 30320111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320112
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320112,
					"content": "Ты была права, малая властительница Кусанали. Даже в тщетных попытках есть своя польза. По крайней мере, я заставил многих забыть обо мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320113,
					"content": "Но это не означает, что твоё прошлое исчезло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320114
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320114,
					"content": "Разумеется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320115
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320115,
					"content": "И твоя главная цель, ради которой ты отдал всё, что у тебя было... ты не смог её достичь. Надеюсь, ты сознаёшь это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320116
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320116,
					"content": "Изменить мир, изменить прошлое, изменить судьбы людей... Это непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320117
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320117,
					"content": "Ты искал полного уничтожения... но это не более чем фантазия. Даже ценой исчезновения Сказителя невозможно подчинить мир своей воле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320118
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320118,
					"content": "...Да. Ха-ха, какая нелепость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320119
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320119,
					"content": "Ты жалеешь о том, что пошёл на такие жертвы, получив так мало взамен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30320120,
					"content": "Даже если я ничего не стою, в этом мире не о чем сожалеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320121,
					"content": "Малая властительница Кусанали, ты специально оставила эту информацию в Ирминсуле, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320122,
					"content": "Да, и я позаботилась о том, чтобы ты получил эту информацию естественным путём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320123
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320123,
					"content": "К чему всё это? Ты тоже пытаешься переманить меня на свою сторону?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320124
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320124,
					"content": "По правде говоря, твой прошлый опыт делает тебя полезным для Сумеру и для меня. Переманить тебя было частью моего плана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320125
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320125,
					"content": "Но прежде я хотела рассказать правду о твоём прошлом. Если бы я хотела просто использовать тебя, я бы ничем не отличалась от Доктора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320126
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320126,
					"content": "...Очень умно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320127
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320127,
					"content": "Это одно из моих достоинств.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320128
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320128,
					"content": "Быть полезным для других - значит быть ценным. Если принятие своих грехов снова сделает меня полезным, пусть будет так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320129
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320129,
					"content": "Нахида не этой логикой руководствуется.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320130
					]
				},
				{
					"id": 30320130,
					"content": "Ах да, чуть не забыл... вы хорошие. Вы за справедливость и всё такое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320131
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320131,
					"content": "Простите, у меня несколько иной взгляд на вещи. Но расчётливость не видится мне такой уж плохой. Самым мудрым лидерам суждено в итоге получить самых лучших помощников... Почему бы и нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320132
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320132,
					"content": "Я рада, что ты думаешь об этом в таком ключе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320133
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320133,
					"content": "#{NICKNAME}, я собираюсь продолжить исследовать Ирминсуль. Посмотрим, какие секреты удастся раскрыть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320134
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320134,
					"content": "#Включая начало путешествия {F#твоего брата}{M#твоей сестры}, записанное в Ирминсуле. Я также хочу выяснить, что именно произошло до и после этого момента.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320135
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320135,
					"content": "Спасибо. Надеюсь, ты сможешь найти ответы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320136
					]
				},
				{
					"id": 30320136,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320137
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320137,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320138
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320138,
					"content": "Да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320139
					]
				},
				{
					"id": 30320139,
					"content": "#Почему ты {F#отправилась}{M#отправился} в Инадзуму после того, как я погрузился в информационный поток Ирминсуля?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320140
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320140,
					"content": "#Потому что я хотел{F#а} узнать, что ты изменил.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320141
					]
				},
				{
					"id": 30320141,
					"content": "#...Так вот как ты узнал{F#а}, чья судьба изменилась и как.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320142
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320142,
					"content": "#Какими бы ни были причины, ты оказал{F#а} мне услугу, и я сделаю всё возможное, чтобы вернуть долг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320143,
						30320144
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320143,
					"content": "#...Я сделал{F#а} это не ради награды.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				},
				{
					"id": 30320145,
					"content": "Брать и отдавать - единственные реальные отношения между людьми. Не волнуйся, рано или поздно мы будем в расчёте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320146
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320146,
					"content": "Это неправда. Отношения между людьми - это не просто счёт, который можно сравнять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320147
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320147,
					"content": "Я думаю, в глубине души ты это понимаешь. Люди, которые появляются в твоей жизни, не могут просто испариться, как капли воды, не оставив после себя ничего. Не существует такого понятия, как «быть в расчёте».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320148
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320148,
					"content": "Некоторые вещи в этом мире невозможно вернуть и изменить, поэтому в мире людей существуют эмоции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320149
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320149,
					"content": "Все твои чувства реальны. То, чего тебе не хватает, нельзя восполнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320150
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320150,
					"content": "Быть человеком - значит жить жизнью, полной несовершенств. Ты можешь выбрать, быть человеком или нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320151
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320151,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320152
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320152,
					"content": "Разве можно быть человеком без сердца? Впрочем, это неважно, я давно оставил попытки стать человеком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320153
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320153,
					"content": "Даже не имея сердца, ты прекрасно знаешь, что такое боль. Ты просто прячешь свои чувства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320154
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320154,
					"content": "Прошлое никуда не денется, но ты можешь идти вперёд. Чем длиннее будет твоё будущее, тем меньше места будет занимать прошлое. Пока однажды оно не станет лишь малой частью твоей жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320155
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320155,
					"content": "Похоже, у тебя есть планы на моё будущее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320156
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320156,
					"content": "Надеюсь, ты дашь Нахиде шанс.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320157
					]
				},
				{
					"id": 30320157,
					"content": "Всё так сложно, Паймон даже не знает, с чего начать... Но главное для тебя сейчас - слушать Нахиду. Иначе все наши усилия окажутся напрасными!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320158
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30320158,
					"content": "...Тогда, пожалуй, с этого момента я буду помогать вам, действуя за кулисами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320159
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320159,
					"content": "Я рада, что ты принял наше предложение. Почему бы тебе не придумать себе новое имя в честь этого знаменательного события?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320160
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320160,
					"content": "Скорее, скорее! Паймон хочет и тебе дать противное прозвище!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320161
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30320161,
					"content": "Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320162
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320162,
					"content": "Потому что... потому что ты всё ещё не нравишься Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320163
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30320163,
					"content": "В таком случае надеюсь, что мы будем редко видеться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320164
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320164,
					"content": "«Имя - первый дар жизни». Ты не произнёс этого вслух, но я знаю, что ты подумал именно об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320165
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320165,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320166
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320166,
					"content": "#{NICKNAME} и Паймон многое сделали для тебя. Если ты не можешь выбрать новое имя, возможно, стоит попросить их поделиться идеями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320167
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320167,
					"content": "Хм? Ты хочешь, чтобы мы дали ему имя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320168
					]
				},
				{
					"id": 30320168,
					"content": "Ну уж нет, Паймон только прозвища придумывает! Если нужно что-то серьёзное... придумывай ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30320144,
					"content": "Пожалуйста, не говори так, будто я принуждаю тебя к чему-то",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				}
			]
		},
		{
			"id": 303203,
			"completionStepIds": [
				303203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
