				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320401,
					"content": "Вот, теперь у тебя есть имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320402
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320402,
					"content": "Как насчёт прозвища? Уже придумала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320403
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320403,
					"content": "Э-э-э, ещё думаю... Не торопи меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30320404,
					"content": "Не торопись. Нам всё равно пока нет нужды встречаться, можешь подумать как следует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320405
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320405,
					"content": "Что будешь делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320406
					]
				},
				{
					"id": 30320406,
					"content": "Все, кто манипулировал мной и причинял мне страдания, должны заплатить за это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320407
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320407,
					"content": "Ты говоришь о Фатуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30320408,
					"content": "Как минимум, о Докторе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320409
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320409,
					"content": "Твоё положение изменилось, и я верю, что твой путь также изменится. Но не сразу... Тебе потребуется время, чтобы прийти в себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320410
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320410,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320411
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320411,
					"content": "И ещё кое-что.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320412
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320412,
					"content": "В Инадзуме до сих пор живут потомки Райдэн гокадэн. Некоторые из них знают... Они должны знать о связи между мной и Райдэн гокадэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320413
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320413,
					"content": "В ближайшее время я не планирую покидать Сумеру. Если вы встретите их в Инадзуме, пожалуйста, расскажите им, что это я в ответе за падение Райдэн гокадэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320414
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320414,
					"content": "...Даже если события стёрлись из памяти людей, они всё равно заслуживают правды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320415
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320415,
					"content": "Понятно... Тебе решать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320416
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320416,
					"content": "Хм? Но если мы сделаем это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30320417,
					"content": "Всё в порядке. Они могут вонзить свои клинки в мою грудь, если им того захочется. Возможно, так и должно было случиться с самого начала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320418,
						30320422
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320418,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320419
					]
				},
				{
					"id": 30320419,
					"content": "Что вы на меня так смотрите? Я знаю, что делаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320420
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320420,
					"content": "...Этот день обязательно настанет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320421
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320421,
					"content": "Вот и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320425,
					"content": "Прощай, мудрое божество. И вы тоже прощайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320426
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320426,
					"content": "Ушёл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30320427,
					"content": "Сегодня он словно бы прожил целую жизнь в одно мгновение. Ему нужно время, чтобы всё принять и осмыслить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320428
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320428,
					"content": "Да, это правда. И всё-таки теперь он уже не кажется таким жестоким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320429
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30320429,
					"content": "Препятствий было немало, но теперь всё позади.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320430
					]
				},
				{
					"id": 30320430,
					"content": "Так мы можем наконец пойти поесть? Паймон умирает с голоду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30320431,
					"content": "Большое вам спасибо! Надеюсь, вы сможете как следует отдохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30320422,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320423
					]
				},
				{
					"id": 30320423,
					"content": "Хе-хе, не хмурься. Со мной всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320424
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320424,
					"content": "...Ладно, давайте на этом закончим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303205,
			"completionStepIds": [
				303205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
