					"Данех"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "#Ого! Ты {F#нашла}{M#нашёл} все копии реликвий?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736950202,
					"content": "Вот это да! А у тебя талант к раскопкам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736950203,
					"content": "Тогда держи подарок! Спасибо за участие в мероприятии нашего даршана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736950204,
					"content": "#Путешественни{F#ца}{M#к}, надеюсь, что во время этого мероприятия ты получил{F#а} удовольствие от раскопок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736950205,
					"content": "К сожалению, настоящая работа археолога по большей части трудна и однообразна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736950206,
					"content": "Но когда раскапываешь важную реликвию, понимаешь, что труды не напрасны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736950207,
					"content": "А если не находишь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "Если не раскапываешь... ну, тогда, как говорят, поработал впустую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736950210,
					"content": "Честно говоря, так и происходит в большинстве случаев. Раскопать важную реликвию удаётся крайне редко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736950211,
					"content": "Но если занимаешься археологией, нужно привыкнуть к этому и не унывать, несмотря ни на что. Иначе очень скоро выдохнешься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Данех"
				},
				{
					"id": 736950208,
					"content": "Такое тоже случается.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
