			"dialogs": [
				{
					"id": 150050201,
					"content": "А здесь красиво! И кохолазавры встречаются. Давай сфотографируемся с дикими кохолазаврами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150050202,
					"content": "А если они кусаются?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050203
					]
				},
				{
					"id": 150050203,
					"content": "Ну... Паймон они кажутся такими милыми...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150050204,
					"content": "Ой, что это там...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150050205,
					"content": "Спасите! На помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050206
					],
					"speakerTitle": "Карья"
				},
				{
					"id": 150050206,
					"content": "Ой, дикие кохолазавры и правда кусаются!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050207,
						150050209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150050207,
					"content": "Скорее, в бой!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050208
					]
				},
				{
					"id": 150050208,
					"content": "#Они угодили в беду! {M#Прославленный воин}{F#Прославленная воительница} {NICKNAME} и {M#его}{F#её} верная напарница Паймон уже спешат на помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150050209,
					"content": "Сфотографируемся в другой раз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050210
					]
				},
				{
					"id": 150050210,
					"content": "Да, поговорим об этом после. Люди зовут на помощь! Мы должны вмешаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}