			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ханаяма Каору"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721260101,
					"content": "О нет... Что теперь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260102
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721260102,
					"content": "Что произошло потом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260103
					]
				},
				{
					"id": 721260103,
					"content": "Добрый день... Я так рада вас видеть... Вот, как только вы дали мне семена, я принялась сажать цветы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260104
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721260104,
					"content": "Но едва я начала, как появилась группа монстров и принялась бродить вокруг того места, где я собиралась посадить цветы. Я больше не осмеливаюсь там ходить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260105
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721260105,
					"content": "Если они тут останутся, то могут вытоптать участки, на которых посажены цветы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260106
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721260106,
					"content": "Если вам не трудно, можете сходить туда и избавиться от монстров? Я... Я всего лишь хочу сажать цветы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260107,
						721260109
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721260107,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260108
					]
				},
				{
					"id": 721260108,
					"content": "Вы ответили «да»? Спасибо вам огромное! Я на вас рассчитываю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721260109,
					"content": "Почему ты так решительно настроена на то, чтобы посадить цветы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260110
					]
				},
				{
					"id": 721260110,
					"content": "Я подумала, что люди не хотят возвращаться в Татарасуну, потому что беспокоятся, что после инцидента с горном Микагэ эти места больше не пригодны для жизни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260111
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721260111,
					"content": "Я не могу убеждать каждого по отдельности, но я могу снова высадить здесь множество красивых цветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260112
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721260112,
					"content": "Возможно, этого окажется достаточно, чтобы все поняли, что в Татарасуне уже безопасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260113
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721260113,
					"content": "И... хе-хе, кроме высадки цветов, больше мне убедить людей нечем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260114
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721260114,
					"content": "Так что прошу вас, помогите мне прогнать этих монстров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ханаяма Каору"
				}
			]
		},
