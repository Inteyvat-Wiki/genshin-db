						721260302
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721260302,
					"content": "#Я всех их прогнал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260303
					]
				},
				{
					"id": 721260303,
					"content": "Спасибо! Теперь я могу дальше выращивать цветы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260304
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721260304,
					"content": "Да, и прошу вас, возьмите вот это. Жаль, не могу дать вам ничего красивого... В любом случае спасибо за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
