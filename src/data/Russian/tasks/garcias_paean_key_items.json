			"dialogs": [
				{
					"id": 230135201,
					"content": "#Путешественни{F#ца}{M#к}, ты прин{F#есла}{M#ёс} слизь слайма?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135202
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230135202,
					"content": "Да, вот она.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135203
					]
				},
				{
					"id": 230135203,
					"content": "#Спасибо, этого достаточно. Лу Тун, не мог бы ты заплатить путешественни{F#це}{M#ку} за {F#её}{M#его} труды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135204
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230135204,
					"content": "Сперва мне нужно посмотреть на качество слизи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135205
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230135205,
					"content": "#Путешественни{F#ца}{M#к}, вот ваша награда. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135206
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230135206,
					"content": "Вы тоже приходите, если у вас будет время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135207
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230135207,
					"content": "И если состояние господина Гарсии будет... ухудшаться, то буду вынужден обратиться к вам за помощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				}
			]
		}
	]
