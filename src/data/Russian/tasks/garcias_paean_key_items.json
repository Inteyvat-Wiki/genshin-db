				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301301",
							"2"
						],
						"stepId": 2301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_DAILY_TASK_VAR_GT",
						"rawParams": [
							"42020",
							"1",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лу Тун",
					"Гарсия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230131101,
					"content": "Господин Гарсия, прислушайтесь к моим словам, я говорю это от чистого сердца. Мы можем продать несколько книг, чтобы поправить своё положение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131102
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230131102,
					"content": "Нет! Ни в коем случае! Дорогой мой Лу Тун, ты требуешь, чтобы я продал свою душу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131103
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230131103,
					"content": "Господин, но за душу никто не даст ни моры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131104,
						230131105
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230131104,
					"content": "Ты ещё здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				},
				{
					"id": 230131106,
					"content": "#Путешественни{F#ца}{M#к}? Как вы здесь оказались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131107
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230131107,
					"content": "Эх... Испытания прошли неудачно, я неправильно разбавил слаймовую слизь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131108
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230131108,
					"content": "И получившаяся смазка оказалась совершенно бесполезна, теперь подшипники Числовой машины заедают ещё сильнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131109
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230131109,
					"content": "Так что... Мне нужно ещё немного слаймовой слизи для новых испытаний. Вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131110,
						230131111
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230131110,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131120
					]
				},
				{
					"id": 230131120,
					"content": "#Путешественн{F#ица}{M#ик}, помогите мне раздобыть слаймовую слизь. Я непременно вас отблагодарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230131111,
					"content": "У вас нет возможности заработать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131112
					]
				},
				{
					"id": 230131112,
					"content": "Дело не в возможности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131113
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230131113,
					"content": "Дело в способности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131114
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230131114,
					"content": "Спасибо за уточнение, Лу Тун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131115
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230131115,
					"content": "Эх, стыдно признаться, но... Хотя я говорю, что моя Числовая машина уже готова, пока что её функции слишком примитивны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131116
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230131116,
					"content": "Как бы вам объяснить... Она пока даже не умеет самостоятельно проводить вычисления, мне приходится вручную проделывать множество вспомогательных операций.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131117
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230131117,
					"content": "Но... Я доведу её до ума! У меня нет никаких сомнений, что моя Числовая машина окажется великим изобретением!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131118
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230131118,
					"content": "Таким... Таким изобретением, которое положит начало новой эпохе! И тогда у меня обязательно появится способ заработать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131119
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230131119,
					"content": "Но, но пока...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131120
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230131105,
					"content": "Тебе снова нужна слизь слайма?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				}
			]
		},
