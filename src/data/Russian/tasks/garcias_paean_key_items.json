				"points": []
			},
			"dialogs": [
				{
					"id": 230130101,
					"content": "Дорогой Лу Тун, ты... Ты уверен, что это то самое место?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130102
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130102,
					"content": "Уверен, господин Гарсия, здесь слаймы встречаются чаще всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130103
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230130103,
					"content": "Насчёт этого я нисколько не сомневаюсь, вопрос в другом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130104
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130104,
					"content": "Не слишком ли их много?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130105
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130105,
					"content": "Господин Гарсия, мы крайне стеснены в средствах, поэтому у нас нет иного выхода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130106,
						230130107
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230130106,
					"content": "Ты... Гарсия?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				},
				{
					"id": 230130108,
					"content": "#Путешественни{F#ца}{M#к}! Вот так совпадение, вы тоже прибыли в Сумеру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130109
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130109,
					"content": "Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130110
					]
				},
				{
					"id": 230130110,
					"content": "Ха-ха-ха! Я здесь ищу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130111
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130111,
					"content": "Неприятности на свою голову.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130112
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230130112,
					"content": "Ищу приключения! Спасибо, Лу Тун, ты не мог бы немного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130113
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130113,
					"content": "Как прикажете, господин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130114
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230130114,
					"content": "Вернёмся к твоему вопросу. Я пришёл сюда, чтобы раздобыть немного слаймовой слизи. Это будет смазка для моей Числовой машины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130115
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130115,
					"content": "Но, во-первых, слаймовая слизь, которая продаётся на рынке, обычно уже не самая свежая, и качество оставляет желать лучшего. Во-вторых...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130116
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130116,
					"content": "Господин Гарсия накупил слишком много книг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130117
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230130117,
					"content": "Во-вторых, мы вынуждены были заплатить слишком много... Это было необходимо! Но теперь мы крайне стеснены в средствах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130118
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130118,
					"content": "Потому мы сюда и пришли, чтобы самим раздобыть немного свежей слаймовой слизи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130119
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130119,
					"content": "Но, как видите, мой милый Лу Тун - выходец из Ли Юэ, он не силён в боевых искусствах, готовить тоже не умеет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130120
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130120,
					"content": "К счастью, я ещё не разучился вести бухгалтерию... Спасибо сложным налоговым правилам, установленным Департаментом по делам граждан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130121
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230130121,
					"content": "...А я... Не могу же я драться деталями из Числовой машины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130122
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130122,
					"content": "Тебе нужна моя помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130123
					]
				},
				{
					"id": 230130123,
					"content": "В некотором смысле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130124
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130124,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130125
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230130125,
					"content": "Лу Тун, мы... Гм... У нас ещё остались деньги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130126
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130126,
					"content": "#Уверен, оплатив услуги {F#этой путешественницы}{M#этого путешественника}, мы не погибнем от голода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130127
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230130127,
					"content": "#Хорошо! Спасибо, путешественни{F#ца}{M#к}! Помоги мне раздобыть немного слаймовой слизи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230130107,
					"content": "Как ты здесь оказался?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				}
			]
		},
		{
			"id": 2301302,
