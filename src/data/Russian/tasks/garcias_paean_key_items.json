			"dialogs": [
				{
					"id": 230135101,
					"content": "#Путешественни{F#ца}, рад тебя видеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135102,
						230135103
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230135102,
					"content": "Расскажи про Гарсию.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135104
					]
				},
				{
					"id": 230135104,
					"content": "Всё из-за миледи по имени Кайя. Он об этом не говорит, но во время работы отвлекается всё чаще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135105
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230135105,
					"content": "И в то кафе он больше не ходит, а вместо этого отправляет меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135106
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230135106,
					"content": "Даже господин Ахангар предлагал поговорить с Гарсией, если это необходимо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135107
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230135107,
					"content": "Я не знаю, как помочь господину. Я раньше не сталкивался с подобными ситуациями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135108
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230135108,
					"content": "Эх, похоже, между мной и господином Гарсией появилось ещё одно препятствие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230135103,
					"content": "Он всё ещё...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135104
					]
				}
			]
