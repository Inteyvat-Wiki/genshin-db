				"points": []
			},
			"dialogs": [
				{
					"id": 3960001,
					"content": "На тебя напали Фатуи? Это уже чересчур...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960002
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960002,
					"content": "Джинн уже вернулась в штаб ордена. Она сказала, что сама займётся расследованием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960003
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960003,
					"content": "Но если не найдётся конкретных улик, то выдвинуть обвинение против Фатуи будет очень сложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Барбара"
				}
			]
		},
		{
			"id": 39602,
			"completionStepIds": [
				39602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39602",
							"2"
						],
						"stepId": 39602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Барбара"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960201,
					"content": "Это Барбара, пастор церкви Фавония. Она хочет вернуть Небесную лиру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960202
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3960202,
					"content": "Да хранит вас ветер!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960203
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960203,
					"content": "Пусть моё положение не столь значительно, как у действующего магистра Джинн, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960204
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960204,
					"content": "Я хочу поблагодарить вас за помощь от лица всего Мондштадта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960205
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960205,
					"content": "К счастью, всё закончилось благополучно. Я и представить боюсь, к чему привела бы полномасштабная война с драконом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960206
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960206,
					"content": "Теперь нам не нужна помощь Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960207
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3960207,
					"content": "Должно быть, они сейчас в ярости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960208
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3960208,
					"content": "У них не осталось рычагов давления на Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960209
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3960209,
					"content": "Их дипломатическая миссия вернётся домой ни с чем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960210
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3960210,
					"content": "Это всё прекрасно, но вернёте ли вы Небесную лиру?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960211
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960211,
					"content": "Власть действующего магистра имеет свои границы. Сенешаль хочет вернуть лиру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960212
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960212,
					"content": "Инструмент у нас... Вот только...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960213,
					"content": "Не переживайте. Я не собираюсь брать с вас плату, церковь - это некоммерческая организация.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Барбара"
				}
			]
		},
		{
			"id": 39605,
			"completionStepIds": [
				39605
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39605",
							"2"
						],
						"stepId": 39605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Барбара"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960501,
					"content": "#О, почётный рыцарь! Ты очнул{M#ся}{F#ась}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960502,
						3960505
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960502,
					"content": "Венти... Он в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960503
					]
				},
				{
					"id": 3960503,
					"content": "Ну... Не совсем «в порядке».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960504
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960504,
					"content": "Я нашла тебя без сознания у стен собора, и мне пришлось применить элементальные силы, чтобы поднять тебя на ноги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960510,
					"content": "Бард пришёл в сознание раньше всех. Странно, но мои восстанавливающие способности не произвели на него никакого эффекта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960511
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960511,
					"content": "Это первый подобный случай в моей практике. Он просто сказал, что всё в порядке, и ушёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960512
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960512,
					"content": "Ушёл? Куда он направился?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960513,
					"content": "<color=#00E1FFFF>Символ героев Мондштадта</color>... Он сказал так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960514
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960514,
					"content": "Я хотела его остановить, но Джинн... действующий магистр Джинн сказала отпустить барда. Это очень странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960515,
						3960516
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960515,
					"content": "(Кажется, я понимаю, почему...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960517,
					"content": "Паймон помнит, как Венти исцелился рядом с тем <color=#00E1FFFF>огромным деревом</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960518
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960518,
					"content": "(Вероятно, между Анемо Архонтом и долиной Ветров существует какая-то связь. Джинн уже поняла это, но мы не можем рассказать Барбаре...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960516,
					"content": "(Кажется, Джинн тоже понимает, почему...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960505,
					"content": "Это... Это какая планета?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960506
					]
				},
				{
					"id": 3960506,
					"content": "Планета?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960507
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960507,
					"content": "#Барбара, не слушай е{M#го}{F#ё}! Он{F#а} болтает всякие глупости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960508,
					"content": "Ох.. Если вкратце, я нашла тебя без сознания у стен собора, и мне пришлось применить элементальные силы, чтобы поднять тебя на ноги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960509
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 3960509,
					"content": "#Кажется, она просто обрызгала тебя водой, и ты приш{M#ёл}{F#ла} в сознание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 39606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39604",
							"2"
						],
						"stepId": 39604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960601,
					"content": "Ты только послушай, как ветер колышет листву. Как же мне нравится здешний запах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960602
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960602,
					"content": "Ха-ха! В прошлый раз я сказал то же самое. Эх, почему я замечаю эту красоту, только когда мне не везёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960603
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960603,
					"content": "Так... что же такое «Сердце Бога»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960604
					]
				},
				{
					"id": 3960604,
					"content": "#Хм. Ты заметил{F#а}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960605
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960605,
					"content": "Я не могу обсуждать это с простыми людьми. Но, думаю, с тобой я могу поделиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960606
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960606,
					"content": "Как ты знаешь, Глаз Бога - это артефакт, которым владеет очень небольшое количество людей. В этих артефактах заключена элементальная энергия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960607
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960607,
					"content": "На самом деле, каждый владелец Глаза Бога может стать богом и вознестись в Селестию. Мы называем таких людей Боги Истоков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960608
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960608,
					"content": "Боги Истоков? Никогда не слышала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960609,
					"content": "Этот секрет знают только сами божества. Нам не нужны примитивные инструменты, типа Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960610
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960610,
					"content": "Вместо этого мы напрямую резонируем с Селестией... Это называется Сердце Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960611
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960611,
					"content": "А что это у тебя висит на поясе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960612
					]
				},
				{
					"id": 3960612,
					"content": "Это просто светящийся шарик, чтобы не вызывать подозрений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960613,
						3960614
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960613,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				},
				{
					"id": 3960615,
					"content": "А кто была эта женщина, которая запустила Паймон в воздух и похитила Сердце Бога у Венти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960616
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960616,
					"content": "Синьора. Номер восемь из Предвестников Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960617
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960617,
					"content": "Она, как и другие Предвестники Фатуи, обладает властью, подобной власти Царицы Снежной. Их сила превосходит силу простых смертных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960618
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960618,
					"content": "Царица Снежной? Это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960619
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960619,
					"content": "Да. Она одна из семи Архонтов, Ледяная Царица, восседающая в Заполярном дворце. Предвестники Фатуи находятся в её непосредственном подчинении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960620
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960620,
					"content": "Архонты не всегда ладят друг с другом, но я никогда бы не подумал, что она решится украсть Сердце Бога у другого Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960621
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960621,
					"content": "Какая она из себя, эта Ледяная Императрица?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960622
					]
				},
				{
					"id": 3960622,
					"content": "Хм... Как бы объяснить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960623
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960623,
					"content": "Я помню, какой она была пятьсот лет назад. Должно быть, она изменилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960624
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960624,
					"content": "Она перестала с нами общаться после одной катастрофы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960625
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960625,
					"content": "Давай обсудим Крио Архонта и Фатуи в другой раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960626
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960626,
					"content": "#Похоже, поиск семерых Архонтов будет полон трудностей, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960627
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960627,
					"content": "Тебе стоит отправиться к нашим соседям в Ли Юэ. Гео Архонт, в отличие от меня, управляет своим регионом напрямую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960628
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960628,
					"content": "Раз в год он является жителям Ли Юэ и даёт им указания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960629
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960629,
					"content": "Он делает это ровно на один раз в год больше, чем Архонт ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960630
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960630,
					"content": "Кхм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960631
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960631,
					"content": "Скоро начнётся Церемония Сошествия. Если ты пропустишь её, придётся ждать следующего года.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960632
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960632,
					"content": "#Что?! Чего ж ты сразу нам не сказал? Пошевеливайся, {NICKNAME}, нам нельзя терять ни минуты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960633
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960633,
					"content": "Не так быстро, чужеземец, поймавший ветер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960634,
						3960636
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960634,
					"content": "Ты это обо мне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960635
					]
				},
				{
					"id": 3960635,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960638,
					"content": "#Путешественни{F#ца}{M#к}... Не забывай о конечной цели своего путешествия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960639
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960639,
					"content": "Птицы Тейвата, песни и города, Царица и Фатуи, монстры и чудовища... Всё это части твоего пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960640
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960640,
					"content": "Не спеши завершать его. Наслаждайся видами по пути. Исследуй окружающий мир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960641,
						3960642
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960641,
					"content": "Венти...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960643,
					"content": "Отлично! Это был всего лишь маленький совет от Анемо Архонта. А сейчас мне пора снова стать обычным бардом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960642,
					"content": "#Я тебя понял{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960636,
					"content": "Прости, но силой Анемо меня наградила статуя...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960637
					]
				},
				{
					"id": 3960637,
					"content": "Ха-ха, да пользуйся ей на здоровье! Но от бокала вина в знак благодарности я не откажусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960614,
					"content": "Меня снова обманули... Пора уже привыкнуть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				}
			]
		},
		{
			"id": 39608,
			"completionStepIds": [
				39604
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960701,
					"content": "Если хочешь поболтать по душам, сейчас самое время... Бард редко остаётся надолго в одном и том же месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960702,
						3960707,
						3960715,
						3960727,
						3960741
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960702,
					"content": "О Двалине...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960703
					]
				},
				{
					"id": 3960703,
					"content": "До самого конца Двалин помнил свой долг Хранителя четырёх ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960704
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960704,
					"content": "Поэтому я не хочу навязывать ему свои идеалы свободы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960705
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960705,
					"content": "Я надеюсь, что когда-нибудь он сам всё поймёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960706
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960706,
					"content": "Ещё до того, как я стал Архонтом, один мой друг объяснил мне, что такое свобода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960707,
					"content": "Об ордене Бездны...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960708
					]
				},
				{
					"id": 3960708,
					"content": "Хм? Что же выяснил Кэйа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960709
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960709,
					"content": "Так значит в том, что произошло с Двалином, виноват тайный лидер ордена Бездны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960710
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960710,
					"content": "Похоже, они хотели сделать его орудием войны... Я никогда не слышал, чтобы у ордена Бездны был какой-то лидер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960711,
						3960712
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960711,
					"content": "Значит, у них не заведено иметь лидера?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960713,
					"content": "Похоже на то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960714
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960714,
					"content": "Но как ему удалось так быстро стать главой ордена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960712,
					"content": "Значит, он появился совсем недавно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960715,
					"content": "О Синьоре...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960716
					]
				},
				{
					"id": 3960716,
					"content": "Эта фатуйка, которая украла твоё Сердце Бога... Она так быстро исчезла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960717
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960717,
					"content": "Она не хотела попасться на глаза рыцарям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960718
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960718,
					"content": "Если бы Ордо Фавониус поймал её за руку, отношения между двумя государствами стали бы очень напряжёнными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960719
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960719,
					"content": "Неужели после этого им хватит наглости притворятся союзниками Мондштадта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960720
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960720,
					"content": "Я считаю, всем семи нациям бы следовало объединиться против угрозы, которую несёт орден Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960721
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960721,
					"content": "Фатуи обладают самой сильной армией на всём континенте. Но увы, они использовали её для того, чтобы украсть Небесную лиру, получить божественные силы и направить Двалина против Ордо Фавониус...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960722
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960722,
					"content": "Кстати! Пока мы искали Небесную лиру, Дилюк кое-что сказал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960723
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960723,
					"content": "Он сказал, что Фатуи так смело разгуливают по Тейвату только благодаря Одиннадцати Предвестникам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960724
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960724,
					"content": "Да. Я уже говорил, что Крио Архонт наделила их безграничной властью и божественными силами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960725
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960725,
					"content": "Ледяная Императрица... Я не видел тебя уже 500 лет. Что же ты замышляешь? Каков твой план?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960726
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960726,
					"content": "Ответы на эти вопросы могут сильно повлиять на ваши поиски Семерых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960727,
					"content": "О божествах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960728
					]
				},
				{
					"id": 3960728,
					"content": "Как я уже говорил, все носители Глаза Бога могут вознестись на Селестию и стать Богами Истоков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960729
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960729,
					"content": "А Сердце Бога - это средоточие элементальной силы, символ могущества семерых Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960730
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960730,
					"content": "#Мне очень жаль, но я не знаю, кто из Архонтов похитил тво{M#ю сестру}{F#его брата}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960731
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960731,
					"content": "Будучи Архонтом, я и сам могу быть не чист на руку, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960732,
						3960734
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960732,
					"content": "#Ты совсем не похож на того, кто украл мо{M#ю сестру}{F#его брата}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960733
					]
				},
				{
					"id": 3960733,
					"content": "Образ бродяжки может быть всего лишь прикрытием. Мы не можем судить по внешности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960734
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960734,
					"content": "Мы знакомы уже довольно давно. Я доверяю тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960735
					]
				},
				{
					"id": 3960735,
					"content": "#Ха-ха-ха, мы и вправду пережили немало приключений вместе! Не хочешь стать одним из Хранителей четырёх ветров после того, как найдёшь сво{M#ю сестру}{F#его брата}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960736
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960736,
					"content": "Эм...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960737
					]
				},
				{
					"id": 3960737,
					"content": "#Ты чего, {NICKNAME}? Кажется, тебе не очень понравилась такая идея...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960738
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960738,
					"content": "Так, бродяжка! Если в обязанности Хранителя четырёх ветров входит есть бесплатную еду, то вы можете рассчитывать на меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960739
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960739,
					"content": "Ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960741,
					"content": "Ладно, нам пора идти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960742
					]
				},
				{
					"id": 3960742,
					"content": "Да, вам нужно поторапливаться в <color=#00E1FFFF>Ли Юэ</color> на Церемонию Сошествия, иначе придётся ждать целый год.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		}
	]
}