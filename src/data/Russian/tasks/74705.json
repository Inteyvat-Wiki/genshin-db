			"dialogs": [
				{
					"id": 747050101,
					"content": "...Наверное, эта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050102
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 747050102,
					"content": "Да, хороший выбор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050103
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747050103,
					"content": "Почему эта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050104
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 747050104,
					"content": "Обрати внимание на цвет её хвоста. Самая стильная рыба во всём океанариуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050105
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 747050105,
					"content": "Краски слишком яркие, но ладно. Приму это за комплимент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050106
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 747050106,
					"content": "Ух ты! Сколько людей! Все пришли в океанариум?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747050107,
					"content": "Да, мы недавно закончили снимать и решили воспользоваться перерывом, чтобы полюбоваться на всё это великолепие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050108
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747050108,
					"content": "Что вы сейчас обсуждали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747050109,
					"content": "Пытались решить, какая рыба больше всего похожа на Тиори.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050110
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 747050110,
					"content": "И вы тоже?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747050111,
					"content": "А... Ха-ха, Коломбина первая об этом заговорила, нам её развлечение показалось забавным, и мы незаметно тоже увлеклись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050112
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747050112,
					"content": "Так это ещё и заразно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747050113,
					"content": "Ой, смотри! Вон та похожа на тебя, Шеврёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050114
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 747050114,
					"content": "В каком смысле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050115
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 747050115,
					"content": "Ни секунды не отдыхает, всё время кружит по аквариуму, наращивает силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050116
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 747050116,
					"content": "...Значит, вот как ты меня видишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шеврёз"
				}
			]
		}
	]
}