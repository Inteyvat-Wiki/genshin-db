			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Маленькая шишка",
					"Взрывопламенный чурбан",
					"Виже"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 755100101,
					"content": "По моему мнению, воин в маске не может повсюду летать как миротворец. Однако для победы ей достаточно лишь выбрать идеальный момент для нападения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100102
					],
					"speakerTitle": "Маленькая шишка"
				},
				{
					"id": 755100102,
					"content": "Вот пустоголовая! Какой прок с одной только скорости по прямой, если ни повернуть, ни ударить нельзя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100103
					],
					"speakerTitle": "Взрывопламенный чурбан"
				},
				{
					"id": 755100103,
					"content": "Довольно, дети. Зачем ссоритесь, если всё можно спокойно обсудить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100104
					],
					"speakerTitle": "Виже"
				},
				{
					"id": 755100104,
					"content": "Нет-нет, мы просто... говорили о могучих воинах и очень уж воодушевились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100105
					],
					"speakerTitle": "Взрывопламенный чурбан"
				},
				{
					"id": 755100105,
					"content": "Не волнуйся, Виже! Даже если мы будем спорить, то только используя логику и доказательства!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100106
					],
					"speakerTitle": "Маленькая шишка"
				},
				{
					"id": 755100106,
					"content": "Мне в голову пришла новая стратегия. Сыграем ещё разок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100107
					],
					"speakerTitle": "Взрывопламенный чурбан"
				},
				{
					"id": 755100107,
					"content": "Ещё раз, ещё раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100108,
						755100109
					],
					"speakerTitle": "Маленькая шишка"
				},
				{
					"id": 755100108,
					"content": "...Как здесь оживлённо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				},
				{
					"id": 755100110,
					"content": "О, новый клиент! Приветствую!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100111
					],
					"speakerTitle": "Виже"
				},
				{
					"id": 755100111,
					"content": "#Судя по твоему наряду, ты {F#путешественница}{M#путешественник}, верно? Это нас объединяет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100112
					],
					"speakerTitle": "Виже"
				},
				{
					"id": 755100112,
					"content": "Хочешь попробовать этот интерактивный тканый свиток, который я недавно создала вместе с детьми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100113,
						755100114
					],
					"speakerTitle": "Виже"
				},
				{
					"id": 755100113,
					"content": "«Интерактивный тканый свиток»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100115,
					"content": "Словом, это игра, которая объединяет бумажный театр Ли Юэ, мангу Инадзумы и кино Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100116
					],
					"speakerTitle": "Виже"
				},
				{
					"id": 755100116,
					"content": "К историческим рассказам о прославленных местных героях была добавлена концепция «трансграничных испытаний», что привело к созданию новой истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100117
					],
					"speakerTitle": "Виже"
				},
				{
					"id": 755100117,
					"content": "Попробуй! Возможно, он принесёт тебе новые впечатления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100118
					],
					"speakerTitle": "Виже"
				},
				{
					"id": 755100118,
					"content": "С удовольствием!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100119
					]
				},
				{
					"id": 755100119,
					"content": "Отлично! Желаю тебе хорошо провести время!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виже"
				},
				{
					"id": 755100114,
					"content": "Свиток, который движется сам по себе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100109,
					"content": "Что происходит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				}
			]
		},
