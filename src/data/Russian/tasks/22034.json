					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220340203,
					"content": "А они быстро бросились бежать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340204
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340204,
					"content": "Возможно, они побежали обратно, чтобы сообщить о нас. В этом случае наша цель была достигнута.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340205
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340205,
					"content": "#Благодарю тебя за твой труд, путешественни{F#ца}{M#к}. Пожалуйста, возьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340206
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340206,
					"content": "Я вернусь и сообщу Санго о том, как всё прошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340207
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340207,
					"content": "Интересно, выяснила ли она что-нибудь новое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				}
			]
		},
