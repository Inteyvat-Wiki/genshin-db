	"talks": [
		{
			"id": 2203401,
			"completionStepIds": [
				2203401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203401",
							"2"
						],
						"stepId": 2203401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220340101,
					"content": "#Путешественни{F#ца}{M#к}, пожалуйста, постой. Санго хотела бы обратиться к тебе за помощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340102
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340102,
					"content": "Как дело продвигается?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340103
					]
				},
				{
					"id": 220340103,
					"content": "Она мне не говорила. Она просто сказала, что ей всё ещё нужно сделать кое-какие приготовления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340104
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340104,
					"content": "Она также сказала, чтобы я подождал тебя и спросил, не против ли ты вместе со мной провести поиски в диких землях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340105,
						220340107
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340105,
					"content": "Чего она планирует этим добиться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340106
					]
				},
				{
					"id": 220340106,
					"content": "Ну... если честно, я тоже ничего не знаю. Но когда мы делаем то, что говорит нам Санго, то обычно в итоге раскрываем дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340112,
					"content": "Что ж. На этой ноте давай перейдём к делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340113
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340113,
					"content": "По словам Санго, патруль в городе действительно был усилен с тех пор, как Амано и Андо сообщили о том инциденте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340114
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340114,
					"content": "Но, как ни странно, торговцы в городе по-прежнему становятся жертвами краж. И намерения преступников предельно ясны. Их не интересует ничего, кроме некоторых целевых товаров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340115
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340115,
					"content": "Ситуация такова. Санго считает, что вероятность того, что Похитители сокровищ пробираются в город для совершения этих преступлений, очень мала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340116
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340116,
					"content": "У подозреваемого... или подозреваемых есть чёткая цель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340117
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340117,
					"content": "Вполне вероятно, что в городе всё это время находится крот, передающий информацию людям за городской чертой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340118
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340118,
					"content": "Разве это не означает, что действия досинов безрезультатны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340119
					]
				},
				{
					"id": 220340119,
					"content": "Вовсе нет. Это именно то, чего мы хотим. Поскольку наш преступник, похоже, понял, что он не является целью досинов, он будет продолжать совершать преступления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340120
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340120,
					"content": "Чем больше преступлений он совершает, тем легче ему выдать себя, и тем больше шансов у Санго выяснить, кто он на самом деле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340121
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340121,
					"content": "Поэтому нам по-прежнему нужно продолжать это шоу, чтобы наш вор ослабил бдительность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340122
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340122,
					"content": "#Путешественни{F#ца}{M#к}, вот почему я здесь и прошу тебя пойти со мной и поискать стычек с этими Похитителями сокровищ в диких землях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340123
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340123,
					"content": "Разумеется, тут для тебя предполагается вознаграждение. Также... когда дело будет закончено, будет ещё и дополнительный подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340124
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340124,
					"content": "И это тоже Санго попросила тебя сказать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340125
					]
				},
				{
					"id": 220340125,
					"content": "#Хм... Ты это почувствовал{F#а}? А у тебя довольно острая интуиция...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340126
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340126,
					"content": "Это действительно была Санго, именно она велела мне убедить тебя этими словами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340127
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340127,
					"content": "Но, пожалуйста, верь мне, когда я говорю, что не лгу. По крайней мере, твоё вознаграждение уже у меня с собой прямо сейчас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340128
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340128,
					"content": "#Так что прошу тебя помочь, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340129
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340129,
					"content": "Что именно от меня требуется?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340130
					]
				},
				{
					"id": 220340130,
					"content": "Всё просто. Нам нужно... немножко побузить с Похитителями сокровищ в диких землях. Чем больше будет переполох, тем лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340131
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340131,
					"content": "Санго уже установила места расположения некоторых лагерей Похитителей сокровищ. Я также отметил их для тебя на карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340132
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340132,
					"content": "Хорошо, после снова встречаемся здесь. Вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340107,
					"content": "А почему она сама не пришла?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340108
					]
				},
				{
					"id": 220340108,
					"content": "Такие у неё привычки. Она говорит, что... из всех видов деятельности она хороша только в мыслительной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340109
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340109,
					"content": "Некоторое время назад один писатель пришел взять у неё интервью, желая сделать из её истории роман.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340110
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340110,
					"content": "Он даже назвал Санго «диванным детективом». Похоже, ей понравилось это прозвище, и с тех пор она подумывает о покупке дивана, или хотя бы кресла - на худой конец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340111
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220340111,
					"content": "Но из-за проблем с финансами мы пока не можем позволить себе даже кресло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Рюдзи"
				}
			]
		},
		{
			"id": 2203402,
