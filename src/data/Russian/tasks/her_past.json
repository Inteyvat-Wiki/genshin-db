					}
				]
			},
			"dialogs": [
				{
					"id": 760350101,
					"content": "(Коломбины... здесь нет?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350102
					]
				},
				{
					"id": 760350102,
					"content": "Ищешь меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350103
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350103,
					"content": "А-а-а!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350104,
						760350105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760350104,
					"content": "Ты напугала Паймон!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				},
				{
					"id": 760350106,
					"content": "Почувствовав твоё присутствие, мне захотелось проверить, как близко я смогу подобраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350107
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350107,
					"content": "У тебя, похоже, куча свободного времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760350108,
					"content": "О... Правда? Когда я была с Фатуи, всё было примерно так же... У меня никогда не было особо много дел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350109
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350109,
					"content": "Царица лишь стремилась обрести силу Богини Луны. Меня никогда не посылали за Сердцем Бога или чем-то подобным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350110
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350110,
					"content": "Чем же ты обычно занималась?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350111
					]
				},
				{
					"id": 760350111,
					"content": "Гуляла, любовалась Луной, иногда пела. Но петь я стала реже после того, как Сандроне сделала мне замечание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350112
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350112,
					"content": "Хм? Ей не понравилось твоё пение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760350113,
					"content": "Нет. На самом деле она его похвалила, но на тот момент я недавно присоединилась к Фатуи, и она сказала, что другие будут нервничать, услышав меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350114
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350114,
					"content": "Тем, кто не в курсе, может показаться, что я собираюсь использовать... какую-то силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350115
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350115,
					"content": "Вот как. Кажется... Паймон понимает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760350116,
					"content": "Ах, была ещё одна причина. Она сказала, что ночью будет заниматься исследованиями, поэтому, если я буду петь днём, я буду мешать ей высыпаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350117
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350117,
					"content": "(Это была главная причина!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350118
					]
				},
				{
					"id": 760350118,
					"content": "Поэтому я пела у её двери по ночам. Но она всё равно прогоняла меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350119
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760350120,
					"content": "Ты ладила с другими?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350121
					]
				},
				{
					"id": 760350121,
					"content": "Ладила? Хм... Когда мы впервые встретились, Арлекино, казалось, очень хотела поладить со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350122
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350122,
					"content": "Она часто беззвучно появлялась позади меня, как я появлялась позади тебя. По-моему, она говорила, что проверяет меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350123
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350123,
					"content": "Я тоже пыталась играть в эту игру, но она всегда поворачивалась, даже когда я была очень далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350124
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350124,
					"content": "И однажды я использовала куувяки и наконец смогла хорошенько напугать её, подкравшись сзади. Однако после этого она больше не играла со мной в эту игру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350125
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350125,
					"content": "(Вероятно, Арлекино никогда не относилась к этому как к игре...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760350126,
					"content": "Доктор также часто просил меня помочь ему в исследованиях, связанных с Миром света.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350127
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350127,
					"content": "Я несколько раз согласилась, но это было очень скучно. «Используй куувяки, чтобы ударить это», «используй куувяки, чтобы контролировать то»... Через некоторое время я перестала ходить к нему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350128,
						760350129
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350128,
					"content": "Похоже, сегодня у тебя хорошее настроение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350130,
					"content": "Да. Хотя я сбежала из дома, у меня всё равно остались приятные воспоминания о нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350131
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350131,
					"content": "Арлекино и Сандроне относились ко мне довольно хорошо, а ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350132
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350132,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350133
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350133,
					"content": "(Этот взгляд... Она вспомнила кого-то...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350134
					]
				},
				{
					"id": 760350134,
					"content": "Дай мне руку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350135,
						760350136
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350135,
					"content": "...А?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350137,
					"content": "Я вспомнила, как Розалина научила меня... быть благодарной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350138
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350138,
					"content": "#Спасибо, что выслушал{F#а} меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350139
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350139,
					"content": "Пустяки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350140
					]
				},
				{
					"id": 760350140,
					"content": "(Это... благословение Богини Луны?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350141
					]
				},
				{
					"id": 760350141,
					"content": "На сегодня хватит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350142
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760350142,
					"content": "Как-то всё быстро закончилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350143,
						760350144
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760350143,
					"content": "Тсс... Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350145,
					"content": "#О, ты прав{F#а}. Тогда не будем больше ей докучать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760350144,
					"content": "Возможно, она вспомнила что-то из прошлого...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350136,
					"content": "Зачем?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350129,
					"content": "Ты много рассказала о своём прошлом...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350105,
					"content": "Обязательно было вот так выскакивать?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				}
			]
		}
	]
}