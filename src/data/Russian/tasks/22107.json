			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжи Хуа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221070101,
					"content": "«Любовь... Она может быть бесконечно далеко, или она может быть у тебя прямо под носом. Настанет момент, и она предстанет перед твоими глазами...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070102
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221070102,
					"content": "О чём ты говоришь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070103
					]
				},
				{
					"id": 221070103,
					"content": "Это моё предсказание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070104
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221070104,
					"content": "Вот что сказала гадалка Ци Мин о моей любовной жизни... Она может быть бесконечно далеко, а может быть у меня под носом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070105
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221070105,
					"content": "Я уверен, что это что-то значит... Но что именно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070106
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221070106,
					"content": "Я слышал, что предсказания сбываются, и на это указывает много разных знаков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070107
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221070107,
					"content": "Я чувствую, что любовь где-то рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070108
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221070108,
					"content": "Поищешь для меня эти знаки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070109,
						221070110
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221070109,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070111
					]
				},
				{
					"id": 221070111,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221070110,
					"content": "Почему ты сам этим не займёшься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070112
					]
				},
				{
					"id": 221070112,
					"content": "Как нейтральный наблюдатель, ты сможешь заметить больше знаков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070113
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221070113,
					"content": "А моя личная заинтересованность не позволит мне правильно их интерпретировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070114
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221070114,
					"content": "Поэтому мне нужна твоя помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Хуа"
				}
			]
		},
