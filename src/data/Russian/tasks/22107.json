			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжи Хуа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071101,
					"content": "Сегодня торговля идёт бойко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071102
					]
				},
				{
					"id": 221071102,
					"content": "Бизнес процветает? Богатство приумножается? Неплохо... Звучит многообещающе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071103
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221071103,
					"content": "Что посеешь, то и пожнёшь. Терпение и труд всё перетрут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071104
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221071104,
					"content": "Это относится и к любви! Теперь я понял! К любви надо относиться с терпением, и только тогда любовь вырастет в твоём сердце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071105
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221071105,
					"content": "Хм... Сп-спасибо за... совет. Я обязательно подумаю над этим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071106
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221071106,
					"content": "Ци Мин! Настанет день...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Хуа"
				}
			]
		},
		{
