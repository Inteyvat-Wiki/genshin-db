			"trigger": {
				"objectNames": [
					"Чжи Хуа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071001,
					"content": "Две птицы на крыше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071002
					]
				},
				{
					"id": 221071002,
					"content": "Отлично! Какой хороший знак!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071003
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221071003,
					"content": "Голубь и голубка покинули свои стаи, чтобы быть вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071004
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221071004,
					"content": "Этот знак может означать только одно. Я обязан встретить свою единственную любовь, несмотря ни на что!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071005
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221071005,
					"content": "И ничто не сможет помешать нашему счастью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071006
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221071006,
					"content": "Кхм! Спасибо, спасибо тебе... Я должен обсудить это с Ци Мин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Хуа"
				}
			]
		},
		{
			"id": 2210711,
