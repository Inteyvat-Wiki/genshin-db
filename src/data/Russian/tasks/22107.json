			"dialogs": [
				{
					"id": 221071301,
					"content": "Кошка подружилась с рыбкой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071302
					]
				},
				{
					"id": 221071302,
					"content": "#Какой хороший знак! Ты точно знал{F#а} куда смотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071303
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221071303,
					"content": "Крепкая дружба, отрицающая все условности... Я восхищаюсь этими животными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071304
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221071304,
					"content": "Разве не в этом сама суть любви? В преодолении непреодолимых границ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071305
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221071305,
					"content": "Я бесконечно уважаю эту кошечку и эту рыбку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071306
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221071306,
					"content": "Этот знак говорит нам, что для настоящей любви нет преград. Надо поговорить об этом с Ци Мин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071307
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221071307,
					"content": "С... спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Хуа"
				}
			]
		},
