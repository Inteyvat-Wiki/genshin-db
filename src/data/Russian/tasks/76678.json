					"nextDialogs": [
						760830614
					]
				},
				{
					"id": 760830614,
					"content": "Ручка зонта коротковата, неудобно держать в дождливую погоду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760830615,
					"content": "Зонт... я им особо не пользуюсь. Когда идёт дождь, можно создать щит с помощью куувяки.",
					"roleType": "TALK_ROLE_NPC",
