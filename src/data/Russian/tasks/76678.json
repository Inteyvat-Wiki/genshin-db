			"dialogs": [
				{
					"id": 760830501,
					"content": "Идите же, друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830502
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760830502,
					"content": "Нужно угадать, что изображено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830503,
						760830508,
						760830513
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760830503,
					"content": "Железный утёнок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830504
					]
				},
				{
					"id": 760830504,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830505
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 760830505,
					"content": "#Как ты {F#догадалась}{M#догадался}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760830506,
					"content": "Так вот как его зовут. Он носит своего создателя повсюду на руке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830507
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760830507,
					"content": "Кажется, ты перепутала Айно с одной своей коллегой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760830508,
					"content": "Хорёк-барахольщик с набитым животом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830509
					]
				},
				{
					"id": 760830509,
					"content": "Сможет ли он воровать, набив живот?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760830510,
					"content": "Или, может быть, ему уже и не нужно ничего красть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830511
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760830511,
					"content": "Правильный ответ... большая механическая утка возле мастерской Айно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830512
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760830512,
					"content": "Возвращайтесь. Спасибо вам, это было непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760830513,
					"content": "Колба.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830514
					]
				},
				{
					"id": 760830514,
					"content": "Ого, куухенки ради игры даже разузнали, как выглядит специальное лабораторное оборудование? Они действительно не жалеют сил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760830515,
					"content": "Почти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830516
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760830516,
					"content": "Правильный ответ... большая механическая утка возле мастерской Айно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830517
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760830517,
					"content": "Ну как?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830518
					],
					"speakerTitle": "Паймон"
				},
