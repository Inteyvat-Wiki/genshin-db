					"id": 760490705,
					"content": "Дай мне руку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490706,
					"content": "Тебе не нужно ничего давать нам взамен. Правда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Паймон"
				},
				{
