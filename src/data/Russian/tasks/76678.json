					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490705,
					"content": "Дай мне руку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490706,
					"content": "Тебе не нужно ничего давать нам взамен. Правда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760490707,
					"content": "Ах, у меня другое намерение... Я хотела украсить твою мелодию лучами нежного лунного света.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490709,
					"content": "Мы прошли сквозь облака и вместе нашли ответ на луне... Его красота подобна музыке, которую исполняют твои струны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				}
			]
		},
