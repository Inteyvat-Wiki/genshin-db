					}
				]
			},
			"dialogs": [
				{
					"id": 150000401,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000402
					],
					"speakerTitle": "Почи",
					"speakerSubtitle": "Детёныш юмказавра"
				},
				{
					"id": 150000402,
					"content": "Здесь заврята! А? А рядом... Ахав?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000403,
					"content": "А не глупенькие ли это приятели нашего слуги? Выследили у подножия и забрались сюда на поклон? Как увидели недавно, так наше величие и запало глубоко вам в души.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000404
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 150000404,
					"content": "Что же нам с вами ничтожествами делать. Ладно, целуйте наши ноги! Наше драконье величество Кухул Ахав позволит недостойным поклониться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000405
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 150000405,
					"content": "Ты же спутничек Кинича? Опять сам с собой разговариваешь. Ещё бредовее, чем в прошлый раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000406,
					"content": "Вздор! Какой такой спутничек? Мы есть великий дракон! Суверенный правитель страны огня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000407
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 150000407,
					"content": "Если бы Кинич не просил за вас, мы бы и словом таких ничтожеств не удостоили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000408
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 150000408,
					"content": "Чего?! Ясно же, что Кинич тебя на коротком поводке держит, а ты ещё и выпендриваешься!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000409,
						150000411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000409,
					"content": "А что суверенный правитель на горе делает?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000410
					]
				},
				{
					"id": 150000410,
					"content": "Хах, так-то лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 150000413,
					"content": "Мы изволили ответить на мольбы нашего слуги помочь в расследовании инцидента с Бездной рядом с Уитцтланом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000414
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 150000414,
					"content": "Инцидент с Бездной?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000415,
					"content": "Видишь эту ящерку? Её мать, ящерица побольше, попала под влияние силы Бездны и в своём помешательстве не только напала на племя нашего слуги, но и на своё потомство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000416
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 150000416,
					"content": "Ох... И что с ней сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000417,
					"content": "Что такое ничтожество может противопоставить силе Бездны? Конечно же, она отправилась в Царство Ночи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000418
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 150000418,
					"content": "Жалкое создание... Говорят, она прекратила страдания, прыгнув со скалы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000419
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 150000419,
					"content": "Прыгнув со скалы?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000420,
					"content": "Моя худосочная летающая букашка, как ни забита твоя голова вопросами, держи их при себе. И убери это дурацкое выражение с лица. Мы есть драконье величество Кухул Ахав, а не фонтан, исполняющий желания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000421
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 150000421,
					"content": "Худосочная летающая букашка?! Ах ты!.. Я тебе ещё придумаю кличку похуже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000422,
					"content": "Хм, мы чувствуем слабую энергию Бездны... Поблизости скрывается злой маг, но он хорошо спрятался. Если встретите каких-то подозрительных чужаков, хорошенько допросите их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000423
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 150000423,
					"content": "Подозрительных чужаков? Это ты на нас намекаешь, что ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000424,
					"content": "Пф! Как смеешь ты клеветать на своего правителя, невежа? Тебе повезло, что у нашего слуги такой мерзкий вкус на друзей! А то бы мы из тебя котлету сделали! А потом отбивную! И опять котлету!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000425
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 150000425,
					"content": "Если не будешь целовать ноги, то убирайся восвояси! Не мешай работе нашего драконьего величества Кухул Ахава.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ахав"
				},
				{
					"id": 150000411,
					"content": "А что ты, крошка, на горе делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000412
					]
				},
				{
					"id": 150000412,
					"content": "Суверенный правитель! Ты смеешь наше драконье величество Кухул Ахава злить?! Гореть тебе за своё кощунство в Пламени поворота тысячу лет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "Ахав"
				}
			]
		},
		{
			"id": 1500005,
			"completionStepIds": [
				1500007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1500007",
							"2"
						],
						"stepId": 1500007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хуни",
					"Тоба"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2373.144,
							259.097,
							8480.769
						],
						"pointId": 9113
					},
					{
						"sceneId": 3,
						"position": [
							-2375.592,
							259.064,
							8479.979
						],
						"pointId": 9114
					},
					{
						"sceneId": 3,
						"position": [
							-2374.284,
							259.103,
							8478.566
						],
						"pointId": 9115
					},
					{
						"sceneId": 3,
						"position": [
							-2374.395,
							259.072,
							8482.007
						],
						"pointId": 9116
					}
				]
			},
			"dialogs": [
				{
					"id": 150000501,
					"content": "Ого! Вы уже вернулись! Так быстро!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000502
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000502,
					"content": "Я так рада, что с малышами всё в порядке! Спасибо вам! Теперь я могу спокойно идти домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000503
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000503,
					"content": "Не за что! Было совсем не трудно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000504,
					"content": "Вы, наверное, устали по горам лазить? И ещё... Вы ведь не из Натлана, да? У вас и одежда совсем не как у нас. Приходите к нам домой отдохнуть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000505
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000505,
					"content": "Да, приходите! Покажем вам гостеприимство Потомков Крон! Мы люди очень добрые - не то что очкарик тот!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000506
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000506,
					"content": "Похоже, этот твой очкарик тоже не из Натлана, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000507,
					"content": "Эм, наверное. Ну одежда его точно не отсюда... Знаешь, если подумать, какой-то он очень подозрительный был!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000508
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000508,
					"content": "Правда? Может, это подозрительный чужак, о котором Ахав говорил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000509,
					"content": "Можешь подробно о нём рассказать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000510
					]
				},
				{
					"id": 150000510,
					"content": "Конечно, если вам интересно. О чём мы там с ним разговаривали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000511
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000511,
					"content": "Дядя, пожалуйста, я уже столько историй вам рассказала... Когда вы нам поможете найти заврят?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000512
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000512,
					"content": "Ещё одну историю. Последнюю, честное слово. Расскажи побольше об огненном шаре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000513
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000513,
					"content": "Я слышал, что был огромный прозрачный огненный шар. И было это пятьсот лет назад. Или тысячу? Может, и того раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000514
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000514,
					"content": "А, ты про Пламя поворота! Древнее имя «Мал{RUBY#[D]Пламя поворота}ипо» как раз из этой истории появилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000515
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000515,
					"content": "Ого, так вот откуда взялось древнее имя? Очень впечатляет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000516
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000516,
					"content": "Ага! У каждого древнего имени есть своя история. По легенде, Пламя поворота впервые появилось в эпоху Великого Альянса. Его использовал тиран Оч-кан, чтобы править Натланом и уничтожать всех, кто выступал против него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000517
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000517,
					"content": "Пламя поворота отличается от обычного огня. Люди, на которых оно набрасывается, чувствуют ужасное болезненное жжение позади, но сразу они не умирают. Главное ни в коем случае не оборачиваться, чтобы посмотреть на него!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000518
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000518,
					"content": "Почему? Что будет, если обернуться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000519
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000519,
					"content": "Как только повернёшься, сразу и сгоришь дотла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000520
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000520,
					"content": "Ой мамочки... Одно дело чью-то одежду подпалить, а другое - людей заживо сжигать. Какая жестокость...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000521
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000521,
					"content": "Да ведь? Это так мерзко - жечь кого-то сзади и даже не давать ему обернуться посмотреть. Оч-кан действительно был ужасным тираном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000522
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000522,
					"content": "Да, какой кошмар... Дай-ка угадаю, потом появился герой и всех спас? Обычно так в историях бывает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000523
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000523,
					"content": "Верно, дядя Очки! А ты, похоже, разбираешься! Герой был предком нашего племени, а звали его Юпанки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000524
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000524,
					"content": "Ага. Юпанки дружил с тираном Оч-каном и с первым Пиро Архонтом Шбаланке. Он отвечал за вооружение в Великом Альянсе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000525
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000525,
					"content": "Он был не согласен с жестоким правлением Оч-кана. Поэтому он украл Пламя поворота и бросил его на армию Оч-кана. Против огня никакой защиты нет, и все солдаты сгорели дотла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000526
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000526,
					"content": "Так наш предок освободил людей. Но когда он уже собирался покинуть город, ему показалось, что сзади его окликает Оч-кан. От неожиданности он обернулся, чтобы посмотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000527
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000527,
					"content": "Но Оч-кана там не было. Был только обугленный город, уничтоженная армия и рвущиеся в небо огромные языки пламени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000528
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000528,
					"content": "Через мгновение огонь вырвался из его глаз и поглотил нашего предка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000529
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000529,
					"content": "Лишь на мгновение обернулся! И сразу сгорел дотла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000530
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000530,
					"content": "Это плата за то, что он украл огонь, или за то, что он обернулся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000531
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000531,
					"content": "Никто не знает. Но огонь, поглотивший Юпанки, горел намного яростней любого другого. Он горел сто дней и прожёг дыру прямо сквозь артерии земли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000532
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000532,
					"content": "А потом пш-ш-ш! Огонь упал во мрак Царства Ночи, где он до сих пор и горит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000533
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000533,
					"content": "Взрослые говорят, что он освещает путь, ведущий в следующую жизнь. Но чтобы мёртвые возродились, они должны принять пламя и сначала очиститься в огне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000534
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000534,
					"content": "Это как последний взгляд назад на свою жизнь, когда надо за всё ответить... Короче говоря, это история Пламени поворота Юпанки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000535
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000535,
					"content": "Ах... Замечательная история! Так это правда? Огонь действительно можно найти в Царстве Ночи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000536
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000536,
					"content": "Я не знаю... Думаю, это просто история.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000537
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000537,
					"content": "А потом это имя так и передавалось в вашем племени?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000538
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000538,
					"content": "Конечно! Оно перешло к Буркине, герою, которого мы чествуем в Ночь Пламени поворота. Но это было на пятьсот лет позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000539
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000539,
					"content": "Да, а теперь оно принадлежит Киничу... Поэтому мы часто называем его Кинич Мал{RUBY#[D]Пламя поворота}ипо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000540
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000540,
					"content": "Кинич...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000541
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000541,
					"content": "Ладно, дядя Очки, хватит историй! Ты теперь нам поможешь найти детёнышей завриана, как и обещал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000542
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000542,
					"content": "Эм... Но ведь легенда о Пламени поворота учит нас не смотреть назад? Давайте не будем о том, что прошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000543
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000543,
					"content": "Расскажите мне про этого Кинича. Всего одна история. Честное слово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000544
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000544,
					"content": "А? Тоба, ты смотришь так, будто хочешь на меня ругаться? Нет-нет, так нельзя. Ругаться можно только взрослым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000545
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000545,
					"content": "Дядя... Если ты нас обманываешь... тебя после смерти будет жарить Пламя поворота!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000546
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000546,
					"content": "Как же оно меня будет жарить, если я не из Натлана? Дядя нездешний, знаешь ли. В отличие от вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000547
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000547,
					"content": "А?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000548
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000548,
					"content": "Так... Это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000549
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000549,
					"content": "Ладно, ребята, я своё слово держу. Я двух своих друзей позвал. Они вам за меня помогут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000550
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000550,
					"content": "Вы их как следует погоняйте, ладно? Они для этого сюда и идут. Не надо их беречь ради меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000551
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000551,
					"content": "Правда? Скажи хоть имя своё тогда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000552
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000552,
					"content": "Мы встретились у подножия скалы... так что... Пусть будет Санка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000553
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000553,
					"content": "Правда, что ли?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000554
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000554,
					"content": "Если не верите, то сами посмотрите. Вон они у вас за спиной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000555
					],
					"speakerTitle": "Эндзё"
				},
				{
					"id": 150000555,
					"content": "А? Где?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000556
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000556,
					"content": "Стой... Дядя Санка, ты где?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000557
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000557,
					"content": "Да уж, очень подозрительный тип... Похоже, он вынюхивал информацию о древних именах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000558
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000558,
					"content": "Ага! Мало того, он ещё нас предал! Он за это поплатится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000559
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000559,
					"content": "Но он у нас только истории выведал. Что плохого может случиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000560
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000560,
					"content": "#Хм... {NICKNAME}, может быть, расскажем об этом Киничу? Ахав сказал, что занимается этим, но он себе на уме, нельзя ему доверять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000561
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000561,
					"content": "А? Вы знаете Кинича?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000562
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000562,
					"content": "Не то чтобы очень хорошо. Но мы с ним разок встречались и обедали даже вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000563
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000563,
					"content": "Ох, как завидно! Я с ним даже не разговаривал ни разу. Он такой крутой! Мало того, что охотник на заврианов, так ещё с потрясающим древним именем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000564
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000564,
					"content": "И я тоже! Но папе он, кажется, не очень нравится. Папа всегда говорит держаться от него подальше. Наверное, из-за этого пугала, которое постоянно с ним. Злобный такой и самодовольный!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000565
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000565,
					"content": "А! Пугало, которое называет себя Кухул Ахавом! Да, нам тоже посчастливилось с ним столкнуться. Любит же людей бесить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000566
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150000566,
					"content": "Точно! Не понимаю, почему Кинич выбрал его в спутники. Почему он меня не выбрал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000567
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000567,
					"content": "Ой-ой! Хуни, уже поздно так! Что-то мы загулялись... Пошли домой скорее, а то нам попадёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000568
					],
					"speakerTitle": "Тоба"
				},
				{
					"id": 150000568,
					"content": "А, и правда! Ну... Эта дорога идёт к нашей деревне. Если решите зайти, то обязательно приходите к нашему дому!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000569
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000569,
					"content": "Если вам что-нибудь понадобится, то мой папа может помочь. Надеюсь, скоро увидимся. Обязательно заходите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000570
					],
					"speakerTitle": "Хуни"
				},
				{
					"id": 150000570,
					"content": "Нам пора! Пока-пока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тоба"
				}
			]
		},
