					"nextDialogs": [
						732440803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440803,
					"content": "Ну как? Вы не пострадали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440802
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440802,
					"content": "Всё прошло гладко! Смотри! Конденсаторы теперь у нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7324410,
			"completionStepIds": [
				7324419
