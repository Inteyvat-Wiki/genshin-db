			},
			"dialogs": [
				{
					"id": 732441901,
					"content": "Надеюсь, когда мы достанем конденсаторы, Бенбен сможет восстановиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441902
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441902,
					"content": "Если вы переживаете, я могу пойти с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441903,
						732441904
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441903,
					"content": "Нет, оставайся здесь с Бенбеном.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				},
				{
					"id": 732441905,
					"content": "Хорошо, я останусь здесь. Буду ждать от вас хороших новостей. Берегите себя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441904,
					"content": "Мы скоро вернёмся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				}
			]
		},
