			"trigger": {
				"objectNames": [
					"Джехт"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440101,
					"content": "Как же... я могла забыть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440102
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440102,
					"content": "Надеюсь, ещё не поздно. Нужно хотя бы обыскать его палатку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440103
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440103,
					"content": "Джехт! Эй, что такое? Ты куда собираешься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440104,
					"content": "#Паймон и {NICKNAME}... Вы как раз вовремя. Я собираюсь по делам... Мне нужно в палатку Адерфи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440105
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440105,
					"content": "Адерфи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440106,
					"content": "Это же предатель, который вступил в сговор с Фатуи? А, Паймон всё поняла. Ты хочешь посмотреть, не оставил ли он что-нибудь ценное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440107,
					"content": "Нет, меня не интересуют его вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440108
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440108,
					"content": "У племени свои правила насчёт оставшихся вещей предателей... Хм, если бы не правила, я бы с радостью сожгла его вещи все до единой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440109
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440109,
					"content": "Я иду в его палатку из-за...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440110
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440110,
					"content": "Из-за Бенбена, так?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440111
					]
				},
				{
					"id": 732440111,
					"content": "А, точно! Бенбен всё ещё у Адерфи. Как же быть?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440112,
					"content": "Ох, Джехт, зачем же ты отдала Бенбена этому типу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440113,
					"content": "Эх, раньше я ведь не знала, что он предатель!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440114
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440114,
					"content": "Как бы то ни было, сейчас я должна отправиться к Адерфи как можно скорее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440115
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440115,
					"content": "#{NICKNAME}, давай пойдём вместе с ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440116,
						732440117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440116,
					"content": "Не будем терять время...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				},
				{
					"id": 732440118,
					"content": "Ох, только бы с Бенбеном всё было в порядке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440117,
					"content": "Сейчас же выдвигаемся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				}
			]
		},
		{
			"id": 7324403,
			"completionStepIds": [
				7324403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324403",
							"2"
						],
						"stepId": 7324403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джехт"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440301,
					"content": "Смотрите, кажется, здесь что-то есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440302,
					"content": "Это не записи проверки, а, скорее, письмо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440303,
					"content": "Письмо? Давай откроем и прочитаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440304
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440304,
					"content": "Судя по этому письму, у Бенбена просто закончилась энергия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440305,
					"content": "И в самом деле, Бенбен открыл для нас ворота в гробницу царя Дешрета и пропустил нас внутрь... В пути Бенбен много помогал нам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440306,
					"content": "Но даже у Бенбена силы небезграничны... Может быть, он потерял энергию, потому что сделал для нас так много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440307
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440307,
					"content": "В письме говорится об особых конденсаторах преобразования энергии, но в палатке такого нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440308
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440308,
					"content": "Возможно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440309,
						732440312
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440309,
					"content": "Они где-то спрятаны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440310
					]
				},
				{
					"id": 732440310,
					"content": "Вряд ли. Если они нужны для починки Бенбена, то зачем их прятать, а не использовать сразу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440311
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440311,
					"content": "Я поняла! Просто сделка ещё не состоялась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440314,
					"content": "Адерфи не отвёл Бенбена на место сделки, потому конденсаторов преобразования энергии здесь нет... Тогда остаётся только один вопрос - кто заключил сделку с Адерфи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440315
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440315,
					"content": "Ха, какой глупый вопрос. Боюсь, единственные, кто бы мог вести с ним дела за пределами племени, это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440316,
						732440318
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440316,
					"content": "Учёные из Сумеру?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440317
					]
				},
				{
					"id": 732440317,
					"content": "Это Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440320,
					"content": "И что нам сейчас делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440321,
					"content": "А какие есть варианты? С Фатуи разговаривать не о чем. Остаётся только добраться до места сделки и отобрать конденсаторы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440322
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440322,
					"content": "Отлично! Значит, будем отбирать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440323,
					"content": "Но Бенбен... в таком состоянии мы не можем взять его с собой, тем более на место сделки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440324
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440324,
					"content": "Но и оставлять его одного небезопасно. Я больше не хочу подвергать его опасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440325
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440325,
					"content": "#Тогда сделаем так - Паймон и {NICKNAME} отправятся к Фатуи, а вы с Бенбеном подождёте здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440326,
						732440328
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440326,
					"content": "Хорошо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440327
					]
				},
				{
					"id": 732440327,
					"content": "Хорошо! Ограбим Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440330,
					"content": "#Мне очень хочется отправиться самой, но... {NICKNAME} и Паймон, теперь починка Бенбена зависит от вас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440331
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440331,
					"content": "Хотя ваш противник - просто кучка Фатуи, всё равно будьте осторожны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440332
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440332,
					"content": "Не беспокойся! Можешь на нас положиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440333
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440333,
					"content": "Я... не могу оставить Бенбена в палатке этого предателя. Заберу его к себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440334
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440334,
					"content": "Когда добудете конденсаторы, встретимся в моей палатке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440328,
					"content": "Ограбим Фатуи!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440329
					]
				},
				{
					"id": 732440329,
					"content": "Ага! Тем более, что нам не впервой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732440318,
					"content": "Фатуи!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440319
					]
				},
				{
					"id": 732440319,
					"content": "Именно так. Больше некому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732440312,
					"content": "Он их ещё не получил?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440313
					]
				},
				{
					"id": 732440313,
					"content": "Ах, я поняла, что ты имеешь в виду. Сделка ещё не состоялась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Джехт"
				}
			]
		},
