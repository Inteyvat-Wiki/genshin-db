			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джехт",
					"Бенбен"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732441001,
					"content": "Смотрите, это же Бенбен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732441002,
					"content": "Хорошо, что Адерфи не успел забрать Бенбена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441003
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441003,
					"content": "Вернее сказать, что он ничего не успел забрать - здесь всё по-прежнему и ничего не изменилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441004
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441004,
					"content": "Он же не думал, что может так просто свергнуть матриарха и как ни в чём не бывало вернуться в свою палатку?.. Какой самовлюбленный болван.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441005
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441005,
					"content": "Но в то же время из-за его глупости с Бенбеном ничего не случилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441006
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441006,
					"content": "Это называется «ничего не случилось»? О, бедный Бенбен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441007,
						732441008
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732441007,
					"content": "Как это могло случиться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				},
				{
					"id": 732441009,
					"content": "Да, почему он на земле?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441010
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732441010,
					"content": "Что всё-таки случилось с Бенбеном? Когда мы видели его в последний раз, всё было хорошо!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441011
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732441011,
					"content": "После ухода из Хадж-нисут Бенбен начал слабеть. В нём как будто что-то сломалось, и издаваемый им звук становился всё тише...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441012
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441012,
					"content": "А потом совсем исчез. Бенбен перестал двигаться - будто силы постепенно его покинули.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441013
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441013,
					"content": "В племени никто, кроме Адерфи, не мог разобраться, что случилось с Бенбеном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441014
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441014,
					"content": "Поэтому я оставила Бенбена у Адерфи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441015
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441015,
					"content": "Как же так? Бенбен, он ведь не останется таким навсегда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441016
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732441016,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441017
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441017,
					"content": "В общем, хорошо, что Бенбен теперь у нас. Рано или поздно мы найдём способ его починить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441018
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441018,
					"content": "Но ведь у нас нет ни единой зацепки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441019
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732441019,
					"content": "Нужно подумать. Я помню, как Адерфи сказал, что там нет ничего серьёзного и что через пару дней он починится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441020
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441020,
					"content": "У Адерфи есть привычка оставлять записи после проверок. Нужно их поискать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441021
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441021,
					"content": "Если с Бенбеном действительно не произошло ничего серьёзного, то мы и сами справимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732441008,
					"content": "Бенбен... Что с ним?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				}
			]
		},
