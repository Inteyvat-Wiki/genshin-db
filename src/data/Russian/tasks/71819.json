	"talks": [
		{
			"id": 7181901,
			"completionStepIds": [
				7181901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
