			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ван Я"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190701,
					"content": "#Ты вернул{F#ась}{M#ся}! Ну, как прошла доставка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190702
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718190702,
					"content": "Никто не остался обиженным.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190703
					]
				},
				{
					"id": 718190703,
					"content": "#Спасибо, ты мне здорово помог{F#ла}... Без тебя я бы точно ничего не успела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190704
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718190704,
					"content": "Ты весь праздник будешь работать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190705
					]
				},
				{
					"id": 718190705,
					"content": "Ну... Хоть Департамент по делам граждан и организует Миллелитам смены...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190706
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718190706,
					"content": "Но слишком уж Ли Юэ большой. Патрулям нужно охватить огромную территорию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190707
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718190707,
					"content": "Людей не хватает, и даже со сменами многим всё равно придётся работать во время праздника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190708
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718190708,
					"content": "К тому же учитывая размах Праздника морских фонарей, как ты работников не распределяй, их всегда будет недостаточно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190709,
						718190710
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718190709,
					"content": "М-да, ну и задачка...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				},
				{
					"id": 718190711,
					"content": "Ничего, такая у нас работа... Главное, чтобы праздник прошёл гладко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190712
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718190712,
					"content": "Кстати, во время праздника многим нужна помощь. Будет здорово, если ты придёшь на выручку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190713
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718190713,
					"content": "Чем больше людей примет участие в Празднике морских фонарей, тем веселее он получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190714
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718190714,
					"content": "Мы дарим небесные фонари для того, чтобы каждый смог запустить их и загадать желание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190715
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718190715,
					"content": "В более широком смысле... мы так распространяем Праздник морских фонарей, чтобы все могли проникнуться его атмосферой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190716
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718190716,
					"content": "Всё-таки Праздник морских фонарей - событие для всех и каждого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190717
					],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718190717,
					"content": "Ладно, мне нужно возвращаться к работе. Счастливого тебе Праздника морских фонарей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ван Я"
				},
				{
					"id": 718190710,
					"content": "Сочувствую. Держись.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				}
			]
		},
