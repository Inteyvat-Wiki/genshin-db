				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сян Мин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190201,
					"content": "Хм? Чем могу помочь? Я на службе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190202
					],
					"speakerTitle": "Сян Мин"
				},
				{
					"id": 718190202,
					"content": "Доставка небесных фонарей!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190203
					]
				},
				{
					"id": 718190203,
					"content": "Тише! Я на службе ведь, какая ещё доставка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190204
					],
					"speakerTitle": "Сян Мин"
				},
				{
					"id": 718190204,
					"content": "А, это от Департамента по делам граждан? Ясно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190205
					],
					"speakerTitle": "Сян Мин"
				},
				{
					"id": 718190205,
					"content": "Вот и снова наступил Праздник морских фонарей, а я собирался пораньше уйти домой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190206
					],
					"speakerTitle": "Сян Мин"
				},
				{
					"id": 718190206,
					"content": "Но я не могу расслабиться, когда творится такое... Кажется, я опять вернусь домой только через несколько дней...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190207
					],
					"speakerTitle": "Сян Мин"
				},
				{
					"id": 718190207,
					"content": "Спасибо, что проделали весь этот путь. Я приму подарок. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190208
					],
					"speakerTitle": "Сян Мин"
				},
				{
					"id": 718190208,
					"content": "Эх, когда же этот тип отсюда провалит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сян Мин"
				}
			]
		},
		{
			"id": 7181903,
			"completionStepIds": [
				7181903
