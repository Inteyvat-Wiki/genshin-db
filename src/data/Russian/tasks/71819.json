			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цай Лэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190501,
					"content": "Вот ёлки зелёные... Как мне туда залезть? Надо бы придумать что-нибудь другое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190502
					],
					"speakerTitle": "Цай Лэ"
				},
				{
					"id": 718190502,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190503
					]
				},
				{
					"id": 718190503,
					"content": "#Здравствуй, путешественни{F#ца}{M#к}. Ха-ха, ничего особенного. Просто думаю вот, как снять с дерева этот фонарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190504
					],
					"speakerTitle": "Цай Лэ"
				},
				{
					"id": 718190504,
					"content": "Лазать в броне слишком тяжко... Я постоянно соскальзываю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190505
					],
					"speakerTitle": "Цай Лэ"
				},
				{
					"id": 718190505,
					"content": "#Эх... Путешественни{F#ца}{M#к}, помоги мне, а? Тебе ведь достать его будет несложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190506
					],
					"speakerTitle": "Цай Лэ"
				},
				{
					"id": 718190506,
					"content": "Хорошо, стой здесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190507
					]
				},
				{
					"id": 718190507,
					"content": "Отлично, спасибо большое. Давай поскорее вернём этот фонарь ради детской улыбки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цай Лэ"
				}
			]
		},
		{
			"id": 7181906,
			"completionStepIds": [
				7181908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181908",
							"2"
						],
						"stepId": 7181908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цай Лэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190601,
					"content": "Удалось снять небесный фонарь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190602
					],
					"speakerTitle": "Цай Лэ"
				},
				{
					"id": 718190602,
					"content": "А как же.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190603
					]
				},
				{
					"id": 718190603,
					"content": "Покажи-ка... Да, это он. Вот дети обрадуются. Я сам отнесу им фонарик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190604
					],
					"speakerTitle": "Цай Лэ"
				},
				{
					"id": 718190604,
					"content": "Надеюсь, детишки ещё не ушли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190605
					],
					"speakerTitle": "Цай Лэ"
				},
				{
					"id": 718190605,
					"content": "Кстати, о подарке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190606
					]
				},
				{
					"id": 718190606,
					"content": "#Должно быть, это от Департамента по делам граждан. Я с благодарностью его приму. Спасибо, что прин{F#есла}{M#ёс} его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190607
					],
					"speakerTitle": "Цай Лэ"
				},
				{
					"id": 718190607,
					"content": "Миллелиты даже таким занимаются?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190608
					]
				},
				{
					"id": 718190608,
					"content": "Лазают на деревья за фонариками? Ха-ха-ха, ну конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190609
					],
					"speakerTitle": "Цай Лэ"
				},
				{
					"id": 718190609,
					"content": "Снимать фонарики, прогонять злодеев, расправляться с чудовищами - неважно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190610
					],
					"speakerTitle": "Цай Лэ"
				},
				{
					"id": 718190610,
					"content": "Миллелиты должны помогать всем, кто в этом нуждается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190611
					],
					"speakerTitle": "Цай Лэ"
				},
				{
					"id": 718190611,
					"content": "Ну, спасибо тебе ещё раз. Мне нужно поскорее вернуться к детям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190612
					],
					"speakerTitle": "Цай Лэ"
				},
				{
					"id": 718190612,
					"content": "А потом ещё и другие дела уладить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цай Лэ"
				}
			]
		},
		{
			"id": 7181907,
			"completionStepIds": [
				7181909
			],
