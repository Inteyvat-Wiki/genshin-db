				"objectNames": [
					"Хун И"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190301,
					"content": "Кто же мог отравить этот колодец...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190302
					],
					"speakerTitle": "Хун И"
				},
				{
					"id": 718190302,
					"content": "Доставка небесных фонарей!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190303
					]
				},
				{
					"id": 718190303,
					"content": "О, должно быть, от Департамента по делам граждан. Спасибо, давай его сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190304
					],
					"speakerTitle": "Хун И"
				},
				{
					"id": 718190304,
					"content": "Однако мне пока нельзя покидать свой пост. Нужно удостовериться, чтобы никто из жителей не набирал воду из этого колодца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190305
					],
					"speakerTitle": "Хун И"
				},
				{
					"id": 718190305,
					"content": "Эх... Кто знает, что с ним стало... Но пить из него ни в коем случае нельзя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хун И"
				}
			]
		},
		{
			"id": 7181904,
			"completionStepIds": [
				7181905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181905",
							"2"
						],
						"stepId": 7181905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"И Сянь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190401,
					"content": "*Хнык* Я... Я не дописала желание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190402
					],
					"speakerTitle": "И Сянь"
				},
				{
					"id": 718190402,
					"content": "Тише, малышка Сянь. Сейчас дядя Миллелит его тебе принесёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190403
					],
					"speakerTitle": "И Чжу"
				},
				{
					"id": 718190403,
					"content": "А где Цай Лэ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190404
					]
				},
				{
					"id": 718190404,
					"content": "Ты ищешь дядю Миллелита?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190405
					],
					"speakerTitle": "И Чжу"
				},
				{
					"id": 718190405,
					"content": "И Сянь нечаянно выпустила фонарик, когда писала желание, и он улетел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190406
					],
					"speakerTitle": "И Чжу"
				},
				{
					"id": 718190406,
					"content": "Дядя Миллелит увидел, что фонарик зацепился за дерево, и пошёл его снимать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190407,
						718190408
					],
					"speakerTitle": "И Чжу"
				},
				{
					"id": 718190407,
					"content": "Что в этом фонарике особенного?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				},
				{
					"id": 718190409,
					"content": "Я так ей и сказал, но она...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190410
					],
					"speakerTitle": "И Чжу"
				},
				{
					"id": 718190410,
					"content": "*Хнык-хнык* ...Н-нельзя. Мне его братик плёл. Он так старался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190411
					],
					"speakerTitle": "И Сянь"
				},
				{
					"id": 718190411,
					"content": "Малышка Сянь, сейчас дядя Миллелит его принесёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190412
					],
					"speakerTitle": "И Чжу"
				},
				{
					"id": 718190412,
					"content": "Прости, пожалуйста. Если тебе срочно нужен дядя Миллелит, то он где-то вон там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "И Чжу"
				},
				{
					"id": 718190408,
					"content": "Почему просто не сделать новый?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				}
			]
		},
