						],
						"pointId": 4
					}
				]
			},
			"dialogs": [
				{
					"id": 80200601,
					"content": "Как я и думал... Ложные воспоминания были ловушкой. Орден Бездны хотел, чтобы мы привели его к тайнику.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200602
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200602,
					"content": "Теперь, когда они рядом, мы сможем увидеть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200603
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200603,
					"content": "Ох!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200604
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200604,
					"content": "Дайн! Что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200605,
					"content": "Вы чувствуете? Помехи в артериях земли. Дело рук ордена Бездны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200606
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200606,
					"content": "Наверное, ты очень чувствителен к таким вещам. Паймон ничего не заметила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200607,
					"content": "#{NICKNAME}, воспользуйтесь тем механизмом и уходите. Сделайте, как я говорю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200608
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200608,
					"content": "Оставить тебя одного? Ты уверен, что всё будет в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200609
					]
				},
				{
					"id": 80200609,
					"content": "Орден Бездны приступил к реализации своего плана. Если вы сейчас вернётесь в деревню Вимара, наверняка найдёте там пропавшего человека.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200610
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200610,
					"content": "...Будем считать, что для успеха операции нам нужно разделиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200611
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200611,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200612
					]
				},
				{
					"id": 80200612,
					"content": "(Дайн говорит разумные вещи...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200613
					]
				},
				{
					"id": 80200613,
					"content": "(Но что-то не так... Что я упускаю?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200614
					]
				},
				{
					"id": 80200614,
					"content": "Хм... Я знал, что встречусь с тобой лишь в том случае, если попаду в твою ловушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200615
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200615,
					"content": "Ты поставил на кон собственную безопасность и сохранность глаза...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200616
					]
				},
				{
					"id": 80200616,
					"content": "#Весьма рискованный ход, Дайнслейф... Но сдаётся мне, это я попал{M#а} в ловушку Сумеречного Меча.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200617
					]
				},
				{
					"id": 80200617,
					"content": "#Ты {M#пришла одна}{F#пришёл один}? Где твои последователи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200618
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200618,
					"content": "#Если Сумеречный Меч готов к битве, никакая армия не поможет. Поэтому я {M#решила}{F#решил} встретиться с тобой в одиночку.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200619
					]
				},
				{
					"id": 80200619,
					"content": "Я знаю, тебе есть что мне рассказать...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200620
					]
				},
				{
					"id": 80200620,
					"content": "...Но сначала тебе придётся одержать надо мной победу.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				}
			]
		},
