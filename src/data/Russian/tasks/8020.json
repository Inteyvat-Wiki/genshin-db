				{
					"id": 80200304,
					"content": "Да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200305
					]
				},
				{
					"id": 80200305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200306
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200306,
					"content": "...У нас мало времени. Давайте пройдём внутрь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200307
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200307,
					"content": "(Что Дайн только что хотел нам сказать?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200308
					]
				},
				{
					"id": 80200308,
					"content": "Эй, подождите Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
