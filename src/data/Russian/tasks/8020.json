			"dialogs": [
				{
					"id": 80200301,
					"content": "Вот где ты его спрятал! Да, здесь его ни за что не найти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200302,
					"content": "Давайте скорее проверим, на месте ли он!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200303,
					"content": "#{NICKNAME}, подожди...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200304
					],
					"speakerTitle": "Дайнслейф"
