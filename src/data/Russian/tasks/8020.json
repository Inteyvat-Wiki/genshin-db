				]
			},
			"dialogs": [
				{
					"id": 80200201,
					"content": "Дайн! Эй! Дайн! Ау-у-у! Ты чего застыл?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200203
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200203,
					"content": "Что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200204,
					"content": "Что с тобой, Дайн?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200205
					]
				},
				{
					"id": 80200205,
					"content": "Вы можете описать пропавшего человека?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200206
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200206,
					"content": "Э?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200207,
					"content": "Молодой парень, двадцать лет или около того... Дайн, да что с тобой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200208,
					"content": "У меня в голове появились воспоминания, которых раньше не было...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200209
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200209,
					"content": "Воспоминания... о нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200210
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200210,
					"content": "Что? А может... может, мы вчера столько о нём говорили, что он тебе приснился?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200211,
					"content": "Нет. Это не сон, а воспоминания, которые внезапно появились в моей голове после пробуждения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200212
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200212,
					"content": "И я уверен, что никогда с ним не встречался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200213
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200213,
					"content": "И что это за «воспоминания»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200214
					]
				},
				{
					"id": 80200214,
					"content": "Воспоминания о том, как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200215
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200215,
					"content": "...я отдал ему глаз первого культиватора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200216
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200216,
					"content": "?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200217
					]
				},
				{
					"id": 80200217,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200218,
					"content": "...Значит теперь мы уверены, что пропавший как-то связан с орденом Бездны, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200219,
					"content": "Да. И похоже, что он умеет «вживлять» воспоминания в память людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200220
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200220,
					"content": "Как это вообще возможно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200221
					]
				},
				{
					"id": 80200221,
					"content": "Стоп, тогда... воспоминания о нём у жителей деревни Вимара... тоже фальшивые? Выходит, они с ним вовсе не знакомы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200222,
					"content": "Но зачем ему это понадобилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200223,
					"content": "Что бы ни задумал орден Бездны, сегодня нам удалось выяснить кое-что очень важное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200224
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200224,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200225,
					"content": "Они по-прежнему хотят получить... глаз первого культиватора. Они не отказались от своей цели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200226
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200226,
					"content": "А я единственный, кто знает, где он. Скорее всего, вживляя воспоминания, они попытались каким-то образом проникнуть в мой разум...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200227,
						80200228
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200227,
					"content": "Глаз по-прежнему в безопасном месте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				},
				{
					"id": 80200229,
					"content": "Твои опасения вполне обоснованны. Я думаю, что орден Бездны пока не способен подгонять реальность под воспоминания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200230
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200230,
					"content": "Но если учесть, как сильно им нужен глаз, нам нужно ни на секунду не забывать об осторожности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200231
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200231,
					"content": "Идите за мной. Давайте проверим, на месте ли глаз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200232
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200232,
					"content": "Ты собираешься показать нам, где его спрятал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200233,
					"content": "(...А вдруг за нами следят? Мы приведём за собой хвост, и орден запросто узнает, где прячется глаз.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200234
					]
				},
				{
					"id": 80200234,
					"content": "(Возможно, орден вживил воспоминания Дайну именно с этой целью? Чтобы заронить в нём подозрение, заставить проверить, на месте ли глаз...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200235
					]
				},
				{
					"id": 80200235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200236
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200236,
					"content": "(Насколько я знаю Дайна, он должен был это предусмотреть. Похоже, у него есть план...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200237,
						80200238
					]
				},
				{
					"id": 80200237,
					"content": "Идём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200239,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200238,
					"content": "Веди нас, Дайн.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200228,
					"content": "А если воспоминания не лгут?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				}
			]
		},
