					}
				]
			},
			"dialogs": [
				{
					"id": 80200501,
					"content": "Похоже, это тупик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200502,
					"content": "Будьте осторожны. Я чувствую присутствие Бездны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200503
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200503,
					"content": "Это орден Бездны! Они здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 802006,
