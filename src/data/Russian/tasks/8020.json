			"dialogs": [
				{
					"id": 80200101,
					"content": "Постойте... Это же... Дайнслейф!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200102,
					"content": "А, это вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200103
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200103,
					"content": "Это ваш друг?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200104
					],
					"speakerTitle": "Атосса"
				},
				{
					"id": 80200104,
					"content": "Ладно, мне пора в деревню. Надо проверить, как там староста и остальные жители. До встречи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200105
					],
					"speakerTitle": "Атосса"
				},
				{
					"id": 80200105,
					"content": "До встречи, Атосса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200106,
					"content": "Почему ты вечно появляешься из ниоткуда? Тебе что, доставляет удовольствие нас пугать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200107,
					"content": "Ничего личного... Если вы преследуете орден Бездны, рано или поздно наши пути обязательно пересекутся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200108
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200108,
					"content": "Значит, ты здесь из-за ордена Бездны? Теперь понятно, откуда взялись монстры, с которыми ты сражался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200109,
					"content": "Да. Подожди... А вы здесь не по той же причине?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200110,
						80200111
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200110,
					"content": "Мы тоже ищем орден Бездны...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				},
				{
					"id": 80200112,
					"content": "Не имеет значения. Я уверен, вы поняли, пусть и не сразу, что место это странное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200113
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200113,
					"content": "Орден Бездны готовит какой-то план... А возможно, они уже перешли к действиям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200114
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200114,
					"content": "И ты думаешь, это орден Бездны подначивает хиличурлов нападать на местных жителей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200115,
					"content": "Судя по всему, вряд ли они задались целью натравить хиличурлов на жителей деревни. Скорее, возросшая активность хиличурлов стала побочным эффектом их основного плана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200116
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200116,
					"content": "И всё равно хиличурлы опасны для деревни Вимара. Нам следует остаться и защитить деревню. Что думаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80200117,
					"content": "Лучший способ защитить деревню - выяснить, что на самом деле затевает орден Бездны. Так мы предотвратим возможную трагедию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200118,
						80200119
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200118,
					"content": "Давайте попробуем задать деревенским ещё несколько вопросов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200120,
					"content": "Вы их получите. Я не собираюсь ничего скрывать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200121
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200121,
					"content": "Не беспокойтесь. На этот раз у нас будет достаточно времени, чтобы как следует поговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80200119,
					"content": "А потом... ты тоже задолжал нам много ответов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200111,
					"content": "Но признаюсь, мы вышли на них случайно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				}
			]
		},
