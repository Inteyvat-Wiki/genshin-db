			"trigger": {
				"objectNames": [
					"Айлин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200660101,
					"content": "Ох, какая головная боль! Что же мне с этим делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660102
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200660102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660103
					]
				},
				{
					"id": 200660103,
					"content": "Готовлюсь к отборочным соревнованиям в Ордо Фавониус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660104
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200660104,
					"content": "Ах... Но мне никогда не стать такой же сильной, как Джинн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660105
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200660105,
					"content": "Нужно больше уделять внимание технике, а не силе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660106
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200660106,
					"content": "Я хотела снести эти чучела одним ударом, но они оказались довольно крепкими. Не знаю, где отец их достал, но он проделал неплохую работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660107
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200660107,
					"content": "Если у тебя найдётся минутка, подскажи, как это сделать, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660108,
						200660109
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200660108,
					"content": "Надо подумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660110
					]
				},
				{
					"id": 200660110,
					"content": "Конечно, не спеши. Эти чучела никуда не денутся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660111
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200660111,
					"content": "Да и я тоже никуда не денусь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200660114,
					"content": "Хм... Может начать с этой стороны, а потом в ту сторону кинуть бомбу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660115
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200660115,
					"content": "Ха-ха! Шучу. Даже не знаю, где мы возьмём бомбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200660109,
					"content": "Давай попробуем вместе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660112
					]
				},
				{
					"id": 200660112,
					"content": "Тебе нравится командный бой? Всегда приятно знать, что ты не один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660113
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200660113,
					"content": "Но я училась сражаться только в одиночку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Айлин"
				}
			]
		},
