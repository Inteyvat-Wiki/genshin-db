			"dialogs": [
				{
					"id": 710501401,
					"content": "Давай сейчас не будем обсуждать другие вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501402
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710501402,
					"content": "#Ты проделал{F#а} колоссальную работу в Разломе за эти несколько дней. Даже не знаю, как тебя отблагодарить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501403
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710501403,
					"content": "Я бы заплатил тебе ещё, но, боюсь, сколько бы я не дал, этого будет недостаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501404
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710501404,
					"content": "Если ты действительно хочешь заплатить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710501405
					]
				},
				{
					"id": 710501405,
					"content": "Ты, наверное, шутишь. Мне неловко заплатить тебе и оставить всё как есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501406
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710501406,
					"content": "Разве для тебя это не оскорбительно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501407
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710501407,
					"content": "Вот, возьми это письмо. Если путешествие приведёт тебя в Сумеру, и тебе понадобится помощь, отдай это письмо Пурбируни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501408
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710501408,
					"content": "Мы сделаем всё возможное, чтобы помочь тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501409
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710501409,
					"content": "«Дружба дороже золота.»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501410
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710501410,
					"content": "Так говорят в Сумеру. Мне кажется, это высказывание очень подходит в данной ситуации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хедив"
				}
			]
		}
	]
