				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110101,
					"content": "Альбедо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110102,
					"content": "Вы вернулись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110103
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110103,
					"content": "Мы очень старались! Посмотри на меч теперь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110104,
					"content": "Вот, взгляни.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110105
					]
				},
				{
					"id": 412110105,
					"content": "Хм... Вижу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110106
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110106,
					"content": "Как я и думал, этот меч набирается сил в сражениях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110107
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110107,
					"content": "Не очеловечивай его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110108,
					"content": "Это то, что делает его особенным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110109
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110109,
					"content": "Ладно. Давайте сначала обсудим одно важное дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110110
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110110,
					"content": "Я исследовал окрестные снега и обнаружил необычные следы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110111
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110111,
					"content": "Только не говори, что это воры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110112,
						412110113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110112,
					"content": "Но разве не мы настоящие воры в этой ситуации?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				},
				{
					"id": 412110114,
					"content": "Ну да...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110115,
					"content": "Я считаю, эти необычные следы нужно исследовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110116
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110116,
					"content": "Воры это или что-то другое, мы сможем узнать только завершив расследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110113,
					"content": "Вряд ли Похитители сокровищ так видят эту ситуацию...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				}
			]
		},
		{
			"id": 4121102,
			"completionStepIds": [
				4121109
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121109",
							"2"
						],
						"stepId": 4121109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110201,
					"content": "Фатуи? И они решили атаковать нас в лагере Похитителей сокровищ... Неужели они следовали за нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110202
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110202,
					"content": "Но зачем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110203,
					"content": "#А! Неужели ты спровоцировал{F#а} их, пока Паймон не видела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110204,
					"content": "Это правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110205,
						412110206
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110205,
					"content": "Как можно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				},
				{
					"id": 412110207,
					"content": "Тогда мы ни при чём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110208,
					"content": "Я думаю, Фатуи тоже ищут этот меч.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110209
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110209,
					"content": "Да-а? Разве ты не хранил его существование в секрете? Как они могли узнать о нём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110210,
					"content": "...Может, они видели, как вы пользуетесь им в горах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110211
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110211,
					"content": "Если их глаза остры, они могли заметить, что этот меч не такой, как все.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110212
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110212,
					"content": "Этим Фатуи вечно всё надо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110213,
					"content": "Нет, не всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110214
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110214,
					"content": "Мне доводилось слышать о чём-то подобном.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110215
					]
				},
				{
					"id": 412110215,
					"content": "Я думаю, вы уже знаете, что Фатуи охотятся на всё, что связано с Архонтами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110216
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110216,
					"content": "Да, на самом деле, господин Дилюк говорил об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110217,
					"content": "Дурин - заклятый враг Анемо Архонта, и он обладал соответствующей силой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110218
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110218,
					"content": "Сказать, что он мог бросить вызов Архонтам или что он связан с ними, не будет преувеличением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110219
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110219,
					"content": "Неудивительно, что Фатуи заинтересованы в этом мече.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110220
					]
				},
				{
					"id": 412110220,
					"content": "Вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110221,
					"content": "Недавно я сделал открытие, пока делал зарисовки в окрестностях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110222
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110222,
					"content": "Недалеко отсюда по прямой есть очень интересное место. Энергия Артерий земли там течёт по-другому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110223
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110223,
					"content": "Это притягивает монстров. Попадая под влияние этого места, они через некоторое время становятся сильнее сородичей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110224
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110224,
					"content": "Это удобно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110225,
					"content": "Нам ведь нужно, чтобы меч напился энергии? Так пойдём, потренируемся на них!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110226,
					"content": "Неплохо. И будьте добры, понаблюдайте, какое влияние этот меч оказывает на разных врагов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110206,
					"content": "#Я никогда не сделал{F#а} бы такого.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				}
			]
		},
		{
			"id": 4121103,
			"completionStepIds": [
				4121112
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121112",
							"2"
						],
						"stepId": 4121112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110301,
					"content": "Ну, как оно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110302,
						412110303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110302,
					"content": "Сила меча крепнет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110304
					]
				},
				{
					"id": 412110304,
					"content": "У меня есть гипотеза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110305
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110305,
					"content": "Поглощая энергию противника, меч резонирует с лежащими глубоко в здешних снегах останками Дурина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110306
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110306,
					"content": "Ух ты... Вот это да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110307,
					"content": "Если моя гипотеза верна, значит, местные монстры тоже могут иметь связь с тем, что осталось от дракона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110308
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110308,
					"content": "Почему так происходит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110309
					]
				},
				{
					"id": 412110309,
					"content": "Боюсь, это связано с источником энергии местных монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110310
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110310,
					"content": "Дурин - необычное существо. Пусть он и мёртв сейчас, все эти горы до сих пор находятся под влиянием его останков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110311
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110311,
					"content": "Сами его силы... могут быть своего рода проклятием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110312
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110312,
					"content": "У нас недостаточно информации. Нужно как следует поразмыслить, получить больше данных. И здесь ваш выход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110313
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110313,
					"content": "И когда это мы успели перейти от сказок к работе?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110314,
					"content": "Сейчас мне нужно закончить с кое-какой исследовательской работой, поэтому нам пока придётся разделиться. Давайте встретимся позже около сломанного моста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110303,
					"content": "Реакция разная... Но энергия струится одна и та же.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110304
					]
				}
			]
		},
