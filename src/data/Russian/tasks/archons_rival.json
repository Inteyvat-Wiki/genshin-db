			},
			"dialogs": [
				{
					"id": 412110401,
					"content": "Тут действительно было много людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110402,
					"content": "Их было явно больше, чем один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110403,
					"content": "Посмотри! Выглядит, будто это были Похитители сокровищ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110404
					]
				},
				{
					"id": 412110404,
					"content": "Значит, здесь у них лагерь... Интересно, они здесь ради грабежа, как и всегда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110405,
					"content": "В горах много одиноких искателей приключений, грабить их очень удобно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110406
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412110406,
					"content": "Здесь выживает сильнейший, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110407,
					"content": "Они столько воруют, а всё равно бедны как церковные мыши. Какой ужас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110408,
						412110409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110408,
					"content": "Полагаешь, им стоит сочувствовать?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110410
					]
				},
				{
					"id": 412110410,
					"content": "Пф-ф! Всё равно те, кто назвал Паймон воришкой, не заслуживают жалости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110411,
					"content": "Кто это? Кто посмел ворваться в наш лагерь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110412
					],
					"speakerTitle": "???"
				},
				{
					"id": 412110412,
					"content": "А-а, нас заметили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412110409,
