					"nextDialogs": [
						708240202
					]
				},
				{
					"id": 708240202,
					"content": "Ты подметать умеешь? А, ладно. У нас так мало работников, что любая помощь не помешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240203
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 708240203,
					"content": "Пойдём внутрь. Там много где нужно убрать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аделинда"
				}
			]
		},
