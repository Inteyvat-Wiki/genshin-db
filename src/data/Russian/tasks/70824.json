			"dialogs": [
				{
					"id": 708240401,
					"content": "#Ты уже закончил{F#а} убирать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240402
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 708240402,
					"content": "Да, всё чисто.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240403
					]
				},
				{
					"id": 708240403,
					"content": "#Отлично. Ты мне здорово помог{F#ла}. Будь я одна, не представляю, когда со всем бы управилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240404
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 708240404,
					"content": "А если бы за дело взялись девочки... Сколько всего они бы сломали и побили...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240405
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 708240405,
					"content": "Пожалуйста, прими. Прошу прощения, что тебе пришлось подметать. Ты всё-таки наш гость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240406
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 708240406,
					"content": "К твоему следующему визиту здесь всё будет сверкать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аделинда"
				}
