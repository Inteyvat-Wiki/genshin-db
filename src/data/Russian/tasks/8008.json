			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Юэ Хуэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80080101,
					"content": "Здравствуйте! Мы готовы сообщить о результатах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80080102,
					"content": "О! Наконец-то! Я немного волновался. Я, конечно, заплатил вам, и вы настоящие профессионалы, но всё же на душе было неспокойно. Мне бы не хотелось, чтобы с вами что-то случилось. Вам пришлось исследовать такое странное место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080103
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80080103,
					"content": "Если бы что-то произошло, меня бы мучила совесть до конца жизни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080104
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80080104,
					"content": "Всё хорошо. Нам любая задача по плечу! Мы в порядке и сумели разобраться в ситуации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80080105,
					"content": "Отлично, отлично. Так что там происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080106
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80080106,
					"content": "Ну... Э...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080107,
						80080109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80080107,
					"content": "Хиличурлы спускаются туда, чтобы обрести покой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080108
					]
				},
				{
					"id": 80080108,
					"content": "Покой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80080111,
					"content": "Если вкратце, то хиличурлы, которые туда спускаются, больше не агрессивны, и мы надеемся, что шахтёры не будут их сильно беспокоить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080112,
						80080113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80080112,
					"content": "Верно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080114,
					"content": "Мы, шахтёры, ужасно заняты и никогда не стали бы мешать им. Нам нужно только то, что блестит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080115
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80080115,
					"content": "Такая философия Паймон нравится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80080116,
					"content": "Я не совсем понимаю то, о чём вы рассказали. Но раз вы уверяете, что всё в порядке, то я спокоен. Это значит, что мы можем в любой момент приступить к работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080117
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80080117,
					"content": "Спасибо! Пожалуйста, примите это в знак благодарности за ваши труды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80080113,
					"content": "Не переживайте.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080109,
					"content": "Там последнее пристанище хиличурлов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080110
					]
				},
				{
					"id": 80080110,
					"content": "Пристанище?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Юэ Хуэй"
				}
			]
		}
	]
