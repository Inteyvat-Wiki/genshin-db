			"dialogs": [
				{
					"id": 60110701,
					"content": "...Интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110702
					],
					"speakerTitle": "Лунный мститель"
				},
				{
					"id": 60110702,
					"content": "Ты давно преследуешь меня. Не хочешь показаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110703
					],
					"speakerTitle": "Лунный мститель"
				},
				{
					"id": 60110703,
					"content": "Ха-ха, верно! Забыл представиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110704
					],
					"speakerTitle": "Варка"
				},
				{
