						"pointId": 13087
					},
					{
						"sceneId": 3,
						"position": [
							1547.907,
							258.402,
							9321.152
						],
						"pointId": 13088
					}
				]
			},
			"dialogs": [
				{
					"id": 60110201,
					"content": "Этот человек был подобен маяку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110202
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110202,
					"content": "Он просто жил, дарил свет окружающим и являл им благодать. Но люди привыкли к свету и перестали замечать присутствие фонаря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110203
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110203,
					"content": "Постепенно он и сам начал мыслить так же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110204
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110204,
					"content": "«Мои поступки не представляют собой ничего особенного. Я недостаточно хорошо выполнил свою работу. Я должен быть терпеливым. Я должен ждать...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110205
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110205,
					"content": "Его конец трагичен, но я по-прежнему горжусь тем, как он освещал путь другим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110206
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110206,
					"content": "Каждая тень, рождённая из света, должна помнить об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110207
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110207,
					"content": "Бедняга...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60110208,
					"content": "#Однажды я услышал{F#а} историю об Альве-Фонарщике.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110209
					]
				},
				{
					"id": 60110209,
					"content": "Ах. Я тоже слышал эту историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110210,
						60110211
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110210,
					"content": "#И я хотел{F#а} бы сказать ему то же самое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				},
				{
					"id": 60110212,
					"content": "Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110213
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110213,
					"content": "Пожалуй, вы правы. Может показаться, что наши усилия были напрасны, что Рери достиг своих целей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110214
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110214,
					"content": "Но мы будем преследовать его до последнего, даже если результат окажется не таким, как нам хотелось бы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110215
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110215,
					"content": "Это похоже на работу кладбищенского сторожа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110216
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110216,
					"content": "Мы не стремимся вернуть мёртвых к жизни, а лишь даруем им покой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110217
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110217,
					"content": "Хорошо сказано.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110218
					]
				},
				{
					"id": 60110218,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110219
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110219,
					"content": "О чём вы говорите? Объясните Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60110220,
					"content": "Не сейчас, Паймон. Я всё объясню тебе, когда мы вернёмся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110221
					]
				},
				{
					"id": 60110221,
					"content": "Хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60110222,
					"content": "В любом случае главное действующее лицо этих похорон не Альв-Фонарщик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110223
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110223,
					"content": "«Светоносец, своей кровью ты проложил дорогу к славе и справедливости».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110224
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110224,
					"content": "«Хотя мы спешим вперёд, хотя мы получим много ран, остановись ненадолго и взгляни на мир, на его любовь и ненависть».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110225
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110225,
					"content": "«Пока мир не закроет глаза в глубине ночи, пока для тебя одного не зажжётся фонарь, который больше никто не видит».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110226
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110226,
					"content": "Спасибо за всё, сержант-майор Соссий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110211,
					"content": "Не нужно зацикливаться на результате.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				}
			]
		},
