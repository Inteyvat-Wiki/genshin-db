			"dialogs": [
				{
					"id": 60110501,
					"content": "Босс, я... Помните, я хотела спросить ваше мнение по одному вопросу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110502
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 60110502,
					"content": "По шкале от 1 до 10, сколько усилий должен приложить Кураторий тайн, если мы снова будем работать с другими?",
					"roleType": "TALK_ROLE_NPC",
