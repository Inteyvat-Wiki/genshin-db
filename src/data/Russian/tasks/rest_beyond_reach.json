							9954.46
						],
						"pointId": 13576
					}
				]
			},
			"dialogs": [
				{
					"id": 60110801,
					"content": "Флинс? Ты редкий гость в моей мастерской. Осмотрись пока. Я сейчас занята.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110802
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 60110802,
					"content": "Я пришёл навестить вас, госпожа Айно. И я принёс из города традиционные закуски со сливочным маслом. Где их оставить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110803
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110803,
					"content": "Тише! ...Инеффа услышит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110804
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 60110804,
					"content": "...Итак, что привело тебя сюда? Хочешь сказать... что Светоносцы возьмут на себя все инциденты с Дикой Охотой после того случая с пушкой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110805
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 60110805,
					"content": "Критиковать такого гения, как ты, из-за результатов, которые никто из нас не мог предвидеть? Разумеется, мы не будем столь бестактны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110806
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110806,
					"content": "Если мы так поступим, смею предположить, мы больше никогда не увидим технологических прорывов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110807
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110807,
					"content": "Хм. Подлиза...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110808
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 60110808,
					"content": "Я рад, что смог развеять ваши опасения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110809
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110809,
					"content": "Так в чём дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110810
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 60110810,
					"content": "Не могли бы вы помочь мне починить этот фонарь? Я сдавал его в ремонт в Нашгороде, но он снова сломался во время нашей последней битвы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110811
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110811,
					"content": "Хочешь, чтобы такой гений, как я, чинил фонарь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110812
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 60110812,
					"content": "О, прошу прощения. Возможно, с этой просьбой лучше обратиться к госпоже Инеффе, да и сладости тоже ей отдать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110813
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110813,
					"content": "Что-о-о?.. Я... Я хочу сказать, что вполне могу это сделать, без проблем. Подожди здесь. Я закончу, прежде чем ты успеешь сказать «Почини!».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110814
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 60110814,
					"content": "Премного благодарен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110815
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60110815,
					"content": "И в следующий раз, когда что-то подобное снова случится, сразу приходи ко мне, слышишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айно"
				}
			]
		},
