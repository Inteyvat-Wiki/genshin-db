					"Айно"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 60111001,
					"content": "«Почини мой фонарь», - говорит он. Тоже мне! Это займёт меньше десяти минут!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111002
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 60111002,
					"content": "Вот бы каждый занимался своим делом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111003
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 60111003,
					"content": "Взять, к примеру, этого Хинцу. Как, честное слово, можно создать интегрированный контроллер для пушки и барьер из случайных компонентов, которые люди просят тебя починить? Уф, у меня от одной только мысли об этом голова болит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111004
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 60111004,
					"content": "Я отругала его и велела регулярно отчитываться. Если он в последнее время работал над этим проектом, я хочу об этом знать! Ладно... Признаю, в этом есть и толика моей вины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айно"
				}
			]
		},
		{
			"id": 601111,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
