					"Флинс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 60111101,
					"content": "#О, рад тебя видеть, {NICKNAME}. Лично я считаю, что после великого сражения необходимо провести ремонт и техническое обслуживание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111102
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60111102,
					"content": "#Спасибо, что сохранил{F#а} мои секреты, несмотря на то, что знаешь так много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111103,
						60111104
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 60111103,
					"content": "Раньше не было времени об этом спросить, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				},
				{
					"id": 60111105,
					"content": "Я не хотел иметь проблем со Старшиной. Если бы его нельзя было обнаружить, то начальство заставило бы меня использовать обычный фонарь ратника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111106
					],
					"speakerTitle": "Флинс"
				},
