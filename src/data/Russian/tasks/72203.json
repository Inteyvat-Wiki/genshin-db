			"dialogs": [
				{
					"id": 722030501,
					"content": "#Ха-ха, ты снова меня {F#нашла}{M#нашёл}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030502
					],
					"speakerTitle": "Нонно"
				},
				{
					"id": 722030502,
					"content": "Знаешь, я буду скучать по тебе, но... но я хочу попрощаться. Золотой дядя говорит, что нам пора идти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030503
					],
					"speakerTitle": "Нонно"
				},
				{
					"id": 722030503,
					"content": "#Не беспокойся обо мне! Там, куда я иду, есть много людей, с которыми можно поиграть! Было бы здорово, если бы ты тоже {F#пошла}{M#пошёл}, но золотой дядя говорит, что ещё не время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "Нонно"
				},
				{
					"id": 722030504,
					"content": "Всё хорошо. Правда. Я просто буду ждать тебя там... а если не дождусь, то превращусь в частички света и приду к тебе во сне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "Нонно"
				},
				{
					"id": 722030505,
					"content": "Удачи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "Спасибо! С тобой было очень весело играть. Спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030507
					],
					"speakerTitle": "Нонно"
				},
				{
					"id": 722030507,
					"content": "Я больше не буду в одиночестве... Это здорово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нонно"
				}
			]
