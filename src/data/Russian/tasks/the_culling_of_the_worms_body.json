			"trigger": {
				"objectNames": [
					"Винаяк",
					"Шрия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735150101,
					"content": "#А вот и ты, искатель{F#ница} приключений. Мы как раз планировали всё собрать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150102
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735150102,
					"content": "Если испытание пройдёт гладко, сегодня мы хорошенько проучим чудище. Этот день ему надолго запомнится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150103
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735150103,
					"content": "После запуска процесса зарядки окрестные монстры могут попытаться нам помешать. В это время нужно следить за ходом зарядки и прочностью устройства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150104,
						735150105
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735150104,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				},
				{
					"id": 735150106,
					"content": "#Большое спасибо, искатель{F#ница} приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150107
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735150107,
					"content": "#О, у меня есть идея! Ты нам здорово помог{F#ла} с унутобойной пушкой. Так что и честь первого испытания предоставляется тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150108,
						735150110
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735150108,
					"content": "Разве ты не хочешь сам это сделать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150109
					]
				},
				{
					"id": 735150109,
					"content": "Я с радостью понаблюдаю за выстрелами. Во всей красе стрельбу можно увидеть, только если зажиганием займётся кто-то другой... Ах, что тут говорить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735150112,
					"content": "Тебе нужно только защищать зарядное устройство от монстров и ждать, пока наполнится энергия. Как только унут покажет уязвимое место, стреляй без колебаний!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150113
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735150113,
					"content": "Об остальном позаботятся устройства зажигания и автокоррекции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150114
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735150114,
					"content": "#Звучит впечатляюще. {NICKNAME}, Паймон тоже хочет посмотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735150115,
					"content": "Хорошо, я с этим справлюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150116
					]
				},
				{
					"id": 735150116,
					"content": "Отлично, тогда договорились! Давай я расскажу тебе, как тут всё работает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735150110,
					"content": "Я не знаю, как работает эта штука...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150111
					]
				},
				{
					"id": 735150111,
					"content": "Не переживай! Я разрабатывал её в соответствии с принципами удобства пользователей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735150105,
					"content": "Без проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				}
			]
		}
	]
}