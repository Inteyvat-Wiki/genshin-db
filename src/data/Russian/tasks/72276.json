			"dialogs": [
				{
					"id": 722761201,
					"content": "Вы вернулись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761202
					],
					"speakerTitle": "Ябэ"
				},
				{
					"id": 722761202,
					"content": "Привет, как там...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761203
					]
				},
				{
					"id": 722761203,
					"content": "Ябэ! Меня зовут Ябэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761204
					],
					"speakerTitle": "Ябэ"
				},
				{
					"id": 722761204,
					"content": "#Уф, когда ты уже запомнишь моё имя. Только не говори, что забыл{F#а}, зачем я тебя послал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761205
					],
					"speakerTitle": "Ябэ"
				},
				{
					"id": 722761205,
					"content": "#{NICKNAME} просто шутит. Мы раскрыли тайну сокровища Бункоку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722761206,
					"content": "Вы рассказываете Ябэ о произошедшем...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722761207
					]
				},
				{
					"id": 722761207,
					"content": "Значит, тайная комната, скрытая солнечными фантазмами, и правда существует? Но, кажется, случилось что-то ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761208
					],
					"speakerTitle": "Ябэ"
				},
				{
					"id": 722761208,
					"content": "Ещё комнату охраняют мстительные духи и порождения скверны, которые могут управлять сознанием. Ох, это так страшно. Как хорошо, что я не пошёл с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761209
					],
					"speakerTitle": "Ябэ"
				},
				{
					"id": 722761209,
					"content": "Боишься причинить нам вред?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761210
					]
				},
				{
					"id": 722761210,
					"content": "Боюсь, что вы могли бы задать мне хорошую взбучку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761211
					],
					"speakerTitle": "Ябэ"
				},
				{
					"id": 722761211,
					"content": "В любом случае я и доволен, и расстроен одновременно. Спасибо. Какой бы сложной не казалась головоломка, всё объясняется силами элементов. Так неинтересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761212
					],
					"speakerTitle": "Ябэ"
				},
				{
					"id": 722761212,
					"content": "Головоломка Бункоку наконец разгадана. Я объявлю об этом по возвращении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ябэ"
				}
			]
		},
