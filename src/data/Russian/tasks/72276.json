			},
			"dialogs": [
				{
					"id": 722761001,
					"content": "Как... Как такое возможно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761002
					],
					"speakerTitle": "Коянаги"
				},
				{
					"id": 722761002,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722761003,
					"content": "Как я мог напасть на своего друга...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761004
					],
					"speakerTitle": "Коянаги"
				},
				{
					"id": 722761004,
					"content": "Должно быть, в меня вселился один из мстительных духов, вызванных Бункоку. Он управлял мною...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761005
					],
					"speakerTitle": "Коянаги"
				},
				{
					"id": 722761005,
					"content": "Сокровище - ничто по сравнению с нашей дружбой. Я... я бы никогда не поддался искушению напасть на него из-за какого-то там сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761006
					],
					"speakerTitle": "Коянаги"
				},
				{
					"id": 722761006,
					"content": "Он так сильно доверял мне, что даже пригласил меня сюда, чтобы вместе найти сокровище Бункоку... Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761007
					],
					"speakerTitle": "Коянаги"
				},
				{
					"id": 722761007,
					"content": "Я бы никогда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761008
					],
					"speakerTitle": "Коянаги"
				},
				{
					"id": 722761008,
					"content": "Так правда была скрыта в последнем фрагменте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761009
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722761009,
					"content": "Ему нужно немного побыть одному.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761010
					]
				},
				{
					"id": 722761010,
					"content": "Да уж.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761011
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722761011,
					"content": "Давай вернёмся и расскажем Ябэ, что случилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
