						722760703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722760703,
					"content": "Оказывается, узор превратился в настоящую дверь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722760704,
					"content": "Разве мы не вернёмся в ту же комнату внизу?",
