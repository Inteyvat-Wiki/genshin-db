			"dialogs": [
				{
					"id": 718040501,
					"content": "Соблюдайте порядок! Соблюдайте порядок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040502,
						718040504
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 718040502,
					"content": "Иванович хочет получить новое разрешение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040503
					]
				},
				{
					"id": 718040503,
					"content": "#А? Ты его представитель? Подготовили учредительные документы организации и это самое... как его... а, обязательство по безопасности бизнеса? Всё {M#принёс}{F#принесла}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 718040504,
					"content": "Ты отвечаешь за сертификаты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040505
					]
				},
				{
					"id": 718040505,
					"content": "Нет-нет, я просто помогаю пока. У Чжао сейчас куча дел и меня позвали помочь принимать документы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040506
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 718040506,
					"content": "#Эх, такая утомительная работа... Так. Так ты {M#принёс}{F#принесла} учредительные документы и обязательство по безопасности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзя И"
				}
			]
		},
