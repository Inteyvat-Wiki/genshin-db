			"dialogs": [
				{
					"id": 718040201,
					"content": "Доска объявлений торговой площади Фэйюнь. Здесь вы сможете узнать последние новости и ознакомиться с рекламными материалами местных магазинов. Пожалуйста, не засоряйте доску бессмысленными объявлениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040202,
						718040205,
						718040208
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 718040202,
					"content": "Информация о ротации кадров в Департаменте по делам граждан...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040203
					]
				},
				{
					"id": 718040203,
					"content": "«Ротация кадров Департамента по делам граждан производится следующим...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040204
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 718040204,
					"content": "Погоди-ка, это ведь не имеет никакого отношения к разрешениям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718040205,
					"content": "Сообщение о загрязнении вод источника на торговой площади Фэйюнь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040206
					]
				},
				{
					"id": 718040206,
					"content": "«Проблема загрязнения источника рядом с площадью Фэйюнь...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040207
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 718040207,
					"content": "Иванович торопится же. У нас нет времени читать о загрязнении воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718040208,
					"content": "Заявление на получение нового разрешения на ведение коммерческой деятельности...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040209
					]
				},
				{
					"id": 718040209,
					"content": "«При подаче заявления на получение разрешения на ведение коммерческой деятельности необходимы следующие...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040210
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 718040210,
					"content": "Похоже, это про новую лицензию, которую хочет получить Иванович. Давай скорее перепишем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7180403,
			"completionStepIds": [
				7180403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
