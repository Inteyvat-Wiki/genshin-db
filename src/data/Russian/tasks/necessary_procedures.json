			"dialogs": [
				{
					"id": 718040401,
					"content": "Опять эти документы не так заполнены...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040402
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 718040402,
					"content": "Иванович хочет получить новое разрешение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040403
					]
				},
				{
					"id": 718040403,
					"content": "Иванович... А, помню, приходил он пару раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040404
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 718040404,
					"content": "Он на новое разрешение подаёт, да? Хе-хе... Набегался уж, наверное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040405
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 718040405,
					"content": "#Ты, наверное, ему помогаешь? {M#Принёс}{F#Принесла} <color=#00E1FFFF>разрешение на выход в море</color>? Я ему говорил в тот раз, что у него не так заполнено и надо ещё в другое место сходить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нервный Ань"
				}
			]
		},
