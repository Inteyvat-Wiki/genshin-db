			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иванович"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718040301,
					"content": "#Ты {M#нашёл}{F#нашла} объявление о новом разрешении?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040302
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 718040302,
					"content": "#Да, и переписал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040303
					]
				},
				{
					"id": 718040303,
					"content": "Прекрасно! Ну-ка посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040304
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 718040304,
					"content": "Разрешение на выход в море, учредительные документы коммерческой организации и обязательство по безопасности ведения бизнеса... и старое разрешение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040305
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 718040305,
					"content": "Ничего, это ничего. Эти документы я ещё пару дней назад бегал подписывал. Целый марафон был.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040306
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 718040306,
					"content": "#Путешественн{F#ица}{M#ик}, поможешь мне подать эти документы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040307
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 718040307,
					"content": "Кхм... Правда, подавать их надо разным людям...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040308
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 718040308,
					"content": "Так, сначала <color=#00E1FFFF>разрешение на выход в море</color> нужно отдать Нервному Аню, а <color=#00E1FFFF>учредительные документы коммерческой организации и обязательство по безопасности ведения бизнеса</color> надо отдать Миллелиту Цзя И...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040309
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 718040309,
					"content": "А потом отдать <color=#00E1FFFF>старое разрешение на ведение коммерческой деятельности</color> клерку Чжао, и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040310
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 718040310,
					"content": "#Помоги мне, пожалуйста, подать эти бумаги, путешественн{F#ица}{M#ик}. Я обязательно тебя отблагодарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040311
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 718040311,
					"content": "Ладно, ладно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040312
					]
				},
				{
					"id": 718040312,
					"content": "Надеюсь, после этих формальностей уже всё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040313
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 718040313,
					"content": "Да уж.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040314
					]
				},
				{
					"id": 718040314,
					"content": "Тебе-то, наверное, больше никогда этим не придётся заниматься, а мне вот... Если хочу здесь торговать, то потом всё равно придётся бегать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040315
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 718040315,
					"content": "Эх, такие методы внушают спокойствие, конечно, но было бы неплохо их немного упростить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иванович"
				}
			]
		},
