					"nextDialogs": [
						733480904
					]
				},
				{
					"id": 733480904,
					"content": "Об учёном дома Пурбируни? Ты ведь к Садифэю? Вот так чудеса, к нему кто-то пришёл.",
					"roleType": "TALK_ROLE_NPC",
