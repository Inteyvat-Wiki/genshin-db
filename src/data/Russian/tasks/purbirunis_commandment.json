			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Садифэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733480301,
					"content": "#Путешественни{F#ца}{M#к}, вы вернулись. Позвольте спросить вас о моём сундуке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480302,
						733480303
					],
					"speakerTitle": "Садифэй"
				},
				{
					"id": 733480302,
					"content": "Он здесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				},
				{
					"id": 733480304,
					"content": "Отлично! Я так благодарен вам... Ах, вы пришли ко мне с рекомендательным письмом, а я заставил вас ещё и помогать мне. Мне так стыдно! Всё-таки прошу вас, примите от меня мору за труды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480305,
						733480311
					],
					"speakerTitle": "Садифэй"
				},
				{
					"id": 733480305,
					"content": "Вы хотите сказать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480306,
					"content": "А? Вам не знаком этот оборот речи? У нас, учёных из Пурбируни, есть одно предостережение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480307
					],
					"speakerTitle": "Садифэй"
				},
				{
					"id": 733480307,
					"content": "Оно напоминает нам о том, что ни деньги, ни другие материальные блага ни в коем случае не должны мешать науке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480308
					],
					"speakerTitle": "Садифэй"
				},
				{
					"id": 733480308,
					"content": "Ведь если некий исследователь во главу угла поставит выгоду, то... он не достоин называться исследователем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480309
					],
					"speakerTitle": "Садифэй"
				},
				{
					"id": 733480309,
					"content": "Но вы так старались, чтобы помочь мне, что должны получить достойную награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480310
					],
					"speakerTitle": "Садифэй"
				},
				{
					"id": 733480310,
					"content": "Ещё раз большое спасибо за помощь. Если в будущем я смогу быть вам как-то полезен, только скажите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Садифэй"
				},
				{
					"id": 733480311,
					"content": "«За мудрость не платят морой»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480303,
					"content": "Мы вернули его.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				}
			]
		},
		{
			"id": 7334804,
			"completionStepIds": [
				7334804
