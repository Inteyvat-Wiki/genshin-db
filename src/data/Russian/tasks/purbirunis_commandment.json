					{
						"sceneId": 3,
						"position": [
							-1855.176,
							155.344,
							5478.426
						],
						"pointId": 330700025
					}
				]
			},
			"dialogs": [
				{
					"id": 733480201,
					"content": "Постой, не надо! Не бей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480202
					],
					"speakerTitle": "Дара"
				},
				{
					"id": 733480202,
					"content": "Из-за сундука с какими-то книгами не стоит так лютовать... Если хочешь, я всё тебе отдам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480203,
						733480204
					],
					"speakerTitle": "Дара"
				},
				{
					"id": 733480203,
					"content": "Это всё?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				},
				{
					"id": 733480205,
					"content": "Клянусь! Мы откопали здесь только его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480206
					],
					"speakerTitle": "Дара"
				},
				{
					"id": 733480206,
					"content": "Кроме книг в нём были ещё какие-то камни и грязь в склянках... Среди камней было несколько симпатичных самоцветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480207
					],
					"speakerTitle": "Дара"
				},
				{
					"id": 733480207,
					"content": "И куда вы дели самоцветы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480208
					]
				},
				{
					"id": 733480208,
					"content": "Эй! Немедленно возвращай все камни! Это бесценные геологические образцы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733480209,
					"content": "Геологические... образцы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480210,
						733480211
					],
					"speakerTitle": "Дара"
				},
				{
					"id": 733480210,
					"content": "Верни их.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480212,
					"content": "Всё-всё вернём! Скорее, складывайте всё в сундук...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480213
					],
					"speakerTitle": "Дара"
				},
				{
					"id": 733480213,
					"content": "Все камни и записи в сундуке. Мы пойдём?.. Ха-ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480214
					],
					"speakerTitle": "Дара"
				},
				{
					"id": 733480214,
					"content": "Все вещи, которые были нужны Садифэю, на месте. Вернём ему сундук.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733480215,
					"content": "Он в одиночку отправился в пустыню, чтобы достать геологические образцы и сделать записи... Паймон думает, что он невероятный учёный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733480211,
					"content": "Считаю до трёх.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480204,
					"content": "Что-нибудь ещё?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				}
			]
		},
		{
			"id": 7334803,
			"completionStepIds": [
				7334805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7334805",
							"2"
						],
						"stepId": 7334805,
						"stateName": "QUEST_STATE_UNFINISHED"
