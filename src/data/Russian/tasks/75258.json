			},
			"dialogs": [
				{
					"id": 752580101,
					"content": "А? Кажется, кто-то здесь лежит без сознания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752580102,
					"content": "Эй, ты слышишь Паймон? Что с тобой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752580103,
					"content": "Вы усаживаете лежащего человека и помогаете ему прийти в себя...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752580104
					]
				},
				{
					"id": 752580104,
					"content": "Ой-ой-ой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580105,
						752580106
					],
					"speakerTitle": "Потерявший сознание сотрудник"
				},
				{
					"id": 752580105,
					"content": "Перепил?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				},
				{
					"id": 752580107,
					"content": "У меня голова кружится... Что происходит? ...Дайте-ка подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580108
					],
					"speakerTitle": "Потерявший сознание сотрудник"
				},
				{
					"id": 752580108,
					"content": "Ой, я вспомнил! Меня ударили, и я потерял сознание... Но я не видел, кто это сделал. Подождите... это были не вы, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580109
					],
					"speakerTitle": "Потерявший сознание сотрудник"
				},
				{
					"id": 752580109,
					"content": "Эй! Мы помогли тебе. Будь нам благодарен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752580110,
					"content": "Ой, извините... Эм, я работаю в баре «Пьяный мёд». Изначально я собирался доставить кое-какие товары в порт на севере. Хм... И там был один торговец из Нод-Края, который купил у нас медовое вино.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580111
					],
					"speakerTitle": "Потерявший сознание сотрудник"
				},
				{
					"id": 752580111,
					"content": "Ой! Что такое?! Где мои товары?! Моё медовое вино пропало! Его украли? Подождите... это не вы его украли?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580112
					],
					"speakerTitle": "Потерявший сознание сотрудник"
				},
				{
					"id": 752580112,
					"content": "Мы помогли тебе. Почему ты всё ещё нас в чём-то подозреваешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752580113,
					"content": "Ой, точно, точно. Простите, у меня голова немного кружится. Спасибо вам огромное, но мне нужно сейчас же сообщить обо всём в бар...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580114
					],
					"speakerTitle": "Потерявший сознание сотрудник"
				},
				{
					"id": 752580114,
					"content": "Раз тут орудуют грабители, не ходите в северный порт. Это может быть опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Потерявший сознание сотрудник"
				},
				{
					"id": 752580106,
					"content": "Мне тебя проводить домой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				}
			]
		}
	]
}