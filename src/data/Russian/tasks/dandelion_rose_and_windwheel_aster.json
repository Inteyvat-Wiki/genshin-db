					"Джинн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705060101,
					"content": "Привет, милашка. Рада тебя видеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060102
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060102,
					"content": "Хоть и странно встретить тебя в таком месте, но я тоже рада тебя видеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060103
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060103,
					"content": "Что значит «в таком месте»? Таверна - прекрасное место для отдыха и развлечений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060104
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060104,
					"content": "Ох, можешь ли представить, каких трудов мне стоило вытащить действующего магистра из-за рабочего стола?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060105
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060105,
					"content": "Мы только пришли, а она уже вся извелась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060106
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060106,
					"content": "Лиза...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060107
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060107,
					"content": "Всё-таки в ордене полно дел...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060108
					]
				},
				{
					"id": 705060108,
					"content": "Да! Это же магистр Джинн, и на ней лежит ответственность за Ордо Фавониус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705060109,
					"content": "Но знаешь, как говорят? «Пришли так уж пришли!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705060110,
					"content": "#Пусть {F#путешественница}{M#путешественник} приготовит вам парочку отличных напитков. Повеселитесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705060111,
					"content": "Да, отдыхать иногда тоже нужно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060112
					]
				},
				{
					"id": 705060112,
					"content": "Джинн - единственная из моих друзей, кого нужно учить, как расслабляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060113
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060113,
					"content": "А смешай мне Любовные стихи, пожалуй. Среднюю кружку, послаще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060114
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060114,
					"content": "Джинн, а тебе чего хочется?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060115
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060115,
					"content": "Мне только... кофе. Средний, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060116
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060116,
					"content": "Магистр Джинн, ты и так всё время пьёшь кофе. Может, попробуешь что-то новое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705060117,
					"content": "Нет, спасибо. Мне нужно взбодриться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060118
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060118,
					"content": "Ясно. Сейчас всё будет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060119
					]
				},
				{
					"id": 705060119,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джинн"
				}
			]
		},
		{
			"id": 7050602,
			"completionStepIds": [
				7050604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050604",
							"2"
						],
						"stepId": 7050604,
						"stateName": "QUEST_STATE_UNFINISHED"
