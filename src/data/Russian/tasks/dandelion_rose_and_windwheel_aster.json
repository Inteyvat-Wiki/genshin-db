			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лиза",
					"Джинн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705060201,
					"content": "М-м-м... сладко. То, что надо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060202
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060202,
					"content": "А кофе крепкий и насыщенный, с приятной горчинкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060203
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060203,
					"content": "#{M#Рад}{F#Рада}, что вам понравилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060204
					]
				},
				{
					"id": 705060204,
					"content": "Я понимаю, о чём ты, Лиза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060205
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060205,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060206
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060206,
					"content": "В последнее время я часто задумываюсь о своих недостатках. Мне не помешало бы поработать над эффективностью и управленческими навыками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060207
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060207,
					"content": "Кажется, моё напряжение передалось и Лизе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060208
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060208,
					"content": "Думаю, ты не совсем поняла.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060209
					]
				},
				{
					"id": 705060209,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060210
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060210,
					"content": "Хи-хи, видишь, милашка всех видит насквозь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060211
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060211,
					"content": "Я просто вытащила тебя пропустить стаканчик и развлечься, потому что вижу, как ты много работаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060212
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060212,
					"content": "Но даже в таверне ты думаешь о делах. Вот что больше всего беспокоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060213
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060213,
					"content": "Такое напряжение рано или поздно подкосит тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060214
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060214,
					"content": "Именно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060215
					]
				},
				{
					"id": 705060215,
					"content": "#{NICKNAME}, и ты так думаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060216
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060216,
					"content": "Хм, значит, научиться отдыхать - моя главная задача?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060217
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060217,
					"content": "Как говорят в Ли Юэ, всё должно быть в меру.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060218
					]
				},
				{
					"id": 705060218,
					"content": "Да! Усердно работай, а отдыхай ещё усерднее. Вам двоим нужно больше отдыха, чем вы думаете!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705060219,
					"content": "Это... интересный подход.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060220
					]
				},
				{
					"id": 705060220,
					"content": "Хи-хи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060221
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060221,
					"content": "Да... Я понимаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060222
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060222,
					"content": "Спасибо вам. Теперь я знаю, что в этом заведении не только подают напитки, но и бодрят дух. Так вот почему вам с Кэйей так нравится таверна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060223
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060223,
					"content": "И да, и нет. Вообще-то, это зависит от того, кто готовит напитки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060224
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060224,
					"content": "И кстати, без тебя мы бы не смогли переубедить Джинн. А у тебя, милашка, язык подвешен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060225,
						705060226
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060225,
					"content": "Ну что ты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				},
				{
					"id": 705060227,
					"content": "Хи-хи, до скорой встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060228
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 705060228,
					"content": "Если выпадет такая возможность, то, пожалуй, зайду сюда снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060229
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 705060229,
					"content": "Здорово! Берегите себя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705060226,
					"content": "#{M#Рад}{F#Рада} помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				}
			]
		}
	]
}