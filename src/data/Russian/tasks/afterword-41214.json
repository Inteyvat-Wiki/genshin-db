				"points": []
			},
			"dialogs": [
				{
					"id": 412140101,
					"content": "Это снова мы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412140102,
					"content": "#Путешественни{F#ца}{M#к}, Паймон. Вы вернулись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140103
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140103,
					"content": "Паймон уже привыкла вот так видеться с Альбедо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140104,
						412140105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412140104,
					"content": "Мы закончили с твоим поручением.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				},
				{
					"id": 412140106,
					"content": "Спасибо. Я знал, что сделал правильный выбор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140107
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140107,
					"content": "Когда попросил меня помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140108
					]
				},
				{
					"id": 412140108,
					"content": "#Конечно. Ты очень помог{F#ла} мне в моём исследовании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140109
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140109,
					"content": "Хе-хе, приятно слышать~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412140110,
					"content": "Я не забуду вашу доброту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140111
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140111,
					"content": "Я возвращаю меч тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140112
					]
				},
				{
					"id": 412140112,
					"content": "Наверное, он стал достаточно сильным?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412140113,
					"content": "Более или менее. Как ты себя чувствуешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140114
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140114,
					"content": "Как всегда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140115
					]
				},
				{
					"id": 412140115,
					"content": "Это хорошо. Никаких побочных эффектов, никакого яда и порочной энергии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140116
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140116,
					"content": "Полагаю... Я был прав.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140117
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140117,
					"content": "Ох уж этот Альбедо, делает вид, что он всезнайка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412140118,
					"content": "Нравится тебе меч?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140119,
						412140120
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140119,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140121,
					"content": "Вот как? Так или иначе, он достиг нужного мне состояния.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140122
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140122,
					"content": "Почему это ты так держишь меч... Альбедо, что ты задумал? Не делай глупостей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412140123,
					"content": "Я хочу извлечь из него очищенную тобой энергию жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140124
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140124,
					"content": "Разве она может существовать вне меча?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412140125,
					"content": "Возможно, другим такое не под силу, но не мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140126
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140126,
					"content": "...Замечательно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140127
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140127,
					"content": "Ого, эта энергия похожа на светящийся шарик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412140128,
					"content": "А ты поместил её в волшебную бутылку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412140129,
					"content": "Этот клинок, может, и не великое оружие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140130
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140130,
					"content": "Но всё равно, возьми его на память. Надеюсь, он сослужит тебе добрую службу в путешествии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140131,
						412140132
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140131,
					"content": "Правда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140133,
					"content": "Мне он был нужен лишь ради эксперимента. Теперь я получил результаты, так пусть он останется у тебя - ты найдёшь ему лучшее применение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140134
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140134,
					"content": "#Путешественни{F#ца}{M#к}, спасибо тебе за помощь в исследовании. А теперь... До встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140135
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140135,
					"content": "Жизненная энергия дракона резонирует со мной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140136
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140136,
					"content": "Но это происходит не потому что он дракон. Это происходит из-за меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140137
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140137,
					"content": "Рэйндоттир... Учитель... Так значит, Дурин - твоё творение?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140138
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140139
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140139,
					"content": "Действительно ли наша встреча к добру?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412140132,
					"content": "Тебе он не нужен?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140120,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140105,
					"content": "Мы сделали то, о чём ты нас просил.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				}
			]
		}
	]
}