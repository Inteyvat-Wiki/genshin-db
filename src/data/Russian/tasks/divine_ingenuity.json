	"talks": [
		{
			"id": 7166201,
			"completionStepIds": [
				7166201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166201",
							"2"
						],
						"stepId": 7166201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620101,
					"content": "#Приветствую, {F#путешественница}{M#путешественник}. Твоё появление как нельзя кстати. У нас есть поручение, которым лучше всего было бы заняться тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620102,
						716620103
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 716620102,
					"content": "Это поручение опасное?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				},
				{
					"id": 716620104,
					"content": "Оно касается до сей поры неизвестного подземелья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620105
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 716620105,
					"content": "Гильдия исследует это подземелье уже давно, но каких-либо ценных сведений мы не получили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620106
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 716620106,
					"content": "Хун Лан - он возглавляет исследование - утверждает, что ему необходима помощь искателя приключений, который способен действовать в любых условиях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620107
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 716620107,
					"content": "И я сразу же подумала о тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620108
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 716620108,
					"content": "Что это за подземелье?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620109
					]
				},
				{
					"id": 716620109,
					"content": "Сейчас Хун Лан находится у его входа. Если хочешь помочь, сходи к нему и спроси, что ему требуется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620110
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 716620110,
					"content": "#Мы рассчитываем на тебя, {F#путешественница}{M#путешественник}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				},
				{
					"id": 716620103,
					"content": "Это поручение очень сложное?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				}
			]
		},
		{
			"id": 7166202,
			"completionStepIds": [
				7166202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166202",
							"2"
						],
						"stepId": 7166202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хун Лан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620201,
					"content": "Да что же с этим подземельем такое?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620202
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620202,
					"content": "#Я {F#пришла}{M#пришёл} насчёт поручения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620203
					]
				},
				{
					"id": 716620203,
					"content": "Хм? Ты... А, так это твоей помощи попросила Катерина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620204
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620204,
					"content": "#Я слышал, что ты {F#многоопытная}{M#многоопытный} и {F#находчивая искательница}{M#находчивый искатель} приключений, {F#одна}{M#один} из лучших в этом деле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620205,
						716620206
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620205,
					"content": "Это правда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				},
				{
					"id": 716620207,
					"content": "Отлично! Всё это обнадёживает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620208
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620208,
					"content": "Не мог бы ты всё же рассказать об этом подземелье?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620209
					]
				},
				{
					"id": 716620209,
					"content": "Ах да, точно. Позволь мне ввести тебя в курс дела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620210
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620210,
					"content": "Случилось вот что. Некоторое время назад отряд искателей приключений в глуши обнаружил странную огромную дверь... Она как раз перед тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620211
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620211,
					"content": "Переступив порог, отряд очутился в неизвестном подземелье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620212
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620212,
					"content": "По словам первой группы искателей приключений, когда они только вошли, подземелье представляло собой «пустое помещение».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620213,
						716620214
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620213,
					"content": "О чём ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620215,
					"content": "Это я образно. Если говорить точно, это была область «около пятидесяти двух шагов в длину, пятидесяти двух шагов в ширину и неизвестной высоты».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620216
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620216,
					"content": "В пределах пятидесяти двух шагов область эта представляла собой пол из каменных плит, самый обыкновенный, но вот дальше начинался плотный тёмно-серый туман.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620217
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620217,
					"content": "Более того, когда кто-то пытался выйти за пределы этой площади в пятьдесят два шага...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620218
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620218,
					"content": "То он непостижимым образом начинал двигаться в обратном направлении либо внезапно исчезал и появлялся позади остальных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620219
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620219,
					"content": "Словом, выйти из этой области в пятьдесят два шага возможным не представлялось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620220
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620220,
					"content": "Они пробовали исследовать эту область с помощью инструментов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620221
					]
				},
				{
					"id": 716620221,
					"content": "Разумеется пробовали. Но что бы они ни бросили, вещь возвращалась на своё исходное место. Даже свет факелов не выходил за пределы пятидесяти двух шагов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620222
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620222,
					"content": "Значит, мы вам нужны для того, чтобы исследовать это место?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716620223,
					"content": "Верно. Правда... тебе предстоит заниматься не только «исследованием».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620224
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620224,
					"content": "Здесь этого так не объяснить. Пройдём внутрь подземелья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620214,
					"content": "Пустое... помещение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620206,
					"content": "Ч-что ты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				}
			]
		},
		{
			"id": 7166203,
			"completionStepIds": [
				7166204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166204",
							"2"
						],
						"stepId": 7166204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хун Лан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620301,
					"content": "Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716620302,
					"content": "Это и есть «пустое помещение», о котором ты говорил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620303,
						716620304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716620303,
					"content": "Подземелье как подземелье...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				},
				{
					"id": 716620305,
					"content": "Точно! Это же обычное подземелье, в каких мы частенько бываем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716620306,
					"content": "Это и в самом деле подземелье, которое мы хотим исследовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620307
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620307,
					"content": "Теперь оно выглядит так, потому что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620308
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620308,
					"content": "...недавно изменило свою форму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620309
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620309,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716620310,
					"content": "И теперь выглядит вот так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620311
					]
				},
				{
					"id": 716620311,
					"content": "Да. Это подземелье меняется... следуя желаниям людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620312
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620312,
					"content": "Согласно командиру отряда, после часов безрезультатных блужданий по подземелью они начали терять терпение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620313
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620313,
					"content": "Тогда один из членов отряда начал тихо ворчать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620314
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620314,
					"content": "«С обычным подземельем мы бы уже давно справились».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620315
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620315,
					"content": "Остальные, голодные и изрядно уставшие, согласились с ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620316
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620316,
					"content": "Всё больше людей соглашалось с его мнением, и тут вдруг отряд оказался в «обычном подземелье».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620317
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620317,
					"content": "В том «обычном подземелье» были механизмы, проходы, сокровище... Даже факелы, которые ещё горели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620318
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620318,
					"content": "Команда решила, что с такой ситуацией им не справиться, и тут же доложила обо всём Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620319
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620319,
					"content": "Мы без промедления отправили людей провести более тщательные исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620320
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620320,
					"content": "Но, как мы уже знаем, подземелье изменяется согласно желаниям людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620321
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620321,
					"content": "Если в подземелье войдёт несколько человек, то оно перестроится под желание того, у кого оно самое сильное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620322
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620322,
					"content": "Ничего себе! Значит, тут можно создать целую гавань Ли Юэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716620323,
					"content": "Мы уже пытались, но безуспешно. Быть может, наше желание увидеть здесь гавань Ли Юэ было недостаточно сильным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620324
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620324,
					"content": "Как бы то ни было, сейчас мы ищем искателей приключений, которые входили бы в это подземелье и изменяли его сообразно своим желаниям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620325
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620325,
					"content": "В процессе мы надеемся обнаружить закономерности в изменениях, и уже из них извлечь ответы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620326,
						716620327
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620326,
					"content": "Что мне тогда нужно делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620328,
					"content": "Видишь вон тот механизм? Это установленный нами «механизм запуска». Собственно, его придумал один из наших искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620329
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620329,
					"content": "Проще говоря, он пожелал, чтобы «подземелье изменялось только после активации этого механизма».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620330
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620330,
					"content": "Подземелье выполнило его желание, но чтобы механизм всегда оставался здесь, нам периодически приходится приглашать того искателя приключений сюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620331
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620331,
					"content": "Какие только способы не придумают...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620332
					]
				},
				{
					"id": 716620332,
					"content": "Это нечто вроде меры на случай непредвиденных обстоятельств. Без такого механизма изменениям подземелья не было бы конца...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620333
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620333,
					"content": "С другой стороны, это подземелье прекрасно подходит для тренировок искателей приключений. Достаточно одной мысли, чтобы изменился ландшафт и появились разнообразные механизмы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620334
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620334,
					"content": "Но лучше один раз увидеть, чем сто раз услышать. Почему бы тебе не попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620335
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620335,
					"content": "Видишь ту золотистую Монету приключений? Их мы тоже создали силой мысли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620336
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620336,
					"content": "Попробуй подобрать её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620327,
					"content": "Нужно применить какой-нибудь особый подход?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620304,
					"content": "#Где-то я такое уже {F#видела}{M#видел}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				}
			]
		},
