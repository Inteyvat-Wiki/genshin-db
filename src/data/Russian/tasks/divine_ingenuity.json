			"dialogs": [
				{
					"id": 716620401,
					"content": "#О, впечатляет! Ты так быстро {F#разобралась}{M#разобрался}, что делать с этим подземельем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620402
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620402,
					"content": "Дело теперь за тобой. Изменяй это подземелье, задействовав всё своё воображение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620403
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 716620403,
					"content": "Надеюсь, скоро мы выясним принципы, по которым оно изменяется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хун Лан"
				}
			]
