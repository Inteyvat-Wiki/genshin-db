			"dialogs": [
				{
					"id": 718120301,
					"content": "Это... клочок бумаги? На нём что-то написано. Давай скорее прочитаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718120302,
					"content": "Хм... Кажется, здесь говорится, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718120303,
					"content": "Нужно отправиться к огромному дереву, найти середину дороги, а ещё... Сокровище спрятано под ступеньками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
