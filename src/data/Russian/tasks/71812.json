				"points": []
			},
			"dialogs": [
				{
					"id": 718120201,
					"content": "#Ну, ты что-нибудь наш{F#ла}{M#ёл}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120202
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718120202,
					"content": "#Я наш{F#ла}{M#ёл} вот это.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120203
					]
				},
				{
					"id": 718120203,
					"content": "#Что это?.. Никогда не видела ничего подобного. Где ты его наш{F#ла}{M#ёл}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120205
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718120205,
					"content": "Неподалёку от гробницы Дуньюй...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120206
					]
				},
				{
					"id": 718120206,
					"content": "Гробница Дуньюй? Что же там делают такие вещи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120207
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718120207,
					"content": "Спасибо за помощь с подсказкой. По правилам искателей приключений этот предмет принадлежит тебе. И, конечно же, твоя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120208
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718120208,
					"content": "Я отправлю кого-нибудь в гробницу Дуньюй для проведения более тщательного поиска.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120209
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718120209,
					"content": "Очень странно... Этот регион неплохо исследован... Как мы могли что-то пропустить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				}
			]
		},
		{
			"id": 7181203,
