				"points": []
			},
			"dialogs": [
				{
					"id": 706700101,
					"content": "Привет! Не хочешь сыграть в «По следам ветра»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700102,
						706700107
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700102,
					"content": "А ты всё вербуешь игроков?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700103
					]
				},
				{
					"id": 706700103,
					"content": "Ой, это вы! Я до сих пор под впечатлением от вашей техники!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700104
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700104,
					"content": "Вы сразу играли, как настоящий мастер, но многие люди утверждают, что игра слишком сложная. Мятежники жалуются, что им некуда бежать, а охотники - что не могут никого найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700105
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700105,
					"content": "Ещё некоторые игроки жаловались, что мятежникам, которых поймали охотники, нечего делать до самого конца игры, только скучать, наблюдая со стороны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700106
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700106,
					"content": "Эх, не знаю, верить им или нет... Поэтому я решил набрать новых игроков и посмотреть, что скажут они...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700120
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700120,
					"content": "#Ладно, хватит разговоров. Лучше сыграй сам{F#а}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700121,
						706700122
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700121,
					"content": "Сыграть в «По следам ветра».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700123
					]
				},
				{
					"id": 706700123,
					"content": "Ладно. Если вдруг захочешь сыграть в «По следам ветра», отыщи меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700122,
					"content": "Уйти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700123
					]
				},
				{
					"id": 706700107,
					"content": "Что такое «По следам ветра»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700108
					]
				},
				{
					"id": 706700108,
					"content": "Хороший вопрос! «По следам ветра» - это замечательная игра, основанная на истории Мондштадта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700109
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700109,
					"content": "Ты, наверное, знаешь, что раньше в Мондштадте были аристократы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700110
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700110,
					"content": "Они бесчинствовали в Мондштадте, и многие люди страдали в те времена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700111
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700111,
					"content": "Чтобы дать отпор жестокости аристократов, несколько смелых людей из Мондштадта собрались вместе и создали тайную организацию сопротивления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700112
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700112,
					"content": "Эти рыцари проводили операции в разных частях Мондштадта и доставили аристократам немало неприятностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700113
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700113,
					"content": "Но аристократы быстро подготовили группу своих приспешников, обученных подавлять действия рыцарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700114
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700114,
					"content": "И тогда рыцари и приспешники аристократов стали бороться друг с другом по всему Мондштадту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700115
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700115,
					"content": "Игра «По следам ветра» как раз основана на этих исторических событиях! Когда-то эта игра была очень популярна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700116
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700116,
					"content": "Когда-то?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700117
					]
				},
				{
					"id": 706700117,
					"content": "Да. Сейчас городская молодёжь не интересуется игрой «По следам ветра»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700118
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700118,
					"content": "Но я не могу допустить, чтобы игра «По следам ветра» оказалась забыта! Поэтому мне пришлось немного отредактировать прежние правила, чтобы игра стала интереснее и проще для понимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700119
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706700119,
					"content": "Кроме того, теперь в игре появилось много новых игровых карт. Мне кажется, благодаря этому гораздо больше людей захочет сыграть в неё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700120
					],
					"speakerTitle": "Гайгэкс"
				}
			]
		}
	]
}