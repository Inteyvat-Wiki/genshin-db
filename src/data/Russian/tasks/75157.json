			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Конулаф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751570101,
					"content": "Хнык-хнык... Я не ожидала, что меня запрут в клетке... Мои честь и достоинство Повелителя Ночного Ветра попраны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570102
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570102,
					"content": "Позор племени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570103
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570103,
					"content": "Снова ты? Что случилось на этот раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751570104
					]
				},
				{
					"id": 751570104,
					"content": "#О, благодетель{F#ница}... Мы снова встретились. Простите, что вам пришлось стать свидетелем этой неприятной сцены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570105
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570105,
					"content": "Я вроде говорила вам, что меня зовут Конулаф, я жрица-стажёр Повелителей Ночного Ветра...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570106
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570106,
					"content": "Сейчас я прохожу обучение, чтобы стать жрицей и... Старейшины племени рассказали, что мой предок, Санхадж, часто делал ставки против выходцев из других племён и обманывал их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570107
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570107,
					"content": "И тогда старейшины сказали: «Сделай ставку и выиграй! Только так можно стать истинным Повелителем Ночного Ветра!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570108
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570108,
					"content": "Я проходила мимо, увидела состязание и... решила принять участие. Кого вообще волнуют все эти титулы вроде «действующий чемпион тепетлизавр» или «кукузавр, сильнейший новичок десятилетия»?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570109
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570109,
					"content": "Иктомизавры Повелителей Ночного Ветра сильны от природы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570110
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570110,
					"content": "В общем, я поставила не на того завриана...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570111
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570111,
					"content": "В итоге я не просто проиграла, но и оказалась заперта в клетке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570112
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570112,
					"content": "Они сказали: «Мы вернём тебе в десять раз больше моры, если иктомизавр станет чемпионом. Если нет, то ты останешься в этой клетке».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570113
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570113,
					"content": "И что мне оставалось делать? Ах, если бы только существовал иктомизавр, который мог бы хорошенько потрепать тех двух заврианов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570114
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570114,
					"content": "Тогда я смогла бы выбраться отсюда и получить в десять раз больше моры! ...Но самое главное - нельзя, чтобы эти два племени смотрели свысока на наших замечательных иктомизавров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570115
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570115,
					"content": "#Хнык-хнык... Прошу, благодетель{F#ница}, найдите такого иктомизавра...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570116
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570116,
					"content": "Простите, я несу чушь. Вы не из нашего племени, откуда вы возьмёте иктомизавра? Не из воздуха же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570117
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 751570117,
					"content": "Я постараюсь найти...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751570118
					]
				},
				{
					"id": 751570118,
					"content": "Правда? Тогда я буду ждать вас в этой клетке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Конулаф"
				}
			]
		},
		{
