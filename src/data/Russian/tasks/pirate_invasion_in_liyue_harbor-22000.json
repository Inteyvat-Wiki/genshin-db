			},
			"dialogs": [
				{
					"id": 220000201,
					"content": "#Я готов{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "Ура! Начинаем игру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000203,
					"content": "А как мы её начинаем?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000204,
					"content": "С ограбления!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "А! Пират!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220000206,
					"content": "Малышка Лулу, я спасу тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220000207,
					"content": "Эй, пират! Почему ты нас грабишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000208,
					"content": "Потому что я пират!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "Не все пираты грабят! Бывают хорошие пираты и плохие пираты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000211,
					"content": "Бэй Доу говорит, что она пират. Но Бэй Доу - хороший пират! Она дарит нам вкусняшки! Все любят Бэй Доу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000212,
					"content": "Зачем тебе быть плохим пиратом, если ты можешь быть хорошим пиратом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000213,
					"content": "Ты же сказал, что пираты ведут себя плохо и берут чужие вещи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220000214,
					"content": "#Я был{F#а} не прав{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "Отлично! Признать свои ошибки - это первый шаг на пути к исправлению. Так говорит Бэй Доу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000217,
					"content": "Следующий шаг - уборка местности. Если ты совершаешь хорошие поступки, ты можешь стать хорошим человеком. Даже хорошим пиратом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000215,
					"content": "#Я хочу быть хорош{F#ей}{M#им}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "Пираты грабят.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
