			"dialogs": [
				{
					"id": 220000101,
					"content": "Поиграем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000102,
					"content": "Эм... Если никто не хочет быть пиратом, то поиграть у нас не получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220000103,
					"content": "Совсем никто не хочет быть пиратом. Что же нам делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000104,
					"content": "Что вы делаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "Мы хотим поиграть, но никто не хочет быть пиратом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000106,
					"content": "А если не будет пирата, то некому будет нас грабить... Поэтому мы не можем играть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000107,
					"content": "Ага! Я знаю! Давай, ты будешь пиратом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000108,
					"content": "Давай!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "Ура! Тогда начинаем игру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000115,
					"content": "#Мы начнём, когда ты будешь готов{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000110,
					"content": "Я не умею быть пиратом...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "Ничего страшного! Это совсем несложно! Тебе надо плохо себя вести и брать чужие вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000112,
					"content": "Я никогда не видел настоящего пирата. Но Бэй Доу мне много про них рассказывала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000113,
					"content": "Я думаю, что пиратом быть очень просто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000114,
					"content": "Ха-ха! Я уверен, что у тебя получится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Малыш Мэн"
				}
			]
		},
		{
