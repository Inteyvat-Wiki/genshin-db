			"dialogs": [
				{
					"id": 220000501,
					"content": "#Уже закончил{F#а} уборку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000502
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000502,
					"content": "Пока ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000503
					]
				},
				{
					"id": 220000503,
					"content": "Поторопись! Это твой шанс стать хорошим человеком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000504
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000504,
					"content": "Хм. Разве уборка способна сделать из плохого человека хорошего?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000505
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220000505,
					"content": "Хороший человек - это человек, который хочет делать хорошие дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000506
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000506,
					"content": "Вот так просто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000507
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220000507,
					"content": "Если делаешь хорошие дела, значит ты хороший человек. Делаешь плохие, значит ты плохой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000508
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000508,
					"content": "Эх. Почему же на свете так много плохих людей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000509
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220000509,
					"content": "Потому что сказать легче, чем сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000510
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000510,
					"content": "Плохие вещи делать проще, чем хорошие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000511
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000511,
					"content": "Тебя этому научила Бэй Доу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000512
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220000512,
					"content": "Нет, я узнал это из книг.",
