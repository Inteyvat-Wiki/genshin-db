			"dialogs": [
				{
					"id": 220000301,
					"content": "#Уже закончил{F#а} уборку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000302
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000302,
					"content": "Всё чисто!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "Ура! Спасибо тебе! С тобой так приятно играть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000304,
					"content": "Оставайся хорошим человеком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000305,
					"content": "Эй, а когда я буду капитаном?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220000306,
					"content": "В следующий раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220000307,
					"content": "Ты так говорил в прошлый раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Фэй"
				}
