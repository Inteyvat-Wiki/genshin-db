				"points": []
			},
			"dialogs": [
				{
					"id": 10200101,
					"content": "Посмотри вверх! Это Нефритовый дворец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200102,
						10200103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200102,
					"content": "Как высоко...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				},
				{
					"id": 10200104,
					"content": "Эм... Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200105,
					"content": "М-да... Паймон должна быть твоим проводником, но... Паймон не знает, как попасть в Нефритовый дворец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200106,
						10200107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200106,
					"content": "Ты только сейчас об этом задумалась?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200108,
					"content": "Ммм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200109,
					"content": "Если мы хотим попасть в Нефритовый дворец, то нам стоит двигаться в его сторону!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200110,
					"content": "Должен же быть какой-то способ туда забраться. Давай хорошенько осмотримся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200107,
					"content": "Нам стоило узнать об этом у Гань Юй, посланницы Нин Гуан.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200103,
					"content": "Как же мы туда попадём?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				}
			]
		},
		{
			"id": 102002,
			"completionStepIds": [
				102002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
