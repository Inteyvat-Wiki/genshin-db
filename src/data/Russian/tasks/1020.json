			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200201,
					"content": "Смотри! Там какая-то механическая штучка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200202,
					"content": "Мы находимся в правильном месте. Значит, штучка как-то связана с Нефритовым дворцом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200203,
						10200205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200203,
					"content": "Может быть, это путь к Нефритовому дворцу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200204
					]
				},
				{
					"id": 10200204,
					"content": "Точно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200205,
					"content": "А вдруг это ловушка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200206
					]
				},
				{
					"id": 10200206,
					"content": "Не может быть! Доверься моим инстинктам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 102004,
			"completionStepIds": [
				102004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102004",
							"2"
						],
						"stepId": 102004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хуа Цин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200401,
					"content": "Стоять!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200402
					],
					"speakerTitle": "Хуа Цин"
				},
				{
					"id": 10200402,
					"content": "Кто дерзнул войти в эти заповедные земли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200403,
						10200404
					],
					"speakerTitle": "Хуа Цин"
				},
				{
					"id": 10200403,
					"content": "Дерзнули? Мы просто проходили мимо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				},
				{
					"id": 10200405,
					"content": "Вот именно! Что это ты такое говоришь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200406,
					"content": "У нас есть официальное приглашение. Как ты смеешь так с нами обращаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200407,
					"content": "Постой... Может быть, это всё часть плана Нин Гуан!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200408,
					"content": "Её приглашение - это западня! Миллелиты нас арестуют!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200409,
						10200410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200409,
					"content": "Непохоже...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200411,
					"content": "Аргх!!! Паймон в ярости! Эй ты! Это что, шутка такая?! Бесстыдники!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200412,
					"content": "Что? Мы просто стоим на страже! Почему «бесстыдники»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200413
					],
					"speakerTitle": "Хуа Цин"
				},
				{
					"id": 10200413,
					"content": "Чепуха! Немедленно задержите нарушителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200414
					],
					"speakerTitle": "Ян"
				},
				{
					"id": 10200414,
					"content": "Они нападают! Бей их всех разом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200410,
					"content": "Мы ещё не рассказали о приглашении...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200404,
					"content": "Заповедные земли? Это просто пустоши в районе горы Тяньхэн.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				}
			]
		},
		{
			"id": 102006,
			"completionStepIds": [
				102006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102006",
							"2"
						],
						"stepId": 102006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200601,
					"content": "Стоять! Что происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200602
					],
					"speakerTitle": "Хуа Цин"
				},
				{
					"id": 10200602,
					"content": "Госпожа Кэ Цин, эта странная парочка появилась словно из ниоткуда. Кажется, они строят планы на баллисту Гуй Чжун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200603
					],
					"speakerTitle": "Хуа Цин"
				},
				{
					"id": 10200603,
					"content": "Ты кого назвал «странным»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200604,
					"content": "Мы просто хотим попасть в Нефритовый дворец.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200605
					]
				},
				{
					"id": 10200605,
					"content": "Хм... Нефритовый дворец? Кто вы такие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200606
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200606,
					"content": "У нас есть приглашение... Мы ищем Цисин. А ты кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200608
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200608,
					"content": "Я член Цисин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200609
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200609,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200610,
					"content": "Меня зовут Кэ Цин, Нефритовое Равновесие группировки Цисин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200611
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200611,
					"content": "#Мне известно о тебе, путешественни{F#ца}{M#к}. Вы гости Нин Гуан? Не ожидала встретить вас в горах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200612
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200612,
					"content": "Ого... А Паймон не ожидала встретить столь крупную шишку в такой глуши.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200613,
					"content": "Баллиста Гуй Чжун в перевале Тяньхэн многие годы находилась в печальном состоянии, но её отремонтировали в одночасье. Я собираюсь выяснить, что произошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200614
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200614,
					"content": "Миллелиты здесь исключительно для охраны. Они не собираются никого арестовывать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200615
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200615,
					"content": "Значит, произошло недопонимание? Эм... Кто бы мог подумать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200616
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200616,
					"content": "Думать - это несложно. Попробуй, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200617
					]
				},
				{
					"id": 10200617,
					"content": "Простые смертные не смогли бы починить механизм Адептов. Это не под силу даже Цисин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200618
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200618,
					"content": "Хе-хе... Это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200619,
						10200620
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200619,
					"content": "(Тсс... Паймон, не стоит об этом.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				},
				{
					"id": 10200621,
					"content": "Эм... Ладно. Госпожа Нефритовое Равновесие... знаете ли вы, зачем госпожа Воля Небес пригласила нас в Нефритовый дворец?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200622
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200622,
					"content": "Зовите меня Кэ Цин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200623
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200623,
					"content": "Я бы сказала, что Нин Гуан хочет попросить героя Мондштадта занять... более нейтральную позицию. По крайней мере, не принимать целиком сторону Адептов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200624
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200624,
					"content": "Мы не занимаем сторон. Мы поговорили с Адептами. Они тоже хотят защитить Ли Юэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200625
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200625,
					"content": "Под «защитой» подразумевается их ханжеское высокомерие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200626
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200626,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200627
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200627,
					"content": "Вы простые смертные, поэтому находитесь под покровительством Адептов. По их мнению, «вам не хватило бы сил, чтобы убить божество».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200628
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200628,
					"content": "Они даже решили, что Нин Гуан приказала закрыть город и допросить всех свидетелей только для отвода глаз. Адепты думают, что поиск убийцы всего лишь прикрытие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200629
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200629,
					"content": "Если вкратце, они нас недооценивают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200630
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200630,
					"content": "В твоих словах есть смысл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200631
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200631,
					"content": "Однако я ещё не встречала в Ли Юэ людей, которые не уважают Адептов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200632
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200632,
					"content": "И за что же я должна их уважать? За то, что у них нет чувства времени? Или, может быть, за то, что из-за презрения к простым смертным они не приняли быстрые и решительные меры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200633
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200633,
					"content": "Ладно. Мне не стоило говорить об Адептах в таком ключе. Нин Гуан не разделяет мой скептицизм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200634
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200634,
					"content": "В любом случае стоит признать, что на этот раз Адепты повели себя весьма сдержанно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200635
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200635,
					"content": "Кончина Властелина Камня - это действительно чрезвычайная ситуация. Но кто бы мог подумать, что вместо прямого вмешательства они решат созвать совет Адептов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200636
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200636,
					"content": "Для них это невиданный уровень цивилизованности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200637,
						10200638
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200637,
					"content": "Возможно, ты сможешь с ними это обсудить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200639,
					"content": "Мощь красноречия Нин Гуан поистине не знает пределов. Но боюсь, что на этот раз одними словами мы не обойдёмся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200640
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200640,
					"content": "Времена Адептов давно прошли. Если даже Цисин не готовы это признать, то какое же тогда будущее ждёт Ли Юэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200641
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200641,
					"content": "Пф... Ещё одно громкое заявление.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200642
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200642,
					"content": "#Эх... Пожалуй, мне следует остановиться. Я и так наговорила много лишнего. Ты славный слушатель, {F#путешественница}{M#путешественник}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200643
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200643,
					"content": "Вам двоим пора в Нефритовый дворец. Постарайтесь не опаздывать. У Нин Гуан очень плотное расписание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200644
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200644,
					"content": "Представители высшего общества Ли Юэ считают «вознесение в Нефритовый дворец» большой честью. Чтобы добиться расположения Нин Гуан, они приносят ей роскошные подарки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200645
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200645,
					"content": "Расположения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200646,
						10200647
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200646,
					"content": "Паймон, это неважно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200648,
					"content": "Но... но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200649
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200649,
					"content": "Постой-ка! Подарки - это неотъемлемая часть культурного наследия Ли Юэ. Мы не пытаемся добиться расположения, мы просто чтим традиции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200650
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200650,
					"content": "Внезапно Паймон решила проявить почтение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200651
					]
				},
				{
					"id": 10200651,
					"content": "Ладно. Вы сами разберётесь, что делать с подарками. Давайте я расскажу вам, как попасть в Нефритовый дворец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200652
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200652,
					"content": "На самом деле вам не нужно было подниматься на гору Тяньхэн. Возвращайтесь в город и найдите проводника в павильоне Лунного моря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200653
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200653,
					"content": "#Настала пора прощаться. До встречи, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200654
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10200654,
					"content": "Пускай Нефритовое Равновесие и не уважает Адептов, но всё равно Паймон считает её классной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200655,
						10200656
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200655,
					"content": "На меня она тоже произвела впечатление.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200657,
					"content": "Что же мы собираемся дарить Нин Гуан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200658
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200658,
					"content": "Кажется, Паймон думает только о подарке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200659
					]
				},
				{
					"id": 10200659,
					"content": "Верно! Вчера мне приснилась опупительная вкусняшка - <color=#00E1FFFF>глазированный слайм</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200660
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200660,
					"content": "Паймон думает, что это идеальный подарок для такой богатенькой госпожи, как Нин Гуан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200661
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200661,
					"content": "Давай подарим ей слайма!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200662,
						10200664
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200662,
					"content": "У тебя есть рецепт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200663
					]
				},
				{
					"id": 10200663,
					"content": "Нет! Но нам не нужен рецепт, нам нужно только добавить немного шака-лака бум-бум!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200666,
					"content": "Давай соберём необходимые ингредиенты. Время никого не ждёт! И богатенькие тоже никого не ждут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200664,
					"content": "Эм... Как же нам приготовить блюдо из твоих снов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200665
					]
				},
				{
					"id": 10200665,
					"content": "Как? Бум шака-лака - вот как!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200656,
					"content": "Я разделяю её взгляды.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200647,
					"content": "Соберись, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200638,
					"content": "Нин Гуан тоже предпочитает решать проблемы дипломатическим путём, не так ли?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200620,
					"content": "(Мы только чуть-чуть помогли...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				}
			]
		},
		{
			"id": 102007,
			"completionStepIds": [
				102007
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102007",
							"2"
						],
						"stepId": 102007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200701,
					"content": "Хм? Можно долететь только досюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200702,
					"content": "Если бы поток ветра был сильнее, мы бы сразу забрались на самый верх!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200703,
					"content": "Давай вернёмся в Ли Юэ и узнаем у Миллелитов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200704
					]
				},
				{
					"id": 10200704,
					"content": "Что? Зачем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200705,
					"content": "Способ подняться не должен быть тайным, иначе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200706
					]
				},
				{
					"id": 10200706,
					"content": "Иначе?.. А, я поняла! Если бы путь наверх держали в секрете, то Гань Юй не предложила бы нам отыскать его самостоятельно, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200707,
					"content": "Ладно, давай придерживаться твоего плана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200708,
					"content": "А! Подожди. Что там внизу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200709,
					"content": "Мы уже рядом с <color=#00E1FFFF>баллистой Гуй Чжун</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200710,
					"content": "Хм... У Паймон есть план!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200711
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200711,
					"content": "Почему бы нам не запульнуть тебя из баллисты Гуй Чжун прямо в Нефритовый дворец?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200712,
						10200714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200712,
					"content": "Нет, спасибо. Мне ещё пожить хочется.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200713
					]
				},
				{
					"id": 10200713,
					"content": "Эм... Да, это не самый безопасный способ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200716,
					"content": "Хотя у баллисты есть прицел...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200717
					]
				},
				{
					"id": 10200717,
					"content": "Действительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200718
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200718,
					"content": "Давай поищем путь в Нефритовый дворец с помощью прицела баллисты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10200714,
					"content": "За что ты меня так не любишь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200715
					]
				},
				{
					"id": 10200715,
					"content": "Ой... Я просто не подумала о мерах безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}