			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ханаяма Каору"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270101,
					"content": "Добрый день, вот и вы. Видите, сколько здесь цветов? Разве они не прекрасны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270102,
						721270104
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270102,
					"content": "И правда очень красиво.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270103
					]
				},
				{
					"id": 721270103,
					"content": "Хе-хе... Правда. Я о них хорошо забочусь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270106,
					"content": "Кстати, можете снова оказать мне услугу? Теперь, когда цветы цветут так хорошо, я хотела бы взять и засушить несколько растений, чтобы послать их с письмами тем, кто ещё не вернулся в Татарасуну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270107
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270107,
					"content": "Но... Я не знаю, может, из-за недосыпания, но я вышла, чтобы выбрать несколько цветов, но я уже так устала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270108
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270108,
					"content": "Не могли бы вы помочь мне выбрать здесь несколько цветков-сахарков? Трёх будет достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270109,
						721270111
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270109,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270110
					]
				},
				{
					"id": 721270110,
					"content": "Тогда оставляю это на вас. А я пока немного передохну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270112
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270112,
					"content": "От цветков-сахарков мне нужен их бесподобный аромат. Остальные сухие цветы я положу в письма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270113
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270113,
					"content": "И когда люди будут читать эти письма и вдыхать этот приятный аромат, настроение их улучшится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270114
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270114,
					"content": "Так значит, я на вас рассчитываю. Я сделаю небольшой перерыв... Когда выберете цветы, пожалуйста, принесите их мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270111,
					"content": "Похоже, цветки-сахарки тут повсюду...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270112
					]
				},
				{
					"id": 721270104,
					"content": "Как долго ты их уже высаживаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270105
					]
				},
				{
					"id": 721270105,
					"content": "Не очень долго. Просто... просто чуть меньше сплю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Ханаяма Каору"
				}
			]
		},
		{
			"id": 7212702,
