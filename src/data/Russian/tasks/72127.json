			},
			"dialogs": [
				{
					"id": 721270201,
					"content": "Вы собрали цветки-сахарки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ханаяма Каору"
				}
			]
		},
		{
			"id": 7212703,
			"completionStepIds": [
				7212703
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212703",
							"2"
						],
						"stepId": 7212703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ханаяма Каору"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270301,
					"content": "Спасибо. Этих цветков-сахарков будет достаточно. Пойду сушить цветы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270302
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270302,
					"content": "А, да, у меня для вас есть подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270303
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270303,
					"content": "Вот, возьмите этот засушенный цветок. И хотя он слегка завядший, он очень ценный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270304,
						721270305
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270304,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270307
					]
				},
				{
					"id": 721270307,
					"content": "Это первый цветок, который зацвёл среди моря цветов. Вы помогли мне найти семена, так что я хотела бы дать вам этот цветок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270308
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270308,
					"content": "И хотя его не назовёшь таким уж ценным, но всё же... Большое вам спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270309
					],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270309,
					"content": "Не сомневаюсь, что все жители вернутся сюда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270310
					]
				},
				{
					"id": 721270310,
					"content": "Да! Так что мне нужно посадить ещё больше цветов, чтобы когда все вернутся, они увидели бескрайние цветущие поля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ханаяма Каору"
				},
				{
					"id": 721270305,
					"content": "В нём есть что-то особенное?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270306
					]
				},
				{
					"id": 721270306,
					"content": "Конечно же, в нём есть что-то особенное. Если бы цветок был самый обычный, я бы его вам не дала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270307
					],
					"speakerTitle": "Ханаяма Каору"
				}
			]
		}
	]
}