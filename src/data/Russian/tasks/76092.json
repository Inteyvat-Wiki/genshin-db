			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рольф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760920101,
					"content": "Держись подальше! Здесь опасно, и если появится Дикая Охота, у меня не будет сил тебя защищать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920102,
						760920109,
						760920112
					],
					"speakerTitle": "Рольф"
				},
				{
					"id": 760920102,
					"content": "Откуда ты знаешь, что появится Дикая Охота?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920103
					]
				},
				{
					"id": 760920103,
					"content": "Для светоносца, борьба с Дикой Охотой - долг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920104
					],
					"speakerTitle": "Рольф"
				},
				{
					"id": 760920104,
					"content": "Видишь этот камень печати прилива? Чтобы обеспечить полное уничтожение Дикой Охоты, мне придётся следить тут три дня и три ночи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920105
					],
					"speakerTitle": "Рольф"
				},
				{
					"id": 760920105,
					"content": "Камень печати прилива?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920106
					]
				},
				{
					"id": 760920106,
					"content": "Камни печати прилива - это печати, установленные нами, светоносцами, чтобы рассеять следы Дикой Охоты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920107
					],
					"speakerTitle": "Рольф"
				},
				{
					"id": 760920107,
					"content": "Хотя я и не знаю точный принцип, но обычно в местах, где появлялась Дикая Охота, остаётся особая аура, которая может снова их привлечь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920108
					],
					"speakerTitle": "Рольф"
				},
				{
					"id": 760920108,
					"content": "Поэтому, отразив Дикую Охоту, мы устанавливаем камни печати прилива. Если поблизости снова появится Дикая Охота, они защитят нас в бою.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рольф"
				},
				{
					"id": 760920109,
					"content": "Я не боюсь никакой Дикой Охоты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920110
					]
				},
				{
					"id": 760920110,
					"content": "Не знаю, откуда у тебя такая уверенность, но Дикая Охота - не тот противник, с которым можно справиться просто так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920111
					],
					"speakerTitle": "Рольф"
				},
				{
					"id": 760920111,
					"content": "Прислушайся к моему совету: если встретишь места с такими камнями, прояви предельную осторожность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рольф"
				},
				{
					"id": 760920112,
					"content": "Не буду тебе мешать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920113
					]
				},
				{
					"id": 760920113,
					"content": "Хорошо, береги себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рольф"
				}
			]
		},
		{
			"id": 7609202,
