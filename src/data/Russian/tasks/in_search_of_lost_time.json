						"pointId": 4700
					},
					{
						"sceneId": 3,
						"position": [
							4931.681,
							495.167,
							3966.649
						],
						"pointId": 4845
					},
					{
						"sceneId": 3,
						"position": [
							4932.99,
							495.314,
							3968.181
						],
						"pointId": 6370
					}
				]
			},
			"dialogs": [
				{
					"id": 740411301,
					"content": "Только не бейте! Я сдаюсь! Сдаюсь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411302
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411302,
					"content": "Вы... Это всё из-за этих перфолент? Забирайте! Только не бейте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411303
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411303,
					"content": "Командир Фатуи передал все данные исследований...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411304
					]
				},
				{
					"id": 740411304,
					"content": "Ну, Бройль, теперь всё на месте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411305,
					"content": "Эм, это...точно? Да, точно, теперь здесь все данные!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411306
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411306,
					"content": "Ладно, вопрос закрыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411307,
					"content": "Что вы задумали?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411308
					]
				},
				{
					"id": 740411308,
					"content": "Да, рассказывай начистоту! Чего вы добиваетесь, занимая эти наблюдательные станции?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411310
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411310,
					"content": "Это... чтобы отлынивать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411311
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411311,
					"content": "?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411312,
					"content": "Меня зовут Малиновский, капитан независимого разведотряда №34.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411313
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411313,
					"content": "В начале, когда нас только направили в Фонтейн, мы все прекрасно проводили время, у нас не было сложных заданий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411315
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411315,
					"content": "Эм... какое это имеет отношение к захвату наблюдательных станций?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411316,
					"content": "Неожиданно, буквально несколько месяцев назад, в связи с кадровыми перестановками, мне назначили нового адъютанта по фамилии Шумилов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411317
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411317,
					"content": "Шумилов? А, это тот командир взвода, которого я видела на станции креп-сюзетт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411318,
					"content": "Да! Я терпеть не могу этого парня! Но избавиться от него было не так-то просто, и я придумал предлог и убежал от него на задание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411319
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411319,
					"content": "Погоди, ты меня запутал... Этот Шумилов - твой адъютант?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411320,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411321
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411321,
					"content": "Значит, он твой подчинённый? Но начальник не обязан терпеть своего подчинённого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411322,
					"content": "Да, этот гадкий человечек - мой подчинённый, но он всегда корчит строгую мину, заставляя людей усердно работать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411323
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411323,
					"content": "И он приводил неопровержимые доводы. Но не могу же я при всех открыто сказать ему, что люди, вообще-то, не хотят работать?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411324
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411324,
					"content": "И вот я увидел в окрестностях какие-то странные башни, сказал, что мы должны изучить их, и подделал письмо из Палаты Жестьон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411325
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411325,
					"content": "Хм, так это вы его подделали! Паймон ещё подумала, как могла Палата Жестьон передать вам управление станцией гидрологического контроля!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411326,
					"content": "Бройль, может, у тебя есть к нему какие-то вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411327,
					"content": "Хм... Получается, вы оккупировали нашу наблюдательную станцию, чтобы тут бездельничать... простите, чтобы хоть немного отдохнуть от этого шумного мира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411328
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411328,
					"content": "Ну так что? Как вам отдыхается здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411329
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411329,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411330
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411330,
					"content": "Ну... очень комфортно! Вокруг такие чудесные виды. Вздремнёшь немного, и чувствуешь себя намного лучше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411331
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411331,
					"content": "Действительно. Особенно когда просыпаешься и понимаешь, что нет никаких срочных дел и надоедливых людей, которые за тобой наблюдают, а есть только полуденный солнечный свет и ветерок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411332
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411332,
					"content": "Это как проснуться от одного сна и попасть в другой, где не нужно ни о чём беспокоиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411333
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411333,
					"content": "Что ж, такой и должна быть ваша жизнь! Вы ведь не попробовали лимитированную коллекцию чёрного чая, который продавался в пассаже Вазари? Жаль, у вас, видно, не было возможности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411334
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411334,
					"content": "Нет-нет-нет, почему ты вдруг переключился на такую странную тему?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411335
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411335,
					"content": "Ладно, парень, можешь честно пойти с нами! Пришло время рассказать о своих преступлениях в отношении Исследовательского института Фонтейна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411336
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411336,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411337
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411337,
					"content": "Пожалуйста, подождите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411338
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411338,
					"content": "#{M#Благодетели}{F#Благодетельницы}! Этот господин не нанёс никакого ущерба нашим гидрологическим исследованиям, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411339
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411339,
					"content": "Если быть объективным, то этот господин даже помог нам собрать некоторые данные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411340
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411340,
					"content": "Более того, он всего лишь не хочет работать, он хочет жить красивой, счастливой и неторопливой жизнью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411341
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411341,
					"content": "Да, верно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411342
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411342,
					"content": "Нет, даже если и так, это не то, чем стоит гордиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411343
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411343,
					"content": "#Прошу вас, любезн{M#ый}{F#ая} {M#господин}{F#госпожа}! Ради науки, будьте великодушны и отпустите его на этот раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411344,
						740411345
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411344,
					"content": "Хотя, казалось бы, это не имеет никакого отношения к науке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				},
				{
					"id": 740411346,
					"content": "Спа... спасибо вам, господин! И вам тоже! Клянусь, я больше никогда-никогда не буду так делать! Отныне я положу все силы на то, чтобы предаваться безделью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411347
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740411347,
					"content": "Точно! Самое главное - это решимость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411348
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411348,
					"content": "Не нужно стимулировать такое странное рвение в подобном месте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411349
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411349,
					"content": "Командир Фатуи с благодарным видом откланялся...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411350
					]
				},
				{
					"id": 740411350,
					"content": "Хорошо! Теперь, когда проблема решена, пора вернуться к разбору данных!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411351
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411351,
					"content": "Огромное спасибо вам! Пожалуйста, примите это!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411352
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411352,
					"content": "Действительно ли... всё решилось благополучно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411353
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411353,
					"content": "Ну, вполне... Наблюдательная станция восстановила работу, солдат Фатуи отступил, так что, думаю, на этом можно и закончить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411345,
					"content": "Раз уж так говорит заинтересованное лицо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				}
			]
		},
