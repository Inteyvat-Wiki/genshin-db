			"dialogs": [
				{
					"id": 740410601,
					"content": "Эм, дайте взглянуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410602
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740410602,
					"content": "Если нам удастся объединить собранные ранее данные, то мы получим превосходные результаты... Возобновление гидрологических исследований не за горами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410603
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740410603,
					"content": "Прекрасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740410604,
					"content": "А? У меня такое ощущение, что часть данных отсутствует... Может, просто кажется?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410605
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740410605,
					"content": "Почему ты всегда говоришь так неопределённо?! Разве не ты отвечаешь за эти данные?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740410606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410607
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740410607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740410608,
					"content": "?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410609
					]
				},
				{
					"id": 740410609,
					"content": "... Ой, простите, ошибся комнатой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410610
					],
					"speakerTitle": "Малиновский"
				},
				{
					"id": 740410610,
					"content": "Командир Фатуи с ловкостью, совершенно не соответствовавшей его телосложению, стремительно ускользнул...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410611
					]
				},
				{
					"id": 740410611,
					"content": "Постой... Что это только что было?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410612,
						740410613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740410612,
					"content": "Так быстро, даже быстрее вишапа...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				},
				{
					"id": 740410614,
					"content": "Нет-нет-нет, сейчас не время думать об этом! Это Фатуи! Но что он тут делает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740410615,
					"content": "#{NICKNAME}, нужно отправиться за ним и узнать всю правду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740410613,
					"content": "Какой проворный тип...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				}
			]
		},
		{
			"id": 7404113,
