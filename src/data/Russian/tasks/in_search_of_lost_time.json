					"nextDialogs": [
						740411402,
						740411403
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411402,
					"content": "Кажется, здесь никого...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411404
					]
				},
				{
					"id": 740411404,
					"content": "Да, Фатуи всё равно ушёл, мы здесь больше не нужны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411405,
					"content": "Нельзя сказать с уверенностью. А если здесь ещё есть другие люди из Снежной, я ведь могу больше никогда не увидеть печенье «Мадлен»?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411406
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411406,
					"content": "Кхм, я имею в виду, больше не будет никаких гидрологических исследований! Поэтому прошу, сопроводите меня внутрь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411407
					],
					"speakerTitle": "Бройль"
				},
				{
					"id": 740411407,
					"content": "Увы, делать нечего. Открывай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740411403,
					"content": "Могу ли я вернуться назад?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411404
					]
				}
