				"points": []
			},
			"dialogs": [
				{
					"id": 706740101,
					"content": "Почему на этот раз в Мондштадте?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740102,
						706740103
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740102,
					"content": "Хун Лан?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740104
					]
				},
				{
					"id": 706740104,
					"content": "#{NICKNAME}? Вот так встреча! Не ожидал увидеть тебя здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740105
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740105,
					"content": "#Что касается нынешней ситуации... Просто посмотри на дверь рядом со мной. Полагаю, ты всё понял{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740106,
						706740107
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740106,
					"content": "То подземелье снова появилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740108
					]
				},
				{
					"id": 706740108,
					"content": "Именно так. Благодаря твоей помощи в исследовании того подземелья мы смогли получить много важных данных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740109
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740109,
					"content": "Однако у нас не было возможности получить более полезную информацию о том подземелье извне. Разумеется, Гильдия пыталась, но увы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740110
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740110,
					"content": "В связи с этим, мы хотели отправить туда больше людей. Мы даже позвали искателей приключений из других Гильдий... но подземелье вдруг исчезло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740111
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740111,
					"content": "И больше мы о нём не слышали до тех пор, пока оно не появилось снова в Мондштадте. Я здесь благодаря искателям приключений из местной Гильдии, которые своевременно оповестили нас о подземелье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740112
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740112,
					"content": "Вы уже начали исследование?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740113
					]
				},
				{
					"id": 706740113,
					"content": "Конечно! Разве можно отказаться от представившейся возможности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740114
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740114,
					"content": "Правила подземелья почти не поменялись. Оно по-прежнему создаёт разные вещи в зависимости от воображения вошедшего в него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740115
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740115,
					"content": "Но по мере того, как мы углублялись в подземелье, мы обнаружили, что теперь оно может создавать определённых «противников».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740116
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740116,
					"content": "Они атаковали нас и выдворили из подземелья. Это было весьма болезненно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740117
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740117,
					"content": "Как бы это сказать... Это ничем не отличалось от настоящего сражения, которое другие искатели приключений сочли бы увлекательным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740118
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740118,
					"content": "Но многие навоображали противников, которых не смогли победить, и в итоге им понадобилась помощь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740119
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740119,
					"content": "Кхе... В общем, неважно. Не согласишься ли ты ещё раз исследовать это подземелье вместе с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740120,
						706740122
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740120,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740121
					]
				},
				{
					"id": 706740121,
					"content": "Ха-ха-ха, замечательно! С твоей помощью нас ждёт успех, я уверен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740122,
					"content": "Это не слишком опасно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740123
					]
				},
				{
					"id": 706740123,
					"content": "Думаю, с тобой всё будет в порядке. Просто соблюдай осторожность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740124
					],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740124,
					"content": "В общем, если ты согласишься исследовать подземелье вместе с нами, нас ждёт успех, я уверен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хун Лан"
				},
				{
					"id": 706740107,
					"content": "Ты же уже исследовал подобное подземелье?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740108
					]
				},
				{
					"id": 706740103,
					"content": "Это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740104
					]
				}
			]
		}
	]
}