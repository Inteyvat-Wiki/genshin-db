			"trigger": {
				"objectNames": [
					"Ода Таро"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630301,
					"content": "Ох, когда же я разыщу попутчика...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630302
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630302,
					"content": "Можешь что-нибудь сказать об этой карте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630303
					]
				},
				{
					"id": 721630303,
					"content": "Ты из Гильдии искателей приключений? Они наконец-то нашли людей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630304
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630304,
					"content": "#Я просто путешественни{F#ца}{M#к}, держащ{F#ая}{M#ий} свой путь через эти края.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630305
					]
				},
				{
					"id": 721630305,
					"content": "Что ж... Дашь мне посмотреть на карту?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630306
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630306,
					"content": "Позволь посмотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630307
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630307,
					"content": "Это же! Неужели и правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630308,
						721630309
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630308,
					"content": "Что тебе удалось понять?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				},
				{
					"id": 721630310,
					"content": "Это Сэйрай?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630311,
						721630312
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630311,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630313,
					"content": "Ха-ха-ха, и правда Сэйрай? Я угадал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630314
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630314,
					"content": "Мои предки когда-то жили на острове Сэйрай, но это было очень давно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630315
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630315,
					"content": "В моем поколении уже ни у кого не осталось представлений об острове Сэйрай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630316
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630316,
					"content": "Всё что напоминает нам о доме - это три картины, изображающих пейзажи острова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630317
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630317,
					"content": "Почему же ты хочешь вернуться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630318
					]
				},
				{
					"id": 721630318,
					"content": "Ну это всё-таки родина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630319
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630319,
					"content": "Я чувствую, что должен побывать на острове во что бы то ни стало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630320
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630320,
					"content": "Но сейчас у меня так много дел, что я никак не могу отлучиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630321
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630321,
					"content": "К тому же мне не удалось найти искателей приключений, которые могли бы сопроводить меня в путешествии на остров Сэйрай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630322
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630322,
					"content": "Поэтому я решил использовать запасной план и вывесил поручение в Гильдии искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630323
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630323,
					"content": "Надеюсь, кто-нибудь из искателей приключений сможет отправиться на остров вместо меня, найдёт места, изображённые на пейзажах, и сделает снимки на фотокамеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630324
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630324,
					"content": "Но пока что никто из искателей приключений не принял это поручение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630325,
						721630326
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630325,
					"content": "Я возьмусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630327,
					"content": "Ты правда хочешь мне помочь? Это просто замечательно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630328
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630328,
					"content": "Не волнуйся о вознаграждении. Я всё приготовлю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630329
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630329,
					"content": "Что ж, я на тебя рассчитываю. Вместе с принесённой тобой картиной получается четыре места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630330
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630330,
					"content": "Прошу тебя отправиться на Сэйрай и сделать для меня фотографии в этих четырёх местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630326,
					"content": "Я могу отправиться туда для тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630312,
					"content": "Верно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630309,
					"content": "Это твои родные места?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				}
			]
		},
		{
