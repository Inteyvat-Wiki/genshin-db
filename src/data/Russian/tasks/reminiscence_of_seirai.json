			"dialogs": [
				{
					"id": 721630401,
					"content": "Ты уже здесь? Ну как? Удалось сделать снимки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630402
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630402,
					"content": "Всё готово.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630403
					]
				},
				{
					"id": 721630403,
					"content": "Отлично. Можно посмотреть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630404
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630404,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630405
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630405,
					"content": "Ха-ха-ха, никак не могу понять, что за место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630406
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630406,
					"content": "Похоже, эти места сильно изменились с тех пор, как уехала наша семья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630407
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630407,
					"content": "Узнает ли их Фудзивара Тосико?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630408
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630408,
					"content": "Думаю... вряд ли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630409
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630409,
					"content": "Она тоже с Сэйрая?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630410
					]
				},
				{
					"id": 721630410,
					"content": "Точнее говоря, она, как и я, ведёт свой род от тех, кто когда-то жил на Сэйрае.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630411
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630411,
					"content": "Здесь, в городе Инадзума, немало тех, чьи предки когда-то были жителями острова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630412
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630412,
					"content": "Но почему вы сбежали с острова?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630413
					]
				},
				{
					"id": 721630413,
					"content": "Я не помню точно... Это было очень давно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630414
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630414,
					"content": "Кажется, из-за очень сильной грозы. А может быть, дело было в запрете на контрабанду и незаконное пересечение границы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630415
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630415,
					"content": "Как бы то ни было, сёгунат всё устроил, чтобы люди могли переехать с Сэйрая на Наруками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630416
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630416,
					"content": "Впрочем, довольно светских бесед. Это вам, в благодарность за поездку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630417
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630417,
					"content": "Когда же я сам побываю на острове Сэйрай?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630418
					],
					"speakerTitle": "Ода Таро"
				},
				{
					"id": 721630418,
					"content": "Эх, сначала нужно разобраться с делами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ода Таро"
				}
			]
