			"trigger": {
				"objectNames": [
					"Фуруя Нобору"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630201,
					"content": "Ну и головная боль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630202
					],
					"speakerTitle": "Фуруя Нобору"
				},
				{
					"id": 721630202,
					"content": "Можешь что-нибудь сказать об этой карте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630203
					]
				},
				{
					"id": 721630203,
					"content": "Судя по рельефу, это какая-то часть Сэйрая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630204
					],
					"speakerTitle": "Фуруя Нобору"
				},
				{
					"id": 721630204,
					"content": "Как тебе удалось это понять?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630205
					]
				},
				{
					"id": 721630205,
					"content": "Гильдия публиковала несколько поручений, связанных с островом Сэйрай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630206
					],
					"speakerTitle": "Фуруя Нобору"
				},
				{
					"id": 721630206,
					"content": "Искатели приключений, которые взялись за поручения, вернулись в Гильдию с отчётом и передали нам информацию о Сэйрае.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630207
					],
					"speakerTitle": "Фуруя Нобору"
				},
				{
					"id": 721630207,
					"content": "К сожалению, проблемы с рабочей силой не позволяют нам организовать масштабную экспедицию, поэтому мы вынуждены отправлять на исследования лишь небольшие группы искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630208
					],
					"speakerTitle": "Фуруя Нобору"
				},
				{
					"id": 721630208,
					"content": "Боюсь, что из-за этого я мало чем могу тебе помочь с этой картой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630209
					],
					"speakerTitle": "Фуруя Нобору"
				},
				{
					"id": 721630209,
					"content": "Но мне знаком человек, который знает о Сэйрае больше меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630210
					],
					"speakerTitle": "Фуруя Нобору"
				},
				{
					"id": 721630210,
					"content": "Его зовут Ода Таро. Я слышал, что его предки жили на острове Сэйрай, а потом почему-то перебрались сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630211
					],
					"speakerTitle": "Фуруя Нобору"
				},
				{
					"id": 721630211,
					"content": "Кстати, не так давно он приходил в Гильдию, чтобы нанять искателей приключений, которые отправились бы вместе с ним на остров Сэйрай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630212
					],
					"speakerTitle": "Фуруя Нобору"
				},
				{
					"id": 721630212,
					"content": "Можешь спросить его об этой карте. Как знать, вдруг ему что-то известно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фуруя Нобору"
				}
			]
		},
