			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Коллеи",
					"Эола",
					"Лессиг",
					"Кли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401251201,
					"content": "Если начать с деревни Аару... по пути в город Сумеру мы сможем посмотреть Караван-рибат и Пардис Дхяй...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251202
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 401251202,
					"content": "Понятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251203
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 401251203,
					"content": "Будем покупать сувениры домой? Я понесу покупки, не беспокойтесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251204
					],
					"speakerTitle": "Лессиг"
				},
				{
					"id": 401251204,
					"content": "Дотащу любую тяжесть! Главное, чтобы в сумку помещалось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251205
					],
					"speakerTitle": "Лессиг"
				},
				{
					"id": 401251205,
					"content": "Да перестань, кому мы повезём столько сувениров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251206
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 401251206,
					"content": "Маме, Альбедо, Джинн, Рэйзору... А ещё Дионе, Моне, Фишль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251207
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 401251207,
					"content": "Хм, и почему ты на меня так смотришь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251208
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 401251208,
					"content": "Нет-нет, просто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251209
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 401251209,
					"content": "Итак, Кли, какие подарки ты хочешь привезти в Мондштадт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251210
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 401251210,
					"content": "Мм... Конфеты из закатника! А ещё большие шляпы, как у плесенников! И ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251211
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 401251211,
					"content": "И ещё целую гору книжек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251212
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 401251212,
					"content": "Только я пока не придумала, что привезти маме...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251213
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 401251213,
					"content": "Ничего страшного, посмотрим, что будет на прилавках. А если будет трудно выбрать, мы поможем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251214
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 401251214,
					"content": "Ура! Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кли"
				}
			]
		}
	]
}