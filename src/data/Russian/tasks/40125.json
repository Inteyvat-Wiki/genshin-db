			},
			"dialogs": [
				{
					"id": 401251101,
					"content": "Сангономия, ты не думаешь взять раковину с собой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251102
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 401251102,
					"content": "Нет, мне кажется, ей лучше остаться у Идии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251103
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 401251103,
					"content": "На острове Ватацуми уже появилась новая «драгоценность», и мечты людей постепенно стали претворяться в жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251104
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 401251104,
					"content": "Пусть лучше раковина хранит это подземелье и мечты всех путников, которые здесь окажутся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				}
			]
		},
		{
			"id": 4012512,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
