			"dialogs": [
				{
					"id": 746560107,
					"content": "#Ты тоже {F#пришла}{M#пришёл} сюда погулять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560101
					],
					"speakerTitle": "Исменор"
				},
				{
					"id": 746560101,
					"content": "Тебе нужен пузырин?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746560102
					]
				},
				{
					"id": 746560102,
					"content": "#Ах, дружочек, ты {F#принесла}{M#принёс} пузырин? Прошу, поделись им со мной, и мы сможем подкрепиться и поговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560103
					],
					"speakerTitle": "Исменор"
				},
				{
					"id": 746560103,
					"content": "Статуи - это бессловесные поэмы, поэтому не стоит любоваться ими на голодный желудок. Так сказал мне один дуэлянт во время последней в своей жизни дуэли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560106,
						746560104
					],
					"speakerTitle": "Исменор"
				},
				{
					"id": 746560106,
					"content": "Вот твои пузырины.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746560104,
					"content": "#Не {F#принесла}{M#принёс}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746560105
					]
				},
				{
					"id": 746560105,
					"content": "Я сделал, как советовали, и отложил немного моры, чтобы поблагодарить тебя за пузырин. Я дождусь, когда ты принесёшь пузырин, а потом отдам тебе вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Исменор"
				}
			]
		},
