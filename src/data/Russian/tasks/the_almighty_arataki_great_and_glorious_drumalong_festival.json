			},
			"dialogs": [
				{
					"id": 726840660,
					"content": "Говорят, что Ёимия тоже здесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840661
					]
				},
				{
					"id": 726840661,
					"content": "Ты о хозяйке «Фейерверков Наганохары»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840662
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840662,
					"content": "Она и правда очень разговорчивая и приветливая девушка. Она совершенно случайно узнала о нашем фестивале по пути на остров Амаканэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840663
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840663,
					"content": "Ей очень понравился наш фестиваль, и она даже подошла к нам с поздравлениями. А ещё она сказала, что в следующий раз заранее подготовит для нас фейерверки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840664
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840664,
					"content": "Мне кажется, в будущем нашей банде стоит наладить контакты с «Фейерверками Наганохары».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840631,
					"content": "Возвращаясь к нашей теме, дружище, остались ли у тебя какие-нибудь вопросы по поводу фестиваля?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аратаки Итто"
				}
			]
