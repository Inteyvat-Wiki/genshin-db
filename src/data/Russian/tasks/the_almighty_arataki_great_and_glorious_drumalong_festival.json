					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хирохико"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840501,
					"content": "Чего изволите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840502
					],
					"speakerTitle": "Хирохико"
				},
				{
					"id": 726840502,
					"content": "Мы ищем банду Аратаки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840503
					]
				},
				{
					"id": 726840503,
					"content": "Хм, дайте угадаю: вы тоже здесь, чтобы принять участие в каком-то там фестивале Аратаки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840504
					],
					"speakerTitle": "Хирохико"
				},
				{
					"id": 726840504,
					"content": "Тоже?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840505
					]
				},
				{
					"id": 726840505,
					"content": "Ага, совсем недавно здесь побывала Кудзё Сара из комиссии Тэнрё, а ещё госпожа Ёимия из «Фейерверков Наганохары».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840506
					],
					"speakerTitle": "Хирохико"
				},
				{
					"id": 726840506,
					"content": "Когда госпожа Ёимия пришла продавать фейерверки, она увидела, как те ребята подготавливали площадку, ей стало интересно, и она тоже присоединилась посмотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840507
					],
					"speakerTitle": "Хирохико"
				},
				{
					"id": 726840507,
					"content": "А вот почему госпожа Кудзё пожаловала сюда - непонятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840508
					],
					"speakerTitle": "Хирохико"
				},
				{
					"id": 726840508,
					"content": "#{NICKNAME}, ха-ха, так нас опередили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840509,
					"content": "Так где сейчас банда Аратаки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840510,
					"content": "Мне, право, неловко об этом говорить, но сейчас на острове не осталось свободных площадок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840511
					],
					"speakerTitle": "Хирохико"
				},
				{
					"id": 726840511,
					"content": "Поэтому мы смогли выделить им только небольшую отмель на северо-западе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840512
					],
					"speakerTitle": "Хирохико"
				},
				{
					"id": 726840512,
					"content": "Если бы они только чуть раньше подали заявку, я бы мог подготовить для них местечко получше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840513
					],
					"speakerTitle": "Хирохико"
				},
				{
					"id": 726840513,
					"content": "Если вы отправитесь на северо-запад, вы обязательно встретитесь с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хирохико"
				}
			]
		},
		{
			"id": 7268406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268406",
							"2"
						],
						"stepId": 7268406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аратаки Итто"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840601,
					"content": "Ха-ха-ха! Дружище! Вот и ты, наконец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840602
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840602,
					"content": "#Я как раз только сейчас думал, когда же я всё-таки смогу увидеть тебя, и ты {F#пришла}{M#пришёл}! Спасибо, {F#порадовала}{M#порадовал} меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840603
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840603,
					"content": "Посмотри-ка на нашу площадку. Ну как? Отличный выбор?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840604
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840604,
					"content": "Кругом море, свежий воздух, вдали от суматохи города. Замечательный пейзаж!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840605
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726840605,
					"content": "Прибыв на остров Амаканэ, проникаешься культурой праздников и фестивалей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840606
					],
					"speakerTitle": "Акира"
				},
				{
					"id": 726840606,
					"content": "Транспортное сообщение отлично развито, сюда можно добраться и на корабле, и по суше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840607,
						726840608
					],
					"speakerTitle": "Гэнта"
				},
				{
					"id": 726840607,
					"content": "Действительно неплохое место.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				},
				{
					"id": 726840609,
					"content": "Я с первого взгляда понял: вот оно, то самое место!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840610
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840610,
					"content": "В тот миг весь мир перевернулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840611
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840611,
					"content": "Босс, вы гениальны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840612
					],
					"speakerTitle": "Гэнта"
				},
				{
					"id": 726840612,
					"content": "Да ладно, мы же знаем, что вы здесь только потому, что комиссия Тэнрё отправила вас сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840613,
					"content": "Кхм-кхм... Давайте сначала о деле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840614
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840614,
					"content": "Я пригласил вас сюда в надежде, что вы примете участие в Грандиозном барабанном фестивале великолепного Аратаки! Этот фестиваль обладает огромным значением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840615
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840615,
					"content": "Во-первых, благодаря фестивалю банда Аратаки станет более узнаваемой, и в будущем нам будет проще набирать новых членов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840616
					],
					"speakerTitle": "Гэнта"
				},
				{
					"id": 726840616,
					"content": "Во-вторых, мы поздравим Синобу с успешным окончанием учёбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840617
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726840617,
					"content": "Ну и наконец, мы сможем сплотить нашу команду! Компенсируем все те разы, когда нам пришлось отказаться от этой идеи из-за недостатка средств.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840618
					],
					"speakerTitle": "Акира"
				},
				{
					"id": 726840618,
					"content": "Какой полезный этот фестиваль!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840619
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840619,
					"content": "Акира... последнее можно было не упоминать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840620
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840620,
					"content": "А куда подевалась Синобу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840621
					]
				},
				{
					"id": 726840621,
					"content": "С фестивалями всегда так: чтобы привлечь побольше людей, нужна реклама, этим и занялась Синобу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840622
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840622,
					"content": "Эй! Так разве Синобу не главное действующее лицо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840623
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840623,
					"content": "Она сейчас там трудится, а вы здесь бездельничаете!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840624
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840624,
					"content": "Вообще-то я тоже занимаюсь важными делами. Вот гостей встречаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840625
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840625,
					"content": "Босс на самом деле только что вернулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840626
					],
					"speakerTitle": "Гэнта"
				},
				{
					"id": 726840626,
					"content": "Когда речь зашла о том, что вы, возможно, прибудете, он специально пришёл, чтобы встретить вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840627
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726840627,
					"content": "А так он вместе с Синобу изо всех сил старался привлечь как можно больше людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840628
					],
					"speakerTitle": "Акира"
				},
				{
					"id": 726840628,
					"content": "Вы меня захвалите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840629
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840629,
					"content": "Ого, у Пастушонка вдруг проснулось желание серьёзно заниматься делом. Становишься надёжным типом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840630
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840630,
					"content": "Пф, это уж не летающей карликовой дыньке судить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840631,
					"content": "Возвращаясь к нашей теме, дружище, остались ли у тебя какие-нибудь вопросы по поводу фестиваля?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840608,
					"content": "Вы настроены оптимистично.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				}
			]
		},
		{
			"id": 7268407,
			"completionStepIds": [
				7268407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268407",
							"2"
						],
						"stepId": 7268407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гэнта"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840701,
					"content": "Я - Гэнта, ответственный за приём гостей фестиваля Аратаки. Можем начинать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840702
					],
					"speakerTitle": "Гэнта"
				},
				{
					"id": 726840702,
					"content": "О, кстати, босс совсем забыл пояснить кое-что по поводу этого барабана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840703
					],
					"speakerTitle": "Гэнта"
				},
				{
					"id": 726840703,
					"content": "У нас здесь совсем никто ничего не понимает в музыке, поэтому перед началом церемонии ты можешь самостоятельно попрактиковаться играть на нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840704
					],
					"speakerTitle": "Гэнта"
				},
				{
					"id": 726840704,
					"content": "Так звук на самом выступлении будет чище и приятнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840705
					],
					"speakerTitle": "Гэнта"
				},
				{
					"id": 726840705,
					"content": "Пожалуйста, попробуй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гэнта"
				}
			]
		},
		{
			"id": 7268430,
			"completionStepIds": [
				7268406
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268406",
							"2"
						],
						"stepId": 7268406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аратаки Итто"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840632,
					"content": "Какие планируются мероприятия?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840633
					]
				},
				{
					"id": 726840633,
					"content": "Ха-ха-ха! У нас богатая программа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840634
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840634,
					"content": "Видишь вон тот холм? Это холм песнопений. На нём можно петь, обращаясь к морю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840635
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840635,
					"content": "На костре можно поджарить фиалковые дыни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840636
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840636,
					"content": "Ещё у нас есть эти ящики, места хватит для всего: и для «Священного призыва семерых», и для жучиных боёв.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840637
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840637,
					"content": "И впрямь «богато».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840638
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840638,
					"content": "Конечно же, главным событием фестиваля станет Барабанное шоу. Вот, посмотрите сами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840639
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840639,
					"content": "Скажу по секрету, это сокровище я получил с помощью тайных каналов. Говорят, что этот маленький барабанчик оставил один оммёдзи, его начальная стоимость - восемь миллионов моры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840640
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840640,
					"content": "Продавщица сказала, что ей понравился мой благородный облик, она почувствовала, что между нами особая связь, а потому была готова сделать скидку и уступить барабан за восемьсот тысяч.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840641
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840641,
					"content": "Вещь за восемь миллионов отдают за восемьсот тысяч... Паймон кажется, что это обман.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840642
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840642,
					"content": "Именно! Но разве можно меня обмануть такими детскими методами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840643
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840643,
					"content": "Я с первого взгляда понял, что этот барабанчик с изъянами, обычный брак! Она ещё и сказала, что между нами особая связь, смех, да и только!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840644
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840644,
					"content": "Я торговался как зверь, так что в конце концов мы сговорились на восемьдесят тысяч. Ха-ха-ха! Я остался в большом плюсе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840645
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840645,
					"content": "Паймон кажется, что это продавщица осталась в большом плюсе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840646
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840646,
					"content": "У Пастушонка нашлось целых восемьдесят тысяч, вот это да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840647
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840647,
					"content": "Ха, всего-то! Не надо меня недооценивать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840648
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840648,
					"content": "Там моих было двадцать тысяч...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840649
					],
					"speakerTitle": "Гэнта"
				},
				{
					"id": 726840649,
					"content": "И моих...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840650
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726840650,
					"content": "А? Босс, а почему я тогда одолжил тридцать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840651
					],
					"speakerTitle": "Акира"
				},
				{
					"id": 726840651,
					"content": "Двадцать тысяч, да ещё двадцать, плюс ещё тридцать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840652
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840652,
					"content": "Ах ты, Пастушонок! Сам не заплатил ни моры, обобрал бедняг!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840653
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840653,
					"content": "Кхе-кхе, ты как вообще считаешь? Я тоже скинулся - десять тысяч были из моего кармана!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840665
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840665,
					"content": "Ладно, хватит разговоров. Мне пора возвращаться к Синобу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840666
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840666,
					"content": "Праздник только-только начался, нам нужно постараться, чтобы привлечь побольше людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840667
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840667,
					"content": "#Возьми этот барабан. Как будешь {F#готова}{M#готов}, подойди к Гэнте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840668
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840668,
					"content": "До скорого, дружище!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аратаки Итто"
				}
			]
		},
