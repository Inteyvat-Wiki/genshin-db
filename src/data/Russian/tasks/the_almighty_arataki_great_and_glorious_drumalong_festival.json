					"Кимура"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840301,
					"content": "Нужна помощь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840302
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840302,
					"content": "Расскажи о предстоящем фестивале.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840303
					]
				},
				{
					"id": 726840303,
					"content": "Что? Фестиваль? Вроде ни о каких фестивалях речи не шло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840304
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840304,
					"content": "Вы не могли бы рассказать чуть подробнее? Например, как он будет называться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840305
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840305,
					"content": "Грандиозный фестиваль...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840306
					]
				},
				{
					"id": 726840306,
					"content": "Грандиозный?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840307,
						726840308
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840307,
					"content": "Грандиозный фестиваль Аратаки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				},
				{
					"id": 726840309,
					"content": "Грандиозный барабанный фестиваль великолепного Аратаки, организованный самой бандой Аратаки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840310,
					"content": "Ого! Той самой бандой Аратаки, которая в прошлый раз устроила дебош на празднике Иродори?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840311
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840311,
					"content": "Так вы говорите о том несанкционированном мероприятии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840312
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840312,
					"content": "Несанкционированном? Нет-нет, вы нас не так поняли. Речь о Грандиозном барабанном фестивале великолепного Аратаки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840313,
					"content": "Ладно-ладно, хватит повторять это название, я понял, о чём речь. Могу вам кое-что рассказать о нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840314
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840314,
					"content": "Несколько дней назад я в самом деле видел здесь нескольких членов банды Аратаки. Они повсюду наставили совершенно безвкусные вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840315
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840315,
					"content": "Тот, кто был у них за главного, вообще заявил, что они собираются провести здесь фестиваль, который затмит сам праздник Иродори. Должно быть, вы об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840316
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840316,
					"content": "Однако пары вопросов хватило, чтобы выяснить, что у них не было разрешения на проведение этого мероприятия, равно как и документов на аренду площадки, а уж о разрешениях из необходимых инстанций я вообще молчу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840317
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840317,
					"content": "Несанкционированно, непрофессионально, неофициально. В соответствии с законом мы были вынуждены заставить их остановиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840318
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840318,
					"content": "Э? Заставить остановиться? Неужели вы их арестовали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840319,
					"content": "До этого не дошло. Учитывая, что у них не было опыта организации подобных мероприятий, и, принимая во внимание их проработанную памятку по технике безопасности, мы ограничились нравоучительной нотацией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840320
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840320,
					"content": "Памятка по технике безопасности... А эти парни и правда осознают всю ответственность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840321,
					"content": "Если вы разыскиваете банду Аратаки, вам следует отправиться на остров Амаканэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840322
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840322,
					"content": "Комиссия Ясиро выделила остров Амаканэ для проведения крупномасштабных мероприятий. Изначально задумывалось, что таким образом будут поддерживаться народные культурные традиции. С необходимыми процедурами и пошлинами там всё просто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840323
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840323,
					"content": "Мы передали эту информацию тем господам из банды Аратаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840324
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840324,
					"content": "Если они всё ещё хотят провести своё мероприятие, то места лучше им просто не найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840325
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840325,
					"content": "#Хм, {NICKNAME}, хотя всё это не слишком вызывает доверие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840326,
					"content": "...но, раз уж мы всё равно здесь, может, заглянем на остров Амаканэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726840308,
					"content": "Грандиозный барабанный фестиваль...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				}
			]
		},
		{
