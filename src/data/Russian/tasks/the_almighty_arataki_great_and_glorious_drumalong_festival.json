			},
			"dialogs": [
				{
					"id": 726847201,
					"content": "Я - Мамору, отвечаю за атмосферу грандиозного барабанного фестиваля Аратаки. Тебе что-нибудь нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847202
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726847202,
					"content": "Хочешь более подробно узнать о моей работе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847203
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726847203,
					"content": "Хм, как ответственный за атмосферу я главным образом должен способствовать всеобщему веселью, чтобы все люди, пришедшие к нам на фестиваль, думали: «Ох, здесь нереально здорово!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847204
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726847204,
					"content": "Вот у тебя такие мысли не возникают?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847205,
						726847206
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726847205,
					"content": "Совсем нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				},
				{
					"id": 726847207,
					"content": "Пожалуйста, пожалуйста, не говори так!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847208
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726847208,
					"content": "Не надо своим равнодушием уничтожать мой энтузиазм! Так моя работа лишается всякого смысла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847209
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726847209,
					"content": "Ты же дружище босса, так поддержи меня вместо него. Пожалуйста, просто скажи мне эти слова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847210
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726847210,
					"content": "Какие слова?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847211
					]
				},
				{
					"id": 726847211,
					"content": "Ох, здесь нереально здорово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847212,
						726847215
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726847212,
					"content": "Ох, здесь нереально здорово.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847213
					]
				},
				{
					"id": 726847213,
					"content": "Здорово! Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847214
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726847214,
					"content": "Это лучшее признание наших стараний!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726847218,
					"content": "Давайте, друзья! Давайте веселиться! Давайте танцевать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726847215,
					"content": "Ох, как же здесь... здесь нереально... прости, я не могу это сказать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847216
					]
				},
				{
					"id": 726847216,
					"content": "О... ладно. Всё равно, глядя, как все члены банды Аратаки изо всех сил делают свою работу, я не могу позволить себе расслабиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847217
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726847217,
					"content": "Трудности нас не остановят - таков мой девиз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "Мамору"
				},
				{
					"id": 726847206,
					"content": "Нет, даже и близко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				}
			]
		}
	]
