				"points": []
			},
			"dialogs": [
				{
					"id": 726847101,
					"content": "Я - Акира, отвечаю за сбор отзывов по поводу особого барабанного фестиваля Аратаки. Поделишься своим мнением?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847102,
						726847103,
						726847104
					],
					"speakerTitle": "Акира"
				},
				{
					"id": 726847102,
					"content": "Мне кажется, всё очень неплохо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847105,
					"content": "Спасибо за отзыв!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847106
					],
					"speakerTitle": "Акира"
				},
				{
					"id": 726847106,
					"content": "А? Что-то ещё? Мне больше нечего сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847107
					],
					"speakerTitle": "Акира"
				},
				{
					"id": 726847107,
					"content": "То есть... просто босс говорил, что мне нужно говорить только две фразы: «Поделитесь своим мнением?» и «Спасибо за ваш отзыв!».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847108
					],
					"speakerTitle": "Акира"
				},
				{
					"id": 726847108,
					"content": "Если же гость спросит о том, когда отзывы будут обработаны, то я должен отвечать: «Просим вас проявить терпение и немного подождать».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847109
					],
					"speakerTitle": "Акира"
				},
				{
					"id": 726847109,
					"content": "Босс сказал, что на других мероприятиях это делается именно так, и мы должны перенимать чужой опыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847110
					],
					"speakerTitle": "Акира"
				},
				{
					"id": 726847110,
					"content": "Но потом Синобу сказала, что это халатность, и подготовила специально для меня этот блокнотик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847111
					],
					"speakerTitle": "Акира"
				},
				{
					"id": 726847111,
					"content": "Вот, твой отзыв записан, и как только Синобу вернётся, она сама просмотрит все записи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Акира"
				},
				{
					"id": 726847103,
					"content": "Средне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847104,
					"content": "Мне кажется, есть куда расти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				}
			]
		},
