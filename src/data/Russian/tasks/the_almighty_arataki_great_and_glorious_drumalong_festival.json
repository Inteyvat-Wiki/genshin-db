			"dialogs": [
				{
					"id": 726840654,
					"content": "Говорят, что Кудзё тоже здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840655
					]
				},
				{
					"id": 726840655,
					"content": "А, ты об этой противной тэнгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840656
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840656,
					"content": "Мне пришлось послать пригласительный и ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840657
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840657,
					"content": "Но она напрочь лишена чувства благодарности. Специально установила доску объявлений с какими-то нелепыми сообщениями, оправдываясь тем, что это предупреждения для путешественников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840658
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840658,
					"content": "Ещё сказала, чтобы мы не вздумали ничего стирать. Как бессовестно так обращаться с нами, с бандой Аратаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840659
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840659,
					"content": "Я мечтаю, что однажды прямо на главной улице сойдусь с ней в честном бою. Кто-то же должен как следует проучить эту заносчивую тэнгу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 726840631,
					"content": "Возвращаясь к нашей теме, дружище, остались ли у тебя какие-нибудь вопросы по поводу фестиваля?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аратаки Итто"
				}
			]
		},
