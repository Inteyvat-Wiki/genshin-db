			},
			"dialogs": [
				{
					"id": 726840401,
					"content": "Остались ли у вас ещё какие-нибудь вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840402
					],
					"speakerTitle": "Кимура"
				},
				{
					"id": 726840402,
					"content": "Если вам нужна банда Аратаки, вам следует отправиться на остров Амаканэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кимура"
				}
			]
		},
		{
			"id": 7268405,
			"completionStepIds": [
				7268405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
