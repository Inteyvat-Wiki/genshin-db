			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вакамурасаки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720401,
					"content": "Ну как, этой сетью удобно пользоваться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720402
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720402,
					"content": "Её хватило на один раз...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720403
					]
				},
				{
					"id": 726720403,
					"content": "Хм... Полагаю, это было неизбежно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720404
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720404,
					"content": "Как я уже говорила, техника оммё может поймать сущность небольшого животного. Но чтобы сохранить эту сущность и воссоздать животное, нужен материальный носитель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720405
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720405,
					"content": "Я использовала эту технику в Сети всевездесущности, так что она служит средством для сохранения сущности и одновременно носителем для воплощения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720406
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720406,
					"content": "Как-то сложно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720407
					]
				},
				{
					"id": 726720407,
					"content": "Попросту говоря, каждую сеть можно использовать только один раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720408
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720408,
					"content": "Я пока не смогла решить эту проблему. Если носитель нельзя будет переиспользовать, цена использования устройства будет слишком высока...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720409
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720409,
					"content": "Я продолжу работу над сетью и постараюсь устранить проблему как можно скорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720410
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720410,
					"content": "Если тебе ещё понадобятся Сети всевездесущности, приходи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720411
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720411,
					"content": "И вот ещё... Хотя пока эти сетки годятся только для ловли мелких животных, но их довольно сложно делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720412
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720412,
					"content": "Так что... хм, за следующую сеть тебе придётся оплатить мне её себестоимость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720413
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720413,
					"content": "Не переживай, мы же с Санго друзья, я дам тебе честную цену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вакамурасаки"
				}
			]
		},
		{
