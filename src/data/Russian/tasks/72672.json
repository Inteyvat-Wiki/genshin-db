				"objectNames": [
					"Санго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720101,
					"content": "Ох уж эта Вакамурасаки. Не надо было говорить ей о Кагэромару...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720102
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720102,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720103
					]
				},
				{
					"id": 726720103,
					"content": "#О, привет, путешественни{F#ца}{M#к}. Ещё помнишь про Сеть вездесущности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720104
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720104,
					"content": "После того как мы разобрались с прошлым делом, я рассказала обо всём произошедшем своей подруге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720105
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720105,
					"content": "Её зовут Вакамурасаки, и она... Ну, она называет себя «конструктором».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720106
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720106,
					"content": "#То, как ты использовал{F#а} сеть, очень её вдохновило.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720107
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720107,
					"content": "Она всё упрашивала меня помочь ей придумать, как лучше переделать Сеть вездесущности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720108
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720108,
					"content": "Сил не было терпеть её нытьё, так что я отыскала новенький приёмчик в своей коллекции древностей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720109
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720109,
					"content": "#Если тебя это интересует, путешественни{F#ца}{M#к}, ступай к ней. Думаю, она уже закончила вносить улучшения в сеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				}
			]
		},
		{
			"id": 7267202,
			"completionStepIds": [
				7267202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267202",
							"2"
						],
						"stepId": 7267202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вакамурасаки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720201,
					"content": "Так, ну это уж точно должно сработать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720202
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720202,
					"content": "Привет, ты Вакамурасаки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720203
					]
				},
				{
					"id": 726720203,
					"content": "Да, это я. Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720204
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720204,
					"content": "Я по поводу Сети вездесущности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720205
					]
				},
				{
					"id": 726720205,
					"content": "#А? Ты... и есть т{F#а}{M#от} сам{F#ая}{M#ый} путешественни{F#ца}{M#к}, да? Санго говорила мне о тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720206
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720206,
					"content": "У тебя здорово получается управляться с Сетью вездесущности. Очень вдохновляюще!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720207
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720207,
					"content": "Говорят, ты её сейчас улучшаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720208
					]
				},
				{
					"id": 726720208,
					"content": "Да, так и есть. Хе-хе... Санго откопала для меня совершенно новую технику оммё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720209
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720209,
					"content": "Я использовала эту технику, чтобы создать новую, улучшенную модель. Я назову её «Сеть всевездесущности»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720210
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720210,
					"content": "По словам Санго, эта техника оммё способна удерживать духовные сущности живых существ, а потом воссоздавать форму этих существ на другом материальном носителе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720211
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720211,
					"content": "Она говорит, что в своём высшем проявлении эта техника оммё может даже воссоздать сущность человека!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720212
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720212,
					"content": "Такие сущности могут отвечать на вопросы и никогда не лгут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720213
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720213,
					"content": "Детективу вроде Санго этот приём очень бы пригодился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720214
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720214,
					"content": "Знаешь что? Я начинаю подозревать, что именно поэтому она рассказала мне об этой технике и позволила внести изменения в сеть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720215
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720215,
					"content": "Ах, да! Только не вздумай никому об этом рассказывать. Я поделилась с тобой только потому, что вы с Санго друзья, ясно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720216,
						726720217
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720216,
					"content": "Э-это и вправду настолько мощная штука?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				},
				{
					"id": 726720218,
					"content": "Мм, вообще-то пока нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720219
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720219,
					"content": "Что бы я ни делала, эта сеть годится только для воссоздания сущностей мелких существ. На людей она вообще не действует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720220
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720220,
					"content": "#Знаешь что, путешественни{F#ца}{M#к}? Возьми эту сеть с собой. Кто знает, может, увидев тебя в деле, я снова обрету вдохновение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720221
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720221,
					"content": "Вот, возьми. И помни, теперь это не просто Сеть вездесущности, а Сеть всевездесущности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720222
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720222,
					"content": "Скорее поймай каких-нибудь животных, чтобы испытать её в деле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 726720217,
					"content": "Ты смогла внести улучшения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				}
			]
		},
		{
			"id": 7267204,
			"completionStepIds": [
				7267204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
