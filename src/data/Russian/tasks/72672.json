				"points": []
			},
			"dialogs": [
				{
					"id": 726720501,
					"content": "#Поговорил{F#а} с Вакамурасаки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720502
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720502,
					"content": "Речь шла о Сети всевездесущности...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720503
					]
				},
				{
					"id": 726720503,
					"content": "Сеть всевездесущности... Звучит неплохо, вот только эта техника оммё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720504
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720504,
					"content": "Эта техника действительно может удержать духовную сущность человека?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720505
					]
				},
				{
					"id": 726720505,
					"content": "Мм, нет... Это невозможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720506
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720506,
					"content": "О подобном сохранились лишь упоминания. Практика растворилась в тумане прошлого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720507
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720507,
					"content": "Техника, которой я обучила Вакамурасаки, годится только для небольших животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720508
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720508,
					"content": "Подожди, тогда почему ты ей об этом не сказала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720509
					]
				},
				{
					"id": 726720509,
					"content": "Ну, если ты об этом... Я хотела, чтобы Вакамурасаки помогла мне распространить слухи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720510
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720510,
					"content": "«Глава детективного агентства Бантан Санго поручила кому-то создать сеть с помощью техники оммё Камуны, которая может заставить людей говорить правду».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720511
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720511,
					"content": "Давно утраченная техника оммё Камуны, детективное агентство Бантан Санго и сеть... которая в действительности годится только для ловли сущностей мелких животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720512
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720512,
					"content": "Соедини три этих элемента вместе и получишь городскую легенду, которая звучит очень впечатляюще и при этом не так уж далека от истины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720513
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720513,
					"content": "Для обычного человека подобная городская легенда лишь незначительная историйка. Но для преступников, в сердцах которых уже живут семена страха, подобные истории совсем не так просты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720514
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720514,
					"content": "Так вот в чём дело.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720515
					]
				},
				{
					"id": 726720515,
					"content": "Ну и опять же... Вакамурасаки начала действовать мне на нервы со всей этой чепухой: «Найди мне самую сильную технику оммёдо!».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720516
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720516,
					"content": "Я сотню раз говорила ей, что подобного не существует, но она меня не слушала! Поэтому мне не оставалось ничего, кроме как дать ей для работы хоть что-то, чтобы она отвязалась от меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720517
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720517,
					"content": "Что если Вакамурасаки никому об этом не расскажет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720518
					]
				},
				{
					"id": 726720518,
					"content": "Не-воз-мож-но. Она не в состоянии сохранить секрет, даже если бы от этого зависела её жизнь. Я её слишком хорошо знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720519
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720519,
					"content": "В любом случае спасибо за помощь с визитом. Прими от меня вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720520
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 726720520,
					"content": "О, Архонты, надеюсь, она больше не будет меня беспокоить. Я детектив, понимаешь? А не какой-нибудь оммёдзи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				}
			]
		},
