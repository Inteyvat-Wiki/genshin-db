				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304101",
							"2"
						],
						"stepId": 2304101,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"3",
							"23041"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нермин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410301,
					"content": "#Путешественни{F#ца}{M#к}, ты как раз вовремя. Попробуй мой мятно-фасолевый суп!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410303
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410303,
					"content": "А из чего суп?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410304
					]
				},
				{
					"id": 230410304,
					"content": "Большинство ингредиентов купили по моей просьбе. Но вот мята... Это я её вырастила!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410305
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410305,
					"content": "Раеф подарил мне набор садовых инструментов и немного удобрений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410306
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410306,
					"content": "Я подумала, что было бы расточительством использовать их на один-единственный цветочный горшок... Поэтому я попросила Азалая купить для меня семена мяты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410307
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410307,
					"content": "Я посадила мяту и ухаживала за ней так же, как и за цветами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410308
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410308,
					"content": "И вот мята росла-росла и выросла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410309
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410309,
					"content": "Я собрала немного мяты и приготовила этот мятно-фасолевый суп. Как тебе? Вкус довольно приятный, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410310
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410310,
					"content": "#Так, раз ты съел{F#а} мой мятно-фасолевый суп, то теперь {M#должен}{F#должна} мне помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410311,
						230410312
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410311,
					"content": "#Я ведь даже не доел{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				},
				{
					"id": 230410313,
					"content": "Я же просто пошутила! А за твою помощь я дам хорошую награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410314
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410314,
					"content": "#Мне нужно всего лишь, чтобы ты {M#принёс}{F#принесла} мне три персика зайтун. Это любимый фрукт Раефа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410315
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410315,
					"content": "Хочу добавить персики в мой мятно-фасолевый суп и отнести Раефу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410316
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410316,
					"content": "Мятно-фасолевый суп я уже варить умею. Мне не хватает только персиков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410317,
						230410319
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410317,
					"content": "Ясно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410318
					]
				},
				{
					"id": 230410318,
					"content": "Спасибо! Когда вернёшься, я угощу тебя ещё одной миской мятно-фасолевого супа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410321,
					"content": "#Я рассчитываю на тебя, путешественни{M#к}{F#ца}. Принеси мне персики зайтун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410319,
					"content": "Разве он может есть в рабочее время?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410320
					]
				},
				{
					"id": 230410320,
					"content": "Это не отнимет у него так уж много времени. Да и он не слишком занят работой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410312,
					"content": "Забирай суп назад!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				}
			]
		},
