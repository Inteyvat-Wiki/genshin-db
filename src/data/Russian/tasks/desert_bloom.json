				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нермин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410201,
					"content": "О нет, снова листья обкусаны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410202
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410202,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410203
					]
				},
				{
					"id": 230410203,
					"content": "#Путешественни{F#ца}{M#к}, ты только посмотри! Котёнок опять объел листья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410204
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410204,
					"content": "Взгляни на этот листок. И на тот! От каждого отхватил приличный кусок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410205,
						230410208
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410205,
					"content": "Может, котёнок голоден?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410206
					]
				},
				{
					"id": 230410206,
					"content": "То же самое сказал и Раеф. Он даже сходил покормить котёнка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410207
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410207,
					"content": "Но на следующий день котёнок вернулся и снова обглодал мои цветы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410210,
					"content": "Пока что котёнок просто кусает листья. Но если он начнёт грызть стебли? Вот это будет беда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410211
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410211,
					"content": "Но и прогонять его я не хочу. За деревней ему некуда идти, только в пустыню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410212
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410212,
					"content": "#Путешественни{F#ца}{M#к}, поможешь мне? Нужно ещё раз покормить котёнка. Надеюсь, после этого он не будет больше обгладывать листья у моего цветка. Они ведь даже не съедобные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410213,
						230410214
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410213,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410216
					]
				},
				{
					"id": 230410216,
					"content": "#Спасибо, что {M#согласился}{F#согласилась} помочь. Я отмечу на карте место, куда любит наведываться котёнок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410217
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410217,
					"content": "А я покараулю здесь на случай, если явится ещё один мохнатый любитель полакомиться листьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410214,
					"content": "С кошками мне равных нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410215
					]
				},
				{
					"id": 230410215,
					"content": "Отлично! А то я при виде кошачьих лап сразу представляю, как в меня впиваются их когти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410216
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410208,
					"content": "Может, котёнку нравится играть с листьями?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410209
					]
				},
				{
					"id": 230410209,
					"content": "Не знаю, что ему нравится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Нермин"
				}
			]
		},
		{
			"id": 2304103,
			"completionStepIds": [
				2304101,
				2304111,
				2304116,
				2304117
			],
			"beginWay": "TALK_BEGIN_MANUAL",
