						230410506
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410506,
					"content": "Бабушка Кульсум говорит, что поливать надо до момента, когда вода начинает просачиваться в поддон горшка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410507
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410507,
					"content": "Это значит, что почва пропиталась насквозь. Поливать надо раз в три дня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410508
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410508,
					"content": "#Ой, прости, я увлеклась. А вот и обещанная награда. Спасибо за помощь, путешественни{M#к}{F#ца}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410509
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410509,
					"content": "Что мне взять для обрезки листьев...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нермин"
				}
			]
