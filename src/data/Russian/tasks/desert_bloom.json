			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нермин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410101,
					"content": "Уф... Теперь земля должна быть достаточно рыхлой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410102
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410102,
					"content": "Ты всё ещё занимаешься этим цветком?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410103
					]
				},
				{
					"id": 230410103,
					"content": "Да, бабушка Кульсум дала мне пару советов по уходу за цветами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410104
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410104,
					"content": "Рассказала о рыхлении почвы, о регулярной обрезке листьев и о том, как справиться с жуками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410105
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410105,
					"content": "Да, и что нельзя поливать цветы слишком часто, чтобы корни не загнили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410106
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410106,
					"content": "А мне-то казалось, что поливать нужно каждый день... Чтобы почва всегда была влажной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410107
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410107,
					"content": "Зато теперь мне больше не придётся каждый день ходить за водой. А то колодец неблизко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410108
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410108,
					"content": "Мне нужно закончить обрезку. А ты можешь пока принести немного воды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410109
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410109,
					"content": "Я говорила с Касаном. Он сказал, что я могу набрать воды для полива сегодня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410110,
						230410111
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410110,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410114
					]
				},
				{
					"id": 230410114,
					"content": "Лейка вон там. Осторожнее при наборе воды, не зачерпни грязь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410111,
					"content": "Всему этому тебя научила бабушка Кульсум?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410112
					]
				},
				{
					"id": 230410112,
					"content": "Ну... Вроде того. Бабушка Кульсум всё знает. Я всегда с ней советуюсь, когда у меня есть вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410113
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230410113,
					"content": "Полагаюсь на тебя! Воды нужно не так уж много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410114
					],
					"speakerTitle": "Нермин"
				}
			]
		},
		{
			"id": 2304102,
			"completionStepIds": [
				2304101,
				2304111,
				2304116,
				2304117
			],
			"beginWay": "TALK_BEGIN_MANUAL",
