					"nextDialogs": [
						732572907
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732572907,
					"content": "Давайте не будем тратить время на неуместную болтовню. Поручаю оставшееся вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572908
					],
					"speakerTitle": "Михир"
				},
				{
					"id": 732572908,
					"content": "«Да озарит вечная Хварна наш путь ввысь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Михир"
