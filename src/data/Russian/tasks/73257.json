			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Соруш"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570101,
					"content": "Соруш и слова не проронила с тех пор, как мы покинули разрушенную мастерскую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570102,
					"content": "Раньше она говорила без умолку. Паймон не может понять, почему она молчит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570103,
						732570104,
						732570105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570103,
					"content": "Должно быть, сильно испугалась.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570106,
					"content": "Не вешай нос, Соруш! У нас ещё куча дел!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570107,
					"content": "Например, нам нужно провести... э-э-э... тот обряд со странным названием, а затем заделать огромную дыру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570108,
					"content": "А когда всё будет сделано, мы сможем вознаградить себя чем-нибудь вкусненьким за труды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570109,
					"content": "Мы можем поесть... Паймон не знает, что пари предпочитают...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570111
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570111,
					"content": "Пари не нуждаются в еде, глупое существо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570112
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570112,
					"content": "Подумать только! Я так низко пала, что нуждаюсь в утешении Белой Болталки. Какой позор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570113
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570113,
					"content": "Я бы предпочла быть запечатанной в сером кристалле или найти себе пещеру и безмятежно спать там целую вечность, пока все, кого я знаю, не перестанут существовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570114
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570114,
					"content": "Паймон устала повторять, что Паймон не Белая Болталка! Что за глупое создание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570115,
						732570117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570115,
					"content": "Избегание не поможет решить проблему.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570116
					]
				},
				{
					"id": 732570116,
					"content": "Мне всё равно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570119,
					"content": "Как мне жить с чувством глубокого стыда из-за того, что Наседжуна меня одурачил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570120
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570120,
					"content": "Теперь, когда вы собрали все великие песни Хварны, вы можете отправиться к Михир или Рашну, если хотите устранить аномалию в небе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570121
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570121,
					"content": "Прошу, оставьте меня в покое и забудьте, что я говорила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570122
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570122,
					"content": "Ты много чего говорила. Что именно нам надо забыть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570123,
						732570124,
						732570125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570123,
					"content": "#Забыть, что я {F#твоя}{M#твой} яснапати?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570126,
					"content": "Хватит! Довольно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570127
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570127,
					"content": "#{NICKNAME}, не надо её дразнить! Она проделала с нами долгий путь, и Паймон не хочет, чтобы она бросила всё, не закончив начатое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570128,
					"content": "Более того, у Соруш есть... хорошие качества... например...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570129,
					"content": "Я видела, как ты замешкалась! У-у-у... Хватит меня жалеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570130,
						732570131
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570130,
					"content": "Ты быстро действуешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570132,
					"content": "Да! И мы прилагаем все усилия, чтобы потушить знамение, разве нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570133,
					"content": "Мы достигли успехов только благодаря тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570134,
					"content": "#Как там было? Вспомнила! «Однажды ты станешь {M#великим искателем}{F#великой искательницей} приключений, это лишь вопрос времени.».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570135,
					"content": "Правда? Ты искренне меня хвалишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570136
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570136,
					"content": "Да, настолько искренне, насколько может быть искренним друг.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570137
					]
				},
				{
					"id": 732570137,
					"content": "Хе-хе, я знала, что я великая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570138
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570138,
					"content": "Ха, ко мне вернулась уверенность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570139
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570139,
					"content": "Итак, к Соруш вернулась уверенность в своих силах. Теперь давайте найдём Зурван, заделаем гигантскую дыру и получим награду! Паймон не терпится съесть свой большой обед!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570131,
					"content": "У тебя есть чувство ответственности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570124,
					"content": "Забыть про отвагу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570125,
					"content": "Забыть про судьбоносное самопожертвование?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570117,
					"content": "У тебя остались незавершённые дела.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570118
					]
				},
				{
					"id": 732570118,
					"content": "Я знаю, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570104,
					"content": "Учитывая случившееся...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570105,
					"content": "Или, может быть, устала.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				}
			]
		},
		{
			"id": 7325702,
			"completionStepIds": [
				7325702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325702",
							"2"
						],
						"stepId": 7325702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Зурван"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							390.447,
							312.914,
							5703.516
						],
						"pointId": 4535
					}
				]
			},
			"dialogs": [
				{
					"id": 732570201,
					"content": "Зурван, мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570202,
					"content": "#О! {NICKNAME}, Соруш и Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570203
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570203,
					"content": "Судя по всему, вам удалось добыть все великие песни Хварны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570204,
						732570205
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570204,
					"content": "Несмотря на некоторые сложности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				},
				{
					"id": 732570206,
					"content": "Вы преуспели. Я была права, доверив вам эту миссию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570207
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570207,
					"content": "Если бы не вы, великие песни Хварны наверняка бы попали в руки недобрых людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570208
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570208,
					"content": "Почему Паймон кажется, что Зурван предвидела, что произойдёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570209,
					"content": "Эх-хе, значит, я снова оказалась права! Вы столкнулись с приспешниками тьмы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570210,
						732570212
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570210,
					"content": "Откуда ты знаешь об этом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570211
					]
				},
				{
					"id": 732570211,
					"content": "Ну... Вместо того чтобы зацикливаться на том, как я об этом узнала, почему бы вам не рассказать, что именно произошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570214,
					"content": "Вы рассказываете Зурван о своём приключении в подземных руинах и о предательстве Наседжуны.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732570215
					]
				},
				{
					"id": 732570215,
					"content": "Хе-хе, даже виджнянапати ордена скептиков встал на сторону чёрной бездны. Неожиданно. Я не возлагала на них особых надежд, но это переходит все границы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570216
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570216,
					"content": "#И если я не ошибаюсь, Наседжуну склонил к поискам великих песен Хварны слуга чёрной бездны, с которым ты {F#сражалась}{M#сражался}. Он мой старый знакомый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570217
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570217,
					"content": "А? Ты знаешь того парня из ордена Бездны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570218,
					"content": "Раньше он состоял в ордене скептиков. Несколько сотен лет назад из тропического леса прибыла следственная группа, чтобы изучить секреты дахрийцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570219
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570219,
					"content": "Они настаивали на том, чтобы войти в руины дахрийцев, несмотря на предостережение ордена. Тогда виджнянапати отправил этого человека с группой на случай, если что-то пойдёт не так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570220
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570220,
					"content": "Никто не знал, с чем они столкнулись в руинах, но к тому времени, как он вернулся, он успел получить благословение скверны, а исследовательской группы нигде не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570221
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570221,
					"content": "Затем пришли последователи чёрной бездны. Им нужны были великие песни Хварны, и для этой цели они призвали бесчисленных дэвов, которые напали на оазис Вурукаша.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570222
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570222,
					"content": "Благодаря помощи многих пари и воинов-людей нам удалось защитить свой дом, но мы не смогли искоренить последователей тёмного пролома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570223
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570223,
					"content": "Дабы убедиться, что у них не останется лазеек, я использовала силу великих песен Хварны, чтобы запечатать оазис Вурукаша и многочисленные руины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570224
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570224,
					"content": "Орден скептиков так и не смог оправиться от случившегося. В результате пожара они утратили свои древние архивы и постепенно стали такими, какими вы их видите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570225
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570225,
					"content": "Когда вы упомянули их в последний раз, я почувствовала, что последователи тёмного пролома ведут свою игру. Но не ожидала, что они смогли перетянуть на свою сторону даже главу скептиков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570226
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570226,
					"content": "Паймон интересно, о чём говорил Наседжуна. Ты знаешь что-нибудь о предках скептиков?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570227
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570227,
					"content": "Ты ведь сражалась с ними плечом к плечу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570228
					]
				},
				{
					"id": 732570228,
					"content": "Хе-хе, история превращается в легенды, а легенды - в сказки. Так живут традиции. Забвение - это тоже часть истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570229
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570229,
					"content": "Чем больше вы цепляетесь за представление о традициях, тем больше вы выборочно запоминаете только желаемые истории и в конце концов теряетесь в лабиринте сказок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570230
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570230,
					"content": "В мире, где вещи забываются каждый час каждого дня, то, что мы записываем на земле, гораздо надёжнее, чем то, что мы поём ветру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570231
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570231,
					"content": "Вот почему я доверяю вам. Вы честны и вас не беспокоит мнение других людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570232
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570232,
					"content": "Хоть ты и хвалишь нас, но делаешь это как-то странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570233,
					"content": "Я почему-то чувствую сарказм.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570234
					]
				},
				{
					"id": 732570234,
					"content": "Предполагаю, что слова первоявленной Зурван адресованы мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570235
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570235,
					"content": "Что касается произошедшего пятьсот лет назад, думаю, вам лучше всё один раз увидеть, чем сотню раз слушать мои истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570236
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570236,
					"content": "И сейчас у вас есть эта возможность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570237
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570237,
					"content": "К слову, Соруш, ты стала более надёжной. После всего пережитого ты пробудилась от этих бредней людей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570238
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570238,
					"content": "Первоявленная! Прошу, пусть всё останется в прошлом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570239
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570239,
					"content": "#{NICKNAME}, я поступила правильно, доверив это дело тебе и Паймон. Полагаю, я также могу смело просить вас провести обряд Аб-Зохр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570240
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570240,
					"content": "Обряд Аб-Зохр?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570241
					]
				},
				{
					"id": 732570241,
					"content": "Паймон помнит, что Зурван рассказывала об этом обряде! Он нужен, чтобы очистить... какую-то скверну?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570242
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570242,
					"content": "Обряд Аб-Зохр - это ритуал, который проводится для очищения Харвисптохм от скверны. Обычно его проводят только под подавляющими тьму деревьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570243
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570243,
					"content": "Однако, учитывая ослабление печати и повторное появление аномалии в небе, нам нужно какое-то особое решение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570244
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570244,
					"content": "Аномалия появилась над Харвисптохм в результате того, что дерево впитало в себя большое количество скверны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570245
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570245,
					"content": "Из-за чрезмерного количества скверны, скопившейся внутри, и разложения, вызванного аномалией, Харвисптохм больше не может удерживать в себе Хварну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570246
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570246,
					"content": "Единственное, что мы можем сделать сейчас, - войти в Харвисптохм, чтобы очистить её и разбудить нашу богиню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570247
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570247,
					"content": "В дерево можно войти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570248
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570248,
					"content": "Разумеется. Неужели ты думала, что обряд Чинват нужно проводить внутри пролома? Даже пари не в силах противостоять скопившейся там скверне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570249
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570249,
					"content": "Внутри Харвисптохм находится гигантский лотос, Гаокерена, в котором дремлет сознание нашей богини. Очистите его от скверны - и Цветок святости снова расцветёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570250
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570250,
					"content": "Амрита очистит землю от нечистот. Такие процессы могут показаться запутанными, но я уверена, что это вас не остановит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570251
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570251,
					"content": "Я уже отправила Рашну и Михир в пролом Туниги. Вам осталось только принести великие песни, и тогда вы сможете собрать силу Хварны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570252
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570252,
					"content": "Хварна пробудит огромные деревья, подавляющие тьму, и очистит скопившуюся в глубинах грязь. После этого можно совершить обряд Чинват и тем самым открыть путь в Харвисптохм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570253
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570253,
					"content": "Как только вы окажетесь внутри, венец поведает Соруш о великих деяниях древних героев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570254
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570254,
					"content": "В конечном итоге все воспоминания, связанные с Хварной, возвратятся к Харвисптохм. Они никогда не померкнут, независимо от того, как часто пересказываются и изменяются легенды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570255
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570255,
					"content": "Впервые слышу об этом!",
					"roleType": "TALK_ROLE_NPC",
