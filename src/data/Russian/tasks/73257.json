						732570257
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 732570257,
					"content": "А теперь, пожалуйста, идите и погасите Знамение Апаоши. Мы встретимся снова, когда с неба прольётся амрита.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зурван"
