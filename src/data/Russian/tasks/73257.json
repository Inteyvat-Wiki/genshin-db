					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570405
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 732570405,
					"content": "Неправда. Ожидание тоже важная работа. Действие, по сути, сиюминутно, в то время как ожидание непреходяще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570406
					],
					"speakerTitle": "Михир"
				},
				{
