						732570409
					],
					"speakerTitle": "Михир"
				},
				{
					"id": 732570409,
					"content": "Конечно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732570410,
					"content": "В таком случае давайте снимем печать, и вы сможете собрать силу Хварны с помощью великих песен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570411
					],
					"speakerTitle": "Михир"
				},
				{
					"id": 732570411,
					"content": "Будьте осторожны. Скверна накапливалась веками, даже не представляю, что произойдёт, когда будет снята печать.",
					"roleType": "TALK_ROLE_NPC",
