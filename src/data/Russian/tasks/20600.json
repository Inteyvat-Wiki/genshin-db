			},
			"dialogs": [
				{
					"id": 206000601,
					"content": "#Ты уже прин{M#ёс}{F#есла}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000602
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 206000602,
					"content": "Да. Вот.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000603
					]
				},
				{
					"id": 206000603,
					"content": "Дай взглянуть... Ну, сойдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000604
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 206000604,
					"content": "Давай я расскажу тебе кое-что о Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000605
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 206000605,
					"content": "Мы, Фатуи, прибыли из Заполярного дворца. Мы повинуемся приказам нашей Царицы, следуем её воле и несём эту волю всему свету.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000606
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 206000606,
					"content": "Одиннадцать сильнейших из нас были выбраны Её Величеством, чтобы стать её Предвестниками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000607
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 206000607,
					"content": "Они - не безызвестные слуги, как мы. Одиннадцать Предвестников - это серьёзные люди с высокой репутацией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000608
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 206000608,
					"content": "Если ты вступишь в Фатуи и докажешь свою силу, то, возможно, тебя изберут Предвестником.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000609
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 206000609,
					"content": "И тогда тебя ждёт головокружительная карьера...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000610
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 206000610,
					"content": "Я? Вряд ли меня изберут. Я лишь занимаюсь мелкими делами для Синьоры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000611
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 206000611,
					"content": "Ну... Если бы мне пришлось выбирать, я бы пошёл служить под началом Капитано...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				}
			]
		},
