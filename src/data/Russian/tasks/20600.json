			"dialogs": [
				{
					"id": 206000501,
					"content": "Не забудь, тебе нужен трофей с митачурла. Возвращайся, когда добудешь его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000502
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 206000502,
					"content": "Что конкретно? Добудь... Рог. Да, и возвращайся с ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				}
			]
		},
