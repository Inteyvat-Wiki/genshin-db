					"speakerTitle": "Виктор"
				},
				{
					"id": 206000702,
					"content": "Если попытаешься одурачить меня и подсунуть какой-нибудь хлам, то сделка отменяется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				}
			]
		},
