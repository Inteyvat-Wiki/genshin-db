			},
			"dialogs": [
				{
					"id": 80010101,
					"content": "Вот мы и встретились снова... Раньше, чем я ожидал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010102
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010102,
					"content": "Эй, это же Дайн!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010103,
					"content": "Судя по вашим лицам, с вами случилось что-то необычное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010104
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010104,
					"content": "Неужели в тех руинах вы встретили Вестника Бездны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010105
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010105,
					"content": "Что?! Откуда ты знаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010106,
					"content": "Я шёл по следу Вестника Бездны. Если честно, не ожидал увидеть здесь вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010107,
						80010108
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010107,
					"content": "Мы там встретили не только Вестника Бездны...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				},
				{
					"id": 80010109,
					"content": "Перевёрнутая статуя семи Архонтов... держит в руках энергию Бездны? Нет, за время своей борьбы с Бездной я такого не видел... хоть у меня и были подозрения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010110
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010110,
					"content": "Расскажите мне всё, что там произошло. Вы бежали из глубин подземелья, заполненных энергией Бездны, а что потом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010111
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010111,
					"content": "А дальше прямо перед выходом откуда ни возьмись перед нами появился Вестник Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010112,
					"content": "У нас с этим чучелом произошла эпичная битва. Может быть, оно ещё где-то рядом?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010113,
					"content": "Да, такой случай выпадает редко. Постараемся его догнать, следуйте за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010114,
						80010115
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010114,
					"content": "Хорошо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010116,
					"content": "Ну пойдём же! Это редкий шанс! Может быть, с помощью Дайна у нас получится разгадать больше тайн Бездны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010115,
					"content": "#Постой, вообще-то это я тебя нанял{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010108,
					"content": "Там было что-то необычнее, чем Вестник Бездны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				}
			]
		},
		{
			"id": 800102,
			"completionStepIds": [
				800103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800103",
							"2"
						],
						"stepId": 800103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дайнслейф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010201,
					"content": "Эти маги Бездны... Они хотели устроить нам засаду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010202,
					"content": "Нет, они просто пытались найти что-нибудь ценное в этом старом страже руин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010203
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010203,
					"content": "#Правда? Мо{F#я}{M#й} путешественни{F#ца}{M#к} тоже очень любит этим заниматься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010204,
					"content": "Собирает устройства хаоса, цепи хаоса и всё такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010205,
						80010206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010205,
					"content": "Ага, это очень важные материалы!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				},
				{
					"id": 80010207,
					"content": "Они бы не занимались поиском настолько обычных вещей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010208
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010208,
					"content": "Вообще я пришёл сюда на разведку потому, что маги Бездны часто выходят именно из этих руин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010209
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010209,
					"content": "Кажется, они осматривают останки стражей руин в поисках какой-то ценной вещи, чтобы забрать её обратно в руины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010210
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010210,
					"content": "Но по их разочарованному виду ясно, что до сих пор их поиски не дали никаких результатов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010211
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010211,
					"content": "Почему тогда ты не схватил одного из них и не выбил всю правду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010212,
						80010213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010212,
					"content": "Да, господин Дилюк так уже делал...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010214,
					"content": "Я-то уж точно не собираюсь церемониться с этими отродьями Бездны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010215
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010215,
					"content": "Но у меня есть такое чувство, что этот предмет может быть необычайно важен для всего ордена Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010216
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010216,
					"content": "Правду о нём не узнать при помощи допросов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010217
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010217,
					"content": "Точнее, для магов Бездны есть что-то намного страшнее, чем болезненный допрос...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010218,
						80010219
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010218,
					"content": "Страшнее...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010220,
					"content": "Ох... У Паймон мурашки от таких мыслей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010221,
					"content": "Ладно, не будем терять время. Давай продолжим поиски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010219,
					"content": "Что-то, что мы видели в руинах?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010213,
					"content": "Нужно быть с ними погрубее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010206,
					"content": "Вряд ли маги Бездны искали что-то подобное...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				}
			]
		},
		{
			"id": 800103,
			"completionStepIds": [
				800105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800105",
							"2"
						],
						"stepId": 800105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дайнслейф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010301,
					"content": "Ого... Кроме ордена Бездны здесь ещё и активные стражи руин водятся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010302,
					"content": "Похоже, что в каждом убежище ордена Бездны на нас обязательно нападают стражи руин. Совпадение? Не думаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010303,
					"content": "В мире не бывает совпадений. Всё происходящее - это плоды некогда посеянных семян.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010304
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010304,
					"content": "К примеру, ваше появление в таверне... Время всего-навсего ждёт, когда прорастут эти семена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010305,
						80010306
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010305,
					"content": "#Но я услышал{F#а} о тебе совершенно случайно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				},
				{
					"id": 80010307,
					"content": "Забудь. Это просто мысли вслух.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010308
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010308,
					"content": "Связь между орденом Бездны и стражами руин не может быть случайной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010309
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010309,
					"content": "Точнее, это ветви, выросшие из общих корней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010310
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010310,
					"content": "Ветки, корни... Что ты имеешь в виду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010311,
					"content": "Все они берут своё начало из древней нации Каэнри'ах, которая была уничтожена 500 лет назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010312
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010312,
					"content": "Что? Каэнри'ах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010313,
					"content": "Серьёзно?! Орден Бездны и стражи руин остались после уничтожения Каэнри'ах?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010314,
					"content": "А ведь Каэнри'ах - это такое древнее название...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010315,
					"content": "Ой, точно! Как твой проводник я должна объяснить кое-что. Давным-давно нация Каэнри'ах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010316,
					"content": "Я знаю это название.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010317
					]
				},
				{
					"id": 80010317,
					"content": "...Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010318,
					"content": "Потому что я помню о Каэнри'ах.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010319
					]
				},
				{
					"id": 80010319,
					"content": "Помнишь? Но ведь эта нация была уничтожена 500 лет назад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010320,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010321
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010321,
					"content": "#Правда? Ну, у каждого есть свои секреты. Ты не лез{F#ла} в мои, поэтому я не буду лезть в твои.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010322
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010322,
					"content": "#Но если ты захочешь поделиться, я послушаю тебя с превеликим удовольствием... Расскажи мне, какой была та Каэнри'ах, которую ты видел{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010323,
						80010324,
						80010325,
						80010362
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010323,
					"content": "(Скрывать это больше невозможно...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010326,
					"content": "Так вот как всё было... Паймон думала, что вы сначала наткнулись на неизвестное божество...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010327,
					"content": "#Ясно... Значит, твои первые воспоминания об этом мире - это то, как тебя разбудил{M#а} и вытащил{M#а} из метеорита тво{F#й брат}{M#я сестра}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010328
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010328,
					"content": "#Похоже, что {F#твой брат}{M#твоя сестра} очнул{F#ся}{M#ась} перв{F#ым}{M#ой}, но вопрос в том, насколько раньше тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010329,
					"content": "#И затем {F#твой брат}{M#твоя сестра} рассказал{M#а} тебе, что после уничтожения Каэнри'ах весь мир погрузился в хаос и что вам нужно как можно скорее покинуть этот мир, зовущийся Тейватом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010330
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010330,
					"content": "#Уничтожения Каэнри'ах? Он{M#а} так и сказал{M#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010331,
						80010332
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010331,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010333,
					"content": "Те разрушения, что вы наблюдали... Они произошли 500 лет назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010334
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010334,
					"content": "Похоже, что твоё первое пробуждение в этом мире произошло примерно в те времена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010335
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010335,
					"content": "#Хм... Наверное, на тот момент {F#твой брат}{M#твоя сестра} лучше понимал{M#а} этот мир, потому что он{M#а} проснул{F#ся}{M#ась} раньше тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010336
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010336,
					"content": "И вскоре после этого вы столкнулись с неизвестным божеством, которое не позволило вам покинуть этот мир...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010337
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010337,
					"content": "Ой, эту часть истории Паймон знает очень хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010338
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010338,
					"content": "...Я понял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010339
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010339,
					"content": "#Ты лишь очнул{F#ась}{M#ся} и сразу же попытал{F#ась}{M#ся} покинуть этот мир. Ты ничего не знал{F#а} о Каэнри'ах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010340
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010340,
					"content": "Но теперь, когда ты уже кое-что знаешь о Тейвате, ты наверняка понимаешь, что увиденная вами война - это война, уничтожившая Каэнри'ах... Не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010341
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010341,
					"content": "#А, и действительно, ты ведь прочитал{F#а} кучу книг за эти несколько месяцев, что мы путешествуем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010342
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010342,
					"content": "#До Мондштадта нам попадались только всякие непонятные записки, но затем нам удалось собрать множество древних книг по всему Мондштадту и Ли Юэ, однако ты сказал{F#а}, что все они бесполезные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010343
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010343,
					"content": "#Получается, всё это время ты пытал{F#ась}{M#ся} собрать побольше информации о Каэнри'ах, чтобы найти {F#своего брата}{M#свою сестру}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010344,
						80010345
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010344,
					"content": "Это единственная зацепка, кроме поиска семи Архонтов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010346,
					"content": "Точно... Семерых Архонтов можно отыскать в семи королевствах, но где же искать нацию, которая была уничтожена 500 лет назад?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010347
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010347,
					"content": "Пожалуй, я знаю о Каэнри'ах больше вас обоих.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010348
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010348,
					"content": "Каэнри'ах была нацией без бога. Не потому, что он умер или покинул своё королевство, а потому, что они жили без божества с самого начала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010349
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010349,
					"content": "Это была могущественная нация, построенная исключительно людьми. Необычайно прекрасная цветущая цивилизация, гордость всего человечества.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010350
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010350,
					"content": "Нация... без... бога...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010351
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010351,
					"content": "Затем случилось именно то, что ты помнишь: она была полностью уничтожена... богами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010352
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010352,
					"content": "Ты имеешь в виду, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010353
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010353,
					"content": "500 лет назад боги спустились на землю и уничтожили Каэнри'ах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010354
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010354,
					"content": "«Гордость всего человечества» была вырвана с корнем и растоптана, словно вредный сорняк в райском саду богов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010355
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010355,
					"content": "Но как такое могло произойти? В исторических книгах ничего об этом не говорится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010356,
						80010357
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010356,
					"content": "Это ужасно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010358,
					"content": "Да... Долгие разговоры о прошлом только подавляют дух.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010359,
						80010360
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010359,
					"content": "(Боюсь, в следующий раз Венти и Чжун Ли...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010361,
					"content": "Давайте двигаться вперёд. По пути я расскажу больше о том, что тебя интересует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010360,
					"content": "(...Должны будут мне кое-что объяснить.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010357,
					"content": "#Этот мир жесток и опасен... Я долж{F#на}{M#ен} поскорее отыскать {F#своего брата}{M#свою сестру}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010345,
					"content": "У нас нет ничего, кроме названия.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010332,
					"content": "#По крайне мере, я так услышал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010324,
					"content": "(Дайн и Каэнри'ах... Стоит рискнуть.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010325,
					"content": "#(Он{M#а} разбудил{M#а} меня...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010362,
					"content": "#(И море пламени, когда я {M#проснулся}{F#проснулась}...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010306,
					"content": "Я не до конца понимаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				}
			]
		},
		{
			"id": 800104,
			"completionStepIds": [
				800107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
