			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дайнслейф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010401,
					"content": "А? Этот маг Бездны обронил талисман... Может быть, это какое-то письмо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010402,
					"content": "Хм, этот талисман связан с Вестником Бездны. Но как он оказался у мага Бездны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010403
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010403,
					"content": "Возможно, в нём и правда таится информация об их операциях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010404
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010404,
					"content": "Но Паймон не может прочитать, что тут написано. Это язык Каэнри'ах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010405,
					"content": "#«...Окутайте веру врага пламенем и славьте Е{F#го}{M#ё} высочество Принц{F#а}{M#ессу}...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010406
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010406,
					"content": "Что?! Там так написано?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010407,
					"content": "«...\"Плетение судьбы\", первая операция».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010408
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010408,
					"content": "Они... Бездна, похоже, проводит какую-то массивную операцию. Ключевое слово здесь... «Плетение судьбы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010409
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010409,
					"content": "Мне кажется, что это только начало их операции, или, точнее, они проводят предварительные испытания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010410
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010410,
					"content": "«Плетение судьбы»? А что это? У них там какая-то машинка для плетения есть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010411,
						80010412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010411,
					"content": "Маг Бездны пришёл из тех руин...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				},
				{
					"id": 80010413,
					"content": "Ох, у Паймон всё это время было такое неприятное ощущение. Я супер уверена, что эти неприятные руины связаны с той плетёной операцией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010414,
					"content": "Ну так о чём говорится в этом письме, Дайн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010415,
					"content": "Секунду, дочитаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010416
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010416,
					"content": "Хм... Довольно амбициозная операция, но я не могу понять некоторые её части.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010417
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010417,
					"content": "А что там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010418,
					"content": "В общем, первая фаза плана связана с Осиалом, Архонтом Вихрей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010419
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010419,
					"content": "Архонт Вихрей! Это то водяное божество?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010420,
						80010421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010420,
					"content": "Нам не удалось уничтожить его в прошлый раз...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010422,
					"content": "Но всё же, для чего им понадобился Осиал? Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010423,
					"content": "Для того же, для чего и Двалин?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010424
					]
				},
				{
					"id": 80010424,
					"content": "Я знаю о твоих подвигах с Двалином, и я также знаю о роли ордена Бездны в деле с Ужасом Бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010425
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010425,
					"content": "#Ты угрожал{F#а} схожим планам ордена Бездны, даже не подозревая об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010426
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010426,
					"content": "В прошлый раз им нужен был старый друг Архонта, в этот раз они заинтересовались огромным древним божеством... Орден Бездны продолжает поднимать планку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010427,
					"content": "Орден Бездны планирует использовать ложь и тёмную магию на Осиале так же, как и на Двалине?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010428
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010428,
					"content": "Нет... В этом письме также описан их следующий шаг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010429
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010429,
					"content": "Они не только осквернят сознание Осиала, но и полностью трансформируют его тело с помощью древней технологии «культиваторов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010430
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010430,
					"content": "А такое вообще... возможно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010431,
					"content": "Подожди, то есть орден Бездны хочет сделать из Осиала какого-то... кибернетического бога-каракатицу массового уничтожения?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010432,
						80010433
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010432,
					"content": "Похоже на то.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010434,
					"content": "Мало кто сейчас понимает цивилизацию Каэнри'ах по-настоящему, но и точность этого понимания тяжело оценить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010435
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010435,
					"content": "Только орден Бездны не прекращая искал остатки Каэнри'ах. Они очень настойчиво пытаются найти эту человеческую цивилизацию, хоть сами они уже далеко не люди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010436
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010436,
					"content": "В письме говорится, что они собираются использовать «осквернённую статую» в качестве основы, к которой прикрепят конечности Осиала, чтобы сконструировать механическое божество.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010437
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010437,
					"content": "А новым ядром, заменяющим сферу, что держит в руках статуя Архонта, станет... глаз самого первого культиватора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010438
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010438,
					"content": "«Глаз самого первого культиватора»? ...А, Паймон поняла! Все эти маги Бездны занимаются поисками того самого особого глаза, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010439
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010439,
					"content": "Похоже, что так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010440,
						80010441
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010440,
					"content": "Они его до сих пор не нашли. У нас ещё есть время.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010442,
					"content": "Это дело становится всё запутаннее. Но всё это как-то связано с той странной статуей семи Архонтов, что мы видели, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010443
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010443,
					"content": "Да. Согласно письму, глаз должен быть установлен в руках осквернённой статуи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010444
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010444,
					"content": "И тогда родится новое божество, которое сможет «низвергнуть богов Селестии со своих тронов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010445,
						80010446
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010445,
					"content": "(Селестия...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010447,
					"content": "О нет... Орден Бездны и впрямь не собирается мелочиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010448
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010448,
					"content": "Хм... Раз уж никто не знает, где находятся эти культиваторы, то почему бы нам не взять перевёрнутую статую за отправную точку нашего расследования?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010449,
						80010450
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010449,
					"content": "Эта статуя была похожа на Анемо Архонта...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010451,
					"content": "Нашего барда-бродяжку мы так просто не найдём. Давай сначала сходим в <color=#00E1FFFF>собор</color> и постараемся там что-нибудь разузнать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010452
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010452,
					"content": "Собор... Хм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010453
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010453,
					"content": "Хм? Что-то не так, Дайн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010454
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010454,
					"content": "Ничего. Пора идти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010450,
					"content": "Может, нам стоит спросить кого-нибудь из церкви Фавония?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010446,
					"content": "(Низвергнуть богов...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010441,
					"content": "Давайте найдём глаз раньше них.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010433,
					"content": "С каждым днём их прозвища всё длиннее!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010421,
					"content": "Его всего лишь подавили Нефритовым дворцом...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010412,
					"content": "Это как-то связано с перевёрнутой статуей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				}
			]
		},
		{
			"id": 800105,
			"completionStepIds": [
				800108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800108",
							"2"
						],
						"stepId": 800108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дайнслейф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010501,
					"content": "Смотрите, снова страж руин и маги Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010502,
					"content": "Дайн, ты говорил, что эти древние механизмы родом из Каэнри'ах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010503,
					"content": "Значит ли это, что в Каэнри'ах было так много руин, которые нужно было охранять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010504,
					"content": "Нет. «Стражами руин» их назвали современные жители континента. 500 лет назад их так никто не называл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010505
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010505,
					"content": "Нынешних стражей руин жители Каэнри'ах называли культиваторами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010506
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010506,
					"content": "Культиваторами? Какое необычное название.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010507,
						80010508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010507,
					"content": "Они просто фермерское оборудование?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				},
				{
					"id": 80010509,
					"content": "Это не то, что вы подумали. «Культиваторы» всего лишь кодовое название. Народ Каэнри'ах любил давать своему оружию кодовые имена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010510
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010510,
					"content": "«Землю не возделывают инструментами - за неё сражаются сталью и кровью». Так появились культиваторы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010511
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010511,
					"content": "«Сражаются сталью и кровью?» Народ Каэнри'ах как-то странно понимал слово «культивирование»... Непохоже, что в этом есть какой-либо добрый посыл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010512,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010513
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010513,
					"content": "После уничтожения Каэнри'ах эти культиваторы потеряли своих хозяев и полностью вышли из-под контроля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010514
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010514,
					"content": "Они веками бесцельно ходили по этим землям и в итоге разбрелись по всему Тейвату.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010515
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010515,
					"content": "Может быть, скорбь других погибших цивилизаций резонировала с ними, и влекла их к руинам, где они спят по сей день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010516
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010516,
					"content": "Это звучит... так грустно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010517,
						80010518
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010517,
					"content": "500 лет бесцельных скитаний...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010520
					]
				},
				{
					"id": 80010520,
					"content": "Когда ты узнаешь побольше, все эти детали перестанут иметь значение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010521
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010521,
					"content": "Каким бы ни было их прошлое, сейчас они несут лишь угрозу. Иди и уничтожь их всех!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80010518,
					"content": "Кажется... нам нужно положить конец их страданиям.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010519
					]
				},
				{
					"id": 80010519,
					"content": "Да уж... Паймон знает, как хорошо ты над этим работаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80010508,
					"content": "Почему все они вооружены...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				}
			]
		}
	]
}