			"dialogs": [
				{
					"id": 710480201,
					"content": "#Ты {F#вернулась}{M#вернулся}! Добро пожаловать в Гильдию искателей приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480202,
						710480206,
						710480208,
						710480211
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 710480202,
					"content": "Расскажи мне о Разломе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480203
					]
				},
				{
					"id": 710480203,
					"content": "Что, хочешь узнать, что там? Ха-ха, и правда, лишняя информация никогда не помешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480204
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 710480204,
					"content": "Одни говорят, что шахтёры откопали Исполнитель желаний и загадали желание, но всё сбылось ровно наоборот. Другие говорят, что они откопали хвост Владычицы Морей... Всё это просто забавные слухи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480205
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 710480205,
					"content": "Не спрашивай меня о Разломе. Я и сама не знаю, что там произошло. Просто поговори с Му Нином. Это предписание Департамента по делам граждан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 710480206,
					"content": "Расскажи мне о поручении...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480207
					]
				},
				{
					"id": 710480207,
					"content": "Кхе-кхе... Кругом полно людей, которые связаны с Разломом. Можешь подокучать им своими вопросами, а у меня хватает забот с Гильдией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 710480208,
					"content": "Расскажи мне о Му Нине...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480209
					]
				},
				{
					"id": 710480209,
					"content": "Ну... Думаю, что Департамент по делам граждан отправил его на Разлом, чтобы он закалил характер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480210
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 710480210,
					"content": "В своём деле он разбирается, но уж больно избалован. Это не очень хорошо для государственного служащего... Я думаю, Разлом заставит его повзрослеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 710480211,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480212
					]
				},
				{
					"id": 710480212,
					"content": "К звёздам и к безднам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				}
			]
		}
	]
}