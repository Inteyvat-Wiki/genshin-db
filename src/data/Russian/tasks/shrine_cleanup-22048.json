			"dialogs": [
				{
					"id": 220480101,
					"content": "В святилище опять бардак...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480102
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220480102,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480103
					]
				},
				{
					"id": 220480103,
					"content": "Мяу, это снова ты? Ты вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480104
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220480104,
					"content": "В святилище опять бардак, повсюду листья. Смотреть больно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480105
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220480105,
					"content": "Нельзя, чтобы люди, желающие выразить своё почтение, приходили в грязное святилище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480106
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220480106,
					"content": "Можно попросить тебя прибраться в святилище, как прежде?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480107,
						220480112
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220480107,
					"content": "Разве ты не можешь попросить Тайсукэ и Эйко?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480108
					]
				},
				{
					"id": 220480108,
					"content": "Я ни за что первая не заговорю с теми людьми в зелёном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480109
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220480109,
					"content": "Тот высокий человек всегда странно на меня смотрит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480110
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220480110,
					"content": "А другой человек в зелёном никогда не выглядит особенно... заинтересованным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480111
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220480111,
					"content": "Мяу-мяу, они не очень благонадёжны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220480115,
					"content": "В этом деле я могу положиться только на тебя. Просто используй длинную палку и приберись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480116,
						220480117
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220480116,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480118,
					"content": "Как бы там ни было, я поручаю это тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480119
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220480119,
					"content": "Я буду ждать тебя здесь, мяу-мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220480117,
					"content": "Более-менее понятно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480112,
					"content": "Можно попросить господина Осиму...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480113
					]
				},
				{
					"id": 220480113,
					"content": "Человек с камнями только и занят, что своим постукиваниями. Кто знает, что он делает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480114
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220480114,
					"content": "В конце концов, он закончил с камнем. Что он там стучит на этот раз... Надоело...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "Нэко"
				}
			]
		},
