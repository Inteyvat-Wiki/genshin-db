			"dialogs": [
				{
					"id": 700890101,
					"content": "Ой, здесь кто-то есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700890102,
					"content": "Не та статуя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890103
					],
					"speakerTitle": "Маук"
				},
				{
					"id": 700890103,
					"content": "Эй, ты что делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700890104,
					"content": "Я ищу дорогу назад. Помню только, что нужно найти статую Анемо Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890105
					],
					"speakerTitle": "Маук"
				},
				{
					"id": 700890105,
					"content": "Больше я ничего не помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890106
					],
					"speakerTitle": "Маук"
				},
				{
					"id": 700890106,
					"content": "Дорогу назад?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700890107,
					"content": "Смутно чувствую тоску по дому, но ничего не помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890108
					],
					"speakerTitle": "Маук"
				},
				{
					"id": 700890108,
					"content": "Когда я очнулся, в моей руке была только записка со словами: «Ты - Маук».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890109
					],
					"speakerTitle": "Маук"
				},
				{
					"id": 700890109,
					"content": "Поэтому я думаю, что меня зовут Маук.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890110
					],
					"speakerTitle": "Маук"
				},
				{
					"id": 700890110,
					"content": "Мне пора. Пока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890111
					],
					"speakerTitle": "Маук"
				},
				{
					"id": 700890111,
					"content": "Какой странный человек. Но вроде не злой, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700890112,
					"content": "Ты как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700890113,
					"content": "#Я видел{F#а} странное видение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700890114
					]
				},
				{
					"id": 700890114,
					"content": "Странное видение? Может, это из-за того, что он дотронулся до статуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
