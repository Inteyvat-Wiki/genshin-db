			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джули"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160601,
					"content": "Хе-хе, вообще-то это довольно вкусно. Съем-ка я ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160602,
						220160606,
						220160609
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 220160602,
					"content": "Почему ты хотела принести ему еды?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160603
					]
				},
				{
					"id": 220160603,
					"content": "Ну... Я просто не хотела, чтобы он голодал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160604
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 220160604,
					"content": "Когда мы виделись в прошлый раз, он явно грустил. Я решила, что это из-за голода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160605
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 220160605,
					"content": "Поэтому я хотела принести ему поесть. Я подумала, что наевшись он не будет таким печальным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джули"
				},
				{
					"id": 220160606,
					"content": "А почему ты стала ему доверять?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160607
					]
				},
				{
					"id": 220160607,
					"content": "Это... интуиция искателя приключений. Я очень хорошо умею отличать хороших парней от плохих.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160608
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 220160608,
					"content": "Только хорошие люди отдают еду, когда сами голодны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джули"
				},
				{
					"id": 220160609,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160610
					]
				},
				{
					"id": 220160610,
					"content": "Пока. Я больше никогда не буду пропускать завтрак...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джули"
				}
			]
		},
		{
			"id": 2201607,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
