				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160801,
					"content": "Что тебя беспокоит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160802,
						220160807,
						220160814,
						220160819
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160802,
					"content": "Почему ты согласился пойти вместе с Сюй Дуном?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160803
					]
				},
				{
					"id": 220160803,
					"content": "Как сказал Сюй Дун, если я хочу хорошо питаться... работа на него в данный момент - мой лучший вариант.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160804
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160804,
					"content": "Кроме того, Джули и Сюй Дун - люди высокой морали, и для меня будет большой честью странствовать вместе с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160805
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160805,
					"content": "Парвана... вдумчивая девушка. Вполне естественно, что она относится ко мне настороженно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160806
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160806,
					"content": "Кроме того, она просто отнеслась ко мне немного подозрительно, но не стала сразу меня прогонять, а этого... этого мне достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160807,
					"content": "А ты и впрямь просто странствовал по окрестным землям?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160808
					]
				},
				{
					"id": 220160808,
					"content": "Точно. Я бы никогда не стал лгать. Я просто странствовал с тех пор, как оставил сёгунат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160809
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160809,
					"content": "Я просто набивал желудок подножным кормом. Если везло - мясом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160810
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160810,
					"content": "Иногда я помогал людям прогнать монстров или кайраги - это приносило мне хоть какие-то деньги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160811
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160811,
					"content": "Хе-хе... Человеку вроде меня, который только и умеет, что ловко махать мечом, найти подходящую вакансию не так просто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160812
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160812,
					"content": "Не говоря уже о моём прошлом - я же служил сёгунату. Люди до сих пор ассоциируют меня с кайраги, а потому найти работу еще сложнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160813
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160813,
					"content": "У меня в Инадзуме нет ни дома, ни семьи - мне некуда податься. Поэтому я просто странствовал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160814,
					"content": "Почему вы оставили сёгунат?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160815
					]
				},
				{
					"id": 220160815,
					"content": "Я просто... не мог смириться с тем, что сёгунат вытворял в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160816
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160816,
					"content": "Я всего лишь владею боевыми искусствами. Я не знаю, что хорошо для страны, а что плохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160817
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160817,
					"content": "Но я точно знал, что происходящее мне не по сердцу, а потому решил уйти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160818
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160818,
					"content": "Хе-хе. Может быть, я просто старомоден.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220160819,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160820
					]
				},
				{
					"id": 220160820,
					"content": "Прощай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камэи Мунэхиса"
				}
			]
		}
	]
