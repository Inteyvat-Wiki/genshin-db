				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Парвана"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160701,
					"content": "Не могу поверить, что эти двое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160702,
						220160705,
						220160713
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220160702,
					"content": "Ты всё еще ему не доверяешь, верно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160703
					]
				},
				{
					"id": 220160703,
					"content": "Ты про Камэи Мунэхису? Конечно же, нет... Мы встречались всего несколько раз - как я могу ему доверять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160704
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220160704,
					"content": "...Но хоть я не доверяю Камэи Мунэхисе, я полностью доверяю мнению Сюй Дуна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220160705,
					"content": "Ты из Академии?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160706
					]
				},
				{
					"id": 220160706,
					"content": "Типа того. Я занималась полевыми исследованиями в Академии, когда встретила Сюй Дуна в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160707
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220160707,
					"content": "Он собирался отправиться в экспедицию, чтобы изучать рецепты, а тема моей работы как раз была связана с кулинарией. Мы несколько раз пообщались, а потом решили путешествовать вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160708
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220160708,
					"content": "Первым делом мы отправились в Мондштадт, и там нас окружила толпа монстров. И тут появилась Джули - она помогла нам сбежать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160709
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220160709,
					"content": "Когда она узнала, что мы странствуем и изучаем разные кухни, она решила присоединиться к нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160710
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220160710,
					"content": "Она сказала, что собралась отправиться на поиски приключений, но у меня такое чувство, что ей просто захотелось поесть хорошей еды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160711
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220160711,
					"content": "Дальше мы пойдём в Сумеру. Мои исследования почти завершены и мне пора возвращаться в Академию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160712
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220160712,
					"content": "Когда мы доберемся до Сумеру, я обязательно дам им попробовать наши местные деликатесы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220160713,
					"content": "До свидания.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160714
					]
				},
				{
					"id": 220160714,
					"content": "Да... До встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Парвана"
				}
			]
		},
		{
			"id": 2201608,
