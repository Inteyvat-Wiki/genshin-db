			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джек"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250101,
					"content": "Эх... Если бы я только мог сходить и посмотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250102
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250103
					]
				},
				{
					"id": 411250103,
					"content": "Привет! Да так, ничего особенного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250104
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250104,
					"content": "Хотя нет, нечто особенное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250105,
						411250108
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250105,
					"content": "Ты имеешь в виду метеориты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250106
					]
				},
				{
					"id": 411250106,
					"content": "#Точно! Ты их тоже видел{F#а}? Последнее время с неба беспрестанно падают метеориты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250107
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250107,
					"content": "Но... Благодаря то ли покровительству Анемо Архонта, то ли удаче, ни один из них не упал в городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250113,
					"content": "Но за городом их целая куча. И говорят ещё, что если к ним прикоснуться, то впадёшь в сон, от которого не просыпаются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250114
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250114,
					"content": "Сайрус уже поручил некоторым искателям приключений найти тех, кто остался снаружи, и передать им, чтобы они укрылись в городе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250115
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250115,
					"content": "Другие отправлены помогать Ордо Фавониус устанавливать места падения метеоритов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250116
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250116,
					"content": "После этого они должны проводить поиски и оказывать пострадавшим помощь вокруг этих метеоритов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250117
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250117,
					"content": "Ну а я... Сайрус сказал, что мне лучше оставаться в городе и присматривать за спящими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250118
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250118,
					"content": "Возможно, я не так хорош, как остальные... Но мне всегда достаются мелкие задания. Мне с ними сильнее не стать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250119
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250119,
					"content": "#Эх... Ну, мне всё равно нужно выполнять, что поручено... Но, путешественн{F#ица}{M#ик}, могу ли я попросить тебя об одной услуге?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250120
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250120,
					"content": "Помоги мне собрать некоторые сведения, связанные с метеоритами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250121,
						411250126
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250121,
					"content": "Зачем тебе эти сведения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250122
					]
				},
				{
					"id": 411250122,
					"content": "Сайрус всегда говорит, что перед приключением нужно быть готовым на все сто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250123
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250123,
					"content": "Если бы я мог убедить его, что осознаю ситуацию, и все необходимые приготовления уже совершил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250124
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250124,
					"content": "Может, он позволил бы мне присоединиться к расследованиям в поле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250125
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250125,
					"content": "Но пока я ухаживаю за этими людьми и никуда пойти не могу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250133,
					"content": "#Поэтому прошу тебя, путешественн{F#ица}{M#ик}! Осмотрись в округе. Далеко ходить не надо - Шепчущего леса будет достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250134
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250134,
					"content": "Если что-нибудь найдёшь, расскажи мне. Смогу ли я выйти за городские стены и присоединиться к исследованиям, зависит от тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250126,
					"content": "Так ты хочешь выскользнуть и...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250127
					]
				},
				{
					"id": 411250127,
					"content": "Что? Ни в коем случае!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250128
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250128,
					"content": "Это правда, я хотел бы отправиться за город исследовать... Но людям здесь нужна помощь! Я не могу просто взять и бросить их...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250129
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250129,
					"content": "Ай, просто... Сайрус всегда говорит, что перед приключением нужно быть готовым на все сто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250130
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250130,
					"content": "Если бы я мог убедить его, что осознаю ситуацию, и все необходимые приготовления уже совершил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250131
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250131,
					"content": "Может, он позволил бы мне присоединиться к расследованиям в поле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250132
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250132,
					"content": "Но пока я ухаживаю за этими людьми и никуда пойти не могу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250108,
					"content": "Ты о юбилейной скидке в «Хорошем охотнике»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250109
					]
				},
				{
					"id": 411250109,
					"content": "Что?! У них скидки?! Почему я об этом узнаю только сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250110
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250110,
					"content": "Ай, нет-нет-нет... Я совсем не об этом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250111
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250111,
					"content": "#Последнее время с неба постоянно падают метеориты. Уверен, ты их уже видел{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250112
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 411250112,
					"content": "Но... Благодаря то ли покровительству Анемо Архонта, то ли удаче, ни один из них не упал в городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Джек"
				}
			]
		},
