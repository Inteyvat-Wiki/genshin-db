			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Отчаянный Паллад"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250201,
					"content": "Похоже, оторвался. Что же здесь всё-таки происходит?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250202
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 411250202,
					"content": "Ты здесь, чтобы исследовать метеориты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250203
					]
				},
				{
					"id": 411250203,
					"content": "Верно. По поручению гильдии я должен исследовать метеориты и связанные с ними происшествия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250204
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 411250204,
					"content": "Вот только чудовища рядом с упавшими метеоритами стали вести себя необычно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250205
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 411250205,
					"content": "Их сила увеличилась, движения и повадки изменились. К тому же их количество значительно возросло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250206
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 411250206,
					"content": "Они меня заметили, и я сообразил, что лучше сматываться. Я пошёл по малоизвестным тропам, чтобы от них избавиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250207
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 411250207,
					"content": "Нужно как можно быстрее рассказать обо всех этих странностях Сайрусу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250208
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 411250208,
					"content": "Что-нибудь ещё примечательное?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250209
					]
				},
				{
					"id": 411250209,
					"content": "Ещё? Ну, много кто из учёных отказывается возвращаться в город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250210
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 411250210,
					"content": "Они никак не поддавались уговорам и настаивали, что продолжат свои исследования снаружи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250211
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 411250211,
					"content": "Искателей приключений здесь немного, и оповещать их раз в несколько дней мы не можем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250212
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 411250212,
					"content": "Какой же это головняк...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250213
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 411250213,
					"content": "#Ладно, путешественн{F#ица}{M#ик}. Если это всё, лучше возвращайся в город. Сейчас снаружи делать нечего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Отчаянный Паллад"
				}
			]
		},
