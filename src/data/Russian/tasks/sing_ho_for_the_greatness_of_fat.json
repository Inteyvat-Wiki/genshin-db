			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сурики"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650701,
					"content": "Хе-хе, неплохо. Но всё же твой результат чуть хуже, чем у меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650702
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650702,
					"content": "Я всегда была полновата, но никогда не отказывалась от тренировок. Ловкостью и силой удара я намного превосхожу этих глупых качков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650703
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650703,
					"content": "Не думай о том, как бы накачать мышцы! Лучше вместе со мной спой гимн его величеству жиру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сурики"
				}
			]
		},
		{
			"id": 7516508,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516505",
							"3"
						],
						"stepId": 7516505,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516506"
						],
						"stepId": 7516506
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иллимани"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650801,
					"content": "Неплохой результат... Не хочу хвастаться, но до моего рекорда тебе далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650802
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650802,
					"content": "Понимаешь, у каждого человека есть свой конёк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650803
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650803,
					"content": "Теперь ты мне веришь? Моя комплекция ловкости не помеха! Так что ешь как следует и забудь о диетах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иллимани"
				}
			]
		},
		{
			"id": 7516509,
			"completionStepIds": [
				7516506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
