		},
		{
			"id": 7516502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516502",
							"2"
						],
						"stepId": 7516502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сурики"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650201,
					"content": "#{M#Отважный путник}{F#Отважная путница}, ты {F#пришла}{M#пришёл} к Тетеокану, чтобы обрести силу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650202
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650202,
					"content": "Возможно, тебе уже довелось увидеть сильнейших воинов Удела Благодатных Земель. Груды бесполезных мускулов, так я их называю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650203
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650203,
					"content": "#Но ты другое дело. По твоей стройной фигуре я вижу, что ты ещё не {F#превратилась в одержимую}{M#превратился в одержимого}, {F#которая}{M#которая} целыми днями пыхтит на спортивном оборудовании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650204
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650204,
					"content": "Они все обманщики, вот что я тебе скажу. Не верь им.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650205,
						751650206
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650205,
					"content": "Ты не любишь тренироваться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				},
				{
					"id": 751650207,
					"content": "Всё не так просто. Но утверждение о том, что сила воина определяется мускулами, - полнейшая чушь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650208
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650208,
					"content": "Вот что я тебе скажу, герои древности точно не были качками, у которых тело состоит из одних костей и мускулов, обтянутых кожей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650209
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650209,
					"content": "Они жили в куда более суровых условиях, чем мы сейчас. В бою они делали главную ставку на выживание и оборону. А значит, у них наверняка было достаточно жира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650210
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650210,
					"content": "Думаю, они выглядели примерно как я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650211
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650211,
					"content": "Да, герои прошлого были слегка полноваты. Такое телосложение позволяет быть одновременно сильным и ловким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650212
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650212,
					"content": "К сожалению, никто в племени этого не понимает. Глупцы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650213
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650213,
					"content": "Вижу, ты мне не веришь... Ладно, вот что.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650214
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650214,
					"content": "Попробуй пройти моё испытание и разбить все горшки! Вообще, это моя площадка для тренировок, но я не возражаю, если ты тоже ей воспользуешься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650215
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650215,
					"content": "#Попробуй, тогда сам{F#а} поймёшь, что толстякам в реальном бою намного проще!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650206,
					"content": "Ты не любишь мускулы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				}
			]
		},
		{
			"id": 7516503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516507",
							"2"
						],
						"stepId": 7516507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сурики"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650301,
					"content": "Мне нужно время, чтобы подготовиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650302
					]
				},
				{
					"id": 751650302,
					"content": "#Конечно. Как будешь готов{F#а}, возвращайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сурики"
				}
			]
		},
		{
			"id": 7516504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516504",
							"2"
						],
						"stepId": 7516504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иллимани"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "#{M#Отважный путник}{F#Отважная путница}! Да, да, ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650402,
					"content": "Кожа да кости... Ты вообще когда-нибудь ешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650406,
					"content": "Но у меня всю еду съедает Паймон, мой проводник.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "Что бы ни случилось, какие бы невзгоды ни обрушились на вас, вы ни в коем случае не должны забывать о еде!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650408,
					"content": "Раз вы пришли в Тетеокан, наверняка уже видели воинов Удела Благодатных Земель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650409,
					"content": "Хочу дать тебе один совет, от чистого сердца: не верь людям, которые только и думают, как бы накачать мышцы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650410,
					"content": "Мы должны ценить жир, которым наделил нас Архонт. Неужели мускулы стоят того, чтобы отказываться от вкусной еды и сбрасывать жир...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650411,
					"content": "Глупейшая идея на свете. Даже лесные кабаны сочувствуют таким глупцам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650412,
					"content": "И вообще, если говорить о красоте, то одержимость мускулами вошла в моду всего пару десятилетий назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650413,
					"content": "Мой дедушка говорил, что во времена его молодости людям нравилась полнота.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650414,
					"content": "Так что не позволяй себя одурачить и не начинай худеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650415,
					"content": "Но если однажды ты решишь сбросить вес ради обретения силы, как мои родственники из Удела Благодатных Земель...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650416,
					"content": "Запомни вот что: полные воины тоже могут быть ловкими и проворными, словно рыбы. А вот в силе эти тощие заморыши с нами тягаться не могут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650417,
					"content": "Если хочешь доказательств, взгляни на горшки на этой тренировочной площадке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650418,
					"content": "С моим телосложением я могу <color=#00E1FFFF>быстро добраться до финиша, не разбив ни единого горшка</color>. Думаю, тощим мешкам с костями такая ловкость даже не снилась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650419,
					"content": "Вижу, тебе смешно? Что ж... Было сразу ясно, что ты мне не поверишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650420,
					"content": "Давай, попробуй! Доберись до финиша так быстро, как только можешь, <color=#00E1FFFF>не разбив ни одного горшка</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650421,
					"content": "Посмотрим, как у тебя получится! Сможешь ли ты побить мой рекорд?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650404,
					"content": "Э... Хочешь угостить меня ужином?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "#Нет, я говорю о другом... Если ты действительно {F#голодна}{M#голоден}, у меня в сумке есть немного жареного мяса. Но об этом после...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Иллимани"
				}
			]
		},
		{
			"id": 7516505,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
