							10136.43
						],
						"pointId": 11221
					}
				]
			},
			"dialogs": [
				{
					"id": 751650901,
					"content": "Иллимани, ты ещё поправился! Поздравляю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650902
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650902,
					"content": "Ха-ха, спасибо тебе, Сурики!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650903
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650903,
					"content": "Кстати, хорошие новости! Я убедил очередного задохлика бросить свою диету!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650904
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650904,
					"content": "Ого! Отлично, молодец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650905
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650905,
					"content": "Привет! А у тебя как дела, ты хорошо питаешься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650906,
						751650908
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650906,
					"content": "Да, просто замечательно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650907
					]
				},
				{
					"id": 751650907,
					"content": "Вот это правильно! Чтобы нарастить побольше жирка, надо хорошо питаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650910,
					"content": "#Кстати, Иллимани! {F#Эта девушка взялась}{M#Этот юноша взялся} за испытание с горшками и едва не побил{F#а} мой рекорд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650911
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650911,
					"content": "#Да, и у меня {M#он}{F#она} {M#прошёл}{F#прошла} испытание с отличным результатом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650912
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650912,
					"content": "#Ого, здорово! Кто бы мог подумать, что ты {M#такой ловкий}{F#такая ловкая}! Почти как мы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650913
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650913,
					"content": "#Думаю, он{F#а} сможет нас обогнать, если наберёт ещё немного веса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650914
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650914,
					"content": "#Да, вполне возможно. По-моему, тебе стоит подкопить ещё жирка, слишком ты {F#худенькая}{M#худенький}. И всё равно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650915
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650915,
					"content": "Я считаю, ты молодец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650916
					],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650916,
					"content": "И я так считаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650917
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650917,
					"content": "Только не забывай есть побольше, мой тебе совет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650918
					],
					"speakerTitle": "Иллимани"
				},
				{
					"id": 751650918,
					"content": "Никаких диет, никаких уменьшенных порций. Иначе мы в тебе разочаруемся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сурики"
				},
				{
					"id": 751650908,
					"content": "Не очень.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650909
					]
				},
				{
					"id": 751650909,
					"content": "Плохо! Самое главное в жизни - хорошо питаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "Сурики"
				}
			]
		},
