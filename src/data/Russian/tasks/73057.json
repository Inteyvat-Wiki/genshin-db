					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570302
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570302,
					"content": "Здесь я и живу, располагайтесь!",
					"roleType": "TALK_ROLE_NPC",
