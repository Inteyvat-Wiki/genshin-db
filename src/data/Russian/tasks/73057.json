				"objectNames": [
					"Аранакин",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570501,
					"content": "Тоже утварь нар... Как она называется? Аранакину не нужен сон, поэтому я не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570502
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570502,
					"content": "«Кровать», выглядит как новая... На ней кто-то спал раньше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570503,
					"content": "Хи-хи, Аранакин за ней ухаживал... Если хотите, ложитесь, вам можно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранакин"
				}
			]
		},
		{
			"id": 7305706,
			"completionStepIds": [
				7305714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305714",
							"2"
						],
						"stepId": 7305714,
						"stateName": "QUEST_STATE_UNFINISHED"
