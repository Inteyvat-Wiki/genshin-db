			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570101,
					"content": "Ну вот, исчез... Правильно, он ведь не помнит наших приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570102,
						730570103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570102,
					"content": "Не расстраивайся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570104
					]
				},
				{
					"id": 730570104,
					"content": "#Да, ты прав{F#а}... Прав{F#а}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570105,
					"content": "Помнишь, в прошлый раз Аранакин научил нас одной мелодии? Давай сыграем, вдруг он нас узнает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570106,
						730570108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570106,
					"content": "Дело говоришь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570107
					]
				},
				{
					"id": 730570107,
					"content": "Хи-хи, потому что это Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570108,
					"content": "Хоть одна разумная мысль...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570109
					]
				},
				{
					"id": 730570109,
					"content": "Эй! Паймон такого не заслужила!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570103,
					"content": "Мы можем подружиться снова.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570110
					]
				}
			]
		},
		{
			"id": 7305702,
			"completionStepIds": [
				7305707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305707",
							"2"
						],
						"stepId": 7305707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Аранакин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570201,
					"content": "Ха-ха, пришёл! Привет, малявочка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570202,
					"content": "Аранакин не малявочка! Белая леталка - вот настоящая малявочка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570203
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570203,
					"content": "Золотой песок... Нары, откуда вы знаете эту мелодию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570204
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570204,
					"content": "Гм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570205,
						730570207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570205,
					"content": "Ты сам нас научил.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570206
					]
				},
				{
					"id": 730570206,
					"content": "Да, во время нашего прошлого приключения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570209,
					"content": "Вот оно что... Гм, Аранакин не очень умён, но вы вроде бы не похожи на «плохих песочников».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570210
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570210,
					"content": "Да! «Плохие песочники» - это валука, плохие нары. А мы - хорошие нары! Ты сам нам сказал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570211,
					"content": "Ого! Я и это вам говорил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570212
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570212,
					"content": "#Ха-ха, да! {NICKNAME}, давай расскажем ему о наших приключениях?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570213,
					"content": "Вы рассказываете Аранакину о ваших приключениях и о том, как обуздали зону Увядания.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730570214
					]
				},
				{
					"id": 730570214,
					"content": "Вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570215
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570215,
					"content": "Аранакин не очень умён, но, кажется, вы говорите правду. Аранакин ничего не помнит, простите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570216
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570216,
					"content": "Тебе не за что просить прощения! Да, забывать - очень даже нормально! И вообще, мы ведь можем подружиться снова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570217,
						730570218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570217,
					"content": "Аранакин - умница.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570220
					]
				},
				{
					"id": 730570220,
					"content": "Ох... Раз мы друзья, следуйте за мной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570221
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570221,
					"content": "А? Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570222,
					"content": "#{M#Золотой}{F#Золотая} нара, белая леталка! Я приглашаю вас в своё жилище! Идём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570218,
					"content": "Паймон - умница.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570219
					]
				},
				{
					"id": 730570219,
					"content": "Хи-хи, само собой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570207,
					"content": "#Я сыграл{F#а} её, чтобы увидеться с тобой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570208
					]
				},
				{
					"id": 730570208,
					"content": "#Хи-хи, как тебе исполнение? {NICKNAME} помнит партитуру, которой ты нас научил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "Паймон"
				}
			]
		},
