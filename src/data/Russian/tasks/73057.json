				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аранакин",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570601,
					"content": "А наверху есть ещё листы, которые оставили нары, но... Я не понимаю, не могу прочесть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570602
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570602,
					"content": "Там... Листы, на которых нары оставляли свою память. Нары покрывали листы записями, а потом собирали их вместе. Но Аранакин не понимает письмена нар...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570606
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570606,
					"content": "Ты про... «Записную книжку»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570603,
					"content": "«Записная книжка»?.. Книга, куда нары записывают свою память?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570604
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570604,
					"content": "Гм, да... Аранакин не возражает, если мы поднимемся наверх и вместе посмотрим, что там написано?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570605,
					"content": "Я? Не возражаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранакин"
				}
			]
		},
		{
			"id": 7305707,
			"completionStepIds": [
				7305706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305706",
							"2"
						],
						"stepId": 7305706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аранакин",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570701,
					"content": "Что там написано? О чём вы читаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570702
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570702,
					"content": "Судя по всему, хозяин этой записной книжки был с тобой знаком.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570703
					]
				},
				{
					"id": 730570703,
					"content": "Вот оно что... Я ничего не помню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570704
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570704,
					"content": "Здесь написано... Что он больше не может тебя увидеть, потому что уже взрослый...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570705,
					"content": "Ох... Быть взрослым - очень грустно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570706,
					"content": "Да, а ещё он пишет... Что дарит этот цветок тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570707,
					"content": "Вот.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570708
					]
				},
				{
					"id": 730570708,
					"content": "А?.. Ничего себе! Это же очень важный цветок! Откуда ты... Откуда он у него?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570709
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570709,
					"content": "А ведь однажды ты подарил нам точно такой же цветок... Просто ничего не помнишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570710,
					"content": "Вот как?.. Мы можем снова стать друзьями. Но... Но хозяина записной книжки я совсем не помню, не помню даже, как он выглядел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570711
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570711,
					"content": "Ничего, ничего страшного!.. Не расстраивайся, зато у нас есть этот цветок! Он поможет тебе вспомнить, вот увидишь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730570712,
					"content": "Да, белая леталка права.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570713
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570713,
					"content": "Я возьму цветок себе, Мотийима наверняка знает, как его разбудить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570714
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570714,
					"content": "#Гм... Нара {NICKNAME}, белая леталка, я пойду к Аранаге и посажу цветок в землю, послушаю его песню. Приходите к нам, как будет свободная минутка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570715
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570715,
					"content": "Да, обязательно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
