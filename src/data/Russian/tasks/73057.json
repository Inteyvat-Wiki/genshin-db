					"Аранакин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570401,
					"content": "Это инструмент, на котором играют нары, Аранакин всё это время хранил его. Наверное, он уже разучился петь... Все струны расстроены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570402
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730570402,
					"content": "(Старинный уд, кое-где на нём виднеются аккуратно залатанные трещины, видно, что инструмент хранили очень бережно)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранакин"
				}
			]
		},
		{
			"id": 7305705,
			"completionStepIds": [
				7305713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305713",
							"2"
						],
						"stepId": 7305713,
