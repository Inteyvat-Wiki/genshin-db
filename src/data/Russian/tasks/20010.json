			},
			"dialogs": [
				{
					"id": 200100601,
					"content": "Olah! Muhe mimi, nye, eh... mosi aba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100602
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200100602,
					"content": "Yo mimi beru si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100603
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 200100603,
					"content": "Buka... mita nye, guru-guru... yo mosi ka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100604
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200100604,
					"content": "Ya odomu, Todo yo, buka guru-guru nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100605
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 200100605,
					"content": "Mi? Dada! Valo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100606
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200100606,
					"content": "Valo, ya odomu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100607
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 200100607,
					"content": "Ха-ха! Посмотри на него. Он такой счастливый!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100608
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200100608,
					"content": "Похоже, что я делаю успехи в хиличурлском.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элла Маск"
				}
			]
		},
		{
			"id": 2001007,
			"completionStepIds": [
				2001015
			],
