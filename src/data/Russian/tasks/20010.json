						"stepId": 2001003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Элла Маск"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200100201,
					"content": "Смотри! Вон тот хиличурл не спит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100202
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200100202,
					"content": "Пойдём поздороваемся с ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100203
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200100203,
					"content": "Осторожно, не разбуди других хиличурлов. Это невежливо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100204
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200100204,
					"content": "Нельзя допустить, чтобы они подумали, что мы агрессивно настроены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100205
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200100205,
					"content": "А то мы точно не сможем с ними поговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элла Маск"
				}
			]
		},
		{
			"id": 2001003,
			"completionStepIds": [
				2001004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
