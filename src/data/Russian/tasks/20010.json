					"Элла Маск"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200100401,
					"content": "#Хорошо, что ты был{F#а} рядом. Боюсь представить, что бы они со мной сделали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100402
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200100402,
					"content": "Вроде бы я всё сказала правильно... Может быть, дело в моём произношении?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100403
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200100403,
					"content": "Наверное, стоит пока поучиться по книжкам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элла Маск"
				}
			]
		},
