				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200100701,
					"content": "Как тебе такое? Мой разговорный хиличурлский стал лучше, да? Теперь, когда мы можем с ними общаться, взаимопонимание всего лишь вопрос времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100702
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200100702,
					"content": "У меня есть одна мечта... Я надеюсь, что настанет день, когда люди и хиличурлы будут обладать равными правами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100703
