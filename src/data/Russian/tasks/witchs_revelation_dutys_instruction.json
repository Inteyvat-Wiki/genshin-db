			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Барбелот"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746930101,
					"content": "Правда не можешь сделать копию рубашки для этой колоды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930102
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930102,
					"content": "Прошу прощения, но не могу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930103
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930103,
					"content": "Но она такая красивая! Может, договоримся?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930104
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930104,
					"content": "Нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930105
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930105,
					"content": "Понятно. Чтобы получить карты с красивой рубашкой и играть сильными картами, нужно заплатить определённую цену. Понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930106,
						746930107,
						746930108
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930106,
					"content": "Думаю, ты вообще ничего не понял.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930109,
					"content": "Эй! Ты же не знаешь, зачем Сайно здесь! Может, он пришёл, чтобы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746930110,
					"content": "Точно. Хорошие друзья всегда на одной волне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930111
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930111,
					"content": "Да ладно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746930112,
					"content": "В Фонтейне, проходит небольшая встреча игроков в карточные игры. Я слышал, что участники получают в подарок эксклюзивные держатели карт, выпущенные специально по случаю мероприятия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930113
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930113,
					"content": "У меня нет срочных дел в Академии, поэтому я здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930114
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930114,
					"content": "Да даже если бы и были важные дела, ты бы нашёл способ сделать их не такими уж важными...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746930115,
					"content": "Да, я работал сверхурочно всего две недели и практически разобрался со всеми делами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930116
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930116,
					"content": "Сетос тоже помогал. Он отлично справляется с бумажной работой. Я обещал принести ему чехол с картами в благодарность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930117
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930117,
					"content": "Генерал махаматра, ты будешь тянуть карту или нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930118
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930118,
					"content": "Разумеется, буду. Ты сказала, что эта карта может предсказать моё будущее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930119
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930119,
					"content": "Строго говоря, не совсем верно. Но если понимать именно так, то в этом нет ничего плохого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930120
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930120,
					"content": "Понятно... Это как та фраза из «Мастера поединков»... «Доверь свою судьбу следующей карте, которую ты вытащишь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930121
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930121,
					"content": "Итак, моя очередь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930122
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930122,
					"content": "Сайно делает глубокий вдох, принимает эффектную позу и тянет карту...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746930123
					]
				},
				{
					"id": 746930123,
					"content": "Перевёрнутая «Умеренность»... Неудивительно, что именно ты, генерал махаматра Академии Сумеру, вытянул её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930124
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930124,
					"content": "Ты слышала о Сайно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930125
					]
				},
				{
					"id": 746930125,
					"content": "Алиса несколько раз упоминала его. Ей кажется забавным, что в такой чопорной и старомодной Академии есть генерал махаматра с развитым чувством юмора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930126
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930126,
					"content": "Поблагодари её от меня. Я вытянул карту, что делать дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930127
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930127,
					"content": "Это перевёрнутая «Умеренность», или, иначе говоря, перевёрнутое «Искусство», я бы посоветовала тебе на время оставаться в состоянии бездействия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930128
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930128,
					"content": "Ты поступил опрометчиво и едва не поскользнулся на узком мосту судьбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930129
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930129,
					"content": "Это потому, что я слишком много играю в карты? Сетос и Тигнари говорили мне то же самое, поэтому я пересмотрел свой график.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930130
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930130,
					"content": "...Я говорю не о карточных играх. Я говорю о рабочем времени. Наверняка «Священный призыв семерых» не единственное, что требует полного внимания генерала махаматры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930131
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930131,
					"content": "Мои обязанности не оставляют мне особого простора для манёвра...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930132
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930132,
					"content": "Ты привык нести ответственность за свои действия в одиночку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930133
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930133,
					"content": "Есть и другие матры. Мы распределяем нагрузку между собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930134
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930134,
					"content": "Но все они рассчитывают на тебя. Не только матры, но и учёные Академии, народ Сумеру... многие полагаются на генерала махаматру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930135
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930135,
					"content": "Они об этом не говорят. Возможно, сами даже не осознают... Зачем им это, когда они все так очарованы твоим чувством юмора?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930136
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930136,
					"content": "Но ты чувствуешь их взгляды, устремлённые на тебя днём и ночью... О, и ещё тень, странствующая вместе с тобой, - это тоже часть бремени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930137
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930138
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930138,
					"content": "Ты привык идти впереди всех, нести на себе чужие тяготы... Думаю, именно в этом и заключается причина твоего душевного дисбаланса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930139
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930139,
					"content": "У меня много друзей, а ещё есть «Священный призыв семерых».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930140
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930140,
					"content": "Ты не собираешься отдыхать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930141
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930141,
					"content": "Время для отдыха ещё не пришло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930142
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930142,
					"content": "Действительно. Для такого, как ты, если постоянно происходит внутренняя борьба, то даже смерть не положит конец исполнению долга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930143
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930143,
					"content": "Прими этот Лунный аркан. Возможно, он приведёт тебя к тому, что вернёт тебе душевное равновесие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930144
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930144,
					"content": "Когда это произойдёт, борьба внутри тебя тоже должна подойти к решающему завершению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930145,
						746930146
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930145,
					"content": "Сайно не проиграет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930147,
					"content": "#Спасибо, {NICKNAME}, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930148
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930148,
					"content": "Благодарю вас. Я заберу эту карту. Обещаю, что не отнесу её в крепость Меропид.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930149
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930149,
					"content": "...А? Что за бред? Подожди, неужели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930150,
						746930151,
						746930152
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746930150,
					"content": "Опять?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930153,
					"content": "...Какое отношение это имеет к крепости Меропид?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930154
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746930154,
					"content": "Потому что это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930155
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930155,
					"content": "Аркан побега из тюрьмы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайно"
				},
				{
					"id": 746930151,
					"content": "Он придумал ещё одну.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930152,
					"content": "Барбелот, пожалуйста, не...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930146,
					"content": "Сайно самый сильный.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930107,
					"content": "Я тоже...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930108,
					"content": "Ты пришёл сюда сыграть в карты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				}
			]
		},
		{
			"id": 7469302,
			"completionStepIds": [
