			"dialogs": [
				{
					"id": 710330801,
					"content": "Эм... Придумал. Загадка готова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 710330901,
					"content": "Ну, загадки на фонариках готовы. Давай вернёмся в деревню Цинцэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330902
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 710330902,
					"content": "Пойдём туда, и я повторю тебе загадку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цин Чжоу"
				}
			]
		},
		{
