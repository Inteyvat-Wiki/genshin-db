				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бабуля Жо Синь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331201,
					"content": "Хм? Тебе что-то нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331202
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 710331202,
					"content": "Насчёт состязания Цин Чжоу и Вермеера...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331203
					]
				},
				{
					"id": 710331203,
					"content": "А, эти двое? За них переживать нечего. А ещё они с детьми играют, что вообще замечательно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331204
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 710331204,
					"content": "Сейчас большой праздник, и немного оживления не помешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331205
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 710331205,
					"content": "#А вот ты, внуч{F#енька}{M#ок}. Вижу, в Цинцэ у тебя полно забот. Ты, наверное, устал{F#а}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331206,
						710331207
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 710331206,
					"content": "Ничего, мне не привыкать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				},
				{
					"id": 710331208,
					"content": "Золотое у тебя сердце... Спасибо тебе за всё. Вот, возьми. Хорошего тебе праздника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331209
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 710331209,
					"content": "Надеюсь, последующие Праздники морских фонарей будут здесь такими же весёлыми...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 710331207,
					"content": "Что вы, не стоит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				}
			]
		},
		{
