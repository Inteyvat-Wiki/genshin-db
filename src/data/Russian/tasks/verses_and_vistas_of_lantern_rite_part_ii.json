			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вермеер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330101,
					"content": "#Путешественни{F#ца}{M#к}, путешественни{F#ца}{M#к}, прошу, подойди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330102
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330102,
					"content": "Ты тот художник, который бросил вызов Цин Чжоу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330103
					]
				},
				{
					"id": 710330103,
					"content": "Он самый. Мы с тем поэтом договорились создать работы, которые запечатлели бы Праздник морских фонарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330104
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330104,
					"content": "#Ты помог{F#ла} мне добыть материалы, помнишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330105,
						710330106
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330105,
					"content": "Помню...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				},
				{
					"id": 710330107,
					"content": "Моя картина... Кхм. Ах, да... Я уже нарисовал множество пейзажей, людей и животных...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330108
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330108,
					"content": "Мне кажется, что все они по-своему удачны... Но ни на одной из них не запечатлена суть Праздника морских фонарей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330109
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330109,
					"content": "Эх... Я лишился сна и аппетита, израсходовал все свои холсты и краски, но нарисовать такую картину не смог.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330110
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330110,
					"content": "Поэтому я хотел бы найти того поэта и посмотреть, как он сочиняет стихи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330111
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330111,
					"content": "#Путешественни{F#ца}{M#к}, знаешь ли ты, куда он ушёл?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330112
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330112,
					"content": "Он сейчас в деревне Цинцэ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330113
					]
				},
				{
					"id": 710330113,
					"content": "Деревня Цинцэ? Зачем она ему?.. Неужели он нашёл там источник вдохновения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330114
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330114,
					"content": "#Скорее, путешественни{F#ца}{M#к}, нас ждёт деревня Цинцэ! Если всё сложится, может быть, немного вдохновения найду и я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330115
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330115,
					"content": "Кхм. Словом, в путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330106,
					"content": "Насчёт твоей картины...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				}
			]
		},
		{
			"id": 7103303,
			"completionStepIds": [
				7103303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103303",
							"2"
						],
						"stepId": 7103303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вермеер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330301,
					"content": "А это, значит, деревня Цинцэ... И где наш поэт? Куда его занесли поиски вдохновения теперь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330302
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330302,
					"content": "#Последний раз, когда я его видел{F#а}, он играл с детьми в загадки на фонарях...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330303
					]
				},
				{
					"id": 710330303,
					"content": "Загадки на фонарях? Что всё это значит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330304
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330304,
					"content": "Может быть, он не нашёл вдохновения и сдался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330305
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330305,
					"content": "Впрочем, неважно, что у него там. Праздник морских фонарей скоро закончится, и больше медлить нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330306
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330306,
					"content": "Спросим у того, кто здесь главный. Нам предстоит определить победителя не позднее, чем сегодня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вермеер"
				}
			]
		},
		{
			"id": 7103304,
			"completionStepIds": [
				7103304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103304",
							"2"
						],
						"stepId": 7103304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бабуля Жо Синь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330401,
					"content": "#Ой, здравствуй, путешественни{F#ца}{M#к}. Благодаря тебе деревня Цинцэ наполнилась праздничным весельем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330402
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 710330402,
					"content": "О, новое лицо. Кто это с тобой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330403
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 710330403,
					"content": "Это художник. Он ищет Цин Чжоу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330404
					]
				},
				{
					"id": 710330404,
					"content": "Ищет Цин Чжоу? Хм, так уж получилось, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330405
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 710330405,
					"content": "Несколько дней назад Ван Я ушла, а Цин Чжоу предпочёл ещё ненадолго остаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330406
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 710330406,
					"content": "Сейчас он, должно быть, загадывает детям загадки на фонариках. Насколько я помню, он вместе с детьми прогуливается в окрестностях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330407
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 710330407,
					"content": "Вы наверняка найдёте его недалеко от деревни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330408
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 710330408,
					"content": "#Он и правда затеял игру с загадками на фонариках... Путешественни{F#ца}{M#к}, ты мне поможешь с этим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330409
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330409,
					"content": "Скажи тому поэту, что я пришёл. А я пока тут подготовлюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330410
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 710330410,
					"content": "Сегодня мы увидим победителя во что бы то ни стало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вермеер"
				}
			]
		},
		{
			"id": 7103305,
			"completionStepIds": [
				7103305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103305",
							"2"
						],
						"stepId": 7103305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цин Чжоу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330501,
					"content": "Ха-ха-ха, у вас уже неплохо получается. Вы отгадываете всё быстрее и быстрее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330502,
						710330503
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 710330502,
					"content": "Вермеер пришёл.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				},
				{
					"id": 710330504,
					"content": "Вермеер... Ах, да, художник. Судя по тому, сколько прошло времени, условленный день - сегодня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330505
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 710330505,
					"content": "К сожалению, мой стих ещё не готов, а дети ещё не отгадали всех загадок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330506
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 710330506,
					"content": "Хе-хе, наверное, это и есть предел моего поэтического таланта... Может, отправимся вместе на поиски вдохновения вновь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330507
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 710330507,
					"content": "Хм... Да и не «на поиски вдохновения», а просто прогуляемся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330508
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 710330508,
					"content": "Дядя Цин Чжоу! Загадок больше не будет? Я хотел поразгадывать ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330509
					],
					"speakerTitle": "Маленький Цзо"
				},
				{
					"id": 710330509,
					"content": "Я тоже хочу загадок, дядя Цин Чжоу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330510
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 710330510,
					"content": "Ну, я тоже хочу попробовать разгадать парочку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330511
					],
					"speakerTitle": "Маленькая Ю"
				},
				{
					"id": 710330511,
					"content": "#Ха-ха-ха, всему своё время. А сейчас мне нужно пройтись с наш{F#ей}{M#им} добр{F#ой}{M#ым} путешественни{F#цей}{M#ком}. Скоро я вернусь и принесу новых загадок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330512
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 710330512,
					"content": "Вы пока возвращайтесь в деревню Цинцэ, а мы вас потом разыщем, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330513
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 710330513,
					"content": "Ладно! Какой дядя Цин Чжоу молодец, столько загадок придумал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330514
					],
					"speakerTitle": "Маленький Цзо"
				},
				{
					"id": 710330514,
					"content": "Дядя Цин Чжоу точно прочёл целую гору книг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330515
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 710330515,
					"content": "Вот бы мне стать такой же, как он...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330516
					],
					"speakerTitle": "Маленькая Ю"
				},
				{
					"id": 710330516,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330517
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 710330517,
					"content": "#Путешественни{F#ца}{M#к}, давай поскорее всё уладим, не то детишки сгорят от нетерпения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 710330503,
					"content": "Ты не забыл о вашем соревновании с Вермеером?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				}
			]
		},
