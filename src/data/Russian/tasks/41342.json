			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Здоровяк Ван"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413421202,
					"content": "Отлично. Большое спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421203
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413421203,
					"content": "Ещё осталась пара мелочей... Если тебя не затруднит, сходи, пожалуйста, в порт и посчитай, сколько прибыло материалов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421204
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413421204,
					"content": "Всего в порту должно быть три ящика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421205
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413421205,
					"content": "Хорошо, сделаем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421206
					]
				},
				{
					"id": 413421206,
					"content": "Спасибо. Мне нужно поскорее закончить с работой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Здоровяк Ван"
				}
			]
		},
