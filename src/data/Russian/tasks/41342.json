			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Молот Ли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420602,
					"content": "Этот фонарь - подарок ему от Сы Юй, так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420603,
						413420604
					],
					"speakerTitle": "Молот Ли"
				},
				{
					"id": 413420603,
					"content": "Ты что, подслушивал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				},
				{
					"id": 413420605,
					"content": "Просто я хорошо его знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420606
					],
					"speakerTitle": "Молот Ли"
				},
				{
					"id": 413420606,
					"content": "В том году было то же самое: вышел он как-то, а когда вернулся, всю ночь борт одного из кораблей гвоздевал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420607
					],
					"speakerTitle": "Молот Ли"
				},
				{
					"id": 413420607,
					"content": "Я знаю, в чём дело, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420608
					],
					"speakerTitle": "Молот Ли"
				},
				{
					"id": 413420608,
					"content": "#Путешественни{F#ца}{M#к}, пожалуйста, помоги ему. Сейчас такой праздник, и мне больно смотреть, как он мучается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420609
					],
