				"points": []
			},
			"dialogs": [
				{
					"id": 413420401,
					"content": "#А? Ты ко мне по делу, путешественни{F#ца}{M#к}? Я сейчас занят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420402
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413420402,
					"content": "Вот небесный фонарь от Сы Юй...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4134205,
			"completionStepIds": [
				4134205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134205",
							"2"
						],
						"stepId": 4134205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Здоровяк Ван"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420501,
					"content": "Сы Юй? Она... Она хочет подарить мне небесный фонарь? Д-дай посмотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420502
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413420502,
					"content": "Ха-ха-ха, она даже желание написала. Я с детства мечтал, чтобы оно сбылось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420503
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413420503,
					"content": "Я глазом моргнуть не успел, как прошло столько лет. Как же быстро летит время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420504
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413420504,
					"content": "Как так получилось, что она поручила принести небесный фонарь тебе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420505,
						413420506
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413420505,
					"content": "У неё полно домашней работы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				},
				{
					"id": 413420507,
					"content": "О, вот как... Ладно, ладно. Очень хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420508
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413420508,
					"content": "У неё наверняка всё в полном порядке. Вот и славно... Ха-ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420509
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413420509,
					"content": "Да, просто отлично... Прости, у меня ещё много работы. Мне пора...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413420506,
					"content": "Ей нужно было вернуться домой помогать мужу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				}
			]
		},
		{
			"id": 4134206,
			"completionStepIds": [
				4134206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
