			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сы Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420101,
					"content": "Всё-таки стоило бы подарить ему небесный фонарь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420102
					],
					"speakerTitle": "Сы Юй"
				},
				{
					"id": 413420102,
					"content": "Кому?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420103
					]
				},
				{
					"id": 413420103,
					"content": "#Ах, это ты, путешественни{F#ца}{M#к}. Дело в том, что Здоровяк Ван всегда заботился обо мне. Он во всём помогает мне и сейчас. Он мне почти как брат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420104
					],
					"speakerTitle": "Сы Юй"
				},
				{
					"id": 413420104,
					"content": "Но сейчас праздник, а он работает не покладая рук...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420105
					],
					"speakerTitle": "Сы Юй"
				},
				{
					"id": 413420105,
					"content": "Точно, подарю-ка я ему небесный фонарь, хе-хе! Мы дружим с самого детства, и ему всегда нравилось на них смотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420106
					],
					"speakerTitle": "Сы Юй"
				},
				{
					"id": 413420106,
					"content": "#Вот он обрадуется, когда получит его! Путешественни{F#ца}{M#к}, не мог{F#ла} бы ты отнести ему небесный фонарь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420107,
						413420108
					],
					"speakerTitle": "Сы Юй"
				},
				{
					"id": 413420107,
					"content": "А почему ты не подаришь его сама?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				},
				{
					"id": 413420109,
					"content": "Я и хотела бы, вот только дома дел невпроворот...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420110
					],
					"speakerTitle": "Сы Юй"
				},
				{
					"id": 413420110,
					"content": "Я только за покупками вышла, и мне скорее нужно вернуться, потому что оставлять мужа наедине со всеми домашними заботами не годится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420111
					],
					"speakerTitle": "Сы Юй"
				},
				{
					"id": 413420111,
					"content": "Поэтому мне помощь с доставкой фонарика и нужна. А когда появится свободное время, мы с мужем вместе проведаем Здоровяка Вана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420112
					],
					"speakerTitle": "Сы Юй"
				},
				{
					"id": 413420112,
					"content": "Надеюсь, тогда и он сам найдёт время передохнуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сы Юй"
				},
				{
					"id": 413420108,
					"content": "Будет лучше, если это сделаешь ты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				}
			]
		},
		{
			"id": 4134202,
			"completionStepIds": [
				4134202
			],
