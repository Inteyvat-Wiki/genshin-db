					]
				},
				{
					"id": 413420610,
					"content": "Ах... Спасибо тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420611
					],
					"speakerTitle": "Молот Ли"
				},
				{
					"id": 413420611,
					"content": "Поспеши, он вот-вот должен подняться на корабль работать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420612
					],
					"speakerTitle": "Молот Ли"
				},
				{
					"id": 413420612,
					"content": "Я куплю чего-нибудь поесть. Когда вы там кончите, приходи, перекусим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Молот Ли"
				},
				{
					"id": 413420604,
					"content": "Откуда тебе это известно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				}
			]
