			"dialogs": [
				{
					"id": 413420901,
					"content": "Прости, что пришлось ждать. У меня всё готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420902
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413420902,
					"content": "О, так ты всё уже сделал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420903
					],
					"speakerTitle": "Молот Ли"
				},
				{
					"id": 413420903,
					"content": "#Ага. Дело и так нетрудное, а с путешественни{F#цей}{M#ком} так вообще пустяк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420904
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413420904,
					"content": "Так ты... Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420905
					],
					"speakerTitle": "Молот Ли"
				},
				{
					"id": 413420905,
					"content": "Будет тебе. Праздник на дворе, нечего дуться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420906
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413420906,
					"content": "Ладно, как скажешь. А ты небесный фонарь уже подготовил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420907
					],
					"speakerTitle": "Молот Ли"
				},
				{
					"id": 413420907,
					"content": "Небесный фонарь... Ох ты, я совсем забыл! Память моя дырявая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420908
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413420908,
					"content": "Ничего, не страшно. Не запущу раз небесный фонарь, конец света не настанет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420909
					],
					"speakerTitle": "Здоровяк Ван"
				},
				{
					"id": 413420909,
					"content": "Что ты такое говоришь? Не запустить небесный фонарь в такой большой праздник? Безобразие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420910
					],
					"speakerTitle": "Молот Ли"
				},
				{
					"id": 413420910,
					"content": "#Путешественни{F#ца}{M#к}, поможешь моему другу с небесным фонарём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420911
					],
					"speakerTitle": "Молот Ли"
				},
				{
					"id": 413420911,
					"content": "Будет сделано.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420912
					]
				},
				{
					"id": 413420912,
					"content": "Благодарю. Мы ждём тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Молот Ли"
				}
			]
		},
