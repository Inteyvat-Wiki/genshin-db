						750860402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750860402,
					"content": "Заказчик, который должен был нам заплатить, куда-то исчез, а нас ещё и приняли за сообщников злодея. Вот не везёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750860403,
					"content": "Но это не в нашем стиле сидеть и терпеть нападки. Надо разобраться в правде! А ещё Паймон волнуется за Таруку и Оберона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750860404,
					"content": "Ламизана... на него нельзя положиться! Но у нас нет других зацепок. Может, посмотрим место происшествия? Финиш?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
