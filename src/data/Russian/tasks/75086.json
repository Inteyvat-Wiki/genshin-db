				"objectNames": [
					"Лива"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750860301,
					"content": "#О, ты здесь! Тарука только что рассказывал, {F#какая ты крутая}{M#какой ты крутой}. Сказал, что мне придётся стараться изо всех сил, чтобы не отставать от тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860302
					],
					"speakerTitle": "Лива"
				},
				{
					"id": 750860302,
					"content": "Этот ребёнок совсем не верит, что я могу победить? Ни капли уважения к старшей сестре!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860303
					],
					"speakerTitle": "Лива"
				},
				{
					"id": 750860303,
					"content": "Так что не надейся, что я буду поддаваться. И ты не сдерживай себя! Посмотрим, кто окажется лучше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860304,
						750860306
					],
					"speakerTitle": "Лива"
				},
				{
					"id": 750860304,
					"content": "Ещё пожалеешь, что заставила меня отнестись к этому всерьёз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750860305
					]
				},
				{
					"id": 750860305,
					"content": "Ха-ха, вот это я понимаю настрой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860308
					],
					"speakerTitle": "Лива"
				},
				{
					"id": 750860308,
					"content": "#Ладно, хватит болтать. Давайте начнём, если ты {F#готова}{M#готов}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лива"
				},
				{
					"id": 750860306,
					"content": "Я тут только ради приза за участие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750860307
					]
				},
				{
					"id": 750860307,
					"content": "Ха! Думаешь, меня этим успокоишь? Не выйдет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860308
					],
					"speakerTitle": "Лива"
				}
			]
		},
