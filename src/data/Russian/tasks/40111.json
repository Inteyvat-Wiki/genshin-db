				"objectNames": [
					"Нин Гуан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113201,
					"content": "Я слышала, что даже неофициальный турнир по «Священному призыву семерых» пользуется огромной популярностью. Многие серьёзные игроки записались на него параллельно с официальным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113202
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 401113202,
					"content": "Что касается меня... Я не против время от времени попробовать свои силы в модных играх, хотя по-прежнему предпочитаю шахматы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113203
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 401113203,
					"content": "Но какими бы ни были различия, все игры имеют кое-что общее: они объединяют друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нин Гуан"
				}
			]
		},
		{
			"id": 4011133,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
