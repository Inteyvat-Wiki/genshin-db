			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Шарлотта",
					"Малыш Цянь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113301,
					"content": "Привет, меня зовут Шарлотта. Я репортёр газеты «Паровая птица».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113302
					],
					"speakerTitle": "Шарлотта"
				},
				{
					"id": 401113302,
					"content": "Найдётся ли у вас немного времени для интервью?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113303
					],
					"speakerTitle": "Шарлотта"
				},
				{
					"id": 401113303,
					"content": "Уф... Ну хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113304
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 401113304,
					"content": "Вы многообещающе начали это соревнование, повергнув многих соперников на пути к финалу, но потерпели поражение в дуэли с управляющей ритуальным бюро «Ваншэн», госпожой Ху Тао. Вы были столь близки к победе. Наверное, разочарование было горьким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113305
					],
					"speakerTitle": "Шарлотта"
				},
				{
					"id": 401113305,
					"content": "В связи с этим не хотели бы вы поделиться своими мыслями о том, как сложился финальный матч?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113306
					],
					"speakerTitle": "Шарлотта"
				},
				{
					"id": 401113306,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113307
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 401113307,
					"content": "Простите, вам нужен ответ для прессы или мои настоящие мысли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113308
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 401113308,
					"content": "Конечно, честное мнение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113309
					],
					"speakerTitle": "Шарлотта"
				},
				{
					"id": 401113309,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113310
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 401113310,
					"content": "Я всегда говорил, что игра в карты - это семьдесят процентов мастерства и тридцать процентов удачи... Но когда твой противник выбрасывает сразу шесть дайсов одного элемента, с этим даже Адепту не справиться... Так что у простого искателя приключений вроде меня шансов не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Цянь"
				}
			]
		},
		{
			"id": 4011151,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
