				"points": []
			},
			"dialogs": [
				{
					"id": 401115201,
					"content": "Генерал Кудзё, можем кое-что обсудить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115202
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 401115202,
					"content": "Конечно. Поздравляю с победой, Сангономия Кокоми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115203
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 401115203,
					"content": "Я хотела выразить благодарность за полезный совет перед поединком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115204
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 401115204,
					"content": "Это ничего не значащий пустяк. Любой, у кого есть голова на плечах, знает, что победителя определяют мастерство и стратегия. Это была интересная дуэль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115205
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 401115205,
					"content": "Жаль, что ты не участвовала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115206
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 401115206,
					"content": "Боюсь, я бы не смогла у тебя выиграть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115207
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 401115207,
					"content": "Не говори так. Мы не так уж сильно отличаемся... Ты тоже ищешь возможностей отточить свои навыки, продумываешь контрмеры и остаёшься друзьями с соперниками по игре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115208
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 401115208,
					"content": "Что-то в этом есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115209
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 401115209,
					"content": "Тогда почему нам не сыграть в «Священный призыв семерых», пока ты не покинула Наруками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115210
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 401115210,
					"content": "Почту за честь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				}
			]
		},
