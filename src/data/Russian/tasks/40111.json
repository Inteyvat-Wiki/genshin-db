			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кэйа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111301,
					"content": "Привет. Хочешь ещё что-нибудь обсудить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111306,
						401111310
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 401111302,
					"content": "Расскажи о «Священном призыве семерых»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111303
					]
				},
				{
					"id": 401111303,
					"content": "В последнее время эта игра стала очень популярна. Теперь это часть повседневной жизни - куда ни пойдёшь, всюду люди играют в карты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111304
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 401111304,
					"content": "Некоторые даже отказываются от выпивки, чтобы сохранить ясную голову во время игры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111305
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 401111305,
					"content": "Хе-хе, уверен, Диона будет рада об этом услышать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111306,
						401111310
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 401111306,
					"content": "У рыцарей Ордо Фавониус всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111307
					]
				},
				{
					"id": 401111307,
					"content": "Не переживай, всё хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111308
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 401111308,
					"content": "Я даже уговорил было Джинн сыграть со мной, но на середине партии её отвлекли. Пришлось мне заканчивать дуэль в одиночку. Эх... Что поделать? Работа прежде всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111309
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 401111309,
					"content": "Но турнир прошёл успешно, и все отлично провели время, так что надеюсь, что теперь у неё на один повод для беспокойства меньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111310
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 401111310,
					"content": "Давай поболтаем в другой раз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111311
					]
				},
				{
					"id": 401111311,
					"content": "Конечно! А когда выдастся время, сыграем в «Священный призыв семерых».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэйа"
				}
			]
		},
		{
			"id": 4011114,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
