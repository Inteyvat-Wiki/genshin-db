				"objectNames": [
					"Шарлотта",
					"Кирара"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401115301,
					"content": "Я слышала, как ты называла одну из финалисток «госпожой кицунэ». Можешь рассказать подробнее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115302
					],
					"speakerTitle": "Шарлотта"
				},
				{
					"id": 401115302,
					"content": "Прошу, не упускай ни одной детали. Кто знает, может, я смогу включить что-то в статью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115303
					],
					"speakerTitle": "Шарлотта"
				},
				{
					"id": 401115303,
					"content": "Ох, лучше не надо. Я боюсь, что чего-нибудь не того наговорю. Да и я не самый опытный ёкай, чтобы отвечать на такие вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115304
					],
					"speakerTitle": "Кирара"
				},
				{
					"id": 401115304,
					"content": "Хорошо, может, тогда ты сможешь прояснить связь между кицунэ и жареным тофу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115305
					],
					"speakerTitle": "Шарлотта"
				},
				{
					"id": 401115305,
					"content": "Мм, от твоих вопросов мне есть захотелось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115306
					],
					"speakerTitle": "Кирара"
				},
				{
					"id": 401115306,
					"content": "Может, я угощу тебя жареным тофу и рамэном, раз уж мы в Инадзуме? А за едой попробую всё объяснить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кирара"
				}
			]
		}
	]
