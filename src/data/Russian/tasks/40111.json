			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аратаки Итто",
					"Куки Синобу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401115101,
					"content": "Ух, вот это поединок устроили лисичка с рыбкой! Я аж вспотел!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115102
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401115102,
					"content": "Да-да, уже весь Рито знает, как ты взволнован, босс. Но банда ждёт, нам пора возвращаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115103
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401115103,
					"content": "Э, ну они могут ещё немного подождать... А дружище пока сыграет со мной ещё партию! Ты же не можешь мне в этом отказать?.. Пожалуйста-пожалуйста!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115104,
						401115107
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401115104,
					"content": "Хорошо, сыграем партию.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115105
					]
				},
				{
					"id": 401115105,
					"content": "Да, дружище! Я знал, что ты примешь вызов! Только ты можешь понять такого крутого игрока в «Священный призыв семерых», как я!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115106
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401115106,
					"content": "Ну что мне с вами делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401115107,
					"content": "Давай лучше в следующий раз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115108
					]
				},
				{
					"id": 401115108,
					"content": "Ну ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115109
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401115109,
					"content": "Всё в порядке, я тебя не виню... Но тебе лучше уйти. Ты ведь не хочешь видеть, как плачет взрослый óни?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аратаки Итто"
				}
			]
		},
