				"points": []
			},
			"dialogs": [
				{
					"id": 110240301,
					"content": "Я ещё немного побуду здесь. Боюсь, подобные мгновения воспоминаний будут случаться всё реже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240302,
						110240305,
						110240308
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110240302,
					"content": "Мне несколько жаль Архонта Соли...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240303
					]
				},
				{
					"id": 110240303,
					"content": "Во времена Войны Архонтов мы определяли добро и зло совсем не так, как это делают сейчас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240304
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110240304,
					"content": "Конечно... сейчас мне хотелось бы, чтобы она жила в более доброе время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110240305,
					"content": "Разве эти реликвии не сделают Осиала сильнее?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240306
					]
				},
				{
					"id": 110240306,
					"content": "Соляная чаша и соляная планка - по-своему сильные артефакты, но для Осиала они бесполезны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240307
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110240307,
					"content": "Даже если он однажды вернёт свои силы и восстанет вновь... Ха, он безусловно вновь потерпит поражение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110240308,
					"content": "Что ты будешь делать теперь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240309
					]
				},
				{
					"id": 110240309,
					"content": "Хороший вопрос. Когда-то я смог бы дать тебе особенно точный ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240310
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110240310,
					"content": "Но теперь... Да, пожалуй, я продолжу исполнять роль консультанта в ритуальном бюро «Ваншэн».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240311
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110240311,
					"content": "Но если это путешествие пришлось тебе по вкусу, то я буду рад совершить следующую попытку сберечь историю Ли Юэ вместе с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				}
			]
		}
	]
}