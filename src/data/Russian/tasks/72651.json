			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ульман"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726510101,
					"content": "Эх... Я что, правда что-то вроде магнита для фей?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510102
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510102,
					"content": "#О, да это же... это ты, путешественни{F#ца}{M#к}! Что привело тебя сюда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510103,
						726510106
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510103,
					"content": "Кто ты такой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510104
					]
				},
				{
					"id": 726510104,
					"content": "Это же я, Ульман! Раньше мы вместе искали сокровища, помнишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510105
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510105,
					"content": "А поисковая фея? Ну хоть это ты помнишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510108
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510108,
					"content": "Как ты оказался в Инадзуме?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510109
					]
				},
				{
					"id": 726510109,
					"content": "#Кхм... Помнишь, как в тот раз ты {F#помогла}{M#помог} мне найти кучу железных монет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510110
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510110,
					"content": "Я продал их за кругленькую сумму... Хе-хе. Кстати, спасибо тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510111
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510111,
					"content": "Но, знаешь ли, способов потратить мору уйма. И я уже почти всё потратил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510112
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510112,
					"content": "Поисковой феи у меня нет, и без твоей помощи я бы их не нашёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510113
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510113,
					"content": "Поэтому мне пришлось искать другие способы, как разжиться морой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510114
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510114,
					"content": "Один... знакомый из Инадзумы сказал мне, что здесь полно сокровищ, вот я и приехал попытать счастья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510115
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510115,
					"content": "Ты ведь знаешь, что границы Инадзумы закрыты?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510116
					]
				},
				{
					"id": 726510116,
					"content": "Да, конечно. Скажем... у меня свои пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510117
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510117,
					"content": "Так вот, я договорился с моими «друзьями», за определенную плату заполучил лодку и приготовился к отплытию в Инадзуму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510118
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510118,
					"content": "Вот только... эх... Чем ближе я подплывал к Инадзуме, тем страннее становилась погода. Грянул гром, поднялся ветер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510119
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510119,
					"content": "И тут вдруг молния расколола лодку, меня выбросило за борт и унесло в море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510120
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510120,
					"content": "Меня накрыло волнами, я наглотался морской воды и потерял сознание. Пришёл в себя уже на пляже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510121
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510121,
					"content": "Тебе крупно повезло.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510122
					]
				},
				{
					"id": 726510122,
					"content": "Ха-ха-ха, можно сказать, мне везёт по жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510123
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510123,
					"content": "И, хм... В общем, когда я добрался до берега, осмотрелся и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510124
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510124,
					"content": "Каким-то образом опять наткнулся на фею. Она помогла мне найти несколько сокровищ. Поэтому я подумал, что это одна из тех поисковых фей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510125
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510125,
					"content": "Но, как и все предыдущие, после нескольких сокровищ она устала, и теперь просто кружит вокруг меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510126
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510126,
					"content": "Значит, такие феи есть и здесь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510127
					]
				},
				{
					"id": 726510127,
					"content": "Я и сам не знаю. Может, я что-то вроде магнита для фей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510128
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510128,
					"content": "Или они находят во мне что-то притягательное? Ничего не понимаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510129
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510129,
					"content": "В любом случае, раз уж я здесь, с пустыми руками я не уйду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510130
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510130,
					"content": "Судя по моим сведениям, где-то поблизости должны быть сокровища. В записной книжке я отметил участки, где их стоит поискать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510131
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510131,
					"content": "Но, раз уж наш маленький друг участвовать в этом мероприятии не желает, я тоже ничего не могу поделать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510132
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510132,
					"content": "#Поработаешь со старым приятелем Ульманом, а, путешественни{F#ца}{M#к}? Думаю, твоей поисковой фее не терпится взяться за дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510133
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510133,
					"content": "Всё как в прошлый раз: я указываю тебе места, а ты находишь для меня сокровища. Все драгоценности твои, я на них не претендую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510134
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510134,
					"content": "А железные монеты неси мне. Клянусь, я заплачу за них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510135
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510135,
					"content": "Только если цена будет хорошей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510136
					]
				},
				{
					"id": 726510136,
					"content": "А как же! Мы с тобой давние партнёры. Ты можешь доверять мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510137
					],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510137,
					"content": "#Вот, возьми мою записную книжку. Удачной охоты, путешественни{F#ца}{M#к}! За наше выгодное сотрудничество!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ульман"
				},
				{
					"id": 726510106,
					"content": "Верно, ты тот парень с поисковой феей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510107
					]
				},
				{
					"id": 726510107,
					"content": "Да, это я, Ульман. Раньше мы работали вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510108
					],
					"speakerTitle": "Ульман"
				}
			]
		},
