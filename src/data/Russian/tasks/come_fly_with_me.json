			"dialogs": [
				{
					"id": 750701401,
					"content": "Кхм, мы должны начать всё сначала! ...Если вы не возражаете, конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701402
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750701402,
					"content": "Эх... Ну... раз уж мы здесь, мы не против.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701403,
						750701405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750701403,
					"content": "Давайте продолжим!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701404
					]
				},
				{
					"id": 750701404,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750701405,
					"content": "Давайте немного отдохнём...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701406
					]
				},
				{
					"id": 750701406,
					"content": "Прыжки со скал - это тяжёлая физическая работа. Пора отдохнуть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750701407,
					"content": "А... Да. Я не учёл этого. Ладно, начинайте, когда будете готовы. Я буду ждать здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Магнифико"
				}
			]
		},
