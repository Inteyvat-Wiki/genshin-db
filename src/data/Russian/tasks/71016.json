				"points": []
			},
			"dialogs": [
				{
					"id": 710160301,
					"content": "О безымянном сокровище...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160302
					]
				},
				{
					"id": 710160302,
					"content": "#Если моё предположение верно, то та вещь, что ты прин{F#есла}{M#ёс} в прошлый раз, всего лишь одна часть из трёх.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160303
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160303,
					"content": "Только если собрать воедино три части, можно получить артефакт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160304
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160304,
					"content": "Если тебе удастся найти все три, то я с удовольствием предложу тебе хорошую цену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160305
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160305,
					"content": "Но это довольно древний предмет... Возможно, собрать все три будет непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лан"
				}
			]
		},
