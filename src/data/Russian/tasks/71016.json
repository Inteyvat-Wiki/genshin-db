				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Линь Лан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160501,
					"content": "#Я наш{M#ёл}{F#ла} все три части.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160502
					]
				},
				{
					"id": 710160502,
					"content": "#Ты правда собрал{F#а} все части? Пожалуйста, позволь взглянуть... Действительно, эти три узора подходят друг к другу и в самом деле повествуют об Аждахе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160503
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160503,
					"content": "Этот журавль, видимо, символизирует Творца Гор, а этот олень... Возможно, это Владыка Лун, но тогда третий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160504
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160504,
					"content": "Хм... Кажется, последний узор был специально кем-то стёрт, детали разглядеть невозможно. Так кто же этот третий Адепт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160505
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160505,
					"content": "Ладно, это за пределами моих познаний. Так или иначе, это сокровище предстало перед нами целиком, поэтому его можно продать по хорошей цене.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160506
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160506,
					"content": "Ну что, хочешь оставить себе на память или отдать мне, чтобы я продала его подороже?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160507
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160507,
					"content": "Я продам его вам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160508
					]
				},
				{
					"id": 710160508,
					"content": "Хорошо. Вот твои деньги. Сокровище я заберу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160509
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160509,
					"content": "Но всё-таки... почему изображение одного из трёх Адептов стёрто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160510
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160510,
					"content": "Кто создал эту вещь, кто сломал её, кто стёр портрет Адепта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160511
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160511,
					"content": "Да, кажется, Сорайя уже прибыла в Ли Юэ. Я могу написать ей письмо по этому вопросу... Думаю, её тоже заинтересует эта вещь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лан"
				}
			]
