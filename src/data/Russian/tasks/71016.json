			"dialogs": [
				{
					"id": 710160401,
					"content": "Я отправлюсь на поиски.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160402
					]
				},
				{
					"id": 710160402,
					"content": "Хорошо. Если найдёте все три части, пожалуйста, принеси их мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
