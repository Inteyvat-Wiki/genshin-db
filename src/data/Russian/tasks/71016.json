	"talks": [
		{
			"id": 7101602,
			"completionStepIds": [
				7101602
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101602",
							"2"
						],
						"stepId": 7101602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Линь Лан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "О безымянном сокровище...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160202,
					"content": "#Та вещь, что ты прин{F#есла}{M#ёс}, выглядит неплохо. Орнаменту наверняка много лет. Пожалуйста, подожди, пока я её открою.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160203,
					"content": "Здесь есть некоторые дефекты... Если тебе нужно срочно сбыть это, я могу предложить цену. Не слишком высокую, впрочем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160204,
					"content": "Я осмотрела это. Узор действительно выполнен в стиле Ли Юэ, к тому же то, что написано на поверхности, совпадает с историей об Аждахе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160205,
					"content": "Говорят, Аждаха - это дракон, появившийся из скопления Гео элемента в Ли Юэ. Даже самому Властелину Камня Мораксу было нелегко усмирить его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160206,
					"content": "Чтобы одолеть дракона, Властелин Камня призвал трёх Адептов и поручил им возвести небесную обитель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160207,
					"content": "Затем Властелин Камня лично вступил в борьбу с драконом и загнал его в ту обитель. Адептам он приказал перекрыть путь в неё, и только так удалось усмирить Аждаху.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160208,
					"content": "#Узоры на той вещи, которую ты мне прин{F#есла}{M#ёс}, как раз описывают те события, когда три Адепта вместе возвели небесную обитель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160209,
					"content": "Поэтому я думаю, что должно существовать три вещи такого рода. Если их соединить, то мы получим целый предмет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160210,
					"content": "Вы всё это знаете...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "Что ж, моя работа - покупать и продавать товары. Общие знания в различных сферах лишними не бывают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160215,
					"content": "Но мы с тобой отвлеклись. Как было сказано, есть три части, составляющие одну вещь. Боюсь, цена только одной части не будет велика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160216,
					"content": "Но если удастся собрать все три, тогда другое дело. Однако она выглядит довольно древней. Боюсь, найти все три части будет нелегко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160212,
					"content": "Ли Юэ - действительно загадочное место...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "Не уверена. Но люди старшего поколения говорили мне, что Ли Юэ слишком велик, а история региона слишком длинна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 710160214,
					"content": "Какие бы странные артефакты вы ни находили в Ли Юэ, в этом нет ничего удивительного. История этого региона настолько древняя, что наши сегодняшние знания - лишь капля в её бескрайнем море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Линь Лан"
				}
			]
		},
		{
			"id": 7101603,
