				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220430301,
					"content": "#Да, думаю, они подойдут. Прости, что попросил о помощи сразу после того, как ты проделал{F#а} весь этот путь, чтобы добраться до святилища... Пожалуйста, возьми это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430302
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430302,
					"content": "Когда я усовершенствую свои навыки резьбы по дереву, я пришлю тебе свои лучшие работы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430303
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430303,
					"content": "В какой позе вырезать временную настоятельницу в этот раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осима Дзюмпэй"
				}
			]
		}
