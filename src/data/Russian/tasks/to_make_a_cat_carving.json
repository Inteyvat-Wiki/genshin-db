			"trigger": {
				"objectNames": [
					"Осима Дзюмпэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220430101,
					"content": "Как так получилось, что у меня закончилась древесина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430102
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430102,
					"content": "#{NICKNAME}, я надеялся, что ты придёшь. Окажешь мне услугу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430103,
						220430104
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430103,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				},
				{
					"id": 220430105,
					"content": "Я пытаюсь сделать более маленькую статуэтку нашей временной настоятельницы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430106
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430106,
					"content": "Я хотел отвезти партию этих изделий на остров Наруками, чтобы посмотреть, захочет ли кто-нибудь их купить... Разумеется, после того, как я закончу их делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430107
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430107,
					"content": "Если удастся их продать, то можно будет считать это постоянным заработком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430108,
						220430111
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430108,
					"content": "Думаю, их получится продать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430109
					]
				},
				{
					"id": 220430109,
					"content": "Ха-ха-ха, спасибо за добрые слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430110
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430110,
					"content": "Кроме того, я верю в обаяние нашей временной настоятельницы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430118,
					"content": "Ну, не будем пока об этом. Давай поговорим о насущной проблеме...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430119
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430119,
					"content": "Дело в том, что у меня заканчивается древесина, которую я использую для практики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430120
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430120,
					"content": "#{NICKNAME}, ты не принесешь мне 10 кусков отоги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430121,
						220430123
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430121,
					"content": "Не вопрос.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430122
					]
				},
				{
					"id": 220430122,
					"content": "Большое спасибо, ты мне очень поможешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430126,
					"content": "Когда всё соберёшь, скорее возвращайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430123,
					"content": "Этого хватит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430124
					]
				},
				{
					"id": 220430124,
					"content": "Ну, я только начал практиковаться, так что лучше подстраховаться и подготовить больше материала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430125
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430125,
					"content": "#Спасибо, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430111,
					"content": "Почему ты вдруг начал делать деревянные статуэтки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430112
					]
				},
				{
					"id": 220430112,
					"content": "О, ну... Ты знаешь, чем наша временная настоятельница расплачивается со мной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430113
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430113,
					"content": "Бутылками, чашками, блюдцами и прочими подобными вещами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430114
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430114,
					"content": "Они выглядят немного старыми, но когда я пошёл оценить их, выяснилось, что эти вещи на самом деле антикварные... и к тому же ценные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430115
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430115,
					"content": "Но, по правде говоря, было довольно хлопотно и утомительно каждый раз продавать их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430116
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430116,
					"content": "К тому же этот доход нельзя назвать стабильным. Если у временной настоятельницы однажды закончатся эти вещи, то это будет подобно потере работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430117
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430117,
					"content": "Поэтому я решил заняться новым бизнесом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 220430104,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				}
			]
		},
