				"points": []
			},
			"dialogs": [
				{
					"id": 747030101,
					"content": "Подождите... эти счета... Вы уверены, что не ошиблись в расчётах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030102
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747030102,
					"content": "Хм? Что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747030103,
					"content": "...Разве у нас может быть такая большая выручка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030104
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747030104,
					"content": "Жалеешь, что согласилась всего на тридцать процентов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030105
					]
				},
				{
					"id": 747030105,
					"content": "Значит, я кажусь тебе такой скупердяйкой? Я удивлена, что вы так хорошо управляете океанариумом, только и всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030106
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747030106,
					"content": "Паймон уверена, что во многом это благодаря кинофестивалю «Фонтиналия».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747030107,
					"content": "Эта выручка... не только окупила аренду «Вингалета», но и принесла приличную прибыль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030108
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747030108,
					"content": "Не думаешь сменить профессию?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030109
					]
				},
				{
					"id": 747030109,
					"content": "Это вряд ли. Во мне совсем нет деловой жилки. Меня больше интересует изучение механики и разных формул.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030110
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747030110,
					"content": "Хотя... когда пустой зал без единой рыбы на твоих глазах превращается в настоящий океанариум. Это похоже на чудо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030111
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747030111,
					"content": "Хе-хе, если бы ты не разрешила нам здесь распоряжаться, ничего бы не было! Приятно смотреть, как наша работа приносит радость людям! Правда, Сандроне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747030112,
					"content": "Хм. Может быть, чуть-чуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030113
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747030113,
					"content": "Всего лишь чуть-чуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747030114,
					"content": "Наверное, жалеет, что согласилась всего на тридцать процентов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030115
					]
				},
				{
					"id": 747030115,
					"content": "Я же сказала, меня это не волнует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
}