				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Антэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370401,
					"content": "Посол с острова Наруками рассказывал о птицах. Они летают на крыльях высоко в небе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370402
					],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370402,
					"content": "Это просто потрясающе. Можете такое представить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370403
					],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370403,
					"content": "Другие верят, что птицы - посланники богов, которые предсказывают судьбу человека.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370404
					],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370404,
					"content": "Если человек изгнан в пустыню, эти создания прилетят и будут клевать его бренное тело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370405
					],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370405,
					"content": "Я очарован этим существом. Если сегодня я не умру, то обязательно заведу птицу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Антэй"
				}
			]
		},
		{
			"id": 7223705,
			"completionStepIds": [
				7223708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223708",
							"2"
						],
						"stepId": 7223708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Антэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370501,
					"content": "Вы принесли книгу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370502
					],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370502,
					"content": "Да. Антэй, ты действительно невиновен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722370503,
					"content": "Жаль, что вы не дзибасири, а то на месте бы сразу засвидетельствовали мою невиновность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370504
					],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370504,
					"content": "И я был бы абсолютно свободен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370505
					],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370505,
					"content": "Сейчас я чувствую себя очень бодрым, а до этого ощущал слабость от кровопотери. Не могу избавиться от ощущения, что скоро умру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370506
					],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370506,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722370507,
					"content": "#Я спрашиваю тебя, {F#незнакомка}{M#незнакомец}. Неужели быть ложно обвинённым в Бякуякоку - это преступление?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370508
					],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370508,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370509
					]
				},
				{
					"id": 722370509,
					"content": "Если сейчас из-за тревожного состояния души великий бог Токоё оставит меня как грешную тень, буду ли я грешником?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370510
					],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370510,
					"content": "Есть на мне грех?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370511
					],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370511,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370512
					]
				},
				{
					"id": 722370512,
					"content": "#{NICKNAME}, осторожнее со словами. Если он осознает, то исчезнет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722370513,
					"content": "Ты лишь тень Антэя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370514
					]
				},
				{
					"id": 722370514,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370515
					],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370515,
					"content": "Ты невиновен. Я скажу об этом всем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370516
					]
				},
				{
					"id": 722370516,
					"content": "Хм, вот как. Я лишь тень себя прежнего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370517
					],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370517,
					"content": "Я невиновен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Антэй"
				},
				{
					"id": 722370518,
					"content": "Призрак Антэя начинает декламировать какой-то отрывок:\\n«Какой божественный закон нарушил я?\\nИ почему к богам несчастные взывают?\\nМои деяния... В чём смысл бытия,\\nКоль ныне доброту грехами называют?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Антэй"
				}
			]
		}
	]
}