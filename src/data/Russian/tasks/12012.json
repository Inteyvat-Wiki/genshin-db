			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иматани Каори",
					"Иматани Сабуро"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120101,
					"content": "Ёимия пришла! Проходи, присаживайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120102
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120102,
					"content": "Ты пришла с друзьями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120103
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120103,
					"content": "Да, это путешественники из дальних краёв. Сейчас иноземцам непросто приехать в Инадзуму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120104
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120104,
					"content": "Действительно, сейчас странные времена. Но раз уж они проделали такой путь, мы, местные жители, должны оказать им тёплый прием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120105
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120105,
					"content": "Пока не забыла, я принесла фейерверки, которые вы заказали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120106
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120106,
					"content": "Спасибо, дорогая. Твоя семья всегда очень добра к нам. Сначала твой отец, а теперь ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120107
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120107,
					"content": "Интересно, увижу ли я при жизни преемника «Фейерверков Наганохары»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120108
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120108,
					"content": "Конечно увидите! У вас отменное здоровье! Не навлекайте на себя несчастье такими речами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120109
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120109,
					"content": "Мы уже не так молоды, как раньше. Да и здоровье уже не то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120110
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120110,
					"content": "Раньше я могла целый день работать в поле, носить воду, а теперь даже от легкой работы у меня всё болит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120111
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120111,
					"content": "Вчера я хотела заняться прополкой, но как только я наклонилась, вдруг почувствовала, что если продолжу, то уже не смогу разогнуться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120112
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120112,
					"content": "Ни слова больше! Предоставьте это нам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120113
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120113,
					"content": "Нет-нет-нет! Ни в коем случае нельзя перекладывать работу на гостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120114
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120114,
					"content": "Я принесу чай и сладости, а потом мы продолжим наш разговор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120115
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120115,
					"content": "Всё в порядке, я не первый раз помогаю вам по хозяйству. Просто в последнее время у меня было мало времени из-за предстоящего фестиваля. Как только он закончится, я обязательно буду заходить почаще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120116
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120116,
					"content": "Для нас не составит большого труда помочь вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120120117,
					"content": "Вы такие хорошие дети... Не то что наш сын. Он уже вырос, до сих пор одинок, но всё равно не навещает нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120118
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120118,
					"content": "Если вы уверены, что это не составит труда, то... У меня тут есть немного маринованной редьки. Не могли бы вы доставить её Сатору на другой конец деревни?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120119
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120119,
					"content": "Хорошо! Мы мигом вернёмся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120120
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120120,
					"content": "Старики не очень расторопны, так что давайте поможем им. Сначала мы <color=#00E1FFFF>прополем сорняки</color>, а затем <color=#00E1FFFF>доставим маринованную редьку</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ёимия"
				}
			]
		},
		{
			"id": 1201204,
			"completionStepIds": [
				1201204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201204",
							"2"
						],
						"stepId": 1201204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сатору"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120401,
					"content": "Господин Сатору, здравствуйте! Как ваше здоровье?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120402
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120402,
					"content": "Как обычно, мало что изменилось. Ты полна энергии, как всегда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120403
					],
					"speakerTitle": "Сатору"
				},
				{
					"id": 120120403,
					"content": "Всё это благодаря поддержке наших постоянных клиентов. Торговля идёт всё лучше и лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120404
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120404,
					"content": "Некоторое время назад мы продали в Ли Юэ несколько фейерверков. Говорят, они пользовались большим успехом. В будущем мы планируем получать больше заказов оттуда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120405
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120405,
					"content": "Это означает, что у вас будет больше работы. Ты уверена, что вы с господином Рюносукэ справитесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120406
					],
					"speakerTitle": "Сатору"
				},
				{
					"id": 120120406,
					"content": "Если станет слишком тяжело, ты всегда можешь обратиться ко мне за помощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120407
					],
					"speakerTitle": "Сатору"
				},
				{
					"id": 120120407,
					"content": "Думаю, мы справимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120408
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120408,
					"content": "Ах да, это маринованная редька от госпожи Иматани.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120409
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120409,
					"content": "Спасибо тебе большое! Раньше я не был поклонником маринованной редьки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120410
					],
					"speakerTitle": "Сатору"
				},
				{
					"id": 120120410,
					"content": "Но однажды я попробовал маринованную редьку госпожи Иматани. Теперь она всегда у нас на столе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120411
					],
					"speakerTitle": "Сатору"
				},
				{
					"id": 120120411,
					"content": "Кстати, о вашей семье, всё хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120412
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120412,
					"content": "Всё хорошо. У нас иногда бывают жаркие споры, но... такое случается в каждой семье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120413
					],
					"speakerTitle": "Сатору"
				},
				{
					"id": 120120413,
					"content": "Возможность иметь семью рядом - это лучше, чем никогда не видеться с ней, даже если для этого приходится мириться с некоторыми разногласиями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120414
					],
					"speakerTitle": "Сатору"
				},
				{
					"id": 120120414,
					"content": "У четы Иматани прекрасные отношения, но всё же им должно быть одиноко от того, что сын не навещает их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120415
					],
					"speakerTitle": "Сатору"
				},
				{
					"id": 120120415,
					"content": "Мне так не показалось. Я думаю, они просто привыкли к этому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120416
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120416,
					"content": "Вы правильно сказали. В будущем мне стоит заглядывать к ним почаще. Тогда им не будет так одиноко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120417
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120417,
					"content": "Я уверен, что им это понравится. Как и всем нам в деревне Конда. Здесь тебе всегда рады.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120418
					],
					"speakerTitle": "Сатору"
				},
				{
					"id": 120120418,
					"content": "Хе-хе, спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ёимия"
				}
			]
		},
		{
			"id": 1201205,
			"completionStepIds": [
				1201205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201205",
							"2"
						],
						"stepId": 1201205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иматани Каори"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120501,
					"content": "Вы уже вернулись? Молодёжь всё делает быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120502
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120502,
					"content": "У молодых людей много энергии, а у пожилых - много мудрости. У каждого из нас есть свои сильные стороны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120503
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120503,
					"content": "Кстати, о молодёжи... Знаешь что? Прошло уже 50 лет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120504
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120504,
					"content": "О, так и есть! Как летит время... Вы едва замечаете, как проходят годы, но потом вдруг оказывается, что прошло 50 лет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120505
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120505,
					"content": "50 лет со дня чего? С какого-то важного дня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120120506,
					"content": "Ха-ха, ну, если хотите знать, 50 лет назад эта красавица пыталась завоевать меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120507
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120507,
					"content": "О, перестань распускать хвост. Мы оба знаем, что это ты был безнадёжно влюблён и отчаянно пытался завоевать моё расположение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120508
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120508,
					"content": "Давай опустим подробности. 50 лет назад я сделал предложение своей будущей жене на фестивале фейерверков Наганохары. С тех пор мы вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120509,
						120120510
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120509,
					"content": "Мои поздравления.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				},
				{
					"id": 120120511,
					"content": "По правде говоря, я был немного не уверен. Я не был уверен, что делаю, когда вошёл в магазин Наганохары и заказал свой фейерверк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120512
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120512,
					"content": "Даже когда фейерверк полетел вверх... я всё ещё не знал, что мне сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120513
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120513,
					"content": "Но потом он взорвался, небо озарилось. Я посмотрел на неё и увидел её глаза, мерцающие в свете фейерверка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120514
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120514,
					"content": "Прежде чем я понял, что происходит, я уже сказал это, и она ответила «да».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120515
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120515,
					"content": "50 лет... С одной стороны это очень долго, с другой - совсем недолго. На самом деле, это просто цифра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120516
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120516,
					"content": "Но 50 лет совместной жизни... Это стоит отметить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120517
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120517,
					"content": "Если бы я знала, что вы хотите отметить годовщину, то сделала бы для вас особый фейерверк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120518
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120518,
					"content": "Всё в порядке. Мы всегда запускаем один и тот же фейерверк каждый год. Без него праздник был бы не таким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120519
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120519,
					"content": "Мы любуемся фейерверком и возвращаемся в то время. Даже в этом возрасте мы оглядываемся назад, не испытывая ни малейшего сожаления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120520
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120520,
					"content": "О, какие у них прекрасные отношения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120521
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120120521,
					"content": "Давайте лучше поговорим о вас. Ёимия, разве ты не занята предстоящим фестивалем фейерверков? Ты пришла что-то обсудить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120522
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120522,
					"content": "Да... Даже не знаю с чего начать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120523
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120523,
					"content": "Сакудзиро... Значит, он вернулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120524
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120524,
					"content": "Вы знаете его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120525
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120525,
					"content": "Он был лучшим другом нашего сына, когда они были маленькими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120526
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120526,
					"content": "Они были не разлей вода. Делились всем друг с другом и везде ходили вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120527
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120527,
					"content": "Но однажды они очень сильно поругались...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120528
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120528,
					"content": "Сакудзиро хотел уехать из Инадзумы, чтобы повидать мир. Он думал, что здесь слишком безмятежно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120529
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120529,
					"content": "Но наш Кэйсукэ брал пример с отца и матери. Он считал, что в мирной жизни нет ничего плохого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120530
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120530,
					"content": "Дети ужасно переживают из-за таких вещей. В конце концов Сакудзиро ушёл, и на этом всё закончилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120531
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120531,
					"content": "Вот оно как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120532
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120532,
					"content": "Кэйсукэ ничего не сказал ни мне, ни моей жене о ссоре. Мы чувствовали, что его это очень задело, но он не хотел говорить с нами о своих чувствах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120533
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120533,
					"content": "В конце концов, то ли из-за гнева, то ли по какой-то другой причине, он вступил в комиссию Тэнрё. Теперь он редко навещает нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120534
					],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120534,
					"content": "Если бы это было что-то другое, то я могла бы поговорить с Кэйсукэ. Уверена, что он смог бы помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120535
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120535,
					"content": "Но поскольку это касается Сакудзиро... Я не думаю, что мы можем чем-то помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120536
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120536,
					"content": "Какое странное совпадение. Кто бы мог подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120537
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120120537,
					"content": "Теперь я понимаю. Когда я спросила Сакудзиро, почему он вернулся, он просто сказал «из-за прошлых ошибок» и не захотел уточнять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120538
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120538,
					"content": "Теперь я понимаю, почему он не может решить, что делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120539
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120539,
					"content": "Два лучших друга детства. Один вырастает и становится членом комиссии Тэнрё, другой - разыскиваемым преступником...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120540,
						120120541
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120120540,
					"content": "Это судьба.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120542,
					"content": "Если это так, то не волнуйтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120543
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120543,
					"content": "Мы можем найти другой способ помочь Сакудзиро. Нет необходимости усложнять вам жизнь. Сакудзиро и Кэйсукэ должны сами уладить свои отношения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120544
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120544,
					"content": "Да, было бы здорово, если бы они могли снова стать друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120545
					],
					"speakerTitle": "Иматани Каори"
				},
				{
					"id": 120120545,
					"content": "Я думаю, что после стольких лет они должны забыть свои обиды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иматани Сабуро"
				},
				{
					"id": 120120541,
					"content": "Неожиданный поворот.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120510,
					"content": "Вам можно позавидовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				}
			]
		},
		{
			"id": 1201206,
			"completionStepIds": [
				1201206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201206",
							"2"
						],
						"stepId": 1201206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Наганохара Рюносукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120601,
					"content": "Ёимия, только что приходили люди из комиссии Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120602
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120120602,
					"content": "Зачем? Они всё знают?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120603
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120603,
					"content": "Папа, с тобой всё в порядке? Они ведь ничего тебе не сделали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120604
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120604,
					"content": "Я сказал им, что скоро начнётся фестиваль и внутри полно фейерверков. И что им не стоит заходить внутрь, потому что это опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120605
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120120605,
					"content": "Но они не послушали. Похоже, они знали, что Сакудзиро прячется внутри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120606
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120120606,
					"content": "К счастью, Сакудзиро вовремя услышал их приближение и сумел сбежать через окно. Комиссия Тэнрё не смогла его поймать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120607
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120120607,
					"content": "Это плохие новости. Я не думаю, что у Сакудзиро было достаточно времени, чтобы принять решение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120608
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120608,
					"content": "Ты видел, куда он побежал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120609
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120609,
					"content": "Комиссия Тэнрё определённо будет преследовать его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120610
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120610,
					"content": "Вы запомнили их имена?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120611
					]
				},
				{
					"id": 120120611,
					"content": "Имена, нам нужны имена! Такое внезапное появление должно быть делом рук Кэйсукэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120612
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120612,
					"content": "Обычно комиссия не поднимает такой шум из-за нелегального пересечения границы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120613
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120613,
					"content": "Извините, у меня плохой слух, да и я не очень хорошо их разглядел. Если вам интересно, в какую сторону они пошли, то они покинули город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120614
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120120614,
					"content": "Я не уловил их имен... Я ничего не расслышал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120615
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 120120615,
					"content": "Я расслышал имена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120616
					],
					"speakerTitle": "Морихико"
				},
				{
					"id": 120120616,
					"content": "Я забирал руду у своего друга и случайно столкнулся с ними по дороге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120617
					],
					"speakerTitle": "Морихико"
				},
				{
					"id": 120120617,
					"content": "Кажется, их лидера звали Кэйсукэ, как вы и сказали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120618
					],
					"speakerTitle": "Морихико"
				},
				{
					"id": 120120618,
					"content": "Я так и думала. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120619
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120619,
					"content": "Если Сакудзиро не принял решение, то их столкновение не только не решит проблему, но может обострить её и ничего нельзя будет исправить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120620
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 120120620,
					"content": "#Мы не можем этого допустить. Пойдём со мной, {NICKNAME}, надо их догнать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ёимия"
				}
			]
		},
