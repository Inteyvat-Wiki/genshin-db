			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Волчонок"
				],
				"points": [
					{
						"sceneId": 48000,
						"position": [
							38.876,
							0.239,
							22.069
						],
						"pointId": 7
					},
					{
						"sceneId": 48000,
						"position": [
							39.722,
							0.239,
							21.347
						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 706770101,
					"content": "Ой! У меня гости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770102
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706770102,
					"content": "Я ждал очень долго, но никто не приходил. Я решил вздремнуть, но кресло такое мягкое, что я провалился в сон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770103
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706770103,
					"content": "Ух ты! Говорящая игрушка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706770104,
					"content": "Ага, говорящая. Я умею говорить! Так, дайте подумать. Наверное, я должен представиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770105
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706770105,
					"content": "Дорогие гости, я... Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770106
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706770106,
					"content": "Кто же я?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770107
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706770107,
					"content": "Эм... А нам откуда знать... Ты что, ещё не проснулся как следует?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770108,
						706770109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706770108,
					"content": "Ты барон Кусьвольф.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770110
					]
				},
				{
					"id": 706770110,
					"content": "А? Серьёзно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770111
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706770111,
					"content": "#Да {NICKNAME} просто шутит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706770112,
					"content": "#Кстати, Паймон зовут Паймон, а это {NICKNAME}. Уф, отлично. По крайней мере, память в этой таинственной комнате не отшибает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706770113,
					"content": "Простите... Похоже, я спал слишком долго и видел так много снов, что теперь не могу понять, какой из них был настоящим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770114
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706770114,
					"content": "Так, надо сосредоточиться... Сейчас я консьерж, отвечающий за приём гостей. Да, зовите меня Волчонком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770115
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770115,
					"content": "Ладно. Но как сны могут быть настоящими? Ведь сны это просто игра твоего воображения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706770116,
					"content": "Вы хотите сказать, что игра воображения не может быть настоящей? Наверное, вы больше меня сведущи в таких вопросах. А я не вижу разницы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770117
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770117,
					"content": "И неважно, влачу ли я одинокое существование на бескрайних снежных равнинах, где страшное проклятие сковало моё сердце льдом, который невозможно растопить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770118
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770118,
					"content": "Или веселюсь с Белым клыком в туманном лесу, гоняюсь за золотыми бабочками, переправляюсь через рокочущие горные потоки, и лунный свет брызгами разлетается у меня из-под лап...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770119
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770119,
					"content": "Или иду в триумфальном шествии, осыпаемый разноцветным конфетти, и представляю, что её величество скоро удостоит меня награды! Какая честь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770120
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770120,
					"content": "Для меня такие сны неотличимы от реальности. А недавно мне приснилось, что я стою в испещрённом тропинками саду, и госпожа маг говорит мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770121
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770121,
					"content": "«Отныне ты будешь консьержем. Устраивай гостям тёплый приём».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770122
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770122,
					"content": "А потом я оказался здесь и, как уже говорил, провёл в ожидании целую вечность... Но вы наконец пришли! И теперь я смогу выполнить свои обязанности консьержа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770123
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770123,
					"content": "Вы хотели ещё что-то спросить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770124,
						706770131,
						706770139,
						706770147
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770124,
					"content": "Расскажи о госпоже маге...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770125
					]
				},
				{
					"id": 706770125,
					"content": "Кто она? Паймон понимает, что она тебе приснилась, но здесь явно кроется нечто большее. Как загадочно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706770126,
					"content": "Ну... госпожа маг это госпожа маг. Всё равно как гости это гости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770127
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770127,
					"content": "Она с подругами... Да! Её подруги тоже маги. Они все прекрасно владеют магией. Магия созидания, магия иллюзий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770128
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770128,
					"content": "У госпожи мага была волшебная чернильница, наполненная «фантастической реальностью». Я тайком лизнул немного - такая горечь... ух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770129
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770129,
					"content": "Но другим магам нравилась её магия, и с помощью магии созидания они превратили её «фантастическую реальность» в «реальную фантазию».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770130
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770130,
					"content": "Как им это удалось? Понятия не имею, ведь я всего лишь игрушка, и в голове у меня одна вата да нитки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770123
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770131,
					"content": "Расскажи об этой комнате...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770132
					]
				},
				{
					"id": 706770132,
					"content": "Да, что это за место такое? Мы вошли сюда через библиотечную дверь, которая раньше всегда была закрыта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706770133,
					"content": "Это особая комната, в которую можно попасть только по приглашению. Поздравляю, вы были приглашены!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770134
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770134,
					"content": "Раз вы здесь, то можете пригласить сюда и своих друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770135
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770135,
					"content": "Сейчас я быстренько наведу здесь порядок, приготовлю чай и десерты. Вы ведь не против сладкого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770136
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770136,
					"content": "Паймон точно не против... Стоп! Мы вообще где? Это всё ещё Мондштадт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706770137,
					"content": "Хм, сложный вопрос. Эту комнату наколдовала госпожа маг, а я ничего не смыслю в магии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770138
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770138,
					"content": "Но уверяю вас как консьерж, что здесь уютно и безопасно! Очень надеюсь, чтобы вы хорошо проведёте время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770123
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770139,
					"content": "Расскажи о той книге и о нашем сражении...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770140
					]
				},
				{
					"id": 706770140,
					"content": "Я видел! Прекрасное выступление! Глаз не отвести!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770141
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770141,
					"content": "...Выступление?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770142
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706770142,
					"content": "Госпожа маг говорила, что каждая страница книги есть фрагмент «реальности».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770143
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770143,
					"content": "Наверное, дело в том, что вы особые гости, и потому смогли занять на сцене место главных героев и великолепно выступить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770144
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770144,
					"content": "Захватывающие батальные сцены... добавляют некоторым историям остроты! Моё любимое чтение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770145
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770145,
					"content": "Как бы вы озаглавили сборник рассказов о своих великолепных выступлениях? Сага о войне? Эпос о яростных битвах? Рассказы о завоеваниях? Военный трактат? Непростой выбор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770146
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770146,
					"content": "Словом, надеюсь, вы и дальше будете радовать зрителей подобными представлениями... Нет, не так. Я настаиваю! Продолжайте в том же духе, оставьте после себя как можно больше историй о «настоящем»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770123
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770147,
					"content": "У меня больше нет вопросов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770148
					]
				},
				{
					"id": 706770148,
					"content": "Паймон кажется, что загадок стало только больше... Но Волчонок не похож на злодея, так что вряд ли мы в опасности. К тому же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770149
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706770149,
					"content": "Ведь мы хотим побывать в каждом уголке Тейвата. А такое под силу только самым отважным и смелым путешественникам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770150
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706770150,
					"content": "Ух ты! Слова, достойные настоящих искателей приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770151
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770151,
					"content": "Хи-хи, само собой! Мы же и есть настоящие искатели приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770152
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706770152,
					"content": "В самом деле? Как консьерж, я должен делать всё возможное, чтобы уставшие гости хорошо отдохнули и набрались сил для новых приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770153
					],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770153,
					"content": "Когда устанете, возвращайтесь сюда, чтобы отдохнуть. Я позабочусь, чтобы вы ни в чём не нуждались!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Волчонок",
					"speakerSubtitle": "«Консьерж»"
				},
				{
					"id": 706770109,
					"content": "Ты знаменитый почётный рыцарь, предмет всеобщего обожания.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770110
					]
				}
			]
		}
	]
}