			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кандакия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30230301,
					"content": "Если я могу что-нибудь для вас сделать, только скажите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230302
					],
					"speakerTitle": "Кандакия"
				},
				{
					"id": 30230302,
					"content": "Хоть я и не могу покинуть деревню Аару, но, когда я смотрю на вас, - сама не знаю почему - очень волнуюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230303
					],
					"speakerTitle": "Кандакия"
				},
				{
					"id": 30230303,
					"content": "Раньше я всегда сражалась одна, и даже представить не могла, что буду чувствовать такой духовный подъём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230304
					],
					"speakerTitle": "Кандакия"
				},
				{
					"id": 30230304,
					"content": "Мне кажется, в этом и заключается сила партнёрства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кандакия"
				}
			]
		},
		{
			"id": 302304,
			"completionStepIds": [],
