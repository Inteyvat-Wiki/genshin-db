			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дэхья"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30230401,
					"content": "Поручения последнее время были нелёгкими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230402
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 30230402,
					"content": "И кроме того, я просто не могу поверить, что этот титанический труд не принесёт никакой экономической выгоды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230403
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 30230403,
					"content": "Давайте думать о хорошем! Может, мы ещё разбогатеем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30230404,
					"content": "Тоже верно. Эх, вот если бы однажды ты проснулась богачом, что бы ты стала делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230405
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 30230405,
					"content": "Паймон накупила бы целую кучу всяких вкусняшек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30230406,
					"content": "И это всё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230407
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 30230407,
					"content": "Хм... А потом бы ещё что-нибудь попить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30230408,
					"content": "Ха-ха-ха, как мило!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230409
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 30230409,
					"content": "Ну что ж... Я сделаю всё возможное, чтобы наши прекрасные фантазии сбылись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230410
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 30230410,
					"content": "Надеюсь, всё, что мы будем делать дальше, изменит мир к лучшему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэхья"
				}
			]
		}
	]
