			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аль-Хайтам"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30230201,
					"content": "Не торопись. Такие великие дела не вершатся в одночасье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230202
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30230202,
					"content": "Подумай как следует. Нам надо убедиться, что план разумен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230203
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30230203,
					"content": "И он снова уткнулся в книгу! Эй! Ты слушаешь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30230204,
					"content": "Хочешь, одолжу тебе почитать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230205
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30230205,
					"content": "Спасибо, не надо. Твои книги не подходят для Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30230206,
					"content": "Шутка! Мои книги действительно не подходят для тебя и на руки не выдаются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230207
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30230207,
					"content": "Арр! Паймон вне себя от гнева!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 302303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
