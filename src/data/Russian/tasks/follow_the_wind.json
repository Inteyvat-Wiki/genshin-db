			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бэй Доу",
					"Паймон",
					"Каэдэхара Кадзуха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020401,
					"content": "Посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020402
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020402,
					"content": "Пропал... Глаз Бога пропал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020403
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020403,
					"content": "Что?! Кто-то его украл? Кто бы осмелился украсть его средь бела дня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20020404,
					"content": "Мы не знаем точно, когда его украли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020405
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020405,
					"content": "Не ожидала, что здесь есть кто-то достаточно смелый, чтобы перейти дорогу Бэй Доу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020406
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020406,
					"content": "Не стоит беспокоиться, даже самый искусный вор не избежит пристального ока природы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020407
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020407,
					"content": "Хм... Его украли недавно, вор не мог уйти далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020408
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020408,
					"content": "В качестве приза Глаз Бога предложил именно я, и я должен был за ним следить. И вернуть его тоже должен буду я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020409
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020409,
					"content": "Хорошо, раз ты настаиваешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020410
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020410,
					"content": "А я пока постараюсь успокоить толпу зрителей и болельщиков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020411
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020411,
					"content": "#Я хочу, чтобы ты {F#пошла}{M#пошёл} со мной, {NICKNAME}, если ты не возражаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020412,
						20020413
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020412,
					"content": "Ничего не поделаешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				},
				{
					"id": 20020414,
					"content": "Подождите, а мы-то на острове... Куда отсюда мог уйти вор?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20020415,
					"content": "Следуйте за мной. Я чувствую, как меняются ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020413,
					"content": "Мой соперник всё равно не явился.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				}
			]
		},
		{
			"id": 200209,
			"completionStepIds": [
				200209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200209",
							"2"
						],
						"stepId": 200209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Планерист Фэй",
					"Каэдэхара Кадзуха",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020901,
					"content": "Вы догнали меня... Это невозможно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020902
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020902,
					"content": "Я даже лодку заранее приготовил, но вы всё равно меня догнали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020903
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020903,
					"content": "Ни одна лодка не сможет плыть быстрее ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020904
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020904,
					"content": "Ветра? О чём ты вообще? О, понятно... Твой Глаз Бога!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020905
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020905,
					"content": "Проклятье, если бы у меня только был Глаз Бога... Или если бы я мог пробудить этот, вы бы за мной никогда не угнались!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020906
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020906,
					"content": "Глаз Бога тут ни при чём. Ты умело растворился в толпе, но совсем не попытался скрыться от ока природы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020907
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020907,
					"content": "К тому же выбранный тобой путь побега имеет множество недочётов. А ещё было забавно слышать твой надменный смех на ветру, пока мы шли по твоим следам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020908
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020908,
					"content": "Другими словами, три главных залога успешного ограбления: скорость, скрытность и стиль - оказались тебе неведомы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020909
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020909,
					"content": "Ты... Ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020910
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020910,
					"content": "Но больше всего разочаровывает вид Глаза Бога в твоих руках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020911
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020911,
					"content": "Оказывается, Глаз Бога не отвечает слепо на любые человеческие желания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020912
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020912,
					"content": "Ладно, хорошо! Я признаюсь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020913
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020913,
					"content": "Я давно хотел заполучить этот Глаз Бога, и записался на турнир после того, как услышал, что там будут участвовать только никчёмные бойцы. Я прошёл свой путь до финала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020914
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020914,
					"content": "Так это ты должен был быть нашим соперником на финале!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020915
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20020915,
					"content": "#Я хотел выиграть этот приз по правилам, полагаясь только на свои навыки. Но потом появил{F#ась}{M#ся} ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020916
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020916,
					"content": "После твоего боя в полуфинале я понял, что не выиграю. Но я не собирался вот так просто расставаться с Глазом Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020917
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020917,
					"content": "Не было толку выходить против тебя на бой. Вместо этого я решил использовать свои навыки с пользой, пока вы с Бэй Доу отвлекали толпу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020918
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020918,
					"content": "Я был уверен, что хорошо продумал свой путь отхода... но вы всё равно меня догнали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020919,
						20020921,
						20020927
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020919,
					"content": "Тебе некуда бежать. Сдавайся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020920
					]
				},
				{
					"id": 20020920,
					"content": "Проклятье! Всё должно было быть по-другому...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020923
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020923,
					"content": "Не сопротивляйся, будет только хуже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020924
					]
				},
				{
					"id": 20020924,
					"content": "Ха! Пустые угрозы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020928,
					"content": "#Хорошо... Не забывай, что ты дал{F#а} мне слово! Он всё равно не пробудился в моих руках, так что для меня это теперь обычная стекляшка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020929
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020929,
					"content": "А ты знал, что по законам моря за кражу вору полагается сломать руки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020930
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020930,
					"content": "Что?! Ты шутишь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020931
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020931,
					"content": "Ты украл главный приз турнира, не явился на финальный бой и испортил репутацию капитана Южного Креста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020932
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020932,
					"content": "Остаётся только выжечь на твоём лбу раскалённым клеймом слово «вор».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020933
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020933,
					"content": "Подожди, не надо, зачем так жестоко-то?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020934
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20020934,
					"content": "Никогда бы не подумал, что вы можете быть такими бесчеловечными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020935
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020935,
					"content": "Мне ничего не остаётся, кроме как сразиться с вами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020921,
					"content": "Отдай Глаз Бога.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020922
					]
				},
				{
					"id": 20020922,
					"content": "После всего, через что мне пришлось пройти? Ну уж нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020925
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020925,
					"content": "Делай, что мы говорим, и ты свободен.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020926
					]
				},
				{
					"id": 20020926,
					"content": "П-правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Планерист Фэй"
				},
				{
					"id": 20020927,
					"content": "Отдавай Глаз Бога и можешь идти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020928
					]
				}
			]
		},
		{
			"id": 200211,
			"completionStepIds": [
				200211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
