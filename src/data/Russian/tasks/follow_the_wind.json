						"stepId": 200212,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Чжу Хань",
					"Каэдэхара Кадзуха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20021201,
					"content": "Что? Бэй Доу уже ушла? Может, она вернулась на свой корабль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20021202,
					"content": "Вы ищете капитана? За ней прислала мисс Нин Гуан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021203
					],
					"speakerTitle": "Чжу Хань"
				},
				{
					"id": 20021203,
					"content": "Похоже, турнир Южного Креста наделал шума и привлёк её внимание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021204
					],
					"speakerTitle": "Чжу Хань"
				},
				{
					"id": 20021204,
					"content": "Капитан пробормотала что-то про то, что Нин Гуан - затычка в бочке, и отплыла к Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021205
					],
					"speakerTitle": "Чжу Хань"
				},
				{
					"id": 20021205,
					"content": "Ха-ха, у неё с Нин Гуан часто возникают недопонимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021206
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20021206,
					"content": "И всё же капитан была крайне расстроена тем, что не стала свидетелем коронации нового чемпиона, ведь она очень долго этого ждала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021207
					],
					"speakerTitle": "Чжу Хань"
				},
				{
					"id": 20021207,
					"content": "#Укравший Глаз Бога вор оказался человеком, который должен был сразиться с наш{F#ей}{M#им} геро{F#иней}{M#ем} в финальном раунде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021208
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20021208,
					"content": "Он знал, что проиграет бой, поэтому его сознанием завладела мысль о краже главного приза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021209
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20021209,
					"content": "Это может значить только одно: турнир Южного Креста завершается однозначным результатом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021210
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20021210,
					"content": "Значит, вот как!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021211
					],
					"speakerTitle": "Чжу Хань"
				},
				{
					"id": 20021211,
					"content": "#В таком случае согласно правилам он должен быть дисквалифицирован... и наш{F#а} геро{F#иня}{M#й} становится чемпионом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021212
					],
					"speakerTitle": "Чжу Хань"
				},
				{
					"id": 20021212,
					"content": "Паймон, конечно, была уверена в нашей победе, но не так она себе её представляла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20021213,
					"content": "Ничего страшного, твоя слава вполне заслужена. Подождите, сейчас я подготовлю медаль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021214
					],
					"speakerTitle": "Чжу Хань"
				},
				{
					"id": 20021214,
					"content": "Теперь вы поможете нам попасть в Инадзуму?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021215
					]
				},
				{
					"id": 20021215,
					"content": "Думаю, да. Я обязательно передам капитану, когда она вернётся. Она человек своего слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021216
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20021216,
					"content": "Но путешествие в Инадзуму будет крайне опасным. Весь путь вы будете наслаждаться непрекращающимся штормом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021217
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20021217,
					"content": "На самом деле, грозные ветра и дождь тоже являются воплощением воли сёгуна Райдэн закрыть доступ в своё царство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021218
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20021218,
					"content": "Погоди. Ты хочешь сказать, что она может менять погоду силой мысли?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20021219,
					"content": "Не будем забывать, что она одна из семи Архонтов. Если Моракс мог обрушивать с небес каменные копья, то нет ничего удивительного в том, что сёгун Райдэн способна призвать вечный шторм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021220
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20021220,
					"content": "Нужно подготовить «Алькор» к путешествию в Инадзуму, поэтому вам придётся немного подождать. Вас уведомят о том, что всё готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021221
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20021221,
					"content": "А я тем временем собираюсь отправиться в своё собственное путешествие. Я пройду по землям Ли Юэ в надежде найти способ пробудить Глаз Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021222
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20021222,
					"content": "Паймон уверена, что у тебя всё получится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20021223,
					"content": "Спасибо. Да будут наделены смыслом наши путешествия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021224
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20021224,
					"content": "И кое-что напоследок... Возможно, самая трудная часть пути ждёт вас ещё до вечного шторма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				}
			]
		},
