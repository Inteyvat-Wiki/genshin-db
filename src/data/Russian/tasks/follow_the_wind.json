		},
		{
			"id": 200202,
			"completionStepIds": [
				200202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200202",
							"2"
						],
						"stepId": 200202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бэй Доу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020201,
					"content": "Куда он запропастился...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020202
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020202,
					"content": "#Ничего страшного, давай сперва представим тебя зрителям, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020203
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020203,
					"content": "Слушайте все! Внимание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020204
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020204,
					"content": "Мы все этого ждали! Финальный бой турнира Южного Креста!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020205
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020205,
					"content": "После многих сражений и неожиданных событий на сегодняшней арене оказались два участника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020206
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020206,
					"content": "#Сначала я хочу представить вам первого участника. Вы все {F#её}{M#его} прекрасно знаете, хоть и мало кто видел {F#её}{M#его} вживую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020207
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020207,
					"content": "#{F#Она}{M#Он} вселяет страх в самого Осиала, а при упоминании {F#её}{M#его} имени даже у Предвестников Фатуи дрожат колени... Представляю вам странствующ{F#ую}{M#его} геро{F#иню}{M#я} Ли Юэ по имени {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020208
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020208,
					"content": "Урааа!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020209
					],
					"speakerTitle": "Участник"
				},
				{
					"id": 20020209,
					"content": "Дождались!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020210
					],
					"speakerTitle": "Участник"
				},
				{
					"id": 20020210,
					"content": "#Вы все видели, как зрелищно {F#она сражалась}{M#он сражался} в полуфинале.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020211
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020211,
					"content": "Но финальный бой будет ещё веселее и невероятнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020212
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020212,
					"content": "А наш следующий участник... Так и не появился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020213
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020213,
					"content": "Интересно, чем он так занят. Нельзя просто так не явиться и признать поражение... Это ведь финал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020214
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020214,
					"content": "Всем стоять! Давайте ещё подождём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020215,
						20020216
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020215,
					"content": "Может, он перепутал время?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				},
				{
					"id": 20020217,
					"content": "Если он так и не появится, нам придётся отложить бой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020218
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20020218,
					"content": "Подождите. Тут что-то не так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020219
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020219,
					"content": "Капитан, нам следует проверить приз. Коробку с Глазом Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020220
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020220,
					"content": "#{NICKNAME}, идём с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20020216,
					"content": "Может, он боится показаться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				}
			]
		},
		{
			"id": 200204,
			"completionStepIds": [
				200204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
