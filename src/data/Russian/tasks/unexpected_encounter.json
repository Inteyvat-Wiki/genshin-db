			"dialogs": [
				{
					"id": 3710101,
					"content": "#Ты же не всё им рассказал{F#а}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3710102,
					"content": "Кроме кристалла и дракона нам повстречался кое-кто ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710103,
						3710104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3710103,
					"content": "#Я хочу сам{F#а} с этим разобраться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710105
					]
				},
				{
					"id": 3710105,
					"content": "Да? Значит, ты помнишь о том парне в зелёной одежде!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3710106,
					"content": "Смотри! Это же он!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710107,
						3710111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3710107,
					"content": "Хм. Цвет очень похож.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710108
					]
				},
				{
					"id": 3710108,
					"content": "Ну да же? Да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3710109,
					"content": "Хм. Похоже, что это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3710110,
					"content": "Он и есть???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3710111,
					"content": "Это наш парень в зелёном!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710112
					]
				},
				{
					"id": 3710112,
					"content": "Ой!",
