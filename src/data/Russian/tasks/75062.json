						],
						"pointId": 10046
					}
				]
			},
			"dialogs": [
				{
					"id": 750620201,
					"content": "Да, это проклятое место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620202
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750620202,
					"content": "Не оставайтесь здесь. Уходите... Скорее, уходите, пока не пришёл чёрный прилив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620203
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750620203,
					"content": "Да, чёрный прилив. Эта огромная тень уже почти настигла нас. Мы должны... должны убедиться, что все добрались до безопасного места, что все... были благополучно эвакуированы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кенин"
				}
			]
		},
		{
			"id": 7506203,
