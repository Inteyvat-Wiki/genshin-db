			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Парвана"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220101,
					"content": "Этот рецепт должен быть таким...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220102
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220103
					]
				},
				{
					"id": 220220103,
					"content": "Я пытаюсь разобраться с рецептами. К сожалению, некоторые из них совсем плохо помню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220104,
						220220106
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220104,
					"content": "А почему бы тебе не спросить Сюй Дуна?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220105
					]
				},
				{
					"id": 220220105,
					"content": "Сюй Дун... Он и его «творческий подход» - главная причина, по которой у меня в голове всё перемешалось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220109,
					"content": "Каждый раз, когда ему в руки попадает новый рецепт, он будет следовать ему не более одного-двух дней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220110
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220110,
					"content": "Затем он... чего только не начнёт пробовать, чтобы улучшить их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220111,
						220220113
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220111,
					"content": "А зачем он так делает?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220112
					]
				},
				{
					"id": 220220112,
					"content": "По его словам, это для того, чтобы сделать их более дешёвыми... Но это звучит, как отговорка... Не знаю зачем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220118,
					"content": "Но в любом случае результаты говорят сами за себя. Он действительно был успешен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220119
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220119,
					"content": "Вкус похож на оригинальный, но стоимость производства до смешного низкая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220120
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220120,
					"content": "Его возмутительные методы приготовления пищи - это причина, по которой я согласилась работать с ним. А причина, по которой он согласился взять меня на работу, я думаю, заключается в моих навыках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220121,
						220220123
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220121,
					"content": "А что требуется от меня?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220122
					]
				},
				{
					"id": 220220122,
					"content": "Ах... упс! Я так увлеклась разговором о Сюй Дуне, что совсем отошла от темы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220128,
					"content": "В последнее время Сюй Дун достал меня с просьбами изменить рецепты. Он писал и рисовал прямо на них... Поэтому некоторые рецепты стали слишком трудночитаемыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220129
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220129,
					"content": "Я хочу точно восстановить эти рецепты и сохранить копию на случай, если таковая когда-нибудь понадобится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220130
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220130,
					"content": "#Путешественни{F#ца}{M#к}, если ты всё ещё помнишь их, то не мог{F#ла} бы ты мне помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220131,
						220220132
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220131,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220133,
					"content": "Спасибо. Значит, я разберусь с испорченными рецептами, а ты можешь исправить непонятные части...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220132,
					"content": "Конечно. Я настоящий знаток кухни Тейвата.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220123,
					"content": "Твои навыки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220124
					]
				},
				{
					"id": 220220124,
					"content": "Разве я тебе не рассказывала? Тема моего исследования в Академии - «идеальная приправа».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220125
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220125,
					"content": "Проще говоря, я хочу создать суперприправу, которая сделает любую еду вкусной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220126
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220126,
					"content": "Именно по этой причине я здесь - чтобы собрать информацию о различных кулинарных культурах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220127
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220127,
					"content": "Кхм, что-то я слишком заболталась. Давай вернёмся к теме рецептов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220113,
					"content": "А как именно он их улучшает?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220114
					]
				},
				{
					"id": 220220114,
					"content": "Ну... его способ отличается от других. Большинство поваров стараются сделать рецепт более изысканным, чтобы блюдо можно было продать по более высокой цене.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220115
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220115,
					"content": "Но у Сюй Дуна, похоже, совершенно другие принципы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220116
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220116,
					"content": "Например, он использовал картофель, грибы и некоторые другие дешёвые овощи, чтобы приготовить вегетарианское блюдо, которое по вкусу почему-то напоминало острую курицу на пару...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220117
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220117,
					"content": "Существует также упрощенная версия «Искушения адепта», приготовленная из картофеля, риса, чашечки лотоса, заоблачного перчика, теста и сырого мяса. Текстура и вкус в итоге оказались достаточно похожи на оригинальное блюдо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220106,
					"content": "Минуточку, но разве вы не всеядные гурманы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220107
					]
				},
				{
					"id": 220220107,
					"content": "Пожалуйста, больше не упоминай это прозвище при мне. Эти слова больше никогда не появятся в моих работах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220108
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 220220108,
					"content": "К тому же он и его «творческий подход» - главная причина, по которой у меня в голове всё перемешалось и я не могу вспомнить эти рецепты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Парвана"
				}
			]
		},
		{
