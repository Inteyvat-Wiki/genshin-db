						718080202
					],
					"speakerTitle": "Цзю"
				},
				{
					"id": 718080202,
					"content": "С тобой всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080203
					]
				},
				{
					"id": 718080203,
					"content": "Хочешь стать свидетелем Его воскрешения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080204
					],
					"speakerTitle": "Цзю"
				},
				{
					"id": 718080204,
					"content": "Ты немного рано... Но и не поздно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080205
					],
					"speakerTitle": "Цзю"
				},
				{
					"id": 718080205,
					"content": "Что она говорит? Ничего не понятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718080206,
					"content": "Эй, ты о чём?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080207
					]
				},
				{
					"id": 718080207,
					"content": "#Хе-хе. Ты ещё не заметил{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080208
					],
					"speakerTitle": "Цзю"
				},
				{
					"id": 718080208,
					"content": "Для тебя так даже лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080209
					],
					"speakerTitle": "Цзю"
				},
				{
					"id": 718080209,
					"content": "Иди. Когда Он воскреснет, ты всё поймёшь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзю"
				}
			]
		},
