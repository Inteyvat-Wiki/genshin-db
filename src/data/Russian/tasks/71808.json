			"dialogs": [
				{
					"id": 718080301,
					"content": "#Ты вернул{F#ась}{M#ся}. Как дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080302
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 718080302,
					"content": "О Южных небесных вратах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080303
					]
				},
				{
					"id": 718080303,
					"content": "Землетрясения, монстры, да ещё маленькая девочка... Может быть, она потерялась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080304
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 718080304,
					"content": "О словах девочки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080305
					]
				},
				{
					"id": 718080305,
					"content": "Что она сказала? Его воскрешение? Свидетель? Бред какой-то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080306
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 718080306,
					"content": "Обчитаются своих странных книжек... Ладно, я сейчас же пошлю кого-нибудь забрать малышку в город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080307
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 718080307,
					"content": "И землетрясения, и монстры... Надеюсь, с ней всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080308
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 718080308,
					"content": "Спасибо. Это тебе за помощь в нашей работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080309
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 718080309,
					"content": "Эх, как же много дел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзя И"
				}
