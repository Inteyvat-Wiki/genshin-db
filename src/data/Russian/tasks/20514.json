	"talks": [
		{
			"id": 2051401,
			"completionStepIds": [
				2051401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
