					"Энтони"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140301,
					"content": "#Ты наш{F#ла}{M#ёл} Анну?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140302
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140302,
					"content": "Она сидит на верхушке мельницы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140303
					]
				},
				{
					"id": 205140303,
					"content": "Мельницы?! Как эта ветреница там оказалась? Я за рыцарями Ордо Фавониус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140304
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140304,
					"content": "Она сказала, что скоро вернётся...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140305
					]
				},
				{
					"id": 205140305,
					"content": "#О. Кхм, вот как. Главное, что она цела и невредима. Ну ты меня и напугал{F#а}. Я уж подумал, она там застряла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140306
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140306,
					"content": "Спасибо тебе. Схожу-ка я за ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140307
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140307,
					"content": "Ишь ты, едва выздоровела, и сразу куролесить. Надо бы её проучить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		},
		{
			"id": 2051404,
