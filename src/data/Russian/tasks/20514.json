					"Сайрус"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140401,
					"content": "Хм, ну и дела... Ты здесь какими судьбами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140402
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 205140402,
					"content": "Ты тут случайно не видел одну девушку?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140403
					]
				},
				{
					"id": 205140403,
					"content": "Анну, что ли? Она как раз направлялась к вон той мельнице.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140404
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 205140404,
					"content": "Странно всё как-то. Я думал, она болеет. Откуда у неё вдруг взялось столько сил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140405
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 205140405,
					"content": "Она поздоровалась и побежала дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140406
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 205140406,
					"content": "Ты не знаешь, когда это она выздоровела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайрус"
				}
			]
		},
