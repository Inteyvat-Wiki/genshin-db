			"trigger": {
				"objectNames": [
					"Анна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140201,
					"content": "Как же тут высоко! Братец в жизни не догадается, где я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140202
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205140202,
					"content": "Эй, что ты тут делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140203
					]
				},
				{
					"id": 205140203,
					"content": "#Ох! Как ты сюда забрал{F#ась}{M#ся}, да ещё так тихо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140204
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205140204,
					"content": "#И как ты вообще меня наш{F#ла}{M#ёл}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140205
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205140205,
					"content": "Ну, я это, взяла и залезла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140206
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205140206,
					"content": "Мой брат ищет меня? Время пролетело так быстро, я и не заметила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140207
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 205140207,
					"content": "Ясненько. Я ещё немного побуду здесь и тут же вернусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				}
			]
		},
		{
			"id": 2051403,
			"completionStepIds": [
				2051403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
