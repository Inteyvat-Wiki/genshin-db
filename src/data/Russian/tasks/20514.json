				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Энтони"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140101,
					"content": "Как такое могло случиться?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140102
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140102,
					"content": "Что стряслось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140103
					]
				},
				{
					"id": 205140103,
					"content": "#Здравствуй. Хорошо, что ты приш{F#ла}{M#ёл}. Приняв лекарство того целителя, Анна понемногу стала поправляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140104
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140104,
					"content": "Раньше она болела и была так слаба, что почти не покидала постели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140105
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140105,
					"content": "Теперь она выздоровела и постоянно зовёт меня гулять. А отказать ей я не могу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140106
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140106,
					"content": "Но теперь эта гулёна и вовсе пропала. Помоги мне её разыскать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140107,
						205140110,
						205140113
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140107,
					"content": "Вот как... Ладно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140108
					]
				},
				{
					"id": 205140108,
					"content": "Я буду ждать здесь. Поспеши, прошу тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140109
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140109,
					"content": "Только поправилась, и сразу повесничать. Хоть бы с ней чего не случилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140116,
					"content": "Я обыскал весь город. Осталась Гильдия искателей приключений, но я совсем выбился из сил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140117
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140117,
					"content": "Стоит проверить и там. Может, Сайрус что-нибудь видел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140118
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140118,
					"content": "Надеюсь, ты найдёшь Анну. Иначе мне придётся опять искать её самому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140110,
					"content": "Вид у тебя довольно радостный.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140111
					]
				},
				{
					"id": 205140111,
					"content": "Радостный? Так, давай без шуток. Только она окрепла, тут же и упорхнула, что та бабочка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140112
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140112,
					"content": "Ох и влетит ей, когда она вернётся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140113,
					"content": "Она проголодается, и сразу придёт домой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140114
					]
				},
				{
					"id": 205140114,
					"content": "Моя сестра, по-твоему, что, кошка? К тому же она только выздоровела, и голодной ей ходить нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140115
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205140115,
					"content": "Ладно, ладно. Я найду её. Жди здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Энтони"
				}
			]
		},
		{
			"id": 2051402,
			"completionStepIds": [
				2051402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
