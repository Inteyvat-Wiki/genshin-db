				"points": []
			},
			"dialogs": [
				{
					"id": 111120501,
					"content": "А? Вы все здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111120502,
					"content": "Мы вот уже много лет собираемся вместе, чтобы вспомнить о давней дружбе и поговорить о прошлом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120503
					],
					"speakerTitle": "Маленький У"
				},
				{
					"id": 111120503,
					"content": "Наш родной городок разрушило бедствие, и возвращаться нам некуда. Теперь наш дом там, где друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120504
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120504,
					"content": "Я только что услышала, что вы ищете памятные вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120505
					],
					"speakerTitle": "Цун Цзы"
				},
				{
					"id": 111120505,
					"content": "Я занимаюсь изготовлением небесных фонарей в Ли Юэ. Думаю, ничто не будет напоминать обо мне лучше них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120506
					],
					"speakerTitle": "Цун Цзы"
				},
				{
					"id": 111120506,
					"content": "Пару дней назад я купила несколько превосходных осколков плаустрита. Сейчас они на складе у причала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120507
					],
					"speakerTitle": "Цун Цзы"
				},
				{
					"id": 111120507,
					"content": "Я уже поговорила с заведующим. Не могли бы вы сходить за ними?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120508
					],
					"speakerTitle": "Цун Цзы"
				},
				{
					"id": 111120508,
					"content": "#Они уже всё знают, {NICKNAME}. Мы скоро вернёмся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
