			},
			"dialogs": [
				{
					"id": 111120801,
					"content": "Спасибо вам за помощь. Они отличного качества. Подождите немного, остался последний шаг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120802
					],
					"speakerTitle": "Цун Цзы"
				},
				{
					"id": 111120802,
					"content": "Вот, готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120803
					],
					"speakerTitle": "Цун Цзы"
				},
				{
					"id": 111120803,
					"content": "Внутри фонаря я написала все пять наших имён. Знаете, каждый год во время Праздника морских фонарей мы запускаем их в небо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120804
					],
					"speakerTitle": "Цун Цзы"
				},
				{
					"id": 111120804,
					"content": "Что бы ни принесло нам будущее, и по какому бы пути мы ни пошли... Пока жив этот ритуал, мы останемся неизменны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120805
					],
					"speakerTitle": "Цун Цзы"
				},
				{
					"id": 111120805,
					"content": "Что же касается Большого Г... Мы обсудили и решили, что не будем вас расспрашивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120806
					],
					"speakerTitle": "Маленький У"
				},
				{
					"id": 111120806,
					"content": "Но, если сможете, то передайте ему, что... У нас всё хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120807
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120807,
					"content": "А всё, о чём мы когда-то говорили, сбылось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120808,
						111120809
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120808,
					"content": "Можете об этом не беспокоиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				},
				{
					"id": 111120810,
					"content": "Спасибо! Мы обязательно передадим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120811
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111120811,
					"content": "Большому Г повезло, что у него есть такие друзья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111120809,
					"content": "А я не стану расспрашивать, о чём именно вы «когда-то говорили».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				}
			]
		},
