			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Му Му"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120401,
					"content": "Ай, опять вы... Который раз повторяю, работа ритуального бюро мне не интересна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120402
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120402,
					"content": "Мэн рассказывал нам о тебе. Вы ведь с ним старые друзья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111120403,
					"content": "Да, это так. Помню, он недавно пошёл работать в ритуальное бюро «Ваншэн».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120404
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120404,
					"content": "Мы с остальными сразу поняли почему... Происшествие с Большим Г.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120405
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120405,
					"content": "Знаю, уговорами ему не помочь. Иногда отпускать прошлое слишком больно. Мне об этом хорошо известно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120406
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120406,
					"content": "Значит, вы пришли ко мне из-за Большого Г?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120407
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120407,
					"content": "Как ты догадался?! Мы ведь ещё ничего не сказали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111120408,
					"content": "Ха-ха, я ведь коммерсант и обязан быть чутким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120409
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120409,
					"content": "Все слышат имя «Му Му» и думают, что я тугодум. Когда я начинал собственное дело, то немало от этого натерпелся. Но... В итоге я преуспел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120410
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120410,
					"content": "Вот, возьмите. В наше время о такой шикарной коробке игрушек мечтал каждый ребёнок, но денег на неё ни у кого не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120411
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120411,
					"content": "А сейчас дела идут в гору, и в итоге я купил большую партию таких коробок. Можно сказать, сбылась мечта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120412
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120412,
					"content": "Ого, да ты богач, наверное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111120413,
					"content": "Ха-ха... Для меня это память о давно ушедшем детстве. Без неё не было бы нынешнего меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120414
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120414,
					"content": "Раз меня вы уже нашли, вам ещё нужно к Маленькому У и Цун Цзы, так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120415
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120415,
					"content": "Угу. С Маленьким У мы уже виделись, осталась Цун Цзы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111120416,
					"content": "Ясно. Мы с Цун Цзы договаривались встретиться на торговой площади Фэйюнь над лестницей, что ведёт к пристани.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120417
					],
					"speakerTitle": "Му Му"
				},
				{
					"id": 111120417,
					"content": "Я закончу одно дельце и сразу же туда отправлюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Му Му"
				}
			]
		},
		{
