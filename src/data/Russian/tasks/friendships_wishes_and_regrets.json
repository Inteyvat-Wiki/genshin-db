					"Маленький У"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120301,
					"content": "Отлично. Этого достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120302
					],
					"speakerTitle": "Маленький У"
				},
				{
					"id": 111120302,
					"content": "Я займусь острой курицей на пару. Вам, наверное, ещё нужно к остальным ребятам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120303
					],
					"speakerTitle": "Маленький У"
				},
				{
					"id": 111120303,
					"content": "Когда у них всё будет готово, я отдам блюдо вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120304
					],
					"speakerTitle": "Маленький У"
				},
				{
					"id": 111120304,
					"content": "Хорошо! До скорого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111120305,
					"content": "(А? Как он узнал?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1111204,
