						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100301,
					"content": "Альбедо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100302,
					"content": "Привет! Это снова мы!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100303
					]
				},
				{
					"id": 412100303,
					"content": "Хм? Вам что-то нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100304
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100304,
					"content": "Заблудились?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100305
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100305,
					"content": "Ничего подобного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100306,
						412100307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100306,
					"content": "Сахароза поручила нам выяснить твою тайну.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				},
				{
					"id": 412100308,
					"content": "Что? Тайну?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100309
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100309,
					"content": "Эй! Что это ты делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100310,
					"content": "Зачем ты рассказываешь?! Нам ведь нужно было провести скрытное расследование!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100311,
					"content": "Так или иначе, Альбедо бы заметил.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100312
					]
				},
				{
					"id": 412100312,
					"content": "Ох... Да, но всё же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100313,
					"content": "На самом деле, хорошо, что вы пришли. У меня тоже есть к вам дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100314
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100314,
					"content": "Лови!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100315
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100315,
					"content": "Хм? Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100316,
					"content": "Меч, как видите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100317,
						412100318
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100317,
					"content": "Решил заняться кузнечным делом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100319,
					"content": "Не я его выковал. Однако я нанёс на него несколько алхимических штрихов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100320
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100320,
					"content": "Хочешь его испытать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100321
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100321,
					"content": "Ты даришь его мне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100322
					]
				},
				{
					"id": 412100322,
					"content": "Согласно моему исследованию, этот меч обладает некоторым... особыми свойствами. Только ты можешь им воспользоваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100323
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100323,
					"content": "Но мне нужно собрать данные о нём, и срочно, поэтому могу я попросить тебя испытать его в бою?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100324
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100324,
					"content": "Погоди-погоди. Почему только один человек может пользоваться этим мечом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100325,
					"content": "Есть какие-то побочные эффекты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100326
					]
				},
				{
					"id": 412100326,
					"content": "Вы проницательны. Этот меч действительно необычен - на нём лежит некое проклятие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100327
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100327,
					"content": "#Обычный человек не смог бы даже взять его в руки. Но ты особенн{F#ая}{M#ый}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100328
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100328,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100329,
					"content": "Точнее, только у тебя есть иммунитет к этому проклятию. Поэтому, кто же ещё мне поможет, как не ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100330
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100330,
					"content": "В общем, разговоры не дадут никакого результата. Пойди поищи в округе чудовищ. В конце концов, некоторые вещи познаются только на практике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100318,
					"content": "Все алхимики разбираются в ковке оружия?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100307,
					"content": "Сахароза сказала, что ты скрываешь невообразимую тайну.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				}
			]
		},
		{
			"id": 4121004,
			"completionStepIds": [
				4121006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121006",
							"2"
						],
						"stepId": 4121006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Свирепый мужик"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100401,
					"content": "#Нашёл! Он у вон то{F#й}{M#го} мелко{F#й}{M#го}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100402
					],
					"speakerTitle": "Свирепый мужик"
				},
				{
					"id": 412100402,
					"content": "Отдай, воришка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100403
					],
					"speakerTitle": "Свирепый мужик"
				},
				{
					"id": 412100403,
					"content": "Похитители сокровищ? А вам тут не холодновато?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100404,
					"content": "Хватит болтать! Отдавай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100405
					],
					"speakerTitle": "Свирепый мужик"
				},
				{
					"id": 412100405,
					"content": "А-а-а! Поберегись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				}
			]
		},
		{
			"id": 4121005,
			"completionStepIds": [
				4121008
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121008",
							"2"
						],
						"stepId": 4121008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100501,
					"content": "Теперь Похитители сокровищ называют нас воришками! От воришек слышим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100502,
					"content": "Они очень быстро объявились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100503,
						412100504
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100503,
					"content": "Альбедо, это ты вор, о котором они говорили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				},
				{
					"id": 412100505,
					"content": "Конечно, нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100506
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100506,
					"content": "Кажется, они говорили об этом мече. Что происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100507,
					"content": "Почему вы так смотрите на меня? Само собой, я его не крал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100508
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100508,
					"content": "Не так давно рыцари Ордо Фавониус арестовали группу Похитителей сокровищ недалеко от города. Они также конфисковали всё, что те незаконно перевозили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100509
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100509,
					"content": "Среди этих вещей был и этот меч. Мы думали, что его у кого-то украли, но никто не признал его своим, и откуда он взялся, мы тоже не смогли выяснить. Поэтому он остался пылиться на складе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100510
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100510,
					"content": "Я случайно заметил его, когда пришёл на склад за другой вещью. Честно говоря, такой старый меч вряд ли пригодился бы где-то, кроме алхимии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100511
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100511,
					"content": "Что? Как можно вот так присваивать краденые вещи?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100512,
					"content": "И что потом? Ты просто взял его с собой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100513,
					"content": "Да, я хотел провести над ним несколько экспериментов, но в ходе исследований неожиданно узнал его историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100514
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100514,
					"content": "Этот древний меч был выкован неким ныне покойным кузнецом. Это легендарный магический меч.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100515
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100515,
					"content": "Магический меч?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100516
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100516,
					"content": "Говорят, кузнец пропал почти сразу после того, как закончил меч, а сам клинок оказался утерян на долгие века.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100517
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100517,
					"content": "Раз его изъяли из краденых вещей, значит, вероятнее всего, он был украден Похитителями сокровищ, а потому и считался утраченным до настоящего времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100518
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100518,
					"content": "То есть его создатель просто исчез?! Звучит жутко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100519
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100519,
					"content": "Неудивительно, что меч проклят!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100520,
					"content": "Именно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100521
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100521,
					"content": "Удивительно, что человек мог создать такой волшебный меч...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100522
					]
				},
				{
					"id": 412100522,
					"content": "Знаешь ли ты историю о <color=#00E1FFFF>Дурине</color> и этой горе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100523
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100523,
					"content": "<color=#00E1FFFF>Дурин</color> - это чёрный дракон, который сотни лет назад угрожал Мондштадту и был затем сражён совместными усилиями <color=#00E1FFFF>Двалина</color> и <color=#00E1FFFF>Анемо Архонта Барбатоса</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100524
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100524,
					"content": "После жестокой битвы поверженный Дурин рухнул здесь, в эту толщу снега.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100525
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100525,
					"content": "Снег на вершине гор не тает никогда, и это очень удивительный феномен. Он наводит на мысль: случайно ли упал сюда Дурин, или это было спланировано?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100526
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100526,
					"content": "Думаешь, это могло быть спланировано?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100527
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100527,
					"content": "Может быть, это место было выбрано его могилой, чтобы силы вечных льдов могли сдержать яд разложения, источаемый телом Дурина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100528
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100528,
					"content": "Вполне вероятно, что Барбатос решил выбрать этот вариант.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100529
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100529,
					"content": "Ай да Барбатос...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100530
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100530,
					"content": "Это всего лишь мои ничем не подтверждённые догадки. Но мы можем быть уверены, что эти горы тесно связаны с Дурином.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100531
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100531,
					"content": "На самом деле, я думаю, что в этом самом мече содержатся частички Дурина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100532
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100532,
					"content": "Частички дракона?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100533
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100533,
					"content": "Верно. Глаза, когти и чешуя мёртвого дракона были смолоты в пыль, которую затем нанесли на клинок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100534
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100534,
					"content": "Таким образом яд разложения Дурина проник в меч, став источником его силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100535
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100535,
					"content": "Это вершина кузнечного искусства. Закончив клинок, кузнец был так счастлив, что, должно быть, решил испытать его сам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100536
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100536,
					"content": "Стоило ему вступить с этим мечом в бой, как энергия разложения устремилась вверх по рукояти и вошла в его тело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100537
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100537,
					"content": "Простые смертные не могут сопротивляться этой силе. Проклятый и сошедший с ума кузнец бежал в приступе помешательства, и, возможно, перенеся множество страданий, встретил свой конец в никому не известном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100538
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100538,
					"content": "Ого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100539
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100539,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100540
					]
				},
				{
					"id": 412100540,
					"content": "У тебя получилось очистить слёзы Двалина, а это очень редкий дар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100541
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100541,
					"content": "Эта сила означает, что ты не только не получишь вреда от тьмы и разъедающего яда, но и сможешь их нейтрализовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100542
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412100542,
					"content": "Поэтому только ты можешь верно распорядиться этим клинком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100543
					],
					"speakerTitle": "Альбедо"
				},
				{
