			]
		},
		{
			"id": 4121002,
			"completionStepIds": [
				4121002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121002",
							"2"
						],
						"stepId": 4121002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сахароза"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100201,
					"content": "Ой, это же Сахароза!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100202,
					"content": "Ты тоже пришла исследовать снежные горы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100203,
					"content": "Ах! Вы меня напугали... Пожалуйста, не надо пугать меня, когда я раздумываю над исследовательским докладом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100204
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100204,
					"content": "Но ты просто стояла здесь и смотрела в одну точку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100205,
					"content": "Н-нет, неправда! Я пыталась придумать название для нового подвида цветка-сахарка. Его семена в четыре раза больше обычных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100206,
						412100207
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100206,
					"content": "В четыре раза? Звучит вкусно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				},
				{
					"id": 412100208,
					"content": "Ох, тебе интересно? Замечательно! Давай я тебе покажу плоды своей работы в следующий раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100209
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100209,
					"content": "Эх, если бы я не пошла на эту гору, я бы взяла с собой несколько образцов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100210
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100210,
					"content": "Ну да! Разве ты не проводила свои исследования в городе? Как ты здесь оказалась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100211,
					"content": "Мы с Тимеем помогали Альбедо упорядочивать данные экспериментов. Вообще-то, Тимей только что ушёл. Вы с ним не пересеклись по пути?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100212
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100212,
					"content": "Не-а.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100213,
					"content": "Он сказал, что ему далеко до Альбедо, когда дело доходит до работы с данными. На самом деле, ему очень и очень далеко до Альбедо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100214
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100214,
					"content": "Есть некоторые вещи, которые Альбедо схватывает на лету, в то время как нам, чтобы их понять, требуется относительно много времени. Боюсь, это из-за разницы в опыте и эрудиции...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100215
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100215,
					"content": "После всего этого Тимей очень расстроился и сказал, что пойдёт прогуляться, поэтому я осталась здесь, чтобы довести работу до конца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100216
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100216,
					"content": "(Выглядит так, будто он нарочно так с ней поступает...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100217
					]
				},
				{
					"id": 412100217,
					"content": "На самом деле, я тоже собиралась пойти осмотреться вокруг, как закончу работы, но неожиданно нашла в отчёте интересные данные!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100218
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100218,
					"content": "Но, кажется... мне придётся подождать с раскрытием научных тайн...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100219
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100219,
					"content": "Тайны? Ох, что за тайны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100220,
					"content": "Ах? ...Хм, а у вас есть свободное время?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100221
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100221,
					"content": "Есть! Мы как раз ничегошеньки не делаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100222,
					"content": "Могу я попросить вас помочь мне? Мне кажется, что... Альбедо скрывает что-то от нас с Тимеем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100223
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100223,
					"content": "Разве Альбедо не ваш учитель? Какие у учителя могут быть секреты от учеников?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100224,
					"content": "Да, но, похоже, у него есть какой-то секрет... Я думаю, это какой-то великий алхимический секрет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100225
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100225,
					"content": "Подожди. Почему ты так уверена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100226,
					"content": "Мы с Тимеем очень увлечены алхимическими исследованиями. Если у господина Альбедо есть что-то ещё, ему не нужно скрывать это от нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100227
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100227,
					"content": "Хм... Справедливо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100228,
					"content": "Помоги мне узнать, что скрывает Альбедо, пожалуйста! Мне... действительно очень-очень интересно! Ну, пожалуйста!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100229
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100229,
					"content": "Хм... Что ты думаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100230,
						412100231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100230,
					"content": "Раз Сахарозе интересно, давай поможем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100232,
					"content": "Ура! Замечательно! Спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100233
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412100233,
					"content": "Да ладно тебе! Ну что, за дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412100231,
					"content": "Мне тоже интересно, какую тайну скрывает Альбедо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100207,
					"content": "Это же можно есть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				}
			]
		},
		{
			"id": 4121003,
