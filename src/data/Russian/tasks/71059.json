					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590301,
					"content": "Так вы вернулись. У меня тут ещё осталась огненная вода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590302
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590302,
					"content": "Ха-ха, я не предлагаю вам со мной пить. Если вас ранят, то огненной водой можно промывать раны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590303
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590303,
					"content": "Ну как? Есть новости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590304
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590304,
					"content": "Мы вот что нашли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7105904,
