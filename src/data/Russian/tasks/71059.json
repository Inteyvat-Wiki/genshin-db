			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катарина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580601,
					"content": "Мне нужно отдохнуть. Болят старые раны... Извини.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580602
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580602,
					"content": "Если что, приходи в другой раз... У меня как раз есть к тебе просьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катарина"
				}
			]
		},
		{
			"id": 7105901,
			"completionStepIds": [
				7105901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105901",
							"2"
						],
						"stepId": 7105901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Катарина",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590101,
					"content": "А вот и вы! Будьте как дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590102
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590102,
					"content": "Извините, в прошлый раз я вас второпях выставила и даже не объяснила, что мне от вас нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590103,
						710590104
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590103,
					"content": "Ничего страшного. Я слушаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590107
					]
				},
				{
					"id": 710590107,
					"content": "Успокойтесь, ничего плохого я не попрошу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590108,
						710590109
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590108,
					"content": "Тогда рассказывай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590113
					]
				},
				{
					"id": 710590113,
					"content": "Дело такое... Мой Коля... Мой соратник Николай не выходит на связь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590114
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590114,
					"content": "И вот... я хочу попросить вас поискать его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590115
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590115,
					"content": "Если он ещё жив, то верните его, пожалуйста. Если он погиб... я должна знать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590116
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590116,
					"content": "Мне правда неловко просить вас о таком деле... но я надеюсь, что вы подумаете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590117
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590117,
					"content": "Ну... Паймон думала, что ты хочешь, чтобы мы помогли тебе в плохом деле! Миллелитам свинью подложить или типа того...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710590118,
					"content": "Миллелитам... Зачем? Фатуи ничего хорошего от вражды с ними нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590119
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590119,
					"content": "Что ты хочешь этим сказать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590120
					]
				},
				{
					"id": 710590120,
					"content": "Да я сама уже ничего не понимаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590121
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590121,
					"content": "Погодите... Кажется, до меня дошло... Мы плохо обошлись с жителями Ли Юэ на поверхности?.. Вот почему прервались наши поставки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590122
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590122,
					"content": "Ужасно... Что же случилось на поверхности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590123,
						710590124
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590123,
					"content": "Это долгая история...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590125,
					"content": "Хм... Об этом попозже поговорим. Война есть война... друзья быстро сменяются врагами, и это та реальность, в которой живут Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590126
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590126,
					"content": "Но сейчас... По крайней мере, сейчас я переживаю только за Колю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590127
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590127,
					"content": "Во время нашего отступления он отделился от отряда... Позже я вернулась, чтобы разыскать его, и в итоге сама отстала от остальных. Какой позор...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590128
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590128,
					"content": "Место, где его видели в последний раз... Я могу отметить его на карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590129
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590129,
					"content": "Там он отделился от нас, хотел отвлечь преследующего врага... Он был хорошим бойцом, и я знала, что он не погибнет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590130
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590130,
					"content": "Надеюсь, он оставил там зацепки... Я очень на это надеюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590124,
					"content": "Это вы всю кашу заварили...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590109,
					"content": "Ты точно не заставишь нас проворачивать гнусные делишки Фатуи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590110
					]
				},
				{
					"id": 710590110,
					"content": "И да, если мы будем делать хорошие дела, а для вас, злодеев, они окажутся плохими, то не смей нас останавливать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710590111,
					"content": "Хорошие дела... плохие... мне вас останавливать?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590112
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590112,
					"content": "Ох, какие же вы сложные. Сначала выслушайте меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590113
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590104,
					"content": "Да ладно, мы ещё ни на что не соглашались.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590105
					]
				},
				{
					"id": 710590105,
					"content": "Кстати, ты же Фатуи! Если попросишь нас сделать что-то плохое, то мы не будем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710590106,
					"content": "Пфф... ну да, ну да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590107
					],
					"speakerTitle": "Катарина"
				}
			]
		},
		{
			"id": 7105902,
