					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7105909",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катарина",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590401,
					"content": "А вот и вы. Что-нибудь нашли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590402
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590402,
					"content": "Если нет, то нет. Располагайтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590403
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590403,
					"content": "Не обращайте внимание... Я вовсе не нервничаю. Я всё равно собираюсь остаться здесь до старости, и, возможно, мне придётся просить вас оформить за меня пенсию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590404
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710590404,
					"content": "Вот же ты лентяйка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710590405,
					"content": "Ну, если вы не найдёте ничего нового, я буду бездельничать здесь до старости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катарина"
				}
			]
		},
		{
			"id": 7105906,
			"completionStepIds": [
				7105907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105907",
							"2"
						],
						"stepId": 7105907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590603,
					"content": "Хм... Значок... Тот парень Фатуи оставил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590601
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710590601,
					"content": "Ох... тут же никого нет. И что же мы скажем Кате?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710590602,
					"content": "Что ж, Паймон думает, что мы тут уже не поможем. Идём обратно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7105913,
			"completionStepIds": [
				7105909
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105909",
							"2"
						],
						"stepId": 7105909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катарина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591305,
					"content": "Это... значок сержанта, походный дневник и... заметки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591306
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591306,
					"content": "Пожалуйста, скажите, где Коля? Он жив?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591307,
						710591308
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591307,
					"content": "Мы его не нашли, но, возможно, он ещё жив.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				},
				{
					"id": 710591309,
					"content": "Коля никогда бы не бросил меня и не дезертировал. Я просто знаю это. Битвами его не напугать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591310
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591310,
					"content": "Где вы всё это нашли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591311
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591311,
					"content": "Пещера на юго-востоке. Дай-ка отмечу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591312
					]
				},
				{
					"id": 710591312,
					"content": "Это жуткое место, которое кишит чудовищами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710591313,
					"content": "Спасибо... Спасибо вам. Я... извиняюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591314
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591314,
					"content": "Я... лучше я буду думать, что Коля погиб. Лучше бы было так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591315
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591315,
					"content": "Коля... Не опозорь Царицу, не опозорь меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591316
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591316,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591317
					]
				},
				{
					"id": 710591317,
					"content": "Кхм-кхм... Простите! Распустила тут нюни... Я только что вспомнила, что не успела поблагодарить вас как следует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591318
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591318,
					"content": "Кстати, вот огненная вода... Ох, вы же не пьёте, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591319
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591319,
					"content": "У меня есть немного моры... и кое-какие материалы, которые я насобирала. Сейчас они мне ни к чему, так что возьмите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591320,
						710591321
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591320,
					"content": "А что ты будешь делать дальше?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591322,
					"content": "Что дальше? Спасибо за заботу, но мне больше не нужно просить вас о помощи с плохими делами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591323
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591323,
					"content": "Да... возможно я отправлюсь на поиски Коли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591324
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591324,
					"content": "Письмо, которое он прислал мне перед переброской отряда, я до сих пор храню при себе... Для меня это последнее свидетельство того, что он все ещё на этой земле. Оно навсегда останется со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591325
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591325,
					"content": "Если он ещё жив... как Фатуи, верная Царице, я буду охотиться за головой этого предателя, где бы он ни скрылся и сколько бы ни прятался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591326
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591326,
					"content": "Если он погиб... как его сестра, я тоже встречу судьбу, которая неизбежно постигает каждого Фатуи, и буду гордиться им.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591327
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591327,
					"content": "Девиз «кто, если не мы» значит, что и жизнь свою мы должны отдать без колебаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591328,
						710591330
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591328,
					"content": "Что, если ты замышляешь злое, и мне нужно тебя остановить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591329
					]
				},
				{
					"id": 710591329,
					"content": "...всегда наступает момент, когда нет выбора, и все мы должны делать то, что должны, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591333,
					"content": "Ладно-ладно... сколько серьёзности... Детей, которые ещё недостаточно взрослые, чтобы пить, всегда заботят такие странные вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591334
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591334,
					"content": "Давай поговорим об этом, когда нам придётся делать выбор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591335
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591335,
					"content": "Но сейчас я собираюсь отдохнуть... Не хочешь тоже вздремнуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591336
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591336,
					"content": "Здесь только один тюфяк, как же на нём уместиться? Ты же явно пытаешься нас выставить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591337
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710591337,
					"content": "Ну, это как посмотреть. Так что как пожелаете, ха-ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591338
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591338,
					"content": "В любом случае я очень вам благодарна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591330,
					"content": "Тебе обязательно всегда думать, как Фатуи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591331
					]
				},
				{
					"id": 710591331,
					"content": "Да. А что не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591332
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591332,
					"content": "Идеи, точки зрения... Это так скучно! Пфф... под моей маской не только идеи, но и страх перед пулями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710591321,
					"content": "Тебе нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591308,
					"content": "Вероятно, он сбежал через тайный ход.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				}
			]
		},
		{
			"id": 7105914,
			"completionStepIds": [
				7105908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591401,
					"content": "«...мне удалось войти в эту тайную комнату, а огромный механический монстр всё ещё бродил снаружи, словно свирепый хищник, поджидая, пока я выйду наружу...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591402
					],
					"speakerTitle": "Записка младшего сержанта Николая"
				},
				{
					"id": 710591402,
					"content": "«...моя левая нога повреждена и жутко болит. Я наспех перебинтовал её, но она опухла. Наверное, попала инфекция...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591403
					],
					"speakerTitle": "Записка младшего сержанта Николая"
				},
				{
					"id": 710591403,
					"content": "«...в этой пещере есть ещё один выход, но я не знаю, куда он ведёт. Он выглядит таким хрупким, что, кажется, рухнет от одного толчка, если его не подпереть...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591404
					],
					"speakerTitle": "Записка младшего сержанта Николая"
				},
				{
					"id": 710591404,
					"content": "«Меня заметили, кто-то идёт. Это... мечник... в чёрном?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591405
					],
					"speakerTitle": "Записка младшего сержанта Николая"
				},
				{
					"id": 710591405,
					"content": "«...он, нет, оно?.. Кажется, что даже прочная металлическая решётка его не остановит. Это ясно по одному только его виду...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591406
					],
					"speakerTitle": "Записка младшего сержанта Николая"
				},
				{
					"id": 710591406,
					"content": "«Прости меня, Катя».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Записка младшего сержанта Николая"
				}
			]
		}
	]
}