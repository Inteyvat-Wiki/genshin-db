				]
			},
			"dialogs": [
				{
					"id": 711630301,
					"content": "Что происходит? Как мы здесь оказались!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630302,
					"content": "Ну как? Вам понравился мой подарок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630303
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630303,
					"content": "Цзы Бай, вот ты где! Что это за зонтик такой? Он взял и перенёс нас сюда, мы даже моргнуть не успели!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630304,
					"content": "Похоже, не у одной меня провалы в памяти. Вы что, забыли наши полёты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630305
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630305,
					"content": "Теперь вспомнили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630306
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630306,
					"content": "О! Это... это же лунная колесница! Вот почему она показалась Паймон такой знакомой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630307,
					"content": "Хе-хе, это всего лишь копия, которую я создала по памяти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630308
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630308,
					"content": "#А всё благодаря нефритовой инсигнии, которую {F#принесла путешественница}{M#принёс путешественник}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630309
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630309,
					"content": "#Ого! Так вот какую вещицу ты обещала смастерить для {F#путешественницы}{M#путешественника}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630310,
					"content": "Именно. Эта нефритовая колесница сможет быстро доставить вас туда, куда пожелаете. Уверена, она не раз выручит вас во время путешествия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630311
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630311,
					"content": "Прошу, примите её, мои добрые проводники.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630312
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630312,
					"content": "Невероятно... Паймон думала, тебе это просто к слову пришлось... И даже не ждала никакого подарка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630313,
					"content": "Я думала, что это займёт больше времени, ведь нефритовая инсигния была сильно повреждена, и вся её духовная сила давно рассеялась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630314
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630314,
					"content": "К счастью, мы находимся в долине Чэньюй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630315
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630315,
					"content": "А при чём тут долина Чэньюй?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630316,
					"content": "Ты знаешь, где именно мы сейчас стоим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630317
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630317,
					"content": "Эм... в порту Илун?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630318,
					"content": "Хе-хе, ты пока мало знаешь об этих местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630319
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630319,
					"content": "Земля под нашими ногами - один из ключевых узлов артерий земли Ли Юэ, и всего таких узлов восемь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630320
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630320,
					"content": "Жизнь, Смерть, Покой, Тайны, Начало, Земля, Ужас и Раны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630321
					]
				},
				{
					"id": 711630321,
					"content": "Ты знаешь эти места лучше, чем я предполагала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630322
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630322,
					"content": "О! Паймон тоже вспомнила! Это восемь врат артерий земли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630323,
					"content": "Верно. Сейчас мы стоим в самом центре Врат жизни, это самые благоприятные врата из восьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630324
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630324,
					"content": "Врата жизни отвечают за рост и процветание, возрождение всего сущего. Именно поэтому я смогла быстро восполнить духовную силу нефритовой инсигнии и создать эту колесницу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630325
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630325,
					"content": "Ух ты, вот как это работает! Похоже, долина Чэньюй и в самом деле край чудес...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630326,
					"content": "Да... Вам следует поселиться здесь, дабы жить в мире и спокойствии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630327
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630327,
					"content": "Что? Почему нам?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630328
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630328,
					"content": "Нет, это я так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630329
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630329,
					"content": "Ладно, я своё дело сделала. Больше вас отвлекать не смею.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630330
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630330,
					"content": "Я хочу ещё побродить по горам. Здесь мы расстанемся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630331
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630331,
					"content": "Спасибо, Цзы Бай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630332
					]
				},
				{
					"id": 711630332,
					"content": "#Не благодари. Ты разбудил{F#а} меня, это я перед тобой в долгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630333
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630333,
					"content": "Это заслуга Чжун Ли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630334
					]
				},
				{
					"id": 711630334,
					"content": "Я сказала ему то же, что и тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630335
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630335,
					"content": "И от него я узнала, что у тебя впереди ещё долгий путь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630336
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630336,
					"content": "Следующей остановкой на твоём пути будет далёкая страна, укрытая снегами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630337
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630337,
					"content": "Да, мы собираемся в Снежную.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630338
					]
				},
				{
					"id": 711630338,
					"content": "Снежная... Хоть я и не знаю, что это за место, но льды и снега таят для путников много опасностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630339
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630339,
					"content": "#{NICKNAME}, если тебе понадобится помощь, ты знаешь, где меня найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630340
					],
					"speakerTitle": "Цзы Бай"
				},
				{
					"id": 711630340,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630341
					]
				},
				{
					"id": 711630341,
					"content": "Береги себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзы Бай"
				}
			]
		}
	]
}