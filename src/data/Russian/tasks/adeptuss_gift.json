			"dialogs": [
				{
					"id": 711630201,
					"content": "Похоже, Цзы Бай нигде нет. Но она ведь сама нас сюда позвала? Куда же она подевалась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630202,
					"content": "Ой! Знакомый зонтик... Где же Паймон его видела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630203,
					"content": "Наверное, это зонтик Цзы Бай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630204
					]
				},
				{
					"id": 711630204,
					"content": "Да, наверное... но почему она оставила его у двери?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630205,
					"content": "У неё память плохая...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630206
					]
				},
				{
					"id": 711630206,
					"content": "Что же нам делать? Если так пойдёт дальше, однажды она сядет за стол и забудет, как держать палочки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630207,
					"content": "Эх, надо её найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630208,
					"content": "Подожди... кажется, это не зонтик.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630209
					]
				},
				{
					"id": 711630209,
					"content": "Если не зонтик, то что? Хм... Дай-ка Паймон посмотрит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711630210,
					"content": "А-а-а!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7116303,
