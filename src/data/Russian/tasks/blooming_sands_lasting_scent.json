			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нермин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420101,
					"content": "Это уж точно станет сюрпризом для Раефа, хи-хи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420102
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420102,
					"content": "Что за сюрприз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420103
					]
				},
				{
					"id": 230420103,
					"content": "А! Не пугай меня так!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420104
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420104,
					"content": "#Я к тебе не {M#подкрадывался}{F#подкрадывалась}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420105
					]
				},
				{
					"id": 230420105,
					"content": "Я задумалась кое о чём, вот и не заметила тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420106
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420106,
					"content": "#Путешественни{F#ца}{M#к}, ты знаешь про такую штуку, которая называется «духи»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420107
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420107,
					"content": "Бабушка Джавахир рассказывала мне, что в молодости она делала духи сама...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420108
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420108,
					"content": "Духи не только способны скрыть запах пота. Некоторые из них даже обладают ободряющим эффектом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420109
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420109,
					"content": "Раеф всё время на страже деревни. От жары он потеет и вечно жалуется, что от солнца кружится голова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420110
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420110,
					"content": "Поэтому я хочу сделать для него флакон мятных духов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420111
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420111,
					"content": "Бабушка Джавахир записала рецепт приготовления духов и помогла мне купить ингредиенты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420112
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420112,
					"content": "Но делать духи оказалось намного сложнее, чем я думала... На одну только подготовку ингредиентов у меня ушло очень много времени. И ошибок я много наделала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420113
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420113,
					"content": "Если так пойдёт и дальше, Раеф обо всём узнает, а духи ещё не будут готовы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420114
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420114,
					"content": "#Путешественни{M#к}{F#ца}, поможешь мне достать некоторые ингредиенты? Только осторожнее, чтобы Раеф ничего не проведал, хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420115,
						230420117
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420115,
					"content": "Если он и узнает, ничего страшного не случится...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420116
					]
				},
				{
					"id": 230420116,
					"content": "Я долго готовила этот сюрприз. Я не хочу, чтобы он узнал и все испортил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420119,
					"content": "Работы не так уж много. Тебе нужно только найти господина Азалая и забрать у него товары, которые я заказала, а потом принести ведёрко воды. Вот и всё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420120
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420120,
					"content": "Только не забудь держать всё в тайне, чтобы Раеф не узнал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нермин"
				},
				{
					"id": 230420117,
					"content": "М-м... Хорошо, я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420118
					]
				},
				{
					"id": 230420118,
					"content": "Ещё раз спасибо! Я обязательно приготовлю хорошее вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Нермин"
				}
			]
		},
		{
			"id": 2304203,
			"completionStepIds": [
				2304202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
