			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Верующая женщина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000501,
					"content": "Наконец-то в моей жизни появилась цель и надежда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000502
					],
					"speakerTitle": "Верующая женщина"
				},
				{
					"id": 111000502,
					"content": "Расскажи о Звездолове.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000503
					]
				},
				{
					"id": 111000503,
					"content": "О, вы тоже уверовали в Звездолова?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000504
					],
					"speakerTitle": "Верующая женщина"
				},
				{
					"id": 111000504,
					"content": "После того как меня бросил жених, мои глаза не просыхали от слёз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000505
					],
					"speakerTitle": "Верующая женщина"
				},
				{
					"id": 111000505,
					"content": "Но потом я обратилась к Звездолову за помощью. По его совету я начала сжигать изображения жениха и развеивать пепел над океаном на рассвете...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000506
					],
					"speakerTitle": "Верующая женщина"
				},
				{
					"id": 111000506,
					"content": "Я не понимаю как... Но это сработало! Я уверена, что он вернётся. Это не просто какой-то психологический эффект... Я действительно в этом уверена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000507
					],
					"speakerTitle": "Верующая женщина"
				},
				{
					"id": 111000507,
					"content": "Я так счастлива, что отдала Звездолову в качестве подношения своё приданое. Ведь если бы не он, то и жених ко мне не вернулся бы, и приданое мне вовсе не понадобилось бы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верующая женщина"
				}
			]
		},
		{
			"id": 1110006,
			"completionStepIds": [
				1110006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
