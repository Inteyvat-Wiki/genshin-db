			"trigger": {
				"objectNames": [
					"Небесный Император Звездолов"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111001001,
					"content": "Привет! Позволь представиться! Мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111001002,
					"content": "А, не благодарите. Искоренять зло - долг любого Адепта. Не придавайте значения. Я не придаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001003
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111001003,
					"content": "Подождите. Кто вы? Я подумал, что вы мои последователи, но, похоже, мы не встречались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001004,
						111001007
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111001004,
					"content": "Мы просто путешественники.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001005
					]
				},
				{
					"id": 111001005,
					"content": "#Паймон - это Паймон! А это мой помощник, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001006
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111001006,
					"content": "Вот оно что. Тогда мне тоже следует представиться, дабы соблюсти этикет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111001010,
					"content": "Кхе-кхе... Стоящий перед вами есть Небесный Император Звездолов, в народе именуемый просто Звездоловом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001011
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111001011,
					"content": "Сей раз спустился я с гор, чтобы очистить от зла этот мир, а встреча наша была предначертана судьбой. Так скажите же мне, чего алкают ваши души.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001012
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111001012,
					"content": "Чего мы хотим? Паймон думала, что Адепты из Ли Юэ могут только хорошо драться... А вы ещё и желания исполняете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001013
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111001013,
					"content": "Ха-ха... Адепты бывают разные... Ведь звёзды выше гор, луны и облаков, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001014
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111001014,
					"content": "Но Адепту не пристало хвастаться своими способностями. Возможно, вам следует сначала пообщаться с последователями, а потом самим сделать вывод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111001007,
					"content": "Мы разыскиваем того, кто идёт путями Адептов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001008
					]
				},
				{
					"id": 111001008,
					"content": "#Паймон - это Паймон! А это мой помощник, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001009
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111001009,
					"content": "Значит, нам по пути. Я тоже должен представиться, дабы соблюсти этикет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Небесный Император Звездолов"
				}
			]
		},
