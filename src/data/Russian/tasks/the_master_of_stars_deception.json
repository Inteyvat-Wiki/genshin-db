			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000101,
					"content": "#Эй, {NICKNAME}... Паймон кажется, или те хиличурлы действительно странно выглядят?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000102,
						111000104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111000102,
					"content": "От них веет тёмной энергией.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000103
					]
				},
				{
					"id": 111000103,
					"content": "Паймон тоже так думает. Хиличурлы, которых мы видели раньше, конечно, были не особо приятными типами, но такими - никогда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111000106,
					"content": "Ой-ой, а ведь постоялый двор «Ваншу» совсем недалеко отсюда... Постояльцы в опасности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111000107,
					"content": "#Ну вот, если теперь мы ничего не сделаем, Паймон будет чувствовать себя виноватой... Так что пойдём, {NICKNAME}, пообщаемся с ними поближе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111000104,
					"content": "Они кажутся обеспокоенными.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000105
					]
				},
				{
					"id": 111000105,
					"content": "Точно! Может, это как-то связано с этой их тёмной энергией?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1110003,
			"completionStepIds": [
				1110003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110003",
							"2"
						],
						"stepId": 1110003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000301,
					"content": "Кажется, одолеть этих мерзких хиличурлов будет сложнее, чем обычных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111000302,
					"content": "Эй, смотри! Кажется, там какие-то люди... Чем это они занимаются?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111000303,
					"content": "Ого... Видишь того парня в маске? Он распугал всех хиличурлов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000304,
						111000305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111000304,
					"content": "Неужели он Адепт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				},
				{
					"id": 111000306,
					"content": "Ты думаешь, он как Сяо? И в самом деле маска этого парня очень похожа на ту, что носит Сяо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111000307,
					"content": "Но его магия, похоже, даже более «адептовая», чем у Сяо. Может, пойдём поговорим с ним?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111000305,
					"content": "Выглядит как магия Адептов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				}
			]
		},
		{
			"id": 1110004,
			"completionStepIds": [
				1110004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110004",
							"2"
						],
						"stepId": 1110004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Верующий мужчина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000401,
					"content": "Видели, что сделал Звездолов? Вот это мощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000402
					],
					"speakerTitle": "Верующий мужчина"
				},
				{
					"id": 111000402,
					"content": "Теперь у моего больного отца появилась надежда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000403
					],
					"speakerTitle": "Верующий мужчина"
				},
				{
					"id": 111000403,
					"content": "Расскажи о Звездолове.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000404
					]
				},
				{
					"id": 111000404,
					"content": "Взгляни, как он владеет магией. Разве тебе ещё нужны доказательства? Истинный Адепт, вне всякого сомнения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000405
					],
					"speakerTitle": "Верующий мужчина"
				},
				{
					"id": 111000405,
					"content": "Не так давно я попросил у него немного лекарства для своего больного отца. Если сравнивать с рецептами из хижины «Бубу», то это просто небо и земля!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000406
					],
					"speakerTitle": "Верующий мужчина"
				},
				{
					"id": 111000406,
					"content": "От заваренного лекарства исходил такой неземной туман... Очень по-адептски! А может, это из-за туманного цветка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000407
					],
					"speakerTitle": "Верующий мужчина"
				},
				{
					"id": 111000407,
					"content": "Лекарства от Адептов - самые действенные. Мой отец скоро поправится, я в этом уверен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000408
					],
					"speakerTitle": "Верующий мужчина"
				},
				{
					"id": 111000408,
					"content": "Конечно, если ищешь помощи у самого Адепта Звездолова, то придётся чем-то пожертвовать. Как подношение я отдал несколько фамильных реликвий... Но что такое старые побрякушки по сравнению со здоровьем родного отца?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верующий мужчина"
				}
			]
		},
		{
			"id": 1110005,
			"completionStepIds": [
				1110005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
