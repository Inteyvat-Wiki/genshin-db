					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240602
					],
					"speakerTitle": "«Календула»"
				},
				{
					"id": 750240602,
					"content": "Не горячись, мы лишь хотим проверить, не пострадал ли вон тот человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240603,
						750240605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750240603,
					"content": "Похоже, придётся сражаться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240604
					]
				},
				{
					"id": 750240604,
					"content": "Ну же, ещё рано сдаваться! Послушай, мы не хотим причинить тебе вреда, мы... Мы уверены, что у тебя не драчливый характер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750240606,
					"content": "Шра-а-ар! Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240607
					],
					"speakerTitle": "«Календула»"
				},
				{
					"id": 750240607,
					"content": "Ах... Она ещё больше разозлилась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750240605,
					"content": "«О Календула, моя прекрасная Календула...»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240606
					]
				}
			]
