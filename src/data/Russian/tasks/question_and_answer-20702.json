					],
					"speakerTitle": "Свен"
				},
				{
					"id": 207020102,
					"content": "Как и в прошлый раз, у меня есть для вас несколько вопросов: это вопросы по темам из этого руководства и общие вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207020103
					],
					"speakerTitle": "Свен"
				},
				{
					"id": 207020103,
					"content": "В зависимости от ответов я также вручу вам небольшой подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Свен"
