			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Эгуи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740910101,
					"content": "Как бы этого парнишку не схватили хиличурлы и не сварили из него суп...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910102,
						740910103
					],
					"speakerTitle": "Эгуи"
				},
				{
					"id": 740910102,
					"content": "Схватили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910105
					]
				},
				{
					"id": 740910105,
					"content": "Вон там, видите лагерь хиличурлов у воды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910106
					],
					"speakerTitle": "Эгуи"
				},
				{
					"id": 740910106,
					"content": "Он появился здесь будто бы за одну ночь. Никакого отдыха, работали не покладая рук. Ох, прямо как Бален, этот паршивец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910107
					],
					"speakerTitle": "Эгуи"
				},
				{
					"id": 740910107,
					"content": "Как по мне, если ему повезло, то он сейчас не в котле, а с удовольствием болтает с хиличурлами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910108
					],
					"speakerTitle": "Эгуи"
				},
				{
					"id": 740910108,
					"content": "А? Ты хочешь сказать, что у тебя кого-то знакомого схватили те хиличурлы? Почему ты такой спокойный? Если это правда, то его нужно срочно спасать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740910109,
					"content": "Спасать? Кого спасать? Я давно ему говорю, что опасная работа не стоит его жизни. Просто докладывай Этьену по графику, а тот найдёт кого-то, кто с этим разберётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910110
					],
					"speakerTitle": "Эгуи"
				},
				{
					"id": 740910110,
					"content": "Учу его, учу, а он мне что? Обвинил меня в халатном отношении к служебным обязанностям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910111
					],
					"speakerTitle": "Эгуи"
				},
				{
					"id": 740910111,
					"content": "Раз ему всё равно на опыт и мудрость старшего поколения, значит, это его собственный выбор. Молодым полезно набить шишек, чтобы набраться ума-разума.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910112,
						740910113
					],
					"speakerTitle": "Эгуи"
				},
				{
					"id": 740910112,
					"content": "Трудно судить, выслушав лишь одну сторону.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910114,
					"content": "Да, нужно скорее его спасти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740910115,
					"content": "Это же опасно! Ребятишки, а если вы поранитесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910116
					],
					"speakerTitle": "Эгуи"
				},
				{
					"id": 740910116,
					"content": "#Не переживай! {NICKNAME}, силы-то тебе хватит! Жди здесь, мы скоро вернёмся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740910113,
					"content": "Попав в беду, он может не вернуться. Тогда он ничему уже не научится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910103,
					"content": "Какой ещё суп?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910104
					]
				},
				{
					"id": 740910104,
					"content": "Вот ориентир!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910105
					],
					"speakerTitle": "Паймон"
				}
			]
		},
