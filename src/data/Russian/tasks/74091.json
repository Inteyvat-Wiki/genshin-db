				"points": []
			},
			"dialogs": [
				{
					"id": 740911001,
					"content": "Мы вернулись! Проблемы и правда были, но мы всё исправили так, как ты нас учил, так что теперь всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740911002,
					"content": "Большое вам спасибо. Если вовремя не устранять мелкие угрозы безопасности, то в будущем они могут перерасти в настоящую катастрофу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911003
					],
					"speakerTitle": "Бален"
				},
				{
					"id": 740911003,
					"content": "Поэтому я не могу согласиться с господином Эгуи, пусть и понимаю, что он так обо мне заботится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911004
					],
					"speakerTitle": "Бален"
				},
				{
					"id": 740911009,
					"content": "Как бы там ни было, я безмерно благодарен вам за спасение и за помощь в работе. Пожалуйста, возьмите это в награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911010
					],
					"speakerTitle": "Бален"
				},
				{
					"id": 740911010,
					"content": "Извините, что задержал вас в дороге. Удачного вам пути!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бален"
				}
			]
		},
