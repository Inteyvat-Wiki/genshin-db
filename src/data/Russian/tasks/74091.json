					"content": "Ты как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740910403,
					"content": "Я-я... В порядке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910404
					],
					"speakerTitle": "Бален"
				},
				{
					"id": 740910404,
					"content": "Он не в порядке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910405
					]
				},
				{
					"id": 740910405,
					"content": "П-пожалуйста, отнесите меня к тому причалу... Я... Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910406
					],
					"speakerTitle": "Бален"
				},
				{
					"id": 740910406,
					"content": "Не разговаривай! Мы тебя отнесём.",
					"roleType": "TALK_ROLE_NPC",
