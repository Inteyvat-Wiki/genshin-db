						],
						"stepId": 7409115,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7409113",
							"2"
						],
						"stepId": 7409113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эгуи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740911701,
					"content": "Зачем тратить собственное время на утомительный ремонт, когда есть кому помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911702,
						740911706
					],
					"speakerTitle": "Эгуи"
				},
				{
					"id": 740911702,
					"content": "Расскажи о пирсе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911703
					]
				},
				{
					"id": 740911703,
					"content": "В крепости Меропид много труб. Кто-то же должен за ними следить? Этим мы и занимаемся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911704
					],
					"speakerTitle": "Эгуи"
				},
				{
					"id": 740911704,
					"content": "Обычно это всякий мелкий ремонт. Да и если что-то серьёзное случится, я-то что сделаю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911705
					],
					"speakerTitle": "Эгуи"
				},
				{
					"id": 740911705,
					"content": "Я просто делаю, что могу. Например, письма в город отношу по выходным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эгуи"
				},
				{
					"id": 740911706,
					"content": "Не буду мешать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911707
					]
				},
				{
					"id": 740911707,
					"content": "Да ты не мешаешь, я всё равно особо ничего не делаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эгуи"
				}
			]
		}
	]
}