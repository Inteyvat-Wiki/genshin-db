			"dialogs": [
				{
					"id": 741140301,
					"content": "#Ох, {NICKNAME}, вы гений! Просто гений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140302
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140302,
					"content": "Без вашей помощи вся плёнка намокла бы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140303
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140303,
					"content": "Нам нужно вернуться в город и передать плёнку господину Гайзерту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140304
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140304,
					"content": "#А потом... Всем вместе пообедать! {NICKNAME}, если хотите, присоединяйтесь к нам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140305
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140305,
					"content": "После обеда я отдам вам обещанное вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140306,
						741140307
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140306,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				},
				{
					"id": 741140308,
					"content": "Вот и договорились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140309
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140309,
					"content": "И Фэн, тебе надо будет отнести ящик с плёнкой господину Гайзерту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140310
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140310,
					"content": "Син Е, а ты... покупаешь продукты. Недавно я узнала рецепт рыбного супа де Пуассон, сегодня будет чем удивить господина Гайзерта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140311
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140311,
					"content": "Босс, давай лучше пойдём в ресторан? Зачем тебе готовить самой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140312
					],
					"speakerTitle": "Син Е"
				},
				{
					"id": 741140312,
					"content": "Так мы сможем... сэкономить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140313
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140313,
					"content": "Кхм! Всё, решено! В путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140314
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140314,
					"content": "#{NICKNAME}, следуйте за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140307,
					"content": "#Я как раз {F#проголодалась}{M#проголодался}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				}
			]
		},
