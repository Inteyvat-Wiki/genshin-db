					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140202
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140202,
					"content": "Босс, не беспокойся. Ящик прочный, вода не проникнет внутрь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140203
					],
					"speakerTitle": "И Фэн"
				},
				{
					"id": 741140203,
					"content": "Хорошо хоть, камера не упала. Иначе всё, конец...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Син Е"
