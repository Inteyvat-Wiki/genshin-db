					}
				]
			},
			"dialogs": [
				{
					"id": 741140601,
					"content": "#{NICKNAME}, я хочу познакомить вас с господином Гайзертом, корифеем киносъёмки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140602
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140602,
					"content": "#Господин Гайзерт, это {NICKNAME}, {F#непревзойдённая искательница приключений}{M#непревзойдённый искатель приключений}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140603
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140603,
					"content": "#Если будете снимать фильм о боевых искусствах, непременно пригласите {F#её}{M#его} на главную роль!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140604
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140604,
					"content": "Ха-ха, госпожа Цю преувеличивает. Я никакой не корифей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140605
					],
					"speakerTitle": "Гайзерт"
				},
				{
					"id": 741140605,
					"content": "Просто немного разбираюсь в том, как использовать свет в кадре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140606
					],
					"speakerTitle": "Гайзерт"
				},
				{
					"id": 741140606,
					"content": "Ох, не скромничайте. Свет в ваших фильмах настолько живой, что скоро заговорит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140607,
						741140609
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140607,
					"content": "Как использовать свет в кадре?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140608
					]
				},
				{
					"id": 741140608,
					"content": "Да. Согласно моей теории света и тени, работая со светом в кадре, вы работаете с эмоциями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Гайзерт"
				},
				{
					"id": 741140611,
					"content": "Но... Как вам объяснить... Моя теория пока не получила признания в киноиндустрии Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140612
					],
					"speakerTitle": "Гайзерт"
				},
				{
					"id": 741140612,
					"content": "Большинство режиссёров предпочитают рассказывать историю с помощью действий, происходящих в кадре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140613
					],
					"speakerTitle": "Гайзерт"
				},
				{
					"id": 741140613,
					"content": "Я снял несколько фильмов, в которых ключевым источником нарратива была светотень, но почти никто моими фильмами не заинтересовался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140614
					],
					"speakerTitle": "Гайзерт"
				},
				{
					"id": 741140614,
					"content": "Но теперь по крайней мере один режиссёр оценил мою теорию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140615
					],
					"speakerTitle": "Гайзерт"
				},
				{
					"id": 741140615,
					"content": "Я? Режиссёр? Ха-ха-ха, не шутите так, господин Рено! Я всего лишь торгую чаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140616
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140616,
					"content": "Кто сказал, что торговец чаем не может быть режиссёром? Я вот пришёл в режиссуру из журналистики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140617
					],
					"speakerTitle": "Гайзерт"
				},
				{
					"id": 741140617,
					"content": "Вы были журналистом... Значит, вы отлично умеете писать репортажи? Ну, как в газетах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140618
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140618,
					"content": "Наверное. А что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140619
					],
					"speakerTitle": "Гайзерт"
				},
				{
					"id": 741140619,
					"content": "А, ничего... совсем как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140620
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140620,
					"content": "Ой, не обращайте внимания! Нас с вами ждёт долгое сотрудничество! Ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140621
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140621,
					"content": "Все рассаживаются за столом под весёлый смех госпожи Цю.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741140622
					]
				},
				{
					"id": 741140622,
					"content": "Обед закончен, но госпожа Цю приготовила ещё несколько угощений, аккуратно их упаковала и положила вам в рюкзак.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741140609,
					"content": "Свет настолько важен для фильма?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140610
					]
				},
				{
					"id": 741140610,
					"content": "Конечно. Согласно моей теории света и тени, свет - ключевой способ передачи эмоций.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Гайзерт"
				}
			]
		},
