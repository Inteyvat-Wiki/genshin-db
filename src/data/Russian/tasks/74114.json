			"dialogs": [
				{
					"id": 741140401,
					"content": "Какая странная кастрюля... Но вряд ли она отличается в использовании от кастрюль из Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140402
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140402,
					"content": "Босс, все продукты я купил, только маркот в магазине закончился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140403
					],
					"speakerTitle": "Син Е"
				},
				{
					"id": 741140403,
					"content": "И в других магазинах его тоже нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140404
					],
					"speakerTitle": "Син Е"
				},
				{
					"id": 741140404,
					"content": "#Значит, не хватает одного ингредиента... {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140405,
						741140406
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140405,
					"content": "Я найду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				},
				{
					"id": 741140407,
					"content": "Спасибо за помощь. Не беспокойтесь, я знаю правила искателей приключений. Я заплачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 741140406,
					"content": "Учтите это поручение, когда будем рассчитываться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				}
