				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750730101,
					"content": "#Ох, {M#мой благодетель}{F#моя благодетельница}! Спасибо, что вы помогли... избавиться от этих хиличурлов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730102
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 750730102,
					"content": "Я стояла на скале, любуясь видами, и тут вдруг хиличурл сбил меня с ног. Когда я очнулась, то оказалась заперта здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730103
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 750730103,
					"content": "Заперто. Ключ... Ключ лежит в той коробке. Могу я попросить о небольшой услуге?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730104
					],
					"speakerTitle": "Конулаф"
				},
				{
					"id": 750730104,
					"content": "Я буду бесконечно благодарна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Конулаф"
				}
			]
		},
