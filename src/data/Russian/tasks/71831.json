					"Ван Пинъань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718310301,
					"content": "Храм выглядит довольно хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310302
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718310302,
					"content": "#{F#Согласна}{M#Согласен}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310303
					]
				},
				{
					"id": 718310303,
					"content": "У вас потрясающее чувство времени. Мы только закончили работы, и я едва успел расплатиться с рабочими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310304
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718310304,
					"content": "Не думал, что это будет стоить так дорого! Я потратил почти всю свою мору...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310305
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718310305,
					"content": "Но, несмотря ни на что, храм был восстановлен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310306
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718310306,
					"content": "Хотите воскурить благовония? Мы сделали новую курильницу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310307,
						718310308
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718310307,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310310
					]
				},
				{
					"id": 718310310,
					"content": "Возьмите благовония, вы найдёте курильницу там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718310308,
					"content": "А ты уже воскурил благовония?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310309
					]
				},
				{
					"id": 718310309,
					"content": "Конечно! Я сделал это сразу, как работы были закончены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310310
					],
					"speakerTitle": "Ван Пинъань"
				}
			]
		},
		{
			"id": 7183105,
			"completionStepIds": [
				7183105
			],
