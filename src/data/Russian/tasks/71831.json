				"points": []
			},
			"dialogs": [
				{
					"id": 718310501,
					"content": "Вы уже закончили? Вам понравилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310502
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718310502,
					"content": "Понравилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310503
					]
				},
				{
					"id": 718310503,
					"content": "Замечательно. Я надеюсь, что этот храм всегда будет наполнен запахом благовоний...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310504
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718310504,
					"content": "Хочу остаться здесь подольше. Это тихое место идеально подходит для моей писательской деятельности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310505
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718310505,
					"content": "Нужно разобрать материалы, которые я собрал, и продолжить работу над книгой о Защитнике Яксе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310506
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718310506,
					"content": "Если у вас будет время, вы можете заглянуть в храм проверить, как обстоят дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310507
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718310507,
					"content": "Если захотите воскурить благовония, то приходите ко мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310508
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718310508,
					"content": "Вообще-то я бы с удовольствием отремонтировал и прилегающую территорию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310509
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718310509,
					"content": "Надо заново вымостить дорожку, поставить ограждения по обе стороны, разбить цветник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ван Пинъань"
				}
			]
		},
