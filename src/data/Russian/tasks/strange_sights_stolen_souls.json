			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжун Ли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200301,
					"content": "Мы остановились на том, что Властелин Камня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200302
					],
					"speakerTitle": "Тянь Железный Язык"
				},
				{
					"id": 111200302,
					"content": "Ах, вот ты где, Чжун Ли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200303,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200304
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200304,
					"content": "Пришли послушать истории? Не знал, что вы ценители.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200305
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200305,
					"content": "Нет-нет, мы за тобой! У тебя есть свободное время?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200306,
					"content": "Уж его-то у меня в избытке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200307,
						111200308
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200307,
					"content": "Мы тут приняли поручение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				},
				{
					"id": 111200309,
					"content": "Нам нужен человек, который смыслит в геологии и руде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200310,
					"content": "Геологии и руде...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200311
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200311,
					"content": "Разве на всём материке есть кто-нибудь ещё, кто разбирается в этом лучше тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200312,
					"content": "Наниматель утверждает, что нашёл лучшего специалиста по камням в мире. Паймон же хочет ему доказать, что этот человек - ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200313,
					"content": "Откуда у тебя вдруг взялась подобная жажда состязания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200314
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200314,
					"content": "Да нет, просто... Этот дядюшка Дай не знает, о чём говорит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200315,
					"content": "Паймон хочет... немножко его просветить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200316,
					"content": "Ха-ха, понятно. В таком случае за дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200317
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200317,
					"content": "Правда?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200318,
					"content": "Должен вас предупредить, что, невзирая на свои познания, я не могу называть себя самым сведущим специалистом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200319
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200319,
					"content": "Учению нет предела. Расширять кругозор всегда полезно. Однако же, думаю, я смогу вам помочь в вашем начинании. Если мы действительно повстречаем подлинного знатока, то сможем перенять от него ценные знания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200320
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200320,
					"content": "Ай... хватит скромничать, Чжун Ли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200321,
					"content": "Раз Чжун Ли согласен, идём к дядюшке Даю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200308,
					"content": "У нас есть одно особое задание...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				}
			]
		},
		{
			"id": 1112004,
			"completionStepIds": [
				1112004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112004",
							"2"
						],
						"stepId": 1112004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дядюшка Дай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200401,
					"content": "Дядюшка Дай! А вот мы и вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200402,
					"content": "О! Это, стало быть, ваш друг?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200403
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200403,
					"content": "Именно! Лучший знаток камней и геологии собственной персоной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200404,
					"content": "Не стоит преувеличивать. Тем не менее некоторым опытом на этом поприще я обладаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200405
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200405,
					"content": "Ага, как скажете. Вот придёт мой специалист, тогда посмотрим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200406
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200406,
					"content": "Расхваливать его я не стану. Вы сейчас сами всё увидите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200407
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200407,
					"content": "Эм... Так это здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200408
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200408,
					"content": "Лёгок на помине! Позвольте мне представить вам моего помощника, Кунь Цзюня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200409
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200409,
					"content": "Кунь Цзюнь, это два искателя приключений, присланные гильдией. Что же до этого господина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200410
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200410,
					"content": "Хм?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200411
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200412
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200412,
					"content": "Это Чжун Ли, консультант ритуального бюро «Ваншэн».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200413
					]
				},
				{
					"id": 111200413,
					"content": "Консультант ритуального бюро «Ваншэн»... Господин Чжун Ли! Весьма о вас наслышан. Говорят, вы обладаете выдающимися способностями и эрудицией. Не ожидал, что сегодня повстречаю вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200414
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200414,
					"content": "Хм... Кажется, я где-то вас уже видел... не в ритуальном бюро ли? Постойте, я же никогда не был в ритуальном бюро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200415
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200415,
					"content": "Дядюшка Дай, разве тебе не интересно узнать, кто из них лучший эксперт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200416,
					"content": "Так вот что ты задумала.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200417
					]
				},
				{
					"id": 111200417,
					"content": "А? Хм... Я даже не знаю с чего начать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200418
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200418,
					"content": "А пусть они сами придумают, как испытать друг друга! Если победит Чжун Ли, помощником будет он. А если Чжун Ли проиграет, то... А такого быть не может, чтобы он проиграл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200419
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200419,
					"content": "Испытание? Это я с удовольствием!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200420
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200420,
					"content": "Я восхищён энтузиазмом этого юноши.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200421
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200421,
					"content": "А-ха-ха! Должен заметить, ты определённо похож на эксперта в данной области. Крайне любопытно, кто же из нас двоих одержит верх.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200422
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200422,
					"content": "Хватит болтать! Пора заняться делом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200423,
					"content": "Я просто говорю как есть, ха-ха-ха... Впрочем, ничего другого я не умею.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200424
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200424,
					"content": "Так ты оценщик камней, Кунь Цзюнь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200425
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200425,
					"content": "Нет... Н-на самом деле, я уже забыл, зачем пришёл в Ли Юэ... Однажды, когда я стоял на обочине, меня окликнул дядюшка Дай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200426
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200426,
					"content": "Дядюшка Дай увидел камень у меня в руке и задал несколько вопросов. Он так взбудоражился, что даже некоторое время преследовал меня. Мы условились встретиться тут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200427
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200427,
					"content": "А? Разве такое можно забыть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200428
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200428,
					"content": "Я встретил Кунь Цзюня по пути в Ли Юэ, когда он разглядывал камни и бормотал себе под нос что-то с таким видом, будто прекрасно в них разбирается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200429
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200429,
					"content": "Из любопытства я задал ему пару вопросов о камнях. И, к моему удивлению, он знал больше меня, старого шахтёра! Занят он не был и согласился мне помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200430
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200430,
					"content": "Выходит... у тебя скверная память?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200431,
					"content": "Не совсем так... Как бы то ни было, если речь идёт о камнях, я могу помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200432
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200432,
					"content": "Господин Чжун Ли, что вы скажете об этом камне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200433
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200433,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200434
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200434,
					"content": "У него блестящая поверхность с трещинами, которые образовались вследствие извержения вулкана. Если я не ошибаюсь, это необработанный самоцвет из другого королевства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200435
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200435,
					"content": "Ага... Глаз у вас намётан!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200436
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200436,
					"content": "Но это не обычный необработанный самоцвет. Хрупкая поверхность, чёрные прожилки... Думаю, внутри него мы найдём кристальную руду высокого качества.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200437
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200437,
					"content": "Блестяще. Этот камень действительно образовался рядом с вулканом. Я наткнулся на него на рынке и сразу же купил. Продавец принял его за производственные отходы и понятия не имел, какое это сокровище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200438,
						111200439
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200438,
					"content": "Но ведь кристальная руда есть везде.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				},
				{
					"id": 111200440,
					"content": "Одна лишь чистота и редкость драгоценным его ещё не делает. Во многих более редких и ценных кристаллах встречаются вкрапления воды или золотого песка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200441
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200441,
					"content": "В покрытый каменной оболочкой кристалл в момент его образования попал небольшой пузырёк воды. Вода, словно затаившаяся внутри горы полная луна, отражает яркие лучи света... Этот камень - настоящее сокровище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200442
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200442,
					"content": "Столько подробностей, будто он всё собственными глазами видел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200443
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200443,
					"content": "Скажи-ка, а не пытаешься ли ты нас одурачить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200444
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200444,
					"content": "Нет. Он говорит чистую правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200445
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200445,
					"content": "Обычно кристаллы зарождаются только при очень высокой температуре. Подобная температура и вода несовместимы, поэтому кристаллы с вкраплением капель ценятся столь высоко. Более того, вода в этом кристалле из горного озера. Поистине удивительная находка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200446
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200446,
					"content": "Если это говорит Чжун Ли... значит, так и есть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200447
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200447,
					"content": "Проницательность твоих суждений удивляет меня, господин Чжун Ли. Как ты узнал, что именно находится внутри?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200448
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200448,
					"content": "В своё время таких камней я повидал немало и опознал его сразу. Надеюсь, тебе не претит то, что я щеголяю своим опытом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200449
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111200449,
					"content": "Вовсе нет! Я чувствую в тебе родственную душу и хотел бы предложить тебе свою дружбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200450
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200450,
					"content": "Дядюшка Дай, позволь Чжун Ли к нам присоединиться! Поверь, он специалист высочайшего класса. Второго такого можно и за всю жизнь не повстречать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200451
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111200451,
					"content": "Хорошо. Как говорится, сила в количестве. Прошу всех проследовать за мной к Разлому. Пропавшие шахтёры рассчитывают на вашу помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200439,
					"content": "Чем так хорош этот конкретный кусок?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				}
			]
		},
		{
			"id": 1112022,
			"completionStepIds": [],
