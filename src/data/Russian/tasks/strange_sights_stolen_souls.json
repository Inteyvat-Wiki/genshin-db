				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200101,
					"content": "Катерина, мы пришли! Есть новые поручения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200102,
					"content": "Да, кое-что есть. Думаю, вам это будет в самый раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200103
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 111200103,
					"content": "Дядюшка Дай - один из начальников Хуэй Шань в Ли Юэ. Он хотел бы, чтобы Гильдия искателей приключений прислала кого-нибудь ему помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200104
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 111200104,
					"content": "Что именно мы должны сделать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200105,
					"content": "Насколько я знаю, нужно будет найти рабочих.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200106
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 111200106,
					"content": "О, поиск людей? Это мы хорошо умеем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200107,
					"content": "Да, я нисколько в ваших способностях не сомневаюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200108
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 111200108,
					"content": "Подробности вы сможете обсудить при встрече. Если вы принимаете это поручение, отправляйтесь на пристань и поговорите с дядюшкой Даем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				}
			]
		},
		{
			"id": 1112002,
			"completionStepIds": [
				1112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112002",
							"2"
						],
						"stepId": 1112002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дядюшка Дай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200201,
					"content": "Эй! Это вы дядюшка Дай?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200202,
					"content": "Он самый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200203
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200203,
					"content": "Хм? Итак, вас, должно быть, прислала Гильдия искателей приключений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200204
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200204,
					"content": "А? Неужели это так заметно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200205,
					"content": "Судя по вашему виду и одежде, вы опытные искатели приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200206
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200206,
					"content": "Правильно, правильно! А ты очень наблюдательный!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200207,
					"content": "Ха-ха-ха, в нашем деле без проницательности не обойтись. Нужно разбираться не только в камнях, но и в людях. Мне достаточно лишь взгляда, чтобы понять, какой передо мной человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200208
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200208,
					"content": "Подождите немного здесь. Мой помощник должен прибыть с минуты на минуту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200209
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200209,
					"content": "Постой-ка! Мы ведь уже здесь. Зачем ещё кого-то брать в долю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200210,
					"content": "Ха! По правде говоря, ситуация на этот раз несколько запутанная. Боюсь, одним искателям приключений не справиться, так что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200211
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200211,
					"content": "Хм! Так с нами будет кто-то ещё? Хм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200212,
					"content": "Дяденька, кажется, нас недооценивает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200213,
						111200214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200213,
					"content": "Держи себя в руках, Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				},
				{
					"id": 111200215,
					"content": "Вы не в курсе случившегося. Инцидент сей произошёл в шахте, и он несколько необычен. В шахтах всегда было небезопасно, и я на всякий случай нанял специалиста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200216
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200216,
					"content": "Насколько мне известно, оценка качества руды, подробный геологический анализ и тому подобные навыки не входят в компетенцию искателей приключений. Дело пойдёт лучше, если рядом будет эксперт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200217
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200217,
					"content": "К тому же этот парень в своей области лучший. Он способен удивительно точно определить ценность любого камня на глаз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200218
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200218,
					"content": "Я бы даже сказал, что во всём Тейвате не найдётся человек, который разбирается в камнях лучше него. Разве мог я такого специалиста не нанять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200219
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200219,
					"content": "Нет-нет, вы ошибаетесь, если считаете, что нашли лучшего специалиста по камню во всём Тейвате!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200220,
					"content": "Это почему же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200221
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111200221,
					"content": "А потому, что самый лучший знаток камня в Тейвате - наш друг!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200222,
					"content": "А ты случайно не имеешь в виду...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200223
					]
				},
				{
					"id": 111200223,
					"content": "(Отлично, мне тоже хотелось бы задать ему парочку вопросов.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200224
					]
				},
				{
					"id": 111200224,
					"content": "Ох-хо-хо! Всегда найдётся кто-то лучше! Подожди немного, сейчас мы его приведём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111200214,
					"content": "Паймон, опять в тебе взыграл дух соперничества...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				}
			]
		},
		{
			"id": 1112003,
			"completionStepIds": [
				1112003
			],
			"beginWay": "TALK_BEGIN_AUTO",
