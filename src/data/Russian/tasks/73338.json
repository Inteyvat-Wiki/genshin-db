			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Танджи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733380101,
					"content": "#Здравствуй, незнаком{F#ка}{M#ец}! Ты путешествуешь по этим местам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380102
					],
					"speakerTitle": "Танджи"
				},
				{
					"id": 733380102,
					"content": "#Прошу прощения, что задерживаю... Эм, не мог{F#ла} бы ты рассказать, что здесь произошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380103
					],
					"speakerTitle": "Танджи"
				},
				{
					"id": 733380103,
					"content": "#Меня зовут {NICKNAME}. Рад{F#а} встрече.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380104
					]
				},
				{
					"id": 733380104,
					"content": "Я Танджи из дастура Вахумана. Я пришёл сюда, чтобы вести просветительскую работу среди... да, племени Танит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380105
					],
					"speakerTitle": "Танджи"
				},
				{
					"id": 733380105,
					"content": "Это всё очень странно. Это должно быть здесь, но... Что здесь произошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380106,
						733380108
					],
					"speakerTitle": "Танджи"
				},
				{
					"id": 733380106,
					"content": "Это... долгая история.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380107
					]
				},
				{
					"id": 733380107,
					"content": "Война племён? Или междоусобица? Очень интересно. В песках уже несколько столетий не случалось такого конфликта, который бы уничтожил целое племя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "Танджи"
				},
				{
					"id": 733380110,
					"content": "Кроме того, я обнаружил довольно зловещие следы... Не советую тебе смотреть. Опасно для желудка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380111
					],
					"speakerTitle": "Танджи"
				},
				{
					"id": 733380111,
					"content": "А может быть, это выжившие постарались. Вернулись и забрали большую часть... забытых вещей. Я не уверен. Но выглядит довольно кошмарно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380112
					],
					"speakerTitle": "Танджи"
				},
				{
					"id": 733380112,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380113
					]
				},
				{
					"id": 733380113,
					"content": "Эх... И как я в такое вляпался? Будто в истории оказался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380114
					],
					"speakerTitle": "Танджи"
				},
				{
					"id": 733380114,
					"content": "А, кстати... В карты хочешь сыграть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380115
					],
					"speakerTitle": "Танджи"
				},
				{
					"id": 733380115,
					"content": "Я в палатках пару колод обнаружил, немного почистил, и теперь они не грязные. Если хочешь, то мы могли бы сыграть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Танджи"
				},
				{
					"id": 733380108,
					"content": "Может, они... переселились?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380109
					]
				},
				{
					"id": 733380109,
					"content": "Переселились? Нет... Смотри, запасы и палатки - всё на своих местах. Повсюду пепел и другие следы... Хм. Больше похоже, что их жизни прервал какой-то внезапный катаклизм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "Танджи"
				}
			]
		},
