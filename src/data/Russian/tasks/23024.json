			"dialogs": [
				{
					"id": 230240101,
					"content": "Ох, ну наконец-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240102
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230240102,
					"content": "Очень вовремя. У нас уже всё готово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240103
					],
					"speakerTitle": "Гурген"
				},
				{
					"id": 230240103,
					"content": "Ты так взбудоражен...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240104
					]
				},
				{
					"id": 230240104,
					"content": "Неужели розы распустились?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230240105,
					"content": "#Да, ха-ха-ха! Всё благодаря тебе, путешественни{F#ца}{M#к}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240106
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230240106,
					"content": "Роза ещё не расцвела, но уже можно увидеть её необычайную жизненную силу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240107
					],
					"speakerTitle": "Гурген"
				},
				{
					"id": 230240107,
					"content": "Если тебе интересно, подойди, посмотри поближе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240108
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230240108,
					"content": "Ха-ха-ха, а вдруг она прямо перед тобой расцветёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240109
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230240109,
					"content": "Не могу такое пропустить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240110
					]
				},
				{
					"id": 230240110,
					"content": "Правда? Так быстро расцветёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230240111,
					"content": "Паймон просто не терпится посмотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
