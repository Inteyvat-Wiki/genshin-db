				"points": []
			},
			"dialogs": [
				{
					"id": 745300401,
					"content": "#А, привет, {M#наставник}{F#наставница}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300402,
						745300403
					],
					"speakerTitle": "Качина"
				},
				{
					"id": 745300402,
					"content": "Качина, выглядишь очень довольной!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				},
				{
					"id": 745300404,
					"content": "Я нашла очень хорошую сырую руду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300405
					],
					"speakerTitle": "Качина"
				},
				{
					"id": 745300405,
					"content": "Если хорошенько отполировать, получится сверкающий большой самоцвет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300406
					],
					"speakerTitle": "Качина"
				},
				{
					"id": 745300406,
					"content": "Отлично!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300407
					]
				},
				{
					"id": 745300407,
					"content": "Так и есть! Сначала мне совсем не везло. Думала, что придётся уйти с пустыми руками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300408
					],
					"speakerTitle": "Качина"
				},
				{
					"id": 745300408,
					"content": "Но потом я решила, что нельзя сдаваться и продолжила копать, совсем чуть-чуть ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300409
					],
					"speakerTitle": "Качина"
				},
				{
					"id": 745300409,
					"content": "Я всё подбадривала себя, пока наконец-то не нашла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300410
					],
					"speakerTitle": "Качина"
				},
				{
					"id": 745300410,
					"content": "Когда я вышла из шахты, то обнаружила, что солнце уже почти село... Незаметно для себя провела за раскопками целый день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300411,
						745300412
					],
					"speakerTitle": "Качина"
				},
				{
					"id": 745300411,
					"content": "Какая у тебя сила воли, Качина!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300413,
					"content": "Сфотографировать? Я обычно стесняюсь перед камерой... Не уверена, что получится хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300414
					],
					"speakerTitle": "Качина"
				},
				{
					"id": 745300414,
					"content": "Но раз ты просишь, я постараюсь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300415,
						745300416
					],
					"speakerTitle": "Качина"
				},
				{
					"id": 745300415,
					"content": "Ты и так уже молодец.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300417,
					"content": "Хм! Тогда я доверюсь тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Качина"
				},
				{
					"id": 745300416,
					"content": "Ты выглядишь хорошо без всяких стараний, Качина!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300412,
					"content": "Можно сфотографировать тебя? Ты так сияешь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300403,
					"content": "Случилось что-то хорошее?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				}
			]
		}
	]
