	"talks": [
		{
			"id": 7350201,
			"completionStepIds": [
				7350201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
