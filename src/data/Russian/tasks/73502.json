				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020101,
					"content": "«День сменяет день. С моста увидишь идущую с работы тень маяка».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020102
					],
					"speakerTitle": "Исследовать"
				},
				{
					"id": 735020102,
					"content": "Ч-что это такое? Загадка? Или какая-то поговорка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735020103,
					"content": "День сменяет день? Идущая с работы тень...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735020104,
					"content": "#Путешественни{F#ца}{M#к}? Ты тоже {F#заинтересовалась}{M#заинтересовался} загадкой господина Друсуса?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020105,
						735020106
					],
					"speakerTitle": "Камал"
				},
				{
					"id": 735020105,
					"content": "Это загадка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				},
				{
					"id": 735020107,
					"content": "Её придумал один учёный из Академии, господин Друсус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020108
					],
					"speakerTitle": "Камал"
				},
				{
					"id": 735020108,
					"content": "Насколько я знаю, в Академии его считают чудаком...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020109
					],
					"speakerTitle": "Камал"
				},
				{
					"id": 735020109,
					"content": "Больше всего ему нравится обсуждать с разными людьми всевозможные загадки и исследовать различные способы шифровки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020110
					],
					"speakerTitle": "Камал"
				},
				{
					"id": 735020110,
					"content": "Но его загадки слишком трудны, а потому почти никто не хочет с ним общаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020111
					],
					"speakerTitle": "Камал"
				},
				{
					"id": 735020111,
					"content": "Поэтому он придумал вознаграждать людей за правильно разгаданные загадки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020112
					],
					"speakerTitle": "Камал"
				},
				{
					"id": 735020112,
					"content": "Проще говоря, эти загадки являются подсказками, где искать сокровище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020113
					],
					"speakerTitle": "Камал"
				},
				{
					"id": 735020113,
					"content": "Если в правильное время правильным способом достигнуть правильного места, то можно найти сокровище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020114
					],
					"speakerTitle": "Камал"
				},
				{
					"id": 735020114,
					"content": "Господин Друсус дал ещё одну подсказку. Он сказал, что сокровище спрятано в городе Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020115
					],
					"speakerTitle": "Камал"
				},
				{
					"id": 735020115,
					"content": "Но, как видите, ещё ни один искатель приключений не преуспел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020116
					],
					"speakerTitle": "Камал"
				},
				{
					"id": 735020116,
					"content": "Вы тоже можете попробовать, если интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020117
					],
					"speakerTitle": "Камал"
				},
				{
					"id": 735020117,
					"content": "Но, по-моему, лучше бы вам заняться каким-нибудь стоящим делом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камал"
				},
				{
					"id": 735020106,
					"content": "Ты знаешь, кто её придумал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				}
			]
		},
		{
			"id": 7350203,
			"completionStepIds": [
				7350203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350203",
							"2"
						],
						"stepId": 7350203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Друсус"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020301,
					"content": "Неужели сегодня никто не придёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020302
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735020302,
					"content": "Это главный вход в Храм знаний?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020303
					]
				},
				{
					"id": 735020303,
					"content": "Да! Это главный вход в Храм знаний. Вы... отгадали все мои загадки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020304
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735020304,
					"content": "Замечательно! А мне уж думалось, сегодня ни у кого не получится. Значит, скоро на обед схожу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020305
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735020305,
					"content": "А зачем ты придумал все эти загадки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020306
					]
				},
				{
					"id": 735020306,
					"content": "Как зачем? Ради интереса, конечно же!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020307
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735020307,
					"content": "Ответил без раздумий!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735020308,
					"content": "Ну а кроме этого, как думаете, зачем мне этим заниматься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020309
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735020309,
					"content": "Чтобы наслаждаться тем, какой я высокоинтеллектуальный в глазах других?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020310,
						735020311
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735020310,
					"content": "Кто знает...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				},
				{
					"id": 735020312,
					"content": "Ха-ха-ха, в таком случае вы, как и некоторые личности в Академии, меня недопоняли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020313
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735020313,
					"content": "Написал я эти загадки просто потому, что мне нравятся размышления, которые появляются в ходе их отгадывания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020314
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735020314,
					"content": "Если перечитаете мои загадки, то заметите, что в них самих уже содержится ключевое слово. Оно-то и указывает на разгадку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020315
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735020315,
					"content": "Если взять это слово за основу и вести мысль именно от него, решить загадку можно очень быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020316
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735020316,
					"content": "А ежели бы я просто хотел усложнить кому-то жизнь, убрал бы все подсказки. Тогда загадка превратится в неразрешимую задачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020317
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735020317,
					"content": "Ну, неважно. Раз вы всё отгадали, возьмите это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020318
					],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735020318,
					"content": "Это ваша награда за усердную мозговую деятельность. Берите-берите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Друсус"
				},
				{
					"id": 735020311,
					"content": "Не могу сказать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				}
			]
		},
