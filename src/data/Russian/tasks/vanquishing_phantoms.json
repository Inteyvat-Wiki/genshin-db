				1403411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1403403",
							"2"
						],
						"stepId": 1403403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Клоринда"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2525.035,
							469.746,
							4803.685
						],
						"pointId": 340300464
					}
				]
			},
			"dialogs": [
				{
					"id": 140340301,
					"content": "Кстати, об Охотниках Сумеречного двора. А что нам делать с сокровищами из пещеры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340302
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 140340302,
					"content": "Вернуть на место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340303
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340303,
					"content": "Ты уверена? Можно ведь показать их людям, чтобы они вспомнили об Охотниках... тебе совсем этого не хочется?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140340304,
					"content": "Нет. Это был их выбор. И каждый Охотник знает, чем такой выбор чреват.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340305
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340305,
					"content": "И я не исключение... Я не хочу, чтобы люди запомнили меня как Охотника Сумеречного двора. Пусть меня знают как судебного дуэлянта, этого достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340306
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340306,
					"content": "У иллюзионистов совсем иной путь. Но я всё равно восхищаюсь твоим решением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340307
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 140340307,
					"content": "Подождите, Паймон только что вспомнила. Если никаких спецэффектов не было, то почему наше оружие светилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140340308,
					"content": "В прошлом Охотники Сумеречного двора применяли к своему оружию заклинания, которые помогали противостоять монстрам. Если рядом появлялся монстр, оружие начинало светиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340309
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340309,
					"content": "О! Так вот почему в конце нам удалось остановить врага. А я думала, сработал призыв.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340310
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140340310,
					"content": "Призыв наверняка тоже помог.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340311
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340311,
					"content": "Что это значит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340312
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 140340312,
					"content": "Предполагаю, что Пожиратель относится к той же эпохе, что и Охотники Сумеречного двора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340313
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340313,
					"content": "Все названные вами имена принадлежат храбрейшим Охотникам, которые когда-то уничтожили несметное количество монстров. Пожиратель явно струсил, когда их услышал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340314
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340314,
					"content": "Не думала, что в именах может крыться такая сила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140340315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340316
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340316,
					"content": "Навия, во время призыва ты сказала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340317
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340317,
					"content": "А? Ха-ха... Да, всё правда! Ну, мой персонаж должен был так сказать! Хорошо, что ты услышала, но не заставляй меня повторять. Мне неловко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340318
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140340318,
					"content": "Рада была услышать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340319
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340319,
					"content": "Да, ты же меня знаешь. Конечно, я бы так сказала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340320
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140340320,
					"content": "Эм... Ладно, хватит об этом! Я пойду вперёд, а вы следуйте за мной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340321
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140340321,
					"content": "Ну вот, убежала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140340322,
					"content": "Тогда я тоже пойду. Сегодня произошла удивительная история. Моим братьям и сёстрам тоже будет интересно послушать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340323
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 140340323,
					"content": "Увидимся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340324
					]
				},
				{
					"id": 140340324,
					"content": "Пока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340325
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 140340325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340326
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340326,
					"content": "#{NICKNAME}... Как думаешь, в чём смысл путешествия, если твоё имя не запомнят, а поступки не оценят те, кому ты {M#помог}{F#помогла}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340327
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340327,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340328
					]
				},
				{
					"id": 140340328,
					"content": "Даже если время, проведённое вместе, сотрётся из памяти, возможность пережить приключения вместе с друзьями ценна сама по себе. И важно будущее, которое мы создаём вместе с друзьями.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340329
					]
				},
				{
					"id": 140340329,
					"content": "Отличный ответ. Я запомню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340330
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340330,
					"content": "А ты как бы ответила, Клоринда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340331
					]
				},
				{
					"id": 140340331,
					"content": "Я? Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340332
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340332,
					"content": "(Охотница Сумеречного двора ничего не отвечает на этот вопрос.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340333
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 140340333,
					"content": "(Возможно, ответ кроется в её молчании. Безмолвная клятва эхом отдаётся в ночи... Избранный ею путь не нуждается в объяснении.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Клоринда"
				}
			]
		}
	]
}