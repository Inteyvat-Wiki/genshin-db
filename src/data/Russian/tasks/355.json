			},
			"dialogs": [
				{
					"id": 3550701,
					"content": "Ух! Меня чуть не сдуло!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3550702,
					"content": "К счастью, я успела ухватиться за твои волосы. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550703,
						3550704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3550703,
					"content": "Ещё чуть-чуть, и ты оторвала бы мне голову.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550705
					]
				},
				{
					"id": 3550705,
					"content": "Что это было? Я думала, он нас съест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3550706,
					"content": "Это определённо связано с чудиком, который разговаривает с драконами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550707,
						3550709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3550707,
					"content": "#Я думал{F#а}, что драконов не бывает...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550708
					]
				},
				{
					"id": 3550708,
					"content": "Я понимаю, почему ты переживаешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550711
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3550711,
					"content": "А это ещё что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3550712,
					"content": "Там какая-то красная штучка. Вон на том огромном булыжнике!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550713
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3550713,
					"content": "Пойдём посмотрим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3550709,
					"content": "Тут все с драконами на «ты»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550710
					]
				},
				{
					"id": 3550710,
					"content": "Нет, конечно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550711
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3550704,
					"content": "Хорошо, что дракон нас не заметил.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550705
					]
				}
			]
		}
