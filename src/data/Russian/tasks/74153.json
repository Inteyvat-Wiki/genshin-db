						],
						"pointId": 6403
					},
					{
						"sceneId": 3,
						"position": [
							3594.91,
							435.073,
							4531.89
						],
						"pointId": 7522
					},
					{
						"sceneId": 3,
						"position": [
							3594.826,
							435.073,
							4532.51
						],
						"pointId": 7523
					}
				]
			},
			"dialogs": [
				{
					"id": 741530101,
					"content": "Здравствуйте! Есть тут кто? Вам нужны газеты? Эй! Есть кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530102
					],
					"speakerTitle": "Пип"
				},
				{
					"id": 741530102,
					"content": "Привет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530103
					]
				},
				{
					"id": 741530103,
					"content": "Бенуа дома?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530104
					]
				},
				{
					"id": 741530104,
					"content": "А мне откуда знать? А вообще, кто так делает - выписывает газету и не забирает её? Странно всё это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530105
					],
					"speakerTitle": "Пип"
				},
				{
					"id": 741530105,
					"content": "Когда я приходил сюда раньше, он хотя бы отзывался, но в последнее время я его не видел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530106
					],
					"speakerTitle": "Пип"
				},
				{
					"id": 741530106,
					"content": "Честно говоря, я сложил здесь целую кучу номеров «Паровой птицы». Вы его знаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530107
					],
					"speakerTitle": "Пип"
				},
				{
					"id": 741530107,
					"content": "Да-да, мы его друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530108,
					"content": "Близкие друзья? ...Неважно. Может, я отдам газеты вам, а вы передадите их ему при встрече?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530109,
						741530110
					],
					"speakerTitle": "Пип"
				},
				{
					"id": 741530109,
					"content": "Не вопрос. Давай сюда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530111
					]
				},
				{
					"id": 741530111,
					"content": "Вот, пожалуйста. Я сделал всё, что мог. И не вздумайте сказать, что это не так! У меня ещё куча дел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530112
					],
					"speakerTitle": "Пип"
				},
				{
					"id": 741530112,
					"content": "В последнее время мы его тоже не видели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530113,
					"content": "Правда? Чем же он был занят в последнее время? Может, вернулся в свой старый дом? Разумеется, я ничего об этом не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530114
					],
					"speakerTitle": "Пип"
				},
				{
					"id": 741530114,
					"content": "Старый дом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530115
					]
				},
				{
					"id": 741530115,
					"content": "Именно так. Его прежнее жильё во Флёв Сандр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530116
					],
					"speakerTitle": "Пип"
				},
				{
					"id": 741530116,
					"content": "Так вот где он раньше жил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530117,
					"content": "Вы не знаете, что он переехал оттуда сюда? А вы правда его друзья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530118
					],
					"speakerTitle": "Пип"
				},
				{
					"id": 741530118,
					"content": "Эм... Мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530119,
					"content": "Ладно, неважно. Не нужно ничего объяснять. Мне всё равно, какие у вас отношения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530120
					],
					"speakerTitle": "Пип"
				},
				{
					"id": 741530120,
					"content": "Передайте ему газеты, и я буду благодарен. Вот, возьмите, а мне надо идти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530121
					],
					"speakerTitle": "Пип"
				},
				{
					"id": 741530121,
					"content": "Хм. Такое ощущение, что мы многого не знаем о Бенуа. Как думаешь, это может быть как-то связано с нашим расследованием?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530122,
						741530123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530122,
					"content": "Скорее всего, да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530124
					]
				},
				{
					"id": 741530124,
					"content": "Хорошо. Давай прошерстим весь дом. Возможно, узнаем побольше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530125,
					"content": "Но при этом нельзя шуметь, иначе мы привлечём внимание той парочки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530123,
					"content": "Чем больше информации, тем лучше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530124
					]
				},
				{
					"id": 741530110,
					"content": "Паймон, возьми.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530111
					]
				}
			]
		},
		{
