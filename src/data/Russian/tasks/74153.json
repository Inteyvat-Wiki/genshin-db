			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Снодграсс"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3504.715,
							283.082,
							4526.98
						],
						"pointId": 6410
					},
					{
						"sceneId": 3,
						"position": [
							3505.04,
							283.082,
							4528.36
						],
						"pointId": 7524
					},
					{
						"sceneId": 3,
						"position": [
							3504.077,
							283.082,
							4528.295
						],
						"pointId": 7525
					}
				]
			},
			"dialogs": [
				{
					"id": 741530701,
					"content": "Ах, как скучно... Не хочу работать... Когда же я разбогатею?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530702
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530702,
					"content": "Расскажи о Бенуа Леруа...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530703
					]
				},
				{
					"id": 741530703,
					"content": "Леруа? Хм. Я где-то слышал это имя. Дай подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530704
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530704,
					"content": "Вспомнил. Бенуа Леруа был владельцем лавки, в которой продавались самые разные товары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530705
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530705,
					"content": "Кстати, кто вы и зачем спрашиваете о нём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530706
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530706,
					"content": "Вообще-то, мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530707,
						741530708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530707,
					"content": "Он оказался в непростой ситуации.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530709
					]
				},
				{
					"id": 741530709,
					"content": "А... Он что-то натворил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530710
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530710,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530711
					]
				},
				{
					"id": 741530711,
					"content": "Хорошо, хорошо... Но могу я спросить, вы из Спина-ди-Росула или Палаты Жардинаж?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530712
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530712,
					"content": "Ты имеешь право хранить молчание...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530713
					]
				},
				{
					"id": 741530713,
					"content": "Всё, что ты скажешь, может быть использовано против тебя в суде...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530714
					]
				},
				{
					"id": 741530714,
					"content": "#(Ух ты, у тебя здорово получается, {NICKNAME}!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530715
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530715,
					"content": "Хорошо, хорошо, я понял. Вопросов больше нет. Ну, вряд ли он заработал состояние честным путём. Наверняка найдётся какой-нибудь закон, который он нарушил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530716
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530716,
					"content": "Вы обратились по адресу. Я знаю о Бенуа всё, без преувеличения. Нет такого дурного поступка, до которого бы он не опустился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530717
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530717,
					"content": "Хм. Я достиг зрелого возраста, так что он уже должен быть стариком, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530718
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530718,
					"content": "В общем, я помню, что его дочь, Осень, была настоящей красавицей. Правда, он никогда не позволял нам с ней общаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530719
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530719,
					"content": "Осень?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530720
					]
				},
				{
					"id": 741530720,
					"content": "Верно, Осень Леруа - его приёмная дочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530721
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530721,
					"content": "Подумайте сами. Он был простым парнем, который продавал всякую всячину и зарабатывал немного моры то тут, то там. Как ему удалось внезапно разбогатеть настолько, чтобы перебраться на поверхность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530722
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530722,
					"content": "Всё благодаря его дочери, конечно. Бедная, хорошенькая девочка... Он заставил её выйти замуж за какого-то старого богача!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530723
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530723,
					"content": "И что вы думаете, этот богатый старик через несколько лет скончался, после чего его дом отошёл к ней. А что принадлежит ей, то принадлежит и Бенуа. В общем, довольно быстрый способ обустроить жизнь «наверху», если вы понимаете, о чём я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530724
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530724,
					"content": "И почему именно ему выпала такая удача - ведь он же кровопийца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530725
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530725,
					"content": "(Неужели что-то подобное произошло на самом деле?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530726
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530726,
					"content": "(Давай расспросим его подробнее.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530727
					]
				},
				{
					"id": 741530727,
					"content": "Итак, офицеры, это то, о чём вы хотели спросить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530728
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530728,
					"content": "То есть, если эта информация окажется полезной, то можно сказать, что я внёс свой вклад в безопасность Фонтейна, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530729
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530729,
					"content": "Неужели Палата Жардинаж не предусмотрела вознаграждение для такого... деятельного гражданина, как я?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530730,
						741530732
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530730,
					"content": "Всё, что ты рассказал, нам было известно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530731
					]
				},
				{
					"id": 741530731,
					"content": "О, не волнуйтесь, у меня есть и другие истории. Разве может человек жить во Флёв Сандр и не знать чужих тайн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530734
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530734,
					"content": "Сейчас Осень второй раз замужем. О да, она быстро вышла замуж. На этот раз довольно далеко, и мы не слышали о ней целую вечность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530735
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530735,
					"content": "К тому времени, когда до нас дошли новости... Ну, она... сделала это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530736
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530736,
					"content": "Что «это»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530737
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530737,
					"content": "Неужели вы не в курсе, офицеры? Она убила своего второго мужа. И за свои преступления попала в крепость Меропид. Разве вы этого не знали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530738,
						741530739
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530738,
					"content": "Вот список лиц, причастных к этому инциденту, офицер Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530740
					]
				},
				{
					"id": 741530740,
					"content": "#А, эм, извините, капитан {NICKNAME}. Этого больше не повторится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530741,
						741530742
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530741,
					"content": "Продолжай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530743
					]
				},
				{
					"id": 741530743,
					"content": "Я как раз к этому веду. Я узнал об этом от другого человека. Говорят, что Осень просила отца выступить в суде, но он отказался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530744
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530744,
					"content": "Бенуа не был женат. Из детей одна только дочь... И, насколько я помню, хоть её удочерили, она была его кровной родственницей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530745
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530745,
					"content": "Так или иначе, её единственный отец не стал выступать свидетелем в суде, и, как вы понимаете, её отправили в крепость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530746
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530746,
					"content": "Поступил ли он так, чтобы получить дом в своё полное распоряжение или из-за каких-то разногласий с дочерью - я не берусь гадать, хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530747
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530747,
					"content": "Обычно он выглядит достаточно дружелюбно, не так ли? Я тоже помню, как он угощал меня сладостями. Кто бы мог подумать, что он такой кровожадный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530748
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530748,
					"content": "Хм. Знаете, офицер, за всё это время вы ни разу не нахмурились. Я думал, что это я хладнокровный, но у вас совершенно точно в жилах лёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530749
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530749,
					"content": "Это называется профессионализм.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530750
					]
				},
				{
					"id": 741530750,
					"content": "Разве это не достойно уважения? Итак, офицеры, что вы думаете о преступлениях Бенуа? Они достаточно серьёзны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530751
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530751,
					"content": "Без комментариев.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530752
					]
				},
				{
					"id": 741530752,
					"content": "Неужели всё так плохо? А как же его дом? Его конфискуют?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530753,
						741530754
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530753,
					"content": "Возможно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530755
					]
				},
				{
					"id": 741530755,
					"content": "Ха, я так и знал. Крыса может выскочить на поверхность, но крысой она и останется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530756
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530756,
					"content": "Спасибо, офицеры, за прекрасный день. С нетерпением жду новой встречи с вами здесь, во Флёв Сандр. Хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530757
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530757,
					"content": "Хм... Это... У Паймон возникло противоречивое чувство. Поначалу Бенуа произвёл очень хорошее впечатление...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530758,
						741530760
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530758,
					"content": "Не суди о книге по обложке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530759
					]
				},
				{
					"id": 741530759,
					"content": "Ох, неужели Паймон слишком глупа и не разглядела, что он за человек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530763
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530763,
					"content": "В любом случае это даёт пищу для размышлений. Паймон от всего этого становится как-то не по себе. Наверное, стоит покинуть это место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530764
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530764,
					"content": "Тогда пойдём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530765
					]
				},
				{
					"id": 741530765,
					"content": "Да, пойдём посидим на солнышке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530760,
					"content": "Мы услышали только одну версию истории от случайного собеседника.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530761
					]
				},
				{
					"id": 741530761,
					"content": "Это так, но Паймон не уверена, что мы можем полностью доверять Бенуа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530762
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530762,
					"content": "Ужасное ощущение! Хорошо, что Паймон может доверять тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530763
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530754,
					"content": "Такая вероятность существует.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530755
					]
				},
				{
					"id": 741530742,
					"content": "Что там за секрет, о котором ты говорил?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530743
					]
				},
				{
					"id": 741530739,
					"content": "#Вы, как я вижу, не очень внимательно изучили материалы дела. Я разочарован{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530740
					]
				},
				{
					"id": 741530732,
					"content": "Всё зависит от того, что именно ты собираешься рассказать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530733
					]
				},
				{
					"id": 741530733,
					"content": "О, у меня много тайн. Это же Флёв Сандр. Здесь никто не может спокойно спать, если у него нет в запасе нескольких чужих секретов, хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530734
					],
					"speakerTitle": "Снодграсс"
				},
				{
					"id": 741530708,
					"content": "Мы надеемся на твою помощь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530709
					]
				}
			]
		},
