				"points": []
			},
			"dialogs": [
				{
					"id": 741531201,
					"content": "Что ты можешь сказать об этом чеке?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741531202
					]
				},
				{
					"id": 741531202,
					"content": "Продано недавно. Плоскогубцы, пилы и свечи? Странный вопрос...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531203
					],
					"speakerTitle": "Бракари"
				},
				{
					"id": 741531203,
					"content": "Если вам нужны ингредиенты для закусок, то их у меня много, а вот этого у меня мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531204
					],
					"speakerTitle": "Бракари"
				},
				{
					"id": 741531204,
					"content": "Мы не хотим покупать эти вещи, бабушка. Мы спрашиваем, не покупал ли кто-нибудь их в последнее время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741531205,
					"content": "О, дайте подумать... На самом деле, да, было дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531206
					],
					"speakerTitle": "Бракари"
				},
				{
					"id": 741531206,
					"content": "Несколько дней назад приходили двое молодых людей, мужчина и женщина, и купили эти вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531207
					],
					"speakerTitle": "Бракари"
				},
				{
					"id": 741531207,
					"content": "Они сказали, что хотели дома смастерить что-то из дерева, но им не хватает инструментов. Что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531208
					],
					"speakerTitle": "Бракари"
				},
				{
					"id": 741531208,
					"content": "О, нет, нет, мы просто проводим... социально-экономическое исследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741531209,
					"content": "Социально-экономическое исследование, говоришь? Хе-хе, вы здесь в поисках информации, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531210
					],
