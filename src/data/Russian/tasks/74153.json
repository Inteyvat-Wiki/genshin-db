				]
			},
			"dialogs": [
				{
					"id": 741530501,
					"content": "Ящик смотрится здесь совершенно неуместно и воняет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530502,
					"content": "Я подозреваю, что его привезли из Флёв Сандр.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530503
					]
				},
				{
					"id": 741530503,
					"content": "Значит, кто-то из семьи Бенуа ездил туда... Да и сам он родом оттуда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530504,
					"content": "#Все имеющиеся у нас подсказки связаны с этим местом, {NICKNAME}. Возможно, там мы найдём больше полезной информации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741530505,
					"content": "Вперёд!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530506
					]
				},
				{
					"id": 741530506,
					"content": "Во Флёв Сандр!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7415307,
			"completionStepIds": [
				7415307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
