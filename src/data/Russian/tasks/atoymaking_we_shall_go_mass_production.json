			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бертран"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726970101,
					"content": "#Хах, {NICKNAME} и Паймон, а вот и вы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970102
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970102,
					"content": "Город игрушек объявляю открытым!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970103
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970103,
					"content": "Город игрушек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726970104,
					"content": "Кхе-кхе, ну пока это только я и моя Великолепная машина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970105
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970105,
					"content": "Итак, я упростил этапы. Теперь производство должно занять намного меньше времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970106
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970106,
					"content": "Конечно, мгновенно не получится, но будет быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970107
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970107,
					"content": "Ого, звучит здорово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726970108,
					"content": "А ещё я улучшил коллектор материалов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970109
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970109,
					"content": "Раньше вам всё время приходилось бегать туда-сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970110
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970110,
					"content": "Я подумал, что это неэффективно и кое-что поменял. Теперь он обновляет текущий этап в зависимости от вашего сбора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970111
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970111,
					"content": "Обновляет текущий процесс...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726970112,
					"content": "В зависимости от нашего сбора?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726970113,
					"content": "Паймон не понимает...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970114
					]
				},
				{
					"id": 726970114,
					"content": "Хм, как бы объяснить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970115
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970115,
					"content": "Допустим, на первом этапе требуется десять закатников, на втором этапе нужен Гидро элемент, а на третьем - победить двух Гидро слаймов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970116
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970116,
					"content": "У тебя в руках коллектор материалов с десятью закатниками. В таком случае он решит, что сбор материалов для первого этапа закончен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970117
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970117,
					"content": "А затем он...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970118
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970118,
					"content": "Паймон поняла! А затем он сам начнёт сбор для второго этапа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726970119,
					"content": "Умница! Он перейдёт в режим «Наполнение энергией», а когда вы закончите собирать Гидро элементы, он снова изменит процесс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970120,
						726970121
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970120,
					"content": "И перейдёт к третьему этапу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				},
				{
					"id": 726970122,
					"content": "Да. Тебе останется только победить двух Гидро слаймов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970123
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970123,
					"content": "Кажется, стало намного удобнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726970124,
					"content": "Именно! Я всю ночь провозился с этим улучшением. Я называю это универсальным решением «Три в одном»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970125
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970125,
					"content": "Этот коллектор материалов такой замечательный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726970126,
					"content": "Я тоже так думаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970127
					]
				},
				{
					"id": 726970127,
					"content": "Хех...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970128
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970128,
					"content": "Но зачем ты отдаёшь свой коллектор нам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726970129,
					"content": "Хе-хе, я пока застрял на Рито... Как мне собирать материалы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970130
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970130,
					"content": "Помогите мне и получите немного прибыли от продажи игрушек и одну игрушку бесплатно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970141
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970141,
					"content": "Помнишь тот купон? Хе-хе, можешь обменять его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970142
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970142,
					"content": "Ну, конечно, если такая модель игрушки уже создана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970131
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970131,
					"content": "Что? Да мы же пол-Тейвата оббегали, все материалы собрали, а за это получим только немного моры и всего одну игрушку?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726970132,
					"content": "#Это ни в какие ворота не лезет! Идём, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726970133,
					"content": "Погодите... А как насчёт чуть большей доли и двух... ладно, трёх игрушек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970134
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970134,
					"content": "Паймон, мы уходим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970135
					]
				},
				{
					"id": 726970135,
					"content": "Четыре! Четыре! Я больше просто не могу предложить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970136
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970136,
					"content": "Ох, да я бы вам хоть все игрушки отдал, если бы не мой долг. Ведь я ещё должен кучу моры Международной торговой ассоциации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970137
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970137,
					"content": "Бедняга.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970138
					]
				},
				{
					"id": 726970138,
					"content": "Эх... Слушай, мы взялись тебе помогать не ради моры или игрушек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726970139,
					"content": "Хе-хе, без вас я бы не справился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970140
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970140,
					"content": "Такое облегчение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726970121,
					"content": "И начнёт «Активацию ядра»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				}
			]
		}
	]
}