					],
					"speakerTitle": "Паромщица"
				},
				{
					"id": 400350602,
					"content": "Здравствуйте. Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350603
					],
					"speakerTitle": "Паромщица"
				},
				{
					"id": 400350603,
					"content": "Мы ищем вашего консультанта Чжун Ли...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350604
					]
				},
				{
					"id": 400350604,
					"content": "Понятно. Боюсь, он сейчас с управляющей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350605
					],
					"speakerTitle": "Паромщица"
				},
				{
					"id": 400350605,
					"content": "С управляющей? В смысле, работает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350606,
					"content": "Управляющая сказала, что они идут на прогулку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350607
					],
					"speakerTitle": "Паромщица"
				},
				{
					"id": 400350607,
					"content": "Вы можете попробовать поискать их в ресторане «Три чашки в порту».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350608
					],
					"speakerTitle": "Паромщица"
				},
				{
					"id": 400350608,
					"content": "Я слышала, что управляющая часто ходит туда для... э-э-э, продвижения наших услуг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паромщица"
				}
			]
		},
		{
			"id": 4003507,
			"completionStepIds": [
				4003507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
