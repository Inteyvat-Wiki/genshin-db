				"points": []
			},
			"dialogs": [
				{
					"id": 400350701,
					"content": "Ух... Я так объелась, сейчас лопну!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350787
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 400350787,
					"content": "♪!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350702
					],
					"speakerTitle": "Гоба"
				},
				{
					"id": 400350702,
					"content": "Сян Лин, а ты здорово придумала подавать рыбу с соусом, вкус такой, что умереть можно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350703
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 400350703,
					"content": "Хи-хи, это мой фирменный соус. Я знала, что получится очень вкусно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350704
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 400350704,
					"content": "Хм, жареный заоблачный перчик, чесночная паста, нарезанный зелёный лук, соль, уксус и соевый соус, всё обжарено в горячем масле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350705
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350705,
					"content": "Этот рецепт может показаться грубоватым, но он полностью зависит от баланса вкусов и приправ, выверенного шеф-поваром. Всё должно быть сбалансировано идеально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350706
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350706,
					"content": "Именно непревзойдённое владение этим балансом превращает скромное блюдо в изысканное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350780
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350780,
					"content": "Да! Вот так комплимент, Сян Лин, согласна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350781
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 400350781,
					"content": "Хи-хи... Я польщена. Спасибо, господин Чжун Ли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350782
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 400350782,
					"content": "Я считала себя мастером слова, но вы меня определённо превосходите, господин Чжун Ли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350783
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 400350783,
					"content": "Вы слишком добры. Ваше красноречие... кхм, печально известно в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350784
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350784,
					"content": "♪~♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350785
					],
					"speakerTitle": "Гоба"
				},
				{
					"id": 400350785,
					"content": "Что такое? Хочешь что-нибудь заказать, Гоба? Что бы это ни было, я угощаю! Я только открою в меню раздел Сян Лин!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350786
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 400350786,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350707
					],
					"speakerTitle": "Гоба"
				},
				{
					"id": 400350707,
					"content": "Эй, вы снова обсуждаете вкусную еду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350708,
					"content": "#Ой! Это же {NICKNAME} и Паймон! Что привело вас сюда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350709
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 400350709,
					"content": "Стойте! Я угадаю. Хм, да... Вы прибыли на Праздник морских фонарей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350710
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 400350710,
					"content": "Разве это не очевидно? Любой бы догадался!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350711
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350711,
					"content": "Ой, да ладно! Это же шутка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350712
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 400350712,
					"content": "Вы пришли как раз вовремя, я собиралась подать своё новое блюдо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350779
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 400350779,
					"content": "Владелец «Трёх чашек в порту» сказал, что и три чашки бы съел! Господину Чжун Ли и Ху Тао, похоже, тоже понравилось, но я считаю, что никогда не помешает предложить попробовать как можно большему количеству людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350713
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 400350713,
					"content": "Что скажете? Хотите попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350714
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 400350714,
					"content": "Как будто Паймон нужно спрашивать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350715
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350715,
					"content": "Спасибо, но мы пришли к господину Чжун Ли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350716
					]
				},
				{
					"id": 400350716,
					"content": "А? То есть, мы не будем ничего есть? Ладно... Давай вернёмся к делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350717
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350717,
					"content": "#Давно не виделись, {NICKNAME}. Как проходит ваше путешествие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350718
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350718,
					"content": "Неплохо, мы многому научились по пути.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350719
					]
				},
				{
					"id": 400350719,
					"content": "Прекрасно, в этом и заключается ценность путешествия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350720
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350720,
					"content": "Ну так что, зачем вам понадобился наш консультант? Рассказывайте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350721
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 400350721,
					"content": "И мы здесь тоже по делу, вообще-то! Мы заглянули к Сян Лин только потому, что оказались поблизости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350722
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 400350722,
					"content": "Делу? Какие дела могут быть у ритуального бюро во время праздника?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350723
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350723,
					"content": "Даже в самые весёлые праздники жизнь продолжает течь своим чередом. Разве это так необычно? Но не стоит волноваться, просто сегодня такой хороший денёк, и я решила, что мы могли бы прогуляться и немного заняться рекламой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350724
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 400350724,
					"content": "Ну вы можете тут поболтать, а мы с Сян Лин сходим попить чаю. Чжун Ли, только не забудь зайти за мной, когда закончишь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350725
					],
					"speakerTitle": "Ху Тао"
				},
				{
					"id": 400350725,
					"content": "Конечно, до встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350726
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350726,
					"content": "#Итак, {NICKNAME}, что привело тебя ко мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350727
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350727,
					"content": "Если вкратце...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350728
					]
				},
				{
					"id": 400350728,
					"content": "Вы рассказываете Чжун Ли о Кэ Цин...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400350729
					]
				},
				{
					"id": 400350729,
					"content": "Хм, да. Нефритовое Равновесие честна, умна и очень прилежна. Она способна взять на себя ответственность, на которую мало бы кто отважился, но всё должно быть в равновесии, а здоровье человека, безусловно, имеет вес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350730
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350730,
					"content": "Мы можем как-нибудь ей помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350731
					]
				},
				{
					"id": 400350731,
					"content": "Да. Все знают, что ты очень умный, так что Паймон уверена, что она к тебе прислушается!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350732
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350732,
					"content": "Если бы я всё ещё был могущественным Властелином Камня, я мог бы её убедить. Но, увы, теперь я всего лишь обычный консультант. Мои слова больше не имеют такого веса, как когда-то прежде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350733
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350733,
					"content": "Кроме того, я совсем не близок с Нефритовым Равновесием. Если я возьму на себя смелость прочитать ей лекцию, это может легко привести к эффекту, противоположному от желаемого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350734
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350734,
					"content": "Ты прав... Что же нам делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350735
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350735,
					"content": "Мы могли бы применить более тонкий подход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350736
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350736,
					"content": "Например, рассказать историю, содержащую ваше послание, которая тронет её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350737
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350737,
					"content": "История получится замечательной, если в ней будут темы из её повседневной жизни. А если в ней ещё и будет кто-то близкий ей, то она окажется ещё более эффективной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350738
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350738,
					"content": "Паймон не совсем понимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350739
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350739,
					"content": "Давай поговорим с теми, кто знаком с Кэ Цин.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350740
					]
				},
				{
					"id": 400350740,
					"content": "#Я знал, что ты всё поймёшь. Молодец, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350741
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350741,
					"content": "Отыщи источники для истории. Конечно же, я всегда дам совет, если потребуется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350742
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350742,
					"content": "Как только мы придумаем сюжет, ты сможешь рассказать историю Нефритовому Равновесию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350743
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350743,
					"content": "Я?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350744
					]
				},
				{
					"id": 400350744,
					"content": "Ты находишься в дружественных отношениях с Нефритовым Равновесием, что делает тебя идеальным кандидатом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350745
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350745,
					"content": "Паймон поняла! Нужно просто поговорить со знакомыми Кэ Цин, да? С кого начнём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350746
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350746,
					"content": "Всем привет, надеюсь, я не помешала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350747
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350747,
					"content": "А? Кэ Цин!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350748
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350748,
					"content": "Господин Чжун Ли, я не ожидала вас здесь встретить. Спасибо за вашу помощь на Церемонии Вознесения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350749
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350749,
					"content": "Не за что. Это меньшее, что я мог сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350750
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350750,
					"content": "Кэ Цин, а что ты здесь делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350751
					]
				},
				{
					"id": 400350751,
					"content": "Хм? Что у вас за странные лица?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350752
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350752,
					"content": "Прошу прощения, кажется, я помешала вашему разговору с господином Чжун Ли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350753
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350753,
					"content": "Нет-нет, совсем нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350754
					]
				},
				{
					"id": 400350754,
					"content": "Кэ Цин, ты искала нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350755
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350755,
					"content": "Да, я хотела попросить вас познакомить меня с Адептами. Я подумала, что было бы неплохо отправить им подарки от лица Цисин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350756
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350756,
					"content": "Но разве ты не виделась с ними во время обороны Ли Юэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350757
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350757,
					"content": "Ты можешь просто навестить их в Заоблачном пределе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350758
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350758,
					"content": "Да, но мы виделись лишь мельком. Адепты наверняка уже забыли меня, и я боюсь, что было бы невежливо появляться так внезапно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350759
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350759,
					"content": "Поэтому я подумала, что лучше попросить вас познакомить меня с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350760,
						400350761
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350760,
					"content": "Конечно, без проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350764
					]
				},
				{
					"id": 400350764,
					"content": "Значит, тебе даже приходится лично разносить подарки... Да уж, быть одной из Цисин непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350765
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350765,
					"content": "Мы с радостью поможем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350766
					]
				},
				{
					"id": 400350766,
					"content": "#Спасибо, {NICKNAME}. Я пойду приготовлю подарки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350767
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350767,
					"content": "Мне жаль заставлять вас бегать по делам во время праздника. Обещаю справиться как можно быстрее, чтобы вы вернулись до начала шоу фейерверков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350768
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350768,
					"content": "Значит, мы посмотрим на фейерверки вместе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350769
					]
				},
				{
					"id": 400350769,
					"content": "А? В-вместе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350770
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350770,
					"content": "Хорошо. Я схожу с вами посмотреть на фейерверки, когда закончу с работой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350771
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350771,
					"content": "Кстати говоря, господин Чжун Ли, фейерверки в этом году будут особенно чудесными. Пожалуйста, не пропустите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350772
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350772,
					"content": "Конечно. Большое спасибо за напоминание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350773
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350773,
					"content": "#Мне пора идти. {NICKNAME}, как будешь готов{F#а}, найди меня в Нефритовом дворце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350774
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350774,
					"content": "Всё, ушла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350775
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350775,
					"content": "Нефритовое Равновесие, эффективная и надёжная, как и всегда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350776
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350776,
					"content": "#Ты тоже надёжный, Чжун Ли! Да, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350777
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350777,
					"content": "Спасибо, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350778
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350778,
					"content": "Пожалуйста, не забывай наш разговор. Как только вы соберете достаточно сведений для истории, мы сможем снова встретиться здесь и обсудить дальнейший план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 400350761,
					"content": "Ты пробовала спросить Гань Юй?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350762
					]
				},
				{
					"id": 400350762,
					"content": "К сожалению, у Гань Юй сейчас выходные, поэтому я не могу с ней поговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350763
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350763,
					"content": "Боюсь, мне необходима ваша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350764
					],
					"speakerTitle": "Кэ Цин"
				}
			]
		},
		{
			"id": 4003508,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
