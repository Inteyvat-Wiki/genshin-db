	"talks": [
		{
			"id": 4003502,
			"completionStepIds": [
				4003502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003502",
							"2"
						],
						"stepId": 4003502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нин Гуан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350201,
					"content": "...Отправь этот отчёт в Департамент по делам граждан и попроси их делегировать задачи из списка соответствующим службам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350202
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350202,
					"content": "Кроме того, обязательно передай им, что пусть Праздник морских фонарей и сложен в организации, всё должно быть безупречно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350203
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350203,
					"content": "Госпожа Нин Гуан! Привет, это снова мы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350204,
					"content": "Мы тебя не отвлекаем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350205
					]
				},
				{
					"id": 400350205,
					"content": "Конечно же нет. Вы мои почётные гости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350206
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350206,
					"content": "И, судя по всему, я предполагаю, что вы прибыли на Праздник морских фонарей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350207
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350207,
					"content": "Да! Что ждёт нас на празднике в этом году?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350208,
					"content": "Как и всегда, будут проходить различные мероприятия. Но одно из них представляет особый интерес... Департамент по делам граждан планирует устроить шоу фейерверков. Безусловно, его не стоит пропускать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350221
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350221,
					"content": "Лунные фонари всегда были важнейшей частью Праздника морских фонарей, но после того, что происходило в Ли Юэ последнее время, думаю, жителям города нужно что-то, что сможет согреть их сердца и подарить чувство единения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350222
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350222,
					"content": "Я считаю, что в этом году нужно устроить особый праздник, настолько волшебный, чтобы он смог тронуть сердце каждого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350223
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350223,
					"content": "Сейчас мы размещаем фейерверки по всему Ли Юэ. В определённый момент праздника мы запустим их все одновременно, чтобы сверкающие огни смогли вселить радость в сердца людей. По крайней мере, так решил Департамент по делам граждан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350209
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350209,
					"content": "Фейерверки? Но мы уже видели фейерверки раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350210,
					"content": "В фейерверках Ли Юэ есть что-то особенное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350211,
					"content": "Фейерверки, наряду со многими другими изобретениями, были придуманы здесь, в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350212
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350212,
					"content": "Когда наши предки впервые создали фейерверки, изначально они назвали их «хлопушками». Их яркие вспышки и громкие звуки часто использовались для отпугивания зверей или в качестве предупреждающих сигналов другим людям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350213
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350213,
					"content": "В те дни людям было трудно связаться друг с другом, когда они работали в поле. Поэтому они носили с собой хлопушки, чтобы подавать сигналы при необходимости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350214
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350214,
					"content": "Но образ жизни людей начал меняться после основания Ли Юэ. Им больше не нужно было уходить из города, чтобы ухаживать за полями, поэтому хлопушки также начали реже использоваться в чрезвычайных ситуациях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350215
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350215,
					"content": "Но благодаря нашим традициям новаторский дух прежних хлопушек сохраняется до сих пор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350216
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350216,
					"content": "Хлопушки были ранними предшественниками фейерверков. Мы усовершенствовали их и начали зажигать во время Праздника морских фонарей, чтобы почтить память наших мужественных предков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350217
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350217,
					"content": "Типичный Ли Юэ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350218
					]
				},
				{
					"id": 400350218,
					"content": "Ого, в Ли Юэ у всего есть история...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350219,
					"content": "Как вы уже наверняка знаете, всё на этой земле с течением времени накапливает ценность и историю. Такова природа Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350220
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350220,
					"content": "Я назначила Кэ Цин ответственной за шоу фейерверков. Если вам интересно, почему бы нам не навестить её вместе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нин Гуан"
				}
			]
		},
		{
			"id": 4003503,
			"completionStepIds": [
				4003503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003503",
							"2"
						],
						"stepId": 4003503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кэ Цин",
					"Пэн И"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350301,
					"content": "Хм, нужно разместить фейерверки в ещё нескольких местах. Шоу должно быть видно по всему Ли Юэ, а не только в городе. В деревне Цинцэ тоже ведь отмечают Праздник морских фонарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350302
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350302,
					"content": "Но госпожа Кэ Цин, как же бюджет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350303
					],
					"speakerTitle": "Пэн И"
				},
				{
					"id": 400350303,
					"content": "Бюджет именно такой, как следует. Этой суммы хватит для достижения всех целей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350304
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350304,
					"content": "Если ты считаешь, что этих средств будет недостаточно, то мы просто подадим заявку на дополнительное финансирование от Департамента по делам граждан и дождёмся их одобрения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350305
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350305,
					"content": "Наша цель - организовать незабываемый Праздник морских фонарей. Бюджет служит лишь для облегчения планирования, но мы не должны упускать из виду нашу цель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350306
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350306,
					"content": "Да, госпожа Кэ Цин, я понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350307
					],
					"speakerTitle": "Пэн И"
				},
				{
					"id": 400350307,
					"content": "Отлично. И не забывай, безопасность превыше всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350308
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350308,
					"content": "#Нин Гуан, {NICKNAME}. Рада вас видеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350309
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350309,
					"content": "Вы прибыли на праздник морских фонарей? Лучшего момента и не придумаешь, приготовления почти закончены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350310
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350310,
					"content": "Над чем ты работаешь, Кэ Цин?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350311
					]
				},
				{
					"id": 400350311,
					"content": "Я проверяю расположение фейерверков и соответствующие объекты... Это всё пустяки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350312
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350312,
					"content": "Прости за прямоту, но, если я не ошибаюсь, ты могла бы с таким же успехом оставить эти задачи своим подчиненным. Последнее время ты работаешь круглыми сутками, уверена, что перерыв тебе бы не помешал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350313
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350313,
					"content": "Всё в порядке, я справлюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350314
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350314,
					"content": "Пэн И, пожалуйста, отредактируй наши планы, составь краткий отчёт и отправь его в Департамент по делам граждан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350315
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350315,
					"content": "Я схожу в город проверить установку фейерверков. Скоро вернусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350316
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350316,
					"content": "#{NICKNAME}, ты наш почётный гость. Пожалуйста, воспользуйся возможностью задержаться в Ли Юэ и насладиться праздничной атмосферой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350317
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350317,
					"content": "Пэн И, ты запомнил, что я тебе сказала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350318
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350318,
					"content": "Да, госпожа Кэ Цин, не волнуйтесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350319
					],
					"speakerTitle": "Пэн И"
				},
				{
					"id": 400350319,
					"content": "#Хорошо. Нин Гуан, {NICKNAME}, до свидания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350320
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 400350320,
					"content": "#Простите, госпожа Нин Гуан и... путешественни{F#ца}{M#к}, мне нужно идти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350321
					],
					"speakerTitle": "Пэн И"
				},
				{
					"id": 400350321,
					"content": "Госпожа Кэ Цин сделала много распоряжений, мне нужно заново переписать все планы, так что время сейчас на вес золота.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350355
					],
					"speakerTitle": "Пэн И"
				},
				{
					"id": 400350355,
					"content": "Минутку! Чуть не забыл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350356
					],
					"speakerTitle": "Пэн И"
				},
				{
					"id": 400350356,
					"content": "#{NICKNAME}, это пусковая труба. Госпожа Кэ Цин сказала, что тебе может быть интересно, поэтому попросила меня передать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350357
					],
					"speakerTitle": "Пэн И"
				},
				{
					"id": 400350357,
					"content": "Такой умелец, как ты, определённо сможет использовать её для создания собственных фейерверков. Попробуй, когда выдастся возможность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350322
					],
					"speakerTitle": "Пэн И"
				},
				{
					"id": 400350322,
					"content": "Паймон не удалось вставить ни единого словечка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350323,
					"content": "Точнее, Паймон не решалась открывать рот во время их разговора, но всё же!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350324,
					"content": "Кэ Цин очень внушительная...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350325
					]
				},
				{
					"id": 400350325,
					"content": "#Ты тоже заметил{F#а}? Влияние Кэ Цин стало ещё сильнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350326,
					"content": "А ещё, кажется, у неё прибавилось забот... Интересно, почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350327,
					"content": "С тех пор как адепты оставили Ли Юэ в руках смертных, мы, Цисин, взяли на себя ответственность за руководство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350328
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350328,
					"content": "Мы взяли на себя решение многих жизненно важных задач в различных сферах, а также мы отвечаем за планирование и организацию всевозможных дел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350329
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350329,
					"content": "И всё же ответственность временами бывает утомительной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350330
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350330,
					"content": "Прежде за организацию Праздника морских фонарей отвечала Цзян Чжоу, но сейчас её отец уже довольно стар, поэтому в этом году она перешла работать в другой департамент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350331
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350331,
					"content": "В конце концов, организация Праздника морских фонарей перешла ко мне и Кэ Цин. Я являюсь главным организатором, в то время как Кэ Цин отвечает за долгожданное шоу фейерверков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350332
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350332,
					"content": "Такое важное событие следовало доверить наиболее квалифицированному кандидату. Кэ Цин дисциплинирована, но при этом увлечена своей работой, поэтому она подходит лучше всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350333
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350333,
					"content": "Она и правда очень дисциплинирована...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350334
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350334,
					"content": "Да. Она строга как к себе, так и к другим, иногда даже чрезмерно. Она уже несколько дней работает без перерыва.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350335
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350335,
					"content": "Я обеспокоена тем, какие последствия это может принести в будущем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350336
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350336,
					"content": "Поиск баланса - важнейший аспект культуры Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350337
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350337,
					"content": "Я пыталась с ней поговорить, но вы же знаете, какая она... Своим острым языком она заткнёт кого угодно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350338
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350338,
					"content": "#{NICKNAME}, вы с Кэ Цин довольно близки, может, ты попробуешь поговорить с ней? Возможно, она прислушается к тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350339,
						400350340
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350339,
					"content": "Да, конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350341
					]
				},
				{
					"id": 400350341,
					"content": "#Спасибо, {NICKNAME}. Я рада, что ты можешь помочь. С Кэ Цин иногда бывает непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350342
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350342,
					"content": "Мне нужно заняться другими делами в Нефритовом дворце, так что я оставлю Кэ Цин тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350343
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 400350343,
					"content": "Нин Гуан уходит...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400350344
					]
				},
				{
					"id": 400350344,
					"content": "#Ты уверен{F#а}, что мы сможем убедить Кэ Цин немного отдохнуть? Даже у Нин Гуан это не получилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350345
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350345,
					"content": "К тому же прежде чем убеждать кого-то, нужно хотя бы попытаться представить себя на его месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350346
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350346,
					"content": "Кэ Цин работает без перерывов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350347
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350347,
					"content": "Значит, она... устала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350348
					]
				},
				{
					"id": 400350348,
					"content": "Да ладно, это любой поймёт! Подумай хорошенько, что она чувствует глубоко-глубоко внутри?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350349
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350349,
					"content": "Или мы можем спросить друга, который разбирается в этом получше нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350350
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350350,
					"content": "Давай поговорим с Чжун Ли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350351
					]
				},
				{
					"id": 400350351,
					"content": "А? Чжун Ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350352
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350352,
					"content": "Он хорошо понимает жителей Ли Юэ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350353
					]
				},
				{
					"id": 400350353,
					"content": "С этим не поспоришь! Что ж, идём к Чжун Ли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350354
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350354,
					"content": "Он всё ещё работает консультантом в ритуальном бюро «Ваншэн». Пойдём посмотрим, там ли он!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400350340,
					"content": "Я что-нибудь придумаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350341
					]
				}
			]
		},
