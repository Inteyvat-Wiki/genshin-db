			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ипэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722080101,
					"content": "Ты неплохо ловишь рыбу! Хотя, тебе тоже есть куда расти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080102,
						722080103
					],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080102,
					"content": "Что?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				},
				{
					"id": 722080104,
					"content": "Ха-ха, прости... Я всегда забываю поздороваться. Всегда забываю, что могу напугать людей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080105
					],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080105,
					"content": "Тем не менее ты этим наслаждаешься...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080106
					]
				},
				{
					"id": 722080106,
					"content": "О, да ладно! Пугать детей время от времени весело, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080107
					],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080107,
					"content": "Кхе-кхе, давай вернёмся к разговору о рыбалке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080108,
						722080109
					],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080108,
					"content": "У тебя ко мне серьёзный разговор?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080110,
					"content": "Мне неловко об этом говорить... Когда я рыбачил, то уронил амулет, который дала мне Макири. В нём содержатся благословения духов её предков и Громовой Птицы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080111
					],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080111,
					"content": "Когда мы сядем в лодку, и она узнает, что я потерял такую важную вещь, это будет ужасно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080112
					],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080112,
					"content": "Золотой лодочник обещал, что пришлёт кого-нибудь помочь мне, но никто так и не появился. Я подумал, что раз уж ты здесь, то сможешь мне помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080113,
						722080114
					],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080113,
					"content": "#А я-то думал{F#а}, что на тебя можно положиться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080115
					]
				},
				{
					"id": 722080115,
					"content": "Обычно я рыбачу вон там, но моя память становится все слабее и слабее, поэтому прошу тебя помочь мне с поиском...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080116,
						722080117
					],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080116,
					"content": "Поскольку это напоминание о старых временах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080118,
					"content": "О чём ты говоришь? У чужаков есть особые методы поиска вещей?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080119
					],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080119,
					"content": "Что бы это ни было, ты сможешь найти амулет только после того, как найдёшь нужное место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080120
					],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080120,
					"content": "А как мне искать сам амулет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080121
					]
				},
				{
					"id": 722080121,
					"content": "Посредством рыбалки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080122
					],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080122,
					"content": "Ясно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080123
					]
				},
				{
					"id": 722080123,
					"content": "#Спасибо тебе, {F#чужеземная подруга}{M#чужеземный друг}! Да хранят тебя Громовая птица и наши предки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080117,
					"content": "Думаю, перо должно помочь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080114,
					"content": "Ты - это что-то...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080199
					]
				},
				{
					"id": 722080199,
					"content": "К западу от равнин Аутакэ есть островок напротив трёх водопадов... Он находится на побережье к западу от островка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080115
					],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080109,
					"content": "Только о рыбалке и думаешь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080103,
					"content": "Хорошо было бы сначала поздороваться!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				}
			]
		},
