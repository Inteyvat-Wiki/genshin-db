					"nextDialogs": [
						722080403
					]
				},
				{
					"id": 722080403,
					"content": "#Понятно. Не торопись. Береги себя, {F#чужеземка}{M#чужеземец}.",
					"roleType": "TALK_ROLE_NPC",
