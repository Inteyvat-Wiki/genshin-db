				{
					"id": 722080201,
					"content": "Спасибо большое! Теперь я наконец-то могу спокойно сесть в лодку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080202
					],
					"speakerTitle": "Ипэ"
				},
				{
					"id": 722080202,
					"content": "Куда направляется эта лодка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "В золотую страну грёз. В царство без тумана. Мы встретимся снова во сне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ипэ"
