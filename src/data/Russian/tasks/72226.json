			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ру"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722260301,
					"content": "#Спасибо, {NICKNAME}! Спасибо, Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260302
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722260302,
					"content": "Вижу, гнездовье в отличном состоянии. На этот раз церемония точно пройдёт как надо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260303,
						722260304
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722260303,
					"content": "Легко справились.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260304,
					"content": "Было опасно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260305,
					"content": "#Хе-хе. Сынок, Паймон и {NICKNAME} путешественники бывалые!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722260306,
					"content": "#Слушай, {NICKNAME}, а откуда ты родом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260307
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722260307,
					"content": "Люди, которые приходили сюда раньше, говорили о некой Инадзуме и острове Наруками. Вы тоже из Инадзумы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260308,
						722260312
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722260308,
					"content": "Можно и так сказать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260309
					]
				},
				{
					"id": 722260309,
					"content": "Да, мы действительно с острова Наруками... Постой-ка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722260310,
					"content": "Паймон почти забыла, что мы ищем маусиро!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722260311,
					"content": "Мы прибыли из очень, очень далёкого места...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260312
					]
				},
				{
					"id": 722260312,
					"content": "Это точно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722260313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260314
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722260314,
					"content": "Круто! Вы даже летали верхом на драконе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260315,
						722260316
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722260315,
					"content": "Да, но было это очень неудобно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260316,
					"content": "Да, и было это очень неплохо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260317,
					"content": "С ума сойти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260318
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722260318,
					"content": "Мир, знаешь ли, огромен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722260319,
					"content": "Я и не догадывался, что за морем тумана так много разных мест и столько людей. Если я однажды выберусь отсюда, то хочу посмотреть их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260320
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722260320,
					"content": "Нам постоянно говорят, мол, если покинуть туман, наши души потеряются, и что он защищает нас от тьмы извне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260321
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722260321,
					"content": "Но я уже повстречал немало людей из внешнего мира. Потому-то мне известно, что Море молчания должно быть населено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260322
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722260322,
					"content": "Если у тебя есть такая возможность, можем посмотреть вместе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260323
					]
				},
				{
					"id": 722260323,
					"content": "Хорошо! Значит, договорились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260324
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722260324,
					"content": "Вы идите первыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260325
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722260325,
					"content": "Когда закончится церемония, вместе исследуем мир за пределами острова Цуруми!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722260326,
					"content": "Конечно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ру"
				}
			]
		},
