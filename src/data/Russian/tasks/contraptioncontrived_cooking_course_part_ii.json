			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хранитель Облаков"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010101,
					"content": "Справится ли эта машина с десертом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010102
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705010102,
					"content": "Что будете делать в этот раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010103
					]
				},
				{
					"id": 705010103,
					"content": "#Путешественни{F#ца}{M#к}, ты, как всегда, вовремя. Я как раз собиралась приготовить следующее блюдо - так называемый «пудинг».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010104
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705010104,
					"content": "Этот самый пудинг я обнаружила среди популярных ныне рецептов. Говорят, что он нежен и ароматен - прекрасный десерт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010105
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705010105,
					"content": "Я немного изменила и улучшила изначальный рецепт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010106
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705010106,
					"content": "И добавила туда рис.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010107
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705010107,
					"content": "Теперь я самолично должна наречь его... Пусть будет «рисовый пудинг».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010108
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705010108,
					"content": "Звучит очень сытно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010109
					]
				},
				{
					"id": 705010109,
					"content": "Для блюда главное - качество риса. Включив «Чудо кулинарной машинерии», я приказала найти первосортный рис. Поиск привёл меня сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010110
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705010110,
					"content": "#Ну что ж, путешественни{F#ца}{M#к}. Поможешь мне собрать первосортного риса, раз уж ты здесь? Машина показывает, что его можно найти где-то поблизости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010111,
						705010112
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705010111,
					"content": "Ну почему опять я...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				},
				{
					"id": 705010113,
					"content": "Для настройки машины нужно время, я же пока не могу разорваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010114
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705010114,
					"content": "#Ты быстр{F#а} и шустр{F#а} - бесценный помощник. Поможешь мне снова, и, когда рисовый пудинг будет готов, уж я тебя не обделю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010115
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705010115,
					"content": "Благодарю за твою помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010116
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705010116,
					"content": "Чудо кулинарной машинерии... включено!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010117
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705010117,
					"content": "#Путешественни{F#ца}{M#к}, машина уже запущена, скорее отправляйся на поиски нужного мне риса, ты отыщешь его по запаху.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705010112,
					"content": "Разве вы летать не умеете...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				}
			]
		},
		{
			"id": 7050102,
			"completionStepIds": [
				7050104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050104",
							"2"
						],
						"stepId": 7050104,
						"stateName": "QUEST_STATE_UNFINISHED"
