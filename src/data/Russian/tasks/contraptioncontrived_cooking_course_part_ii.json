				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Брунн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010201,
					"content": "Спасибо вам! Вы спасли мне жизнь... Я Брунн, торговец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010202
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010202,
					"content": "Эх, вот так неудача. Я вообще перевозил партию товара...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010203
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010203,
					"content": "Вот уж не думал... На полдороге меня внезапно атаковали монстры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010204
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010204,
					"content": "Я просто побежал изо всех сил, не разбирая пути и думать забыв про свои товары... В итоге я прибежал сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010205
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010205,
					"content": "Здесь я подумал, что оторвался от них, и решил проверить, что с товаром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010206
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010206,
					"content": "Но вдруг они опять не пойми откуда выскочили... Хорошо, что вы помогли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010207
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010207,
					"content": "Что ты перевозишь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010208
					]
				},
				{
					"id": 705010208,
					"content": "Я перевожу продукты, рис и всё такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010209
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010209,
					"content": "Похоже на тот рис, который нас просила найти Адепт. Но его, кажется, совсем и не осталось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705010210,
					"content": "Продашь немного риса?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010211
					]
				},
				{
					"id": 705010211,
					"content": "Хочешь рис купить? Не то чтобы я не мог продать, но... я пока бежал, считай, весь товар с телеги по дороге растерял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010212
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010212,
					"content": "Боюсь только, что монстры уже утащили все мои товары к себе в лагерь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010213
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010213,
					"content": "Вот ведь беда. Как же мне получить свои товары? Если я их не верну, то потеряю кучу денег...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010214
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010214,
					"content": "#Путешественни{F#ца}{M#к}... Я вижу, ты очень {M#умелый}{F#умелая}. Можешь помочь мне вернуть товар?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010215
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010215,
					"content": "Если ты мне поможешь, то я тебе сколько угодно риса дам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010216,
						705010218
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010216,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010217
					]
				},
				{
					"id": 705010217,
					"content": "Спасибо! Я рассчитываю на тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010220,
					"content": "Возьми с собой мой товарный аэростат и просто положи товары на него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010221
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010221,
					"content": "#Спасибо тебе, путешественни{F#ца}{M#к}. Я буду ждать тебя здесь. Пожалуйста, верни мне мои вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010218,
					"content": "Я, наверное, столько товара не унесу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010219
					]
				},
				{
					"id": 705010219,
					"content": "Ничего, я знаю способ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "Брунн"
				}
			]
		},
		{
			"id": 7050103,
			"completionStepIds": [
				7050107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050107",
							"2"
						],
						"stepId": 7050107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Брунн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010301,
					"content": "#Ты вернул{F#а} товары? Спасибо тебе большое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010302
					],
					"speakerTitle": "Брунн"
				},
				{
					"id": 705010302,
