			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710120201,
					"content": "«Ветер разносит истории, а время превращает их в легенды...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120202
					],
					"speakerTitle": "Повреждённая надпись"
				},
				{
					"id": 710120202,
					"content": "Это те самые солнечные часы из записок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710120203,
					"content": "Паймон не понимает, что в них такого особенного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710120204,
					"content": "Давай внимательнее изучим эти записки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7101210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101210",
							"2"
						],
						"stepId": 7101210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Генри Мортон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710121001,
					"content": "#Что привело тебя сюда, путешественн{F#ица}{M#ик}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121002
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121002,
					"content": "Глаза бури...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121003
					]
				},
				{
					"id": 710121003,
					"content": "Глаз бури? За всё время, что я здесь провёл, мне не встречался никакой Глаз бури. Разве что иногда резко усиливается ветер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121004
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121004,
					"content": "Но это не связано с Глазом бури. Глаз бури я бы ни с чем не перепутал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121005,
						710121007
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121005,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121006
					]
				},
				{
					"id": 710121006,
					"content": "Поверь, если бы Глаз бури прервал мои исследования, я бы это запомнил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121009,
					"content": "Если быть точным, я провожу исследование совместно с приятелем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121010
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121010,
					"content": "Он тоже учёный. Мы с ним вместе учились в Академии Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121011
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121011,
					"content": "Он стал археологом и отправился исследовать мир, а я продолжил обучение в Академии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121012
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121012,
					"content": "Когда приятель приехал в Мондштадт, он рассказал мне о том, как исследовал храм Тысячи ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121013
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121013,
					"content": "Он сказал: «Когда я раскрою тайны твоих родных мест, то ты первый об этом узнаешь!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121014
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121014,
					"content": "После этого от него не было никаких вестей. Я попросил путешественников передать Сайрусу из Гильдии искателей приключений письмо с просьбой найти моего друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121015
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121015,
					"content": "О приятеле по-прежнему ничего не было слышно, поэтому я прервал своё обучение и срочно вернулся сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121016
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121016,
					"content": "Однако здесь я ничего не обнаружил, кроме этих солнечных часов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121017
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121017,
					"content": "На том острове тоже есть солнечные часы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121018
					]
				},
				{
					"id": 710121018,
					"content": "Что? Точно такие же? На острове?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121019
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121019,
					"content": "Да! Теперь я припоминаю. Однажды в ясную погоду я даже видел этот остров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121020
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121020,
					"content": "Подожди... Ты говоришь, что рядом с часами лежал дневник? Значит, мой приятель побывал там...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121021
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121021,
					"content": "Спасибо тебе. Если выдастся подходящая возможность, я обязательно посещу этот остров. Однако сейчас я должен разобраться с этим местом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121022
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121022,
					"content": "Мне пора возвращаться к работе. Если тебе интересно, можешь пролистать мои исследовательские записи. И оставил их вон там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121023
					],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121023,
					"content": "Может быть, ты обнаружишь в них что-то полезное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Генри Мортон"
				},
				{
					"id": 710121007,
					"content": "Чем ты занимаешься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121008
					]
				},
				{
					"id": 710121008,
					"content": "Чем я занимаюсь? Я провожу исследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "Генри Мортон"
				}
			]
		},
