			"dialogs": [
				{
					"id": 710120101,
					"content": "«Ветер разносит истории, а время превращает их в легенды...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120102
					],
					"speakerTitle": "Повреждённая надпись"
				},
				{
					"id": 710120102,
					"content": "Что это значит? Паймон не понимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710120103,
					"content": "Похоже, что у этого места есть свои тайны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710120104,
					"content": "Давай осмотримся вокруг. Может быть, мы найдём какие-нибудь подсказки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7101202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
