			"dialogs": [
				{
					"id": 737100101,
					"content": "♪~♪♪~♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100102
					],
					"speakerTitle": "Бам-бам-шапочка"
				},
				{
					"id": 737100102,
					"content": "♫♫~♫~♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100103
					],
					"speakerTitle": "Огнерадость"
				},
				{
					"id": 737100103,
					"content": "Хания, Соука, мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100104,
					"content": "Я издалека услышала приближение весёлых Бам-бам-шапочки и Огнерадости. Видимо, вы и правда здорово провели время!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100105
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737100105,
					"content": "Ты можешь издалека понять, что они в хорошем настроении? Я до сих пор не умею различать эмоции плесенников так хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100106
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737100106,
					"content": "Видно, мне ещё многому предстоит научиться... Нет предела совершенству!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100107
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737100107,
					"content": "Хе-хе-хе, Паймон чувствует, что на этот раз всё было совсем по-другому!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100108,
					"content": "Мы погуляли с друзьями-плесенниками, а теперь вернулись в Парк плесенников. Словно устали играть и просто пришли домой перекусить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100109,
					"content": "А может, давайте сейчас все вместе сфотографируемся? Паймон видела в «Паровой птице», что во многих знаменитых путевых заметках собирают все фотографии из путешествия и распределяют их по порядку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100110,
					"content": "Теперь, когда Серебряный спутник об этом напомнила, я вспомнила, что все эти годы мы с друзьями-плесенниками проводили время вместе, но так ни разу и не сфотографировались...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100111
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737100111,
					"content": "Ага! Наши боссы отлично знают, как устроить идеальное завершение приключения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100112
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737100112,
					"content": "♪♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100113
					],
					"speakerTitle": "Бам-бам-шапочка"
				},
				{
					"id": 737100113,
					"content": "♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100114
					],
					"speakerTitle": "Огнерадость"
				},
				{
					"id": 737100114,
					"content": "Ладно! Тогда Паймон сделает общее фото на камеру Бам-бам-шапочки со штатива, по таймеру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100115,
					"content": "Когда у Хании и Соуки будет поменьше дел, мы обязательно снова все вместе так же весело куда-нибудь выберемся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100147
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100147,
					"content": "Здорово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100116,
					"content": "Кстати, у Бам-бам-шапочки потрясающий талант к фотографированию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100117,
					"content": "Паймон выбрала несколько удачных снимков и поместила их вместе с нашей общей фотографией. Можете посмотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100118,
						737100119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100118,
					"content": "Здорово! Ты всё продумала...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				},
				{
					"id": 737100120,
					"content": "А ещё... Хания и Соука, Паймон принесла вам угощения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100121,
					"content": "Макароны, которые вы тогда не успели попробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100122,
					"content": "Ой! Я же просто так обмолвилась, а ты и правда запомнила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100123
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737100123,
					"content": "Серебряный спутник... Как трогательно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100124
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737100124,
					"content": "Чтобы больше не доставлять тебе хлопот, мне нужно избавиться от этой дурной привычки. Я буду тщательно планировать поездки заранее... и не только на бумаге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100125
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737100125,
					"content": "Знаешь, когда друзья общаются, отдыхая вместе, даже мимоходом брошенные слова могут выдать их истинные мысли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100126,
						737100127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100126,
					"content": "Когда ты это купила?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100128,
					"content": "Ещё когда мы фотографировались в Кур-де-Фонтейне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100129,
					"content": "#Пока ты {M#любовался}{F#любовалась} пейзажами с Бам-бам-шапочкой, я нашла одну газетчицу, попросила помочь и дала ей немного моры за хлопоты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100130,
					"content": "Не волнуйся, у Паймон и для тебя есть! Как же Паймон могла бы о тебе забыть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100131,
					"content": "Паймон даже велела ей, чтобы она, как только войдёт в магазин, сразу взяла твой любимый вкус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100132,
					"content": "Хотя мы уже, кажется, перепробовали все десерты Кур-де-Фонтейна, так что вряд ли будет что-то новенькое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100133,
						737100134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100133,
					"content": "Любые сладости, купленные Паймон, вкусные!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100135,
					"content": "Правда? Хе-хе... Тогда Паймон будет покупать тебе угощения чаще!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100136,
					"content": "Эх, жалко, что для наших друзей-плесенников не придумали особых сладостей... Представляешь, как было бы здорово обнять их и устроить настоящий пир за одним столом, полным всяких вкусностей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100137,
					"content": "Не беспокойся об этом, в моей работе «Полная энциклопедия популяций плесенников» есть фундаментальное исследование того, что любят есть плесенники.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100138
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737100138,
					"content": "Цель - найти ингредиенты, подходящие и плесенникам, и людям, чтобы маленьким друзьям не приходилось круглый год питаться только чудесным агаром разных вкусов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100139
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737100139,
					"content": "Рано или поздно я найду ингредиенты, которые подойдут и людям, и плесенникам, и создам блюда, вкусные для всех!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100140
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737100140,
					"content": "А когда дело дойдёт до практики, я буду готовить! Чтобы Хания не испортила нашу одиннадцатую кастрюлю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100141
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737100141,
					"content": "Судя по всему, день, когда мы сядем за совместную трапезу с друзьями-плесенниками, не за горами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100142,
						737100143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737100142,
					"content": "Ждём хороших новостей от Хании!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100144,
					"content": "Тогда почаще заходите в Парк плесенников. Мы и друзья-плесенники всегда рады вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100145
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737100145,
					"content": "Кто знает, возможно, сюрприз появится раньше, чем ты ожидаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100146
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737100146,
					"content": "♪!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бам-бам-шапочка"
				},
				{
					"id": 737100143,
					"content": "Ждём угощения от Соуки!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100134,
					"content": "Когда Паймон сама покупает для меня, это дорогой сердцу подарок!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100127,
					"content": "#Я даже не заметил{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100119,
					"content": "Паймон, ты так предусмотрительна!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				}
			]
		}
	]
}