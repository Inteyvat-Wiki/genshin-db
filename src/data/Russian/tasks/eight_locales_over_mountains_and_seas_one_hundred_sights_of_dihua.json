			"dialogs": [
				{
					"id": 722620201,
					"content": "Готово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620202,
					"content": "Дальше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620203,
					"content": "Кстати, Китибоси, ты когда-нибудь ходил на рыбалку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620204,
					"content": "Рыбалка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620205
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620205,
					"content": "Похоже, что нет. Пойдём ближе к воде!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620206,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				}
			]
		},
		{
			"id": 7226203,
			"completionStepIds": [
				7226207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226207",
							"2"
						],
						"stepId": 7226207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Китибоси",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620301,
					"content": "О-о... Почему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620302
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620302,
					"content": "Ну, Китибоси! Почему ты сразу ворвался в лагерь хиличурлов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620303,
					"content": "Думал, мы можем... поиграть вместе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620304
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620304,
					"content": "А? Что? Хиличурлы - опасные монстры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620305,
						722620307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620305,
					"content": "#Я бы не {M#сказал}{F#сказала}, что они опасны...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620306
					]
				},
				{
					"id": 722620306,
					"content": "Ну, ладно! Китибоси не такой опытный боец, как ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620309,
					"content": "Хм, когда мы впервые встретились в лесу Тиндзю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620310
					]
				},
				{
					"id": 722620310,
					"content": "Правильно! Разве ты сам не прятался, а вокруг были хиличурлы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620311,
					"content": "Когда мы впервые встретились... Я думаю... О, да, вспомнил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620312
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620312,
					"content": "Тогда я играл в прятки с хиличурлами. Лесные хиличурлы не нападают на бакэ-дануки. Они часто играют с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620313
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620313,
					"content": "Вы смогли поладить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620314,
					"content": "Не знаю, почему хиличурлы здесь такие. Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620315
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620315,
					"content": "Тут нужно быть осторожнее. Даже когда дело касается хиличурлов... Ну, особенно с ними...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620316,
					"content": "#Сложно. Ты объясни, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620317,
					"content": "Нужно отличать хороших от плохих.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620318
					]
				},
				{
					"id": 722620318,
					"content": "Да! Так ты сможешь защитить себя в будущем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620319,
					"content": "Но не забывай оставаться добрым и открытым.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620320
					]
				},
				{
					"id": 722620320,
					"content": "Именно! Так в твоей жизни будет много хорошего!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620321,
					"content": "Мм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620322
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620322,
					"content": "#{NICKNAME} и Паймон говорят о сложных вещах. Китибоси не понимает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620323
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620323,
					"content": "Но Китибоси знает, что вы хорошие люди. Поэтому Китибоси учится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620324
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620324,
					"content": "#Ладно. А теперь {NICKNAME} поучит нас ловить рыбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620325,
					"content": "Мм! Рыбалка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620307,
					"content": "Да, они действительно опасны!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620308
					]
				},
				{
					"id": 722620308,
					"content": "Эй, не надо его пугать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620309
					],
					"speakerTitle": "Паймон"
				}
			]
		},
