					"speakerTitle": "Паймон"
				},
				{
					"id": 722620404,
					"content": "Вы учите Китибоси основам рыбалки.\\nОбъясняете попроще...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722620405
					]
				},
				{
					"id": 722620405,
					"content": "Рыбка!",
