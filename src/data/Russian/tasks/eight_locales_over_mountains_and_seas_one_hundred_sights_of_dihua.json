					"nextDialogs": [
						722620406
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620406,
					"content": "Понятно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620407
					]
				},
				{
					"id": 722620407,
					"content": "Мха-ха. Рыбы глупые. Их можно обмануть едой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620408,
						722620410,
						722620412
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620408,
					"content": "И Паймон тоже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620409
					]
				},
				{
					"id": 722620409,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620413,
					"content": "Все любят вкусненькое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620414,
					"content": "#Ну, что? {NICKNAME}, покажи Китибоси, как надо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620410,
					"content": "И Китибоси.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620411
					]
				},
				{
					"id": 722620411,
					"content": "Ммм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620413
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620412,
					"content": "И меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620413
					]
				}
			]
