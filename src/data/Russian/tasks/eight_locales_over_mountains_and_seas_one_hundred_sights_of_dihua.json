			},
			"dialogs": [
				{
					"id": 722620601,
					"content": "Хм. Почему бы не зайти в воду, чтобы ловить рыбу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620602,
						722620603,
						722620604
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620602,
					"content": "Некоторых рыб так не поймать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620605
					]
				},
				{
					"id": 722620605,
					"content": "Да! Рыбалка - отличный вид тренировки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620606,
						722620608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620606,
					"content": "Попробуй, Китибоси.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620607
					]
				},
				{
					"id": 722620607,
					"content": "Ммм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620610
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620610,
					"content": "Китибоси пробует поймать рыбу.\\nКак и ожидалось, ничего не получилось.\\nВ итоге все вы решаете, что хватит рыбачить, и играете втроём у воды.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722620611
					]
				},
				{
					"id": 722620611,
					"content": "Промокнуть неприятно, но играть в воде было весело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620612,
					"content": "Китибоси рад! Но рыбалка - это сложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620613
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620613,
					"content": "#Да. Но если научишься ловить рыбу, то однажды у тебя появятся неожиданные друзья. Правда, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620614,
						722620615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620614,
					"content": "Верно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620617
					]
				},
				{
					"id": 722620617,
					"content": "Трудно понять... Но Китибоси понимает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620618
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620618,
					"content": "#{NICKNAME}, Паймон, играть с вами очень весело. {NICKNAME} и Паймон - друзья Китибоси.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620619
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620619,
					"content": "Люблю обучение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620620
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620620,
					"content": "О да, кстати говоря, Иорой хотел, чтобы Китибоси посетил восемь мест для тренировок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620621
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620621,
					"content": "Драконий хребет, каменный лес Гуюнь, Мондштадт, гавань Ли Юэ, гора Хулао... Мы уже завершили большую часть твоего обучения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620622
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620622,
					"content": "Да, верно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620623
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620623,
					"content": "Куда дальше отправимся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620624
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620624,
					"content": "Решай ты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620625
					]
				},
				{
					"id": 722620625,
					"content": "#О, такое Паймон нечасто от тебя слышит, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620626
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620626,
					"content": "Хорошо! Положитесь на Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620627
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620627,
					"content": "Положимся на Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620615,
					"content": "И тогда на еду будешь ещё больше тратить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620616
					]
				},
				{
					"id": 722620616,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620617
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620608,
					"content": "Попробуй, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620609
					]
				},
				{
					"id": 722620609,
					"content": "Рыба утащит Паймон в море!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620603,
					"content": "Это может быть довольно хлопотно, но так интереснее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620605
					]
				},
				{
