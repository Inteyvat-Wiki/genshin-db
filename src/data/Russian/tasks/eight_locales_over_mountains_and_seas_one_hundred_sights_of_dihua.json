				},
				{
					"id": 722620402,
					"content": "Китибоси хочет поиграть с водой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620403
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620403,
					"content": "Эй, нет, только не сейчас! Ты распугаешь рыбу!",
