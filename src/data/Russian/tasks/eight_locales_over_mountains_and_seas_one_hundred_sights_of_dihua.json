				"points": []
			},
			"dialogs": [
				{
					"id": 722620101,
					"content": "О-о-о. Море здесь красивое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620102
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620102,
					"content": "А? Регион Тростниковых островов - это не море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620103,
					"content": "Хотя его воды соединены с морем...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620104
					]
				},
				{
					"id": 722620104,
					"content": "Хм, это правда... но всё равно неправильно называть здешние воды морем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620105,
					"content": "Мм... Не совсем понимаю. В чём разница между «морем» и «неморем»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620106,
						722620110,
						722620114
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620106,
					"content": "Во вкусе воды?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620107
					]
				},
				{
					"id": 722620107,
					"content": "О! Лесная вода сладковата, так что она не море!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620108
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620108,
					"content": "Но если Сидровое озеро наполнено сидром, то чем оно считается?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620109,
					"content": "Чем-то, что любит Венти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620120
					]
				},
				{
					"id": 722620120,
					"content": "Впрочем, хватит пока об этом. Паймон кажется, или Китибоси стал лучше говорить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620121,
						722620122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620121,
					"content": "Как говорил Иорой...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620123,
					"content": "Что там говорил Иорой? «Я самый известный в мире бакэ-дануки Иорой!» Нет, не то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620124,
					"content": "«О-ох... Как же я хочу почесать себе пузико...» «Ой!» Хм, тоже не то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620125,
					"content": "Мха-ха, Паймон так точно подражает. Очень смешно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620126
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620126,
					"content": "«Привыкните к его ауре...»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620127
					]
				},
				{
					"id": 722620127,
					"content": "О да, точно! Чем больше мы привыкаем к ауре Китибоси, тем лучше понимаем его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620128,
					"content": "#А ещё Китибоси учится! {NICKNAME} и Паймон путешествуют с Китибоси. Китибоси узнаёт много нового!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620129,
						722620133
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620129,
					"content": "Паймон - отличный гид-проводник.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620130
					]
				},
				{
					"id": 722620130,
					"content": "О...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620131,
					"content": "#Это было так давно, но {NICKNAME} всё ещё помнит об этом? Это так мило...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620132,
					"content": "#Мм! Спасибо, Паймон и {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620136,
					"content": "Это «море-неморе» красивое. Высокий-высокий дом за ним тоже красив. Сфотографируешь для Китибоси?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620137
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620137,
					"content": "Да, конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722620133,
					"content": "Компаньоны, которые вместе путешествуют, вместе и развиваются.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620134
					]
				},
				{
					"id": 722620134,
					"content": "Компаньоны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620135
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620135,
					"content": "Самые лучшие компаньоны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620122,
					"content": "Иорой что-то говорил об этом перед нашим уходом...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620110,
					"content": "Море - большое водное пространство за пределами материка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620111
					]
				},
				{
					"id": 722620111,
					"content": "Ого, это... довольно точное определение. Но оно возвращает нас к вопросу о «границах», верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620112,
					"content": "#{NICKNAME} говорит, что воды Тростниковых островов связаны с морем. Значит, в чём разница между «сушей» и «несушей»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620113
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620113,
					"content": "...Видимо, точное определение не решает всех проблем, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620114,
					"content": "Эти понятия навязаны человеком. Не имеют никакого особого смысла.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620115
					]
				},
				{
					"id": 722620115,
					"content": "Если воды Тростниковых островов считают себя морем, значит, это море.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620116
					]
				},
				{
					"id": 722620116,
					"content": "Если Китибоси считает себя Адептом, то он Адепт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620117
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722620117,
					"content": "#Не слушай {M#его}{F#её}, Китибоси! Что это ты такое говоришь, {NICKNAME}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620118,
					"content": "Хотя мысль и выражена так себе, но зерно истины есть. Ты можешь стать любым бакэ-дануки, каким захочешь, Китибоси! Кто знает, может, ты даже станешь Адептом тануки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722620119,
					"content": "Адепт тануки! Ура!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "Китибоси"
				}
			]
		},
