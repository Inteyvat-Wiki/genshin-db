					{
						"sceneId": 3,
						"position": [
							-1813.328,
							132.133,
							9749.9
						],
						"pointId": 9633
					}
				]
			},
			"dialogs": [
				{
					"id": 750870701,
					"content": "А? Тарука! Ты уже здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750870702,
					"content": "#{M#Братец}{F#Сестрица} {NICKNAME}! Я так рад, что с вами всё в порядке... Я всё рассказал сестре и остальным. Ну, Ламизана, как и ожидалось, полный дурак...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870703
					],
					"speakerTitle": "Тарука"
				},
				{
					"id": 750870703,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870704
					],
					"speakerTitle": "Оберон"
				},
				{
					"id": 750870704,
					"content": "Да, ещё глупее тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870705
					],
					"speakerTitle": "Тарука"
				},
				{
					"id": 750870705,
					"content": "Ру-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870706
					],
					"speakerTitle": "Оберон"
				},
				{
					"id": 750870706,
					"content": "#Ладно, ладно, он, наверное, расстроен, что вас так надолго разлучили. Кстати, только что он и {REALNAME[ID(2)|SHOWHOST(true)]} отлично сработались!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750870707,
					"content": "Но ещё есть куда расти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870708
					]
				},
				{
					"id": 750870708,
					"content": "Ну, заврианчик ведь ещё совсем малыш! Если ты будешь хорошо за ним ухаживать, Паймон уверена, что он вырастет в великолепного кукузавра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750870709,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870710
					],
					"speakerTitle": "Оберон"
				},
				{
					"id": 750870710,
					"content": "Кстати, а как ты вернулся? Тебя кто-то спас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870711
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750870711,
					"content": "Нет, я сам сбежал. Хотел забрать Оберона с собой, но он был слишком занят заврианским печеньем и отказался двигаться, как я ни пытался. В итоге я разозлился и ушёл один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870712
					],
					"speakerTitle": "Тарука"
				},
				{
					"id": 750870712,
					"content": "А? Так просто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870713
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750870713,
					"content": "Когда я разобрался, как двигаются заврианы-стражи, я понял, что есть момент, когда можно улизнуть. В итоге я выбрался без проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870714
					],
					"speakerTitle": "Тарука"
				},
				{
					"id": 750870714,
					"content": "Кажется, ты здесь самый надёжный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870715
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750870715,
					"content": "Почему так долго? Я уже собирался разобраться с этим лжецом... ну и, конечно, официально извиниться перед вами. Я сделал поспешные выводы и чуть не подставил невинных людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870716,
						750870718
					],
					"speakerTitle": "Ламизана"
				},
				{
					"id": 750870716,
					"content": "Слишком поздно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870717
					]
				},
				{
					"id": 750870717,
					"content": "Вот именно! Ты появился, когда всё уже закончилось. Если это не попытка приписать себе чужие заслуги, то что тогда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750870720,
					"content": "Мне нечем оправдаться, так что я заплачу вам обещанное вознаграждение или что захотите. Жадничать не буду. Можете даже ударить меня, если это вас успокоит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870721
					],
					"speakerTitle": "Ламизана"
				},
				{
					"id": 750870721,
					"content": "Я настоящий мужчина, так что не стану увиливать от ответственности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870722,
						750870724
					],
					"speakerTitle": "Ламизана"
				},
				{
					"id": 750870722,
					"content": "#Пусть {REALNAME[ID(2)|SHOWHOST(true)]} врежет тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870723
					]
				},
				{
					"id": 750870723,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870726,
					"content": "Ой! Ай! Меня ещё не ударили, а уже больно! Пощадите меня... и мои пальцы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870727
					],
					"speakerTitle": "Ламизана"
				},
				{
					"id": 750870727,
					"content": "Ты только что говорил, что настоящий мужчина, а теперь так себя ведёшь... Слабак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870728
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750870728,
					"content": "#Ладно, мы выше этого. Верно, {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870729
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750870729,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870730
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870730,
					"content": "Спасибо, что простили меня. Лётная школа... У нас тут нет дверей, но, считайте, её двери всегда открыты для вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870731
					],
					"speakerTitle": "Ламизана"
				},
				{
					"id": 750870731,
					"content": "#Раз уж вы и {REALNAME[ID(2)|SHOWHOST(true)]} так хорошо ладите, хотел спросить, в чём ваш секрет? Заглядывайте ещё, мне бы хотелось поучиться у вас обращаться с заврианами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870732
					],
					"speakerTitle": "Тарука"
				},
				{
					"id": 750870732,
					"content": "Хе-хе, хорошо! Если выпадет возможность, заглянем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750870724,
					"content": "#Пусть {REALNAME[ID(2)|SHOWHOST(true)]} хорошенько ударит тебя по пальцам ног.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870725
					]
				},
				{
					"id": 750870725,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870718,
					"content": "Я требую компенсацию! И свой приз за участие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870719
					]
				},
				{
					"id": 750870719,
					"content": "#Ещё и про приз за участие не {F#забыла}{M#забыл}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Паймон"
				}
			]
		},
