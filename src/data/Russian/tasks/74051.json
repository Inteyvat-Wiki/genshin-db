			"dialogs": [
				{
					"id": 740510301,
					"content": "Как хорошо! Кинокамера в порядке, плёнка тоже не пострадала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510328
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510328,
					"content": "Слава Архонтам! Я думала, придётся начинать съёмки сначала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510302,
						740510303
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510302,
					"content": "Что вы здесь снимаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510303,
					"content": "Кажется, вы тоже не местные.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510329,
					"content": "Это долгая история...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510304,
					"content": "Постараюсь в двух словах. Мы прибыли из деревни Цяоин, что в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510305,
					"content": "Большинство жителей нашей деревни занимаются торговлей чаем, но мы... Мы совсем не интересуемся чаем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510306
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510306,
					"content": "Поэтому мы решили сменить род занятий и заняться съёмками рекламных фильмов для торговцев чаем из нашей деревни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510307
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510307,
					"content": "На самом деле в чайном бизнесе слишком большая конкуренция, нам там нечего делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510308
					],
					"speakerTitle": "И Фэн"
				},
				{
					"id": 740510308,
					"content": "Мастера из нашей лавки один за другим ушли работать на других или открыли чайный бизнес, так что нам даже есть было нечего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510309
					],
					"speakerTitle": "Син Е"
				},
				{
					"id": 740510309,
					"content": "Вы не могли бы... выражаться несколько иначе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510310
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510310,
					"content": "Мы заработали много моры на съёмке рекламных фильмов для торговцев чаем из Цяоин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510311
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510311,
					"content": "Но недавно в деревне нашлись другие умельцы, которые тоже стали снимать рекламные фильмы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510312
					],
					"speakerTitle": "И Фэн"
				},
				{
					"id": 740510312,
					"content": "В съёмках некоторых фильмов принимали участие настоящие оперные певцы. Вот размах так размах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510313
					],
					"speakerTitle": "Син Е"
				},
				{
					"id": 740510313,
					"content": "Поэтому мы и приехали в Фонтейн. Хотим получить рекомендации у экспертов в киносъёмке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510314
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510314,
					"content": "Значит, вы приехали в Фонтейн, чтобы научиться снимать фильмы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510315
					]
				},
				{
					"id": 740510315,
					"content": "Да. И здесь мы познакомились с экспертом по имени Гайзерт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510316
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510316,
					"content": "Он здорово разбирается в том, как использовать светотень для подачи... чего там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510317
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510317,
					"content": "«Нарратива».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510318
					],
					"speakerTitle": "И Фэн"
				},
				{
					"id": 740510318,
					"content": "Точно! В использовании светотени для подачи нарратива.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510319
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510319,
					"content": "Под руководством господина Гайзерта мы снимем лучший фильм в истории деревни Цяоин!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510320
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510320,
					"content": "Босс, в прошлом месяце ты говорила, что мы снимем лучший фильм в истории всего Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510321
					],
					"speakerTitle": "Син Е"
				},
				{
					"id": 740510321,
					"content": "Много ты понимаешь. Любой бизнесмен знает, как важно уметь корректировать свои ожидания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510322
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510322,
					"content": "#Ладно. Спасибо за помощь, {F#путешественница}{M#путешественник}. Вот ваше вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510323
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510323,
					"content": "Син Юэ, И Фэн, живо собирайтесь! Сегодня нужно закончить съёмки и показать готовый фильм господину Гайзерту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510324
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510324,
					"content": "Помните о свете! Объектив должен быть направлен к источнику света под таким углом, чтобы у световых лучей появилась текстура!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510325
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510325,
					"content": "Вы ведь читали книгу господина Рено? Свет и тень должны иметь текстуру. Текстуру! Вы меня понимаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510326
					],
					"speakerTitle": "Госпожа Цю"
				},
				{
					"id": 740510326,
					"content": "Босс, книгу господина Гайзерта мы читали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510327
					],
					"speakerTitle": "Син Е"
				},
				{
					"id": 740510327,
					"content": "Но с такой камерой у нас не получится передать текстуру световых лучей, как ни бейся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "И Фэн"
				}
			]
		},
