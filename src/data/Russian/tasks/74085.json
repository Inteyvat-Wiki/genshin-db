			"dialogs": [
				{
					"id": 740850201,
					"content": "Ключ, статуя, ключ, статуя, ключ, статуя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850202
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850202,
					"content": "Хм... Ты имеешь в виду, что нужно поместить ключи в статуи? Это было бы логично - три ключа и три статуи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740850203,
					"content": "Может быть, попробуем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740850204,
					"content": "Что произойдёт, когда ключи будут на месте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850205
					]
				},
				{
					"id": 740850205,
					"content": "Дверь открыть, открыть дверь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850206
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850206,
					"content": "Дверь? Где? И что за той дверью?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740850207,
					"content": "Корни, Эринии, очень глубокие ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850208
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850208,
					"content": "Дверь ведёт к корням острова Эриний? Пашив, ты... ты так много знаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740850209,
					"content": "Пашив, защищать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850210
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850210,
					"content": "Что ещё мы должны знать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850211
					]
				},
				{
					"id": 740850211,
					"content": "А?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850212
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850212,
					"content": "Ну, знаешь, нам нужна информация! Чем больше, тем лучше! Чем больше мы знаем, тем увереннее будем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740850213,
					"content": "Инфор... мация? Инфор... мация... Пашив! Информация, очень много...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850214
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850214,
					"content": "Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740850215,
					"content": "Эринии, информация, очень много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850216
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850216,
					"content": "Так... Информации очень много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740850217,
					"content": "Информация, водная артерия, очень много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850218
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850218,
					"content": "Угу... Много водных артерий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740850219,
					"content": "Водные артерии, Новый валет, очень много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850220
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850220,
					"content": "Ага... Что? Много Новых валетов? Подожди, Паймон не понимает... Откуда? Новый валет умеет создавать свои собственные копии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740850221,
					"content": "Мелюзина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850222
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850222,
					"content": "Водные артерии, Новый валет, попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850223
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850223,
					"content": "Зло, Новый валет, чувствовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850224
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850224,
					"content": "Попробовать зло водных артерий? А какое оно на вкус?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740850225,
					"content": "Новый валет ощущает информацию в водных артериях?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850226
					]
				},
				{
					"id": 740850226,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850227
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850227,
					"content": "Ива, собирать. Туман, обрабатывать. Источник, отправлять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850228
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850228,
					"content": "Корень, водные артерии, центр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850229
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850229,
					"content": "Остров Эриний - это информационный центр?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850230
					]
				},
				{
					"id": 740850230,
					"content": "Ты хочешь сказать, что весь остров Эриний - это информационная система Нового валета? И что он может чувствовать через неё что-то плохое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740850231,
					"content": "#Умная Паймон! {F#Умная}{M#Умный} {NICKNAME}! Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850232
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740850232,
