			"dialogs": [
				{
					"id": 740851901,
					"content": "Всё пропало! Нас просто выбросило на берег... А мы ведь ещё не нашли Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740851902,
					"content": "Не волнуйся, Пашив должна уметь плавать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851903
					]
				},
				{
					"id": 740851903,
					"content": "Верно... Ух ты! Посмотри на то дерево!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851904
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740851904,
					"content": "Какое красивое! Это его настоящий вид? Уверена, Пашив очень бы обрадовалась, увидев его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851905
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740851905,
					"content": "#Паймон! Пашив! {NICKNAME}! Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851906
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740851906,
					"content": "Пашив? Как хорошо. Где ты была? Мы волновались за тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851907
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740851907,
					"content": "След простыл, Пашив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851908
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740851908,
					"content": "А... Сундук, Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851909
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740851909,
					"content": "Что? Это... сундук? Ты отправилась искать сундуки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851910
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740851910,
					"content": "Пашив! Но сверкает и круглое, мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851911
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740851911,
					"content": "Ты не смогла найти мору? Это совершенно неважно! Этих сундуков уже достаточно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851912
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740851912,
					"content": "Так трогательно, что ты помнишь, что Паймон говорила. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851913
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740851913,
					"content": "С... спасибо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851916
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740851916,
					"content": "«Спасибо» значит «Пашив».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851917
					]
				},
				{
					"id": 740851917,
					"content": "#Паймон, спасибо! {NICKNAME}, спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851918
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740851918,
					"content": "#Паймон, хорошая штука! {NICKNAME}, хорошая штука!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851919
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740851919,
					"content": "Пашив! Хорошая штука!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851920
					]
				},
				{
					"id": 740851920,
					"content": "Пашив! Хорошая штука!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851921
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740851921,
					"content": "#{NICKNAME}, давай потом будем почаще навещать Пашив? Мы можем научить её новым словам, как Новый валет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851922
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740851922,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851923
					]
				},
				{
					"id": 740851923,
					"content": "Пашив, что скажешь? Можно, мы будем навещать тебя в будущем? Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851924
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740851924,
					"content": "Она снова исчезла?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851925
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740851925,
					"content": "Пашив след простыл?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851926
					]
				},
				{
					"id": 740851926,
					"content": "Потрясающе! Паймон никогда не встречала такую мелюзину... Вернее, она вообще не похожа на мелюзину, а скорее напоминает загадочную дикую фею.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851927
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740851927,
					"content": "Но, может быть, именно поэтому ей удалось тайно наблюдать за тем фиолетовым негодяем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851928
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740851928,
					"content": "Эй! Пашив! Пока! В следующий раз мы научим тебя, как правильно прощаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
