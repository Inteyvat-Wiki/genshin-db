				"points": []
			},
			"dialogs": [
				{
					"id": 706900301,
					"content": "Хм? Все книги уже разобраны? Я даже не ожидала, что вы так быстро управитесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900302
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 706900302,
					"content": "Что ты хочешь в награду, милашка? Благодаря вам у меня теперь весь вечер свободен. Может, проведём его вместе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900303,
						706900305
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 706900303,
					"content": "Хотелось бы получить вознаграждение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900304
					]
				},
				{
					"id": 706900304,
					"content": "И только? Не переживай, о вознаграждении я не забуду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900306
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 706900306,
					"content": "Вы тоже заметили? Очень странные названия, а содержание ещё более странное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900307
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 706900307,
					"content": "У нас здесь крупнейшая Библиотека в северном Тейвате, но ни одной книги из списка у меня нет. Не понимаю, как это возможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900308
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 706900308,
					"content": "Если только...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900309
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 706900309,
					"content": "На самом деле, мы только что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706900310,
					"content": "Кажется, ты хочешь рассказать мне о чём-то не очень приятном? Честно говоря, я предпочла бы остаться в неведении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900311
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 706900311,
					"content": "Да и потом, раз уж такие книги существуют, их необходимо добавить в библиотечный фонд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900312
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 706900312,
					"content": "Пусть лучше хранятся здесь, чем ходят по свету и попадают в руки всяких... подозрительных личностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900313
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 706900313,
					"content": "Вот ваше вознаграждение. И ещё раз спасибо за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лиза"
				},
				{
					"id": 706900305,
					"content": "Расскажи мне об этих книгах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900306
					]
				}
			]
		}
	]
}