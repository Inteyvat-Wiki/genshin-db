			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266206",
							"2"
						],
						"stepId": 7266206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кудзирай Момидзи",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620301,
					"content": "Как же так... Даже папина наживка не сработала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620302
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620302,
					"content": "Не расстраивайся, это всё страж руин! Это он Лунного левиафана спугнул! Давай ещё раз попробуем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726620303,
					"content": "Да, надо попробовать ещё раз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620304
					]
				},
				{
					"id": 726620304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620305
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620306
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620306,
					"content": "Ладно, хватит, что-то я подустала. А, может быть, Нантак прав?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620307
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620307,
					"content": "Эх... Хочу пойти прогуляться. Надо подумать, что делать дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620308
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620308,
					"content": "А это вам. Как бы то ни было, а я очень благодарна за вашу помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620309
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620309,
					"content": "Похоже, Момидзи хочет побыть одна. Давай её попозже навестим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}