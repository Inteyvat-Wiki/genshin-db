			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кудзирай Момидзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620101,
					"content": "Смотрите! Я снова просмотрела судовой журнал отца...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620102
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620102,
					"content": "Здесь есть приложение, где описывается способ приготовления особой наживки, которую они изобрели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620103
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620103,
					"content": "Они использовали наживку из смеси водорослей и магической кристальной руды в тот раз, когда встретили Лунного левиафана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620104
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620104,
					"content": "Если мы сделаем такую же, то тоже сможем его привлечь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620105
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620105,
					"content": "Водорослей у меня много, но вот руды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620106
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620106,
					"content": "Не волнуйся, у меня есть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620107
					]
				},
				{
					"id": 726620107,
					"content": "#А? Правда? Ты её в Арауми добыл{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620108
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620108,
					"content": "В отцовском журнале говорится, что магическую кристальную руду можно добыть в руинах Арауми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620109
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620109,
					"content": "Не очень понятно, чем она отличается от обычной магической кристальной руды, но раз уж мы решили так делать, то лучше делать в точности по журналу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620110
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620110,
					"content": "Вот только в Арауми очень много монстров, очень опасно. Пойдём в Гильдию искателей приключений и составим поручение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620111
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620111,
					"content": "#Не надо, я сам{F#а} справлюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620112
					]
				},
				{
					"id": 726620112,
					"content": "#А, точно. Я и забыла, что ты сам{F#а} очень сильный искатель приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620113
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620113,
					"content": "Мне так повезло, что ты мне помогаешь. Я рассчитываю на тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620114
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620114,
					"content": "Я тогда пойду пока схожу за инструментами, чтобы приманку изготовить. Давай встретимся потом на пляже к западу от Арауми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кудзирай Момидзи"
				}
			]
		},
		{
			"id": 7266202,
			"completionStepIds": [
				7266204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266204",
							"2"
						],
						"stepId": 7266204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кудзирай Момидзи",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620201,
					"content": "#Ты так быстро её добыл{F#а}? Вот уж действительно сильный искатель приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620202
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620202,
					"content": "Этого хватит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620203
					]
				},
				{
					"id": 726620203,
					"content": "Ага. Теперь моя очередь. Надо только сделать вот так... вот так... и вот так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620204
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620204,
					"content": "Вот так. Готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620205
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620205,
					"content": "Теперь мы просто закидываем приманку и ждём Лунного левиафана, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726620206,
					"content": "Ага. Я специально выбрала это место. Именно здесь мы тогда и выбрались на берег.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620207
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620207,
					"content": "И Лунный левиафан, когда привёл нас обратно, тоже где-то здесь исчез.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620208
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620208,
					"content": "Ну что, все готовы? Не забудьте загадать желание, когда увидите Лунного левиафана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620209
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620209,
					"content": "А если ничего не выйдет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620210
					]
				},
				{
					"id": 726620210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620211
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620211,
					"content": "Не говори так - всё получится. Лунный левиафан обязательно появится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620212
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620212,
					"content": "Да! Всё получится! Большая рыбина, большая рыбина, будь добра и хватай наживку! Прошу тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726620213,
					"content": "Смотрите! Смотрите скорее! В воде что-то светится! Там что-то есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620214
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726620214,
					"content": "Правда? Это правда Лунный левиафан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726620215,
					"content": "А-а! Это страж руин!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726620216,
					"content": "Он-то тут откуда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7266203,
			"completionStepIds": [
				7266206
			],
