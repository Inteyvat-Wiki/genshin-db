				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100801,
					"content": "Досины следят за порядком в Ханамидзаке. Ни один преступник не останется незамеченным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100802
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100802,
					"content": "По сюжету, рыцари противника имеют те же обязанности, что и досины. Но чтобы было интереснее, давайте сделаем их в десять раз сильнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100803,
						220100805
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100803,
					"content": "Почему именно в 10 раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100804
					]
				},
				{
					"id": 220100804,
					"content": "Числовая шкала - самая наглядная вещь в мире. Это поможет показать, насколько силен главный герой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100806
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100806,
					"content": "Ну, я... наделю главного героя мастерством маскировки. Например, возможностью свободно менять внешность и голос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100807
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100807,
					"content": "Ещё одна сверхспособность?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100808
					]
				},
				{
					"id": 220100808,
					"content": "Это скрытая способность главного героя. Встреча с определёнными врагами - лучший способ раскрыть её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100809
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100809,
					"content": "Ты ведь только что это выдумал!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100810
					]
				},
				{
					"id": 220100810,
					"content": "Н-нет... Так было задумано с самого начала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100811
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100811,
					"content": "Давай оставим всё как есть! Пойдём расскажем Сигэру про мою идею.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100805,
					"content": "И как же главный герой с этим справится?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100806
					]
				}
			]
		},
