			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дзюнкити"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100701,
					"content": "В «Цукумомоно» продаются всевозможные товары. Некоторые из них похожи на предметы, собранные во время приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100702
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100702,
					"content": "Аои всегда говорит: «Что мусор для одного, то сокровище для другого».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100703
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100703,
					"content": "Чтобы добиться хороших продаж, очень важно выяснить, что интересует покупателя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100704
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100704,
					"content": "Но, если я так напишу, мне придётся потратить много времени на описание психологических мотивов, а это не очень хорошо сочетается с основной темой «Проклятого пути»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100705
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100705,
					"content": "Почему бы мне просто не сделать главного героя экстрасенсом, который может интуитивно чувствовать потребности покупателя?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100706,
						220100708
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100706,
					"content": "Нельзя просто взять и добавить новые способности главному герою!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100707
					]
				},
				{
					"id": 220100707,
					"content": "Не беспокойся. Всё происходит в рамках взросления и развития персонажа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100710,
					"content": "У меня появилось вдохновение! Теперь я знаю, о чём писать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100711
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100711,
					"content": "#{NICKNAME}, пойдём. Мне нужно рассказать об этом Сигэру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100708,
					"content": "В сюжете есть отсылки к этому?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100709
					]
				},
				{
					"id": 220100709,
					"content": "В сюжете... Я придумываю сюжет в процессе написания. С этим не будет проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Дзюнкити"
				}
			]
		},
		{
			"id": 2201008,
			"completionStepIds": [
				2201004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
