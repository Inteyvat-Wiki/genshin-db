			"dialogs": [
				{
					"id": 220100401,
					"content": "В главе, над которой я сейчас работаю, главный герой отправляется один на вражескую территорию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100402
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100402,
					"content": "Сбор информации имеет решающее значение для борьбы с врагом. Как я могу облегчить ему задачу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100403
					],
					"speakerTitle": "Дзюнкити"
				},
				{
