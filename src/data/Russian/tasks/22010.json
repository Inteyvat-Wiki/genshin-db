				"points": []
			},
			"dialogs": [
				{
					"id": 220100101,
					"content": "Дзюнкити, крайний срок сдачи рукописи - завтра. Больше никаких задержек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100102
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100102,
					"content": "Бесполезно меня подгонять! Я застрял на поворотной точке сюжета, и у меня писательский ступор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100103
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100103,
					"content": "О чём вы спорите?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100104
					]
				},
				{
					"id": 220100104,
					"content": "#{NICKNAME}, ты как раз вовремя. Нам не помешает голос разума.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100105
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100105,
					"content": "Я Сигэру, редактор издательского дома Яэ. А это Дзюнкити, писатель, за которого я отвечаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100106
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100106,
					"content": "Его новый роман «Онибудо» очень популярен. Но он никогда не укладывается в сроки. Иногда даже задерживает срок сдачи рукописи на несколько недель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100107
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100107,
					"content": "И он, конечно же, в своём репертуаре. Если он не сдаст рукопись к завтрашнему дню, я не смогу отдать в печать номер за этот месяц.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100108
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100108,
					"content": "Почему бы нам не отложить выпуск? Наши преданные читатели всё равно заплатят за него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100109
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100109,
					"content": "Не говори глупости. Если у романа не будет регулярного продолжения, его репутация будет подмочена!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100110
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100110,
					"content": "Но у меня совсем нет вдохновения. Я не буду писать лишь бы что. Сюжет должен быть захватывающим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100111
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100111,
					"content": "Но другие писатели уже сдали свои рукописи. Остался только ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100112
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100112,
					"content": "Может быть Дзюнкити просто нужно немного вдохновения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100113
					]
				},
				{
					"id": 220100113,
					"content": "Вот именно! Видишь, они меня понимают. Мне нужно вдохновение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100114
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100114,
					"content": "Пойду прогуляюсь в поисках вдохновения. Думаю, оно не заставит себя ждать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100115
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100115,
					"content": "Эй, в прошлый раз ты говорил то же самое, чтобы уйти от разговора. В этот раз такое не повторится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100116
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100116,
					"content": "Но в этот раз у меня правда нет вдохновения! Поверь мне хотя бы раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100117
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100117,
					"content": "Хорошо... Но это в последний раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100118
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100118,
					"content": "Больше никаких задержек. Понял?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100119
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100119,
					"content": "Понял я... Понял...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100120
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100120,
					"content": "Хм... Похоже, на этот раз мне придётся сдать рукопись вовремя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100121,
						220100122
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100121,
					"content": "Пойдём добудем материал.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220100122,
					"content": "Пойдём поищем вдохновение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100123
					]
				},
				{
					"id": 220100123,
					"content": "Если бы найти вдохновение было так просто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100124
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100124,
					"content": "Но мне придётся как-то это сделать. Иначе Сигэру сотрёт меня в порошок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				}
			]
		},
