			"dialogs": [
				{
					"id": 220100901,
					"content": "Я нашёл вдохновение в «Кузнице Амэнома».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100902
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100902,
					"content": "Правда? Ты действительно собирал материал? Расскажи, что ты придумал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100903
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100903,
					"content": "Однажды ночью на главного героя внезапно снизошло озарение, и он получил непревзойдённую алхимическую способность - «Воскрешение меча».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100904
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100904,
					"content": "Он может превращать ржавый клинок в мощное оружие, просто произнеся его имя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100905
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100905,
					"content": "И таким образом... Что? Что не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100906
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100906,
					"content": "Эй... ты что, опять взялся за старое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100907,
						220100908
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100907,
					"content": "Опять?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100909
					]
				},
				{
					"id": 220100909,
					"content": "Ты опять собираешься добавить главному герою новые способности, чтобы продолжить историю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100910
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100910,
					"content": "И ты будешь добавлять новые нюансы к этим способностям, пока не закончишь главу. Я прав?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100911
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100911,
					"content": "Неважно, насколько тебе нравится персонаж, перестань давать ему слишком много способностей! Это запутает читателей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100912
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100912,
					"content": "Но я всегда так писал. Так ведь интереснее, и читателям нравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100913
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100913,
					"content": "Не надо говорить мне, что нравится читателям! Многие уже устали от твоих бесконечных придумок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100914
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100914,
					"content": "#Твои идеи слишком консервативны! Давай послушаем, что скажет {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100915
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100915,
					"content": "#{NICKNAME}, кто из нас прав?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100908,
					"content": "За что именно?",
