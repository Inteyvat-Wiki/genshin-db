					"Сигэру"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100916,
					"content": "Вообще-то идея Дзюнкити не так уж и плоха...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100917
					]
				},
				{
					"id": 220100917,
					"content": "Не так уж и плоха? Если он продолжит писать в том же духе, он сам себя запутает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100918
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100918,
					"content": "#Видишь, {NICKNAME} на моей стороне. Значит, моя идея понравится читателям!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100919
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100919,
					"content": "Самое главное в романе - это захватывающий сюжет. Я всегда об этом помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100920
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100920,
					"content": "Ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100921
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100921,
					"content": "Не волнуйся. Я знаю, что я делаю. Глава обязательно получит единодушную похвалу. Вот увидишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				}
			]
		},
		{
			"id": 2201013,
