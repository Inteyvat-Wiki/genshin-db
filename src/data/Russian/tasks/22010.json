			},
			"dialogs": [
				{
					"id": 220100601,
					"content": "Искры летят, когда молот ударяется о наковальню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100602
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100602,
					"content": "Кузница Амэнома - это место, полное энергии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100603
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100603,
					"content": "Кузнецы используют самые простые инструменты, чтобы превратить прототипы и сырые минералы в мощное оружие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100604
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100604,
					"content": "Если при ковке используется алхимия, разве нельзя создать неразрушимое оружие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100605,
						220100606
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100605,
					"content": "Алхимия не способна на такое...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100608
					]
				},
				{
					"id": 220100608,
					"content": "Да, это отличная идея! У главного героя должно быть самое сильное оружие! Выкованное с помощью алхимии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100609
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100609,
					"content": "А ещё у этого оружия должно быть потрясающее название... и потрясающая история.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100610
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100610,
					"content": "Вот оно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100611
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100611,
					"content": "#{NICKNAME}, пойдём. Мне нужно рассказать об этом Сигэру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100606,
					"content": "Вряд ли ты понимаешь, в чём состоит смысл алхимии...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100607
					]
				},
				{
					"id": 220100607,
					"content": "В смысле? Разве алхимия это не то, что делает невозможное возможным?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100608
					],
					"speakerTitle": "Дзюнкити"
				}
			]
		},
		{
			"id": 2201007,
			"completionStepIds": [
				2201003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201003",
							"2"
						],
						"stepId": 2201003,
						"stateName": "QUEST_STATE_UNFINISHED"
