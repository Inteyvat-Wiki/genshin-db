			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дзюнкити",
					"Сигэру"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220101101,
					"content": "Мы наблюдали за работой досинов, и меня посетило вдохновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101102
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220101102,
					"content": "Очень хорошо. Расскажи, что ты придумал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101103
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220101103,
					"content": "У главного героя внезапно пробуждается способность к маскировке, позволяющая ему свободно менять внешность и голос... Назовем это «Зеркало иллюзий»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101104
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220101104,
					"content": "В таком случае как бы сильно ни отбивался враг, он не сможет остановить главного героя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101105
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220101105,
					"content": "Эй... ты что, опять взялся за старое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101106,
						220101107
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220101106,
					"content": "Опять?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220101108
					]
				},
				{
					"id": 220101108,
					"content": "Ты опять собираешься добавить главному герою новые способности, чтобы продолжить историю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101109
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220101109,
					"content": "И ты будешь добавлять новые нюансы к этим способностям, пока не закончишь главу. Я прав?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101110
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220101110,
					"content": "Неважно, насколько тебе нравится персонаж, перестань давать ему слишком много способностей! Это запутает читателей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101111
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220101111,
					"content": "Но я всегда так писал. Так ведь интереснее, и читателям нравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101112
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220101112,
					"content": "Не надо говорить мне, что нравится читателям! Многие уже устали от твоих бесконечных придумок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101113
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220101113,
					"content": "#Твои идеи слишком консервативны! Давай послушаем, что скажет {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101114
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220101114,
					"content": "#{NICKNAME}, кто из нас прав?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220101107,
					"content": "За что именно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220101108
					]
				}
			]
		},
		{
			"id": 2201012,
