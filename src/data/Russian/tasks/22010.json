			"trigger": {
				"objectNames": [
					"Дзюнкити",
					"Сигэру"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100922,
					"content": "Вообще-то, Сигэру говорит разумные вещи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100923
					]
				},
				{
					"id": 220100923,
					"content": "Разумные? Разумность не заменит хорошего сюжета. Разумный сюжет был бы скучен без захватывающей истории!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100924
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100924,
					"content": "Когда придёт время закончить историю, ты сойдёшь с ума, пытаясь связать концы с концами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100925
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100925,
					"content": "Я-я... делаю заметки. У меня не будет проблем с концовкой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100926
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100926,
					"content": "Тебе приходится делать заметки, чтобы запомнить все детали. Хочешь, чтобы читатели тоже делали заметки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100927
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100927,
					"content": "Э... Ну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100928
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220100928,
					"content": "Я не говорю, что ты не можешь добавить новые способности. Просто ты должен помнить, сколько их и когда они добавляются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100929
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100929,
					"content": "Написание романа похоже на марафон. Если ты слишком усердствуешь в начале, то быстро выдохнешься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100930
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100930,
					"content": "Ключ к успешному роману - постоянное движение вперёд, шаг за шагом. Поверь мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100931
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220100931,
					"content": "Хорошо-хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				}
			]
		}
	]
