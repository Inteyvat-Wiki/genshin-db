			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910203,
					"content": "Вы отдаёте Семёну блокнот и выпавшие страницы...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910204
					]
				},
				{
					"id": 760910204,
					"content": "Посмотрим... Да, это они! Большое спасибо. Здесь содержится множество улик против Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910205
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910205,
					"content": "...Улик?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760910206,
					"content": "Посмотрите на сооружения, которые они построили на острове Паха. Посмотрите на механизмы, которые они привезли... Ведь раньше остров был домом для многих животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910207
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910207,
					"content": "Я недавно вернулся из Малинового лимана, медузы там еле живы, и всё из-за устройств Фатуи... Люди должны об этом знать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910208
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910208,
					"content": "А? Ты о Желейке и остальных? Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760910209,
					"content": "Вы рассказываете ему о случившемся в Малиновом лимане...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910210
					]
				},
				{
					"id": 760910210,
					"content": "Видимо, я опоздал... Но об этом всё равно нужно написать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910211
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910211,
					"content": "Оставляю свой блокнот вам. Мне нужно поспешить домой, упорядочить остальные записи и подготовить статью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910213
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910213,
					"content": "Да, и если расскажете кому-нибудь, непременно добавьте, что узнали всё от Семёна. Семён - это я! Всё-таки нужно время, чтобы написать статью и опубликовать её в газете...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910214
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910214,
					"content": "В общем, спасибо вам большое, до свидания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
