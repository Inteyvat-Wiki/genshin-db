					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910101,
					"content": "Парящий альв! Мой блокнот... Все самые важные мои записи забрали Фатуи, ты поможешь мне отыскать их?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910102
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910102,
					"content": "Паймон никакой не альв... но дело плёвое! Кстати, почему Фатуи понадобилось отбирать блокнот у маленького мальчика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760910103,
					"content": "Возможно, они боятся, что я обнародую записи... Если вы поможете мне вернуть блокнот, я вам всё расскажу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910105
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910105,
					"content": "Но об этом поговорим позже, а сейчас очень прошу, помогите мне <color=#00E1FFFF>вернуть блокнот</color>. Возможно, кое-какие <color=#00E1FFFF>страницы выпали</color>. Вы найдёте их там, где сейчас Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7609102,
			"completionStepIds": [
				7609107
			],
