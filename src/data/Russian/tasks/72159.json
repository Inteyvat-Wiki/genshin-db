			"dialogs": [
				{
					"id": 721590501,
					"content": "#Похоже, ты запустил{F#а} тренировки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590502
					],
					"speakerTitle": "Масанори"
				},
				{
					"id": 721590502,
					"content": "Достаточно всего одного дня праздности, чтобы перечеркнуть десять дней труда воина. Уверен, тебе этот принцип хорошо знаком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590503
					],
					"speakerTitle": "Масанори"
				},
				{
					"id": 721590503,
					"content": "#Продолжай совершенствовать навыки. Я не верю, что это всё, на что ты способ{F#на}{M#ен}.",
