			"dialogs": [
				{
					"id": 721590301,
					"content": "Я хочу поговорить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721590302
					]
				},
				{
					"id": 721590302,
					"content": "Я отверг своё прошлое. Мне с этим миром нечего больше обсуждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590303
					],
					"speakerTitle": "Масанори"
				},
				{
					"id": 721590303,
					"content": "#Если ищешь, с кем поговорить, ты обратил{F#ась}{M#ся} не по адресу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590304
					],
					"speakerTitle": "Масанори"
				},
				{
					"id": 721590304,
					"content": "Прошу тебя, уходи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Масанори"
				}
			]
		},
