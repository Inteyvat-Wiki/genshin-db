			"dialogs": [
				{
					"id": 740920101,
					"content": "Почему... почему всё так обернулось... Возмутительно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920102,
						740920103
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920102,
					"content": "Госпожа Хрония?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				},
				{
					"id": 740920104,
					"content": "#{NICKNAME}! Ты {M#пришёл}{F#пришла}... ты... по крайней мере, ты знаешь правду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920105
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920105,
					"content": "Госпожа Хрония, успокойтесь. Что с вами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740920106,
					"content": "Даже если... даже если мой отчёт не попадёт в газету...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920107
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920107,
					"content": "Что случилось с вашей газетой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920108
					]
				},
				{
					"id": 740920108,
					"content": "Да, нам всем интересно, когда же мы увидим вашу газету.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740920109,
					"content": "Не видели... не видели... точно... должно быть, вы не видели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920110
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920110,
					"content": "Почему у вас такое растерянное выражение лица?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920111
					]
				},
				{
					"id": 740920111,
					"content": "Дело вот в чём... С того дня, как я вернулась из Исследовательского института Фонтейна, я работала над статьёй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920112
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920112,
					"content": "Я написала в ней обо всём, что видела, слышала и чувствовала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920113
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920113,
					"content": "Например, что Исследовательский институт устранил далеко не все архиумы. И, более того, даже инициировал программу, связанную с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920114
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920114,
					"content": "Один из подчинённых Эдвина был послан обыскать руины Исследовательского института Фонтейна, но погиб во время взрыва.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920115
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920115,
					"content": "Раймондо, старший технический сотрудник, отказался признать его смерть и настаивал на том, что взрывы были спланированы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920116
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920116,
					"content": "А ещё этот вышедший из-под контроля механизм в руинах и заражённое озеро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920117
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920117,
					"content": "Обо всём, что Исследовательский институт намеревается сокрыть ото всех, я написала в своей статье!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920118
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920118,
					"content": "Но... после того, как я отправила статью в газету, мне сказали, что Исследовательский институт начал против меня уголовное дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920119
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920119,
					"content": "Согласно требованиям издательства, все мои материалы, связанные с Исследовательским институтом Фонтейна, должны пройти проверку на достоверность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920120
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920120,
					"content": "Мой отчёт был отозван...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920121,
						740920122
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920121,
					"content": "Проверка на достоверность?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920123,
					"content": "Нет, эта проверка не против моего отчёта, а против меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920124
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920124,
					"content": "Если в двух словах, то Исследовательский институт заявил, что из-за конфликта интересов я предвзято освещаю события в отчёте и предоставляю общественности неверную информацию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920125
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920125,
					"content": "Но разве у тебя есть конфликт интересов с Исследовательским институтом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920126
					]
				},
				{
					"id": 740920126,
					"content": "Госпожа Хрония всего лишь сделала пару фото, на которых камни да железяки... Какой тут конфликт интересов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740920127,
					"content": "Великие архонты! Ты пролила свет на их моральные принципы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920128
					]
				},
				{
					"id": 740920128,
					"content": "Они... обвиняют меня в том, что я раскрыла конфиденциальную информацию по поводу нового вида Фонты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920129
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920129,
					"content": "Люди из Исследовательского института настаивают, что на снимках, которые я сделала в руинах, попал проектный вариант новой модели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920130
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920130,
					"content": "Они обязаны проверять каждую фотографию. Пока Исследовательский институт не отзовёт свой иск, я буду вынуждена постоянно проходить проверки на достоверность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920131
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920131,
					"content": "Уверена, что Исследовательский институт задумал это, чтобы помешать мне публиковаться. Но я не могу сдаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920132
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920132,
					"content": "Вот, возьми! Это копии газеты, которые я напечатала тайком. Скоро я начну распространять их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920133
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920133,
					"content": "Я расскажу всем правду об Исследовательском институте, а ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920134
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920134,
					"content": "Госпожа Хрония! Почему вы здесь? Вас так долго искали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920135
					],
					"speakerTitle": "Мюрн"
				},
				{
					"id": 740920135,
					"content": "О нет! Кто-то пришёл, мне нужно уходить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920136
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920136,
					"content": "Возьми эти газеты. Позаботься о них, здесь вся правда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920137
					],
					"speakerTitle": "Хрония"
				},
				{
					"id": 740920137,
					"content": "Согласно предписаниям, вы должны явиться во Дворец законов для прохождения ежедневной проверки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920138
					],
					"speakerTitle": "Мюрн"
				},
				{
					"id": 740920138,
					"content": "А! Не убегайте, госпожа Хрония!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920139
					],
					"speakerTitle": "Мюрн"
				},
				{
					"id": 740920139,
					"content": "Это же всего лишь Фонта, наверняка всё это какое-то недоразумение! Если вы только объясните...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920140
					],
					"speakerTitle": "Мюрн"
				},
				{
					"id": 740920140,
					"content": "Подождите! Пожалуйста, постойте, госпожа Хрония!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мюрн"
				},
				{
					"id": 740920122,
					"content": "Издательство полагает, что твоему отчёту нельзя верить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920103,
					"content": "Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				}
			]
		}
	]
}