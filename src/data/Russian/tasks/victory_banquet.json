			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кодзэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230201,
					"content": "Уй... от этого парня несёт выпивкой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230202,
					"content": "Хм? Ой, да это же... Командир Рыбы-меча II! Верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230203
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230203,
					"content": "#Ты всё-таки {F#вернулась}{M#вернулся}. А я уже думал, ты {F#бросила}{M#бросил} отряд и {F#сбежала}{M#сбежал}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230204
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230204,
					"content": "Ну уж нет! Мы бы ни за что не стали убегать от боя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230205,
					"content": "Хм, кто его знает. Эти дни все только и говорят, что о мире и стабильности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230206
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230206,
					"content": "Не забыли, что для сопротивления главное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230207
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230207,
					"content": "Воля к борьбе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230208
					]
				},
				{
					"id": 120230208,
					"content": "#Правильно. Я тебя немного испытаю. Посмотрим, {F#достойна}{M#достоин} ли ты звания воина сопротивления!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230209
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230209,
					"content": "Если ты победишь меня, я отвечу на все твои вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230210
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230210,
					"content": "Ай... неужели ему так трудно просто поговорить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230211,
					"content": "#Сразишься с ним, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230212,
						120230213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230212,
					"content": "А как же. Мы не проиграем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				},
				{
					"id": 120230214,
					"content": "Кхе... Это мы ещё посмотрим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230213,
					"content": "Через пару секунд ты будешь умолять о том, чтобы всё рассказать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				}
			]
		},
		{
			"id": 1202303,
			"completionStepIds": [
				1202305,
				1202312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202305",
							"2"
						],
						"stepId": 1202305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кодзэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230301,
					"content": "Ты сильный боец... Недаром её превосходительство выбрала тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230302
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230302,
					"content": "Ты действительно обладаешь волей к борьбе... Наверное, ты поймёшь нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230303
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230303,
					"content": "Командир, соратник... присоединишься к нам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230304
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230304,
					"content": "Сначала расскажи, что происходит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230305
					]
				},
				{
					"id": 120230305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230306
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230306,
					"content": "Сговора между комиссией Тэнрё и Фатуи не существует. Мы выдумали его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230307
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230307,
					"content": "Ч-что?! Бедная Кокоми места себе не находит! Выходит, всё это враки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230308,
					"content": "Вы чем вообще думали? Из-за этого вы можете снова отправиться воевать с комиссией Тэнрё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230309,
					"content": "Да. Именно этого мы и хотим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230310
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230310,
					"content": "Мирные переговоры? Тьфу... Все только о них и думают. Поэтому будущее Ватацуми под угрозой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230311
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230311,
					"content": "Нет никаких гарантий, что комиссия Тэнрё не предаст! Нет никаких гарантий, что сёгун Райдэн не провозгласит очередную Охоту на Глаза Бога!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230312
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230312,
					"content": "Мы сопротивление! Всё держится на нашей воле к борьбе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230313
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230313,
					"content": "Комиссии Тэнрё и сёгуну доверять нельзя. Но мы-то можем довериться самим себе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230314
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230314,
					"content": "Ты ведь тоже так считаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230315
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230315,
					"content": "В чём-то он прав, но Паймон чует неладное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230316,
					"content": "Короче говоря, ты просто хочешь сражаться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230317
					]
				},
				{
					"id": 120230317,
					"content": "Точно! То, что ты говоришь, всего лишь догадки, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230318,
					"content": "Тебе действительно захотелось выдумать столь дикий слух и разрушить мир, добытый трудами множества людей, из-за каких-то там домыслов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230319,
					"content": "Не говори со мной так, будто ты лучше меня! Да что вы понимаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230320
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230320,
					"content": "Ради победы мы всецело отдались воле к борьбе, но теперь нам вдруг говорят, что это больше не имеет значения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230321
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230321,
					"content": "Они хотят, чтобы мы сложили оружие и зажили обычной жизнью, но разве мы так можем? Как я могу, если... каждый раз, когда закрываю глаза, вижу лица друзей, которых мы потеряли в бою.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230322
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230322,
					"content": "Когда они предстают передо мной, их образы напоминают мне, что нельзя прощать комиссию Тэнрё, и нельзя прощать Охоту на Глаза Бога!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230323
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230323,
					"content": "#Похоже, ты не {F#одна}{M#один} из нас... Расскажи всё её превосходительству, если хочешь. Но нас не остановить. Уже слишком поздно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230324
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230324,
					"content": "Не остановить? О чём ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230326
					],
					"speakerTitle": "Кодзэн"
				},
				{
					"id": 120230326,
					"content": "Ах, вряд ли он ответит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230327,
					"content": "#Как быть, {NICKNAME}? Дело серьёзное! Нужно сейчас же рассказать всё Кокоми!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1202304,
			"completionStepIds": [
				1202306,
				1202307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202306",
							"2"
						],
						"stepId": 1202306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сангономия Кокоми"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230401,
					"content": "...Мы тут кое-что выяснили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230402,
					"content": "Слухи о сговоре Тэнрё и Фатуи - ложь. Они всё выдумали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230403,
					"content": "Они хотят сорвать переговоры о перемирии и продолжить сражаться. Ещё они сказали, что их не остановить, и уже слишком поздно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230404,
					"content": "М-м, ясно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230405,
						120230406
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230405,
					"content": "В чём дело, Кокоми?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				},
				{
					"id": 120230407,
					"content": "Ничего, я в норме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230408
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230408,
					"content": "Это моя вина. Заметь я их настроения раньше, до такого бы не дошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230409
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230409,
					"content": "Я, кажется, понимаю, что означает это «слишком поздно».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230410
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230410,
					"content": "Переговоры начнутся только завтра, но обе стороны уже отправили стражников обеспечивать безопасность места, где пройдёт встреча.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230411
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230411,
					"content": "Подозреваю, что один из товарищей Кодзэна, выступающих за войну, проник в стражу и собирается во время завтрашних переговоров разжечь вражду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230412
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230412,
					"content": "Плохо дело. Хочешь, мы отправимся туда и сменим стражу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230413,
					"content": "Это не сработает. Во-первых, прибытие нового отряда стражи насторожит обе стороны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230414
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230414,
					"content": "Это наверняка подтолкнёт сторонников войны к действию. Они нападут на стражников комиссии Тэнрё, и тогда может снова вспыхнуть война.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230415
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230415,
					"content": "Тем более что нам неизвестно, сколько солдат Ватацуми в этом замешано. После такой спешной замены мы не будем знать, кому можно доверять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230416
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230416,
					"content": "Как всё запутано... Мы действительно ничего не можем предпринять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230417,
					"content": "Не стоит беспокоиться. Что сделано, то сделано. Теперь мне необходимо разработать ответный план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230418
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230418,
					"content": "Эти солдаты зашли слишком далеко, но виноваты не только они. Что бы ни случилось, я придумаю, как спасти их...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230419
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230419,
					"content": "Встречаемся завтра на этом же месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230406,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				}
			]
		},
		{
			"id": 1202305,
			"completionStepIds": [
				1202308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
