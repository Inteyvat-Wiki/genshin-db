			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хирай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230501,
					"content": "Благодаря её превосходительству на Ватацуми наконец-то снова мир...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230502
					],
					"speakerTitle": "Хирай"
				},
				{
					"id": 120230502,
					"content": "Как дела? Что нового?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230503
					]
				},
				{
					"id": 120230503,
					"content": "Нового? Дай подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230504
					],
					"speakerTitle": "Хирай"
				},
				{
					"id": 120230504,
					"content": "Самая большая перемена для нас в том, что мы снова можем выходить в море ловить рыбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230505
					],
					"speakerTitle": "Хирай"
				},
				{
					"id": 120230505,
					"content": "Во время войны там было полно боевых кораблей. Нам приходилось довольствоваться мелкой рыбёшкой и креветками с побережья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230506
					],
					"speakerTitle": "Хирай"
				},
				{
					"id": 120230506,
					"content": "Иногда улов был скудный, и мы жили впроголодь. Детишки ревели день и ночь напролёт, но мы ничего не могли поделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230507
					],
					"speakerTitle": "Хирай"
				},
				{
					"id": 120230507,
					"content": "Шли спать с пустым животом и ворочались всю ночь, пытаясь дождаться рассвета. А сейчас уже будет получше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230508
					],
					"speakerTitle": "Хирай"
				},
				{
					"id": 120230508,
					"content": "#Поговаривают, ты командир Рыбы-меча II, да? Спасибо, что {F#помогла}{M#помог} нам победить. Вот тебе рыба! Только что поймал. От неё отдаёт... рыбой, но это ничего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230509
					],
					"speakerTitle": "Хирай"
				},
				{
					"id": 120230509,
					"content": "Ох, нет-нет-нет, мы не можем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230510,
					"content": "Ха-ха, берите-берите! Если бы не вы, я и сегодня шёл бы спать голодным. Её превосходительство учит нас благодарить за добро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230511
					],
					"speakerTitle": "Хирай"
				},
				{
					"id": 120230511,
					"content": "#Ладно, спасибки. Идём, {NICKNAME}. Поговорим с кем-нибудь ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
