			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сангономия Кокоми",
					"Дэндзиро"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230101,
					"content": "Кажется, всё готово к пиру. Перед тем, как он начнётся, мне нужно произнести краткую речь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230102
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230102,
					"content": "Ах... У тебя хватит энергии, как ты считаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230103,
					"content": "Не беспокойся, у меня её предостаточно. Благодаря вам я восстановилась быстрее обычного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230104
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230104,
					"content": "Отлично! Мы будем болеть за тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120230105,
					"content": "Приветствую всех вас. Сегодня мы празднуем нашу победу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230106
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230106,
					"content": "Война с сёгуном недавно подошла к концу, и мы стали свидетелями отмены Охоты на Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230107
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230107,
					"content": "Никому из нас будущее Инадзумы не известно. Но завтра я проведу переговоры о мире с комиссией Тэнрё. Клянусь, я всегда буду стремиться к миру для острова Ватацуми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230108
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230108,
					"content": "Благодарю каждого из вас за то, что не прекращали бороться. Лишь благодаря вашим усилиям мы одержали победу в этой тяжёлой битве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230109
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230109,
					"content": "Этот пир проходит в честь каждого из вас. Пришло время расслабиться и насладиться победой, которая далась нам такой высокой ценой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230110
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230110,
					"content": "Ура-а-а!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230111
					],
					"speakerTitle": "Дэндзиро"
				},
				{
					"id": 120230111,
					"content": "Сегодня всё прошло гладко. Хорошо, что не возникло никаких проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230112
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230112,
					"content": "В часы радости люди более открыты. Могу ли я попросить тебя собрать для меня некоторые сведения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230113
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230113,
					"content": "У меня до сих пор нет зацепок касательно возможного сговора комиссии Тэнрё и Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230114
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230114,
					"content": "И я опасаюсь, что завтра на переговорах может что-то случиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230115
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120230115,
					"content": "Хорошо, мы поспрашиваем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1202302,
