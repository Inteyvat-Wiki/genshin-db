					"Кабасава"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230601,
					"content": "Эй, кому свежих фруктов-овощей? Верное средство, если объелись жареного мяса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230602
					],
					"speakerTitle": "Кабасава"
				},
				{
					"id": 120230602,
					"content": "Что последнее время новенького?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230603
					]
				},
				{
					"id": 120230603,
					"content": "Ты о деле с комиссией Тэнрё и Фатуи? Мне довелось об этом слышать, но ничего конкретного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230604
					],
					"speakerTitle": "Кабасава"
				},
				{
					"id": 120230604,
					"content": "Говоришь, солдаты на взводе... Мне тоже так кажется. Видишь вон того парня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230605
					],
					"speakerTitle": "Кабасава"
				},
				{
					"id": 120230605,
					"content": "Какой-то он нынче странный. Орёт постоянно и копьём размахивает, когда ему делать нечего. Пару раз перепугал меня до смерти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230606
					],
					"speakerTitle": "Кабасава"
				},
				{
					"id": 120230606,
					"content": "Ух... Какое счастье, что война кончилась. Довольно хватили мы лиха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230607
					],
					"speakerTitle": "Кабасава"
				},
				{
					"id": 120230607,
					"content": "А больше я и не знаю. Если хотите, можете спросить у него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230608
					],
					"speakerTitle": "Кабасава"
				},
				{
					"id": 120230608,
					"content": "#А это уже интересно. {NICKNAME}, посмотрим, что там такое с этим парнем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
