					"nextDialogs": [
						732961404
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732961404,
					"content": "Я должен сосредоточиться на выздоровлении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Жюльен"
