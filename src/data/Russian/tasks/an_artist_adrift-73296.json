			"dialogs": [
				{
					"id": 732961601,
					"content": "Фух... Я не думал, что рисование отнимает столько сил. Если бы я знал это, я бы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961602
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732961602,
					"content": "Похоже, Жюльену очень непросто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732961603,
					"content": "Уф, ну, я... только недавно залечил раны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961604
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732961604,
					"content": "Здешние пейзажи поистине уникальны. Странно, что я раньше этого не замечал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961605
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732961605,
					"content": "Впереди тоже неплохой вид. Хочешь пойти туда? Только будь осторожен.",
