			},
			"dialogs": [
				{
					"id": 732960601,
					"content": "Но сначала нам нужно подготовиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960602
					]
				},
				{
					"id": 732960602,
					"content": "Хорошо. Отправимся сразу, как будем готовы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7329608,
			"completionStepIds": [
				7329608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329608",
							"2"
						],
						"stepId": 7329608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Жюльен"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960801,
					"content": "Как тебе этот вид? Красиво, да? Перчику тоже нравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732960802,
					"content": "Словами не описать эту красоту. Катерпиллер был прав. Мир за пределами железной клетки необъятен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960803
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732960803,
					"content": "Железной клетки?.. Ты говорил, что в Фонтейне у тебя тесновато...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732960804,
					"content": "Кхе, в Сумеру есть на что посмотреть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960805
					]
				},
				{
					"id": 732960805,
					"content": "Точно! Он решил стать настоящим художником, так что давай немного сменим обстановку, чтобы... как это называется... расширить горизонты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732960806,
					"content": "Он сказал, что хочет сдаться, но Паймон считает, что рано так говорить! Ещё есть время передумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960807
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732960807,
					"content": "Только подумай об этом, Жюльен! Там могут быть такие же грандиозные пейзажи, как этот, а может быть, даже более грандиозные - такие, каких ты никогда не видел! Может быть, они дадут вдохновение, которое тебе так нужно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960808
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732960808,
					"content": "Что касается твоего восприятия цвета, ты сам сказал, что просто видишь пейзаж по-другому...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732960809,
					"content": "«Красотой нужно делиться».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960810
					]
				},
				{
					"id": 732960810,
					"content": "Согласен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960811
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732960811,
					"content": "Да... Звучит вполне разумно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960812
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732960812,
					"content": "Это твои собственные слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960813
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732960813,
					"content": "Я... Ха-ха, я так и знал. Я знал это, но продолжал идти по ложному пути...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960814
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732960814,
					"content": "Мы узнали об этом месте только потому, что Перчик привёл тебя сюда. Разве можно считать это ложным путём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960815
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732960815,
					"content": "Жаль, что мы не смогли помочь тебе найти путь паломничества океанид, хотя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960816
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732960816,
					"content": "Он вообще существует?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960817
					]
				},
				{
					"id": 732960817,
					"content": "До этого момента я верил, что он существует, но... Думаю, что неважно, были ли успешны мои поиски...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960818
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732960818,
					"content": "...главное - то, что я нашёл долгожданный ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960819
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732960819,
					"content": "Спасибо, друзья. Как мне вас отблагодарить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960820
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732960820,
					"content": "Если бы я только купил то мистическое яйцо, что может отгонять несчастья. Оно наверняка пригодилось бы искателям приключений вроде вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960821,
						732960823
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732960821,
					"content": "Да, и правда жаль.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960822
					]
				},
				{
					"id": 732960822,
					"content": "#{NICKNAME}, ты что, во всё это веришь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732960825,
					"content": "Я останусь здесь ненадолго. Это место успокаивает душу и хорошо подходит для размышлений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960826
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732960826,
					"content": "У меня есть предчувствие, что на этот раз я смогу нарисовать что-то особенное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960827
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732960827,
					"content": "Спасибо, дорогие друзья. Желаю вам удачи в путешествии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732960823,
					"content": "Всё в порядке. Не думаю, что оно бы нам пригодилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960824
					]
				},
				{
					"id": 732960824,
					"content": "Почему нет? Даже если оно и не сможет защищать от несчастий, может быть... может быть, оно было бы в сто раз вкуснее обычного яйца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Паймон"
				}
			]
		},
