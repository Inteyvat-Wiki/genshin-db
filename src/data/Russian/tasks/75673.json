			"dialogs": [
				{
					"id": 756730101,
					"content": "Аши полностью довольны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730102
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756730102,
					"content": "Нам удалось помочь им завершить ещё одно особенное испытание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730103
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756730103,
					"content": "Ура, потрясающий успех!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756730104,
					"content": "Этот аша сразу же вдохновился и хочет скорее начать рисовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730105,
						756730106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756730105,
					"content": "Момент вдохновения мимолётен...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				},
				{
					"id": 756730107,
					"content": "#А, да! Он ещё оставил кучу сокровищ, которые собрал... Всё это должно достаться вам, {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730108
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756730108,
					"content": "Может быть, когда мы вернёмся сюда через какое-то время, то увидим новый шедевр Аши Мастера Цвета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730109
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756730109,
					"content": "Даже обычные аши создают удивительные краски. Интересно, на что способно такое особенное существо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756730110,
					"content": "Ой, Паймон не терпится увидеть! А вдруг они смогут создать что-то... что обычными словами не описать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756730111,
					"content": "Цвета флогистона? Луны? Или глубин звёздного неба?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756730112,
					"content": "Вот именно! В путешествиях, если встречаешь того, кто попал в беду, нужно по возможности помогать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730113
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756730113,
					"content": "Угу! И, кто знает, однажды это может обернуться неожиданной наградой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730114,
						756730115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756730114,
					"content": "#Я тоже {M#согласен}{F#согласна} с Беннетом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730116,
					"content": "Хотя... Как-то неправильно помогать только ради награды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730117
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756730117,
					"content": "Даже без всякой платы приятно видеть, как решаются проблемы, как друзья, ещё недавно растерянные, снова улыбаются, как всё начинает идти к лучшему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730118
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756730118,
					"content": "Мне это по-настоящему нравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Беннет"
				},
				{
					"id": 756730115,
					"content": "Это даёт ощущение настоящей полноты жизни.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730106,
					"content": "Нельзя его упускать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				}
			]
		}
	]
}