			"dialogs": [
				{
					"id": 200070401,
					"content": "Благодарю тебя! Какие они всё-таки настойчивые. Интересно, что же такого поймали охотники...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070402
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 200070402,
					"content": "Драфф - гениальный охотник. Когда-нибудь я буду охотиться так же, как он.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070403
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 200070403,
					"content": "Но для начала нужно довезти эту развалюху до города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070404
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 200070404,
					"content": "Ты не поверишь, я уже почти починил повозку, но во время последней атаки её снова поломали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070405
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 200070405,
					"content": "Становится только хуже! Сзади была верёвка, но её, должно быть, оторвали хиличурлы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070406
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 200070406,
					"content": "Поищи, пожалуйста, <color=#00E1FFFF>верёвку</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аллан"
				}
			]
		},
