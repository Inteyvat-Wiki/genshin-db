					"nextDialogs": [
						200170404
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 200170404,
					"content": "Невероятно! Они стащили <color=#00E1FFFF>верёвку</color>! Добрый человек, пожалуйста, найди её.",
