			},
			"dialogs": [
				{
					"id": 200170101,
					"content": "Нет! Не бейте, пожалуйста! А, это ты. Славно... А куда делись все хиличурлы? Они убежали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170102
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 200170102,
					"content": "Отлично! Спасибо тебе. Они правда убежали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170103
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 200170103,
					"content": "Фух... За мной должок. Но после такой задержки мне всё равно не поспеть за караваном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170104
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 200170104,
					"content": "К тому же моя повозка сломана, нужно починить её и добраться до города, пока фрукты не испортились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170105
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 200170105,
					"content": "Если они испортятся, будет такая вонища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170106
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 200170106,
					"content": "Фу, уже попахивает. Надо всё перебрать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170107
					],
					"speakerTitle": "Фарра"
				},
				{
					"id": 200170107,
					"content": "Поможешь мне поискать материалы для ремонта телеги? Мне нужна <color=#00E1FFFF>крепкая доска</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фарра"
				}
			]
		},
