			"dialogs": [
				{
					"id": 727210101,
					"content": "Гав? Гав-гав! Гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210102,
						727210103
					],
					"speakerTitle": "Таромару"
				},
				{
					"id": 727210102,
					"content": "Э? Это же Таромару?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210104
					]
				},
				{
					"id": 727210104,
					"content": "Ясухико Таро упоминал, что четвёртый воин стал участником, потому что ему не хватало моры. Кажется, Таромару тоже борется за награду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 727210105,
					"content": "Прости, Таромару, но когда дело касается моры, Паймон непобедима!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 727210106,
					"content": "Гав?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210107
					],
					"speakerTitle": "Таромару"
				},
				{
					"id": 727210107,
					"content": "Гав-гав, гав-гав-гав-гав! Гав-гав-гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210108,
						727210109
					],
					"speakerTitle": "Таромару"
				},
				{
					"id": 727210108,
					"content": "Лай Таромару становится громче...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210110
					]
				},
				{
					"id": 727210110,
					"content": "Таромару, это честное соревнование, награда достанется тому, кто окажется более искусным в боевых искусствах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 727210111,
					"content": "Но если победим мы... то мы купим тебе вкусные лакомства!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 727210112,
					"content": "Гав, гав-гав-гав-гав-гав, гав-гав-гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210115,
						727210113
					],
					"speakerTitle": "Таромару"
				},
				{
					"id": 727210115,
					"content": "#Я ничего не понял{F#а}, давай начинать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210116
					]
				},
				{
					"id": 727210116,
					"content": "Гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Таромару"
				},
				{
					"id": 727210113,
					"content": "#Я ничего не понял{F#а}, дай нам минутку на подготовку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210114
					]
				},
				{
					"id": 727210114,
					"content": "Гав-гав-гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Таромару"
				},
				{
					"id": 727210109,
					"content": "Ты его разозлила.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210110
					]
				},
				{
					"id": 727210103,
					"content": "«Сильнейший воин» - это Таромару!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210104
					]
				}
			]
		}
	]
