	"talks": [
		{
			"id": 1302301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302304",
							"2"
						],
						"stepId": 1302304,
						"stateName": "QUEST_STATE_UNFINISHED"
