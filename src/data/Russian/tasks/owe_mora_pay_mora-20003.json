			"dialogs": [
				{
					"id": 200030701,
					"content": "«Хороший охотник». Там подают салат.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030702
					]
				},
				{
					"id": 200030702,
					"content": "«Хороший охотник»... Хм... Да, наверное, Мона пошла поесть салата. Пойдём и проверим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030703
