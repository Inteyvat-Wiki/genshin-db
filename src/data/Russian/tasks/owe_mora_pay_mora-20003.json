				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030501,
					"content": "Мона, ты дома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200030502,
					"content": "Пора платить аренду, Мона!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030503
					]
				},
				{
					"id": 200030503,
					"content": "Хм... Кажется, её нет дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200030504,
					"content": "Странно. Она же обычно сидит в своей комнате. Может, вышла по делам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200030505,
					"content": "А вдруг она лежит в голодном обмороке, не в силах открыть дверь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030506,
						200030507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200030506,
					"content": "Я не думаю, что всё так плохо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				},
				{
					"id": 200030508,
					"content": "Хм? Неужели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200030509,
					"content": "Но где же нам искать Мону?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200030507,
					"content": "Она же говорила, что нашла заработок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				}
			]
		},
