			"dialogs": [
				{
					"id": 200030601,
					"content": "Думаю, в библиотеке Ордо Фавониус.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030602
					]
				},
				{
					"id": 200030602,
					"content": "Библиотека... Точно! Библиотека ордена огромна. Может, Мона пошла туда за материалами для исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200030603,
					"content": "Тогда выдвигаемся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
