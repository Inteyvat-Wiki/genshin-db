				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гёте"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030301,
					"content": "Огромное тебе спасибо. Этого будет достаточно. Осталось отнести древесину столяру, а ещё собрать деньги за аренду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030302
					],
					"speakerTitle": "Гёте"
				},
				{
					"id": 200030302,
					"content": "Ой, застану ли я на месте эту гастро... астрогло... как её там бишь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030303
					],
					"speakerTitle": "Гёте"
				},
				{
					"id": 200030303,
					"content": "Астрологист Мона Мегистус.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030304
					]
				},
				{
					"id": 200030304,
					"content": "Точно, так её и зовут! Ай, всё никак не запомню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030305
					],
					"speakerTitle": "Гёте"
				},
				{
					"id": 200030305,
					"content": "Мона не заплатила за аренду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200030306,
					"content": "В том-то и дело. Все жильцы уже заплатили, а она нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030307
					],
					"speakerTitle": "Гёте"
				},
				{
					"id": 200030307,
					"content": "Сколько бы я к ней ни ходил, её никогда нет дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030308
					],
					"speakerTitle": "Гёте"
				},
				{
					"id": 200030308,
					"content": "#{NICKNAME}, пожалуйста, сходи к ней и поторопи с оплатой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гёте"
				}
			]
		},
