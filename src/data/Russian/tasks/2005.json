					"nextDialogs": [
						20050804
					],
					"speakerTitle": "Тадао"
				},
				{
					"id": 20050804,
					"content": "Сегодня было только начало. Я поведу вас по эпичному пути разбоя и грабежей, о котором будут рассказывать в легендах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050805
					],
					"speakerTitle": "Тадао"
				},
				{
					"id": 20050805,
					"content": "Босс, ты самый крутой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050806
					],
					"speakerTitle": "Го"
				},
				{
					"id": 20050806,
					"content": "Похоже, их мы и искали. Давай проучим их.",
					"roleType": "TALK_ROLE_NPC",
