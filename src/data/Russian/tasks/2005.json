				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кэн",
					"Тадао",
					"Паймон",
					"Го"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050201,
					"content": "Эх, вот и наши денежки... А мы ведь столько трудились, чтобы их украсть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050202
					],
					"speakerTitle": "Кэн"
				},
				{
					"id": 20050202,
					"content": "Начальник! Придумай что-нибудь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050203
					],
					"speakerTitle": "Кэн"
				},
				{
					"id": 20050203,
					"content": "#Хе-хе... А ты, {M#парень}{F#девка}, неплох{F#а}... Не хочешь стать Похитителем сокровищ? Нам такие люди пригодятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050204,
						20050205
					],
					"speakerTitle": "Тадао"
				},
				{
					"id": 20050204,
					"content": "Сначала расскажи всё, что знаешь о Куросаве.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				},
				{
					"id": 20050206,
					"content": "Куросава? А... Я помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050207
					],
					"speakerTitle": "Тадао"
				},
				{
					"id": 20050207,
					"content": "Так это он вас послал? Эх, не везёт нам... Не надо было его дом обчищать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050208
					],
					"speakerTitle": "Тадао"
				},
				{
					"id": 20050208,
					"content": "Что там было внутри? Много продовольствия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050209,
					"content": "Продовольствия? Шутишь, что ли? Там был полный бардак... Мы только странную коробку нашли. Думали, там что-то ценное лежит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050210
					],
					"speakerTitle": "Тадао"
				},
				{
					"id": 20050210,
					"content": "Хотел открыть, как вернёмся, чтобы никто нас не заметил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050211
					],
					"speakerTitle": "Тадао"
				},
				{
					"id": 20050211,
					"content": "Но раз уж вы нас поймали, то давайте договоримся? Мы вам коробку, а вы нас отпустите. Пойдёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050212
					],
					"speakerTitle": "Тадао"
				},
				{
					"id": 20050212,
					"content": "Договорились! Давай скорее открывай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050213,
					"content": "А?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050214
					],
					"speakerTitle": "Кэн"
				},
				{
					"id": 20050214,
					"content": "Что за?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050215
					],
					"speakerTitle": "Тадао"
				},
				{
					"id": 20050215,
					"content": "Долговые расписки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050216
					],
					"speakerTitle": "Го"
				},
				{
					"id": 20050216,
					"content": "Да, и так много...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050217,
					"content": "Похоже, что все они на имя Аои из магазина... Он ей кучу денег должен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050218,
					"content": "Пойдём поговорим с Аои, и узнаем, в чём дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050219,
					"content": "А вы идите. И смотрите, больше нам на глаза не попадайтесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050220,
					"content": "Да! Конечно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050221
					],
					"speakerTitle": "Кэн"
				},
				{
					"id": 20050221,
					"content": "Откупились какими-то долговыми расписками... Получается, что мы заработали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050222
					],
					"speakerTitle": "Го"
				},
				{
					"id": 20050222,
					"content": "Завали! Пошли скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тадао"
				},
				{
					"id": 20050205,
					"content": "Говорят, вы ограбили дом Куросавы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				}
			]
		},
		{
			"id": 200503,
			"completionStepIds": [
				200504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200504",
							"2"
						],
						"stepId": 200504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аои"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050301,
					"content": "Добро пожаловать в магазин «Цукумомоно», у нас есть всё. Что-то хотите купить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050302
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050302,
					"content": "Или... хотите о чём-то спросить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050303
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050303,
					"content": "Эти расписки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050304
					]
				},
				{
					"id": 20050304,
					"content": "А, так вы друзья Куросавы, да? Ха-ха. Хотите вернуть его долги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050305
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050305,
					"content": "Ой-ой, давайте не будем торопиться... Мы просто хотим узнать, что произошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050306,
					"content": "Откуда у Куросавы такие долги? Он здесь что-то очень дорогое купил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050307,
					"content": "Дай подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050308
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050308,
					"content": "Куросава регулярно покупал здесь большое количество продовольствия и всегда платил из собственной зарплаты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050309
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050309,
					"content": "Но последнее время цены на продовольствие взлетели, и его зарплаты перестало хватать. Поэтому он начал брать в долг, чтобы покрыть часть до нормального количества.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050310
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050310,
					"content": "Так вот откуда эти рационы брались...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050311,
					"content": "Но почему Куросаве надо было покупать «нормальное» количество? Почему бы не купить поменьше, раз цены поднялись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050312,
					"content": "Подумайте, ведь люди, которые получают эти рационы, каждый раз думают, на сколько им его хватит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050313
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050313,
					"content": "Они внимательно рассчитывали, постоянно перепроверяли, и вдруг получат меньше, чем планировали... Куросава думал, что это сильно бы по ним ударило.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050314
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050314,
					"content": "Поэтому он предпочёл влезть в долги, лишь бы не расстраивать их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050315
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050315,
					"content": "Так Куросава сам покупал все эти рационы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050316,
					"content": "И никто его не поблагодарил... Они только винили его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050317,
					"content": "Отношение людей всегда зависит от их обстоятельств. Мало кто задумывается в сложной ситуации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050318
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050318,
					"content": "Мне кажется, что если бы Куросава сказал всем правду о рационах с самого начала, то сейчас у него было бы меньше проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050319
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050319,
					"content": "Но разве что немного поменьше. То, что он делал, поистине неблагодарный труд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050320
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050320,
					"content": "А почему он решил покупать рационы на собственные деньги и никому не говорить... Этого я и сама не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050321
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050321,
					"content": "Если тебе интересно, то почему бы не спросить его самого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050322
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050322,
					"content": "Он не помнит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050323
					]
				},
				{
					"id": 20050323,
					"content": "А... Кстати, у него только что Глаз Бога отобрали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050324
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050324,
					"content": "Очень жалко... Если он не сможет отдать долги, то придётся Куросаве продать свой меч, который ему так дорог.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050325
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050325,
					"content": "Меч? Что за меч?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050326,
					"content": "Он вам не говорил? У Куросавы есть очень ценный меч... Много лет уже его носит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050327
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050327,
					"content": "Я спрашивала, откуда он взялся. Куросава сказал, что ему отец подарил... Ни за какие деньги не продаст.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050328
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050328,
					"content": "Мне теперь даже немного жалко, что я не предложила ему продать меч... Мне кажется, что у всего есть своя цена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050329
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050329,
					"content": "Спросите у Куросавы про меч. Может быть, так вы и получите ответы, которые ищете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050330
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050330,
					"content": "Но сначала будьте любезны заплатить за счёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050331
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050331,
					"content": "А? Но мы же ничего не покупали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050332
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050332,
					"content": "Хе-хе, информация тоже товар, так ведь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050333
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050333,
					"content": "Но не волнуйтесь, информация о Куросаве недорого стоит. Он никогда и не просил держать что-то в тайне. Так... две тысячи моры будет достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050334
					],
					"speakerTitle": "Аои"
				},
				{
					"id": 20050334,
					"content": "Ладно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050335
					]
				},
				{
					"id": 20050335,
					"content": "Зато мы узнали, откуда брались эти рационы и что у Куросавы есть бесценный меч...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050336
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050336,
					"content": "Пойдём с ним ещё раз поговорим, вдруг он что-нибудь вспомнит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
