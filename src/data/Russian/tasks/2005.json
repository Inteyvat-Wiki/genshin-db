			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Омори",
					"Юуя",
					"Куросава Коносукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050101,
					"content": "Говорят, комиссия Тэнрё подчиняется напрямую сёгуну. Они отвечают за поддержание закона и порядка в Инадзуме. Именно они занимаются Охотой на Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050102,
					"content": "Но почему они принялись за своего же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050103,
					"content": "Паймон не понимает... А? Кажется, там какая-то стычка, пойдём посмотрим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050104,
					"content": "Я спрашиваю ещё раз... Так и не выдашь рацион на этот месяц?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050105
					],
					"speakerTitle": "Омори"
				},
				{
					"id": 20050105,
					"content": "Весь наш клан рассчитывает на эту еду! Мы требуем объяснений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050106
					],
					"speakerTitle": "Юуя"
				},
				{
					"id": 20050106,
					"content": "Сколько раз вам говорить... Не знаю я ничего ни про какие рационы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050107
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050107,
					"content": "А ты всё врёшь! От этого продовольствия наша жизнь зависит, понимаешь? Оно не для того, чтобы вы, самураи, карманы себе набивали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050108
					],
					"speakerTitle": "Омори"
				},
				{
					"id": 20050108,
					"content": "Раз вы самураи, то вам всё можно, что ли?! Я всё расскажу комиссии Тэнрё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050109
					],
					"speakerTitle": "Юуя"
				},
				{
					"id": 20050109,
					"content": "Что за рацион... это как консерва?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050110
					]
				},
				{
					"id": 20050110,
					"content": "А? А ты кто? Вместе с Куросавой, наверное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050111
					],
					"speakerTitle": "Омори"
				},
				{
					"id": 20050111,
					"content": "Что? Мы просто мимо проходили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050112,
					"content": "Услышали вашу ссору и подошли посмотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050113,
					"content": "Вот оно что. Может быть, вы как раз и поможете нам разрешить эту ситуацию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050114
					],
					"speakerTitle": "Омори"
				},
				{
					"id": 20050114,
					"content": "Это Куросава, он самурай и член армии сёгуна. Они распределяют рационы зерна в этой местности, а он за это отвечает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050115
					],
					"speakerTitle": "Омори"
				},
				{
					"id": 20050115,
					"content": "Раньше мы просто к нему обращались и нам всё выдавали. А теперь он отказывается давать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050116
					],
					"speakerTitle": "Омори"
				},
				{
					"id": 20050116,
					"content": "Да он их себе оставляет, точно говорю! А мы с голоду помрём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050117
					],
					"speakerTitle": "Омори"
				},
				{
					"id": 20050117,
					"content": "Никому до нас дела нет... Раньше мы думали, что Куросава - добрый человек, а теперь увидели его истинное лицо - он такой же, как и остальные самураи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050118
					],
					"speakerTitle": "Юуя"
				},
				{
					"id": 20050118,
					"content": "Неудивительно, что у него даже Глаз Бога отобрали. Сёгун Райдэн не хочет, чтобы такие люди, как он, помогали ей управлять страной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050119
					],
					"speakerTitle": "Юуя"
				},
				{
					"id": 20050119,
					"content": "Так это ему Аяка просила помочь. Но зачем ей помогать такому человеку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050120,
					"content": "Давай всё-таки спросим Куросаву и посмотрим, что он скажет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 200502,
			"completionStepIds": [
				200503
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200503",
							"2"
						],
						"stepId": 200503,
						"stateName": "QUEST_STATE_UNFINISHED"
