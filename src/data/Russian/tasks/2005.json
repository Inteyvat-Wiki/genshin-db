				"points": []
			},
			"dialogs": [
				{
					"id": 20050401,
					"content": "А чего это ты тут один? Куда те двое делись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050402,
					"content": "Я дал им выбор: либо они уйдут, либо я достаю меч. Они ушли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050403
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050403,
					"content": "Оказалось намного проще, чем пытаться их уговорить. Пожалуй, стоит пользоваться этим почаще...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050404
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050404,
					"content": "Вы нашли Похитителей сокровищ? Я вас не обманул, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050405
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050405,
					"content": "На самом деле...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050406
					]
				},
				{
					"id": 20050406,
					"content": "Примерно так всё было. Оказывается, ты действительно распределял рационы, но куплены они были на твои собственные деньги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050407,
					"content": "Странно... Я действительно был таким человеком?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050408
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050408,
					"content": "Я этого совсем не помню. Даже после вашего рассказа не могу вспомнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050409
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050409,
					"content": "Зачем я покупал для всех продовольствие? Почему загнал себя в такую передрягу?.. Не понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050410
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050410,
					"content": "Но действительно, когда я обнажил свой меч, чтобы прогнать этих двух, я почувствовал, будто само моё тело сопротивлялось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050411,
						20050412
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050411,
					"content": "Этот меч...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				},
				{
					"id": 20050413,
					"content": "Он раньше принадлежал моему отцу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050414
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050414,
					"content": "Помню, когда я был маленьким, однажды я стащил его, чтобы похвастаться перед соседскими детьми. Отец поймал меня и крепко наказал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050415
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050415,
					"content": "Он сказал мне... Хм... Не помню, что он сказал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050416
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050416,
					"content": "Похоже, я забыл много важного, когда у меня забрали Глаз Бога. Сколько ни пытаюсь вспомнить, в моей памяти зияет огромная пропасть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050417
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050417,
					"content": "Помню только, как отец сказал мне, что в этом мече принципы всей его жизни. Перед своей смертью он сам вложил его мне в руки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050418
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050418,
					"content": "...и сказал: «С этим мечом ты должен...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050419
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050419,
					"content": "Ой... Если приглядеться, то на рукояти что-то написано.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050420,
					"content": "#{NICKNAME}, можешь прочитать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050421,
					"content": "«Доброта и долг».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050422
					]
				},
				{
					"id": 20050422,
					"content": "«Доброта и долг»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050423
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050423,
					"content": "Почему-то эти слова как будто всё объясняют...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050424
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050424,
					"content": "Без сожаления влезать в долги, чтобы подавать другим. Это было моим самым большим желанием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050425
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050425,
					"content": "Но какой толк от доброты и долга? Я покупал продовольствие для нуждающихся, и к чему это привело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050426
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050426,
					"content": "Комиссия Тэнрё отняла мой Глаз Бога и те самые люди, которым я помогал, отказываются меня понимать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050427
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050427,
					"content": "Но самое ироничное... мне почему-то было жалко их, когда я угрожал им мечом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050428
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050428,
					"content": "Я не смог стать хорошим человеком, но и не могу стать плохим... Что же мне теперь делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050429
					],
					"speakerTitle": "Куросава Коносукэ"
				},
				{
					"id": 20050429,
					"content": "Ещё один несчастный человек...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050430
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050430,
					"content": "Надо поговорить с Томой о долге Куросавы, когда у нас будет возможность. Комиссия Ясиро сможет, наверное, ему помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050431,
					"content": "Ни в коем случае нельзя, чтобы он продал свой меч...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050432,
						20050433
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050432,
					"content": "Потерять Глаз Бога...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050434,
					"content": "Да, оказывается, потерять свои мечты так страшно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050435
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050435,
					"content": "Хорошо, что у тебя нет Глаза Бога, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050436
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050436,
					"content": "Пойдём искать следующего несчастного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20050433,
					"content": "...довольно ужасно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050412,
					"content": "Можно взглянуть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				}
			]
		},
