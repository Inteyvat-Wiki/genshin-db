			"dialogs": [
				{
					"id": 705100401,
					"content": "Ох... в последние дни в таверне от посетителей нет отбоя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100402
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705100402,
					"content": "Кто-то приходит за напитками, но большинство всё же именно к тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100403
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705100403,
					"content": "Хм... До сих пор как-то не верится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705100404,
					"content": "Ещё никогда курс «Стань барменом за неделю» не имел такого успеха. Мы заработали и деньги, и репутацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100405
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705100405,
					"content": "Отличная работа, коллеги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100406
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705100406,
					"content": "Пара дней - и мы уже коллеги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100407,
						705100408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705100407,
					"content": "В каком-то смысле...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				},
				{
					"id": 705100409,
					"content": "Я имел в виду, не могли бы вы подумать о том, чтобы остаться и работать здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100410
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705100410,
					"content": "#Не получится. Хоть тут и можно пить вволю, но Паймон пообещала и дальше путешествовать с {M#ним}{F#ней}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705100411,
					"content": "Ну, не буду настаивать. Вообще-то, Чарльз говорил об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100412
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705100412,
					"content": "В любом случае двери «Доли ангелов» всегда открыты для вас. И приводите своих друзей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100413
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705100413,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100414
					]
				},
				{
					"id": 705100414,
					"content": "До свидания. Счастливого пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лука"
				},
				{
					"id": 705100408,
					"content": "Он в чём-то прав...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				}
			]
		}
	]
