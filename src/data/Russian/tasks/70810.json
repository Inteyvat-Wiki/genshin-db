				"points": []
			},
			"dialogs": [
				{
					"id": 708101101,
					"content": "Итак, для основы понадобится яблочный напиток, а вкус сделает сочетание одуванчика, мяты и ягод. Подавать только охлаждённым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101102
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 708101102,
					"content": "С каждым глотком этого освежающего напитка по рту и горлу разнесётся прохлада мондштадтского ветерка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101103
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 708101103,
					"content": "Я налью его в бутылку и закупорю, чтобы не пропал вкус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101104
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 708101104,
					"content": "Не забудь только: перед подачей его нужно охладить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чарльз"
				}
			]
		},
