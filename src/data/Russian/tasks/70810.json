			"dialogs": [
				{
					"id": 708101811,
					"content": "Нет. Это все, что были.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101812
					]
				},
				{
					"id": 708101812,
					"content": "Вот и ладненько. Давай на этом и остановимся, а то мы с тобой потом неприятностей не оберёмся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101813
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708101813,
					"content": "Если это всё, давай прощаться. Вдруг для меня появится какое-нибудь срочное дело...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101814
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708101814,
					"content": "Эх, когда же меня отправят домой?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				}
			]
		},
