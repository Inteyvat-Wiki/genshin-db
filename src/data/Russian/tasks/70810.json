			"dialogs": [
				{
					"id": 708101701,
					"content": "(Отдать особый напиток)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101702
					]
				},
				{
					"id": 708101702,
					"content": "Выглядит неплохо... Дай-ка мне его попробовать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101703
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708101703,
					"content": "Его сначала нужно охладить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101704
					]
				},
				{
					"id": 708101704,
					"content": "Да? Ну тогда я открою его уже дома. У нас лёд найти будет нетрудно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101705
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708101705,
					"content": "Я тебе вот что скажу. Мы, Фатуи, своё слово держим. Имея с нами дело, ты в убытке не останешься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101706
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708101706,
					"content": "Ну, задавай свои вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101707
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708101707,
					"content": "Расскажи мне про других Предвестников.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101708
					]
				},
				{
					"id": 708101708,
					"content": "Предвестники... Такому маленькому человеку, как я, приходится довольствоваться случайными слухами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101709
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708101709,
					"content": "Не воспринимай всерьёз то, что я тебе сейчас расскажу. За что купил, за то и продаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101710
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708101710,
					"content": "Говорят, что номер шесть из Предвестников, Скарамучча, крайне неуживчив. Он много кому не нравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101711
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708101711,
					"content": "Почему так? Одни упоминают его дурной характер, другие - беспокойный язык и неуместные фразы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101712
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708101712,
					"content": "Мои знакомые, которые тесно работают с Предвестниками, говорят, что даже те Скарамуччу на дух не переносят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101713
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708101713,
					"content": "Но что ни говори, он всё-таки Предвестник, и мне до него далеко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				}
			]
		},
