			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сара"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100201,
					"content": "Насчёт Мондштадтских диковинок...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100202
					]
				},
				{
					"id": 708100202,
					"content": "Мондштадтских деликатесов? Можно сказать, что каждое из наших блюд характерно для Мондштадта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100203
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 708100203,
					"content": "Но большая их часть долго храниться не может, и брать их с собой в дорогу неудобно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100204
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 708100204,
					"content": "Мы, конечно, можем их сделать удобными для переноски и хранения, но тогда вкус будет совсем не тот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100205
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 708100205,
					"content": "Ничего страшного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100206
					]
				},
				{
					"id": 708100206,
					"content": "Ладно, раз уж ты так настаиваешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100207
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 708100207,
					"content": "Только вот деликатесы на прилавках уже немного полежали. Если ты собираешься их дарить, лучше будет приготовить свежее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100208
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 708100208,
					"content": "А откуда твой друг родом? Может, я смогу что-нибудь порекомендовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100209,
						708100211
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 708100209,
					"content": "Из Снежной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100210
					]
				},
				{
					"id": 708100210,
					"content": "Снежной, значит? Как же это от нас далеко... Нужно хорошенько подумать, что приготовить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 708100213,
					"content": "Хм, не знаю, что едят в Снежной, но у меня есть одно блюдо, которое нравится всем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100214
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 708100214,
					"content": "Пожалуйста, сделай для меня Питательный салат, а я подготовлю его к долгому пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100215
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 708100215,
					"content": "Давно я этим не занималась. Пойду поищу инструменты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сара"
				},
				{
					"id": 708100211,
					"content": "Он - Фатуи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100212
					]
				},
				{
					"id": 708100212,
					"content": "Фа... Фатуи? Это те, которые из Снежной?.. Широкий у тебя круг общения, мягко говоря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "Сара"
				}
			]
		},
