			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Виктор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100121,
					"content": "Хочешь ещё что-то спросить? Спрашивай, не стесняйся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100122,
						708100127
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708100122,
					"content": "Почему ты выбрал меня?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100123
					]
				},
				{
					"id": 708100123,
					"content": "Хе-хе... Наконец-то нормальный вопрос. Мне кажется, что в Мондштадте скоро начнут вешать Фатуи на столбах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100124
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708100124,
					"content": "Сёстры уже косо на меня смотрят. Ещё чуть-чуть и люди начнут хвататься за вилы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100125
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708100125,
					"content": "#Кому же, если не тебе, путешественн{F#ица}{M#ик}, я могу доверять в таком месте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100126
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708100126,
					"content": "Я не понимаю, чем я заслужил такое отношение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708100127,
					"content": "Сколько Фатуи сейчас находится в городе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100128
					]
				},
				{
					"id": 708100128,
					"content": "Не могу назвать точное число. Однако делегация, которая остановилась в отеле «Гёте», уже давно не выходит на улицу. Понятия не имею, что с ними произошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100129
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 708100129,
					"content": "Наверное, начальство опять что-то замышляет... Скорее всего, меня это никак не коснётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				}
			]
		},
		{
			"id": 7081003,
			"completionStepIds": [
				7081002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
