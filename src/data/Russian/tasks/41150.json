			"dialogs": [
				{
					"id": 411500301,
					"content": "#Я слышал{F#а}, что есть особый заказ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411500302
					]
				},
				{
					"id": 411500302,
					"content": "Тут такое дело. Эта бестолковая Лин Гуань заказала налетайку и сказала, что скоро придёт, но, похоже, она опять куда-то умотала и заблудилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500303
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 411500303,
					"content": "#Доставь ей еду, ладно? <color=#00E1FFFF>Иди спокойно только, а не носись как {M#угорелый}{F#угорелая}</color>, а то расплескаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500304
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 411500304,
					"content": "<color=#00E1FFFF>И не трогай всякие элементальные штуки, а то вкус испортится</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500305
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 411500305,
					"content": "Если блюдо всё-таки испортится, то возвращайся ко мне - я ещё приготовлю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
			]
		},
