							4587.584
						],
						"pointId": 340300485
					}
				]
			},
			"dialogs": [
				{
					"id": 746870101,
					"content": "Дело затягивается. Мы уже полдня сражаемся, а монстров всё так же много...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870102
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870102,
					"content": "Может, мне стоит позвать подкрепление?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870103
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870103,
					"content": "Не волнуйся, доверься моей пушке и агенту в штатском!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870104
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 746870104,
					"content": "#Кроме того, у нас есть {M#искатель}{F#искательница} приключений с острым чутьём на опасности, как у настоящего офицера... {M#Он}{F#Она} обязательно придёт на подмогу, если мы окажемся в беде...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870105,
						746870106
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 746870105,
					"content": "Какая ещё опасность?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				},
				{
					"id": 746870107,
					"content": "О! Вот и мегабосс с маленькой помощницей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870108
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870108,
					"content": "Прошу прощения, позвольте мне ввести вас в курс дела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870109
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 746870109,
					"content": "Хе-хе, отдохни немного, я всё объясню!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870110
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870110,
					"content": "Хочешь пострелять из тяжёлой пушки? После разгрома флота такие шансы выпадают крайне редко! Ты можешь почувствовать себя воином из прошлого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870111
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870111,
					"content": "Специальные снаряды, которые разносят монстров пачками. Отличное развлечение, не правда ли? И плюс ко всему, можно получить бонус от жандармов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870112
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870112,
					"content": "Обстреливать монстров из пушки... Это мы можем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870113,
						746870114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746870113,
					"content": "Кажется, ничего сложного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870115,
					"content": "Я понимаю твою радость, но сейчас стоит отнестись к делу серьёзнее. Позволь мне всё объяснить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870116
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870116,
					"content": "Недавно рабочие случайно раскопали в окрестностях древние руины, тем самым разбудив монстров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870117
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870117,
					"content": "Чтобы помешать монстрам вырваться наружу, жандармы организовали оборону.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870118
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870118,
					"content": "Но на данный момент оборона состоит из нас двоих и агента-мелюзины, которая сейчас в отпуске, а ещё с нами наша усовершенствованная пушка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870119
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870119,
					"content": "Ого! Звучит как-то опасно! С агентом-мелюзиной всё в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746870120,
					"content": "Не волнуйтесь, агент-мелюзина может управлять тяжёлой пушкой у выхода из руин дистанционно: не вступая в бой лично, она сдерживает большую часть монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870121
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 746870121,
					"content": "На неё действительно можно положиться, но постоянная работа в условиях высокого напряжения, безусловно, может утомить даже её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870122
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870122,
					"content": "Мегабосс, поможешь? Если ситуация ухудшится, я обязательно запрошу подкрепление.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870123
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870123,
					"content": "#Шене, ты прекрасно знаешь, на что {F#способна}{M#способен} мегабосс! {M#Он}{F#Она} воспользуется моей пушкой и уничтожит всех монстров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870124,
						746870125
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 746870124,
					"content": "Не буду отрицать, мне действительно любопытно испытать пушку...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870126,
					"content": "Мы не можем остаться в стороне, когда кто-то попал в беду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746870127,
					"content": "Супер! Спасибо за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870128
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 746870128,
					"content": "После прошлого испытания я переделал своё изобретение. Надеюсь, пушка вам понравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870129
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 746870129,
					"content": "Эх, было бы здорово, если бы тяжёлая пушка могла сама наводиться и стрелять! Верно, Фрежюс?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870130
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870130,
					"content": "Точно! В следующий раз я попробую добавить на пушку модуль идентификации целей от жандарматона, чтобы она могла работать самостоятельно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870131
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 746870131,
					"content": "Вот это мысль! Просто гениально!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шене"
				},
				{
					"id": 746870125,
					"content": "Какая бы ни была ситуация, я хочу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870114,
					"content": "Но почему нужно отстреливать монстров?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870106,
					"content": "Мы как раз вовремя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				}
			]
		},
		{
			"id": 7468703,
