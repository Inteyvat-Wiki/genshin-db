						],
						"pointId": 340300480
					}
				]
			},
			"dialogs": [
				{
					"id": 746870301,
					"content": "Так, а вот и смена!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870302
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 746870302,
					"content": "А? Что вы тут делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870303,
						746870307
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 746870303,
					"content": "А что не так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870304
					]
				},
				{
					"id": 746870304,
					"content": "Мы раньше встречались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746870305,
					"content": "#Нет, всё в порядке! Отлично, отлично. Вы прославленные {F#воительницы}{M#воины}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870306
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 746870306,
					"content": "Во время службы в подразделении, да и потом, когда я вернулась в деревню, все говорили, что любые дела можно без сомнений доверить вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 746870311,
					"content": "Мои коллеги тоже надёжные, но всё же между ними порой возникает какая-то непонятная... неловкость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870312
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 746870312,
					"content": "Человеческие эмоции - сложная штука. Может, стоит помочь им?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870313
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 746870313,
					"content": "Неловкость?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870314
					]
				},
				{
					"id": 746870314,
					"content": "Ладно, вернёмся к делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870315
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 746870315,
					"content": "Я в вас верю! Управлять этой пушкой совсем не сложно. Надеюсь, вы быстро и эффективно уничтожите все цели!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марин"
				},
				{
					"id": 746870307,
					"content": "Мы, кажется, уже встречались?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870308
					]
				},
				{
					"id": 746870308,
					"content": "О, вы меня помните? Недавно, когда «Страна кинофантазий Шевальмарин» искала сотрудников, я отправила вам своё резюме!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870309
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 746870309,
					"content": "Да, Паймон припоминает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746870310,
					"content": "Я знаю, что вы сильны. И могу смело поручить вам любую работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "Марин"
				}
			]
		}
	]
}