						10151305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10151305,
					"content": "От... Откуда этот голос?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10151306,
					"content": "Мне кажется, он доносится из-за стойки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151307
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10151307,
					"content": "#Тогда... {NICKNAME}, проверь за стойкой, а я тебя прикрою, м?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
