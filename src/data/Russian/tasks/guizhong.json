					"nextDialogs": [
						10151302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10151302,
					"content": "Есть тут кто-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10151303,
					"content": "Добро пожаловать!",
