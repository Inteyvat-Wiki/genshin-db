				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150301,
					"content": "Такая огромная... Подобное могли сотворить только Адепты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150302,
					"content": "Но как этой штукой пользоваться? Кажется, что для этого понадобится немереная сила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150303,
					"content": "Мы не сможем воспользоваться. Она повреждена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150304
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150304,
					"content": "Откуда вы знаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150305,
					"content": "Её установили здесь Адепты тысячи лет назад, и никто за ней не ухаживал. Видно, что эта баллиста знавала лучшие дни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150306
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150306,
					"content": "И что же нам теперь делать? Мне кажется, господин Чжун Ли, это прекрасная возможность блеснуть вашим безграничным кругозором!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150307,
					"content": "Вы правда считаете, что я не лучше этой «золотой молодёжи», которая может только посещать театр, да слушать пение птиц? Как досадно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150308
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150308,
					"content": "Давайте проверим вокруг. Наверняка здесь где-то хранятся материалы для обслуживания баллисты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150309
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150309,
					"content": "Если не ошибаюсь, мы сможем найти военный склад где-то среди руин этого перевала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150310
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150310,
					"content": "Материалы с военного склада помогут нам понять принцип работы баллисты, и тогда её починка не составит особого труда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150311
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150311,
					"content": "Господин Чжун Ли, а вы знаете... принцип работы этой штуки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150312,
					"content": "Ну так... Можно сказать, слегка разбираюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150313
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150313,
					"content": "Можно попробовать починить её, но придётся собрать <color=#00E1FFFF>некоторые материалы</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				}
			]
		},
		{
			"id": 101506,
			"completionStepIds": [
				101515
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101506",
							"2"
						],
						"stepId": 101506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150601,
					"content": "Да, эти материалы подойдут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150602
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150602,
					"content": "Подождите здесь, я попробую разобраться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150603
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150603,
					"content": "Сделано. А устройство баллисты оказалось сложнее, чем я предполагал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150604
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150604,
					"content": "Ого, как круто! И как нам теперь из неё стрелять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150605,
					"content": "Это очень просто. Взгляните... Конструкция Адептов включает в себя прицел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150617
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150617,
					"content": "Хм... Здесь нет... Там тоже нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150606,
					"content": "Эй, вы! Чего вы там шныряете, а?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150607
					],
					"speakerTitle": "Веснушчатый Хуан"
				},
				{
					"id": 10150607,
					"content": "Это вы починили эту катапульту? Для чего она вам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150608
					],
					"speakerTitle": "Веснушчатый Хуан"
				},
				{
					"id": 10150608,
					"content": "Это не просто катапульта, а баллиста Гуй Чжун. А вас я попрошу представиться. Это простейшие правила приличия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150609
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150609,
					"content": "А ты ещё не понял, кто мы такие? Мы Похитители сокровищ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150610
					],
					"speakerTitle": "Веснушчатый Хуан"
				},
				{
					"id": 10150610,
					"content": "Ходят слухи, что в этих руинах хранятся сокровища, но мы никак не можем обойти эту вашу катапульту. Она хуже Стража руин!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150611
					],
					"speakerTitle": "Веснушчатый Хуан"
				},
				{
					"id": 10150611,
					"content": "Когда мы в прошлый раз поднялись на гору, она выстрелила, и мои ребята чуть не превратились в шашлыки на палочке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150612
					],
					"speakerTitle": "Веснушчатый Хуан"
				},
				{
					"id": 10150612,
					"content": "Тогда нам всё-таки удалось сломать эту штуковину, но теперь вы пришли и снова её включили! Какого демона?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150613
					],
					"speakerTitle": "Веснушчатый Хуан"
				},
				{
					"id": 10150613,
					"content": "Вам придётся заплатить за это своими головами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150614
					],
					"speakerTitle": "Веснушчатый Хуан"
				},
				{
					"id": 10150614,
					"content": "Хм... Вы хотите запятнать кровью мудрость Адептов ради собственной наживы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150615
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150615,
					"content": "Думаю, пришло время научить вас манерам, господа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150616
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150616,
					"content": "#Правильно! {NICKNAME}, задай им!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 101507,
			"completionStepIds": [
				101507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101507",
							"2"
						],
						"stepId": 101507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ци Ци"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150701,
					"content": "Прости, Ци Ци, но мы не смогли выполнить нашу часть контракта. Нам не удалось найти священное животное, которое ты называешь «кокосовой козой».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150702
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150702,
					"content": "Ах... Какая досада... Но ничего страшного... Просто досадно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150703
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150703,
					"content": "Ну вот, теперь я чувствую себя ужасно виноватой перед Ци Ци.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150704,
						10150705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150704,
					"content": "Ци Ци, ты знаешь ещё что-нибудь про эту козу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				},
				{
					"id": 10150706,
					"content": "Её молоко... вкусное... Вкуснее обычного... козьего... Потому что священное... животное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150707
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150707,
					"content": "Простите... У меня плохая... память... Я где-то записала... как называется это... молоко... Сейчас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150708
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150708,
					"content": "Вот оно... Точно... Вкусное молоко... «Кокосовое молоко»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150709
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150709,
					"content": "Что???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150710,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150711
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150711,
					"content": "Простите, это моя вина... Я должен был догадаться, прежде чем тащить вас в горы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150712
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150712,
					"content": "Не берите на себя вину, господин Чжун Ли. Любой из нас мог догадаться, но не догадался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150713
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150713,
					"content": "Ци Ци сказала... что-то... не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150714
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150714,
					"content": "#Прости, {NICKNAME}, но я не хочу ломать психику этому бедному ребёнку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150715,
						10150716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150715,
					"content": "Кокосовое молоко получают не от кокосовой козы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150717,
					"content": "А...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150718
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150718,
					"content": "Похоже, она задумалась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150719,
						10150720
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150719,
					"content": "Оставим её подумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150721,
					"content": "Ха-ха-ха, это был хороший урок для моей девочки! Спасибо, что присмотрела за лавкой, Ци Ци.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150722
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 10150722,
					"content": "А вы кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150723
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150723,
					"content": "Прошу прощения за свои манеры. Меня зовут Бай Чжу, я владелец хижины «Бубу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150724
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 10150724,
					"content": "А мы думали, что Ци Ци здесь главная... Мы подумали, раз она носит все эти травы на шее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150725
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150725,
					"content": "Ци Ци - очень наивный ребёнок, но, к сожалению, клиенты бывают ещё наивнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150726
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 10150726,
					"content": "ААА!!! Эта змея!!! Она что-то с-с-сказала!!! Только что!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150727,
						10150728
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150727,
					"content": "Говорящая змея!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150729,
					"content": "Честно говоря, я не хотела разговаривать с вами. Старые клиенты уже привыкли к моему облику, а новые всё ещё удивляются... и пугаются. Но если я буду и дальше хранить молчание, вы примете меня за какое-нибудь лекарство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150730
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 10150730,
					"content": "Ха-ха-ха... Это Чан Шэн, она очень добрая. А теперь скажите, чем я могу вам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150731
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 10150731,
					"content": "Подскажите, пожалуйста, есть ли у вас в наличии Вечный ладан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150732
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150732,
					"content": "Вечный ладан... Да. Конечно, есть. Конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150733
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 10150733,
					"content": "Ух, отлично! Всё-таки не зря мы потратили целый день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150734
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150734,
					"content": "Три миллиона моры. Высшее качество, обещаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150735,
						10150737
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 10150735,
					"content": "Три миллиона???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150736
					]
				},
				{
					"id": 10150736,
					"content": "А ключи от Золотой палаты вы не хотите?! ...Хотя там сейчас всё занято группировкой Цисин, поэтому и охрана будет внимательнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150739,
					"content": "Три миллиона... Хм... Обычное число, как и любое другое, но с практической точки зрения такую сумму и впрямь нелегко собрать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150740
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150740,
					"content": "Так много моры! Мы никогда не сможем столько заплатить! А вы, господин Чжун Ли, лучше ничего не говорите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150741
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150741,
					"content": "Я только соглашусь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150742
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150742,
					"content": "У вас правда нет совести...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150743
					]
				},
				{
					"id": 10150743,
					"content": "Что же нам делать? Неужели снова придётся обращаться к Чайльду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150744
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150744,
					"content": "Ха-ха-ха-ха-ха-ха-ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150745
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10150745,
					"content": "Кокосовая коза... Кокосовая коза! Неужели вы правда купились на такой детский розыгрыш?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150746
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10150746,
					"content": "Эй, хватит злорадствовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150747
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150747,
					"content": "Ах... Я не могу остановиться. Рассмешили до слёз... Давайте я заплачу за вас. Расценивайте это как знак благодарности за то, что вам удалось так меня рассмешить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150748
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10150748,
					"content": "А вы... врач Бай Чжу, я прав? Меня зовут Чайльд, я один из Предвестников Фатуи. Если вы не возражаете, я бы хотел продолжить наше сотрудничество.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150749
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10150749,
					"content": "Если вы всё-таки нуждаетесь в этом, мы могли бы оформить поставки кокосового молока до хижины «Бубу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150750
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10150750,
					"content": "В самом деле? Я наслышана о том, что Фатуи любят «заводить друзей», но вы правда рассчитываете, что я соглашусь на кокосовое молоко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150751
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 10150751,
					"content": "Кокосовое молоко... Кокосовое молоко... Господин Бай... Кокосовое молоко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150752
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150752,
					"content": "Хорошо, хорошо, хорошо... Я полагаю, мне нужно поблагодарить вас, господин Чайльд. Искренне надеюсь, что наше дальнейшее сотрудничество будет плодотворным. И вы заслужили скидку. Теперь вы можете купить Вечный ладан всего лишь за 2 990 000 моры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150753
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 10150753,
					"content": "Хэй! Это же почти то же самое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150754
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150754,
					"content": "Хм... 2 990 000... Тоже обычное число, как и любое другое, к тому же действительно меньше, чем три миллиона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150755
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150755,
					"content": "Решено. С этим делом мы закончили. Если у вас нет никаких других дел, то я буду ожидать вас на террасе Юйцзин. Господин Чайльд, господин Бай Чжу, малышка Ци Ци... Всем удачи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150756
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150756,
					"content": "Ну и ну... Ну и люди... Давно я так не смеялся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150757
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10150757,
					"content": "Надеюсь, ты подслушала что-нибудь полезное. О чём они говорили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150758
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10150758,
					"content": "Да, господин Чайльд. Они говорили, что Цисин заняли Золотую палату...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150759
					],
					"speakerTitle": "Екатерина"
				},
				{
					"id": 10150759,
					"content": "Так, так, так. Нин Гуан и её прислужники Цисин. Что же вы прячете в Золотой палате... если не экзувию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150760
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10150760,
					"content": "#Прости, {NICKNAME}, но я же тебя предупреждал, что у стен в Ли Юэ есть уши.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10150737,
					"content": "А ключи от Золотой палаты вы не хотите?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150738
					]
				},
				{
					"id": 10150738,
					"content": "Хотя там сейчас всё занято Цисин, поэтому и охрана будет внимательнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150728,
					"content": "Ничего удивительного, это Ли Юэ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150720,
					"content": "Рано или поздно каждому приходится столкнуться с несправедливостью этого мира.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150716,
					"content": "Кокосовое молоко получают из кокосов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150705,
					"content": "Зачем тебе кокосовая коза, Ци Ци?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				}
			]
		},
		{
			"id": 101509,
			"completionStepIds": [
				101509
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101509",
							"2"
						],
						"stepId": 101509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ци Ци"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150901,
					"content": "Вот она где! Такая коротенькая, вот мы её и не увидели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150902,
						10150904
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150902,
					"content": "Она... Зомби?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150903
					]
				},
				{
					"id": 10150903,
					"content": "#Думаю, ты прав{F#а}. Посмотри на заговор у неё на лбу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150908,
					"content": "Добро пожаловать в хижину «Бубу», меня зовут Ци Ци.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150909
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150909,
					"content": "Не волнуйтесь... Ци Ци умерла однажды... Но Адепты спасли её... Поэтому она теперь... зомби.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150910,
						10150911
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150910,
					"content": "Рассказывает о своей смерти как о каком-то пустяке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150912,
					"content": "В Мондштадте нам бы никто не поверил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150913
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150913,
					"content": "Дитя моё... А можешь ли ты подсказать мне, есть ли у вас в наличии Вечный ладан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150914
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150914,
					"content": "А у вас... есть рецепт... от врача?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150915
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150915,
					"content": "А разве для покупки Вечного ладана нужен рецепт? Им не лечат болезни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150916
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150916,
					"content": "Я могу продать... продать лекарство... только по рецепту. ...Таков приказ, который... Ци Ци отдала Ци Ци.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150917,
						10150918
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150917,
					"content": "Приказ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150920
					]
				},
				{
					"id": 10150920,
					"content": "Чтобы привести труп в движение, ему нужен приказ. Этой девочке никто ничего не приказал, поэтому она отдала приказ сама себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150921
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150921,
					"content": "Малышка Ци Ци, у нас, к сожалению, нет рецепта от врача, но всё же мы надеемся на твою помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150922
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150922,
					"content": "Хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150923
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150923,
					"content": "Что? Почему она сейчас согласилась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150924
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150924,
					"content": "Но тогда вы... тоже должны помочь... Ци Ци. ...Так будет... честно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150925
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150925,
					"content": "Продавец должен помочь покупателю! Разве это недостаточно честно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150926
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150926,
					"content": "Нет, девочка говорит справедливо. Коммерческие отношения в Ли Юэ очень сложные и запутанные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150927
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150927,
					"content": "Я хочу, чтобы вы... поднялись на горы Тяньхэн... и убили кокосовую козу... с помощью баллисты Гуй Чжун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150928,
						10150930
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150928,
					"content": "Что убили? Чем? Зачем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150929
					]
				},
				{
					"id": 10150929,
					"content": "Баллиста Гуй Чжун... Думаю, я слышал о такой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150932,
					"content": "Баллиста Гуй Чжун - это древний механизм, который Адепты установили в горах Тяньхэн. Древнее и очень мощное орудие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150933
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150933,
					"content": "Она была построена для охраны перевала Тяньхэн и способна сразить самых ужасных чудовищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150934
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150934,
					"content": "Вы правда знаете всё на свете, господин Чжун Ли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150935
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150935,
					"content": "Вовсе нет. К примеру, эта «кокосовая коза»... В первый раз о такой слышу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150936
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150936,
					"content": "Кокосовая коза... согласно легендам... священное животное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150937
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150937,
					"content": "Ещё что-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150938
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150938,
					"content": "Да... Кокосовая коза... согласно легендам... священное животное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150939
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150939,
					"content": "Как выглядит... Неизвестно... Где водится... Неизвестно... Откуда взялась... Неизвестно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150940,
						10150941
					],
					"speakerTitle": "Ци Ци"
				},
				{
					"id": 10150940,
					"content": "Всё понятно, она нам не поможет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150942,
					"content": "Давайте сходим к <color=#00E1FFFF>баллисте</color>. Может, там мы найдём что-нибудь интересное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150943
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150943,
					"content": "Кокосовая коза... Что это вообще за коза такая?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150941,
					"content": "Да уж, маловато информации...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150930,
					"content": "Она просто балуется...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150931
					]
				},
				{
					"id": 10150931,
					"content": "Я так не думаю. Баллиста Гуй Чжун... Звучит очень знакомо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150918,
					"content": "Чего она противится?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150919
					]
				},
				{
					"id": 10150919,
					"content": "Боюсь, что она права. Таков её приказ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150920
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10150911,
					"content": "У вас здесь это обычное дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150904,
					"content": "Уж не тебе обсуждать чужой рост, Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150905
					]
				},
				{
					"id": 10150905,
					"content": "Хэй, но я ведь умею летать! Поэтому совсем неважно, какой у меня рост.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150906
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150906,
					"content": "Но ты посмотри на неё... Она какая-то странная. Ещё и заговор на лбу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150907
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10150907,
					"content": "Подожди, она что... зомби???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 101511,
			"completionStepIds": [
				101512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
