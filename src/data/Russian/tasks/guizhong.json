			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжун Ли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10151101,
					"content": "Мы наняли работников и достали Вечный ладан. Приготовления к церемонии почти завершены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151102
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10151102,
					"content": "Ах... Ну наконец-то!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10151103,
					"content": "#А теперь, путешественни{M#к}{F#ца}, расскажи мне, какой опыт ты получил{F#а} по прошествии нашего сотрудничества?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151104
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10151104,
					"content": "Это оказалось очень-очень странное приключение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151105
					]
				},
				{
					"id": 10151105,
					"content": "Странное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151106,
						10151107
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10151106,
					"content": "Не могу определиться. Вроде мы увидели изнутри жизнь богачей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151108
					]
				},
				{
					"id": 10151108,
					"content": "Ха-ха-ха! Ну и каков же твой ответ в итоге? Во время приключений всегда возникают путаницы и сомнения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151109
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10151109,
					"content": "Я дам тебе немного времени на размышление. А я скажу тем временем, что в качестве оплаты за вашу помощь в приготовлении Церемонии Вознесения я решил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151110
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10151110,
					"content": "Пригласить вас на ужин. Я угощаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151111,
						10151112
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10151111,
					"content": "Вы? Угощаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151113
					]
				},
				{
					"id": 10151113,
					"content": "Только не волнуйся. На этот раз я не забуду захватить кошелёк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151114
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10151114,
					"content": "Сегодня я приглашаю вас посетить прославленные старинные погреба Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151115
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10151115,
					"content": "А в какой ресторан вы нас приглашаете? В такой, где подают вино?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10151116,
					"content": "Да. Увидимся в ресторане «Три чашки в порту».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10151112,
					"content": "Ничего себе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151113
					]
				},
				{
					"id": 10151107,
					"content": "...но в то же время жили жизнью бедняков.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151108
					]
				}
			]
		},
