			"dialogs": [
				{
					"id": 730280101,
					"content": "Кажется, здесь тоже есть большие части робота. Если они попадутся на глаза господину Джазари, он тотчас полезет за фотокамерой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730280102,
					"content": "Арарикан говорит, что это он притащил части в убежище. Неужели это так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730280103,
					"content": "Конечно, это правда. Арарикан не обманывает нар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280104,
						730280105
					],
					"speakerTitle": "Арарикан"
				},
				{
					"id": 730280104,
					"content": "Как и ожидалось...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				},
				{
					"id": 730280106,
					"content": "Арарикан - тот самый аранара, который играл с детьми в тайном убежище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730280107,
					"content": "Но Арарикан ничего не помнит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280108,
						730280109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730280108,
					"content": "Возможно, это связано с сухим цветком в блокноте...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280110,
					"content": "Да, после того, как аранара из леса Мотийимы отдал нам цветок, он совершенно всё забыл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730280111,
					"content": "Возможно, трое из них пережили такое же приключение, что и мы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730280112,
					"content": "Арарикан не понимает, о чём вы говорите и ничего не помнит. Но с вами, нарами, очень весело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280113
					],
					"speakerTitle": "Арарикан"
				},
				{
					"id": 730280113,
					"content": "Да, Арарикан, весело должно быть всегда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730280109,
					"content": "Мы с таким уже сталкивались...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280105,
					"content": "Если мы не ошибаемся...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				}
			]
		},
