					"Фаргани"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250701,
					"content": "А? Вы уже установили все маячки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250702
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250702,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250703
					]
				},
				{
					"id": 230250703,
					"content": "Даже не знаю, как вас благодарить. Возьмите это в награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250704
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250704,
					"content": "Теперь нужно лишь дождаться, пока они соберут данные и подтвердят мой вывод!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250705
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250705,
					"content": "Но как же мне подняться и забрать маячки?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фаргани"
				}
			]
		},
		{
