			},
			"dialogs": [
				{
					"id": 230251001,
					"content": "Что? Монстры? Быть такого не может. Параметры показывают...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251002
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230251002,
					"content": "Могут ли маячки сами быть переменными? Что если их вибрация и звук привлекают монстров?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251003
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230251003,
					"content": "Могут ли они повлиять на данные? Ах, извините, я снова говорю сам с собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251004
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230251004,
					"content": "Я не хотел доставить вам лишних хлопот... Вот ваша оплата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251005
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230251005,
					"content": "В следующий раз следует быть более осторожным при измерении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фаргани"
				}
			]
