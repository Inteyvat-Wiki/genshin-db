				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250401,
					"content": "Хм... Так вот оно что. Надо ввести переменную, и я смогу объяснить ошибку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250402
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250402,
					"content": "Но меняет ли это остальную часть вывода?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250403
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250403,
					"content": "Получается?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250404
					]
				},
				{
					"id": 230250404,
					"content": "Извини, я забыл, что вы всё ещё здесь... Вот ваша оплата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250405
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250405,
					"content": "Что касается прогресса... Я разрешил некоторые вопросы, но появились новые. Что поделать - исследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250406
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250406,
					"content": "#Возможно, мне ещё понадобится ваша помощь, путешественни{F#ца}{M#к}, пока я не приду к окончательному выводу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фаргани"
				}
			]
		},
