					"Фаргани"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250801,
					"content": "#Ой, путешественни{F#ца}{M#к}, наконец-то вы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250802
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250802,
					"content": "Как проходит исследование?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250803
					]
				},
				{
					"id": 230250803,
					"content": "Благодаря вашим стараниям я преуспел за последние дни. Сейчас маячки собирают данные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250804
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250804,
					"content": "Мне лишь нужно получить данные и проверить новую догадку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250805,
						230250806
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250805,
					"content": "Так ты несколько дней просто гадал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				},
				{
					"id": 230250807,
					"content": "Кхе-кхе, ну я улучшил уравнение, откалибровал приборы. Как видите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250808
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250808,
					"content": "...я не могу подняться к маячкам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250809
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250809,
					"content": "Боюсь, мне придётся попросить вас их вернуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250810,
						230250812
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250810,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250811
					]
				},
				{
					"id": 230250811,
					"content": "#Пожалуйста, путешественни{F#ца}{M#к}. Я щедро вас отблагодарю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250812,
					"content": "В следующий раз сначала подумай, как их забрать обратно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250813
					]
				},
				{
					"id": 230250813,
					"content": "А как же! Добавил устройство сбора, расширил область применения... ну и всякое такое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250814
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250814,
					"content": "Но на это ушло больше бюджета, и я не уверен, не повлияет ли это на точность данных...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250815
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250815,
					"content": "#В общем, без вас, путешественни{F#ца}{M#к}, мне снова не обойтись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250806,
					"content": "Это сложно назвать «преуспел»!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				}
			]
		},
