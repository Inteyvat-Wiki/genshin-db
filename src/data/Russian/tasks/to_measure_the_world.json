			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Фаргани"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250201,
					"content": "Эй, мой дорогой друг, не уделите мне минутку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250202,
						230250203
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250202,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250208
					]
				},
				{
					"id": 230250208,
					"content": "Вы когда-нибудь задумывались о том, что будет, если небо упадёт на землю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250209,
						230250210
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250209,
					"content": "Мне кажется, ты слишком много переживаешь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250212,
					"content": "Может быть. Но почему небо не падает? Почему земля не проваливается? Без точных измерений мы никогда не получим ответа на эти вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250213
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250213,
					"content": "По правде говоря, у меня была идеальная модель для объяснения этих загадок. Мне просто нужно больше данных, чтобы подтвердить это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250214,
						230250215
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250214,
					"content": "Нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250223,
					"content": "Значит, вы мне поможете? Огромное вам спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250224
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250224,
					"content": "Я выбрал идеальное место для своего наблюдения, но здесь бродит столько монстров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250225
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250225,
					"content": "Пожалуйста, прогоните их, чтобы я мог наблюдать в безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250226,
						230250228
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250226,
					"content": "Ладно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250227
					]
				},
				{
					"id": 230250227,
					"content": "Спасибо. Пойдёмте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250228,
					"content": "А тебе зачем идти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250229
					]
				},
				{
					"id": 230250229,
					"content": "Мне нужно собрать некоторые данные, чтобы найти причину ошибки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250230
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250230,
					"content": "А если зарыться в гору бумаг, то ответа не найдёшь никогда. Ну, идёмте уже скорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250215,
					"content": "Удачи тебе. Увидимся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250216
					]
				},
				{
					"id": 230250216,
					"content": "Подождите, подождите! Прошу вас, подумайте над этим. Если мою работу опубликуют, это станет эпохальным событием!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250217
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250217,
					"content": "Вы станете моими помощниками в сотворении этой теории, и я даже напишу ваше имя в благодарностях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250218
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250218,
					"content": "Ух... Или даже вы можете стать моими соавторами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250219
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250219,
					"content": "К чему такая спешка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250220
					]
				},
				{
					"id": 230250220,
					"content": "Если я не смогу получить результаты, боюсь, у меня возникнут проблемы с финансированием моих исследований... гораздо более разрушительные, чем падение неба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250221,
						230250222
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250221,
					"content": "Ну если соавторами...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250222,
					"content": "А как насчёт гонорара?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250210,
					"content": "Небо не может упасть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250203,
					"content": "У меня нет времени.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250204
					]
				},
				{
					"id": 230250204,
					"content": "Ох, прошу, не говорите так. Что может быть хуже, чем крах собственного жилища?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250205
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250205,
					"content": "Твой дом... разрушен?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250206
					]
				},
				{
					"id": 230250206,
					"content": "Кхе-кхе, нет, конечно. Но если вы живёте в доме, который никогда не видели целиком, как вы можете быть уверены в его прочности?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250207
					],
					"speakerTitle": "Фаргани"
				},
				{
					"id": 230250207,
					"content": "Вы бы обеспокоились, проводя дни в таком доме, верно? Вот так же и с жизнью в этом мире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250208
					],
					"speakerTitle": "Фаргани"
				}
			]
		},
		{
