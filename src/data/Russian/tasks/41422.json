	"talks": [
		{
			"id": 4142201,
			"completionStepIds": [
				4142201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142201",
							"2"
						],
						"stepId": 4142201,
