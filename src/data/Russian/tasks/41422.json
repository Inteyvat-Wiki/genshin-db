					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220101,
					"content": "Я поговорила с Родией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220102
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220102,
					"content": "Она не только самая известная из наших океанидов-разведчиков, но и самая сильная. Однако она бежала из Фонтейна, оставаясь преданной идеалам прежнего Гидро Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220103
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220103,
					"content": "Для меня обратной дороги в Фонтейн нет, поэтому я расскажу вам всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220104
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220104,
					"content": "Когда-то мы жили в каждой реке, ручье и пруду по всему материку. Почти все из нас были шпионами Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220105
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220105,
					"content": "Шпионами?! Что это Гидро Архонт такое замышлял?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414220106,
					"content": "У неё не было никакого плана. Она всего лишь хотела объединить в этом мире всё живое, подобно соединяющимся друг с другом водам. Но после её гибели многие океаниды оборвали связь с Фонтейном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220107
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220107,
					"content": "Они, как и могущественная Родия, не признавали нового Гидро Архонта и предпочли остаться в своих грёзах. Родия мечтает лишь о тихом прибежище в спокойных водах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220108
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220108,
					"content": "Но она заметила меня и приняла за подосланную Фонтейном убийцу. Это наполнило её гневом, и она сделала воды горькими для того, чтобы уничтожить меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220109
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220109,
					"content": "Но когда мы встретились впервые, ты была такой крохотной и слабой. Зачем ей понадобилось прикладывать столько усилий?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414220110,
					"content": "Господствующее сознание духов воды, вошедшее в контакт с другим, меньшим, но порочным сознанием, может легко разрушиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220111
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220111,
					"content": "Я восхищалась Родией, поэтому я проделала путь из Фонтейна сюда, прыгая от водоёма к водоёму на Гидро слайме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220112
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220112,
					"content": "Вряд ли другие океаниды, помимо убийц на задании, стали бы проявлять такое упорство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220113
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220113,
					"content": "Это в некотором роде впечатляюще...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414220114,
					"content": "#Но до Паймон, которая с путешественни{F#цей}{M#ком} рано или поздно побывает во всех семи королевствах, тебе ещё далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414220115,
					"content": "Паймон!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220116
					]
				},
				{
					"id": 414220116,
					"content": "Я всё ей объяснила. Скоро горечь в воде должна исчезнуть. Она даже спросила, не хочу ли я влиться с ней в воды Цинцэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220117
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220117,
					"content": "Значит, ты пришла, чтобы попрощаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414220118,
					"content": "Сначала мне нужно передать ещё одно послание. Пожалуйста, проводите меня в Спрингвейл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эндора"
				}
			]
		},
		{
			"id": 4142202,
			"completionStepIds": [
				4142202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142202",
							"2"
						],
						"stepId": 4142202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Старина Финч"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220201,
					"content": "Финч, Финч!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220202
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220202,
					"content": "Ой, ой! Перепугала старика...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220203
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414220203,
					"content": "Эндора схватывает всё на лету. Она даже научилась пугать людей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414220204,
					"content": "Просто меня никто не называл Финчем, кроме неё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220205
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414220205,
					"content": "О...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414220206,
					"content": "«Робко ребёнок, шагая вперёд, день за днём сей мир познаёт. Капля за каплей жизни вода...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220207
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220207,
					"content": "«Его напоит, а потом унесёт, но останется с ним навсегда».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220208
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414220208,
					"content": "Мне знакомы эти строки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220209
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414220209,
					"content": "Наша жизнь ни капли не похожа на вашу. Вряд ли мы сможем когда-либо друг друга понять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220210
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220210,
					"content": "В то же время наши жизни подобны. Стремительный поток из мгновений, возможностей и новизны несёт всех нас к морю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220211
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220211,
					"content": "Посему сказала она: «Когда в небе погаснет последняя звезда, когда все ручейки и сны сольются воедино... Тогда свидимся и мы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220212
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220212,
					"content": "...Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220213
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414220213,
					"content": "Жизнь течёт своим чередом. Не останавливайся же и ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220214
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220214,
					"content": "Ха-ха-ха, это в её духе. Она всё ещё считает меня ребёнком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220215
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414220215,
					"content": "Я всё понял. Теперь, пожалуйста, оставьте меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220216
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414220216,
					"content": "#Тогда и нам пора, {NICKNAME}. Нужно рассказать обо всём Коннору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4142203,
			"completionStepIds": [
				4142203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142203",
							"2"
						],
						"stepId": 4142203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Коннор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220301,
					"content": "О, вы вернулись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220302
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 414220302,
					"content": "Я так понимаю, что раз уж за дело взялись вы, то всё улажено?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220303,
						414220304
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 414220303,
					"content": "Другого ожидать и не стоило.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				},
				{
					"id": 414220305,
					"content": "Через день-другой вода станет прежней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414220306,
					"content": "Понял, понял. Раз уж первопричина устранена, через некоторое время вода очистится сама.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220307
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 414220307,
					"content": "Тогда я сообщу Гильдии искателей приключений, что дело закрыто. Благодарю вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Коннор"
				},
				{
					"id": 414220304,
					"content": "Не обошлось без осложнений...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				}
			]
		},
		{
			"id": 4142204,
			"completionStepIds": [
				4142204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142204",
							"2"
						],
						"stepId": 4142204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220401,
					"content": "Мы выражаем любовь, сливаясь воедино. Таким образом, множество сознаний может сосуществовать без каких-либо преград.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220402
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220402,
					"content": "Но понять другие формы жизни совсем непросто. Ради этого мы наблюдаем, изучаем, имитируем и воплощаемся в форме других живых существ. Можно сказать, что их формы стали частью нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220403
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220403,
					"content": "Похоже, течение реки вдохновило Эндору на глубокие размышления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414220404,
					"content": "Я никогда не задумывалась о будущем. Мне всегда казалось, что лучше всего будет слиться с Родией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220405
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220405,
					"content": "Но Родия выглядела несчастной. Она понимает, что наступит момент, когда все чистые воды станут загрязнены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220406,
						414220407
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220406,
					"content": "Так каков же твой выбор?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220408
					]
				},
				{
					"id": 414220408,
					"content": "Ни Родия, ни та, что живёт в Спрингвейле, не хотели, чтобы я следовала их пути. Но я уверена, что жизнь в Фонтейне была для них ещё более нестерпимой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220409
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220409,
					"content": "Вы просто невероятные существа. Паймон не знает, что посоветовать... Но я считаю, что всегда нужно стремиться к счастливой жизни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414220410,
					"content": "Поэтому я решила избрать путь, по которому до меня никто не мог пройти. Странствия с вами принесли мне радость, какой я хотела бы наполнить свои дни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220411
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220411,
					"content": "Я хочу путешествовать вместе с вами, видеть цветущие долины и плывущие по синему небу облака, видеть, как ручейки жизни стекаются в море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220412,
						414220413
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414220412,
					"content": "Мы будем тебе только рады.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220415
					]
				},
				{
					"id": 414220415,
					"content": "Плохо дело... Роль Паймон как твоей единоличной спутницы в путешествии по семи королевствам в опасности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414220413,
					"content": "Для начала нужно сбагрить Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220414
					]
				},
				{
					"id": 414220414,
					"content": "Что-о-о?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414220407,
					"content": "И поэтому ты отвергла её?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220408
					]
				}
			]
