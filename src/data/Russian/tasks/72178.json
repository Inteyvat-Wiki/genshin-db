			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721780101,
					"content": "(На вид обычное святилище. Никаких необычных следов элементов здесь нет.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780102
					],
					"speakerTitle": "Святилище"
				},
				{
					"id": 721780102,
					"content": "Исследовать",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780103
					]
				},
				{
					"id": 721780103,
					"content": "(Похоже, святилище в хорошем состоянии. Вероятно, за ним в последние несколько дней хорошо смотрели. Человек, который этим занимался, должно быть, очень добросовестный.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780104
					],
					"speakerTitle": "Святилище"
				},
				{
					"id": 721780104,
					"content": "(Кроме этого, других следов чьего-то пребывания здесь нет.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780105
					],
					"speakerTitle": "Святилище"
				},
				{
					"id": 721780105,
					"content": "Странно... Кажется, здесь кто-то побывал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7217802,
			"completionStepIds": [
				7217803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217801",
							"2"
						],
						"stepId": 7217801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721780201,
					"content": "Там есть ещё одно святилище. Пойдём взглянем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721780202,
					"content": "(На вид обычное святилище. Никаких необычных следов элементов здесь нет.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780203
					],
					"speakerTitle": "Святилище"
				},
				{
					"id": 721780203,
					"content": "Исследовать",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780204
					]
				},
				{
					"id": 721780204,
					"content": "(Святилище чистое и ухоженное. Здесь чувствуется лёгкий аромат Священной сакуры. Кто-то здесь недавно молился.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780205
					],
					"speakerTitle": "Святилище"
				},
				{
					"id": 721780205,
					"content": "(Кроме этого, более новых следов нет.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780206
					],
					"speakerTitle": "Святилище"
				},
				{
					"id": 721780206,
					"content": "Этот аромат... Это Священная сакура! Наверное, сюда заходила мама Тёдзи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721780207,
					"content": "И совсем недавно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7217803,
			"completionStepIds": [
				7217804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
