			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721780301,
					"content": "На вид это святилище совсем новое! Давай-ка осмотрим его повнимательнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721780302,
					"content": "(На вид обычное святилище. Никаких необычных следов элементов здесь нет.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780303
					],
					"speakerTitle": "Святилище"
				},
				{
					"id": 721780303,
					"content": "Исследовать",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780304
					]
				},
				{
					"id": 721780304,
					"content": "(Дерево, из которого сделано святилище, довольно старое, но благодаря грамотному уходу выглядит оно не таким ветхим, даже красивым.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780305
					],
					"speakerTitle": "Святилище"
				},
				{
					"id": 721780305,
					"content": "Похоже, кто-то часто заходит сюда и ухаживает за святилищем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7217804,
			"completionStepIds": [
				7217805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
