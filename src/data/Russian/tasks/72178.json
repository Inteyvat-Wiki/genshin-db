			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721780401,
					"content": "Кажется, это то святилище, о котором говорил Тёдзи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721780402,
					"content": "(На вид обычное святилище. Никаких необычных следов элементов здесь нет.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780403
					],
					"speakerTitle": "Святилище"
				},
				{
					"id": 721780403,
					"content": "Исследовать",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780404
					]
				},
				{
					"id": 721780404,
					"content": "(Простое, но изящное святилище. Деревянная ниша тускло блестит, приветствуя гостей и их подношения торжественной тишиной.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780405
					],
					"speakerTitle": "Святилище"
				},
				{
					"id": 721780405,
					"content": "(Вокруг святилища разбросаны лепестки Священной сакуры. Что-то тут не так. Похоже, их здесь разбросали специально.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780406
					],
					"speakerTitle": "Святилище"
				},
				{
					"id": 721780406,
					"content": "Хм... И здесь никаких следов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780407,
						721780408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721780407,
					"content": "Смотри, лепестки сакуры...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				},
				{
					"id": 721780409,
					"content": "Точно! Тёдзи упоминал, что его мама подносит лепестки сакуры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721780410,
					"content": "Здесь тоже много лепестков... Это не случайность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721780411,
					"content": "Вернёмся и расскажем ему!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721780408,
					"content": "Это подношение матери Тёдзи ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				}
			]
		},
