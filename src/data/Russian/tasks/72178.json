			"dialogs": [
				{
					"id": 721780501,
					"content": "Здесь тоже есть святилища, и выглядят они знакомыми!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721780502,
					"content": "(На вид обычное святилище. Никаких необычных следов элементов здесь нет.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780503
					],
					"speakerTitle": "Святилище"
				},
				{
					"id": 721780503,
					"content": "Исследовать",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780504
					]
				},
				{
					"id": 721780504,
					"content": "(Это святилище выглядит довольно обветшалым. Деревянный фасад весь выцвел и покрылся трещинками, обнажая опасные тёмно-красные следы.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780505
					],
					"speakerTitle": "Святилище"
				},
				{
					"id": 721780505,
					"content": "Это святилище... жуткое. У меня мурашки побежали по коже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721780506,
					"content": "Давай уйдём отсюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
