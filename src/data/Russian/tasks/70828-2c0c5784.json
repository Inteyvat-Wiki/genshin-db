					"Элси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280601,
					"content": "#Послушай, искатель{F#ница} приключений с золотыми волосами! А вдруг у тебя есть какие-нибудь справочные материалы по любовной поэзии? Я готова их купить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элси"
				}
			]
		},
