				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Элси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "#Эй! Искатель{F#ница} приключений с золотыми волосами! Минутку, подожди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280103,
					"content": "Нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "Нет, я только хотела спросить, нет ли у тебя сборника стихов о любви.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280107,
					"content": "Видишь ли, перед тобой стоит невероятно талантливый бард - возможно, лучший за всю историю Мондштадта, разумеется, после господина Барбатоса... Короче говоря, я очень крутая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280108,
					"content": "Но бард по имени Лайнус не может с этим смириться, он постоянно приходит ко мне и читает стихи! Он явно меня провоцирует, вы согласны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280109,
					"content": "А что ещё хуже, он читает всякую ерунду про любовь, про влюблённых... я на такие темы никогда не писала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280110,
					"content": "Поэтому я решила взяться за дело сама и написать великую поэму о любви, которая потрясёт весь Мондштадт. Покажу ему, что такое настоящий талант!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280111,
					"content": "Но... всё своё время я посвящаю великому искусству, и пока у меня не было возможности самой испытать любовь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280112,
					"content": "Так что если у тебя есть какие-нибудь сборники стихов о любви, можешь продать их мне! Я их пролистаю, и вдохновение забьёт ключом! Я ведь очень талантлива.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280104,
					"content": "Прости, не могу тебе помочь, у меня дела.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "Я и не прошу о помощи! И знаешь, если бы каждый человек, столкнувшись с трудностями, кидался на улице к первому встречному незнакомцу, чтобы их решить, наверное, все мы боялись бы выходить из дома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280106,
					"content": "Кхм-кхм, я всего лишь хотела спросить, нет ли у тебя сборника стихов о любви.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Элси"
				}
			]
		},
		{
			"id": 7082802,
			"completionStepIds": [
				7082802
			],
			"beginWay": "TALK_BEGIN_NONE",
