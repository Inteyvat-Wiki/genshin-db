					"Элси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280401,
					"content": "(Предложить «Сон Ронабуйе»)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280402
					]
				},
				{
					"id": 708280402,
					"content": "О-о, это сборник стихов из Фонтейна! Посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280403
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280403,
					"content": "...вернуться в прошлое... ко двору Рыцаря чистых родников... полюбить в прислужницу с одного взгляда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280404
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280404,
					"content": "Умираю от смеха! Ну и глупец! У него была возможность вернуться в прошлое, а он только и думал о том, как бы завести роман с девицей, которая годится ему в прабабки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280405
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280405,
					"content": "Это ведь любовные стихи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280406
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280406,
					"content": "#Эх, теперь понятно, любовь сводит с ума. В общем, куплю и буду читать не торопясь. Спасибо тебе, искатель{F#ница} приключений с золотыми волосами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элси"
				}
			]
		},
		{
			"id": 7082805,
			"completionStepIds": [
				7082805
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082805",
							"2"
						],
						"stepId": 7082805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Элси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280501,
					"content": "#Ха-ха, спасибо тебе, искатель{F#ница} приключений с золотыми волосами! Ты {F#моя героиня}{M#мой герой}! Правда-правда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280502
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280502,
					"content": "Сейчас вдохновение у меня в голове бушует, точно ураган в логове Ужаса Бури, точно миазмы в долине Чэньюй или гроза на острове Сэйрай, и всё это рвётся наружу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280503
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280503,
					"content": "Мне даже не по себе стало!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280504
					]
				},
				{
					"id": 708280504,
					"content": "Хм, подожди! Сейчас я буду творить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280505
					],
					"speakerTitle": "Элси"
				},
				{
					"id": 708280505,
					"content": "Слащавые стишки Лайнуса не выдерживают никакой критики. Когда я закончу свой шедевр, все таверны Тейвата будут буквально кипеть от восторга!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элси"
				}
			]
		},
		{
			"id": 7082806,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
