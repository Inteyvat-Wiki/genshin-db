			"dialogs": [
				{
					"id": 223020201,
					"content": "Это похоже на <color=#00E1FFFF>торговую гильдию «Фэйюнь»</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 223020202,
					"content": "Просто передай книгу <color=#00E1FFFF>мужчине у входа</color> в гильдию. Вот и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 223020203,
					"content": "Но Паймон хочет узнать, про что эта книга...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 223020204,
					"content": "Что думаешь? Может, посмотрим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
