			"dialogs": [
				{
					"id": 223020301,
					"content": "Куда он делся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020302
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 223020302,
					"content": "У меня книга от Чана Девятого.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020303
					]
				},
				{
					"id": 223020303,
					"content": "Хм? Он всё ещё что-то пишет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020304
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 223020304,
					"content": "А... Припоминаю... Он что-то говорил про литературный конкурс в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020305
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 223020305,
					"content": "О чём же он написал на этот раз? Прошлая история была про Цисин. Чан Девятый настаивал, чтобы мы её опубликовали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020306
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 223020306,
					"content": "И хотя мы не стали этого делать, у нас всё равно возникли проблемы с Миллелитами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020307
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 223020307,
					"content": "Хорошо, что в этот раз он отправляет роман на конкурс в Инадзуму... Это больше не наша ответственность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020308
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 223020308,
					"content": "Передай мне книгу. Моряки, отправляющиеся в Инадзуму, доставят её по адресу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020309
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 223020309,
					"content": "Если честно, то я думаю, что у него нет шансов на победу. В Инадзуме сейчас безумно популярна книга «Легенда о клинке».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020310
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 223020310,
					"content": "Её тоже написал кто-то из Ли Юэ, но я не знаю кто именно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020311
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 223020311,
					"content": "Благодарю тебя за доставку рукописи. Чан Девятый просил, чтобы мы сами забрали книгу, и даже заплатил вперёд, но... Вот твоя награда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй"
				}
			]
		},
