						223020402
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 223020402,
					"content": "Эта книга будет продаваться по всему миру... И она обязательно её прочтёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020403
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 223020403,
					"content": "Ты всё ещё здесь? Скорее, отнеси мою рукопись в <color=#00E1FFFF>торговую гильдию «Фэйюнь»</color>.",
					"roleType": "TALK_ROLE_NPC",
