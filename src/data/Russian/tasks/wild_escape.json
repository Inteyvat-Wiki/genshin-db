			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дилюк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760601,
					"content": "Ах, господин Дилюк, вы не видели здесь двух воришек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760602
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 3760602,
					"content": "Что произошло? Откуда эта толпа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760603
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760603,
					"content": "Разве вы не слышали, господин Дилюк? Два вора пытались украсть Небесную лиру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760604
					],
					"speakerTitle": "Майлз"
				},
				{
					"id": 3760604,
					"content": "Хм. Неужели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760605
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760605,
					"content": "На этой лире играл сам Анемо Архонт. Это бесценное сокровище!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760606
					],
					"speakerTitle": "Майлз"
				},
				{
					"id": 3760606,
					"content": "Зачем похищать то, что нельзя продать? В моих погребах можно найти много более простой наживы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760607
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760608
					],
					"speakerTitle": "Отто"
				},
				{
					"id": 3760608,
					"content": "Простите, это не относится к делу. Эти двое побежали в ту сторону.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760609
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760609,
					"content": "Так точно! Спасибо, господин Дилюк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Майлз"
				}
			]
		},
