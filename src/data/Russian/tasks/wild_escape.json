				"points": []
			},
			"dialogs": [
				{
					"id": 3760401,
					"content": "Господин Дилюк, вот выручка за эту неделю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760402
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 3760402,
					"content": "Хм... Бедствие серьёзно повлияло на бизнес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760403
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760403,
					"content": "Я надеюсь, что всё это безумие скоро прекратится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760404
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 3760404,
					"content": "Хозяин! ...Мы бы не хотели сидеть у всех на виду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760405
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760405,
					"content": "На втором этаже всегда меньше людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760406
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760406,
					"content": "Хм. Ты же бард. Разве ты не хочешь быть в центре внимания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760407
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760407,
					"content": "Ха-ха! Давайте договоримся о платном выступлении на следующий раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760408
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760408,
					"content": "Приглядывай за ними. Этот бард выглядит подозрительно. Я пока наведу кое-какие справки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760409
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760409,
					"content": "У кого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760410
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 3760410,
					"content": "У защитников Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дилюк"
				}
			]
		},
		{
			"id": 37605,
			"completionStepIds": [],
