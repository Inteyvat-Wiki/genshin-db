			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дилюк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760701,
					"content": "Можно мне стаканчик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760702
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760702,
					"content": "Верни на место бутылку, которую ты украл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760703
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760703,
					"content": "...чего-нибудь холодненького.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760704
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760704,
					"content": "Хорошо. А сейчас вы ответите на мои вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760705
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760705,
					"content": "Я всё возмещу! Я дам бесплатное представление!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760706
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760706,
					"content": "Я говорю не о деньгах. Ты выглядишь слишком молодо, чтобы пить вино.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760707
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760708,
					"content": "Как насчёт того, чтобы ответить на мой вопрос?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760709
					]
				},
				{
					"id": 3760710,
					"content": "Кто это?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760711
					]
				},
				{
					"id": 3760707,
					"content": "Об этом не переживайте. Я старше, чем выгляжу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760708,
						3760710
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760709,
					"content": "Ты про него спрашиваешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760711
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760711,
					"content": "Это <color=#00E1FFFF>господин Дилюк</color>, хозяин этой таверны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760712
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760712,
					"content": "Его имя знакомо каждому жителю Мондштадта. Кстати, вино из одуванчиков здесь просто отменное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760713
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760713,
					"content": "Хотя обычно мне хватает денег только на пару бокалов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760714
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760714,
					"content": "Стражники рассказали мне о ворах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760715
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760715,
					"content": "Я восхищён вашей отвагой. Не каждый рискнёт украсть Небесную лиру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760716
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760716,
					"content": "Хоть вы и идиоты, но редкие смельчаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760717
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760717,
					"content": "Мы ничего не украли! Лиру забрал кто-то другой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760718
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3760718,
					"content": "У нас тут новоиспечённый рыцарь Ордо Фавониус. Как же столь благородная особа может быть замешана в краже?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760719
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760719,
					"content": "Рыцарь? Так это ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760720
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760721,
					"content": "Не такие уж и близкие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760722,
					"content": "#Я только однажды слышал{F#а}, как он поёт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760720,
					"content": "Значит, вы с бардом близкие друзья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760721,
						3760722
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760723,
					"content": "#Несмотря на то, что ты не отсюда, ты помог{F#ла} нашему городу в трудную минуту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760724
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760724,
					"content": "#Ты слишком хорош{F#а} для Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760725
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760725,
					"content": "Рыцари слишком осторожны, они боятся сразиться с Ужасом Бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760726
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760726,
					"content": "В переговорах с <color=#00E1FFFF>Фатуи</color> они тоже не показывают особых успехов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760727
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760727,
					"content": "Впрочем, я не хочу об этом сейчас говорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760728
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760728,
					"content": "Похоже, вам не очень нравится Ордо Фавониус, господин Дилюк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760729
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760729,
					"content": "У нас с ними разные подходы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760730
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760730,
					"content": "Я вижу развитие города по-своему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760731
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760731,
					"content": "Теперь скажите мне. Зачем вам Небесная лира?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760732
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760732,
					"content": "Вы уверены, что хотите знать? Возможно, у вас будут проблемы с рыцарями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760733
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760733,
					"content": "Для рыцарей я и так одна большая проблема.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760734
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760734,
					"content": "Тогда позвольте мне поведать эту историю в песне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760735
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760735,
					"content": "Хм. Ну, давай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760736
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760736,
					"content": "Тогда... Вы мне заплатите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760737
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760737,
					"content": "Оплата от пяти моры до Небесной лиры. Зависит от твоей истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760738
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760738,
					"content": "Отлично. Представление начинается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760739
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760739,
					"content": "То, что я сейчас услышал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760740
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760740,
					"content": "Это секретная информация. Почему ты решил довериться мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760741
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760741,
					"content": "Почему? Хм. Может быть, ветер поменял своё направление.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760742
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760742,
					"content": "Что скажете, господин Дилюк?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760743
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760743,
					"content": "Интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760744
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760744,
					"content": "Дайте мне немного времени. Мне нужно связаться кое с кем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760745
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760745,
					"content": "Как член ордена, ты вне подозрений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760746
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760746,
					"content": "В описании Похитителей значатся только светлые волосы, тебе нечего бояться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760747
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760747,
					"content": "А что касается барда... Будет лучше, если он останется в таверне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760748
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760748,
					"content": "Без проблем. Мне нравится в таверне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760749
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3760749,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760750
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3760750,
					"content": "Увидимся здесь после закрытия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760751
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4820221,
					"content": "Следуй за <color=#00E1FFFF>метками</color> до самого финиша.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Эмбер"
				}
			]
		}
	]
}