			"dialogs": [
				{
					"id": 736920101,
					"content": "#А, приветствую, путешественни{F#ца}{M#к}. Наверное, вы тоже хотите поучаствовать в Празднике мудрости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920102
					],
					"speakerTitle": "Паз"
				},
				{
					"id": 736920102,
					"content": "Если да, приглашаю сыграть в мини-игру нашей Амурты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920103
					],
					"speakerTitle": "Паз"
				},
				{
					"id": 736920103,
					"content": "А что нужно делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920104
					]
				},
				{
					"id": 736920104,
					"content": "На Празднике мудрости наш даршан представляет мини-игру «Миметическая репликация».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920105
					],
					"speakerTitle": "Паз"
				},
				{
					"id": 736920105,
					"content": "В этой игре я расскажу о некоторых характерных особенностях поведения животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920106
					],
					"speakerTitle": "Паз"
				},
				{
					"id": 736920106,
					"content": "Конечно, мы их обобщили и упростили, поэтому их легко понять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920107
					],
					"speakerTitle": "Паз"
				},
				{
					"id": 736920107,
					"content": "Нужно имитировать поведение животных по уже разработанным нами моделям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920108,
						736920109
					],
					"speakerTitle": "Паз"
				},
				{
					"id": 736920108,
					"content": "Звучит очень просто...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				},
				{
					"id": 736920110,
					"content": "Да. Всем понятно, что такое «поведенческие паттерны животных».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920111
					],
					"speakerTitle": "Паз"
				},
				{
					"id": 736920111,
					"content": "За этой, на первый взгляд, простой фразой скрываются бесконечные загадки для науки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920112
					],
					"speakerTitle": "Паз"
				},
				{
					"id": 736920112,
					"content": "Но... на время праздника давайте отложим научные гипотезы в сторону и попробуем подражать повадкам животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920113,
						736920115
					],
					"speakerTitle": "Паз"
				},
				{
					"id": 736920113,
					"content": "Хочу попробовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920114
					]
				},
				{
					"id": 736920114,
					"content": "Хорошо, идите сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паз"
				},
				{
					"id": 736920115,
					"content": "Мне пока некогда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920116
					]
				},
				{
					"id": 736920116,
					"content": "Ничего страшного. Во время праздника мой киоск будет всё время открыт. Можете в любое время прийти поиграть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паз"
				},
				{
					"id": 736920109,
					"content": "Вроде это несложно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				}
			]
		}
	]
}