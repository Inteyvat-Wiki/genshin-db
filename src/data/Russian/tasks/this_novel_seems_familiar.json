	"talks": [
		{
			"id": 2201701,
			"completionStepIds": [
				2201701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201701",
							"2"
						],
						"stepId": 2201701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дзюнкити",
					"Сигэру"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170101,
					"content": "С меня хватит! Мне плевать, сколько ты будешь умолять! Я бросаю писательство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170102
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170102,
					"content": "Архонты... Ты угрожаешь мне этим уже седьмой раз... и ни разу это не была серьёзная угроза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170103
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170103,
					"content": "По какому поводу вы в этот раз ругаетесь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170104
					]
				},
				{
					"id": 220170104,
					"content": "#Наконец-то ты здесь, путешественни{F#ца}{M#к}! Ты дол{F#жна}{M#жен} мне помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170105
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170105,
					"content": "#С тех пор, как ты в последний раз встал{F#а} на его сторону, он начал постоянно перегибать палку. Он установил для меня десятки правил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170106
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170106,
					"content": "От названий до устройства сюжета. Он хочет создать список... писательских стандартов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170107
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170107,
					"content": "Как я могу писать в таких условиях?! Если ему хочется соблюдения всех этих бесконечных правил, почему бы ему тогда самому не написать этот роман?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170108
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170108,
					"content": "Это принципы писательского мастерства, которые я извлек из успешных романов. Проверенные и верные рекомендации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170109
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170109,
					"content": "Это навязывание формулы других романов моему произведению. Что я в итоге?! Пишу свой собственный роман или копирую чужой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170110
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170110,
					"content": "Я бы никогда не стал писать настолько педантично... Если ты хочешь чего-то подобного, то напиши это сам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170111
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170111,
					"content": "Кроме того, разве в издательском доме Яэ уже не пылятся сотни подобных романов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170112
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170112,
					"content": "Это просто плохая раскрутка, это вовсе не означает, что сами романы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170113
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170113,
					"content": "Это не имеет никакого отношения к стратегиям продаж. Это связано исключительно с тем, как те авторы написали свои романы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170114
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170114,
					"content": "Возможно, ты не знаком со всеми из них, но я, как автор, прочитал все книги, опубликованные издательским домом Яэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170115
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170115,
					"content": "#Путешественни{F#ца}{M#к}, не мог{F#ла} бы ты достать для меня несколько романов? Нам с Сигэру нужно серьезно поговорить об этом всём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170116,
						220170117
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170116,
					"content": "Положись на меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220170117,
					"content": "Какие романы мне принести?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170118
					]
				},
				{
					"id": 220170118,
					"content": "Просто принесите мне романы, которые у меня уже есть. Я часто использую их как предупреждение самому себе... о том, как не стоит писать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				}
			]
		},
		{
			"id": 2201702,
			"completionStepIds": [],
