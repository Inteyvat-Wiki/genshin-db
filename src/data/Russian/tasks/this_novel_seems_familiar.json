				"points": []
			},
			"dialogs": [
				{
					"id": 220170201,
					"content": "#Путешественни{F#ца}{M#к}, не мог{F#ла} бы ты достать для меня несколько романов? Нам с Сигэру нужно серьезно поговорить об этом всём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170202
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170202,
					"content": "Хмф. Если я позволю ему писать, как ему вздумается, он точно испортит роман.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сигэру"
				}
			]
		},
		{
			"id": 2201703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201703",
							"2"
						],
						"stepId": 2201703,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"2201701"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дзюнкити"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170301,
					"content": "#Путешественни{F#ца}{M#к}, ты принес{F#ла} романы, которые я тебя просил? Давай посмотрим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				}
			]
		},
		{
			"id": 2201704,
			"completionStepIds": [
				2201706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201706",
							"2"
						],
						"stepId": 2201706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сигэру",
					"Дзюнкити"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170401,
					"content": "Я хорошо помню эту книгу. Этот роман был популярен достаточно долгое время, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170402
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170402,
					"content": "Причина его успеха заключалась в хорошо продуманных загадках и структуре сюжета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170403
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170403,
					"content": "Несмотря на то, что многие читатели говорили, что за сюжетом невозможно уследить, автор всё же не отступился от своих принципов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170404
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170404,
					"content": "Вот почему этот роман выделяется среди других романов схожего жанра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170405
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170405,
					"content": "Но разве у этого романа нет также и прочного сеттинга? Продуманная логика мира, которую нелегко изменить, - это ключ к поддержанию сюжета такого рода романа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170406
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170406,
					"content": "#Эээ... ну как бы... Путешественни{F#ца}{M#к}, есть ещё какие-нибудь книги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				}
			]
		},
		{
			"id": 2201705,
			"completionStepIds": [
				2201705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201705",
							"2"
						],
						"stepId": 2201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сигэру",
					"Дзюнкити"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170501,
					"content": "Тогда вот этот! Я помню, что написан он был превосходно, и сюжет был отлично продуман. Редакторы его высоко оценили. Кроме того, его продажи тоже были очень даже ничего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170502
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170502,
					"content": "...Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170503
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170503,
					"content": "Однако он был настолько зажат своим строгим прямолинейным сюжетом и негибким построением мира, что в итоге не осталось никакого места для расширенной вселенной. В конце концов, он просто стал слишком однообразным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170504
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170504,
					"content": "Он постепенно терял читателей, потому что ему не хватало длящейся свежести истории. В конце концов, он потерял всех своих читателей и бесславно угас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170505
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170505,
					"content": "Будь то мир романа или его сюжет, если загнать себя в такие жёсткие рамки, все твои истории будут выглядеть одинаково. Ты упрёшься в стену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170506
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170506,
					"content": "Я не хочу, чтобы это случилось с моим романом! Самое главное, что должно быть у истории - это живая энергия!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170507
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170507,
					"content": "Если... если автор сам не заинтересован в своей истории, как он может заставить читателя почувствовать какую бы то ни было вовлечённость?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170508
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170508,
					"content": "Сигэру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170509
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170509,
					"content": "...Я понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170510
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170510,
					"content": "Я не подозревал, что ты так много думаешь о подобных вещах. Неудивительно, что ты смог написать такой роман, как «Онибудо».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170511
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170511,
					"content": "Я не хочу ограничивать твой творческий потенциал, но я видел слишком много авторов, которые испортили свои работы из-за необузданного полета воображения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170512
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170512,
					"content": "Дзюнкити, что ты думаешь о писательском мастерстве?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170513
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170513,
					"content": "Я считаю, что всё дело в желании творить. Писатель, у которого нет желания творить, не сможет создать текст, привлекающий читателей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170514
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170514,
					"content": "На мой взгляд, важнее, чтобы писатель проявлял сдержанность в выражении этого творческого желания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170515,
						220170516
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170515,
					"content": "Вы двое всё еще не можете достигнуть единого мнения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				},
				{
					"id": 220170517,
					"content": "Сигэру, я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170518
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170518,
					"content": "Но не я автор этого романа, а ты. Я просто редактор, который должен помочь тебе закончить его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170519
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170519,
					"content": "Если ты настаиваешь на том, чтобы остаться при своих принципах, то воплощай их в жизнь по собственному усмотрению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170520
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170520,
					"content": "Не могу сказать, что с тобой согласен. Но я постараюсь понять тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170521
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170521,
					"content": "Ах... спасибо тебе, Сигэру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170522
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170522,
					"content": "Не за что. Конечно же, я понимаю, почему ты думаешь так, как думаешь. Но ты должен понять и мою позицию. Например...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170523
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170523,
					"content": "Ух, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170524
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220170524,
					"content": "Например, ещё один день подходит к концу, а я всё ещё в глаза не видел твоей рукописи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220170516,
					"content": "Видимо, мне не под силу переубедить его...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				}
			]
