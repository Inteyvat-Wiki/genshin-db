			"dialogs": [
				{
					"id": 751950201,
					"content": "О! Что за добрая душа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950202
					],
					"speakerTitle": "Дутта"
				},
				{
					"id": 751950202,
					"content": "Я хотел позвать татанказавра, чтобы он расчистил пустырь от камней. И заодно уничтожил чудовищ, если они появятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950203
					],
					"speakerTitle": "Дутта"
				},
				{
					"id": 751950203,
					"content": "Но не успел я взяться за работу, а всё уже сделано.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950204
					],
					"speakerTitle": "Дутта"
				},
				{
					"id": 751950204,
					"content": "Каждое утро я удобряю плодовые деревья возле дома. Я всю жизнь делаю добрые дела, наверняка боги решили вознаградить меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950205
					],
					"speakerTitle": "Дутта"
				},
				{
					"id": 751950205,
					"content": "#{M#Добрый человек, посланник}{F#Добрая девушка, посланница} богов! Дутта благодарит тебя за отзывчивость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950206
					],
					"speakerTitle": "Дутта"
				},
				{
					"id": 751950206,
					"content": "У меня нет достойной награды, но я дам тебе немного моры и кое-какие вещи, они могут оказаться полезны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дутта"
				}
			]
		}
	]
