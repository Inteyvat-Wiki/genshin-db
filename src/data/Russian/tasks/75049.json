				"points": []
			},
			"dialogs": [
				{
					"id": 750490401,
					"content": "Ну... я не ожидал, что вы найдёте вход, здесь давно никто не появлялся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490402
					],
					"speakerTitle": "Дух полуночной души"
				},
				{
					"id": 750490402,
					"content": "Здесь бродят ночные духи... но, боюсь, никто даже не помнит, как зовут ночных духов в стране, где светит солнце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490403
					],
					"speakerTitle": "Дух полуночной души"
				},
				{
					"id": 750490403,
					"content": "Ночные духи... Мы сны нашей повелительницы, когда она спит. А когда наша богиня иногда просыпается, мы лишь отголоски её мыслей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490404
					],
					"speakerTitle": "Дух полуночной души"
				},
				{
					"id": 750490404,
					"content": "Удивительно, что есть новые люди, которые могут прийти сюда. Те, кто жаждет битвы, пробиваются вперёд... храбрецы, любимцы чужих народов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490405
					],
					"speakerTitle": "Дух полуночной души"
				},
				{
					"id": 750490405,
					"content": "Успокойте этих беспокойных духов огненной битвой, одержите победу, и дух, который спит здесь, будет вознаграждён... Вы согласны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дух полуночной души"
				}
			]
		},
