			"dialogs": [
				{
					"id": 401489601,
					"content": "...Серьёзно, это было так стремительно! Алый воин протаранил механикуса, и тот отлетел!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489602
