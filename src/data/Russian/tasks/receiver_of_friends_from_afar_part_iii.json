			"dialogs": [
				{
					"id": 401489801,
					"content": "Я должен вернуться в порт сразу после обеда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489802
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401489802,
					"content": "Зачем ты на самом деле приехал в Ли Юэ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401489803
					]
				},
				{
					"id": 401489803,
					"content": "Ну... это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489804
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401489804,
					"content": "...Я всё объясню. Босс недавно устроился матросом, что позволило ему приехать сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489805
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401489805,
					"content": "После того как корабль причалил, у него появилось свободное время, которое он мог использовать по своему усмотрению. Это время он посвятил общению с гранд-мастером Ханакадо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489806
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401489806,
					"content": "Всё потому, что он здесь! Других причин нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аратаки Итто"
				}
