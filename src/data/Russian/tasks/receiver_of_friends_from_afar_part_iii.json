					},
					{
						"sceneId": 3,
						"position": [
							924.154,
							258.972,
							367.775
						],
						"pointId": 310400535
					},
					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401480201,
					"content": "Уф... А вот и еда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401480202,
					"content": "О, так это и есть «Радость жизни»? Вы не шутите! Мой размер!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480203
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480203,
					"content": "Давай, дружище, присаживайся. Мы все здесь друзья, так что не надо церемоний! Я приступаю к еде...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480204
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480204,
					"content": "Кхм! Босс, мы должны уважать местные обычаи. Здесь, в Ли Юэ, гости едят первыми. Так принято.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480205
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401480205,
					"content": "Принято? Э-э... Синобу, я думал, что старинные традиции не в твоём вкусе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480206,
						401480207
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480206,
					"content": "#Я закончил{F#а} работу на кухне, поэтому я тоже гость{F#я}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				},
				{
					"id": 401480208,
					"content": "А? Ты смеёшься надо мной, дружище? ...О, я понял. Блюдо такое ароматное, что все хотят попробовать первыми! Думаю, всему виной исключительно мой хороший вкус. Давайте, приступайте, я подожду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480209
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480210
					],
					"speakerTitle": "Камисато Аято"
				},
				{
					"id": 401480210,
					"content": "Вы, Паймон, Аято и Синобу угощаетесь. В итоге осталось совсем немного «мяса»...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480211
					]
				},
				{
					"id": 401480211,
					"content": "...Вот оно как. Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480212
					],
					"speakerTitle": "Камисато Аято"
				},
				{
					"id": 401480212,
					"content": "Наконец-то настала моя очередь! Ух ты, я вижу большой кусок вкуснятины...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480213
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480213,
					"content": "Нет, подожди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401480214,
					"content": "А? Что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480215,
						401480216
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480215,
					"content": "Твоя очередь, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480217,
					"content": "Ну... Я постараюсь... В общем, Паймон забыла рассказать классную историю происхождения этого блюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401480218,
					"content": "Историю происхождения? Дружище, какая разница, откуда оно взялось? Мы все знаем, куда оно идёт! В глотку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480219
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480219,
					"content": "Ну, в общем... Опустить историю происхождения - это как... как отправиться в путешествие без гида! Поверь Паймон, ты получишь гораздо больше впечатлений, когда услышишь рассказ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401480220,
					"content": "Паймон высказала проницательное наблюдение. Как любой чай должен быть оценён по достоинству, так и пробовать блюдо, не услышав его историю, - пустая трата доброго отношения шеф-повара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480221
					],
					"speakerTitle": "Камисато Аято"
				},
				{
					"id": 401480221,
					"content": "Доброе отношение дружища, да? Нельзя, чтобы оно пропало попусту... Хорошо, давай, выкладывай полную версию! Я весь внимание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480222
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480222,
					"content": "Так-то лучше! Тогда начнём с ингредиентов... На самом деле, нет, лучше начнём с истории постоялого двора «Ваншу»... которая начинается с истории Тростниковых островов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401480223,
					"content": "#(Это наш шанс, {NICKNAME}!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480224
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401480224,
					"content": "#(Понял{F#а}!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480225
					]
				},
				{
					"id": 401480225,
					"content": "Пока Итто отвлёкся, вы с Синобу начинаете уплетать блюдо...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480226
					]
				},
				{
					"id": 401480226,
					"content": "...Дружище, история о Тростниковых островах такая трогательная... Людям в прошлом приходилось несладко. Заставляет ценить то, что имеешь. «Радость»... это хороший способ задуматься о жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480227
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480227,
					"content": "(Упс, я не могу упомянуть «тофу». Сама того не замечая, ушла от темы... К счастью, осталось совсем немного!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401480228,
					"content": "(Но мы уже... наелись до отказа...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480229
					]
				},
				{
					"id": 401480229,
					"content": "А-а-а! Дружище, Синобу! Вы что, всё это время ели?! Оставьте мне хоть немного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480230
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480230,
					"content": "Всё, мне надоело ждать! Настала моя очередь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480231
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480231,
					"content": "Подожди! Босс, оно приготовлено из...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480232
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401480232,
					"content": "Одну минуту, Итто. У меня... есть небольшая просьба. Не будешь ли ты так любезен рассмотреть её?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480233
					],
					"speakerTitle": "Камисато Аято"
				},
				{
					"id": 401480233,
					"content": "Я уезжал из дома в спешке и не смог взять с собой никого из своей семьи. Все они много слышали о тебе и являются большими поклонниками банды Аратаки, поэтому они будут очень огорчены, узнав, что упустили такую возможность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480234
					],
					"speakerTitle": "Камисато Аято"
				},
				{
					"id": 401480234,
					"content": "Однако... если ты позволишь мне передать им оставшуюся часть «Радости жизни», я уверен, что это поднимет им настроение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480235
					],
					"speakerTitle": "Камисато Аято"
				},
				{
					"id": 401480235,
					"content": "Э-э-э... Даже не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480236
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480236,
					"content": "Босс, нельзя забывать о своих друзьях. В Ли Юэ так принято... К тому же пока мы ждали основное блюдо, ты съел довольно много рыбы на гриле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480237
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401480237,
					"content": "...В том числе мою и Аято.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480238
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401480238,
					"content": "А? Её для вас приготовили?! Проклятье... Я слишком увлёкся рассказом, не так ли?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480239
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480239,
					"content": "В таком случае... Передавай привет своей семье, брат! Шеф, а можно и остальное завернуть с собой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401480216,
					"content": "Твой выход...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480207,
					"content": "#Я тоже хочу попробовать {F#первой}{M#первым}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				}
			]
		},
