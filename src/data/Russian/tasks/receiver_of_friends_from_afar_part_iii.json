				]
			},
			"dialogs": [
				{
					"id": 401480301,
					"content": "Похоже, с этими разобрались. Хорошо, отдохни немного и за работу - на подходе очередная большая группа посетителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480302
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 401480302,
					"content": "Остаток дня прошёл без происшествий...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4014804,
