					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190940701,
					"content": "Кэйа, конечно, не самый простой человек, но перед бесплатной выпивкой невозможно устоять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190940702
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 190940702,
					"content": "Ты всегда можешь отказаться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940703
					]
				},
				{
					"id": 190940703,
					"content": "Я, честно говоря, не силён во всех этих правилах и условностях, которые связаны с хорами и гимнами в церкви Фавония. Но ничего! Главное - это любовь к музыке, так что я справлюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190940704,
						190940705
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 190940704,
					"content": "Кажется, тебе придётся нелегко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				},
				{
					"id": 190940706,
					"content": "Ха, я получу удовольствие, Грейс успокоится, зрители порадуются... Дело того стоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				},
				{
					"id": 190940705,
					"content": "Ты ведь делаешь это не из-за вина?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				}
			]
		},
