						],
						"stepId": 300001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хайпасия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30000101,
					"content": "Теперь, когда мы прибыли в Сумеру, наша следующая цель - город Сумеру, где нам нужно найти способ встретиться с малой властительницей Кусанали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000102,
					"content": "#Мы мало что знаем о малой властительнице Кусанали, но она совсем не похожа на божество, которое похитило {M#твою сестру}{F#твоего брата}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000103,
					"content": "Однако Сумеру не зря называют «страной мудрости». Если нам удастся встретиться с божеством мудрости, мы сможем получить ценную информацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000104,
					"content": "Я тоже так думаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000105
					]
				},
				{
					"id": 30000105,
					"content": "Паймон не знает, в какой стороне город Сумеру. Давай заберёмся на большую скалу, где стоит статуя семи Архонтов, и осмотримся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000106,
					"content": "Если не увидим город, по крайней мере, посмотрим, нет ли поблизости деревни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000107,
					"content": "Постой... Смотри, там кто-то впереди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000108,
					"content": "Отлично! Мы просто спросим у неё дорогу, вместо того чтобы бродить по округе, как заблудившиеся искатели приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000109,
					"content": "Эй, привет! Мы не местные и, кажется, немного заблудились... Хотим спросить дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000110,
					"content": "Что? Она не слышит Паймон?.. Эй ты там! Можно спросить у тебя дорогу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000112
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30000112,
					"content": "Что происходит? Она точно нас слышала... Постой-ка! Она что, нас игнорирует? Да как она смеет?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000113,
						30000114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000113,
					"content": "Не злись. Это не повод для переживаний...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000115
					]
				},
				{
					"id": 30000115,
					"content": "Уф! Ну и ладно. Она всё равно может направляться куда-то, где живут люди, у которых мы сможем спросить дорогу. Давай пойдём за ней, только не слишком близко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000116,
					"content": "А как только выдастся случай, спросим у кого-нибудь дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000114,
					"content": "Возможно, у неё есть на то причины.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000115
					]
				}
			]
		},
		{
			"id": 300003,
			"completionStepIds": [
				300003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300003",
							"2"
						],
						"stepId": 300003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хайпасия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30000301,
					"content": "Что? Она подошла к тому маленькому водопаду и исчезла. Давай посмотрим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000302,
					"content": "Паймон думала, что эта пещера - вход в деревню или что-то в этом роде. Кажется, Паймон ошиблась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000303,
					"content": "Смотри, вон она сидит. Неужели она здесь живёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000304,
					"content": "И что нам теперь делать? Снова спросить у неё дорогу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000305,
						30000307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000305,
					"content": "Давай попробуем разговорить её.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000306
					]
				},
				{
					"id": 30000306,
					"content": "Ладно, раз уж мы больше никого не встретили... Хоть она и не слишком дружелюбна, нам ведь просто нужно, чтобы она сказала нам, куда идти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000309,
					"content": "Ммм... такой свежий аромат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000310,
					"content": "Думаю, он исходит от той курильницы. Не похоже на дом в привычном понимании, но, по крайней мере, здесь приятно пахнет! Хм, может быть, жить здесь не так уж и плохо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000311,
					"content": "!!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000312
					]
				},
				{
					"id": 30000312,
					"content": "#Что с тобой? Ты аж в лице {F#переменилась}{M#переменился}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000313,
						30000314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000313,
					"content": "Этот запах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000315
					]
				},
				{
					"id": 30000315,
					"content": "Тебе нехорошо от него? А Паймон ничего такого не чувствует...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000316,
					"content": "(Мне нужно выйти! Срочно!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000317
					]
				},
				{
					"id": 30000317,
					"content": "(Я т-теряю сознание...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000318
					]
				},
				{
					"id": 30000318,
					"content": "#{NICKNAME}, что с тобой? Не время спать! Очнись...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30000314,
					"content": "Такой странный...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000315
					]
				},
				{
					"id": 30000307,
					"content": "Давай не будем её беспокоить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000308
					]
				},
				{
					"id": 30000308,
					"content": "Думаю, она медитирует. Если мы её потревожим, она вряд ли будет рада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000309
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 300010,
			"completionStepIds": [
				300010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300010",
							"2"
						],
						"stepId": 300010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Коллеи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30001001,
					"content": "#...{M#Он}{F#Она} точно в порядке? Прошло столько времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001002,
					"content": "Не волнуйся... Поверь, наставник обладает глубокими познаниями. Если говорит, что всё в порядке, значит, так и есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001003
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30001003,
					"content": "#Ты {F#пришла}{M#пришёл} в себя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001004
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30001004,
					"content": "#{NICKNAME}, наконец ты {F#очнулась}{M#очнулся}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001005,
					"content": "Что это за место?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001006
					]
				},
				{
					"id": 30001006,
					"content": "Это... Э-э-э... Хороший вопрос, где же мы? Паймон так переживала за тебя, что забыла спросить, где мы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001007
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001007,
					"content": "Это Гандхарва. Раньше это место служило учёным Сумеру местом отдыха в тропическом лесу. Сейчас здесь в основном базируется Лесной дозор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001008
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30001008,
					"content": "Привет! Меня зовут Коллеи, я стажёр Лесного дозора. Мы с наставником нашли тебя сегодня без сознания во время обхода и принесли сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001009
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30001009,
					"content": "Спасибо тебе за помощь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001010
					]
				},
				{
					"id": 30001010,
					"content": "Что ты, не стоит благодарности. Как ты себя чувствуешь? Ощущаешь дискомфорт в теле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001011,
						30001012
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30001011,
					"content": "Нет, всё хорошо, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001013
					]
				},
				{
					"id": 30001013,
					"content": "#Ха-ха... Виной тому отвар наставника. Он влил в тебя немного, когда ты был{F#а} без сознания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001014
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30001014,
					"content": "Чуть не забыла. Наставник сказал дать тебе ещё этого отвара, когда ты придёшь в себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001015
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30001015,
					"content": "Ай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001016
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30001016,
					"content": "Коллеи, что с тобой? Ты пыталась достать лекарство? Сколько раз я тебе говорил, что тебе нужно быть осторожнее... Я принесу его тебе, только сначала разберусь тут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001017
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001017,
					"content": "Простите, наставник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001018
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30001018,
					"content": "Ох, итак... «Атлас съедобных грибов леса Авидья» висит на доске объявлений. Но если Фарбод не может его запомнить, у меня нет выбора. Придётся повесить его на более видном месте. Например, у него на лбу, чтобы другие напоминали ему об осторожности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001019
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001019,
					"content": "В этом месяце он уже два раза травился. Я непременно поговорю с ним об этом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001020
					],
					"speakerTitle": "Насрин"
				},
				{
					"id": 30001020,
					"content": "Да, будь добра. С другой стороны, если ему нравятся разноцветные человечки, которые танцуют у него перед глазами, то здесь уже ничего не поделаешь. Но в следующий раз, когда он захочет получить лекарство, ему придётся заплатить за него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001021
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001021,
					"content": "Ну как? Тебе лучше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001022
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001022,
					"content": "Это мой наставник, господин Тигнари, лесной страж и глава всех лесных дозорных в Гандхарве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001023
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30001023,
					"content": "#Я объяснил Паймон причину твоей потери сознания. Сейчас расскажу и тебе, раз ты уже {M#пришёл}{F#пришла} в себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001024
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001024,
					"content": "В Сумеру учёные некоторых даршанов выполняют особые практики в лесу. Они используют растительные благовония под названием духовный борнеол, чтобы успокоить свой ум и войти в состояние глубокого раздумья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001025
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001025,
					"content": "В поисках дороги вы вошли в пещеру, где учёная по имени Хайпасия в уединении воскуривала эти благовония.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001026
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001026,
					"content": "Благовония не оказывают никакого воздействия на большинство людей, но они способны стимулировать ум избранных, к которым относишься и ты. Понятно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001027
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001027,
					"content": "Да, теперь понятно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001028
					]
				},
				{
					"id": 30001028,
					"content": "#Вот и хорошо. Скажи, какие у тебя были ощущения, когда ты потерял{F#а} сознание? Ты что-нибудь видел{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001029
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001029,
					"content": "Вы описываете то, что видели, пока были без сознания...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30001030
					]
				},
				{
					"id": 30001030,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001031
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001031,
					"content": "Коллеи, предупреди остальных. Скажи, чтобы они пока не приносили сюда журналы патрулирования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001032
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001032,
					"content": "Э, что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001033
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30001033,
					"content": "Они поживут у меня несколько дней, а я в это время поживу у Амира. А теперь поторопись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001034
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001034,
					"content": "А, да! Понятно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001035
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30001035,
					"content": "Подождите-ка, а что происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001036
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001036,
					"content": "Раньше я думал, что ты придёшь в себя, примешь лекарство и сможешь продолжить свой путь. Но теперь я думаю, что тебе лучше остаться в Гандхарве, чтобы полностью восстановиться. Здесь ты будешь под присмотром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001037
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001037,
					"content": "Под присмотром?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001038
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001038,
					"content": "Но мне нужно в Сумеру...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001039
					]
				},
				{
					"id": 30001039,
					"content": "#Не надо так волноваться. Если ты {F#способна}{M#способен} отличить хорошее от плохого, то поймёшь всю серьёзность ситуации. Прошу, выслушай меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001040
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001040,
					"content": "Судя по твоему рассказу, благовония вызвали у тебя очень сильные галлюцинации. Это значит, что твоё психическое состояние не в лучшей форме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001041
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001041,
					"content": "Если не веришь мне, понюхай это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001042
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001042,
					"content": "Ох!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001043
					]
				},
				{
					"id": 30001043,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001044
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001044,
					"content": "#Очень похоже на те ощущения, когда ты потерял{F#а} сознание, не правда ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001045
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001045,
					"content": "Сейчас твоё сознание стабильно, но если ты уйдёшь, то можешь снова внезапно упасть в обморок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001046
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001046,
					"content": "Тропические леса кишат хищниками и полны опасных зон. В следующий раз вам может не повезти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001047
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001047,
					"content": "В ближайшие несколько дней тебе нужно регулярно принимать лекарство и стараться не передвигаться в одиночку, пока тебе не перестанет становиться плохо от этого запаха. Договорились?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001048
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001048,
					"content": "Хорошо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001049
					]
				},
				{
					"id": 30001049,
					"content": "Отдыхай, а я пока пойду приготовлю для тебя новый отвар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001050
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30001050,
					"content": "Да что же это такое... Мы в Сумеру всего ничего, а уже столкнулись с проблемами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001051
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001051,
					"content": "#{NICKNAME}, я знаю, что ты хочешь поскорее увидеть малую властительницу Кусанали, но ты пока выглядишь так себе... Тебе сначала нужно восстановиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001052
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001052,
					"content": "Эй, ты вообще слушаешь Паймон? Я же беспокоюсь о тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001053
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001053,
					"content": "Я странно себя чувствую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001054
					]
				},
				{
					"id": 30001054,
					"content": "Странно? О чём ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001055,
						30001056
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001055,
					"content": "С моим телом что-то не так, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001057
					]
				},
				{
					"id": 30001057,
					"content": "Ты о корнях и красном небе? Но если это не галлюцинация, то что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001058
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001058,
					"content": "Я не знаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001059
					]
				},
				{
					"id": 30001059,
					"content": "(В тот момент у меня было ощущение, что я нахожусь глубоко под землёй. И там было красное небо... Может, это была Каэнри'ах?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001060
					]
				},
				{
					"id": 30001060,
					"content": "#Хм, хорошо. Ты {F#особенная}{M#особенный}, и Паймон доверяет твоим суждениям. Но почему ты не рассказал{F#а} об этом Тигнари?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001061
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001061,
					"content": "Из-за этого он неправильно оценил твоё состояние. Тебе ведь не станет хуже?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001062,
						30001063
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001062,
					"content": "Не думаю, что он ошибся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001064
					]
				},
				{
					"id": 30001064,
					"content": "Хочешь сказать, Тигнари знает, что это не галлюцинации. Если так, почему он пытается скрыть это от нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001065
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001065,
					"content": "Нам надо докопаться до сути.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001066
					]
				},
				{
					"id": 30001066,
					"content": "#Теперь Паймон понимает, почему ты молчал{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001067
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001067,
					"content": "#Тогда давай пока останемся здесь и восстановим силы. Заодно попытаемся выяснить, что ты видел{F#а} на самом деле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001068
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001068,
					"content": "Мне кажется, спрашивать об этом Тигнари уже не вариант... Что предлагаешь делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001069
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001069,
					"content": "Поговорить с Коллеи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001070
					]
				},
				{
					"id": 30001070,
					"content": "Разумно. Она хорошо к нам относится. Завтра расспросим её о Дендро Архонте и обычаях Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001071
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30001071,
					"content": "Вы всю ночь отдыхаете в комнате...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30001063,
					"content": "Он просто не говорит правду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001064
					]
				},
				{
					"id": 30001056,
					"content": "Это не были галлюцинации.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001057
					]
				},
				{
					"id": 30001012,
					"content": "Но во рту горький привкус!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001013
					]
				}
			]
		}
	]
}