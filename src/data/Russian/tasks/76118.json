			"dialogs": [
				{
					"id": 761180101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180102
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180102,
					"content": "Ты тоже чувствуешь этот вкусный аромат?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761180103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180104
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180104,
					"content": "Коломбина закатила пир для себя любимой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761180105,
					"content": "#{NICKNAME}, Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180106,
					"content": "Выглядит такой довольной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761180107,
					"content": "Хотите попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180108,
					"content": "Кушай, кушай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "Странно видеть, как ты здесь ешь... Ты выходила, чтобы всё это купить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761180110,
					"content": "Это Лаума принесла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180111,
					"content": "О! Она хорошо заботится о тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761180112,
					"content": "При условии, что я не буду выходить отсюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180113,
					"content": "Что?! Это же домашний арест?! Ты что, позволила подкупить себя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761180114,
					"content": "Она принесла интересные книги, изящные игрушки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180115,
					"content": "Будто мама уехала в командировку, а ребёнок остался дома...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761180116,
					"content": "Лаума объяснила причину?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "Она сказала мне пока не выходить на улицу и в особенности избегать Детей Морозной Луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180118,
					"content": "Я спросила животных, которые принесли мне еду, но Лаума велела им молчать, и они выполнили её приказ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180119,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761180120,
					"content": "Думаю, она готовит что-то, что имеет отношение ко мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180121,
					"content": "Не беспокойтесь, мне здесь не скучно. Еда восхитительная, именно такая, как я люблю. Невозможность выйти не тяготит меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180122,
					"content": "К тому же, если Дети Морозной Луны что-то готовят... тем более нельзя позволить своему любопытству помешать им.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180123,
					"content": "Может, разузнаем, что к чему?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "Да, Паймон тоже стало любопытно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761180125,
					"content": "Вы можете, но вам лучше морально подготовиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180126,
					"content": "Она наверняка догадается, что вы приходили ко мне, и, возможно, ничего вам не расскажет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				}
			]
		},
