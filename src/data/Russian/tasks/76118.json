					"nextDialogs": [
						761180409
					],
					"speakerTitle": "Ибис"
				},
				{
					"id": 761180409,
					"content": "О, вот и еда. А? А где еда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180410
					],
					"speakerTitle": "Паймон"
				},
				{
