						761180402
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761180402,
					"content": "Коломбина, ты абсолютно права, Лаума ничегошеньки нам не рассказала!",
					"roleType": "TALK_ROLE_NPC",
