						],
						"pointId": 360600060
					}
				]
			},
			"dialogs": [
				{
					"id": 761180301,
					"content": "Отреставрировать статую Куутар?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761180302,
					"content": "Совершенно верно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180303
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180303,
					"content": "Она больше не Куу{RUBY#[S]Дева Луны}тар - та, что была лишена крыльев и могла лишь одиноко смотреть на луну в небе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180304
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180304,
					"content": "Мы стали свидетелями того, как она расправляет крылья и обретает свободу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180305
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180305,
					"content": "Поэтому и статую божества следует отреставрировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180306
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180306,
					"content": "Звучит неплохо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761180307,
					"content": "Ты рассказала об этом остальным Детям Морозной Луны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180308
					]
				},
				{
					"id": 761180308,
					"content": "Да. Я рассказала им о жертве Богини Луны и о её возвращении...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180309
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180309,
					"content": "И о том, как под руководством мягкого света мы противостояли силе, которая загрязняет этот мир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180310
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180310,
					"content": "Все были рады услышать о её возвращении, поэтому я воспользовалась случаем, чтобы передать им мысли Коломбины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180311
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180311,
					"content": "Что она хотела бы видеть нас своей семьёй и хотела бы, чтобы мы относились к ней так же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180312
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180312,
					"content": "И что они ответили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180313
					]
				},
				{
					"id": 761180313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180314
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180314,
					"content": "Богиня Луны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180315
					],
					"speakerTitle": "Зирница"
				},
				{
					"id": 761180315,
					"content": "Не слишком ли дерзко считать Богиню Луны членом семьи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180316
					],
					"speakerTitle": "Лауха"
				},
				{
					"id": 761180316,
					"content": "Я верю, что это искреннее желание Коломбины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180317
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180317,
					"content": "(Голос Лунного Гимна вот так запросто называет Богиню Луны Коломбиной?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180318
					],
					"speakerTitle": "Кунегунда"
				},
				{
					"id": 761180318,
					"content": "Возможно, вы помните, что я сказала некоторое время назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180319
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180319,
					"content": "«Дорога будет вымощена правдой, и мы сами её проложим».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180320
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180320,
					"content": "Я не буду просить вас сделать тот же выбор, что и я, но сегодня я хочу поделиться с вами одной мудростью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180321
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180321,
					"content": "«Если вы хотите, чтобы лунный свет вошёл в ваш дом и остался, сперва нужно открыть плотно запертые двери».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180322
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180322,
					"content": "...Вот так. Судя по тому, как обстоят дела в последние несколько дней, всё складывается куда оптимистичнее, чем я ожидала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180323
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180323,
					"content": "Госпожа Лаума, новая партия камня доставлена на склад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180324
					],
					"speakerTitle": "Мацей"
				},
				{
					"id": 761180324,
					"content": "Хорошо, я сейчас подойду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180325
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180325,
					"content": "Могу я попросить тебя сохранить в тайне от Коломбины мои слова и всё, что ты здесь видишь? Я хочу приготовить для неё сюрприз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180326
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 761180326,
					"content": "Паймон знает, что у тебя благие намерения, но очевидно, что ты и другие последователи любят сюрпризы... да и сама Богиня Луны тоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761180327,
					"content": "Мы сохраним всё в тайне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180328
					]
				},
				{
					"id": 761180328,
					"content": "Эм, Лаума, насчёт платы за молчание... Паймон хочет спросить, не осталось ли ещё Лунного угощения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761180329,
