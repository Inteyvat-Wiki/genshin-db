			},
			"dialogs": [
				{
					"id": 240030901,
					"content": "#Братец! Ты всё рассказал {F#ей}{M#ему} про моё тайное место! Иначе {F#она не смогла}{M#он не смог} бы найти меня так быстро!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030902
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240030902,
					"content": "Сколько раз повторять? Все твои «тайные» места довольно очевидные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030903,
						240030904
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030903,
					"content": "Боюсь, опыт на моей стороне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				},
				{
					"id": 240030905,
					"content": "В самом деле? А ты ещё с нами поиграешь в другой раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030906
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240030906,
					"content": "Днём родителей нет дома, а брат всё время читает и не хочет играть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030907
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240030907,
