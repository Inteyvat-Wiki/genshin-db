			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Верут",
					"Орель"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "Я выбрал такое место, что ты меня не найдёшь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240030102,
					"content": "Если прятаться в таких местах, тебя будут искать родители, а не я!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030103,
					"content": "Чем вы тут занимаетесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "Я играю в прятки с братом! Вот только он знает все места, где я обычно прячусь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240030105,
					"content": "Верут, мы так давно здесь играем, что ты уже в каждом уголке когда-то прятался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030106,
					"content": "А там, где ты не можешь спрятаться... Я тебе уже тысячу раз говорил, почему там нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030107,
					"content": "Ой, да не такие уж эти места и опасные! Мама и папа просто преувеличивают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240030108,
					"content": "Но когда ты там прячешься, то пачкаешь и рвёшь свою одежду. Мама и папа и так много работают. Не нужно их беспокоить ещё и этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030109,
					"content": "Да, верно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240030110,
					"content": "Давайте я поиграю с вами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "Правда? Хочешь со мной поиграть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240030113,
					"content": "Верут, не беспокой других! Простите моего брата, ему лишь бы поиграть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030114,
					"content": "Ничего, у меня полно времени.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "#Здорово! Видишь, братец? {F#Она согласилась}{M#Он согласился}! Я точно спрячусь лучше тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240030117,
					"content": "#Эх... Хорошо. Тогда дело за тобой, {M#братец}{F#сестрица}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030118,
					"content": "Верут, не прячься там, где я говорил, хорошо? Если родители вернутся и увидят, что ты испачкал и порвал одежду, то будешь сам её стирать и штопать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030119,
					"content": "Хорошо, хорошо... Такой зануда! А теперь давай прятаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240030120,
					"content": "Иди вперёд. Я уже придумал себе место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030121,
					"content": "#В самом деле? Опять хвастаешь! {F#Она}{M#Он} тебя мигом найдёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240030122,
					"content": "Орель и Верут выбрали места и спрятались...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "Ничего страшного, он меня нисколько не беспокоит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "Я-то вряд ли тебя найду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
		{
