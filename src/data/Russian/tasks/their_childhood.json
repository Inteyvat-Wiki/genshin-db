			"dialogs": [
				{
					"id": 240030201,
					"content": "#Ого, ты меня {F#нашла}{M#нашёл}! Тебе про это место мой братец рассказал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030202
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240030202,
					"content": "Да, у тебя здорово получается. Я пойду к обычному месту сбора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верут"
				}
			]
		},
