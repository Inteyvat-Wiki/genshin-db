					"Орель"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030701,
					"content": "Когда же Верут повзрослеет? Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030702
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030702,
					"content": "Не прячешься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030703
					]
				},
				{
					"id": 240030703,
					"content": "И не собирался. Если бы Верут так часто мне не докучал, я бы ещё почитал книжку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030704
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030704,
					"content": "Мама и папа так много работают. Мне нужно поскорее вырасти, чтобы им помогать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030705
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030705,
					"content": "Но Верут всё время говорит, как скучает по маме, поэтому мне и приходится проводить с ним всё время. Тогда он перестаёт грустить на время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030706
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030706,
					"content": "Прости, я слишком много болтаю. Пойду в условленное место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030707
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240030707,
					"content": "Надеюсь, Верут не перепачкает одежду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Орель"
				}
			]
		},
