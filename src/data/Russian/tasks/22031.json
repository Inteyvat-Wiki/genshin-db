			"trigger": {
				"objectNames": [
					"Асакура"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310401,
					"content": "*тяжело дышит* Уровень ваших навыков действительно намного выше моего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310402
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310402,
					"content": "В следующий раз я постараюсь немного сдерживаться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310403
					]
				},
				{
					"id": 220310403,
					"content": "Нет! Пожалуйста, используйте всю вашу силу. Без практики с сильными противниками я не смогу развиваться дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310404
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310404,
					"content": "Учитывая вашу огромную силу, вы, должно быть, много тренировались...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310405
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310405,
					"content": "Простите меня за прямоту, но мне действительно интересно, как вы сами тренировались, чтобы достичь такого уровня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310406,
						220310408
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310406,
					"content": "Однажды гигантский дракон помог мне с тренировкой полета.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310407
					]
				},
				{
					"id": 220310407,
					"content": "Вы... вы летали с гигантским драконом? Невероятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310410,
					"content": "Ничего особенного...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310411
					]
				},
				{
					"id": 220310411,
					"content": "Ха-ха, правда? Тогда, наверное, вы действительно исключительно талантливы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310412
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310412,
					"content": "Благодарю за эту тренировку. Я буду помнить то, чему научился у вас. Пожалуйста, примите это в качестве благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310408,
					"content": "Огромный волк помогает мне в занятиях боевыми искусствами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310409
					]
				},
				{
					"id": 220310409,
					"content": "Это звучит по-настоящему отважно. Я бы очень хотел увидеть, как вы и огромный волк бьётесь друг против друга...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Асакура"
				}
			]
		},
