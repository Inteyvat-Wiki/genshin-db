			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Асакура"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310101,
					"content": "Прямое копье, прямая линия... Ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310102
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310102,
					"content": "Я здесь, чтобы снова потренироваться с тобой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310103
					]
				},
				{
					"id": 220310103,
					"content": "О! Это вы. Вы снова приняли мой запрос? Премного благодарен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310104
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310104,
					"content": "Это действительно здорово, что со мной занимается такой сильный боец, как вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310105,
						220310110
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310105,
					"content": "Твой навык владения копьем значительно улучшился.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310106
					]
				},
				{
					"id": 220310106,
					"content": "Ха-ха... Вы слишком любите надо мной подшучивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310107
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310107,
					"content": "Я слышал, одной из причин изобретения копья было то, что оно позволяет человеку, не умеющему как должно владеть оружием, такому как я, например, сражаться с лёгкостью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310108
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310108,
					"content": "В конце концов, это длинное и острое оружие. Даже если владелец не знает, как им пользоваться, простое нанесение колющих ударов и махи им, по крайней мере, создают видимость силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310109
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310109,
					"content": "Однако, согласно этому правилу... Я думаю, что скромные садовые вилы обладают даже большей силой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310110,
					"content": "Разве ты уже не вернул себе своё оружие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310111
					]
				},
				{
					"id": 220310111,
					"content": "Да, я вернул себе своё оружие, но это не значит, что моё обучение закончено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310112
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310112,
					"content": "У меня уже была стычка с кайраги. Было бы самонадеянно предполагать, что в будущем я не столкнусь с ещё более сильными противниками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310113
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310113,
					"content": "Я никогда больше не позволю своему оружию попасть в руки врага и тем самым осквернить мою честь как самурая. Таков путь самурая, который я хочу пройти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асакура"
				}
			]
		},
		{
			"id": 2203102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
