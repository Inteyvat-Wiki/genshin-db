			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Асакура"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310201,
					"content": "Ах, что ж, довольно болтовни. Я не думаю, что мне стоит и дальше тратить ваше время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асакура"
				}
			]
		},
		{
			"id": 2203103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Асакура"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310301,
					"content": "Кажется, вы сейчас были немного рассеяны. Ваши шаги были беспорядочными, а сила ваших атак - непоследовательной: иногда сильной, иногда слабой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310302
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220310302,
					"content": "Так не пойдёт. Пожалуйста, сначала подготовьтесь, как следует, и мы попробуем ещё раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асакура"
				}
			]
		},
		{
			"id": 2203104,
			"completionStepIds": [
				2203104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
