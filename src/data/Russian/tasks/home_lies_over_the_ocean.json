				"points": []
			},
			"dialogs": [
				{
					"id": 728020601,
					"content": "И куда убежала наша дочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020602,
						728020603
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020602,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				},
				{
					"id": 728020604,
					"content": "Даже если наутро ей нужно на работу, перед уходом Ацуко обычно успевает поговорить с нами. Но сегодня она ушла, не сказав ни слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020605
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020605,
					"content": "Вчера после вашего ухода Ацуко сказала, что устала, отправилась в свою комнату и легла спать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020606
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020606,
					"content": "Утром, когда мы проснулись, в кровати её уже не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020607
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020607,
					"content": "Мы искали её везде. Мой муж камня на камне не оставил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020608
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020608,
					"content": "Однако прошло уже полдня, но мы не обнаружили ни следа нашей дочери.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020609
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020609,
					"content": "Ох... Неужели эта девчонка снова отправилась в путешествие? Что за трудный ребёнок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020610
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020610,
					"content": "Успокойся, душа моя. Я продолжу искать её. А ты пока приберись в комнате Ацуко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020611
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020611,
					"content": "Эта девчонка ушла, не закрыв как следует окно. В комнату надуло столько листьев!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020612
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020612,
					"content": "Да, пока мы не забыли. Вот ваша оплата. Прошу, примите её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020613
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020613,
					"content": "Ох уж эта Ацуко... И куда она делась на этот раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020603,
					"content": "Ацуко снова ушла на работу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				}
			]
		},
