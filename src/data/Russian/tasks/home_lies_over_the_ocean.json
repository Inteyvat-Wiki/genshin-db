			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Митиру",
					"Ё"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020201,
					"content": "Сколько порций приготовить завтра на обед?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020202
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020202,
					"content": "Наши дети в последнее время столько едят! Давай приготовим побольше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020203
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020203,
					"content": "Хм? А это кто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020204,
						728020205
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020204,
					"content": "Скажите, это дом Ацуко?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				},
				{
					"id": 728020206,
					"content": "Да, верно. Слушаем вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020207
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020207,
					"content": "Ацуко попросила передать вам это письмо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020208
					]
				},
				{
					"id": 728020208,
					"content": "Письмо? С чего бы это наша дочь вдруг решила нам написать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020209
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020209,
					"content": "Письмо довольно длинное... Просто она уже вернулась домой. Если ей нужно что-то сказать нам, почему бы не обратиться к нам напрямую?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020210,
						728020211
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020210,
					"content": "...Что?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020212,
					"content": "#...Путешественни{F#ца}{M#к}, похоже, вы удивлены? Да, верно, Ацуко путешествовала по дальним землям, но она уже дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020213
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020213,
					"content": "Зачем ей отправлять нам письмо, если она уже вернулась к нам? Может быть, вы перепутали нас с кем-то ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020214
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020214,
					"content": "Подожди, душа моя. Я пробегу глазами письмо... Да, судя по почерку и стилю изложения, его действительно написала наша дочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020215
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020215,
					"content": "Ещё в нём сказано, что в ближайшее время она не планирует возвращаться и просит нас позаботиться друг о друге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020216
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020216,
					"content": "#Но что всё это значит? Может быть, она попросила путешественни{F#цу}{M#ка} доставить нам письмо, а сама тем временем вернулась домой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020217
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020217,
					"content": "Думаю, это какое-то недоразумение. Как только наша дочь вернётся домой, мы расспросим её об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020218
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020218,
					"content": "К сожалению, сегодня Ацуко пришлось уйти по делам. Как только она вернётся, мы попросим её объяснить, в чём дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020219
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020219,
					"content": "Если вам несложно, загляните к нам завтра вечером. Мы попросим её всё объяснить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020220,
						728020222
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020220,
					"content": "А где она сейчас?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020221
					]
				},
				{
					"id": 728020221,
					"content": "Сказала, что у неё много работы. Она в спешке покинула дом сразу после завтрака.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020224,
					"content": "Да, она каждый день уходит очень рано и возвращается очень поздно. Мы видим её только по вечерам, а потому не можем точно сказать, что у неё на уме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020225
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020225,
					"content": "В любом случае приходите завтра вечером. Если дочь сделала что-то не так, мы непременно заставим её лично попросить у вас прощения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020226
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020226,
					"content": "Нам очень жаль, что вам пришлось проделать весь этот путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020227
					],
					"speakerTitle": "Митиру"
				},
				{
					"id": 728020227,
					"content": "Ох уж эта Ацуко... И почему она у нас такая невоспитанная...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020222,
					"content": "Почему только вечером?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020223
					]
				},
				{
					"id": 728020223,
					"content": "Дочь сказала, что у неё много работы. Сразу после завтрака она уходит на весь день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Ё"
				},
				{
					"id": 728020211,
					"content": "Ацуко... вернулась?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020205,
					"content": "Может быть, вы родители Ацуко?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				}
			]
		},
		{
			"id": 7280203,
