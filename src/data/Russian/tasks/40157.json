				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дворжак"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401570401,
					"content": "Побродите вокруг. Я подойду к вам позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дворжак"
				}
			]
		},
		{
			"id": 4015705,
			"completionStepIds": [
				4015705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4015705",
							"2"
						],
						"stepId": 4015705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сиканоин Хэйдзо"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-3615.737,
							201.872,
							-906.978
						],
						"pointId": 321000267
					}
				]
			},
			"dialogs": [
				{
					"id": 401570501,
					"content": "#О-о-о! {NICKNAME}, Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570502
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570502,
					"content": "Ого! Синобу, Хэйдзо! Вот так сюрприз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401570503,
					"content": "Да, действительно приятный сюрприз... Хотя, если честно, не такой уж и сюрприз. Я как раз говорил госпоже Синобу, что мы вполне можем встретить здесь вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570504
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570504,
					"content": "Ха-ха, досин Сиканоин много о вас рассказывал, пока мы добирались сюда. Видимо, вселенная ответила на его молитвы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570505
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401570505,
					"content": "Интуиция. Имена всплывают в голове в нужные моменты - так уж устроен мой разум.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570506
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570506,
					"content": "#Рад{F#а} встрече.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570507
					]
				},
				{
					"id": 401570507,
					"content": "Кто бы мог подумать, что мы первым делом встретим Хэйдзо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401570508,
					"content": "Босс сказал мне как можно скорее отправить пригласительное письмо комиссии Тэнрё. Он очень хотел пригласить госпожу Кудзё Сару и досина Сиканоина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570509
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401570509,
					"content": "А... А почему Сары нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401570510,
					"content": "Наверняка потому, что у неё нет ни малейшего желания видеть Итто. В её защиту расскажу вам, что было написано в пригласительном письме:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570511
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570511,
					"content": "«Тэнгу Кудзё! Давай встретимся на вершине святилища Сангономии! Устроим рок-н-ролльный матч в духе сумоистов!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570512
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570512,
					"content": "На месте Кудзё Сары я бы не преминула воспользоваться возможностью сбросить Итто с крыши святилища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570513
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401570513,
					"content": "А Кокоми не наваляет ли потом Саре? Топот по крыше... Шум сведёт Кокоми с ума.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401570514,
					"content": "Да, ха-ха... В общем, ответ госпожи Кудзё Сары был гораздо более великодушным, чем мой. Она передала в подарок корзину фиалковых дынь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570515
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401570515,
					"content": "Великодушный? Не уверен. Скорее всего, она пытается что-то этим сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570516
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570516,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401570517,
					"content": "«Если этот óни захочет со мной подраться, в полицейском участке для него припасено много фиалковых дынь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570518
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570518,
					"content": "Может, то, что ты так думаешь, говорит о тебе больше, чем о ней! А что насчёт другой корзины с фиалковыми дынями, а? Подарок от тебя? Какое послание ты хочешь передать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570519
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401570519,
					"content": "Ха-ха, вторая корзина - от ребят из комиссии. Я и другие досины, которые арестовывали Итто раньше, а также некоторые его бывшие сокамерники решили сделать ему подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570520
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570520,
					"content": "Я думаю, корзиной с фиалковыми дынями мы говорим: «Здесь для тебя всегда найдётся место!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570521
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570521,
					"content": "Лучше отдать боссу дыни без лишних слов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570522
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401570522,
					"content": "#Конечно. Ну, моя работа здесь закончена. Теперь, когда я доставил фиалковые дыни и встретился с {M#путешественником}{F#путешественницей}, мне пора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570523
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570523,
					"content": "Ты не участвуешь в мероприятии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570524
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401570524,
					"content": "Не волнуйся, я не пропущу сам фестиваль. У меня есть дела на острове Рито.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570525
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570525,
					"content": "Быть детективом - занятие не из лёгких. Приходится бегать туда-сюда... О, подожди-ка! Рито! Ты случайно ничего не знаешь о таинственном псе-ниндзя, который появился во время войны? Наверняка на острове Рито было немало пересудов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570526
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401570526,
					"content": "А, пёс? Он и послужил источником вдохновения для музыкального фестиваля, не так ли? Синобу вроде так мне говорила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570527
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570527,
					"content": "О... Неважно, Паймон думала, что у детектива может быть своя информация.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570528
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401570528,
					"content": "Я только предполагаю, но, исходя из своего опыта, скажу, что это, скорее всего, местная легенда. Сомневаюсь, что такая собака существует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570529
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570529,
					"content": "#Что такое, {NICKNAME}? Судя по выражению твоего лица, ты считаешь это серьёзным вопросом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570530
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570530,
					"content": "Интересно... Может, мне поспрашивать? Я всё равно собираюсь на остров Рито.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570531,
						401570532
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570531,
					"content": "А это не помешает твоей работе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570533
					]
				},
				{
					"id": 401570533,
					"content": "О, прекрати, пожалуйста. То, что для тебя важно, вероятно, и для меня окажется интересным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570534
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570534,
					"content": "Хе-хе, ждите от меня новостей. Увидимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570535
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401570535,
					"content": "Похоже, досин Сиканоин - одинокий волк. Что ж, мне лучше вернуться к доставке приглашений, чтобы наше мероприятие прошло с размахом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570536
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401570536,
					"content": "Нам тоже пора приниматься за дело. Интересно, как продвигается работа над списком...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570537
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401570537,
					"content": "Простите, что заставил вас ждать. Вот список. Если будете действовать по инструкции, всё будет в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570538
					],
					"speakerTitle": "Дворжак"
				},
				{
					"id": 401570538,
					"content": "#Отлично, ты как раз вовремя! {NICKNAME}, пора в путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570539
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401570539,
					"content": "Спасибо, я очень благодарен вам за помощь. Если в какой-то момент вам захочется потренировать музыкальные способности, приходите ко мне в зону репетиций.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дворжак"
				},
				{
					"id": 401570532,
					"content": "Сколько будут стоить твои услуги?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570533
					]
				}
			]
		},
		{
			"id": 4015706,
