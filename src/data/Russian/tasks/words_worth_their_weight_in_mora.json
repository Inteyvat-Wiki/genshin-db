			},
			"dialogs": [
				{
					"id": 718050501,
					"content": "#{M#Молодой человек}{F#Девушка}, вам чего?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050502
					],
					"speakerTitle": "Дядюшка Тянь"
				},
				{
					"id": 718050502,
					"content": "Вам книга от Цзи Фан.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "Чего?.. А, да, я заказывал «Песни равновесия» в книжном магазине «Ваньвэнь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "Дядюшка Тянь"
				},
				{
					"id": 718050504,
					"content": "Неплохо, неплохо, я как раз эту книгу ждал. Ха-ха. А я уж подумал, что у Цзи Фан слишком много покупателей и она забыла о моей книге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "Дядюшка Тянь"
				},
				{
					"id": 718050505,
					"content": "Прислали и замечательно... И переплёт такой хороший, Цзи Фан, как всегда, обходительна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "Дядюшка Тянь"
				},
				{
					"id": 718050506,
					"content": "Спасибо тебе за книгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дядюшка Тянь"
				}
			]
		},
