			"dialogs": [
				{
					"id": 718050601,
					"content": "О книгах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050602
					]
				},
				{
					"id": 718050602,
					"content": "#Уже доставил{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050603
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 718050603,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050604
					]
				},
				{
					"id": 718050604,
					"content": "Спасибо тебе. Книжный магазин «Ваньвэнь» до сих пор существует именно благодаря этим старым клиентам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050605
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 718050605,
					"content": "А к тому же они истинные ценители книг. Они наверняка оценят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050606
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 718050606,
					"content": "#Путешественни{F#ца}{M#к}, спасибо за твою помощь. Вот, возьми в награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050607
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 718050607,
					"content": "Если тебе понадобятся какие-нибудь книги - обращайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзи Фан"
				}
			]
		},
