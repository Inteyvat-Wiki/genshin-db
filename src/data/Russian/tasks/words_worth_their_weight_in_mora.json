					"nextDialogs": [
						718050702
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 718050702,
					"content": "Эти двое - мои старые клиенты, я обычно заранее готовлю для них книги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050703
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 718050703,
					"content": "Но так много покупателей вдруг, и я в итоге закопалась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050704
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 718050704,
					"content": "Они, наверное, уже заждались...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзи Фан"
				}
