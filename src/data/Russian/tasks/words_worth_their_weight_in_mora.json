			},
			"dialogs": [
				{
					"id": 718050401,
					"content": "#{M#Молодой человек}{F#Девушка}, вам чего?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050402
					],
					"speakerTitle": "Дэань Гун"
				},
				{
					"id": 718050402,
					"content": "Вам книга от Цзи Фан.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "Это «Властелин Инкогнито. Том IV»? Давно я его заказывал. И почему так долго?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "Дэань Гун"
				},
				{
					"id": 718050404,
					"content": "Дай-ка взглянуть... О? Первое издание? Неудивительно, что так долго...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "Дэань Гун"
				},
				{
					"id": 718050405,
					"content": "А я-то подумал, что Цзи Фан забыла обо мне из-за всех этих новых покупателей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "Дэань Гун"
				},
				{
					"id": 718050406,
					"content": "#Спасибо тебе, {M#молодой человек}{F#девушка}, что доставил{F#а} книгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэань Гун"
				}
			]
		},
