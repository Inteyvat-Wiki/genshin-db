			},
			"dialogs": [
				{
					"id": 3540401,
					"content": "Да хранит вас ветер, путники!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540402
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540402,
					"content": "Я Эмбер, скаут Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540403
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540403,
					"content": "Вы непохожи на жителей Мондштадта. Представьтесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540404
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540404,
					"content": "Нам не нужны неприятности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3540405,
					"content": "Все подозрительные личности так говорят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540406
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540406,
					"content": "#Здравствуй! Меня зовут {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540407
					]
				},
				{
					"id": 3540407,
					"content": "Странное имя. Ты не из этих краёв, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540408
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540408,
					"content": "А это что за существо с тобой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540409,
						3540412
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540409,
					"content": "Мы друзья.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540410
					]
				},
				{
					"id": 3540410,
					"content": "Мы познакомились только пару месяцев назад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3540411,
					"content": "Но уже стали лучшими друзьями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3540414,
					"content": "То есть вы путешествуете вдвоём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540415
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540415,
					"content": "Недалеко от Мондштадта видели дракона. Будет лучше, если вы немедленно отправитесь в город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540416
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540416,
					"content": "Я провожу вас. Здесь совсем недалеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540417
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540417,
					"content": "Что? Разве у тебя нет других дел?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3540418,
					"content": "Конечно, есть! Не переживайте, мне не составит труда обеспечить вашу безопасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540419
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540419,
					"content": "К тому же... Я ещё не решила, можно ли доверять вам двоим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540420,
						3540421
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540420,
					"content": "Ты нам не веришь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540422,
					"content": "Ой, наверное, мне не стоит разговаривать таким тоном. Я же рыцарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540423
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540423,
					"content": "Примите мои извинения, незнакомые, но... почтенные путешественники.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540424
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540424,
					"content": "Звучит не очень искренне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540425
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3540425,
					"content": "Чем тебе не нравятся формулировки, рекомендованные «Руководством для рыцарей Ордо Фавониус»?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3540421,
					"content": "Разве можно так обращаться с гостями?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540412,
					"content": "Живая консерва.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540413
					]
				},
				{
					"id": 3540413,
					"content": "А вот и нет! Это даже обиднее, чем «существо»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}