			"trigger": {
				"objectNames": [
					"Флора"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200710201,
					"content": "Ну, как цветы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710202
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200710202,
					"content": "Мне очень жаль...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710203
					]
				},
				{
					"id": 200710203,
					"content": "Хм? Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710204
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200710204,
					"content": "Произошёл несчастный случай и твоих цветов не стало...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710205
					]
				},
				{
					"id": 200710205,
					"content": "Как не стало?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710206
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200710206,
					"content": "У-у-у... Я их специально отбирала. Эти цветы такие хорошие, такие редкие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710207
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200710207,
					"content": "Неужели в горах настолько опасно, что даже такой искатель приключений, как ты, не может просто отнести туда коробки?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710208
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200710208,
					"content": "#Но всё равно спасибо тебе за то, что удосужил{F#ась}{M#ся} помочь. Пожалуйста, возьми это в знак благодарности. А мне пора возвращаться к цветам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710209
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200710209,
					"content": "Эх, пожалуй, придётся пробовать способ Сары...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флора"
				}
			]
		},
