			"dialogs": [
				{
					"id": 700610101,
					"content": "Ох, опять... Ну почему это никак не прекратится? Наказание какое-то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610102
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610102,
					"content": "Я снова опоздаю с доставкой. И как объяснить покупателям, почему они не получили цветы вовремя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610103
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610103,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610104
					]
				},
				{
					"id": 700610104,
					"content": "Посмотрите, всё поле истоптано... Тут росли такие красивые цветы. А теперь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610105
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610105,
					"content": "И всему виной этот негодник!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610106
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610106,
					"content": "Как бесчеловечно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610107
					]
				},
				{
					"id": 700610107,
					"content": "Вот именно! Хотя... он вообще-то не человек, а лесной кабан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610108
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610108,
					"content": "Почему-то в последнее время он постоянно прибегает сюда, грызёт цветы и катается по грядкам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610109
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610109,
					"content": "Настоящий хитрюга: стоит показаться людям, как он сразу убегает. А недавно чуть не сбил с ног проходящего мимо старика...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610110
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610110,
					"content": "Словом, это не кабан, а настоящий свинтус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610111
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610111,
					"content": "#Хм, подожди... Ты ведь почётный рыцарь? {F#Великая героиня, которая спасла}{M#Великий герой, который спас} Мондштадт? Пожалуйста, помоги мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610112
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610112,
					"content": "Хорошо, я прогоню его!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610113
					]
				},
				{
					"id": 700610113,
					"content": "#Как хорошо, что ты {F#согласилась}{M#согласился} помочь... По-моему, он убежал в долину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610114
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610114,
					"content": "Он очень хитёр! Возможно, придётся выманивать его цветами... Правда, вы сами видите, во что превратилось моё поле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610115
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610115,
					"content": "Вот что: соберите по дороге несколько ветроцветов и выманите его! Пусть узнает, каково это - когда тебя обманывают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Леопольдина"
				}
			]
		},
