			"dialogs": [
				{
					"id": 700610701,
					"content": "О... вы вернулись? Ну как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610702
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610702,
					"content": "Мы его прогнали!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610703
					]
				},
				{
					"id": 700610703,
					"content": "Огромное вам спасибо! Вот, возьмите это в награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610704
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610704,
					"content": "Каждый должен быть вознаграждён за свои труды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610705
					],
					"speakerTitle": "Леопольдина"
				},
				{
					"id": 700610705,
					"content": "Теперь можно снова высадить цветы на поле. Надеюсь, отныне разные «бесчеловечные» гости будут обходить его стороной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
