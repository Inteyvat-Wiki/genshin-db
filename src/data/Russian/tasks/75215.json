			"trigger": {
				"objectNames": [
					"Кэрих"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150101,
					"content": "Ну что? Тебя тоже заинтересовал лагерь силовых тренировок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150102
					],
					"speakerTitle": "Кэрих"
				},
				{
					"id": 752150102,
					"content": "Можешь пользоваться любым спортивным оборудованием. Только смотри, не надорвись. А то я смотрю, ручки у тебя совсем тонюсенькие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150103,
						752150104
					],
					"speakerTitle": "Кэрих"
				},
				{
					"id": 752150103,
					"content": "Эй, я каждый день тренируюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				},
				{
					"id": 752150105,
					"content": "Серьёзно? Чем хвастаться, лучше померься силами с большим кубом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150106
					],
					"speakerTitle": "Кэрих"
				},
				{
					"id": 752150106,
					"content": "#<color=#00E1FFFF>Атакуй</color> или <color=#00E1FFFF>протарань</color> большой куб, чтобы заработать очки. Чем сильнее будет удар, тем больше очков заработаешь. Посмотрим, на что ты {F#способна}{M#способен}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэрих"
				},
				{
					"id": 752150104,
					"content": "Я отправляю хиличурлов в полёт одним ударом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				}
			]
		},
		{
			"id": 7521502,
			"completionStepIds": [
				7521502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7521502",
							"2"
						],
						"stepId": 7521502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кэрих"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150201,
					"content": "Да ладно! Тебе удалось отбить у куба целый угол?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150202
					],
					"speakerTitle": "Кэрих"
				},
				{
					"id": 752150202,
					"content": "На моей памяти последней, кто это сделал, была Вареса... Похоже, у тебя настоящий талант, совсем как у неё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150203,
						752150204
					],
					"speakerTitle": "Кэрих"
				},
				{
					"id": 752150203,
					"content": "Это было довольно тяжело.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				},
				{
					"id": 752150205,
					"content": "Верно говорят, внешность обманчива. Знаешь, я готов позвать тебя работать тренером, если ты не возражаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150206
					],
					"speakerTitle": "Кэрих"
				},
				{
					"id": 752150206,
					"content": "Кстати, говорят, благодатный сок помогает повысить эффективность тренировок. Ученики его обожают. Попробуй и ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэрих"
				},
				{
					"id": 752150204,
					"content": "Ха, плёвое дело!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				}
			]
		},
		{
			"id": 7521503,
