				"points": []
			},
			"dialogs": [
				{
					"id": 752150301,
					"content": "Набрать новых людей не трудно, да только спустя некоторое время они начинают прогуливать тренировки, а некоторые и вовсе пропадают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150302
					],
					"speakerTitle": "Кэрих"
				},
				{
					"id": 752150302,
					"content": "Тренер придумывает разные способы, чтобы поддерживать в своих подопечных интерес к тренировкам, и испытание большим кубом - один из таких способов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150303
					],
					"speakerTitle": "Кэрих"
				},
				{
					"id": 752150303,
					"content": "Но чтобы набрать больше очков, некоторые люди стали с разбегу налетать на куб, в итоге они выходят с испытания с разбитыми носами и ещё чаще отпрашиваются с тренировок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэрих"
				}
			]
		},
