					"Хуссени"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715050101,
					"content": "#{NICKNAME}, наконец-то ты здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050102
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050102,
					"content": "Пусковая настройка прошла успешно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050103
					]
				},
				{
					"id": 715050103,
					"content": "Да, всё в порядке. Я всё ещё немного волнуюсь, но мы можем оставить их только там, в штольнях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050104
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050104,
					"content": "Ещё я попросил Хедива сделать лекарство, передам его Ту и Хао.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050105
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050105,
					"content": "#{NICKNAME}, запусти шип, а затем запечатай выход артерий земли, откуда выходит чёрная грязь. Это нужно сделать обязательно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050106
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050106,
					"content": "Сначала Хедив просто позвал меня помочь ему решить проблему, в то время я думал, что если не смогу этого сделать, то в крайнем случае заберу шип и вернусь в Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050107
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050107,
					"content": "В любом случае экспериментальных данных по шипу Пурсины хватило бы для подробного доклада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050108
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050108,
					"content": "Но Ту, Хао и другие люди, что живут здесь... Ведь тогда они будут вынуждены до конца жизни существовать рядом с этой опасностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050109
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050109,
					"content": "Если мои исследования не могут им помочь и нужны только для доклада, то какой в них смысл?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050110
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050110,
					"content": "Вот почему я стал искать способ решить проблему выхода чёрной грязи из артерий земли. Кроме того, прямое соприкосновение с чёрной грязью... тревожный знак для меня, как для учёного из Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050111
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050111,
					"content": "#Я верю в твою силу, но место, где выходит чёрная грязь опасно, будь {F#осторожна}{M#осторожен}, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050112,
						715050113
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050112,
					"content": "Понятно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				},
				{
					"id": 715050114,
					"content": "Ха-ха-ха, кхе-кхе... кхе-кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050115
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050115,
					"content": "#Вообще-то я говорил о тебе, {NICKNAME}. Хотя шип Пурсины активируется около выхода и может уменьшить воздействие чёрной грязи на монстров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050116
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050116,
					"content": "...всё же там слишком много монстров, которых привлекла чёрная грязь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050117
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050117,
					"content": "Береги себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715050113,
					"content": "Я позабочусь о шипе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				}
			]
		}
	]
}