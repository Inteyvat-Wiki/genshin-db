					}
				]
			},
			"dialogs": [
				{
					"id": 760650101,
					"content": "А вот и ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650102
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650102,
					"content": "Коломбина... ты здесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650103
					]
				},
				{
					"id": 760650103,
					"content": "Да, а теперь и ты здесь. Мы здесь вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650104
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650104,
					"content": "Говоришь так, будто знала, что я приду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650105
					]
				},
				{
					"id": 760650105,
					"content": "Я не знала, когда именно, но ты всегда приходишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650106
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650106,
					"content": "Как между Луной и Тейватом есть притяжение... так и ты всегда сможешь найти меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650107
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650107,
					"content": "Иди сюда, давай посидим вместе. Я оставила тебе место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650108
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650108,
					"content": "В прошлый раз мы были на твоём корабле и любовались Тейватом. А в этот раз давай полюбуемся звёздным небом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650109
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650109,
					"content": "Нин Нин и её предшественников манило звёздное небо. У него своя, особенная сила притяжения. Я это чувствую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650110
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650110,
					"content": "Нин Нин и сообщение, которое она отправила...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650111
					]
				},
				{
					"id": 760650111,
					"content": "Не волнуйся, с ней всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650112
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650112,
					"content": "Она прошла очень, очень долгий путь в полной безопасности. Настолько долгий, что я уже не чувствую той силы, которая направляла её на этом пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650113
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650113,
					"content": "Но мне любопытно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650114
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650114,
					"content": "Что тебя интересует?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650115
					]
				},
				{
					"id": 760650115,
					"content": "Хм, много чего. Например, может ли послание созерцателя луны дойти до кого-то другого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650116
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650116,
					"content": "Кто бы его ни получил, или что бы его ни получило... кем они могут быть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650117
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650117,
					"content": "Что они думают? Они, как и мы, знают, что такое любовь и ненависть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650118
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650118,
					"content": "Они, как и мы, не могут оторвать взгляд от прекрасного и таинственного звёздного неба над головой, даже когда Бездна подступает со всех сторон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650119
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650119,
					"content": "Они, как и мы, хотят найти кого-то, помахать рукой и сказать: «Привет, друг, приятно познакомиться»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650120
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650120,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650121
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650121,
					"content": "Есть ли в глубине этого звёздного неба цивилизации, которые не поглотила тьма?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650122
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650122,
					"content": "Думаю, да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650123
					]
				},
				{
					"id": 760650123,
					"content": "М?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650124
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650124,
					"content": "Наш корабль однажды принял сообщение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650125
					]
				},
				{
					"id": 760650125,
					"content": "Что за сообщение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650126
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650126,
					"content": "Почти всё его значимое содержание было утрачено.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650127
					]
				},
				{
					"id": 760650127,
					"content": "Но оно определённо принадлежало разумной цивилизации.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650128
					]
				},
				{
					"id": 760650128,
					"content": "Оно было неполным... потому что преодолело большое расстояние?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650129
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650129,
					"content": "Но это всё равно повод для радости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650130
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650130,
					"content": "#Кстати, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650131
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650131,
					"content": "М?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650132
					]
				},
				{
					"id": 760650132,
					"content": "Твой родной дом тоже где-то там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650133
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650133,
					"content": "#Если однажды ты захочешь вернуться туда, откуда начал{F#а} свой путь, и навести там порядок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650134
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650134,
					"content": "#Я с удовольствием помогу, так же как ты помогал{F#а} мне прибраться на Луне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650135
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650135,
					"content": "Тогда я обязательно приглашу тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650136
					]
				},
				{
					"id": 760650136,
					"content": "Ещё одна вечеринка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650137
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650137,
					"content": "Ещё одна вечеринка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650138
					]
				},
				{
					"id": 760650138,
					"content": "Тогда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650139
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650139,
					"content": "Назовём её «Ночь возвращения домой»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650140
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650140,
					"content": "А может, это будет день?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650141
					]
				},
				{
					"id": 760650141,
					"content": "Тогда будем веселиться день напролёт. Позовём всех друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650142
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 760650142,
					"content": "Отличная идея.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650143
					]
				},
				{
					"id": 760650143,
					"content": "Пусть та ночь придёт под ясным небом... Пусть она придёт вместе с воссоединением друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Коломбина"
				}
			]
		}
	]
}