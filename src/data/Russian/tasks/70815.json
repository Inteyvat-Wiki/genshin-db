			"dialogs": [
				{
					"id": 708150901,
					"content": "Кукла, воздушный змей, мельничка... Я знала, что папа мне опять их подарит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150902
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150902,
					"content": "Жаль, что я приготовила подарки, а папа их не получит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150903
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150903,
					"content": "Давай их мне, а я отнесу их папе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150904
					]
				},
				{
					"id": 708150904,
					"content": "#Ты правда мне поможешь? Ну... С чудовищами ты справил{F#ась}{M#ся} и без Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150905
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150905,
					"content": "Давай так и сделаем. Спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150906
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150906,
					"content": "Эх, вот бы мне стать такой же сильной, как и ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малышка Лю"
				}
