			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бабуля Жо Синь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150501,
					"content": "Ой, куда это она убежала?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150502
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150502,
					"content": "Насчёт малышки Лю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150503
					]
				},
				{
					"id": 708150503,
					"content": "Так вы ищете малышку Лю? Ох, если б вы в другое время пришли... Я её сама обыскалась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150504
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150504,
					"content": "Несколько дней назад ей от отца из Ли Юэ пришло письмо, где говорилось, что он скоро приедет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150505
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150505,
					"content": "Малышка Лю так обрадовалась. Всё говорила, что нужно приготовить папе подарок, и подбивала других деток пойти за цветами да ягодами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150506
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150506,
					"content": "А позже пришло ещё одно. Отца вызывают на службу, и приехать он не сможет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150507
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150507,
					"content": "Она закатила истерику, уговоры даже слушать не стала. Упёрлась, мол, если папа не приедет к ней, тогда она сама приедет к папе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150508
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150508,
					"content": "Но мы-то думали, что она шутит, а этим утром её и хватились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150509
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150509,
					"content": "Все кто мог, уже отправились её искать. Если вы хотите, можете присоединиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150510,
						708150512
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150510,
					"content": "Мы так и сделаем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150511
					]
				},
				{
					"id": 708150511,
					"content": "Вы нам очень поможете. Ох, уж эта девчонка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150512,
					"content": "Как думаете, куда она могла пойти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150513
					]
				},
				{
					"id": 708150513,
					"content": "Далеко уйти она не могла. Она точно где-нибудь поблизости, но места тут дремучие есть, опасные... Скорее идите её искать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабуля Жо Синь"
				}
			]
		},
		{
