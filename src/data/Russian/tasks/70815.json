			"dialogs": [
				{
					"id": 708150601,
					"content": "Цзя И тоже хорош. Разве можно пообещать и не приехать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150602,
					"content": "Малютка его почти что раз в год видит. И куда такое годится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150603,
					"content": "Он делает это ради Ли Юэ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "Цзя И сам так из года в год твердит. Столько раз он повторял эти слова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150605,
					"content": "Служба у него такая...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "А о дочери кто заботиться будет? Она ведь на глазах растёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150607,
					"content": "Придёт время, он оставит службу и вернётся, а тогда уж уедет Лю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 708150608,
					"content": "И всё отцу и дочери не встретиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабуля Жо Синь"
				}
			]
		},
