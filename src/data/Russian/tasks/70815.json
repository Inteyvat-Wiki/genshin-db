			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Малышка Лю"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150801,
					"content": "Вы чего за мной ходите? Я же сказала, что иду в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150802
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150802,
					"content": "Чудовищ я обойду осторожненько, и меня они не увидят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150803
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150803,
					"content": "Не надо со мной, как с ребёнком. Я уже взрослая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150804
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150804,
					"content": "Это тебе от папы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150805
					]
				},
				{
					"id": 708150805,
					"content": "От папы? Это он попросил вас принести?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150806
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150806,
					"content": "Там точно какие-нибудь детские игрушки. Не воздушный змей, так кукла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150807
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150807,
					"content": "Тебе что, не нравится?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150808
					]
				},
				{
					"id": 708150808,
					"content": "...Нравится. Как же мне могут папины подарки не понравиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150809
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150809,
					"content": "Но если я всегда буду любить игрушки, значит, я никогда не вырасту?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150810
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150810,
					"content": "Если я всё буду играть, то когда я стану искателем приключений или получу собственный Глаз Бога?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150811
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150811,
					"content": "А зачем тебе Глаз Бога?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150812
					]
				},
				{
					"id": 708150812,
					"content": "С Глазом Бога можно столько всего сделать! Денег, например, заработать, или ещё чего-нибудь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150813
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150813,
					"content": "Тогда папе не пришлось бы постоянно быть на службе в Ли Юэ. Он бы вернулся и побыл со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150814
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150814,
					"content": "Вот видишь, мне без Глаза Бога даже до Ли Юэ не дойти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150815
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150815,
					"content": "Но раз папа попросил вас принести мне подарки, я лучше к нему не пойду, не то у него ещё неприятности будут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150816
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150816,
					"content": "<color=#00E1FFFF>А я ведь тоже приготовила ему подарок</color>, хотела сделать сюрприз... Но принести его папе я не могу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150817
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150817,
					"content": "<color=#00E1FFFF>Если бы кто-нибудь мог передать</color>... А, ладно. И ходить за мной не надо, дорогу обратно я знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малышка Лю"
				}
			]
		},
