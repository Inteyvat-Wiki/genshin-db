			},
			"dialogs": [
				{
					"id": 708150701,
					"content": "Вы пришли, чтобы поймать меня и вернуть в деревню Цинцэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150702,
					"content": "Бабуля Жо Синь беспокоится о тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "Хм! Никуда я не пойду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150706,
					"content": "Возвращайтесь в деревню и скажите всем, что я пошла в Ли Юэ за папой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150707,
					"content": "Я его найду, поговорю с ним немного, а потом вернусь. Пускай они там не переживают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 708150704,
					"content": "#Я тебе кое-что прин{F#есла}{M#ёс}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "Ничего мне от вас не надо. Меня так просто не подкупишь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Малышка Лю"
				}
			]
		},
		{
			"id": 7081508,
			"completionStepIds": [
				7081508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
