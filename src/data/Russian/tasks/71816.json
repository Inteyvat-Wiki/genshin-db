		},
		{
			"id": 7181604,
			"completionStepIds": [
				7181605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181605",
							"2"
						],
						"stepId": 7181605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Фрэнсис"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160401,
					"content": "Это... товары, которые я заказал. Архонты, ну наконец-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160402
					],
					"speakerTitle": "Фрэнсис"
				},
				{
					"id": 718160402,
					"content": "Судя по твоей одежде, ты родом не из Ли Юэ, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160403
					],
					"speakerTitle": "Фрэнсис"
				},
				{
					"id": 718160403,
					"content": "#Пробовал{F#а} ты деликатесы Ли Юэ или нет, но они просто восхитительны. Уж поверь мне, их должен попробовать каждый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160404
					],
					"speakerTitle": "Фрэнсис"
				},
				{
					"id": 718160404,
					"content": "Ладненько. Раз мой товар приехал, я могу спокойно насладиться едой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фрэнсис"
				}
			]
		},
		{
			"id": 7181605,
