			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Жёлтая рубаха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160101,
					"content": "И как мне это всё доставить?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160102
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160102,
					"content": "Что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160103
					]
				},
				{
					"id": 718160103,
					"content": "#Ты, должно быть, путешественни{F#ца}{M#к}. Тебе повезло попасть в Ли Юэ к самому началу Праздника морских фонарей. Мне же радоваться нечему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160104
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160104,
					"content": "На Праздник морских фонарей мы по традиции запускаем небесные фонари. Из-за этого объём материалов для сборки фонарей, поставляемых каждый год, поражает воображение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160105
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160105,
					"content": "Может, я заблуждаюсь, но в этом году объём груза куда больше, чем когда-либо ранее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160106
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160106,
					"content": "Мне одной не справиться. А этот купец из Фонтейна ещё подгоняет постоянно. Хоть бы состояние дорог в Ли Юэ учитывал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160107
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160107,
					"content": "Я ищу помощника, но подходящих людей встретить пока не довелось. Что скажешь, возьмёшься за сопровождение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160108,
						718160111
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160108,
					"content": "Без проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160109
					]
				},
				{
					"id": 718160109,
					"content": "Отлично! Обожаю тех, кто лёгок на подъём. Если бы ещё и сопровождаемый был таким же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160110
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160110,
					"content": "Зовут его Фрэн... Как бишь его... Фрэнсис, вот. С этими иноземными именами язык сломать можно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160115,
					"content": "Если ты берёшься, встретимся там, где хранится товар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160116
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160116,
					"content": "Точное место я помечу на твоей карте. Мне пора. Встретимся там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160111,
					"content": "Купец из Фонтейна?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160112
					]
				},
				{
					"id": 718160112,
					"content": "Верно. Как его там... Фрэн... Фрэнсис, кажется. Ну и имена у этих иноземцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160113
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160113,
					"content": "Ума не приложу, зачем ему такая крупная партия материалов, но... Раз он платит, за мной не заржавеет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160114
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160114,
					"content": "По выполнению работы свою долю ты получишь, обещаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Жёлтая рубаха"
				}
			]
		},
		{
			"id": 7181602,
			"completionStepIds": [
				7181603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
