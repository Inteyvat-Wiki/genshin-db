			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Жёлтая рубаха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160501,
					"content": "Я связалась с Фрэнсисом. Товар он получил, большое тебе спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160502
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160502,
					"content": "Когда это ты успела?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160503
					]
				},
				{
					"id": 718160503,
					"content": "Ха-ха, не обращай внимания. Наёмники вроде меня на своих двоих куда быстрее, чем остальные. По части связи... мы тоже очень быстры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160504
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160504,
					"content": "Благодаря тебе всё прошло гладко. Оплатить должным образом труд - святая обязанность. Подожди немного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160505
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160505,
					"content": "Ты тоже не можешь отдохнуть на праздник?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160506
					]
				},
				{
					"id": 718160506,
					"content": "В нашем деле когда густо, а когда и пусто. Даже на Праздник морских фонарей дома не бываешь... Но, ничего не поделаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160507
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160507,
					"content": "Если ты путешествуешь, обязательно посети Ли Юэ. Сейчас там как раз проходит Праздник морских фонарей, и все запускают небесные фонарики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160508,
						718160510
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160508,
					"content": "А что насчёт тебя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160509
					]
				},
				{
					"id": 718160509,
					"content": "Я годами в разъездах, и всё никак не найду времени запустить фонарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160512,
					"content": "Будь под рукой готовый, я бы запустила на удачу. Но времени делать его вообще нету...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160513
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160513,
					"content": "Дух праздника проходит мимо, но это ничего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160514,
						718160515
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160514,
					"content": "А давай я сделаю тебе фонарик.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
