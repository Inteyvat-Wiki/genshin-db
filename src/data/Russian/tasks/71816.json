			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Жёлтая рубаха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160201,
					"content": "Товар наш хранится здесь. Не переживай, о многом я просить тебя не стану. Тебе нужно будет лишь сопроводить этот товарный аэростат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160202
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160202,
					"content": "Должна напомнить, что весь перевозимый груз состоит из материалов для небесных фонарей, а они крайне хрупкие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160203
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160203,
					"content": "Нельзя, чтобы они повредились или сгорели. Поэтому, прошу тебя, соблюдай осторожность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160204
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160204,
					"content": "#На этом пути иногда встречаются чудовища и Похитители сокровищ, так что будь готов{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160205
					],
					"speakerTitle": "Жёлтая рубаха"
				},
				{
					"id": 718160205,
					"content": "Ну, я оставляю караван на тебя. После того, как товар в сохранности приедет к Фрэнсису, встречаемся на мосту к юго-западу от горы Тигра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Жёлтая рубаха"
				}
			]
		},
		{
			"id": 7181603,
