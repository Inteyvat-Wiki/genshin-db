				"points": []
			},
			"dialogs": [
				{
					"id": 726560101,
					"content": "Смелее, попробуй сыграть в «Театр Механикус»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560102,
						726560106
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560102,
					"content": "Что это такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560103
					]
				},
				{
					"id": 726560103,
					"content": "О, приветствую! Я рекламирую новую игру из Ли Юэ. Она называется «Театр Механикус»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560104
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560104,
					"content": "Если вкратце, это такая настольная игра. Её изобрела госпожа Жуй Цзинь из Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560105
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560105,
					"content": "Ну, госпожа Жуй Цзинь утверждает, что я одна из их заморских агентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560111,
					"content": "Стоило мне получить... э-э... права распространителя, госпожа Жуй Цзинь прислала мне полный комплект «Театра Механикус» с приложенной к нему бизнес-моделью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560112
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560112,
					"content": "Но Инспекция по делам чужеземцев конфисковала посылку... Пришлось потрудиться, прежде чем «Театр Механикус» вернулся ко мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560113
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560113,
					"content": "Но почему Инспекция по делам чужеземцев конфисковала игру?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560114
					]
				},
				{
					"id": 726560114,
					"content": "Они конфискуют всё, что приходит в Инадзуму по морю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560115
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560115,
					"content": "Ну, ладно. Не будем об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560116
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560116,
					"content": "Видите фигурки на столе? Они все используются в игре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560117
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560117,
					"content": "Совсем как в Ли Юэ, да? Всё это воссоздано по описаниям из письма госпожи Жуй Цзинь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560118
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560118,
					"content": "Даже стол сделан на заказ... Обошёлся мне в целое состояние.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560119
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560119,
					"content": "И ещё. По рекомендации госпожи Жуй Цзинь теперь «Театр Механикус» дополнен новым режимом игры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560120
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560120,
					"content": "#Так... Ты, похоже, запутал{F#ась}{M#ся}. Может, попробуешь поиграть? В процессе разберёшься, что и как.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560121,
						726560123
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560121,
					"content": "Сыграть в «Театр Механикус».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560122
					]
				},
				{
					"id": 726560122,
					"content": "#Без проблем. Веселись. Это совершенно новый «Театр Механикус». Разочарован{F#а}{M#} не будешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560123,
					"content": "#Я пока занят{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560124
					]
				},
				{
					"id": 726560124,
					"content": "Ладно, попробуешь, когда будешь посвободнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560106,
					"content": "И как этот «Театр Механикус» оказался здесь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560107
					]
				},
				{
					"id": 726560107,
					"content": "Приветствую... А? Ты знаешь, что это за штука - «Театр Механикус»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560108
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560108,
					"content": "А... Понимаю. Должно быть, тебе уже доводилось играть в неё в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560109
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560109,
					"content": "Госпожа Жуй Цзинь сказала мне, что уже представила эту игру на Празднике морских фонарей... Значит, ей удалось кого-то заинтересовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560110
					],
					"speakerTitle": "Комаката"
				},
				{
					"id": 726560110,
					"content": "В общем, госпожа Жуй Цзинь назначила меня одним из международных представителей «Театра Механикус» в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Комаката"
				}
			]
		}
	]
}