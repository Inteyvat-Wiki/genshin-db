				"points": []
			},
			"dialogs": [
				{
					"id": 110020701,
					"content": "Всё равно чего-то не хватает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020702,
						110020703
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020702,
					"content": "Чего именно нам не хватает?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				},
				{
					"id": 110020704,
					"content": "Не хватает... Шака-лакa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020705
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020705,
					"content": "Точно! Не хватает немного шака-лака бум-бум!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020706,
						110020707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110020706,
					"content": "Шака-лака?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020708,
					"content": "Да-да-да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110020709,
					"content": "Хоть Брук и слепо следует установленным правилам, она всё равно очень талантливый повар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020710
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020710,
					"content": "Без сомнений у неё будут превосходные продукты. Чтобы победить, нам придётся постараться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020711
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020711,
					"content": "Например, холодная закуска из морских чудовищ, хрустящие лепестки цветка цинсинь, лесные грибы в слаймовом желе! М-м-м...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020712
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020712,
					"content": "Слаймовое желе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020713
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110020713,
					"content": "Ха-ха! Да, я знаю, звучит так себе, но на вкус бесподобно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020714
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020714,
					"content": "Надо будет угостить тебя слизнегрибом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020715,
						110020717
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020715,
					"content": "Жду не дождусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020716
					]
				},
				{
					"id": 110020716,
					"content": "Ты не пожалеешь! Хотя в первый раз этот вкус может показаться слегка странным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020719,
					"content": "Ладно, забудь. Давай проверим ещё одно место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020720
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020720,
					"content": "Чувствую, что нас там ждёт нечто интересненькое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020717,
					"content": "Спасибо, но не стоит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020718
					]
				},
				{
					"id": 110020718,
					"content": "Почему? Это же такая вкуснятина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020707,
					"content": "Паймон, ты поняла о чём речь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020703,
					"content": "Хочешь сказать, что этого недостаточно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				}
			]
		}
	]
