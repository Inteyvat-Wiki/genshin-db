			"dialogs": [
				{
					"id": 110020201,
					"content": "Мы уже близко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020202
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020202,
					"content": "Ты уже знаешь, что именно мы ищем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110020203,
					"content": "Нет, конечно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020204
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020204,
					"content": "Тогда откуда такая уверенность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110020205,
					"content": "Я всегда так работаю. Если заранее знаешь, что будешь готовить, то блюдо потеряет элемент неожиданности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020206
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020206,
					"content": "Если бы я знала, что именно ищу, то никакого сюрприза бы не вышло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020207
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020207,
					"content": "Звучит весьма... Рискованно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110020208,
					"content": "Расслабься. Именно так я создавала свои лучшие рецепты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020209
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110020209,
					"content": "Осмотрись кругом. Дай мне знать, если найдёшь что-то интересное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сян Лин"
				}
			]
		},
		{
