			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй",
					"Цю Эр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010501,
					"content": "#О, ты вернул{F#ась}{M#ся}! Тебе удалось выполнить моё поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010502
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010502,
					"content": "Да, удалось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010503
					]
				},
				{
					"id": 227010503,
					"content": "Этого должно хватить. Благодарю тебя, друг. Прими это в знак моей благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010504
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010504,
					"content": "Что? Зачем все эти цветки цинсинь? О нет! Тебя опять мучают головные боли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цю Эр"
				}
			]
		},
		{
			"id": 2270106,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
							"2"
						],
						"stepId": 2270105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй",
					"Цю Эр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010601,
					"content": "Да, цветки должны облегчить его головную боль.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010602
					]
				},
				{
					"id": 227010602,
					"content": "Я бы с радостью принесла тебе лекарство... Зачем ты попросил об этом случайных прохожих?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010603
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 227010603,
					"content": "К тому же мы ничего о них не знаем. Что если?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010604
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 227010604,
					"content": "Довольно, Цю Эр! Они ведь помогли нам, не так ли? Нет нужды ссориться с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010605
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010605,
					"content": "Спасибо. Это тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010606
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010606,
					"content": "Давай, поторапливайся! У братишки болит голова, ему нельзя долго находиться на ветру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010607
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 227010607,
					"content": "Скорее, надо спрятать тебя от ветра. Сейчас я заварю тебе сладкий чай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цю Эр"
				}
			]
		},
		{
			"id": 2270107,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
							"2"
						],
						"stepId": 2270105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй",
					"Цю Эр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010701,
					"content": "На самом деле, цветки для твоего горла.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010702
					]
				},
				{
					"id": 227010702,
					"content": "О, друг! Зачем же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010703
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010703,
					"content": "Хочешь сказать, что я слабачка? От небольшого ветерка у меня сразу горло разболелось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010704
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 227010704,
					"content": "Хотя бы цветки цинсинь не пропадут напрасно. Отвар поможет справиться с твоей головной болью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
