			"dialogs": [
				{
					"id": 227010101,
					"content": "Привет, друг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010102
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010102,
					"content": "Судя по твоей гордой осанке и лёгкой поступи, ты тоже практикуешь боевые искусства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				}
			]
		},
		{
			"id": 2270102,
			"completionStepIds": [
				2270101,
				2270106
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270101",
							"2"
						],
						"stepId": 2270101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "Говори как есть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "Эй! Прояви уважение, когда разговариваешь с ним, понятно?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 227010203,
					"content": "Прошу, не стоит... Я же первый с ними заговорил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010204,
					"content": "Хм... Если только это не ещё один идиот, который ищет Адептов и хочет занять наше место!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 227010205,
					"content": "Да, хорошо, спасибо... Со мной всё будет в порядке. Почему бы тебе не насладиться заслуженным отдыхом? А я пока побеседую с нашим новым другом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010206,
					"content": "Но ты ведь не скажешь им ничего такого, чего не сказал бы при мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 227010207,
					"content": "Мы будем говорить о скучных вещах. Поверь, тебе будет неинтересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010208,
					"content": "Понятненько. Ты опять собираешься говорить о Гухуа... Если не хочешь, я не буду слушать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 227010209,
					"content": "Друг мой, подойди поближе. Теперь мы можем поговорить серьёзно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				}
			]
		},
