			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010401,
					"content": "Это место подойдёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010402
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010402,
					"content": "Что происходит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010403
					]
				},
				{
					"id": 227010403,
					"content": "Эх... Цю Эр... Мы всегда тренировались вместе и были неразлучны. Её таланты ничуть не уступают моим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010404
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010404,
					"content": "Мы пришли искать помощи у Адептов, но путешествие выдалось не из лёгких, а моя спутница болтает без перерыва... Несколько дней назад она простудилась, и у неё до сих пор болит горло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010405
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010405,
					"content": "Я вижу, что ты обладаешь великой силой... Позволь мне смиренно попросить тебя помочь нам. Если ты принесёшь мне три цветка цинсинь, то я смогу приготовить отвар, который облегчит страдания моей спутницы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010406,
						227010408
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010406,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010407
					]
				},
				{
					"id": 227010407,
					"content": "Друг, благодарю тебя. У Цю Эр тонкая душевная организация. Я не смогу оставить её одну и отправиться на поиски лекарства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010408,
					"content": "Но зачем делать это втайне от неё?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010409
					]
				},
				{
					"id": 227010409,
					"content": "Я понимаю твой интерес. У Цю Эр воинственный характер, и она отвергает саму идею слабости. Она никогда не признается, что у неё болит горло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010410
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010410,
					"content": "Если я осмелюсь предположить, что для её собственного блага требуется приготовить лекарство, то она отвергнет эту идею без малейших раздумий. Поэтому я вынужден действовать без её ведома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010411
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 227010411,
					"content": "Более того, я не осмелился бы оставить её в одиночестве. Я прошу тебя о помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				}
			]
		},
		{
			"id": 2270105,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
