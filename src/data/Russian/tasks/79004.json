			"dialogs": [
				{
					"id": 790040101,
					"content": "А? Смотри, на этом камне что-то нарисовано.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040102
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 790040102,
					"content": "Похоже на кораблекрушение... И ещё множество людей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040103
