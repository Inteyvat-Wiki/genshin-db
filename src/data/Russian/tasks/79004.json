				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790041201,
					"content": "Привет, друзья. Вам что-то нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041202
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790041202,
					"content": "А это... Вы же учёный?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790041203,
					"content": "Хе-хе, вроде был им. Если говорить точнее, то моя профессия - хранитель истории... Конечно, это тоже входит в определение «учёного».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041204
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790041204,
					"content": "Что у вас случилось? Столкнулись с вопросами, на которые может ответить только учёный?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041205
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790041205,
					"content": "Дело вот в чём...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041206
					]
				},
				{
					"id": 790041206,
					"content": "Остров в море... И рисунки на этом острове. Интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041207
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790041207,
					"content": "И вы ищете учёного, который поможет вам разобраться в этих рисунках, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041208,
						790041210
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790041208,
					"content": "Вы поможете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041209
					]
				},
				{
					"id": 790041209,
					"content": "Конечно! Я никогда не откажусь пролить свет на что-то неисследованное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790041213,
					"content": "Давайте не будем терять времени. Покажите мне рисунки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041214
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790041214,
					"content": "Вот фотографии рисунков.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041215
					]
				},
				{
					"id": 790041215,
					"content": "Хм... Неплохо, неплохо. Простите, дайте мне немного времени на размышления...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Саид"
				},
				{
					"id": 790041210,
					"content": "Мы можем заплатить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041211
					]
				},
				{
					"id": 790041211,
					"content": "Ха-ха-ха, судя по всему, вы достаточно опытные искатели приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041212
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790041212,
					"content": "Но для меня лучшей платой будет исследование неизведанного. Больше мне от вас ничего не нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Саид"
				}
			]
		},
