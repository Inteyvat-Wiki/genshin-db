						"rawParams": [
							"7900402",
							"3"
						],
						"stepId": 7900402,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900419",
							"2"
						],
						"stepId": 7900419,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040301,
					"content": "Мы уже собрали столько рисунков. Может, у нас получится сложить из них историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7900404,
			"completionStepIds": [
				7900404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900404",
							"2"
						],
						"stepId": 7900404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Саид"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040401,
					"content": "Хм, понять историю на этих рисунках не составит особого труда. Хоть я и не уверен, что у нас получится сложить их в правильной последовательности, но мы можем начать с разбора каждого рисунка по отдельности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040402
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040402,
					"content": "Давай взглянем на этот рисунок. На нём изображена группа людей, потерпевших кораблекрушение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040403
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040403,
					"content": "Пережив крушение, они, должно быть, набрели на острова, где вы и нашли эти рисунки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040404
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040404,
					"content": "Они продолжили жить на этом острове.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040405
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040405,
					"content": "Давайте ещё раз взглянем на этот рисунок. Здесь изображено пять предметов, и в каждом из них - разные отметки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040406
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040406,
					"content": "Похоже на пять чашек с водой, но уровень воды в каждой из них отличается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040407
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040407,
					"content": "Проще говоря, такое изображение подразумевает изменение состояния объекта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040414,
						790040415
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040414,
					"content": "Изменение состояния объекта...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040408
					]
				},
				{
					"id": 790040408,
					"content": "Но я не могу понять, какого именно объекта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040409
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040409,
					"content": "Однако если здесь изображён остров в море, то это может быть и морская вода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040410
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040410,
					"content": "Давайте взглянем на другие рисунки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040411
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040411,
					"content": "Произошло ещё одно кораблекрушение, и на остров прибыли «гости».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040412
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040412,
					"content": "Смотрите, здесь одна группа людей пытается спасти другую. А здесь изображён разбитый корабль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040413
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040413,
					"content": "На первом рисунке корабль был изображён с целью передать катастрофу. На этой же разбитый корабль изображён детальнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040416
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040416,
					"content": "Возможно, для людей, живущих на острове, этот корабль имел какое-то особое значение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040417
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040417,
					"content": "Перейдём к следующему рисунку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040418
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040418,
					"content": "Вы и сами можете увидеть, что на изображённой здесь горе есть особый символ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040419
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040419,
					"content": "Предположу, что для этих людей отмеченное место имело какую-то особую важность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040422
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040422,
					"content": "А вот и последний рисунок. Здесь всё очевидно: они нашли способ покинуть остров и в итоге покинули его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040423
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040423,
					"content": "Вот и вся история, рассказанная на этих рисунках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040424,
						790040428
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040424,
					"content": "Спасибо вам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040425
					]
				},
				{
					"id": 790040425,
					"content": "Не за что. Меня сразу заинтересовали исследования в этой области.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040426
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 790040426,
					"content": "Спасибо, что поделились со мной этими рисунками и их историей. Не думал, что получится достичь таких результатов в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040427
					],
					"speakerTitle": "Саид"
				},
				{
