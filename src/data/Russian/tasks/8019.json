							-1080.309,
							201.336,
							2651.488
						],
						"pointId": 330400533
					}
				]
			},
			"dialogs": [
				{
					"id": 80190301,
					"content": "Привет! Вы за покупками? Я здесь торгую всякой всячиной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190302
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190302,
					"content": "#Нет, нет! Мы {F#искательницы}{M#искатели} приключений! Катерина дала нам поручение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190303,
					"content": "Вот оно что... Да, в последнее время искатели приключений к нам зачастили. Много хлопот мы вам доставили...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190304
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190304,
					"content": "Если честно, мы уже отчаялись. Столько искателей приключений обещали, что найдут его, но каждый раз возвращались ни с чем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190305
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190305,
					"content": "Мы уже устали от расспросов, и деревню Вимара со всеми окрестностями перевернули вверх дном в поисках зацепок, но никто ничего не нашёл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190306
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190306,
					"content": "Но как звали человека, которого мы ищем? Где он жил? У него остались родные?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190307,
					"content": "Не знаю. Понятия не имею. Ума не приложу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190308
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190308,
					"content": "Эм... Неужели расспросы настолько вас утомили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190309,
					"content": "Ох, извини... Я не хотел грубить. Я всего лишь отвечал на твои вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190310,
						80190311
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190310,
					"content": "Если вы не знаете ответов на эти вопросы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				},
				{
					"id": 80190312,
					"content": "Понимаю, может показаться, что мы вообще ничего о нём не знаем, но мы очень хорошо его запомнили. Жили бок о бок, много воспоминаний о нём осталось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190313
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190313,
					"content": "Но ничего конкретного о нём мы не знаем. Может, кто-то и знал раньше, но уже забыл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190314
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190314,
					"content": "К такому выводу мы пришли, когда попытались собрать всё, что нам о нём известно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190315
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190315,
					"content": "Ладно, тогда давай так... Что он был за человек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190316,
					"content": "Молодой парень лет двадцати или около того. Очень добрый, всегда готов прийти на помощь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190317
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190317,
					"content": "Если не было покупателей, мы с ним могли перекинуться парой слов. И я не раз видел, как он со всех ног бросался на выручку, если кому-то была нужна помощь... Да, интересный парнишка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190318
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190318,
					"content": "Вспоминая о нём, ты не выглядишь таким подавленным. Похоже, он в самом деле произвёл на тебя хорошее впечатление.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190319,
					"content": "Конечно! Он всем нравился, иначе мы бы не оставили в Гильдии поручение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190320
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190320,
					"content": "Сейчас таких добрых и честных молодых людей почти не осталось. А он вдруг взял и исчез. Надеюсь, с ним всё в порядке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190321
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190321,
					"content": "А не мог он... тихонько переехать в другое место?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190322,
					"content": "Нет. Он бы обязательно попрощался. Такой уж он человек. Да и как можно переехать, чтобы этого не заметил ни один человек в деревне? Вряд ли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190323
					],
					"speakerTitle": "Бахрам"
				},
				{
					"id": 80190323,
					"content": "Гм... Хорошо, спасибо за информацию. Мы попробуем расспросить остальных соседей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190311,
					"content": "...то что вам вообще известно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				}
			]
		},
		{
