			"dialogs": [
				{
					"id": 80190701,
					"content": "Спасибо! Я не ожидала, что здесь появятся монстры! Даже не знаю, что бы я делала, если бы не вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190702
					],
					"speakerTitle": "Атосса"
				},
				{
					"id": 80190702,
					"content": "Да ладно, пустяки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190703,
						80190704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190703,
					"content": "Сейчас главный вопрос, на который надо ответить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190705
					]
				},
				{
					"id": 80190705,
					"content": "Кстати, в последнее время в окрестностях деревни Вимара действительно стало больше хиличурлов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190706
					],
					"speakerTitle": "Атосса"
				},
				{
					"id": 80190706,
					"content": "Они ведут себя беспокойно, нападают на случайных прохожих. И староста больше не разрешает детям играть за околицей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190707
					],
					"speakerTitle": "Атосса"
				},
				{
					"id": 80190707,
					"content": "Ого... Неужели здесь в самом деле замешан орден Бездны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190708,
					"content": "На всякий случай нам стоит вернуться в деревню Вимара и проверить, как там дела. Паймон надеется, что жителям ничего не угрожает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190704,
					"content": "...что здесь понадобилось ордену Бездны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190705
					]
				}
			]
		}
