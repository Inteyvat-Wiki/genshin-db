			},
			"dialogs": [
				{
					"id": 80190401,
					"content": "У нас гости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190402
					],
					"speakerTitle": "Амадия"
				},
				{
					"id": 80190402,
					"content": "Привет, дедушка Амадия! Мы хотим помочь вам отыскать пропавшего парнишку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190403,
					"content": "Вот что вас сюда привело! Какой долгий путь вам пришлось проделать, мы перед вами в долгу... Уверен, вы его отыщете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190404
					],
					"speakerTitle": "Амадия"
				},
				{
					"id": 80190404,
					"content": "Ты можешь рассказать о нём подробнее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190405,
					"content": "Конечно! Расскажу всё, что знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190406
					],
					"speakerTitle": "Амадия"
				},
				{
					"id": 80190406,
					"content": "Глаза у меня слабые, я не смогу сказать, как он выглядел, зато я слышал его голос... Как жаль, что сейчас я его больше не слышу. Без него и на душе пусто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190407
					],
					"speakerTitle": "Амадия"
				},
				{
					"id": 80190407,
					"content": "Кажется, он жил в деревне один, без родителей. Но совсем не выглядел одиноким. Наоборот, у него всегда была компания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190408
					],
					"speakerTitle": "Амадия"
				},
				{
					"id": 80190408,
					"content": "Он часто заходил в гости к одиноким старикам или играл с деревенскими сиротами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190409
					],
					"speakerTitle": "Амадия"
				},
				{
					"id": 80190409,
					"content": "И если на душе у тебя было тяжело, он всегда был готов выслушать и успокоить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190410
					],
					"speakerTitle": "Амадия"
				},
				{
					"id": 80190410,
					"content": "Как деревенский староста, я очень ему обязан. Я сам должен протягивать людям руку помощи в трудную минуту, но обычно он брал эту обязанность на себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190411
					],
					"speakerTitle": "Амадия"
				},
				{
					"id": 80190411,
					"content": "Какой же он был добрый и отзывчивый! Теперь понятно, почему его исчезновение так вас огорчило!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190412,
					"content": "Но... Дедушка Амадия, ты ведь староста... И ни имени его не знаешь, ни адреса, ни где его семья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190413,
					"content": "Эх... Стыдно признать... но я не помню. Я должен помнить, но как ни пытаюсь напрячь память, ничего не выходит. Наверное, возраст...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190414
					],
					"speakerTitle": "Амадия"
				},
				{
					"id": 80190414,
					"content": "Ничего страшного! Не надо себя заставлять. Мы что-нибудь придумаем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190415,
					"content": "#Ну что, {NICKNAME}? Есть идеи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190416,
						80190417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190416,
					"content": "По-моему, здесь всё не так просто, как кажется на первый взгляд.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				},
				{
					"id": 80190418,
					"content": "Паймон с тобой согласна! Всё-таки странно, что даже имени его никто не помнит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190419
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190419,
					"content": "И никто не знает, где он жил, что с его семьёй... Его будто начисто стёрли из мира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190420,
						80190421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190420,
					"content": "Нет, мне кажется, тут другое...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190422,
					"content": "То есть... Ты хочешь сказать, его вообще никогда не существовало?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190423,
					"content": "Так, Паймон надо это обдумать... Человек, который живёт только в воспоминаниях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190424,
					"content": "(А если мы имеем дело с коллективным изменением памяти? Как тогда, с великой властительницей Руккхадеватой?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190425
					]
				},
				{
					"id": 80190425,
					"content": "#Наверное, вы {F#искательницы}{M#искатели} приключений и прибыли в деревню по поручению?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190426
					],
					"speakerTitle": "Атосса"
				},
				{
					"id": 80190426,
					"content": "Да! Мы пытаемся расследовать дело с пропавшим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190427,
					"content": "Я так рада! Как хорошо, что вы не теряете надежды! Я беспокоилась, что Гильдия отменит наше поручение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190428
					],
					"speakerTitle": "Атосса"
				},
				{
					"id": 80190428,
					"content": "Меня зовут Атосса. Я с детства живу в деревне Вимара. Знаете, я хотела сказать... пожалуйста, отыщите его, очень вас прошу. Не сдавайтесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190429,
						80190430
					],
					"speakerTitle": "Атосса"
				},
				{
					"id": 80190429,
					"content": "Мы обязательно его отыщем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190431,
					"content": "Да! Не беспокойся, мы очень постараемся! Ты хорошо его знала? Можешь поделиться с нами какими-нибудь зацепками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190432
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80190432,
					"content": "Гм... Не знаю, поможет ли это, но я хочу показать вам одно место. Идите за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Атосса"
				},
				{
					"id": 80190430,
					"content": "Мы сделаем всё возможное.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190421,
					"content": "...Он существует только в чужих воспоминаниях.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190417,
					"content": "Многое не сходится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				}
			]
		},
