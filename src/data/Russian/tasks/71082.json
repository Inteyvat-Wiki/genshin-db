			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Самопровозглашённый Тан Учоу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820101,
					"content": "Что? Неужели игра Старины Чоу завела тебя в тупик?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820102
					],
					"speakerTitle": "Самопровозглашённый Тан Учоу"
				},
				{
					"id": 710820102,
					"content": "Давай я тебе кое-что расскажу... Его охота за сокровищами устроена вот как: <color=#00E1FFFF>чем лучше награда, тем больше пороховых бочек вокруг. Ну и наоборот: чем хуже приз, тем слабее взрыв.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820103
					],
					"speakerTitle": "Самопровозглашённый Тан Учоу"
				},
				{
					"id": 710820103,
					"content": "Теперь понятно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Самопровозглашённый Тан Учоу"
				}
			]
		},
		{
			"id": 7108202,
			"completionStepIds": [
				7108202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108202",
							"2"
						],
						"stepId": 7108202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Самопровозглашённый Тан Учоу",
					"Дядя Хэ",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820201,
					"content": "Ах ты гнусный Похититель сокровищ... Ох... Если бы я не был так ослаблен из-за недостатка грибов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820202
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710820202,
					"content": "Давно бы уже тебе показал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820203
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710820203,
					"content": "Эй, старый вор! Мои глазурные... Мои цинсинь! Как ты смеешь называть их грибами и... поедать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820204
					],
					"speakerTitle": "Самопровозглашённый Тан Учоу"
				},
				{
					"id": 710820204,
					"content": "Кхе-кхе... Кто тебе позволил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820205
					],
					"speakerTitle": "Самопровозглашённый Тан Учоу"
				},
				{
					"id": 710820205,
					"content": "Ой, а из-за чего вы ругаетесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710820206,
					"content": "Я искал грибное мясо, а они не пустили меня обратно в шахты. Вот я и забрёл сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820207
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710820207,
					"content": "С таким трудом я их отыскал и только хотел сорвать, как на меня набросился этот нахал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820208
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710820208,
					"content": "#Ха! Наглец? Да он вторгся в тренировочные владения потомка Гухуа. Этими цветами владею я и наш герой {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820209
					],
					"speakerTitle": "Самопровозглашённый Тан Учоу"
				},
				{
					"id": 710820209,
					"content": "А ещё герой Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710820210,
					"content": "Да и герой Паймон! Кроме нас троих никто не смеет ступать на священную землю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820211
					],
					"speakerTitle": "Самопровозглашённый Тан Учоу"
				},
				{
					"id": 710820211,
					"content": "Ах ты похитительское отребье!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820212
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710820212,
					"content": "Вор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820213
					],
					"speakerTitle": "Самопровозглашённый Тан Учоу"
				},
				{
					"id": 710820213,
					"content": "Будет тебе, дядя Хэ. Тан Учоу уже давно не Похититель сокровищ. И он тут посадил цветы, а не грибы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710820214,
					"content": "Что? Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820215
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710820215,
					"content": "Присмотрись. Это же цветки цинсинь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710820216,
					"content": "Ох, и правда цинсинь. Кажется, у меня кружится голова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820217
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710820217,
					"content": "А ты, Тан Учоу, всё ещё серьёзно намерен вырастить свой сад с глазурными лилиями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710820218,
					"content": "Что ж, это было бы самое прекрасное зрелище, не правда ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820219
					],
					"speakerTitle": "Самопровозглашённый Тан Учоу"
				},
				{
					"id": 710820219,
					"content": "Прекратите драку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710820220,
					"content": "Эх, раз грибов нет, то до свидания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820221
					],
					"speakerTitle": "Дядя Хэ"
				},
				{
					"id": 710820221,
					"content": "Теперь, когда этот надоедливый старикашка ушёл, я наконец-то могу заняться посадкой цветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Самопровозглашённый Тан Учоу"
				}
			]
		}
	]
}