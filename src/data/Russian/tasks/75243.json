			"dialogs": [
				{
					"id": 752430101,
					"content": "Ах, вы меня выручили! Спасибо, что прогнали этих Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430102
					],
					"speakerTitle": "Алоха"
				},
				{
					"id": 752430102,
					"content": "Понятия не имею, откуда взялись эти типы. Ни слова не сказали, сразу полезли ко мне в мешок! Да это же настоящие грабители!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430103
					],
					"speakerTitle": "Алоха"
				},
				{
					"id": 752430103,
					"content": "Хорошо, что вы вмешались! А то остался бы сегодня ни с чем... Пожалуйста, примите мою благодарность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430104
					],
					"speakerTitle": "Алоха"
				},
				{
					"id": 752430104,
					"content": "Ах да, совсем забыл рассказать, что это за место. Это Парк альпак - здесь показывают дружелюбных альпак, а ещё можно купить игрушки с ними!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430105
					],
					"speakerTitle": "Алоха"
				},
				{
					"id": 752430105,
					"content": "Но эти хулиганы распугали и сотрудников, и гостей... Нужно срочно навести порядок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430106
					],
					"speakerTitle": "Алоха"
				},
				{
					"id": 752430106,
					"content": "Если хотите посмотреть Парк альпак, приходите завтра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Алоха"
				}
			]
		},
