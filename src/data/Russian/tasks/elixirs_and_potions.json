			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тимей"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590101,
					"content": "Осталось совсем немного... через 9 часов я завершу Эликсир тлеющего града!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590102
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590102,
					"content": "Тимей, что ты делаешь с таким серьёзным видом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590103,
					"content": "Здравствуйте! Давно не виделись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590104
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590104,
					"content": "Я работаю над Эликсиром тлеющего града. Прошу прощения, но в ближайшее время верстак будет занят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590105
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590105,
					"content": "Эликсир тлеющего града? Никогда о таком не слышала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590106,
					"content": "Это зелье было создано несколько лет назад. Я прочитал о нём в одной алхимической книге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590107
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590107,
					"content": "По словам автора, Эликсир тлеющего града происходит из Ли Юэ и способен увеличивать силу использующего его человека. Ничто не может сравниться с его эффектом. Это одно из величайших достижений алхимии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590108
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590108,
					"content": "Он высоко ценится в Ли Юэ. По описанию «аромат зелья подобен глотку свежего воздуха»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590109
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590109,
					"content": "После тщательной оценки я пришёл к выводу, что если мне удастся создать Эликсир тлеющего града, то алхимия продвинется вперёд как минимум на десятилетие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590110
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590110,
					"content": "На десятилетие? Круто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590111,
						716590112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590111,
					"content": "При условии, что написанное в книге является правдой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590113
					]
				},
				{
					"id": 716590113,
					"content": "Не волнуйтесь! Автор этой книги - настоящий учёный! Он написал несколько потрясающих эссе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590114
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590114,
					"content": "Алхимия - поразительная наука. Она постоянно развивается благодаря открытию древних технологий и результатам современных исследований.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590115
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590115,
					"content": "Поэтому я ищу различные источники, из которых могу почерпнуть знания, способные помочь мне овладеть алхимией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590116
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590116,
					"content": "Ты очень целеустремлённый!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590117,
					"content": "Если вы поможете мне, я смогу без проблем закончить своё исследование и получу признание Альбедо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590118
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590118,
					"content": "Если бы я стал помощником господина Альбедо и жил в его лагере, то мог бы существенно продвинуться в исследованиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590119
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590119,
					"content": "#Что скажешь, {NICKNAME}? Поможем Тимею?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590120,
						716590121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590120,
					"content": "Что угодно ради того, чтобы получить доступ к верстаку...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590122
					]
				},
				{
					"id": 716590122,
					"content": "Мы поможем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590123,
					"content": "Спасибо! Я не забуду вашу доброту!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590124
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590124,
					"content": "Если я преуспею, вы будете первыми, кто испытает его чудесные свойства. Вы станете суперсильными в мгновение ока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590125,
						716590126
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590125,
					"content": "Ты слишком добр...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590127
					]
				},
				{
					"id": 716590127,
					"content": "Интересно, а есть зелье, которое может сделать еду ещё вкуснее?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590128,
					"content": "Когда всё закончится, я вас щедро вознагражу и устрою для вас пир! Вы сможете наесться досыта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590129
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590129,
					"content": "Договорились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590130,
					"content": "Вы помогаете Тимею создать легендарный Эликсир тлеющего града...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590131
					]
				},
				{
					"id": 716590131,
					"content": "Ох! Моих навыков недостаточно, чтобы создать Эликсир тлеющего града. Похоже, придётся обратиться к эксперту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590132
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590132,
					"content": "К Альбедо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590133,
					"content": "Нет! Конечно, нет. Это всё равно, что спросить у преподавателя ответы во время экзамена!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590134
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590134,
					"content": "Если господин Альбедо узнает, что я не могу приготовить даже такое зелье, мне не на что рассчитывать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590135
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590135,
					"content": "Логично...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590136,
					"content": "Давай спросим Сахарозу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590137
					]
				},
				{
					"id": 716590137,
					"content": "Хотя познания Сахарозы в алхимии превосходят мои, её область исследования не имеет ничего общего с Эликсиром тлеющего града...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590138
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590138,
					"content": "Кроме того, она всегда очень занята своими исследованиями, я не хочу её беспокоить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590139
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590139,
					"content": "Как насчёт Лизы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590140
					]
				},
				{
					"id": 716590140,
					"content": "Госпожа Лиза отвечает за всю библиотеку. Говорят, у неё чудовищная нагрузка... Если я отвлеку её, она может разозлиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590141
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590141,
					"content": "Её лучше не беспокоить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590142
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590142,
					"content": "И что тогда делать? Нам нужно что-то придумать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590143,
					"content": "Есть один способ. Но для этого придётся отправиться в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590144
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590144,
					"content": "В этой книге говорится, что «великий мастер скрывается по соседству, тёплый ветер и туман окутывают скалистую гавань»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590145
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590145,
					"content": "Я слышал, что под тёплым ветром в Ли Юэ подразумевают южный ветер. Значит, мастер зелий, создавший Эликсир тлеющего града, должен жить где-то на юге Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590146
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590146,
					"content": "Самый эффективный способ - это обратиться непосредственно к мастеру зелий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590147
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590147,
					"content": "Не могли бы вы отправиться со мной в Ли Юэ? Я мало что знаю об этом месте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590148,
						716590149
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590148,
					"content": "Ты уверен...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590150
					]
				},
				{
					"id": 716590150,
					"content": "Конечно! Доверьтесь моим аналитическим способностям!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590151
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590151,
					"content": "Ли Юэ... так далеко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590152
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590152,
					"content": "Говорят, в Ли Юэ изысканная кухня. Когда мы закончим дела, можно будет отведать их блюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590153
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590153,
					"content": "Отличная идея! Паймон полностью поддерживает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590154
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590154,
					"content": "Паймон закажет все блюда в ресторане «Народный выбор». Сколько бы их ни было, мне всё мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590155,
						716590156
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590155,
					"content": "Это будет очень дорого...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590157
					]
				},
				{
					"id": 716590157,
					"content": "Результаты исследования того стоят... Я хотел сказать, что ваша помощь бесценна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590158
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590158,
					"content": "Не будем медлить! В путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590156,
					"content": "Тимей разорится...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590157
					]
				},
				{
					"id": 716590149,
					"content": "...в значении этих фраз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590150
					]
				},
				{
					"id": 716590126,
					"content": "Мне не нужно становиться сильнее...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590127
					]
				},
				{
					"id": 716590121,
					"content": "Что угодно ради алхимической карьеры Тимея...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590122
					]
				},
				{
					"id": 716590112,
					"content": "При условии, что твоя оценка достаточно точна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590113
					]
				}
			]
		},
		{
			"id": 7165902,
			"completionStepIds": [
				7165902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165902",
							"2"
						],
						"stepId": 7165902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тимей"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590201,
					"content": "Судя по карте, в южной части Ли Юэ находится гора Тигра. Я думаю, что легендарный мастер зелий живёт там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590202
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590202,
					"content": "Мы пришли. Это и есть гора Тигра. Давайте поищем этого мастера!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7165903,
			"completionStepIds": [
				7165903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165903",
							"2"
						],
						"stepId": 7165903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ин Эр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590301,
					"content": "Вы вспомнили обо мне? И привели друга...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590302
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590302,
					"content": "Э... Паймон немного неловко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590303,
					"content": "Дело в том, что мы ищем мастера зелий. Вы его случайно не знаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590304,
					"content": "Значит, вы здесь не для того, чтобы навестить меня... Как жаль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590305
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590305,
					"content": "Хотите разузнать мои секреты. Я удивлена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590306,
						716590307
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590306,
					"content": "Секреты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590308
					]
				},
				{
					"id": 716590308,
					"content": "Минуточку! Так Ин Эр и есть тот самый мастер зелий?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590309,
					"content": "Ты умнеешь на глазах, Паймон. Так мило.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590310
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590310,
					"content": "Вот так поворот!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590311,
					"content": "Я думал, что мастер зелий старше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590312
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590312,
					"content": "Вы совершенно не похожи на господина Альбедо, но у вас такая же непостижимая аура!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590313
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590313,
					"content": "Я вижу, вы нетерпеливы. Кажется, вас что-то беспокоит. Почему бы вам не рассказать мне об этом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590314
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590314,
					"content": "Паймон чувствует, что ситуация принимает неожиданный оборот...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590315,
					"content": "Вы вместе с Тимеем рассказываете Ин Эр о попытке создать Эликсир тлеющего града.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590316
					]
				},
				{
					"id": 716590316,
					"content": "Так вот в чём дело. Этот алхимик изучает удивительные свойства Эликсира тлеющего града...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590317
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590317,
					"content": "Жаль вас разочаровывать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590318
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590318,
					"content": "Это не что иное, как одно из моих ароматических масел. Эликсир тлеющего града не имеет ничего общего с алхимией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590319
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590319,
					"content": "Ароматическое масло? Так это парфюм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590320
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590320,
					"content": "Но у него такое впечатляющее название! И в книге говорится, что он может делать людей сильнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590321,
					"content": "Ха-ха, ничего удивительного. Это моё самое популярное ароматическое масло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590322
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590322,
					"content": "Древние писатели подчёркивали слово «воздействие». Если аромат будет витать вокруг вас долгое время, ваши настроение и разум подвергнутся воздействию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590323
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590323,
					"content": "После использования моего ароматического масла у людей резко меняется темперамент, усиливается обаяние, повышается уверенность в общении с окружающими, улучшаются взаимоотношения. Их карьера идёт в гору, а жизнь становится лучше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590324
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590324,
					"content": "Это всё равно, что использовать эликсир Адептов, который дарует удачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590325
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590325,
					"content": "Поэтому люди дали ему поэтическое название и написали простые, понятные стихи, восхваляющие его эффективность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590326
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590326,
					"content": "Теперь понятно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590327,
					"content": "Этого не может быть... Возможно ли, что тезисы, которые я прочитал в книге, не соответствуют действительности? Или я неверно понял стихотворение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590328
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590328,
					"content": "Например, «аромат эликсира - великий источник силы». Смысл этого абзаца должен звучать так: Эликсир тлеющего града может стимулировать твёрдость и потенциал... Верно, госпожа Ин Эр?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590329
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590329,
					"content": "Под «силой» понимаются внешний облик и прекрасные манеры. То есть ароматическое масло меняет поведение и манеры человека.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590330
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590330,
					"content": "Вас нельзя винить в неправильной трактовке, ведь поэзия требует глубоких знаний. Нельзя просто взять слова, разобрать их на части и расшифровать словно цифры. Вы должны понимать всё написанное целиком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590331
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590331,
					"content": "Метод разбора по словам на самом деле не работает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590332
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590332,
					"content": "Но в книге также упоминается множество примеров чудодейственных свойств Эликсира тлеющего града, узнав о которых я потерял дар речи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590333
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590333,
					"content": "Волнующие и таинственные вещи всегда завораживают. Например, силуэт за ширмой выглядит более изящным. Истории в книгах также художественно переосмысляются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590334
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590334,
					"content": "Своего рода комплимент от автора, за который я ему очень благодарна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590335
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590335,
					"content": "Как же так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590336
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590336,
					"content": "Другими словами, автор книги приукрасил действие ароматического масла, а Тимей неправильно истолковал написанное. Поэтому он принял Эликсир тлеющего града за мощное алхимическое зелье?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590337,
						716590338
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590337,
					"content": "#К счастью, я был{F#а} морально готов{F#а} к такому повороту.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590339
					]
				},
				{
					"id": 716590339,
					"content": "В итоге моё исследование было основано на совершенно неверной теории!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590340
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590340,
					"content": "Ах... Опять провал! Все мои усилия были напрасны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590341
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590341,
					"content": "Не унывайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590342
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590342,
					"content": "Как говорится, «за поворотом горной дороги открывается новый путь, высохшие деревья могут дать новые побеги»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590343
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590343,
					"content": "Возможно, этот древний способ изготовления ароматического масла вдохновит вас продолжать исследования, чтобы в итоге создать искомое зелье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590344
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590344,
					"content": "Исследование началось не очень гладко, но ты довольно далеко продвинулся самостоятельно, Тимей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590345
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590345,
					"content": "Раз уж Ин Эр предложила, почему бы не попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590346
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590346,
					"content": "Возможно, ты получишь неожиданные результаты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590347
					]
				},
				{
					"id": 716590347,
					"content": "И правда... Алхимия - это дисциплина, требующая разнообразных знаний. Это не первый раз, когда я терплю неудачу... Нельзя отчаиваться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590348
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590348,
					"content": "Обычно мне удаётся правильно понять прочитанное, но не в этот раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590349
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590349,
					"content": "Хотя я и не смог сварить легендарное зелье, по крайней мере, я могу улучшить своё зельеварение, а это тоже большое достижение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590350
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590350,
					"content": "#Госпожа Ин Эр, {NICKNAME}, пойдёмте к верстаку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590338,
					"content": "#Я ожидал{F#а} чего-то подобного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590339
					]
				},
				{
					"id": 716590307,
					"content": "Удивлена?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590308
					]
				}
			]
		},
		{
			"id": 7165904,
			"completionStepIds": [
				7165904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165904",
							"2"
						],
						"stepId": 7165904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тимей",
					"Ин Эр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590401,
					"content": "Процесс изготовления ароматического масла довольно сложен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590402
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590402,
					"content": "Раскройте цветок очень нежно, как будто вы ласкаете кожу любимого человека, затем отщипните лепестки и аккуратно сложите их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590403
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590403,
					"content": "Мелкие лепестки положите сверху, а более крупные - снизу. Затем раздавите их...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590404
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590404,
					"content": "Не сжимайте пестик слишком крепко. Запястье должно быть расслаблено и двигаться вверх и вниз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590405
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590405,
					"content": "Когда из лепестков начнёт выделяться сок, а нижняя часть пестика станет мокрой, можно увеличить скорость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590406
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590406,
					"content": "Кхм-кхм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590407
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590407,
					"content": "Госпожа Ин Эр, вы описываете это таким... особенным образом! Думаю, я понимаю, что вы имеете в виду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590408
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590408,
					"content": "Необходимо тщательно подготовить ингредиенты, обращая внимание на порядок их размещения на верстаке. Будьте осторожны с жидкими ингредиентами и контролируйте температуру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590409
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590409,
					"content": "При приготовлении зелий высокого порядка нужно уделять особое внимание деталям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590410
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590410,
					"content": "Я вижу, что вы хорошо в этом разбираетесь, но изготовление ароматического масла более сложный процесс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590411
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590411,
					"content": "В некоторых ароматических маслах очень важен эффект сублимации. Необходимо добавить нужные ингредиенты, такие как мята и порошок из звёздных ракушек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590412
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590412,
					"content": "Они позволяют аромату масла быстро распространяться вокруг и оказывают благотворное действие на окружающих.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590413
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590413,
					"content": "Однако эффект сублимации не должен быть слишком сильным, иначе действие бальзама быстро закончится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590414
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590414,
					"content": "Сублимация?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590415
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590415,
					"content": "Я понял! Эта особенность - именно то, что я ищу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590416
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590416,
					"content": "Зелья, которые задерживаются в воздухе, полезны как для человека, который их использует, так и для всех вокруг. Они более эффективны, чем обычные эфирные масла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590417
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590417,
					"content": "Кроме того, если правильно контролировать скорость сублимации, время воздействия должно быть дольше, чем у обычных эфирных масел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590418
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590418,
					"content": "Если я очень постараюсь, у меня всё обязательно получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590419
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590419,
					"content": "Когда речь заходит о таких научных темах, Паймон теряется...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590420,
					"content": "Лучше не мешать им.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590421,
					"content": "Под руководством Ин Эр Тимей пытается сварить улучшенную версию зелья.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590422
					]
				},
				{
					"id": 716590422,
					"content": "Один только запах этого зелья придаёт Паймон энергии и сил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590423,
						716590424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590423,
					"content": "Оно действительно прибавляет сил.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590425
					]
				},
				{
					"id": 716590425,
					"content": "Получилось! Я наконец-то преуспел! Мне удалось приготовить зелье, используя древний метод!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590426
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590426,
					"content": "Госпожа Ин Эр, спасибо вам за помощь и наставления! Без вас я бы не справился так быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590427
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590427,
					"content": "Скромность неуместна. Ваши знания и уровень понимания стали ключом к успеху!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590428
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590428,
					"content": "Теперь... как насчёт того, чтобы дать имя этому с таким трудом сваренному зелью?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590429
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590429,
					"content": "Я назову его Зелье тлеющего града! Это идеальное сочетание ароматического масла госпожи Ин Эр и алхимического зелья. Оно настолько необычно, что, несомненно, войдёт в историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590430
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590430,
					"content": "Как трогательно... Я польщена!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590431
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590431,
					"content": "Но это название не сильно отличается от предыдущего Эликсира тлеющего града, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590432
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590432,
					"content": "Э... вернёмся к делу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590433
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590433,
					"content": "#{NICKNAME}, хочешь стать {F#первой}{M#первым}, кто опробует на себе Зелье тлеющего града?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590434
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590434,
					"content": "Зелье тлеющего града требует доработки, но я бы хотел попросить тебя испытать это зелье на себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590435
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590435,
					"content": "Эффект Зелья тлеющего града проявится лучше в местах с относительно медленным движением воздуха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590436
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590436,
					"content": "Я слышал, в Ли Юэ есть заброшенные подземелья. Они идеально подходят для тестирования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590437,
						716590438
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590437,
					"content": "Если идти, то идти до конца.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590439
					]
				},
				{
					"id": 716590439,
					"content": "Благодарю за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590440
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590440,
					"content": "Я останусь здесь, чтобы продолжить научную беседу с госпожой Ин Эр. Я хочу послушать её комментарии и продумать, как улучшить Зелья тлеющего града.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590441
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716590441,
					"content": "Будем ждать хороших новостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716590438,
					"content": "Мне тоже не терпится испытать зелье.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590439
					]
				},
				{
					"id": 716590424,
					"content": "Оно обладает чудодейственным эффектом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590425
					]
				}
			]
		},
