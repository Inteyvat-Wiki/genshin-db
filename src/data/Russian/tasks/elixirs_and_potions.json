				"points": []
			},
			"dialogs": [
				{
					"id": 716590601,
					"content": "Здравствуйте! Вы случайно не знаете мастера зелий, что живёт неподалёку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590602,
					"content": "Мастер зелий? Впервые слышу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590603
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 716590603,
					"content": "Только человек с высоким статусом заслуживает называться мастером. Я не знаю таких людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590604
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 716590604,
					"content": "Давай спросим кого-нибудь ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7165907,
			"completionStepIds": [
				7165907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165907",
							"2"
						],
						"stepId": 7165907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хун И"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590701,
					"content": "Здравствуйте! Мы ищем мастера зелий с горы Тигра. Вы случайно не знаете, где он живёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716590702,
					"content": "Извините, я не знаю прозвищ живущих поблизости людей. Я помню только их зарегистрированные официальные имена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590703
					],
					"speakerTitle": "Хун И"
				},
				{
					"id": 716590703,
					"content": "Вы можете спросить Ин Эр из «Весенних ароматов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590704
					],
					"speakerTitle": "Хун И"
				},
				{
					"id": 716590704,
					"content": "Разумно! Я думаю, она сможет нам помочь. Давайте спросим её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7165951,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165905",
							"2"
						],
						"stepId": 7165905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тимей",
					"Ин Эр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716595101,
					"content": "Вам ещё многое предстоит узнать об ароматических и эфирных маслах. Хотите, я вас научу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716595102
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716595102,
					"content": "Ещё бы! Я могу слушать вас дни и ночи напролёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимей"
				}
			]
		}
	]
