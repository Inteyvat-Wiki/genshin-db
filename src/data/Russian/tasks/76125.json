			"dialogs": [
				{
					"id": 761250201,
					"content": "(Коломбины здесь нет, как и ожидалось...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250202
					]
				},
				{
					"id": 761250202,
					"content": "Неужели Коломбина?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250203,
					"content": "(Она прошла через Лунные врата. Никто не знает, что находится за ними, но это место, которое разорвало в клочья могущественного Лунного мстителя...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250204
					]
				},
				{
					"id": 761250204,
					"content": "(Если бы я тогда...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250205
					]
				},
				{
					"id": 761250205,
					"content": "Коломбина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250207
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 761250207,
					"content": "?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250208
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 761250208,
					"content": "А, это ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250210
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 761250210,
					"content": "Ты... тоже ждёшь возвращения Коломбины?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250212
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 761250212,
					"content": "И ты тоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250214
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 761250214,
					"content": "Ох... не грусти так, взбодрись...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250215,
					"content": "Если мы все будем грустить, то... это будет как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250216,
					"content": "Паймон не хочет об этом думать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250217,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250218
					]
				},
				{
					"id": 761250218,
					"content": "(...Я не могу предаваться самобичеванию.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250219
					]
				},
				{
					"id": 761250219,
					"content": "(Коломбина пожертвовала собой не для того, чтобы мы оказались в такой ситуации, не говоря уже о том, что...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250220
					]
				},
				{
					"id": 761250220,
					"content": "Я... не сдаюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250221
					]
				},
				{
					"id": 761250221,
					"content": "Коломбина, все её друзья... Никто и никогда бы так просто не сдался...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250222
					]
				},
				{
					"id": 761250222,
					"content": "Мне нужно время. Я ничего не обещаю, но я обязательно сделаю всё возможное...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250223
					]
				},
				{
					"id": 761250223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250224
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 761250224,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250225
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 761250225,
					"content": "Они пытаются нас... подбодрить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250226,
					"content": "Хм...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250227
					]
				},
				{
					"id": 761250227,
					"content": "Спасибо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250228,
					"content": "Мы можем вам чем-нибудь помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250229,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250230
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 761250230,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250231
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 761250231,
					"content": "Куухенки... кажется, это та, что любит играть на лире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250232,
					"content": "Она... выглядит встревоженной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250233,
					"content": "Может, сыграешь что-нибудь? Если она услышит знакомую мелодию, то станет спокойнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250234
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250234,
					"content": "Знакомая мелодия...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250235
					]
				},
				{
					"id": 761250235,
					"content": "Попробуем ту, которую всегда поёт Коломбина...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250236
					]
				},
				{
					"id": 761250236,
					"content": "...Спит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250237
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250237,
					"content": "Видимо, давно не отдыхала как следует...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250238,
					"content": "Давай тихонько уйдём отсюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250239
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250239,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250240
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761250240,
					"content": "Сандроне! Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250241,
					"content": "Разве мне запрещено выходить на прогулку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250242
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761250242,
					"content": "Она не вернулась.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250243
					]
				},
				{
					"id": 761250243,
					"content": "Я так и думала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250244
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761250244,
					"content": "Бесплатных чудес не бывает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250245
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761250245,
					"content": "Куда ты направляешься? Паймон хотела сказать... раз уж мы встретились, может, погуляем вместе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250246
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761250246,
					"content": "Не стоит. Я сегодня не в настроении, вряд ли со мной будет приятно общаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250247
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761250247,
					"content": "Кроме того, утешение - это последнее, что нужно этому месту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
