					"Пашив"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741930101,
					"content": "#Паймон! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930102
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930102,
					"content": "О, это ты, Пашив! Рады тебя снова видеть! Что ты тут делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741930103,
					"content": "Пашив... работает! Пашив... устала! Пашив... лежит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930104
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930104,
					"content": "Ты работаешь?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741930105,
					"content": "Ветвь Туманного леса... Ветвь Туманного леса... Можно хорошо кинуть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930106
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930106,
					"content": "Ветвь Туманного леса? Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741930107,
					"content": "Ветвь Туманного леса... Информация!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930108
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930108,
					"content": "Ива, собирать. Туман, обрабатывать. Источник, отправлять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930109
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930109,
					"content": "Ветвь Туманного леса... Информация о пути!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930110
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930110,
					"content": "Информация о Пути в Туманном лесу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930111
					]
				},
				{
					"id": 741930111,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930112
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930112,
					"content": "Ветвь Туманного леса... Хорошо кидать! Здесь много мест!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930113
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930113,
					"content": "Пашив... ищет! Пашив... устала! Пашив... ест! Пашив... лежит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930114
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930114,
					"content": "Ветвь Туманного леса... Очень немного! Но тут много сундуков, много-много!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930115
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930115,
					"content": "#Спасибо, Паймон! Спасибо, {NICKNAME}! Вот!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930116
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930116,
					"content": "Ты снова нашла сундук для нас?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930117
					]
				},
				{
					"id": 741930117,
					"content": "Пашив! Коробка, сокровища, цветок, блестящие, сладкие, много!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930118
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930118,
					"content": "Ух ты, значит, есть и другие вещи? Знаешь, Пашив, ты очень милая, но нехорошо, если мы будем продолжать брать твои вещи бесплатно. Почему бы нам не обмениваться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741930119,
					"content": "Обмен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930120
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930120,
					"content": "Правильно! Мы же друзья, а друзья должны честно обмениваться подарками друг с другом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741930121,
					"content": "Мы поможем найти Ветви Туманного леса, а потом обменяем их на что-нибудь у тебя. Хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741930122,
					"content": "И мы можем принести тебе что-нибудь поесть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930123
					]
				},
				{
					"id": 741930123,
					"content": "Точно, мы можем это сделать! Тебе и самой нелегко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741930124,
					"content": "Еда! Тидалья! Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930125
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930125,
					"content": "Нравится тидалья?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930126
					]
				},
				{
					"id": 741930126,
					"content": "Тидалья! Тидалья! Тидалья! Тидалья! Тидалья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930127
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930127,
					"content": "Это значит, что ты ешь пять раз в день или именно съедаешь пять тидалий в день? Ого, да у тебя аппетит не хуже, чем у Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741930128,
					"content": "Так что насчёт ветвей? Сможем найти их на Пути в Туманном лесу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741930129,
					"content": "Мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930130
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930130,
					"content": "Ветвь Туманного леса... Хорошо кидать! Очень много - Эринии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930131
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930131,
					"content": "Ветви Туманного леса на островах Эриний?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930132
					]
				},
				{
					"id": 741930132,
					"content": "#{F#Умная}{M#Умный} {NICKNAME}! Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930133
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930133,
					"content": "Путь, есть цветы. Ветви и цветы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930134
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930134,
					"content": "Ветвь, ветвь, ветвь, ветвь, ветвь, ветвь... Количество!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930135
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930135,
					"content": "О, Паймон поняла! Там, где лесные ветви растут, есть цветы, как и на Пути в Туманном лесу. Таких мест шесть, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741930136,
					"content": "Умная Паймон! Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930137
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 741930137,
					"content": "Ну вот, теперь всё ясно, да? Отдыхай, Пашив. Мы всё сделаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930138
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741930138,
					"content": "#Паймон, {NICKNAME}, хорошая штука! Так, потихоньку, потихоньку! Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пашив"
				}
			]
		},
