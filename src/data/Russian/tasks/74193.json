						741930302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741930302,
					"content": "Ветвь Туманного леса, полезна очень-очень! Новый валет, полезен очень-очень!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930303
					],
					"speakerTitle": "Пашив"
				},
				{
