			},
			"dialogs": [
				{
					"id": 221040101,
					"content": "Это уже слишком...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040102
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221040102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040103
					]
				},
				{
					"id": 221040103,
					"content": "Ох, прости! Я тебя не заметила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040104
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221040104,
					"content": "Монстров в округе всё больше и больше. И хотя мой муж утверждает, что они не посмеют приблизиться к постоялому двору...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040105
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221040105,
					"content": "Он один способен дать монстрам достойный отпор. И меня это немного тревожит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040106
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221040106,
					"content": "Если у тебя найдётся немного свободного времени, пожалуйста, разберись с монстрами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040107,
						221040108
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221040107,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040109
					]
				},
				{
					"id": 221040109,
					"content": "Спасибо за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221040113,
					"content": "Благодарю тебя за помощь! Тебя ждёт щедрая компенсация.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221040108,
					"content": "Что не так с этим постоялым двором?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040110
					]
				},
				{
					"id": 221040110,
					"content": "В смысле? С постоялым двором всё в порядке. Просто он находится немного в стороне и принимает очень много гостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040111
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221040111,
					"content": "Путешественникам, которые рискуют своей жизнью, всегда нужны тёплая еда и крыша над головой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040112
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221040112,
					"content": "По крайней мере, мы с мужем так считаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "Верр Голдет"
				}
			]
		},
