			"dialogs": [
				{
					"id": 240140101,
					"content": "Рыбы здесь снова стало меньше. Неужели опять мек-рыбы взялись за своё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140102
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140102,
					"content": "Мне нужно выпустить мальков в глубокую воду... Эх, почему же водолазный костюм пришёл в негодность именно сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140103
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140103,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140104
					]
				},
				{
					"id": 240140104,
					"content": "Привет, рада встрече. Меня зовут Линорея. Я журналистка, пишу о проблемах окружающей среды. Я... хочу выпустить мальков на волю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140105,
						240140109
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140105,
					"content": "Журналистка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140106
					]
				},
				{
					"id": 240140106,
					"content": "Верно, именно журналистка. Но я не занимаюсь сплетнями о знаменитостях или скучными новостными сводками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140107
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140107,
					"content": "Меня беспокоят настоящие проблемы, представляющие угрозу безопасности населения Кур-де-Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140108
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140108,
					"content": "Поэтому я здесь выпускаю мальков в воду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140110
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140110,
					"content": "Слышали про мек-рыб?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140111,
						240140112
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140111,
					"content": "Нет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140112,
					"content": "Это особый фонтейнский вид?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140109,
					"content": "Зачем выпускать мальков?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140110
					]
				}
			]
		},
