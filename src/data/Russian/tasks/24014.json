						],
						"stepId": 2401401,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2401401",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Линорея"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240140801,
					"content": "Сколько проблем от этих мек-рыб!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140802,
						240140803
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140802,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				},
				{
					"id": 240140804,
					"content": "Да, но вскоре он опять развалился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140805
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140805,
					"content": "Мек-рыбы здесь совсем взбесились... Уж не знаю почему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140806
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140806,
					"content": "Как только я выпустила мальков, тут же налетели мек-рыбы, снующие неподалёку, и стали их пожирать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140807
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140807,
					"content": "Некоторые даже попытались меня покусать, потому что ко мне прилипло несколько мальков...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140808
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140808,
					"content": "Я знаю, что мек-рыбы не могли причинить мне вреда, но это было страшно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140809
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140809,
					"content": "Я отбивалась от них как могла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140810
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140810,
					"content": "Не знаю, как так вышло, но в водолазном костюме образовалась ещё одна дыра... К счастью, я была недалеко от берега и смогла выбраться на сушу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140811
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140811,
					"content": "Но в такой ситуации я какое-то время не смогу выпускать мальков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140812
					],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140812,
					"content": "#{F#Путешественница}{M#Путешественник}, ты поможешь мне ещё раз? Выпусти мальков в глубоких водах или на мелководье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линорея"
				},
				{
					"id": 240140803,
					"content": "Отремонтировала водолазный костюм?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				}
			]
		}
	]
}