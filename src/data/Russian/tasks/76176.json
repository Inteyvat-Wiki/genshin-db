			},
			"dialogs": [
				{
					"id": 761760301,
					"content": "...Ария, Канон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760302
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760302,
					"content": "Это уже не первый раз. Это... вышло далеко за рамки наказания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760303
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760303,
					"content": "Будь то город драконов, который наш повелитель доверил нам, или хрупкие, но прекрасные жилища, построенные людьми...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760304
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760304,
					"content": "Сколько ещё невинных должно погибнуть на ваших глазах, прежде чем вы перестанете бездействовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760305
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760305,
					"content": "Если бы наш повелитель был здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760306
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760306,
					"content": "Нашего повелителя здесь нет, Сонет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760307
					],
					"speakerTitle": "Ария"
				},
				{
					"id": 761760307,
					"content": "Если этот далеко не всемогущий властитель считает бледную и ужасающую судьбу «порядком», если это единственный способ спасти обречённый мир от гибели, то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760308
					],
					"speakerTitle": "Ария"
				},
				{
					"id": 761760308,
					"content": "...какой бы высокой ни была цена и сколько бы горя она мне ни принесла, это гораздо лучше, чем мёртвая гнетущая тишина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760309
					],
					"speakerTitle": "Ария"
				},
				{
					"id": 761760309,
					"content": "Если мир обречён на гибель... какой смысл бороться с тьмой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760310
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760310,
					"content": "Сонет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760311
					],
					"speakerTitle": "Ария"
				},
				{
					"id": 761760311,
					"content": "Н-ничего, Ария! Я ничего не говорила!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760312
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760312,
					"content": "Я считаю, что мы не должны сидеть сложа руки и смотреть, как тиран убивает живых существ, которые поверили в нас... будь то драконы или беззащитные люди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760313
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760313,
					"content": "Разве мы... не должны спасти их?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760314
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760314,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760315
					],
					"speakerTitle": "Канон"
				},
				{
					"id": 761760315,
					"content": "Я могу понять гнев Сонет, Ария. На мой взгляд, деяния того властителя поистине жестоки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760316
					],
					"speakerTitle": "Канон"
				},
				{
					"id": 761760316,
					"content": "Даже если есть хоть малейший шанс... я хочу приложить все усилия, чтобы спасти тех, кого ещё можно спасти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760317
					],
					"speakerTitle": "Канон"
				},
				{
					"id": 761760317,
					"content": "Но... как же те, кого не удалось спасти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760318
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760318,
					"content": "Те, кого не удалось спасти, жизни, которые не вышло сохранить... Разве их кровь, слёзы и стенания должны бесследно исчезнуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760319
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760319,
					"content": "Нет... так не должно быть. Я хочу, чтобы каждый был спасён, чтобы ни одна душа не была обречена на гибель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760320
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760320,
					"content": "Вот бы его «порядка» не стало вместе с ним...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760321
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760321,
					"content": "Сонет! Прошу тебя, не забывай о том, ради чего мы были рождены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760322
					],
					"speakerTitle": "Ария"
				},
				{
					"id": 761760322,
					"content": "Наша миссия лишь поддерживать этот мир, пока правитель, даровавший нам жизнь, не вернётся из дальних краёв.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760323
					],
					"speakerTitle": "Ария"
				},
				{
					"id": 761760323,
					"content": "Мы всегда осознавали цену порядка... Ведь мы не могли допустить, чтобы мир шёл к собственной гибели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760324
					],
					"speakerTitle": "Ария"
				},
				{
					"id": 761760324,
					"content": "Нет, дело даже не в порядке, Ария.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760325
					],
					"speakerTitle": "Канон"
				},
				{
					"id": 761760325,
					"content": "Сонет, для нас... для меня ты - самая дорогая сестрёнка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760326
					],
					"speakerTitle": "Канон"
				},
				{
					"id": 761760326,
					"content": "Поэтому, пожалуйста, не делай того, что причинит боль Арии и мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760327
					],
					"speakerTitle": "Канон"
				},
				{
					"id": 761760327,
					"content": "Не нужно бросать вызов порядку высших небес. По крайней мере... не сейчас, пока мир ещё так хрупок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760328
					],
					"speakerTitle": "Канон"
				},
				{
					"id": 761760328,
					"content": "Канон... Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760329
					],
					"speakerTitle": "Сонет"
				},
				{
					"id": 761760329,
					"content": "Астарот рассказала мне об одном слове, принадлежащем лишь людям... «Надежда».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760330
					],
					"speakerTitle": "Канон"
				},
				{
					"id": 761760330,
					"content": "Пока есть жизнь, есть и надежда... Надежда будет всегда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Канон"
				}
			]
		}
	]
}