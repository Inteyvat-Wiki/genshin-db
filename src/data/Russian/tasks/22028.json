				{
					"id": 220280601,
					"content": "Давай преподнесём конфеты компэйто.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280801
					]
				},
				{
					"id": 220280801,
					"content": "Отлично! Так и поступим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280802
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220280802,
					"content": "Надеюсь, на этот раз я также получу от Архонта ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280803
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220280803,
					"content": "Я вернусь сюда завтра, чтобы посмотреть, произошло ли что-нибудь необычное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280804
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220280804,
					"content": "#Спасибо, что был{F#а} со мной всё это время. Пожалуйста, возьми!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280805
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220280805,
					"content": "Я надеюсь, что Архонт и правда исполнит мои желания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сёта"
				}
			]
		},
