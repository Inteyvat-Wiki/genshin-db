					"Сёта"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220280501,
					"content": "Пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280502
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220280502,
					"content": "Я слышал, что давным-давно один досин сделал здесь подношение из множества бумажных журавликов, желая, чтобы все в Ханамидзаке жили мирно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280503
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220280503,
					"content": "Вскоре после этого неподалеку вспыхнул пожар, и загорелся дом. Однако этот дом был построен из некачественных материалов, поэтому огонь очень быстро покончил с ним и не успел распространиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280504
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220280504,
					"content": "Все верят, что это всё хорошо закончилось благодаря защите Архонта... Хе-хе, вот почему я также сложил несколько бумажных журавликов и принес их сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280505
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220280505,
					"content": "Но хватит болтать! Что же мы преподнесём на этот раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280506
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220280506,
					"content": "Возможно, мы сможем получить отклик, если предложим бумажных журавликов, как тот досин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280507
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220280507,
					"content": "Но поскольку это святилище находится рядом с чайным домом, не будет ли лучше, если мы сделаем подношение в виде конфет компэйто со вкусом маття?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280508
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220280508,
					"content": "Да, конфеты компэйто со вкусом маття я тоже очень люблю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280509
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220280509,
					"content": "#Что думаешь, {M#братик}{F#сестрёнка}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сёта"
				}
			]
		},
