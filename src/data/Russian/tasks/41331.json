			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бабуля Жо Синь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310201,
					"content": "Эх, опять Праздник морских фонарей настал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310202
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413310202,
					"content": "Вас что-то тревожит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310203
					]
				},
				{
					"id": 413310203,
					"content": "Обычно Праздник морских фонарей должен быть весёлым и шумным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310204
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413310204,
					"content": "Но в Цинцэ старики слишком стары, а дети ещё слишком малы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310205
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413310205,
					"content": "Вся та молодёжь, что ушла работать в город, или слишком занята работой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310206
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413310206,
					"content": "Или слишком далеко, и домой вовремя не успеет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310207
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413310207,
					"content": "Праздник этот радостный, и справлять его нужно всем вместе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310208
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413310208,
					"content": "Понимаю, им тоже приходится нелегко, но как же праздник? Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310209
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413310209,
					"content": "Ай, всё, всё. Так праздник встречать не годится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310210
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413310210,
					"content": "Да, если у тебя есть минутка, поможешь мисс Бай?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310211
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413310211,
					"content": "Она хочет приготовить праздничный стол. Сейчас она очень занята, и я боюсь, что одна она не управится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310212,
						413310213
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413310212,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				},
				{
					"id": 413310214,
					"content": "Ох, спасибо тебе за твою доброту!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413310213,
					"content": "Так и быть, я помогу ей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				}
			]
		},
		{
