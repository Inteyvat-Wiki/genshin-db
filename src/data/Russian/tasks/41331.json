				"points": []
			},
			"dialogs": [
				{
					"id": 413313701,
					"content": "Теперь, когда нас здесь так много собралось, это уже похоже на настоящий праздник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313702
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413313702,
					"content": "Хе-хе, давайте уже запускать небесные фонари!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313703
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413313703,
					"content": "В наступающем году желаю всем вам здоровья и успехов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313704
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413313704,
					"content": "И пусть сбудутся желания молодых людей, которые трудятся вдали от дома...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313705
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413313705,
					"content": "Ладно, бабуля Жо Синь, ещё немного, и еда, которую мы готовили, остынет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313706
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 413313706,
					"content": "О, вкусная еда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313707
					],
					"speakerTitle": "Малышка Лю"
				},
				{
					"id": 413313707,
					"content": "Пойдём, бабуль!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313708
					],
					"speakerTitle": "Дундун"
				},
				{
					"id": 413313708,
					"content": "Эх, дети... Ладно, идите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313709
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413313709,
					"content": "А вы не пойдёте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313710
					]
				},
				{
					"id": 413313710,
					"content": "Я? Я не спешу. К тому же мне хотелось бы подольше посмотреть на фонарики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313711
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413313711,
					"content": "Кстати, это тебе в благодарность за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313712
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413313712,
					"content": "Спасибо, бабуля.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313713
					]
				},
				{
					"id": 413313713,
					"content": "#Не за что. Вижу, ты совсем ещё молод{F#ая}{M#ой}. Ходить-бродить повсюду должно быть очень утомительно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313714
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413313714,
					"content": "Почему бы тебе не остаться и не отпраздновать с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313715
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413313715,
					"content": "Пространствовав целый год, неплохо и передохнуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабуля Жо Синь"
				}
			]
		},
