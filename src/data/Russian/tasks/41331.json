			"dialogs": [
				{
					"id": 413311001,
					"content": "Спасибо тебе за труд! Нам ещё нужно много чего приготовить для праздника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311002
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413311002,
					"content": "#Я был{F#а} рад{F#а} помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413311003
					]
				},
				{
					"id": 413311003,
					"content": "Я так тебе благодарна. Я сама только что собрала немало небесных фонарей, чтобы запустить их вместе со всей деревней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311004
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413311004,
					"content": "Хочешь - приходи вечером к воротам, запустим фонарики и отметим праздник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311005
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413311005,
					"content": "Но вот куда это детишки разбежались?.. Эх, я уже далеко ходить не могу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311006
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413311006,
					"content": "#Не мог{F#ла} бы ты привести детей обратно? Им бы очень понравилось запускать небесные фонари.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311007
					],
					"speakerTitle": "Бабуля Жо Синь"
				},
				{
					"id": 413311007,
					"content": "А кого по дороге увидишь, зови в деревню. Чем больше людей, тем веселее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабуля Жо Синь"
				}
			]
		},
