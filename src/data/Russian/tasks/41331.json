				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310301,
					"content": "Кажется, ещё кое-каких ингредиентов не хватает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310302
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 413310302,
					"content": "Давай я помогу тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310303
					]
				},
				{
					"id": 413310303,
					"content": "А?.. О, мне помощь пришлась бы очень кстати. Я уж начала переживать, что не смогу добыть всех ингредиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310304
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 413310304,
					"content": "Секундочку... Пожалуйста, принеси по три куска сырого мяса и мяса птицы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310305
					],
					"speakerTitle": "Мисс Бай"
				},
				{
					"id": 413310305,
					"content": "А я тем временем постараюсь добыть всё остальное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Бай"
				}
			]
		},
