			"dialogs": [
				{
					"id": 705400101,
					"content": "Ш-ш-ш...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400102
					],
					"speakerTitle": "Сэр Лансекот"
				},
				{
					"id": 705400102,
					"content": "Ах... Этот кот шипит на меня, госпожа Розария! Я боюсь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400103
					],
					"speakerTitle": "Валерина"
				},
				{
					"id": 705400103,
					"content": "Лучше отойди. Если стоять слишком близко, может и лицо расцарапать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400104
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705400104,
					"content": "Ох, Валерина столкнулась с ещё одной неприятностью размером с кошку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400105,
						705400106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705400105,
					"content": "Похоже, в приюте появился новый бездомный кот...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				},
				{
					"id": 705400107,
					"content": "Почётный рыцарь! Заклинательница кошек! Этот большой кот ворвался сюда вслед за Мороженкой! Должно быть, он заметил её, когда она вышла на прогулку, и последовал за ней...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400108
					],
					"speakerTitle": "Валерина"
				},
				{
					"id": 705400108,
					"content": "Ну, ну, спокойно. Здесь никто тебя не обидит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400109
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705400109,
					"content": "Зло и плохие люди, которые понуждали тебя выживать любыми способами... Они не найдут тебя здесь. В этих стенах ты в безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400110
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705400110,
					"content": "Сейчас здесь только хорошие люди. Их постоянное присутствие может немного раздражать, но всё это для твоего же блага. Расслабься и привыкни к спокойной жизни. Это не так уж плохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400111
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705400111,
					"content": "Ш-ш-ш... Мя-я-яу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400112
					],
					"speakerTitle": "Сэр Лансекот"
				},
				{
					"id": 705400112,
					"content": "Этот кот всё понимает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400113
					],
					"speakerTitle": "Валерина"
				},
				{
					"id": 705400113,
					"content": "Похоже на то. Умный кот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400114
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705400114,
					"content": "Этот кот намного больше обычных котов. Его окрас похож на свежевыжатый пузыриновый сок! А ещё на коте шарф с каким-то знаком... О! Это символ рыцарей Ордо Фавониус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705400115,
					"content": "Тогда он заслуживает имени, достойного рыцаря! Хм, по виду он с характером. Как тебе имя «Сэр Лансекот»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705400116,
					"content": "Мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400117
					],
					"speakerTitle": "Сэр Лансекот"
				},
				{
					"id": 705400117,
					"content": "Ты с кошками отлично ладишь. Теперь он стал гораздо спокойнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400118
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705400118,
					"content": "Паймон считает, что ты молодец. Сэр Лансекот сразу успокоился после твоих слов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400119,
						705400120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705400119,
					"content": "Ты уже намного лучше понимаешь кошек, Розария!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400121,
					"content": "Для меня всё это не имеет значения. Хотя... ну, то, что они милые, это хорошо. Главное, что хлопот особо не доставляют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400122
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 705400122,
					"content": "Сейчас Паймон покажет, как умиротворить Сэра Лансекота! Паймон применит свою магию - и он будет абсолютно счастлив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705400120,
					"content": "Надеюсь, работа приносит тебе положительные эмоции!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400106,
					"content": "В нем есть что-то... величественное...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				}
			]
		}
	]
}