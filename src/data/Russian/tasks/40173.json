			},
			"dialogs": [
				{
					"id": 401730301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730302
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730302,
					"content": "(Поверить не могу! Он улизнул! Кошмар... А я распустила перья! Ужас, теперь я буду выглядеть полной дурой...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730303
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730303,
					"content": "(Этот Кокутю настоящий мастер побегов. Но как я скажу им правду? Надо что-то придумать...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730304
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730304,
					"content": "Ситлали! Ты его схватила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401730305,
					"content": "Бабушка здесь одна. Очевидно, нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730306
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 401730306,
					"content": "...Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730307
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730307,
					"content": "...Решила пока его отпустить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730308
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730308,
					"content": "Но я оставила на нём метку. Если он появится в окрестностях, мне будет известен каждый его шаг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730309
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730309,
					"content": "Значит, бабушка только сделала вид, что вышла из пещеры... а на самом деле устроила ловушку и ждала в засаде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730310
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 401730310,
					"content": "Да, ты ведь и Оророна так же поймала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401730311,
					"content": "Но как ты поняла, что Кокутю придёт сюда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401730312,
					"content": "Из-за приманки. Я нарочно оставила на столе карту Пепельного моря и осколок лука. Скорее всего, Кокутю искал именно это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730313
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730313,
					"content": "И стоило нам отойти от пещеры, как ловушка сработала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730314
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730314,
					"content": "Что? Значит, в пещере стояли настоящие ловушки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401730315,
					"content": "Конечно. Но для вас они безопасны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730316
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730316,
					"content": "Видите! Я говорил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730317
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 401730317,
					"content": "Значит, господин Кокутю меня использовал... На самом деле он искал информацию о Пепельном море...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730318
					],
					"speakerTitle": "Лейла"
				},
				{
					"id": 401730318,
					"content": "Да. Я с самого начала не могла понять: зачем ему было оставлять осколок в лагере?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730319
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730319,
					"content": "Но когда я узнала местоположение Пепельного моря, всё стало ясно. Это была приманка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730320
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730320,
					"content": "Он рассчитывал, что дух Лейлы заблудится, а племя придёт ему на помощь. Спасая Лейлу, мы поможем ему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730321
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730321,
					"content": "Значит, он тоже рыбачил! Он хотел, чтобы настоящий духовидец взял осколок в проводники...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401730322,
					"content": "Да. И кое-кто попался на его удочку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730323
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730323,
					"content": "Простите, я попался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730324
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 401730324,
					"content": "Но ведь и бабушка тоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730325
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 401730325,
					"content": "Паршивец! Я ввязалась в эту историю только из-за тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730326
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730326,
					"content": "Как бы там ни было, Кокутю очень хитёр. Он добился своего, почти не рискуя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730327
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 401730327,
					"content": "Да! А представь, если бы он сразу пошёл к Ситлали! Она бы мигом его раскусила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730328
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401730328,
					"content": "Но всё равно... Ситлали, почему ты дала ему уйти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401730329,
					"content": "Кхм... Здесь я не могла рискнуть и воспользоваться всеми своими способностями. Кокутю - довольно скользкий тип. Кто знает, что бы он выкинул, реши я удерживать его силой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730330
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730330,
					"content": "Значит, я выбрал неудачное место? Прости...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730331
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 401730331,
					"content": "Чтобы спасти Лейлу, я искал место, насыщенное духовной энергией, и в итоге выбрал обитель безумного мудреца...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730332
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 401730332,
					"content": "...Безумного мудреца?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730333
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401730333,
					"content": "Да, он спит прямо за стеной. И если он проснётся, дело примет совсем иной оборот. Поэтому я не могла развернуться в полную силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730334
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730334,
					"content": "Но есть и хорошая новость: я отобрала у него карту и осколок. Не позволила ему вытирать о себя ноги!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730335
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730335,
					"content": "Отлично! Значит, он ушёл с пустыми руками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730336
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401730336,
					"content": "Гм... Но есть и плохая новость. Скорее всего, он видел карту. И хотя место, где когда-то находилось Пепельное море, никогда не было тайной за семью печатями, всё же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730337
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730337,
					"content": "Да, тревожная новость! Вдруг он задумал недоброе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730338
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401730338,
					"content": "Не беспокойся, я за ним прослежу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730339
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730339,
					"content": "#Да, Лейла, если ты не возражаешь, я подарю карту с осколком {M#путешественнику}{F#путешественнице}. Вдруг они однажды пригодятся {M#ему}{F#ей} в дороге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730340
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730340,
					"content": "#Да, конечно! {NICKNAME} заслужил{F#а} такой подарок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730341
					],
					"speakerTitle": "Лейла"
				},
				{
					"id": 401730341,
					"content": "Вы уверены? Это очень ценные вещи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730342
					]
				},
				{
					"id": 401730342,
					"content": "#Нам они всё равно ни к чему. А если они в самом деле могут указать путь к Пепельному морю, уверена, искатель{F#ница} приключений вроде тебя едва ли упустит такой шанс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730343
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730343,
					"content": "У Бабушки Ицтли есть такое предчувствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730344
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730344,
					"content": "Эм, Бабушка Ицтли... Как ты думаешь, я всё ещё духовный чурбан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730345
					],
					"speakerTitle": "Лейла"
				},
				{
					"id": 401730345,
					"content": "Что за глупый вопрос? Ты ведь заметил, что я оставила вместо себя мираж! Конечно, я нарочно выполнила трюк небезупречно, но настоящий чурбан ничего бы не увидел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730346
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730346,
					"content": "Оророн, как будешь свободен, преподай этому парню несколько уроков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730347
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730347,
					"content": "Лейла, не прекращай стараться. И посмотрим, как далеко ты сможешь продвинуться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730348
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730348,
					"content": "Невероятно... Жизнь полна чудес. Продолжай двигаться вперёд, и как знать, вдруг посреди дороги тебя будет ждать куча удобрений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730349
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 401730349,
					"content": "Я так рад за тебя, Лейла. Мы будем усердно трудиться и однажды станем прекрасными капустными кочанами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Оророн"
				}
			]
		},
