					"Куинн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200011001,
					"content": "#Благодарю тебя, путешественн{F#ица}{M#ик}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011002
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200011002,
					"content": "Я хотел собрать фрукты здесь, а потом продать их в городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011003
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200011003,
					"content": "Но я не рассчитывал, что дорога будет заблокирована.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011004
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200011004,
					"content": "Ладно, я возвращаюсь в Мондштадт! Заглядывай ко мне в лавку, когда будешь в городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011005
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200011005,
					"content": "Прими это в знак моей благодарности. У меня самые свежие фрукты! Поэтому Беатрис закупается только у меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Куинн"
				}
			]
		}
