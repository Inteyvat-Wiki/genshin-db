				"points": []
			},
			"dialogs": [
				{
					"id": 200010901,
					"content": "#Спасибо, что прогнал{F#а} их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010902
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200010902,
					"content": "Хвала богам, вы здесь... Дорога заблокирована, я не могу продолжить путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010903
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200010903,
					"content": "Если так будет продолжаться, то все фрукты испортятся. А я так долго их собирал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010904
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200010904,
					"content": "Ты поможешь мне расчистить путь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010905,
						200010906
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200010905,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010907
					]
				},
				{
					"id": 200010907,
					"content": "Ха-ха! Спасибо тебе огромное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200010906,
					"content": "Мне некогда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010908
					]
				},
				{
					"id": 200010908,
					"content": "Серьёзно? Я не думал, что ты бросишь меня в беде. Ты моя последняя надежда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Куинн"
				}
			]
		},
		{
			"id": 2000110,
