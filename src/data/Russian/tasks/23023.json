					"Вардан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230301,
					"content": "#Этого хватит. Огромное тебе спасибо, путешественни{F#ца}{M#к}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230302
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230302,
					"content": "С этим особым удобрением почва станет очень плодородной, а роза будет прекрасно расти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230303
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230303,
					"content": "Надеюсь, оно не смоется водой, как в прошлый раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230304
					],
					"speakerTitle": "Гурген"
				},
				{
					"id": 230230304,
					"content": "Так вы и раньше удобряли почву?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230305
					]
				},
				{
					"id": 230230305,
					"content": "Да, мы пробовали самое обычное удобрение, но пользы было мало... Скорее, не было вообще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230306
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230306,
					"content": "Но на других полях оно прекрасно работало, вот уж не знаю почему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230307
					],
					"speakerTitle": "Гурген"
				},
				{
					"id": 230230307,
					"content": "#В общем, не важно. Возьми это в благодарность, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вардан"
				}
			]
		},
