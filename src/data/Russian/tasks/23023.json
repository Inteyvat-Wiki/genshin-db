			"trigger": {
				"objectNames": [
					"Гурген",
					"Вардан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230101,
					"content": "Пап, так не пойдёт. Розы очень плохо растут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230102
					],
					"speakerTitle": "Гурген"
				},
				{
					"id": 230230102,
					"content": "Нам нужно что-то придумать. Иначе мы не успеем отдать травы вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230103
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230103,
					"content": "Почва в порядке. Сорняков и вредителей нет. Что же случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230104
					],
					"speakerTitle": "Гурген"
				},
				{
					"id": 230230104,
					"content": "Что вас беспокоит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230105
					]
				},
				{
					"id": 230230105,
					"content": "А? Ты хочешь купить травы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230106
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230106,
					"content": "Дело в том, что мы регулярно поставляем партии лекарственных трав врачам Бимарстана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230107
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230107,
					"content": "Из всех нужных для них трав самое особенное - сумерская роза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230108
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230108,
					"content": "Розы используются при изготовлении лекарств?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230109
					]
				},
				{
					"id": 230230109,
					"content": "Это уже нужно спрашивать в Бимарстане.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230110
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230110,
					"content": "Врачи говорят, что роза в сочетании с другими лекарствами может использоваться для лечения теплового удара, оказывает успокаивающее действие при проблемах с желудком и что-то ещё... Точно не помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230111,
						230230113
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230111,
					"content": "Ну раз так, я помогу!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230112
					]
				},
				{
					"id": 230230112,
					"content": "Вот спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230113,
					"content": "Что случилось с этой розой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230114
					]
				},
				{
					"id": 230230114,
					"content": "Не знаю, в чём дело, но она растёт слишком медленно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230115
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230115,
					"content": "По нашему опыту проблема должна быть или в почве, или в насекомых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230116
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230116,
					"content": "В этой почве мы выращивали и другие травы, и всё было в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230117
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230117,
					"content": "Мы каждый день чистим от насекомых, о них не может быть и речи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230118
					],
					"speakerTitle": "Гурген"
				},
				{
					"id": 230230118,
					"content": "Мы не можем тратить время на поиски причин. Иначе мы не успеем вовремя доставить розы в Бимарстан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230119
					],
					"speakerTitle": "Гурген"
				},
				{
					"id": 230230119,
					"content": "И вот мы решили использовать специальное удобрение для почвы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230120
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230120,
					"content": "Но ведь нам нужно позаботиться и о других полях. У нас нет времени собирать сырьё для удобрения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230121
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230121,
					"content": "#Путешественни{F#ца}{M#к}, ради пациентов в Бимарстане, не мог{F#ла} бы ты оказать нам услугу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230122
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230122,
					"content": "Я помогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230123
					]
				},
				{
					"id": 230230123,
					"content": "Вот спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230124
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230124,
					"content": "Так-так, что там у нас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вардан"
				}
			]
		},
