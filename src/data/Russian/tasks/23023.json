			"dialogs": [
				{
					"id": 230230401,
					"content": "Возможно, проблема не только в плодородности, но и в воде...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230402
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230402,
					"content": "Может быть, мы слишком глубоко закопали розу и ей недостаёт воды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230403
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230403,
					"content": "#Путешественни{F#ца}{M#к}, помоги нам полить эту розу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вардан"
				}
			]
		},
		{
