				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230601,
					"content": "Уф... Сейчас влаги должно быть достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230602
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230602,
					"content": "Большое спасибо. Без тебя мы бы не справились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230603
					],
					"speakerTitle": "Гурген"
				},
				{
					"id": 230230603,
					"content": "Странно, на этот раз столько воды ушло на увлажнение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230604
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230604,
					"content": "Как будто мы в два раза больше воды вылили, чем обычно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230605
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230605,
					"content": "Это тебе от усталости мерещится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230606
					],
					"speakerTitle": "Гурген"
				},
				{
					"id": 230230606,
					"content": "Если бы мы вылили в два раза больше воды, то тут было бы болото, а сейчас почва нормальной влажности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230607
					],
					"speakerTitle": "Гурген"
				},
				{
					"id": 230230607,
					"content": "Наверное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230608
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230608,
					"content": "Надеюсь, розы будут хорошо расти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230609
					]
				},
				{
					"id": 230230609,
					"content": "Не беспокойся. Ради врачей и пациентов в Бимарстане мы будем заботиться о розе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230610
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230610,
					"content": "#Возьми это в благодарность, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230611
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230611,
					"content": "Но мне правда кажется, что в этот раз мы слишком много полили...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вардан"
				}
			]
