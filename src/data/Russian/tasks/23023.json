						230230202
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230202,
					"content": "У нас есть почти все ингредиенты для особого удобрения, но закончились фрукты харра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230203
					],
					"speakerTitle": "Вардан"
				},
				{
					"id": 230230203,
					"content": "#Путешественни{F#ца}{M#к}, ты не принесёшь нам несколько фруктов харра?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вардан"
