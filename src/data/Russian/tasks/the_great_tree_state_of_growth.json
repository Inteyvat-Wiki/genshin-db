			"dialogs": [
				{
					"id": 230290401,
					"content": "Ну как? Вы сняли общий вид Священного древа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290402
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290402,
					"content": "Всё готово.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290403
					]
				},
				{
					"id": 230290403,
					"content": "О, дай посмотрю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290404
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290404,
					"content": "Прекрасно. Ракурс хороший и изображение чёткое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290405
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290405,
					"content": "#Вот твоя награда. Спасибо за помощь, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290406
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290406,
					"content": "Со стволом проблем нет... Форма окружающих ветвей тоже не изменилась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290407
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290407,
					"content": "Я подожду, пока Ладеп и Фарез закончат сбор данных, и мы сможем перейти к следующей теме...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясмин"
				}
			]
		}
