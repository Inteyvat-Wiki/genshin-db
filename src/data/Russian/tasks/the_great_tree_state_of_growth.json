				"points": []
			},
			"dialogs": [
				{
					"id": 230290101,
					"content": "Сейчас самое время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290102
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290102,
					"content": "Ты ещё исследуешь корни Священного древа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290103
					]
				},
				{
					"id": 230290103,
					"content": "#Путешественни{F#ца}{M#к}, ты каждый раз приходишь вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290104
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290104,
					"content": "Спасибо тебе за помощь. Теперь со Священным древом всё хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290105
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290105,
					"content": "Мы с Ладепом обсудили и пришли к выводу, что это хорошее состояние продлится ещё долго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290106
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290106,
					"content": "Теперь мы можем, наконец, освободиться и заняться подготовкой к написанию научной работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290107
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290107,
					"content": "Смотри, я позаимствовала фотокамеру у Фареза и собираюсь сфотографировать Священное древо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290108
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290108,
					"content": "#Путешественни{F#ца}{M#к}, помоги мне снять общий вид Священного древа. Я отметила точку на твоей карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290109,
						230290110
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290109,
					"content": "Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230290110,
					"content": "Почему ты не можешь сделать это сама?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290111
					]
				},
				{
					"id": 230290111,
					"content": "Эм, это... это... слишком высоко для меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290112
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290112,
					"content": "Мне страшно каждый раз, когда я одна поднимаюсь на высокое место... Всё время кажется, что меня или рукопись сдует ветром...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290113
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230290113,
					"content": "#Обычно туда поднимается Фарез, но сегодня у него, похоже, другие дела, так что остаётся попросить только тебя, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясмин"
				}
			]
		},
