			"dialogs": [
				{
					"id": 111011201,
					"content": "Насчёт «кармы»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111011202
					]
				},
				{
					"id": 111011202,
					"content": "В книге говорится, что после долгой борьбы против злых божеств все Яксы стали связаны кармой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111011203,
					"content": "Ненависть Архонтов отравляет сознание Якс и вызывает в них ужасный гнев, боль и ужас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111011204,
					"content": "Эх... Как грустно... Все эти годы они защищали Ли Юэ, а вместо награды им достались одни лишь страдания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
