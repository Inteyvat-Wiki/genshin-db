			},
			"dialogs": [
				{
					"id": 111010201,
					"content": "Вы желаете экземпляр «Яксы: Защитники Адептов»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010202
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 111010202,
					"content": "Вот, возьмите. Сдачу можете оставить себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010203
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111010203,
					"content": "Ох, вы так щедры! Благодарю за то, что удостоили нас визитом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010204
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 111010204,
					"content": "Это же Звездохват, верно? Забавно, что мы встретили его здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010205,
						111010206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111010205,
					"content": "Звездолов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				},
				{
					"id": 111010207,
					"content": "#Слышал{F#а}, какую книгу он взял? «Яксы: Защитники Адептов» или что-то вроде того?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111010208,
					"content": "Как бы то ни было, это книга про Адептов. Странно... Зачем Адепту читать про Адептов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010209,
						111010211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111010209,
					"content": "Он мне всегда казался подозрительным...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010210
					]
				},
				{
					"id": 111010210,
					"content": "Правда? И что же в нём подозрительного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111010214,
					"content": "Зачем Адепту вообще может понадобиться мора?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010215
					]
				},
				{
					"id": 111010215,
					"content": "Действительно... Все Адепты, которых мы встречали, не просили нас ни о чём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111010220,
					"content": "А!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111010221,
					"content": "Паймон думает, что нам нужно проверить эту самую книжку. Возможно, мы узнаем что-нибудь полезное об этом парне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111010216,
					"content": "Сдаётся мне, что это обычное шарлатанство.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010217
					]
				},
				{
					"id": 111010217,
					"content": "Хочешь сказать, что он не выполнит наши желания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111010218,
					"content": "У него уродская маска.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010219
					]
				},
				{
					"id": 111010219,
					"content": "Хм... Действительно, уродская. Очень подозрительно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111010211,
					"content": "Самолюбование?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010212
					]
				},
				{
					"id": 111010212,
					"content": "Возможно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111010213,
					"content": "Знаешь, Паймон тут подумала... Что-то с этим парнем не так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111010206,
					"content": "Совпадение? Не думаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				}
			]
		},
