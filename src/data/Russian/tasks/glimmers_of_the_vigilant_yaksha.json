			},
			"dialogs": [
				{
					"id": 111010501,
					"content": "По моему велению, сгиньте, демоны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010502
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111010502,
					"content": "Сгиньте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010503
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111010503,
					"content": "П-почему вы не убегаете?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010504
					],
					"speakerTitle": "Небесный Император Звездолов"
				},
				{
					"id": 111010504,
					"content": "Beru nye! Beru nya! Beru nyaaaa!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010505
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 111010505,
					"content": "Ого, кажется, у этого Звездохвата проблемы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111010506,
					"content": "Могут пострадать невинные люди, мы не можем их бросить! Надо помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
