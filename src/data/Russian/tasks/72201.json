				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рэро"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010101,
					"content": "Добрые люди, пожалейте меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010102,
						722010103
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010102,
					"content": "Вы в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				},
				{
					"id": 722010104,
					"content": "Спасибо, что слушаете, как старик изливает свои горести... Идите сюда, дайте мне сказать кое-что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010105
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010105,
					"content": "Жизнь всегда была ко мне жестока...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010106
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010106,
					"content": "Когда я был совсем маленьким, главный священник случайно опрокинул лампу и сжёг волосы на голове моей тёти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010107
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010107,
					"content": "Кошмар...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010108
					]
				},
				{
					"id": 722010108,
					"content": "Позже я заболел какой-то странной болезнью, и стал неказистым. После я упал из колыбели и сломал шесть рёбер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010109
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010109,
					"content": "А когда я немного подрос, мой отец случайно ударил меня лопатой по голове, когда бросился помогать моему двоюродному брату, который подавился грибами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010110
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010110,
					"content": "А потом вэн камуй съел моего любимого зяблика, который жил у нас дома. А потом кабан уронил со скалы самого вэн камуя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010111
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010111,
					"content": "После этого девушка, которая мне нравилась, случайно принесла священника в жертву Громовой птице, и её изгнали с острова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010112
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010112,
					"content": "Когда я вырос, моя бабушка не смогла перенести моего уродства и умерла от горя, а вскоре за ней последовал и дедушка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010113
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010113,
					"content": "А потом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010114
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010114,
					"content": "Вы смогли найти утешение в своей семье?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010115
					]
				},
				{
					"id": 722010115,
					"content": "Кстати, о моей семье... Когда я достиг совершеннолетия, знахарь сказал, что я не смогу иметь детей, потому что у меня вырос... Одну минуту, позвольте мне показать вам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010116,
						722010117
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010116,
					"content": "Не надо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010118,
					"content": "Послушайте меня, умоляю вас. Пусть это будет последнее, что вы сделаете для бедного старика...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010119,
						722010120
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010119,
					"content": "Говорите.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010121,
					"content": "Некоторое время назад я случайно уронил своё золотое кольцо в могилу жены, когда хоронил её...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010122
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010122,
					"content": "Это кольцо - всё, что у меня было. Я не смею его откопать. Боюсь, что её дух может разгневаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010123
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010123,
					"content": "#Ты хочешь, чтобы я раскопал{F#а} могилу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010124
					]
				},
				{
					"id": 722010124,
					"content": "#Ты {F#чужеземка}{M#чужеземец}. Вы, чужеземцы, делаете очень странные вещи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010125
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010125,
					"content": "Нет, нет, подождите... Я хотел сказать, что чужеземцы смогут избежать гнева местных духов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010126
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010126,
					"content": "Её могила находится рядом со святилищем Тирай. Отправляйтесь туда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010120,
					"content": "Лишь бы это не было чем-то странным...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010117,
					"content": "Слишком много информации!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010103,
					"content": "Вам нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				}
			]
		},
		{
			"id": 7220102,
			"completionStepIds": [
				7220103
			],
