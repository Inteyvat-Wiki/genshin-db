			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рэро"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010201,
					"content": "Ха-ха-ха-ха-ха-ха... Мне тяжело дышать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010202
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010202,
					"content": "Ха-ха-ха-ха-ха-ха... Я тут смеюсь от слёз! Ах, если бы ты только была здесь! Если бы ты только видела!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010203,
						722010204
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010203,
					"content": "Я начинаю злиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				},
				{
					"id": 722010205,
					"content": "Прошу прощения, простите... Прошу, не злитесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010206
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010206,
					"content": "Мы с женой очень любили разыгрывать людей. Шутки никогда не повторялись дважды и нравились всем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010207
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010207,
					"content": "Позже она тяжело заболела и рано покинула этот мир... Она сказала, что я должен разыграть кого-то на её могиле. Иначе её дух не упокоится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010208
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010208,
					"content": "Я просто хотел выполнить данное ей обещание. Как вам розыгрыш? Правда здорово вышло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010209,
						722010210,
						722010211
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010209,
					"content": "Дурацкая шутка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010212,
					"content": "Да ладно вам! Все чужеземцы какие-то скучные!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010213
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010213,
					"content": "Вы даже не захотели посмотреть мой фокус с прыскающей водой бородавкой. Скучно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010214
					],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010214,
					"content": "Ладно, ладно, я ухожу! Увидимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рэро"
				},
				{
					"id": 722010210,
					"content": "Мы чуть не погибли из-за вас!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010211,
					"content": "Я вам больше не доверяю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010204,
					"content": "Не хотите рассказать, в чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				}
			]
		},
