			"dialogs": [
				{
					"id": 761850201,
					"content": "Чай, поданный вместе с ценной информацией, имеет совсем другой вкус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850202,
						761850203
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761850202,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761850204,
					"content": "Береги себя. И заходи, когда будет время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761850203,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
