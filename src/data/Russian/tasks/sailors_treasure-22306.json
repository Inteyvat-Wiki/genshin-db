			"dialogs": [
				{
					"id": 223060601,
					"content": "С возвращением! Получилось найти сокровища?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060602
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223060602,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060603
					]
				},
				{
					"id": 223060603,
					"content": "Отлично! Я же говорил, что ты настоящий искатель приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060604
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223060604,
					"content": "Так, так, так... Что у нас тут? Хм... Какой-то хлам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060605
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223060605,
					"content": "Но это лучше, чем ничего... Вот твоя доля. Я передам Чжан Шуню его часть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060606
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223060606,
					"content": "#Эх... Всё ещё не наш{F#ла}{M#ёл} сокровище... Кажется, тот парень меня обманул...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бо Лай"
