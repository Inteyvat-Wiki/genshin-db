				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бо Лай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223060201,
					"content": "Здравствуй, дружок! Чем могу быть полезен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060202
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223060202,
					"content": "Мне нужны карты сокровищ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060203
					]
				},
				{
					"id": 223060203,
					"content": "Карты сокровищ? А! Ты имеешь в виду карты Чжан Шуня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060204
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223060204,
					"content": "Ты действительно собираешься отправиться на поиски сокровищ? Если честно, я никогда не воспринимал эти карты всерьёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060205
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223060205,
					"content": "Но ты выглядишь как серьёзный искатель приключений. У тебя загораются глаза при одном упоминании сокровищ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060206
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223060206,
					"content": "Мне от этих карт всё равно нет никакого проку. Можешь забрать их все.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060207
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223060207,
					"content": "К слову, если ты найдёшь сокровища, то предлагаю поделить всё поровну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060208
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223060208,
					"content": "В конце концов, эти карты пролежали у меня некоторое время. Думаю, что я заслужил свою часть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бо Лай"
				}
			]
		},
		{
			"id": 2230603,
			"completionStepIds": [
				2230603,
				2230621,
				2230622,
				2230623
			],
