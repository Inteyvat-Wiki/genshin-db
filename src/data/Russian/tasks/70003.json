			"trigger": {
				"objectNames": [
					"Потерявшийся котёнок"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030501,
					"content": "Это и впрямь кошка. Интересно, что она здесь забыла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700030502,
					"content": "Мяу... мя-я-яу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030503,
						700030504
					],
					"speakerTitle": "Потерявшийся котёнок"
				},
				{
					"id": 700030503,
					"content": "Мяу, мяу, мяу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				},
				{
					"id": 700030505,
					"content": "Мяу-мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030506
					],
					"speakerTitle": "Потерявшийся котёнок"
				},
				{
					"id": 700030506,
					"content": "Эм, не хочу тебя расстраивать, но Паймон кажется, что она тебя не понимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700030507,
					"content": "Давай для начала спустим её вниз. Может быть, Арамис знает, чья эта кошка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700030504,
					"content": "Ты потерялась?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				}
			]
		},
		{
			"id": 7000306,
			"completionStepIds": [
				7000308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000308",
							"2"
						],
						"stepId": 7000308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арамис"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030601,
					"content": "Прости, я её не видел. Если бы видел, я бы обязательно запомнил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030602
					],
					"speakerTitle": "Арамис"
				},
				{
					"id": 700030602,
					"content": "Как жаль... Моя пушистая мадам очень любит цветы. Я подумала, что, может быть, она погналась за лепестками и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030603
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700030603,
					"content": "Кто-то потерял кошку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030604
					]
				},
				{
					"id": 700030604,
					"content": "Мяу... Мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030605
					],
					"speakerTitle": "Потерявшийся котёнок"
				},
				{
					"id": 700030605,
					"content": "Это... моя Бабочка? Ох, это правда она! Где же ты была?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030606
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700030606,
					"content": "Вон на той стене.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030607
					]
				},
				{
					"id": 700030607,
					"content": "Значит, я была права... Спасибо тебе огромное. Моя Бабочка любит гоняться за лепестками цветов на ветру, а сейчас, во время праздника, они летают по всему городу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030608
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700030608,
					"content": "Спасибо тебе ещё раз. Следующий напиток в «Кошкином хвосте» за мой счёт. Ну, только безалкогольный, конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030609,
						700030610
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700030609,
					"content": "Ну вот опять...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				},
				{
					"id": 700030611,
					"content": "Ха-ха... Ещё раз, спасибо тебе. Увидимся, и счастливого Праздника ветряных цветов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030612
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 700030612,
					"content": "#Никогда бы не подумал, что кошкам могут так нравиться цветы. Какой насыщенный праздник... В любом случае, хорошо, что ты {F#нашла}{M#нашёл} её кошку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030613
					],
					"speakerTitle": "Арамис"
				},
				{
					"id": 700030613,
					"content": "#Если бы ты попросил{F#а} меня самого подняться за ней на стену, думаю, мои колени точно бы отвалились...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030614
					],
					"speakerTitle": "Арамис"
				},
				{
					"id": 700030614,
					"content": "Спасибо за твою помощь. Вот, держи небольшое вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арамис"
				},
				{
					"id": 700030610,
					"content": "Как-нибудь в другой раз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				}
			]
		}
	]
}