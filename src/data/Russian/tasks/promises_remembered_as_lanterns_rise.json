			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Верр Голдет"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240201,
					"content": "#Чем могу помочь, путешественни{M#к}{F#ца}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240202
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718240202,
					"content": "Как там малышка Мин?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240203
					]
				},
				{
					"id": 718240203,
					"content": "Ах, Мин? После того происшествия она ведёт себя очень тихо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240204
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718240204,
					"content": "Бедный ребёнок... В дни праздников, когда шум веселья наполнял постоялый двор, ей было особенно одиноко, вот она и безобразничала, пугая гостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240205
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718240205,
					"content": "Думаю, ей просто хотелось с кем-нибудь поиграть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240206,
						718240207
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718240206,
					"content": "Может, подарим ей небесный фонарь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				},
				{
					"id": 718240208,
					"content": "Ты хочешь подарить ей небесный фонарь? Хм... Неплохая идея. Вот только отыскать её будет трудно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240209
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718240209,
					"content": "Чтобы найти её, повесь небесный фонарь на верхушку дерева в лесу поблизости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240210
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718240210,
					"content": "Тогда она наверняка увидит его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718240207,
					"content": "Интересно, нравятся ли ей небесные фонари?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				}
			]
		},
