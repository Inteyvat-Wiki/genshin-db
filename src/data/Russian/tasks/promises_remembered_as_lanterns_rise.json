			"dialogs": [
				{
					"id": 718240601,
					"content": "Кажется, мы на месте. Но вот где она?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718240602,
					"content": "#О, ты вернул{F#ась}{M#ся}, чтобы поиграть со мной!",
