			"trigger": {
				"objectNames": [
					"Улыбчивый Янь Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240101,
					"content": "Мне стоит поторопиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240102
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718240102,
					"content": "Неужели дела у постоялого двора идут настолько хорошо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240103
					]
				},
				{
					"id": 718240103,
					"content": "Да нет. Наши работники ушли праздновать в город, и мне почти всё приходится делать самому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240104
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718240104,
					"content": "Хорошо хоть гостей не так много, иначе я бы не справлялся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240105
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718240105,
					"content": "Кхм. Я ещё хотел бы поблагодарить тебя за недавнюю помощь. Без неё я бы надолго выбыл из строя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240106,
						718240107
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718240106,
					"content": "Значит, ты снова...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				},
				{
					"id": 718240108,
					"content": "Нет! Вовсе нет, поверь мне! Покажись она тут ещё раз, я бы не выдержал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240109
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718240109,
					"content": "Если ты действительно хочешь знать про... неё, то спрашивай у хозяйки. Я правда ничего не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718240107,
					"content": "Она что, опять...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				}
			]
		},
		{
			"id": 7182402,
			"completionStepIds": [
				7182402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
