					"nextDialogs": [
						718240303
					]
				},
				{
					"id": 718240303,
					"content": "Отлично. Мне кажется, она будет очень рада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240304
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 718240304,
					"content": "Любопытно, какое бы она загадала желание...",
