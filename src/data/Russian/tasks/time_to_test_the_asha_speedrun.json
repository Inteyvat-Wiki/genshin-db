			"dialogs": [
				{
					"id": 150480801,
					"content": "Фух, сердце так колотится... Долго его успокаивать придётся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480802
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150480802,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480803
					],
					"speakerTitle": "Аша"
				},
				{
					"id": 150480803,
					"content": "Поздравляем Беннета и ашу! Вы отличная команда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150480804,
					"content": "А как вы работали вместе в самом конце! Без вашей дружбы ничего бы не получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150480805,
					"content": "Вместе вы оказались сильнее обстоятельств.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480806
					]
				},
				{
					"id": 150480806,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480807
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150480807,
					"content": "#{NICKNAME}, спасибо тебе ещё раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480808
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150480808,
					"content": "#Ты поверил{F#а} в меня и убедил{F#а} сотрудника курорта, что на меня можно положиться. Без тебя мне бы не дали выполнить это задание, и я не смог бы пройти его вместе с ашей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480809
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150480809,
					"content": "Господин Беннет, последние испытания завершены, а это значит, что аттракцион «Аша, беги!» готов принять первых посетителей. Благодарим вас за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480810
					],
					"speakerTitle": "Гаун"
				},
				{
					"id": 150480810,
					"content": "Ты слышал, аша? У нас получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480811
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150480811,
					"content": "Я не забуду вас, господин Беннет. Добрый и отважный искатель приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480812
					],
					"speakerTitle": "Гаун"
				},
				{
					"id": 150480812,
					"content": "Наши приключения ещё не закончились, но я понимаю, что мне будет трудно с ним расстаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480813
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150480813,
					"content": "Я буду скучать по тебе, аша.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480814
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150480814,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480815
					],
					"speakerTitle": "Аша"
				},
				{
					"id": 150480815,
					"content": "Нет... Ты не должен меня утешать! Я командир! Я должен заботиться о товарищах по отряду, а не наоборот!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480816
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150480816,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480817
					],
					"speakerTitle": "Аша"
				},
				{
					"id": 150480817,
					"content": "Наверное, мне соринка в глаз попала. Горло перехватило... Простите, ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480818
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150480818,
					"content": "Надо будет попросить профессора Венти научить меня правильно выражать свои чувства в такие моменты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480819
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150480819,
					"content": "Паймон почти уверена, что бродяжка скажет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480820
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150480820,
					"content": "Не бойся открыть друзьям своё сердце.",
