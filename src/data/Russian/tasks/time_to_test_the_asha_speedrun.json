						150480303
					],
					"speakerTitle": "Аша"
				},
				{
					"id": 150480303,
					"content": "Отличная работа, напарник! Я и не думал, что ты у нас такой спортсмен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480304
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150480304,
					"content": "Теперь очередь Беннета?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150480305,
					"content": "Да! Я сделал разминку, растяжку и готов к подвигам. Не сомневайтесь, я справлюсь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480306
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150480306,
					"content": "Будь осторожен.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480307
					]
				},
				{
					"id": 150480307,
					"content": "Конечно! Спасибо тебе за заботу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Беннет"
				}
			]
		},
