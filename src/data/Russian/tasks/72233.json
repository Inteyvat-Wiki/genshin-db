			},
			"dialogs": [
				{
					"id": 722330401,
					"content": "#{NICKNAME}, остались ещё вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330402,
						722330406
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330402,
					"content": "О знаках-ключах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330403
					]
				},
				{
					"id": 722330403,
					"content": "Мы оставили знаки-ключи у Плавника и Сердца Ватацуми...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330404
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330404,
					"content": "Мы хотели спрятать их, но не слишком далеко. Мало кто знает про эти два храма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330405
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330405,
					"content": "Сделали всё, что могли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330406,
					"content": "Об алтарях...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330407
					]
				},
				{
					"id": 722330407,
					"content": "Они находятся на севере и востоке. Вдоль второй горной гряды, которая опоясывает Бездну, омытую луной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330408
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330408,
					"content": "Если провести две линии от Сангономии до Плавника Ватацуми и Сердца Ватацуми...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330409
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330409,
					"content": "... затем посмотреть на то, где они пересекаются с горной грядой, то точки пересечения и есть те два места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цуюко"
				}
			]
		},
		{
			"id": 7223305,
