						"rawParams": [
							"7223302",
							"3"
						],
						"stepId": 7223302,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223303",
							"2"
						],
						"stepId": 7223303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цуюко",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330201,
					"content": "Это называется «знак-ключ», когда-то такие знаки использовались по всей Энканомии. Они появлялись на поверхности только перед открытием прохода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330202
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330202,
					"content": "По легендам, с пробуждением Энканомии народу Ватацуми будет дарован новый набор ключей. В записях Сангономии сказано, что такие знаки-ключи бывают пяти видов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330203
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330203,
					"content": "Пока мы нашли три из них на Ватацуми. Чтобы снять печать, нужно поместить знаки на их места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330204
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330204,
					"content": "Мы извлекли найденные нами ключи из их замков и перенесли в другие места на Ватацуми, чтобы восстановить барьер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330205
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330205,
					"content": "Мы сделали это, чтобы внутрь не проскользнули ватаги несмышлёных детишек, шпионы Фатуи, жители Наруками и разные чужестранцы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330206
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330206,
					"content": "Э-э, конечно, речь не о таких чужестранцах, как ты. Ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330207
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330207,
					"content": "Нам ещё не удалось установить связь с Гильдией искателей приключений, поэтому им пока тоже сюда нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330208
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330208,
					"content": "А разве можно пускать туда искателей приключений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330209,
					"content": "В летописях есть упоминания о подобных случаях. Мы стремимся к взаимовыгодному сотрудничеству. Всегда хорошо, когда рядом есть искусные исследователи. Как искатели приключений. Или как вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330210
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330210,
					"content": "Хм, то есть в этот раз никто не пробрался туда раньше нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330211,
					"content": "Паймон, где твои манеры?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330212
					]
				},
				{
					"id": 722330212,
					"content": "Ну, как бы это сказать? Хоть мы и восстановили барьер, я не могу гарантировать, что внутрь никто не проник. Мы не сразу разобрались со знаками-ключами и убрали их, так что кто-то мог и проскользнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330213
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330213,
					"content": "Как я уже говорила, нам не хватает людей... Так что если столкнётесь с Фатуи, Похитителями сокровищ, кайраги или им подобными, не стесняйтесь преподать им урок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330214
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330214,
					"content": "Подожди-ка. Если вся эта толпа так легко могла туда забраться, то для чего нужен этот помытый-где-то-там ключ, который мы принесли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330215,
					"content": "Энканомия пробудится, только если достать ключ бездны, омытой луной. И только он может запустить испытание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330216
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330216,
					"content": "Но если кто-то направляется в Энканомию не для того, чтобы совершить Ватацуми горё мацури... возможно, для него открыты и более хитрые обходные пути. Кто знает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330217
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330217,
					"content": "В любом случае вам лучше поспешить и забрать остальные знаки-ключи на Ватацуми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330218
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330218,
					"content": "Мы оставили знаки-ключи у Плавника и Сердца Ватацуми. А их алтари находятся на второй горной гряде вокруг Бездны, омытой луной, на пересечении с линиями, ведущими от Плавника и Сердца к храму Сангономии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330219
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330219,
					"content": "Что ж, тогда я буду ждать от вас новостей на обычном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цуюко"
				}
			]
		},
		{
			"id": 7223303,
			"completionStepIds": [
				7223308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
