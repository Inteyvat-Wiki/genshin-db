				"points": []
			},
			"dialogs": [
				{
					"id": 722330101,
					"content": "#{NICKNAME}, приветствую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330102
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330102,
					"content": "Привет! Госпожа Цуюко, ты уже готова к ритуалу-шмитуалу с кораллами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330103,
					"content": "Увы, не всё так просто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330104
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330104,
					"content": "Госпожа Цуюко, мы, конечно, видим, что тебе грустно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330105,
					"content": "...но твои многозначительные взгляды всё равно не утаить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330106,
					"content": "Ага, значит вы уже поняли, что ситуация критическая. Тогда я расскажу всё как есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330107
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330107,
					"content": "Ты и не пыталась это скрыть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330108,
					"content": "Да, мы получили ключ бездны, омытой луной, Энканомия медленно пробуждается. Однако людей не хватает, поэтому исследования идут очень медленно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330109
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330109,
					"content": "Всё-таки время сейчас неспокойное. Мы пока не знаем, действительно ли потеплеют отношения с островом Наруками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330110
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330110,
					"content": "Ну, у меня тоже всего одна пара рук...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330111
					]
				},
				{
					"id": 722330111,
					"content": "Но это совсем другое дело. Знайте, что, согласно традиции, главное в получении коралла - это наличие «героя».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330112
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330112,
					"content": "Сначала создать базу и помочь герою, изучив пути предков, а затем провести испытание -",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330113
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330113,
					"content": "таков идеальный план. Успех гарантирован!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330114
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330114,
					"content": "Отличный план! Только вот если у вас не хватает людей, то выполнить его невозможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330115,
					"content": "Это точно. Да и с «героем» проблемы, что-то ни волоска его не видно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330116
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330116,
					"content": "Хотя подождите... Кажется, я что-то вижу... Да, у нашего героя светлые волосы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330117
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330117,
					"content": "Ой, звучит как очередная куча проблем. Что-то Паймон эта затея совсем не по душе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330118,
					"content": "Хм, но ведь во время исследования часто находятся редкие сокровища. Конечно, обычно их передают клану Сангономии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330119
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330119,
					"content": "...но в этот раз мы можем и прикрыть глаза, если вы найдёте что-нибудь ценное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330120,
						722330121
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330120,
					"content": "Или даже совсем их закрыть, правда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				},
				{
					"id": 722330122,
					"content": "#Спаситель{F#ница} наш{F#а}! Вы согласны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330123
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330123,
					"content": "Ну разве мы можем сидеть сложа руки в такое тяжёлое для Сангономии время?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330124,
					"content": "Замечательно! Посоветованные госпожой Кокоми аргументы действительно сработали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330125
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330125,
					"content": "И она даже заранее знала, что вы придёте ко мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330126
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330126,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330127,
					"content": "О, ничего, ничего. Позвольте я вам кое-что покажу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330128
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330128,
					"content": "Встретимся внизу, у алтаря впереди. Если вы не видите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330129
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330129,
					"content": "Да, что делать, если не видим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330130,
					"content": "Посмотрите на юго-восток и прищурьтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330121,
					"content": "Знаешь, мы с Кокоми - хорошие друзья, и вообще...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				}
			]
		},
		{
			"id": 7223302,
			"completionStepIds": [
				7223303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
