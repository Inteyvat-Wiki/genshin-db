			"dialogs": [
				{
					"id": 722330501,
					"content": "#{NICKNAME}, остались ещё вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330502
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330502,
					"content": "О Бякуякоку...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330503
					]
				},
				{
					"id": 722330503,
					"content": "Когда-то давно Энканомию называли Бякуякоку. В этом подземном царстве не было ни солнца, ни луны, а были только Белая ночь и Вечная ночь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330504
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330504,
					"content": "Одним из моих предков была служительница святилища по имени Эбоси. Она сыграла важную роль в истории Бякуякоку, и именно благодаря ей я ответственна за Ватацуми горё мацури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цуюко"
				}
			]
		}
	]
}