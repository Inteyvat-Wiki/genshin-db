						],
						"stepId": 7223308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цуюко",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330301,
					"content": "Пора снять печать. Возьмите принесённый вами ключ бездны, омытой луной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330302
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330302,
					"content": "Как-как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330303,
					"content": "Ключ бездны, омытой луной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330304
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330304,
					"content": "Ого, а можешь ещё повторить раза три?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330305,
					"content": "Ключ бездны, омытой луной, ключ бездны, омытой луной, ключ бездны, помытой волной... Всё, у меня уже язык заплетается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330306
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330306,
					"content": "Вот! А Паймон говорила, что названьице так себе. Вам стоит его сменить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722330307,
					"content": "Даже если сменим, это поможет только тем, кто будет жить после нас. Пока придётся говорить, как есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330308
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330308,
					"content": "Кхм, в любом случае, я собираюсь начать ритуал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330309
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330309,
					"content": "Жаль, что мы не знаем, как именно проводится испытание в Энканомии. Вам придётся полагаться только на свои силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330310
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330310,
					"content": "Конечно, это дурная традиция - разводить кругом тайны. Я могу только пожелать вам удачи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330311
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 722330311,
					"content": "И пожалуйста, не увлекайтесь. Ваша безопасность превыше всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цуюко"
				}
			]
		},
		{
			"id": 7223304,
			"completionStepIds": [],
