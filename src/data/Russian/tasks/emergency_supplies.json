	"talks": [
		{
			"id": 2007301,
			"completionStepIds": [
				2007301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2007301",
							"2"
						],
						"stepId": 2007301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ризе"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730101,
					"content": "#Путешественни{F#ца}{M#к}! Ты появил{F#ась}{M#ся} как раз вовремя! Можешь оказать мне услугу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730102
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730102,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730103
					]
				},
				{
					"id": 200730103,
					"content": "Как ты уже наверняка знаешь, условия на Драконьем хребте крайне суровы. Даже самый опытный искатель приключений вряд ли сможет совладать со всем, что ему уготовили эти снежные горы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730104
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730104,
					"content": "Я несу здесь службу по приказу действующего магистра ордена и смотрю, чтобы никто из мондштадтцев не поднимался в горы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730105
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730105,
					"content": "У меня получилось отговорить от этой затеи уже множество горожан, но эти искатели приключений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730106
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730106,
					"content": "Ты ведь знаешь, какие они упрямые. Они не поддаются никаким уговорам и прут себе дальше в горы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730107
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730107,
					"content": "И что характерно, меньше этих ребят не становится. Если бы за каждую проблему с искателями приключений, которую я тут решал, давали по одной море, я бы давно купил домик у Сидрового озера и забил его погреб вином.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730108
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730108,
					"content": "За каждым приключенцем не уследить... Поэтому мы решили разместить в горах несколько точек с экстренными припасами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730109
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730109,
					"content": "Таким образом, у попавших в беду искателей приключений будет больше шансов не оставить в горах свои косточки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730110
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730110,
					"content": "Но если кто-нибудь, следуя слепой удаче, зайдёт слишком глубоко, ему придётся рассчитывать только на себя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730111
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730111,
					"content": "#Так вот, не мог{F#ла} бы ты помочь мне пополнить экстренные припасы в горах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730112,
						200730114
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730112,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730113
					]
				},
				{
					"id": 200730113,
					"content": "Спасибо. Эх, ну почему они не такие же сильные и здравомыслящие, как ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730117,
					"content": "На твоей карте я отметил три места. В каждом из них нужно оставить <color=#00E1FFFF>по ломтику ветчины</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730118
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730118,
					"content": "Эх, когда эти горячие головы образумятся?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730114,
					"content": "Разве от них будет польза?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730115
					]
				},
				{
					"id": 200730115,
					"content": "Будет или нет - неважно... Всё-таки это лучше, чем ничего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730116
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730116,
					"content": "Горы ошибок не прощают, и даже небольшое количество припасов может спасти жизнь. Ты сделаешь доброе дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Ризе"
				}
			]
		},
		{
			"id": 2007302,
			"completionStepIds": [
				2007306
			],
