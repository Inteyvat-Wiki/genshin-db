				"points": []
			},
			"dialogs": [
				{
					"id": 200730201,
					"content": "Все экстренные припасы пополнены?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730202
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730202,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730203
					]
				},
				{
					"id": 200730203,
					"content": "Отлично. Теперь можно не переживать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730204
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730204,
					"content": "Я всё равно надеюсь, что перед походом в горы они будут хорошо готовиться и дело до экстренных припасов не дойдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730205
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730205,
					"content": "#К слову, ты очень легко одет{F#а}. Это такая мода сейчас в Мондштадте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730206
					],
					"speakerTitle": "Ризе"
				},
				{
					"id": 200730206,
					"content": "Пожалуйста, прими это в награду. И оденься потеплее, а то смотреть на тебя холодно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ризе"
				}
			]
		},
