			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гэндо Ринго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721123501,
					"content": "Тебе листок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123502
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721123502,
					"content": "Ой, какая холодная...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721123503,
					"content": "Дай мне, пожалуйста, листок...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123504
					]
				},
				{
					"id": 721123504,
					"content": "Хорошо. Делается это вот как: сначала потряси... ту штуку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123505
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721123505,
					"content": "Разве это не ящик предсказаний?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123506
					]
				},
				{
					"id": 721123506,
					"content": "Да. Из него выпадет гадальная палочка. Я обменяю тебе её на подходящую полоску бумаги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123507
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721123507,
					"content": "#{M#Уверен}{F#Уверена}, они называются гадальными листками...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123508
					]
				},
				{
					"id": 721123508,
					"content": "Всё равно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123509
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721123509,
					"content": "У Паймон вопрос! Что, если... если нам попадётся палочка с предсказанием несчастья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721123510,
					"content": "Такова судьба. Тебе что-то не нравится? А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123511
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721123511,
					"content": "Как?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721123512,
					"content": "Разве нельзя использовать ту стойку снаружи, чтобы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123513
					]
				},
				{
					"id": 721123513,
					"content": "Тц.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123514
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721123514,
					"content": "Она ещё цыкает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721123515,
					"content": "Секундочку... Ах да, вот оно как: «Палочку с предзнаменованием несчастья привяжите к стойке гадальных листков, и она счастьем обернётся»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123516
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721123516,
					"content": "О, точно! Если вам попадётся палочка с предсказанием несчастья, просто привяжите её к стойке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123517
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721123517,
					"content": "Ну что вы за... Ах, не так. Нет милее Великого храма Наруками. Даже если палочка сулит несчастье, вы можете это изменить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123518
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721123518,
					"content": "Что-то тут не так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123519
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721123519,
					"content": "#{NICKNAME}, давай возьмём гадальный листок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
