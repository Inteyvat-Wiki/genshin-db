			"dialogs": [
				{
					"id": 761490101,
					"content": "Кто здесь? Кто здесь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490102
					],
					"speakerTitle": "Аларэ"
				},
				{
					"id": 761490102,
					"content": "#Я {NICKNAME}. Человек нынешней эпохи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490103
					]
				},
				{
					"id": 761490103,
					"content": "Я ничего не знаю о вашем времени. Меня зовут Аларэ. Когда-то я был аскетом эпохи тишины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490104
					],
					"speakerTitle": "Аларэ"
				},
				{
					"id": 761490104,
					"content": "Я не помню, сколько времени прошло с тех пор, как я оказался здесь. Это место прервало мою практику безмолвия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490105
					],
					"speakerTitle": "Аларэ"
				},
				{
					"id": 761490105,
					"content": "Как и ожидалось, практика без мыслей и желаний приведёт к перерождению в немыслящем раю зла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490106
					],
					"speakerTitle": "Аларэ"
				},
				{
					"id": 761490106,
					"content": "Пустяки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490107
					]
				},
				{
					"id": 761490107,
					"content": "Не благодари меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490108
					]
				},
				{
					"id": 761490108,
					"content": "Спасибо! Спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490109
					],
					"speakerTitle": "Аларэ"
				},
				{
					"id": 761490109,
					"content": "Спасти тебя было спонтанным решением. Тем не менее мы намерены искать выход, который не связан с медитацией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490110
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761490110,
					"content": "Вы не умеете медитировать? Или в вашу эпоху этой технике не обучают?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490111
					],
					"speakerTitle": "Аларэ"
				},
				{
					"id": 761490111,
					"content": "Мне потребовались сотни лет, чтобы впервые покинуть это место. Я отказался от своего стремления к истине, отказался от желания увидеть родных и близких.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490112
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761490112,
					"content": "Я не хочу снова от этого отказываться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490113
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761490113,
					"content": "Я тоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490114
					],
					"speakerTitle": "Аларэ"
				},
				{
					"id": 761490114,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490115
					],
					"speakerTitle": "Декс"
				},
				{
					"id": 761490115,
					"content": "Декс нашёл ещё один фрагмент забвения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490116
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761490116,
					"content": "Забвение? А, вы имеете в виду технику медитации маранасати. Я знаю о ней и о том, как она применяется для развития душевного состояния, необходимого для встречи со смертью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490117
					],
					"speakerTitle": "Аларэ"
				},
				{
					"id": 761490117,
					"content": "Раз мы нашли Цайтлинд, давайте искать выход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490118
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761490118,
					"content": "Ты уверен, что мы сможем выбраться отсюда своими силами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490119
					],
					"speakerTitle": "Аларэ"
				},
				{
					"id": 761490119,
					"content": "Раз Меланта и Нихилита могут свободно приходить и уходить, и даже берут с собой людей, то и Декс должен быть способен на это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490120
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761490120,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490121
					],
					"speakerTitle": "Декс"
				},
				{
					"id": 761490121,
					"content": "У нас три фрагмента забвения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490122
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761490122,
					"content": "О, это временное название. Потому что я не знаю, зачем Декс собирает их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490123
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761490123,
					"content": "Декс, что будем делать дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490124
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761490124,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490125
					],
					"speakerTitle": "Декс"
				},
				{
					"id": 761490125,
					"content": "Пойдём туда, куда он указывает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Историй"
				}
			]
		},
