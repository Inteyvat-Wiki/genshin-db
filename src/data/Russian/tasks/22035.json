	"talks": [
		{
			"id": 2203501,
			"completionStepIds": [
				2203501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203501",
							"2"
						],
						"stepId": 2203501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350101,
					"content": "#Путешественни{F#ца}{M#к}, мы снова встретились. Благодаря твоей помощи в прошлый раз Санго теперь уверена в личности нашего преступника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350102
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350102,
					"content": "Но если мы хотим, чтобы преступник был полностью повержен, нам всё равно ещё нужно немного подготовиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350103
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350103,
					"content": "Пока она занимается другими делами. Давай продолжим начатую ранее работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350104,
						220350107
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350104,
					"content": "Продолжим искать Похитителей сокровищ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350105
					]
				},
				{
					"id": 220350105,
					"content": "Именно так. Хотя наш преступник и не имеет никакого отношения к тем Похитителям сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350106
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350106,
					"content": "Эти кладоискатели в любом случае замышляют недоброе, так что пусть лучше нам «помогут».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350112,
					"content": "Санго отметила их конкретное местонахождение. Это недалеко от города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350113
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350113,
					"content": "Что касается дел в городе... Санго тайно поручила Амано и Андо помочь нам с этой операцией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350114
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350114,
					"content": "Она также пообещала, что внешне вся заслуга в раскрытии этого дела будет принадлежать им, так что они с удовольствием будут работать с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350115
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350115,
					"content": "Оставим размышления и планирование ей. Давай просто продолжим наше общение с этими Похитителями сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350116
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350116,
					"content": "Я также отметил это место на твоей карте. Давай начнём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350107,
					"content": "С обманом преступника?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350108
					]
				},
				{
					"id": 220350108,
					"content": "Именно так. Мы должны заставить его продолжать верить, что наша цель - Похитители сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350109
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350109,
					"content": "Таким образом, у Санго будет больше времени, чтобы завершить свой план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350110
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350110,
					"content": "Хи-хи... Не то чтобы эти Похитители сокровищ сами по себе не заслужили немного нашего внимания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350111
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350111,
					"content": "Так что мы вполне имеем право заручиться их «помощью».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Рюдзи"
				}
			]
		},
		{
			"id": 2203502,
			"completionStepIds": [
				2203508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
