					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350204,
					"content": "Да, в этот раз мы тоже наделали немало шума. Амано и Андо помогут нам сделать так, чтобы вор узнал об этом в городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350205
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350205,
					"content": "Сколько ещё времени это займет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350206
					]
				},
				{
					"id": 220350206,
					"content": "Осталось недолго. Как только Санго будет готова, мы сможем закрыть это дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350207
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350207,
					"content": "#Вот твой гонорар, путешественни{F#ца}{M#к}. Спасибо за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350208
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220350208,
					"content": "Это сумма, назначенная самой Санго, поэтому я считаю, что она должна быть соразмерной. Пожалуйста, возьми. Возможно, в будущем у нас ещё будет для тебя работа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				}
			]
		},
