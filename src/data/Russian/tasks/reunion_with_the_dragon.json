			"dialogs": [
				{
					"id": 3840201,
					"content": "Наконец-то все на месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840202
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840202,
					"content": "Как же здесь красиво...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3840203,
					"content": "Идеальное место для долгожданного воссоединения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840204
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3840204,
					"content": "Готовьтесь к битве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840205
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3840205,
					"content": "Чем бы это ни закончилось, всё к лучшему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840206
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3840206,
					"content": "Мондштадту много пришлось вытерпеть за последнее время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840207
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3840207,
					"content": "И вот решение нашей проблемы - песня бродячего музыканта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840208
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840208,
					"content": "Ладно, Ордо Фавониус тоже внесли свою лепту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840209
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840209,
					"content": "Да-да, мы поняли, господин Дилюк! Пожалуйста, все сделайте шаг назад!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840210
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3840210,
					"content": "Я, лучший из бардов этого бренного мира, начинаю играть на Небесной лире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		},
		{
			"id": 38404,
			"completionStepIds": [
				38405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"38405",
							"2"
						],
						"stepId": 38405,
						"stateName": "QUEST_STATE_UNFINISHED"
