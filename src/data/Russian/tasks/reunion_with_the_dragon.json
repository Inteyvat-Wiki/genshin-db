				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3840401,
					"content": "Будь осторожен, Барба... Венти! Будь осторожен, Венти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840402
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3840402,
					"content": "Хе-хе... Ты уже давно поняла, кто я на самом деле. Да, Джинн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840403
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3840403,
					"content": "Я благодарен тебе за то, что продолжаешь называть меня Венти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840404
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3840404,
					"content": "Что с Небесной лирой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840405
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840405,
					"content": "Ты ещё можешь на ней играть? Или нужно её восстанавливать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840406
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840406,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840407
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3840407,
					"content": "Её уже не починить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840408,
						3840410
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3840408,
					"content": "Магу Бездны это с рук не сойдёт!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840409
					]
				},
				{
					"id": 3840409,
					"content": "Ты прав. Чтобы спасти Двалина, нам нужно уничтожить источник зла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840413,
					"content": "Я поручу скауту Эмбер выследить его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840414
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3840414,
					"content": "В этом нет необходимости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840415
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840415,
					"content": "Гм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840416
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3840416,
					"content": "Недавно я уничтожил такой источник в одном из храмов Хранителей четырёх ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840417
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840417,
					"content": "Что? Когда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3840418,
					"content": "Если вы собираетесь выслеживать этих чудовищ, то я буду использовать свои методы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840419
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840419,
					"content": "Господин Дилюк...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3840420,
					"content": "Может быть, он и не любит рыцарей ордена, но он защищает Мондштадт по-своему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3840421,
					"content": "Что с тобой, малышка Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840422
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3840422,
					"content": "Гм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840423
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840423,
					"content": "Я свяжусь с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840424
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840424,
					"content": "Магам Бездны пора понять, что их поведение в Мондштадте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840425
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840425,
					"content": "Не останется безнаказанным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840410,
					"content": "Двалину грозит большая опасность.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840411
					]
				},
				{
					"id": 3840411,
					"content": "Сначала мы должны расправиться с Магом Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840412
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3840412,
					"content": "Единственный способ помочь Двалину - уничтожить источник зла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "Дилюк"
				}
			]
		}
	]
}