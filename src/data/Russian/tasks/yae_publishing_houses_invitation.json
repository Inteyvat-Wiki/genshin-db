			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Син Цю"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060401,
					"content": "Хм, эта часть написана действительно хорошим языком, да и стиль достаточно оригинальный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060402
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 728060402,
					"content": "Син Цю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060403
					]
				},
				{
					"id": 728060403,
					"content": "Ах, вот оно что! Захватывающе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060404
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 728060404,
					"content": "Син Цю!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060405
					]
				},
				{
					"id": 728060405,
					"content": "#Хм? А, это ты, {NICKNAME}. Давненько не виделись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060406
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 728060406,
					"content": "Судя по твоему приветствию, дела у тебя идут хорошо. Это меня радует... Что привело тебя сюда сегодня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060407
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 728060407,
					"content": "Вообще-то, мы надеялись попросить тебя найти кое-кого для нас. Ты прочитал кучу книг, так что наверное знаешь его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 728060408,
					"content": "Найти кого-то? Так вы ищете писателя? Хм... Ну что же, спрашивайте, конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060409
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 728060409,
					"content": "Мы ищем некоего Чжэнь Юя...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060410
					]
				},
				{
					"id": 728060410,
					"content": "Чжэнь Юй? Г-где вы услышали это имя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060411
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 728060411,
					"content": "Да вот же оно напечатано на книге «Легенда о клинке»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060412
					]
				},
				{
					"id": 728060412,
					"content": "Мы ищем этого Чжэнь Юя, потому что нас попросили передать ему письмо из издательского дома Яэ в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 728060413,
					"content": "Так ты знаешь кто такой Чжэнь Юй?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 728060414,
					"content": "Да, Чжэнь Юй, о котором вы говорите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060415
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 728060415,
					"content": "Мне так неловко, но... это мой псевдоним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060416
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 728060416,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 728060417,
					"content": "Ты раньше не упоминал об этом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060418
					]
				},
				{
					"id": 728060418,
					"content": "Ну... эта тема не особенно интересна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060419
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 728060419,
					"content": "Когда-то редактор, отвечавший за эту книгу здесь, в Ли Юэ, сказал мне: «Антураж слишком диковинный, в то время как сюжет неожиданно банален. Это никому не понравится!» - и отклонил мою рукопись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060420
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 728060420,
					"content": "Я решил не сдаваться, поэтому сам напечатал несколько экземпляров и тайком подложил их в книжный магазин «Ваньвэнь», чтобы посмотреть, понравятся ли они кому-нибудь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060421
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 728060421,
					"content": "Читателей у книги было немного, и я решил больше о ней не думать. Я и представить не мог, что она будет пользоваться таким успехом в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060422
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 728060422,
					"content": "И всё же мне очень приятно, что люди хотят читать мои сочинения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060423
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 728060423,
					"content": "#Я должен внимательно прочесть это письмо, путешественни{F#ца}{M#к}. Спасибо тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Син Цю"
				}
			]
		},
		{
