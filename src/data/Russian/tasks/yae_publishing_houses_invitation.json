			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чан Девятый"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060201,
					"content": "#Хм? Путешественни{F#ца}{M#к}? Что тебя привело сегодня к моему дому?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 728060202,
					"content": "Вот вам письмо и подарок от издательского дома Яэ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "Письмо от издательского дома Яэ? Они же не просят меня снова сменить псевдоним?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 728060204,
					"content": "Я тысячу раз говорил им, что буду писать под своим настоящим именем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 728060205,
					"content": "Ладно, ладно, давай посмотрим, чего они там написали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 728060206,
					"content": "Они хотят, чтобы я судил литературный конкурс... Хм. Не думаю, что у меня есть время, но, полагаю, я должен поблагодарить их в любом случае...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 728060207,
					"content": "А? Тут ещё так много... Что это? Это... «творческие рекомендации»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 728060208,
					"content": "#Мне, мне нужно будет прочитать их повнимательнее. Спасибо, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чан Девятый"
				}
			]
		},
		{
			"id": 7280604,
			"completionStepIds": [
				7280604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
