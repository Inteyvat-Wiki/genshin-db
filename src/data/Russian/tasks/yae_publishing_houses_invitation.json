					"Аратани"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060501,
					"content": "#О, ты наконец вернул{F#ась}{M#ся}! Как прошло? Удалось найти двух наших авторов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060502
					],
					"speakerTitle": "Аратани"
				},
				{
					"id": 728060502,
					"content": "Да. Все письма доставлены.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060503
					]
				},
				{
					"id": 728060503,
					"content": "#Это замечательно! Что они сказали, путешественни{F#ца}{M#к}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060504
					],
					"speakerTitle": "Аратани"
				},
				{
					"id": 728060504,
					"content": "Они оба сказали, что прочитают письма очень внимательно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060505
					]
				},
				{
					"id": 728060505,
					"content": "Отлично, отлично. Эх... Просто жаль, что они оба далеко, в Ли Юэ. Даже если бы всё было в порядке, не так просто было бы их проведать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060506
					],
					"speakerTitle": "Аратани"
				},
				{
					"id": 728060506,
					"content": "Особенно хотелось бы посетить господина Чжэнь Юя. Его книгу, «Легенду о клинке» мы даже не от него получили, а от странствующего торговца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060507
					],
					"speakerTitle": "Аратани"
				},
				{
					"id": 728060507,
					"content": "Потом, когда один из наших редакторов прочитал её и оценил её красоту, он был готов лично отправиться в Ли Юэ, чтобы договориться о следующих книгах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060508
					],
					"speakerTitle": "Аратани"
				},
				{
					"id": 728060508,
					"content": "Кто бы мог подумать, что наше положение так изменится, и мы не сможем никого послать в Ли Юэ, а наши письма останутся без ответа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060509
					],
					"speakerTitle": "Аратани"
				},
				{
					"id": 728060509,
					"content": "Всё, что нам оставалось - это просто опубликовать книгу, ведя при этом учёт гонораров, причитающихся господину. Мы решили, что отправим гонорары, как только нам удастся с ним связаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060510
					],
					"speakerTitle": "Аратани"
				},
				{
					"id": 728060510,
					"content": "Но прошло так много времени, а «Легенда о клинке» все еще остаётся бестселлером. Гонорары начинают накапливаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060511
					],
					"speakerTitle": "Аратани"
				},
				{
					"id": 728060511,
					"content": "Ах, как здорово было бы, если бы господин Чжэнь Юй мог присутствовать на этом конкурсе. С этими гонорарами уже нужно что-то делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аратани"
				}
			]
		},
