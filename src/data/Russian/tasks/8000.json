			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гань Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000101,
					"content": "Да, да. У них хватает смелости покуситься на что угодно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000102
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000102,
					"content": "Даже древние артефакты семи Архонтов, божеств и драконов не могут укрыться от их жадности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000103
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000103,
					"content": "Однако в этот раз всё по-другому... Кем они себя возомнили, покусившись на сокровища ордена Бездны?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000104
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000104,
					"content": "#О, {NICKNAME}, это ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000105
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000105,
					"content": "А? Гань Юй, зачем ты пришла к мисс Лань? Хочешь опубликовать какое-то поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80000106,
					"content": "#Здравствуй, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000107
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 80000107,
					"content": "Мы просто обсуждали Похитителей сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000108
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 80000108,
					"content": "Да, мы говорили о том, что даже в край наглые Похитители сокровищ должны понимать, что лучше не связываться с Бездной... Это слишком опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000109
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000109,
					"content": "Но совсем недавно мы получили информацию от Департамента по делам граждан о том, что два важных члена Похитителей сокровищ в Ли Юэ и Мондштадте планируют совместную операцию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000110
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 80000110,
					"content": "Два важных члена Похитителей сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80000111,
					"content": "Да, их называют «Старшая сестричка юга» и «Птеродактиль севера».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000112
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000112,
					"content": "А, Птеродактиль! Паймон помнит, как он пытался скрыться от Эмбер в Мондштадте... Но кто такая «Старшая сестричка юга»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000113,
						80000114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80000113,
					"content": "То есть она самая старшая в банде?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000116
					]
				},
				{
					"id": 80000116,
					"content": "Всё верно. Она глава Похитителей сокровищ в Ли Юэ. Насколько я знаю, члены банды называют её начальницей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000117
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000117,
					"content": "Некоторые говорят, что за её подвиги бог воров одарил её милостью, сделав «Старшей сестрой богов». ...Но это, наверное, просто надуманные слухи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000118
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000118,
					"content": "Как бы то ни было, Похитители сокровищ обнаружили какие-то неисследованные руины, которые тайно охранялись орденом Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000119
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 80000119,
					"content": "Совершенно позабыв об опасности, Похитители сокровищ подумали только о том, какие сокровища могут ждать их внутри...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000120
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 80000120,
					"content": "Они подготовили план: подослать приманку, чтобы отвлечь основные силы ордена Бездны от руин, пока опытный вор отправится внутрь за сокровищем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000121
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 80000121,
					"content": "Судя по нашим данным, для этого дела Старшая сестричка и Птеродактиль наняли некоего «Великого вора» из Фонтейна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000122
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000122,
					"content": "Великого вора? Ничего себе, какой у этого дяди титул.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80000123,
					"content": "Да, на самом деле он очень необыкновенная личность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000124
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000124,
					"content": "Великий вор пользуется большим уважением среди Похитителей сокровищ. Так же, как и мы, искатели приключений, уважаем наших великих искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000125,
						80000127
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000125,
					"content": "Например, знаменитая искательница приключений Алиса?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000126
					]
				},
				{
					"id": 80000126,
					"content": "О, так вы знакомы с автором «Путеводителя по Тейвату»? Да, Великий вор имеет схожую популярность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000129,
					"content": "В общем, несмотря на то что Старшая сестричка и Птеродактиль достаточно крупные шишки в Ли Юэ и Мондштадте, им пришлось приложить немало усилий, чтобы убедить вора такого статуса прибыть сюда и лично проконтролировать выполнение операции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000130
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000130,
					"content": "В последнее время в Ли Юэ происходит столько всего, что у Департамента по делам граждан и Миллелита совсем нет времени и ресурсов на расследование слухов о Похитителях сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000131
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 80000131,
					"content": "Но при любом упоминании Бездны меня охватывает чувство, что за этим может скрываться какая-то неизвестная опасность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000132
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 80000132,
					"content": "Поэтому я решила вывесить своё поручение в Гильдии искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000133,
						80000134
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 80000133,
					"content": "#Ну, раз уж я {F#оказалась здесь}{M#проходил мимо}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000135,
					"content": "Ага, предоставьте это поручение нам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80000136,
					"content": "Ох, я буду очень признательна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000137
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 80000137,
					"content": "Приятно видеть, что за эту работу взялся самый надёжный член гильдии. Что ж, желаю удачи, а оформлением поручения займётся сама гильдия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000134,
					"content": "Я тоже осознаю угрозу Бездны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000127,
					"content": "Например, великий искатель приключений Стэнли?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000128
					]
				},
				{
					"id": 80000128,
					"content": "О, так вы повстречались с живой легендой в Мондштадте? Да, Великий вор имеет схожую популярность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 80000114,
					"content": "Это её Похитители сокровищ называют начальницей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000115
					]
				},
				{
					"id": 80000115,
					"content": "Так ты уже кое-что о них знаешь. Похоже, вы нередко пересекались с Похитителями сокровищ в своих приключениях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000116
					],
					"speakerTitle": "Мисс Лань"
				}
			]
		},
		{
			"id": 800002,
			"completionStepIds": [
				800004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800004",
							"2"
						],
						"stepId": 800004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000201,
					"content": "Кажется... это человек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80000202,
					"content": "Может, это и есть... тот самый Великий вор?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80000203,
					"content": "Почему он в такой позе? Он кому-то молится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80000204,
					"content": "?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80000205,
					"content": "Ах! Это... Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000206,
						80000207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80000206,
					"content": "...Статуя семи Архонтов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000208
					]
				},
				{
					"id": 80000208,
					"content": "П-почему эта статуя семи Архонтов... висит вверх ногами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80000209,
					"content": "А руки статуи... Паймон помнит, что у неё в руках должен быть шар, ведь так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80000210,
					"content": "Но... у этой статуи в руках... Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000211
					],
