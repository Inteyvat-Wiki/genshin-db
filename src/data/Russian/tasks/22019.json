	"talks": [
		{
			"id": 2201901,
			"completionStepIds": [
				2201901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
