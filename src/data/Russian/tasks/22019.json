			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Санго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190101,
					"content": "...Хорошо, рассчитываю на вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190102
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190102,
					"content": "Все будет исполнено в лучшем виде, мисс Санго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190103
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220190103,
					"content": "Не могу поверить, что он так долго прятался прямо у нас под носом. Какая наглость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190104
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220190104,
					"content": "К тому же подобным способом... притворившись...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190105
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220190105,
					"content": "Так или иначе, сегодня его «карьера» закончится. Рюдзи, ты помнишь, что я сказала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190106
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190106,
					"content": "Да, мэм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190107
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220190107,
					"content": "#Хорошо... И ты здесь, путешественни{F#ца}{M#к}. Отлично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190108,
						220190109
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190108,
					"content": "Вы собираетесь поймать вора?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190111
					]
				},
				{
					"id": 220190111,
					"content": "Я собрала достаточно доказательств и вычислила привычки преступника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190112
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190112,
					"content": "#Путешественни{F#ца}{M#к}, ты можешь пойти с Рюдзи, Андо и Амано, дабы помочь привлечь виновного к ответственности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190113
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190113,
					"content": "У него должно быть есть несколько сообщников. С твоей помощью вероятность успеха операции значительно повысится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190114,
						220190117
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190114,
					"content": "Что от меня требуется?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190115
					]
				},
				{
					"id": 220190115,
					"content": "Просто используй свою непревзойденную ауру, чтобы шокировать преступника, дабы он не сделал ничего... слишком глупого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190116
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190116,
					"content": "Хотя я думаю, что у вора, который может только красться тайком и прятаться, не хватит смелости ни на какие резкие движения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190121,
					"content": "Если я права, то наш друг спланировал отправиться в одно дикое безлюдное место, чтобы закопать только что украденное добро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190122
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190122,
					"content": "Если вы пойдёте туда сейчас, вы сможете поймать его с поличным. Я буду ждать здесь ваших хороших новостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190117,
					"content": "А ты не пойдёшь с нами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190118
					]
				},
				{
					"id": 220190118,
					"content": "Моя роль выполнена, так что я не буду вмешиваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190119
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190119,
					"content": "#{NICKNAME}, используй свою непревзойденную ауру, чтобы шокировать преступника, дабы он не сделал ничего... слишком глупого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190120
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190120,
					"content": "Хотя я думаю, что у вора, который может только красться тайком и прятаться, не хватит смелости ни на какие резкие движения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190109,
					"content": "Дело будет закрыто?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190110
					]
				},
				{
					"id": 220190110,
					"content": "Да. Если сегодня всё пройдет успешно, сегодня же и будет закрыто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190111
					],
					"speakerTitle": "Санго"
				}
			]
		},
		{
			"id": 2201902,
			"completionStepIds": [
				2201903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
