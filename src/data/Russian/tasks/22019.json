			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190201,
					"content": "Вижу его. Он закапывает добычу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190202,
						220190204
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220190202,
					"content": "Вперёд!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190203
					]
				},
				{
					"id": 220190203,
					"content": "#Постой, путешественни{F#ца}{M#к}. Пока не время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220190206,
					"content": "Еще немного... Хм... Уже совсем скоро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190207
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220190207,
					"content": "Эй ты! Что ты делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190208
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220190208,
					"content": "Бросай то, что у тебя в руках, и стой, не двигайся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190209
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220190209,
					"content": "К-как вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190210
					],
					"speakerTitle": "Исикава Хатиро"
				},
				{
					"id": 220190210,
					"content": "Агх... Не стойте, как пни! Разберитесь с ними! Избавьтесь от этих двоих, и мы будем свободны, как ветер!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190211
					],
					"speakerTitle": "Исикава Хатиро"
				},
				{
					"id": 220190211,
					"content": "Хах! Несколько жалких Похитителей сокровищ, а кто-то уже зазнался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190212
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220190212,
					"content": "Андо, Амано, предоставьте их нам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190213
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220190213,
					"content": "Хорошо! Милости прошу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190214
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220190214,
					"content": "#{NICKNAME}, сейчас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190215
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220190215,
					"content": "Ах, как все запутанно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190216
					]
				},
				{
					"id": 220190216,
					"content": "Таков план Санго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190217
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220190217,
					"content": "Что же, вперед.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220190204,
					"content": "Ловим его?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190205
					]
				},
				{
					"id": 220190205,
					"content": "Подожди... Скоро, скоро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "Рюдзи"
				}
			]
		},
		{
			"id": 2201903,
			"completionStepIds": [
				2201905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201905",
							"2"
						],
						"stepId": 2201905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190301,
					"content": "#Мы поймали его с поличным. Спасибо за помощь, Рюдзи, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190302
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220190302,
					"content": "Мы с Амано доставим этих Похитителей сокровищ в полицейский участок. Оставшуюся работу оставьте нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190303
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220190303,
					"content": "Удивительно, как Санго смогла так точно выяснить все детали этого таинственного дела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190304
					],
					"speakerTitle": "Амано"
				},
				{
					"id": 220190304,
					"content": "Чего и следовало ожидать от Санго. Для неё такое дело - пустяк, я уверен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190305
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220190305,
					"content": "Рюдзи, нам нужно вернуться в полицейский участок. Мы навестим вас, когда закончим с этим парнем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190306
					],
					"speakerTitle": "Андо"
				},
				{
					"id": 220190306,
					"content": "Милости прошу. До скорого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190307
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220190307,
					"content": "#Путешественни{F#ца}{M#к}, давай вернёмся и доложим Санго о том, как всё прошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				}
			]
		},
		{
			"id": 2201904,
			"completionStepIds": [
				2201906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201906",
							"2"
						],
						"stepId": 2201906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Санго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190401,
					"content": "...а Андо и Амано в данный момент доставляют преступника в полицейский участок, Санго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190402
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 220190402,
					"content": "Ясно. Значит всё разрешилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190403
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190403,
					"content": "#Путешественни{F#ца}{M#к}, спасибо тебе за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190404,
						220190405
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190404,
					"content": "Значит... это всё?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				},
				{
					"id": 220190406,
					"content": "Это нормальное чувство. В конце концов, это Амано и Андо забрали преступника. Почему бы тебе не забрать своё вознаграждение? Это поможет почувствовать реальность происходящего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190407,
						220190409
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190407,
					"content": "А что насчёт твоего вознаграждения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190408
					]
				},
				{
					"id": 220190408,
					"content": "Моего? Самое большое вознаграждение для меня - это возможность помочь полиции в раскрытии дела и обеспечение мира и безопасности в городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190412,
					"content": "Но, честно говоря, в этот раз я почти ничего не приобрела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190413
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190413,
					"content": "Я не увидела никаких новых преступных методов или идей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190414
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190414,
					"content": "Это было неинтересное преступление. К счастью, оно не потребовало больших усилий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190415,
						220190417
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190415,
					"content": "Санго...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190416
					]
				},
				{
					"id": 220190416,
					"content": "Хм? Тебе раньше не доводилось встречать человека, который настолько заинтересован в преступности, как я?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190419,
					"content": "Именно благодаря этому увлечению я решила стать детективом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190420
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190420,
					"content": "А ты не хочешь также и совершать «преступления»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190421
					]
				},
				{
					"id": 220190421,
					"content": "Да, в некотором смысле, хочу. Я хочу совершить безупречное, идеальное преступление.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190422
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190422,
					"content": "Однако... неизбежно, что во время преступления будут оставлены какие-то улики, а пока есть улики, раскрытие преступления лишь вопрос времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190423,
						220190424,
						220190425
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190423,
					"content": "А если преступление совершено не человеком?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190426,
					"content": "Видишь! Ты ведь тоже не можешь не думать о совершении преступлений, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190427
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190427,
					"content": "Не стоит нервничать. Ты просто размышляешь об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190428
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190428,
					"content": "Я постоянно думаю о преступлениях, о том, как и почему они совершаются...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190429
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190429,
					"content": "Зачем ты об этом думаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190430
					]
				},
				{
					"id": 220190430,
					"content": "Конечно, чтобы лучше раскрывать дела. Дела, над которыми я работаю в последнее время, становятся все сложнее и сложнее, поэтому мне приходится много думать над ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190431
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190431,
					"content": "Однако ни одно из этих преступлений нельзя назвать идеальным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190432
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190432,
					"content": "Ты когда-нибудь сталкивалась с идеальным преступлением?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190433
					]
				},
				{
					"id": 220190433,
					"content": "Да, доводилось. Есть одно преступление, которое я не могу раскрыть до сих пор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190434
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190434,
					"content": "Но я считаю, что если это сделал человек, то должны быть какие-то улики. Просто я пока не нашла ни одной из них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190435
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190435,
					"content": "#В любом случае вот твой гонорар. Спасибо, что помог{F#ла} мне, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190436
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190436,
					"content": "#Не стесняйтесь заходить сюда, если у тебя будет время. Но если ты будешь слишком занят{F#а}... что ж... это тоже нормально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190437
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190437,
					"content": "Тем не менее моя интуиция подсказывает мне, что у нас будет шанс снова поработать вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190424,
					"content": "Что, если преступника не существует?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190425,
					"content": "Есть ли способ стереть следы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190417,
					"content": "Все детективы такие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190418
					]
				},
				{
					"id": 220190418,
					"content": "Я бы не стала обобщать, но лично меня очень интересует вопрос «преступления».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190409,
					"content": "И тебе больше ничего не нужно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190410
					]
				},
				{
					"id": 220190410,
					"content": "Я уже испытала сладость исполненной справедливости, кроме этой награды мне ничего не нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190411
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190411,
					"content": "Хе-хе... Это уже получше звучит, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190405,
					"content": "А у меня что-то совсем нет чувства, что все действительно закончилось...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				}
			]
		},
		{
