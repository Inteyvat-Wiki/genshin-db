			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Санго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190601,
					"content": "Если вы пойдёте туда сейчас, вы сможете поймать его с поличным. Я буду ждать здесь ваших хороших новостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190602
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190602,
					"content": "#Есть ли еще что-нибудь, что тебе хотелось бы сказать, путешественни{F#ца}{M#к}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190603,
						220190607
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190603,
					"content": "Ты что-то совсем не выглядишь довольной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190604
					]
				},
				{
					"id": 220190604,
					"content": "Это дело было довольно заурядным: скучный преступник, а методам не хватает изощренности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190605
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190605,
					"content": "Если бы мне нужно было оценить интересность этого дела... на ум приходит лишь слово «скукотень».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190606
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190606,
					"content": "Но, опять же, было совершено преступление, поэтому хорошо, что оно было раскрыто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190607,
					"content": "А ты не пойдёшь с нами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190608
					]
				},
				{
					"id": 220190608,
					"content": "Моя роль выполнена, так что я не буду вмешиваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190609
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190609,
					"content": "Кроме того, с моими боевыми навыками и телосложением я могла бы стать заложницей преступника, которую он мог бы использовать, чтобы получить то, что он хочет. Это было бы хуже всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190610
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 220190610,
					"content": "Я знаю границы своих возможностей, так что я оставлю на вас задачу покончить с ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				}
			]
		}
	]
}