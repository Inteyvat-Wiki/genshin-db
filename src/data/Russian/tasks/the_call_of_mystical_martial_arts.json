				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гесина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706810701,
					"content": "Я буду беречь эти прекрасные снимки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810702
					],
					"speakerTitle": "Гесина"
				},
				{
					"id": 706810702,
					"content": "Я не осознавала, насколько я голодна, пока не расслабилась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810703
					],
					"speakerTitle": "Гесина"
				},
				{
					"id": 706810703,
					"content": "Раз уж ты об этом заговорила, у Паймон тоже начинает урчать в животе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810704,
						706810705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706810704,
					"content": "Давай найдём местечко для отдыха.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810708
					]
				},
				{
					"id": 706810708,
					"content": "Давайте поищем местечко, где можно перекусить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706810709,
					"content": "Похоже, поблизости нет ни одного подходящего ресторана... Из уважения к вам и за ту помощь, которую мне оказали, мне было бы неловко, если бы мы поели в первом попавшемся заведении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810710
					],
					"speakerTitle": "Гесина"
				},
				{
					"id": 706810710,
					"content": "К слову о еде, неужели то сооружение на вершине гигантской скалы - знаменитый <color=#00E1FFFF>постоялый двор «Ваншу»</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810711
					],
					"speakerTitle": "Гесина"
				},
				{
					"id": 706810711,
					"content": "Я слышала от торговца из Ли Юэ, который ведёт дела в Мондштадте, что там превосходная кухня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810712
					],
					"speakerTitle": "Гесина"
				},
				{
					"id": 706810712,
					"content": "Позвольте угостить вас в качестве благодарности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810713
					],
					"speakerTitle": "Гесина"
				},
				{
					"id": 706810713,
					"content": "Ура! Пойдём поедим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706810705,
					"content": "Паймон, разведи огонь и начинай готовить!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810706
					]
				},
				{
					"id": 706810706,
					"content": "Эй! С Паймон нельзя разговаривать в таком тоне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706810707,
					"content": "Кроме того, ты же прекрасно знаешь, как Паймон готовит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810708
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7068108,
