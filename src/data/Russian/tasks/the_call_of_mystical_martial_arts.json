							206.559
						],
						"pointId": 9406
					}
				]
			},
			"dialogs": [
				{
					"id": 706810501,
					"content": "Это же <color=#00E1FFFF>Тростниковые острова</color> впереди, верно? Как красиво! В Мондштадте такого не увидишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810502
					],
					"speakerTitle": "Гесина"
				},
				{
					"id": 706810502,
					"content": "Как я и думала, отправиться в путешествие было правильным решением!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810503
					],
					"speakerTitle": "Гесина"
				},
				{
					"id": 706810503,
					"content": "Такая возможность не каждый день выпадает, давайте сфотографируемся вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гесина"
				}
			]
		},
		{
			"id": 7068106,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
