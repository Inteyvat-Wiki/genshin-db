			"trigger": {
				"objectNames": [
					"Дилюк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4660101,
					"content": "Дилюк! Нам нужно рассказать тебе кое-что очень важное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660102,
					"content": "Насчёт Кэйи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660103
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660103,
					"content": "Можно было сразу догадаться, что он это так просто не оставит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660104
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660104,
					"content": "Вы недолюбливаете друг друга, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660105,
					"content": "Это не имеет значения. Важно то, что рыцари отреагировали именно так, как я и ожидал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660106
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660106,
					"content": "Теперь нам нужно продумать дальнейший план действий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660107,
						4660111
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660107,
					"content": "Для начала, не стоит возвращаться в таверну...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660108
					]
				},
				{
					"id": 4660108,
					"content": "Нельзя. Тогда рыцари станут меня подозревать ещё больше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660109
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660109,
					"content": "Кэйа на это и рассчитывает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660110
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660110,
					"content": "Хмм... И что же нам тогда делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660112,
					"content": "Дайте мне немного подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660113
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660114
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660114,
					"content": "Если они хотят устроить слежку, мы не будем им мешать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660115
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660115,
					"content": "Алиби нам не помешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660116
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660116,
					"content": "«Абилиби»? Что за «алибилиби»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660117,
					"content": "Окажите мне услугу, и я объясню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660118
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660118,
					"content": "Заинтриговал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660119,
					"content": "В садах <color=#00E1FFFF>к северо-западу</color> отсюда выращивают лучшие в Мондштадте туманные цветы. Вокруг сада также растут и дикие цветы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660120
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660120,
					"content": "Буду весьма благодарен, если вы принесёте мне немного тех цветов. А я пока займусь подготовкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660111,
					"content": "Есть идеи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660112
					]
				}
			]
		},
