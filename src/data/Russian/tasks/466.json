			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дилюк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4660801,
					"content": "В садах <color=#00E1FFFF>к северо-западу</color> отсюда выращивают лучшие в Мондштадте туманные цветы. Вокруг сада также растут и дикие цветы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660802
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660802,
					"content": "Когда ты соберёшь достаточно <color=#00E1FFFF>туманных цветов</color>, мы обсудим дальнейший план действий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дилюк"
				}
			]
		},
		{
			"id": 46609,
			"completionStepIds": [
				46622
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46622",
							"2"
						],
						"stepId": 46622,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"100052",
							"4"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дилюк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4660901,
					"content": "Ах, вы вернулись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660902
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660902,
					"content": "Позвольте представить вам нашего главного винодела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660903
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660903,
					"content": "Столько туманных цветов! Не терпится увидеть результат!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660904
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 4660904,
					"content": "Ты уверен, что оборудование выдержит такой уровень чистоты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660905
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660905,
					"content": "А... Кхм... Эм... (Только подумать, я разговариваю с самим владельцем винокурни!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660906
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 4660906,
					"content": "Не нужно волноваться, господин! Я буду служить вам, даже если это будет стоить мне моей жизни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660907
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 4660907,
					"content": "«Стоить жизни»??? Что вы замышляете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660908
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660908,
					"content": "Я пока пойду. Чем раньше начнём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660909
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 4660909,
					"content": "Зачем ему столько туманных цветов? Хочет маме букет подарить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660910
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660910,
					"content": "Если коротко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660911
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660911,
					"content": "Пару дней назад эксперты с винокурни экспериментировали с новыми вкусами. Они хотели выяснить, придаёт ли вину освежающий аромат добавление туманного цветка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660912
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660912,
					"content": "Вкус оказался действительно чарующим. Более чем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660913
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660913,
					"content": "Значит это вино неплохо продаётся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660914
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660914,
					"content": "Нет. Оно начало привлекать только слаймов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660915
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660915,
					"content": "Чтобы выжить, слаймы полагаются на экстракты элементальной энергии. Они не могут устоять перед нашим вином.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660916
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660916,
					"content": "Сколько вреда можно нанести, зная эту информацию... Заставляет задуматься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660917
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660917,
					"content": "*БАХ БУМ ДЫЩЬ*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660918
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 4660918,
					"content": "Ааа! Что это за шум?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660919
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660919,
					"content": "Ах... Х-холодно... Г-господин Дилюк, оч-чистка зав-вершена! Н-но обор-рудование...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660920
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 4660920,
					"content": "Великолепная работа. Не волнуйся за оборудование, я прикажу дворецкому немедленно заказать новое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660921
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660921,
					"content": "Господин Дилюк живёт на широкую ногу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660922
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660922,
					"content": "Это то, о чём я говорил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660923
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660923,
					"content": "Экстракт туманного цветка... Для удобства назовём его элементальной приманкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660924
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660924,
					"content": "Ого, какой сильный элементальный запах! А как нам его проверить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660925
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660925,
					"content": "Плесните немного на землю вон там. Только будьте осторожны. Совсем чуть-чуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дилюк"
				}
			]
		},
