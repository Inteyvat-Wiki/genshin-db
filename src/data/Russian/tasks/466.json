			"dialogs": [
				{
					"id": 4660201,
					"content": "Вот столько достаточно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660202,
					"content": "И долго ждать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660203
					],
					"speakerTitle": "Паймон"
				},
				{
