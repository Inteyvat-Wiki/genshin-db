					"nextDialogs": [
						4660515
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4660515,
					"content": "Хм. Значит, вот как ведут себя рыцари Ордо Фавониус в экстренной ситуации?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660516
					],
					"speakerTitle": "Дилюк"
				},
