				"points": []
			},
			"dialogs": [
				{
					"id": 4660401,
					"content": "Приветствую, Мистер Хоффман, Рыцарь Ордо Фавониус. Чем могу быть полезен в столь поздний час?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660402
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660402,
					"content": "Ох, эм... Ничем. Просто выдалась свободная минутка, решил зайти выпить кружечку... Вот и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660403
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4660403,
					"content": "А? Путешественники, рад вас здесь видеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660404
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4660404,
					"content": "Мы вас тоже. У нас такое хорошее настроение сегодня! Вот, решили погулять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660405,
					"content": "Что желаете заказать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660406
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660406,
					"content": "Я буду вино из одуванчиков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660407
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4660407,
					"content": "Паймон хочет яблочный сок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660410,
					"content": "#Я тоже забыл{F#а} кошелёк.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660411
					]
				},
				{
					"id": 4660412,
					"content": "А можете просто записать на мой счёт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660413
					]
				},
				{
					"id": 4660409,
					"content": "#Но... Паймон забыла дома кошелёк... {NICKNAME}, у тебя есть немного денег?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660311,
						4660312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660411,
					"content": "Тогда, боюсь, мне остаётся только попросить вас вернуться, когда у вас будет, чем платить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660414
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660413,
					"content": "Прошу прощения, но мы не открываем счета. Ни для кого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660414
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660414,
					"content": "В таком случае... Я всё оплачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660415
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4660415,
					"content": "Не нужно! Мы просто сбегаем за деньгами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
