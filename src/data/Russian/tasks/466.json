				"points": []
			},
			"dialogs": [
				{
					"id": 4660301,
					"content": "Фух... Такой сильный эффект от такой маленькой охапки цветов. Ну хоть не зря мы их собирали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660302,
					"content": "Ладно! Господин Дилюк, ты можешь наконец рассказать, что ты там задумал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660303,
					"content": "Да. Мой план состоит в том...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660304
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660304,
					"content": "Вот и весь план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660305
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660305,
					"content": "Хм... Ты уверен, что это сработает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660306,
					"content": "В твоём плане есть только ты сам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660307,
					"content": "С самого начала был только я один...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660308
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660308,
					"content": "И с новыми проблемами справиться тоже должен я один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660309
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660309,
					"content": "Ну ладно, раз ты уже так решил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660310,
					"content": "#Но всё равно Паймон и {NICKNAME} будут тебе помогать. Так ведь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660311,
						4660312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4660311,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660314
					]
				},
				{
					"id": 4660314,
					"content": "Я и вправду у вас в долгу. А теперь давайте следовать плану. Увидимся в <color=#00E1FFFF>таверне</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4660312,
					"content": "За достойную цену.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660313
					]
				},
				{
					"id": 4660313,
					"content": "#Эй! Ты чего это, {M#парень}{F#дамочка}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660314
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
