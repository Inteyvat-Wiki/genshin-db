			"dialogs": [
				{
					"id": 750350101,
					"content": "Прошу прощения, ты мастер Кулахо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750350102,
					"content": "Меня и в самом деле так зовут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350103
					],
					"speakerTitle": "Кулахо"
				},
				{
					"id": 750350103,
					"content": "Хе-хе, так ты и есть тот самый эксперт по самоцветам, который ищет вдохновения! Мы пришли по рекомендации Имиш. Мы заметили, что ты смотрел на дерево. Ты занимался добычей вдохновения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750350104,
					"content": "Вообще-то... Проехали. Это уже не важно... Ох... Чем я могу вам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350105
					],
					"speakerTitle": "Кулахо"
				},
				{
					"id": 750350105,
					"content": "У нас есть прекрасный самоцвет, и мы надеемся, что ты обработаешь его для нашего завриана-спутника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750350106,
					"content": "#Хе-хе, скорее отдай ему самоцвет, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750350107,
					"content": "Р-р! Р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350108,
					"content": "А?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750350109,
					"content": "Вы слышите шум крыльев...\\nК тому времени как вы приходите в себя, самоцвет бесследно исчезает из когтей вашего завриана-спутника.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750350110
					]
				},
				{
					"id": 750350110,
					"content": "Р-р-р! Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350111,
					"content": "Что?! Где самоцвет? Куда мог деться такой огромный камень?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750350112,
					"content": "Кажется, его утащила птица...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350113
					]
				},
				{
					"id": 750350113,
					"content": "Что?! Здешние птицы воруют вещи? Какие невоспитанные!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750350114,
					"content": "Р-р-р! Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350115,
					"content": "Я хотел сказать, что даже если бы самоцвет не украли, я всё равно не смог бы его огранить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350116
					],
					"speakerTitle": "Кулахо"
				},
				{
					"id": 750350116,
					"content": "...Эти проклятые птицы украли все мои инструменты! Я внимательно разглядывал птиц одну за другой, чтобы понять, кто из них добрался своими грязными когтями до моих инструментов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350117
					],
					"speakerTitle": "Кулахо"
				},
				{
					"id": 750350117,
					"content": "#Это... Это вообще возможно? Плохие, плохие птицы! {NICKNAME}, пойдём и вернём самоцвет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750350118,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350119,
					"content": "И мои инструменты тоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кулахо"
				}
			]
		},
