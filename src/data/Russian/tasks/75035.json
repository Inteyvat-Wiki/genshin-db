					"nextDialogs": [
						750351207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750351207,
					"content": "Р-р! Р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351208,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, похоже, ты рад вернуться сюда. Хочешь что-то сказать {F#путешественнице}{M#путешественнику}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351209
					],
					"speakerTitle": "Паймон"
				},
				{
