					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750351233,
					"content": "#Та-дам! Блестящий самоцвет! {REALNAME[ID(2)|SHOWHOST(true)]}, тебе нравится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351234
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750351234,
					"content": "Р-р! Р-р!",
					"roleType": "TALK_ROLE_NPC",
