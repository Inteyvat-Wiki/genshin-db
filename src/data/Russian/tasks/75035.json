						750351203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351203,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, похоже, тебе здесь нравится. Впрочем, в этом нет ничего удивительного, ведь ты наверняка провёл здесь много времени, прежде чем встретил нас...",
