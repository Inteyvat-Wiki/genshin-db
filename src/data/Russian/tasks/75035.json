						750351235
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351235,
					"content": "Ого! Ты очень рад, а значит, Паймон сделала правильный выбор. Эй, осторожнее! Не урони его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351236
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750351236,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, ты его точно потеряешь, если будешь так держать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351237
					],
					"speakerTitle": "Паймон"
				},
