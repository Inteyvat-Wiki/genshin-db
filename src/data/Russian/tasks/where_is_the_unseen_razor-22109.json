			"dialogs": [
				{
					"id": 221090201,
					"content": "#Ты уже разобра{F#лась}{M#лся} с хиличурлами-лучниками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090202
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221090202,
					"content": "Пока ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090203
					]
				},
				{
					"id": 221090203,
					"content": "Ты так тщательно готовишься или просто бьёшь баклуши?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090204
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221090204,
					"content": "Или всё вместе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				}
			]
		},
