			"dialogs": [
				{
					"id": 730560701,
					"content": "Вы! Что здесь делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560702
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 730560702,
					"content": "Ой! Зачем так пугать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560703,
					"content": "Вы - знаете моё имя. Но Аранага вас - здесь не встречал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560704
					],
					"speakerTitle": "Аранага"
				},
				{
