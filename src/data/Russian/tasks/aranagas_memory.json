						730560713
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560713,
					"content": "У нас есть для тебя кое-что!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560714
					]
				},
				{
					"id": 730560714,
					"content": "Для - меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560715
					],
					"speakerTitle": "Аранага"
				},
