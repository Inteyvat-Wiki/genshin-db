					"nextDialogs": [
						730560716
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 730560716,
					"content": "Вот.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560717
					]
				},
				{
					"id": 730560717,
					"content": "...",
