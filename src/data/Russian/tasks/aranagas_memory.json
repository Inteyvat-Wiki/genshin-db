	"talks": [
		{
			"id": 7305601,
			"completionStepIds": [
				7305601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305601",
							"2"
						],
						"stepId": 7305601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хайям",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560101,
					"content": "Ха-ха, ну и ну, ну и дела... Оживает... Этот лес оживает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560102
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560102,
					"content": "Привет! Дедушка, ты заблудился?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560103,
					"content": "Гм-гм... Кто простудился? А, вы это мне? Ха-ха, думали, я заблудился? Нет, нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560104
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560104,
					"content": "Здравствуйте, дети. Я Гийят Хайям, дастур из Амурты, ха-ха... Зовите меня просто Хайям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560105
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560105,
					"content": "Гм... Здравствуй, почтенный Хайям!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560106,
					"content": "Нет... Смотри, опусти кончик языка вниз и выгни язык: «Ха»... Теперь округли губы: «йя»... И в конце просто сожми губы, вот так: «м».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560107
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560107,
					"content": "Ох... Хай... я... м...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560108,
					"content": "Да! Хорошо! Ну, теперь твоя очередь, златокудрое дитя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560109,
						730560111
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560109,
					"content": "Хай... я... м...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560110
					]
				},
				{
					"id": 730560110,
					"content": "Ха-ха, отлично! У тебя получается намного лучше, чем у белой крохи. Смотри-ка, а ведь я давно говорил, что вполне способен преподавать языки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560113,
					"content": "Ну так, почтенный Хайям... Если ты не заблудился, что тебя сюда привело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560114,
					"content": "Что привело? Хе-хе... Я изучаю лес. И эти места для меня - всё равно что родной дом. Разве я могу заблудиться у себя дома? Тем более, я так по нему скучал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560115
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560115,
					"content": "Ого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560116,
					"content": "Этот лес сильно пострадал от зоны Увядания. За последние тридцать лет сократилось количество видов и общая численность лесных растений, а вредных грибов, наоборот, становилось всё больше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560117
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560117,
					"content": "Но не так давно зона Увядания исчезла. Распространение грибов остановилось, и в лесу снова появились многие растения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560118
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560118,
					"content": "С подобным явлением я сталкивался только однажды, это было шестьдесят лет назад... Поэтому я пришёл сюда, чтобы проверить одну свою догадку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560119
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560119,
					"content": "Вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560120,
						730560123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560120,
					"content": "Расскажи мне о своей догадке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560121
					]
				},
				{
					"id": 730560121,
					"content": "Ха-ха, это было шестьдесят лет назад... Я уже стар, плохо помню подробности. Но я уверен, что нынешнее очищение леса от зоны Увядания связано с тем, что случилось тогда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560122
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560122,
					"content": "Поэтому сейчас я собираюсь зайти в эту пещеру и собрать там кое-какие образцы, чтобы проверить свою догадку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560126,
					"content": "И всё-таки... Хоть в пещере больше нет Мараны, но там ещё довольно опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560127,
					"content": "Ха-ха, пустяки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560128
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560128,
					"content": "Э, погоди-ка... Повтори, чего нет в пещере?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560129,
						730560130
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560129,
					"content": "Марана?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560131,
					"content": "Гм... Наверное, мне всё же понадобится ваша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560132
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560132,
					"content": "Хе-хе, надо было сразу послушать Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560133,
					"content": "Гм, простите мою бестактность... Но я так и не спросил, как вас зовут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560134
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560134,
					"content": "#Зови меня {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560135
					]
				},
				{
					"id": 730560135,
					"content": "А это Паймон! Пай-мон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560136,
					"content": "Паймон? Паймон... Ха-ха, интересное имя... Впервые слышу, чтобы человека... Или эльфа называли таким именем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560137
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560137,
					"content": "Ох, прошу прощения. Не хотел тебя обидеть. Я про эту малютку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560138
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560138,
					"content": "Какую малютку? Паймон очень даже обидно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560139,
					"content": "Ладно, довольно разговоров! Отважные джавансы, следуйте за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560140
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560140,
					"content": "«Джавансы»?.. Это кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560141
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560141,
					"content": "Слово из древнего языка, на котором говорят в моих родных местах. «Джаванс» значит «юный храбрец».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560142
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560142,
					"content": "А если точнее... «Молодой человек, который отважно борется с великим злом и не отступает даже перед лицом колоссальной несправедливости».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560143
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560143,
					"content": "Хи-хи, это как раз про нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560144
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560144,
					"content": "Значит, такими вы себя и видите? Ха-ха, тогда следуйте за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560145
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560145,
					"content": "А? Дедушка Хайям, как это ты так хорошо за нами поспеваешь в своём-то возрасте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560146
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560146,
					"content": "Ха-ха... Я изучаю лес уже по меньшей мере двадцать, а то и все тридцать лет. Так что не стоит недооценивать мою физическую форму. Идите вперёд. Я вас догоню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560130,
					"content": "Зоны Увядания?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560123,
					"content": "Тебе нужна наша помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560124
					]
				},
				{
					"id": 730560124,
					"content": "Ха-ха... Спасибо, доброе дитя. Кости у меня старые, плохо слушаются, но голова пока соображает, не стоит меня недооценивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560125
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560125,
					"content": "Во всяком случае, я знаю, как обрадовать этот лес, и он не причинит мне вреда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560111,
					"content": "Почтенный Хайям, что ты тут делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560112
					]
				},
				{
					"id": 730560112,
					"content": "Гм... Ты очень торопишься, слишком частишь. Ничего страшного, просто постарайся говорить чуть-чуть помедленнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Хайям"
				}
			]
		},
		{
			"id": 7305602,
			"completionStepIds": [
				7305606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305606",
							"2"
						],
						"stepId": 7305606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хайям",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560201,
					"content": "Мне нужно изучить здесь три точки. Ха-ха, в последний раз я наведывался сюда тридцать лет назад, но что-то ещё помню... Идите за мной, я покажу дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560202
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560202,
					"content": "Что же, спасибо вам за компанию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560203
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560203,
					"content": "Не за что, почтенный Хайям! Мы ведь джавансы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7305603,
			"completionStepIds": [
				7305609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305609",
							"2"
						],
						"stepId": 7305609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хайям",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560301,
					"content": "Интересно... Растения здесь как будто оживают. Значит, Мотийима снова им помогает... Настоящее чудо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560302
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560302,
					"content": "А?.. Почтенный Хайям тоже знает про Мотийиму? А Паймон думала, что только аранарам это известно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560303,
						730560304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560303,
					"content": "Паймон, тихо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				},
				{
					"id": 730560305,
					"content": "«Аранары», так ты сказала? Значит, вы тоже их видели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560306
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560306,
					"content": "А?.. Гм, да... Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560307,
						730560308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560307,
					"content": "Что такое, почтенный Хайям?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560309,
					"content": "«Где розы пышные твои, Ирем? Где кубок Джемшида, кто скажет нам?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560310
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560310,
					"content": "Идём дальше, к следующей точке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560308,
					"content": "Ты тоже видел аранар?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560304,
					"content": "Паймон!..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				}
			]
		},
		{
			"id": 7305604,
			"completionStepIds": [
				7305610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305610",
							"2"
						],
						"stepId": 7305610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хайям",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560401,
					"content": "Ха, глядите! Посмотрите на это!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560402
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560402,
					"content": "А? Какое-то новое растение? Чему ты так радуешься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560403,
					"content": "Нет, это не новое растение, это ещё лучше!.. Посмотрите, это ведь наш секретный замок! Ха, вот он во что превратился!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560404
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560404,
					"content": "Что?.. «Секретный замок»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560405,
					"content": "Ха-ха! Учёный Омар вернулся! И принёс с собой тайны небесных тел! Ирфан, Симан, где же вы? Почему не встречаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560406
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560407,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560408
					]
				},
				{
					"id": 730560408,
					"content": "Эх... Кхм-кхм... Простите, дети. Я... Я немного переволновался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560409
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560409,
					"content": "В старости всегда так: недавние события путаются в голове, зато картины из детства то и дело встают перед глазами, хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560410
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560410,
					"content": "Ирфан и Симан - так звали моих друзей, когда-то мы втроём вместе построили этот замок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560411
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560411,
					"content": "Ирфан тогда был великим музыкантом, Симан - грозным маршалом, а я - звездочётом. Иногда мы менялись ролями... Дети часто так делают, когда им прискучат правила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560412
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560412,
					"content": "Ирфан прекрасно владел музыкальными инструментами, Симан была высокой и сильной, и никто не мог одолеть её в драке. А я? Ха-ха, я просто любил читать, и дома у нас водились лишние моры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560413,
						730560415
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560413,
					"content": "Это место ваших детских игр?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560414
					]
				},
				{
					"id": 730560414,
					"content": "Нет, это наше секретное королевство, всё было очень серьёзно. Мы с ними поклялись, что не забудем друг друга, и когда повзрослеем, приведём сюда Армию возрождения, чтобы вернуть нашему замку былую славу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560418,
					"content": "Ха-ха, прошло двадцать лет, должно быть, они всё забыли... Я сделал из этого места свою маленькую лесную базу, но тридцать лет назад мне пришлось её оставить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560419
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560419,
					"content": "Потом сюда пришла Марана, а Армия возрождения так и не появилась. Ха-ха, да... Разве может детская клятва остановить наступление смерти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560420
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560420,
					"content": "Но... Раз ты их ещё помнишь, они тоже тебя не забыли! Не надо отчаиваться, почтенный Хайям!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560421,
					"content": "Отчаиваться? Нет, что ты. Детские воспоминания, общие воображаемые друзья - всему этому нет места во взрослой жизни. Да, мне немного жаль, но... Прошлого не вернуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560422
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560422,
					"content": "«Воображаемые друзья»... Ты сейчас об аранарах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560423,
						730560424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560423,
					"content": "Паймон!.. Тсс!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560425,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560426
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560426,
					"content": "Ха-ха... Я чуть не забыл, зачем мы сюда пришли. Не болтать о пустяках, а собирать образцы новых растений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560427
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560427,
					"content": "Простите старика за болтливость. Давайте приступим к делу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560424,
					"content": "Паймон, сколько можно болтать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560415,
					"content": "Всё это осталось от ваших игр?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560416
					]
				},
				{
					"id": 730560416,
					"content": "Нет, не всё. Однажды мы поклялись, что подрастём и вернёмся сюда с Армией возрождения родины, чтобы вернуть этому месту былую славу... Хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560417
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560417,
					"content": "Потом я стал изучать ботанику в Академии и вернулся с кое-какими преобразованиями - то приносил сюда разный хлам, то уносил его обратно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Хайям"
				}
			]
		},
		{
			"id": 7305605,
			"completionStepIds": [
				7305603,
				7305605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305603",
							"2"
						],
						"stepId": 7305603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хайям",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560501,
					"content": "Смотрите, смотрите!.. Как прекрасно здесь всё растёт! Даже пережив нашествие Мараны, земля по-прежнему дарит жизнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560502
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560502,
					"content": "Ха-ха! Мотийима, старая ты проказница! Тебя не взять голыми руками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560503
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560503,
					"content": "Надо же, почтенный Хайям как будто разом помолодел!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560504,
						730560506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560504,
					"content": "Надо же, а Паймон разом стала такой разговорчивой!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560505
					]
				},
				{
					"id": 730560505,
					"content": "Эй! Ты чего?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560508,
					"content": "Гм... Этих образцов должно хватить, спасибо вам за помощь. Мы закончили, давайте поворачивать назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560509
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560509,
					"content": "Ха-ха, просто замечательно... Возможно, эти образцы помогут мне продвинуться в изучении секретов и слабостей зоны Увядания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560510
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560510,
					"content": "Спасибо вам! Давайте вернёмся той же дорогой... И у меня есть для вас кое-что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560511
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560511,
					"content": "Отлично, подарок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560512,
					"content": "Ха-ха, почти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560506,
					"content": "Хорошо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560507
					]
				},
				{
					"id": 730560507,
					"content": "Не знаю, что именно хорошо, но хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7305606,
			"completionStepIds": [
				7305611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305611",
							"2"
						],
						"stepId": 7305611,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хайям",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560601,
					"content": "Благодарю вас, отважные джавансы. Спасибо, что помогли старику.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560602
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560602,
					"content": "Да, надеюсь, вы не откажетесь принять этот скромный подарок... Вам от меня, на память.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560603
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560603,
					"content": "Ого... Что там, что там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560604,
					"content": "Вы наверняка уже видели его раньше - маленький засохший цветок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560605
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560605,
					"content": "Ой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560606,
						730560607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560606,
					"content": "Это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				},
				{
					"id": 730560608,
					"content": "Да. И если моя догадка верна... Вам они тоже такой подарили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560609
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560609,
					"content": "Ха-ха, так я и знал, наша встреча не случайна... Я никогда не верил в совпадения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560610
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560610,
					"content": "Возьмите этот цветок себе. И прошу вас, передайте его нашим общим друзьям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560611
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560611,
					"content": "Гм, конечно, вот только...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560612,
						730560614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730560612,
					"content": "Скорее всего, они меня не помнят.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560613
					]
				},
				{
					"id": 730560613,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560615
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560615,
					"content": "И я их больше не вижу... Я даже не могу поверить, что они на самом деле существуют, ведь может быть... Что это просто мои детские фантазии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560616
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560616,
					"content": "Но я всё равно не сдаюсь. Дети, отнесите им этот цветок... Пока вы ещё способны их увидеть, пока чудо ещё возможно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730560614,
					"content": "Возможно, они тебя уже не помнят.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560615
					]
				},
				{
					"id": 730560607,
					"content": "Аранары...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				}
			]
