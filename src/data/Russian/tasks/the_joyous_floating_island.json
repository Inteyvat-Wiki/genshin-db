			"dialogs": [
				{
					"id": 762020601,
					"content": "Когда мы резко полетели вниз, Паймон так испугалась! Эй, это же огромная... статуя мандрагоры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762020602,
					"content": "Хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020603
					],
					"speakerTitle": "Осмотреть дверь"
				},
				{
					"id": 762020603,
					"content": "Минуточку. Прошу прощения, кажется, что-то пошло не так. Этого не должно было произойти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020604
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762020604,
					"content": "Хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020605
					],
					"speakerTitle": "Осмотреть дверь"
				},
				{
					"id": 762020605,
					"content": "Она зашевелилась! Она пытается атаковать нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762020606,
					"content": "Фух, так-то лучше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Николь"
				},
				{
					"id": 762021401,
					"content": "Николь, ты о чём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762021402,
					"content": "#Хм? Эта атака ведь совсем безобидная. {NICKNAME}, пришло время проявить свои способности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021403
					],
					"speakerTitle": "Николь"
				}
			]
		},
