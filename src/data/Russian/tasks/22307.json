			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бо Лай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070301,
					"content": "Да, хочу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070302
					]
				},
				{
					"id": 223070302,
					"content": "Готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070303
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223070303,
					"content": "Удачи! Не забудь вернуться с сокровищами. Помнишь, мы договорились поделить его на три части?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бо Лай"
				}
			]
		},
