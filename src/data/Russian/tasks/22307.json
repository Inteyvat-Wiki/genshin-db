			"dialogs": [
				{
					"id": 223070601,
					"content": "С возвращением! Получилось найти сокровища?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070602
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223070602,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070603
					]
				},
				{
					"id": 223070603,
					"content": "Отлично! Я же говорил, что ты настоящий искатель приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070604
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223070604,
					"content": "Так, так, так... Что у нас тут? Хм... Какой-то хлам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070605
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223070605,
					"content": "Но это лучше, чем ничего... Вот твоя доля. Я передам Чжан Шуню его часть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070606
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 223070606,
					"content": "#Эх... Всё ещё не наш{F#ла}{M#ёл} сокровище... Кажется, тот парень меня обманул...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бо Лай"
				}
			]
