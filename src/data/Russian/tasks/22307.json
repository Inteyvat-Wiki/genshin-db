				{
					"id": 223070501,
					"content": "Если бы не травма... Я бы охотился за серьёзными сокровищами вместе с капитаном и командой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070502
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223070502,
