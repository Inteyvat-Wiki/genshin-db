					}
				]
			},
			"dialogs": [
				{
					"id": 747010101,
					"content": "Ой, а откуда здесь появился ещё один бассейн? Что там написано на табличке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747010102,
					"content": "«Опасно. Не приближаться»! Что это значит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747010103,
					"content": "То и значит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010104
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747010104,
					"content": "Ой! Сандроне... Ты напугала Паймон. Это твоя табличка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747010105,
					"content": "Да. Не хочу, чтобы кто-нибудь из любопытства свалился в бассейн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010106
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747010106,
					"content": "А что там в бассейне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747010107,
					"content": "Пираньи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010108
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747010108,
					"content": "А?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747010109,
					"content": "Ха-ха, шучу. Ты что, правда поверила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010110
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747010110,
					"content": "Недавно я заметила, что некоторые рыбы в аквариуме обладают сильным чувством территории и довольно вспыльчивым нравом: они нападают на мелких рыбок. Поэтому я переселила их сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010111
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747010111,
					"content": "Ты так не пугай... Значит, это вроде особого санатория для буйных рыбок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747010112,
					"content": "Да, этот бассейн довольно глубокий и просторный. Здесь рыбам, которые не терпят вторжения на свою территорию, будет спокойнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010113
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747010113,
					"content": "Ещё я попросила у медсестры Сиджвин из крепости Меропид специальный корм, который поможет им успокоиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010114
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747010114,
					"content": "Вот оно что. А ты здорово заботишься об этих рыбках!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747010115,
					"content": "Мало кому понравится наблюдать за драками в аквариуме, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010116
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747010116,
					"content": "Да. Тогда давай ты поручишь эту работу нам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747010117,
					"content": "Хорошо. В общем, если рыбки захотят подняться на поверхность воды подышать, это значит, что они уже поправились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010118
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747010118,
					"content": "Если они больше не проявляют агрессии, можно снова вернуть их в общий аквариум?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747010119,
					"content": "Это решайте сами. Я только отлавливаю буйных и выпускаю в этот бассейн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010120
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747010120,
					"content": "Ладно, но объявление у тебя получилось слишком... страшным. Может, стоит его поменять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747010121,
					"content": "Хм... как хотите. Рыба ваша, вам и решать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
}