			"dialogs": [
				{
					"id": 762100301,
					"content": "Смотрите, это Столбы созерцателя слив, гордость школы Гухуа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100302
					],
					"speakerTitle": "Чжансунь Цзицзин"
				},
				{
					"id": 762100302,
					"content": "Могу я попросить вас показать мне своё мастерство? Нужно наступать на камни в указанной мной последовательности в течение отведённого времени!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100303,
						762100305
					],
					"speakerTitle": "Чжансунь Цзицзин"
				},
				{
					"id": 762100303,
					"content": "Раз плюнуть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100304
					]
				},
				{
					"id": 762100304,
					"content": "Может, ты всё-таки не будешь плеваться?.. Э-э, ладно, не обращай внимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762100307,
					"content": "#Прошу вас, {M#юный герой}{F#юная героиня}, покажите мне своё искусство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжансунь Цзицзин"
				},
				{
					"id": 762100305,
					"content": "Паймон, мастер школы Паймон, тоже легко прошла бы испытание...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100306
					]
				},
				{
					"id": 762100306,
					"content": "Что?! Да это невозможно, как ни... Стоп, хотя... Но ведь Паймон летает. Будет нечестно, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Паймон"
				}
			]
		},
