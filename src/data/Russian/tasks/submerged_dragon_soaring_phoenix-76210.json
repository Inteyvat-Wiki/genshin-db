			"dialogs": [
				{
					"id": 762100101,
					"content": "#{M#Юный герой}{F#Юная героиня}, у тебя необыкновенная техника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100102
					],
					"speakerTitle": "Чжансунь Цзицзин"
				},
				{
					"id": 762100102,
					"content": "#Хе-хе, ну конечно! {NICKNAME} очень {M#крутой}{F#крутая}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762100103,
					"content": "#Не откажется ли {M#юный герой}{F#юная героиня} показать мне истинную суть <color=#00E1FFFF>искусства прыжков</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100104
					],
					"speakerTitle": "Чжансунь Цзицзин"
				},
				{
					"id": 762100104,
					"content": "В анналах сказано, что древние мастера школы Гухуа могли взбираться по городским стенам так быстро, словно ступали по ровной земле. Овладев умением бегать по крышам и взбираться по стенам, они облекли эти техники в искусство прыжков...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100105,
						762100106
					],
					"speakerTitle": "Чжансунь Цзицзин"
				},
				{
					"id": 762100105,
					"content": "Вот это да!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100108
					]
				},
				{
					"id": 762100108,
					"content": "#Хм... А почему бы и нет? Ты же, {NICKNAME}, всё время лазаешь по разным местам в поисках сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762100106,
					"content": "Это не мастера, а какие-то налётчики...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100107
					]
				},
				{
					"id": 762100107,
					"content": "#Хе-хе, {M#юный герой}{F#юная героиня}, только подумайте: если налётчики умеют перелезать через стены, а мы ничего подобного сделать не можем, выходит, негодяи будут с лёгкостью сбегать от правосудия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100108
					],
					"speakerTitle": "Чжансунь Цзицзин"
				}
			]
		},
