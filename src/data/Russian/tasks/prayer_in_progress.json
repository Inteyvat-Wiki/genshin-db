					"Маки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110201,
					"content": "#Всё, закончил{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110202
					],
					"speakerTitle": "Маки"
				},
				{
					"id": 220110202,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110203
					]
				},
				{
					"id": 220110203,
					"content": "Большое спасибо. Оставь мне палочки с предсказаниями, и я повешу их обратно на место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110204
					],
					"speakerTitle": "Маки"
				},
				{
					"id": 220110204,
					"content": "Пожалуйста, прими это в качестве благодарности за твою помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110205
					],
					"speakerTitle": "Маки"
				},
				{
					"id": 220110205,
					"content": "Я понимаю, что люди отчаянно пытаются избавиться от невезения и привлечь в свою жизнь удачу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110206
					],
					"speakerTitle": "Маки"
				},
				{
					"id": 220110206,
					"content": "Но я правда думаю, что если они действительно хотят решить свои проблемы, то им стоит искать решения в своих собственных действиях, а не на листках с предсказаниями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110207
					],
					"speakerTitle": "Маки"
				},
				{
					"id": 220110207,
					"content": "Наивно же ждать, что боги предложат тебе помощь, если ты сам ничего не предпринимаешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Маки"
				}
			]
		},
