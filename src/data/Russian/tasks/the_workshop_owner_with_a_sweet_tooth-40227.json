			"dialogs": [
				{
					"id": 402270201,
					"content": "Вы провожаете Айно и Инеффу на выставку.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402270202
					]
				},
				{
					"id": 402270202,
					"content": "Хм... Демонстрационную платформу поставим вот здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270203
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 402270203,
					"content": "Новый механизм Айно... выглядит довольно любопытно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402270204,
					"content": "#{NICKNAME} и Паймон, приходите в любое время. Вы будете в восторге, я уверена!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270205
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 402270205,
					"content": "Спасибо за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270206
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402270206,
					"content": "Не за что! Ах да, в выставке участвуете вы вдвоём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402270207,
					"content": "Я буду участвовать, но Айно регистрировать не нужно. Ей не нравится скопление людей, поэтому после официального открытия выставки она вернётся в мастерскую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270208
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402270208,
					"content": "Хорошая мысль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
