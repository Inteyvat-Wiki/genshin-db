			"dialogs": [
				{
					"id": 402270101,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270102
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 402270102,
					"content": "Привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402270103,
					"content": "#{NICKNAME}, Паймон. Привет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270104
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402270104,
					"content": "Мы помогаем Нефер с организацией выставки и узнали, что мастерская крумкаке «Дзынь-Клац» тоже принимает участие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402270105,
					"content": "Да, Айно проводит последнюю настройку команды «Бах-бух».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270106
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402270106,
					"content": "Это товары, которые вы подготовили для выставки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402270107,
					"content": "Да. Кроты и другие маленькие зверьки постоянно что-то крадут из мастерской, поэтому Айно создала защитный механизм по их образу для охраны имущества.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270108
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402270108,
					"content": "В ходе испытаний эти роботы оказались очень эффективными, поэтому Айно решила модернизировать их и представить на выставке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270109
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402270109,
					"content": "Айно собирается продать свою работу? Паймон ушам своим не верит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402270110,
					"content": "Не совсем. За исключением нескольких специальных заказов Айно редко продаёт готовые изделия. На выставке она планирует продавать чертежи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270111
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402270111,
					"content": "Вот оно что... Кстати, вы готовы отправиться на выставку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402270112,
					"content": "Ягода попросила поторопить вас. Она подготовила для вас очень хорошее место. Если оно будет пустовать, люди начнут задавать ненужные вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402270113,
					"content": "Я сказала ей, что сперва нужно всё отладить! Торопить нас бесполезно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270114
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 402270114,
					"content": "Ого, Айно нечасто увидишь такой серьёзной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402270115,
					"content": "В последнее время мастерская столкнулась с серьёзной нехваткой средств. Айно надеется улучшить финансовое положение благодаря этой выставке, поэтому подходит к делу с особой ответственностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270116
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402270116,
					"content": "Нехватка средств? Неужели Айно проводит какое-то невероятно дорогое исследование?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402270117,
					"content": "Нет. У нас нехватка средств на сладости. Было зафиксировано не менее сорока семи случаев, когда из-за перерасхода средств на сладости возникал дефицит средств на исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270118
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402270118,
					"content": "Поэтому я решила разделить бюджет на исследования и бюджет на сладости. Айно запрещено перекладывать деньги из одного бюджета в другой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270119
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402270119,
					"content": "А совсем недавно Айно израсходовала весь месячный бюджет на сладости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270120,
						402270121
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402270120,
					"content": "Понятно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				},
				{
					"id": 402270122,
					"content": "Готово! Команда «Бах-бух», покажите класс!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270123
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 402270123,
					"content": "Мы готовы отправиться на выставку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 402270121,
					"content": "#Я не {F#удивлена}{M#удивлён}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				}
			]
		},
