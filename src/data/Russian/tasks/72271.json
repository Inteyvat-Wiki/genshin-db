					"Линь Лан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722710102,
					"content": "Хочу продать кое-какие сокровища.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710103
					]
				},
				{
					"id": 722710103,
					"content": "О, какие редкости вы нашли на этот раз? Позвольте мне взглянуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710104
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710104,
					"content": "Вы рассказываете Линь Лан о жемчужине Драконьего цветка.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722710105
					]
				},
				{
					"id": 722710105,
					"content": "Если сказанное вами правда, это изумительная реликвия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710106
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710106,
					"content": "Но при беглом осмотре я не вижу ничего выдающегося. Возможно, нужно время, чтобы качества проявились...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710107
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710107,
					"content": "На мой взгляд, чудесные свойства, которые вы приписываете, могут быть немного... преувеличены. А, может быть, это просто оправдание того, кто не справился...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710108
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710108,
					"content": "Но не принимайте близко к сердцу. У меня, как говорится, что на уме, то и на языке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710122
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710122,
					"content": "В нашем ремесле это обычное дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710109
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710109,
					"content": "Кроме того, я полагаю, что вы не хранили её запечатанной — поверхность уже слегка обшарпана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710110
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710110,
					"content": "Боюсь, это снижает цену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710123
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710123,
					"content": "Как насчёт 80 000 моры? Могу добавить ещё пять порций благополучия и процветания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710111,
					"content": "Это хорошая цена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710112,
						722710116,
						722710119
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710112,
					"content": "Что ты будешь с ней делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710113
					]
				},
				{
					"id": 722710113,
					"content": "Честно говоря, я считаю, что её история ценнее, чем полезность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710114
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710114,
					"content": "Это может заинтересовать рассказчиков, оперные труппы или благородных господ террасы Юйцзин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710115
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710115,
					"content": "А ещё я могу выставить её на прилавке, как древний экспонат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710116,
					"content": "Справедливая цена. Договорились.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710117
					]
				},
				{
					"id": 722710117,
					"content": "Ох, как славно. Вот ваша мора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710118
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710118,
					"content": "Если ещё найдёте подобные сокровища, двери моей лавки всегда открыты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710119,
					"content": "Мне нужно ещё подумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710120
					]
				},
				{
					"id": 722710120,
					"content": "Конечно. В конце концов, всегда нужно присматриваться к товарам... я хочу сказать, к ценам перед тем, как продавать драгоценные реликвии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710121
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710121,
					"content": "Приходите обратно, когда всё обдумаете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лан"
				}
			]
		},
