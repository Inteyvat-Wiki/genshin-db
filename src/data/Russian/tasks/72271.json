				{
					"id": 722710201,
					"content": "О жемчужине Драконьего цветка...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710202
					]
				},
				{
					"id": 722710202,
					"content": "Ох, вы уже приняли решение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710203
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710203,
					"content": "Возьму за 80 000 моры и пять порций благополучия и процветания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710204,
						722710207
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710204,
					"content": "Забирай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710205
					]
				},
				{
					"id": 722710205,
					"content": "Благодарю за визит. Вот ваша мора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710206
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710206,
					"content": "Если ещё найдёте подобные сокровища, двери моей лавки всегда открыты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710207,
					"content": "Мне нужно ещё подумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710208
					]
				},
				{
					"id": 722710208,
					"content": "Конечно. В конце концов, всегда нужно присматриваться к ценам перед тем, как продавать драгоценные реликвии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710209
					],
					"speakerTitle": "Линь Лан"
				},
				{
					"id": 722710209,
