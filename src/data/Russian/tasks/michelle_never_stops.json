				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200430101,
					"content": "Моя спина... Как больно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430102
					],
					"speakerTitle": "Мишель"
				},
				{
					"id": 200430102,
					"content": "Что произошло?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430103
					]
				},
				{
					"id": 200430103,
					"content": "Я собиралась на работу, но вдруг спина заболела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430104
					],
					"speakerTitle": "Мишель"
				},
				{
					"id": 200430104,
					"content": "Я обещала помочь Куинну с продажей фруктов, но думаю, что сейчас мне лучше будет немного передохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430105
					],
					"speakerTitle": "Мишель"
				},
				{
					"id": 200430105,
					"content": "Я не могу пойти на работу в таком состоянии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430106
					],
					"speakerTitle": "Мишель"
				},
				{
					"id": 200430106,
					"content": "Можешь спросить у Куинна, какую работу он для меня приготовил? Тогда я смогу подготовиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430107,
						200430109
					],
					"speakerTitle": "Мишель"
				},
				{
					"id": 200430107,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430108
					]
				},
				{
					"id": 200430108,
					"content": "Спасибо! Я скоро поправлюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мишель"
				},
				{
					"id": 200430109,
					"content": "Ты точно не можешь сама это сделать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430110
					]
				},
				{
					"id": 200430110,
					"content": "Эй, с таким пустяком можно и помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
