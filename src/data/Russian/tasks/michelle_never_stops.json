			"dialogs": [
				{
					"id": 200430501,
					"content": "#Ты наш{M#ёл}{F#ла} закатники?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430502
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430502,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430503
					]
				},
				{
					"id": 200430503,
					"content": "Благодарю. Этого должно быть достаточно для мисс Юри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430504
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430504,
					"content": "Эх... Похоже, что я всё равно потерял большинство покупателей. Нельзя заниматься торговлей в одиночку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430505
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430505,
					"content": "Ах, да! Нужно же тебе заплатить за работу. Подожди немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430506
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430506,
					"content": "Не нужно оплаты. У нас есть к тебе просьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200430507,
					"content": "Насчёт Мишель...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430508
					]
				},
				{
					"id": 200430508,
					"content": "Мишель? Вы её видели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430509
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430509,
					"content": "Более простую работу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430510
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430510,
					"content": "Я всего лишь просил её присмотреть за прилавком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430511
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430511,
					"content": "Действительно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200430512,
					"content": "Раз у меня больше нет покупателей, теперь ей не придётся делать даже это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430513
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430513,
					"content": "Передай ей, чтобы она шла домой отдыхать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430514
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430514,
					"content": "Я подожду доставку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Куинн"
				}
			]
		},
