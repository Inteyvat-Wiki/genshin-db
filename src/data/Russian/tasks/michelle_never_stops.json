					"Куинн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200430301,
					"content": "Где же моя доставка? Сколько можно ждать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430302
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430302,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430303
					]
				},
				{
					"id": 200430303,
					"content": "У меня заканчиваются закатники! Я уже заказал несколько дополнительных партий!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430304
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430304,
					"content": "Но их всё нет! Мои клиенты не готовы ждать вечно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430305
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430305,
					"content": "Мисс Юри приходила уже несколько раз, а ей всего-то нужно <color=#00E1FFFF>три закатника</color>! Она мой постоянный покупатель, и я не хотел бы её потерять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430306
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430306,
					"content": "Я не могу отойти от прилавка... Ах, если бы кто-нибудь помог мне собрать диких закатников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430307,
						200430309
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430307,
					"content": "Если это действительно срочно, то я могу заняться этим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430308
					]
				},
				{
					"id": 200430308,
					"content": "Правда? Восхитительно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430309,
					"content": "Мишель скоро подойдёт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430310
					]
				},
				{
					"id": 200430310,
					"content": "Что ты такое говоришь! Мишель не может собирать фрукты в таком состоянии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200430311,
					"content": "Мы должны помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
