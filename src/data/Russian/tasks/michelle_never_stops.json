			"dialogs": [
				{
					"id": 200430601,
					"content": "#Ты поговорил{F#а} с Куинном?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430602
					],
					"speakerTitle": "Мишель"
				},
				{
					"id": 200430602,
					"content": "Да. Он сказал, чтобы ты шла домой отдыхать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430603
					]
				},
				{
					"id": 200430603,
					"content": "У Куинна сегодня больше нечего делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200430604,
					"content": "Эх, надо поискать себе другое занятие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430605
					],
					"speakerTitle": "Мишель"
				},
				{
					"id": 200430605,
					"content": "Что? Разве ты не пойдёшь отдыхать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200430606,
					"content": "Чувствуешь ветер? Барбатос трудится беспрестанно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430607
					],
					"speakerTitle": "Мишель"
				},
				{
					"id": 200430607,
					"content": "Чтобы заслужить милость Барбатоса, мы тоже должны трудиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430608
					],
					"speakerTitle": "Мишель"
				},
				{
					"id": 200430608,
					"content": "Вы тоже трудились? Так сильно вспотели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430609
					],
					"speakerTitle": "Мишель"
				},
				{
					"id": 200430609,
					"content": "Похоже, что у вас тоже полно работы. Это славно. Чем усерднее мы трудимся, тем добрее к нам ветра Барбатоса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430610
					],
					"speakerTitle": "Мишель"
				},
