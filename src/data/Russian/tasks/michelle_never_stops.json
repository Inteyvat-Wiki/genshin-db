			"dialogs": [
				{
					"id": 200430401,
					"content": "#Ты наш{M#ёл}{F#ла} <color=#00E1FFFF>закатники</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430402
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200430402,
					"content": "Пока ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430403
					]
				},
				{
					"id": 200430403,
					"content": "За городом должно быть полно <color=#00E1FFFF>закатников</color>! Прошу тебя, поспеши! Я бы и сам этим занялся, но не могу отойти от прилавка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Куинн"
				}
			]
		},
