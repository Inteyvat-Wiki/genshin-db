					"Маргарита"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4870301,
					"content": "Принц! Куда ты убежал? Хвала Архонтам, с тобой всё хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870302
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 4870302,
					"content": "Заставил нас попотеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4870303,
					"content": "Эй, маленький Принц! Зачем же ты от меня сбежал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870304
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 4870304,
					"content": "Оставим их вдвоём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4870305,
					"content": "Вот твои струны, Венти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4870306,
					"content": "Нашлись! Я уже попрощался с ними навсегда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870307
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 4870307,
					"content": "В награду ты получишь эксклюзивное выступление от лучшего барда на континенте, который будет играть на этих самых струнах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870308
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 4870308,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4870309,
					"content": "Апчхи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870310
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 4870310,
					"content": "Кхе-кхе... Прошу прощения... Аллергия на кошек даёт о себе знать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870311
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 4870311,
					"content": "Теперь понятно, почему ты сам не стал искать струны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4870312,
					"content": "В любом случае спасибо за помощь. *Апчхи*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		},
