			"dialogs": [
				{
					"id": 4870101,
					"content": "Так это у вас котик потерялся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870102
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 4870102,
					"content": "Венти! Ты пришёл, чтобы помочь нам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4870103,
					"content": "Я? Помочь вам? Вообще-то помощь нужна мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870104
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 4870104,
					"content": "Но Паймон заметила, как ты говоришь с Маргаритой о Принце...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4870105,
					"content": "Принц! Значит, так зовут кота, который стащил мои <color=#00E1FFFF>струны из астрального железа</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870106
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 4870106,
					"content": "Хоть мне и греет душу то, что свободный дух Мондштадта живёт и в братьях наших меньших, я всё равно нахожу его поступок возмутительным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870107
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 4870107,
					"content": "Ха-ха! Принц - коварный маленький разбойник!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870108
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 4870108,
					"content": "Говоришь, как родитель, любящий баловать своё дитя...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4870109
					]
				},
				{
					"id": 4870109,
					"content": "Да. Прямо как Барбатос...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4870110,
					"content": "Какое меткое сравнение... Кхм, а теперь давайте отправимся на встречу с его избалованным высочеством, разбойничьим Принцем Мондштадта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870111
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 4870111,
					"content": "У меня сегодня выступление. Струны мне более чем понадобятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870112
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 4870112,
					"content": "Зачем котику вообще понадобились струны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4870113,
					"content": "Ни один котик не сможет устоять перед клубком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870114
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 4870114,
					"content": "Клубком?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4870115,
					"content": "Эти струны сделаны из астрального железа, пропитанного Анемо энергией. Они очень прочные, поэтому я обычно сматываю их в клубок. Так удобней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870116
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 4870116,
					"content": "Секреты опытного барда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870117
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 4870117,
					"content": "Ты сказал, что струны пропитаны Анемо энергией?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4870118,
					"content": "#Это должно сработать! {NICKNAME}, используй <color=#00E1FFFF>чувство стихий</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4870119,
					"content": "Котик должен оставлять элементальные следы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4870122,
					"content": "Спасибо вам. Принц бегает где-то в окрестностях рыночной площади и жилого квартала. У него чёрная шерсть без единого пятнышка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 4870121,
					"content": "Вот, возьми <color=#00E1FFFF>рыбку</color>, Принц очень любит кушать рыбку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Маргарита"
				}
			]
		}
