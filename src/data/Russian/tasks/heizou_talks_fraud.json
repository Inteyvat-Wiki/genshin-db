				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иба"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570901,
					"content": "С этим Хэйдзо и правда лучше не связываться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570902
					],
					"speakerTitle": "Иба"
				},
				{
					"id": 190570902,
					"content": "А? Вы хотите узнать, что случилось со стариком? На самом деле ничего интересного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570903
					],
					"speakerTitle": "Иба"
				},
				{
					"id": 190570903,
					"content": "Узнав, что дело расследует этот самый Хэйдзо, старик сразу во всём сознался. А как же, с «Ураганом» шутки плохи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570904
					],
					"speakerTitle": "Иба"
				},
				{
					"id": 190570904,
					"content": "С «Ураганом»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190570905
					]
				},
				{
					"id": 190570905,
					"content": "Прозвище Хэйдзо. Вы разве не знали? Преступники его только так и называют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570906
					],
					"speakerTitle": "Иба"
				},
				{
					"id": 190570906,
					"content": "От него не сбежать и не спрятаться, для преступников Хэйдзо - такое же бедствие, как настоящий ураган.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570907
					],
					"speakerTitle": "Иба"
				},
				{
					"id": 190570907,
					"content": "Эх, если бы я знал, что так выйдет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иба"
				}
			]
		}
	]
