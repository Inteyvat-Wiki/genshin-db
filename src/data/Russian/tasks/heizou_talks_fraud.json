				"objectNames": [
					"Кано Нана"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570801,
					"content": "#Здравствуйте, путешественни{F#ца}{M#к}! Наверное, мой братец доставил вам немало хлопот? Характер у него своевольный, но сердце доброе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570802
					],
					"speakerTitle": "Кано Нана"
				},
				{
					"id": 190570802,
					"content": "Если он вас чем-то обидел, не стесняйтесь и как следует его проучите! Если же он посмеет противиться, скажите, что я вам разрешила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кано Нана"
				}
			]
		},
		{
			"id": 1905709,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
