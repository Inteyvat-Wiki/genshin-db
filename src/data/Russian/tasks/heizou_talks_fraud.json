				"points": []
			},
			"dialogs": [
				{
					"id": 190570701,
					"content": "Прошу прощения, я не должна была этого говорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570702
					],
					"speakerTitle": "Эцу"
				},
				{
					"id": 190570702,
					"content": "Вы спрашиваете о господине Хэйдзо? Должно быть, он ненавидит таких людей, как я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570703
					],
					"speakerTitle": "Эцу"
				},
				{
					"id": 190570703,
					"content": "Он отлично владеет собой, в разговоре остаётся вежлив и даже приветлив, но я вижу, что к мошенникам и прочим преступникам Хэйдзо относится иначе... Он ненавидит мошенников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570704
					],
					"speakerTitle": "Эцу"
				},
				{
					"id": 190570704,
					"content": "Неужели он тоже однажды стал их жертвой? Трудно представить, чтобы кто-то попытался обмануть господина Хэйдзо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эцу"
				}
			]
		},
		{
			"id": 1905708,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
