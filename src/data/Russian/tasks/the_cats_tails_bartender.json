			},
			"dialogs": [
				{
					"id": 191010101,
					"content": "Великолепно! В «Кошкином хвосте» отличная выпивка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010102
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 191010102,
					"content": "Где-где?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010103
					]
				},
				{
					"id": 191010103,
					"content": "#А, это ты, путешественни{F#ца}{M#к}. Ты не знаешь про «Кошкин хвост»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010104
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 191010104,
					"content": "#Ты выглядишь так, будто никогда о нём не слышал{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010105
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 191010105,
					"content": "В «Кошкином хвосте» есть несколько удивительных фирменных блюд, которые вы никогда раньше не пробовали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010106
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 191010106,
					"content": "Это место полностью соответствует своему названию - там очень много милых котят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010107
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 191010107,
					"content": "С котиками и качественной выпивкой перестаёшь следить за временем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010108,
						191010109
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 191010108,
					"content": "«Кошкин хвост» сейчас открыт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				},
				{
					"id": 191010110,
					"content": "А в твоём возрасте можно употреблять алкоголь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010111
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 191010111,
					"content": "Всё в порядке! Их бармен - Диона - лучший бармен Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010112
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 191010112,
					"content": "Для неё не проблема приготовить для тебя стаканчик безалкогольного напитка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010113
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 191010113,
					"content": "А ещё Диона тоже очень милая, прямо как те котята...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010114
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 191010114,
					"content": "Ой... Прошу, не говори Дионе, что я это сказал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010115
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 191010115,
					"content": "В общем, если вы хотите пойти в «Кошкин хвост», дверь прямо за вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010116
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 191010116,
					"content": "А я пойду протрезвею немного. Кажется, я немного перебрал. Пятый стакан мне не по силам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 191010109,
					"content": "Я тоже хочу попробовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				}
			]
		}
	]
}