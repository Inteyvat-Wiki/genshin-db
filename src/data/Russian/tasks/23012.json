					"Саре"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230120301,
					"content": "Вы вернули мою кошечку, как же я вам благодарна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120302
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120302,
					"content": "Вижу, уроки кошачьего языка не прошли даром!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120303
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120303,
					"content": "Вот, прими это в качестве награды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120304
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120304,
					"content": "Нечасто встречаются люди, которым так легко даётся кошачий язык. Может, когда-нибудь мне придётся снова обратиться к тебе за помощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120305
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120305,
					"content": "Мяу!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120306
					]
				},
				{
					"id": 230120306,
					"content": "Можешь говорить по-человечьи! Ведь госпожа Саре - не кошка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230120307,
					"content": "#Судя по выражению лица, ты хотел{F#а} сказать: «С удовольствием», но... Тебя немного подвело произношение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120308
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120308,
					"content": "Ничего страшного, позже я дам тебе ещё несколько уроков кошачьего языка, будем учиться вместе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Саре"
				}
			]
		},
