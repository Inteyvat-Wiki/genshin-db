				"points": []
			},
			"dialogs": [
				{
					"id": 230120101,
					"content": "Мяу... Кхе-кхе... Кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120102
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120102,
					"content": "Что ты делаешь?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120103
					]
				},
				{
					"id": 230120103,
					"content": "Ищу своих кошек. Раньше они всегда откликались на этот зов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120104
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120104,
					"content": "Может, я ошиблась в произношении? Зову и зову, а они не откликаются, странное дело...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120105,
						230120109
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120105,
					"content": "Почему нельзя просто позвать их по имени?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120106
					]
				},
				{
					"id": 230120106,
					"content": "Да, обычно хозяева подзывают кошек по кличке, разве нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230120107,
					"content": "Но как же кошки поймут хозяина, если он будет обращаться к ним на человеческом языке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120108
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120108,
					"content": "Мм? А в этом есть своя логика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230120113,
					"content": "Но как я ни зову, они не откликаются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120114
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120114,
					"content": "#Путешественни{F#ца}{M#к}, мне нужно задать тебе один серьёзный вопрос...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120115,
						230120116
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120115,
					"content": "Поручи это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120117,
					"content": "Ты хочешь научиться кошачьему языку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120118
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120118,
					"content": "А?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120119
					]
				},
				{
					"id": 230120119,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230120120,
					"content": "То есть ты научишь нас языку, на котором говорят кошки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230120116,
					"content": "Насчёт вознаграждения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120109,
					"content": "Что значит «ошиблась в произношении»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120110
					]
				},
				{
					"id": 230120110,
					"content": "Я сейчас не просто мяукала, а повторяла их имена на кошачьем языке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120111
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120111,
					"content": "Ведь если звать кошек по имени на человеческом языке, они всё равно ничего не поймут, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120112
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230120112,
					"content": "Мм? А в этом есть своя логика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "Паймон"
				}
			]
		},
