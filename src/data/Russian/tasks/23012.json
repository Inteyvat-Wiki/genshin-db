					"Саре"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230121101,
					"content": "Мне уже доводилось общаться с кошками...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121102
					]
				},
				{
					"id": 230121102,
					"content": "Ты про Нэко? Но Нэко говорила на человеческом языке, а не на кошачьем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230121103,
					"content": "Да, но за это я попрошу тебя отыскать мою кошечку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121104,
						230121105
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230121104,
					"content": "Без проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121108
					]
				},
				{
					"id": 230121108,
					"content": "Так вы согласны? Я вам очень благодарна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121109
					],
					"speakerTitle": "Саре"
				},
				{
					"id": 230121109,
					"content": "Кхе-кхе-кхе... Тогда слушайте внимательно. Я много времени потратила на составление этого сборника, он называется «Типовые фразы кошачьего языка».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Саре"
				},
				{
					"id": 230121105,
					"content": "В каждом городе свои способы искать потерявшихся кошек...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121106
					]
				},
				{
					"id": 230121106,
					"content": "Ха-ха, точно... Если так подумать, почти в каждом городе мы возвращали хозяевам пропавших кошек...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230121107,
					"content": "Наверное, все люди любят кошек, а может... Все хозяева кошек рано или поздно сталкиваются с одинаковыми неприятностями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121108
					],
					"speakerTitle": "Паймон"
				}
			]
		},
