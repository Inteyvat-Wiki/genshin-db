			"dialogs": [
				{
					"id": 130120201,
					"content": "Кстати, за эти дни произошло ещё кое-что странное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120202
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130120202,
					"content": "Ко мне пришла одна негоциантка и потребовала деньги за какую-то сумку для путешествий по пустыне, назвав сумму в один миллион двести пятьдесят тысяч моры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120203
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130120203,
					"content": "Я не помнил, чтобы я кому-то задолжал, да и сумма заоблачная, поэтому я посадил негоциантку под стражу за провокации и хулиганство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120204
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130120204,
					"content": "Вы что-то об этом знаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120205
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 130120205,
					"content": "Н-нет. Паймон ничего не известно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
