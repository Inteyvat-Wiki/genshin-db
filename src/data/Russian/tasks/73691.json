				"points": []
			},
			"dialogs": [
				{
					"id": 736910101,
					"content": "Надеюсь, всем понравится эта игрушка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910102
					],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910102,
					"content": "Во что здесь можно поиграть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910103
					]
				},
				{
					"id": 736910103,
					"content": "#Ты ведь... путешественни{F#ца}{M#к}? Я Фарбал, студент Ртавахиста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910104
					],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910104,
					"content": "Эм... Ты знаешь, что изучает наш даршан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910105
					],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910105,
					"content": "Ах... Насколько я помню, это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910106
					]
				},
				{
					"id": 736910106,
					"content": "Ртавахист специализируется на исследовании звёзд. Конечно, так говорить не совсем правильно, потому что в даршане существует множество областей исследования...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910107
					],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910107,
					"content": "К сожалению, обычные люди вряд ли поймут или... заинтересуются предметами наших исследований.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910108
					],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910108,
					"content": "Если просто установить астрологический киоск, боюсь, что студенты, которые будут за него отвечать, невольно погрузятся в научные беседы и забудут о своих обязанностях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910109
					],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910109,
					"content": "Поэтому после всесторонних обсуждений мы нашли компромиссное решение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910110
					],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910110,
					"content": "Видишь эту астролябию? В верхней части располагаются звёзды. Тебе нужно собрать из них определённый рисунок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910111
					],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910111,
					"content": "Рисунки будут не очень сложными и не будут связаны с неразрешёнными научными спорами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910112
					],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910112,
					"content": "Кхе, то есть... Это просто игра в пазлы ради удовольствия, которая не вызовет научных споров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910113
					],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910113,
					"content": "Кажется, ты очень нервничаешь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910114
					]
				},
				{
					"id": 736910114,
					"content": "Эта игра всё-таки связана со звёздами... Некоторые студенты нашего даршана начинают сильно нервничать от одного только упоминания слова «звёзды».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910115
					],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910115,
					"content": "Ты не представляешь, скольким студентам во время проектирования мне пришлось объяснять, что это просто игрушка и что она не имеет никакого отношения к научным исследованиям...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910116
					],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910116,
					"content": "Ну, хватит разговоров. Если тебе интересно, можешь попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910117,
						736910119
					],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910117,
					"content": "Хочу попробовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910118
					]
				},
				{
					"id": 736910118,
					"content": "Хорошо, вот астролябия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фарбал"
				},
				{
					"id": 736910119,
					"content": "Мне пока некогда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910120
					]
				},
				{
					"id": 736910120,
					"content": "Эм, ничего страшного. Мой киоск будет открыт на протяжении всего Праздника мудрости. Если захочешь сыграть, просто приходи сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фарбал"
				}
			]
		}
	]
}