			"dialogs": [
				{
					"id": 750013201,
					"content": "Невероятно! Это место действительно такое, как описано в истории и песне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013202
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750013202,
					"content": "Шум стихает... Теневая игла возвращается в изначальное состояние. Эта огромная штука с грохотом падает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013203
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750013203,
					"content": "Фух... Подумать только, кому-то действительно удалось это сделать... Это ведь не сон, правда? Вы все реальны, не плод моего воображения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013204
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750013204,
					"content": "Проснись, проснись... Тебе предстоит самому решить эту проблему!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013205
					]
				},
				{
					"id": 750013205,
					"content": "Не шути так жестоко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750013206,
					"content": "#Паймон же говорила тебе, что {NICKNAME} очень сильн{F#ая}{M#ый}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750013207,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013208,
					"content": "#Хи-хи, {REALNAME[ID(2)|SHOWHOST(true)]}, ты тоже думаешь, что это здорово?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750013209,
					"content": "#{NICKNAME}, ты не пострадал{F#а} от влияния Бездны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013210,
						750013211
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750013210,
					"content": "Не переживай, это всего лишь Бездна...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				},
				{
					"id": 750013212,
					"content": "#Даже самые сильные воины племени должны быть осторожными, столкнувшись с Бездной. {NICKNAME}, ты необычный человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013213
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750013213,
					"content": "Возможно, из этого выйдет история, которая будет ещё более захватывающей, чем те, что удалось сочинить Санхаджу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013214
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750013214,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013215
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013215,
					"content": "Не знаю, кто такой Санхадж, но звучит потрясающе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750013216,
					"content": "Ха-ха, все рассказчики племён почитают Санхаджа из Повелителей Ночного Ветра...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013217
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750013217,
					"content": "Но сейчас нам нужно поторопиться. Потом я расскажу вам подробнее о Санхадже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013218
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750013218,
					"content": "Ладно, идём к следующей всплывшей малой Теневой игле. Побыстрее с этим разберёмся, и я наконец начну писать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013219
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750013219,
					"content": "В путь, в путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750013220,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013211,
					"content": "Пока что со мной всё хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				}
			]
		},
		{
			"id": 7505704,
			"completionStepIds": [
				7505702
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7505702",
							"2"
						],
						"stepId": 7505702,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7500107",
							"2"
						],
						"stepId": 7500107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750010801,
					"content": "Ой, я услышал какой-то жуткий звук. Вот решил посмотреть, в чём дело...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010802
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010802,
					"content": "Говорил себе: «Да ладно, Титу, это, наверное, ерунда...» Но это уже что-то! Действительно что-то!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010803
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010803,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010804
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010804,
					"content": "Ого, тепетлизавр... Благодаря тебе эти чужаки попали сюда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010805
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010805,
					"content": "Вы опустили Теневую иглу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010806,
						750010809
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010806,
					"content": "Не нужно было?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010807
					]
				},
				{
					"id": 750010807,
					"content": "#Что? Значит, мы... сделали что-то плохое, {NICKNAME}? Ну, пока только один свидетель...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010808
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750010808,
					"content": "#Ха-ха, да ладно тебе! Если уж на то пошло, я бы сказал, что вы оказали нам услугу! Так, значит, ты {NICKNAME}? А кто твоя подруга?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010813
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010813,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010814
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010814,
					"content": "#Это {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010815
					]
				},
				{
					"id": 750010815,
					"content": "Ага. А меня зовут Титу. Я расск{RUBY#[D]рассказчик}азываю истории для племени. А ещё я забочусь о каменных колоннах в долине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010816
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010816,
					"content": "И конечно же, эта Теневая игла, которую вы погрузили в землю, - одна из трёх, между прочим, - находится в моём ведении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010817
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010817,
					"content": "В ведении?.. Похоже, нам придётся заплатить местным жителям за то, что опустили каменную колонну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010818
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750010818,
					"content": "Не стоило использовать наши настоящие имена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010819
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750010819,
					"content": "Компенсация... «Титу посетила вспышка вдохновения. Он воспользуется возможностью, чтобы эти люди помогли ему достичь своих целей...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010820
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010820,
					"content": "Во всяком случае, именно это я бы и вписал в сюжет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010821
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010821,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010822
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010822,
					"content": "Ах, простите, немного увлёкся. Я отвечаю за рассказывание исто{RUBY#[D]рассказчик}рий племени. Каждую историю я рассказываю уже много лет, а теперь пришло время придумать новые истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010823
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010823,
					"content": "Я думал только об этом, а теперь Теневая игла ещё сломалась... Как говорится, если не везёт, так по-крупному.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010824
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010824,
					"content": "Кхе-кхе, я не хочу вас шантажировать. Иначе я бы с вами своими мыслями не делился, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010825
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010825,
					"content": "Ну, мы назвали друг другу свои имена, но не подрались. Это значит, что мы теперь друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010826
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010826,
					"content": "Вы можете выслушать просьбу друга?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010827
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010827,
					"content": "Конечно... до тех пор, пока речь не идёт о компенсации.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010828
					]
				},
				{
					"id": 750010828,
					"content": "Конечно, нет. Как бы вам объяснить... Ах да, когда вы проходили через долину, вы не видели огромный твёрдый флогистон с золотыми узорами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010829
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010829,
					"content": "Он в самом центре. Его невозможно не заметить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010830,
						750010831
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010830,
					"content": "Думаю, было такое...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010833
					]
				},
				{
					"id": 750010833,
					"content": "Дело, о котором я говорю, связано с той огромной каменной колонной. Мы называем её Теневой иглой... и в последнее время у нас с ней возникли проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010834
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010834,
					"content": "До того, как я вас встретил, я уже хотел сдаться. Я говорил себе: «Теневые иглы не могли быть спасены, и это обрекает племя на гибель». Неплохо звучит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010835
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010835,
					"content": "Это ведь всего лишь каменная колонна. Как она может быть связана с уничтожением племени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010836
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750010836,
					"content": "И ещё, что такого особенного в этих «больших и малых Теневых иглах»? Разве все они не являются большими каменными колоннами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010837
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750010837,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010838
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010838,
					"content": "#О, {NICKNAME} и Паймон, вы, должно быть, чужеземцы, а потому вам понадобится более подробная информация. Это связано с легендой, передаваемой в нашем племени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010839
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010839,
					"content": "Если верить историям, Вайоб повесила иглы здесь, чтобы запечатать тень Повелителя вулканов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010840
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010840,
					"content": "Но на самом деле они запечатали Бездну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010841
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010841,
					"content": "Таково большинство историй в Натлане. Это приукрашенные повествования, полные преувеличений и метафор, которые служат предостережением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010842
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010842,
					"content": "Погоди, говоришь, Бездна запечатана здесь под землёй?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010843
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750010843,
					"content": "Именно так. И недавно две из трёх малых Теневых игл всплыли вверх. Возможно, если и третья всплывёт, всё зло, что нынче под землёй, поднимется, как во время прилива.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010844
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010844,
					"content": "Честно говоря, то, что вам удалось вернуть её обратно, - это неожиданная удача. Так что никакая компенсация не нужна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010845
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010845,
					"content": "И ещё я хочу попросить вас о помощи. Не могли бы вы опустить и вторую малую Теневую иглу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010846
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010846,
					"content": "#Что думаешь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010847,
						750010848
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750010847,
					"content": "Если Бездна замешана, мы не можем остаться в стороне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010849,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010850
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010850,
					"content": "#Ладно, раз даже {REALNAME[ID(2)|SHOWHOST(true)]} соглашается, то и Паймон тоже за...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010851
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750010851,
					"content": "Ох... Как в тумане ночи появляется огонёк, так и в тёмные времена всегда появляются герои. В такие моменты человеческий потенциал проявляется максимально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010852
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010852,
					"content": "#Возможно, это будет отличная история. {NICKNAME}, у тебя есть качества, которыми не обладают даже герои из историй. Это впечатляет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010853
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010853,
					"content": "Вперёд, герои! Пойдёмте проверим оставшуюся Теневую иглу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010848,
					"content": "Думаю, мы можем помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010831,
					"content": "Что-то не припоминаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010832
					]
				},
				{
					"id": 750010832,
					"content": "Правда? Вот и хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010833
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010809,
					"content": "#Это всё Паймон! Я здесь случайно {M#прогуливался}{F#прогуливалась}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010810
					]
				},
				{
					"id": 750010810,
					"content": "Эй! Ты всегда так говоришь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010811
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750010811,
					"content": "#Ха-ха, не волнуйтесь. Если уж на то пошло, то я рад. Значит, тебя зовут Паймон? В таком случае как насчёт {M#этого парня}{F#этой девушки}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010812
					],
					"speakerTitle": "Титу"
				},
				{
					"id": 750010812,
					"content": "#Меня зовут {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010813
					]
				}
			]
		}
	]
}