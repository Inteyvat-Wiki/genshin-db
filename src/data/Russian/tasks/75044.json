			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440701,
					"content": "Зов Завриана работает круглые сутки! Всех людей и заврианов, желающих потренироваться с Матагой, ждут наверху!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440702
					],
					"speakerTitle": "Броский лозунг"
				},
				{
					"id": 750440702,
					"content": "Внимание: лень и нерадивость на тренировках постыдны. Только усердие, только трудолюбие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440703
					],
					"speakerTitle": "Броский лозунг"
				},
				{
					"id": 750440703,
					"content": "Если сегодня не будешь стараться, завтра окажешься на свалке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440704
					],
					"speakerTitle": "Броский лозунг"
				},
				{
					"id": 750440704,
					"content": "Лишь тот, кто бесстрашно движется вперёд, сможет стать настоящим наездником!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Броский лозунг"
				}
			]
		},
		{
			"id": 7504408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440801,
					"content": "Пароль: подать сигнал в левый рог, затем в правый, затем в левый и снова в правый! Не перепутай! За последствия отвечаешь сам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440802
					],
					"speakerTitle": "Матага! Запомни!!!"
				},
				{
					"id": 750440802,
					"content": "Чтобы завриан оставался в хорошем настроении и не клевался, надо кормить его мясом птицы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440803
					],
					"speakerTitle": "Матага! Запомни!!!"
				},
				{
					"id": 750440803,
					"content": "(Похоже на памятку, которую некий человек по имени Матага оставил сам для себя. Даже по почерку видно, как сильно он одержим своим делом.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440804
					],
					"speakerTitle": "Матага! Запомни!!!"
				},
				{
					"id": 750440804,
					"content": "(Но ставить столько восклицательных после каждой фразы - всё равно, что не ставить их совсем...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Матага! Запомни!!!"
				}
			]
		},
		{
			"id": 7504417,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
