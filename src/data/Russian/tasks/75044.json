			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443601,
					"content": "(Любовный роман за авторством Дороти Ликсон. На выцветшей обложке изображена женщина в постели, усыпанной цветами.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443602
					],
					"speakerTitle": "Цветок лаванды"
				},
				{
					"id": 750443602,
					"content": "(Просмотрев книгу, вы чувствуете тепло и удовлетворение, но никаких озарений в ней вы не нашли.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443603
					],
					"speakerTitle": "Цветок лаванды"
				},
				{
					"id": 750443603,
					"content": "И всё-таки... Это был её садовник? Или муж старшей сестры двоюродного брата её лучшей подруги? Ох, у Паймон голова кругом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7504437,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443701,
					"content": "(Биография Фрэнка Дребина, отставного инспектора особой бригады Сумеречного двора. Да, инспектор - энергичный белый кот.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443702
					],
					"speakerTitle": "Детектив Снежок"
				},
				{
					"id": 750443702,
					"content": "(На титульном листе книги стоит большой отпечаток кошачьей лапы - возможно, автограф, который инспектор на память оставил своим подчинённым.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443703
					],
					"speakerTitle": "Детектив Снежок"
				},
				{
					"id": 750443703,
					"content": "Что? А почему про Паймон тогда не напишут книгу? Пусть она называется... «Белокурый детектив»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7504438,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443801,
					"content": "(Пьесы фонтейнского драматурга Джин Бруклин. Толстая увесистая книга, её можно ставить под ноги низкорослым людям вместо ступеньки.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "История Тейвата. Часть I"
				}
			]
		},
		{
			"id": 7504439,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
