					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750444601,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444602
					],
					"speakerTitle": "Маниту"
				},
				{
					"id": 750444602,
					"content": "Вот оно! Нам нужен предмет, на котором есть красный цвет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750444603,
					"content": "Что? Штука, которую мы туда бросили, исчезла... Мы ведь её бросили? Странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750444604,
					"content": "В банке есть что-то ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750444605,
					"content": "(Постучать по банке)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7504447,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
