			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443901,
					"content": "(Фотоальбом, в который давно никто не заглядывал. Внутри много фотографий разных красавиц.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443902
					],
					"speakerTitle": "Коллекция рекламы фонтейнского парфюма"
				},
				{
					"id": 750443902,
					"content": "Пф... Девушки, девушки, снова девушки. Неинтересно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
