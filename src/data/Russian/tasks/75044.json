				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442401,
					"content": "«...Да пребудет вечная слава... Миротворец... добрейший... Оч-кан...»",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442402
					]
				},
				{
					"id": 750442402,
					"content": "«Мастера Махуцинтль, Тланалько и... отвечавшие за водоотводные работы... не соблюдали темп, чем вызвали задержку... добрейший... не наказал... только приостановил выдачу пайка на три недели...»",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442403
					]
				},
				{
					"id": 750442403,
					"content": "«...<color=#00E1FFFF>каменный ключ</color>, что запускает <color=#00E1FFFF>водяной насос</color>... находится... нельзя без разрешения... и даже будут назначены другие мастера...»",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
