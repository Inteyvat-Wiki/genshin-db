			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Флора"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200690101,
					"content": "Цветы увяли. Какая досада...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690102
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690103
					]
				},
				{
					"id": 200690103,
					"content": "Обычно для подарков люди покупают по одному цветку, поэтому каждое утро я наперёд срезаю отдельные цветки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690104
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690104,
					"content": "Но срезанные цветы долго храниться не могут. Если их не продать в тот же день, они вянут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690105
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690105,
					"content": "Что бы я ни пробовала, к концу дня они все вянут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690106
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690106,
					"content": "Должен же быть какой-нибудь способ хранить цветы свежими подольше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690107,
						200690111
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690107,
					"content": "Может, хранить их как еду?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690108
					]
				},
				{
					"id": 200690108,
					"content": "Сара из «Хорошего охотника» как-то говорила, что они хранят оставшиеся продукты в прохладном месте или обкладывают льдом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690109
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690109,
					"content": "Я попробовала такой метод, но если цветы просто положить на лёд, они меняют форму и цвет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690110
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690110,
					"content": "Они не вянут, но становятся абсолютно непохожими на свежие. Такие цветы никто не покупает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690114,
					"content": "Я уже у многих спросила совета, и Саид... Знаешь его? Он учёный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690115
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690115,
					"content": "Так вот, как-то раз Саид пришёл купить цветы и поделился, что в одной из книг прочитал про хранение цветов в холоде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690116
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690116,
					"content": "А именно... Нужно поместить цветы в подходящий контейнер, а уже потом класть на лёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690117
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690117,
					"content": "Он сказал, что для проверки этого способа ввиду своей низкой температуры подошёл бы Драконий хребет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690118
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690118,
					"content": "Но я слышала, что в горах очень опасно. Никто из искателей приключений не спешит мне помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690119
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690119,
					"content": "#{NICKNAME}, поможешь мне закопать эти коробки с цветами в снегах Драконьего хребта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690120,
						200690121
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690120,
					"content": "Помогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690122,
					"content": "#Спасибо, что согласил{F#ась}{M#ся} помочь. Дай подумать... Я слышала, что эта гора просто огромна, и эффект от хранения в разных местах может отличаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690123
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690123,
					"content": "Может быть, стоит попробовать разные места и сравнить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690124
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690124,
					"content": "Пожалуйста, закопай по коробке у <color=#00E1FFFF>статуи семи Архонтов</color>, у <color=#00E1FFFF>водоёма в горах</color> и, пожалуй, у <color=#00E1FFFF>входа в пещеру</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690121,
					"content": "Где именно их закопать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690111,
					"content": "Поэтому остаётся только продавать их в тот же день.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690112
					]
				},
				{
					"id": 200690112,
					"content": "Так оно, конечно, лучше, но под вечер всегда остаётся несколько непроданных цветов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690113
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690113,
					"content": "Это немного, но мне так жалко смотреть, как они вянут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Флора"
				}
			]
		},
