			"dialogs": [
				{
					"id": 200690201,
					"content": "Ну, как цветы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690202
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690202,
					"content": "Все закопаны в снег.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690203
					]
				},
				{
					"id": 200690203,
					"content": "Спасибо. Пусть они некоторое время там побудут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690204
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200690204,
					"content": "Хе-хе, большое спасибо тебе за твою помощь. Вот, это тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690205
					],
					"speakerTitle": "Флора"
				}
			]
		},
