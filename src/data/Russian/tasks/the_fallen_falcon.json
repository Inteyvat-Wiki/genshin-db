				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лилупар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820601,
					"content": "Ой... Массейра исчез!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732820602,
					"content": "Он оставил эту записку... Хм, старый лис.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820603
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 732820603,
					"content": "Если вы читаете эту записку, я уже укрылся в безопасном месте в ущелье.\\nЕсли у вас ещё есть голова на плечах, вы не станете сокрушаться о выборе Тадлэ.\\nЭта охота ещё не окончена. Буря только начинается.\\nО том извещает вас Массейра, охотник и старейшина Танита.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820604
					],
					"speakerTitle": "Исследовать"
				},
				{
					"id": 732820604,
					"content": "А? Это он о чём? Паймон не понимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732820605,
					"content": "Похоже, на него серьёзно надавили, и он сбежал из племени, оставив тебе записку. Ха, а эти Таниты не такие миролюбивые, как кажется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лилупар"
				}
			]
		},
		{
			"id": 7328228,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
