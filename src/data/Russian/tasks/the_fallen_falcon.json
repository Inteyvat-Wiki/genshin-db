			"dialogs": [
				{
					"id": 732820201,
					"content": "В руинах на севере, там, где вы встретились в первый раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820202
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732820202,
					"content": "Это её выбор. Надеюсь, вы отнесётесь к нему с уважением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Массейра"
				}
			]
		},
		{
			"id": 7328204,
			"completionStepIds": [
				7328204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328204",
							"2"
						],
						"stepId": 7328204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тадлэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820401,
					"content": "#Ты и правда {M#пришёл}{F#пришла}, я так рада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820402,
						732820403
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732820402,
					"content": "Мне сказали, что ты меня искала.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				},
				{
					"id": 732820404,
					"content": "Мне всегда казалось, что пустыня в это время суток необычайно прекрасна. Мне она так нравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820405
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732820405,
					"content": "Жаль только, что прежде мне не удавалось полюбоваться закатом вместе с друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820406
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732820406,
					"content": "Да... Пустыня вся окрасилась в цвета заката. Так мирно и спокойно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732820407,
					"content": "Но, Тадлэ, неужели ты позвала нас только ради этого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732820408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820409
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732820409,
					"content": "Для племени Танит вы гости, а для соколов - потенциальная добыча. Но я надеюсь, что вам удастся выжить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820410
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732820410,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820411
					]
				},
				{
					"id": 732820411,
					"content": "Поэтому прости...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732820403,
					"content": "Как твои дела?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				}
			]
		},
		{
			"id": 7328206,
			"completionStepIds": [
				7328206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
