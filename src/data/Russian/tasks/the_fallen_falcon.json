				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Массейра"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822901,
					"content": "#А, это вы, {M#уважаемый повелитель}{F#уважаемая повелительница} джиннов. Что привело вас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822902,
						732822906
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732822902,
