				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тадлэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822801,
					"content": "(Тадлэ отводит глаза и нервно клонит голову.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822802,
						732822805
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732822802,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822803
					]
				},
				{
					"id": 732822803,
					"content": "Простите, охота окончилась. Я сокол отца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822804
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732822804,
					"content": "Но... Я в порядке, не волнуйтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732822808,
					"content": "Это как-то чересчур...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822809
					]
				},
				{
					"id": 732822809,
					"content": "Чересчур? Не знаю. Я живу так с детства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732822814,
					"content": "Хотя... ваши с Паймон истории и приключения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822815
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732822815,
					"content": "Хотелось бы мне услышать больше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822816
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732822816,
					"content": "Без проблем! У нас этих историй - завались!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822817,
						732822818
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732822817,
					"content": "Я с радостью.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822819,
					"content": "Пф...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822820
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732822820,
					"content": "Кхе-кхе, ничего, я просто очень обрадовалась. Спасибо тебе... Ой, вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732822818,
					"content": "Я расскажу тебе любую историю, какую только пожелаешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822810,
					"content": "Ты не думала о том, чтобы пожить для себя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822811
					]
				},
				{
					"id": 732822811,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822812
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732822812,
					"content": "...Нет. Я никогда не думала о таком и не надеялась на подобное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822813
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732822813,
					"content": "Пустыня жестока, здесь нет места досужим размышлениям о собственном благе. Моё племя может прожить без меня. Но я без племени не проживу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732822805,
					"content": "Какие у вас отношения с Массейрой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822806
					]
				},
				{
					"id": 732822806,
					"content": "Как я уже говорила, он мой отец, а я его сокол. Я следую его приказам, охочусь для него, рискую жизнью... Ведь он символизирует волю Танита.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822807
					],
					"speakerTitle": "Тадлэ"
				},
				{
					"id": 732822807,
					"content": "Если однажды я не смогу исполнить приказ отца, моя жизнь как сокола закончится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Тадлэ"
				}
			]
		},
		{
			"id": 7328229,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328207",
							"2"
						],
						"stepId": 7328207,
						"stateName": "QUEST_STATE_UNFINISHED"
