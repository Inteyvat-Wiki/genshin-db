					"Массейра"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820101,
					"content": "А, вы здесь! Постойте, боюсь, у меня к вам последняя просьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820102,
						732820104
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732820102,
					"content": "Говори, с чем нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820103
					]
				},
				{
					"id": 732820103,
					"content": "Это Тадлэ. Она хочет поговорить с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732820106,
					"content": "Хм... С чего вдруг такая официальность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732820107,
					"content": "В руинах на севере, там, где вы встретились в первый раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820108,
						732820110
					],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732820108,
					"content": "Что ты сказал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820109
					]
				},
				{
					"id": 732820109,
					"content": "В руинах на севере, там, где вы встретились в первый раз... Не забудьте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732820110,
					"content": "#Я понял{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820111
					]
				},
				{
					"id": 732820111,
					"content": "Будьте добры с ней, прошу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Массейра"
				},
				{
					"id": 732820104,
					"content": "У меня пока другие дела.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820105
					]
				},
				{
					"id": 732820105,
					"content": "Выслушайте меня... Тадлэ хочет поговорить с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "Массейра"
				}
			]
		},
		{
			"id": 7328202,
			"completionStepIds": [],
