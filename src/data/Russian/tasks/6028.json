			"dialogs": [
				{
					"id": 60280201,
					"content": "Здесь... жители Гипербореи общались с Лунами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280202
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60280202,
					"content": "Вечная Луна, Морозная Луна, Радужная Луна... Когда силы Трёх Лун сольются воедино...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280203
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60280203,
					"content": "Лунные врата откроются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280204
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60280204,
					"content": "Гм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280205
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60280205,
					"content": "Светочи расставлены по местам. Остаётся сделать последний шаг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280206
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 60280206,
					"content": "...Наверное, в Нашгороде сейчас самое веселье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280207
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60280207,
					"content": "Да... Жаль, что нам приходится отправлять тебя домой в такое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60280208,
					"content": "Всё хорошо. Это последний багаж, который я беру с собой. Последний и единственный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280209
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60280209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280210
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60280210,
					"content": "Я уже чувствую зов Луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280211
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60280211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280212
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60280212,
					"content": "Этот луч приведёт тебя к дому, Коломбина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280213
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 60280213,
					"content": "Теперь мы наконец сможем молиться настоящей Луне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280214
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60280214,
					"content": "Коломбина.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280215
					]
				},
				{
					"id": 60280215,
					"content": "Да? Я слушаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280216
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60280216,
					"content": "Если сможешь, навещай нас почаще!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280217
					]
				},
				{
					"id": 60280217,
					"content": "Ха... Конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280218
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60280218,
					"content": "А если нет... Помни, что на этой планете у тебя остались друзья, которые скучают по Коломбине.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280219
					]
				},
				{
					"id": 60280219,
					"content": "Да, обязательно. Спасибо за всё, что вы для меня сделали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280220
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60280220,
					"content": "И помните... Ночью или днём, лунный свет соединит нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280221
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60280221,
					"content": "Эх... Ну что... Прощайте, друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				}
			]
		},
