	"talks": [
		{
			"id": 7216802,
			"completionStepIds": [
				7216803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216803",
							"2"
						],
						"stepId": 7216803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сюй Дун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680201,
					"content": "Парвана, неужели нет никакого другого способа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680202
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680202,
					"content": "В моей книге упоминается лишь один способ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680203
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 721680203,
					"content": "Эх, если бы нам путь преграждала всего лишь кучка монстров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680204
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 721680204,
					"content": "Это тот самый цвет сакуры, который вы искали?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680205
					]
				},
				{
					"id": 721680205,
					"content": "Ой! Да, это он! И этот цвет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680206
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680206,
					"content": "Ура! Думаю, теперь мы наконец поедим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680207
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 721680207,
					"content": "#Погоди, ты уже прош{F#ла}{M#ёл} сквозь барьер? Ты использовал{F#а} способ, о котором я тебе говорила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680208
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 721680208,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680209
					]
				},
				{
					"id": 721680209,
					"content": "#Не расскажешь, где ты наш{F#ла}{M#ёл} ветвь Громовой сакуры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680210
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 721680210,
					"content": "#Когда ты коснул{F#ась}{M#ся} ветви, как к тебе прикрепился Электрогранум?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680211
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 721680211,
					"content": "#...Подожди. Извини, пожалуйста, я возьму записную книжку. Итак, ты почувствовал{F#а} что-нибудь, когда к тебе прикрепился Электрогранум? И...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680212
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 721680212,
					"content": "#Парвана, прошу тебя, оставь путешественни{F#цу}{M#ка} в покое хоть на минутку. Он{F#а} только что так нам помог{F#ла}... Думаю, твоё исследование может немножко подождать, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680213
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680213,
					"content": "#Большое тебе спасибо, путешественни{F#ца}{M#к}! Как и договаривались, ты получишь свою плату.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680214
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680214,
					"content": "Но сначала просто останься с нами ненадолго. Думаю, из принесённых тобой цветов сакуры я сумею приготовить блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680215
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680215,
					"content": "Я слышал об особом инадзумском деликатесе, известном как «тэмпура с сакурой». Думаю, сейчас самое время попробовать этот рецепт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680216
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680216,
					"content": "Дай мне немного времени, и я всё приготовлю. Это недолго, так что приходи ко мне через минутку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				}
			]
		},
		{
			"id": 7216803,
			"completionStepIds": [
				7216804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216804",
							"2"
						],
						"stepId": 7216804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сюй Дун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680301,
					"content": "Вот так... и так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680302
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680302,
					"content": "Ты уже закончил?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680303
					]
				},
				{
					"id": 721680303,
					"content": "Подожди ещё минутку... обвалять в муке, обжарить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680304
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680304,
					"content": "И готово! Тэмпура с сакурой - попробуй, пока она не остыла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680305
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680305,
					"content": "Это... Это вкусно! Немного горячо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680306
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 721680306,
					"content": "Сюй Дун, думаю, эту «тэмпуру» надо подавать с особым соусом для макания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680307
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 721680307,
					"content": "С соусом для макания? Должен сказать, я его ещё не готовил. Займусь им в следующий раз, если у нас будет такая возможность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680308
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680308,
					"content": "#Эта порция тэмпуры с сакурой - твоя, путешественни{F#ца}{M#к}. Прими её в знак благодарности за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680309
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680309,
					"content": "И да, ещё я подарю тебе описание рецепта. Только дай мне минутку, чтобы всё записать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680310
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680310,
					"content": "#Попробуй сам{F#а}, если выпадет возможность! Готовка - и правда увлекательное занятие, знаешь ли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680311,
						721680313
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680311,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680312
					]
				},
				{
					"id": 721680312,
					"content": "Не за что!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680314
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680314,
					"content": "Мы проведём некоторое время в Инадзуме, а потом, быть может, отправимся в <color=#00E1FFFF>Каннадзуку</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680316
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680316,
					"content": "Джули говорит, что хочет увидеть дерево Священной сакуры и Великий храм Наруками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680317
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680317,
					"content": "Говорят, весь цвет сакуры с того огромного дерева на этом острове опал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680318
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680318,
					"content": "Интересно, насколько большое дерево, если с него опало столько лепестков...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680319
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680319,
					"content": "Если любопытно, сходи туда и посмотри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680320
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680320,
					"content": "#Ещё раз спасибо за помощь, путешественни{F#ца}{M#к}. Я тоже перекушу. Умираю с голоду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721680313,
					"content": "Куда вы отправитесь дальше?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680314
					]
				}
			]
		},
