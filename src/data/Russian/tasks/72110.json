			"trigger": {
				"objectNames": [
					"Ивакура Кодзо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "И зачем же я оставил додзё и нанялся в проводники к госпоже Кудзё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100102,
					"content": "Янагиха и Окадзаки, а также Мифунэ... зачем они меня оставили...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ивакура Кодзо"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Окадзаки Тораэмон",
					"Янагиха Араси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "...Теперь не хватает только клинка Коина Ивакуры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "Окадзаки Тораэмон"
				},
				{
					"id": 721100202,
					"content": "Хакуэн Митимицу Амэнома, фамильный меч семейства Ивакура? Когда тебя и Кунихико усыновили, а мастер Эйин отвлёкся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "Янагиха Араси"
				},
				{
					"id": 721100203,
					"content": "Нас уже выгнали. Не стоит беспокоить мастера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "Окадзаки Тораэмон"
				},
				{
					"id": 721100204,
					"content": "Окадзаки, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "Янагиха Араси"
				},
				{
					"id": 721100205,
					"content": "Если взвешивать привязанность и праведность, истинный мечник может пойти только по пути праведности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "Янагиха Араси"
				},
				{
					"id": 721100206,
					"content": "И если мастер так сказал, значит, он не хочет нас изгонять, но у него нет другого выбора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "Янагиха Араси"
				},
				{
					"id": 721100207,
					"content": "Конечно, не хочет, но если он уже решил стать мечом сёгуна и принять участие в Охоте на Глаза Бога, он может лишь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "Окадзаки Тораэмон"
				},
				{
					"id": 721100208,
					"content": "Мы можем лишь выбрать наш собственный путь праведности. Ведь настоящий мечник может идти только этим путём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "Янагиха Араси"
				},
				{
					"id": 721100209,
					"content": "Но праведность мастера в итоге обернулась поражением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "Янагиха Араси"
				},
				{
					"id": 721100210,
					"content": "Верно. Мы должны отомстить не только за Кунихико, но и за остальных - в том числе за Коина Ивакуру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "Окадзаки Тораэмон"
				},
				{
					"id": 721100211,
					"content": "Такова праведность изгнанных учеников вроде нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "Окадзаки Тораэмон"
				},
				{
					"id": 721100212,
					"content": "Это тоже, наверное, благословение мастера. С первым противником мы легко справились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "Янагиха Араси"
				},
				{
					"id": 721100213,
					"content": "#Верно. Ты, видимо, {NICKNAME}. Мне доводилось слышать твою историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "Окадзаки Тораэмон"
				},
				{
					"id": 721100214,
					"content": "В мире мечников смыть кровь можно только другой кровью. Полагаю, вы готовы к встрече с Мэнкё Кайдэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Окадзаки Тораэмон"
				}
			]
		},
		{
			"id": 7211003,
			"completionStepIds": [
				7211014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211014",
							"2"
						],
						"stepId": 7211014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ивакура Кодзо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100301,
					"content": "И зачем же я оставил додзё и нанялся в проводники к госпоже Кудзё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100302
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100302,
					"content": "Янагиха и Окадзаки, а также Мифунэ... зачем они меня оставили...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100303
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100303,
					"content": "#Я уже ходил{F#а} к ученикам Ивакуры.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100304
					]
				},
				{
					"id": 721100304,
					"content": "Точно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100305
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100305,
					"content": "Остались ещё люди, которые утверждают, что они из Ивакуры? У них же был такой неумелый мастер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100306
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100306,
					"content": "Я Ивакура Кодзо, местный учитель фехтования. А ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100307
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100307,
					"content": "#Меня зовут {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100308
					]
				},
				{
					"id": 721100308,
					"content": "Мифунэ, Тамба... Тебе довелось их увидеть? А также братьев Окадзаки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100309
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100309,
					"content": "А ещё Катаяму. Они хотели придумать имя для этой дуэли, пока она не началась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100310
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100310,
					"content": "Ибо сказано: «Если суждено мне в будущем стать истинным мастером, все эти дуэли войдут в историю». Ха-ха-ха, ну и чушь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100311
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100311,
					"content": "Точно, а ещё Симада, который начинал в эпоху Эйина и вплоть до эпохи Коина не мог выйти за пределы Сёдэна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100312
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100312,
					"content": "Они не могли сбежать, потому что не могли постичь силу Охоты на Глаза Бога Всемогущего сёгуна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100313
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100313,
					"content": "Я скучаю по старым добрым дням, когда учил их держать меч. Зачем же я оставил додзё и пошёл в армию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100314
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100314,
					"content": "#{NICKNAME}, как ты оцениваешь их умения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100315,
						721100316
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100315,
					"content": "Мне жаль...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				},
				{
					"id": 721100317,
					"content": "В самом деле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100318
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100318,
					"content": "#Итак, {NICKNAME}, кто же твой мастер? Домон? Или Сёсэн? А может быть, и сама Наруками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100319
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100319,
					"content": "#Я больше {M#учился сам}{F#училась сама}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100320
					]
				},
				{
					"id": 721100320,
					"content": "Понятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100321
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100321,
					"content": "Кажется, искусство Ивакуры завяло под моим присмотром. Ни один из моих учеников не смог одолеть мечника-самоучку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100322
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100322,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100323
					]
				},
				{
					"id": 721100323,
					"content": "Вот оно как. Теперь я понял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100324
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100324,
					"content": "#В какой бы школе фехтования ты ни {M#учился}{F#училась}, это не имеет значения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100325
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100325,
					"content": "Кажется, искусство Ивакуры завяло под моим присмотром. Ни один из моих учеников не смог одолеть мечника, который не желает раскрывать название своей школы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100326
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100326,
					"content": "Я просто плохой мастер, мне нельзя преподавать искусство Ивакуры. Я просто мечник, и меня зовут Коин Ивакура.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100327
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100327,
					"content": "Хотя я запомнил ключ к тайной технике меча, всемогущий сёгун забрала мой Глаз Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100328
					],
					"speakerTitle": "Ивакура Кодзо"
				},
				{
					"id": 721100328,
					"content": "... Но если всё дело в мести за моих учеников, которые не смогли смотреть на мою деградацию и встали на путь неблагодарных демонов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100329
					],
