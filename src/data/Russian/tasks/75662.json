			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кинич"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756620101,
					"content": "Курьер сообщил мне, что наш связной по боевой готовности нашёл опытного специалиста по оценке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620102
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 756620102,
					"content": "Оказалось, что это ты. Благоприятный знак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620103
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 756620103,
					"content": "Пф! Как она вообще нашла тебя?! Все вокруг только о поручениях и думают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620104
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 756620104,
					"content": "О, смотри. Новое поручение: заткнуть рот шумному дракону.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620105,
						756620107
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 756620105,
					"content": "#Это я только что опубликовал{F#а}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620106
					]
				},
				{
					"id": 756620106,
					"content": "Ты... Ты... Так вот вы какие? Толпой наброситесь на всемогущего драконьего повелителя... Ну, погодите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 756620109,
					"content": "#Вернёмся к теме, {NICKNAME}. Нам нужна твоя помощь в тестировании этапов. Их сложность и баланс должны быть на должном уровне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620110
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 756620110,
					"content": "Ты это называешь сложностью? Не смеши!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620111
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 756620111,
					"content": "Что такое сложность в твоём понимании? «Пусть наугад выберут себе спутника, а потом упадут с обрыва с завязанными глазами?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620112
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 756620112,
					"content": "И, возможно, у них будет только десятипроцентный шанс получить в спутники юмказавра, а остальные варианты - воплощение лавы или Гео слаймы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620113,
						756620116
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 756620113,
					"content": "Испытание не на жизнь, а на смерть!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620114
					]
				},
				{
					"id": 756620114,
					"content": "#Ты разве не знаешь, что любят делать эти Потомки Крон? Ты достаточно долго {F#общалась}{M#общался} с моим маленьким лакеем, чтобы знать, что я в теме!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620115
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 756620115,
					"content": "Тогда, может, сам продемонстрируешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 756620120,
					"content": "...Такие пустяковые задачи ниже достоинства нашего драконьего величества. А вы делайте, что хотите, ничтожества!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620121
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 756620121,
					"content": "В общем, Ирада предлагает хорошую цену. Надеюсь, тебе понравится как само испытание, так и щедрая награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620122,
						756620123
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 756620122,
					"content": "Жду с нетерпением!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620124,
					"content": "Успехов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кинич"
				},
				{
					"id": 756620123,
					"content": "Даже не сомневайся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620116,
					"content": "Это вряд ли...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620117
					]
				},
				{
					"id": 756620117,
					"content": "Хр! Хр! Вот человек с изысканным вкусом - во всяком случае, лучше твоего!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620118
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 756620118,
					"content": "Но мне всё же хотелось бы, чтобы Ахав послужил примером.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620119
					]
				},
				{
					"id": 756620119,
					"content": "Я поддерживаю это предложение, Ахав. Ты гораздо проворнее любого среднестатистического претендента, не так ли? И достаточно вынослив, чтобы монстр не расплющил тебя одним ударом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 756620107,
					"content": "Ничего страшного, можешь выполнить поручение позже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620108
					]
				},
				{
					"id": 756620108,
					"content": "Пф! Думаешь, эта жалкая лесть означает, что наше драконье величество теперь в долгу перед тобой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "Ахав"
				}
			]
		}
	]
}