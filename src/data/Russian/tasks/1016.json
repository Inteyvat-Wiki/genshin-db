					"Чжун Ли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160301,
					"content": "Нин Гуан... Гань Юй...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160302
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10160302,
					"content": "Интересно, чью сторону вы заняли в эти тёмные времена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				}
			]
		},
		{
			"id": 101610,
			"completionStepIds": [
				101610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101610",
							"2"
						],
						"stepId": 101610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжун Ли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10161001,
					"content": "И после этих слов посланница по имени Гань Юй исчезла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10161002,
					"content": "Но нас пригласила к себе сама Нин Гуан. Паймон не может в это поверить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10161003,
					"content": "#{NICKNAME}! Мы увидим людей, у которых так много денег, что Паймон даже чисел таких не знает! Мы должны соблюдать этикет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161004,
						10161005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10161004,
					"content": "Я всегда соблюдаю этикет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				},
				{
					"id": 10161006,
					"content": "Хе-хе... Немногие удостаиваются приглашения в Нефритовый дворец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161007
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10161007,
					"content": "Отправляйтесь туда немедленно, но не забудьте о Церемонии Вознесения. Когда вы закончите свои дела в Нефритовом дворце, найдите меня на Тростниковых островах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161008
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 10161008,
					"content": "Не переживай, мы не забудем! Увидимся на Тростниковых островах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10161005,
					"content": "Паймон опять что-то задумала...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				}
			]
		}
	]
}