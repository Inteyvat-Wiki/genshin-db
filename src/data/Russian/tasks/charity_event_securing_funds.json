			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Бернхард"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180101,
					"content": "Не проходите мимо, прославленный почётный рыцарь и лучший проводник Тейвата Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180102
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180102,
					"content": "Умоляю, помогите мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180103
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180103,
					"content": "Неужели кто-то Паймон так называет? Паймон уже стала знаменитой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180140,
					"content": "Погоди... А мы уже встречались?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180104,
					"content": "Мы виделись в зале штаба Ордо Фавониус.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180105
					]
				},
				{
					"id": 705180105,
					"content": "Да-да, я Бернхард из Ордо Фавониус, отношусь к отряду поставок под командованием Герты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180106
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180106,
					"content": "По правилам приличия, мне стоило сначала получше подружиться с тобой, а уже потом просить о помощи... Но время на исходе, и у меня нет выбора...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180107
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180107,
					"content": "Прошу тебя, спаси нашу благотворительную ярмарку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180108
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180108,
					"content": "Спасти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180109
					]
				},
				{
					"id": 705180109,
					"content": "Благотворительная ярмарка... Кажется, Джинн упоминала о ней. Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180110,
					"content": "Мы планировали открыть лавку на Празднике вина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180111
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180111,
					"content": "Вся мора, полученная от продажи, должна была пойти детям и старикам, оказавшимся в тяжёлой жизненной ситуации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180112
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180112,
					"content": "Того, кто откроет лавку, определяли с помощью лотереи, и так уж получилось, что выбрали меня. Я не хотел провалить задание, поэтому многих просил о совете, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180113
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180113,
					"content": "Обычно я занимаюсь доставкой и складированием товаров. И я никогда не занимался продажами, не говоря уже об управлении лавкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180114
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180114,
					"content": "Поэтому я прошу вас помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180115,
						705180116
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180115,
					"content": "В этом есть смысл.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				},
				{
					"id": 705180117,
					"content": "Да-да, с нами можешь не стесняться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180118,
					"content": "Ты говоришь, что благотворительная ярмарка направлена на поддержание детей и стариков Мондштадта, а это очень важно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180119,
					"content": "#{NICKNAME} является почётным рыцарем, а я старый друг ордена, так что мы с радостью тебе поможем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180120,
						705180121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180120,
					"content": "Да, поможем, чем сможем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180122,
					"content": "Премного благодарен. Значит, так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180123
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180123,
					"content": "До начала мероприятия нам нужно подготовить <color=#00E1FFFF>винный студень</color>. Это будет базовым капиталом нашей лавки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180124
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180124,
					"content": "Окрестные торговцы вином остро нуждаются в винном сырье. Если мы продадим им сырьё, то мы получим много винного студня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180125
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180125,
					"content": "Кроме того, некоторые иностранные гости во время Праздника вина собираются закупить алкогольные напитки в большом количестве. Поэтому они ищут посредника, который поможет им с этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180126
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180126,
					"content": "Они заинтересованы в долгосрочном сотрудничестве и не скупятся на деньги. К тому же с торговцами вин можно договориться по ценам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180127
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180127,
					"content": "Разница в цене и будет нашей платой за труд. А на эти деньги мы сможем купить винный студень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180128
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180128,
					"content": "То есть нам нужно предоставить виноделам сырьё, а заморским гостям помочь оформить заказ и договориться по ценам, так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180129,
					"content": "Всё не так сложно, как казалось Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180130,
					"content": "Это мы как раз умеем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180131
					]
				},
				{
					"id": 705180131,
					"content": "П-правда? Это просто прекрасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180132
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180132,
					"content": "У меня тут есть один заказ. Господину Шевирму из Сумеру нужно пятьдесят ящиков <color=#00E1FFFF>Праздничного сока</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180133
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180133,
					"content": "Этот напиток можно купить в <color=#00E1FFFF>киоске «Доля ангелов»</color>, владельцем которого является господин <color=#00E1FFFF>Георг</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180134
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180134,
					"content": "Господин Георг - добрая душа, но не стоит пользоваться его добротой. Хорошенько подумайте над ценой прежде, чем предлагать ему сделку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180135
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180135,
					"content": "Я продолжу сооружать лавку. А вы подходите ко мне, когда соберёте достаточное количество винного студня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180136
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180136,
					"content": "А о материалах для лавки не беспокойтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180137
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180137,
					"content": "Я уже связался с поставщиками, так что они отправят товар, как только получат мору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180138
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180138,
					"content": "Хорошо, тогда разделимся! Ты займёшься подготовкой лавки, а сбор средств поручи нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180139,
					"content": "Вы меня так выручили! Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705180121,
					"content": "И что нам нужно делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180116,
					"content": "Ты не можешь быть экспертом во всём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				}
			]
		},
		{
			"id": 7051802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051802",
							"2"
						],
						"stepId": 7051802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Георг"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180201,
					"content": "Привет, Георг! Мы представляем господина Шевирма и хотим заказать пятьдесят ящиков Праздничного сока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180202,
					"content": "А? Господин Шевирм? Он мой старый клиент. И обычно он всегда заказывает одинаковое количество...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180203
					],
					"speakerTitle": "Георг"
				},
				{
					"id": 705180203,
					"content": "Ладно, так какое ваше предложение в этом году?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Георг"
				}
			]
		},
		{
			"id": 7051803,
			"completionStepIds": [
				7051803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051803",
							"2"
						],
						"stepId": 7051803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Барбара"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180301,
					"content": "#{NICKNAME}, Паймон, и вы тут, оказывается!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180302
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180302,
					"content": "Ой! Барбара!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180303,
						705180304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180303,
					"content": "Привет, Барбара.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				},
				{
					"id": 705180305,
					"content": "И вас с праздником!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180306
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180306,
					"content": "Праздник вина - один из самых популярных праздников в Мондштадте. Я очень рада встрече с вами. Надеюсь, вам тут нравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180307
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180307,
					"content": "Кстати, я слышала от Георга, что вы собираете винный студень. Это правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180308
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180308,
					"content": "Мне любопытно, вы помогаете благотворительной ярмарке ордена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180309
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180309,
					"content": "Ага! Ведь мы же сами рыцари Ордо Фавониус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180310,
					"content": "Сейчас лавка ещё не открылась, поэтому ездим туда-сюда и собираем средства!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180311,
					"content": "Мы не знаем, какие проблемы навалятся на нас после открытия лавки, но мы обязательно справимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180312,
					"content": "Какие вы молодцы! Хе-хе, вы непременно добьётесь небывалого успеха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180313
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180313,
					"content": "Спасибо за поддержку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180314
					]
				},
				{
					"id": 705180314,
					"content": "Раньше, когда орден проводил благотворительную ярмарку меньшего масштаба, я всегда помогала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180315
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180315,
					"content": "Обычно я стояла возле лавки и пела песни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180316
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180316,
					"content": "Кстати, и тогда же я познакомилась с бардом Венти! Он ещё предложил мне спеть вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180317
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180317,
					"content": "Играет он просто и изящно, поэтому в начале я только тихо подпевала ему, опасаясь нарушить его ритм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180318
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180318,
					"content": "Но затем я подстроилась под него, и вскоре мы запели в унисон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180319
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180319,
					"content": "В итоге публике это очень понравилось, и товар стал прекрасно продаваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180320
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180320,
					"content": "Оказывается, Барбара пела вместе с бродяжкой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180321,
					"content": "Мне бы хотелось послушать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180322
					]
				},
				{
					"id": 705180322,
					"content": "Но, к сожалению, в этот раз у меня не получилось со временем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180323
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180323,
					"content": "Во время Праздника вина церковь Фавония собирается устроить концерт в очень красивом месте, и мне нужно репетировать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180324,
						705180325
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180324,
					"content": "Ну ладно, ничего страшного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180326,
					"content": "Мы занимаемся такими важными делами, и Паймон уверена, что мы все прекрасно справимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180327,
					"content": "Спасибо вам! Жалко, что я не смогу спеть, но я постараюсь чем-нибудь помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180328
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180328,
					"content": "Давайте я расскажу всем о вашем магазине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180329
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180329,
					"content": "Хм... Может, нарисовать афишу?.. Или раздавать листовки?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180330
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180330,
					"content": "И да, придумать слоган! А что если под ним ещё поставить подпись...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180331
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180331,
					"content": "Или же лучше будет рекламировать вслух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180332
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180332,
					"content": "Ура! Если Барбара поможет с рекламой, о нашей лавке услышат все вокруг!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180333,
						705180334
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180333,
					"content": "Спасибо тебе за помощь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180335,
					"content": "Мне несложно. От ваших слов мне даже неловко стало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180336
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180336,
					"content": "#Ну, я ещё подумаю и поспрашиваю у других, что можно сделать! {NICKNAME}, Паймон, мы ещё увидимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180337
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180337,
					"content": "И да, орден и церковь будут гордиться вами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180338
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 705180338,
					"content": "Ага! Вместе мы справимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180339
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180339,
					"content": "#Теперь Паймон ещё больше хочется помочь! {NICKNAME}, мы должны из кожи вон вылезти, но сделать всё красиво!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705180334,
					"content": "Мы будем благодарны за любую помощь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180325,
					"content": "Мы сами справимся с благотворительной ярмаркой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180304,
					"content": "С Праздником вина.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				}
			]
		},
		{
