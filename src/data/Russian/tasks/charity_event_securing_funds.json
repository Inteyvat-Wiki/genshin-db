			},
			"dialogs": [
				{
					"id": 705182101,
					"content": "Это шутка такая? Это господин Шевирм вам насоветовал? Цена слишком низкая, не шутите так со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Георг"
				}
			]
		},
		{
			"id": 7051822,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
