				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Георг"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182201,
					"content": "Да, в этом году урожай был богатым, и стоимость производства вина упала, но эта цена никуда не годится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Георг"
				}
			]
		},
		{
			"id": 7051823,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Георг"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182301,
					"content": "Уже лучше! Цена почти такая же, как и в предыдущие годы. Я согласен заключить сделку с вами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Георг"
				}
			]
		},
		{
			"id": 7051824,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Георг"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182401,
					"content": "Хм... Цена не слишком подходящая... но это надёжный клиент. Давайте заключим сделку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Георг"
				}
			]
		},
		{
			"id": 7051825,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Георг"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182501,
					"content": "Извините, но я не могу принять такую низкую цену. Если вы хотите купить, то я готов продать вам за свою цену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Георг"
				}
			]
		},
		{
			"id": 7051826,
			"completionStepIds": [
				7051805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051805",
