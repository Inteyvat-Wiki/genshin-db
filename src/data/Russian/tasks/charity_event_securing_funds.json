			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Георг"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182601,
					"content": "Я, как всегда, доставлю товар прямо до порога лавки господина Шевирма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182602
					],
					"speakerTitle": "Георг"
				},
				{
					"id": 705182602,
					"content": "Не беспокойтесь. Просто сохраните квитанцию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182603
					],
					"speakerTitle": "Георг"
				},
				{
					"id": 705182603,
					"content": "Хорошо, мы продолжим сбор средств, ведь нам нужно как можно скорее найти достаточно винного студня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705182604,
					"content": "Бернхард сказал, что мы можем собирать средства любыми методами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705182605,
					"content": "После того как заморские гости разместят заказ, мы получим свою плату за труд, и нам не придётся продавать торговцам сырьё для вина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705182606,
					"content": "Но на всякий случай давай сходим и к другим торговцам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}