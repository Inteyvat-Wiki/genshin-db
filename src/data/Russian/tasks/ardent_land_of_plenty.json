			},
			"dialogs": [
				{
					"id": 150180501,
					"content": "#Паймон зовут Паймон. А это {NICKNAME}. Паймон - {M#его}{F#её} компаньон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180502,
					"content": "#Хорошо. Паймон и {NICKNAME}, какие красивые имена. Я запомню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180503
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180503,
					"content": "Ладно, в путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
