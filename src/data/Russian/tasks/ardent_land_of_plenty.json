						],
						"pointId": 10947
					}
				]
			},
			"dialogs": [
				{
					"id": 150180801,
					"content": "Вот мы и дома. Перед вами Удел Благодатных Земель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180814
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180814,
					"content": "Ого, вот это да! Огромная платформа в виде бычьей головы! Такая красивая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180802,
					"content": "Хе-хе, это Арена эха. Здесь мы проводим все наши соревнования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180803
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180803,
					"content": "Спасибо, что привела нас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180804
					]
				},
				{
					"id": 150180804,
					"content": "Ерунда, не стоит благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180815
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180815,
					"content": "Я бы с удовольствием провела вас по округе, но мне надо домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180816
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180816,
					"content": "Ты вспомнила о важном деле? Когда хиличурлы появились, Паймон заметила, что ты очень взволнована...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180817
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180817,
					"content": "Надеюсь, мы тебя не задержали.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180818
					]
				},
				{
					"id": 150180818,
					"content": "Нет, что вы! Никаких задержек! Но дело и впрямь важное. Поесть после тренировки - вот что важнее всего!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180805
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180805,
					"content": "Голодный человек становится вялым, рассеянным, страдает от головокружений... Ужас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180806
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180806,
					"content": "Мне очень жаль, но я должна немедленно пообедать! И вы тоже поешьте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180807
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180807,
					"content": "Увидимся на Арене эха. До встречи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180808
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180808,
					"content": "Ушла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180809,
					"content": "Удивительный характер: то мягкая и спокойная, то порывистая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180810,
					"content": "Это называется молодость.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180811
					]
				},
				{
					"id": 150180811,
					"content": "#Молодость? Ты чего вдруг заговорил{F#а}, как {M#старичок}{F#старушка}? Мы ведь и сами молоды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180812
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180812,
					"content": "Ладно, давай пока осмотримся? А потом встретимся с ней на Арене эха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180813
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180813,
					"content": "Наверняка оттуда открывается великолепный вид!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}