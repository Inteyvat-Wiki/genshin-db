			"dialogs": [
				{
					"id": 150180101,
					"content": "Интересно... для чего нужна эта деревянная доска?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180107,
					"content": "А это наше спортивное оборудование. Я часто здесь тренируюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180108
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180108,
					"content": "Спортивное оборудование?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180109,
					"content": "Хм, дайте-ка подумать... Пожалуй, вместо объяснений лучше продемонстрировать. Вареса, вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180103
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180103,
					"content": "Мягкая посадка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180104
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180104,
					"content": "Ого! Ты так легко перепрыгнула! Круто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180105,
					"content": "Вовсе нет. Такое под силу многим, только нужна практика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180110
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180110,
					"content": "О! Тебе даже тренироваться не нужно, ты сама летаешь. Мне с тобой не сравниться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180112
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180112,
					"content": "Нет, это совсем не то, но... В чём-то ты права!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
