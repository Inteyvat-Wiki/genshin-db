			"dialogs": [
				{
					"id": 150180301,
					"content": "Привет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180303,
					"content": "Мм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180304
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180304,
					"content": "Заблудились? Вам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180305
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180305,
					"content": "Нет, не совсем... Мы направляемся в Удел Благодатных Земель. Скажи, это верная дорога?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180306,
					"content": "Да! Это моё родное племя. Если хотите, я могу вас проводить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180307
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180307,
					"content": "#Отлично, местный проводник! {NICKNAME}, нам сегодня везёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180308,
					"content": "Но ты вроде была занята...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180309
					]
				},
				{
					"id": 150180309,
					"content": "Проводник... Ха-ха, почему бы и нет? Теперь я буду вашим проводником!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180310
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180310,
					"content": "По пути будет много потрясающих пейзажей. Я могу рассказать вам о них. Они впечатляют всех, кто попадает сюда впервые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180311
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180311,
					"content": "Спасибо за предложение, но подожди... Ты ведь была занята? Тебе не обязательно нас провожать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180312,
					"content": "Не беспокойтесь, я заканчивала тренировку и как раз собиралась домой, так что нам по пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180313
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180313,
					"content": "Кроме того, со мной вы сможете лучше понять местные обычаи и узнаете много нового. А узнавать новое всегда весело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180314
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180314,
					"content": "Главное, чтобы вам было весело. Дядюшка Акатль называет это «искусством гостеприимства».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180315
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180315,
					"content": "Эм... Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180316,
					"content": "Какая она милая и добрая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180317,
					"content": "Да, нам повезло.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180318
					]
				},
				{
					"id": 150180318,
					"content": "Точно! Паймон она очень понравилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180319,
					"content": "Ну что? Если готовы, идёмте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180320
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180320,
					"content": "Ах да! Мы даже не спросили, как тебя зовут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180321,
					"content": "Точно. Меня зовут Вареса. Приятно познакомиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вареса"
				}
			]
		},
