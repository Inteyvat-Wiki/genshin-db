			},
			"dialogs": [
				{
					"id": 150180201,
					"content": "Так ты и есть Вареса! Мы о тебе наслышаны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180202,
					"content": "#Паймон зовут Паймон. А это {NICKNAME}. Паймон - {M#его}{F#её} компаньон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150180203,
					"content": "#Хорошо. Паймон и {NICKNAME}, какие красивые имена. Я запомню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180204
					],
					"speakerTitle": "Вареса"
				},
				{
					"id": 150180204,
					"content": "Ладно, в путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
