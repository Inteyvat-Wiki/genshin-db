					"nextDialogs": [
						700220104
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700220104,
					"content": "Mimi mani ye! Plata yaya ika?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700220105
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700220105,
					"content": "Plata ika odomu! Zido mi! Mi muhe yeye! Mi mita yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700220106
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700220106,
					"content": "Не знаю как, но, кажется, они нашли общий язык.",
