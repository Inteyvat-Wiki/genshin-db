	"talks": [
		{
			"id": 7302301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Шефкет"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230101,
					"content": "#Эй! Охотни{F#ца}{M#к} на кабана с грибами на спине! Подойди, пожалуйста, мне нужно с тобой проконсультироваться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шефкет"
				}
			]
		},
		{
			"id": 7302303,
			"completionStepIds": [
				7302303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302303",
							"2"
						],
						"stepId": 7302303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Шефкет",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230301,
					"content": "Ох, дорогие, простите, что беспокою, но мне нужно с вами кое-что обсудить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230302
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230302,
					"content": "Не могли бы одолжить мне кусочек мяса добытого грибосвина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230303
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230303,
					"content": "Грибосвина? Ты о том кабане с грибами на спине?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730230304,
					"content": "Да-да-да! О кабане с грибами на спине! Этот вид изо дня в день нежится в болотных топях Сумеру. Вот на шерсти у них и остаются споры, из которых вырастают грибы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230305
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230305,
					"content": "Ха-ха! А ещё говорят, будто со временем грибы врастают в их тела. Поэтому мясо у грибосвинов обладает особым грибным ароматом и стоит дороже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230306,
						730230307
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230306,
					"content": "Звучит жутковато.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230308
					]
				},
				{
					"id": 730230308,
					"content": "Ха-ха! Это просто слухи. Но грибосвины могут есть грибы со спин сородичей зимой или когда не могут раздобыть другой еды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230309
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230309,
					"content": "А споры благодаря миграциям грибосвинов очень хорошо распространяются. Это очень выгодный для обеих сторон симбиоз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230310
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230310,
					"content": "Ой, извините! Я, кажется, ещё не представился. Меня зовут Шефкет, а вас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230311
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230311,
					"content": "Паймон зовут Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730230312,
					"content": "#Меня зовут {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230313
					]
				},
				{
					"id": 730230313,
					"content": "#Так, {NICKNAME} и Паймон. Запомнил. Как увидел, что вы ловко охотитесь на грибосвинов, сразу понял, что вы, ребята, выдающиеся личности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230314
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230314,
					"content": "По правде говоря, я тут провожу исследования, касающиеся местной биоты. Вот только... эх, всё никак не получается поймать тех грибосвинов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230315
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230315,
					"content": "Только на шажочек приближусь, как они сразу убегают или же попросту валят меня с ног. Такими темпами у меня копчик отвалится быстрее, чем исследование начнётся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230316
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230316,
					"content": "А тут появились вы, и так легко с ними справились. Вот я и решился у вас спросить, можно ли купить кусочек мяса грибосвина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230317
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230317,
					"content": "Что в нём такого необычного? На вид такое же, как и у обычных кабанов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730230318,
					"content": "Ай, ответ на этот вопрос можно получить только после исследования! Продайте мне немного мяса, и я вас щедро награжу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230319
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230319,
					"content": "(Отдать мясо грибосвина)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230320
					]
				},
				{
					"id": 730230320,
					"content": "Ой, спасибо тебе большое! Теперь я смогу продолжить исследование!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230321
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230321,
					"content": "Значит, ты как раз проводишь исследование, что же ты изучаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730230322,
					"content": "Обычное экологическое исследование. Иногда нужно охотиться на диких животных, чтобы понаблюдать за их ростом и развитием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230323
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230323,
					"content": "Иногда лишь только одна особь помогает проследить развитие целого стада. Удивительное явление.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230324
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230324,
					"content": "Похоже, Шефкет очень любит животных!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730230325,
					"content": "Да, я... я очень их люблю. И потратил множество времени на их изучение. Природа в лесах Сумеру очень увлекательная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230326
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230326,
					"content": "Итак, мясо грибосвина у меня есть. Теперь на очереди сумеречные птицы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230327
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230327,
					"content": "#{NICKNAME}, вы случайно не встречали сумеречных птиц? Красивых таких. Они ещё часто в <color=#00E1FFFF>чаще Апам</color> обитают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230328
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230328,
					"content": "Это уникальные сумерские птицы. Академия с их помощью даже информацию передаёт. Хотя они способны преодолевать большие расстояния, но ненавидят дождь и прячутся в дождливые дни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230329
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230329,
					"content": "Ладно, я пойду. Надеюсь, мне удастся самому поймать одну сумеречную птичку... Ха-ха, всё же нельзя вечно на других полагаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230330
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230330,
					"content": "#Но если ты соглас{F#на}{M#ен}, тебе... кхе-кхе... следует быть начеку. Я готов купить сумеречных птиц, если ты их поймаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230307,
					"content": "Это немного пугает.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230308
					]
				}
			]
		},
		{
			"id": 7302308,
			"completionStepIds": [
				7302308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302308",
							"2"
						],
						"stepId": 7302308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Шефкет"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230801,
					"content": "Ой, ты же тот исследователь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730230802,
					"content": "Что ещё за «исследователь»? Ха-ха, меня зовут Шефкет. Мы же раньше встречались, разве нет? Вы мне ещё мясо грибосвина продали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230803,
						730230805
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230803,
					"content": "Да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230804
					]
				},
				{
					"id": 730230804,
					"content": "Ага! И заплатил он нам намного больше, чем обычно платят за мясо простых кабанов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230807
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730230807,
					"content": "Кстати, а что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230808
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730230808,
					"content": "Ха-ха-ха! Стыдно признаться, но я здесь до сих пор пытаюсь продолжить своё исследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230809
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230809,
					"content": "Мне нужна сумеречная птица, но я пока ни одной не смог поймать... Моё исследование под угрозой. Птица-то ладно, но хуже того...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230810
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230810,
					"content": "Хуже того?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230811
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730230811,
					"content": "Но хуже того - я натолкнулся на Пустынников. Эти ребята, не сказав ни слова, сразу же наставили на меня своё оружие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230812
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230812,
					"content": "Вот как. Значит, в тот раз они нас с тобой перепутали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230813
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730230813,
					"content": "Что? Правда? Ха-ха! Это, наверное, потому что... точно, потому что они не понимают, что я пытаюсь защитить сумеречных птиц.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230814
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230814,
					"content": "Эх... Пустынники считают, что живущие в лесу сумеречные птицы - их собственность. Поэтому они так враждебно и отреагировали, когда я попытался собрать образцы для исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230815
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230815,
					"content": "Всё же, перья сумеречных птиц - очень дорогой товар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230816
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230816,
					"content": "Кстати, вы знали, что у сумеречных птиц такое красивое оперение для того, чтобы прятаться в лесной чаще?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230817
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230817,
					"content": "Вот люди и охотятся за их роскошными перьями. Это очень грустно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230818
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230818,
					"content": "Как их жаль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230819
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730230819,
					"content": "Мне не хватает смелости, чтобы противостоять Пустынникам, как это делаешь ты... Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230820
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230820,
					"content": "Кстати, если вы вдруг смогли заполучить перо сумеречной птицы, может, продадите мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230821
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230821,
					"content": "Я заплачу вам так же хорошо, как в прошлый раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230822
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230822,
					"content": "(Отдать перо сумеречной птицы)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230823
					]
				},
				{
					"id": 730230823,
					"content": "Ха-ха! Теперь у меня и перо сумеречной птицы есть! Ну вот, большая часть исследования уже завершена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230824
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230824,
					"content": "Вот только это перо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230825
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230825,
					"content": "Что такое? Неужели с ним что-то не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230826
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730230826,
					"content": "Нет-нет, с ним всё хорошо. Просто выглядит плоховато... Т-то есть, судя по вот этой области на пере, с развитием сумеречных птиц дела обстоят плоховато.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230827
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230827,
					"content": "Надо бы собрать по перу в разных местах. Только так получится отследить, что случилось с их популяцией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230828
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230828,
					"content": "Говорят, что <color=#00E1FFFF>на севере от чащи Апам</color> как раз обитает множество стаек сумеречных птиц. Наверно, стоит поискать там...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230829
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230829,
					"content": "#Похоже, мне снова пора в путь! До встречи, {NICKNAME}, Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730230805,
					"content": "Кажется, такое и правда было.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230806
					]
				},
				{
					"id": 730230806,
					"content": "Агась, Паймон вспомнила! Это любитель животных, Шефкет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230807
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7302312,
			"completionStepIds": [
				7302312
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302312",
							"2"
						],
						"stepId": 7302312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Орхан",
					"Паймон",
					"Памук"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231201,
					"content": "Хватит! Перестаньте! Почему вы опять охотитесь на сумеречных птиц?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231202
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231202,
					"content": "Ах, ну конечно же! Вы же и есть те браконьеры, что всё это время творили бесчинства! И вот опять охотитесь на моих сумеречных птиц!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231203
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231203,
					"content": "А чего это они твои? Ты что, их сам растил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231204,
					"content": "Вовсе нет, но это мои сумеречные птицы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231205
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231205,
					"content": "Я отвечаю за их охрану!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231206
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231206,
					"content": "Отвечаешь за их охрану?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231207,
					"content": "Да, меня зовут Орхан. По приказу Бригады тридцати я стерегу место обитания сумеречных птиц от атак браконьеров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231208
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231208,
					"content": "Не верите? Тогда взгляните на этот письменный приказ, который подписал сам шериф.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231209
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231209,
					"content": "Орхан показал приказ. Он и правда подписан Бригадой тридцати.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231210
					]
				},
				{
					"id": 730231210,
					"content": "Но ведь нам сказали... что нужно поймать сумеречных птиц для проведения экологического исследования?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231211,
					"content": "Ну и где вы такие исследования видали, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231212
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231212,
					"content": "Неужели Шефкет нас обманул?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231213,
					"content": "Шефкет... опять этот Шефкет. Ох, великий Дендро Архонт! Да этот бандюга вас надурил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231214
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231214,
					"content": "Он частенько переодевается в лесного дозорного и обманывает людей. А на деле это мерзавец, что работает с Похитителями сокровищ! Они вместе перепродают материалы, полученные от редких животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231215
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231215,
					"content": "Как же так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231216,
						730231217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231216,
					"content": "Придётся признать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231218
					]
				},
				{
					"id": 730231218,
					"content": "Вы не первые, кто попался на его удочку. Он постоянно подстрекает искателей приключений, а сам прячется за их спинами. Вёрткий, как угорь, и не поймаешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231219
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231219,
					"content": "#Что же нам делать, {NICKNAME}? Мы ведь охотились на сумеречных птиц...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231220,
						730231223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231220,
					"content": "Молись, чтобы в тюрьме хорошо кормили.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231221
					]
				},
				{
					"id": 730231221,
					"content": "О нет! Паймон не хочет, чтобы Бригада тридцати засадила её за решётку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231222,
					"content": "Всё не так страшно. К счастью, популяция сумеречных птиц пока что многочисленна, они не так редки. Да и вы ничего не знали, так что сильно вас не накажут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231228
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231228,
					"content": "Вот оно как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231229,
					"content": "«Однако никакое преступление не должно оставаться безнаказанным»... хотел сказать я, но, кхм-кхм, у меня появилась идея. Вы можете искупить свою вину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231230
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231230,
					"content": "Искупить вину?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231231,
					"content": "Да. Не знаю почему, но Шефкету сейчас очень нужны перья сумеречных птиц. Мы можем завлечь его в ловушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231232
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231232,
					"content": "Например, пустим слух: «На горе <color=#00E1FFFF>в восточной части чащи Апам</color> находится самое крупное место обитания сумеречных птиц». Он непременно клюнет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231233
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231233,
					"content": "Но он тот ещё хитрый жук. Одно неловкое движение, и мы его спугнём. Именно поэтому вы нам и нужны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231234
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231234,
					"content": "#Хм... мне послышалось, что золотоволос{M#ого}{F#ую} зовут {NICKNAME}, а эту летунью...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231235
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231235,
					"content": "Паймон - это Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231236
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231236,
					"content": "#Понял. {NICKNAME} и Паймон, мне понадобится ваша помощь. Вы должны вступить с Шефкетом в контакт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231237
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231237,
					"content": "Поняла! Завидев нас, он немного ослабит свою бдительность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231238,
					"content": "Именно так. Мы подготовим засаду, а вам остаётся только привести его к нам прямо в руки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231239
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231239,
					"content": "Как увидите его... Громко кричите: «Мы знаем обо всём, что ты сделал». Это будет нашим паролем. Услышав, мы сразу выскочим и поймаем его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231240
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231240,
					"content": "Ну, как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231241
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231241,
					"content": "Без проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231242
					]
				},
				{
					"id": 730231242,
					"content": "Сказано - сделано. Пора пускать слух. Я отправлюсь в город Сумеру. Ферит, на тебе Гандхарва. Надо проверить, нет ли и там кого-нибудь, кто состоит в сговоре с Похитителями сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231243
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231243,
					"content": "Памук - деревня Вимара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231244
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231244,
					"content": "Есть, шеф! Не волнуйтесь, я распространю дезинформацию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231245
					],
					"speakerTitle": "Памук"
				},
				{
					"id": 730231245,
					"content": "Отлично. На этот раз мерзавец-браконьер ответит за всё содеянное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231246
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231246,
					"content": "#Я рассчитываю на тебя, {NICKNAME}. Мы обязательно должны заманить его в ловушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231223,
					"content": "Ещё не поздно бежать из Сумеру?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231224
					]
				},
				{
					"id": 730231224,
					"content": "Ничего не поделать. К тем необследованным областям придётся вернуться в другой раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231225,
					"content": "Вы думаете, я буду стоять и смотреть, как два преступника убегают у меня из-под носа? К тому же из-за участившихся случаев браконьерства вокруг полно людей Бригады тридцати.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231226
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231226,
					"content": "О нет! Паймон не хочет, чтобы Бригада тридцати засадила её за решётку!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231227
					]
				},
				{
					"id": 730231227,
					"content": "Не волнуйся. К счастью, популяция сумеречных птиц пока что многочисленна, они не так редки. Да и вы ничего не знали, так что сильно вас не накажут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231228
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231217,
					"content": "...что меня обманули.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231218
					]
				}
			]
		},
		{
			"id": 7302314,
			"completionStepIds": [
				7302314
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302314",
							"2"
						],
						"stepId": 7302314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Шефкет",
					"Паймон",
					"Орхан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231401,
					"content": "#О, это же {NICKNAME} и Паймон. Вы тоже слышали, что здесь полно сумеречных птиц, вот и пришли, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231402
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231402,
					"content": "Это довольно непривычная для них обстановка. И почему же они вдруг решили здесь примоститься?.. Этот вопрос определённо стоит изучить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231403
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231403,
					"content": "Шефкет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231404,
					"content": "Ха-ха, что такое? Точно, хотите узнать, нужны ли мне ещё перья сумеречных птиц? Конечно! Они же такие ценные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231405
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231405,
					"content": "«Мы знаем обо всём, что ты сделал»!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231406
					]
				},
				{
					"id": 730231406,
					"content": "?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231407
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231407,
					"content": "Вы чего это? Что-то не так? Устали помогать мне в моём исследовании?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231408
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231408,
					"content": "#(Что такое?! Где же Пустынники? Мы же с Орханом договаривались! {NICKNAME}, давай я попробую.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231409,
					"content": "«Мы знаем обо всём, что ты сделал»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231410,
					"content": "И Паймон туда же? Ох, ну что ж поделать. Такая уж у меня работа, и вы мне очень помогли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231411
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231411,
					"content": "Да, исследование - дело трудное. Но ведь это всё не зря. Всё ради обитателей леса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231412
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231412,
					"content": "Вовсе не ради обитателей леса, а ради твоего собственного кармана!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231413,
					"content": "Мы знаем обо всём, что ты сделал!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231414
					]
				},
				{
					"id": 730231414,
					"content": "Только вы крикнули, как из чащи не спеша вышел Орхан...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231415
					]
				},
				{
					"id": 730231415,
					"content": "Ну что, Шефкет. Бригада тридцати официально арестовывает тебя за незаконное ношение формы Лесного дозора, склонение искателей приключений к браконьерству, сотрудничество с Похитителями сокровищ и прочие преступления. Под стражу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231416
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231416,
					"content": "Что? Орхан, где ты был! Мы же только что во всё горло кричали пароль, а ты и не слышал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231417,
					"content": "Насчёт этого... произошёл непредвиденный случай...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231418
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231418,
					"content": "Откуда здесь Пустынники? Какой ещё пароль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231419
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231419,
					"content": "«Мы знаем обо всём, что ты сделал» - так вот что это значило. А я ведь успел расчувствоваться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231420
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231420,
					"content": "Лжец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231421,
					"content": "Сдавайся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231422
					]
				},
				{
					"id": 730231422,
					"content": "А, я понял. Вы сговорились с Пустынниками... Пф! И слух об этом месте тоже вы пустили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231423
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231423,
					"content": "Ну вот ты и попался, Шефкет. Рыбак сам же попался на удочку, ха! Бригада тридцати о тебе хорошо позаботится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231424
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231424,
					"content": "Эх... Раз так, спорить без толку. Я люблю животных Сумеру, но иногда в одной любви нет никакого толку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231425
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231425,
					"content": "Мне не удалось попасть в Академию. Изо дня в день я пытался проводить какие-то непутёвые исследования. Для окружающих я превратился в странного чудака, бесцельно блуждающего по лесу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231426
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231426,
					"content": "Мне нужна была мора. Не только для исследований, но и для того, что заткнуть рты всем, кто болтал у меня за спиной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231427
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231427,
					"content": "И ты начал использовать животных, о которых знаешь больше всего? Эх, из-за этого ты нанёс фауне огромный ущерб! Это тяжкое преступление!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231428
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231428,
					"content": "У меня не было выбора...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231429
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231429,
					"content": "Твои лживые речи со мной не прокатят! Я не собираюсь верить в твои байки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231430
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231430,
					"content": "Обманщик наконец-то попал в руки правосудия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231431,
					"content": "Кстати, Орхан, ты чего раньше не появился-то?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231432
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231432,
					"content": "А, ты об этом... Ферит и Памук всё никак не возвращались. Найти их у меня тоже не получалось. И, взвесив все за и против, я решил отправиться сюда в одиночку, ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231433
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231433,
					"content": "Но ведь я появился в самый подходящий момент. Тютелька в тютельку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231434,
						730231435
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231434,
					"content": "Звучит сомнительно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231436
					]
				},
				{
					"id": 730231436,
					"content": "Хм-хм, как же так? Я думал, здесь целый отряд Пустынников собрался. А оказалось, только один человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231437
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231437,
					"content": "Сначала я хотел прикинуться арестованным и выждать удобный момент для побега, но... вижу для этого даже нет необходимости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231438
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231438,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231439
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231439,
					"content": "Что? Неужели думали, что вы с... этим жалким Пустынником сможете меня поймать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231440
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231440,
					"content": "Вот и не повезло же вам. Сегодня как раз день, когда мы с Похитителями сокровищ условились передать товар. Они здесь, затаились неподалёку. Так что не только вы можете позвать на помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231441
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231441,
					"content": "А ну, разберитесь с ними!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231435,
					"content": "Ещё немного, и от тебя бы уже не было толку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231436
					]
				}
			]
		},
		{
			"id": 7302316,
			"completionStepIds": [
				7302316
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302316",
							"2"
						],
						"stepId": 7302316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ферит",
					"Памук",
					"Паймон",
					"Орхан",
					"Шефкет"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231601,
					"content": "Вы с лёгкостью расправляетесь с Похитителями сокровищ.\\nФерит и Памук тоже подоспели.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231602
					]
				},
				{
					"id": 730231602,
					"content": "Шеф!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231603
					],
					"speakerTitle": "Ферит"
				},
				{
					"id": 730231603,
					"content": "Извините, мы немного опоздали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231604
					],
					"speakerTitle": "Памук"
				},
				{
					"id": 730231604,
					"content": "И это ты называешь «немного»?! Да тут уже всё закончилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231605,
					"content": "О-ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231606
					],
					"speakerTitle": "Ферит"
				},
				{
					"id": 730231606,
					"content": "Вы где шлялись?! Весь Сумеру из-за вас с ног до головы перевернул! Эй, это что ещё за алкогольный запашок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231607
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231607,
					"content": "Хе-хе, лучший способ распространять дезинформацию - прикинуться пьяным!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231608
					],
					"speakerTitle": "Ферит"
				},
				{
					"id": 730231608,
					"content": "А потом опять распространять слухи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231609
					],
					"speakerTitle": "Памук"
				},
				{
					"id": 730231609,
					"content": "Но вы не притворяетесь, вы и правда пьяны...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231610
					]
				},
				{
					"id": 730231610,
					"content": "#Эх вы... Если бы не {NICKNAME}, эти Похитители сокровищ меня бы тут так отметелили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231611
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231611,
					"content": "#Но, к моему удивлению, {F#она}{M#он} их всех в два счёта повалил{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231612
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231612,
					"content": "#Ну конечно, ведь {NICKNAME} - великолепный боец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231613,
					"content": "Ну да, вы легко меня остановили, когда я хотел вас задержать. Но это... я себе такого даже представить не мог.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231614,
						730231615
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231614,
					"content": "Ты мне льстишь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231616
					]
				},
				{
					"id": 730231616,
					"content": "#Ну что, Шефкет. Мы... вернее, {NICKNAME} одолел{F#а} всех твоих дружков. Ещё есть что сказать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231617
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231617,
					"content": "Я-я... на самом деле... я занимаюсь браконьерством из-за полученной в детстве психологической травмы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231618
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231618,
					"content": "Послушайте... когда я был ещё мальчишкой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231619,
						730231620
					],
					"speakerTitle": "Шефкет"
				},
				{
					"id": 730231619,
					"content": "Да кому это интересно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231621
					]
				},
				{
					"id": 730231621,
					"content": "Ладно, хватайте его. Мы прощаем вам охоту на сумеречных птиц. В следующий раз хорошенько подумайте, кому стоит доверять, а кому нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231622
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231622,
					"content": "Если бы вы меня тогда выслушали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231623
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231623,
					"content": "Чего?! Да ты же сразу в драку полез!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231624
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231624,
					"content": "И то верно... Я просто разволновался, вот и... эх, в следующий раз нужно сохранять хладнокровие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231625
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231625,
					"content": "Но надеюсь, следующего раза не будет. И вы впредь будьте осторожны. Не верьте всему на слово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231626
					],
					"speakerTitle": "Орхан"
				},
				{
					"id": 730231626,
					"content": "Хорошо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231627
					]
				},
				{
					"id": 730231627,
					"content": "Мы запомним твой совет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231628
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730231628,
					"content": "Орхан увёл Шефкета прочь...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730231620,
					"content": "Хватит выдумывать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231621
					]
				},
				{
					"id": 730231615,
					"content": "Ещё одно слово, и я загоржусь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231616
					]
				}
			]
		},
