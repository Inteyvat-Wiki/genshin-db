			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ранджит"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746820101,
					"content": "Наконец-то мы здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820102
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820102,
					"content": "А как же твоя детская мечта?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820103
					]
				},
				{
					"id": 746820103,
					"content": "Повзрослев, я понял, почему лесные стражи смотрели на меня так озадаченно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820104
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820104,
					"content": "Кхе, как бы там ни было, я старался изо всех сил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820105
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820105,
					"content": "Я также узнал, что лучше не держать необработанные плоды Пиро орхидеи рядом с Пернатым плесенником...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820106
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820106,
					"content": "Когда я почувствовал запах гари, было уже поздно, чуть не захлебнулся спорами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820107
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820107,
					"content": "Забываю, что плесенник всё-таки не грибосвин. Совершенно другой вид.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820108
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820108,
					"content": "Верно! Кстати, плесенники - это же грибы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746820109,
					"content": "Да, суп из них получается особенно вкусным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820110
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820110,
					"content": "Ладно, вернёмся к сегодняшнему испытанию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746820111,
					"content": "Я ещё не придумал, что приготовить... О! Точно, ты про «переговоры». Прошу прощения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820112
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820112,
					"content": "Не знаю, слышали ли вы рассказ о двух владыках, инородах Фонтмера. В истории Морского конька тысячелетней жемчужины упоминаются такие слова, как «гордость» и «благородство».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820113
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820113,
					"content": "С другой стороны, Император огня и железа кажется свирепым, могучим, но беспощадным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820114
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820114,
					"content": "Паймон думала, ты подберёшь кого-то сильней, ведь ты хотел захватывающую историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746820115,
					"content": "Император огня и железа сильный бронекраб... А Морской конёк тысячелетней жемчужины - это летающий морской конёк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820116,
						746820118
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820116,
					"content": "А может, летающего морского конька звать пегасом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820117
					]
				},
				{
					"id": 746820117,
					"content": "Тебя действительно волнует этот вопрос?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746820119,
					"content": "Эх, если бы мне удалось оседлать его хотя бы на миг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820120
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820120,
					"content": "Ладно, вижу, ты настроен идти до конца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746820121,
					"content": "Раз мы уже здесь, вернуться ни с чем будет обидно! Если вы готовы, вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820122,
						746820123
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820122,
					"content": "#Я готов{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746820123,
					"content": "Мне некогда. Увидимся позже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820124
					]
				},
				{
					"id": 746820124,
					"content": "Хорошо. Я подожду тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 746820118,
					"content": "Мне без разницы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820119
					]
				}
			]
		}
	]
}