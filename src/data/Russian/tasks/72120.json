	"talks": [
		{
			"id": 7212001,
			"completionStepIds": [
				7212002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212002",
							"2"
						],
						"stepId": 7212002,
						"stateName": "QUEST_STATE_UNFINISHED"
