				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ксавье"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200101,
					"content": "Ха, великолепно! Предыдущие испытания прошли очень хорошо. оникабуто были полностью очищены!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200102
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721200102,
					"content": "Что ж, тогда давай...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200103
					]
				},
				{
					"id": 721200103,
					"content": "Нам осталось лишь утвердить маршрут перемещений - и можем начинать. Однако мы также должны избегать Фатуи... Похоже, нам придётся идти длинным путём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200104
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721200104,
					"content": "Этот приятель довольно громоздок, поэтому лучше всего найти ровную дорогу, чтобы доставить его внутрь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200105
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721200105,
					"content": "#А потому я хочу, чтобы ты {M#вернулся}{F#вернулась} в горн Микагэ. Если ты обнаружишь какие-то разбитые тропы, помоги мне их восстановить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200106
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721200106,
					"content": "Маршрут у меня ещё не готов... но чем больше дорог нам будет доступно, тем лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200107
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721200107,
					"content": "Знаешь, я не эксперт в области дорожного ремонта.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200108
					]
				},
				{
					"id": 721200108,
					"content": "Так тебе и не придётся восстанавливать их до идеального состояния. Просто положи поверх выбоин деревянные доски, чтобы мы могли провезти по ним наше устройство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200109
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721200109,
					"content": "Доски можешь собрать поблизости. Я останусь здесь и попробую повысить надёжность нашего аппарата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				}
			]
		},
		{
			"id": 7212002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
