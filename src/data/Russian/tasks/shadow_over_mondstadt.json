				"points": []
			},
			"dialogs": [
				{
					"id": 3700201,
					"content": "Смотри! Джинн!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3700202,
					"content": "С кем это она разговаривает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3700203,
					"content": "Давай поздороваемся с ней, когда она закончит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3700204,
					"content": "Вот, что мы об этом думаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700205
					],
					"speakerTitle": "Анастасия"
				},
				{
					"id": 3700205,
					"content": "Если вы не можете справиться с драконом, то предоставьте защиту Мондштадта нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700206
					],
					"speakerTitle": "Анастасия"
				},
				{
					"id": 3700206,
					"content": "Мы обладаем достаточными средствами, чтобы справиться с вашим монстром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700207
					],
					"speakerTitle": "Анастасия"
				},
				{
					"id": 3700207,
					"content": "«Монстром»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700208
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700208,
					"content": "Да. Монстром. Что вы хотите сказать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700209
					],
					"speakerTitle": "Анастасия"
				},
				{
					"id": 3700209,
					"content": "На самом деле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700210
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700210,
					"content": "Я ожидала более профессиональный подход от дипломатов из вашей глубокоуважаемой страны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700211
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700211,
					"content": "Вы хотите «избавиться» от одного из Хранителей четырёх ветров Мондштадта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700212
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700212,
					"content": "Это безумие! Рыцари Ордо Фавониус этого не допустят!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700213
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700213,
					"content": "Ха-ха-ха! Не такое уж это и безумие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700214
					],
					"speakerTitle": "Анастасия"
				},
				{
					"id": 3700214,
					"content": "Довольно на сегодня переговоров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700215
					],
					"speakerTitle": "Анастасия"
				},
				{
					"id": 3700215,
					"content": "Как я понимаю, конструктивный обмен мнениями окончен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700216
					],
					"speakerTitle": "Анастасия"
				},
				{
					"id": 3700216,
					"content": "Мы рассмотрим ваши пожелания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700217
					],
					"speakerTitle": "Анастасия"
				},
				{
					"id": 3700217,
					"content": "#{NICKNAME}, ты вернул{F#ась}{M#ся}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700218
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700218,
					"content": "Поток элементов восстановлен. Спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700219
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700219,
					"content": "Нам наконец удалось взять ситуацию под контроль после последней атаки Ужаса Бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700220
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700220,
					"content": "Но настойчивость этой делегации начинает меня беспокоить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700221
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700221,
					"content": "Делегация? Откуда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3700222,
					"content": "Дипломаты из гавани Ли Юэ? Или из Инадзумы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3700223,
					"content": "Из Снежной. Они поклоняются Крио Архонту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700224
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700224,
					"content": "Эти посланники Снежной называют себя Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700225
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700225,
					"content": "Да, у Фатуи громкая репутация.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3700226,
					"content": "Громкая и не очень хорошая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700227
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3700227,
					"content": "Я не думаю, что нам стоит убивать Ужас бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700228
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700228,
					"content": "Кроме того, Крио Архонт, которому поклоняются Фатуи, всегда жаждал силы и власти Анемо Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700229
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700229,
					"content": "Я не верю, что Фатуи хотят бескорыстно помочь Мондштадту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700230
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700230,
					"content": "К слову о силе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700231
					]
				},
				{
					"id": 3700231,
					"content": "Да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700232
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700232,
					"content": "Я хочу кое-что показать рыцарям Ордо Фавониус.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700233
					]
				},
				{
					"id": 3700233,
					"content": "Хм? Давай встретимся в штабе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700234
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700234,
					"content": "О таких вещах лучше говорить в частной обстановке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джинн"
				}
			]
		},
		{
			"id": 37005,
			"completionStepIds": [
				37005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37005",
							"2"
						],
						"stepId": 37005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джинн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3700401,
					"content": "В этом кристалле заточена особая сила... Лиза, ты можешь идентифицировать её?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700402
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700402,
					"content": "Хм. Давай посмотрим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700403
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3700403,
					"content": "Можно заметить, что в этом кристалле есть мутные примеси.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700404
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3700404,
					"content": "Прошу прощения, но для более подробного анализа мне понадобится больше времени. Нужно будет заглянуть в запретный отдел библиотеки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700405
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3700405,
					"content": "Хорошо. Я рассчитываю на тебя, Лиза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700406
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700406,
					"content": "Я дам тебе знать, когда что-нибудь обнаружу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700407
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3700407,
					"content": "Но, честно говоря, в древних текстах очень сложно найти что-то полезное, к тому же... АЙ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700408
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3700408,
					"content": "Это было больно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700409
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3700409,
					"content": "Мутные примеси в кристалле... Как только я приближаюсь к нему, я чувствую острую боль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700410
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3700410,
					"content": "Должно быть, это реакция на Глаз Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700411
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3700411,
					"content": "Примеси в кристалле несовместимы с энергией элементов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700412
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3700413,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700414
					]
				},
				{
					"id": 3700412,
					"content": "#Всё это очень странно. {NICKNAME} тоже надел{M#ён}{F#ена} энергией элементов, но кристалл на не{M#го}{F#ё} так не реагирует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700413
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3700415,
					"content": "Милашка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700416,
					"content": "Хорошо, пусть будет так.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700414,
					"content": "Пусть милашка пока оставит этот кристалл себе. Нам он, безусловно, приносит больше вреда, чем пользы. Физического вреда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700415,
						3700416
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3700417,
					"content": "Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700418
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700418,
					"content": "#Знаешь ли ты, что делает тебя так{M#им}{F#ой} особенн{M#ым}{F#ой}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700419
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700420,
					"content": "Я так и думала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700421
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700421,
					"content": "#В таком случае... {NICKNAME}, у Ордо Фавониус есть к тебе ещё одна просьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700422
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700422,
					"content": "Прими благодарность действующего магистра Ордо Фавониус и титул почётного рыцаря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700423
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700424,
					"content": "Почётный рыцарь... Ордо Фавониус?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700425
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3700426,
					"content": "Мы надеемся, что ты поможешь нам распутать этот клубок тайн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700427
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700427,
					"content": "Хаос, вызванный появлением Ужаса Бури, ставит под угрозу безопасность Мондштадта. А ещё этот странный кристалл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700428
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700428,
					"content": "Да поможет тебе ветер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700429
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3700429,
					"content": "Если я тебе понадоблюсь, ищи меня здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джинн"
				},
				{
					"id": 4820221,
					"content": "Следуй за <color=#00E1FFFF>метками</color> до самого финиша.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Эмбер"
				}
			]
		}
	]
}