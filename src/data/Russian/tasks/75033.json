					"Шуэйони"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750330201,
					"content": "Полетай вместе с моими ребятами! Редко выпадает случай посоревноваться с лучшими наездниками клана Цветочного Пера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330202
					],
					"speakerTitle": "Шуэйони"
				},
				{
					"id": 750330202,
					"content": "Следуйте по трассе за <color=#00E1FFFF>летящим факелом</color>. Выиграет тот, кто первым догонит факел. Так я тренировал своих ребят, когда они были маленькими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330203
					],
					"speakerTitle": "Шуэйони"
				},
				{
					"id": 750330203,
					"content": "<color=#00E1FFFF>Факел летит на воздушном шаре, украшенном алыми перьями</color>, которые олицетворяют ответственность и честь, - качества, присущие каждому воину. Моя работа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330204
					],
					"speakerTitle": "Шуэйони"
				},
				{
					"id": 750330204,
					"content": "Ты сразу его узнаешь. Ну что, попробуешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330205,
						750330207
					],
					"speakerTitle": "Шуэйони"
				},
				{
					"id": 750330205,
					"content": "#Я готов{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330206
					]
				},
				{
					"id": 750330206,
					"content": "Ха-ха, отлично! Тогда пойдём на старт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шуэйони"
				},
				{
					"id": 750330207,
					"content": "Мне нужно приготовиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330208
					]
				},
				{
					"id": 750330208,
					"content": "#Дай знать, когда будешь готов{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шуэйони"
				}
			]
		},
