			"dialogs": [
				{
					"id": 750330801,
					"content": "Ещё одна гонка? Легко! Сейчас вы увидите, на что я способен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330802
					],
					"speakerTitle": "Матага"
				},
				{
					"id": 750330802,
					"content": "Ты так уверен в себе. Давай, Акомитль, нельзя ему проиграть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330803
					],
					"speakerTitle": "Маньойя"
				},
				{
					"id": 750330803,
					"content": "Тебе я согласен проиграть, но только не Матаге!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330804
					],
					"speakerTitle": "Акомитль"
				},
				{
					"id": 750330804,
					"content": "#{NICKNAME}, ты тоже постарайся! Матага всегда вырывается вперёд ближе к концу гонки, не попадайся на его уловки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330805
					],
					"speakerTitle": "Акомитль"
				},
				{
					"id": 750330805,
					"content": "#Когда будешь готов{F#а}, скажи отцу. Полетим все вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Акомитль"
