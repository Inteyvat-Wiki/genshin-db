			"dialogs": [
				{
					"id": 750330501,
					"content": "Ха-ха! Прости, но на этот раз я выиграл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330502
					],
					"speakerTitle": "Матага"
				},
				{
					"id": 750330502,
					"content": "Матага, мелкий ты... Вот всегда ты так! Вырываешься вперёд на середине гонки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330503
					],
					"speakerTitle": "Акомитль"
				},
				{
					"id": 750330503,
					"content": "Хочешь отыграться? Тогда вперёд, догони меня, ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Матага"
