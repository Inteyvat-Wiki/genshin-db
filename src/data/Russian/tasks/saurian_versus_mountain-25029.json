					}
				]
			},
			"dialogs": [
				{
					"id": 250290201,
					"content": "Хороший мальчик! Ты наелся? Появились силы для тренировки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290202
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250290202,
					"content": "Уй, у-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290203
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250290203,
					"content": "Ого, сколько энергии! Хорошо! Сегодня нужно поднажать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290204
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250290204,
					"content": "Постараемся вместе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290206
					]
				},
				{
					"id": 250290206,
					"content": "#Что? Приветствую, {M#братик}{F#сестричка}! Начнём же нашу тренировку по скалолазанию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290207
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250290207,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290208
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250290208,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290209,
						250290212
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250290209,
					"content": "Как идут твои тренировки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290210
					]
				},
				{
					"id": 250290210,
					"content": "Ну... Можно сказать, у нас наблюдается прогресс. В этот раз Тика забрался гораздо выше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290211
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250290211,
					"content": "Просто Тика не очень понимает, как подниматься на гору, и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290216
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250290216,
					"content": "#{M#Братик}{F#Сестричка}, можешь показать нам ещё раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290217,
						250290221
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250290217,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290218
					]
				},
				{
					"id": 250290218,
					"content": "Спасибо! В этот раз я буду внимательно смотреть за твоими движениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290219
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250290219,
					"content": "Тика, ты тоже наблюдай во все глаза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290220
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250290220,
					"content": "Аргх!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250290223,
					"content": "#Эх... Хорошо. Тогда дело за тобой, {M#братец}{F#сестрица}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290224
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250290224,
					"content": "Мы будем наблюдать за тобой у подножия, чтобы рассчитать время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290225
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250290225,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тика"
				},
				{
					"id": 250290221,
					"content": "В этот раз вы должны внимательно наблюдать за моими движениями.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290222
					]
				},
				{
					"id": 250290222,
					"content": "Ещё бы! Мы с Тикой будем наблюдать очень внимательно, чтобы ничего не упустить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250290212,
					"content": "Похоже, он идёт на поправку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290213
					]
				},
				{
					"id": 250290213,
					"content": "Ещё бы! Мама говорит, что я хорошо забочусь о Тике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290214
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250290214,
					"content": "Он уже забирается гораздо выше, чем раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290215
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250290215,
					"content": "Просто Тика не очень понимает, как подниматься на гору, и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290216
					],
					"speakerTitle": "Тлатем"
				}
			]
