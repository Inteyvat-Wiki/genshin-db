					},
					{
						"sceneId": 3,
						"position": [
							2501.867,
							445.247,
							4636.573
						],
						"pointId": 4513
					},
					{
						"sceneId": 3,
						"position": [
							2501.063,
							445.119,
							4637.081
						],
						"pointId": 5959
					}
				]
			},
			"dialogs": [
				{
					"id": 740390601,
					"content": "Ого! Значит, зелье Супер-пупер сила помогло тебе одолеть всех этих монстров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390602,
						740390605
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390602,
					"content": "Да! Зелье Супер-пупер сила дало мне супер-пупер силу!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390603
					]
				},
				{
					"id": 740390603,
					"content": "Как в ужасной рекламе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390604,
					"content": "Ой, спасибо вам! Спасибо! Значит, зелье подействовало! Магистр зельеварения знает своё дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390609,
					"content": "Да, ты права. Ладно, испытание зелья Супер-пупер сила будем считать законченным. Давайте перейдём ко второму зелью под названием Грей-согрей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390610
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390610,
					"content": "Эм... Ты сама придумала все эти названия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390611,
					"content": "Нет, у меня плохая фантазия. Поэтому я доверяю это дело другим, и в итоге получаются вот такие глупые названия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390612
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390612,
					"content": "Ну, почему глупые... Это ведь зелья. Из названия зелья должно быть сразу понятно, какой у него эффект. Разве нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390613,
					"content": "Гм... Впервые слышу подобное рассуждение. Но ты права! Так и должен рассуждать настоящий магистр зельеварения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390614
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390614,
					"content": "#Кхм, ладно, к делу! {NICKNAME}, ты готов{F#а} приступить к испытанию второго зелья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390615
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390615,
					"content": "Конечно, давай начнём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390616
					]
				},
				{
					"id": 740390616,
					"content": "Ох, пахнет ничуть не лучше первого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390617
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390617,
					"content": "В теории зелье Грей-согрей дарит человеку тепло и позволяет не чувствовать холода! Ну, так оно было задумано...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390618
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390618,
					"content": "Вы берёте у Веренаты зелье. Оно пахнет пыльной заплесневелой кожей...\\nЗамешкавшись на мгновение, вы залпом выпиваете зелье. Оно оказывается вполне приятным напитком, вы чувствуете привкус корицы и острые нотки имбиря... Вкус напомнил вам, как уютно трещат дрова в камине в дождливый день.\\nПравда, больше никаких реакций в вашем теле не возникает.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390619
					]
				},
				{
					"id": 740390619,
					"content": "Затем Верената велит вам немного отдохнуть.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740390605,
					"content": "#Я ничего не почувствовал{F#а}. Но оно было сладким на вкус.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390606
					]
				},
				{
					"id": 740390606,
					"content": "А? Но... пахло оно просто ужасно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390607,
					"content": "А? Правда? Неужели я что-то напутала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390608
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390608,
					"content": "Не расстраивайся так... Зато мы знаем, что зелье оказалось не ядовитым. А это уже что-то!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
