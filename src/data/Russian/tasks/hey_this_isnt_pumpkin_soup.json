			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Верената",
					"Паймон"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2515.692,
							415.747,
							4528.094
						],
						"pointId": 4515
					},
					{
						"sceneId": 3,
						"position": [
							2515.588,
							415.68,
							4525.956
						],
						"pointId": 4563
					}
				]
			},
			"dialogs": [
				{
					"id": 740390801,
					"content": "Мы на месте! Здесь я и провожу свои эксперименты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390802
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390802,
					"content": "#Итак, мы собираемся опробовать Зелье истины. Ты готов{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390803
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390803,
					"content": "#Готов{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390804
					]
				},
				{
					"id": 740390804,
					"content": "Ох... Не забывай об осторожности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390805,
					"content": "Вы берёте у Веренаты зелье. Оно источает тошнотворный запах морских водорослей, разлагающихся под палящим солнцем...\\nЗамешкавшись на мгновение, вы залпом выпиваете зелье. На вкус оно оказывается далеко не таким отвратительным. Точнее, у него вообще нет определённого вкуса...\\nБольше никаких реакций в вашем теле не возникает.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390806
					]
				},
				{
					"id": 740390806,
					"content": "Затем Верената велит вам немного отдохнуть. Вы не чувствуете никаких перемен в своём состоянии.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390807
					]
				},
				{
					"id": 740390807,
					"content": "Но вскоре...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390808
					]
				},
				{
					"id": 740390808,
					"content": "Похоже, ничего не изменилось. Фух, можно выдохнуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390809,
					"content": "#Да, но... {NICKNAME} будто замер{F#ла} на секунду. Что случилось? Ты что-то увидел{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390810
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390810,
					"content": "#Я видел{F#а}... половину полупрозрачного корабля?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390811
					]
				},
				{
					"id": 740390811,
					"content": "Правда? Невероятно! Но... э... Можешь описать своё видение подробнее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390812,
						740390815
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390812,
					"content": "#Он был далеко, я почти ничего не рассмотрел{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390813
					]
				},
				{
					"id": 740390813,
					"content": "#Это очень интересно! Но твои слова не могут служить подтверждением действия зелья... Ведь ты мог{F#ла} увидеть какой-нибудь риф или затонувший корабль и принять его за корабль-призрак...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390814
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390814,
					"content": "Так что... Жаль, но эксперимент нельзя считать состоявшимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390818,
					"content": "Спасибо, благодаря вам я смогла собрать очень важные данные! Они пригодятся мне в работе над новыми зельями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390819
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390819,
					"content": "Гм... «Описание выглядит очень знакомо...», так. «Однако необходимо продолжить наблюдения и проверить, увидят ли другие испытуемые схожую картину...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390820
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390820,
					"content": "А? То есть тебе придётся найти других желающих опробовать зелье?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390821
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390821,
					"content": "Да, так и есть. Гм... Если мы хотим доказать, что зелье действительно открывает людям истину, нужно собрать одинаковые свидетельства как минимум двух надёжных очевидцев. Верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390822
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390822,
					"content": "Потому что «истинные» сущности не связаны путами знаний и мышления наблюдателя, их невозможно исказить собственным восприятием... Они существуют и существуют, независимо от нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390823
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390823,
					"content": "Гм... как боги, что живут десятки тысяч лет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390824
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390824,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390825
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390825,
					"content": "Нет. Как белый песок, как кости морских звёзд, как волны, что никогда не устанут набегать на берег... Всё это «истина».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390826
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390826,
					"content": "Но магистр зельеварения говорила, что... сны и воспоминания могут создавать новые «истины». Звучит как-то противоречиво, я плохо понимаю... но изо всех сил пытаюсь понять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390827
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390827,
					"content": "Ого... Какой у нас пошёл непростой разговор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390828
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390828,
					"content": "Ха-ха, тогда давайте сменим тему! Я очень благодарна вам за помощь! Вот, это вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390829
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390829,
					"content": "Гм... И приходите попробовать мои новые зелья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390815,
					"content": "Его как будто рассекло пополам чем-то огромным...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390816
					]
				},
				{
					"id": 740390816,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390817
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390817,
					"content": "#Ой, простите... Я немного... задумалась. Но я записала всё, что ты сказал{F#а}. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Верената"
				}
			]
		},
