					}
				]
			},
			"dialogs": [
				{
					"id": 740390701,
					"content": "#{NICKNAME}, отзовись! Ты в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390702
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390702,
					"content": "Ох... Извини, не знала, что зелье имеет такой побочный эффект...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390703,
						740390710
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390703,
					"content": "Просто зелье как следует меня согрело, и они сбежались на тепло.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390704
					]
				},
				{
					"id": 740390704,
					"content": "А? Да быть не может!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390705,
					"content": "Ой, точно! Водные животные принимают источник тепла за солнце, потому и собираются вокруг. Значит... зелье сработало! Спасибо вам! Огромное спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390706
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390706,
					"content": "Паймон слабо верит такому объяснению...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390707,
					"content": "Водные животные? Но это были Пиро слаймы!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390708
					]
				},
				{
					"id": 740390708,
					"content": "Да?.. Гм, налицо галлюциногенное действие... Так и запишем. Что ж, побочный эффект - тоже эффект. Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390709
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390709,
					"content": "#Но это какой-то плохой эффект! Сегодня {NICKNAME} вместо больших крабов увидел{F#а} Пиро слаймов, а если завтра на {M#него}{F#неё} нападут какие-нибудь опасные монстры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390720,
					"content": "Да... Я перед вами в большом долгу, но есть ещё третье зелье, которое нужно испытать... Эм... Вы готовы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390721,
						740390723
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390721,
					"content": "Если оно не ядовитое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390722
					]
				},
				{
					"id": 740390722,
					"content": "Ну, это мы узнаем потом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390725,
					"content": "Ура, спасибо! Так, у нас осталось... Зелье истины!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390726
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390726,
					"content": "А? Так, подожди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390727
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390727,
					"content": "Первым было зелье Супер-пупер сила, потом Грей-согрей, а теперь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390728
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390728,
					"content": "Зелье истины. Да, оно позволяет увидеть истину, скрытую от глаз... А что не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390729
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390729,
					"content": "Эм, да ничего... Просто название у него совсем не такое, как у предыдущих зелий! Будто поворот на триста шестьдесят градусов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390730,
						740390731
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390730,
					"content": "Поворот на триста шестьдесят градусов приводит тебя в исходную точку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390732,
					"content": "А? Ой... Паймон обсчиталась! Но вы поняли, что Паймон хотела сказать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390733
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390733,
					"content": "Просто первые два названия придумала магистр зельеварения, а третье я назвала сама...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390734
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390734,
					"content": "Я плохо придумываю названия. У госпожи Карабос фантазия работает намного лучше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390735
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390735,
					"content": "Вот оно что... А Паймон думала, всё наоборот. Тебе надо верить в себя! Вообще-то ты придумала отличное название для зелья...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390736
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390736,
					"content": "Ой, спасибо. Но... это зелье отличается от предыдущих, оно может быть опасно... Поэтому прошу вас пройти в мою мастерскую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390737
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390737,
					"content": "Да... Морская среда смягчит действие зелья, и потом, в мастерской у меня есть инструменты, которые помогут справиться с опасностями, так что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390738
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390738,
					"content": "Ой, что там за зелье такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390739
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390739,
					"content": "Давай приступим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390740
					]
				},
				{
					"id": 740390740,
					"content": "Ладно, тогда за мной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390731,
					"content": "Может, на сто восемьдесят?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390723,
					"content": "Теперь отступать уже поздно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390724
					]
				},
				{
					"id": 740390724,
					"content": "Да! Нельзя бросать дело на полпути! Но Паймон всё равно тревожно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390710,
					"content": "Не беспокойся. Пиро слаймы совсем не опасны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390711
					]
				},
				{
					"id": 740390711,
					"content": "Пф, очень даже опасны! Просто ты ещё опаснее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390712,
					"content": "#Эм, подожди... Ты сказал{F#а} «Пиро слаймы»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390713
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390713,
					"content": "Да, точно! Мы видели только стаю большущих крабов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390714,
						740390716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390714,
					"content": "Крабов? Да, у берега всегда полно крабов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390715
					]
				},
				{
					"id": 740390715,
					"content": "#Но ты сейчас {M#вёл}{F#вела} себя очень странно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390716,
					"content": "Но от них шёл настоящий жар. Волны жара...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390717
					]
				},
				{
					"id": 740390717,
					"content": "Ясно... Галлюциногенное действие... Так и запишем. По крайней мере, зелье не пустышка, но... Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390718
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390718,
					"content": "Но я очень рада, что ты в порядке! Просто... Жаль, что зелье снова не сработало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390719
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390719,
					"content": "#Всё хорошо, наоборот... Пусть твоё зелье ужасно пахнет, эксперимент можно считать наполовину успешным! Видишь, {NICKNAME} жив{F#а} и здоров{F#а}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7403908,
			"completionStepIds": [
				7403908
			],
