					},
					{
						"sceneId": 3,
						"position": [
							2501.867,
							445.247,
							4636.573
						],
						"pointId": 4513
					},
					{
						"sceneId": 3,
						"position": [
							2501.063,
							445.119,
							4637.081
						],
						"pointId": 5959
					}
				]
			},
			"dialogs": [
				{
					"id": 740390501,
					"content": "Спасибо! Давайте попробуем первое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390502
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390502,
					"content": "#{NICKNAME}, только не пей слишком много! А если почувствуешь что-то не то, сразу выплюнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390503,
					"content": "Не волнуйся, Паймон. Всё будет хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390504
					]
				},
				{
					"id": 740390504,
					"content": "Хм. Всё равно Паймон за тебя тревожно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740390505,
					"content": "#Я готов{F#а}. Давай мне зелье.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390506
					]
				},
				{
					"id": 740390506,
					"content": "#Это зелье называется Супер-пупер сила, оно сделает тебя {F#суперсильной}{M#суперсильным}! Ну... в теории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390507
					],
					"speakerTitle": "Верената"
				},
				{
					"id": 740390507,
					"content": "Вы берёте у Веренаты зелье и выпиваете его одним глотком.\\nНесмотря на отталкивающий запах, зелье оказывается вполне приятным напитком, сладким и немного вязким.\\nПравда, больше никаких реакций в вашем теле не возникает.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390508
					]
				},
				{
					"id": 740390508,
					"content": "Затем по указанию Веренаты вы ждёте, когда активизируются протогены расщелины.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7403906,
			"completionStepIds": [
				7403904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
