			"dialogs": [
				{
					"id": 711170401,
					"content": "Хм... На каменной табличке написано, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711170402,
					"content": "Если бросить в реку сырое мясо, можно призвать старых друзей, с которыми давно не виделись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170403,
						711170406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711170403,
					"content": "Ты понимаешь, что тут написано?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711170404
					]
				},
				{
					"id": 711170404,
					"content": "Эй, не стоит недооценивать Паймон... Если соединить прочитанное, то наверняка поймёшь, что имеется в виду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711170405,
					"content": "Например, Паймон может прочесть только две последние строки, так что Паймон никак не может ошибиться в том, что они означают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711170408,
					"content": "Ладно, давай кинем сырое мясо в воду. Может, Адепт и вправду появится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711170406,
					"content": "Пожалуй, похоже на то, будто надо бросить еду в память о друге...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711170407
					]
				},
				{
					"id": 711170407,
					"content": "Паймон считает, что Паймон тоже права!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170408
					],
					"speakerTitle": "Паймон"
