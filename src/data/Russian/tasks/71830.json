			"trigger": {
				"objectNames": [
					"Ван Пинъань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "Работа предстоит грандиозная...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300202,
					"content": "Надо же, ты и правда восстанавливаешь храм...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "О, это вы. Разве я не говорил, что изменился и стал добропорядочным гражданином?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300204,
					"content": "Я не ожидал, что проект по восстановлению храма окажется таким масштабным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300205,
					"content": "Дизайнер, которого я пригласил для проектирования нового храма, пришёл в восторг, как только узнал, что это храм Яксы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300206,
					"content": "Он не только скрупулёзно составил тонну чертежей, но и сам потащил меня за материалами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300207,
					"content": "Будь он на несколько десятилетий моложе, держу пари, он бы собственноручно выполнил все строительные работы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300208,
					"content": "Ты больше не попадал в опасные ситуации?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "Опасные ситуации? Наподобие монстров и Похитителей сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300212,
					"content": "Не беспокойтесь. Как только стало известно, что я восстанавливаю храм Яксы, Департамент по делам граждан прислал Миллелитов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300213,
					"content": "Они прогнали всех монстров в округе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300214,
					"content": "Что касается Похитителей сокровищ... Похоже, они залегли на дно в страхе перед миллелитами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300215,
					"content": "Однако объём работ по восстановлению храма превзошёл мои самые смелые ожидания. Нам не хватило материалов, поэтому придётся доставить дополнительные материалы из города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300216,
					"content": "Я сомневаюсь, что Похитителям сокровищ хватит смелости напасть на нас здесь, но они вполне могут устроить засаду на пути сюда и украсть материалы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300217,
					"content": "Миллелиты без труда смогут защитить это место, но вряд ли смогут помочь тем, кто будет доставлять материалы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300218,
					"content": "#{F#Героиня}{M#Герой}, могу ли я просить вас об одолжении?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300219,
					"content": "Я неоднократно был свидетелем ваших способностей и уверен, что никаким Похитителям сокровищ с вами не совладать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300220,
					"content": "Не могли бы вы предпринять превентивные меры и объяснить им, что нас лучше не отвлекать от работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300221,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "Благодарю от всей души!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300223,
					"content": "Почему ты не хочешь попросить о помощи Миллелитов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "Они сутки напролёт нас охраняют и очень устали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300225,
					"content": "#Поэтому, прошу тебя помочь нам, {F#героиня}{M#герой}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300210,
					"content": "Эту местность с трудом можно назвать безопасной...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "Вы имеете в виду, что вокруг полно монстров и Похитителей сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Ван Пинъань"
				}
			]
		},
