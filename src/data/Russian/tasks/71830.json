			"dialogs": [
				{
					"id": 718300301,
					"content": "Осторожнее там! Не повредите статую!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300302
					],
					"speakerTitle": "Ван Пинъань"
				},
				{
					"id": 718300302,
					"content": "Похоже, мы тут надолго задержимся с этим строительством...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ван Пинъань"
				}
			]
		},
		{
			"id": 7183004,
			"completionStepIds": [
				7183004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7183004",
							"2"
						],
						"stepId": 7183004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Главарь Похитителей сокровищ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300401,
					"content": "П-прошу, остановитесь! Пощадите нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "Главарь Похитителей сокровищ"
				},
				{
					"id": 718300402,
					"content": "Забирайте свои вещи и проваливайте!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "Д-да, как скажете...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "Главарь Похитителей сокровищ"
				},
				{
					"id": 718300405,
					"content": "Но... осмелюсь спросить, чем мы вас обидели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "Главарь Похитителей сокровищ"
				},
				{
					"id": 718300406,
					"content": "Или вы нашли сокровище поблизости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "Главарь Похитителей сокровищ"
				},
				{
					"id": 718300407,
					"content": "Мы восстанавливаем храм поблизости.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "Восстанавливаете храм? Откуда взяться храму в этих непроходимых горах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "Главарь Похитителей сокровищ"
				},
				{
					"id": 718300409,
					"content": "Поблизости есть храм Адепта? Постойте, это случайно не та развалюха?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "Главарь Похитителей сокровищ"
				},
				{
					"id": 718300410,
					"content": "Босс, мы видели статую птицы, когда отдыхали там как-то раз. Должно быть, это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "Младший Похититель сокровищ"
				},
				{
					"id": 718300411,
					"content": "Это Якса по имени Бронзовый Воробей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "Главарь Похитителей сокровищ"
				},
				{
					"id": 718300413,
					"content": "Босс! Неужели мы оскорбили Адепта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "Младший Похититель сокровищ"
				},
				{
					"id": 718300414,
					"content": "Хватит нести чушь! Мы не знали об этом, так что это не считается! Мы не специально! Не думаю, что Адепт нас осудит... Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "Главарь Похитителей сокровищ"
				},
				{
					"id": 718300415,
					"content": "Спасибо, что сказали нам о восстановлении храма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "Главарь Похитителей сокровищ"
				},
				{
					"id": 718300416,
					"content": "Мы приносим извинения за наше прежнее невежество...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "Главарь Похитителей сокровищ"
				},
				{
					"id": 718300417,
					"content": "Мы расскажем другим, чтобы они держались подальше от храма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "Главарь Похитителей сокровищ"
				},
				{
					"id": 718300418,
					"content": "Босс, почему бы нам не пойти в храм и не воскурить благовония в качестве извинений перед Адептом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "Младший Похититель сокровищ"
				},
				{
					"id": 718300419,
					"content": "Ишь разошёлся! Пошли, давай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Главарь Похитителей сокровищ"
				},
				{
					"id": 718300403,
					"content": "И даже не смейте приближаться к этому месту.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				}
			]
		},
