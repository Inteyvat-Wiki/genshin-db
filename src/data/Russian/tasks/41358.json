			"dialogs": [
				{
					"id": 413580201,
					"content": "Ну как идёт поиск сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580202
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413580202,
					"content": "#Я уже их все наш{F#ла}{M#ёл}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580203
					]
				},
				{
					"id": 413580203,
					"content": "Все до единого? Да ты... выдающийся охотник за сокровищами! Многие сдаются лишь пару раз повернув фонарь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580204
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413580204,
					"content": "#Раз уж ты отыскал{F#а} все сокровища, вот твоя награда. Весёлого Праздника морских фонарей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Цянь"
				}
			]
		},
