			"dialogs": [
				{
					"id": 401490301,
					"content": "#О, {NICKNAME}! Спасибо за помощь в эти дни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490302
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 401490302,
					"content": "Всегда пожалуйста... Главное, чтобы мне заплатили.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490303
					]
				},
				{
					"id": 401490303,
					"content": "Ха-ха-ха, сразу к делу, да? Вот, возьми. Здесь чуть больше - считай это премией. Упорный труд всегда вознаграждается!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490304
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 401490304,
					"content": "Ура! Усталость и стресс словно испарились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401490305,
					"content": "#Мне очень повезло, что ты проработал{F#а} всего несколько дней. Такими темпами меня бы уволили через пару недель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490306
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 401490306,
					"content": "А я надеюсь ещё много раз насладиться твоими блюдами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490307
					]
				},
				{
					"id": 401490307,
					"content": "Ха-ха, заходи в любое время! В следующий раз приводи с собой друзей, и я покажу, на что способен улыбчивый Янь Сяо, когда у него обе руки в порядке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490308
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 401490308,
					"content": "Отлично! Хотя... на всякий случай готовь с осторожностью! Возможно, ты только что сам себя сглазил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
