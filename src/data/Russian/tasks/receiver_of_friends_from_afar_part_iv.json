				},
				{
					"id": 401499702,
					"content": "В сложившихся условиях я мог готовить только довольно простые блюда... Но все были довольны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499703
					],
					"speakerTitle": "Мика"
				},
				{
					"id": 401499703,
					"content": "Может быть, и тогда «страсть» была секретным ингредиентом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мика"
