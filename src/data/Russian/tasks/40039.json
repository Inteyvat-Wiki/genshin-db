			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кармен"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390801,
					"content": "Эй! Стоять!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390802
					],
					"speakerTitle": "Кармен"
				},
				{
					"id": 400390802,
					"content": "Ослепли, что ли? Не видите, это же капитан Бэй Доу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390803
					],
					"speakerTitle": "Кармен"
				},
				{
					"id": 400390803,
					"content": "Хе-хе... Капитан, давно не виделись. Смотрю, ты всё ещё в хорошей форме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390804
					],
					"speakerTitle": "Кармен"
				},
				{
					"id": 400390804,
					"content": "Кармен, да, давненько мы не встречались. Ты даже успел немного располнеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390805
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400390805,
					"content": "Если так и собираешься прятаться по кустам, то лучше следить за талией. А то скоро помещаться перестанешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390806
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400390806,
					"content": "Смешно, Бэй Доу, очень смешно... Ха-ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390807
					],
					"speakerTitle": "Кармен"
				},
				{
					"id": 400390807,
					"content": "Но если серьёзно, то мне понадобится всё это. Оставь всё мне, и тогда я не причиню вам неприятностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390808
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400390808,
					"content": "Конечно, конечно, как скажешь, капитан... Вы её слышали! Бросайте всё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390809
					],
					"speakerTitle": "Кармен"
				},
				{
					"id": 400390809,
					"content": "Вот, всё здесь. Мы... мы сейчас уйдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390810
					],
					"speakerTitle": "Кармен"
				},
				{
					"id": 400390810,
					"content": "Кармен с Похитителями сокровищ быстро уходят...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400390811
					]
				},
				{
					"id": 400390811,
					"content": "Ого, они сделали всё, что мы сказали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390812
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400390812,
					"content": "Быстро они сдались.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390813
					]
				},
				{
					"id": 400390813,
					"content": "И сбежали тоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390814
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400390814,
					"content": "Не будем больше терять времени. У нас ещё полно работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390815
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400390815,
					"content": "#Но сначала придётся загрузить всё это на лодку... {NICKNAME}, помоги мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бэй Доу"
				}
			]
		},
		{
			"id": 4003911,
			"completionStepIds": [
				4003911
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003911",
							"2"
