			},
			"dialogs": [
				{
					"id": 400391401,
					"content": "Они так быстро сбежали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400391402,
					"content": "Да какая разница. Они мало что успели взять с собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391403
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400391403,
					"content": "Главная проблема в том, что всё это точно не поместится в твоей лодочке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391404
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400391404,
					"content": "Хм... Ладно, вот, как мы поступим. Разгрузи лодку и сложи всё здесь, в одном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391405
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400391405,
					"content": "По плану здесь должен проходить Хай Лун. Когда они доберутся сюда, мы поднимемся на борт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391406
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400391406,
					"content": "А ты, пожалуйста, вернись в Нефритовый дворец и передай моё послание Нин Гуан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391407
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400391407,
					"content": "Скажи ей... Что мы почти закончили с рыбалкой, так что пусть начинает готовить мою награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391408
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400391408,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400391409
					]
				},
				{
					"id": 400391409,
					"content": "#Спасибо, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391410
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400391410,
					"content": "Если здесь были и Кармен, и Лю Лю... Возможно, где-то поблизости шныряет и Начальница?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391411
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400391411,
					"content": "Нужно передать Хай Луну, чтобы вся команда сохраняла бдительность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бэй Доу"
				}
			]
		},
