			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лю Лю"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400391101,
					"content": "Ну же, быстрее! Бросайте хлам, берите только ценное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391102
					],
					"speakerTitle": "Лю Лю"
				},
				{
					"id": 400391102,
					"content": "А ещё кто-нибудь должен загрузить всё в лодку, быстрее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391103
					],
					"speakerTitle": "Лю Лю"
				},
				{
					"id": 400391103,
					"content": "Что бы вы ни собирались делать - не стоит. И что бы ни было у вас в руках - теперь моё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391104
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400391104,
					"content": "Б-бэй Доу?! Что вы здесь делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391105
					],
					"speakerTitle": "Лю Лю"
				},
				{
					"id": 400391105,
					"content": "Могу задать тебе тот же вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391106
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400391106,
					"content": "А на что похоже? Нам повезло, ясно? Нашли драгоценности плавающими посреди океана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391107
					],
					"speakerTitle": "Лю Лю"
				},
				{
					"id": 400391107,
					"content": "Вы можете забрать всё, что вам приглянется! В знак нашего уважения к вам! Ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391108
					],
					"speakerTitle": "Лю Лю"
				},
				{
					"id": 400391108,
					"content": "Да? Ну и здорово. Я возьму всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391109
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400391109,
					"content": "Но... я... Да ладно, зачем же вы так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391110
					],
					"speakerTitle": "Лю Лю"
				},
				{
					"id": 400391110,
					"content": "С нас семь потов сошло, пока мы всё это собирали... Вы же оставите нам хоть что-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391111
					],
					"speakerTitle": "Лю Лю"
				},
				{
					"id": 400391111,
					"content": "Позволь кое-что объяснить: эти вещи вам не принадлежат и никогда принадлежать не будут. Так что ты положишь их, а потом уберешься отсюда так далеко, насколько это физически возможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391112
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400391112,
					"content": "Это... Может, начнём с чистого листа? Мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391113
					],
					"speakerTitle": "Лю Лю"
				},
				{
					"id": 400391113,
					"content": "Ха... Кажется, ты тянешь время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391114
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 400391114,
					"content": "Хватит пустой болтовни. Решим всё по-старому!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бэй Доу"
				}
			]
		},
		{
