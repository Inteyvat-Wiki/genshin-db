					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кудзё Камадзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180506,
					"content": "Всемогущий сёгун!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180507
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180507,
					"content": "С-сёгун, как вы здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180508
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180508,
					"content": "Наследник клана Такацукаса, объясни, что здесь происходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180509
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180509,
					"content": "Мы просто обсуждали мелочи, недавно случившиеся в комиссии Тэнрё. Всемогущему сёгуну не о чем беспокоиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180510
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180510,
					"content": "Значит, необходимость встречаться в таком уединённом месте с охраной из ронинов и кайраги возникла тоже из-за этих мелочей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180511
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180511,
					"content": "Ну, последнее время было неспокойно. Всё это из соображений безопасности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180512
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180512,
					"content": "Молчать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180513
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180513,
					"content": "Слово тебе, наследник клана Кудзё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180514
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180514,
					"content": "Хорошо. Я пришёл сюда с целью переговоров, а оказалось, что им нужно было лишь письменное признание клана Кудзё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180515
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180515,
					"content": "Письменное признание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180516
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180516,
					"content": "Да. Признание всех преступлений, сотворённых кланом Кудзё от начала Охоты на Глаза Бога, включая недавние проступки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180517
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180517,
					"content": "Всё согласно фактам. Ни капли лжи или вымысла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180518
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180518,
					"content": "Не отрицаю. Но также в нём подчёркнуты достижения клана Такацукаса, который якобы в опасное время не растерялся и делал всё, чтобы спасти положение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180519
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180519,
					"content": "Всё это небылицы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180520
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180520,
					"content": "Ах ты двуличный... Сначала говоришь одно, а потом другое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180521
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180521,
					"content": "Говорю как есть. Уверен, всемогущий сёгун рассудит справедливо. Клан Такацукаса всего-навсего пытается выглядеть хорошо, чтобы занять место клана Кудзё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180522
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180522,
					"content": "Зачем ещё ты в письменном признании искажаешь истину и выставляешь свой клан в выгодном свете, вынуждая меня подписывать его под угрозой заточения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180523
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180523,
					"content": "Что ты такое говоришь? Никто тебя здесь не держит! Мы просто ведём переговоры! Ты лжёшь!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180524
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180524,
					"content": "По-моему, я поняла, что происходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180525
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180525,
					"content": "Вы его бредни не слушайте! Крупнейшие прегрешения клана Кудзё вам, должно быть, известны, как и то, что нельзя доверять ни единому их слову!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180526
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180526,
					"content": "Хм. Ваши распри меня не интересуют. Наследник клана Такацукаса, ты хочешь стать главой комиссии Тэнрё, я правильно понимаю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180527
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180527,
					"content": "Э, ну... д-да, конечно! Посвятить жизнь служению всемогущему сёгуну - вечное стремление каждого в комиссии Тэнрё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180528
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180528,
					"content": "Всё куда проще, чем вам представляется. Всё-таки глав комиссии Тэнрё назначаю я. Главой может стать любой, кто победит меня на дуэли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180529
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180529,
					"content": "Эм... на дуэли против всемогущего сёгуна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180530
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180530,
					"content": "Первый глава комиссии Тэнрё доказал свою волю с мечом в руках. Поэтому титул сей наследовался кланом Кудзё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180531
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180531,
					"content": "Для того, чтобы был назначен новый клан, должна произойти дуэль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180532
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180532,
					"content": "Ну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180533
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180533,
					"content": "Ты не умеешь обращаться с клинком? Или преклонные годы и немощность отняли веру в собственные силы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180534
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180534,
					"content": "Ты говоришь о том, чтобы посвятить жизнь служению мне, но боишься предстать перед моим мечом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180535
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180535,
					"content": "Ух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180536
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180536,
					"content": "Забудь. Ну а вы? Любой, кто победит меня, Такацукаса или иной, будет назначен новым главой комиссии Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180537
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180537,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180538
					],
					"speakerTitle": "Такацукаса"
				},
				{
					"id": 120180538,
					"content": "Никто не осмелится бросить мне вызов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180539
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180539,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180540
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180540,
					"content": "Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180541
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180541,
					"content": "Всемогущий сёгун, на дуэль вас вызову я!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180542
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180542,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180543
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120180543,
					"content": "Наследник Кудзё, мне жаль, но даже если ты победишь меня, ошибок твоего клана это не искупит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180544
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180544,
					"content": "Я понимаю. У меня против вас нет ни единого шанса. И я знаю, что из-за ошибок моего отца главенству клану Кудзё в комиссии Тэнрё конец...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180545
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180545,
					"content": "Даже исполняя указ об Охоте, я сомневался в решениях моего отца. Я знал, что поступаю неправильно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180546
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180546,
					"content": "Я сомневался, размышлял, ясно осознавал ситуацию, но так ничего и не предпринял и никого не спас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180547
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180547,
					"content": "Упадок клана Кудзё будет наказанием за мои поступки. Не могу сказать, что не смог его предотвратить, потому что для этого нужно было хотя бы попытаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180548
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180548,
					"content": "Говоря предельно честно, у человека твоих сил ничего бы и не вышло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180549
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180549,
					"content": "Да... я слишком слаб. Отцу на меня наплевать, брат помочь не может, и меня даже порой поучает Иппэй. Так было всегда!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180550
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180550,
					"content": "Но, по крайней мере, сейчас, в последние дни клана Кудзё его интересы представляю я, и обязанности отца надлежит исполнять мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180551
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180551,
					"content": "По словам сёгуна, мой предок однажды доказал свою волю мечом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180552
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180552,
					"content": "Прошу, тогда позвольте мне, Кудзё Камадзи, завершить историю клана Кудзё так же, как она началась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180553
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180553,
					"content": "Это моя последняя возможность сделать хоть что-то!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180554
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120180554,
					"content": "Это лишено всякого смысла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180555
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180555,
					"content": "Но я принимаю вызов. Ступи вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эи"
				}
			]
		},
		{
			"id": 1201807,
			"completionStepIds": [
				1201807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201807",
							"2"
						],
						"stepId": 1201807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180701,
					"content": "Кудзё Камадзи ранен. Наследники Такацукасы, вы обязаны позаботиться о нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180702
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180702,
					"content": "У вас нет храбрости сразиться со мной, но с такой мелочью вы справитесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180703
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180703,
					"content": "Разумеется. Мне очень жаль. Прошу прощения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180704
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180704,
					"content": "Я слышала, что клан Кудзё уже не справляется с работой комиссии Тэнрё. Поиск преемника главы комиссии - дело неотложное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180705
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180705,
					"content": "Но после этой дуэли я решила с наказанием для клана Кудзё повременить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180706
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180706,
					"content": "Тем временем клан Такацукаса, как и прежде, продолжит поддерживать клан Кудзё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180707
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180707,
					"content": "Будет сделано. Воля всемогущего сёгуна для нас закон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180708
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180708,
					"content": "Напоследок, если вы думаете, что можете копировать методы Фатуи, предоставляя мне ложные сведения, из-за чего страдают мои суждения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180709
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180709,
					"content": "...я предстану перед вами вновь, но мой клинок будет беспощаден.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180710
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180710,
					"content": "Мы всё поняли. Благодарим, всемогущий сёгун, за вашу мудрость и милосердие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180711
					],
					"speakerTitle": "Такацукаса Сусуму"
				},
				{
					"id": 120180711,
					"content": "Ладно. Дальнейшим расследованием займётся Окудзумэсю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180712
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180712,
					"content": "Следуйте за мной. Найдём тихое место. Мне нужно кое-что с вами обсудить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эи"
				}
			]
		},
		{
			"id": 1201810,
			"completionStepIds": [
				1201810
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201810",
							"2"
						],
						"stepId": 1201810,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120181001,
					"content": "Когда приходится разбираться с проблемами, ты совсем как сёгун. Такая грозная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120181002,
					"content": "Неужели? По-моему, я была весьма любезна. Будь на моём месте сёгун... она бы без лишней мысли обезглавила Кудзё Камадзи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181003,
						120181004
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181003,
					"content": "Ему повезло.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181005
					]
				},
				{
					"id": 120181005,
					"content": "Мне кажется, он был к такому исходу готов. Это было видно по его глазам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181006
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181006,
					"content": "В клане Кудзё, от его былой славы до нынешнего упадка, произошли разительные перемены. Кудзё Камадзи - наследник вовсе не выдающийся, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181007
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181007,
					"content": "Он показал, что в меняющемся мире некоторые вещи остаются такими же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181008
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181008,
					"content": "Я благодарна и вам. Увиденное на улицах и фотография тоже помогли мне понять это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181009
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181009,
					"content": "Какое будущее ожидает клана Кудзё? Продолжат ли они управлять комиссией Тэнрё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181010
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120181010,
					"content": "Ни за что. Даже если бы их наследник был талантлив, совершённых ими ошибок уже не исправить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181011
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181011,
					"content": "Но... я дам им ещё немного времени, ведь они не единственные, кто делал ошибки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181012
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181012,
					"content": "Сёгун не ошибается. Она попросту на это неспособна. Но я, будучи Эи, хотела бы принести свои извинения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181013
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181013,
					"content": "Мне предстоит осмыслить многое. Но я, по меньшей мере, знаю, куда идти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181014
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181014,
					"content": "Будешь ли ты править Инадзумой непосредственно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181015
					]
				},
				{
					"id": 120181015,
					"content": "Это я предоставлю сёгуну. Величайшей угрозой вечности остаётся приходящая со временем эрозия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181016
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181016,
					"content": "Как я уже говорила, сёгун обладает устойчивой защитной системой от модификаций. Она установлена потому, что я предвидела собственные изменения с ходом времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181017
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181017,
					"content": "Но я уже приняла решение. Я сделаю то, что необходимо, как бы сложно это ни было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181018
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181018,
					"content": "М-м-м...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181019
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181019,
					"content": "Это была весьма памятная череда событий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181020
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181020,
					"content": "Не то слово! Ты разобралась с комиссией Тэнрё, а горожане увидели здорового сёгуна. Все эти ужасные слухи исчезнут сами собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181021
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120181021,
					"content": "Если тебе понравилась прогулка, можем как-нибудь повторить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181022,
						120181023
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120181022,
					"content": "В следующий раз мы принесём тебе диковинок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181024
					]
				},
				{
					"id": 120181024,
					"content": "Не надо. Такому в моей жизни нет места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181025
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181025,
					"content": "И не надо говорить так, будто я не обойдусь без компании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181026
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181026,
					"content": "Ладно, я готова возвращаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181027
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181027,
					"content": "Моё уединение продолжится, но ненадолго. Мелкими делами тем временем пускай занимаются люди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181028
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120181028,
					"content": "Тогда увидимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181029
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120181029,
					"content": "Случилось много неожиданностей, но всё кончилось на удивление хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181030
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120181030,
					"content": "Осталось лишь вернуть пропуск Яэ Мико.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120181023,
					"content": "В следующий раз мы принесём тебе забавных безделушек.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181024
					]
				},
				{
					"id": 120181004,
					"content": "Может, этого он и ожидал.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181005
					]
				}
			]
		},
		{
			"id": 1201812,
			"completionStepIds": [
				1201812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201812",
							"2"
						],
						"stepId": 1201812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Яэ Мико"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120181201,
					"content": "Мико, мы вернулись! Выдалась отличная прогулка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120181202,
					"content": "Вот как? Тогда вы должны всё мне рассказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181203
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120181203,
					"content": "Хе-хе, как забавно. Наш всемогущий сёгун оказалась в большом городе и стала похожа на деревенскую девушку, которая с широко раскрытыми глазами пытается не потеряться на его улицах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181204
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120181204,
					"content": "Очень жаль, что я не видела этого собственными глазами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181205,
						120181206
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120181205,
					"content": "Только ты смеешь говорить подобное.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181207
					]
				},
				{
					"id": 120181207,
					"content": "Всё в порядке, она бы не возражала. Ни за что.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181208
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120181208,
					"content": "Так, из сказанного вами выходит, что она наконец начала понимать, какой должна быть вечность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181209
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120181209,
					"content": "Это самое главное достижение. Когда я давала вам пропуск, то и мечтать не могла о таком значительном успехе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181210
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120181210,
					"content": "Да. Похоже, она больше не будет вынуждать всё застыть в покое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120181211,
					"content": "Даже боги, мягко говоря, иногда предаются самообману. Выражаясь менее приятно, существуют вещи, которые не под силу даже Семи, если они сталкиваются с чем-то более могущественным, нежели они сами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181212,
						120181213
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120181212,
					"content": "Ты о человеческих чувствах?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181214
					]
				},
				{
					"id": 120181214,
					"content": "Хе-хе. Угадай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181215
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120181215,
					"content": "В общем, звучит так, будто прогулка была очень приятной. Вам даже удалось увидеть менее формальную сторону Эи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181216
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120181216,
					"content": "Когда вам захочется повидать её, просто приходите и берите у меня пропуск. Она никогда не признается, но ей частенько бывает одиноко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181217
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120181217,
					"content": "Что? Но она сказала, что ей компания не нужна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120181218,
					"content": "Это потому, что она Архонт. Не то чтобы Архонтам не нужна компания, просто ей это кажется излишеством.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181219
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120181219,
					"content": "Но ты не принадлежишь этому миру. Возможно, именно такой человек, как ты, ей и нужен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120181213,
					"content": "Ты о небесном порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181214
					]
				},
				{
					"id": 120181206,
					"content": "Нравится же вам с сёгуном друг друга подкалывать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181207
					]
				}
			]
		}
	]
}