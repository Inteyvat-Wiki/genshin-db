					"Эи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180301,
					"content": "Ничего себе, это место отлично спрятано!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120180302,
					"content": "Интересно, зачем им было возводить далеко в горах такое сооружение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180303,
						120180304
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180303,
					"content": "Чтобы обезопаситься от бедствий?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120180305
					]
				},
				{
					"id": 120180305,
					"content": "Что-то здесь не так. Я чувствую опасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180306
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180306,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120180307,
					"content": "Продвигаемся осторожно. Наследнику клана Кудзё может грозить опасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эи"
				},
				{
					"id": 120180304,
					"content": "Чтобы скрыться от чужих глаз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120180305
					]
				}
			]
		},
		{
			"id": 1201805,
			"completionStepIds": [
				1201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
