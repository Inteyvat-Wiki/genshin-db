							3626.725
						],
						"pointId": 340200104
					}
				]
			},
			"dialogs": [
				{
					"id": 740370801,
					"content": "Вот мы и на месте. Приступим к работе. Этот фонтан слишком долго стоит без дела, пора снова его запустить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370802
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370802,
					"content": "Эстель и Эдель с головой погружаются в работу...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370803
					]
				},
				{
					"id": 740370803,
					"content": "Клапан установлен. И заодно выполнен комплексный осмотр. Серьёзных повреждений нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370804
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370804,
					"content": "Хорошо. Тогда давайте отойдём. Пора открыть затворы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370805
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370805,
					"content": "Дайте-ка подумать... Главный затвор там, а ещё надо открыть дополнительный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370806
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370806,
					"content": "Подождите меня здесь, я открою затворы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370807
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370807,
					"content": "И кто так проектирует? Зачем располагать затворы так далеко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370808
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370808,
					"content": "Эдель стремительно бежит к затворам, после чего возвращается.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370809
					]
				},
				{
					"id": 740370809,
					"content": "Ох, я совсем умаялся, пока их открыл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370810
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370810,
					"content": "Давайте немного подождём. Скоро хлынет вода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370811
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370811,
					"content": "Раздаются грохочущие звуки, и вскоре из фонтана снова бьёт вода...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370812
					]
				},
				{
					"id": 740370812,
					"content": "Ух ты! Фонтан снова работает! Теперь, даже если Кератри расскажет о том, что было ночью, я смогу сделать вид, что не понимаю, о чём она...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370813,
						740370814
					],
					"speakerTitle": "Ремодье"
				},
				{
					"id": 740370813,
					"content": "Теперь ты знаешь, что с фокусами нужно быть осторожным.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370815
					]
				},
				{
					"id": 740370815,
					"content": "Проблемы же не из-за фокусов возникли... Но всё равно спасибо большое. Вот, это мои сбережения, возьми их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370816
					],
					"speakerTitle": "Ремодье"
				},
				{
					"id": 740370816,
					"content": "Вот оплата, которую я тебе обещал. Спасибо за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370817
					],
					"speakerTitle": "Ремодье"
				},
				{
					"id": 740370817,
					"content": "И вам спасибо, Эдель и госпожа Эстель!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370818
					],
					"speakerTitle": "Ремодье"
				},
				{
					"id": 740370818,
					"content": "Да мы просто сделали, что должны были, чего уж тут. А ты больше не води сестрёнку ночью на улицу. Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370819
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370819,
					"content": "Братик! А что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370820
					],
					"speakerTitle": "Кератри"
				},
				{
					"id": 740370820,
					"content": "Кератри?! Ты здесь откуда?.. Ты же должна быть на прогулке с мамой и папой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370821
					],
					"speakerTitle": "Ремодье"
				},
				{
					"id": 740370821,
					"content": "Хи-хи... Я сбежала, пока они не смотрели. Хотела увидеть, что с фонтаном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370822
					],
					"speakerTitle": "Кератри"
				},
				{
					"id": 740370822,
					"content": "Разве ты не остановил фонтан магией? Я думала, что он всё ещё не работает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370823
					],
					"speakerTitle": "Кератри"
				},
				{
					"id": 740370823,
					"content": "Ха-ха... ну... Кхм... У всякой магии есть свои пределы. Ты ведь это знаешь? Она действует только какое-то время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370824
					],
					"speakerTitle": "Ремодье"
				},
				{
					"id": 740370824,
					"content": "О-о... Я хочу увидеть ещё магию! Можешь ещё раз заставить фонтан остановиться?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370825
					],
					"speakerTitle": "Кератри"
				},
				{
					"id": 740370825,
					"content": "Ну, кхм... Кератри, знаешь, вокруг слишком много людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370826
					],
					"speakerTitle": "Ремодье"
				},
				{
					"id": 740370826,
					"content": "Если я остановлю фонтан, все расстроятся, они же хотели на него посмотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370827
					],
					"speakerTitle": "Ремодье"
				},
				{
					"id": 740370827,
					"content": "Тогда... Можем прийти попозже! И приведём маму и папу. Они наверняка захотят увидеть твою магию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370828
					],
					"speakerTitle": "Кератри"
				},
				{
					"id": 740370828,
					"content": "А?! Нет, это... Милая сестрёнка, я ещё... не очень хорошо выучил заклинание, управляющее фонтаном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370829
					],
					"speakerTitle": "Ремодье"
				},
				{
					"id": 740370829,
					"content": "Наши родители наверняка не захотят смотреть на такой никудышный фокус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370830
					],
					"speakerTitle": "Ремодье"
				},
				{
					"id": 740370830,
					"content": "Поэтому ты не должна ничего рассказывать о магии фонтана маме и папе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370831
					],
					"speakerTitle": "Ремодье"
				},
				{
					"id": 740370831,
					"content": "Я лучше всё как следует выучу, а потом устрою им сюрприз.",
