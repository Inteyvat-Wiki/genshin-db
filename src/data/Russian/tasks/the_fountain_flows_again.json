				]
			},
			"dialogs": [
				{
					"id": 740370501,
					"content": "Привет, чем могу помочь?.. А, Эдель?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370502
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370502,
					"content": "Я пришёл за клапаном и соплом. Надо побыстрее починить фонтан, а не то парнишка Ремодье с ума сойдёт от беспокойства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370503
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370503,
					"content": "К-клапан, говоришь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370504
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370504,
					"content": "Эй, ты чего заикаешься, Эстель? Ты ведь не забыла его сделать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370505
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370505,
					"content": "Нет! Я сделала клапан. Но... перед тобой приходила клиентка, которой срочно нужно было что-то починить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370506
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370506,
					"content": "И-и я дала ей кое-какие детали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370507
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370507,
					"content": "Но переживать не о чем! Я уже занялась новым клапаном! Скоро он будет готов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370508
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370508,
					"content": "Госпожа Эстель, я ведь уже давно сделал этот заказ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370509
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370509,
					"content": "Знаю-знаю. Но эта клиентка так торопилась. Говорила, что ей нужно отремонтировать клапан канализационного стока, и совсем замучила меня своими просьбами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370510
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370510,
					"content": "Всё будет отлично! Как только... как только доставят обломки железа, которые я заказала, я сразу сделаю клапан. Железо вот-вот прибудет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370511
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370511,
					"content": "И когда ты его заказала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370512
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370512,
					"content": "С-сегодня утром...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370513,
						740370514
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370513,
					"content": "Обломки железа я достану.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				},
				{
					"id": 740370515,
					"content": "#Правда? Отлично, просто великолепно. Тогда я буду ждать тебя, {F#путешественница}{M#путешественник}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370516
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370516,
					"content": "Мне так неловко! Хватит трёх обломков железа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370517
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370517,
					"content": "#Что ж, мы будем рассчитывать на тебя, {F#путешественница}{M#путешественник}. О вознаграждении не беспокойся, с пустыми руками не уйдёшь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370514,
					"content": "Я займусь железом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				}
			]
		},
