			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эдель"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740370301,
					"content": "Нужно обновить трубы и клапаны... И прочистить надо... Эх, дел куча.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370302
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370302,
					"content": "А? Вам что-то нужно? Не похоже, что вас послала Эстель починить фонтан...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370303
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370303,
					"content": "Мы по делу Ремодье...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370304
					]
				},
				{
					"id": 740370304,
					"content": "А, ты о нём. О, его фокус был настолько хорош, что заставил проржаветь клапан под фонтаном и сломал сопло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370305
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370305,
					"content": "Ха-ха, шучу. На самом деле клапан так погнуло, что заклинило всю сеть трубопроводов, так что пришлось отключить пока фонтан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370306
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370306,
					"content": "Но вот что случилось с соплом? Ума не приложу... Это так странно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370307
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370307,
					"content": "Ремодье говорил, что его отругают, если фонтан не начнёт работать как можно скорее... Но я не мог заняться этим раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370308
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370308,
					"content": "Только сегодня у меня наконец выдалось время, чтобы забрать новый клапан и сопло у Эстель. Сейчас схожу за ними в город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370309
					],
					"speakerTitle": "Эдель"
				},
				{
					"id": 740370309,
					"content": "Если хотите, можете пойти со мной. Деталей будет много, могу в одиночку всё не унести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эдель"
				}
			]
		},
		{
			"id": 7403704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
