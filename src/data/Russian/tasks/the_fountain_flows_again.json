			"dialogs": [
				{
					"id": 740370401,
					"content": "А если фонтан не починить да поскорее, тот парнишка, Ремодье, с ума сойдёт от беспокойства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эдель"
