			"dialogs": [
				{
					"id": 740370701,
					"content": "Этого хватит! Через несколько минут всё будет готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370702
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370702,
					"content": "Эстель с головой погружается в работу...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370703
					]
				},
				{
					"id": 740370703,
					"content": "Вот и всё! Клапан для фонтана, сопло и необходимые для их работы детали готовы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370704
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370704,
					"content": "#Эдель, {F#путешественница}{M#путешественник}, отправляемся на остров Эриний! Уверена, что с моей помощью фонтан совсем скоро заработает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370705
					],
					"speakerTitle": "Эстель"
				},
				{
					"id": 740370705,
					"content": "#Буду на это рассчитывать... Я возьму эти детали, {F#путешественница}{M#путешественник}. Идём скорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эдель"
				}
			]
		},
		{
			"id": 7403708,
