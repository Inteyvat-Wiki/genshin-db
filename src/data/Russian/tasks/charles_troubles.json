				"points": []
			},
			"dialogs": [
				{
					"id": 4880001,
					"content": "Лиза? Ты здесь по поводу возврата налогов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4880002,
					"content": "Привет, милашка! Всё верно, когда я узнала о состоянии Джинн, я поняла, что могу помочь с бумажными делами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880003
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 4880003,
					"content": "Отлично! Раз наша помощь больше не требуется, мы пойдём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880004
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4880004,
					"content": "Минуточку! Чарльз хотел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880005
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 4880005,
					"content": "Позвольте мне самому сказать, мисс Лиза!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880006
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4880006,
					"content": "Я только что принял крайне важный заказ, но, к сожалению, у нас закончились продукты, а поставку с винокурни ждать ещё долго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880007
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4880007,
					"content": "Если у вас будет возможность, помогите <color=#00E1FFFF>разобраться с этой неприятностью</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880008
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4880008,
					"content": "К чему такая спешка? Что это за крайне важный заказ такой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880009
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4880009,
					"content": "Заказ был сделан в последнюю минуту. Буквально секунду назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880010
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4880010,
					"content": "Да, всё было именно так, как говорит Чарльз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880011
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 4880011,
					"content": "Хорошо. Я посмотрю, что можно сделать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880012
					]
				},
				{
					"id": 4880012,
					"content": "Но в следующий раз я собираюсь пить за счёт заведения.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880013
					]
				},
				{
					"id": 4880013,
					"content": "Ха! Конечно, в следующий раз твой счёт оплатит господин Дилюк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880014
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4880014,
					"content": "Договорились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 48801,
			"completionStepIds": [
				48801
