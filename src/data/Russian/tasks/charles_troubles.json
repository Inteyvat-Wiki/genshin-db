			},
			"dialogs": [
				{
					"id": 4880101,
					"content": "Теперь понятно, что произошло с поставками Чарльза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4880102,
					"content": "Вы здесь, чтобы спасти меня? Я жду помощи уже так долго...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880103
					],
					"speakerTitle": "Эрнест"
				},
				{
					"id": 4880103,
					"content": "За всё время моей работы на винокурне, это первый раз, когда меня грабят хиличурлы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880104
					],
					"speakerTitle": "Эрнест"
				},
				{
					"id": 4880104,
					"content": "Если бы не вы, я не знаю, что бы я делал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "Эрнест"
				},
				{
					"id": 4880105,
					"content": "#Расслабься! {NICKNAME} - гроза хиличурлов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4880106,
					"content": "Отлично. Сопроводи этот <color=#00E1FFFF>аэростат</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880107
					],
					"speakerTitle": "Эрнест"
				},
				{
					"id": 4880107,
					"content": "Обращайся с ним крайне осторожно. Хиличурлы здесь не главное! Гораздо важнее <color=#00E1FFFF>доставить товары в целости и сохранности</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880108
					],
					"speakerTitle": "Эрнест"
				},
				{
					"id": 4880108,
					"content": "Я буду ждать тебя на месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880109
					],
					"speakerTitle": "Эрнест"
				}
			]
		},
