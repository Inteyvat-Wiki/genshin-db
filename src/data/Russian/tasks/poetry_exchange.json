			"dialogs": [
				{
					"id": 201031201,
					"content": "#Как всё прошло? Ты проч{F#ла}{M#ёл} хиличурлам мои стихи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031202
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201031202,
					"content": "#Проч{F#ла}{M#ёл}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031203
					]
				},
				{
					"id": 201031203,
					"content": "И как они отреагировали? Судя по выражению твоего лица... не очень хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031204
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201031204,
					"content": "Произошло недопонимание.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031205
					]
				},
				{
					"id": 201031205,
					"content": "#Ты точно следовал{F#а} моим указаниям? Или они тоже оказались неверными?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031206
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201031206,
					"content": "Мне очень... жаль. Оказывается, я не настолько хорошо знаю язык, как думала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031207
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201031207,
					"content": "Нужно приложить больше усилий к изучению языка. Я не могу опозорить благородную фамилию Маск.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элла Маск"
				}
			]
		},
