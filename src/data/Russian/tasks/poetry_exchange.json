	"talks": [
		{
			"id": 2010301,
			"completionStepIds": [
				2010301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010301",
							"2"
						],
						"stepId": 2010301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Элла Маск"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201030101,
					"content": "#Вот мы и снова встретились! Помнишь меня? Нет? Ты точно долж{F#на}{M#ен} помнить, как мы подружились с хиличурлом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030102
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201030102,
					"content": "Не смотри на меня так. Чтобы выучить язык, необходимо постоянно практиковаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030103
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201030103,
					"content": "Не переживай. Твои усилия не прошли напрасно! Мой разговорный хиличурлский стал намного лучше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030104
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201030104,
					"content": "Но мне ещё нужно работать над своим письменным хиличурлским. После длительных исследований, я сочинила целый цикл стихов на хиличурлском!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030105
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201030105,
					"content": "#К слову, я пока ещё не вполне уверена в значении нескольких строчек. Не мог{F#ла} бы ты их проверить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030106,
						201030111
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201030106,
					"content": "В смысле «проверить»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030107
					]
				},
				{
					"id": 201030107,
					"content": "Ну конечно же прочитать их какому-нибудь хиличурлу и посмотреть, как он отреагирует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030108
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201030108,
					"content": "Не переживай! Всё будет хорошо! Я <color=#00E1FFFF>отметила</color> строчки, в значении которых я не уверена. В любом случае там нет ничего оскорбительного... Не должно быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030109
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201030109,
					"content": "Я уже знаю, где искать слушателей. Там хиличурлы выглядят дружелюбнее остальных. Просто прочитай выделенные строки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030110
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201030110,
					"content": "Спасибо тебе! Возвращайся поскорее, после чтения стихов. Я хочу узнать, как они отреагировали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201030111,
					"content": "Прочитать стихи хиличурлам?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030112
					]
				},
				{
					"id": 201030112,
					"content": "Верно! У тебя огромный опыт общения с хиличурлами. Всё будет хорошо! Я <color=#00E1FFFF>отметила</color> строчки, в значении которых я не уверена. В любом случае там нет ничего оскорбительного... Не должно быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030113
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201030113,
					"content": "Я уже знаю, где искать слушателей. Там хиличурлы выглядят дружелюбнее остальных. Просто прочитай выделенные строки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030114
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201030114,
					"content": "Спасибо тебе! Возвращайся поскорее, после чтения стихов. Я хочу узнать, как они отреагировали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030115
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201030115,
					"content": "А если что-то пойдёт не по плану... То ты сможешь решить эту проблему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элла Маск"
				}
			]
		},
