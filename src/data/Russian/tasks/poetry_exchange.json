			},
			"dialogs": [
				{
					"id": 201031101,
					"content": "#Как всё прошло? Ты проч{F#ла}{M#ёл} хиличурлам мои стихи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031102
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201031102,
					"content": "#Проч{F#ла}{M#ёл}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031103
					]
				},
				{
					"id": 201031103,
					"content": "И как они отреагировали? Судя по выражению твоего лица... нормально?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031104
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201031104,
					"content": "Отреагировали неплохо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031105
					]
				},
				{
					"id": 201031105,
					"content": "Значит я правильно расшифровала значения всех слов. Спасибо за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031106
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201031106,
					"content": "Ещё один маленький шаг на пути изучения хиличурлов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031107
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201031107,
					"content": "Однажды я смогу свободно общаться с хиличурлами. Они поведают мне все свои секреты. И когда этот день настанет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031108
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201031108,
					"content": "Я с гордостью смогу сказать, что заслуживаю носить прославленную фамилию Маск.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031109
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 201031109,
					"content": "Ещё раз благодарю тебя за помощь. Вот твоя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элла Маск"
				}
			]
		},
