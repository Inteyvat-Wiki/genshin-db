			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Му Шэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000301,
					"content": "Вот такая история. В следующий раз обсудим что-нибудь ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
