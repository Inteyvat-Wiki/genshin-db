			},
			"dialogs": [
				{
					"id": 223008001,
					"content": "Ого... Мы уже так долго разговариваем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008002
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223008002,
					"content": "Теперь ты знаешь про Гео Архонта чуть больше, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008003
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223008003,
					"content": "Это дало мне пищу для размышлений...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223008004
					]
				},
				{
					"id": 223008004,
					"content": "Вот и славненько. Но на этом история Властелина Камня не заканчивается. Будет время - заглядывай, я расскажу тебе ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008005
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223008005,
					"content": "#Ого, сколько ты сделал{F#а} записей... Похоже, мои истории увлекли тебя не на шутку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008006
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223008006,
					"content": "Давай ты оставишь эти записи мне, а я в свободную минутку запишу для тебя ещё историй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008007
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223008007,
					"content": "Тогда выйдет неплохой сборник. Когда он будет готов, я с радостью отдам его тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008008
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223008008,
					"content": "Конечно, историй про Властелина Камня много, и понадобится время, чтобы их всех записать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008009
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223008009,
					"content": "#А это тебе. Благодарю, что слушал{F#а} мои истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Му Шэн"
				}
			]
		}
	]
