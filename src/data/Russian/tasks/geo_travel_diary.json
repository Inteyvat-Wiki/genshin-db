		},
		{
			"id": 2230010,
			"completionStepIds": [
				2230010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230010",
							"2"
						],
						"stepId": 2230010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Му Шэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001001,
					"content": "Руда из шахты! Так ты всё-таки неплохо понимаешь, что значит «Гео».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001002
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001002,
					"content": "Первые поселенцы Ли Юэ научились плавить руду и добывать железо. Но ещё раньше у руды было другое применение, более важное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001003
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001003,
					"content": "Когда первые поселенцы прибыли в Ли Юэ, они складывали эти булыжники друг на друга и высекали искру, чтобы получить огонь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001004
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001004,
					"content": "Огонь позволил им готовить пищу. А приготовленная еда давала им достаточно сил для работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001005
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001005,
					"content": "И всё это началось с вот этих самых кусков руды, даров Властелина Камня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001006
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001006,
					"content": "Гео Архонта стали называть Богом Очага.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001007
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001007,
					"content": "Владельцы всех ресторанов и таверн молятся Властелину Камня, чтобы очаг в их заведении никогда не затухал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001008
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001008,
					"content": "Когда ты в следующий раз посетишь какой-нибудь ресторан в Ли Юэ, поблагодари про себя Гео Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Му Шэн"
				}
			]
		},
		{
			"id": 2230011,
			"completionStepIds": [
				2230011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230011",
							"2"
						],
						"stepId": 2230011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Му Шэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "О! Тебе пришлось проделать долгий путь, чтобы найти это, верно? Отличный выбор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001102,
					"content": "#Как ты мог{F#ла} заметить, Ли Юэ - огромный город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001103,
					"content": "Но даже огромные города не сразу строились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001104,
					"content": "Когда сюда прибыли первые поселенцы, никакого города здесь ещё не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001105,
					"content": "Шаг за шагом храбрые первопроходцы возделывали неподатливую почву. В конце концов, им удалось построить этот великий город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001106,
					"content": "Как ты знаешь, земли здесь каменистые. Вырастить что-то на такой почве очень непросто. Здесь прижились только самые устойчивые растения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001107,
					"content": "У этих растений обнаружились полезные свойства, которые помогли первым поселенцам справиться с суровой средой. Они считают эти растения дарами Гео Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001108,
					"content": "Рассказы о подвигах первопроходцев всегда были популярны среди жителей Ли Юэ. По сей день искатели приключений черпают вдохновение у предков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001109,
					"content": "Они унаследовали упорство и трудолюбие первых поселенцев. А Гео Архонта стали называть Первопроходец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223001110,
					"content": "Искатели приключений в Ли Юэ непоколебимо переносят все трудности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Му Шэн"
				}
			]
		},
