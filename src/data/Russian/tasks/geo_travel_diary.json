			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Му Шэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000101,
					"content": "Это всё, о чём я прошу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000102
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223000102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000103
					]
				},
				{
					"id": 223000103,
					"content": "Я поклоняюсь Гео Архонту. Как я могу судить, ты не из Ли Юэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000104
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223000104,
					"content": "Это Храм скалы. Люди со всего Ли Юэ приходят сюда, чтобы поклониться Властелину Камня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000105
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223000105,
					"content": "Я живу очень далеко и не могу часто посещать храм. Поэтому каждый раз я провожу здесь много времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000106
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223000106,
					"content": "Чем больше я узнаю о Властелине Камня, тем больше восхищаюсь его величием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000107
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223000107,
					"content": "Когда я думаю о деяниях Гео Архонта, дорога к храму уже не кажется мне такой изматывающей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000108
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223000108,
					"content": "#Я полагаю, что ты мало знаком{F#а} с Властелином Камня и его историей. Если хочешь, я могу рассказать тебе о нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000109
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223000109,
					"content": "Хотя мои рассказы могут и не произвести на тебя должного впечатления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000110
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223000110,
					"content": "Хм... Придумал! Собери для меня какие-нибудь предметы, связанные <color=#00E1FFFF>с Ли Юэ</color>. Эти вещи помогут мне наглядно проиллюстрировать историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000111,
						223000113
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223000111,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000112
					]
				},
				{
					"id": 223000112,
					"content": "Возвращайся поскорее. Я буду ждать тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223000113,
					"content": "О каких вещах мы говорим?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000114
					]
				},
				{
					"id": 223000114,
					"content": "О любых. Главное, чтобы они были связаны с <color=#00E1FFFF>Ли Юэ</color> или с <color=#00E1FFFF>Властелином Камня</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000115
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223000115,
					"content": "Однако я знаю не очень много историй... И не все эти истории стоит рассказывать, если честно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000116
					],
					"speakerTitle": "Му Шэн"
				},
				{
					"id": 223000116,
					"content": "Я буду ждать тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Му Шэн"
				}
			]
		},
