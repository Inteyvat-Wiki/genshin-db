					"Виктор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270201,
					"content": "Что? Что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270202
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 411270202,
					"content": "Ты бы сориентировал меня, где искать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270203
					]
				},
				{
					"id": 411270203,
					"content": "Эм... Ладно, погоди. Сейчас попробую вспомнить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270204
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 411270204,
					"content": "Ничего не припоминаю. Да и коробка непримечательна тоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270205
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 411270205,
					"content": "Позволь мне тебя кое о чём спросить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270206
					]
				},
				{
					"id": 411270206,
					"content": "Хорошо, спрашивай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				}
			]
		},
		{
