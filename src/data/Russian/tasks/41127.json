			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Виктор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270301,
					"content": "Что ты делал снаружи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270302
					]
				},
				{
					"id": 411270302,
					"content": "Эй, не смотри на меня так подозрительно, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270303
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 411270303,
					"content": "Я просто вышел погулять! Начали падать метеориты, и я побежал обратно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270304
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 411270304,
					"content": "Хорошо. Попробуй поискать. Если совсем ничего не найдёшь, <color=#00E1FFFF>возвращайся ко мне</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270305
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 411270305,
					"content": "А я тем временем постараюсь что-нибудь вспомнить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				}
			]
		},
		{
