				"objectNames": [
					"Виктор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270401,
					"content": "Что находится в коробке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270402
					]
				},
				{
					"id": 411270402,
					"content": "Эм... Не твоё дело. Так, мелочёвка всякая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270403
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 411270403,
					"content": "Да ладно, не смотри ты на меня так! Я не злодей какой-то!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270404
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 411270404,
					"content": "Но ты ведь Фатуи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270405
					]
				},
				{
					"id": 411270405,
					"content": "#Фатуи то, Фатуи сё... Значит, мы все плохие? Как ты дош{F#ла}{M#ёл} до такого заключения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270406
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 411270406,
					"content": "Хорошо. Попробуй поискать. Если совсем ничего не найдёшь, <color=#00E1FFFF>возвращайся ко мне</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270407
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 411270407,
					"content": "А я тем временем постараюсь что-нибудь вспомнить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктор"
				}
			]
		},
