					"Виктор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270501,
					"content": "Что случилось, когда ты побежал обратно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270502
					]
				},
				{
					"id": 411270502,
					"content": "Дай подумать... Что-то ничего конкретного не вспоминается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270503
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 411270503,
					"content": "Ах, да! На пути обратно у <color=#00E1FFFF>храма Тысячи ветров</color> я увидел огромную стаю Электро слаймов. Они меня пару раз шарахнули, и коробка выпала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270504
					],
					"speakerTitle": "Виктор"
				},
				{
					"id": 411270504,
					"content": "Я успел её поднять, но... Когда бежал, снова выронил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270505
					],
