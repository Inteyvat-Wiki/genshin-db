					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620401,
					"content": "Дай мне посмотреть! Что там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620402,
					"content": "«Она вовсе не любила его. Источник бьёт ключом, но это лишь фальшивый образ, и в час холодного одиночества её сердце явит истину».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620407,
					"content": "Ещё одна карта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620403,
					"content": "Опять загадка! Больше загадок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620404,
					"content": "Голова уже идёт кругом! Мозг закипает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620405,
					"content": "Мозг? У тебя есть мозг?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620406
					]
				},
				{
					"id": 4620406,
					"content": "#Разбирайся с этим сам{F#а}! Или попроси Кэйю о помощи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 46205,
			"completionStepIds": [
				46205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
