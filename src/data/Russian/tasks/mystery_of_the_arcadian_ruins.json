			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кэйа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620701,
					"content": "«Она вовсе не любила его. Источник бьёт ключом, но это лишь фальшивый образ, и в час холодного одиночества её сердце явит истину».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620702
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620702,
					"content": "Что это может означать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620703,
					"content": "Похоже на случайную страницу из дешёвого любовного романа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620704
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620704,
					"content": "Ох, значит я была не права. Даже такие гении, как я, могут ошибаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620705,
					"content": "Ха-ха! Я же пошутил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620706
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620706,
					"content": "Кэйа! Это серьёзное дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620707,
					"content": "Ха-ха! Непростая загадка! «На поверхности ручья...» Должно быть, речь идёт о Спрингвейле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620708
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620717,
					"content": "Может, это про тех, кто купается в ручье?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620724,
					"content": "От чего меняется уровень воды в ручье?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620708,
					"content": "«Источник бьёт ключом, но это лишь фальшивый образ»... Что бы это значило? О какой страсти идёт речь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620709
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620718,
					"content": "Это же неприлично! В Мондштадте так не делают, хвала Архонтам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620719,
					"content": "Ты тоже купаешься в ручьях?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620720,
					"content": "В таком случае приношу извинения. Я не осуждаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620721,
					"content": "#Эй! {NICKNAME} совсем не так{M#ой}{F#ая}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620723,
					"content": "Эээ... Может речь идёт об изменении уровня воды в ручье?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620722,
					"content": "Ха-ха! «Стремительная страсть» исходит не от ручья, а от тех, кто в ручье купается!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620725,
					"content": "Хорошая идея! Водопады!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620726,
					"content": "Ключ к тайне спрятан за водопадом в Спрингвейле!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620727,
					"content": "Настоящая страсть находится там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620709,
					"content": "«Сердце водопада» - это скала слева от водопада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620710
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620710,
					"content": "«Холодное одиночество». Похоже на Крио элемент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620711
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620712,
					"content": "Спасибо за помощь, Кэйа.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620713
					]
				},
				{
					"id": 4620711,
					"content": "Возьми с собой друзей с <color=#00E1FFFF>Крио способностями</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620712
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620713,
					"content": "Не за что! Если рыцарь Ордо Фавониус не сможет решить загадку, то как тогда он будет расследовать настоящие преступления?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620714
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620714,
					"content": "Мы отправимся в Спрингвейл. А ты тут занимайся «настоящими преступлениями».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620715
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620715,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620716
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620716,
					"content": "Я имела в виду расследованиями настоящих преступлений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
