			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вэл"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620301,
					"content": "За что? Не стоило <color=#00E1FFFF>ему</color> помогать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620302
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 4620302,
					"content": "Ему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620303,
					"content": "Спасибо вам! На вас можно положиться, в отличие от этих рыцарей из ордена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620304
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 4620304,
					"content": "#Пустяки! {NICKNAME} - путешественни{M#к}{F#ца}. Он{F#а} занимается этим каждый день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620305,
					"content": "#Путешественн{F#ица}{M#ик}? Значит, это ты... Забавно, что мы <color=#00E1FFFF>встретились</color> при таких обстоятельствах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620306
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 4620306,
					"content": "Значит ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620307,
					"content": "Ха-ха! Не знаю, как я могу вас отблагодарить. Что, если я поделюсь с вами информацией о руинах совершенно бесплатно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620308
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 4620308,
					"content": "Личные связи в нашем деле имеют огромное значение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620309,
						4620311
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 4620309,
					"content": "Серьёзно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620310
					]
				},
				{
					"id": 4620310,
					"content": "Да, вы спасли мне жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620312
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 4620312,
					"content": "Какая удача!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620313,
					"content": "Хотя... Кэйа! Вот для кого это большая удача. Платить-то должен был он.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620314,
					"content": "Слушайте внимательно, руины Аркадии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620315
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 4620315,
					"content": "«В том городе на озере живут три великана о шести руках. Двое защищают статую божества, третий охраняет сокровища богов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620316
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 4620316,
					"content": "Ага... Это всё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620325,
					"content": "К этой записке прилагается карта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620317
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 4620317,
					"content": "На карте показано, где сокровища?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620318,
					"content": "Это больше похоже на загадку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620319,
					"content": "#Для тебя это должно быть проще простого! Да, {NICKNAME}? Займёшься этим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620320,
						4620321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620320,
					"content": "Конечно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620322,
					"content": "Если у тебя не получится решить эту загадку, то пусть попробует Кэйа. Похоже, у него тоже котелок неплохо варит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620326,
					"content": "Я оставлю эти данные тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620327
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 4620327,
					"content": "Спасибо, Вэл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620323,
					"content": "«В том городе на озере живут три великана о шести руках. Двое защищают статую божества, третий охраняет сокровища богов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620324,
					"content": "Что это может означать? Кэйа поможет нам, если ты не справишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620321,
					"content": "Да... проще простого...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620311,
					"content": "Спасибо тебе, подруга.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620312
					]
				}
			]
		},
