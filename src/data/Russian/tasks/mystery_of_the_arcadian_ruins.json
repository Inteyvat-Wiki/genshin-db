			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кэйа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620501,
					"content": "#{NICKNAME}! Вы вернулись! Похоже, что у вас есть нужная информация.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620502
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620502,
					"content": "И да, и нет. Всё немного сложнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620503,
					"content": "«В том городе на озере живут три великана о шести руках. Двое защищают статую божества, третий охраняет сокровища богов». Что это может означать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620504,
					"content": "Загадки? Как оригинально! Давай подумаем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620505
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620505,
					"content": "Город на озере - это Мондштадт. А шестирукие гиганты... Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620506
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620506,
					"content": "Крабы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620507
					]
				},
				{
					"id": 4620507,
					"content": "Гигантские крабы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620508,
					"content": "Я не видел в Мондштадте никаких гигантских крабов, к тому же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620509
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620509,
					"content": "У крабов восемь ног, а не шесть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620516
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620516,
					"content": "Мельницы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620517
					]
				},
				{
					"id": 4620517,
					"content": "Это... мельницы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620518
					]
				},
				{
					"id": 4620518,
					"content": "Хм. Ветряные мельницы. Неплохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620519
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620519,
					"content": "У мельниц по шесть лопастей. Всё сходится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620510
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620510,
					"content": "Да! Всё верно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620511,
					"content": "В городе три мельницы. Две из них рядом со статуей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620512
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620512,
					"content": "А другая охраняет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620513
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620513,
					"content": "Я знаю! Я знаю! Другая охраняет сокровища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4620514,
					"content": "Ха-ха! Надеюсь, что так и будет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620515
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4620515,
					"content": "#Пойдём, {NICKNAME}! Проверим эту ветряную мельницу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 46207,
			"completionStepIds": [
				46207
			],
