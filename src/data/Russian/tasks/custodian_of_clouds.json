				"points": []
			},
			"dialogs": [
				{
					"id": 10091501,
					"content": "Эй, а откуда здесь этот стол? Смотри, тут уже всё готово к обеду. Даже винная чашка стоит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091502,
					"content": "А здесь выгравированы имена гостей! «Здесь восседает Хранитель»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091510,
					"content": "«Здесь восседает Гуй Чжун», «Здесь восседает Властелин»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091503,
					"content": "«Властелин»... Может быть, речь идёт о Властелине Камня? Но Паймон не знает ничего про Гуй Чжун...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091504,
					"content": "А «Хранитель» - это, наверное, Хранитель Облаков! Владыка Лун упоминал об этом Адепте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091505,
					"content": "Значит, здесь Хранитель Облаков устраивает вечеринки с другими Адептами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091506,
					"content": "Давай приготовим для Адептов что-нибудь особенное? Так у нас точно получится привлечь внимание Хранителя Облаков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091507,
					"content": "Но... Чем обычно питаются Адепты? Паймон не знает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091508,
					"content": "Хм... Люди постоянно оставляют Адептам подношения. Давай сначала посмотрим, какую еду оставляют, и потом что-нибудь придумаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091509,
					"content": "Как думаешь, понравится ли Адептам... медовое мясо с морковкой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
