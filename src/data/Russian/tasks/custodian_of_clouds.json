			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хранитель Облаков"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10091401,
					"content": "Я впечатлена. Попасть в мою обитель способны лишь достойнейшие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091402
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091402,
					"content": "Перед тобой Адепт, Хранитель Облаков. Что привело тебя сюда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091403,
						10091405
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091403,
					"content": "Ты сама здесь всё построила?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091404
					]
				},
				{
					"id": 10091404,
					"content": "Твоя догадка верна. Я сама здесь всё спроектировала и построила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091407,
					"content": "Гуй Чжун и Властелин Камня высоко оценили мои инженерные навыки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091408
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091408,
					"content": "Это место просто огромное! Ты здесь правда живёшь одна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091409,
					"content": "Зачем тебе это всё? Это твоя частная мастерская, где ты сооружаешь все эти механизмы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091410,
					"content": "Совсем как в легендах... Адепты покидают мир простых смертных и становятся отшельниками. А затем они изобретают разные классные штуки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091411,
					"content": "Просто... людской суете я предпочитаю покой и тишину...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091412
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091412,
					"content": "И я наслаждалась тишиной и покоем... Пока не явились вы с Печатью согласия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091413
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091413,
					"content": "Хватит! Скажите, что привело вас сюда? Вы уже достаточно долго нарушаете безмятежность этого места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091414
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091414,
					"content": "Властелин Камня... Убит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091415
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091415,
					"content": "Как такое возможно? Кто вообще способен на столь мерзкое злодеяние?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091416
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091416,
					"content": "Сама мысль об этом кажется невероятной... Я должна проверить достоверность твоей информации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091417
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091417,
					"content": "Для начала я казню всех жителей Ли Юэ, а потом посовещаюсь с остальными Адептами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091418
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091418,
					"content": "Что?!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091419
					]
				},
				{
					"id": 10091419,
					"content": "ЧТО?! Казнишь всех жителей Ли Юэ? Ты серьёзно собираешься уничтожить весь город?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091420,
					"content": "Лишь для того, чтобы предотвратить дальнейшие происшествия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091421,
						10091423
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091421,
					"content": "Но Адепты поклялись защищать город...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091422
					]
				},
				{
					"id": 10091422,
					"content": "Верно. Мы защищали гавань Ли Юэ под покровительством Властелина Камня на протяжении тридцати семи веков. Но в связи с этим гнусным нападением... должны быть приняты чрезвычайные меры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091425,
					"content": "Я собираюсь принять крайние меры именно потому, что не хочу видеть страдания народа Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091426
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091426,
					"content": "Ой! Надо скорее что-то придумать! Она хочет уничтожить весь город, и, кажется, она не шутит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091427,
					"content": "Ты приняла наше подношение. Мы заключили контракт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091428
					]
				},
				{
					"id": 10091428,
					"content": "Точно! Мы заключили контракт! Мы приготовили много разных вкусняшек и отдали их тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091429
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091429,
					"content": "Мы надеялись, что ты поможешь городу, а не уничтожишь его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091430
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091430,
					"content": "Ну или хотя бы сначала посовещаешься с другими Адептами... Нет же ничего плохого в том, чтобы узнать их мнение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10091431,
					"content": "«Контракт»... После подлого убийства бога контрактов это слово звучит предельно саркастично...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091432
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091432,
					"content": "Кажется, жители Ли Юэ с лёгкостью забывают о контрактах. У них не всегда получается отличить добро от зла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091433
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091433,
					"content": "Тем не менее... Если вы призываете к соблюдению контракта, то я выполню свои обязательства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091434
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091434,
					"content": "Однако вы принесли Печать согласия... Когда Властелин Камня создавал эти печати, он наделил их силой Адептов. Когда-то эта сила помогла людям в битве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091435
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091435,
					"content": "Большинство печатей уже утратило свою силу... Сейчас это всего лишь сувениры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091436
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091436,
					"content": "Этот сувенир не может свидетельствовать о вашей благонадёжности. Я должна провести независимое расследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091437
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091437,
					"content": "Именно этого от меня и ждёт Владыка Лун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091438
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091438,
					"content": "Ваша аудиенция с Адептом завершена. Покиньте обитель и не тревожьте меня вновь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091423,
					"content": "Но разве ты не должна защищать жителей города?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091424
					]
				},
				{
					"id": 10091424,
					"content": "Верно. Но если Властелин Камня действительно был убит, то Ли Юэ грозит серьёзная опасность. Если не принять решительные меры, то произойдёт катастрофа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10091405,
					"content": "Ты сама спроектировала все механизмы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091406
					]
				},
				{
					"id": 10091406,
					"content": "Естественно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Хранитель Облаков"
				}
			]
		},
