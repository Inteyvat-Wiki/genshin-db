			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090201,
					"content": "Здесь точно готовили еду. Думаешь, это было подношение для Адептов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10090202,
					"content": "Похоже, что тут ещё остались кое-какие ингредиенты... Что у нас тут? Львиный зев, немного чашечек лотоса, чуть-чуть тофу... Паймон не понимает, что это за блюдо такое они готовили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10090203,
					"content": "Смотри, здесь какая-то... записная книжка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10090204,
					"content": "Сложновато! Неудивительно, что им пришлось это всё записать... Надо внимательно изучить эти записи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 100903,
			"completionStepIds": [
				100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100903",
							"2"
						],
						"stepId": 100903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090301,
					"content": "Смотри, тут всё в муке... Повар такой грязнуля!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10090302,
					"content": "Что у нас тут? Какое-то непонятное мясо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10090303,
					"content": "Думаешь, это блюдо - подношение Адептам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10090304,
					"content": "Паймон не может себе представить подношение, приготовленное из муки и мяса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10090305,
					"content": "Ха! Наш грязнуля повар обронил какую-то бумажку... И оставил на ней след ботинка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10090306,
					"content": "Может быть, она как-то связана с загадочным блюдом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 100904,
			"completionStepIds": [
				100904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100904",
							"2"
						],
						"stepId": 100904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090401,
					"content": "Здесь так чисто. Повар, который готовил здесь последним, очень аккуратный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10090402,
					"content": "Паймон уверена, что здесь готовили подношения для Адептов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10090403,
					"content": "У нас есть мацутакэ и немного сырого мяса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10090404,
					"content": "А вот и рецепт! Какой же всё-таки внимательный и организованный повар...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
