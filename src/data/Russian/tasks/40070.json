				"points": []
			},
			"dialogs": [
				{
					"id": 400701901,
					"content": "Мы посадили лепесток, ты что-нибудь почувствовала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701902
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701902,
					"content": "Да. Тёплые лучи солнца, море, сияющее, словно жемчуг, и нежно плещущие о скалы волны. А ещё песчинки, перекатывающиеся на пляже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701903
					],
					"speakerTitle": "Ледяное сердце"
				},
				{
					"id": 400701903,
					"content": "И морские птицы садятся на камни и отстукивают незамысловатый ритм своими клювами. Тук-тук, тук-тук.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701904
					],
					"speakerTitle": "Ледяное сердце"
				},
				{
					"id": 400701904,
					"content": "Это музыка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701905
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701905,
					"content": "Да, это музыка. Ведь этот остров и является огромным музыкальным инструментом. Ты музыкант, поэтому должна понимать скрытый смысл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701906
					],
					"speakerTitle": "Ледяное сердце"
				},
				{
					"id": 400701906,
					"content": "Музыка приливов, ветров и волн - это так романтично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701907
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701907,
					"content": "Идём. Пришло время для моего выступления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Синь Янь"
				}
			]
		}
	]
