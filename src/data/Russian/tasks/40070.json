			"dialogs": [
				{
					"id": 400701701,
					"content": "Мы на месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701702
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400701702,
					"content": "А? Фишль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701703
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400701703,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701704
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400701704,
					"content": "И точно она! Фишль!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400701705,
					"content": "Вы уже тут, мои неосмотрительные вассалы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701706
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400701706,
					"content": "О, давно не виделись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701707
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400701707,
					"content": "Да вроде не так много и времени прошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701708
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701708,
					"content": "Мы с миледи почувствовали неладное, поэтому заранее появились здесь и с нетерпением ждали вас. Но мы не ожидали, что вы доберётесь так быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701709
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400701709,
					"content": "Похоже, Оз немного встревожен. Или Паймон это только кажется?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400701710,
					"content": "Нирвана Ночи скоро снизойдёт, поэтому мне нужно подготовиться к церемонии приветствия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701711
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400701711,
					"content": "Миледи, вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701712
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400701712,
					"content": "Я пойду одна, а ты, Оз, если устал от тьмы, то отдохни на стороне света.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701713
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400701713,
					"content": "Миледи, не надо меня прогонять. Я ваш вассал. Я ваши глаза. Вы не можете уйти без меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701714
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400701714,
					"content": "Не смотри на меня жалобными глазами. Сейчас не время что-либо объяснять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701715
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400701715,
					"content": "Ох, миледи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701716
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400701716,
					"content": "Господа, у миледи плохое настроение, поэтому простите её. Также простите меня, что должен вас оставить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701717
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400701717,
					"content": "Ха-ха, похоже, одиночество не слишком помогло Фишль взбодриться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701718
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400701718,
					"content": "Увидев Фишль, я подумала, что эта иллюзия каким-то образом будет связана с ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701719
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400701719,
					"content": "Когда я приблизился к своему миру грёз, на меня нахлынуло ощущение чего-то близкого и знакомого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701720
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400701720,
					"content": "Со мной было похоже. Хотя я не осознавала этого, но почувствовала, что вот-вот появится что-то интересное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701721
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701721,
					"content": "Если Фишль и Оз что-то чувствуют, значит, мы на верном пути. И Фишль так переживает, потому что не хочет встречаться со своим миром грёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701722
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400701722,
					"content": "И почему же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701723
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400701723,
					"content": "Возможно, в её мире грёз есть тайны, которые не должны знать посторонние.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701724
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400701724,
					"content": "Ребята, давайте сначала передохнём. Как только появится мир грёз, мы сразу всё узнаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				}
			]
		},
