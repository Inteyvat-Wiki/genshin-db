				"points": []
			},
			"dialogs": [
				{
					"id": 400701801,
					"content": "Мы уже сделали всё, что могли. Но, похоже, с двумя последними горами ничего нельзя поделать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400701802,
					"content": "Должен быть какой-то выход. Нужно просто подумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701803
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701803,
					"content": "Присмотревшись к горам на острове, я обнаружила, что их растительность и водные артерии связаны между собой и образуют единую систему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701804
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400701804,
					"content": "Но после того как горы рухнули, связь между растениями и водными артериями была утрачена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701805
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400701805,
					"content": "Если расчистить все русла, то водные артерии и растения снова воссоединятся и образуют огромный инструмент, о котором говорилось в записке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701806
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400701806,
					"content": "Тогда мы должны действовать. Стоит расспросить цветок. Он должен знать что-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Синь Янь"
				}
			]
		},
		{
