				"points": []
			},
			"dialogs": [
				{
					"id": 400700401,
					"content": "Некоторые растения и водные артерии повреждены. Ты не знаешь, как можно их восстановить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700402
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400700402,
					"content": "Я знаю, кто может помочь. Наверху живёт мой товарищ, Ледяное Сердце. Спроси у него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пламенное сердце"
				}
			]
		},
		{
			"id": 4007005,
			"completionStepIds": [
				4007005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007005",
							"2"
						],
						"stepId": 4007005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ледяное сердце",
					"Синь Янь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700501,
					"content": "Кто вы? Что вас сюда привело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700502
					],
					"speakerTitle": "Ледяное сердце"
				},
				{
					"id": 400700502,
					"content": "Привет, мы хотим попросить тебя помочь расчистить проходы у гор на острове.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700503
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400700503,
					"content": "Горы? Понимаю... Вы тоже хотите стать великими музыкантами, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700504
					],
					"speakerTitle": "Ледяное сердце"
				},
				{
					"id": 400700504,
					"content": "Что? А дело в этом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400700505,
					"content": "Всё верно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700506
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400700506,
					"content": "Значит, у нас общая цель. И хоть я слаба, но чувствую себя обязанной поделиться с вами частью своей силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700507
					],
					"speakerTitle": "Ледяное сердце"
				},
				{
					"id": 400700507,
					"content": "Вот, возьмите мой лепесток и посадите его в конечной точке пересечения мелодий. То, что погрузилось под землю, возродится вместе с музыкой. Ведь пока есть музыка, жизнь в мире будет продолжаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700508
					],
					"speakerTitle": "Ледяное сердце"
				},
				{
					"id": 400700508,
					"content": "Спасибо тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Синь Янь"
				}
			]
		},
		{
			"id": 4007010,
			"completionStepIds": [
				4007010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007010",
							"2"
						],
						"stepId": 4007010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Синь Янь",
					"Мона",
					"Каэдэхара Кадзуха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701001,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701002
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701002,
					"content": "Наконец-то это время настало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701003
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701003,
					"content": "Ребята, когда-то я загадала выступить с кем-нибудь неожиданным. И вот сегодня на этом острове я во всём разобралась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701004
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701004,
					"content": "Много лет назад кто-то превратил этот остров в огромный музыкальный инструмент. Никто не знает, как его звали и как он выглядел. Но он один из величайших музыкантов во всём Тейвате.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701005
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701005,
					"content": "Я и представить себе не могла, что увижу такой инструмент. Но больше всего меня поразило, что мы сможем сыграть на нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701006
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701006,
					"content": "Ты хочешь сыграть рок-н-ролл?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701007
					]
				},
				{
					"id": 400701007,
					"content": "Нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701008
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701008,
					"content": "Музыка - это дар одной души другой... Я хочу выбрать что-то, более созвучное стилю основателя этого места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701009
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701009,
					"content": "Сегодня никакого рок-н-ролла. Вместо этого вы увидите кое-что новенькое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701010
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701010,
					"content": "Фух.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701011
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701011,
					"content": "Ну как? По-моему, вышло неплохо, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701012
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701012,
					"content": "Более чем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701013
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400701013,
					"content": "Мне впервые довелось услышать подобное. Это было невероятно интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701014
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400701014,
					"content": "И так изящно! Паймон не знает, как это лучше назвать... но это было ни на что не похоже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701015,
						400701016
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400701015,
					"content": "Ты сыграла от души.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				},
				{
					"id": 400701017,
					"content": "Хи-хи, спасибо всем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701018
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701018,
					"content": "Похоже, моё желание исполнилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701019
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701019,
					"content": "У тебя ещё есть дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701020
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400701020,
					"content": "Нет. Думаю, сегодня я буду спать спокойно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701021
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701021,
					"content": "Кажется, ни у кого из нас нет срочных дел? Тогда у меня есть предложение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701022
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400701022,
					"content": "Я хочу снова отправиться в лагерь Фатуи, чтобы проверить там обстановку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701023
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400701023,
					"content": "Что? Значит, вы тоже наткнулись на лагерь Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701024
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400701024,
					"content": "Постой, ты тоже знаешь об этом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701025
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400701025,
					"content": "Конечно, я же гениальный астролог. Я не говорила, что моя чаша для гадания немного восстановилась? Я могу чувствовать, что происходит, с помощью гадания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701026
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400701026,
					"content": "А? Здесь тоже есть Фатуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701027
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701027,
					"content": "Да. Перед уходом Фишль, я и ей об этом рассказала. Если принцесса встретится с Фатуи, она спрячется, чтобы избежать опасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701028
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400701028,
					"content": "Ясно, тогда и нам стоит раскрыть карты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701029
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400701029,
					"content": "Вы подробно рассказываете о странном устройстве и лагере Фатуи, повстречавшемся вам в день высадки на остров...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400701030
					]
				},
				{
					"id": 400701030,
					"content": "Странное устройство, безумные Фатуи... Неужели всё это имеет отношение к истории с мирами грёз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701031
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400701031,
					"content": "Не факт. Но мне кажется, что всё-таки есть какая-то связь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701032
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400701032,
					"content": "Логично. Тогда давайте поскорее отправимся к лагерю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400701016,
					"content": "Очень красивая музыка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				}
			]
		},
		{
