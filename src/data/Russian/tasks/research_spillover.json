			},
			"dialogs": [
				{
					"id": 761380101,
					"content": "А... Госпожа Нефер! Вы пришли как раз вовремя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380102,
					"content": "Решились?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761380103,
					"content": "Э? О чём это вы? Неужели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380104,
					"content": "Я знаю, тебе давно хотелось навестить Детей Морозной Луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761380105,
					"content": "То есть ты хочешь сначала познакомиться с Люликки, чтобы эта дружба и стала поводом для визита к Детям Морозной Луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761380106,
					"content": "Вы... Вы всё знаете? Ах, я ведь держал это в тайне, почти никому не говорил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380107,
					"content": "Господин Сомпайнко, когда хранишь секрет, нужно уметь скрывать даже сам факт того, что держишь секрет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761380108,
					"content": "Иначе стена, что вы построили в голове, рано или поздно даст трещину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761380109,
					"content": "Эх, я никогда не умел скрывать свои мысли, даже когда жил в родном городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380110,
					"content": "Ладно, раз вы всё знаете, не могли бы вы помочь меня представить? Я ведь чужак, просто так к Люликки не подойти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380111,
					"content": "Дети Морозной Луны очень добрые, они тепло примут любого гостя, даже если он не человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761380112,
					"content": "Правда? Серьёзно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380113,
					"content": "Но всё равно будет лучше, чтобы вы меня представили. Вежливость превыше всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380114,
					"content": "Хорошо, они как раз закончили раздавать еду, отличный момент для разговора. Пойдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761380115,
					"content": "На этот раз платить не нужно, я просто случайно оказалась рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761380116,
					"content": "Спасибо, госпожа Нефер! Я сейчас же соберу вещи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сомпайнко"
				}
			]
		},
