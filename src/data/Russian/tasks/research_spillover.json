			"dialogs": [
				{
					"id": 761380201,
					"content": "Госпожа Нефер? Господин Сомпайнко, у вас какое-то дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380202
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761380202,
					"content": "Наш гость из Натлана, похоже, хочет навестить Детей Морозной Луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380203
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761380203,
					"content": "Но из-за правил приличия он предпочёл, чтобы кто-нибудь его представил. Прошу, господин Сомпайнко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380204
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761380204,
					"content": "Здравствуйте, госпожа Люликки! Рад вас видеть. Э-э-э... Это образец окаменелости из Натлана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380205
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380205,
					"content": "Спасибо, господин Сомпайнко. Но я уже давно знаю вас, не нужно так церемониться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380206
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761380206,
					"content": "А? Как вы заметили меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380207
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380207,
					"content": "Когда я раздавала еду, вы рядом ходили, наблюдали. Кружили вокруг, но не вставали в очередь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380208
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761380208,
					"content": "Я подумала, что вы тоже хотите взять, но стесняетесь, поэтому оставила специально для вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380209
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761380209,
					"content": "Но вы никогда ничего не брали. Если бы вы сегодня не пришли, мне пришлось бы кого-то просить уточнить, нужна ли вам помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380210
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761380210,
					"content": "Э... э... простите, я не знал, как можно обратиться к вам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380211
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380211,
					"content": "Так что, госпожа Люликки? Могу я заглянуть к Детям Морозной Луны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380212
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380212,
					"content": "Конечно. У нас и так есть несколько гостей из других мест. Но зачем вам это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380213
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761380213,
					"content": "Я хотел бы сделать несколько фотографий и заметок, просмотреть некоторые записи и, если возможно... расспросить кого-нибудь о местных легендах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380214
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380214,
					"content": "Я из Ассоциации реликвий заврианов в Натлане. Если смогу собрать что-нибудь по своей теме, это будет просто идеально!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380215
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380215,
					"content": "О... То есть вы хотите почитать архивы? Хмм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380216
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761380216,
					"content": "Раз вы уже познакомились, на этом задание можно считать выполненным. Мне пора уходить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380217
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761380217,
					"content": "Спасибо, госпожа Нефер! Я всё равно оплачу ваши услуги, нельзя же, чтобы вы зря пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380218
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761380218,
					"content": "Как вам угодно, господин Сомпайнко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380219
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761380219,
					"content": "Тогда я прощаюсь. Желаю вам приятной беседы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нефер"
				}
			]
		}
	]
}