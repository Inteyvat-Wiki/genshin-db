			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вермеер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350101,
					"content": "Это не то, и это тоже не то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350102
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350103
					]
				},
				{
					"id": 413350103,
					"content": "О, здравствуй. Я всё пытаюсь поймать вдохновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350104
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350104,
					"content": "Поскольку наступил Праздник морских фонарей, я задумал написать картину праздничного Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350105
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350105,
					"content": "Ах... Не знаю, дело в моей технике, или в чём-то ещё, но... Что бы я ни делал, каждый раз выходит не то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350106
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350106,
					"content": "Может, смена обстановки придала бы мне вдохновения, но найти место получше просто не выходит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350107
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350107,
					"content": "#Скажи, путешественни{F#ца}{M#к}, знаешь ли ты места, достойные полотна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350108
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350108,
					"content": "Для этого нам придётся походить по окрестностям.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350109
					]
				},
				{
					"id": 413350109,
					"content": "Хм... Ладно, давай осмотримся. Вдруг найдём какой-нибудь живописный уголок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вермеер"
				}
			]
		},
		{
			"id": 4133503,
			"completionStepIds": [
				4133503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133503",
							"2"
						],
						"stepId": 4133503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цин Чжоу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350301,
					"content": "Здесь открывается неплохой вид. Ой, а это кто?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350302
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350302,
					"content": "Цин Чжоу, к вашим услугам. Я имею смелость считать себя поэтом. А вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350303
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 413350303,
					"content": "Ха-ха, поэт, значит? А я художник. Сейчас я занят поисками вдохновения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350304
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350304,
					"content": "Вот так совпадение, меня привела сюда та же цель. Позволь поинтересоваться, для чего тебе понадобилось искать вдохновение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350305
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 413350305,
					"content": "#Я хотел бы написать картину гавани Ли Юэ во время Праздника морских фонарей, а путешественни{F#ца}{M#к} помогает мне найти живописное место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350306
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350306,
					"content": "А зачем ищешь вдохновение ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350307
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350307,
					"content": "Право, любопытное совпадение... Я намереваюсь написать стихотворение о Ли Юэ и Празднике морских фонарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350308
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 413350308,
					"content": "Вот как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350309
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350309,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350310
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 413350310,
					"content": "Стихотворение?.. Разве можно уместить великолепие гавани и этого праздника в несколько строк?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350311
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350311,
					"content": "Хех, как по мне, передать всё это может только великолепная картина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350312
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350312,
					"content": "Картина, говоришь? Хе-хе, а мне кажется, такое под силу лишь перу и чернилам. Очарование Праздника морских фонарей и атмосферу гавани ни за что не запечатлеть на какой-то там картине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350313
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 413350313,
					"content": "Более того, огромную и величественную землю Ли Юэ в рамки картины не уместить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350314
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 413350314,
					"content": "Ха-ха, думаю, картина будет лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350315
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350315,
					"content": "Хе-хе, а мне кажется, будет лучше стихотворение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350316
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 413350316,
					"content": "Ребята, успокойтесь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350317
					]
				},
				{
					"id": 413350317,
					"content": "Спорами мы ничего не добьёмся. Я предлагаю разойтись и заняться своими работами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350318
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350318,
					"content": "А готовые творения мы выставим на суд публике. Как тебе такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350319
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350319,
					"content": "Вызов принят. Я буду ждать тебя вместе с готовой картиной на постоялом дворе «Ваншу». Там мы найдём тех, кто нас рассудит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350320
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 413350320,
					"content": "Значит, договорились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350321
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350321,
					"content": "Договорились. Засим позвольте откланяться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350322
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 413350322,
					"content": "Хвастун и бесстыдник, вот он кто. Втиснуть такой праздник и всю гавань в пару строк, ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350323
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350323,
					"content": "Я нарисую ему такую картину, что он признает себя побеждённым лишь взглянув на неё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350324
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350324,
					"content": "Мне нужно будет приложить все усилия... И надо бы особым образом подготовить кисти и краски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350325
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350325,
					"content": "#Путешественни{F#ца}{M#к}, ты готов{F#а} совершить подвиг во имя искусства, собрав для меня специальные материалы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350326,
						413350328
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350326,
					"content": "#Всегда готов{F#а}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350327
					]
				},
				{
					"id": 413350327,
					"content": "Благодарю. Так, дай подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350329
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350329,
					"content": "Хм... Точно! Мне понадобится нектар Пиро попрыгуньи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350330
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350330,
					"content": "С его помощью я приготовлю совершенно особенные краски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350328,
					"content": "Какие материалы тебе нужны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350329
					]
				}
			]
		},
		{
			"id": 4133505,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
