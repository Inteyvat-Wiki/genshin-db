			},
			"dialogs": [
				{
					"id": 413350501,
					"content": "Ха, я этого поэта заставлю плакать! От изумления, конечно же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вермеер"
				}
			]
		},
		{
			"id": 4133507,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133507",
							"2"
						],
						"stepId": 4133507,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"4133507"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вермеер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350701,
					"content": "Ну что, удалось добыть нектар попрыгуньи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350702
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350702,
					"content": "Вот он.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350703
					]
				},
				{
					"id": 413350703,
					"content": "Дай посмотреть... Да, то что надо. А пахнет как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350704
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350704,
					"content": "Когда краска будет готова, останется только отыскать место с красивым видом, и тогда можно будет приступать к созданию шедевра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350705
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350705,
					"content": "Вот увидит этот поэт мою картину и будет визжать, как маленькая девчонка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350706
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350706,
					"content": "Ах да! По традиции на Праздник морских фонарей нужно запускать небесные фонари. А ещё на них желания пишут... Верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350707
					],
					"speakerTitle": "Вермеер"
				},
				{
					"id": 413350707,
					"content": "Хе-хе, я небесный фонарь уже приготовил. Что до желания... Его я не скажу, а то не сбудется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350708
					],
					"speakerTitle": "Вермеер"
				},
