							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Квиспи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910301,
					"content": "Ого! Получилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910302,
					"content": "Камень сокровищ, потрясающий... Подожди, это же ты положил их на камень сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910303,
					"content": "...Ха, хе-хе, я бы не стал делать ничего подобного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910304
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910304,
					"content": "Благодаря камням, которые вы нашли, камень сокровищ ожил. О, слышите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910305
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910305,
					"content": "Этот звук был похож на пульсацию магмы, что бьётся в земле, словно... пульс сердца...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910306
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910306,
					"content": "Значит, я правильно сделал, что скормил ему другие камни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910307
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910307,
					"content": "Хм, ничего не слышно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910308,
					"content": "#{NICKNAME}, ты что-нибудь {F#слышала}{M#слышал}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910309,
						750910311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910309,
					"content": "Кажется, это обычный камень...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910310
					]
				},
				{
					"id": 750910310,
					"content": "Так и есть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910313,
					"content": "#Хе-хе, {F#чужеземцы}{M#чужеземки}... О, мои уважаемые гости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910314
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910314,
					"content": "Пожалуйста, принесите мне ещё камней. Ещё красивее и лучше... Верьте в камень сокровищ - он не подведёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910315
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910315,
					"content": "Я чувствую, я чувствую. Это наверняка пойдёт ему на пользу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910316
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910316,
					"content": "Такое ощущение, что нас заманивают в ловушку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910317,
					"content": "#Что думаешь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910318,
					"content": "Если бы можно было достать камни получше...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910319
					]
				},
				{
					"id": 750910319,
					"content": "Это того стоит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910320,
					"content": "Хе-хе, тогда соберите для меня камни получше, поторопитесь... О, лучшие камни, да... Сила камня сокровищ непременно возрастёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910311,
					"content": "Камень сокровищ кричит: «А-а-а-а!»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910312
					]
				},
				{
					"id": 750910312,
					"content": "Не может быть! Опять пытаешься напугать Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7509104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7509104",
