					"Квиспи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910501,
					"content": "Да, из него действительно выросли более качественные камни. Уже во второй раз, но это всё равно похоже на волшебство...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910502,
					"content": "#Хе-хе, подозрительные {F#чужеземки}{M#чужеземцы}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910503
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910503,
					"content": "Теперь вы понимаете, насколько велика сила камня сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910504
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910504,
					"content": "Да-да, камень сокровищ... Он становится сильнее благодаря камням, которые вы принесли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910505
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910505,
					"content": "Интересно, во что он в итоге превратится?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910506
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910506,
					"content": "По правде говоря, даже Паймон стало любопытно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910507,
					"content": "Что же это такое? Как так получается, что, съев камень, он выплёвывает камень получше? Может, откроем его и посмотрим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910508,
					"content": "Что? Что вы такое говорите? Не позволю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910509
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910509,
					"content": "Вы... вы откроете его только через мой труп!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910510
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910510,
					"content": "Просто мысли вслух.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910511,
					"content": "Хм, учитывая, что вы принесли камни, я прощаю вас на этот раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910512
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910512,
					"content": "Хорошо-хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910513,
					"content": "Я чувствую. Нужно скормить ещё более качественный камень, и тогда камень сокровищ произведёт что-то невероятное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910514
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910514,
					"content": "#{F#Чужеземка}{M#Чужеземец}, один торговец говорил, что в пустыне есть особый камень необыкновенной силы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910515
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910515,
					"content": "Он называется... Вспомнил, он называется тришираит. Если получится принести его, и я скормлю его камню сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910516
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910516,
					"content": "Конечно, обязательно получится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910517
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910517,
					"content": "#Что думаешь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910518
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910518,
					"content": "Думаю, можно попробовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910519
					]
				},
				{
					"id": 750910519,
					"content": "Интересно, что же будет дальше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910520,
					"content": "П-пожалуйста, принеси мне тришираит. Одного будет достаточно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Квиспи"
				}
			]
		},
