			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Квиспи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910401,
					"content": "Хм... Нужно быть терпеливым. Когда наступит тишина, я скормлю их камню сокровищ... Хе-хе, спасибо, что принесли мне камни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910402
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910402,
					"content": "Обязательно вырасти лучшие камни, камень сокровищ. Хе-хе, один... один, два...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Квиспи"
				}
			]
		},
		{
			"id": 7509105,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
