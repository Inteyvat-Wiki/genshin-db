			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Квиспи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910201,
					"content": "Хм... Нужно быть терпеливым. Когда всё утихнет, я скормлю их камню сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910202
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910202,
					"content": "Через некоторое время у вас будут камни получше. Хе-хе, раз... раз... два...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Квиспи"
				}
			]
		},
		{
			"id": 7509103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
