			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Квиспи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910101,
					"content": "Один, два, хм, три...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910102
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910102,
					"content": "Хм, хм, один... два...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910103
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910103,
					"content": "Ого, какой странный человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910104,
					"content": "#Странные здесь только вы, {F#чужеземки}{M#чужеземцы}. Кхе-кхе, чужакам здесь не место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910105
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910105,
					"content": "Это какое-то запретное место... или святилище?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910106,
					"content": "Нет, это место сокровищ, которое я обнаружил случайно. Подойдите поближе, слышите? Это особый камень... Камень сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910107
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910107,
					"content": "Звук, который он издаёт, похож на тихий стон, почти как дыхание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910108,
						750910110
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910108,
					"content": "Быть камнем - тяжкий труд.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910109
					]
				},
				{
					"id": 750910109,
					"content": "Это всего лишь дыхание, что ещё за тяжкий труд?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910112,
					"content": "Камни... Камни могут дышать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910113,
					"content": "Он не только дышит. Если приложить к нему ухо и хорошенько прислушаться, то можно услышать ритмичное движение. Будто камни трутся друг о друга под этой грубой оболочкой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910114
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910114,
					"content": "Хе-хе, какой приятный звук.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910115
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910115,
					"content": "А ещё, если скормить ему маленькие камни, то он произведёт ещё более красивые камни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910116
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910116,
					"content": "Невероятно, правда? Посмотри на эти самоцветы... Один, два...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910117
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910117,
					"content": "Значит, ты считал камни, когда мы пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910118,
					"content": "Да, и я чувствую, что, съев разные камни, этот драгоценный камень стал сильнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910119
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910119,
					"content": "Это настоящее чудо! Это камень сокровищ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910120,
						750910121
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910120,
					"content": "Звучит неправдоподобно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910122,
					"content": "#Хе-хе, я и не ожидал, что вы, {F#чужеземки}{M#чужеземцы}, в это поверите. Никто не поверит, пока не попробует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910123
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910123,
					"content": "Я обнаружил это, когда случайно положил собранную руду рядом с камнем сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910124
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910124,
					"content": "Придумал! Попробуйте сами, и вы поверите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910125
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910125,
					"content": "Он уже съел все камни поблизости. Нужно принести другие, но я не могу отправиться на поиски...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910126
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910126,
					"content": "А? Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910127,
					"content": "Потому! Потому что мне нельзя спускать глаз с камня сокровищ. Как только я отойду, он тут же забурится в землю. И что мне тогда делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910128
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910128,
					"content": "Я уже давно стою здесь на страже... и скормил ему все камни, которые у меня были...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910129
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910129,
					"content": "Принесите новые камни, а я скормлю их ему. Вы сами всё увидите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910130
					],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910130,
					"content": "Хм, похоже на обман...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910131,
					"content": "#Что скажешь, {NICKNAME}? Попробуем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750910132,
					"content": "Похоже, это самый обычный камень...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910133
					]
				},
				{
					"id": 750910133,
					"content": "Хе-хе, соберите несколько камней и отдайте их мне... Камень сокровищ наверняка произведёт что-то получше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Квиспи"
				},
				{
					"id": 750910121,
					"content": "Похоже на обман...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910110,
					"content": "Я тоже дышу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910111
					]
				},
				{
					"id": 750910111,
					"content": "В умении дышать нет ничего особенного. Нечем тут хвастаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7509102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
