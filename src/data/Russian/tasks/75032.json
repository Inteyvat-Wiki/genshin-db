					"Маньойя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320801,
					"content": "Задача оказалась не так проста?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320802
					],
					"speakerTitle": "Маньойя"
				},
				{
					"id": 750320802,
					"content": "#Наш командир пришёл бы в ярость, узнай он, что {F#первая встречная искательница}{M#первый встречный искатель} приключений обогнал{F#а} наездника из лётного отряда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320803
					],
					"speakerTitle": "Маньойя"
				},
				{
					"id": 750320803,
					"content": "#Ладно, не расстраивайся. Я должна быть благодарна, что ты сохранил{F#а} мне лицо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320804
					],
					"speakerTitle": "Маньойя"
				},
				{
					"id": 750320804,
					"content": "Ты тоже свободно чувствуешь себя в небе. Но чтобы обогнать меня, нужно ещё постараться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320805
					],
					"speakerTitle": "Маньойя"
				},
				{
					"id": 750320805,
					"content": "#Если хочешь, попробуй ещё раз? Пока ты молод{F#а}, не останавливайся, даже если проиграл{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Маньойя"
				}
			]
		},
