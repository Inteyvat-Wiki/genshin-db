				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110101,
					"content": "Приветики!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110102,
					"content": "#{NICKNAME}, Паймон, вы пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110103
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110103,
					"content": "Только о вас подумал, вы сразу и пришли. Как удачно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110104
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110104,
					"content": "Кэйа, ты домашнее задание сделал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110105,
					"content": "Не хочется тебя расстраивать, но я даже ещё не начинал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110106
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110106,
					"content": "Ученик, который не делает домашнее задания, - это плохой ученик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110107
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110107,
					"content": "А чем же Кэйа занимался вместо того, чтобы делать домашнее задание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110108,
					"content": "Ну, видите ли, я помогал магистру Джинн с разными делами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110109
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110109,
					"content": "Во время праздника в Мондштадте очень людно, а потому и дел тоже навалилась куча. Давно уже этим занимаюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110110
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110110,
					"content": "#{NICKNAME}, можно попросить тебя помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110111
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110111,
					"content": "Один мой собутыльник попросил о помощи, но у меня совсем нет времени... Могу ли я доверить это дело тебе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110112
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110112,
					"content": "Собутыльник? Ты его в таверне встретил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110113
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110113,
					"content": "Да. Иногда после службы я захожу пропустить стаканчик-другой и как-то невольно завожу новые знакомства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110114
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110114,
					"content": "Его зовут Нимрод, и он вечно шатается у таверны. Сейчас он, наверное, как раз свободен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110115
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110115,
					"content": "Мне надо делать домашнее задание, так что я рассчитываю на тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110116,
						414110117
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110116,
					"content": "Удачи с учёбой, Кэйа.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 414110117,
					"content": "Будем считать это частью ознакомления с праздником.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
