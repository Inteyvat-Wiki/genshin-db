				"objectNames": [
					"Нимрод"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110301,
					"content": "Спасибо вам! Спасибо большое! Теперь я смогу приступить к работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110302
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414110302,
					"content": "Помни, что подарок - это не всё! К жене надо относиться хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110303,
					"content": "Да, конечно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110304
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414110304,
					"content": "Эх, надеюсь ей понравится мой подарок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110305
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414110305,
					"content": "Все любят подарки от чистого сердца. Не волнуйся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110306
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110306,
					"content": "Постарайся уж как следует! Эти материалы было не так просто достать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4141105,
			"completionStepIds": [
				4141105
			],
