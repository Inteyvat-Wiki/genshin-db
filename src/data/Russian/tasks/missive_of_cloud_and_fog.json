				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нимрод"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414111401,
					"content": "Эх, что же делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111402
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414111402,
					"content": "Ты, наверное, Нимрод? Кэйа сказал, что у тебя к нему какое-то дело. Он сейчас занят, но мы можем тебе помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111403,
					"content": "#Что? Ах, путешественни{F#ца}{M#к}... Не думал, что придёшь именно ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111404
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414111404,
					"content": "Дело в том, что я собирался сделать своей жене подарок на Праздник ветряных цветов и хотел, чтобы мой приятель Кэйа помог мне с выбором подарка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111405
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414111405,
					"content": "Эм... Я... у меня проблемы с алкоголем. Я постоянно напиваюсь в таверне. Жена запрещает мне пить, и мы из-за этого вечно ругаемся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111406
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414111406,
					"content": "Так ты просто алкаш...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111407,
					"content": "Я всё понимаю, я тоже не против выпить... Не мне судить, конечно, но то, как ты пьёшь... Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111408
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111408,
					"content": "Знаю, знаю... Она, конечно, права. И я должен извиниться перед ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111409
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414111409,
					"content": "#Путешественни{F#ца}{M#к}, можешь помочь мне найти некоторые материалы? Я хочу сделать подарок для жены своими руками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111410
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414111410,
					"content": "По правде говоря, я их сам должен был собрать, но я был в запое. Когда протрезвел, праздник уже начался! Теперь я один точно никак не успею...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111411
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414111411,
					"content": "Ох, ну и бардак у него в голове...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111412,
					"content": "Неженатые мондштадтцы никогда бы не решились попросить кого-то о помощи во время праздника. Хорошо, что ты уже женат, Нимрод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111413
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111413,
					"content": "Хех, ты говоришь... Эх, простите. Опять я выставляю себя посмешищем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111414
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414111414,
					"content": "Что поделать. Рассказывай давай, чем тебе помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111415,
					"content": "Я поищу доски в городе, а для наполнения нужны цветы. Они растут за городом, сможете принести их мне? Мне нужно две травы-светяшки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111416
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414111416,
					"content": "Трава-светяшка и доски... Что из этого можно сделать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111417,
					"content": "Хочу сделать для неё деревянный домик со светящимися цветочками и маленькой мебелью внутри...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111418
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414111418,
					"content": "Какой нежный подарок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111419
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111419,
					"content": "Напоминание о моей любви, ха-ха... Когда мы только познакомились, я часто делал для неё такие подарки... Они ей очень нравились, и она даже говорила, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111420
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414111420,
					"content": "А! Эм, простите. Хватит о прошлом. Спасибо за вашу помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111421
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 414111421,
					"content": "Считай, тебе повезло, что встретил таких добрых помощников, ага?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111422,
					"content": "Ладно, пойдём найдём эти материалы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
