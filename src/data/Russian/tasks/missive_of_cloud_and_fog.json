			},
			"dialogs": [
				{
					"id": 414111501,
					"content": "Венти, наверное, уже здесь. Давай внутри посмотрим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111502,
					"content": "Постойте! Какова цель вашего визита?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111503
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 414111503,
					"content": "Кэйа тут? У нас к нему дельце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111504,
					"content": "Капитан Кэйа? Он дежурит в кабинете магистра Джинн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111505
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 414111505,
					"content": "А? А почему в кабинете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111506,
					"content": "Ордо Фавониус всегда отвечал за Праздник ветряных цветов. Во время празднования магистр Джинн лично отправляется в дозор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111507
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 414111507,
					"content": "А её административную работу в это время выполняет капитан Кэйа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111508
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 414111508,
					"content": "Ах вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4141199,
