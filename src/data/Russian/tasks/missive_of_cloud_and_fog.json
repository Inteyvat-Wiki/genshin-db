					"Кэйа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110501,
					"content": "Вы вернулись! Кэйа, ты закончил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110502,
					"content": "Передаём тетрадки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110503
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110503,
					"content": "С возвращением. Я как раз почти закончил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110504
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110504,
					"content": "Давай-давай сдавай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110505,
					"content": "Всё-всё... Только не смейтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110506
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110506,
					"content": "Хм... Хм? О-о-о..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110507
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110507,
					"content": "Ну как, бродяжка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110508,
					"content": "Кэйа, можно я вслух прочитаю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110509
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110509,
					"content": "Пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110510
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110510,
					"content": "Гхм-гхм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110511
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110511,
					"content": "«Mi muhe ye\\nНа хиличурлов языке\\nЗначит \"я тебя люблю\"».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110512
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110512,
					"content": "А? А-а?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110513,
					"content": "Всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110514
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110514,
					"content": "Всё?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110515,
					"content": "Идея ясна и чётко выражена. Длина, думаю, в самый раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110516
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110516,
					"content": "Чего?! Тебя языку хиличурлов учили, что ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110517,
						414110518
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110517,
					"content": "Нелепица. Где же про любовь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110519
					]
				},
				{
					"id": 414110519,
					"content": "Ха-ха-ха! Любовные стихи должны отражать стиль автора, ведь так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110520
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110520,
					"content": "Больше похоже на отписку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110521
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110521,
					"content": "А Кэйа, оказывается, знает хиличурлский? Очень странно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110522
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110522,
					"content": "Ха-ха, не стоит недооценивать багаж знаний капитана кавалерии Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110523
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110523,
					"content": "Ладно, пора собрать остальные работы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110524
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110524,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110525
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110525,
					"content": "#Похоже, я заметил кого-то подозрительного. Пойду проверю. Путешественни{F#ца}{M#к}, я должен попросить тебя ещё кое о чём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110526
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110526,
					"content": "Церковь подала заявление на получение охотничьего разрешения. Можешь отнести эти документы в собор?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110527
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 414110527,
					"content": "Опять мы на побегушках!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110518,
					"content": "Замечательно. Ты многому научился.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110519
					]
				}
			]
		},
		{
			"id": 4141107,
			"completionStepIds": [
				4141107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
