						414111002
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414111002,
					"content": "Стой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111003
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 414111003,
					"content": "Розария! Я только что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111004
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414111004,
					"content": "Успокойся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111005
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 414111005,
					"content": "Я только что встретила на улице Джинн. Лиза тоже с ней. Всё будет хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111006
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 414111006,
					"content": "Ах! Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111007
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414111007,
					"content": "Фуф...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111008
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414111008,
					"content": "М?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111009
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 414111009,
					"content": "Письмо. Дай его мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111010
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 414111010,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111011
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111011,
					"content": "Если это не про Джинн... То о чём же говорится в письме?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111012
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414111012,
					"content": "Ты думала, что кто-то может закопать Джинн?! Ужас какой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111013
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111013,
					"content": "Сестра, у тебя есть какие-нибудь зацепки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111014
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111014,
					"content": "Судя по карте, преступник изобразил местность рядом с винокурней «Рассвет».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111015
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 414111015,
					"content": "Место открытое, и спрятать там что-то... Что же это может быть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111016
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 414111016,
					"content": "Ого! С первого взгляда разобралась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111017
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111017,
					"content": "Но... винокурня «Рассвет»? Это совсем не там, где мы думали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111018
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111018,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111019
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414111019,
					"content": "Барбара, хватит стоять здесь и фантазировать - пора смело встретиться со своим страхом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111020
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 414111020,
					"content": "Ты права... Просто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111021
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414111021,
					"content": "Ха-ха, страшновато, да? Поэтому мы пойдём с тобой. Что скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111022
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111022,
					"content": "А? Вы такие добрые...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111023
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414111023,
					"content": "А ты, сестра? Пойдёшь с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111024
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111024,
					"content": "Нет надобности... Я сразу поняла, что волноваться не о чем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111025
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 414111025,
					"content": "А? В смысле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111026
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111026,
					"content": "Ничего. Идите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111027
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 414111027,
					"content": "Барбара, тебе уже лучше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111028
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111028,
					"content": "Угу! Я... Я в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111029
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414111029,
					"content": "Розария права. Лучше узнать, что задумал преступник, чем пугать саму себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111030
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414111030,
					"content": "Вот именно! Пойдём скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111031
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111031,
					"content": "Спасибо вам всем. Пойдём в отмеченное место и всё узнаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111032
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414111032,
					"content": "Да! Давай, Барбара, вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4141113,
			"completionStepIds": [
				4141113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141113",
							"2"
						],
						"stepId": 4141113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Барбара"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414111302,
					"content": "Что это? Давайте скорее откроем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111303,
					"content": "Я... Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111304
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414111304,
					"content": "Интересно... Такая изысканная коробка. Как она оказалась в таком захолустье?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111305
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111305,
					"content": "...А?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111306
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414111306,
					"content": "Ух ты, какой красивый венок из ветряных астр! И так много бумажных звёздочек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111307,
						414111308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111307,
					"content": "Это розыгрыш?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				},
				{
					"id": 414111309,
					"content": "Похоже, что «преступником» оказался один из поклонников Барбары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111310
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111310,
					"content": "Тут записка! Что же тут написано? Сейчас посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111311,
					"content": "«Простите, что привлекаю ваше внимание таким способом. Пожалуйста, примите эти анемонии, как символ моего преклонения перед вашей добродетелью и очарованием».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111312,
					"content": "Что? То есть это... поддельное запугивание, получается?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111313,
					"content": "Неважно кому, божеству или любимому человеку, цветы должны подноситься с высшей искренностью. Это самая важная церемония Праздника ветряных цветов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111314
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111314,
					"content": "Чтобы подарить цветы любви и счастья в этот особенный день, нельзя скупиться в средствах для привлечения внимания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111315
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111315,
					"content": "За сомнительным способом скрывается тщательно подготовленный и искренний подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111316
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111316,
					"content": "Эм... Немного перегибаешь, нет? Паймон всё равно кажется, что у кого-то чердак не в порядке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111317,
					"content": "Ха-ха-ха, может быть. Думаю, я знаю, кто подходит под твоё описание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111318
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111318,
					"content": "Кого ты имеешь в виду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111319,
					"content": "(Думаю, я тоже знаю.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111320
					]
				},
				{
					"id": 414111320,
					"content": "Тсс! Не говори пока. Пусть Паймон попробует угадать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111321
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414111321,
					"content": "А?! Как ты надоел!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414111308,
					"content": "Кто-то просто добивается твоего внимания?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				}
			]
		},
		{
			"id": 4141114,
			"completionStepIds": [
				4141114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141114",
							"2"
						],
						"stepId": 4141114,
						"stateName": "QUEST_STATE_UNFINISHED"
