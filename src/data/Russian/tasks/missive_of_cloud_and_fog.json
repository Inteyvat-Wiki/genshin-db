			},
			"dialogs": [
				{
					"id": 414110801,
					"content": "Барбара, Кэйа попросил нас отнести...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110802,
					"content": "Это уже слишком! Это ужасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110803
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 414110803,
					"content": "Как же так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110804
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414110804,
					"content": "Э?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110805,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110806
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110806,
					"content": "Я... получила письмо... Там говорится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110807
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414110807,
					"content": "Давай я. Я только вернулся из пустошей и как обычно пришёл в собор, чтобы сёстры меня перевязали, но тут выбежала вся побледневшая Барбара с письмом в руке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110808
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 414110808,
					"content": "Первый раз такое письмо получаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110809
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414110809,
					"content": "Можно я взгляну?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110810
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110810,
					"content": "«Дорогая Барбара, я украл самую дорогую тебе вещь и закопал её...»\\nНеужели это шантаж?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110811
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110811,
					"content": "Возмутительно... Это розыгрыш? Если розыгрыш, то ладно, но вдруг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110812
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 414110812,
					"content": "Вдруг... это правда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110813
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414110813,
					"content": "Здесь сзади карта. Похоже, это за городом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110814
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110814,
					"content": "Украл самую дорогую тебе вещь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110815
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 414110815,
					"content": "И закопал её...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110816
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110816,
					"content": "Место на карте выглядит знакомым, я точно там бывал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110817
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 414110817,
					"content": "Какая вещь для тебя самая дорогая?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110818
					]
				},
				{
					"id": 414110818,
					"content": "Я так растеряна, что не могу сообразить... А!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110819
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414110819,
					"content": "Сейчас вспомню... Сейчас вспомню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110820
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 414110820,
					"content": "Самая дорогая мне вещь... Постойте... Неужели?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110821
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 414110821,
					"content": "Барбара! Эй, стой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110822
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414110822,
					"content": "А! Я понял! Это храм Тысячи ветров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110823
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 414110823,
					"content": "Эй, Беннет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110824
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414110824,
					"content": "И чего они разбежались? Давайте догоним их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
