			"dialogs": [
				{
					"id": 751780901,
					"content": "#Привет, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780902,
						751780903
					],
					"speakerTitle": "???"
				},
				{
					"id": 751780902,
					"content": "У тебя плохое настроение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780904
					]
				},
				{
					"id": 751780904,
					"content": "Понимаете... Раньше вода в горячем источнике была теплее. Кажется, теперь у меня настоящие неприятности. Что же мне делать, когда я вернусь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780905
					],
					"speakerTitle": "???"
				},
				{
					"id": 751780905,
					"content": "Не переживай, нужно ещё немного подождать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780906
					]
				},
				{
					"id": 751780906,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 751780903,
					"content": "Увидимся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780907
					]
				},
				{
					"id": 751780907,
					"content": "#Береги себя, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
