			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лоштс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751780501,
					"content": "#Как дела, {F#воительница}{M#воин} из чужих земель? Далеко ли вы продвинулись в поисках «сильнейшего»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780502,
						751780503
					],
					"speakerTitle": "Лоштс"
				},
				{
					"id": 751780502,
					"content": "Расскажи мне, где находится «сильнейший»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780504
					]
				},
				{
					"id": 751780504,
					"content": "Поднявшись в горы, вы обнаружите место, где в изобилии текут «Воды Накала»... И там, быть может, вы найдёте следы «сильнейшего».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лоштс"
				},
				{
					"id": 751780503,
					"content": "Мы ещё в процессе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780505
					]
				},
				{
					"id": 751780505,
					"content": "Прекрасно, прекрасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лоштс"
				}
			]
		},
