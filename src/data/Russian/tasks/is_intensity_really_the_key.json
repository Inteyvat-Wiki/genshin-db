					"nextDialogs": [
						751781804,
						751781806
					],
					"speakerTitle": "Лоштс"
				},
				{
					"id": 751781804,
					"content": "Хорошо, чуть позже запишусь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781805
					]
				},
				{
					"id": 751781805,
					"content": "#Прекрасно! Прекрасно! Наконец я увижу {M#легендарного воина}{F#легендарную воительницу} в деле!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
