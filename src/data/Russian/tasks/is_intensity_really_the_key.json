					"nextDialogs": [
						751781802,
						751781808
					],
					"speakerTitle": "Лоштс"
				},
				{
					"id": 751781802,
					"content": "Ты обо мне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781803
					]
				},
				{
					"id": 751781803,
					"content": "Да, именно о тебе! Что скажешь? Примешь участие в испытании воина? Тебе нужно только записаться у мастера. Я возлагаю на тебя большие надежды!",
