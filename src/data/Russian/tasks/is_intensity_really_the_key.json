			"dialogs": [
				{
					"id": 751781001,
					"content": "Гм, мы пообещали, что поможем... Но с чего начать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781002,
						751781005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751781002,
					"content": "Может, воспользуемся чудесными свойствами флогистона?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781003
					]
				},
				{
					"id": 751781003,
					"content": "Р-р?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781004
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781004,
					"content": "Это не сработает! Источник слишком большой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751781009,
					"content": "Эх... Неужели нет никакого реального способа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781010
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751781010,
					"content": "Р-р?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781011
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781011,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, стой! Прекрати бегать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751781005,
					"content": "Скорее всего, в вулкане полно магмы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781006
					]
				},
				{
					"id": 751781006,
					"content": "Паймон поняла! Наш малыш пророет тоннель к вулкану, мы возьмём там немного магмы и нагреем источник? Отличная идея...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781007
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751781007,
					"content": "Р-р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781008,
					"content": "#...Стоп! Это очень опасно! Прекрати шутить свои шутки! Смотри, {REALNAME[ID(2)|SHOWHOST(true)]} тебе поверил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "Паймон"
				}
			]
		},
