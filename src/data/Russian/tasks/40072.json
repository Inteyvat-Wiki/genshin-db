				"objectNames": [
					"Леон",
					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721001,
					"content": "Как хорошо, что здесь кто-то... А? Опять вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721002
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400721002,
					"content": "Это мы должны у тебя спрашивать. Опять ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				}
			]
		},
		{
			"id": 4007213,
			"completionStepIds": [
				4007213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007213",
							"2"
						],
						"stepId": 4007213,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
