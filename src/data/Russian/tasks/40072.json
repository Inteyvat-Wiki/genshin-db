					"Рассказчик",
					"Синь Янь",
					"Каэдэхара Кадзуха",
					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720401,
					"content": "«Однако тёмная мгла надвигалась на Нирвану Ночи. Злобный дракон Таслак проник в недра земли, пересёк океан и направился к вершине башни».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720402
					],
					"speakerTitle": "Рассказчик"
				},
				{
					"id": 400720402,
					"content": "Дракон? Может, просто погода испортилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720403
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400720403,
					"content": "Дракон... Какая-то метафора?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720404
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400720404,
					"content": "Возможно, все, кто не поддерживал Фишль и пытался разрушить её фантазии, и предстали в образе заклятого врага - Злобного дракона Таслака.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				}
			]
		},
		{
			"id": 4007210,
			"completionStepIds": [
				4007210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
