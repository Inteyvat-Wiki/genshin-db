			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каэдэхара Кадзуха",
					"Синь Янь",
					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721301,
					"content": "Ну вот опять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400721302,
					"content": "Похоже, мы только что увидели истинное лицо Злобного дракона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721303
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400721303,
					"content": "Эх, как же я её понимаю. Всегда есть люди, которые считают твои увлечения пустой тратой времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721304
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400721304,
					"content": "Хм? А ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721305
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400721305,
					"content": "Я Арнольд Спроси-Меня-Как-Добраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721306
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400721306,
					"content": "Я имею в виду, ты как тут снова оказался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721307
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400721307,
					"content": "О-о-о, я подумал, что вы направитесь на поиски третьего тома «Песнопений священного царства».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721308
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400721308,
					"content": "Да уж, угадал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721309
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400721309,
					"content": "Милейшая госпожа, мне от вас ничего не нужно! Возможность любоваться вашей красотой - уже величайший подарок. Я отвечу на интересующий вас вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721310
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400721310,
					"content": "Третий том священного писания находится на самом верхнем этаже королевского замка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721311
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400721311,
					"content": "Он охраняется?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721312
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400721312,
					"content": "Ну что за вопрос, господин? Безусловно охраняется! Вы хоть раз видели, чтобы такие важные книги валялись без присмотра в безлюдном месте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721313
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400721313,
					"content": "Другими словами, нас там будет поджидать Воронья стража.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721314
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400721314,
					"content": "Охрана священного писания - величайшая честь для каждого подданного. Но вам, милая госпожа, не стоит опасаться. Я уверен, вы всего-навсего хотите с ним ознакомиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721315
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400721315,
					"content": "Лицо милой госпожи просто обворожительно, а какой же мудрый у вас взгляд. Ваши спутники тоже походят на героев. Вы, господа, определённо заслуживаете чести прочитать наше священное писание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721316
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400721316,
					"content": "Великий летописец Оз записал каждую крупицу биографии Её Высочества. Это произведение стало сокровищем Нирваны Ночи. Каждый раз, перечитывая его, я надеюсь, что принцесса счастлива.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арнольд"
				}
			]
		},
		{
			"id": 4007218,
			"completionStepIds": [
				4007218
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007218",
							"2"
						],
						"stepId": 4007218,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Леон",
					"Каэдэхара Кадзуха",
					"Синь Янь",
					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721801,
					"content": "Прошу прощения за то, что господам уже не впервой приходится видеть меня в таком жалком состоянии. Мне действительно пока не достаёт сил, чтобы играть роль настоящего Вороньего рыцаря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721802
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400721802,
					"content": "Играть роль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721803
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400721803,
					"content": "Стыдно признаваться, но я не настоящий рыцарь. На самом деле я начинающий актёр. Нашёл работу совсем недавно, вот и тренируюсь играть рыцаря Ночного ворона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721804
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400721804,
					"content": "Да уж, гордиться тут нечем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400721805,
					"content": "Нет-нет, вы просто не знаете. В Нирване Ночи театр - важная часть культуры. Хорошее выступление - лучшее выражение благодарности для её высочества принцессы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721806
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400721806,
					"content": "О-о-о, значит, это ваша местная культура?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721807
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400721807,
					"content": "Именно так! Именно поэтому я несказанно счастлив сыграть роль рыцаря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721808
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400721808,
					"content": "А почему вашей принцессе так нравится театр?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721809
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400721809,
					"content": "Однажды её высочество сказала: «Дабы почтить принцессу, велю устроить торжество. Займите же равнину и посвятите всех себя театральному искусству. Склонитесь предо мной да принесите в дар свои грёзы во имя вечной славы ночи».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721810
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400721810,
					"content": "Думаю, дело в том, что её высочество принцесса разбирается в настоящем искусстве, как и в самых сокровенных чувствах, наполняющих сердца её подданных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721811
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400721811,
					"content": "Эмоции и их наивысшее выражение - квинтэссенция театра. Сердца любителей театра открыты для эмоций.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721812
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400721812,
					"content": "Вот оно что.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721813
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400721813,
					"content": "Благодарим за ответ, господин рыцарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721814
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400721814,
					"content": "О! О-о-о! В-вы назвали меня рыцарем! Благодарю от всей души!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721815
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400721815,
					"content": "Ну-с, с этой славой я и отправлюсь на поле битвы. Надеюсь, мы скоро встретимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721816
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400721816,
					"content": "Надеюсь, нет! Поосторожней давай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721817
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400721817,
					"content": "Ах да! Не забудьте пароль: «Слушай мой приказ, взмахни крыльями и отправляйся в полёт».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Леон"
				}
			]
		}
	]
}