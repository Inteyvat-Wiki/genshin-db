			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ворон с мрачным взором",
					"Ворон с пронзительным взором",
					"Мона",
					"Каэдэхара Кадзуха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720201,
					"content": "Стоять! Кто идёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720202
					],
					"speakerTitle": "Ворон с мрачным взором"
				},
				{
					"id": 400720202,
					"content": "Судя по виду, вы не из Нирваны Ночи. А ну говорите, зачем явились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720203
					],
					"speakerTitle": "Ворон с пронзительным взором"
				},
				{
					"id": 400720203,
					"content": "Ой, стража!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400720204,
					"content": "Без паники.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720205
					]
				},
				{
					"id": 400720205,
					"content": "#А? Ты чего удумал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400720206,
					"content": "Мы слуги её высочества принцессы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720207
					]
				},
				{
					"id": 400720207,
					"content": "Мы прошли через море звёзд, чтобы попасть сюда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720208
					]
				},
				{
					"id": 400720208,
					"content": "А доказательства у вас есть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720209
					],
					"speakerTitle": "Ворон с мрачным взором"
				},
				{
					"id": 400720209,
					"content": "Ха, столь нелепые вопросы лишь доказывают вашу недалёкость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720210
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400720210,
					"content": "«Да будет мой народ свободен от оков древних порядков».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720211
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400720211,
					"content": "Э-это же пароль Нирваны Ночи! Они действительно слуги её высочества!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720212
					],
					"speakerTitle": "Ворон с пронзительным взором"
				},
				{
					"id": 400720212,
					"content": "О-ох! Что это на меня нашло?! Прошу, примите мои искренние извинения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720213
					],
					"speakerTitle": "Ворон с мрачным взором"
				},
				{
					"id": 400720213,
					"content": "Раз ошиблись, так дайте дорогу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400720214,
					"content": "С-сию минуту! Мы уже уходим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720215
					],
					"speakerTitle": "Ворон с мрачным взором"
				},
				{
					"id": 400720215,
					"content": "Ушли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400720216,
					"content": "Вот и второй том «Песнопений священного царства». Все готовы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720217
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400720217,
					"content": "Вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
