			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венье"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742230201,
					"content": "Сто тридцать шесть... Ладно, ещё четырнадцать раз, и можно будет отдохнуть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230202
					],
					"speakerTitle": "Венье"
				},
				{
					"id": 742230202,
					"content": "Нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230203
					]
				},
				{
					"id": 742230203,
					"content": "Помощь? Нет, не нужна. Что это за тренировка такая, в которой нужна посторонняя помощь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230204
					],
					"speakerTitle": "Венье"
				},
				{
					"id": 742230204,
					"content": "Только усовершенствовав своё тело и дух, я смогу стать почётным солдатом легиона Атанатой, как этот офицер!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230205
					],
					"speakerTitle": "Венье"
				},
				{
					"id": 742230205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230206
					],
					"speakerTitle": "Венье"
				},
				{
					"id": 742230206,
					"content": "Ах да, позволь представить своего инструктора. Только пройдя подготовленные им испытания, я смогу заслужить право на вознесение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230207,
						742230210
					],
					"speakerTitle": "Венье"
				},
				{
					"id": 742230207,
					"content": "Это же статуя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230208
					]
				},
				{
					"id": 742230208,
					"content": "#Что ты хочешь сказать, {M#уважаемый гражданин}{F#уважаемая гражданка}? Разве не все ремурийцы такие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230209
					],
					"speakerTitle": "Венье"
				},
				{
					"id": 742230209,
					"content": "Не хочешь ли попробовать? В первом испытании нужно одним ударом разбить эти каменные столбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Венье"
				},
				{
					"id": 742230213,
					"content": "Не такое уже простое задание! Несмотря на усердные тренировки, я могу разбить только один столб за раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венье"
				},
				{
					"id": 742230210,
					"content": "Какие ещё испытания?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230211
					]
				},
				{
					"id": 742230211,
					"content": "Боевые испытания, разумеется. Вознесённая, бессмертная форма - это одно, но боевые навыки требуют совершенствования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230212
					],
					"speakerTitle": "Венье"
				},
				{
					"id": 742230212,
					"content": "Не хочешь ли попробовать? В первом испытании нужно одним ударом разбить эти каменные столбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Венье"
				}
			]
		},
