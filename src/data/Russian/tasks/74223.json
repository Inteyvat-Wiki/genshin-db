			"dialogs": [
				{
					"id": 742230401,
					"content": "Ох, я и не думал, что это так делается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230402
					],
					"speakerTitle": "Венье"
				},
				{
					"id": 742230402,
					"content": "#Потрясающе! Ты случайно не служил{F#а} в войске Царя богов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230403
					],
					"speakerTitle": "Венье"
				},
				{
					"id": 742230403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230404
					],
					"speakerTitle": "Венье"
				},
				{
					"id": 742230404,
					"content": "Наш офицер также высоко оценил твой результат! Видимо, мне нужно приложить больше усилий!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венье"
				}
			]
		},
