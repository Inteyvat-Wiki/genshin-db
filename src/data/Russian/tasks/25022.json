			"dialogs": [
				{
					"id": 250220401,
					"content": "Ух ты! Крупный фрукт. Таким точно можно наесться. Хора, хочешь попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220404
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220404,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220405
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250220405,
					"content": "(Хора открывает пасть и заглатывает всю дыню разом.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220406
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250220406,
					"content": "У-у-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220407
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250220407,
					"content": "Ха-ха-ха, за один укус всё съел. Понравилось? Хора?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220408
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220408,
					"content": "Уй, у-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220409
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250220409,
					"content": "Хорошо! Тогда я пойду поищу торговцев из Инадзумы и закуплю побольше фиалковой дыни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кацкаль"
				}
			]
		},
		{
			"id": 2502205,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
