			"dialogs": [
				{
					"id": 250220301,
					"content": "Очень красивый цветок. И название тоже приятное. Хора, хочешь попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220304
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220304,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220305
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250220305,
					"content": "(Хора тщательно пережёвывает, наслаждаясь вкусом лепестков.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220306
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250220306,
					"content": "Бульк, бульк...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220307
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250220307,
					"content": "О! Смотрю, ему понравилось. Но одними цветами сыт не будешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220308
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220308,
					"content": "Кроме того, этот цветок не выглядит слишком дешёвым... Я лучше сделаю о нём запись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220309
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220309,
					"content": "Как сделать из цветов еду? Хм. Может, завернуть в лепёшку?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кацкаль"
				}
			]
		},
		{
