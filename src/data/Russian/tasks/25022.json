					"Хора"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250220501,
					"content": "О, какой аромат. Такой свежий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220504
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220504,
					"content": "Хора? Ой! Ты уже его съел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220505
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220505,
					"content": "(Хора моментально проглатывает цветок цинсинь и мило моргает...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220506
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250220506,
					"content": "Хора разворачивается и за один присест съедает половину фруктов в корзине.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250220507
					]
				},
				{
					"id": 250220507,
					"content": "Почему у него вдруг проснулся такой аппетит? Неужели это всё эффект от цветка цинсинь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220508
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220508,
					"content": "М-мне надо посоветоваться с ветеринаром...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кацкаль"
				}
			]
		},
