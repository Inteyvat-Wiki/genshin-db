			"dialogs": [
				{
					"id": 250220101,
					"content": "Хм... Похоже, придётся сменить рецепт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220102
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220102,
					"content": "У-у-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220103,
						250220104
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250220103,
					"content": "Есть какие-то предложения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220106
					]
				},
				{
					"id": 250220106,
					"content": "Бульк, бульк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220107
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220107,
					"content": "Обычно он съедает целую корзину фруктов, а после носится весь день напролёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220108
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220108,
					"content": "Сейчас же он и половины не съедает. И сидит потом, не двигаясь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220109
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220109,
					"content": "Я даже подумал, что он заболел. Так испугался, что посреди ночи пошёл к ветеринару за помощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220110
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220110,
					"content": "Мы возились всю ночь и в итоге пришли к выводу, что Хора здоров. Просто... привереда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220111
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220111,
					"content": "Ветеринар сказал, что лучшее решение - сменить ему рацион.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220112
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220112,
					"content": "Он также сказал, что я могу попробовать включить музыку, пока Хора ест. Может быть, это поможет пробудить его аппетит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220113,
						250220114
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220113,
					"content": "Отличная идея.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220115,
					"content": "Ха-ха-ха... да, я нашёл пластинку с музыкой, которая понравилась и Хоре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220116
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220116,
					"content": "Но Хора подпрыгнул и откусил половину пластинки... Поэтому мне пришлось отказаться от этой идеи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220117
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220117,
					"content": "Всё же для тепетлизавров пластинка из обсидиана и флогистона - это само по себе неплохая закуска...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220118
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220118,
					"content": "Придётся сходить в племя Потомков Крон. Вдруг у них есть какие-то новые ингредиенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220119,
						250220120
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220119,
					"content": "Я помогу тебе их найти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220121,
					"content": "Ты мне поможешь? Большое спасибо! Потомки Крон ищут ингредиенты по всему Натлану, но ты-то можешь выходить и за его пределы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220124
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220124,
					"content": "Подожди, я посмотрю список, который мне дал ветеринар. Он так много знает, даже про то, что вне Натлана...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220125
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220125,
					"content": "Хм... Там написано, что мы можем попробовать использовать <color=#00E1FFFF>радужную розу, фиалковую дыню</color> и... <color=#00E1FFFF>цветок цинсинь</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220122
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220122,
					"content": "#Спасибо, что вызвал{F#ась}{M#ся} помочь мне. Когда соберёшь ингредиенты - возвращайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220123
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250220123,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хора"
				},
				{
					"id": 250220120,
					"content": "Я хорошо ищу ингредиенты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220114,
					"content": "И такие пластинки бывают?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220104,
					"content": "(Гладит Хору.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220105
					]
				},
				{
					"id": 250220105,
					"content": "Бульк, бульк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220106
					],
					"speakerTitle": "Хора"
				}
			]
		},
