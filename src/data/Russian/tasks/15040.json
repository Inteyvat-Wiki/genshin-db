			"dialogs": [
				{
					"id": 150401001,
					"content": "Отлично! «Парящий аша» выглядит на пять с плюсом, и вся наша команда в кадре. Часка, встань ближе к центру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401002
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150401002,
					"content": "Я так взволнован!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401003
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150401003,
					"content": "Все готовы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401004
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150401004,
					"content": "И ты беги скорее к нам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150401005,
					"content": "Не беспокойся, у меня всё спланировано. Итак, поехали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401006
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150401006,
					"content": "Три, два, один...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401007
					],
					"speakerTitle": "Муалани"
				},
				{
