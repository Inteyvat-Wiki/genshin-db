			"dialogs": [
				{
					"id": 150400601,
					"content": "#Ха... Вот это да! Спасибо, {F#дорогая соперница}{M#дорогой соперник}! Мы отлично провели время!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400602,
						150400603,
						150400604
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150400602,
					"content": "Ты был достойным соперником.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400606,
					"content": "Отличная работа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400607
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150400607,
					"content": "#{NICKNAME}, поздравляю с победой! И благодарю нашего дорогого благодетеля и ашу за прекрасную работу в команде!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400608
					],
					"speakerTitle": "Тикрак"
				},
				{
					"id": 150400608,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400609
					],
					"speakerTitle": "Аша"
				},
				{
					"id": 150400609,
					"content": "Поначалу я не поверила, что ты понимаешь речь аши. Но после турнира вынуждена признать: я очень впечатлена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400610
					],
					"speakerTitle": "Тикрак"
				},
				{
					"id": 150400610,
					"content": "И я тоже! Я глаз не могла отвести, за вас болела! Будто следила с трибуны за финалом Паломничества!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400611
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150400611,
					"content": "Понимаю. Когда страсти накалились, мне ужасно хотелось подлететь и самой выпустить пулю-другую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400612
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150400612,
					"content": "То есть твои пули годятся для рисования?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400613
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150400613,
					"content": "Да, только я не знаю точно, какой оттенок они дадут. И думаю, с ними аша быстро перестанет парить в небе и свалится на землю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400614
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150400614,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150400615,
					"content": "Ха-ха! Ну что, остался последний шаг, чтобы завершить испытание «Парящий аша»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400616
					],
					"speakerTitle": "Тикрак"
				},
				{
					"id": 150400616,
					"content": "Дорогие благодетели, теперь зажгите кисти «Парящего аши»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400617
					],
					"speakerTitle": "Тикрак"
				},
				{
					"id": 150400617,
					"content": "(Воспроизведение примечательных граффити ашей)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400618
					]
				},
				{
					"id": 150400618,
					"content": "Красиво, правда? Я знаю отличное место, чтобы сделать общее фото!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тикрак"
				},
				{
					"id": 150400603,
					"content": "Из вас вышла отличная команда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400604,
					"content": "Мне стоило попросить помощи у Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400605
					]
				},
				{
					"id": 150400605,
					"content": "#Значит, теперь ты вспомнил{F#а} о Паймон? И года не прошло!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400606
					],
					"speakerTitle": "Паймон"
				}
			]
		},
