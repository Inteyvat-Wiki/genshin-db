				]
			},
			"dialogs": [
				{
					"id": 150400301,
					"content": "Ого, сработало! Теперь Пеноцветочное море никого не разочарует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400302
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150400302,
					"content": "Отличная работа! Теперь осталось рассказать обо всём сотруднику курорта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150400303,
					"content": "Постойте, подождите... Уф...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400304
					],
					"speakerTitle": "Тикрак"
				},
				{
					"id": 150400304,
					"content": "А ты вовремя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150400305,
					"content": "Не торопись! Отдышись как следует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400306
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150400306,
					"content": "Фух... Привет! Я на курорте отвечаю за главное испытание на Пёстрых скалах. Оно называется «Парящий аша».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400307
					],
					"speakerTitle": "Тикрак"
				},
				{
					"id": 150400307,
					"content": "Я сейчас увидела с высоты, как зелёный луг превратился в настоящее море цветов. Причём такое яркое и красивое, что я едва бинокль не уронила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400308
					],
					"speakerTitle": "Тикрак"
				},
				{
					"id": 150400308,
					"content": "Вы... настоящие спасители Пёстрых скал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400309
					],
					"speakerTitle": "Тикрак"
				},
				{
					"id": 150400309,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400310
					],
					"speakerTitle": "Аша"
				},
				{
					"id": 150400310,
					"content": "Хе-хе, ерунда. Это всё они!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150400311,
					"content": "Дорогие благодетели, не хотите ли теперь пройти моё испытание?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400312
					],
					"speakerTitle": "Тикрак"
				},
				{
					"id": 150400312,
					"content": "Точнее... Не хотите ли заодно раскрасить наши достопримечательности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400313
					],
					"speakerTitle": "Тикрак"
				},
				{
					"id": 150400313,
					"content": "Звучит круто... Но ты уверена, что это разрешено?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400314
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150400314,
					"content": "Конечно, разумеется! И мы будем очень рады, если вы согласитесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400315
					],
					"speakerTitle": "Тикрак"
				},
				{
					"id": 150400315,
					"content": "Вы оказали моему коллеге огромную услугу, поэтому я хочу поблагодарить вас от его имени. И я решила, что такое развлечение вы оцените выше денежного вознаграждения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400316
					],
					"speakerTitle": "Тикрак"
				},
				{
					"id": 150400316,
					"content": "Эм, честно говоря...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150400317,
					"content": "Она хочет сказать, что мы согласны! Ха-ха, куда идти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400318
					],
					"speakerTitle": "Беннет"
				},
				{
					"id": 150400318,
					"content": "Следуйте за мной, мы отправимся туда на воздушном шаре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тикрак"
				}
			]
		},
