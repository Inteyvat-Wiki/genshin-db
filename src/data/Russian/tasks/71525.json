			},
			"dialogs": [
				{
					"id": 716662101,
					"content": "Превосходно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662102
					],
					"speakerTitle": "Работа над ошибками"
				},
				{
					"id": 716662102,
					"content": "Я вижу, что банда Аратаки превратила жучиные бои в ожесточённый состязательный экстремальный вид спорта. Да, здесь есть все предпосылки для прекрасной повести, которую можно рассказывать снова и снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662103
					],
					"speakerTitle": "Работа над ошибками"
				},
				{
					"id": 716662103,
					"content": "Отличная дуэль, эсквайр Тянь! Было очень опрятно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662104
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716662104,
					"content": "Правильно будет сказать «было очень приятно», король óни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662105
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 716662105,
					"content": "Ах, детали-шметали! Главное... спасибо за поддержку нашего лагеря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662106
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716662106,
					"content": "Я тоже выражаю тебе свою благодарность, босс Аратаки. Я намерен остаться здесь и немного понаблюдать, чтобы ещё больше обогатить свой писательский лексикон. Пожалуйста, не обращай на меня внимания. Сделай вид, что меня здесь нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662107
					],
					"speakerTitle": "Работа над ошибками"
				},
				{
					"id": 716662107,
					"content": "Приятель, я ещё никогда не сражался с кем-то настолько... высококультурным! У меня голова гудит от всех этих высокопарных слов. Как называется это зудящее ощущение? Ах да - обучение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662108
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716662108,
					"content": "Похоже, Подготовительный лагерь Аратаки для боевых жуков успешно стартовал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аратаки Итто"
				}
			]
		},
