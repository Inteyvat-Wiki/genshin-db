			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Работа над ошибками"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-336.767,
							200.419,
							-709.591
						],
						"pointId": 7026
					}
				]
			},
			"dialogs": [
				{
					"id": 716662001,
					"content": "Всем привет! Я Тянь Железный Язык, у меня здесь официальная вывеска Подготовительного лагеря Аратаки для боевых жуков. Она также служит разрешением на проведение мероприятия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662002
					],
					"speakerTitle": "Работа над ошибками"
				},
				{
					"id": 716662002,
					"content": "Вау! Это... Пастушонок и Алый воин? Явно перебор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716662003,
					"content": "Как мило! К сожалению, это не моя работа... Но только посмотрите на дизайн! А какие линии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662004
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716662004,
					"content": "Круто! Эпично! Здесь точно передано, насколько круто я выгляжу в качестве профессионального мастера боя жуков в пылу сражения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662005
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716662005,
					"content": "Чувак! Постой, да, кстати... Как принято обращаться к незнакомцам в этой части мира?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662006
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716662006,
					"content": "Может... эсквайр?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662007
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 716662007,
					"content": "Точно! Эсквайр Тянь, твоя работа бесподобна! Словами не передать, как банда Аратаки тебе благодарна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662008
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716662008,
					"content": "Обращаться ко мне так необязательно, босс Аратаки. И ещё, я не художник, а простой рассказчик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662009
					],
					"speakerTitle": "Работа над ошибками"
				},
				{
					"id": 716662009,
					"content": "Эта вывеска была выполнена девушкой из Департамента по делам граждан. Янь Фэй присматривает за ней, поэтому узнав о вашем мероприятии, она предложила свою помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662010
					],
					"speakerTitle": "Работа над ошибками"
				},
				{
					"id": 716662010,
					"content": "О, так это заслуга Янь Фэй! А ведь она действительно всё продумала... Это именно то, что нам было нужно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662011
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716662011,
					"content": "По словам гранд-мастера Ханакадо, ваш Подготовительный лагерь - это амбициозная программа подготовки, которая может предопределить будущее жучиных боёв.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662012
					],
					"speakerTitle": "Работа над ошибками"
				},
				{
					"id": 716662012,
					"content": "Сам я далёк от жучиных боёв, но много слышал о них и всегда хотел попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662013
					],
					"speakerTitle": "Работа над ошибками"
				},
				{
					"id": 716662013,
					"content": "Кто знает, может быть, это вдохновит меня на новую замечательную историю, которую я расскажу соседям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662014
					],
					"speakerTitle": "Работа над ошибками"
				},
				{
					"id": 716662014,
					"content": "Бои жуков - это то, к чему нужно иметь природную предрасположенность. Возьмём, к примеру, Покорительницу небес Железную фиалковую дыню. Она посмотрела короткую демонстрацию, после чего состоялся её первый бой, который выявил в ней большой потенциал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662015
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 716662015,
					"content": "Когда эсквайр Тянь постигнет азы боя жуков и увидит их привлекательность, возможно, его рассказы станут для нас бесплатной рекламой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662016
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 716662016,
					"content": "Чувак! Это было бы круто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662017
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716662017,
					"content": "Ладно, дружбан! Друган! Дружище! Дорогой друг! Кхм, кхм... Э-э... Пусть победит сильнейший!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аратаки Итто"
				}
			]
		},
