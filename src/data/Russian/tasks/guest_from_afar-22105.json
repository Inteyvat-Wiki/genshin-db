			"dialogs": [
				{
					"id": 221050101,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050102
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221050102,
					"content": "Что произошло?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050103
					]
				},
				{
					"id": 221050103,
					"content": "У меня вечно такое ощущение, что вокруг постоялого двора происходит что-то нехорошее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050104
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221050104,
					"content": "А наши постояльцы очень впечатлительны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050105
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221050105,
					"content": "При малейшем беспокойстве они могут разбить окно или сломать дверь. Иногда даже рамы вываливаются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050106
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221050106,
					"content": "К счастью, эти постояльцы восстанавливают ущерб сами. Но после каждого такого ремонта мы остаёмся с дверьми и окнами, которые никак не подходят под общий стиль гостиницы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050107
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221050107,
					"content": "Можно попросить тебя проверить, что происходит снаружи? Если заметишь что-нибудь странное, пожалуйста, разберись с этим. А я останусь здесь принимать гостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050108,
						221050109
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221050108,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050110
					]
				},
				{
					"id": 221050110,
					"content": "Большое спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221050109,
					"content": "Что не так с этими людьми...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050111
					]
				},
				{
					"id": 221050111,
					"content": "#Не будь так строг{F#а} к ним. Жизнь вечных приключений неизбежно воспитывает в тебе осторожность, бдительность и постоянное чувство тревоги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050112
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221050112,
					"content": "Пожалуйста, осмотри окрестности. Уверена, что ты не найдёшь ничего особенно опасного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верр Голдет"
				}
			]
		},
