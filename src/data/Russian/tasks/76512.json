			"dialogs": [
				{
					"id": 765120101,
					"content": "#К этому моменту {NICKNAME} уже всё понял{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120102
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 765120102,
					"content": "Кхм-кхм... Дай-ка вспомню свои слова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120103
					],
					"speakerTitle": "Сецех"
				},
				{
					"id": 765120103,
					"content": "Этот великолепный турнир наконец подошёл к концу. Пора объявить результаты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120104
					],
					"speakerTitle": "Сецех"
				},
				{
					"id": 765120104,
					"content": "#Просим {M#нашего финального испытателя}{F#нашу финальную испытательницу} выбрать чемпиона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120105
					],
					"speakerTitle": "Сецех"
				},
				{
					"id": 765120105,
					"content": "#На этот раз {NICKNAME} решает, кто станет чемпионом? О... Впервые {NICKNAME} выступает самым главным судьёй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120106,
						765120112,
						765120119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765120106,
					"content": "Я выбираю красавчика Гаумару.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120107
					]
				},
				{
					"id": 765120107,
					"content": "Ага, Паймон тоже считает, что Гаумару самый крутой, прямо как Таромару!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765120108,
					"content": "Ру-у-у! Ру-у-у!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120109
					],
					"speakerTitle": "Гаумару"
				},
				{
					"id": 765120109,
					"content": "Потрясающе, Гаумару! Твои усилия увенчались успехом и получили высшую оценку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120110
					],
					"speakerTitle": "Сумирэ"
				},
				{
					"id": 765120110,
					"content": "Вполне ожидаемый результат. Поздравляю наших друзей из Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120111
					],
					"speakerTitle": "Ониксовый Агат"
				},
				{
					"id": 765120111,
					"content": "Бравый господин пёс-ниндзя действительно очень силён, я поддерживаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "Арпеджио Уменьшенного Септаккорда"
				},
				{
					"id": 765120125,
					"content": "Пусть у нас и нет пышной церемонии награждения, вы все цените практику и обычно предпочитаете держаться в тени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120126
					],
					"speakerTitle": "Сецех"
				},
				{
					"id": 765120126,
					"content": "#Признание от {M#путешественника}{F#путешественницы} - высшая честь в Нод-Крае, куда более ценная, чем любые позолоченные кубки и медали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120127
					],
					"speakerTitle": "Сецех"
				},
				{
					"id": 765120127,
					"content": "#Хе-хе! Возможно, вы первые воины во всём Тейвате, кого {NICKNAME} награждает таким образом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765120128,
					"content": "Нам не нужны дополнительные награды. Этого достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120129
					],
					"speakerTitle": "Ониксовый Агат"
				},
				{
					"id": 765120129,
					"content": "Не так ли, Буданова?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120130
					],
					"speakerTitle": "Ониксовый Агат"
				},
				{
					"id": 765120130,
					"content": "В следующий раз мы, со своей стороны, можем профинансировать турнир и сделать его более масштабным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120131
					],
					"speakerTitle": "Арпеджио Уменьшенного Септаккорда"
				},
				{
					"id": 765120131,
					"content": "Лучше устроить отбор хотя бы на сотню участников. Тогда можем найти мастеров, о которых нет данных и которые пока ни к кому не примкнули.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120132
					],
					"speakerTitle": "Арпеджио Уменьшенного Септаккорда"
				},
				{
					"id": 765120132,
					"content": "Есть смысл. Бомбардиры тоже с радостью поддержат такое мероприятие. Я заранее подготовлю план для майора Валерия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120133
					],
					"speakerTitle": "Ониксовый Агат"
				},
				{
					"id": 765120133,
					"content": "Сюмацубан тоже... эх... Если бюджет дойдёт до десятков миллионов моры, вопрос финансирования отпадёт, и отряд псов-ниндзя обязательно примет участие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120134
					],
					"speakerTitle": "Сумирэ"
				},
				{
					"id": 765120134,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120135
					],
					"speakerTitle": "Гаумару"
				},
				{
					"id": 765120135,
					"content": "Благодарю за вашу щедрость, но, полагаю, если у такого состязания появится влиятельный спонсор, его суть может измениться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120136
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 765120136,
					"content": "Сможете ли вы устоять перед искушением и не попробовать привлечь на свою сторону сильнейших из участников?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120137
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 765120137,
					"content": "А... Кадзуха, ты хочешь сказать, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120138
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765120138,
					"content": "Именно поэтому лучше всего, чтобы турнир проводила относительно нейтральная Гильдия искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120139,
						765120140
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 765120139,
					"content": "Лучше, чтобы турнир был независимым.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120141
					]
				},
				{
					"id": 765120141,
					"content": "Хм... Кажется, Паймон тоже поняла! Тогда Паймон скажет прямо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120142
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765120142,
					"content": "Хотя в этот раз оба участника от Фатуи были вежливы, некоторые из ваших коллег довольно агрессивны. Стоит им нас увидеть, как они сразу лезут в бой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765120143,
					"content": "Если Фатуи станут спонсорами турнира, вы наверняка начнёте привлекать сильнейших участников. И выйдет так, что мы сами помогаем вам находить бойцов, которые потом будут нас же и бить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120144
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765120144,
					"content": "Ха-ха, раскусили...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120145
					],
					"speakerTitle": "Ониксовый Агат"
				},
				{
					"id": 765120145,
					"content": "Я понимаю вашу точку зрения, но не могу давать обещания за других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120146
					],
					"speakerTitle": "Ониксовый Агат"
				},
				{
					"id": 765120146,
					"content": "У разных подразделений свои задачи и методы, а слова такого младшего офицера, как я, мало что значат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120147
					],
					"speakerTitle": "Ониксовый Агат"
				},
				{
					"id": 765120147,
					"content": "#Господин Каэдэхара прав. Опасения {M#путешественника}{F#путешественницы} и проводника Паймон вполне обоснованны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120148
					],
					"speakerTitle": "Арпеджио Уменьшенного Септаккорда"
				},
				{
					"id": 765120148,
					"content": "Ладно, хватит вам строить планы. Наслаждайтесь честным боем, как Гаумару!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120149
					],
					"speakerTitle": "Сумирэ"
				},
				{
					"id": 765120149,
					"content": "Р-р-р! Гру-ур!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120150
					],
					"speakerTitle": "Гаумару"
				},
				{
					"id": 765120150,
					"content": "И правда, нам, простым бойцам, не стоит забивать голову делами начальства. Главное - сражаться в своё удовольствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120151
					],
					"speakerTitle": "Ониксовый Агат"
				},
				{
					"id": 765120151,
					"content": "В следующий раз я обязательно продемонстрирую ещё более высокий уровень мастерства!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120152
					],
					"speakerTitle": "Ониксовый Агат"
				},
				{
					"id": 765120152,
					"content": "А я... принесу такой торт, чтобы хватило каждому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арпеджио Уменьшенного Септаккорда"
				},
				{
					"id": 765120140,
					"content": "Нельзя примешивать к нему посторонние цели.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120141
					]
				},
				{
					"id": 765120112,
					"content": "Ониксовый Агат показал себя лучше всех.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120113
					]
				},
				{
					"id": 765120113,
					"content": "Тот высокий Фатуи с двуручным мечом... С ним и правда непросто справиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765120114,
					"content": "Я? Благодарю за признание, это лучшая поддержка для меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120115
					],
					"speakerTitle": "Ониксовый Агат"
				},
				{
					"id": 765120115,
					"content": "#Все показали достойные боевые навыки. Мне повезло. Я чувствовал, как будет драться {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120116
					],
					"speakerTitle": "Ониксовый Агат"
				},
				{
					"id": 765120116,
					"content": "Гр-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120117
					],
					"speakerTitle": "Гаумару"
				},
				{
					"id": 765120117,
					"content": "Видишь, Гаумару? Тебе нужно хорошенько поучиться у Ониксового Агата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120118
					],
					"speakerTitle": "Сумирэ"
				},
				{
					"id": 765120118,
					"content": "Отлично, поручик Степаняна. Майор Валерий тоже будет гордиться тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "Арпеджио Уменьшенного Септаккорда"
				},
				{
					"id": 765120119,
					"content": "Победитель - Арпеджио Уменьшенного Септаккорда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120120
					]
				},
				{
					"id": 765120120,
					"content": "Хм... Кстати, некоторых из тех Фатуи в шляпах, с которыми мы сражались в Фонтейне, обучала именно эта госпожа? Тогда она действительно крутая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765120121,
					"content": "#Ох, какая честь... Придётся готовить для тебя, {NICKNAME}, только роскошные десерты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120122
					],
					"speakerTitle": "Арпеджио Уменьшенного Септаккорда"
				},
				{
					"id": 765120122,
					"content": "Грур?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120123
					],
					"speakerTitle": "Гаумару"
				},
				{
					"id": 765120123,
					"content": "Если ты тоже хочешь попробовать пирожные госпожи Будановой, тогда придётся постараться и стать сильнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120124
					],
					"speakerTitle": "Сумирэ"
				},
				{
					"id": 765120124,
					"content": "Ох, как-никак вы опытный инструктор служебных войск. Мне с вами не тягаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "Ониксовый Агат"
				}
			]
		}
	]
}