			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ли Дин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10089701,
					"content": "Братец рассказал мне, как вы его спасли! Спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089702
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10089702,
					"content": "Эх... У нашей семьи ничего не осталось... Мы услышали о сокровищах в янтарных ловушках горы Хулао и решили испытать удачу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089703
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10089703,
					"content": "О чём мы только думали? Мы планировали найти сокровища и взять ровно столько, сколько нужно для пропитания нашей семьи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089704
					],
					"speakerTitle": "Ли Дан"
				},
				{
					"id": 10089704,
					"content": "В итоге Адепт наказал нас за жадность. Янтарная ловушка поглотила меня, и если бы не ваша помощь, то не знаю, когда бы я выбрался на волю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089705
					],
					"speakerTitle": "Ли Дан"
				},
				{
					"id": 10089706,
					"content": "...Посланников?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089707
					]
				},
				{
					"id": 10089709,
					"content": "О твоём преступлении и раскаянии мне известно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089710
					]
				},
				{
					"id": 10089705,
					"content": "К счастью, Адепт проявил милосердие и направил нам на помощь двух могучих посланников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089706,
						10089709
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10089707,
					"content": "Да! Вы двое спасли жизнь моему брату, пока я молил Адепта о прощении прямо здесь на вершине горы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089708
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10089708,
					"content": "Значит, вы - посланники Адепта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "Ли Дан"
				},
				{
					"id": 10089710,
					"content": "Ого! А у тебя здорово получается изображать посланника Адептов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089711
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10089711,
					"content": "Спасибо... Мы с братом приносим искренние извинения. Мы больше так не будем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10089712,
					"content": "Мы счастливы получить благословение Адептов и отныне начнём вести честную жизнь. Даже если ради этого нам придётся работать портовыми грузчиками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089713
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10089713,
					"content": "В любом случае мы уже слишком долго находимся на территории Адептов без разрешения. Пора продолжать путь. Спасибо вам, могучие посланники Адептов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089714
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10089714,
					"content": "Да, спасибо вам, посланники...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089715
					],
					"speakerTitle": "Ли Дан"
				},
				{
					"id": 10089715,
					"content": "Вот было бы здорово, если бы мы и вправду были посланниками Адептов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10080609,
					"content": "Судя по всему, у этого Адепта достаточно скверный характер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10080610,
					"content": "Но мы же не сделали ничего плохого? Поэтому у нас не должно возникнуть никаких проблем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10089601,
					"content": "Кто посмел проникнуть в мои владения? Кто освободил вора из заточения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10089602,
					"content": "Глупые смертные, понесите же заслуженное наказание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Творец Гор"
				}
			]
		},
