						"stepId": 100806,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100802",
							"3"
						],
						"stepId": 100802,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ли Дин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080601,
					"content": "Благодарю за спасение моего брата, могучие посланники просветлённых Адептов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080602
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080602,
					"content": "Ты встречал Адептов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080603
					]
				},
				{
					"id": 10080603,
					"content": "Что? Нет... Мы только слышали, что они живут где-то на горе Хулао...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080604
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080604,
					"content": "Но простым смертным редко удаётся воочию увидеть Адептов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080605
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080605,
					"content": "В отличие от вас... Вы ведь их посланники. Вы стоите совсем на другом уровне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080606
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080606,
					"content": "В любом случае мы уже слишком долго находимся на территории Адептов без разрешения. Пора продолжать путь. Спасибо вам, могучие посланники Адептов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080607
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080607,
					"content": "Да, спасибо вам, посланники...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080608
					],
					"speakerTitle": "Ли Дан"
				},
				{
					"id": 10080608,
					"content": "Вот было бы здорово, если бы мы и вправду были посланниками Адептов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10080609,
					"content": "Судя по всему, у этого Адепта достаточно скверный характер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10080610,
					"content": "Но мы же не сделали ничего плохого? Поэтому у нас не должно возникнуть никаких проблем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10089601,
					"content": "Кто посмел проникнуть в мои владения? Кто освободил вора из заточения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10089602,
					"content": "Глупые смертные, понесите же заслуженное наказание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Творец Гор"
				}
			]
		},
		{
			"id": 100807,
			"completionStepIds": [
				100807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100807",
							"2"
						],
						"stepId": 100807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Творец Гор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080701,
					"content": "Вы вторгаетесь в заповедную гору Хулао, вы уничтожаете мои янтарные ловушки, вы даруете вору свободу, не имея на то ни малейшего права!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080702
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080702,
					"content": "Действия вора оскорбили Адепта, но то, что натворили вы, - переходит все возможные границы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080703
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080703,
					"content": "Подождите! Мы можем всё объяснить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080704,
						10080706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10080704,
					"content": "Вот, смотрите...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080705
					]
				},
				{
					"id": 10080705,
					"content": "Печать согласия! Не знал, что такие ещё остались в мире смертных...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080708,
					"content": "Это... Печать согласия? Удивительно, что в мире смертных ещё остались подобные вещи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080709
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080709,
					"content": "На заре времён Властелин Камня лично даровал их простым смертным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080710
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080710,
					"content": "Говорите. Я хочу знать, что привело вас ко мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080711
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080711,
					"content": "Проявите мудрость и говорите правду. Вряд ли вам удастся меня обмануть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080712
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080712,
					"content": "Властелин Камня... убит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080713
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080713,
					"content": "Во время Церемонии Сошествия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080714
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080714,
					"content": "Кто же в Ли Юэ... во всём мире посмел бы на подобную измену? Или стоит спросить, у кого хватило бы на это сил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080715
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080715,
					"content": "Властелин Камня поручил Адептам защищать Ли Юэ, и мы с честью выполняли свой долг. Чем лучше жили граждане города, тем выше мы уходили в горы. Это был жест доброй воли к человечеству.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080716
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080716,
					"content": "Но теперь... Когда Властелина Камня больше нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080717
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080717,
					"content": "#Путешественни{F#ца}{M#к}, ты прин{F#есла}{M#ёс} мне дурную весть. Я знаю, почему Владыка Лун послал за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080718
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080718,
					"content": "Мне нужно закончить некоторые дела, требующие моего внимания. После этого я встречусь с другими Адептами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080719
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080719,
					"content": "А что происходит с этим янтарём?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080720
					]
				},
				{
					"id": 10080720,
					"content": "Паймон знает! В книжках говорится, что у Адептов есть магические силы. Похоже, что это действительно так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080721
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10080721,
					"content": "Трава - это волосы Адептов, а реки - их слюни... Ну и с янтарём должно быть что-то в этом духе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080722,
						10080723
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10080722,
					"content": "Получается, дождь - это слёзы Адептов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080724,
					"content": "...Вы несёте полную чушь! Этот янтарь производят особые цветы, наскальные подсолнухи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080725
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080725,
					"content": "Чаще всего эти цветы растут под землёй. Если наступить на такой цветок, то попадёшь в янтарную ловушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080726
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080726,
					"content": "Когда я поселился здесь, я посадил множество наскальных подсолнухов, чтобы сохранить тишину и спокойствие в этом месте. На протяжении долгих лет они помогали мне сохранять покой. А ещё в эти ловушки попало много разных интересных вещиц...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080727
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080727,
					"content": "Получается, что этот янтарь... живой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080728
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10080728,
					"content": "Получается, что так. Поэтому я не могу так просто оставить это место, и подвергнуть риску жизни невиновных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080729
					],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080729,
					"content": "Я отправлюсь в путь, как только разберусь с этой проблемой. Я полагаю, что вы отправитесь в путь намного раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Творец Гор"
				},
				{
					"id": 10080723,
					"content": "Янтарь - это кристаллизованные Адепты? Мерзость...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080706,
					"content": "Нас послал Владыка Лун...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080707
					]
				},
				{
					"id": 10080707,
					"content": "Владыка Лун... послал ко мне обычных смертных?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "Творец Гор"
				}
			]
		},
		{
			"id": 100897,
