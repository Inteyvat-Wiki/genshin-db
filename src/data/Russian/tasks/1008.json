				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ли Дин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080201,
					"content": "Сжальтесь надо мной, могучий Адепт! Молю вас, пощадите меня и моего братца... Отпустите нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080202
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080202,
					"content": "Всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080203
					]
				},
				{
					"id": 10080203,
					"content": "#Ты... Ты... Ты кто так{F#ая}{M#ой}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080204
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080204,
					"content": "Мы тебя первые спросили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10080205,
					"content": "Ох... Если вы безопасно прошли в Заоблачный предел, это может означать только одно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080206
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080206,
					"content": "Вы посланники Адептов! Вас отправили сюда, чтобы спасти меня и моего брата!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080207
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080207,
					"content": "О чём это он?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10080208,
					"content": "Прошу, смилуйтесь, могучие посланники просветлённых Адептов! Я умоляю о помощи! Мы с братом пришли сюда только из-за бедности... Мы услышали о несметных сокровищах, что таит гора Хулао...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080209
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080209,
					"content": "Как же глупо мы поступили... Но мы всего лишь хотели поправить финансовое состояние нашей семьи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080210
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080210,
					"content": "Мы поднялись по <color=#00E1FFFF>тропинке высоко в горы</color>, но вдруг янтарь... он поглотил моего брата, Ли Дана!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080211
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080211,
					"content": "Я бросился прочь... Я бежал, что есть мочи... И только сейчас до меня дошло, что мы перешли священные границы и за это понесли наказание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080212
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080212,
					"content": "Я понятия не имею, как спасти брата, поэтому я начал молить Адептов о помощи. И вот ко мне явились двое посланников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080213
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080213,
					"content": "Что ты несёшь? Мы никакие не посланники Адептов! Мы сами тоже ищем Адептов, как и все.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10080214,
					"content": "Нет! Нет-нет-нет! Вы посланники! Вы должны быть посланниками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080215
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080215,
					"content": "Я не знаю, какой именно янтарь схватил моего брата... Прошу вас, спасите его! Умоляю, проявите хоть немножко милосердия Адептов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080216,
						10080218
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080216,
					"content": "Хорошо... Я посмотрю, что можно сделать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080217
					]
				},
				{
					"id": 10080217,
					"content": "Спасибо. Спасибо вам, могучие посланники просветлённых Адептов. Я обещаю, что впредь буду вести себя хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10080218,
					"content": "О твоём преступлении и раскаянии мне известно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080219
					]
				},
				{
					"id": 10080219,
					"content": "Ого! Когда ты так разговариваешь, несложно поверить в то, что ты на самом деле посланник Адептов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10080220,
					"content": "Хвала Адептам горы Хулао и их могучим посланникам! Мы больше никогда не будем совершать таких глупых поступков!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ли Дин"
				}
			]
		},
		{
			"id": 100806,
			"completionStepIds": [
				100806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
