				{
					"id": 10089901,
					"content": "Пожалуйста, спасите моего брата. Я не знаю, какой именно янтарь его поглотил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089902
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10089902,
					"content": "Я точно уверен в том, что мы <color=#00E1FFFF>не сходили с этой тропы</color>. Янтарь должен быть где-то по пути на вершину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089903
					],
					"speakerTitle": "Ли Дин"
				},
				{
					"id": 10089903,
					"content": "Могущественные посланники Адептов, умоляю вас, спасите его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ли Дин"
				}
			]
		}
