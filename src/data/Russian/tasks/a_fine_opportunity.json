			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джек"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010601,
					"content": "#Ты уничтожил{F#а} их лагерь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010602
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010602,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010603
					]
				},
				{
					"id": 206010603,
					"content": "#Ты так{M#ой}{F#ая} сильн{M#ый}{F#ая}. Если бы я мог стать таким, как ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010604
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010604,
					"content": "Я бы тоже хотел убивать драконов и спасать мир, прямо как в легендах, но не могу справиться даже с группой хиличурлов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010605
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010605,
					"content": "Ай... Ну... Мне очень неловко просить тебя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010606
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010606,
					"content": "На самом деле, я отправился исследовать храм Тысячи ветров, потому что скоро я должен пройти тест на ранг приключений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010607
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010607,
					"content": "Я подумал, что если проявлю силы в этот раз, то и тест смогу сдать легче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010608
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010608,
					"content": "Но я не ожидал, что не только не смогу себя показать, но и окажусь на грани жизни и смерти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010609
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010609,
					"content": "Я... Я могу попросить тебя не рассказывать Сайрусу о моём провале? Если это действительно повлияет на тест, то я пропал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010610,
						206010612
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010610,
					"content": "Я никому не скажу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010611
					]
				},
				{
					"id": 206010611,
					"content": "Большое тебе спасибо! Обещаю, что больше не буду таким беспечным!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010612,
					"content": "Это неправильно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010613
					]
				},
				{
					"id": 206010613,
					"content": "Я знаю. И Сайрус всегда говорит: «Искатель приключений всегда должен быть честен с собой»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010614
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010614,
					"content": "Но... Эх, ладно, надеюсь, Сайрус не будет сильно сердиться на меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джек"
				}
			]
		},
		{
