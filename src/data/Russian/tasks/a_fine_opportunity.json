		{
			"id": 2060105,
			"completionStepIds": [
				2060105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2060105",
							"2"
						],
						"stepId": 2060105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джек"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010501,
					"content": "Ау, больно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010502
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010502,
					"content": "Спасибо тебе. Без тебя я бы не добрался домой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010503
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010503,
					"content": "Как ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010504
					]
				},
				{
					"id": 206010504,
					"content": "Ха, всего лишь... Ай! Царапина. Со мной всё будет в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010505
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010505,
					"content": "Я обнаружил, что группа хиличурлов собралась в лагере впереди. Мне показалось, они что-то замышляли, и я решил проследить за ними...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010506
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010506,
					"content": "...Но я подошёл слишком близко, и из-за моей неосторожности они заметили меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010507
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010507,
					"content": "Но это ничего, со мной всё будет в порядке, только, пожалуйста, помоги скорее избавиться от них!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010508
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010508,
					"content": "Их становится всё больше. Нельзя допустить, чтобы они реализовали свои планы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010509
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 206010509,
					"content": "Что до меня... Я сам о себе позабочусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джек"
				}
			]
		},
		{
			"id": 2060106,
			"completionStepIds": [
				2060108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
