			"dialogs": [
				{
					"id": 206010701,
					"content": "#Ты вернул{M#ся}{F#ась}! И Джек вернулся, вот только он что-то прихрамывает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010702
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206010702,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010703
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206010703,
					"content": "Джек был неосмотрителен, и его ранили...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010704
					]
				},
				{
					"id": 206010704,
					"content": "Так я и думал. Эх... Никогда не слушает, что я говорю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010705
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206010705,
					"content": "Хотя я понимаю, что он хочет показать себя, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010706
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206010706,
					"content": "Ладно, я всё понял. Я с ним поговорю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010707
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206010707,
					"content": "Это тебе. Считай, что это - твоя награда за приключение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайрус"
				}
			]
		},
