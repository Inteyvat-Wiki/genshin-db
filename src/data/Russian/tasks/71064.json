				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640201,
					"content": "(На каменной табличке начертаны следующие слова...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640202
					],
					"speakerTitle": "Каменная табличка"
				},
				{
					"id": 710640202,
					"content": "«...во время битвы в Разломе мои руки и ноги парализовало и мне пришлось надиктовать эти слова, чтобы их вырезали на табличке».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640203
					],
					"speakerTitle": "Каменная табличка"
				},
				{
					"id": 710640203,
					"content": "«...я выжил в той свирепой битве, но по ночам, вспоминая своих павших товарищей, я не мог сомкнуть глаз. А после случившегося с моим телом я жалел, что не присоединился к ним».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640204
					],
					"speakerTitle": "Каменная табличка"
				},
				{
					"id": 710640204,
					"content": "«...я попытался отправиться к ним, но Властелин Камня прознал об этом и вразумил меня».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640205
					],
					"speakerTitle": "Каменная табличка"
				},
				{
					"id": 710640205,
					"content": "«Увы, отныне я не могу воспользоваться шлемом и бронёй Миллелитов, что были дарованы мне. У меня они покроются пылью, поэтому я оставляю их здесь для того, кому суждено их забрать».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640206
					],
					"speakerTitle": "Каменная табличка"
				},
				{
					"id": 710640206,
					"content": "«Ко всем взываю: если нам не суждено быть товарищами в этой жизни, то станем же соратниками в следующей. Поклянёмся же в верности, разделив кубок вина, и защитим Ли Юэ от врагов...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каменная табличка"
				}
			]
		},
		{
			"id": 7106403,
			"completionStepIds": [
				7106411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106411",
							"2"
						],
						"stepId": 7106411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ван"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640301,
					"content": "Ого! Тебе удалось найти... Так это и есть Сокровище Миллелитов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640302
					],
					"speakerTitle": "Ван"
				},
				{
					"id": 710640302,
					"content": "Я понятия не имею, что там, но воин, оставивший это сокровище, наверняка был бы рад узнать, что его нашли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640303
					],
					"speakerTitle": "Ван"
				},
				{
					"id": 710640303,
					"content": "С той катастрофы прошло пятьсот лет... Когда я думаю о том, что некогда здесь в жестоком сражении столько наших предков сложило свои головы, я не могу не размышлять о том...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640304
					],
					"speakerTitle": "Ван"
				},
				{
					"id": 710640304,
					"content": "Думал ли кто-нибудь из тех людей, которые сражались бок о бок с Властелином Камня, что их будут помнить на протяжении веков?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640305
					],
					"speakerTitle": "Ван"
				},
				{
					"id": 710640305,
					"content": "Усомнились ли они хоть на миг в своём долге? А те, кто так и не обрёл Глаз Бога, как они оставались верными богу, который не проявил своей благосклонности до самой их смерти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640306,
						710640307
					],
					"speakerTitle": "Ван"
				},
				{
					"id": 710640306,
					"content": "Их бог никогда не покидал их.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				},
				{
					"id": 710640308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640309
					],
					"speakerTitle": "Ван"
				},
				{
					"id": 710640309,
					"content": "Да, ты верно говоришь. С Глазом Бога или без него люди стремятся к будущему с бесконечными возможностями. В этом движущая сила, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640310
					],
					"speakerTitle": "Ван"
				},
				{
					"id": 710640310,
					"content": "Так же и мы. Мы здесь не ради славного прошлого и не ради славы в настоящем... Мы здесь, чтобы поддержать друг друга и оставить свой след для будущего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640311
					],
					"speakerTitle": "Ван"
				},
				{
					"id": 710640311,
					"content": "Может быть, когда-нибудь в далёком будущем Разлом тоже станет нашим памятником.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640314
					],
					"speakerTitle": "Ван"
				},
				{
					"id": 710640314,
					"content": "Шахты и долины, пот поколений шахтёров... вот он наш тернистый путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640312
					],
					"speakerTitle": "Ван"
				},
				{
					"id": 710640312,
					"content": "Точно так же, как Камни памяти, это место через сотни и тысячи лет будет свидетельством того, что жертвы, принесённые здесь, не были напрасными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640313
					],
					"speakerTitle": "Ван"
				},
				{
					"id": 710640313,
					"content": "Хе-хе, правда я до этого не доживу. Но если кто-нибудь поднимет здесь тост за нас, бедных шахтёров, когда нас не станет, я буду счастлив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ван"
				},
				{
					"id": 710640307,
					"content": "Они выбрали преданность.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				}
			]
		},
