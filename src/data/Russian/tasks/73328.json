				"points": []
			},
			"dialogs": [
				{
					"id": 733280201,
					"content": "Тысяча обнимашек! Ещё увидимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280202,
						733280206
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280202,
					"content": "Где мы встретимся в следующий раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280203
					]
				},
				{
					"id": 733280203,
					"content": "Кто знает? На Селестии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280204
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280204,
					"content": "Ха-ха-ха-ха, шучу! Но если захочешь, то я и туда приду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280205
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280205,
					"content": "Не спрашивай почему, я просто знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280208,
					"content": "Увидимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280206,
					"content": "И я тебя крепко обнимаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280207
					]
				},
				{
					"id": 733280207,
					"content": "Ха-ха, спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "Джехт"
				}
			]
		}
	]
}