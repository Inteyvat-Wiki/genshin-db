			"trigger": {
				"objectNames": [
					"Джехт"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733280101,
					"content": "Привет, Джехт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733280102,
					"content": "#{NICKNAME}, Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280103
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280103,
					"content": "Бип-бип!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280104
					],
					"speakerTitle": "Бенбен"
				},
				{
					"id": 733280104,
					"content": "Ха-ха, как я и говорила! Мы встретились снова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280105
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280105,
					"content": "Что привело тебя сюда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280106
					]
				},
				{
					"id": 733280106,
					"content": "Хм... У женщин могут быть свои секреты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280107
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280107,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733280108,
					"content": "#{M#Не надо расспрашивать! У меня также есть личная жизнь...}{F#Позови меня в бар, развесели, тогда, может, и расскажу... Не учить же мне тебя?}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280109
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280109,
					"content": "#{M#Пфф... таковы правила охранного предприятия. Я не могу про это рассказывать, извини.}{F#Ха-ха, шутка, не воспринимай всерьёз! Таково правило охранного предприятия... Нельзя рассказывать о грузе, извини.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280110
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280110,
					"content": "Хм, какая загадочная!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733280111,
					"content": "Мм... Как у вас дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280112,
						733280113
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280112,
					"content": "Неплохо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				},
				{
					"id": 733280114,
					"content": "Ах, и у меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280115
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280115,
					"content": "Что ж, не буду тебя задерживать. Увы... Мне надо спешить по делам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280116
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280116,
					"content": "Хм, Джехт, ты так занята... Раньше ведь такого не было?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733280117,
					"content": "Пфф... Это всё «стабильная» работа, хотя по сути занимаюсь примерно тем же, что и раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280118
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280118,
					"content": "Вскоре после того, как нашла работу в охранном предприятии, я начала скучать по прежним свободным денькам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280119
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280119,
					"content": "Хотя не знаю, как твоя жизнь, но я с нетерпением жду твои истории. И мне тоже есть что тебе рассказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280120
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280120,
					"content": "Но не волнуйтесь, не волнуйтесь... Хорошие истории, как вино, нужно хранить. Когда-то от таких историй зависели жизни странствующих по пустыне, хе-хе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280121
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280121,
					"content": "В общем, пожалуйста, берегите себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280122
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280122,
					"content": "И ты будь осторожна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280123
					]
				},
				{
					"id": 733280123,
					"content": "Крепко обнимаю и буду продолжать молиться за тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280124
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280124,
					"content": "Бип-бип!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280125
					],
					"speakerTitle": "Бенбен"
				},
				{
					"id": 733280125,
					"content": "Ха-ха, и Бенбен тоже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733280113,
					"content": "Так себе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				}
			]
		},
		{
			"id": 7332802,
			"completionStepIds": [],
