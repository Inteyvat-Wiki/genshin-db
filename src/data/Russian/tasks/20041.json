			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Любопытная Пачи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200410101,
					"content": "Не бывает приключений, которые идут строго по плану! Мы так и не сдвинемся с места, если целый день будем только планировать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410102
					],
					"speakerTitle": "Любопытная Пачи"
				},
				{
					"id": 200410102,
					"content": "Если план не идеален, то мы должны быть готовы ко всему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410103
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200410103,
					"content": "О чём вы спорите?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410104
					]
				},
				{
					"id": 200410104,
					"content": "Я исследователь древних руин, и я пытаюсь найти вход в храм Тысячи ветров. Но я вовсе не умею драться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410105
					],
					"speakerTitle": "Любопытная Пачи"
				},
				{
					"id": 200410105,
					"content": "Мистер Дулан - искатель приключений. Он взял на себя обязательства по принятию всех необходимых мер для исследования храма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410106
					],
					"speakerTitle": "Любопытная Пачи"
				},
				{
					"id": 200410106,
					"content": "Я ни в коем случае не хочу критиковать мистера Дулана. Мне вполне очевидна опасность, которую представляют стражи руин. Но мистер Дулан настаивает на составлении подробнейшего плана всего приключения. Мы без конца обсуждаем детали этого плана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410107
					],
					"speakerTitle": "Любопытная Пачи"
				},
				{
					"id": 200410107,
					"content": "Исследования, разведка, поправки к плану, дополнительные исследования, повторная разведка, новые поправки к плану. Это уже просто невыносимо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410108
					],
					"speakerTitle": "Любопытная Пачи"
				},
				{
					"id": 200410108,
					"content": "Сейчас он нашёл новые доказательства того, что монстры разбили лагерь неподалёку от храма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410109
					],
					"speakerTitle": "Любопытная Пачи"
				},
				{
					"id": 200410109,
					"content": "Прошу тебя, разберись с этими монстрами! Возможно, хоть тогда мистер Дулан замолчит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410110,
						200410111
					],
					"speakerTitle": "Любопытная Пачи"
				},
				{
					"id": 200410110,
					"content": "Понятно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200410111,
					"content": "Я с радостью поговорю с мистером Дуланом вместо тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410112
					]
				},
				{
					"id": 200410112,
					"content": "Я ценю это, но поверьте мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410113
					],
					"speakerTitle": "Любопытная Пачи"
				},
				{
					"id": 200410113,
					"content": "С монстрами вам будет намного проще справиться, чем с мистером Дуланом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Любопытная Пачи"
				}
			]
		},
