				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лука"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020101,
					"content": "#Привет! Так ты и есть путешественни{F#ца}{M#к}, слава о {M#котором}{F#которой} гремит повсюду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020102,
						705020103
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705020102,
					"content": "Это я.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				},
				{
					"id": 705020104,
					"content": "Эй! А как же не менее прославленная Паймон?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705020105,
					"content": "Хи-хи, ну конечно. Нынче в «Доле ангелов» проводят мероприятие «Стань барменом за неделю». Думаю, вас это заинтересует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020106
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705020106,
					"content": "В общем, все наши ингредиенты для коктейлей или любых других напитков в вашем распоряжении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020107
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705020107,
					"content": "Главное, чтобы зря не пропадало, а так пейте сколько влезет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020108
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705020108,
					"content": "Пить сколько влезет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705020109,
					"content": "И, конечно же, вам хорошо заплатят, если сможете угодить гостям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020110
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705020110,
					"content": "Что? Ещё и заплатят?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705020111,
					"content": "Ну всё, Паймон клюнула...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020112
					]
				},
				{
					"id": 705020112,
					"content": "Где тут записывают?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705020113,
					"content": "Хоть мы и называем это «Стань барменом за неделю», но строгое присутствие всю неделю не требуется...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020114
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705020114,
					"content": "Вам не обязательно соглашаться прямо сейчас. Вы можете сначала попробовать разок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020115
					],
					"speakerTitle": "Лука"
				},
				{
					"id": 705020115,
					"content": "Ну что? Надумали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лука"
				},
				{
					"id": 705020103,
					"content": "Чем могу помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				}
			]
		},
		{
			"id": 7050202,
			"completionStepIds": [
				7050203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050203",
							"2"
						],
						"stepId": 7050203,
