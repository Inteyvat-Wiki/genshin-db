					"Чарльз"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020301,
					"content": "М-м-м, ты быстро учишься. Очень неплохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020302
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 705020302,
					"content": "Паймон согласна! Вкуснятинка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705020303,
					"content": "Хотя это лишь тренировка. В жизни клиенты хотят чего-нибудь особенного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020304
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 705020304,
					"content": "Кто-то любит насыщенные напитки, кто-то - покислее. Тебе нужно научиться правильно смешивать ингредиенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020305
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 705020305,
					"content": "Я хочу самый большой стакан Карамельных шишек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705020306,
					"content": "Ну вот, пожалуй, и всё. Но чтобы стать выдающимся барменом, нужно не только уметь смешивать, но и общаться с посетителями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020307,
						705020308
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 705020307,
					"content": "Это по мне!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				},
				{
					"id": 705020309,
					"content": "Хорошо, в таком случае стойка ваша. Если у вас возникнут вопросы или понадобится помощь, просто позовите меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020310
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 705020310,
					"content": "Уф... Урок окончен! Эй, а где Карамельные шишки для Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705020311,
					"content": "Так ты и правда хочешь Карамельные шишки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705020308,
					"content": "Обожаю разговоры.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				}
			]
		},
