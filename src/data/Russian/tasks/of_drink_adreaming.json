				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чарльз"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020201,
					"content": "О, знакомые лица! Что вам подать сегодня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020202
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 705020202,
					"content": "Привет, Чарльз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020203
					]
				},
				{
					"id": 705020203,
					"content": "Эй, Чарльз, между прочим, мы хотим стать барменами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705020204,
					"content": "Барменами? Лука вас заманил? Он это умеет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020205
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 705020205,
					"content": "#{NICKNAME}, я знаю, ты прекрасно справляешься с трудностями, однако смешивать коктейли - совсем другое дело. Тут нужен деликатный подход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020206
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 705020206,
					"content": "Соотношение ингредиентов и то, как ты их смешиваешь, может повлиять на напиток.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020207
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 705020207,
					"content": "#Не переживай! {F#Она}{M#Он} просто превосходный повар! А у кулинарии и приготовления коктейлей много общего!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705020208,
					"content": "Хорошо, поверю тебе на слово. Да, и ещё кое-что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020209
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 705020209,
					"content": "В прошлый раз у нас был ученик, который как попало смешал три вида крепких напитков. От одного стаканчика наш гость свалился на пол.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020210
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 705020210,
					"content": "С тех пор мы больше не даём алкогольные ингредиенты новичкам. Надеюсь на понимание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020211
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 705020211,
					"content": "Не проблема.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020212
					]
				},
				{
					"id": 705020212,
					"content": "Отлично. Кажется, мне больше нечего добавить. Ты всё схватываешь на лету.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чарльз"
				}
			]
		},
		{
			"id": 7050203,
			"completionStepIds": [
				7050205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
