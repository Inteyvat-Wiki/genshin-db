						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 762030301,
					"content": "Это Ирминсуль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762030302,
					"content": "А, эта картина? Вам хорошо знакомы белые деревья... но знаете ли вы, что первое предательство ангелов произошло именно под ветвями одного из них?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030303,
						762030304
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030303,
					"content": "Не знаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				},
				{
					"id": 762030305,
					"content": "Паймон интересно послушать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762030306,
					"content": "Пожалуй, пришло время рассказать вам историю, в которой смешались любовь и ужас. Надо подумать, как лучше всего сохранить анонимность всех участников... Придумала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030307
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030307,
					"content": "#Давным-давно жил-был один путешественник, странствовавший среди звёзд. {NICKNAME}, это не имеет к тебе никакого отношения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030308
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030308,
					"content": "Однажды он отправился к серебряному дереву на встречу с принцессой утренней звезды. Вскоре он начал расспрашивать её о самых сокровенных тайнах её государства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030309
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030309,
					"content": "Его слова озадачили принцессу. Как он мог знать обо всех этих вещах, запрещённых богами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030310
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030310,
					"content": "Юноша раскрыл своё происхождение и показал принцессе то, чего она никогда раньше не видела: свободу воли и любовь, благородную и возвышенную.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030311
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030311,
					"content": "Его слова пробудили в ней чувство собственного достоинства, до сих пор скованное богами. Её сердце взлетело, унося её за пределы, которых она никогда раньше не переступала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030312
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030312,
					"content": "Принцесса утренней звезды доверила юноше секреты королевства, и между ними зародилась и расцвела любовь. Вместе с решимостью бросить вызов богам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030313
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030313,
					"content": "Вполне обычная история любви. Где же обещанный ужас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762030314,
					"content": "Не волнуйся, Паймон, ужас вот-вот начнётся. Они мечтали дать людям возможность жить в полной свободе, но боги не смогли простить им измену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030315
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030315,
					"content": "Боги обрушили на них гнев и ярость, разрушив дом влюблённых. А когда великая война улеглась, сила и мудрость принцессы исчезли без остатка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030316
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030316,
					"content": "Даже её самые близкие друзья были прокляты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030317
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030317,
					"content": "...Э-э-э, да... Ужасная концовка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762030318,
					"content": "Но ты обещала рассказать нам о первом ангеле. И, и... ты же не хочешь сказать, что эта история правдива?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762030319,
					"content": "Конечно, правдива, и это самое страшное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030320
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030320,
					"content": "В таком случае я расскажу одну жуткую историю любви.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030321
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030321,
					"content": "Надо подумать, как лучше всего сохранить анонимность всех участников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030322
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030322,
					"content": "Придумала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030304,
					"content": "#Я что-то об этом слышал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				}
			]
		},
