						],
						"pointId": 33
					}
				]
			},
			"dialogs": [
				{
					"id": 762030101,
					"content": "О, вы пришли! А я как раз думала, не нужны ли вам более очевидные указания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030102
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030102,
					"content": "Но потом подумала, что слишком явные подсказки могут помешать вашему путешествию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030103
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030103,
					"content": "И вот, пока я ломала голову над тем, что же мне делать... вы сами пришли! Вот и отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030104
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762030104,
					"content": "Привет, Николь! Ты сегодня такая энергичная! И... такая разговорчивая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762030105,
					"content": "Буду считать это комплиментом! Итак, готовы заглянуть в мою следующую комнату?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Николь"
				}
			]
		},
		{
			"id": 7620302,
			"completionStepIds": [
				7620302
