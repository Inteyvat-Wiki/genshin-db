			},
			"dialogs": [
				{
					"id": 200080101,
					"content": "#Спасибо! Ты спас{F#ла} мне жизнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080102
					],
					"speakerTitle": "Артур"
				},
				{
					"id": 200080102,
					"content": "Эти слаймы появились будто бы из ниоткуда! Я и глазом не успел моргнуть, как они меня окружили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080103
					],
					"speakerTitle": "Артур"
				},
				{
					"id": 200080103,
					"content": "Пожалуйста, не рассказывай об этом моему отцу. Он настаивает, чтобы я никуда не ходил, постоянно говорит, что слаймы здесь ведут себя слишком агрессивно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080104
					],
					"speakerTitle": "Артур"
				},
				{
					"id": 200080104,
					"content": "Я целыми днями торчу дома, но сегодня мне удалось ускользнуть незамеченным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080105
					],
					"speakerTitle": "Артур"
				},
				{
					"id": 200080105,
					"content": "Можешь проверить, есть ли впереди ещё слаймы? Если есть, избавься от них, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080106,
						200080107
					],
					"speakerTitle": "Артур"
				},
				{
					"id": 200080106,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080108
					]
				},
				{
					"id": 200080108,
					"content": "Отлично! Мой отец об этом даже и не узнает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Артур"
				},
				{
					"id": 200080107,
					"content": "Прости, но у нас много других важных дел.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080109
					]
				},
				{
					"id": 200080109,
					"content": "Н-но... Нельзя, чтобы мой отец обо всём узнал... Только ты можешь мне помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Артур"
				}
			]
		}
	]
