			"dialogs": [
				{
					"id": 742500201,
					"content": "Большое спасибо за гостеприимство, госпожа Сандроне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500202,
						742500203
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 742500202,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 742500204,
					"content": "Берегите себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лини"
				},
				{
					"id": 742500203,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
