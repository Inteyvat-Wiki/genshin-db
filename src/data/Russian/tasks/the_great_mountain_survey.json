			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эстер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701040201,
					"content": "#Ты наш{F#ла}{M#ёл} мои маячки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040202
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040202,
					"content": "Да. Вот они.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040203
					]
				},
				{
					"id": 701040203,
					"content": "Дай-ка посмотреть... Верно, это мои маячки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040204
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040204,
					"content": "Судя по их виду, чудовища их не пожалели. Хорошо хоть, они совсем не переломали их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040205
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040205,
					"content": "Эх... Эти маячки можно будет использовать нескоро... Ну, ничего не поделаешь. Придётся обойтись исследованием меньшего масштаба...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040206
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040206,
					"content": "У меня остались другие маячки. Вызовешься ли ты помочь науке и установишь их на горе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040207,
						701040209
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040207,
					"content": "Где именно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040208
					]
				},
				{
					"id": 701040208,
					"content": "#Значит, ты соглас{F#на}{M#ен}? Спасибо! Я отмечу точки установки на твоей карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040215,
					"content": "...Готово. Просто установи маячки примерно в этих местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040216
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040216,
					"content": "Их важно установить там, где повыше. Это скажется на точности исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040209,
					"content": "Почему ты не установишь их сама?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040210
					]
				},
				{
					"id": 701040210,
					"content": "Мне страшно... Целая группа исследователей убегала от чудовищ. Я одна от них точно не отобьюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040211
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040211,
					"content": "Других экспедиций в горы пока не намечается, а исследования вечно откладывать нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040212
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040212,
					"content": "#Больше мне рассчитывать не на кого. Ты так лихо вернул{F#а} те маячки, что я уверена, ты с этим заданием справишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040213
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040213,
					"content": "Я твой должник. Тебя будет ожидать достойная награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040214
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040214,
					"content": "Ах да, позволь мне отметить, куда установить маячки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Эстер"
				}
			]
		},
