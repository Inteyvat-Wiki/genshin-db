			"dialogs": [
				{
					"id": 701040301,
					"content": "Ну как, все маячки на своих местах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040302
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040302,
					"content": "Все маячки установлены.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040303
					]
				},
				{
					"id": 701040303,
					"content": "#Ты сильно помог{F#ла} мне. Это тебе. Ещё раз спасибо огромное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040304
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701040304,
					"content": "Ах, не знаю, можно ли будет с таким количеством маячков добыть хоть немного полезных данных...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эстер"
				}
			]
		},
