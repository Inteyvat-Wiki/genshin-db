				]
			},
			"dialogs": [
				{
					"id": 150360301,
					"content": "#{NICKNAME}, Скирк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360302,
					"content": "Что случилось? Скирк только что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360304
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360304,
					"content": "#В долине Гуйли ты спросил{F#а}, почему он выбрал тебя своей целью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360305
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360305,
					"content": "Теперь я знаю ответ. Дело не только в твоей силе. Сыграла роль ещё и твоя способность «очищать» силу Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360306
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360306,
					"content": "Что бы ни скрывало под собой «очищение», оно позволяет ему делать то, что казалось невозможным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360307
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360307,
					"content": "...проникать сквозь мою защиту и похищать мою силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360308,
						150360309
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360308,
					"content": "Значит, его настоящей целью была ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				},
				{
					"id": 150360310,
					"content": "Нет, он не знал, что я приду в его подземелье. Он похитил часть твоей души, потому что понимал, чего стоит её сила. Но вряд ли ожидал, что она пригодится ему так скоро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360311
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360311,
					"content": "Можете считать это судьбой. Если не ошибаюсь, здесь этим словом называют скучные совпадения вроде этого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360312
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360312,
					"content": "Но для нас это может быть и к лучшему. Зная, для чего ему понадобилась твоя сила, мы сможем вернуть потерянное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360313
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360313,
					"content": "Но ты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360314
					]
				},
				{
					"id": 150360314,
					"content": "Я справлюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360315
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360315,
					"content": "Ну что, ты насытился? Теперь отвечай на мой вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360316
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360316,
					"content": "Откуда у тебя сила Всепожирающего нарвала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360317
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360317,
					"content": "Всепожирающего нарвала?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360318,
					"content": "Точно! Вот почему шипы показались Паймон такими знакомыми... Они похожи на рог нарвала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360319,
					"content": "Вряд ли ты мог овладеть этой силой самостоятельно. Я права?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360320
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360320,
					"content": "Будь ты в самом деле способен одержать победу над Всепожирающим нарвалом, не стал бы рыскать повсюду в поисках останков божества и других источников силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360321
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360321,
					"content": "Всё это означает только одно. Ты знаком с моим наставником, «Рыцарем скверны» Сурталоги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360322
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360322,
					"content": "«Рыцарь скверны»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360323
					],
					"speakerTitle": "Скофнунгр"
				},
				{
					"id": 150360323,
					"content": "Кто смеет так его называть? Сурталоги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360324
					],
					"speakerTitle": "Скофнунгр"
				},
				{
					"id": 150360324,
					"content": "Сурта... логи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360325
					],
					"speakerTitle": "Скофнунгр"
				},
				{
					"id": 150360325,
					"content": "Что случилось? Проглотил больше силы, чем можешь переварить? И теперь не выходит поддерживать даже обычную беседу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360326
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360326,
					"content": "Подожди... Я ещё не...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360327
					],
					"speakerTitle": "Скофнунгр"
				},
				{
					"id": 150360327,
					"content": "Смотрите! Опять!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360328
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360328,
					"content": "Одержимые силой скорее дадут ей поглотить себя, чем откажутся от своей одержимости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360329
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360329,
					"content": "Что нам теперь делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360330
					]
				},
				{
					"id": 150360330,
					"content": "Сохранять спокойствие и трезвый рассудок, чтобы принять подходящее решение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360331
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360331,
					"content": "(Скирк была пронзена одним из шипов, когда возвращала мне душу, и лишилась части своей силы.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360332
					]
				},
				{
					"id": 150360332,
					"content": "(Похититель скрывается где-то в тумане. После битвы я примерно представляю, как он сражается. Если продолжить бой, шансы на победу довольно высоки.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360333
					]
				},
				{
					"id": 150360333,
					"content": "(Но Скирк дышит слабее, чем обычно. Бросившись в атаку, я не смогу обеспечить безопасность Скирк и Паймон. Трудное решение, но...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360334
					]
				},
				{
					"id": 150360334,
					"content": "Уходим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360335
					]
				},
				{
					"id": 150360335,
					"content": "Мудрое решение. Исход войны не решается одной битвой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360336
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360336,
					"content": "Мы вернули утраченную часть твоей души, задание выполнено. Пусть живёт. Это ненадолго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360337
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360337,
					"content": "Выводи нас отсюда. Теперь мы зависим от тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360309,
					"content": "Он с самого начала охотился на тебя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				}
			]
		},
