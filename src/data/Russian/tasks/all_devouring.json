				]
			},
			"dialogs": [
				{
					"id": 150360501,
					"content": "Фух... Теперь мы в безопасности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360502,
					"content": "Я больше не чувствую его присутствия. Скорее всего, он остался в подземелье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360503
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360503,
					"content": "Слабым сущностям нелегко переварить мою силу. Вряд ли он попытается выбраться оттуда, пока сила не усвоена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360504,
						150360505
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360504,
					"content": "Всепожирающий нарвал...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				},
				{
					"id": 150360506,
					"content": "#Ты {F#удивлена}{M#удивлён}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360507
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360507,
					"content": "Ну да... Вы видели лишь малую часть того, на что способен этот кит. В его распахнутой пасти может исчезнуть целая планета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360508
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360508,
					"content": "Его не зря так назвали. Лучше всего на свете он умеет пожирать. Он способен извлечь энергию из любого объекта, живого или мёртвого, если сможет установить с ним физический контакт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360509
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360509,
					"content": "Да, когда мы с ним сражались, Нёвиллет сказал, что у него «инстинкт пожирателя»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360510,
					"content": "Ваш друг-дракон увидел природу его силы и защитил вас с помощью Гидро. Это сработало, поскольку Всепожирающий нарвал был сыт и не так агрессивен, как обычно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360511
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360511,
					"content": "Но другое дело, когда все силы, которыми он питался, оказываются истрачены. Тогда и проявляется истинная сущность Всепожирающего нарвала. В таком состоянии он способен сожрать целую планету, потому я и заперла его в пустом пространстве...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360512
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360512,
					"content": "Но я не подумала, что на этой планете кто-то ещё способен воспользоваться его силой. Это означает, что наш враг встречался со Всепожирающим нарвалом ещё очень давно. Скорее всего, он знаком с моим наставником.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360513
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360513,
					"content": "Да, слова «Рыцарь скверны» были ему знакомы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360514
					]
				},
				{
					"id": 150360514,
					"content": "Да, и поэтому я сразу всё поняла. Значит, мы с тобой получили то, за чем пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360515
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360515,
					"content": "И наша сделка завершена. Твоя душа снова цела, можешь продолжать своё путешествие. А я позабочусь об остальном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360516
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360516,
					"content": "Нет, так нельзя! Ты лишилась силы, пытаясь помочь нам. Мы не можем бросить тебя в беде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360517,
					"content": "Я не в первый раз терплю неудачу и теряю силу. Упавший на дно ущелья должен встать на ноги и снова взбираться наверх, пока не станет ещё сильнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360518
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360518,
					"content": "Но... если тот монстр отыщет тебя, пока ты ещё не до конца восстановила силы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360519
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360519,
					"content": "И вообще, как ты вернёшься домой? Без силы ты не сможешь так запросто открыть врата Бездны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360520,
					"content": "Может, пока побудешь с нами? Хорошая идея, соглашайся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360521,
						150360522
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360521,
					"content": "Мы предлагаем это не из жалости.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360523,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360524
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360524,
					"content": "Я понимаю. Ладно, держите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360525
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360525,
					"content": "Что это?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360526
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360526,
					"content": "Кошелёк с морой. Насколько мне известно, в этом мире за всё нужно платить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360527
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360527,
					"content": "Решите сами, куда мы отправимся. Но поторопитесь, медлить нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360522,
					"content": "Ты говорила, что мне лучше не быть у тебя в долгу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360505,
					"content": "Не могу поверить, что ему удалось отнять твою силу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				}
			]
