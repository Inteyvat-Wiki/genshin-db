			"dialogs": [
				{
					"id": 150360101,
					"content": "Значит... Мы сейчас рядом с Разломом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360102,
					"content": "Да. Отсюда мы сможем добраться до того пространства из твоего сна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360103
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360103,
					"content": "У вас есть опыт взаимодействия с подземельем Бездны, но теперь мы окажемся на чужой территории. Будьте осторожны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360104
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360104,
					"content": "Хорошо! Паймон спрячется у вас за спиной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360105,
					"content": "#Гм... {NICKNAME}, ты тоже не забывай про осторожность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360106,
						150360107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360106,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				},
				{
					"id": 150360108,
					"content": "#Идём. Вспомни, чему ты успел{F#а} научиться. Возможно, скоро эти навыки пригодятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360107,
					"content": "Давайте проучим этого воришку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				}
			]
		},
