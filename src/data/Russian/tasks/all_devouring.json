							-180.436
						],
						"pointId": 51
					}
				]
			},
			"dialogs": [
				{
					"id": 150360201,
					"content": "Кажется, здесь дорога обрывается! Мы что, пришли к его убежищу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360202,
					"content": "Какой густой туман! Ничего не видно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360203,
					"content": "#Здесь на тебя и напали, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360204
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360204,
					"content": "И где-то рядом часть твоей души. Ты чувствуешь, где она?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360205
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360205,
					"content": "(Если закрыть глаза и сосредоточиться на свете, который исходил от раны... Да, я чувствую, что она рядом, но не могу сказать, где именно её прячут.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360206,
						150360207
					]
				},
				{
					"id": 150360206,
					"content": "Нет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				},
				{
					"id": 150360208,
					"content": "#Похоже, наш противник на всякий случай замёл следы. Иначе ты бы ясно почувствовал{F#а}, где он её прячет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360209
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360209,
					"content": "Смотрите! Шипы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150360210,
					"content": "Спокойно. Дадим нашему врагу развернуться, заодно увидим, с кем имеем дело. Наше безрассудство будет ему только на руку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360211
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360211,
					"content": "Он забрал часть твоей души не просто так. Вероятно, он как-то встроил её в свои атаки. Если не будем терять голову, то сможем его выследить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Скирк"
				},
				{
					"id": 150360207,
					"content": "Но она где-то рядом...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				}
			]
		},
