			"dialogs": [
				{
					"id": 411490301,
					"content": "#Я слышал{F#а}, что есть особый заказ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411490302
					]
				},
				{
					"id": 411490302,
					"content": "Да, ты как раз вовремя. Валлит недавно заказал у нас блинчики к чаю и уже оплатил их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490303
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 411490303,
					"content": "Он попросил доставить их куда-то к югу от каньона Светлой короны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490304
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 411490304,
					"content": "Почему-то последнее время всё больше и больше заказов на доставку, а у нас людей не хватает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490305
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 411490305,
					"content": "Можешь помочь, если ты не против?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сара"
				}
