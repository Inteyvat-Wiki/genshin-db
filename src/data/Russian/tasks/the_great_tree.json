					"Ясмин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230270101,
					"content": "Думаю, нужно хорошенько всё осмотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270102
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270103
					]
				},
				{
					"id": 230270103,
					"content": "#Ты же... О, ты же настоящ{F#ая}{M#ий} путешественн{F#ица}{M#ик}, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270104
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270104,
					"content": "Я Ясмин, студентка Амурты, сейчас изучаю Священное древо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270105
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270105,
					"content": "Количество лет, прожитых этим Священным древом, превышает количество рисинок во всех пловах в Порт-Ормосе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270106
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270106,
					"content": "Кроме того, оно поддерживает Академию... Это так же важно, как овощи под жареным цыплёнком в тандыре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270107,
						230270108
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270107,
					"content": "Вот это метафоры...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270110
					]
				},
				{
					"id": 230270110,
					"content": "Если с ним что-нибудь случится, то в Сумеру произойдут страшные катастрофы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270111
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270111,
					"content": "Например, если в нём заведутся насекомые, то изнутри вырвется саранча размером с крышу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270112
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270112,
					"content": "Или, если ветви будут бесконтрольно разрастаться, а огромная корневая система пробьётся из-под земли, то все дома будут разрушены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270113
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270113,
					"content": "Или, если Священное древо вдруг засохнет, то при падении раздавит половину Сумеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270114
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270114,
					"content": "Нет, этого не должно произойти!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270115
					]
				},
				{
					"id": 230270115,
					"content": "Ох, конечно. На данный момент с ним всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270116
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270116,
					"content": "Тем не менее, когда ты соберёшься в лес за грибами, плесенники не будут предупреждать тебя заранее о внезапном нападении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270117
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270117,
					"content": "Поэтому я и здесь. Я наблюдаю за состоянием этого дерева и готовлюсь к различным возможным несчастьям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270118
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270118,
					"content": "Но, как видите, несмотря на то, что мой разум быстр, как сумеречная птица, сил у меня, как у гриба-звезды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270119
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270119,
					"content": "#Поэтому, путешественни{F#ца}{M#к}, не мог{F#ла} бы ты описать состояние корневой системы Священного древа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270120
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270120,
					"content": "Обычно я нанимаю себе в помощь искателей приключений, но сейчас они, кажется, заняты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270121,
						230270122
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270121,
					"content": "Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230270122,
					"content": "Все учёные так странно разговаривают?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270123
					]
				},
				{
					"id": 230270123,
					"content": "Что? Ты имеешь в виду метафоры? Извини, у меня всегда была такая манера говорить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270124
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270124,
					"content": "Многие в Академии подмечали это, но я не могу вот так взять и измениться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270125
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270125,
					"content": "Благодарю. Буду ждать тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270108,
					"content": "В твоём духе, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270109
					]
				},
				{
					"id": 230270109,
					"content": "Это действительно великое дерево...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270110
					],
					"speakerTitle": "Паймон"
				}
			]
		},
