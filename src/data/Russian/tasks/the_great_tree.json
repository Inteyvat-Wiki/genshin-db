			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ясмин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230271101,
					"content": "#Ты вернул{F#ась}{M#ся}! В каком состоянии корневая система?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271102
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230271102,
					"content": "Вы описали Ясмин состояние корней...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230271103
					]
				},
				{
					"id": 230271103,
					"content": "...Ох, раз там собрались живые существа, значит, земля ещё обладает жизненной силой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271104
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230271104,
					"content": "Следовательно, корни Священного древа тоже должны спокойно расти, пока не возникнут какие-нибудь серьёзные проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271105
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230271105,
					"content": "Единственное, о чём нужно волноваться... Это возможное ухудшение качества воды в водоемах поблизости, что может привести к увеличению числа плесенников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271106
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230271106,
					"content": "Ах да, вот награда за труды. Спасибо за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271107
					],
					"speakerTitle": "Ясмин"
