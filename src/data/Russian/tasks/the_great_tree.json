				"points": []
			},
			"dialogs": [
				{
					"id": 230270201,
					"content": "#Путешественни{F#ца}{M#к}! Мы снова встретились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270202
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270202,
					"content": "Ты ещё исследуешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270203
					]
				},
				{
					"id": 230270203,
					"content": "Ага, Ладеп и Фарез сказали, что нужно больше данных, так что я продолжу свою работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270204
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270204,
					"content": "Однако я не знаю, в каком сейчас состоянии корни дерева...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270205
					],
					"speakerTitle": "Ясмин"
				},
				{
					"id": 230270205,
					"content": "#Путешественни{F#ца}{M#к}, если у тебя есть время, не мог{F#ла} бы ты описать состояние корневой системы Священного древа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясмин"
				}
			]
		},
