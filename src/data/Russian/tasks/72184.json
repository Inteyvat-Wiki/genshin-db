			},
			"dialogs": [
				{
					"id": 721840201,
					"content": "О, привет! Могу я чем-нибудь помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840202
					],
					"speakerTitle": "Риэ"
				},
				{
					"id": 721840202,
					"content": "Насчёт пиццы из ресторана Киминами...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840203
					]
				},
				{
					"id": 721840203,
					"content": "О, эта пицца и правда очень вкусная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840204
					],
					"speakerTitle": "Риэ"
				},
				{
					"id": 721840204,
					"content": "Но... Как бы это сказать... Я не слишком привычна к такому вкусу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840205
					],
					"speakerTitle": "Риэ"
				},
				{
					"id": 721840205,
					"content": "Просто я думаю, что если добавить в пиццу кое-какие инадзумские ингредиенты, такие как фиалковая дыня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840206
					],
					"speakerTitle": "Риэ"
				},
				{
					"id": 721840206,
					"content": "Возможно, пицца завоюет всеобщую популярность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Риэ"
				}
			]
		},
		{
			"id": 7218403,
			"completionStepIds": [
				7218403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
