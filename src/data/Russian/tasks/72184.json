			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Киминами Анна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721840301,
					"content": "#Путешественни{F#ца}{M#к}, ты вернул{F#ась}{M#ся}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840302
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840302,
					"content": "Как всё прошло, есть отзывы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840303
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840303,
					"content": "Что касается отзывов клиентов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840304
					]
				},
				{
					"id": 721840304,
					"content": "Пицца с фиалковой дыней... Не очень сложно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840305
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840305,
					"content": "Остальные ингредиенты - как обычно. Что ж, поскольку отзыв был «добавить кое-какие местные инадзумские ингредиенты», значит, я могу использовать и некоторые другие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840306
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840306,
					"content": "Хм-м, морской гриб? Трава наку? О, а как насчёт светящегося гриба?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840307
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840307,
					"content": "Э, нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840308
					]
				},
				{
					"id": 721840308,
					"content": "О! Прошу прощения, я как раз думаю о том, какие добавить ингредиенты! Так, посмотрим. Думаю, фиалковых дынь в магазине осталось немного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840309
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840309,
					"content": "#Путешественни{F#ца}{M#к}, помоги мне достать фиалковых дынь. Что касается ингредиентов... Недостаёт только их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840310,
						721840312
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840310,
					"content": "Я обо всём позабочусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840311
					]
				},
				{
					"id": 721840311,
					"content": "Так, значит, я на тебя рассчитываю. Одной фиалковой дыни будет достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840312,
					"content": "Нужны ещё какие-нибудь ингредиенты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840313
					]
				},
				{
					"id": 721840313,
					"content": "В магазине ещё остались кое-какие ингредиенты. Пожалуйста, просто принеси фиалковую дыню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Киминами Анна"
				}
			]
		},
