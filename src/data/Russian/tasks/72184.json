			"dialogs": [
				{
					"id": 721840501,
					"content": "Спасибо, этого будет достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840502
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840502,
					"content": "Интересно, какой будет на вкус пицца с местными инадзумскими ингредиентами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840503
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840503,
					"content": "Готово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840504
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840504,
					"content": "Эта пицца выглядит... довольно хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840505
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840505,
					"content": "#Спасибо за помощь, путешественни{F#ца}{M#к}. Вот, возьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840506
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840506,
					"content": "Я обязательно буду смаковать вкус этой пиццы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840507
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 721840507,
					"content": "Если получилось неплохо... Скоро она официально станет новым блюдом нашего меню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Киминами Анна"
				}
			]
		},
