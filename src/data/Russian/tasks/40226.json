			"dialogs": [
				{
					"id": 402260201,
					"content": "Вы провожаете Навию и Клоринду на выставку.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402260202
					]
				},
				{
					"id": 402260202,
					"content": "Выставка больше, чем я представляла, но людей не так много...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260203
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 402260203,
					"content": "Должно быть, потому что выставка ещё не началась. Похоже, Ягоде не помешает наша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402260204,
					"content": "Тогда мы с Клориндой займёмся подготовкой. Обязательно загляните к нам на стенд, когда будет возможность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Навия"
				}
			]
		}
	]
