				]
			},
			"dialogs": [
				{
					"id": 402260101,
					"content": "«Флагман»... Значит, этот участник решил сначала разобраться с жильём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402260102,
					"content": "#{M#Напарник}{F#Напарница}! Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260103
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 402260103,
					"content": "Навия, давно не виделись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260104,
						402260105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402260104,
					"content": "Полагаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				},
				{
					"id": 402260106,
					"content": "Да, Спина-ди-Росула - один из участников выставки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260107
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 402260107,
					"content": "Главарь преступного мира... Да, всё сходится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402260108,
					"content": "Главарь преступного мира... Да, всё сходится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402260109,
					"content": "Ха-ха, это моё новое прозвище? Круто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260110
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 402260110,
					"content": "Как хорошо, что мы вас нашли! Мы выполняем поручение. Помогаем регистрировать участников выставки, проверяем товары и всё такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402260111,
					"content": "Вот как! Садитесь, давайте поговорим. Я как раз заказала много блюд. Клоринда и Шеврёз распаковывают вещи, но должны вот-вот подойти... Ха, а вот и они!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260112
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 402260112,
					"content": "Говорите о нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260113
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 402260113,
					"content": "Клоринда! Шеврёз! Привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402260114,
					"content": "Нод-Край - непредсказуемое и опасное место. Учитывая значение Спина-ди-Росула для Фонтейна, я не могу позволить, чтобы с действующей главой здесь что-то случилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260115
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 402260115,
					"content": "Мне нравится путешествовать с друзьями, но... Посмотри, на меня! Что может случиться плохого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260116
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 402260116,
					"content": "С таким беспечным подходом, кто знает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260117
					],
					"speakerTitle": "Клоринда"
				},
				{
					"id": 402260117,
					"content": "Пусть так. Думаю, нашего лучшего судебного дуэлянта можно записать как моего... телохранителя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260118
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 402260118,
					"content": "Главарь преступного мира и её телохранитель... Записали. Шеврёз, тебя тоже записать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402260119,
					"content": "Меня регистрировать не нужно, я здесь по служебной необходимости. Многие крупные дела в последнее время связаны с Нод-Краем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260120
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 402260120,
					"content": "О-о, тогда Паймон не будет задавать лишних вопросов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402260121,
					"content": "Ах да, ещё одно! Что Спина-ди-Росула планирует продавать на выставке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402260122,
					"content": "Вот! Это одно из новейших изобретений Исследовательского института Фонтейна. Своего рода релейная система, которая позволяет пользователю высвобождать энергию пневмы и усии в бою!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260123
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 402260123,
					"content": "То есть это... оружие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402260124,
					"content": "Конечно! На рынке без правового контроля оружие - один из самых ходовых товаров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260125
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 402260125,
					"content": "Да... но хвастаться перед Шеврёз отсутствием необходимости соблюдать закон как-то неправильно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402260126,
					"content": "Я не против. Я не раз читала о «территориях вне закона» в криминальных романах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260127
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 402260127,
					"content": "Как детектив, я знаю, что мне придётся на время забыть о правилах, если я хочу добиться результата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260128
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 402260128,
					"content": "И на этой ноте я должна приступить к работе. Особый патруль ждёт меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260129
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 402260129,
					"content": "Если готовы, мы проводим вас на выставку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402260130,
					"content": "Хорошо, приступим! Я тоже хочу прикупить всякого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Навия"
				},
				{
					"id": 402260105,
					"content": "...вы тоже приехали на выставку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				}
			]
		},
