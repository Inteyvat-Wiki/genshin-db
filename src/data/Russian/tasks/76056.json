			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Терхо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560101,
					"content": "Привет! Не скучно тебе целый день торчать здесь и стрелять по мишеням? Силы тебе не занимать. Может, хочешь с нами пару приёмчиков отработать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Терхо"
				}
			]
		},
		{
			"id": 7605602,
			"completionStepIds": [
				7605601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605601",
							"2"
						],
						"stepId": 7605601,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7605601",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Терхо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560201,
					"content": "#Всего-то пару? Я думал{F#а}, будет больше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560202
					]
				},
				{
					"id": 760560202,
					"content": "#Ха-ха, вот это правильный настрой! Нет занятия интересней, чем помериться силами с достойными противниками! Белов, начинай! Проведи пару раундов с {F#нашей гостьей}{M#нашим гостем}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560205
					],
					"speakerTitle": "Терхо"
				},
				{
					"id": 760560205,
					"content": "#Хорошо, босс! Я в два счёта уложу {F#её}{M#его} на лопатки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Белов"
				}
			]
		},
		{
			"id": 7605603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605601",
							"2"
						],
						"stepId": 7605601,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7605601",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Терхо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560301,
					"content": "#Извини, но сейчас я занят{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560302
					]
				},
				{
					"id": 760560302,
					"content": "Ничего страшного, нам всё равно особенно нечем заняться. Приходи, когда освободишься или заскучаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Терхо"
				}
			]
		},
		{
			"id": 7605604,
			"completionStepIds": [
				7605602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605602",
							"2"
						],
						"stepId": 7605602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Терхо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560401,
					"content": "Простите, босс... Я вас подвёл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560402
					],
					"speakerTitle": "Белов"
				},
				{
					"id": 760560402,
					"content": "Эй, да перестань, Белов, мы ведь просто дурака валяем. Давай, отдохни пока в сторонке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560403
					],
					"speakerTitle": "Терхо"
				},
				{
					"id": 760560403,
					"content": "В твоих движениях столько силы! Меня зовут Терхо, большая честь с тобой познакомиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560404
					],
					"speakerTitle": "Терхо"
				},
				{
					"id": 760560404,
					"content": "#Я {NICKNAME}, рад{F#а} встрече!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560405
					]
				},
				{
					"id": 760560405,
					"content": "#Вижу, ты {F#опытная воительница}{M#опытный воин}. Придётся нам попотеть. Ладно, первый бой не в счёт, давай начнём заново! Инкали, твой выход!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560406
					],
					"speakerTitle": "Терхо"
				},
				{
					"id": 760560406,
					"content": "#Пока всё хорошо, босс обо мне и не вспомнит... Ничего не поделаешь. Ладно, {F#умелица}{M#умелец}, давай начинать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Инкали"
				}
			]
		},
		{
			"id": 7605605,
			"completionStepIds": [
				7605603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605603",
							"2"
						],
						"stepId": 7605603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Терхо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560501,
					"content": "#Я... я проиграла... проиграла {F#какой-то незнакомке}{M#какому-то незнакомцу}... Да быть не может!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560502
					],
					"speakerTitle": "Инкали"
				},
				{
					"id": 760560502,
					"content": "Значит, даже Инкали тебе не страшна... Мы тебя недооценили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560503
					],
					"speakerTitle": "Терхо"
				},
				{
					"id": 760560503,
					"content": "Это не ваша вина, босс. Кто мог подумать, что нам случайно встретится такой сильный противник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560504
					],
					"speakerTitle": "Белов"
				},
				{
					"id": 760560504,
					"content": "Босс! Нельзя дать им уйти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560505
					],
					"speakerTitle": "Инкали"
				},
				{
					"id": 760560505,
					"content": "О? Разве это не дружеский поединок?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560506
					]
				},
				{
					"id": 760560506,
					"content": "Поймите нас правильно: нам трудно принять поражение. Мы всё-таки охотники за сокровищами и дорожим своей репутацией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560507
					],
					"speakerTitle": "Терхо"
				},
				{
					"id": 760560507,
					"content": "#{NICKNAME}, я официально вызываю тебя на бой. И я имею в виду не тренировочный бой. Сразимся в полную силу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560508
					],
					"speakerTitle": "Терхо"
				},
				{
					"id": 760560508,
					"content": "Тогда выходите против меня все втроём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560509
					]
				},
				{
					"id": 760560509,
					"content": "Хорошо, мы церемониться не будем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Терхо"
				}
			]
		},
		{
			"id": 7605606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
