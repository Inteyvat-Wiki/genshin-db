				"points": []
			},
			"dialogs": [
				{
					"id": 411111601,
					"content": "Приветствую вас! Я сестра Эдна, ухаживаю за больными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111602
					],
					"speakerTitle": "Эдна"
				},
				{
					"id": 411111602,
					"content": "Сейчас же назови себя, о безумец кошмаров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111603
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411111603,
					"content": "Прошу прощения, это не о вас. Господин, что лежит за вами - он что-нибудь говорил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111604
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411111604,
					"content": "Да... Кажется, что-то о возвращении к работе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111605
					],
					"speakerTitle": "Эдна"
				},
				{
					"id": 411111605,
					"content": "А... Вино... Вино...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111606
					],
					"speakerTitle": "Хартман"
				},
				{
					"id": 411111606,
					"content": "Его работа связана с вином?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111607
					]
				},
				{
					"id": 411111607,
					"content": "Кажется, он очень крепко спит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111608
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411111608,
					"content": "Это не обычный сон... Это проклятие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111609
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411111609,
					"content": "А нельзя ли его просто разбудить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111610,
					"content": "Я уже пробовала. Он, было, проснулся, но через миг снова заснул.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111611
					],
					"speakerTitle": "Эдна"
				},
				{
					"id": 411111611,
					"content": "Когда он проснулся, то что-нибудь сказал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111612,
					"content": "Он говорил, что ему снится гора, и ему очень холодно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111613
					],
					"speakerTitle": "Эдна"
				},
				{
					"id": 411111613,
					"content": "Гора? Холодно? Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111614,
					"content": "Уж не холодное ли проклятье демона снежной горы это?.. Увы, пал взор злого демона на владения родниковой феи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111615
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411111615,
					"content": "Сложилась мрачная картина... Но не страшитесь, ибо проклятие развею я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111616
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411111616,
					"content": "Извините, если помешал... Вы не заняты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111617
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 411111617,
					"content": "О, привет, Драфф! Что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111618,
					"content": "Э... Неловко об этом говорить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111619
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 411111619,
					"content": "Один из <color=#00E1FFFF>метеоритов</color> упал на <color=#00E1FFFF>холм за деревней</color>. <color=#00E1FFFF>Аллан</color> всем сказал, что собирается пойти и посмотреть на него, и тут же убежал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111620
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 411111620,
					"content": "Вы уже видели, что метеориты опасны. Боюсь, что с ним что-то случилось... Не могли бы вы пойти поискать его со мной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111621
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 411111621,
					"content": "Значит... с неба падают горящие камни, а он волнуется, как бы ничего не пропустить?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111622
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111622,
					"content": "Именно! Когда этот сорванец вернётся, его будет ждать крепкая взбучка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111623
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 411111623,
					"content": "Вот это правильно. Пойдём и поищем его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4111117,
			"completionStepIds": [
				4111117
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111117",
							"2"
						],
						"stepId": 4111117,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аллан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411111701,
					"content": "Фух! Я думал, что мне тут конец придёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111702
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 411111702,
					"content": "Дуралей! Ты чем думал, когда решил в такое-то время шататься по округе?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111703
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 411111703,
					"content": "Виноват... Я больше не буду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111704
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 411111704,
					"content": "Приношу извинения за доставленные Алланом неприятности. Я уж прослежу, чтобы он этот урок запомнил надолго!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111705
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 411111705,
					"content": "В следующий раз подумаешь дважды, прежде чем дурака валять!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111706,
					"content": "Метеорит находится вон там.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111707
					]
				},
				{
					"id": 411111707,
					"content": "Паймон подойдёт побли... Ой! Принцесса, твой <color=#00E1FFFF>Глаз Бога мерцает</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111708,
					"content": "Хм? Неужто мой «Мистический шар бездны» кончину хладному проклятью предрекает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111709
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411111709,
					"content": "Эм... А на что твой Глаз Бога реагирует?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111710,
					"content": "На непостижимые загадки, шёпот звёзд, проклятия демонических останков, а ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111711
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411111711,
					"content": "Тебе обязательно так выражаться? Паймон твои речи совершенно не понимает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111712,
					"content": "Прошу простить нас, принцесса не очень хорошо владеет языком смертных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111713
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411111713,
					"content": "Поэтому ты у неё за переводчика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111714,
					"content": "Боюсь, вы неправильно поняли. Я не перевожу, но лишь доношу волю принцессы. Полагаю, что её <color=#00E1FFFF>Глаз Бога</color> откликается на <color=#00E1FFFF>энергию элементов</color> в этой местности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111715
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411111715,
					"content": "Кхм, благодарю, Оз. Те, чей разум затуманен бренным миром, узреть значение слов принцессы сразу, в отличие от тебя, не способны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111716
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411111716,
					"content": "Значит, в метеоритах есть энергия элементов? И твой Глаз Бога, реагируя на неё, мерцает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111717,
						411111718
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111717,
					"content": "Можно ли отследить источник энергии?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				},
				{
					"id": 411111719,
					"content": "Паймон думает... Может, так и есть? Давайте попробуем отыскать <color=#00E1FFFF>осколки метеоритов</color> с помощью <color=#00E1FFFF>Глаза Бога</color> Фишль, и сделаем округу безопаснее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111718,
					"content": "Он должен реагировать и на сам источник!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				}
			]
		},
