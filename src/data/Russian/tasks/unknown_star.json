			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джойс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110601,
					"content": "Смертные! Принцесса милостиво позволяет отбросить привычный церемониал и сразу же переходить к изложению подробностей этого дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110602
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411110602,
					"content": "Хм? А вы кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110603
					],
					"speakerTitle": "Джойс"
				},
				{
					"id": 411110603,
					"content": "Прошу прощения, господин. Мы надеемся, вы сможете рассказать нам о том, что именно произошло с потерпевшими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110604
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411110604,
					"content": "Погодите, Паймон сейчас объяснит! Мы пришли по поручению Гильдии искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411110605,
					"content": "Ах, вот оно что. Вчера вечером эта бедняжка дотронулась до метеорита и тут же упала без сознания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110606
					],
					"speakerTitle": "Джойс"
				},
				{
					"id": 411110606,
					"content": "Поэтому, как бы вы не собирались проводить расследование, заклинаю вас: не прикасайтесь к метеоритам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110607
					],
					"speakerTitle": "Джойс"
				},
				{
					"id": 411110607,
					"content": "Чушь! Принцесса сия находится под защитой «Мистического шара бездны». Разве ей может угрожать какой-то жалкий чёрный кристалл?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110608
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411110608,
					"content": "Вовсе нет, госпожа. Та принцесса мудра, которая прислушивается разумным советам подчинённых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110609
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411110609,
					"content": "Вот как... Тогда я поступлю в соответствии с советом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110610
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411110610,
					"content": "#То же самое касается и тебя, {NICKNAME}! Мудр тот путешественник, что прислушивается к советам умных людей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411110611,
					"content": "Ладно, Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110612
					]
				},
				{
					"id": 411110612,
					"content": "Паймон так ещё никогда не разговаривала... Но ей это определённо нравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411110613,
					"content": "Ты смеешь имитировать манеру выражения принцессы?! Хм! Смертным не постичь скорби гибели тысячи миров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110614
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411110614,
					"content": "Может, это и к лучшему. Ноша Принцессы осуждения показалась бы тебе слишком гнетущей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110615
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411110615,
					"content": "Только после вас, принцесса.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
