			"dialogs": [
				{
					"id": 411111501,
					"content": "Здесь ещё одна жертва!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111502,
					"content": "Прошу, ответь мне, рыцарь, какое несчастье постигло этого беднягу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111503
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411111503,
					"content": "Э... Он... Он целый день проспал, и, похоже, не собирается просыпаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111504,
						411111506
					],
					"speakerTitle": "Адлер"
				},
				{
					"id": 411111504,
					"content": "Он прикасался к метеориту?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111505
					]
				},
				{
					"id": 411111505,
					"content": "Да. А теперь он крепко спит, и порой чего-то бормочет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111508
					],
					"speakerTitle": "Адлер"
				},
				{
					"id": 411111508,
					"content": "Больше не могу... Давай передохнём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111509
					],
					"speakerTitle": "Адлер"
				},
				{
					"id": 411111509,
					"content": "Ч-что происходит? Почему он это сказал?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111510,
					"content": "Тёмный сон его подобен запретному плоду в челюстях свирепой твари, которая очами чернее чёрной черноты увлекает слабого в бездну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111511
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411111511,
					"content": "Ты хочешь сказать, что во сне его что-то манит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111512,
					"content": "Доказать этого мы пока не можем, но интуиция принцессы ещё никогда не подводила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111513
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411111513,
					"content": "Хм... Давайте продолжим расследование!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111506,
					"content": "Были у него другие симптомы помимо глубокого сна?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111507
					]
				},
				{
					"id": 411111507,
					"content": "Пока нет. Но иногда он разговаривает во сне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111508
					],
					"speakerTitle": "Адлер"
				}
			]
		},
		{
			"id": 4111116,
