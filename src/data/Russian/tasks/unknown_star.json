			},
			"dialogs": [
				{
					"id": 411111801,
					"content": "Похоже, последний. Помогло ли это жителям Спрингвейла?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111802,
					"content": "Метеориты, в которых заключена энергия элементов... Подлинным источником бедствия были они или нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111803
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411111803,
					"content": "Святую клятву я принести могу, что кошмары насылали именно эти метеориты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111804
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411111804,
					"content": "Тогда пойдём в деревню и проверим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111805
					]
				},
				{
					"id": 411111805,
					"content": "Ага!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}