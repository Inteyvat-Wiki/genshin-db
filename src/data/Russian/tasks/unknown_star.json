				"points": []
			},
			"dialogs": [
				{
					"id": 411111401,
					"content": "Эдна, мы избавились от метеорита на холме за деревней. Стало ли пострадавшим лучше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111402,
					"content": "Только что благодаря вам двое из пострадавших очнулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111403
					],
					"speakerTitle": "Эдна"
				},
				{
					"id": 411111403,
					"content": "Дайте ещё немного поспать... *Зевает*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111404
					],
					"speakerTitle": "Хартман"
				},
				{
					"id": 411111404,
					"content": "Отлично! Сработало!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111405,
					"content": "Если бы вы могли избавиться от остальных <color=#00E1FFFF>метеоритов</color> в округе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111406
					],
					"speakerTitle": "Эдна"
				},
				{
					"id": 411111406,
					"content": "Тогда проснулись бы все остальные!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111407
					]
				},
				{
					"id": 411111407,
					"content": "Ах, поистине воодушевляющая весть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111408
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411111408,
					"content": "Хи-хи, вот что бывает, если в дело вступает принцесса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111409
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411111409,
					"content": "Господин, который только что проснулся, что вам снилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111410,
					"content": "Помню только пронизывающий холод. Я всё шёл по горной тропе... Среди <color=#00E1FFFF>льда и снега</color>, кажется...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111411
					],
					"speakerTitle": "Хартман"
				},
				{
					"id": 411111411,
					"content": "По горной тропе? Просто так шли? Без цели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411111412,
					"content": "Я и сам не знаю. Во сне мною будто управлял кто-то другой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111413
					],
					"speakerTitle": "Хартман"
				},
				{
					"id": 411111413,
					"content": "Это точно было проклятие. О, многострадальная земля...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111414
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411111414,
					"content": "(Проклятие? Неужели это так?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111415
					]
				},
				{
					"id": 411111415,
					"content": "Как бы то ни было, мы теперь точно знаем, как избавляться от метеоритов. Нас ещё ждёт куча работы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
