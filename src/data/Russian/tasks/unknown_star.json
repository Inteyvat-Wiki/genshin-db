			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110101,
					"content": "#Ты как раз вовремя, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110102
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 411110102,
					"content": "Что-то случилось, Катерина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411110103,
					"content": "Боюсь, что так. Случилось кое-что серьёзное, и нам срочно нужна помощь всех доступных искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110104
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 411110104,
					"content": "#В связи с этим у меня есть для тебя очень важное поручение, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110142
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 411110142,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110105
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 411110105,
					"content": "Ох, как всё серьёзно звучит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411110106,
					"content": "По правде говоря, мы и сами впервые столкнулись с такой ситуацией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110107
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 411110107,
					"content": "Местные члены гильдии загружены до предела, поэтому мы можем полагаться только на совместные усилия путешествующих по Тейвату искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110108,
						411110109
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 411110108,
					"content": "Доверь это мне!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				},
				{
					"id": 411110110,
					"content": "Подожди секундочку. Безопасность превыше всего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110111
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 411110111,
					"content": "Катерина! Подданная Нирваны Ночи. Ветер обманул мои уши, или ты занимаешься воспеванием славного имени своей Принцессы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110112
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411110112,
					"content": "Ах, вот и вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110113
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 411110113,
					"content": "Вот мы и встретились снова, Катерина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110114
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411110114,
					"content": "А! Этот ворон - говорящий!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411110115,
					"content": "Ха-ха! Уверен, на своём пути вы повидали чудеса намного более удивительнее обычного говорящего ворона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110116
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411110116,
					"content": "Судя по трепету и застывшему на ваших лицах ужасу, мои верные подданные, мерзкое всеотравляющее зло вновь угрожает миру и спокойствию нашего любимого Мондштадта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110117
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411110117,
					"content": "Путешественники, позвольте представить вам госпожу Фишль, опытного члена Гильдии искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110118
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 411110118,
					"content": "#Фишль, Оз, это т{F#а}{M#от} сам{F#ая}{M#ый} путешественни{F#ца}{M#к}, о которо{F#й}{M#м} я вам рассказывала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110119
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 411110119,
					"content": "#Ох, так вот как{F#ая}{M#ой} ты, путешественни{F#ца}{M#к}. Хм... Твой взгляд мне по {F#душе}{M#вкусу}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110120
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411110120,
					"content": "#Почётный рыцарь Ордо Фавониус и е{F#ё}{M#го} славная спутница Паймон, для нас великая честь познакомиться с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110121
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411110121,
					"content": "#Путешественни{F#ца}{M#к}, ты тоже жаждешь покончить с этими кристаллами безгранично глубокой тьмы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110122
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411110122,
					"content": "Покончить с... какими бескритично глубокими кристаллами? Какой тьмы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411110123,
					"content": "Катерина, ты разве упоминала об этом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110125
					]
				},
				{
					"id": 411110125,
					"content": "Миледи говорит о <color=#00E1FFFF>метеоритах</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110126
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411110126,
					"content": "Гильдия всё ещё не может определить причины и последствия метеоритного дождя, поэтому мы рекомендуем искателям приключений отправляться на выполнение этого поручения минимум по двое человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110127
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 411110127,
					"content": "#{NICKNAME}, Фишль, прошу вас, позаботьтесь друг о друге и всегда будьте начеку. Действуйте исходя из соображений безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110128
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 411110128,
					"content": "Ты всегда была верна мне, Катерина, поэтому я исполню твою просьбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110129
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411110129,
					"content": "#Возрадуйся! Ты будешь всю оставшуюся жизнь гордиться тем, что путешествовал{F#а} и сражал{F#ась}{M#ся} плечом к плечу с самой Принцессой осуждения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110130
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411110130,
					"content": "Это моя госпожа, прибывшая из другого мира, Принцесса осуждения Нирваны Ночи, Фишль. А я её смиренный слуга и фамильяр, ворон Оз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110131
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411110131,
					"content": "К-какие у вас интересные отношения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411110132,
					"content": "#Меня зовут Паймон, а это {NICKNAME}, не обижайте е{F#ё}{M#го}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110133,
						411110134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411110133,
					"content": "Так вы... из другого мира?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110135,
					"content": "Со временем всё встанет на свои места... Чем больше времени вы проведёте с мисс Фишль, тем понятнее и яснее станет её история.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110136
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 411110136,
					"content": "Ещё один путник, который слеп к величию Нирваны Ночи, царства вечной тьмы. Но невежество, а отнюдь не богохульство, является причиной его преступления. Поэтому сегодня Принцесса осуждения проявит милосердие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110137
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411110137,
					"content": "Милосердие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110138
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411110138,
					"content": "Миледи хочет сказать: «Здравствуйте».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110139
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411110139,
					"content": "Паймон видела много дуэтов, но эти спелись как-то по-особому. Хозяйка звучит так загадочно и таинственно, но как только встревает её слуга, все её речи начинают казаться до ужаса дурацкими...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411110140,
					"content": "Я уверен, у вас к нам множество вопросов. Давайте поговорим по пути к нашему заданию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110141
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411110141,
					"content": "Кстати, а что там говорили про отряды из двух человек? Смотрите, у нас собрался отряд из целых четверых!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411110134,
					"content": "#Нирвана Ночи? Никогда раньше не слышал{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110109,
					"content": "Спасибо, что сообщила. Я берусь за это поручение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				}
			]
		},
		{
