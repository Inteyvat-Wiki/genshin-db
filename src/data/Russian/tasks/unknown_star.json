			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Фишль"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110501,
					"content": "Это Спрингвейл. Катерина сказала, что ближе всего к Мондштадту метеорит упал именно здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411110502,
					"content": "Всё выглядит куда хуже, чем можно было предположить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110503
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411110503,
					"content": "Столько людей без сознания...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110504
					]
				},
				{
					"id": 411110504,
					"content": "Бейте в колокола, трубите в трубы, ведь настал судный день! Жаждущие искупления да возрадуются, ибо явилась Принцесса осуждения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110505
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411110505,
					"content": "Рвению этой принцессы можно только позавидовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4111106,
			"completionStepIds": [
				4111106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111106",
							"2"
						],
						"stepId": 4111106,
						"stateName": "QUEST_STATE_UNFINISHED"
