			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Джави"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090101,
					"content": "Странно... Я помню, это должно быть где-то рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090102
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090102,
					"content": "Что ты ищешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090103
					]
				},
				{
					"id": 731090103,
					"content": "#Ты... и есть путешественни{F#ца}{M#к}? Я слышал о тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090104
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090104,
					"content": "Меня зовут Джави, я обычный продавец и ищу ларец мечты, который закопал когда-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090105
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090105,
					"content": "Какое странное название... А что там внутри?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731090106,
					"content": "Ну, если можно так сказать, то там находятся детские мечты, которые ждут, когда их воплотят в жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090107
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090107,
					"content": "И для чего ты это сделал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090108
					]
				},
				{
					"id": 731090108,
					"content": "Ха-ха, это игра, которую мы придумали с друзьями, когда были детьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090109
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090109,
					"content": "Нужно записать свою самую сокровенную мечту и закопать её здесь. А потом встретиться в определённое время и выкопать ларец мечты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090110
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090110,
					"content": "И вот время настало. Но, кажется, только я помню про это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090111
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090111,
					"content": "Эх, жалко, что они забыли. Лишь бы они не забыли о своих мечтах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090112
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090112,
					"content": "В общем, я здесь, чтобы выкопать свой ларец и закончить игру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090113
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090113,
					"content": "Вот только я обыскал всё вокруг, но ничего не нашёл. Неужели кто-то другой выкопал его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090114,
						731090115
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090114,
					"content": "А ты как-нибудь отметил это место?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090118
					]
				},
				{
					"id": 731090118,
					"content": "Я помню, что тогда я закопал его под деревом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090119
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090119,
					"content": "Под деревом? Но тут кругом деревья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731090120,
					"content": "Тогда я не обратил на это внимания. Ещё мы прибили дощечку, чтобы отметить место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090121
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090121,
					"content": "Но прошло столько времени, и дощечка исчезла, а я не узнаю эти деревья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090122
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090122,
					"content": "Я примерно помню, что это место должно быть где-то рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090123
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090123,
					"content": "#Путешественни{F#ца}{M#к}, можно попросить тебя помочь поискать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090124,
						731090127
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090124,
					"content": "И как мне его искать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090125
					]
				},
				{
					"id": 731090125,
					"content": "Я зарыл ларец под деревом. Попробуй покопать под деревьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090126
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090126,
					"content": "Я вознагражу тебя за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090130,
					"content": "Смотри, сколько деревьев, я один не справлюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090131
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090131,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090132
					]
				},
				{
					"id": 731090132,
					"content": "Большое спасибо. Давай разделимся. Я начну искать здесь, а ты - там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090127,
					"content": "Так ведь мечта улетела...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090128
					]
				},
				{
					"id": 731090128,
					"content": "Вот почему я хочу откопать ларец. Чтобы напомнить себе о мечте, которую я хотел воплотить в жизнь в то время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090129
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090129,
					"content": "#Пожалуйста, путешественни{F#ца}{M#к}, помоги мне. Я непременно вознагражу тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090115,
					"content": "Мечта улетела...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090116
					]
				},
				{
					"id": 731090116,
					"content": "Ха-ха, не спорю, ведь я даже не помню, что я тогда написал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090117
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090117,
					"content": "Даже если бы мечта улетела, ларец должен был остаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090118
					],
					"speakerTitle": "Джави"
				}
			]
		},
		{
			"id": 7310903,
