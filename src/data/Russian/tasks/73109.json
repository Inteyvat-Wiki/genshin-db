			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джави"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090301,
					"content": "Нет, это не мой ларец мечты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090302,
						731090304
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090302,
					"content": "Мы нашли ларец.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090303
					]
				},
				{
					"id": 731090303,
					"content": "Ха-ха, я тоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090305
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090305,
					"content": "Я открыл ларец мечты, и в нём лежала записка Ами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090306
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090306,
					"content": "Я помню эту девочку. Она дочь Джахангира. Я часто вижу её возле продуктового ларька.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090307
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090307,
					"content": "Она мечтает стать садовником и посадить много цветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090308
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090308,
					"content": "Неожиданно. Мне всегда казалось, что она унаследует ларёк Джахангира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090309,
						731090310
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090309,
					"content": "Теперь давай прочитаем твою мечту.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090311,
					"content": "Да-да, давай прочитаем мою мечту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090312
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090312,
					"content": "Хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090313
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090313,
					"content": "«Хочу стать ванарой и жить в лесу...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090314
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090314,
					"content": "Так это и есть моя детская мечта? Даже не представляю, о чём я тогда думал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090315
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090315,
					"content": "Да ладно... Вот я дурачьё, что у меня было в голове? Ванарам особо не платят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090316,
						731090317
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090316,
					"content": "А мне так не кажется.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090318,
					"content": "Это детский взгляд на жизнь, а в моём возрасте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090319
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090320
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090320,
					"content": "Нужно думать, как заработать побольше моры, чтобы ночью спать спокойно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090321
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090321,
					"content": "Ладно, хватит уже о моей скучной мечте. Давайте лучше поговорим о мечте Ами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090322
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090322,
					"content": "Я повредил её ларец мечты, поэтому мне нужно сделать что-то, чтобы загладить свою вину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090323
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090323,
					"content": "Итак, если она хочет стать садовником, сначала ей нужно научиться сажать цветы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090324
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090324,
					"content": "У меня как раз есть лишний горшок, который я могу отдать ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090325
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090325,
					"content": "#Путешественни{F#ца}{M#к}, а ты знаешь, как сажать цветы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090326,
						731090327
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090326,
					"content": "Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090332
					]
				},
				{
					"id": 731090332,
					"content": "#Что касается семян, я предоставляю это тебе, путешественни{F#ца}{M#к}. Встретимся возле лавки Джахангира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090327,
					"content": "Почему ты решил так поступить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090328
					]
				},
				{
					"id": 731090328,
					"content": "Ха-ха, это спонтанное решение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090329
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090329,
					"content": "Я не смогу воплотить в жизнь свою мечту, потому что уже не молод и... и мне это неинтересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090330
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090330,
					"content": "А Ами ещё маленькая, поэтому она ещё может воплотить в жизнь свою мечту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090331
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090331,
					"content": "Такой скучный взрослый, как я, ничем не может ей помочь. Поэтому я подарю ей горшок, чтобы поддержать её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090332
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090317,
					"content": "Мечты не бывают плохими или хорошими.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090310,
					"content": "Вот твой ларец мечты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090304,
					"content": "Ты тоже нашёл ларец?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090305
					]
				}
			]
		},
		{
			"id": 7310905,
			"completionStepIds": [
				7310905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310905",
							"2"
						],
						"stepId": 7310905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ами",
					"Джави"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090501,
					"content": "Это... мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090502
					],
					"speakerTitle": "Ами"
				},
				{
					"id": 731090502,
					"content": "Это я виновата, что плохо закрыла ларец. Поэтому дяденьке не надо извиняться передо мной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090503
					],
					"speakerTitle": "Ами"
				},
				{
					"id": 731090503,
					"content": "Ну, мне этот горшок всё равно не нужен, поэтому возьми его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090504
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090504,
					"content": "А ещё я попросил кое-кого принести семена. Они скоро будут здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090505,
						731090506
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090505,
					"content": "А вот и семена!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				},
				{
					"id": 731090507,
					"content": "#А? Ты когда вернул{F#ась}{M#ся}? Я даже не заметил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090508
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090508,
					"content": "Ами, разве ты не хотела стать садовником? Ты уже сейчас можешь посадить цветы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090509
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090509,
					"content": "Спасибо, но если я начну выращивать цветы возле папиной лавки, то жучки могут залететь в котёл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090510
					],
					"speakerTitle": "Ами"
				},
				{
					"id": 731090510,
					"content": "Мне будет жалко этих жучков, если их съедят взрослые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090511
					],
					"speakerTitle": "Ами"
				},
				{
					"id": 731090511,
					"content": "А если я посажу цветы подальше, то, боюсь, что не смогу заботиться о них. И мне будет жалко завядшие цветы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090512
					],
					"speakerTitle": "Ами"
				},
				{
					"id": 731090512,
					"content": "К тому же папа очень занят, поэтому он не разрешает мне уходить далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090513
					],
					"speakerTitle": "Ами"
				},
				{
					"id": 731090513,
					"content": "А что, если мы вместе будем ухаживать за цветами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090514
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090514,
					"content": "Я могу приходить сюда каждый день, но только после работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090515
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090515,
					"content": "Как здорово! Но папа может не разрешить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090516
					],
					"speakerTitle": "Ами"
				},
				{
					"id": 731090516,
					"content": "Я, можно сказать, знаком с Джахангиром, поэтому попробую уговорить его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090517
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090517,
					"content": "Хорошо! Тогда мне нужны ещё горшки! Мне больше всего нравится сумерская роза! Однажды вся папина лавка будет окружена кустами роз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090518
					],
					"speakerTitle": "Ами"
				},
				{
					"id": 731090518,
					"content": "Хорошо, малышка! Давай сделаем для этого всё возможное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090519,
						731090520
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090519,
					"content": "Не забудь подарить мне одну розу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090521,
					"content": "#Спасибо, {F#сестрёнка}{M#братишка}. А ещё я хочу посадить цветок-сахарок, а потом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090522
					],
					"speakerTitle": "Ами"
				},
				{
					"id": 731090522,
					"content": "Похоже, девочке очень нравится заниматься цветами. Надеюсь, она сможет воплотить в жизнь свою мечту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090523
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090523,
					"content": "Хе-хе, только бы она не стала такой же скучной взрослой, как я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090524
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090524,
					"content": "#Путешественни{F#ца}{M#к}, спасибо за помощь. Вот, возьми свою награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090525,
						731090526
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090525,
					"content": "Жить по велению сердца вовсе не банально.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090527,
					"content": "Спасибо. Я не жалуюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090528
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090528,
					"content": "Просто я немного расстроился, когда увидел закопанную мечту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090529
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090529,
					"content": "#Ну, мне тоже пора возвращаться. Спасибо за твою помощь, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090530
					],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090530,
					"content": "А что если... записать ещё одну мечту и снова закопать её...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джави"
				},
				{
					"id": 731090526,
					"content": "В реальной жизни не всё так скучно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090520,
					"content": "Удачи!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090506,
					"content": "Вот, держи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				}
			]
		},
