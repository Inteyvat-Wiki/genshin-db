					"Тимми"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200480101,
					"content": "#Аргх! Опять ТЫ! Ты снова распугал{F#а} всех голубей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480102
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200480102,
					"content": "#Я же кормил их! Что ты наделал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480103
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200480103,
					"content": "Прошу прощения.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480104
					]
				},
				{
					"id": 200480104,
					"content": "Пфф. Мама говорит, что по-настоящему прощение нужно просить делами, а не словами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480105
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200480105,
					"content": "Эти голуби - мои друзья. Я кормлю их каждый день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480106
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200480106,
					"content": "Но недавно утки стали отбирать у них еду. Теперь им не хватает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480107
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200480107,
					"content": "Раздобудь где-нибудь пшеницы и накорми этих уток. А я пока буду кормить голубей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480108
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200480108,
					"content": "Когда у обеих сторон будет достаточно еды, все станут жить дружно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480109,
						200480110
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200480109,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480111
					]
				},
				{
					"id": 200480111,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480112
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200480112,
					"content": "Если хорошо относиться к животным, то они могут стать твоими друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200480110,
					"content": "Но я не хочу дружить с голубями.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480113
					]
				},
				{
					"id": 200480113,
					"content": "#Хочешь или нет... Ты долж{M#е}н{F#а} перед ними извиниться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480114
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200480114,
					"content": "Отправляйся на поиски пшеницы поскорей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимми"
				}
			]
		},
