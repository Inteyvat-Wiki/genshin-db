			"dialogs": [
				{
					"id": 190603101,
					"content": "Уэсуги - пустозвон, не принимайте его слова за чистую монету.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603102
					],
					"speakerTitle": "Овада"
				},
				{
					"id": 190603102,
					"content": "Расскажи мне о Рюдзи и Такацукасе Исаму...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603103
					]
				},
				{
					"id": 190603103,
					"content": "Что же, если ты правда хочешь знать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603104
					],
					"speakerTitle": "Овада"
				},
				{
					"id": 190603104,
					"content": "Вне всяких сомнений, Рюдзи считал Такацукасу Исаму своим названым отцом. А вот что двигало Такацукасой, когда он подобрал Рюдзи с улицы, - только ли жалость или ещё и корысть - этого я не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603105
					],
					"speakerTitle": "Овада"
				},
				{
					"id": 190603105,
					"content": "Такацукаса Исаму был непростым человеком, он не мог сделать наивного и доверчивого Рюдзи своим советником. А вот на роль помощника и преданного пса Рюдзи подходил как нельзя лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603106
					],
					"speakerTitle": "Овада"
				},
				{
					"id": 190603106,
					"content": "К тому же потом у Такацукасы родился собственный ребёнок, но, к сожалению, Такацукаса погиб, даже не успев увидеть его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603107
					],
					"speakerTitle": "Овада"
				},
				{
					"id": 190603107,
					"content": "Ай, не будем об этом. Вы ведь дело расследуете? Тогда идём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Овада"
				}
			]
