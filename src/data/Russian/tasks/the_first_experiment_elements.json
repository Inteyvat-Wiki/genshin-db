			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420101,
					"content": "У Паймон вопрос. Что из этого семени вырастет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420102,
					"content": "Не знаю. Я считаю, что тут важен не конечный результат, а сам процесс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420103
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420103,
					"content": "Если я с помощью алхимии проращу семя из другого мира, то совершу огромный скачок в понимании природы жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420104
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420104,
					"content": "После пробуждения жизни станет возможным даже созидание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420105
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420105,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420106,
					"content": "Ха-ха, всё ещё не очень понятно, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420107
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420107,
					"content": "Нет-нет-нет, Паймон всё поняла. Но Паймон куда интереснее, во что это семя вырастет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420108,
						110420109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420108,
					"content": "Ты точно не поняла.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				},
				{
					"id": 110420110,
					"content": "Если оно даст изысканные фрукты, я непременно с вами поделюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420111
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420111,
					"content": "Ха! Паймон ловит тебя на слове!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420112,
						110420113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420112,
					"content": "Тебе так легко удалось убедить Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420114,
					"content": "Всё потому, что... иногда мне приходится приглядывать за ребёнком. Долго объяснять. Будем считать, что это - один из несвязанных с алхимией навыков, в которых я хоть немного преуспел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420115
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420115,
					"content": "Предметом моего первого исследования были силы элементов. В этом мире возможность управлять ими даёт Глаз Бога, но у тебя я ничего подобного не видел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420116
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420116,
					"content": "Я хотел бы определить, почему ты так непринуждённо контролируешь силу стихии. Поэтому у меня к тебе несколько вопросов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420117
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420117,
					"content": "Первое, есть ли у тебя органы, которых нет у других? Например, второе сердце, четвёртый желудок и тому подобное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420118,
						110420119
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420118,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420120,
					"content": "Удивительно. Крепится ли каким-то образом к твоему телу это летающее дитя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420121
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420121,
					"content": "Что за бестолковый вопрос! Разве не видно, что между нами ничего нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420122,
					"content": "И ещё. Не «летающее дитя», а Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420123,
					"content": "#Я лишь допустил, что ты можешь быть наружным органом, связанным с путешественни{F#цей}{M#ком} какой-нибудь неведомой силой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420124,
						110420125
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420124,
					"content": "#Я повстречал{F#а} Паймон во время странствий.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420126,
					"content": "Тогда эту возможность мы исключаем. Возможно ли, что силой элементов тебя наделила Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420127
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420127,
					"content": "Но тогда бы это означало, что своей силой Паймон способна пробить валун толщиной до десяти метров или заставить водопад к югу от Спрингвейла падать вверх.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420128
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420128,
					"content": "Хм. Это определённо невозможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420129
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420129,
					"content": "Паймон ещё ничего не сказала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420130,
					"content": "В таком случае твоё тело устроено так же, как тела людей в нашем мире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420131
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420131,
					"content": "Очевидно, что в моё исследование закралась погрешность, а значит ответы смогут дать лишь эксперименты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420132
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420132,
					"content": "Во-первых, я хотел бы посмотреть, как именно проявляется твоя загадочная элементальная сила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420133
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420133,
					"content": "Я приманю нескольких слаймов, а ты, пожалуйста, порази их наиболее естественным для себя способом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420134
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420134,
					"content": "Как-то это слишком просто. А ты точно учёный?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420135,
					"content": "Хороший эксперимент должен быть ясным и наглядным. В данном случае простота эксперимента его недостатком не является.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420136
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420136,
					"content": "Но если вы желаете повысить сложность, можно было бы попробовать сразиться с шестью океанидами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420137
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420137,
					"content": "Слаймы! Слаймы нас устроят!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420138,
						110420139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420138,
					"content": "Не очень понятно. По-моему, это лишняя морока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420140,
					"content": "Тогда приготовьтесь. Сейчас появятся слаймы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420139,
					"content": "#Быть бит{F#ой}{M#ым} Гидро мимиками мне неохота.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420125,
					"content": "#Я поймал{F#а} Паймон на удочку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420119,
					"content": "Насколько мне известно, нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420113,
					"content": "Ты прекрасно понимаешь, чего хочет Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420109,
					"content": "Мне тоже любопытно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				}
			]
		},
		{
