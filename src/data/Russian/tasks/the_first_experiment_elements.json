				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420601,
					"content": "Я только что немного попробовал. Оно в точности соответствует ожиданиям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420602
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420602,
					"content": "Не забывай постоянно хранить спокойствие. Если почувствуешь дискомфорт, дыши глубже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420603
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420603,
					"content": "Все видимые результаты и данные я запишу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				}
			]
		},
		{
			"id": 1104207,
			"completionStepIds": [
				1104207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104207",
							"2"
						],
						"stepId": 1104207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420701,
					"content": "#Как ты, {NICKNAME}? Видок у тебя не очень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420702,
						110420703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420702,
					"content": "Немного... жжёт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				},
				{
					"id": 110420704,
					"content": "#Ты ведь говорил, что попробовал зелье! Ты уверен, что оно было готово? Что с н{F#ей}{M#им} происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420705,
					"content": "Хм? Из всех возможных такой результат самый нормальный. Мы должны быть ему рады.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420706
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420706,
					"content": "Это зелье направляет элементальную силу внутрь тела. При обычных условиях оно вызывает отторжение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420707
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420707,
					"content": "Если стихия внутри течёт беспрепятственно, нужно всего лишь перетерпеть кратковременный дискомфорт. Когда потоки остановятся, никаких других эффектов не последует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420708
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420708,
					"content": "Так ты знал, что тебе будет плохо, но всё равно немного выпил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420709,
					"content": "Хе-хе, всё-таки это зелье моего приготовления, и я, конечно же, обязан был опробовать его на себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420710,
						110420712
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420710,
					"content": "Так ты... беспокоишься о подопытном?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420711
					]
				},
				{
					"id": 110420711,
					"content": "Ну конечно! Ты мой ассистент, и я ни за что бы не позволил тебе взять весь риск на себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420714,
					"content": "Итак, позвольте сделать вывод. Эксперимент с элементальной силой абсолютно не показал каких-либо различий между людьми этого мира и тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420715
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420715,
					"content": "Паймон ожидала увидеть что-нибудь особенное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420716,
					"content": "Обыденное, как мне кажется, лучше особенного. Необычное далеко не всегда соответствует нашим представлениям о хорошем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420717
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420717,
					"content": "Что ты хочешь сказать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420718
					]
				},
				{
					"id": 110420718,
					"content": "Преимущество обыденного в том, что все вокруг тебя могут служить объектами для сравнения, и все способны тебя понять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420719
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420719,
					"content": "Все люди подобны, и потому могут понимать, поощрять и поддерживать друг друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420720
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420720,
					"content": "Если заболеешь, доктор с лёгкостью поставит диагноз, потому что он похож на тебя. Если у тебя неприятности, ты можешь посоветоваться с тем, кто их уже испытал, ведь вы схожи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420721
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420721,
					"content": "А особенный человек не сможет воспользоваться обыденными для нас вещами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420722
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420722,
					"content": "К примеру... Человеку жизнь Пиро орхидеи или Глаза бури понять не под силу. Ясно ли я выражаюсь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420723,
						110420724
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420723,
					"content": "#Думаю, я понял{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420725,
					"content": "В общем, мы получили хорошие результаты. Ты можешь спокойно использовать элементальную силу и дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420726
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420726,
					"content": "Тимей, результаты последнего опыта готовы. Будь добр, займись их сопоставлением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420727
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420727,
					"content": "Уже иду, учитель!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420728
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 110420728,
					"content": "Вы заставили меня хорошенько задуматься и поломать голову. Сейчас мой разум стал куда более ясен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420729
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 110420729,
					"content": "С моей стороны определить тебя, как животное, было неточностью. Но если идти от предположения, что ты элементальное существо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420730
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 110420730,
					"content": "Неплохо. Признаю, версия интересная. Вместо того, чтобы выносить суждение, я хотел бы, чтобы ты изучил реальное положение дел сам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420731
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420731,
					"content": "Уверяю вас, учитель, я приду к заключению, которое устроит всех!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420732
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 110420732,
					"content": "Кажется, он ничуть не расстроился. Приободрился даже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420733
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420733,
					"content": "Паймон хотела сказать... Какой боевитый юноша! Ну или у Альбедо так подвешен язык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420734
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110420734,
					"content": "Хм... Перед тем как продолжить наше исследование, я должен кое-что подготовить. Прошу немного подождать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420735
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420735,
					"content": "Тем временем вы могли бы тут осмотреться. Если вам это, конечно, интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420724,
					"content": "Не очень понятно, о чём ты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420712,
					"content": "А как же ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420713
					]
				},
				{
					"id": 110420713,
					"content": "Наверное, взыграла моя самоуверенность учёного. Заодно удалось избежать ненужных хлопот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110420703,
					"content": "Ты выпей, тогда на тебя посмотрим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				}
			]
		},
