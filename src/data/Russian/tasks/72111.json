			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Конда Дэнсукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110201,
					"content": "Кошель для переноски моры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110202
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110202,
					"content": "Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110203
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110203,
					"content": "...Это принадлежит нашей семье. В этом нет ничего подозрительного. Да, самый обычный кошель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110204
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110204,
					"content": "Это очень подозрительно! Тут что-то не так!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110205,
						721110206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110205,
					"content": "Пожалуйста, нарисуй мне знак с этого кошеля.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				},
				{
					"id": 721110210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110211
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110211,
					"content": "Хорошо. Это и впрямь не мой кошель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110212
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110212,
					"content": "Через мой задний двор проходит столько народу - кто-то мог и кошель обронить. Что тут такого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110213
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110213,
					"content": "Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110214
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110214,
					"content": "Что произошло?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110215
					]
				},
				{
					"id": 721110215,
					"content": "А! Вы меня подловили. Я и впрямь собирался присвоить этот кошель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110216
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110216,
					"content": "Ох, Дэнсукэ, откуда у такого старого и почтенного человека такие злодейские мысли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110217,
						721110218
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110217,
					"content": "Что-то не так.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110219,
					"content": "Я... Я уже признался в намерении присвоить деньги. Что тут ещё скрывать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110220
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110220,
					"content": "Потом я сдам их сёгунату.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110221
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110221,
					"content": "Мне тут что-то не нравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110222,
						721110223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110222,
					"content": "Кошель кто-то оставил там намеренно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110227,
					"content": "Какие доказательства у тебя... у тебя есть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110228
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110228,
					"content": "Кошель для денег - это ещё не всё. Мы также нашли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110229,
					"content": "#...Нашли что? Хм-м, теперь твоя очередь, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110230
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110230,
					"content": "#({NICKNAME}, а что мы нашли в канаве?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110231,
					"content": "Вот это кто-то намеренно бросил дождливой ночью.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110223,
					"content": "Не обращай внимания, Паймон просто думает вслух.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110224
					]
				},
				{
					"id": 721110224,
					"content": "#(Это наверняка неправда! {NICKNAME}, не мог же дедушка Дэнсукэ просто охотиться за морой?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110225,
					"content": "(Он же что-то скрывает, правда?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110226,
					"content": "Кошель кто-то оставил там намеренно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110218,
					"content": "Ты что-то от нас скрываешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110206,
					"content": "Пожалуйста, скажи, сколько моры там было.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110207
					]
				},
				{
					"id": 721110207,
					"content": "Ха-ха-ха, это что ещё за вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110208
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110208,
					"content": "Ты не знаешь, сколько моры было в твоём кошеле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110209
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110209,
					"content": "Пожалуйста, нарисуй мне знак с этого кошеля.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				}
			]
		},
