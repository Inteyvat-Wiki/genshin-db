				}
			]
		},
		{
			"id": 7211107,
			"completionStepIds": [
				7211107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211101",
							"3"
						],
						"stepId": 7211101,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211102",
							"3"
						],
						"stepId": 7211102,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211103",
							"3"
						],
						"stepId": 7211103,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211107",
							"2"
						],
						"stepId": 7211107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Конда Дэнсукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110701,
					"content": "Это... Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110702
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110702,
					"content": "Не могу поверить, что был так беспечен, когда разбил телегу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110703
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110703,
					"content": "Ого, ты наконец признался!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110704,
					"content": "У меня нет выбора, ведь вы зашли так далеко в своём расследовании. Я больше не могу это скрывать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110705
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110705,
					"content": "Тогда вы должны хорошо представлять, что же произошло на самом деле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110706
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110706,
					"content": "Ещё как хорошо! Дедушка Дэнсукэ, как ты мог...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110707,
					"content": "...украсть телегу сёгуната? Во время боя ты разрушил телегу ударами кулаков, и груз попадал в канаву.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110708,
					"content": "В надежде спастись солдаты сёгуната побросали свои кошельки в колодец, чтобы отвлечь твоё внимание! И чтобы деньги не растащили, ты перекрыл доступ к колодцу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110709,
					"content": "Верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110710,
					"content": "Что? Да нет же, всё было не так!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110711
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110711,
					"content": "В самом деле? А я хотела попросить у тебя ключ, чтобы собрать мору со дна колодца...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110712,
					"content": "...и дать сёгунату! Именно! Отдать все деньги сёгунату!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110713
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110713,
					"content": "Эх, вот что произошло на самом деле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110714
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110714,
					"content": "Была в деревне компания молодых людей, которые однажды выпили, обнаглели и решили ограбить телегу сёгуната. Эти товары и кошель принадлежат сёгунату.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110715
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110715,
					"content": "Я не мог допустить, чтобы все узнали о таком постыдном происшествии в нашей деревне. Потому я и попытался всё скрыть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110716
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110716,
					"content": "А как же твоё признание про кошель...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110717
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110717,
					"content": "Это всё ради того, чтобы скрыть правду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110718
					]
				},
				{
					"id": 721110718,
					"content": "Верно. Я подумал, что вы прекратите расследование, если я возьму вину на себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110719
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110719,
					"content": "Если бы наказали только меня... и больше никого не тронули...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110720
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110720,
					"content": "Пожалуйста, не сообщайте сёгунату. Дело не в том, что я хочу сохранить лицо. Я не хочу, чтобы пострадала вся деревня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110721,
						721110724
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110721,
					"content": "Меня доносительство не интересует.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110722
					]
				},
				{
					"id": 721110722,
					"content": "Да, мы здесь не за этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110723
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110723,
					"content": "Слава богам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110727,
					"content": "Меня постоянно мучила совесть из-за сокрытия истины, поэтому я всё записал в дневнике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110728
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110728,
					"content": "Я забросил дневник на крышу. Если вы и впрямь хотите почитать - пожалуйста. Только постарайтесь не попортить мне крышу - я её недавно отремонтировал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110729
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110729,
					"content": "По поводу замка на колодце...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110730
					]
				},
				{
					"id": 721110730,
					"content": "Да, это я перекрыл колодец. А ещё я записал, куда спрятал ключ. Идите и поищите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110731
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110731,
					"content": "Знает ли дедушка Дэнсукэ что-нибудь про барьер деревни Конда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110732
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110732,
					"content": "Барьер? Ох, люди всё ещё помнят эту древнюю легенду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110733
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110733,
					"content": "В древние времена под землёй, на которой мы стоим, проходил корень громовой сакуры - один из пяти корней, защищавших мир на острове Наруками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110734
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110734,
					"content": "А обязанность охранять корень и его барьер кицунэ Сайгу возложила на нас, жителей деревни Конда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110735
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110735,
					"content": "Но это было очень давно. Я не очень хорошо знаю детали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110724,
					"content": "Я просто хочу узнать правду...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110725
					]
				},
				{
					"id": 721110725,
					"content": "Да, мы здесь не за этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110726
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110726,
					"content": "Правду? Хе-хе... молодёжь в наши дни такая интересная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Конда Дэнсукэ"
				}
			]
		},
