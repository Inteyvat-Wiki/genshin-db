			"dialogs": [
				{
					"id": 721110301,
					"content": "Это же... кхм, где вы это взяли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110302,
						721110304
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110302,
					"content": "Вниз по течению воды в канаве.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110303
					]
				},
				{
					"id": 721110303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110306,
					"content": "Как бы там ни было, у вас нет никаких доказательств того, что эти предметы связаны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110307
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110307,
					"content": "Они связаны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110308,
					"content": "Это нелепо! Как они могут быть связаны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110309
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110309,
					"content": "Разве что, на море есть какой-то тайный код?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110310
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110310,
					"content": "На море ничего нет, но есть на чём-то другом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110311,
					"content": "Рядом с обломками телеги мы нашли вот это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110304,
					"content": "Это висело на ветках дерева на въезде в деревню.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110305
					]
				},
				{
					"id": 721110305,
					"content": "Не может быть... Вам не нужно проверять меня таким образом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "Конда Дэнсукэ"
				}
			]
		},
