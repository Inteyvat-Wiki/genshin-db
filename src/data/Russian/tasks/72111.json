				},
				{
					"id": 721110602,
					"content": "#{M#Парень}{F#Девушка}, ты пытаешься задурить мне голову какими-то случайно подобранными предметами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110603
					],
