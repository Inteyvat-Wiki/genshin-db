			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Конда Дэнсукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110101,
					"content": "#Что я могу для тебя сделать, {M#юноша}{F#девушка}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110102
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110102,
					"content": "Мы нашли доказательства.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110103
					]
				},
				{
					"id": 721110103,
					"content": "Доказательства? Какие доказательства? Я не понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110104
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110104,
					"content": "О странном происшествии в деревне. Прошу, перестань прикидываться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110105,
					"content": "Чушь! Что за странные происшествия могут произойти у нас в деревне? Ну ладно, показывайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110106
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 721110106,
					"content": "#(Эй, {NICKNAME}, начни с того, что мы нашли у колодца. Я не буду тебе мешать!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721110107,
					"content": "Вот это мы нашли у сухого колодца на заднем дворе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211102,
			"completionStepIds": [
				7211105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
