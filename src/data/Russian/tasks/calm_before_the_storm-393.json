			"dialogs": [
				{
					"id": 3930101,
					"content": "Когда мы закончим, я напишу много песен о наших путешествиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930102,
						3930103
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3930102,
					"content": "Столько всего произошло.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				},
				{
					"id": 3930104,
					"content": "Надеюсь, что в Мондштадте эти песни будут популярны так же, как Легенда о Веннесе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930105
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3930105,
					"content": "Я с детства люблю эту песню!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930106
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3930106,
					"content": "#Как твои дела, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930107
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3930107,
					"content": "Я в отличной форме и готова помогать остальным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930108,
						3930109
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3930108,
					"content": "На действующего магистра Джинн можно положиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930110,
					"content": "И даже господин Дилюк сопровождал нас до самого конца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3930111,
					"content": "Хотя в самом начале мы пересеклись с ним...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3930112,
					"content": "Случайно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3930113,
					"content": "Вы доверились мне. А я в ответ доверился вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930114,
						3930117,
						3930120
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3930114,
					"content": "Значит, вы делали это из-за доверия? В этом причина?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930115
					]
				},
				{
					"id": 3930115,
					"content": "Действующий магистр Джинн - из-за долга, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3930116,
					"content": "А бард-бродяжка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3930121,
					"content": "Свобода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930122
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3930122,
					"content": "Свобода...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3930123,
					"content": "Тебе разве не рассказывали, что Мондштадт - это город свободы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930124
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3930124,
					"content": "Эмбер...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930125
					]
				},
				{
					"id": 3930125,
					"content": "Ха-ха. Эмбер точно дитя свободы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930126
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3930126,
					"content": "Мондштадт... Город свободных романтиков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930127
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3930127,
					"content": "Жители Мондштадта - самые свободные люди в семи королевствах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930128
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3930128,
					"content": "Дракон, который был защитником Мондштадта, тоже скоро станет свободным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930129
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3930129,
					"content": "Он не поверит, что Мондштадт его предал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930130
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3930130,
					"content": "Никто не должен был говорить ему, что защита Мондштадта - его вечная обязанность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930131
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3930131,
					"content": "Он волен сам выбирать свой жизненный путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930132
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3930132,
					"content": "Венти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3930133,
					"content": "#{NICKNAME}, да направят тебя тысячелетние ветра Мондштадта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930134
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3930134,
					"content": "Позволь мне снова наделить тебя силой Анемо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930135,
						3930136
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3930135,
					"content": "Снова?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930137,
					"content": "#Вот оно что! Поэтому твой голос показался {F#ей}{M#ему} знакомым!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3930136,
					"content": "Точно! Это был ТВОЙ голос!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930117,
					"content": "Действующий магистр Джинн из-за долга.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930118
					]
				},
				{
					"id": 3930118,
					"content": "Для господина Дилюка это доверие, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3930119,
					"content": "А бард-бродяжка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3930120,
					"content": "А Венти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930121
					]
				},
				{
					"id": 3930109,
					"content": "Я тоже в отличной форме!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930103,
					"content": "Мы уже как старые друзья.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				}
			]
		}
	]
