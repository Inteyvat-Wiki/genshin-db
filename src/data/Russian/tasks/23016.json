			"dialogs": [
				{
					"id": 230163801,
					"content": "Гарсия берётся за дело...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230163802
					]
				},
				{
					"id": 230163802,
					"content": "Гм... Что-то с этой шестерёнкой не так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163803
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230163803,
					"content": "#Ничего, попробуем ещё раз... Путешественни{F#ца}{M#к}, на что мне нужно обратить внимание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гарсия"
