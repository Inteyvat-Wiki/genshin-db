			"dialogs": [
				{
					"id": 230165001,
					"content": "Господин, мне кажется, нам пора попробовать другой подход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165002
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230165002,
					"content": "Другой подход?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165003
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230165003,
					"content": "Например, построить не такую сложную, но при этом достаточно умную машину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165004
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230165004,
					"content": "Уверен, с вашим талантом это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165005
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230165005,
					"content": "Дорогой мой Лу Тун, мы уже не раз обсуждали этот вопрос, и ты знаешь мой ответ... И я с уважением отнесусь к любому твоему выбору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165006
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230165006,
					"content": "Господин, давайте лучше обсудим место вашего следующего ужина с госпожой Кайей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165007
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230165007,
					"content": "Спасибо, Лу Тун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165008
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230165008,
					"content": "Не благодарите, господин. Срок договора, который мы с вами подписали, ещё не истёк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				}
			]
		},
