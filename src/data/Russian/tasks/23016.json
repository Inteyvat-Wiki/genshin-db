			},
			"dialogs": [
				{
					"id": 230160301,
					"content": "Лу Тун! Эту шестерёнку пора доставать из формы! Скорее сюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160302
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160302,
					"content": "#Путешественни{F#ца}{M#к}, вот и ты! Ты расспросил{F#а} господина Ахангара о приёмах отливки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160303
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160303,
					"content": "Скорее, ну же! Что я должен сделать с этой шестерёнкой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гарсия"
				}
			]
		},
