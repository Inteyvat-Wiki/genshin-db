			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гарсия",
					"Лу Тун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160101,
					"content": "Руки... Ох... Не слушаются...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160102
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160102,
					"content": "Господин, не перетрудитесь, вам сегодня ещё предстоит заниматься счетами госпожи Кайи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160103
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230160103,
					"content": "Сам знаю! Хватит об этом, Лу Тун!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160104
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160104,
					"content": "Конечно, если вы не сможете, я возьму эту работу на себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160105
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230160105,
					"content": "Нет! Я пойду туда сам, только... Только сделаю ещё несколько шестерёнок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160106
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160107
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160107,
					"content": "Ладно, руки уже не слушаются, я больше не могу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160108
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160108,
					"content": "Что ты опять делаешь?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160109
					]
				},
				{
					"id": 230160109,
					"content": "#Это ты, путешественни{F#ца}{M#к}... Ох... Мои руки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160110
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160110,
					"content": "Видите ли, у господина Ахангара много другой работы, он не может всё время заниматься деталями для моей машины...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160111
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160111,
					"content": "К тому же детали, которые он отливает, всегда немного отличаются от того, что я хотел бы видеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160112
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160112,
					"content": "Поэтому, чтобы обеспечить надёжную работу каждой детали, я решил взять у господина Ахангара несколько уроков по литью, буду изготавливать детали своими руками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160113
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160113,
					"content": "К счастью, в Фонтейне я работал с чем-то похожим... Но некоторые приёмы, которые показывал господин Ахангар, вылетели у меня из головы, эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160114
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160114,
					"content": "#Путешественни{F#ца}{M#к}, мне надо немного отдохнуть, вы не могли бы пойти к господину Ахангару и ещё раз расспросить его о тех приёмах, которым он меня учил?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160115,
						230160116
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160115,
					"content": "Отдохни как следует.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160121
					]
				},
				{
					"id": 230160121,
					"content": "#Спасибо! Ты так добр{F#а}! Ох, моя рука...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160116,
					"content": "Кайя - это кто?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160117
					]
				},
				{
					"id": 230160117,
					"content": "Деловой партнёр!.. Гм, весьма талантливый и весьма состоятельный деловой партнёр!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160118
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160118,
					"content": "Мы заключили долгосрочный договор о предоставлении бухгалтерских услуг! Поэтому я и хожу на все эти встречи. Правда, Лу Тун?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160119
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230160119,
					"content": "Совершенно верно, господин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160120
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230160120,
					"content": "#Как бы там ни было... Путешественни{F#ца}{M#к}, прошу вас поскорее отправиться к господину Ахангару, а я буду ждать вас здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гарсия"
				}
			]
		},
		{
			"id": 2301602,
			"completionStepIds": [
				2301602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301602",
							"2"
						],
						"stepId": 2301602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ахангар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160201,
					"content": "Я же сказал подождать... Э? Это ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160202,
						230160203
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160202,
					"content": "Он меня послал кое-что узнать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				},
				{
					"id": 230160204,
					"content": "Он и правда сам взялся за дело... Вот чудак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160205
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160205,
					"content": "Сколько лет я работаю кузнецом, ни разу не встречал таких придирчивых клиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160206
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160206,
					"content": "Он с линейкой измеряет толщину швов между железными трубками и промежутки между пазами в резьбе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160207
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160207,
					"content": "Я однажды не выдержал и сказал, что раз он такой умный, пусть сам берётся за дело... И что ты думаешь? На другой день он явился сюда и попросил научить его отливке деталей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160208
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160208,
					"content": "Я согласился, пусть делает, что хочет. Пока он платит за материал, я ему и инструменты готов уступить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160209
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160209,
					"content": "Да уж, понятия не имею, что он там себе придумал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160210,
						230160211
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160210,
					"content": "Он создаёт величайший механизм.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160212,
					"content": "Ну, пусть... Чудак он, конечно. Вы ведь пришли спросить о приёмах отливки? С шестерёнками всё просто, здесь нет никаких хитростей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160213
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160213,
					"content": "Правда, я заметил, что он пытается добиться особой формы шестерёнок: ему нужны детали с острыми краями и углублением посередине...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160214
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160214,
					"content": "Для такой необычной формы простая отливка не годится, здесь понадобится вторичная обработка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160215
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160215,
					"content": "Я ему уже объяснял всё, что надо сделать. Передай ему вот что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160216
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160216,
					"content": "Прежде всего, когда будет отправлять детали в печь во второй раз, <color=#00E1FFFF>пусть не забудет прибавить огня</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160217
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160217,
					"content": "Потом, когда он достанет деталь из печи, <color=#00E1FFFF>нужно будет простучать её изнутри наружу</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160218
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160218,
					"content": "#Ну что, запомнил{F#а}? Если запомнил{F#а}, иди и передай всё ему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160219
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160219,
					"content": "Странный всё-таки тип...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230160211,
					"content": "Он строит странную машину.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160203,
					"content": "Он отдыхает, у него руки онемели.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				}
			]
		},
		{
			"id": 2301603,
