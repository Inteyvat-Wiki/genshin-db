			"dialogs": [
				{
					"id": 230163901,
					"content": "Гарсия берётся за дело...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230163902
					]
				},
				{
					"id": 230163902,
					"content": "Ура! Получилось! Отличная шестерёнка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163903
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230163903,
					"content": "Шаг между зубцами... Толщина... Размер... Мне нужна линейка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163904
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230163904,
					"content": "#Не будем отвлекать господина Гарсию от измерений. Путешественни{F#ца}{M#к}, вот твоё вознаграждение, спасибо за работу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163905
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230163905,
					"content": "У тебя так и сохраняется осторожный пессимизм?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230163906
					]
				},
				{
					"id": 230163906,
					"content": "Да, оптимизма как не было, так и нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163907
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230163907,
					"content": "Мы с господином Гарсией бродим у подножия огромной горы. Сейчас мы всего лишь убрали с пути маленький камешек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163908
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230163908,
					"content": "Но на самом деле, мы пока ещё очень далеки от того, чтобы отыскать проход сквозь гору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163909
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230163909,
					"content": "Надеюсь, талант господина Гарсии поведёт нас по правильному пути...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163910
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230163910,
					"content": "Иначе мне только и остаётся, что повторять про себя одну и ту же фразу: «Когда телега подкатит к горе, дорога сама отыщется».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				}
			]
		},
