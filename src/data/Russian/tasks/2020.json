				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20210101,
					"content": "Что же вы всё-таки делали в Царстве эвтюмии сёгуна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210102,
					"content": "Паймон поверить не может, что Охота на Глаза Бога прекращена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210103,
						20210104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210103,
					"content": "Всё это заслуга Яэ Мико.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				},
				{
					"id": 20210105,
					"content": "А, понятно... Паймон страшно переживала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210106,
					"content": "Стало быть, Мико ищет нас для того, чтобы наградить? Хи-хи... давай разыщем её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210104,
					"content": "Мы донесли желания людей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				}
			]
		}
	]
}