			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Яэ Мико",
					"Сёгун Райдэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200501,
					"content": "Ты проиграла, Эи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200502,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200503,
					"content": "...Да, я проиграла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200504,
					"content": "Почему ты не доверяешь своим людям и силам их устремлений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200505,
					"content": "Устремления эти вознеслись над пространством и временем, и ничто их уже не уничтожит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200506,
					"content": "Когда все, как один, ступают вперёд...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "#Это урок, который ты {F#вынесла}{M#вынес} из путешествия по Ли Юэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200510,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "Значит, есть государства, где люди идут вперёд, оставляя богов позади...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200512,
					"content": "Так зачем нам топтаться на месте?.. Ради самоуспокоения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200513,
					"content": "...Мы обе видели, какие потери может принести движение вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200514,
					"content": "Вечность... вечность - единственный путь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200515,
					"content": "Небесный порядок... для меня это пустые слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200516,
					"content": "Словом, ты просто хочешь веки вечные защищать свою любимую Инадзуму, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200517,
					"content": "Это слишком общие слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200518,
					"content": "Но заслуживает ли это царство вечного существования?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200519,
					"content": "Без устремлений, без перемен оно будет просто... существовать. Как пустая оболочка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200520,
					"content": "Хе, будет ли уничтожение такого государства вообще считаться утратой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200521,
					"content": "Мико, возьми свои слова обратно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200522,
					"content": "Неизменная вечность - это то, что я пообещала народу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200523,
					"content": "Но народу нужны не обещания. Ему нужно твоё внимание, присмотр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200524,
					"content": "...Глаза Бога?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200525,
					"content": "Человеческая жизнь едва доходит до сотни лет. Больше утрат они не вынесут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200526,
					"content": "Мне всё это знакомо. Именно поэтому я решила вести их по истинному пути к вечности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200527,
					"content": "Ах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200528,
					"content": "...Вечность - слишком жестокая судьба для тебя, Эи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200529,
					"content": "Для меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200530,
					"content": "Ты не только перестала обращать внимание на мир, но и на саму себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200531,
					"content": "Столетия, проведённые здесь, наверняка выдались ужасно одинокими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200532,
					"content": "По-другому нельзя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200533,
					"content": "Ты упустишь многое, оставаясь на одном месте... Не задумывалась ли ты, сколько теряешь, пытаясь с помощью вечной медитации избежать потерь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200534,
					"content": "Ясно, что тебе одиноко, но ради вечности ты растягиваешь одиночество до бесконечности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200535,
					"content": "Скажи, почему некогда мрачное здесь небо сейчас вдруг засияло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200536,
					"content": "Это же твоё Царство эвтюмии, твой внутренний мир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200537,
					"content": "Это может только означать, что... ты рада видеть меня вновь. Одиночество давно стало для тебя невыносимым, ведь так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200538,
					"content": "Мне... нечего сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200539,
					"content": "Хе-хе, а у меня вот много чего тебе рассказать. Давай я введу тебя в курс последних нескольких столетий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200540,
					"content": "Сколько это займёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200541,
					"content": "Я посланница кицунэ, и память у меня отменная. Я помню всё, что случилось за последние столетия в мельчайших подробностях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200542,
					"content": "Понадобится сотня-другая лет, чтобы всё изложить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200543,
					"content": "Хе... хе-хе... Мико, я думала, мы уже никогда не встретимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200544,
					"content": "Встреча с тобой - изменение в вечности... и приятный сюрприз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200545,
					"content": "Хе-хе, раз уж ты это признаёшь, значит, мы с тобой остаёмся друзьями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200546,
					"content": "Детский лепет какой-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200547,
					"content": "В любом случае своим планом вы нанесли мне поражение. Я прислушаюсь к вам и отменю Охоту на Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200548,
					"content": "Что же до вечности, и следует ли этому государству двигаться вперёд, мне ещё нужно подумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200549,
					"content": "Да ну, это ты с самого начала ведёшь себя как ребёнок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20200507,
					"content": "Они способны превзойти ожидания богов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "И даже взять на себя их обязанности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
		},
