			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сёгун Райдэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "Удовлетворите моё любопытство. Почему вы предстали передо мной вновь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200302,
					"content": "Думаешь, твоя безрассудная храбрость защитит этих людей? Или же... ты ищешь встречи со мной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200303,
					"content": "Эти Фатуи обманули сёгуна Райдэн.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "#Хм? Ты ведь не {F#помешала}{M#помешал} моей вечной медитации только ради того, чтобы сказать мне это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200306,
					"content": "Значит, ты недооцениваешь меня. Мне известно, как проходит Охота на Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200307,
					"content": "Ты знаешь обо всём, что происходит снаружи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "Нет. Только о том, что касается вечности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200309,
					"content": "Включая Охоту на Глаза Бога, которую я одобряю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200310,
					"content": "Действия Фатуи пока не угрожают вечности. В противном случае... они давно были бы уничтожены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200311,
					"content": "Но Охота на Глаза Бога принесла столько вреда...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "Личные амбиции несовместимы с вечностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200314,
					"content": "Возможно, ты не понимаешь, что в погоне за мечтой... лишаешься значительно большего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200315,
					"content": "Никто не теряет жизнь, когда у него отнимают Глаз Бога...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200316,
					"content": "Потеряли жизни те, кто предпочёл преследовать свои желания, разве не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200317,
					"content": "Тэппэй...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "#Путешественни{F#ца}{M#к}, твоё существование видится мне исключительным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200319,
					"content": "#Ты {F#полна}{M#полон} бесчисленных неопределённостей. Иными словами, от вечности ты дальше иных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200320,
					"content": "Я не ожидаю, что ты поймёшь мои поступки. Важно то, что от имени своего народа я иду к вечности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200321,
					"content": "Это твоё Царство эвтюмии...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "Его создало твоё сознание, правильно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "Правильно. Удивительно, что ты понимаешь это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200324,
					"content": "Довольно. Ты ищешь возможности поколебать мою волю... не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200325,
					"content": "Я здесь не для того, чтобы оспаривать твои идеи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "#Я {F#пришла}{M#пришёл} разбить их.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200328,
					"content": "Что же, противник вечности... просвети меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 20200312,
					"content": "Из-за неё народ Инадзумы потерял слишком много.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "Указа об Охоте на Глаза Бога не должно было быть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
		{
			"id": 202005,
			"completionStepIds": [
				202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
