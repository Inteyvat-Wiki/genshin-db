			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гайгэкс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "О, приветствую! Мы снова встретились! Какая удача!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790102,
					"content": "А ты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "Гайгэкс! Я Гайгэкс! Помните событие «По следам ветра»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790106,
					"content": "Так это ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706790107,
					"content": "#Я вспомнил{F#а} тебя!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "Выглядите так, будто не вспомнили...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790109,
					"content": "Как бы то ни было, прошу, взгляните сюда. Я уверен, что вы помните событие «По следам ветра».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790110,
					"content": "А помните, как вы высказали множество предложений после предыдущего раунда игрового тестирования? Отличные идеи! Я постарался применить их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790111,
					"content": "Я пересмотрел правила и игровой процесс... Несколько раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790112,
					"content": "Они ведь не стали сложнее?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "Не волнуйтесь. Уверен, вам понравятся нововведения. Позвольте вкратце рассказать о них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790115,
					"content": "Во-первых, в новой версии «По следам ветра» появилось так называемое сигнальное устройство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790116,
					"content": "Если мятежники активируют 4 сигнальных устройства, они одержат победу над охотником!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790117,
					"content": "А охотник... Тут ничего не изменилось! Если охотник захватит всех мятежников, то победит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790118,
					"content": "Но в этой версии «По следам ветра», когда мятежники попадают в руки охотника, они не выходят сразу из игры. Вместо этого они будут оставаться в зоне наблюдения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790119,
					"content": "Они смогут покинуть зону наблюдения и продолжить игру, когда пройдёт некоторое время или если им помогут другие мятежники.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790120,
					"content": "Но если мятежник попадёт в плен во второй раз... он выбывает из игры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790121,
					"content": "Звучит сложновато...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "Не волнуйтесь. Они только кажутся сложными, но после нескольких раундов вы во всём разберётесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790124,
					"content": "Ладно, я попробую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "Отлично! Сюда, пожалуйста...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790126,
					"content": "Мне некогда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "Ничего страшного. Приходите, когда освободитесь. Я буду здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гайгэкс"
				},
				{
					"id": 706790122,
					"content": "Столько новых правил...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "Ты ведь не добавил в событие какой-нибудь странный игровой процесс?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "Так ты... тот парень, предлагавший сыграть в игру?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "Гайгэкс! Но вы не ошиблись... И я совсем не расстроен тем, что название «По следам ветра» лучше запомнилось вам, чем я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Гайгэкс"
				}
			]
		}
	]
}