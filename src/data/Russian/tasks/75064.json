			"dialogs": [
				{
					"id": 750640701,
					"content": "Надо поработать над освещением. Мне не нужна помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640702
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750640702,
					"content": "Нужно <color=#00E1FFFF>подсветить левую сторону лица и контур спины! </color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Магнифико"
				}
			]
		},
		{
