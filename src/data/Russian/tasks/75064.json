			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Магнифико"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750640801,
					"content": "«Луи! Луи!» ...Ах, вы меня напугали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640802
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750640802,
					"content": "#Ну что? Ты передумал{F#а}? Или хочешь просто поздороваться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640803,
						750640806
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750640803,
					"content": "#Хотел{F#а} поздороваться и помочь, пока мы здесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640804
					]
				},
				{
					"id": 750640804,
					"content": "Ур-ру-у-у!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640805
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640805,
					"content": "Ха-ха, здорово! Начинаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750640806,
					"content": "Мы просто проходили мимо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640807
					]
				},
				{
					"id": 750640807,
					"content": "Ладно, удачи тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Магнифико"
				}
			]
		},
