			},
			"dialogs": [
				{
					"id": 750641401,
					"content": "#Подожди... Почему ты исчез{F#ла}, когда появился иктомизавр? И почему он исчез, когда ты {M#вернулся}{F#вернулась}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641402
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750641402,
					"content": "Неужели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641403
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750641403,
					"content": "#Да, {M#он}{F#она} в туалете!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750641404,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641405
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750641405,
					"content": "Эм... Ну, мы ведь не можем пойти туда все вместе? Это было бы слишком неловко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750641406,
					"content": "#И правда... Ха-ха, {NICKNAME} не может стать заврианом, так что ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Магнифико"
				}
			]
		},
