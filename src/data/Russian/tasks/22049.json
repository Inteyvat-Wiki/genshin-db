			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Наганохара Рюносукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220490101,
					"content": "#Это же {F#новая приятельница}{M#новый приятель} моей маленькой девочки! Ты хочешь с ней поиграть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490102,
						220490105
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490102,
					"content": "Как идёт торговля сегодня?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490103
					]
				},
				{
					"id": 220490103,
					"content": "Хорошо, очень хорошо! Ха-ха-ха, моя девочка - настоящий мастер!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490104
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490104,
					"content": "Вы пришли к ней?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490107,
					"content": "К сожалению, нет! Она сказала, что собирается за материалами для изготовления нового фейерверка, так что сейчас её нет дома!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490108
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490108,
					"content": "Куда она ушла?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490109
					]
				},
				{
					"id": 220490109,
					"content": "Что? Что вы говорите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490110
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490110,
					"content": "Ёимия! Где она?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490111
					]
				},
				{
					"id": 220490111,
					"content": "О, э... Я вообще-то не уверен. Возможно, она говорила, но знаете, я не расслышал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490112
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490112,
					"content": "Вы к ней по делу или хотите купить фейерверки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490113,
						220490116
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490113,
					"content": "Мы хотим позвать её погулять...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490114
					]
				},
				{
					"id": 220490114,
					"content": "Вряд ли у вас получится. Никогда не знаешь, когда она вернётся или когда она пойдёт возиться со своими фейерверками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490115
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490115,
					"content": "Как насчёт этого? Перед уходом она сделала и оставила в магазине несколько новых фейерверков. Почему бы вам не взять их и не пойти поиграть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490118,
					"content": "Где же они... Наверное, внутри...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490119,
						220490120
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490119,
					"content": "Мы точно можем их взять...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490121,
					"content": "Всё в порядке, не волнуйтесь. У нас тут куча товара в магазине. Просто возьмите и идите развлекаться. Не беспокойтесь ни о чём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490122
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490122,
					"content": "Кроме того, моя девочка искала людей, которые могли бы испытать эти фейерверки. Раз уж вы здесь, то можете это сделать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490123
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490123,
					"content": "Просто возьмите их на пробу и расскажите, как всё прошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490124
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490124,
					"content": "Я передам ваши впечатления Ёимии, когда она вернётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490125
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490125,
					"content": "Не беспокойтесь об этом. Я уверен, она будет очень рада узнать, что именно вы взяли их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490126
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490126,
					"content": "Только запускайте их за пределами города. Если вы сделаете это в городе, вы привлечёте ненужное внимание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490120,
					"content": "Не сказав Ёимии...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490116,
					"content": "Хотелось бы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490117
					]
				},
				{
					"id": 220490117,
					"content": "Понятно. Перед уходом она сделала и оставила в магазине несколько новых фейерверков. Почему бы вам не взять их и не пойти поиграть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490105,
					"content": "Ёимия здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490106
					]
				},
				{
					"id": 220490106,
					"content": "Вы пришли к ней?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "Наганохара Рюносукэ"
				}
			]
		},
