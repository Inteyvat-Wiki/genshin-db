			"dialogs": [
				{
					"id": 220490301,
					"content": "Вы вернулись. Вам понравились фейерверки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490302,
						220490304
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490302,
					"content": "Очень.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490303
					]
				},
				{
					"id": 220490303,
					"content": "Вот и хорошо, ха-ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490306,
					"content": "Мне нужно вернуться к работе в магазине. В последнее время дела идут в гору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490307
					],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490307,
					"content": "Ёимия ещё не вернулась. Куда она запропастилась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наганохара Рюносукэ"
				},
				{
					"id": 220490304,
					"content": "Мы бы ещё запустили парочку другую...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490305
					]
				},
				{
					"id": 220490305,
					"content": "Значит, вам и правда понравилось. В следующий раз я дам вам ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Наганохара Рюносукэ"
				}
			]
		}
	]
