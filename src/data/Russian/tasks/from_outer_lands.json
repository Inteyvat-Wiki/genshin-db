					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030205,
					"content": "Эти люди покинули Инадзуму... Но в море случилась какая-то беда, и им оставалось только дрейфовать по течению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
