					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790030101,
					"content": "Кажется, это... лодка? Или, скорее, половинка лодки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030102,
					"content": "Но что здесь делает половинка лодки? Смотри! Тут какие-то слова нацарапаны... Давай почитаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030103,
					"content": "«...Даже несмотря на то, что передняя часть уничтожена, мы смогли проплыть так далеко. Мой корабль великолепен, ха-ха-ха... Но почти весь груз утонул...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030104,
					"content": "«...Похоже, нас несёт юго-восточное течение? Неважно. Самое главное - найти выход отсюда...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030105,
					"content": "Похоже, что люди потерпели крушение! «...передняя часть уничтожена...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030106,
					"content": "Получается, это задняя часть корабля. Ох... Какая неведомая сила могла переломить корабль надвое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030107,
					"content": "Здесь также сказано: «...дрейфует с юго-востока...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030108,
					"content": "Возможно, нам стоит поискать вторую часть лодки в том направлении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030109,
					"content": "Давай захватим эту дощечку с собой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030110
					]
				},
				{
					"id": 790030110,
					"content": "Паймон всё поняла. Ты думаешь, что эти надписи нам как-то помогут?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030111,
					"content": "Ладненько. Эта лодка уже почти превратилась в труху, так что отломить дощечку не составит большого труда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030112,
					"content": "Забирай дощечку и пойдём уже искать вторую половину лодки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
