				{
					"id": 790030317,
					"content": "Здесь стоит осмотреться. Вдруг мы найдём... СОКРОВИЩА!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030318,
						790030320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030318,
					"content": "Так долго пролежать в воде... Что угодно придёт в негодность.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030319
					]
				},
				{
					"id": 790030319,
					"content": "Эй! Не порть мне настрой! Уверена, что мы найдём роскошное блестящее сокровище!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030322,
					"content": "Пора пошевеливаться. Нам ещё целое море нужно обыскать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030320,
					"content": "Или монстров...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030321
					]
				},
				{
					"id": 790030321,
					"content": "Исключено. Мы же в море! Тут лишь вода да рыбки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790030314,
					"content": "Вдруг им удалось выжить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030315
					]
				},
				{
					"id": 790030315,
					"content": "Паймон тоже на это надеется... Но ситуация выглядит весьма плачевно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030316
					],
					"speakerTitle": "Паймон"
				}
			]
