				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030501,
					"content": "Похоже, мы пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030502
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030502,
					"content": "Жуткий, безжизненный, тёмный зал... Теперь я понимаю, о какой злой ауре вы мне рассказывали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030503
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030503,
					"content": "У-у-у-у... Такое страшное место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030504,
					"content": "Будьте осторожны, не дайте энергии осквернённой статуи овладеть вами. Вестник Бездны... Он здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030505
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030505,
					"content": "Ха-ха-ха-ха... Твоё чутьё не обмануло тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030506
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80030506,
					"content": "Ты такой же надоедливый, как и раньше, Дайнслейф, враг Бездны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030507
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80030507,
					"content": "Я чувствую, что твоя душа запятнана ужасным кровопролитием, возможно, из твоих самых мрачных кошмаров. Или... Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030508
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80030508,
					"content": "Ох, ещё что-то... Что-то намного опаснее! От тебя несёт порчей, так знакомой мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030509
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80030509,
					"content": "Значит, мы с тобой похожи. Мы оба опасны. Но опасность вне ордена Бездны должна быть поймана и заключена в клетку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030510
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80030510,
					"content": "Тц.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030511
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030511,
					"content": "Несёт порчей только от твоих слов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030512
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030512,
					"content": "Пришло время тебя заткнуть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дайнслейф"
				}
			]
		},
