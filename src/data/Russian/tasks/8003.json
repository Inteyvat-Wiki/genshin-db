			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дайнслейф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030201,
					"content": "Это же... Неужели?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030202,
					"content": "#{F#Итэр}{M#Люмин}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030203
					]
				},
				{
					"id": 80030203,
					"content": "#{F#Люмин}{M#Итэр}...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030204,
						80030205
					]
				},
				{
					"id": 80030204,
					"content": "#Наконец-то я наш{F#ла}{M#ёл} тебя!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				},
				{
					"id": 80030206,
					"content": "#П-постой... Он{M#а} только что блокировал{M#а} атаку против Вестника Бездны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030207,
					"content": "#Тво{F#й}{M#я} {F#брат}{M#сестра}... с Бездной?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030208,
					"content": "#{F#Люмин}{M#Итэр}, почему ты с Дайном?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030209,
						80030210
					]
				},
				{
					"id": 80030209,
					"content": "...Что?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030211,
					"content": "(Мы не виделись так давно...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030213,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030214,
					"content": "#Тво{F#й}{M#я} {F#брат}{M#сестра}... знает Дайна, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030216
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030216,
					"content": "#{F#Итэр}{M#Люмин}. Мы встретились вновь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030217
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030217,
					"content": "#Ч-что происходит? Дайн тоже {F#его}{M#её} знает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030218,
					"content": "#{F#Люмин}{M#Итэр}... Тебе не стоит следовать за этим человеком.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030219
					]
				},
				{
					"id": 80030219,
					"content": "Он... мой враг.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030220
					]
				},
				{
					"id": 80030220,
					"content": "#{F#Итэр}{M#Люмин}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030221,
						80030222
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030221,
					"content": "Подожди!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030223,
					"content": "...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030224
					]
				},
				{
					"id": 80030224,
					"content": "#Но я долж{F#ен}{M#на} сказать это, {F#Люмин}{M#Итэр}. Не пытайся меня остановить. Не пытайся остановить Бездну.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030225
					]
				},
				{
					"id": 80030225,
					"content": "Этот человек, Дайнслейф, был известен как «Сумеречный меч», один из королевской стражи последней династии Каэнри'ах. 500 лет назад он не смог предотвратить уничтожение своей нации.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030226
					]
				},
				{
					"id": 80030226,
					"content": "На него было наложено проклятие бессмертия, заставившее его вечно блуждать по пустоши... И он наблюдал, как люди, которых он должен был защищать, превращаются в монстров Бездны.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030227
					]
				},
				{
					"id": 80030227,
					"content": "Значит... на самом деле Дайн из Каэнри'ах?! Той самой Каэнри'ах, которая была уничтожена 500 лет назад?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030228,
					"content": "#И ты сказал{M#а}, что люди превращались в монстров... Ты хочешь сказать Паймон, что орден Бездны не просто имеет какое-то отношение к Каэнри'ах, а что он и есть народ Каэнри'ах?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030229,
					"content": "Ох... И что Дайн твой враг? Паймон совсем ничего не понимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030230,
						80030231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030230,
					"content": "#Идём со мной, {F#Итэр}{M#Люмин}! Пора возвращаться домой!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030232,
					"content": "Дом...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030233
					]
				},
				{
					"id": 80030233,
					"content": "Да, конечно. Дом - это то место, где мы вместе.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030234
					]
				},
				{
					"id": 80030234,
					"content": "Но я не могу покинуть этот мир с тобой в поисках нового дома... Пока не могу.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030235
					]
				},
				{
					"id": 80030235,
					"content": "Пока имена богов не канут в Бездну, я буду сражаться с небесным порядком...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030236
					]
				},
				{
					"id": 80030236,
					"content": "С небесным порядком?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030237
					]
				},
				{
					"id": 80030237,
					"content": "#Послушай меня, {F#Люмин}{M#Итэр}.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030238
					]
				},
				{
					"id": 80030238,
					"content": "#Я уже закончил{M#а} своё путешествие по этому миру. Закончи его и ты. Только тогда ты сможешь познать истинную природу этого мира.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				},
				{
					"id": 80030231,
					"content": "Ты можешь рассказать мне обо всём по пути домой!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030222,
					"content": "#Я не понимаю, {F#Итэр}{M#Люмин}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030212,
					"content": "(Почему ты спрашиваешь о том, что не имеет значения?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030210,
					"content": "Ты спрашиваешь... о Дайне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030205,
					"content": "Пойдём со мной! Здесь опасно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				}
			]
		},
		{
			"id": 800303,
			"completionStepIds": [
				800307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
