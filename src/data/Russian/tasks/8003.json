			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дайнслейф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030101,
					"content": "Дайн, вот ты где. Ты видел магистра Джинн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030102,
					"content": "Я увидел её, но не стал вступать с ней в контакт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030103
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030103,
					"content": "Будучи рыцарем Львиного клыка и действующим магистром ордена, она бы отнеслась ко мне с опаской.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030104
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030104,
					"content": "Если я буду неосторожен, то однажды могу стать целью какого-нибудь её расследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030105
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030105,
					"content": "Вернёмся к делу... Я уничтожил некоторые силы Бездны, но мне не удалось добыть новую информацию. Надеюсь, вы добились больших результатов, чем я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030106
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030106,
					"content": "Понятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030107
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030107,
					"content": "Значит, теперь мы можем примерно определить, где оказался первый культиватор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030108
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030108,
					"content": "Что, правда? Только из истории Борея?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030109,
					"content": "Не только. Ещё мы применим всесторонний анализ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030110
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030110,
					"content": "Например, та «старая история», которую вы услышали в соборе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030111
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030111,
					"content": "«Последний гнев тирана»!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030112
					]
				},
				{
					"id": 80030112,
					"content": "Именно. Странные события, о которых вам рассказала юная сестра церкви. Долгое время считалось, что это было проклятье, наложенное почившим тираном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030113,
						80030114,
						80030126
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030113,
					"content": "Скорее всего, этими огненными шарами были ракеты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030115,
					"content": "Ах, Паймон поняла! «Последний гнев тирана» - это на самом деле ракеты, которыми стрелял сбежавший из Вольфендома культиватор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030116,
					"content": "Должно быть, после поражения в бою с Волком Севера он добрёл до руин древнего Мондштадта и остался там...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030117,
					"content": "А потом, когда кто-то подходил близко - БУМ, БАМ, БА-БАХ! Он обстреливал их кучей ракет... Пока однажды он не сломался окончательно, и огненные шары перестали сыпаться с небес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030118,
					"content": "В те времена жители Мондштадта нечасто видели стражей руин, поэтому они поняли это явление как «Последний гнев тирана»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030119,
					"content": "Похоже, нам придётся отправиться в <color=#00E1FFFF>логово Ужаса Бури</color> и прочесать там всю местность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030120,
						80030121
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030120,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030122,
					"content": "Хм? Что ты имеешь в виду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030123
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030123,
					"content": "Я... Я помню.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030124
					]
				},
				{
					"id": 80030124,
					"content": "Что? Ты имеешь в виду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030125,
					"content": "О! Паймон тоже вспомнила! В прошлый раз мы видели одинокого <color=#00E1FFFF>стража руин, сидящего на вершине башни</color>! Такое тяжело забыть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030121,
					"content": "Не нужно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030114,
					"content": "Древние жители Мондштадта не поняли, чем были шары на самом деле...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030126,
					"content": "На самом деле Барбара - пастор...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				}
			]
		},
		{
			"id": 800302,
			"completionStepIds": [
				800305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
