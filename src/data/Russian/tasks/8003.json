				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800311",
							"2"
						],
						"stepId": 800311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030601,
					"content": "Они ушли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030602,
					"content": "#Ох, не расстраивайся, {NICKNAME}... Мы обязательно их отыщем! С другой стороны, нам удалось раздобыть кое-какую полезную информацию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030603,
						80030605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030603,
					"content": "Я... не расстраиваюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030604
					]
				},
				{
					"id": 80030604,
					"content": "Да? Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030607,
					"content": "#По крайней мере, теперь, помимо семерых Архонтов, Дайн тоже стал ключом к поискам твое{F#го}{M#й} {F#брата}{M#сестры}, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030608,
						80030609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030608,
					"content": "Нужно иметь это в виду, когда мы достигнем Инадзумы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030610,
					"content": "#Точно! Кстати, ты что-нибудь понял{F#а} из той неразберихи, что они несли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030611,
						80030612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030611,
					"content": "Более-менее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030613,
					"content": "Ох... Тогда давай попробуем разобраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030614,
					"content": "#Во-первых, Вестник Бездны называл {F#твоего брата «Принцем»}{M#твою сестру «Принцессой»}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030615,
					"content": "#Похоже, что {F#твой брат}{M#твоя сестра} ведёт орден Бездны за собой, и даже сам Вестник Бездны отчитывается перед {F#ним}{M#ней}... Но опять же, мы не знаем, является ли {F#он}{M#она} главой всей этой организации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030616
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030616,
					"content": "#Ещё {F#твой брат}{M#твоя сестра} сказал{M#а}, что хочет, чтобы «имена богов канули в Бездну», и что он{M#а} «будет сражаться с небесным порядком». Что всё это значит? ...Неужели он{M#а} хочет уничтожить семерых Архонтов и все семь королевств?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030617
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030617,
					"content": "Далее... Оказывается, после уничтожения их нации, народ Каэнри'ах превратился в монстров ордена Бездны. Это просто ужасная история!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030618,
					"content": "И сам Дайн тоже оказался из Каэнри'ах! Он стал свидетелем её уничтожения 500 лет назад. Но... он не превратился в монстра и поэтому теперь сражается с орденом Бездны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030619
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030619,
					"content": "#Получается, поэтому тво{F#й брат}{M#я сестра} сказал{M#а}, что Дайн {F#его}{M#её} враг?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030620
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030620,
					"content": "Но... почему же он противостоит ордену Бездны, если монстры Бездны - это те же люди, которых Дайн поклялся защищать столько лет назад?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030621
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030621,
					"content": "#И как так получилось, что тво{F#й брат}{M#я сестра}, котор{F#ого}{M#ую} мы так долго вместе искали, оказал{F#ся}{M#ась} на стороне ордена Бездны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030622,
						80030623
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030622,
					"content": "Появилось много вопросов и мало ответов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030624,
					"content": "Да, согласна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030625
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030625,
					"content": "#В таком случае нам нельзя вешать нос, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030626
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030626,
					"content": "Наше путешествие не окончено, нужно продолжать идти вперёд! Да и пора уже выбираться из этого тёмного ужасного места под тёплые лучики солнца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030627
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030627,
					"content": "#Если {F#твой брат}{M#твоя сестра} хочет, чтобы ты достиг{F#ла} конца своего путешествия, то... Давай покажем {F#ему}{M#ей}, на что ты способ{F#на}{M#ен}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030628
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030628,
					"content": "#В путь, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030623,
					"content": "Догадки ничем не помогут.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030612,
					"content": "#Мне не было дела ни до чего, кроме {F#брата}{M#сестры}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030609,
					"content": "К нашему путешествию добавилась ещё одна цель.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030605,
					"content": "Ты права, Паймон. Надежда умирает последней.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030606
					]
				},
				{
					"id": 80030606,
					"content": "Хех, да-да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}