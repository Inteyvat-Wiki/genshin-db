			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дайнслейф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030301,
					"content": "Вот он, да? Ну что ж, попробуй найти глаз с помощью своего чувства стихий!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030302,
					"content": "У-у-у-у... Ну и что ты видишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030303,
					"content": "А? ...Ничего? А Паймон так ждала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030304,
					"content": "#Тогда в чём же дело... Ты уверен{F#а}, что всё сделал{F#а} правильно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030305,
					"content": "Здесь понадобится другой метод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030306
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030306,
					"content": "Осмотр культиватора чувством стихий не поможет, потому что его питают не стихийные элементы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030307
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030307,
					"content": "Позвольте мне попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030308
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030308,
					"content": "...Готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030309
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030309,
					"content": "Ого! Это, это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030310,
					"content": "Та вещь, которую так отчаянно искал Вестник Бездны, - глаз первого культиватора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030311
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030311,
					"content": "Существующие сегодня стражи руин просто копии этой машины. Она была прототипом, и её боевые характеристики не были ничем ограничены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030312
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030312,
					"content": "«Прототипом»? ...Паймон не знает такого слова. Это ещё одно словечко из языка Каэнри'ах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030313,
					"content": "Согласно предположению ордена Бездны, если установить этот глаз в руки осквернённой статуи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030314
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030314,
					"content": "И присоединить конечности Осиала, Архонта Вихрей, к самой статуе... То мы получим механическое божество...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030315
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030315,
					"content": "...Которое сможет «низвергнуть богов Селестии со своих тронов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030316,
						80030317
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030316,
					"content": "Это очень опасная операция.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				},
				{
					"id": 80030318,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030319
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030319,
					"content": "Но... Что же нам делать с этим глазом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030320,
						80030321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030320,
					"content": "Мы спрячем его.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030322,
					"content": "Нет. Я буду хранить его у себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030323
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030323,
					"content": "Что?! Ты?! Дайн... Надеюсь, ты не собираешься его как-то использовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030324,
					"content": "Сомневаться в моих намерениях - твоё право. Но я не могу позволить, чтобы он попал не в те руки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030325
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030325,
					"content": "Где бы мы ни спрятали глаз, они его найдут. А что касается церкви Фавония... Вы знаете, что я не могу им доверять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030326
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030326,
					"content": "Ох... Ну да...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030327,
					"content": "Более того, наша работа ещё не окончена. Чтобы избежать дальнейших последствий, мы должны позаботиться об осквернённой статуе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030328,
						80030329
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030328,
					"content": "Что нам нужно сделать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030330,
					"content": "Нельзя вмешивать церковь, мы справимся сами. А что касается статуи... Мы должны уничтожить её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030331
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030331,
					"content": "У-уничтожить её?! Но ведь это статуя семи Архонтов! Это не только культурное достояние, но и божественная реликвия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030332
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030332,
					"content": "Ну в общем, хорошо, что мы ничего не рассказали Барбаре, иначе сейчас она бы просто сошла с ума!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030333
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80030333,
					"content": "Хм... Вряд ли семеро Архонтов рассчитывают на то, что я буду заботиться об их статуях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030334
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030334,
					"content": "Давайте вернёмся в <color=#00E1FFFF>те руины</color> и уничтожим перевёрнутую статую. Если повезёт, мы там опять встретим Вестника Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030335
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030335,
					"content": "В этот раз я не позволю ему сбежать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80030329,
					"content": "Мы можем доверить это церкви?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030321,
					"content": "Мы оставим его под охраной церкви Фавония.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030317,
					"content": "Нужно остановить орден Бездны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				}
			]
		},
