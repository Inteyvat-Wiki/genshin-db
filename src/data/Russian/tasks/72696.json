					"Бертран"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960201,
					"content": "#Как проходит заключительный этап? Могу поспорить, что {F#такой опытной искательнице приключений}{M#такому опытному искателю приключений}, как ты, не составило труда одолеть элементальных существ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бертран"
				}
			]
		},
		{
			"id": 7269603,
			"completionStepIds": [
				7269603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269603",
							"2"
						],
						"stepId": 7269603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бертран"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960301,
					"content": "Итак, мы всё закончили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960302
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960302,
					"content": "#{NICKNAME}, хочешь сам{F#а} установить коллектор материалов в машину?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960303
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960303,
					"content": "Я понятия не имею, что из этого выйдет. Это так волнительно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960304
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960304,
					"content": "Так ты не знаешь, какая получится игрушка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726960305,
					"content": "Да, в этом и вся прелесть Великолепной машины! Она по-разному реагирует на материалы и обрабатывает их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960306
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960306,
					"content": "То, что вы насобирали, определит результат... Давай скорее попробуем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бертран"
				}
			]
		},
		{
			"id": 7269604,
			"completionStepIds": [
				7269605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269605",
							"2"
						],
						"stepId": 7269605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бертран"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960401,
					"content": "Это правда игрушка, изготовленная машиной из Фонтейна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726960402,
					"content": "Хм... Совсем не вяжется с моим представлением о Фонтейне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960403
					]
				},
				{
					"id": 726960403,
					"content": "Ну, знаете, если бы я стал делать механические игрушки, как в Фонтейне, я никогда бы не достиг коммерческого успеха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960404
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960404,
					"content": "По правде говоря, я включил в производство свои представления о местной популярной культуре. Ведь нужно завоевать сердца жителей, чтобы получить радушный приём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960405
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960405,
					"content": "Это правда понравится людям?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726960406,
					"content": "Кхе-кхе... Поначалу могут возникнуть недопонимания, но надо не опускать руки и улучшать продукцию, тогда мы найдём ключ к их сердцам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960407
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960407,
					"content": "В общем, первый цикл мы завершили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960408
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960408,
					"content": "И как вам? Правда же замечательно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960409
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960409,
					"content": "Довольно интересно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960410
					]
				},
				{
					"id": 726960410,
					"content": "Хе-хе, теперь понятно. Так вот что мы можем изготовить из этих материалов. Это я отправляю на склад, а ты возьми купон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960417
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960417,
					"content": "А купон пригодится вам, если вы захотите бесплатно получить такую же игрушку, если она вам приглянулась. Конечно же, только после запуска производства!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960418
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960418,
					"content": "Это ведь наша первая игрушка, и мне ещё нужно провести кое-какие исследования. Не будут же они у нас всё время взрываться, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960411
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960411,
					"content": "Так теперь посмотрим, какие проблемы возникли во время пробного запуска... Ну-ка... Кажется, нужно внести кое-какие корректировки, чтобы повысить эффективность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960412
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960412,
					"content": "Ты так серьёзно ко всему относишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726960413,
					"content": "Конечно. Я один на чужбине. Эта машина - моё создание и всё, что у меня есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960414
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960414,
					"content": "Досины, которые меня арестовали, сказали, что это всё «чудные фокусы». Что ж, я им покажу чудные фокусы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960415
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960415,
					"content": "Но сначала мне нужно внести некоторые корректировки и приступить к производству.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960416
					],
					"speakerTitle": "Бертран"
				},
				{
					"id": 726960416,
					"content": "#{NICKNAME}, ты мне поможешь, когда настанет время?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бертран"
				}
			]
