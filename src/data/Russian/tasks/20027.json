			"dialogs": [
				{
					"id": 200270101,
					"content": "#Благодарю тебя, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270102
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200270102,
					"content": "Я всего лишь хотел проверить виноградники, а тут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270103
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200270103,
					"content": "Пожалуйста, не рассказывай ничего моему сынишке. Он рыцарь Ордо Фавониус. Я уверен, что ему и так забот хватает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270104
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200270104,
					"content": "Не стоит ему переживать из-за глупого старика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270105
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200270105,
					"content": "В последнее время у нас тут слаймов развелось... Я ночами не сплю, переживаю, что они весь виноград попортят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270106
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200270106,
					"content": "Если у тебя найдётся свободная минутка, прогони их от виноградников, сделай одолжение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270107,
						200270108
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200270107,
					"content": "Без проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270109
					]
				},
				{
					"id": 200270109,
					"content": "#Храни тебя ветер, {F#дочь}{M#сынок}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200270108,
					"content": "Мне некогда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270110
					]
				},
				{
					"id": 200270110,
					"content": "Я бы с радостью сам с этим разобрался, но только вот возраст уже даёт о себе знать. А для тебя это - плёвое дело. Давай, помоги старику!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Таннер"
				}
			]
		}
	]
