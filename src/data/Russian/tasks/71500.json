			"dialogs": [
				{
					"id": 715000201,
					"content": "Вы вернули побеги бамбука?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хранитель Облаков"
				}
			]
		},
		{
			"id": 7150003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150005",
							"2"
						],
						"stepId": 7150005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хранитель Облаков"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000303,
					"content": "Всё остальное можно доверить устройству. Однако контроль температуры - это твоя забота.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000304
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000304,
					"content": "А оно само не может контролировать температуру?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000305
					]
				},
				{
					"id": 715000305,
					"content": "Э-э... Я несколько раз пыталась использовать внутреннее пламя для достижения автономного управления огнём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000306
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000306,
					"content": "Но в Чуде кулинарной машинерии необычное пламя... Чтобы управлять им, нужно использовать пламя Адептов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000307
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000307,
					"content": "Пламя Адептов такой силы исказит форму внутренних компонентов, если направить его непосредственно внутрь устройства. Жертвовать большим устройством ради небольшой выгоды неразумно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000308
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000308,
