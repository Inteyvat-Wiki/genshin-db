	"talks": [
		{
			"id": 7150001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150001",
							"2"
						],
						"stepId": 7150001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хранитель Облаков"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000101,
					"content": "Мм... Возможно, этот путь лучше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000102
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000102,
					"content": "#Ты как раз вовремя, путешественни{F#ца}{M#к}. Я только закончила настройку этого устройства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000103,
						715000105
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000103,
					"content": "Это... Чудо кулинарной машинерии?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000104
					]
				},
				{
					"id": 715000104,
					"content": "Истинно. В него вложено много моих усилий, и его способности огромны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000107,
					"content": "Бесчисленное количество трудов нужно было прочесть для создания этого устройства. Знай, что в искусстве приготовления еды есть несколько ключевых моментов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000108
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000108,
					"content": "Первый из них - поиск ингредиентов, которые имеют огромное значение в кулинарии. Долгие годы бесчисленное множество поваров трудилось в поисках всевозможных ингредиентов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000109
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000109,
					"content": "Прежде всего устройство призвано решить эту проблему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000110
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000110,
					"content": "После активации оно будет автоматически искать подходящие ингредиенты поблизости и отмечать их запах, чтобы повара могли найти их источник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000111
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000111,
					"content": "А оно не может само собрать ингредиенты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000112
					]
				},
				{
					"id": 715000112,
					"content": "Это... устройство находится на ранней стадии разработки. Вопрос о том, как оно может самостоятельно преодолевать неровности горных дорог, ещё не решён.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000113
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000113,
					"content": "Второй ключевой момент - само приготовление. Внутри этого устройства размещено бесчисленное множество сложных компонентов. При помещении ингредиентов внутрь происходит их автоматическая обработка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000114
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000114,
					"content": "Как устройство узнаёт, что делать с ингредиентами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000115
					]
				},
				{
					"id": 715000115,
					"content": "Ну... Естественно, при определении способа обработки ингредиентов оно ссылается на соответствующий рецепт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000116
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000116,
					"content": "Его внутреннее устройство трудно объяснить в двух словах. Тебе достаточно знать, что решение этого вопроса потребовало немалых усилий с моей стороны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000117
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000117,
					"content": "Ещё больше усилий потребовало решение самого насущного для всех поваров вопроса очистки устройства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000118
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000118,
					"content": "Очистка застрявших кусочков пищи может испортить атмосферу праздника...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000119,
						715000122
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000119,
					"content": "Это устройство продаётся?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000120
					]
				},
				{
					"id": 715000120,
					"content": "Ха-ха, сомневаюсь, что ты сможешь позволить себе это чудесное устройство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000121
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000121,
					"content": "Более того, в настоящее время оно работает только под действием силы Адепта. Его покупка не принесёт тебе никакой пользы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000125,
					"content": "Довольно пустых разговоров. Когда я создавала это устройство, я также изучала рецепты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000126
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000126,
					"content": "Поэтому я придумала несколько рецептов, чтобы это Чудо кулинарной машинерии могло пройти соответствующие испытания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000127
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000127,
					"content": "Я пригласила тебя, чтобы попросить помочь мне собрать ингредиенты и по этим рецептам приготовить несколько блюд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000128
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000128,
					"content": "Первое блюдо называется тофу «Вэньсинь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000129
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000129,
					"content": "Для приготовления этого блюда тофу необходимо нарезать на мелкие кубики. Подходящее испытание для проверки способностей нарезки этого устройства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000130
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000130,
					"content": "Что касается ингредиентов... нужны тофу, ветчина, побеги бамбука и мясо птицы. Я уже попросила Гань Юй подготовить эти ингредиенты, и они должны быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000131
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000131,
					"content": "Что? Куда делись побеги бамбука? Они совершенно точно были здесь. Неужели какие-то злодеи воспользовались тем, что я была поглощена работой, и украли их?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000132
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000132,
					"content": "Неважно. Это хорошая возможность продемонстрировать тебе способности Чуда кулинарной машинерии по поиску ингредиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000133
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000133,
					"content": "Чудо кулинарной машинерии... включено!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000134
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000134,
					"content": "#Путешественни{F#ца}{M#к}, устройство активировано. Следуй за запахом и верни побеги бамбука.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000122,
					"content": "Зачем тогда было его создавать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000123
					]
				},
				{
					"id": 715000123,
					"content": "Цель... изучить искусство механизмов и инженерии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000124
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000124,
					"content": "И, конечно, приготовление пищи станет более удобным для меня в будущем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 715000105,
					"content": "Что оно делает?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000106
					]
				},
				{
					"id": 715000106,
					"content": "#Как поспешно с твоей стороны. Будь {F#спокойна}{M#спокоен}, и позволь мне всё объяснить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "Хранитель Облаков"
				}
			]
		},
