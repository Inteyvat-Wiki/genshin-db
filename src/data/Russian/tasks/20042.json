					"nextDialogs": [
						200420703
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200420703,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420704
					]
				},
				{
					"id": 200420704,
					"content": "#Отлично, одной проблемой меньше. Но зачем ты подметал{F#а} эти листья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420705
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200420705,
					"content": "Нет листьев - нет Альберта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420706
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200420706,
					"content": "Возьми это в знак моей благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420707
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200420707,
					"content": "Пора мне вернуться к моим делам. А тебе - к своим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктория"
