			"dialogs": [
				{
					"id": 200420101,
					"content": "Где ты прячешься? Ты маленький...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420102
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200420102,
					"content": "Ты что-то потеряла?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420103
					]
				},
				{
					"id": 200420103,
					"content": "Я? Я ищу одного жуликоватого типа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420104
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200420104,
					"content": "Его зовут Альберт. Он целый день у собора ошивается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420105
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200420105,
					"content": "Выглядит он так, словно задумал что-то неладное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420106
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200420106,
					"content": "#Помоги мне его прогнать, будь добр{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктория"
				}
			]
		},
