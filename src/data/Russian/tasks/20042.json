			"dialogs": [
				{
					"id": 200421001,
					"content": "Что? Подозрительный вид? Что-то недоброе замышляю? Вы всё не так поняли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421002
					],
					"speakerTitle": "Альберт"
				},
				{
					"id": 200421002,
					"content": "Эх... Ты знаешь Барбару? Она просто ангел во плоти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421003
					],
					"speakerTitle": "Альберт"
				},
				{
					"id": 200421003,
					"content": "Многие жители Мондштадта обожают её, я в их числе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421004
					],
					"speakerTitle": "Альберт"
				},
				{
					"id": 200421004,
					"content": "Да я глава фан-клуба Барбары!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421005
					],
					"speakerTitle": "Альберт"
				},
				{
					"id": 200421005,
					"content": "Рыцари Ордо Фавониус будут здесь с минуты на минуту!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200421006
					]
				},
				{
					"id": 200421006,
					"content": "П-подожди! Я правда восхищаюсь Барбарой! Я хочу принести пользу Мондштадту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421007
					],
					"speakerTitle": "Альберт"
				},
				{
					"id": 200421007,
					"content": "Я простой человек без выдающихся способностей, но я могу подметать площадь и улицы вокруг собора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421008
					],
					"speakerTitle": "Альберт"
				},
				{
					"id": 200421008,
					"content": "Сестра Виктория даже слушать меня не хочет, она постоянно меня прогоняет.",
