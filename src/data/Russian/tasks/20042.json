			"dialogs": [
				{
					"id": 200420601,
					"content": "#Ты закончил{F#а} с листьями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420602
					],
					"speakerTitle": "Альберт"
				},
				{
					"id": 200420602,
					"content": "Всё чисто.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420603
					]
				},
				{
					"id": 200420603,
					"content": "Отличная работа! Спасибо тебе. У Барбары теперь будет чуть меньше забот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420604
					],
					"speakerTitle": "Альберт"
				},
				{
					"id": 200420604,
					"content": "Пожалуйста, не рассказывай ей об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420605
					],
					"speakerTitle": "Альберт"
				},
				{
					"id": 200420605,
					"content": "Будет лучше, если она об этом не узнает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420606
					],
					"speakerTitle": "Альберт"
				},
				{
					"id": 200420606,
					"content": "Не беспокойся. Я ухожу, как и обещал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420607
					],
					"speakerTitle": "Альберт"
				},
				{
					"id": 200420607,
					"content": "До встречи. Может быть, мы ещё встретимся.",
