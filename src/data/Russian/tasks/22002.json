			},
			"dialogs": [
				{
					"id": 220020101,
					"content": "Лулу, как так вышло, что я снова капитан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220020102,
					"content": "Потому что играть намного веселее, когда ты капитан!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020103,
					"content": "Если Лулу так нравится, то я не против...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220020104,
					"content": "Что вы делаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "Мы играем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020106,
					"content": "Мэн - капитан, Фэй - первый помощник, а я буду богатым купцом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020107,
					"content": "Нам не хватает пирата. Пират должен нас ограбить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020108,
					"content": "Ты можешь быть пиратом, если хочешь поиграть с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020109,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "Ура! Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020113,
					"content": "#Отлично. Дай нам знать, когда будешь готов{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020111,
					"content": "Я хочу играть за хороших...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "Это понарошку! Не переживай, мы знаем, что ты хороший человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Малышка Лулу"
				}
			]
		},
		{
			"id": 2200202,
			"completionStepIds": [
				2200202
