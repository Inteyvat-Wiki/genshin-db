			"dialogs": [
				{
					"id": 220020301,
					"content": "#Наш{F#ла}{M#ёл} чашечки лотоса?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020302
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020302,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020303
					]
				},
				{
					"id": 220020303,
					"content": "Ура! Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020304,
					"content": "Мэн! Фэй! Давайте скорее есть чашечки лотоса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020305,
					"content": "Эй! Паймон думала, что мы будем вас грабить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220020306,
					"content": "Ах, да! Вот ваши деньги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020307,
					"content": "У тебя отлично получается быть пиратом! Не каждый сможет ограбить ребёнка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020308,
					"content": "Мне кажется, что они над нами издеваются!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220020309,
					"content": "Спасибо за игру! Было весело! Давай в следующий раз тоже играть вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малышка Лулу"
				}
			]
		},
