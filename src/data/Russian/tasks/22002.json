			},
			"dialogs": [
				{
					"id": 220020201,
					"content": "#Я готов{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "Ура! Начинаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020203,
					"content": "Ты начинаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020204,
					"content": "Йо-хо-хо! Я тебя сейчас ограблю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "Ого! При свете дня! На глазах у Миллелитов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220020206,
					"content": "Лулу! Бежим! Скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220020207,
					"content": "Привет, пират! Ты хочешь нас ограбить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020208,
					"content": "Гони монету!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "Но у меня нет денег...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020213,
					"content": "Папа говорит, что самые ценные вещи на корабле - это товары купца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020214,
					"content": "А давай ты поможешь нам найти ценные вещи для игры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020215,
					"content": "Тогда тебе будет, что грабить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020216,
					"content": "Хм... Чашечки лотоса подойдут!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020217,
					"content": "Мы все любим чашечки лотоса. Худшее, что может сделать самый отвратительный пират - это украсть наши вкусняшки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020209,
					"content": "Эй ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "Гм... Это всего лишь игра, нужно быть аккуратнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220020211,
					"content": "Миллелиты уже наблюдают за нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "Малышка Лулу"
				}
			]
		},
