			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сюй Дун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140101,
					"content": "#Привет, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140102,
						220140104
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140102,
					"content": "Чем могу помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140103
					]
				},
				{
					"id": 220140103,
					"content": "Помнишь, я обещал тебе сытный обед? Вот как раз собираюсь его готовить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140106,
					"content": "Мы повсюду собирали свежие ингредиенты, чтобы приготовить по-настоящему вкусное блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140107
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140107,
					"content": "У меня почти достаточно ингредиентов, и сейчас я думаю над тем, что именно из них сообразить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140108
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140108,
					"content": "А где Парвана и Джули?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140109
					]
				},
				{
					"id": 220140109,
					"content": "Парвана отправилась на поиски новых ингредиентов для «идеальной приправы», которую она хотела сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140110
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140110,
					"content": "А с собой на поиски она взяла Джули... Они сказали, что не будут уходить далеко от города, так что не волнуйся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140111
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140111,
					"content": "Однако мне все-таки потребуется твоя помощь. Хотя у меня есть много свежих ингредиентов, у меня нет... вдохновения, необходимого для прорыва на моем пути к идеальному блюду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140112
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140112,
					"content": "Смотри. У меня есть водоросли, морские грибы, и... хм, цвет сакуры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140113
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140113,
					"content": "Они все очень свежие, но я понятия не имею, с чего мне начать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140114
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140114,
					"content": "Я собирался спросить совета у местного повара в Инадзуме. Но если бы я это сделал, то в итоге получил бы обычное инадзумское блюдо. В нем не было бы ничего оригинального.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140115
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140115,
					"content": "Поэтому я решил использовать инадзумские ингредиенты, но не так, как их используют в Инадзуме, а как повара из Ли Юэ. Из такой комбинации точно выйдет что-нибудь новое и интересное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140116
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140116,
					"content": "#Путешественни{F#ца}{M#к}, ты не мог{F#ла} бы пойти в Ли Юэ и проконсультироваться за меня с шеф-поваром Мао из «Народного выбора»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140117,
						220140119
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140117,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140118
					]
				},
				{
					"id": 220140118,
					"content": "Благодарю. Буду ждать тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140124,
					"content": "Надеюсь, у шеф-повара Мао найдётся пара хороших идей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140119,
					"content": "Тебе хотелось бы такого... бомбезного эффекта, а?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140120
					]
				},
				{
					"id": 220140120,
					"content": "Бомбезного? А? Ты имеешь в виду... чтобы люди испытали неожиданное ощущение восторга, попробовав моё блюдо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140121
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140121,
					"content": "Если ты найдёшь рецепт, который даст нашему блюду подобный эффект, это будет просто фантастика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140122
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140122,
					"content": "Но я не знаю никого, у кого был бы такой рецепт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140123
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140123,
					"content": "Так или иначе, сходи сначала к шеф-повару Мао, а там посмотрим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140104,
					"content": "Ты, случаем, не вон тем блюдом собрался меня угостить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140105
					]
				},
				{
					"id": 220140105,
					"content": "Ха-ха, именно им и собрался!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Сюй Дун"
				}
			]
		},
		{
			"id": 2201402,
			"completionStepIds": [
				2201402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201402",
							"2"
						],
						"stepId": 2201402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Шеф-повар Мао"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140201,
					"content": "#А? Что привело тебя сегодня ко мне, путешественни{F#ца}{M#к}? Хочешь, чтобы я сварганил для тебя чего-нибудь вкусненького?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140202
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140202,
					"content": "#Я {M#пришёл}{F#пришла} за советом...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140203
					]
				},
				{
					"id": 220140203,
					"content": "Сюй Дун отправился в Инадзуму за ингредиентами для своего блюда?.. Решимости ему не занимать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140204
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140204,
					"content": "Вы знакомы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140205
					]
				},
				{
					"id": 220140205,
					"content": "В каком-то смысле. Однажды у нас выдался кулинарный поединок, и дело закончилось ничьей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140206
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140206,
					"content": "Он упоминал, что собирается путешествовать по миру в поисках прорыва в своем кулинарном искусстве... Но я никогда не думал, что он действительно так далеко зайдет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140207
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140207,
					"content": "Однако похоже, что он зашёл в тупик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140208,
						220140210
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140208,
					"content": "Ты знаешь, как ему помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140209
					]
				},
				{
					"id": 220140209,
					"content": "Не могу ничего гарантировать, но постараюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140214,
					"content": "Водоросли... морской гриб... и... цвет сакуры? Какие странные ингредиенты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140215
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140215,
					"content": "Если взять только водоросли и морской гриб, то я думаю, я смог бы что-нибудь приготовить... но нам потребуются еще кое-какие ингредиенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140216
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140216,
					"content": "#Путешественни{F#ца}{M#к}, ты не мог{F#ла} бы пойти найти для меня заоблачный перчик и немного мяса птицы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140217,
						220140219
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140217,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140218
					]
				},
				{
					"id": 220140218,
					"content": "Договорились. Раздобудь и принеси их мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140219,
					"content": "Ах, классика...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140220
					]
				},
				{
					"id": 220140220,
					"content": "Ха-ха-ха, это точно. Нужно очень постараться, чтобы приготовить из них что-нибудь невкусное. Как только они будут у тебя - сразу ко мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140221
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140221,
					"content": "Однако, что касается цвета сакуры, то я не знаю, как его готовить... Понятия не имею, что с ними делают повара в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140210,
					"content": "Может быть, у Сян Лин найдутся какие-нибудь идеи, как решить его проблему...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140211
					]
				},
				{
					"id": 220140211,
					"content": "У Сян Лин... И правда, она всегда отличалась творческим подходом к кулинарии. Вполне вероятно, что она и тут сможет что-нибудь придумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140212
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140212,
					"content": "Но она отправилась в Цинцэ, чтобы набрать побегов бамбука, так что в данный момент её здесь нет. Потребуется время, чтобы найти её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140213
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140213,
					"content": "А Сюй Дун, должно быть, уже весь сам не свой от ожидания. Дай подумаю, может быть и я смогу тут чем-нибудь подсобить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Шеф-повар Мао"
				}
			]
		},
		{
			"id": 2201403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
