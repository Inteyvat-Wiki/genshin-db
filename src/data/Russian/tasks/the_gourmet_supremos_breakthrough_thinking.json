			"dialogs": [
				{
					"id": 220140401,
					"content": "Этого должно быть достаточно. Минутку. Посмотрим, что я смогу из них приготовить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140402
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140402,
					"content": "Готово. Хотя по ощущениям это не сильно отличается от того, что я обычно готовлю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140403
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 220140403,
					"content": "Отнеси это блюдо Сюй Дуну. Будем надеяться, что это решит его проблему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шеф-повар Мао"
