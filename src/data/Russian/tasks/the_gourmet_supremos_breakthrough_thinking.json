			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сян Лин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140601,
					"content": "А эти побеги бамбука ничего. Выкопаю-ка я парочку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140602
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 220140602,
					"content": "А? Вот так встреча. Что тебя сюда привело? Хочешь, чтобы я снова приготовила тебе чего-нибудь вкусненького?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140603,
						220140604
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 220140603,
					"content": "Мне нужна твоя помощь с одним делом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140607
					]
				},
				{
					"id": 220140607,
					"content": "О, комбинация ингредиентов из Инадзумы и кулинарных техник из Ли Юэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140608
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 220140608,
					"content": "#Хе-хе. Ты приш{M#ёл}{F#ла} по адресу! Я слышала об одной инадзумской технике, в соответствии с которой ингредиенты сначала обваливают в муке, а потом жарят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140609
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 220140609,
					"content": "Называется «тэмпура». А подаётся такое блюдо с соусом для обмакивания в него приготовленной еды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140610
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 220140610,
					"content": "Когда я сама пробовала приготовить тэмпуру, меня особенно увлёк именно этот соус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140615
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 220140615,
					"content": "Я пробовала самые разные ингредиенты: нектар попрыгуньи, пылающий цветок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140611
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 220140611,
					"content": "А он, часом, не из слизи слайма?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140612
					]
				},
				{
					"id": 220140612,
					"content": "Нет, нет. Слизь слайма здесь ни в какие ворота.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140616
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 220140616,
					"content": "Но своё предпочтение я отдаю порошку из крыльев Электро цицинов, чтобы придать ему более слоистую текстуру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140613
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 220140613,
					"content": "На всякий случай, я напишу тебе записку, а то забудешь ещё. Покажи её Сюй Дуну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140614
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 220140614,
					"content": "Эх... Хотела бы и я в Инадзуму. Там точно ещё столько ингредиентов, которые мне не доводилось использовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 220140604,
					"content": "Ты отреагировала точно так же, как и шеф-повар Мао...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140605
					]
				},
				{
					"id": 220140605,
					"content": "#А, ты был{F#а} в ресторане? Хм. Вижу, ты здесь, наверное, не для того, чтобы поесть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140606
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 220140606,
					"content": "В таком случае у тебя кулинарные затруднения, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140607
					],
					"speakerTitle": "Сян Лин"
				}
			]
		},
