				{
					"id": 220140801,
					"content": "Это блюдо... дай-ка попробую...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140802
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140802,
					"content": "Вкус великолепный, и сочетание ингредиентов тоже очень хорошее. Чего и следовало ожидать от шеф-повара Мао.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140803
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140803,
					"content": "Однако, мне кажется, что ему всё ещё чего-то не хватает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140804
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140804,
					"content": "Бомбезности, думается мне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140805
					]
				},
				{
					"id": 220140805,
					"content": "Не знаю... Эх... Я ещё подумаю. В любом случае шеф-повар Мао подал мне идею.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140806
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140806,
					"content": "Благодарю за помощь. Вот, пожалуйста, возьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140807
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 220140807,
					"content": "Как же мне приготовить действительно уникальное блюдо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				}
			]
