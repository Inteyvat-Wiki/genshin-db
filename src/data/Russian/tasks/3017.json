			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ташфин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170101,
					"content": "Стоять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170102
					],
					"speakerTitle": "Ташфин"
				},
				{
					"id": 30170102,
					"content": "#Путешественни{F#ца}{M#к} с золотыми волосами и {F#её}{M#его} летающая подружка... неплохой улов. Бежать вам некуда, можете сами в этом убедиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170103
					],
					"speakerTitle": "Ташфин"
				},
				{
					"id": 30170103,
					"content": "Ах вы! Из Бригады тридцати, да? Решили нас поймать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170104,
					"content": "Бригада тридцати... По-вашему, мы похожи на этих бездарных правительственных шавок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170105
					],
					"speakerTitle": "Ташфин"
				},
				{
					"id": 30170105,
					"content": "Мы элитнейший корпус с самыми высокими комиссионными во всём Сумеру. Мы исполняем поручение господина «Изгнанника».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170106
					],
					"speakerTitle": "Ташфин"
				},
				{
					"id": 30170106,
					"content": "Господин «Изгнанник»... то есть изгнанный из Академии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170107,
					"content": "Похоже, речь о Дотторе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170108
					]
				},
				{
					"id": 30170108,
					"content": "Но почему же он тогда сразу не послал за нами Фатуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170109,
						30170110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170109,
					"content": "У местных наёмников больше преимуществ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170111
					]
				},
				{
					"id": 30170111,
					"content": "Ты гляди на них, даже поболтать время нашли. Смерть вам совсем не страшна, не так ли? Все в атаку!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170112
					],
					"speakerTitle": "Ташфин"
				},
				{
					"id": 30170112,
					"content": "#{NICKNAME}, в б-бой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170110,
					"content": "Он воспользовался ресурсами Академии.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170111
					]
				}
			]
		},
		{
			"id": 301703,
			"completionStepIds": [
				301703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
