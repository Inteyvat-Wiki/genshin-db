							"301703",
							"2"
						],
						"stepId": 301703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ташфин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170301,
					"content": "Не так-то просто было с ними справиться. Не зря они себя «элитнейшими» называли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170302,
					"content": "Эта засада не последняя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170303
					]
				},
				{
					"id": 30170303,
					"content": "Да. Нам нужно быть осторожнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170304,
					"content": "Ну и жуткий же этот Дотторе... Он тоже знал, что мы отправляемся к Тигнари. Вот и устроил нам «сюрприз».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170305,
					"content": "Умные противники - та ещё головная боль. Ладненько, продолжим путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 301704,
			"completionStepIds": [
				301704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301704",
							"2"
						],
						"stepId": 301704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Коллеи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170401,
					"content": "#Ой, путешественни{F#ца}{M#к}! Да ещё и Паймон здесь. Откуда вы здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170402
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30170402,
					"content": "Коллеи! Рады тебя видеть. Как у тебя дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170403,
					"content": "Ну... честно говоря, не очень хорошо. В последние дни элеазар прогрессирует всё сильнее. Мне всё труднее и труднее выполнять свои обязанности лесного дозорного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170404
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30170404,
					"content": "Поэтому мастер Тигнари убрал меня из расписания патрулей. Теперь мне разрешено лишь помогать им с организационными моментами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170405
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30170405,
					"content": "Вот как... Бедняжка Коллеи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170406,
					"content": "Поможет только излечение Ирминсуля...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170407
					]
				},
				{
					"id": 30170407,
					"content": "Кстати, насчёт Тигнари! Он сейчас на задании? А то мы его ищем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170408,
					"content": "Мастер Тигнари недавно ушёл из леса Авидья и отправился в Пардис Дхяй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170409
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30170409,
					"content": "М? Он ушёл? Но... раньше он ни в какую не хотел покидать лес Авидья. Даже от приглашения мудрецов отказался. Что же случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170410,
					"content": "Мне тоже это показалось странным. Мастер Тигнари всегда ответственно относился к обязанностям Лесного дозора. Но тут он вдруг ушёл. Да ещё и в спешке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170411
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30170411,
					"content": "Он не сказал зачем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170412,
					"content": "Не-а. Мастер Тигнари просто наспех оставил для меня записку, чтобы я была в курсе. Ради этого он даже свои дела передвинул.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170413
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30170413,
					"content": "Если мастер Тигнари так торопился, наверняка это дело очень важное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170414
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30170414,
					"content": "Ты сказала, что он отправился в Пардис Дхяй. Где находится это место?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170415,
					"content": "Раньше мастер Тигнари обучался в Амурте. Пардис Дхяй - это что-то вроде их исследовательской базы. Там специально высадили разные растения для научных целей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170416
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30170416,
					"content": "Перед тем как стать лесным стражем, мастер Тигнари проводил в Пардис Дхяй почти всё своё время и усердно там учился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170417
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30170417,
					"content": "Исследовательская база? Какая же идея пришла ему в голову, что он бросился туда сломя голову...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170418,
					"content": "#{NICKNAME}, у нас не так много времени. Нужно отправиться в этот Пардис Дхяй и отыскать Тигнари.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170419,
						30170420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170419,
					"content": "Береги себя, Коллеи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170421
					]
				},
				{
					"id": 30170421,
					"content": "Ох... угу. Не переживай. Я уже привыкла к элеазару. Как найдёте мастера Тигнари, передайте ему от меня привет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170422
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 30170422,
					"content": "Ладненько, передадим! До встречи, Коллеи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170420,
					"content": "Почаще отдыхай, Коллеи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170421
					]
				}
			]
		},
		{
			"id": 301705,
			"completionStepIds": [
				301705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301705",
							"2"
						],
						"stepId": 301705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нахида",
					"Нахида"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170501,
					"content": "Погоди-ка! Это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170502,
						30170503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170502,
					"content": "Нахида!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170504
					]
				},
				{
					"id": 30170504,
					"content": "Как хорошо, что ты в порядке! Мы за тебя очень переживали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170505,
						30170506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170505,
					"content": "Нахида, ты там?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170507
					]
				},
				{
					"id": 30170507,
					"content": "#Да ну тебя, {NICKNAME}! Взял{F#а} и испортил{F#а} такое трогательное воссоединение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170508,
					"content": "#Паймон, путешественни{F#ца}{M#к} не зря меня проверяет. Всё же, Дотторе тоже умеет манипулировать сознанием других людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170509
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170509,
					"content": "Вы ведь не знаете, что произошло после нашего с вами расставания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170510
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170510,
					"content": "После проливного дождя даже грязная лужа может показаться нам небосводом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170511
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170511,
					"content": "Хм... Ну, кроме Нахиды, всё равно никто больше не умеет такие красивые метафоры выдавать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170512,
						30170513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170512,
					"content": "Я тоже так думаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170514
					]
				},
				{
					"id": 30170514,
					"content": "А? Я это сказала, чтобы просто понятнее разъяснить ситуацию. Даже доказать пока ничего не пыталась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170515
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170515,
					"content": "Ладно-ладно, мы поняли. Нахида, рассказывай давай! Что же тогда произошло? Что с теми людьми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170516
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170516,
					"content": "Когда вы ушли, я изо всех сил старалась восстановить их воспоминания. К счастью, слова Дотторе об «отправке информации напрямую в подсознание» вовсе не подразумевали то, что эта самая «информация» будет вписываться непосредственно в человеческий мозг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170517
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170517,
					"content": "Это скорее было больше похоже на галлюцинацию. А с таким я вполне могу справиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170518
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170518,
					"content": "К счастью, я успела закончить начатое. Когда он захотел взять меня под контроль, моему сознанию удалось увернуться и сбежать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170519
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170519,
					"content": "Повезло-повезло! Ну и не вовремя же этот Дотторе вылез. Если бы не Нахида...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170520,
					"content": "Всё не так уж и радужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170521
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170521,
					"content": "Пока я восстанавливала память тех людей, Дотторе смог установить мою личность. Теперь у нас на одну нераскрытую карту меньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170522
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170522,
					"content": "К тому же Дотторе способен менять настройки терминалов Акаши. Возможно, захват моего сознания в Акаше - лишь вопрос времени для него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170523
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170523,
					"content": "Значит, ты больше не сможешь свободно перемещаться по сознаниям? Но как же нам теперь быть... Дотторе в Академии и уже наверняка начал воплощать свои злобные замыслы с Акашей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170524,
						30170525
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170524,
					"content": "Нужно торопиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170526
					]
				},
				{
					"id": 30170526,
					"content": "Ну что же за невезенье... Дотторе будто бы просто играет с нами! Вот уж действительно серьёзный противник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170527
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170527,
					"content": "Ещё и сражается он отлично. Не зря он второй среди Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170528
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170528,
					"content": "Не время впадать в уныние. Лучше сосредоточиться на поиске решения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170529
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170529,
					"content": "Ты права. Кстати, как ты узнала, что мы направляемся в Пардис Дхяй? Неужели ты нас здесь уже поджидала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170530
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170530,
					"content": "#Да. Я легко ощущаю твою элементальную силу, {NICKNAME}. По её движению я и определила, куда вы направлялись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170531
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170531,
					"content": "Не думаю, что здесь вас заинтересовали исключительно достопримечательности. Нашли какие-то зацепки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170532
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170532,
					"content": "Мы пришли на поиски одного знакомого учёного, Тигнари. Не так давно с ним лично связывался один из мудрецов. Нахида, пойдёшь с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170533
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170533,
					"content": "Хорошо. Надеюсь, наше появление не доставит ему в будущем проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170525,
					"content": "Наше положение будет ухудшаться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170526
					]
				},
				{
					"id": 30170513,
					"content": "Вот теперь я тебе верю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170514
					]
				},
				{
					"id": 30170506,
					"content": "Дотторе тебя случайно не перепрограммировал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170507
					]
				},
				{
					"id": 30170503,
					"content": "Катерина!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170504
					]
				}
			]
		},
		{
			"id": 301706,
			"completionStepIds": [
				301706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301706",
							"2"
						],
						"stepId": 301706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хайпасия",
					"Нахида"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170601,
					"content": "#{NICKNAME}? Это же {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170602
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170602,
					"content": "Ой... Хайпасия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170603,
						30170604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170603,
					"content": "Давно не виделись!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170605
					]
				},
				{
					"id": 30170605,
					"content": "О великие Архонты, как же я рада вас видеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170606
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170606,
					"content": "Кто это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170607
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170607,
					"content": "Хайпасия - учёная из Академии. Мы с ней в лесу Авидья познакомились. В последнюю нашу встречу она была в этой, как её... «Сатьяваде», да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170608,
					"content": "О, понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170609
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170609,
					"content": "Ага! Мы с ними хорошие друзья. Вы, кстати, как раз вовремя. Со мной в этом месте ещё никто и словом не обмолвился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170610
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170610,
					"content": "Всегда бы нас так тепло встречали! Кстати, неужели ты перестала практиковать, раз лес Авидья покинула?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170611,
					"content": "Нет, погоди! Неужто ты уже закончила и достигла Парипурны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170612,
					"content": "Хи-хи... а ты как думаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170613
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170613,
					"content": "Мне действительно удалось войти в контакт с божеством в своём сознании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170614
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170614,
					"content": "М?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170615
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170615,
					"content": "Что? Правда?! Поздравляем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170616,
						30170617
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170616,
					"content": "#Я так рад{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170618
					]
				},
				{
					"id": 30170618,
					"content": "Ха-ха! Мне очень приятно поделиться с вами радостью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170619
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170619,
					"content": "Когда я наладила контакт с божеством... ох, этих невероятных чувств просто не передать словами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170620
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170620,
					"content": "Ничего себе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170651,
						30170652
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170651,
					"content": "Мы здесь, чтобы найти Тигнари.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170621
					]
				},
				{
					"id": 30170621,
					"content": "Вот как... Ой, погодите секундочку. Я же забыла о своём обещании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170622
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170622,
					"content": "#Помнишь? Я обещала помочь тебе разобраться в том, что ты видел{F#а} у Ирминсуля, как только я обрету сокровенные знания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170623
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170623,
					"content": "А ведь я не только мудрость обрела, но ещё и с божествами теперь могу связаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170624
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170624,
					"content": "Н-неужели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170625
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170625,
					"content": "Это возможно, Нахида?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170626
					]
				},
				{
					"id": 30170626,
					"content": "Никогда о таком не слышала. Но если ты хочешь попробовать, я сделаю всё возможное, чтобы защитить твоё сознание в процессе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170627
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170627,
					"content": "Секунду, у меня тут с собой есть духовный борнеол. Без него ритуал не провести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170628
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170628,
					"content": "Опять эти благовония?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170629
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170629,
					"content": "Так-с, а теперь возьми меня за руки. Я помогу вам наладить духовную связь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170630
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170630,
					"content": "Ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170631
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170631,
					"content": "Готовы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170632
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170632,
					"content": "Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170633,
						30170634
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170633,
					"content": "...вовсе не сознание великой властительницы Руккхадеваты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170635
					]
				},
				{
					"id": 30170635,
					"content": "Неужели это прошлое Скарамуччи?! Всё совпадает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170636
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170636,
					"content": "Но как это связано с божественным сознанием, о котором говорила Хайпасия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170637
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170637,
					"content": "Вы видели?! Чувствовали?! Великое божество... благородная воля... и возвышенные чувства!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170638
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170638,
					"content": "Ох... как жаль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170639
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170639,
					"content": "...как жаль, что в моей груди бьётся всего лишь ничтожное человеческое сердце. Простишь ли ты меня, великое божество? Есть ли у меня шанс искупить своё существование...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170640
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170640,
					"content": "Видите? Боюсь, что это не Парипурна, а...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170641
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170641,
					"content": "Очнись, Хайпасия!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170642
					]
				},
				{
					"id": 30170642,
					"content": "А...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170643
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170643,
					"content": "#Почему... почему ты так жесток{F#а} со мной? Почему все меня избегают?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170644
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170644,
					"content": "Я же обрела божественную мудрость! Они должны восхвалять меня! Я та, кто во тьме нашла ярчайший свет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170645
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170645,
					"content": "Хайпасия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170646
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170646,
					"content": "Ну мне казалось, что именно так всё должно быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170647
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170647,
					"content": "Постойте-ка!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170648
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170648,
					"content": "Неужели... я на грани безумия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170649
					],
					"speakerTitle": "Хайпасия"
				},
				{
					"id": 30170649,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170650
					]
				},
				{
					"id": 30170650,
					"content": "Стоп! Что-то здесь не так!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30170634,
					"content": "...но и не сознание царя Дешрета.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170635
					]
				},
				{
					"id": 30170652,
					"content": "У нас ещё остались дела. Поговорим потом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170621
					]
				},
				{
					"id": 30170617,
					"content": "Хайпасия, ты молодец.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170618
					]
				},
				{
					"id": 30170604,
					"content": "Вот уж не думали встретить тебя здесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170605
					]
				}
			]
		},
		{
			"id": 301707,
			"completionStepIds": [
				301707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301707",
							"2"
						],
						"stepId": 301707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тигнари"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170701,
					"content": "Похоже, мы окончательно оторвались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170702,
						30170703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170702,
					"content": "!!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170704
					]
				},
				{
					"id": 30170704,
					"content": "#Ты в порядке, Нахида? Постой! Что-то не так... {NICKNAME}, ты вернул{F#ась}{M#ся}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170705,
					"content": "#А? {NICKNAME} снова с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170706,
						30170707
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170706,
					"content": "Да, это я...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170708
					]
				},
				{
					"id": 30170708,
					"content": "Нахида на время перешла в твоё сознание. Видимо, она успела перескочить туда, пока Катерину не уничтожили. Ещё бы чуть-чуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170709,
					"content": "Наши крики услышал Тигнари и прибежал на помощь. Он помог нам справиться с наёмниками. Затем мы побежали и так оказались здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170710,
						30170711
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170710,
					"content": "Это был не просто перенос разума...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170712
					]
				},
				{
					"id": 30170712,
					"content": "#А? Поменялись? То есть, ты переместил{F#ась}{M#ся} в тело Нахиды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170713
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170713,
					"content": "А что с Нахидой? Где же сейчас её сознание?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170714,
					"content": "Подумать только... Сознание можно перемещать в другое тело. Никогда бы не поверил, если бы сам не увидел. Обычные люди на такое точно не способны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170715
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170715,
					"content": "#Кстати, {NICKNAME}. Пока мы бежали, Нахида попросила передать тебе кое-что. Она сказала:...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170716
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170716,
					"content": "...«Дотторе нашёл способ, как поймать моё сознание в ловушку. Больше я не смогу вас сопровождать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170717
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170717,
					"content": "...Однако в тёмную ночь множество звёзд может распознать иллюзорность и обман даже без луны».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170718
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170718,
					"content": "О-о-ох! Значит, Нахиду заточили в Храме Сурастаны! Дела хуже некуда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170719
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170719,
					"content": "И это всё её послание? Какое-то оно не очень понятное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170720,
						30170721
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170720,
					"content": "У нас свой понятный только нам язык...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170722
					]
				},
				{
					"id": 30170722,
					"content": "О-о-о, понятно. Раз ему удалось захватить сознание Нахиды, теперь он знает обо всех её мыслях. Осторожность в формулировках не помешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170723
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170723,
					"content": "«Однако в тёмную ночь множество звёзд может распознать иллюзорность и обман даже без луны»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170724
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170724,
					"content": "Паймон помнит, что «луна», «иллюзорность» и «обман» связаны с алхимическим гаданием на Сабзеруз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170725
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170725,
					"content": "А «множество звёзд» похоже на очередную метафору Нахиды. Паймон думает, это связано с Сетарией...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170726,
						30170727,
						30170728
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170726,
					"content": "«Луна» - это Нахида.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170729
					]
				},
				{
					"id": 30170729,
					"content": "А-а-а! Значит, Нахида имела в виду, что нужно отправляться за помощью в пустыню, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170730
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170730,
					"content": "Но вот справимся ли мы без Нахиды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170731
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170731,
					"content": "#Паймон, ты говорила о Храме Сурастаны, да? Та «Нахида», о которой вы говорите и которая вселялась в {NICKNAME}... это Дендро Архонт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170732
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170732,
					"content": "Э... да, ты угадал. Но нам пока трудно объяснить тебе всё. Ситуация довольно сложная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170733
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170733,
					"content": "Ничего. Пытливый ум учёного не требует немедленных ответов. А по поводу ситуации... да, я заметил, что всё непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170734
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170734,
					"content": "За это время я узнал вас. Да и Дендро Архонт на вашей стороне. Так что... я вам верю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170735
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170735,
					"content": "Угу! Спасибо, Тигнари. Кстати, мы же тебя спросить хотели. Ты что-нибудь знаешь о проекте, над которым работают мудрецы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170736
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170736,
					"content": "Ах, это... Меня приглашали принять в нём участие. Однако мудрецы упорно отказывались раскрывать мне его суть. Конечно же, я отказался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170737
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170737,
					"content": "Всё, что я знаю, так это то, что проект посвящён возрождению Ирминсуля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170738,
						30170739
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170738,
					"content": "Думаю, мне известна суть проекта.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170740
					]
				},
				{
					"id": 30170740,
					"content": "#Хм? Ты что-то увидел{F#а}, пока вы с Нахидой обменивались сознаниями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170741
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170741,
					"content": "Академия помогает Скарамучче стать божеством.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170742
					]
				},
				{
					"id": 30170742,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170743
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170743,
					"content": "У тебя есть доказательства?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170744,
						30170745
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170744,
					"content": "#Я видел{F#а}, как зарождается божество.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170746
					]
				},
				{
					"id": 30170746,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170747
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170747,
					"content": "Вы рассказываете о видениях, которые возникли, пока вы с Нахидой обменивались сознаниями...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30170748
					]
				},
				{
					"id": 30170748,
					"content": "Вот оно что... Это объясняет, почему симптомы сумасшествия Хайпасии отличались от симптомов других учёных. Она вошла в контакт с рождающимся божеством.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170749
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170749,
					"content": "Тигнари, ты покинул лес Авидья из-за Хайпасии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170750
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170750,
					"content": "Верно. Я заметил её странное поведение, однако эти симптомы были несколько необычными. Поэтому я и отвёл Хайпасию в Пардис Дхяй, чтобы найти способ помочь ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170751
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170751,
					"content": "Если бы не это, её бы уже наверняка сослали в деревню Аару за нарушение дисциплины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170752
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170752,
					"content": "Теперь, когда вы упомянули об этом, я осознал, что Академия всегда недолюбливала малую властительницу Кусанали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170753
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170753,
					"content": "Но я даже и не предполагал, что они дойдут до того, чтобы создавать новое божество. Отказаться от сотрудничества с ними было правильным решением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170754,
						30170755
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170754,
					"content": "В этом замешаны Фатуи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170756
					]
				},
				{
					"id": 30170756,
					"content": "«Доктор» и «Сказитель»... Оба Предвестника пожаловали в Сумеру. Ни к чему хорошему это не приведёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170757
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170757,
					"content": "Однако, судя по твоим словам, проект ещё не завершён. У нас ещё есть шанс их остановить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170758
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170758,
					"content": "Какова же связь между сотворением нового божества и возрождением Ирминсуля?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170759
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170759,
					"content": "Да уж. Мы до сих пор точно не знаем, что же задумали эти мудрецы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170760,
						30170761
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170760,
					"content": "Нам нужно в пустыню.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170762
					]
				},
				{
					"id": 30170762,
					"content": "Да. Мы уже обсудили всё, что нам известно. Значит, пора действовать. А ты, Тигнари, что планируешь делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170763
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170763,
					"content": "Пока что я побуду здесь. Нужно проследить за Хайпасией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170764
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170764,
					"content": "Если вы направляетесь в пустыню, можете сперва добраться до Караван-рибата. Это самый короткий путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170765
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170765,
					"content": "Если вам понадобится моя помощь, я буду здесь. Да не оставит вас мудрость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170766
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 30170766,
					"content": "Хорошо! Надеемся, что Хайпасия поправится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30170761,
					"content": "Нужно помешать им во что бы то ни стало.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170762
					]
				},
				{
					"id": 30170755,
					"content": "Их могли надоумить Фатуи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170756
					]
				},
				{
					"id": 30170745,
