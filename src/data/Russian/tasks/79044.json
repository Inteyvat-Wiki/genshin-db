			},
			"dialogs": [
				{
					"id": 790440101,
					"content": "О путешественники, наконец-то после долгих скитаний вы пришли сюда, следуя подсказкам судьбы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440102
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440102,
					"content": "Должно быть, вы тоже ищете случая, о котором даже не мечтали, удивительного путешествия, выходящего за рамки воображения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440103
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440103,
					"content": "Сейчас перед нами открывается уникальная возможность, позволяющая помочь друг другу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440104
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440104,
					"content": "Присоединяйтесь к нашей новой постановке «Три дня фантазий Дайи» и получите уникальный и невероятный опыт игры на сцене!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440105
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440105,
					"content": "Искупайтесь в море... Изгоните призраков из старинного замка... Вырвитесь из оков земного притяжения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440106
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440106,
					"content": "Если вас это заинтересовало, прошепчите пароль: «Хотим очутиться в мире грёз», и да начнётся ваше путешествие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440107
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440107,
					"content": "Ух ты, это было вдохновляюще! Хотя Паймон так и не поняла, о чём именно речь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440108,
					"content": "Путешествие? Постановка? Сцена? И что там ещё... море моры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440109,
						790440110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440109,
					"content": "Возможно, это новый аттракцион.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				},
				{
					"id": 790440111,
					"content": "Ух ты! Вот теперь Паймон поняла! Мы уже слышали о таком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440112,
					"content": "Так это Дайя сейчас говорила? Наверное, она режиссёр спектакля?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440113,
					"content": "Если мы вызовемся, мы станем персонажами пьес?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440114,
						790440115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440114,
					"content": "Паймон заинтересовалась?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440116,
					"content": "Звучит очень интересно! Паймон хочет увидеть море моры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440117,
					"content": "Эм... нет, не то! Паймон хочет узнать, что есть такого интересного в этом аттракционе, раз он занимает особое место в Мираже Велуриям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440118,
					"content": "Давай вместе скажем этот пароль!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440119,
					"content": "Хотим очутиться в мире грёз!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440120
					]
				},
				{
					"id": 790440120,
					"content": "Хотим очутиться в мире грёз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440121,
					"content": "О, неужели вот так сразу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440122
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440122,
					"content": "Кхе-кхе... Прекрасно! Вы зарегистрировались, «Три дня фантазий Дайи» вот-вот начнутся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440123
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440123,
					"content": "«И вновь оживает древняя легенда, и снова таинственные подсказки указывают путь к несметным сокровищам. Благородные пираты, до блеска наточив оружие, поднимают паруса...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440124
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440124,
					"content": "«Беда пришла в парящий среди облаков город, и сотворившему это Чудо-архитектору нужно поторопиться, чтобы не дать городу упасть...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440125
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440125,
					"content": "«Чтобы спасти пропавших товарищей, одинокий Гидро эйдолон собирается ворваться в замок, где они заключены в темницу, и найти способ разрушить проклятие...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440126
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440126,
					"content": "Три разных постановки - сыграйте в той, что вам по душе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440127
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440127,
					"content": "Ищите подобные громкоговорители и следуйте их указаниям, чтобы попасть в мир грёз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440128
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440128,
					"content": "#Паймон поняла! {NICKNAME}, давай найдём следующий такой громкоговоритель и посмотрим, что будет дальше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440115,
					"content": "#Может, станем {F#актрисами}{M#актёрами}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440110,
					"content": "Например, театр, в котором играют сами посетители.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				}
			]
		},
		{
			"id": 7904406,
			"completionStepIds": [
				7904405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904405",
							"2"
						],
						"stepId": 7904405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790440601,
					"content": "О! Откуда здесь столько Капелек... они собрались вокруг гигантского механизма?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440602,
					"content": "Паймон ничего не понимает. Что это ещё за механизм? И где Дайя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440603,
					"content": "Добро пожаловать за кулисы «Трёх дней фантазий»! Должно быть, вы сейчас недоумеваете, что означает увиденное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440604
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440604,
					"content": "Сейчас мы вам всё покажем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440605
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440605,
					"content": "Хватит спать, «Бездельник»! Позиция один, действие два!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440606
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440606,
					"content": "«О путешественники, наконец-то после долгих скитаний вы пришли сюда, следуя подсказкам судьбы!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440607
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440607,
					"content": "Капелька управляет громкоговорителем и... воспроизводит запись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440608,
					"content": "Звучит знакомо... Кажется, Паймон это уже где-то слышала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440609,
						790440610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440609,
					"content": "Это объявление, благодаря которому мы впервые узнали об этом аттракционе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440611
					]
				},
				{
					"id": 790440611,
					"content": "«Король усердия», твоя очередь: позиция три, действие семь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440612
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440612,
					"content": "«Старпом выходит поприветствовать новых членов команды. Вы видите, что его тело пестрит укрывающими раны повязками, а одежда изорвана. Очевидно, совсем недавно он побывал в ожесточённом сражении...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440613
					],
					"speakerTitle": "Голос из громкоговорителя"
				},
				{
					"id": 790440613,
					"content": "Паймон вспомнила! Это же слова рассказчика в постановке «\"Морион\" и морское чудовище»! Момент, когда мы только что встретились со старпомом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440614,
					"content": "Так вот как проигрывалась та запись, которую мы тогда услышали... И как всё своевременно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440615,
					"content": "«Сорвиголова», «Морион» скоро доберётся до места у сокровищницы. Пора устанавливать все декорации и механизмы... Только ничего не перепутай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440616
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440616,
					"content": "Похоже, Капелька каким-то образом... управляет этим аппаратом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440617,
						790440618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440617,
					"content": "Мониторинг, трансляция и управление механизмами...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440619
					]
				},
				{
					"id": 790440619,
					"content": "Верно. Предназначение этого гигантского устройства - управление всеми требуемыми для постановки функциями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440620
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440620,
					"content": "Прилежные Гидро эйдолоны постоянно наблюдают за ходом представления, и когда посетители добираются до определённых точек, проигрывается закадровая реплика пьесы и запускаются соответствующие механизмы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440621
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440621,
					"content": "Посетителям нужно только тщательно следовать установленному порядку, и они смогут насладиться всеми постановками «Трёх дней фантазий»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440622
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440622,
					"content": "Конечно, если посетитель вдруг выпрыгнет на полдороге или сделает ещё что-нибудь неожиданное, то полного впечатления от постановок не получит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440623
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440623,
					"content": "Пока у нас недостаточно персонала, чтобы справляться с такими ситуациями... Но мы верим, что посетители не будут вести себя подобным образом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440624
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440624,
					"content": "Как круто! Мы так увлеклись игрой, что даже и не заметили, что за кулисами есть ещё столько всего!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440625
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440625,
					"content": "На пути у нас было столько механизмов, управлять всем этим - дело совсем не лёгкое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440626,
						790440627
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440626,
					"content": "Здесь и правда всё так продуманно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440628
					]
				},
				{
					"id": 790440628,
					"content": "Ммм... голос, который говорит сейчас с нами, - это Дайя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440629
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440629,
					"content": "Ты управляешь ходом представления «Трёх дней фантазий» с помощью этих Гидро эйдолонов? А почему ты не можешь рассказать нам всё это лично?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440630
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440630,
					"content": "У Паймон к тебе столько вопросов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440631
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440631,
					"content": "Ваши предположения верны, но не во всём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440632
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440632,
					"content": "Вы видите в этой радиорубке контрольное устройство, «Режиссёра», «Псевдодраматурга», «Бездельника», «Короля усердия» и «Сорвиголову»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440633
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440633,
					"content": "Есть и другие, невидимые и неслышные, но так же следящие за ходом представления Гидро эйдолоны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440634
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440634,
					"content": "Все мы вместе - это и есть «Дайя», система, что создаёт и контролирует ход постановки. Это не какой-то конкретный человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440635
					],
					"speakerTitle": "Информационный громкоговоритель"
				},
				{
					"id": 790440635,
					"content": "Дайя - это не человек... это система?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440636
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440636,
					"content": "Погодите-погодите, это за гранью понимания Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440637
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440637,
					"content": "Паймон знает, что Капельки очень умные, но неужели одни только Капельки могут создать такую сложную... систему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440638,
						790440639
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440638,
					"content": "Должно быть, за кулисами есть и разработчик.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440640
					]
				},
				{
					"id": 790440640,
					"content": "Поначалу всё так и было, ваше удивление вполне ожидаемо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440641
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440641,
					"content": "Это долгая история. «Три дня фантазий Дайи» появились благодаря режиссёру-энтузиасту Зосимосу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440642
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440642,
					"content": "Пока он находился в Мираже Велуриям, он был полностью сосредоточен на интересных пьесах, позабыв про весь остальной репертуар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440643
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440643,
					"content": "Проведя какое-то время вместе с Гидро эйдолонами, он обнаружил, что они умны и эмоциональны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440644
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440644,
					"content": "Гидро эйдолонам очень понравились его спектакли. Они захотели увидеть ещё больше представлений и подарить такие же яркие впечатления другим посетителям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440645
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440645,
					"content": "И тогда режиссёру Зосимосу пришла в голову идея: а не поставить ли Гидро эйдолонам свою пьесу или даже придумать её?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440646
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440646,
					"content": "Как смело! Напоминает... обучение группы детей режиссёрскому мастерству!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440647
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440647,
					"content": "Это действительно было нелегко, но, к счастью, общими усилиями удалось преодолеть все трудности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440648
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440648,
					"content": "Зосимос приложил немало усилий, чтобы обучить нескольких увлёкшихся театром Гидро эйдолонов пониманию всех ключевых моментов создания постановки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440649
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440649,
					"content": "Методом проб и ошибок он написал множество примеров пьес и подробных пояснений к ним на понятном Гидро эйдолонам языке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440650
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440650,
					"content": "С помощью Идии он создал этот контроллер и в различных местах возвёл связанные с ним механизмы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440651
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440651,
					"content": "Помимо реплик пьес, Зосимос также записал произношение большинства часто встречающихся слов, чтобы мы могли составлять правильные фразы для общения с посетителями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440652
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440652,
					"content": "Потренировавшись какое-то время, мы наконец сумели создать три образцовые пьесы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440653
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440653,
					"content": "Это «\"Морион\" и морское чудовище», «Проклятие окаменения» и «Спасение Небесного града»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440654
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440654,
					"content": "Получается... Зосимос всё подготовил для постановки «Трёх дней фантазий Дайи» и оставил сценарии с инструкциями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440655
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440655,
					"content": "Во время игры мы даже и не подозревали, что ход представления контролируется Капельками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440656
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440656,
					"content": "Спасибо за комплимент! Ваша игра окупила наши старания и подтвердила многие наши идеи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440657
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440657,
					"content": "Поэтому мы хотели бы отблагодарить вас и показать процесс создания постановок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440658,
						790440659
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440658,
					"content": "Не стоит благодарности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440660
					]
				},
				{
					"id": 790440660,
					"content": "О да! Мы побывали на невероятном аттракционе и очень расширили свой кругозор. Большое тебе спасибо, Дайя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440661
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440661,
					"content": "Аха-ха! Теперь мы будем двигаться к следующей цели - к созданию пьесы по нашему собственному сценарию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440662
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440662,
					"content": "Для этого мы должны ещё лучше разобраться в театральном искусстве и собрать побольше материала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440663
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440663,
					"content": "Среди нас есть «Псевдодраматург», который слушает истории посетителей и улучшает наши идеи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440664
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440664,
					"content": "Даже если не будет подходящих посетителей, «Псевдодраматург» сможет поспрашивать других Гидро эйдолонов об их опыте общения с посетителями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440665
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440665,
					"content": "Так вот оно что! Значит, рассказывая истории «Псевдодраматургу», мы помогаем вам создавать новые пьесы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440666
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440666,
					"content": "Верно! Если у вас будет время, поболтайте с «Псевдодраматургом»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440667
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440667,
					"content": "А ещё продолжайте веселиться в Мираже Велуриям и побольше общайтесь с другими Гидро эйдолонами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440668
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440668,
					"content": "#Не волнуйтесь, {NICKNAME} и Паймон любят это место и точно смогут дать вам много материала для спектаклей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440669
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440669,
					"content": "Эмм... Ещё один вопрос... Паймон уже давно это интересует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440670
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440670,
					"content": "Что означают «три дня» в названии спектакля?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440671
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440671,
					"content": "Неужели Зосимос написал каждую пьесу за три дня? Или у него ушло всего три дня на все пьесы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440672,
						790440673
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440672,
					"content": "Ха-ха, я могу ответить на этот вопрос!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440674
					]
				},
				{
					"id": 790440674,
					"content": "«Вчера», «Сегодня» и «Завтра»? Похоже, в этом что-то есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440675
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440675,
					"content": "Это показывает, что Зосимос... нет, что все члены «Дайи» усердно работают, изо дня в день посвящая себя творчеству!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440676
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440676,
					"content": "Какая замечательная идея! Но, к сожалению, это преувеличение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440677
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440677,
					"content": "На самом деле «три дня»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440678
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440678,
					"content": "Это «Завтра, когда у нас будет больше времени», «Завтра, когда всё станет лучше» и «Завтра, когда придёт конец всему, если мы не справимся».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440679
					],
					"speakerTitle": "Дайя"
				},
				{
					"id": 790440679,
					"content": "Что? Как же так!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790440673,
					"content": "Это «Вчера», «Сегодня» и «Завтра»!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440674
					]
				},
				{
					"id": 790440659,
					"content": "Нам тоже очень понравилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440660
					]
				},
				{
					"id": 790440639,
					"content": "И ещё ведь нужен тот, кто будет управлять сценарием, верно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440640
					]
				},
				{
					"id": 790440627,
					"content": "Как же всё точно подобрано.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440628
					]
				},
				{
					"id": 790440618,
					"content": "Функций вполне достаточно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440619
					]
				},
				{
					"id": 790440610,
					"content": "Из громкоговорителя звучала эта запись.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440611
					]
				}
			]
		},
		{
			"id": 7904407,
			"completionStepIds": [
				7904406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
