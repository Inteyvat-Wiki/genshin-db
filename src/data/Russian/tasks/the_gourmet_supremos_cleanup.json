			"dialogs": [
				{
					"id": 738050101,
					"content": "Путешественник, стой! У меня для тебя письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050102
					],
					"speakerTitle": "Марьям"
				},
				{
					"id": 738050102,
					"content": "Письмо? Для меня?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050103
					]
				},
				{
					"id": 738050103,
					"content": "Его оставил Сюй Дун из Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050104,
						738050105
					],
					"speakerTitle": "Марьям"
				},
				{
					"id": 738050104,
					"content": "Где он?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050106
					]
				},
				{
					"id": 738050106,
					"content": "Этого уж я не знаю. Некоторое время назад он примчался и отдал мне это письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050107
					],
					"speakerTitle": "Марьям"
				},
				{
					"id": 738050107,
					"content": "Что же он сказал... Он сказал непременно передать тебе письмо и даже заплатил мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050108
					],
					"speakerTitle": "Марьям"
				},
				{
					"id": 738050108,
					"content": "Сюй Дун... примчался? Почему же он так торопился?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 738050109,
					"content": "Неужели... Это дело рук того негодяя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050110,
						738050111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 738050110,
					"content": "Сначала прочитаю письмо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050112
					]
				},
				{
					"id": 738050112,
					"content": "Ну ладно... Тогда сначала прочтём письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 738050111,
					"content": "Возможно, в письме будет объяснение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050112
					]
				},
				{
					"id": 738050105,
					"content": "Почему же он оставил мне письмо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050106
					]
				}
			]
		}
	]
