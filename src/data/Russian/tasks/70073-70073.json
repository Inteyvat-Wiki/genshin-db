			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мардава"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730101,
					"content": "Я хочу сразиться с этим здоровяком.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730102
					]
				},
				{
					"id": 700730102,
					"content": "Благословенны будьте! Даже моему владыке необходимо поддерживать божественное тело в тонусе, чтобы упавшие кусочки стали нежными и богатыми на вкус. Не сдерживайтесь! Сражайтесь в полную силу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мардава"
				}
			]
		},
		{
			"id": 7007302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мардава"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730201,
					"content": "О владыка Махавасу{RUBY#[S]Наследник Владыки, дарующего мир}дева Ява, да проникнет твоя Дживас{RUBY#[D]жизненная сила}тикая в основание этой земли, да превзойдёт твой вкус всех божеств в мире...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мардава"
				}
			]
		},
		{
			"id": 7007303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мардава"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730301,
					"content": "Что это такое?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730302
					]
				},
				{
					"id": 700730302,
					"content": "Прекрасный вопрос! Это отпрыск почитаемого нами божества {RUBY#[D]Бифронс}жизни, гриба истинного вкуса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730303
					],
					"speakerTitle": "Мардава"
				},
				{
					"id": 700730303,
					"content": "Нагахвая всегда призывает Владыку зелени и Владыку цвет{RUBY#[S]Пушпаватика}очного сада. Макани Хаган вечно молится Владыке песков. Спроси у них, кто из трёх великих божеств вкуснее моего владыки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730304
					],
					"speakerTitle": "Мардава"
				},
				{
					"id": 700730304,
					"content": "Знай, что непричинение вреда и есть праведное деяние. Если бы не божественное тело нашего владыки, нам пришлось бы отнимать жизни у птиц, зверей и растений, чтобы выжить... О, как прискорбно бы было!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730305
					],
					"speakerTitle": "Мардава"
				},
				{
					"id": 700730305,
					"content": "К счастью, когда Владычица пространства забрала меня с земли, джи{RUBY#[S]споры}ва моего владыки последовала за мной. Как видишь, они выросли и дарят нам божественный вкус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мардава"
				}
			]
		},
		{
			"id": 7007304,
