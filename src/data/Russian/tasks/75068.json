							-366.065,
							209.991,
							10035.07
						],
						"pointId": 10052
					}
				]
			},
			"dialogs": [
				{
					"id": 750680501,
					"content": "Вы лучше поторопитесь, а то будет поздно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680502
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750680502,
					"content": "Почему будет слишком поздно? Потому... потому что весь отряд искателей приключений уничтожен. Это гигантское, чёрное чудовище... Они все...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680503
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750680503,
					"content": "Они попросили меня защитить эвакуированных и, по крайней мере, проследить, чтобы они покинули город. Спасательная команда из клана Цветочного Пера уже в пути...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680504
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750680504,
					"content": "Я должен уничтожить этих злобных монстров, чтобы выжившие смогли вернуться на землю и вновь увидеть свет... Но... Почему я снова здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680505
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750680505,
					"content": "Этот звук... А-а-а, он становится всё громче и громче. Я... Я должен вернуться к водопаду. Да, я должен... вернуться к водопаду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680506
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750680506,
					"content": "#{M#Храбрый воин}{F#Храбрая воительница}, вам тоже следует поскорее уходить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кенин"
				}
			]
		}
	]
}