					"Китибоси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726750301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750302
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750302,
					"content": "Не золотая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750303
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750303,
					"content": "Что? Ядро не золотое?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750304,
						726750305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750304,
					"content": "Ну, раз вы так говорите...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				},
				{
					"id": 726750306,
					"content": "#Если подумать, то Паймон никогда этого не замечала, хотя ты раньше лови{F#ла}{M#л} кучу кристальных бабочек...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750307,
					"content": "Так вот, что называют «разочарованием»? То, что происходит, когда ты вырастаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750308,
					"content": "Кажется, тебе тоже нужны тренировки, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750309
					]
				},
				{
					"id": 726750309,
					"content": "Давай, Белый Помпон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750310
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750310,
					"content": "Никаких «давай, Паймон»! Тренироваться нужно тебе, Китибоси.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750311,
					"content": "Но это всё равно разочаровывает... Почему ядро Гео кристальной бабочки не золотое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750312,
					"content": "Да! Золотая бабочка почему не золотая?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750313,
						726750314
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750313,
					"content": "Может, у них просто такое строение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750315,
					"content": "Ну что ж, в любом случае нам не нужно отклоняться от плана. Пора показать Китибоси «Алькор»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750314,
					"content": "Я правда не знаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750305,
					"content": "Тут уж ничего не поделаешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				}
			]
		},
		{
			"id": 7267504,
			"completionStepIds": [
				7267504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267504",
							"2"
						],
						"stepId": 7267504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726750401,
					"content": "Смотри, это «Алькор»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750402,
					"content": "Здорово! Сколько воды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750403
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750403,
					"content": "Какой большой! Большой! На воде!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750404
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750404,
					"content": "Он большой и тяжёлый. Почему не тонет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750405
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750405,
					"content": "Потому что «Алькор» - это корабль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750406,
					"content": "Но глиняная лодка потонула. Иорой рассказывал историю. Про зайца, бакэ-дануки и глиняную лодку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750407
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750407,
					"content": "Ну... «Алькор» не из глины, поэтому не тонет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750408,
					"content": "Раз не из глины, то не тонет? Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750409
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750409,
					"content": "Ты говоришь всё лучше, Китибоси. Но как же тебе ответить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750410,
					"content": "#Точно! {NICKNAME}, почему корабли не тонут в воде?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750411,
						726750414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750411,
					"content": "Корабли сделаны из дерева. Да здравствует мощь Дендро!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750412
					]
				},
				{
					"id": 726750412,
					"content": "Что? Дендро на такое способно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750413,
					"content": "Хм... Тогда почему хиличурлы с деревянными щитами не плавают?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750416,
					"content": "Мм. Не понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750417
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750417,
					"content": "Ничего, Китибоси! Когда ты подрастёшь, ты будешь таким же умным, как Паймон! Тогда ты поймёшь все эти вещи: почему корабли плавают, почему на Драконьем хребте идёт снег... Ты всё будешь знать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750418,
						726750420,
						726750421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750418,
					"content": "Кажется, ты тоже не знаешь, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750419
					]
				},
				{
					"id": 726750419,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750422,
					"content": "Ага! И ты можешь отсюда увидеть «Алькор». Давай сфотографируем Китибоси!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750423,
					"content": "Фото! Рисунок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750424
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750424,
					"content": "Да, именно! А сейчас замри!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750420,
					"content": "Ничего, если ты этого пока не понимаешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750421,
					"content": "Не обязательно знать всё на свете.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750414,
					"content": "Корабли могут плавать до тех пор, пока их выталкивающая сила превышает силу тяжести.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750415
					]
				},
				{
					"id": 726750415,
					"content": "О, вот как! Паймон понимает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Паймон"
				}
			]
		},
