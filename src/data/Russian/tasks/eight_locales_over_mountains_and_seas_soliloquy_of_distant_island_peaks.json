					"Китибоси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722641401,
					"content": "Да! Тренироваться - это весело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641402,
						722641412
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722641402,
					"content": "Хорошо, что тебе весело.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641403
					]
				},
				{
					"id": 722641403,
					"content": "#Жёлтая Шёрстка {F#сильная}{M#сильный}. Бабах. И нет большого и круглого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641404
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722641404,
					"content": "Потому что я постоянно тренируюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641405
					]
				},
				{
					"id": 722641405,
					"content": "Мм! Китибоси хочет быть сильным, как Жёлтая Шёрстка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641406
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722641406,
					"content": "Тренироваться! Тренироваться! Стать сильным-пресильным!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641407
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722641407,
					"content": "А что ты будешь делать, когда станешь сильным, Китибоси?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641408
					]
				},
				{
					"id": 722641408,
					"content": "Отомщу Гёбу Кобан! Мха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641409
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722641409,
					"content": "И сделаю Иороя не камнем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641410
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722641410,
					"content": "Удачи тебе! А мы займёмся твоими тренировками.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641411
					]
				},
				{
					"id": 722641411,
					"content": "Мм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722641412,
					"content": "Что ж, мы идём веселиться. Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641413
					]
				},
				{
					"id": 722641413,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				}
			]
		},
		{
			"id": 7267501,
			"completionStepIds": [
				7267501
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267501",
							"2"
						],
						"stepId": 7267501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726750101,
					"content": "Не как Снежная гора. Не холодно. Снега нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750102
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750102,
					"content": "Это каменный лес Гуюнь! По легенде здесь Властелин Камня сразил этого, как его... многоголового водяного змея. Как там его звали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750103,
						726750104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750103,
					"content": "Архонт Вихрей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				},
				{
					"id": 726750105,
					"content": "Да, точно! Осиал, Архонт Вихрей! Вот тут его каменным копьём победил Властелин Камня и усмирил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750106,
					"content": "Ого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750107
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750107,
					"content": "Круто, да? Но мы тоже с ним сражались! На вершине Нефритового дворца Нин Гуан...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750108,
					"content": "Золотая кристальная бабочка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750109
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750109,
					"content": "Это ты бабочке так радуешься?! Паймон, вообще-то, рассказывает тебе историю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750110,
					"content": "Бабочка не похожа на те, что в Инадзуме...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750111
					]
				},
				{
					"id": 726750111,
					"content": "Наверное, он никогда не видел кристальных бабочек другого цвета, кроме фиолетового...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750112
					]
				},
				{
					"id": 726750112,
					"content": "#Ну... возможно. Ладно, ладно. Поймаешь ему бабочку, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750113,
						726750115,
						726750117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750113,
					"content": "А почему не ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750114
					]
				},
				{
					"id": 726750114,
					"content": "Потому что у тебя больше опыта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750118,
					"content": "Можно попробовать, но поймается только кристальное ядро.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750119
					]
				},
				{
					"id": 726750119,
					"content": "Ура! Здорово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750115,
					"content": "Но ты умеешь летать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750116
					]
				},
				{
					"id": 726750116,
					"content": "Да, но ты лучше ловишь бабочек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750117,
					"content": "Ладно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750118
					]
				},
				{
					"id": 726750104,
					"content": "Осиал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				}
			]
		},
