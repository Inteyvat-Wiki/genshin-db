					"Китибоси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726750601,
					"content": "А теперь давай отведём Китибоси на палубу «Алькора»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750602,
					"content": "Плохо. Если лодка потонет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750603
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750603,
					"content": "Не переживай, эта лодка не потонет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750604
					]
				},
				{
					"id": 726750604,
					"content": "Мы приплыли на этом корабле от самой Инадзумы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750605
					]
				},
				{
					"id": 726750605,
					"content": "Точно! А потом мы познакомились с тобой и Иороем. Успокойся, всё будет хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750606,
					"content": "Мм! Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750607
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750607,
					"content": "На капитана Бэй Доу можно положиться, как и на всю её команду. Поэтому в открытом море этот корабль - самое безопасное место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750608,
					"content": "Мм! Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				}
			]
		},
		{
			"id": 7267508,
			"completionStepIds": [
				7267508
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267508",
							"2"
						],
						"stepId": 7267508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726750801,
					"content": "Смотри! Красиво, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750802,
					"content": "Мм! Очень!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750803
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750803,
					"content": "Там так много гор. Что это за место?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750804
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750804,
					"content": "Хм... Ну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750805,
						726750806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750805,
					"content": "Это Инадзума.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				},
				{
					"id": 726750807,
					"content": "Верно! Вон там, наверное, гора Ёго. А под Ёго лес Тиндзю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750808
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750808,
					"content": "Далеко. Иорой за морем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750809
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750809,
					"content": "Да. Но мы будем с тобой всё путешествие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750810,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750811
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750811,
					"content": "Ну что ж, куда же дальше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750812
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750812,
					"content": "Здесь есть поблизости знакомое место, где мы могли бы вкусно поесть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750813,
						726750817
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750813,
					"content": "Ну конечно! У Паймон на уме одна еда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750814
					]
				},
				{
					"id": 726750814,
					"content": "Хорошая еда - хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750815
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750815,
					"content": "#О! Видишь, {NICKNAME}? Китибоси и то понимает! Есть хорошую еду по всему миру - это тоже хорошая тренировка, ясно тебе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750816
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750816,
					"content": "Китибоси скоро переплюнет тебя, если не поумнеешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750818
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750818,
					"content": "Ох, карабкаться на мачту было утомительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750819
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750819,
					"content": "Зачем Белый Помпон карабкается? Она же умеет летать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750820
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750820,
					"content": "Не будем вдаваться в подробности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750821
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750821,
					"content": "Ладно, сегодня останемся тут. Паймон должна хорошенько подумать о том, куда мы пойдем дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750822
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726750822,
					"content": "Мм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726750817,
					"content": "Неплохая идея. Кажется, я тоже хочу есть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750818
					]
				},
				{
					"id": 726750806,
					"content": "Это твоя родина.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				}
			]
		}
	]
}