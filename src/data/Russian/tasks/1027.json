			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Янь Фэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280601,
					"content": "Кто бы мог подумать, что мы тут застрянем. Непростая ситуация.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280602
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280602,
					"content": "Я знаю все законы, но обычно я занималась тем, чтобы посадить кого-то в тюрьму, а не вытащить его оттуда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280603
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280603,
					"content": "Да, я же заключила контракт с отцом «жить счастливо»... Значит, как минимум я не могу пасть духом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280604
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280604,
					"content": "Если смотреть с хорошей стороны, то я повидала новые места и встретилась со старыми друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280605,
					"content": "Мм, да, всё хорошо... Наверно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Янь Фэй"
				}
			]
		},
