			},
			"dialogs": [
				{
					"id": 10280701,
					"content": "Положение у нас печальное, выхода пока нет. Нужно быть готовыми провести здесь какое-то время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280702
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10280702,
					"content": "Хорошо, что запасов у нас вдоволь. И в нашей задиристой команде есть люди, способные сохранять спокойствие даже в сложных обстоятельствах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280703
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10280703,
					"content": "Позаботьтесь о себе, а я займусь остальным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Е Лань"
				}
			]
		}
