			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960701,
					"content": "Если хочешь поболтать по душам, сейчас самое время... Бард редко остаётся надолго в одном и том же месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960702,
						3960707,
						3960715,
						3960727,
						3960741
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960702,
					"content": "О Двалине...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960703
					]
				},
				{
					"id": 3960703,
					"content": "До самого конца Двалин помнил свой долг Хранителя четырёх ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960704
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960704,
					"content": "Поэтому я не хочу навязывать ему свои идеалы свободы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960705
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960705,
					"content": "Я надеюсь, что когда-нибудь он сам всё поймёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960706
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960706,
					"content": "Ещё до того, как я стал Архонтом, один мой друг объяснил мне, что такое свобода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960707,
					"content": "Об ордене Бездны...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960708
					]
				},
				{
					"id": 3960708,
					"content": "Хм? Что же выяснил Кэйа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960709
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960709,
					"content": "Так значит в том, что произошло с Двалином, виноват тайный лидер ордена Бездны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960710
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960710,
					"content": "Похоже, они хотели сделать его орудием войны... Я никогда не слышал, чтобы у ордена Бездны был какой-то лидер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960711,
						3960712
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960711,
					"content": "Значит, у них не заведено иметь лидера?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960713,
					"content": "Похоже на то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960714
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960714,
					"content": "Но как ему удалось так быстро стать главой ордена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960712,
					"content": "Значит, он появился совсем недавно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960715,
					"content": "О Синьоре...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960716
					]
				},
				{
					"id": 3960716,
					"content": "Эта фатуйка, которая украла твоё Сердце Бога... Она так быстро исчезла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960717
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960717,
					"content": "Она не хотела попасться на глаза рыцарям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960718
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960718,
					"content": "Если бы Ордо Фавониус поймал её за руку, отношения между двумя государствами стали бы очень напряжёнными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960719
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960719,
					"content": "Неужели после этого им хватит наглости притворятся союзниками Мондштадта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960720
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960720,
					"content": "Я считаю, всем семи нациям бы следовало объединиться против угрозы, которую несёт орден Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960721
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960721,
					"content": "Фатуи обладают самой сильной армией на всём континенте. Но увы, они использовали её для того, чтобы украсть Небесную лиру, получить божественные силы и направить Двалина против Ордо Фавониус...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960722
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960722,
					"content": "Кстати! Пока мы искали Небесную лиру, Дилюк кое-что сказал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960723
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960723,
					"content": "Он сказал, что Фатуи так смело разгуливают по Тейвату только благодаря Одиннадцати Предвестникам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960724
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960724,
					"content": "Да. Я уже говорил, что Крио Архонт наделила их безграничной властью и божественными силами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960725
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960725,
					"content": "Ледяная Императрица... Я не видел тебя уже 500 лет. Что же ты замышляешь? Каков твой план?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960726
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960726,
					"content": "Ответы на эти вопросы могут сильно повлиять на ваши поиски Семерых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960727,
					"content": "О божествах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960728
					]
				},
				{
					"id": 3960728,
					"content": "Как я уже говорил, все носители Глаза Бога могут вознестись на Селестию и стать Богами Истоков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960729
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960729,
					"content": "А Сердце Бога - это средоточие элементальной силы, символ могущества семерых Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960730
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960730,
					"content": "#Мне очень жаль, но я не знаю, кто из Архонтов похитил тво{M#ю сестру}{F#его брата}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960731
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960731,
					"content": "Будучи Архонтом, я и сам могу быть не чист на руку, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960732,
						3960734
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960732,
					"content": "#Ты совсем не похож на того, кто украл мо{M#ю сестру}{F#его брата}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960733
					]
				},
				{
					"id": 3960733,
					"content": "Образ бродяжки может быть всего лишь прикрытием. Мы не можем судить по внешности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960734
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960734,
					"content": "Мы знакомы уже довольно давно. Я доверяю тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960735
					]
				},
				{
					"id": 3960735,
					"content": "#Ха-ха-ха, мы и вправду пережили немало приключений вместе! Не хочешь стать одним из Хранителей четырёх ветров после того, как найдёшь сво{M#ю сестру}{F#его брата}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960736
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960736,
					"content": "Эм...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960737
					]
				},
				{
					"id": 3960737,
					"content": "#Ты чего, {NICKNAME}? Кажется, тебе не очень понравилась такая идея...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960738
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960738,
					"content": "Так, бродяжка! Если в обязанности Хранителя четырёх ветров входит есть бесплатную еду, то вы можете рассчитывать на меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960739
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3960739,
					"content": "Ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3960741,
					"content": "Ладно, нам пора идти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960742
					]
				},
				{
					"id": 3960742,
					"content": "Да, вам нужно поторапливаться в <color=#00E1FFFF>Ли Юэ</color> на Церемонию Сошествия, иначе придётся ждать целый год.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		}
	]
}