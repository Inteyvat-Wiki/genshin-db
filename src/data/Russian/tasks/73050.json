				"objectNames": [
					"Арарикан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500201,
					"content": "#Нара {NICKNAME} и Паймон! Не беспокойтесь, злодеи, виновники болезни ваны, больше не появлялись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "Арарикан"
				},
				{
					"id": 730500202,
					"content": "#Нара {NICKNAME}, Паймон, спасибо, что помогли Арарикану защитить Ванарану... Хочу подарить вам цветы, нара {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "Арарикан"
				},
				{
					"id": 730500203,
					"content": "Возьмите эти цветы, друзья мои!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арарикан"
				}
			]
		},
		{
			"id": 7305003,
			"completionStepIds": [
				7305003
