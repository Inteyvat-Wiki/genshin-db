			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Арапанду"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500101,
					"content": "#Нара {NICKNAME} и Паймон! Благодаря вам с машиной Варуны всё в полном порядке, как и с землёй Ашаван...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500102
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730500102,
					"content": "Все аранары вернулись в Ванарану на Праздник Утсава, словно птицы в свои гнёзда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500103
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730500103,
					"content": "Сердитый ливень сменился ласковым дождиком, я снова могу ухаживать за питомником и выращивать весёлый випариас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500104
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730500104,
					"content": "Из весёлого випариаса получаются весёлые фонари, украшающие весёлый Праздник Утсава...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500105
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730500105,
					"content": "#Нара {NICKNAME} и Паймон, питомник в полном в порядке, а Праздник Утсава удался на славу. Спасибо за помощь в исцелении машины Варуны и возвращении Аранакулы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500106
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730500106,
					"content": "Вот и славно! Хи-хи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730500107,
					"content": "Кстати, меня занимает один вопрос...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500108
					]
				},
				{
					"id": 730500108,
					"content": "Почему нара Варуна так зовётся?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500109
					]
				},
				{
					"id": 730500109,
					"content": "#О, это потому, что именно нара помог{F#ла} нам исцелить машину Варуны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500110
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730500110,
					"content": "#Тогда как звучит {M#её}{F#его} настоящее имя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500111
					]
				},
				{
					"id": 730500111,
					"content": "#Хм... Не знаю. Нара Варуна никогда не говорил{M#а}, как {M#её}{F#его} зовут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500112,
						730500113
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730500112,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				},
				{
					"id": 730500114,
					"content": "#Нара {NICKNAME}, ты тоже здорово нам помог{F#ла}. Ты храбр{M#ый}{F#ая} нара, преодолевш{M#ий}{F#ая} немало трудностей. Славно, что мы вместе на Празднике Утсава.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500115
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730500115,
					"content": "#Нара {NICKNAME}, у нас есть для тебя кое-что.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500116
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730500116,
					"content": "Это благодарность от аранар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500117
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730500117,
					"content": "#Нара {NICKNAME} и Паймон наверняка это оценят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500118
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730500118,
					"content": "Этот цветочек от аранар специально для нары и Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500119
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730500119,
					"content": "#У меня тоже есть цветочек, не випариас, конечно, но специально для вас, нара {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500120
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730500120,
					"content": "#Нара {NICKNAME} и Паймон, спасибо за всё, что вы сделали для Ванараны. Аранары никогда не забывают друзей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730500113,
					"content": "Я понимаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				}
			]
		},
