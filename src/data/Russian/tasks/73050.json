			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Аранага"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500301,
					"content": "#Праздник Утсава... Звучит знакомо... Хм, белая-пребелая леталка... и золот{M#ой}{F#ая} нара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 730500302,
					"content": "Это друг-нара и друг друга-нара. Надеюсь, вы хорошенько повеселитесь на Празднике Утсава.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730500303,
					"content": "#Друг моего друга - мой друг! Золот{M#ой}{F#ая} нара и Белый Помпон - мои друзья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арагару"
				}
			]
		}
	]
