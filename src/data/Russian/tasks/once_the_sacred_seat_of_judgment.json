			},
			"dialogs": [
				{
					"id": 751890301,
					"content": "«Пойдёмте. Давайте посмотрим, где они спрятали разрешение...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890302
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890302,
					"content": "«Его оставили там... они вообще не собирались его прятать?..»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890303
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890303,
					"content": "«Судя по виду, это только оболочка...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890304
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890304,
					"content": "Ох, откуда здесь столько гончих Разрыва? Значит, разрешение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751890305,
					"content": "«Защиты на входе, должно быть, не было, что позволило им войти».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890306
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890306,
					"content": "Ч-что будем делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751890307,
					"content": "«Ничего. Нужно только запустить устройства для ремонта и очистки Зала заседаний».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890308
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890308,
					"content": "«Вон там...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Слуга источника"
				}
			]
		},
