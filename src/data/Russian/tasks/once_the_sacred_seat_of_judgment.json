			"dialogs": [
				{
					"id": 751890701,
					"content": "Обнаружена угроза со стороны теневого врага...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890702
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890702,
					"content": "Внутренняя защита... Активирован режим автоматического восстановления...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890703
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890703,
					"content": "Ого! Паймон и представить себе не могла, что в таком месте могут быть подобные механизмы... У монстров не было и шанса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751890704,
					"content": "«Это сооружение строилось, чтобы пережить саму вечность. Оно не только превосходно защищено, но даже способно восстанавливать себя...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890705
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890705,
					"content": "Он так блестит... Паймон хочет его потрогать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751890706,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890707,
					"content": "«Ха-ха, лучше не надо... Он не различает, кто друг, а кто враг... Он поглощает всё, к чему прикасается».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890708
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890708,
					"content": "«...Грубый и жестокий подход. Чего только ни напридумывали эти глупцы...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890709
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890709,
					"content": "Но мы можем воспользоваться им, чтобы снять щит, который закрывает разрешение, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890710,
						751890712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751890710,
					"content": "Стоит попробовать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890711
					]
				},
				{
					"id": 751890711,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890716,
					"content": "В общем... давайте придумаем, как заставить эту штуку подняться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751890712,
					"content": "Серьёзное предложение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890713
					]
				},
				{
					"id": 751890713,
					"content": "Р-р-р... Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890714
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890714,
					"content": "«Действительно. Неожиданная глубина от белой посланницы... Такая скрытая мудрость. Поразительно».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890715
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890715,
					"content": "...Паймон не понимает, чему ты поражаешься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
