						],
						"pointId": 72
					}
				]
			},
			"dialogs": [
				{
					"id": 751890601,
					"content": "«Вот он, гравировочный свет, активирующий чешую. Это и есть разрешение...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890602
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890602,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890603,
					"content": "Отсюда открывается вид... на весь Священный город!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751890604,
					"content": "«Действительно, отголоски славного и жалкого прошлого...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890605
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890605,
					"content": "Вр-р-р-рор... Р-р?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890606,
					"content": "«Хочешь узнать, чем закончился суд? Хе-хе...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890607
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890607,
					"content": "«Взывающие ко священному правосудию, разумеется, знают, что повелитель всего света и пламени впал в состояние ложной смерти, но когда лишь порой просыпающийся король явился во плоти...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890608
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890608,
					"content": "«Тринадцать владык и три принца, говорившие беспрестанно, поспешно отказались от своих слов, и суд, который превратился в фарс, разрешился сам собой...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890609
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890609,
					"content": "Ру-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890610
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890610,
					"content": "«Позднее... три принца были убиты в войне с людьми, десять владык погибли, когда обрушился Священный город Толлан, а один остался в Чичен Уктока...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890611
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890611,
					"content": "«Из всех владык в живых остался только один...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890612
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890612,
					"content": "«Хотя, не сомневаюсь, вряд ли ему захотелось бы существовать в такой форме...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890613
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890613,
					"content": "«Ладно... Продолжим продвигаться к Сердцу Священной горы. Там похоронено всё... в том числе и жажда завершить странствие».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890614
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890614,
					"content": "«Мой долг скоро будет исполнен... Избранник драконов, если бы ты знал, сколь прекрасным когда-то было это место...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890615
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890615,
					"content": "«Ступай, прикоснись к высеченному огнём свету... Заполучи разрешение отправиться к Сердцу Священной горы...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890616
					],
					"speakerTitle": "Слуга источника"
				},
				{
					"id": 751890616,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890617
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890617,
					"content": "Аванью... Опять ушёл! Паймон ещё даже не привыкла к этому имени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751890618,
					"content": "Зато у нас наконец-то есть разрешение войти в Сердце Священной горы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890619
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751890619,
					"content": "Р-р-рур...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890620
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890620,
					"content": "Свет на этой стороне... он исчез...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
