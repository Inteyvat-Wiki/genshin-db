			"trigger": {
				"objectNames": [
					"Тисэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722020101,
					"content": "Неужели Громовая птица... оставила меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020102,
						722020103
					],
					"speakerTitle": "Тисэ"
				},
				{
					"id": 722020102,
					"content": "Здравствуй?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				},
				{
					"id": 722020104,
					"content": "О, могучая Громовая птица, прошу тебя... Не гневайся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020105
					],
					"speakerTitle": "Тисэ"
				},
				{
					"id": 722020105,
					"content": "Я сделаю всё возможное, чтобы прочитать твои указы и наставления... Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020106
					],
					"speakerTitle": "Тисэ"
				},
				{
					"id": 722020106,
					"content": "Но почему ты отвергаешь меня... Почему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020107
					],
					"speakerTitle": "Тисэ"
				},
				{
					"id": 722020107,
					"content": "Почему я не могу войти в туман, который ты создала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020108,
						722020113
					],
					"speakerTitle": "Тисэ"
				},
				{
					"id": 722020108,
					"content": "Прочесть... О чём вы говорите?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020109,
					"content": "Громовые камни, которые ты оставила... я придумаю способ... но серебряная лодка уже близко. Времени мало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020110
					],
					"speakerTitle": "Тисэ"
				},
				{
					"id": 722020110,
					"content": "Что такое громовой камень?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020111
					]
				},
				{
					"id": 722020111,
					"content": "Громовые камни на равнинах Аутакэ... Только те, кто владеет Электро, могут вернуть их к жизни. Только прошедшие через туман могут найти их...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020112
					],
					"speakerTitle": "Тисэ"
				},
				{
					"id": 722020112,
					"content": "Стоять во весь рост, как Громовая птица... Расправить крылья, как Громовая птица...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тисэ"
				},
				{
					"id": 722020113,
					"content": "Подождите. Разве туман не рассеялся?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020103,
					"content": "Вам нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				}
			]
		},
