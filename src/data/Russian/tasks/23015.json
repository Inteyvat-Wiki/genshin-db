			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гарсия",
					"Лу Тун",
					"Ахангар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150301,
					"content": "Отлично! Отлично! Больше не нужно ничего объяснять, я пойду ковать тебе новые шестерёнки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150302
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230150302,
					"content": "Но я ещё не закончил рассказ о машине...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150303
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230150303,
					"content": "Обломки железа у нас есть, теперь самое время взяться за работу. Отойди-ка в сторону!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150304
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230150304,
					"content": "Ахангар так неистово размахивает молотом, что Гарсия вынужден отойти...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230150305
					]
				},
				{
					"id": 230150305,
					"content": "Не будем отвлекать господина Ахангара. Вот ваше вознаграждение, спасибо за работу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150306
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230150306,
					"content": "Надеюсь, у вас всё получится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150307
					]
				},
				{
					"id": 230150307,
					"content": "#Спасибо за добрые слова, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150308
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230150308,
					"content": "Я отношусь к этой затее... с осторожным пессимизмом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150309
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230150309,
					"content": "Господин Гарсия талантлив во всём, что касается механизмов, это не подлежит сомнению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150310
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230150310,
					"content": "Но я думаю, что для создания машины, о которой мечтает господин Гарсия, требуется нечто намного большее, чем просто «талант»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				}
			]
		},
		{
			"id": 2301550,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
