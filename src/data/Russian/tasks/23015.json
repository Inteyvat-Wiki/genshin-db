						],
						"stepId": 2301502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ахангар",
					"Гарсия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230155001,
					"content": "Зачем тебе столько трубок и шестерёнок? Жестяной дом собрался построить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155002
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230155002,
					"content": "Да, господин! Я хочу построить дом, настоящий дом, набитый шестернями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155003
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230155003,
					"content": "Первую комнату, где будет помещаться одна половина шестерёнок, я назову «хранилище», а вторая комната с подшипниками и оставшимися шестерёнками будет называться «расчётная база».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155004
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230155004,
					"content": "Шестерёнки из «хранилища» будут использоваться для записи и хранения данных, а шестерёнки из «расчётной базы» будут проводить вычисления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155005
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230155005,
					"content": "Я нарисую схему, чтобы вам было понятнее, у вас есть бумага? Нет? Ничего, я нарисую прямо на рукаве, тогда вы увидите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155006
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230155006,
					"content": "Могу я взять этот уголёк? Благодарю, посмотрите сюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гарсия"
				}
			]
		}
	]
}