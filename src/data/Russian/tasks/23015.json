				"points": []
			},
			"dialogs": [
				{
					"id": 230150101,
					"content": "Подшипник получился великоват, он не подходит к остальным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150102
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230150102,
					"content": "Прошлый был маловат, этот великоват, у меня так обломков железа не останется!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150103
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230150103,
					"content": "На самом деле, у нас и денег почти не осталось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150104
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230150104,
					"content": "О чём спорите?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150105
					]
				},
				{
					"id": 230150105,
					"content": "Этот человек требует, чтобы я ковал ему разные шестерёнки и железные трубки, причём все эти шестерёнки и трубки должны отличаться друг от друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150106
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230150106,
					"content": "Я уже потратил на его трубки и шестерёнки все свои обломки железа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150107
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230150107,
					"content": "Но ему всё мало, ему нужно больше шестерёнок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150108
					],
					"speakerTitle": "Ахангар"
				},
				{
					"id": 230150108,
					"content": "Просто послушайте, я объясню, как всё работает, и вы поймёте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150109
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230150109,
					"content": "Что стряслось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150110
					]
				},
				{
					"id": 230150110,
					"content": "Пусть господин Ахангар выслушает господина Гарсию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150111
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230150111,
					"content": "#Путешественни{F#ца}{M#к}, я... Гм, господин Гарсия просит вас о помощи: нужно отправиться на поиски обломков железа, вы согласны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150112,
						230150113
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230150112,
					"content": "#Я сейчас {F#свободна}{M#свободен}, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				},
				{
					"id": 230150114,
					"content": "С машиной дело обстоит так... Мы столкнулись с некоторыми ожидаемыми трудностями. И господин Гарсия как раз ищет способы их преодоления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150115
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230150115,
					"content": "Если вам интересно, после можете сами расспросить господина Гарсию обо всём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150116
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230150116,
					"content": "Думаю, кроме него, никто не способен как следует объяснить принципы работы этой машины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150117
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230150117,
					"content": "Но прежде я прошу вас принести нам несколько обломков железа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230150113,
					"content": "Как идёт работа над Числовой машиной?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				}
			]
		},
