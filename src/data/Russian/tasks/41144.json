				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411440301,
					"content": "#Я слышал{F#а}, что есть особый заказ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411440302
					]
				},
				{
					"id": 411440302,
					"content": "#А? Ты {M#пришёл}{F#пришла} помочь доставить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440303
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 411440303,
					"content": "Хорошо, ты как раз вовремя. Лин Гуань заказала рулеты из мацутакэ с вином.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440304
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 411440304,
					"content": "Она сказала принести попозже куда-то к северо-западу от Тростниковых островов. Уже всё оплачено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440305
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 411440305,
					"content": "#Ну как, если ты {M#свободен}{F#свободна}, то доставь, пожалуйста. Я тебе заплачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
			]
		},
