			"dialogs": [
				{
					"id": 411440101,
					"content": "Сейчас же доставлю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411440102
					]
				},
				{
					"id": 411440102,
					"content": "#О, а ты {M#бойкий}{F#бойкая}... Ну тогда поторопись. Постарайся <color=#00E1FFFF>не трогать ничего странного</color> по пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440103
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 411440103,
					"content": "А, и не <color=#00E1FFFF>лети на планере</color>, чтобы поскорее успеть. Если голубцы развалятся при приземлении, то клиент точно не примет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
