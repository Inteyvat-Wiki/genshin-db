		{
			"id": 7224702,
			"completionStepIds": [
				7224704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224704",
							"2"
						],
						"stepId": 7224704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Абэраку",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722470201,
					"content": "Похоже, что у тебя сил более чем достаточно для того, чтобы отнести подношения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470202
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722470202,
					"content": "Я смогу наконец-то успокоиться. Эти предметы нужно доставить туда, чтобы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470203
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722470203,
					"content": "Для чего?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722470204,
					"content": "Чтобы... чтобы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470205
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722470205,
					"content": "О-о-о. Похоже, он сломался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722470206,
					"content": "Но подношение, о котором он говорил, - вероятно, вот это... Хоть и выглядит потрёпанно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7224703,
			"completionStepIds": [
				7224705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
