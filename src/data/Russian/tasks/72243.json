			},
			"dialogs": [
				{
					"id": 722430102,
					"content": "Хочу продать кое-какие сокровища.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430103
					]
				},
				{
					"id": 722430103,
					"content": "Продать сокровища? Какой сюрприз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430104
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430104,
					"content": "Я полагаю, что у такого опытного искателя приключений, как вы, должны быть действительно редкие товары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430105
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430105,
					"content": "Дайте посмотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430106
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430106,
					"content": "Вы рассказываете Марджори о жемчужине Драконьего цветка.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722430107
					]
				},
				{
					"id": 722430107,
					"content": "А это не то, что барды называли «плодом безмятежности»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430108
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430108,
					"content": "Подумать только, он действительно существует... А его настоящее название - жемчужина Драконьего цветка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430109
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430109,
					"content": "Если его эффект будет таким, как вы говорите, я готова заплатить за него 80 000 моры и угощу своими особыми блюдами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430110,
					"content": "Как насчёт 80 000 моры и пяти лунных пирогов. Что скажете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430111,
						722430114,
						722430120
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430111,
					"content": "Что ты будешь с ней делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430112
					]
				},
				{
					"id": 722430112,
					"content": "Хе-хе. Это такое уникальное сокровище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430113
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430113,
					"content": "Сказочные, мифические характеристики! Думаю, алхимики отсыпят мне немало моры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430114,
					"content": "Справедливая цена. Договорились.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430115
					]
				},
				{
					"id": 722430115,
					"content": "Тогда я беру. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430116
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430116,
					"content": "Ах да. Такие бусинки могут медленно испаряться от ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430117
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430117,
					"content": "Поэтому лучше накрыть мембраной или поместить в герметичный контейнер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430118
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430118,
					"content": "Я дам вам этот совет бесплатно. Надеюсь, он пригодится вам в ваших приключениях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430119
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430119,
					"content": "Если в будущем встретите такие сокровища, всегда помните, что у вас есть кому их продать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430120,
					"content": "Мне нужно ещё подумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430121
					]
				},
				{
					"id": 722430121,
					"content": "Конечно, без проблем. Я уверена в том, что верно оцениваю стоимость этого предмета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430122
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 722430122,
					"content": "Приходите обратно, когда всё обдумаете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марджори"
				}
			]
		},
