			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940801,
					"content": "Просим вас не держать при себе большое количество моры, чтобы избежать возможных краж.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940802
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731940802,
					"content": "При обнаружении хищения не обращайтесь за помощью к патрулирующим окрестности Пустынникам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940803
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731940803,
					"content": "С большой долей вероятности именно они присвоили ваши деньги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319409,
