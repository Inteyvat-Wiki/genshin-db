			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940701,
					"content": "Бимарстан - это учреждение здравоохранения при Амурте, которое предоставляет бесплатную медицинскую помощь всем жителям Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940702
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731940702,
					"content": "Врачи Бимарстана проходят лицензирование в Амурте. Диагнозы и лечебные планы специалистов Бимарстана неоднократно проверяются Акашей. Благодаря этому мы предоставляем жителям Сумеру самые профессиональные и безопасные медицинские услуги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940703
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731940703,
					"content": "Не доверяйте неизвестным и не имеющим лицензии врачам, чтобы избежать финансовых потерь и необратимого вреда здоровью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319408,
			"completionStepIds": [
				7319408
			],
