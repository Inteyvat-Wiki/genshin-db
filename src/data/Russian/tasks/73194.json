			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941101,
					"content": "Поскольку махамата больше не будет здесь ничего публиковать, эта доска отлично подойдёт для объявлений нашей таверны. Оставляйте здесь свои сообщения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941102
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731941102,
					"content": "Прибыли ли десять ящиков вина, которые я заказал? Вчера мне сказали, что их ещё не привезли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941103
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731941103,
					"content": "Быть того не может! К нам за вином пожаловал кое-кто со светлыми волосами, утверждая, что вы живёте вместе. Я помню, что вы вместе заходили на днях. Ты ничего не путаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941104
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731941104,
					"content": "Ясно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319412,
			"completionStepIds": [
				7319412
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319412",
