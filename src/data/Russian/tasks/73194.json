			},
			"dialogs": [
				{
					"id": 731940901,
					"content": "Разыскивается: Касим",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940902
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731940902,
					"content": "Выдаёт себя за всемирно известного опасного преступника, гастролирующего по разным странам. На самом деле является мошенником, не входящим в число сильнейших Пустынников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940903
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731940903,
					"content": "В последнее время было зарегистрировано много случаев мошенничества с его участием. Будьте бдительны и не попадайтесь на его уловки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
