			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941201,
					"content": "Если собираетесь в лес, осторожно! На днях наставник отправил меня туда собирать травы, и меня чуть не съел тигр ришболанд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941202
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731941202,
					"content": "К счастью, меня спасла лесная дозорная. Она назвала себя стажёром Лесного дозора, но опыта ей, кажется, не занимать. А главное - она вкусно меня покормила, чтобы снять стресс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941203
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731941203,
					"content": "«Говорят, она ученица Тигнари. Ну, каков учитель, таков и ученик!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
