			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941001,
					"content": "Разыскивается: Муста",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941002
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731941002,
					"content": "Выдавая себя за махамату Академии, занимается вымогательством и грабежом в районе порта у Базара. Дело расследуется Цитаделью Регзара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941003
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731941003,
					"content": "Согласно имеющимся сведениям, скрывается в джунглях. Сообщите, если вам известны любые сведения о его местонахождении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319411,
			"completionStepIds": [
				7319411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319411",
