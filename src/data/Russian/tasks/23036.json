				"points": []
			},
			"dialogs": [
				{
					"id": 230360101,
					"content": "Попробуйте новую наживку ещё раз, господин Кайван.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360102
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 230360102,
					"content": "Я уже кучу раз её пробовал, она ничем не отличается от прежней!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360103
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230360103,
					"content": "Что? Вы снова вместе рыбачите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230360104,
					"content": "#Вот мы и снова встретились, {F#путешественница}{M#путешественник}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360105
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230360105,
					"content": "Здравствуйте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360106,
						230360107
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 230360106,
					"content": "Вы разобрались, почему не ловится рыба?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				},
				{
					"id": 230360108,
					"content": "Ха-ха, нисколько. Мы с господином учёным модернизировали удочку, наживку и технику ловли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360109
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230360109,
					"content": "Перепробовали кучу водоёмов, ловили в самых разных местах... Он даже заставил меня сидеть на жерди посреди кишащего рыбой пруда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360110
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230360110,
					"content": "Но что бы мы ни делали, мне так и не попалось ни одной рыбины, только один хлам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360111
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230360111,
					"content": "Успокойтесь, господин Кайван. Разве учёный не пообещал продолжить исследование? Он точно поможет вам разобраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360112
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 230360112,
					"content": "Ведь он разработал для вас новую приманку и поручил мне всё время находиться рядом и фиксировать любую мелочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360113
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 230360113,
					"content": "Надеюсь, он и правда найдёт ответ. Но до всего этого я отлично рыбачил и собственным методом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360114
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230360114,
					"content": "#{NICKNAME}, если у тебя есть время, не мог{F#ла} бы ты поискать для меня ещё наживку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кайван"
				},
				{
					"id": 230360107,
					"content": "Встреча с учёным вам помогла?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				}
			]
		},
