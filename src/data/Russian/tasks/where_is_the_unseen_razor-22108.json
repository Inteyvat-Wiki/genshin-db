			"dialogs": [
				{
					"id": 221080201,
					"content": "#Ты уже разобра{F#лась}{M#лся} с хиличурлами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080202
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080202,
					"content": "Пока ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080203
					]
				},
				{
					"id": 221080203,
					"content": "Не торопись. Искатель приключений не должен подвергать себя лишней опасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080204
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080204,
					"content": "Но помни, что твоя награда напрямую зависит от скорости выполнения задания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				}
			]
		},
