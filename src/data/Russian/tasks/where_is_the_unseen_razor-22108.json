			"dialogs": [
				{
					"id": 221080301,
					"content": "#Ты уже разобрал{F#ась}{M#ся} с хиличурлами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080302
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080302,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080303
					]
				},
				{
					"id": 221080303,
					"content": "Отлично сработано. Настоящий искатель приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080304
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080304,
					"content": "Вот твоя награда. Спасибо. Береги себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080305
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080305,
					"content": "Полагаю, тебе не удалось найти меч, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080306
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080306,
					"content": "Понятно... Так я и думала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080307
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080307,
					"content": "Спасибо, вот твоя награда. Хорошего дня.",
					"roleType": "TALK_ROLE_NPC",
