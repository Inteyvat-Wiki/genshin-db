					"Мисс Лань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221080101,
					"content": "Снова промах... Вариантов всё меньше и меньше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080102
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080103
					]
				},
				{
					"id": 221080103,
					"content": "Кто ты? Если хочешь записаться в Гильдию, поговори с Катериной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080104
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080104,
					"content": "#Ты уже вступил{F#а} в Гильдию? Прошу прощения. Хоть я и глава местного отделения Гильдии, но я не очень пристально слежу за набором кадров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080105
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080105,
					"content": "#Поэтому я не знаю всех новобранцев в лицо... Но ты ведь уже совсем не новобранец, верно? Ты похож{F#а} на закалённого в боях искателя приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080106
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080106,
					"content": "Может быть, ты сможешь мне помочь? Я хочу подчеркнуть, что это личное поручение, а не задание Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080107,
						221080108
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080107,
					"content": "Хорошо. Договорились.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080109
					]
				},
				{
					"id": 221080109,
					"content": "Мне нравится твой энтузиазм, но соглашаться на задание, не узнав его условий, крайне неразумно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080111,
					"content": "Твоё задание - победить двух больших хиличурлов с огромными щитами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080112
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080112,
					"content": "#Их щиты заряжены Гео энергией. Ничего слишком опасного, но будь осторож{F#на}{M#ен}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080113
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080113,
					"content": "Тебе нужно только победить их. После этого возвращайся ко мне за наградой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080114
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080114,
					"content": "Ах, да... Если тебе по пути попадётся что-то связанное с мечом, принеси это что-то мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080115
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080115,
					"content": "А если нет, то ничего страшного. Чтобы получить награду, тебе нужно только победить хиличурлов. Можешь приступать к выполнению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221080108,
					"content": "Можно поподробнее?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080110
					]
				},
				{
					"id": 221080110,
					"content": "#Осторожный ответ. Видно, что опасности научили тебя быть осторожн{F#ой}{M#ым}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Мисс Лань"
				}
			]
		},
