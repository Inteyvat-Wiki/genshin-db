			"dialogs": [
				{
					"id": 3880101,
					"content": "<color=#00E1FFFF>Штормовой барьер!</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3880102,
					"content": "Выглядит зловеще!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3880103,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880104
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3880104,
					"content": "Пусть это всё, что у меня есть, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880105
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3880105,
					"content": "Мне не нужна Небесная лира, чтобы прорваться через такие барьеры... Погоди, что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880106
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3880106,
					"content": "Нас атакуют! Готовьтесь к бою!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джинн"
				}
			]
		},
