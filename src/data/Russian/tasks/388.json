			"dialogs": [
				{
					"id": 3880301,
					"content": "Странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880302
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3880302,
					"content": "Обычно хиличурлы избегают мест с такими сильными стихийными потоками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880303
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3880303,
					"content": "Им должно быть просто невыносимо здесь находиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880304
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3880304,
					"content": "Маги Бездны контролируют их разум. Но как они узнали, что мы будем здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880305
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3880305,
					"content": "Похоже, они расставляют своих приспешников по всей округе, чтобы поймать нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880306
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 3880306,
					"content": "Тогда нам стоит поторопиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880307
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3880307,
					"content": "Когда Ветер - мой единственный слушатель, я играю быстрее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		},
