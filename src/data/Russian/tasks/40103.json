			},
			"dialogs": [
				{
					"id": 401035101,
					"content": "Аль-Хайтам, Нилу! Вы видели остальных участников?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401035102,
					"content": "Нет! Пока никто не справился с заданием... А что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035103
					],
					"speakerTitle": "Нилу"
				},
				{
					"id": 401035103,
					"content": "С Диадемой что-то не так... Слушай, аль-Хайтам, ты ведь что-то знаешь, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401035104,
					"content": "Ты о чём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035105
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 401035105,
					"content": "Ты!.. Ай, ладно! Мы пойдём искать Диадему знания, а потом обо всём тебя расспросим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
