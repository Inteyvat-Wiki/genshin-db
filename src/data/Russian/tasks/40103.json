					}
				]
			},
			"dialogs": [
				{
					"id": 401030201,
					"content": "Вот и вы. Прошу прощения, я был занят на допросе и не успел отправить к вам нарочного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030202
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401030202,
					"content": "И что тебе удалось узнать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401030203,
					"content": "Скажем так... много всего неожиданного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030204
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401030204,
					"content": "Похитителей мы поймали на удивление легко. Один из наших ребят переоделся Сачином, и они сразу купились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030205
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401030205,
					"content": "Но в результате допроса мы выяснили, что похищение Сачина заказал его собственный сын.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030206
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401030206,
					"content": "Что? Но зачем кому-то понадобилось похищать собственного отца?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401030207,
					"content": "Остаётся только гадать... В городе действовала только небольшая группа наёмников, а все остальные засели в окрестностях города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030208
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401030208,
					"content": "Я собираюсь отправить людей на их поимку. Не хотите присоединиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030209
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 401030209,
					"content": "Хорошо! Заодно и узнаем, что это всё значит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
