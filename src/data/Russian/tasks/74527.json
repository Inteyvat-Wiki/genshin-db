				"points": []
			},
			"dialogs": [
				{
					"id": 745270401,
					"content": "#А, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270402,
						745270403
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 745270402,
					"content": "Эскофье, давно не виделись.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				},
				{
					"id": 745270404,
					"content": "Сегодня я не отвечаю за готовку, а дегустирую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270405
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 745270405,
					"content": "Саванна хочет представить новое блюдо и попросила меня помочь ей с оценкой. Вот только... я уже попробовала пять вариантов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270406
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 745270406,
					"content": "Сначала неправильная температура испортила текстуру ингредиентов, потом излишек пряностей перебил все остальные оттенки вкуса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270407
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 745270407,
					"content": "Ты всё такая же строгая.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270408
					]
				},
				{
					"id": 745270408,
					"content": "А как иначе?! Кулинария - это наука, и я не собираюсь менять свои стандарты только потому, что Саванна моя подруга. Наоборот, раз я несу ответственность перед ней и клиентами, я должна быть ещё строже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270409,
						745270410
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 745270409,
					"content": "На самом деле, у меня есть маленькая просьба...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270411,
					"content": "...Прямо сейчас? Если фото будут выставляться для публики, то не лучше ли выбрать другое время?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270412
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 745270412,
					"content": "Нужно тщательно подобрать фон и аккуратно настроить освещение и ракурс, чтобы добиться наилучшего результата...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270413,
						745270414
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 745270413,
					"content": "Это всего лишь памятная фотография для друзей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270415,
					"content": "...Ладно. Всё равно придётся ждать, пока она переделает в шестой раз, так что время есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270416
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 745270416,
					"content": "Посмотрим, что получится лучше - твои фотографии или новое блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 745270414,
					"content": "Да и хочется проверить возможности нового объектива.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270410,
					"content": "Могу я сфотографировать тебя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270403,
					"content": "Разрабатываешь новый рецепт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				}
			]
		}
	]
}