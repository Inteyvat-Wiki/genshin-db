			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нэко",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110401,
					"content": "Какой аромат! Вы уже приготовили еду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110402
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110402,
					"content": "Всё готово.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110403
					]
				},
				{
					"id": 722110403,
					"content": "Мяу-мяу! Чудесно, дайте же мне скорее попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110404
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110405
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110405,
					"content": "Кажется, это отличается от того, что готовила Хибики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110406
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110406,
					"content": "Это наверняка очень вкусно. Попробуем вместе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110407,
					"content": "Очень вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110408,
					"content": "Мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110409
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110409,
					"content": "(Нэко не нравится, что еда не похожа на ту, что готовила Хибики?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110410,
					"content": "Очень вкусно. Вам действительно можно доверять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110411
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110411,
					"content": "Замечательно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110412
					]
				},
				{
					"id": 722110412,
					"content": "Хотя блюдо, которое вы приготовили, непохоже на то, что делала Хибики...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110413
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110413,
					"content": "...но когда мы ели с вами вместе, это было так похоже на наши совместные трапезы с Хибики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110414
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110414,
					"content": "Почему так? У людей есть для этого какая-то странная магия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110415,
						722110416
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110415,
					"content": "Тебя просто давно никто не кормил.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				},
				{
					"id": 722110417,
					"content": "Как бы то ни было, спасибо вам. Я давно не ела такой вкусной еды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110418
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110418,
					"content": "Малышам точно понравится. Угости их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110419
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110419,
					"content": "Если понравилось мне, то и им точно понравится. Может быть, после вкусной еды они станут более послушными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110416,
					"content": "Может быть, дело в том, что человек вкладывает душу, когда готовит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				}
			]
		},
		{
			"id": 7221105,
			"completionStepIds": [
				7221107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
