					"Тайсукэ",
					"Эйко",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "Эйко, что будем исследовать дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722110102,
					"content": "Уф, может, передохнём для начала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722110103,
					"content": "А, это вы? Зачем вы нас искали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722110104,
					"content": "Нам нужен надёжный повар...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "Повар? На Сэйрае?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722110106,
					"content": "Так уж обстоят дела. Нэко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110107,
					"content": "Так это госпожа Нэко попросила вас помочь с готовкой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722110108,
					"content": "Проклятье! Если бы у меня был хоть какой-то талант к кулинарии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722110109,
					"content": "Другими словами, вам нужен повар, который разберётся, как приготовить из этих ингредиентов то, что понравится кошкам, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722110110,
					"content": "Дайте-ка подумать... Повар...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722110111,
					"content": "Почему бы вам не поехать в город Инадзуму и не отыскать там Анну Киминами из ресторана «Киминами».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722110112,
					"content": "Госпожа Киминами очень добрая и отлично готовит. Она наверняка сможет вам помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722110113,
					"content": "Спасибо, мы попробуем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "Не за что, отправляйтесь поскорее. А нам с Тайсукэ нужно составить план будущих исследований.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722110115,
					"content": "Ха-ха, надеюсь, это святилище и впрямь вернётся к жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722110116,
					"content": "Иначе ваши с Нэко труды пропадут зря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эйко"
				}
			]
		},
		{
			"id": 7221102,
