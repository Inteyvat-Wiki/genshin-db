				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722111101,
					"content": "Здравствуйте! Добро пожаловать в ресторан «Киминами». Чем могу быть полезна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111102
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111102,
					"content": "Добрый день... А, друзья госпожи Камисато! Входите скорее. Чем я могу вам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111103
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111103,
					"content": "Речь идёт о еде для Нэко...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111104
					]
				},
				{
					"id": 722111104,
					"content": "Нэко? А это случайно не кошачье имя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111105
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111105,
					"content": "Ты знакома с Нэко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722111106,
					"content": "Нет. Просто мне почему-то показалось, что это имя хорошо бы подошло для кошки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111107
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111107,
					"content": "У тебя отличная интуиция.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111108
					]
				},
				{
					"id": 722111108,
					"content": "Ладно, это сейчас неважно. Дело вот в чём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722111109,
					"content": "На острове Сэйрай есть святилище Асасэ, и там живёт говорящая кошка? И эта кошка попросила вас что-нибудь ей приготовить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111110
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111110,
					"content": "Что, правда? Никогда о таком не слышала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111111,
						722111112
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111111,
					"content": "Да, это правда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111113
					]
				},
				{
					"id": 722111113,
					"content": "На острове Сэйрай? Я обязательно проверю, как только мне представится шанс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111114
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111114,
					"content": "Так что с едой для Нэко?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111115
					]
				},
				{
					"id": 722111115,
					"content": "Ах да, о главном-то чуть не забыла. Дай мне подумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111116
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111116,
					"content": "Хм... Блюдо, которое могло бы понравиться кошке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111117
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111117,
					"content": "Это сложно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722111118,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111119
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111119,
					"content": "Очень-очень сложно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111120
					]
				},
				{
					"id": 722111120,
					"content": "Это настоящий вызов для семьи Киминами! И я с ним обязательно справлюсь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111121
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111121,
					"content": "Думаю что из рыбы, сырого мяса, морских водорослей и риса обязательно получится такое блюдо, перед которым кошки не смогут устоять. Предоставь это мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111122
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111122,
					"content": "И я хочу попробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111123,
						722111124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722111123,
					"content": "#Я бы тоже не отказал{M#ся}{F#ась}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111125,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111126
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111126,
					"content": "Я ещё подумаю над рецептом, а вы пока достаньте три пучка морских водорослей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111127,
						722111129
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111127,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111128
					]
				},
				{
					"id": 722111128,
					"content": "Тогда займитесь этим. Трёх пучков морских водорослей хватит. Возвращайтесь, как только найдёте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111129,
					"content": "Ты уже знаешь, что будешь готовить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111130
					]
				},
				{
					"id": 722111130,
					"content": "Есть одна мысль, но мне нужно ещё подумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111131
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111131,
					"content": "А пока найдите для меня три пучка морских водорослей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722111124,
					"content": "Я рассчитываю на тебя!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111112,
					"content": "Ты можешь сама посмотреть и убедиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111113
					],
					"speakerTitle": "Киминами Анна"
				}
			]
		}
	]
