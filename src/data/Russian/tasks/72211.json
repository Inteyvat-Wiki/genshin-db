			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221108",
							"2"
						],
						"stepId": 7221108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Киминами Анна",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110702,
					"content": "Отлично! Дай-ка мне секунду, мне нужно подумать... Есть! Я знаю, что делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110703
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722110703,
					"content": "Готово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110704
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722110704,
					"content": "Пахнет вкусно! Паймон очень хочет попробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110705,
					"content": "Как бы назвать это блюдо? Хм-м... Раз это для говорящей кошки, я назову это «Бодрящее кошачье лакомство».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110706
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722110706,
					"content": "Ну вот и всё, можете забирать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110707
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722110707,
					"content": "Да, рецепт я тебе тоже запишу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110708
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722110708,
					"content": "#Отлично, у нас в меню скоро будет кошачье лакомство от мастер-шефа {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110709,
						722110712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110709,
					"content": "Ты что, кошка, Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110710
					]
				},
				{
					"id": 722110710,
					"content": "Как грубо! Вкусная еда - это универсальный язык общения! Например, между Нэко и мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110711
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110711,
					"content": "Ой, да, спасибо огромное, госпожа Киминами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110713
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110713,
					"content": "Не стоит благодарностей. Пусть это блюдо и рецепт станут моими подарками для Нэко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110714
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722110714,
					"content": "Как только у меня выдастся свободная минутка, я непременно побываю на Сэйрае.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110715
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722110715,
					"content": "Что ж, вам пора возвращаться. Не стоит заставлять Нэко ждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 722110712,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110713
					]
				}
			]
		},
		{
			"id": 7221108,
			"completionStepIds": [
				7221101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221101",
							"2"
						],
						"stepId": 7221101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Нэко",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110801,
					"content": "А, это ты? Как раз вовремя. Мне нужна помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110802
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110802,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110803
					]
				},
				{
					"id": 722110803,
					"content": "Благодаря тебе святилище выглядит гораздо лучше, скоро может прийти много людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110804
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110804,
					"content": "И когда это случится, котята должны вести себя достойно, чтобы не сплоховать перед людьми. Я занимаюсь их обучением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110805
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110805,
					"content": "Но они слишком привыкли к вольной жизни и совсем не слушают моих наставлений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110806
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110806,
					"content": "Но я придумала один метод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110807
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110807,
					"content": "Метод?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110808
					]
				},
				{
					"id": 722110808,
					"content": "Когда я была очень-очень маленькой, мне тоже нравилось играть где попало. Чтобы научить меня послушанию, Хибики готовила мне вкусную еду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110809
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110809,
					"content": "Вкусную?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110810,
					"content": "Каждый раз, когда подавали это блюдо, все кошки сбегались с деревьев и крыш. Хотя оно было таким горячим, что обжигало наши языки, мы не могли устоять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110811
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110811,
					"content": "Хибики всегда готовила его в большом котле, и все ели вместе - люди и кошки. Посетители святилища тоже получали свою порцию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110812
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110812,
					"content": "Но вот Домэки... Он был настоящий обжора, всегда столько ел! Ужасные манеры, не то что у меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110813,
						722110814
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110813,
					"content": "Ты хочешь сказать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				},
				{
					"id": 722110815,
					"content": "Ловишь на лету! Я хочу попросить вас приготовить мне еду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110816
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110816,
					"content": "Нисколько не сомневаясь в твоей мудрости...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110817
					]
				},
				{
					"id": 722110817,
					"content": "...хочу уточнить: а ты знаешь, как готовить это блюдо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110818
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110818,
					"content": "Мяу-мяу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110819
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110819,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110820
					]
				},
				{
					"id": 722110820,
					"content": "Н-ну... В этом же и смысл задания! Не могу же я всё-всё вам разжёвывать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110821
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110821,
					"content": "Ах, то блюдо было поистине восхитительным! Как бы далеко ни завела судьба, сколько бы времени ни прошло, этот запах как будто всё ещё чувствуется в воздухе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110822
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110822,
					"content": "#Ну что, {NICKNAME}, работёнка прямо для нас, да? Всё ради блага святилища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110823,
						722110824
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110823,
					"content": "А что входит в состав блюда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110826
					]
				},
				{
					"id": 722110826,
					"content": "Ну конечно, я всё помню. Рыба, мясо, трава, которая растёт в воде, и ещё белый рис.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110827
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110827,
					"content": "Так значит рыба, сырое мясо, морские водоросли и рис, ага... Ты помнишь, как его готовить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110828
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110828,
					"content": "Не помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110829,
						722110831
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110829,
					"content": "Может, стоит спросить повара.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110830
					]
				},
				{
					"id": 722110830,
					"content": "Конечно, но... Где нам найти повара, который знает, как готовить еду для кошек? Хм... Давай узнаем у Тайсукэ и Эйко. Может, они знают, что делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110831,
					"content": "Спросим у тех двоих искателей приключений.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110832
					]
				},
				{
					"id": 722110832,
					"content": "Точно! Тайсуке и Эйко - искатели приключений. Может, они что-то знают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110824,
					"content": "Паймон, твои хитрости так легко разгадать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110825
					]
				},
				{
					"id": 722110825,
					"content": "Да ладно, Паймон просто очень любит кошек! Нэко, ты помнишь, какие ингредиенты входили в это блюдо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110826
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722110814,
					"content": "...что мы должны приготовить для тебя еду?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				}
			]
		},
