			"dialogs": [
				{
					"id": 722110601,
					"content": "Все дела, связанные с приготовлением еды, поручаю вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110602
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110602,
					"content": "Когда всё будет готово, поешь вместе со мной и котятами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				}
			]
		},
		{
			"id": 7221107,
			"completionStepIds": [
