			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нэко"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110501,
					"content": "Вы уже отнесли еду котятам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110502
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110502,
					"content": "Им очень понравилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110503
					]
				},
				{
					"id": 722110503,
					"content": "Да? Ну вот и отлично, мяу-мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110504
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110504,
					"content": "Как давно я не ела такой вкусной еды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110505
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110505,
					"content": "Мяу-мяу. Я сейчас не испытываю ни голода, ни жажды, но это еда такая вкусная, что я не могу устоять перед искушением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110506
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110506,
					"content": "Одного из моих котят зовут Вкусняшка, потому что мне хотелось назвать её в честь самой лучшей вещи на свете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110507
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110507,
					"content": "Как называлось блюдо, которое тебе готовила Хибики?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110508
					]
				},
				{
					"id": 722110508,
					"content": "Называлось? У еды тоже бывают имена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110509
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110509,
					"content": "Это блюдо называется «Бодрящее кошачье лакомство».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110510
					]
				},
				{
					"id": 722110510,
					"content": "Какое сложное имя. Но меня оно не раздражает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110511
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110511,
					"content": "#Ты прав{F#а}. Еда - замечательная вещь. А у всех хороших вещей должны быть имена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110512
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110512,
					"content": "Мяу-мяу, когда Хибики вернётся, я у неё спрошу. И тогда ты тоже сможешь приготовить её блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110513
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110513,
					"content": "А она сможет сделать твоё. И тогда я смогу съесть два разных вкусных блюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110514
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110514,
					"content": "А значит мне нужно ещё лучше привести в порядок святилище. И тогда она вернётся, и мы поедим все вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110515
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722110515,
					"content": "Спасибо, очень вкусно. Мяу-мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				}
			]
		},
		{
