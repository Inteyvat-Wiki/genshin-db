	"talks": [
		{
			"id": 7351101,
			"completionStepIds": [
				7351101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351101",
							"2"
						],
						"stepId": 7351101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Шрия",
					"Фодил"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110101,
					"content": "Вот дурак... Умчал в пустыню сломя голову, разве так можно? Фодил, помоги ему!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110102
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110102,
					"content": "Прошу прощения, но гарнизон в деревне небольшой, лишних людей нет, все должны следить за «ними», чтобы не вышло беды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110103
					],
					"speakerTitle": "Фодил"
				},
				{
					"id": 735110103,
					"content": "Так ведь этот дурак так старается, как раз чтобы справиться с «ними»! Прошу, это в наших общих интересах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110104
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110104,
					"content": "Да мы бы и не против помочь. Просто все стражники сейчас рассредоточены по пустыне, ищут их. На сбор команды уйдёт время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110105
					],
					"speakerTitle": "Фодил"
				},
				{
					"id": 735110105,
					"content": "Как же быть... Если возвращаться за помощью в Караван-рибат, мы точно опоздаем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110106,
						735110107
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110106,
					"content": "Кто-то в опасности?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				},
				{
					"id": 735110108,
					"content": "А? Кто вы?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110109
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110109,
					"content": "#Просто {M#проходящий мимо искатель}{F#проходящая мимо искательница} приключений.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110110
					]
				},
				{
					"id": 735110110,
					"content": "#И {M#его}{F#её} лучший компаньон, Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735110111,
					"content": "Искатели приключений? Серьёзно? Хвала небесам! Винаяк спасён!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110112
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110112,
					"content": "#{M#Уважаемый искатель}{F#Уважаемая искательница} приключений! Умоляю вас помочь Винаяку, обещаю щедрое вознаграждение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110113
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110113,
					"content": "Для начала мне бы хотелось понять, что происходит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110114
					]
				},
				{
					"id": 735110114,
					"content": "Пустыня стала опаснее прежнего из-за того, что там бесчинствуют они. Перед тем как строить планы, мне стоит ввести вас в курс дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110115
					],
					"speakerTitle": "Фодил"
				},
				{
					"id": 735110115,
					"content": "Ох... вы правы. Прошу прощения, я немного нервничаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110116
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110116,
					"content": "Паймон слышала ваш разговор с самого начала. Кто такие они?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735110117,
					"content": "Группа унутов. По какой-то причине в последнее время они стали необычайно агрессивными. Скрываются среди песчаных бурь и внезапно нападают на проходящую мимо добычу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110118,
						735110119
					],
					"speakerTitle": "Фодил"
				},
				{
					"id": 735110118,
					"content": "Это же просто червяки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110120,
					"content": "#В каком-то смысле ты прав{F#а}. Но в этот раз их слишком много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110121
					],
					"speakerTitle": "Фодил"
				},
				{
					"id": 735110121,
					"content": "Когда они под прикрытием песчаной бури, с ними сложно справиться. А при первых признаках опасности они сбегают...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110122
					],
					"speakerTitle": "Фодил"
				},
				{
					"id": 735110122,
					"content": "Ого, плохо дело...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735110123,
					"content": "Пострадала не только деревня Аару, но и проходившие мимо караваны. Поэтому Академия отправила нас с Винаяком разобраться с разбушевавшимися унутами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110124
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110124,
					"content": "Но унуты атаковали караван, которому мы поручили доставить часть необходимых компонентов. Детали занесло песчаной бурей... Боюсь, теперь они стали игрушкой для чудовищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110125
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110125,
					"content": "Я хотела вернуться в Караван-рибат за подмогой, но Винаяк... Кто бы мог подумать, что после стольких лет он всё ещё упрям, словно какой-то механизм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110126
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110126,
					"content": "Пробубнил что-то о возвращении своих драгоценных компонентов и убежал в пустыню в одиночку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110127
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110127,
					"content": "Эх... Может, стоит позволить монстрам схватить его?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110128
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110128,
					"content": "#Ого... Что будем делать, {NICKNAME}? Если оставить всё как есть, то учёный окажется в опасности, да и проблема с унутами не решится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110129,
						735110130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735110129,
					"content": "Нельзя оставлять проблемы в пустыне без внимания.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110131,
					"content": "Спасибо! Огромное спасибо! Простите, что перед этим дала волю чувствам. Я отмечу на карте место нападения. Прошу, найдите его как можно скорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110132
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110132,
					"content": "Надеюсь, он не настолько безрассуден, чтобы броситься прямо в лапы монстров ради компонентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735110130,
					"content": "Постараюсь спасти его.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110119,
					"content": "#Я {M#встречался}{F#встречалась} с врагами и похуже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110107,
					"content": "Вам нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				}
			]
		},
		{
			"id": 7351103,
			"completionStepIds": [
				7351103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351103",
							"2"
						],
						"stepId": 7351103,
						"stateName": "QUEST_STATE_UNFINISHED"
