				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Винаяк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110301,
					"content": "Если пройду отсюда, используя особенности рельефа для укрытия... При условии, что угол падения солнечных лучей не превышает... А моя скорость не ниже... Эх, всё равно не годится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110302
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735110302,
					"content": "Что ты пытаешься рассчитать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110303
					]
				},
				{
					"id": 735110303,
					"content": "Путь, по которому я могу пройти и вернуть компоненты, не столкнувшись с монстрами... Чудовища унесли мои детали, и всё из-за унутов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110304
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735110304,
					"content": "Ой! Вы кто? И откуда вы взялись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110305
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735110305,
					"content": "Я уже довольно давно тебя слушаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110306
					]
				},
				{
					"id": 735110306,
					"content": "Не переживай. Мы хорошие! Нас прислала твоя напарница!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735110307,
					"content": "Напарница? Вы о Шрие? Хотя нет, она же ясно сказала, что если я попаду в лапы монстрам, ей плевать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110308
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735110308,
					"content": "А, понял, она прислала вас за компонентами, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110309
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735110309,
					"content": "Поймают ли меня монстры - до этого ей дела нет, а вот если не вернуть компоненты, быть беде... Да, она определённо могла бы так выразиться. Похоже на правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110310
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735110310,
					"content": "...Можно и так сказать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110311
					]
				},
				{
					"id": 735110311,
					"content": "И всё равно я вам благодарен. Я уже голову сломал, пытаясь во всём разобраться. Готов был бросить расчёты и действовать напролом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110312
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735110312,
					"content": "А ведь одного неверного шага достаточно, чтобы угодить в лапы монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110313
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735110313,
					"content": "Эх, а Шрия такая неуклюжая, кто сможет позаботиться о компонентах без меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110314
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735110314,
					"content": "Понимаю, почему Шрия так разволновалась... У него на уме одни механизмы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735110315,
					"content": "#{NICKNAME}, давай соберём компоненты, пока он не надумал рискнуть собой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
