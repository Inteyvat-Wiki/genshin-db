			"dialogs": [
				{
					"id": 741490601,
					"content": "Это почтальон? Оставьте газету у входа, пожалуйста. Я заберу позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490602
					],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741490602,
					"content": "(Вы сегодня уже помогали Бенуа. Будет не очень вежливо опять его беспокоить. Бенуа ждёт вас в гости завтра, как вы и договаривались.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Постучать"
				}
			]
		},
