						715090102
					]
				},
				{
					"id": 715090102,
					"content": "Наконец-то, шип Пурсины нужно поместить сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715090103
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715090103,
					"content": "Кхе-кхе... По моим расчётам, это и есть настоящий выход из артерий земли.",
