				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740301,
					"content": "Я наблюдаю за маленькими детьми, которые очень скучают по своей бабушке. Жаль, да, действительно жаль, что они не могут сесть в лодку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "«Лодочник»"
				}
			]
		},
		{
			"id": 7217404,
			"completionStepIds": [],
