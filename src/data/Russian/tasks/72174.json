			"dialogs": [
				{
					"id": 721740201,
					"content": "Теперь я подглядываю своим маленьким глазом... Бабушка скучает по своим внукам. Она не может отпустить их, нет, не может, она не может сесть в лодку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "«Лодочник»"
				}
			]
		},
		{
			"id": 7217403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
