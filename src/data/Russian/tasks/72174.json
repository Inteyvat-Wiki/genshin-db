			"dialogs": [
				{
					"id": 721740601,
					"content": "Вы, старые, кто хватается за вещи, странные и новые, давайте вернёмся, давайте вернёмся, в золотой дворец под луной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "«Лодочник»"
