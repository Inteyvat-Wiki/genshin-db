			"dialogs": [
				{
					"id": 721741001,
					"content": "Они все пришли, йо-хо-хо, йо-хо-хо, у нас есть наша весёлая команда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741002
					],
					"speakerTitle": "«Лодочник»"
				},
				{
					"id": 721741002,
					"content": "#Спасибо тебе, {F#добрая чужеземка}{M#добрый чужеземец}! Наконец-то мы отправимся в путь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741003
					],
					"speakerTitle": "«Лодочник»"
				},
				{
					"id": 721741003,
					"content": "Берег реки, эй! Золотой дуб стоит там, эй! Золотая полынь на земле, золотые камни кругом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741004
					],
					"speakerTitle": "«Лодочник»"
				},
				{
					"id": 721741004,
					"content": "Пейзаж прекрасен настолько, насколько это возможно. Простирается гораздо дальше, чем может видеть глаз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "«Лодочник»"
				}
			]
		},
