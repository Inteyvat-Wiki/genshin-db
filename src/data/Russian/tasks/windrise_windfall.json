			"dialogs": [
				{
					"id": 207431001,
					"content": "Если винокурня будет простаивать и дальше, то как я объясню это господину Дилюку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207431002
					],
					"speakerTitle": "Эльзер"
				},
				{
					"id": 207431002,
					"content": "#Путешественн{F#ица}{M#ик}, если вы встретите господина Дилюка, вы не могли бы рассказать ему об этом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207431003
					],
					"speakerTitle": "Эльзер"
				},
				{
					"id": 207431003,
					"content": "Он не слишком много внимания уделяет своему бизнесу, и этому делу тоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эльзер"
				}
			]
		},
		{
