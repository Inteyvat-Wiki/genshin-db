			},
			"dialogs": [
				{
					"id": 742510201,
					"content": "И большая радость делиться историями из прошлого с госпожой Гильотен за чашечкой восхитительной воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 742510202,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 742510204,
					"content": "Хорошо. Куда бы вы ни отправились дальше, желаю удачи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 742510203,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
}