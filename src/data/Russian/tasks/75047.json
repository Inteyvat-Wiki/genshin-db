					"Хурук"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750470301,
					"content": "Я хочу спать... Я хочу спать... Но мы должны все стоять...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470302
					],
					"speakerTitle": "Хурук"
				},
				{
					"id": 750470302,
					"content": "Почему нужно стоять здесь целый день?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хурук"
				}
			]
		},
		{
			"id": 7504704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
