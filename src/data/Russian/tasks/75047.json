				"objectNames": [
					"Куси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750470401,
					"content": "Хм, я смогла контролировать вес, но... Хм? Что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470402,
						750470405,
						750470409
					],
					"speakerTitle": "Куси"
				},
				{
					"id": 750470402,
					"content": "Кто ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470403
					]
				},
				{
					"id": 750470403,
					"content": "Я один из стражников, стоящий обычно на этом посту, но сейчас нахожусь в отпуске...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470404
					],
					"speakerTitle": "Куси"
				},
				{
					"id": 750470404,
					"content": "Если тебе что-то нужно, обращайся к Юкому!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Куси"
				},
				{
					"id": 750470405,
					"content": "Тебя что-то беспокоит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470406
					]
				},
				{
					"id": 750470406,
					"content": "Дело вот в чём. Последнее время я немного набрала вес. Поэтому в свой рацион к злакофруктам добавила много полезных овощей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470407
					],
					"speakerTitle": "Куси"
				},
				{
					"id": 750470407,
					"content": "Не знаю почему, но мой спутник Ур в последнее время тоже, смотря на меня, стал есть много травы... хотя заврианы всеядны, но слишком много травы, наверное, не очень хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470408
					],
					"speakerTitle": "Куси"
				},
				{
					"id": 750470408,
					"content": "Давай как-нибудь поговорим с ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Куси"
				},
				{
					"id": 750470409,
					"content": "Ничего страшного...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470410
					]
				},
				{
					"id": 750470410,
					"content": "#Хорошо. Желаю тебе счастливого пути, {F#чужеземка}{M#чужеземец}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Куси"
				}
			]
		}
