			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790510101,
					"content": "Смотри, ещё одна часть дневника. Похоже, она в хорошем состоянии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510102
					],
					"speakerTitle": "Читать"
				},
				{
					"id": 790510102,
					"content": "Фух... Какое облегчение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510103
					],
					"speakerTitle": "Читать"
				},
				{
					"id": 790510103,
					"content": "Значит, художник освободился от мук, и его мастерство действительно выросло. Наверняка он добился успеха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510104
					],
					"speakerTitle": "Читать"
				},
				{
					"id": 790510104,
					"content": "Хотя ему и пришлось покинуть друзей-Капелек. Звучит грустно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510105,
						790510106
					],
					"speakerTitle": "Читать"
				},
				{
					"id": 790510105,
					"content": "Думаю, в кругах художников копии не слишком ценятся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				},
				{
					"id": 790510107,
					"content": "Да уж, Паймон это понимает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510108
					],
					"speakerTitle": "Читать"
				},
				{
					"id": 790510108,
					"content": "Паймон ещё кое-что смущает. В дневнике написано, что рисунок может потерять свой первоначальный вид.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510109
					],
					"speakerTitle": "Читать"
				},
				{
					"id": 790510109,
					"content": "Но даже после всего случившегося с ним всё в полном порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510110,
						790510111
					],
					"speakerTitle": "Читать"
				},
				{
					"id": 790510110,
					"content": "Всё благодаря Капелькам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510112,
					"content": "Вот как! Теперь понятно, почему они так хорошо управляются с потоковыми проекторами и реставрацией рисунка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510113
					],
					"speakerTitle": "Читать"
				},
				{
					"id": 790510113,
					"content": "Ах, как же это трогательно! Пусть Капельки и не похожи на разумных существ, они очень внимательные и верные друзья...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Читать"
				},
				{
					"id": 790510111,
					"content": "Капельки защищали творение своего друга.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510106,
					"content": "Лучше придерживаться уникальности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				}
			]
		},
