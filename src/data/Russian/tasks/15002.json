			},
			"dialogs": [
				{
					"id": 150020301,
					"content": "Вы пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020302
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 150020302,
					"content": "Кинич! Тринидад сказал, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150020303,
					"content": "Да. У вас на лицах написано.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020304
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 150020304,
					"content": "#Это {NICKNAME} и Паймон? Простите меня за то, что я не поприветствовал вас по прибытии. Как вождь, я должен был это сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020305
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				},
				{
					"id": 150020305,
					"content": "Привет, вождь Уайна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150020306,
					"content": "Я только вчера узнал новости от Тринидада, поэтому попросил Кинича пригласить вас для беседы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020307
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				},
				{
					"id": 150020307,
					"content": "Мы рады помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020308
					]
				},
				{
					"id": 150020308,
					"content": "Хе-хе... Полагаю, Кинич уже рассказал вам немного, так что я перейду сразу к делу. Во-первых, я полностью одобряю ваше назначение в качестве огненосцев на предстоящую Ночь Пламени поворота.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020309
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				},
				{
					"id": 150020309,
					"content": "Но у меня есть одна просьба. Надеюсь, вы сможете обеспечить безопасность Горного короля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020310
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				},
				{
					"id": 150020310,
					"content": "Каждый ребёнок племени растёт, слушая рассказы о наших героях: от Юпанки Огненосца до Буркины и Горного короля, которые сражались с Бездной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020311
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				},
				{
					"id": 150020311,
					"content": "Это наша история и наше наследие, источник нашей гордости и центр нашей веры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020312
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				},
				{
					"id": 150020312,
					"content": "Убить Горного короля - значит уничтожить наш дух... Я никогда не смогу потом смотреть в лицо нашим предкам в Царстве Ночи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020313
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				},
				{
					"id": 150020313,
					"content": "Смерть Нанны была большой трагедией, и я не виню Тринидада за те действия, которые он совершил. Тем не менее я не могу допустить, чтобы Горному королю был причинён вред. На карту поставлены сами корни нашей идентичности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020314
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				},
				{
					"id": 150020314,
					"content": "Мои уважаемые гости, прошу вас серьёзно отнестись к этому вопросу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020315
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				},
				{
					"id": 150020315,
					"content": "Нет ли решения, которое удовлетворило бы обе стороны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020316
					]
				},
				{
					"id": 150020316,
					"content": "Возможно, оно есть. Но, несмотря на все наши попытки сдержать ситуацию на протяжении многих лет, мы так и не нашли его. Сейчас я хотел бы услышать вашу точку зрения по этому вопросу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020317,
						150020319,
						150020321,
						150020323
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				},
				{
					"id": 150020317,
					"content": "Я постараюсь выполнить вашу просьбу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020318
					]
				},
				{
					"id": 150020318,
					"content": "Хотя я чувствую, что вы ещё не приняли решение, ваши слова меня утешают. До церемонии осталось три дня. Надеюсь, вы сможете определиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				},
				{
					"id": 150020326,
					"content": "Итак, Кинич, ранее ты говорил, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150020327,
					"content": "#{NICKNAME}, Паймон, давайте пройдёмся и поговорим. Я покажу вам племя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020328
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 150020328,
					"content": "Хорошо... Паймон нужно передохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150020319,
					"content": "Я склоняюсь к тому, чтобы выполнить соглашение с Тринидадом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020320
					]
				},
				{
					"id": 150020320,
					"content": "Должен сказать, меня это беспокоит, хотя я уверен, что вам нужно больше времени, чтобы всё обдумать. Неважно, до церемонии остаётся ещё три дня. Надеюсь, вы сможете определиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				},
				{
					"id": 150020321,
					"content": "Мне нужно время, чтобы всё обдумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020322
					]
				},
				{
					"id": 150020322,
					"content": "Я понимаю. До церемонии осталось ещё три дня. Надеюсь, вы сможете определиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				},
				{
					"id": 150020323,
					"content": "Паймон, давай сегодня сбежим к какому-нибудь другому племени...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020324
					]
				},
				{
					"id": 150020324,
					"content": "#Но проблема не решится сама по себе... Паймон знает, что ты ещё не придумал{F#а}, что делать. Ничего страшного. Давай вместе что-нибудь придумаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150020325,
					"content": "Спасибо. До церемонии осталось ещё три дня. Надеюсь, вы сможете определиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "Уайна",
					"speakerSubtitle": "Вождь Потомков Крон"
				}
			]
		},
