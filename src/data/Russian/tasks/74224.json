	"talks": [
		{
			"id": 7422402,
			"completionStepIds": [
				7422402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422402",
							"2"
						],
						"stepId": 7422402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тайлефер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240201,
					"content": "Тайлефер, вот мы и встретились снова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 742240202,
					"content": "#А, это же искатель{F#ница} приключений и {F#её}{M#его} маленькая помощница. В прошлый раз я забыла спросить ваши имена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240203
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240203,
					"content": "#Паймон зовут Паймон, а {M#его}{F#её} - {NICKNAME}. Кстати, спасибо за помощь. В прошлый раз благодаря тебе нам удалось воспроизвести древнюю мелодию с помощью тубинеллы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 742240204,
					"content": "Что привело тебя в Петрикор?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 742240205,
					"content": "#Я хотела спросить у вас то же самое. Меня привели сюда слухи, но уверена, что вам, как {F#искательницам}{M#искателям} приключений, всё уже известно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240206
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240206,
					"content": "Слухи? Что за слухи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 742240207,
					"content": "Слышали важные новости из Петрикора?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240208,
						742240209
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240208,
					"content": "О том, как мы спасли мир?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				},
				{
					"id": 742240210,
					"content": "О чём это ты? Нет, нет, я говорю о том, что вновь найден легендарный Обветшалый замок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240211
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240211,
					"content": "Последние упоминания об этом месте датируются несколькими столетиями. А я-то думала, что вы здесь именно по этой причине!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240212
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240212,
					"content": "Ну, нельзя сказать, что это не имеет к нам никакого отношения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 742240213,
					"content": "В таком случае я уверена, вы знаете, что замок когда-то принадлежал Боэцию - самому значимому музыканту в истории Фонтейна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240214
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240214,
					"content": "Будь то оперы или сочинённые им партитуры древней Ремурии - все работы Боэция занимают особое место в истории музыки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240215
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240215,
					"content": "Наверняка в замке, где он когда-то жил, можно найти огромное количество творческих работ, каждый из которых является важной реликвией для нас, членов Ассоциации музыкантов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240216
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240216,
					"content": "Я поспешила сюда, как только услышала новости. Я хотела заполучить важнейшие реликвии до того, как сюда прибудут толпы искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240217
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240217,
					"content": "Но вы опередили меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240218
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240218,
					"content": "(Что ей сказать? Что Боэций на самом деле был великим злодеем, который использовал музыку, чтобы творить зло?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 742240219,
					"content": "(Расстроится ли она, узнав правду?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240220,
						742240221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 742240220,
					"content": "Симфонию больше нельзя использовать во зло.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240222,
					"content": "О чём это вы? Вы ведь не успели найти какую-нибудь древнюю партитуру?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240223
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240223,
					"content": "Что если... Паймон хочет сказать, что если бы Боэций был очень-очень плохим человеком, ты бы всё равно хотела заполучить его музыкальные партитуры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 742240224,
					"content": "Хм... Не совсем понимаю, что ты имеешь в виду, говоря, что он был «очень-очень плохим», но в истории о нём как о личности, а не только как о музыканте сказано мало добрых слов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240225
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240225,
					"content": "Из его романтической оперы «Летающий чужеземец» мы узнаём, что он не оставлял попыток возродить Ремурию, пока был жив, и, следовательно, видел в новом Фонтейне врага.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240226
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240226,
					"content": "По мнению историков, он также приложил руку к войнам, которые шли вплоть до основания Фонтейна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240227
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240227,
					"content": "Однако его музыкальные достижения - это совсем другое. В его музыке может быть заключена недостоверная история, но от этого она не теряет своей ценности для искусства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240228
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240228,
					"content": "И, как мне кажется, это тоже часть истории. Даже самое чистое искусство может быть использовано во вред, и всем музыкантам стоит помнить об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240229,
						742240231
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240229,
					"content": "#Я уверен{F#а}, что ты не станешь использовать партитуры во зло.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240230
					]
				},
				{
					"id": 742240230,
					"content": "Ха-ха, я всего лишь исследователь. Для меня большая честь хотя бы просто услышать эти древние мелодии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240233,
					"content": "Кстати, раз судьба распорядилась так, чтобы мы снова встретились, могу я попросить вас помочь мне кое с чем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240234
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240234,
					"content": "Можете считать это платой за прошлую услугу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240235,
						742240237,
						742240239
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240235,
					"content": "В прошлый раз ты сказала, что тебе не нужна оплата...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240236
					]
				},
				{
					"id": 742240236,
					"content": "В таком случае считайте это помощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240240,
					"content": "Как я говорила, я здесь, чтобы найти знаменитую потерянную оперу «Летающий чужеземец».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240241
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240241,
					"content": "Согласно записям, оставленным неким Руджеро несколько сотен лет назад, она спрятана где-то в Обветшалом замке. Вы поможете мне найти её?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240242
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240242,
					"content": "Полагаю, вы намного лучше меня разбираетесь в таких вопросах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240243
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240243,
					"content": "#Раз она просит и раз партитуры утратили свою силу... мы могли бы взяться за это дело, верно, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240244
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 742240244,
					"content": "Отлично! Будем считать, что вы согласны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240245
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240245,
					"content": "Спасибо за готовность помочь. Буду ждать вашего возвращения в деревне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240237,
					"content": "А вознаграждение будет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240238
					]
				},
				{
					"id": 742240238,
					"content": "Не волнуйся, ты получишь вознаграждение. Должна заметить, Ассоциация музыкантов - это не сборище голодранцев!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240239,
					"content": "#Я так и думал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240240
					]
				},
				{
					"id": 742240231,
					"content": "Потрясающая аргументация.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240232
					]
				},
				{
					"id": 742240232,
					"content": "Хе-хе, это всего лишь моё мнение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Тайлефер"
				},
				{
					"id": 742240221,
					"content": "Потребуется время, чтобы всё объяснить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240209,
					"content": "О знаменитом гипнозе в Петрикоре?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				}
			]
		},
		{
