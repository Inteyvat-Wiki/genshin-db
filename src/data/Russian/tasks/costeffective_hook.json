				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кайван",
					"Хельбет"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040101,
					"content": "Прошу, помогите! Мне очень нужна ваша помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040102
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040102,
					"content": "Ничего не поделаешь. Пожалуйста, уходи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040103
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040103,
					"content": "Ой, о чём спорят эти двое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731040104,
					"content": "#Эй, чужезем{F#ка}{M#ец}! Не поможешь мне отвадить эту барышню?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040105
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040105,
					"content": "Она весь день ко мне пристаёт с каким-то старьём. Говорит, ей нужна помощь, чтобы достать его со дна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040106
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040106,
					"content": "Всю рыбу мне распугала! Ещё и уходить не собирается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040107
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040107,
					"content": "Чего ты вообще так из-за этого старья переживаешь? Неужто разбогатеть захотела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040108
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040108,
					"content": "Ну нет же, господин Кайван! Меня зовут Хельбет, и я работаю в Академии Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040109
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040109,
					"content": "Академия нашла этот антиквариат и назначила меня ответственной за его сохранность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040110
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040110,
					"content": "Но вчера на корабле, что перевозил предметы старины, случилось происшествие. Несколько из них и упали в воду. А затем их и вовсе унесло куда-то вниз по течению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040111
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040111,
					"content": "Тебе надо обратиться в Ассоциацию рыболовов! Меня-то, простого рыбака, чего тюкать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040112
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040112,
					"content": "На то, чтобы найти подходящую команду, уйдёт слишком много времени. Я слышала, что Кайван по прозвищу «Непревзойдённый крюк» каждый день вылавливает пропавшие вещи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040113
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040113,
					"content": "К тому же вы часто рыбачите в этих водоёмах. Я хотела попросить вас забросить свой «Непревзойдённый крюк». Вдруг на него попадутся затонувшие реликвии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040114,
						731040115
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040114,
					"content": "В отчаянии все средства хороши.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040117
					]
				},
				{
					"id": 731040117,
					"content": "Кхе-кхе! Хельбет, я искренне соболезную тебе, но я всего лишь простой рыбак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040118
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040118,
					"content": "Удить я умею только рыбу. Именно для этого сюда и хожу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040119
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040119,
					"content": "Что-то ты пока ни одной рыбины и не поймал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731040120,
					"content": "Кхм! Я оттачиваю свои рыбацкие навыки исключительно с мыслью о рыбе и только.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040121
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040121,
					"content": "Так что лучше бы вам, барышня, попросить кого-нибудь другого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040122
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040122,
					"content": "А?.. Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040123
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040123,
					"content": "Тогда давайте так. Я больше не буду просить вас выловить мои реликвии. Вам просто нужно будет перейти в другое место. За рыбой, конечно! Идёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040124
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040124,
					"content": "Просто... просто воспринимайте меня как своего клиента, что заплатил вам за рыбалку. Умоляю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040125
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040125,
					"content": "Да сколько можно повторять! Я всего лишь простой рыбак! Ры-бак!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040126,
						731040127
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040126,
					"content": "Так какая разница, где рыбачить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040128,
					"content": "Умоляю! Ну пожалуйста! Смотрите, я уже и вознаграждение вам приготовила. Ну окажите мне услугу, пожалуйста!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040129
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040129,
					"content": "Вот пристала... Ладно уж! Что-то мне вдруг захотелось в другом месте порыбачить. Куда идти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040130
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040130,
					"content": "Огромное вам спасибо! Следуйте за мной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040131
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040131,
					"content": "#Путешественни{F#ца}{M#к}, не мог{F#ла} бы ты достать для меня наживку, пожалуйста?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040132
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040132,
					"content": "Думаю, на этот раз в состав обязательно должна входить мята. Но собрать её нужно в определённом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040133
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040133,
					"content": "Я отметил на карте примерное местоположение. Я рассчитываю на тебя. Тебя ждёт вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040134
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040134,
					"content": "Я пойду вместе с Хельбет. Встретимся в условленном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040127,
					"content": "Иногда и простым рыбакам попадается что-нибудь необычное.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040115,
					"content": "Если удочку забросит сам Кайван, то может получиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040116
					]
				},
				{
					"id": 731040116,
					"content": "Я использую удочку только для ловли рыбы! Понятно вам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040117
					],
					"speakerTitle": "Кайван"
				}
			]
		},
