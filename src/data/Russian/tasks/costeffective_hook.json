			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310404",
							"2"
						],
						"stepId": 7310404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кайван",
					"Хельбет"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040401,
					"content": "Вот это скорость. Благодарю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040402
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040402,
					"content": "Скорее же. А не то эти релик... то есть, рыбины уплывут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040403
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040403,
					"content": "А ну не лезь под руку. Сперва нужно прочувствовать каждую капельку в этом водяном потоке. А удочку следует забрасывать исключительно в умиротворённом настроении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040404
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040404,
					"content": "Посмотрим, что тут можно поймать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040405
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040405,
					"content": "Кайван насадил наживку на крючок и начал рыбачить...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040406
					]
				},
				{
					"id": 731040406,
					"content": "Спустя некоторое время вы увидели, что Кайван выудил какой-то мокрый свёрток...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040407
					]
				},
				{
					"id": 731040407,
					"content": "Что это такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040408
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040408,
					"content": "Это же... дайте взглянуть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040409
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040409,
					"content": "Ура! Это одна из пропавших реликвий! Состояние безупречное, и водные организмы ещё не успели проникнуть внутрь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040410
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040410,
					"content": "У вас получилось выудить реликвию! Вы и впрямь достойны звания «Непревзойдённого крюка»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040411
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040411,
					"content": "Ты что... меня хвалишь, что ли? А мне вот всё равно, абсолютно всё равно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040412
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040412,
					"content": "Итак, мы спасли первую реликвию. Нужно пройти чуть далее на запад. Там должна быть следующая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040413
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040413,
					"content": "Пфф... Ну идёмте уже быстрее. Мне уже не терпится поскорее вернуться к своей тихой и мирной рыбалке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040414
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040414,
					"content": "Конечно-конечно! Прошу за мной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040415
					],
					"speakerTitle": "Хельбет"
				},
				{
					"id": 731040415,
					"content": "#Путешественни{F#ца}{M#к}, на этот раз для наживки мне понадобится фрукт харра. Моя интуиция подсказывает мне, что именно он подойдёт для следующего захода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040416
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040416,
					"content": "Есть одно местечко, где растут самые лучшие фрукты харра. Давай я отмечу его на карте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040417
					],
					"speakerTitle": "Кайван"
				},
				{
					"id": 731040417,
					"content": "Мы пойдём вперёд. Встретимся на месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кайван"
				}
			]
		},
