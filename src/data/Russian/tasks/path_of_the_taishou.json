			"dialogs": [
				{
					"id": 400230101,
					"content": "#{NICKNAME}, вы пришли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230102
					],
					"speakerTitle": "Сики Тайсё"
				},
				{
					"id": 400230102,
					"content": "Я объяснил ситуацию комиссии Тэнрё и показал официальные документы того времени. В итоге они поверили, что я и Мистическая палата оммё ни в чём не виноваты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230103
					],
					"speakerTitle": "Сики Тайсё"
				},
				{
					"id": 400230103,
					"content": "Потрясающе! Значит, ты сможешь сосредоточиться на своей миссии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400230104,
					"content": "Именно так. Я даже восстановил первоначальный вид Мистической палаты оммё - места, предназначенного для оттачивания боевого мастерства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230105
					],
					"speakerTitle": "Сики Тайсё"
				},
				{
					"id": 400230105,
					"content": "Со временем подземелье может исчерпать свою магию амулетов. Когда это время наступит, я позволю ему погрузиться в сон, чтобы сила могла постепенно восстановиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230109
					],
					"speakerTitle": "Сики Тайсё"
				},
				{
					"id": 400230109,
					"content": "Самое время попробовать. Готовы принять вызов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230106,
						400230107
					],
					"speakerTitle": "Сики Тайсё"
				},
				{
					"id": 400230106,
					"content": "#Я готов{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400230108
					]
				},
				{
					"id": 400230108,
					"content": "Да! Паймон тоже в деле!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400230107,
					"content": "Вперёд!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400230108
					]
				}
			]
		}
	]
