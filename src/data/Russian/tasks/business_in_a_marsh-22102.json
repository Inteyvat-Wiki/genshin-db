			"dialogs": [
				{
					"id": 221020201,
					"content": "#Как идут дела? Избавил{F#ась}{M#ся} от монстров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020202
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221020202,
					"content": "Пока ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020203
					]
				},
				{
					"id": 221020203,
					"content": "Поторопись! У нашего повара скоро закончатся продукты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020204
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221020204,
					"content": "В самом крайнем случае мне самому придётся разбираться с этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
