				"points": []
			},
			"dialogs": [
				{
					"id": 221020101,
					"content": "Это просто кошмар...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020102
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221020102,
					"content": "Что произошло?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020103
					]
				},
				{
					"id": 221020103,
					"content": "Я не спал несколько дней... Видишь, у меня уже круги под глазами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020104
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221020104,
					"content": "Тебе довелось встретить других постояльцев? Их, мягко говоря, немного... Один чуднее другого. Недавно гость спрыгнул с крыши, а здание у нас высокое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020105
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221020105,
					"content": "Но не бери в голову. Я жду доставку продуктов из города. Она должна была прибыть с минуты на минуту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020106
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221020106,
					"content": "Но на дороге так много монстров... Может быть, ты расчистишь дорогу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020107,
						221020108
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221020107,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020109
					]
				},
				{
					"id": 221020109,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221020108,
					"content": "Это место кто-то проклял...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020110
					]
				},
				{
					"id": 221020110,
					"content": "Ну что ж... Наши двери открыты для гостей со всего континента... Мне нравится так думать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020111
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221020111,
					"content": "Мы справимся. В конце концов, это самый обычный постоялый двор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020112
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221020112,
					"content": "Спасибо за помощь. Я ценю это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				}
			]
		},
