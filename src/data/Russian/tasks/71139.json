			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мао",
					"Лин Юань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390201,
					"content": "Лазурь, Лазурь, ты не рассказала мне концовку истории в прошлый раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390202
					],
					"speakerTitle": "Мао"
				},
				{
					"id": 711390202,
					"content": "Да. Я помню. Однако я передумала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390203
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390203,
					"content": "«Передумала»? Что это значит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390204
					],
					"speakerTitle": "Мао"
				},
				{
					"id": 711390204,
					"content": "Окончание истории я оставлю... на твоё усмотрение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390205
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390205,
					"content": "Эх! Лазурь, это же жульничество! Ты обещала, что если я расскажу тебе историю, то и ты расскажешь! Почему теперь я должен рассказывать обе истории?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390206
					],
					"speakerTitle": "Мао"
				},
				{
					"id": 711390206,
					"content": "Я всего лишь глупое чудовище. Я не могу придумать хороший конец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390207
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390207,
					"content": "Концовка, которую я придумала, была плохой. Это была плохая история, которая никого не сделает счастливым. Так что лучше тебе самому придумать и рассказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390208
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390208,
					"content": "Это жульничество!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390209
					],
					"speakerTitle": "Мао"
				},
				{
					"id": 711390209,
					"content": "Я не отрицаю этого. В качестве компенсации я могу показать тебе тайные чудеса горы Линмэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390210
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390211
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390211,
					"content": "Пожалуйста, не делай такое лицо. Я позволю тебе... посидеть у меня на спине, минут пять или около того. Десять минут, ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390212
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390212,
					"content": "Хорошо, договорились! Я придумаю концовку для этой истории...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мао"
				}
			]
		},
		{
			"id": 7113903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
