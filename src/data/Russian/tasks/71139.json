					},
					{
						"sceneId": 3,
						"position": [
							1498.467,
							-44.813,
							2746.65
						],
						"pointId": 311600093
					}
				]
			},
			"dialogs": [
				{
					"id": 711390701,
					"content": "Кстати говоря, это должна быть твоя обитель, верно, Фу Цзинь? Мне кажется, что она немного отличается от других обителей Адептов, в которых мы бывали... Как бы это сказать? Она кажется более... прагматичной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390702,
					"content": "Здесь нет никаких странных механизмов или невидимых мостов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390703,
					"content": "Мне очень жаль... Я слишком смущалась раньше, и поэтому не объяснила ничего толком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390704
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390704,
					"content": "Я не могу создавать новые обители Адептов, как Адепты юга. Покои Карпа не обитель в обычном понимании, а скорее грот...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390705
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390705,
					"content": "Грот, пространство, что угодно! Это всё «обители», где живут Адепты, не так ли? Но мы даже не знаем, когда ты сможешь вернуть человеческий облик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390706,
					"content": "Вся накопленная ею сила рассеялась по этой земле. Пока какое-то время она не сможет вернуться в человеческий облик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390707
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390707,
					"content": "Со мной происходит то же самое, когда я истощаю свою силу. После смерти наставника снег падал, таял, а потом снова падал, и так бесчисленное количество раз, прежде чем я смогла вернуть себе человеческий облик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390708
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390708,
					"content": "О, так вот оно что... Погоди, Лин Юань, ты тоже можешь превращаться в человека?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390709,
					"content": "Пф! Конечно! Вы многого не знаете! Тогда, на горе Яоцзюнь, Лин Юань выглядела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390710
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390710,
					"content": "Фу Цзинь. Не стоит говорить о таких вещах. Это не имеет никакого отношения к данной теме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390711
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390711,
					"content": "Вся эта история с объеданием печеньем на храмовом празднестве в человеческом облике и упрашиванием Властительницы лекарств заварить чай для похудения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390712
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390712,
					"content": "Или как я случайно выпила праздничные напитки и притащила лесных кабанов, чтобы спросить их: «Кто красивее, я или Властительница лекарств?» Ах! Но ведь я не должна рассказывать, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390713
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390713,
					"content": "...Фу Цзинь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390714
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390714,
					"content": "Вот это да! Теперь Паймон стало любопытно. Какая ты в человеческом обличье, Лин Юань? Будешь ли ты такой же синей, как сейчас? Или ты была бы... чуть светлее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390715,
						711390717
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390715,
					"content": "И мне интересно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390716
					]
				},
				{
					"id": 711390716,
					"content": "Я не понимаю вашего любопытства. Вы сами люди. Если вас интересуют человеческие формы, посмотрите на себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390721
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390721,
					"content": "#Хе-хе... Спасибо вам, {NICKNAME} и Паймон. Я и представить себе не могла, что настанет день, когда я смогу свободно общаться с кем-то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390722
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390722,
					"content": "И в столь радостном состоянии духа я готова одарить вас защитой в вашем путешествии, гарантируя успех и большую удачу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390723
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390723,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390724
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390724,
					"content": "...Простите, я немного увлеклась. Я хотела попробовать стать похожей на других Адептов, поэтому сказала несколько высокопарных фраз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390725
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390725,
					"content": "Я останусь здесь и буду молиться, чтобы ваше путешествие было успешным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390717,
					"content": "Лин Юань, можешь на секундочку превратиться человека?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390718
					]
				},
				{
					"id": 711390718,
					"content": "Я отказываюсь. Человеческие тела слабы. Им не хватает клыков, чтобы разрывать добычу, и когтей, чтобы преследовать врагов и охотиться. Я не стану делать этого без приказа Фу Цзинь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390726,
						711390727
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390726,
					"content": "К сожалению...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390721
					]
				},
				{
					"id": 711390727,
					"content": "Фу Цзинь, надеюсь на твою помощь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390719
					]
				},
				{
					"id": 711390719,
					"content": "Правда? В таком случае, думаю, нам стоит уважать желания Лин Юань...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390720
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390720,
					"content": "У меня нет никаких желаний. Если у вас есть, скажите мне прямо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390721
					],
					"speakerTitle": "Лин Юань"
				}
			]
		},
