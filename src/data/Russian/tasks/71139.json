						],
						"pointId": 311500192
					}
				]
			},
			"dialogs": [
				{
					"id": 711390301,
					"content": "А это не Лин Юань?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390303
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390303,
					"content": "Ах, прости! Ты охотишься? Мы тебя потревожили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390304,
					"content": "Я не охочусь. Вы мне не мешаете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390305
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390305,
					"content": "Эм... Ты что, задумалась? О еде?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390306,
					"content": "Я не думала о тебе. Я просто думала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390307
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390307,
					"content": "Думала... Подожди, а что значит твоё первое высказывание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390308,
					"content": "#Я думаю о вопросе, который {NICKNAME} задал{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390309
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390309,
					"content": "«Если людские дела - часть закона природы, что ты думаешь о самих людях?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390310
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390310,
					"content": "Я уже давненько не общалась с людьми из поселения. С тех пор как Фу Цзинь и змея ушли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390311
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390311,
					"content": "Эй, ты так говоришь, будто Мао за человека не считаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390312,
					"content": "#Мао - человек, который относится к поселенцам, но не является частью поселения. Ты и {NICKNAME} относитесь к категории попутчиков, но ты не «принадлежишь» {M#своему попутчику}{F#своей попутчице}. В этом и заключается разница.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390313,
						711390315
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390313,
					"content": "Ты не считаешь Мао частью общества?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390314
					]
				},
				{
					"id": 711390314,
					"content": "Мао ещё не полностью стал частью общества. Большинство человеческих детей таковы до тех пор, пока не станут полностью поглощены порядком, как это происходит и в природе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390317,
					"content": "Я слишком долго не общалась с людьми из поселения. Возможно, из-за ненависти, возможно, из-за страха, а может, из-за того и другого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390318,
						711390319
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390318,
					"content": "Потому что они занимают землю, которая принадлежит природе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390320,
					"content": "Не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390321
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390321,
					"content": "Или, возможно, не существует явных различий между «нами» и «ими», но я не уверена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390322
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390322,
					"content": "Детёныш человека ходит со мной, а детёныши моего рода будут из любопытства ходить с людьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390323
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390323,
					"content": "Детёныш твоего рода?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390324,
					"content": "Тот ребёнок встретил смертных в горах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390325
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390325,
					"content": "Я всё ещё не могу ответить на твой вопрос. Мне нужно продолжать наблюдать за человечеством.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390326
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390326,
					"content": "Есть многое, чего я не понимаю. Я постараюсь понять, чтобы однажды, как и обещала, ответить на твой вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390319,
					"content": "Потому что Фу Цзинь пожертвовала собой ради них?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390315,
					"content": "Сложно сказать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390316
					]
				},
				{
					"id": 711390316,
					"content": "Ну, хватит уже эти странные разговоры вести!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7113904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7113904",
							"2"
						],
						"stepId": 7113904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мао",
					"Отмонтень"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390401,
					"content": "Слушая Гору, думаю, что оперы Фонтейна похожи на наши!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390402
					],
					"speakerTitle": "Мао"
				},
				{
					"id": 711390402,
					"content": "Рыцари, маги, храбрые воины и злые драконы - вы убиваете меня, я убиваю вас, и в конце концов все погибают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390403
					],
					"speakerTitle": "Мао"
				},
				{
					"id": 711390403,
					"content": "Важен не финал! Важен сам процесс! Не каждую трагедию можно рассматривать как последовательность боевых сцен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390404
					],
					"speakerTitle": "Отмонтень"
				},
				{
					"id": 711390404,
					"content": "О! И «Лемурские големы», о которых только что говорила Гора, - это очень здорово! Интересно, они больше, чем Лазурь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390405
					],
					"speakerTitle": "Мао"
				},
				{
					"id": 711390405,
					"content": "Лазурь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390406
					],
					"speakerTitle": "Отмонтень"
				},
				{
					"id": 711390406,
					"content": "О, точно! Я ведь так и не рассказал тебе о Лазури... Что, если ты расскажешь мне больше о «лемурских големах», а я расскажу тебе о Лазури!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мао"
				}
			]
		},
		{
			"id": 7113905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Фу Цзинь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390501,
					"content": "Ух ты! Нежданно-негаданно мы заполучили столько силы Адептов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390502,
						711390503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390502,
					"content": "Смотри и учись!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390505
					]
				},
				{
					"id": 711390505,
					"content": "Как говорила Фу Цзинь, всю эту силу Адептов нужно использовать на Заветном нефрите. Тогда в следующем году деревня Цяоин сможет собрать богатый урожай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390506,
					"content": "Тогда Паймон попросит дядюшку Ло приготовить для неё всевозможные вкусности! Например, чайное печенье, тушёные в соевом соусе фрикадельки, запечённую с мёдом свинину и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390507,
					"content": "О, да! И, конечно же, чайный напиток «Чэньюй»! Паймон нужно всё это записать... А? Кто там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390508,
					"content": "Фу Цзинь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390509,
					"content": "Прошу прощения. Я тебя напугала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390510
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390510,
					"content": "Ты вернула себе человеческий облик!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390511,
					"content": "Да! Разве я не говорила, что я не так уж сильно пострадала, и мне нужно всего лишь немного отдохнуть, чтобы вернуться в своё любимое обличье?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390512
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390512,
					"content": "Спасибо, что собрали всю силу Адептов для Заветного нефрита, пока я отдыхала. Обильный урожай в следующем году будет в немалой степени вашей заслугой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390513,
						711390514
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390513,
					"content": "Хе-хе, для меня это пара пустяков!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390515,
					"content": "Итак, ты вернула себе человеческий облик и тебе больше не нужно прятаться в этом тёмном месте. Что планируешь делать дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390516
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390516,
					"content": "Я ещё не думала об этом. Может, мне стоит для начала осмотреться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390517
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390517,
					"content": "Попробовать современные чаи, послушать современные оперы, посмотреть на современных людей... Простите. Я всё время выделяю слово «современный», как будто я какая-то древняя развалюха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390518
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390518,
					"content": "Хотя мне очень нравится слово «современность». В современности я могу сделать то, что не смогла сделать в прошлом. То, чего не удалось достичь раньше, все те обещания, которые не удалось сдержать, можно воплотить теперь в жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390519
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390519,
					"content": "Потом я хотела бы посетить ассамблею Гуйли и гавань Ли Юэ, чтобы посмотреть на этих милых людей и познакомиться с ними. А затем я бы не отказалась встретиться с Властительницей лекарств...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390520
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390520,
					"content": "#Хочешь, чтобы я {F#составила}{M#составил} тебе компанию?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390521
					]
				},
				{
					"id": 711390521,
					"content": "Да! Паймон помнит, что ты говорила что-то о том, что «нельзя надолго покидать чистые воды», а «нужно путешествовать только с помощью чайника Адептов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390522
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390522,
					"content": "Хе-хе... Спасибо, что помнишь об этом, и спасибо за готовность помочь мне. Однако я бы хотела остаться в долине Чэньюй подольше и вдоволь насладиться красотами и звуками родного дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390523
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390523,
					"content": "Что касается дальних путешествий, то я подумаю... Может быть, мне стоит подождать, пока малыш Мао вырастет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390524
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390524,
					"content": "Но это слишком долго!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390525
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711390525,
					"content": "Шучу! Я планирую остаться здесь на некоторое время и посмотреть, не смогу ли я убедить Лин Юань отправиться в путешествие вместе со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390526
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390526,
					"content": "#Кстати, {NICKNAME}! Пока ты здесь, я хочу кое-что сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390527
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390527,
					"content": "Тебе пришлось через многое пройти из-за меня и Лин Юань. Моя сила Адептов постепенно восстанавливается, поэтому позволь даровать тебе истинное благословение защиты в дальнейшем путешествии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390528
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390528,
					"content": "Хе-хе, готово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390529,
						711390530
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390529,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390532
					]
				},
				{
					"id": 711390532,
					"content": "#Что ж, тогда ещё раз... Спасибо вам, {NICKNAME} и Паймон. Спасибо за всё, что вы сделали для меня и долины Чэньюй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390530,
					"content": "Кажется, ничего не изменилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390531
					]
				},
				{
					"id": 711390531,
					"content": "Удача - это не то, что можно измерить на глаз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390532
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390514,
					"content": "#Рад{F#а} помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390503,
					"content": "Ничего удивительного, это же я!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390504
					]
				},
				{
					"id": 711390504,
					"content": "Эй! Всё уже давно закончилось, хватит так говорить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390505
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7113906,
