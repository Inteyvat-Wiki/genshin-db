				"points": []
			},
			"dialogs": [
				{
					"id": 711390601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390602
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390602,
					"content": "В чём дело, Лин Юань? Почему ты так на меня смотришь? У меня лицо испачкано?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390603
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390603,
					"content": "Я тут подумала... Нет, ничего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390604
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390604,
					"content": "Даже если ты и змея попросите меня об этом, я никогда больше не приму человеческий облик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390605
					],
					"speakerTitle": "Лин Юань"
				},
				{
					"id": 711390605,
					"content": "Хе-хе. Я никогда раньше не просила тебя об этом. Зачем мне это сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390606
					],
					"speakerTitle": "Фу Цзинь"
				},
				{
					"id": 711390606,
					"content": "...Забудь об этом. Пойдём. Ты сказала, что всё ещё хочешь увидеть чай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лин Юань"
				}
			]
		},
		{
			"id": 7113907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
