					}
				]
			},
			"dialogs": [
				{
					"id": 746750101,
					"content": "Какой прекрасный день, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750102
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750102,
					"content": "Вы такие знаменитые... Наверняка люди постоянно дают вам свои визитки, мечтая познакомиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750103
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750103,
					"content": "#Э-э... Ты нас знаешь? {NICKNAME}, а он довольно продвинутый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746750104,
					"content": "#Относиться к другому с пренебрежением из-за возраста - это ошибка, которую может совершить только невежа. Я надеюсь, что вы {F#обе}{M#оба} не настолько поверхностны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750105
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750105,
					"content": "Я не хотел хвастаться, но мы со старшим братом - известные местные кинорежиссёры. Все зовут меня господин Пти Люмьер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750106,
						746750107
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750106,
					"content": "Привет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750108
					]
				},
				{
					"id": 746750108,
					"content": "Верно! Я очень хочу узнать больше о ваших приключениях. В моей отрасли нужны необычные истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750109
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750109,
					"content": "Поскольку вы, по-видимому, мало знаете обо мне, позвольте рассказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750110
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750110,
					"content": "Мы с моим старшим братом достаточно давно работаем над созданием фильмов и уже успели снять несколько громких картин. Возможно, вы смотрели фильм «Выход рабочих с фабрики»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750111
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750111,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750112
					]
				},
				{
					"id": 746750112,
					"content": "О, ничего страшного. А «Прибытие аквабуса на станцию»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750113
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750113,
					"content": "Тоже нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746750114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750115
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750115,
					"content": "Понятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750116
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750116,
					"content": "...В них нет ничего примечательного. Дорога к славе и величию, по которой мы с братом идём, очень длинная. Мы обязательно снимем фильмы, которые будут ещё более популярными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750117
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750117,
					"content": "Производство фильма, построение и планирование сюжета, игра актёров, взаимодействие оператора и режиссёра, монтаж и обработка... Всё это поистине увлекательные процессы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750118
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750118,
					"content": "Самым технически сложным я считаю именно процесс съёмки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750119
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750119,
					"content": "От того, на чём вы решили сделать акцент во время съёмки, зависит, какая информация будет донесена до зрителей, какую атмосферу они почувствуют...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750120
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750120,
					"content": "Конечно, закадровый текст очень важен, но нельзя ожидать, что сюжет будет полагаться только от него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750121
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750121,
					"content": "Четыре кадра! Я всегда считал, что для построения наименьшей делимой единицы сюжета нужно всего четыре кадра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750122
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750122,
					"content": "В рамках четырёх кадров гений может творить чудеса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750123
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750123,
					"content": "Не хотите ли попробовать? Используйте эту возможность, чтобы окунуться в атмосферу блеска и очарования кинематографа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750124
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750124,
					"content": "Что нам нужно сделать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746750125,
					"content": "Это несложно! Я предложу вам несколько простых историй, которые уже изложены в виде коротких сцен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750126
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750126,
					"content": "Главное - попробовать разные способы совместить закадровый текст и работу с камерой в нескольких коротких сценах. Я вас заинтересовал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750127
					],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750127,
					"content": "Звучит интересно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750128
					]
				},
				{
					"id": 746750128,
					"content": "Чудесно! Тогда после того, как вы будете готовы, можете отправиться на места съёмок, которые я подготовил. После чего я дам вам отзывы о ваших готовых работах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пти Люмьер"
				},
				{
					"id": 746750107,
					"content": "Ты тоже хочешь дать нам свою визитную карточку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750108
					]
				}
			]
		}
	]
}