			"dialogs": [
				{
					"id": 200470301,
					"content": "Что-нибудь интересное? Что-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470302
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470302,
					"content": "#Я наш{M#ё}л{F#а} кое-что...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470303
					]
				},
				{
					"id": 200470303,
					"content": "...Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470304
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470304,
					"content": "Действительно интересно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470305
					]
				},
				{
					"id": 200470305,
					"content": "Отличные новости! Превосходно. Вот, возьми это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470306
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470306,
					"content": "Мисс Пачи! В нашем плане произошли критические изменения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дулан"
				}
			]
