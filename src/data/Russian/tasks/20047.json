			"dialogs": [
				{
					"id": 200470201,
					"content": "Вы нашли что-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470202
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470202,
					"content": "Пока ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470203
					]
				},
				{
					"id": 200470203,
					"content": "Прошу тебя, от этого зависит всё приключение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дулан"
				}
