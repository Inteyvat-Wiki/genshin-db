			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дулан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200470101,
					"content": "Не бывает приключений, которые идут строго по плану! Мы так и не сдвинемся с места, если целый день будем только планировать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470102
					],
					"speakerTitle": "Любопытная Пачи"
				},
				{
					"id": 200470102,
					"content": "Если план не идеален, то мы должны быть готовы ко всему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470103
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470103,
					"content": "О чём вы спорите?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470104
					]
				},
				{
					"id": 200470104,
					"content": "Видите ли, мы планируем исследовать <color=#00E1FFFF>храм Тысячи ветров</color>. Но мисс Пачи не совсем хватает приключенческого опыта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470105
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470105,
					"content": "Храм просто кишит монстрами, а страж руин выглядит очень серьёзно. Мы поставим наши жизни под ненужную угрозу, если будем действовать необдуманно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470106
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470106,
					"content": "Я всего лишь стараюсь обеспечить безопасность мисс Пачи. И свою собственную безопасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470107
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470107,
					"content": "Я пытаюсь убедить её в преимуществах тщательно составленного подробного плана приключения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470108
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470108,
					"content": "Боюсь, что во время предварительной разведки мисс Пачи может чересчур увлечься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470109
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470109,
					"content": "Я лучше останусь здесь и присмотрю за ней. Сможешь провести для меня разведку местности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470110,
						200470113
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470110,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470111
					]
				},
				{
					"id": 200470111,
					"content": "Славно! Изучи всё очень внимательно. Любая незамеченная мелочь может стоить нам всего приключения, а может и жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470112
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470112,
					"content": "#Ты долж{M#е}н{F#а} будешь мне это рассказать всё, что увидишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470113,
					"content": "Давай я присмотрю за мисс Пачи, а ты займёшься разведкой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470114
					]
				},
				{
					"id": 200470114,
					"content": "Нет, это невозможно! Мне нужно обсудить с ней поправки к текущему плану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470115
					],
					"speakerTitle": "Дулан"
				},
				{
					"id": 200470115,
					"content": "Помоги мне, прошу тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дулан"
				}
			]
		},
