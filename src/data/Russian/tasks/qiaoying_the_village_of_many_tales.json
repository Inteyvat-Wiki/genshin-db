						],
						"pointId": 311400061
					}
				]
			},
			"dialogs": [
				{
					"id": 700500801,
					"content": "Это и есть «фонари»? Похожи на рыб. Как интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500802
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500802,
					"content": "А рукоятки нужны, чтобы поднять фонари повыше? Гм... Конструкция разборная, если проявить смекалку и незаметно добавить пару секций, никто ничего не заподозрит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500803
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500803,
					"content": "Места внутри довольно много. Можно легко вставить туда несколько...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500804
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500804,
					"content": "Перестань! Держи свои мысли при себе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500805
					]
				},
				{
					"id": 700500805,
					"content": "А? Ой... Ха-ха, точно! Когда вижу разные интересные штуковины, сама не замечаю, как начинаю рассуждать вслух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500806
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500806,
					"content": "Да, «фонари» сделают мою книгу более фактурной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500807
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500807,
					"content": "#{NICKNAME}, могу я попросить тебя снять на камеру тот большой фонарь в виде рыбы? Снимок пригодится мне в работе над книгой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500808,
						700500809
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500808,
					"content": "Пришло время поднять моё умение работать с камерой на новую высоту...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				},
				{
					"id": 700500810,
					"content": "#Спасибо тебе, {F#путешественница}{M#путешественник}. Да, и ещё: фонарь должен попасть в кадр целиком, для меня это очень важно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500811
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500811,
					"content": "...Если закрутить интригу вокруг «размеров», выйдет довольно интересно. Но как решить проблему с весом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500809,
					"content": "Давай, я помогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				}
			]
		},
		{
			"id": 7005010,
			"completionStepIds": [
				7005010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7005010",
							"2"
						],
						"stepId": 7005010,
						"stateName": "QUEST_STATE_UNFINISHED"
