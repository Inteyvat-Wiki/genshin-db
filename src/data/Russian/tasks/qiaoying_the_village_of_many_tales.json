				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2228.768,
							286.695,
							1534.213
						],
						"pointId": 311400066
					}
				]
			},
			"dialogs": [
				{
					"id": 700501001,
					"content": "Куда подевалась Гийарра? Она ведь только что была здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501002,
						700501003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700501002,
					"content": "Её унёс зверь Сюаньвэнь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				},
				{
					"id": 700501004,
					"content": "Перестань! Наверное, она снова куда-то забрела, обдумывая сюжет новой книги. Давай поищем вокруг!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700501005,
					"content": "С чайного поля открывается хороший обзор. Давай начнём оттуда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501006
					]
				},
				{
					"id": 700501006,
					"content": "Да, сначала лучше забраться повыше! Так и сделаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700501003,
					"content": "Её вымысел воплощается в реальность?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				}
			]
		},
		{
			"id": 7005012,
			"completionStepIds": [
				7005012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7005012",
							"2"
