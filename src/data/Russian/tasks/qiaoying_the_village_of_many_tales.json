				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гийарра"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2304.876,
							292.814,
							1561.417
						],
						"pointId": 311400064
					}
				]
			},
			"dialogs": [
				{
					"id": 700501201,
					"content": "Гийарра! Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700501202,
					"content": "...Нет, нет. Нельзя, чтобы они просто так наткнулись на главную подсказку. И вообще, разве человек может нормально соображать, если всю ночь провёл здесь связанным?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501203
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501203,
					"content": "Ого... Гийарра поглощена сюжетом новой книги. Наверное, она нашла мощный источник вдохновения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700501204,
					"content": "Или натолкнулась на серьёзное препятствие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501205
					]
				},
				{
					"id": 700501205,
					"content": "#{NICKNAME}, Паймон, вы как раз вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501206
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501206,
					"content": "Не могли бы вы привязать меня к столбу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501207
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501207,
					"content": "Ч-что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700501208,
					"content": "Я хотела попросить вас связать мне руки и подвесить за них к дереву. Ну да, дерево или столб, какая разница.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501209
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501209,
					"content": "#Я не хочу стать {M#подозреваемым}{F#подозреваемой} из твоего романа.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501210
					]
				},
				{
					"id": 700501210,
					"content": "Тебе не о чем беспокоиться! Я уже подготовила специальное письмо о том, что беру на себя ответственность за всё, что может со мной случиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501211
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501211,
					"content": "Нет, не в этом дело! Почему тебе вдруг пришло в голову, что мы должны тебя связать? Ты ничего плохого не делала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700501212,
					"content": "Но главного героя моего романа ждёт именно такая судьба! Деревенские подвесят его за руки к столбу и оставят так на всю ночь, чтобы зверь Сюаньвэнь вынес свой приговор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501213
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501213,
					"content": "Но дальше главный герой, знавший заранее о том, что его ждёт, найдёт способ пережить эту ночь и откроет людям правду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501214
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501214,
					"content": "...Но я понятия не имею, что будет чувствовать человек, провисевший всю ночь на столбе. Как он будет говорить, думать, двигаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501215
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501215,
					"content": "Поэтому я хочу, чтобы вы привязали меня и оставили здесь на всю ночь. Так я смогу понять его ощущения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501216,
						700501217
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501216,
					"content": "Нет, это слишком опасно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				},
				{
					"id": 700501218,
					"content": "...Гм. Есть и другой способ, но я не уверена, что он сработает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501219
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501219,
					"content": "Я могу не висеть, а просто простоять здесь всю ночь с поднятыми руками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501220
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501220,
					"content": "Ох... Гийарра, брось ты эту книгу. Если нас увидят, мы замучаемся объяснять, что тут на самом деле происходит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700501221,
					"content": "Твоему главному герою не позавидуешь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501222
					]
				},
				{
					"id": 700501222,
					"content": "Прошу вас! Это главное звено сюжета! С ним мой роман будет почти готов! И вам не придётся совершать никаких преступлений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501223
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501223,
					"content": "Мы и не собирались!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700501224,
					"content": "Мы и не собирались!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501225
					]
				},
				{
					"id": 700501225,
					"content": "Ну... Я хотела сказать, это не отнимет у вас много сил. Просто побудьте рядом со мной, чтобы никакой человек... или зверь не утащил меня, пока я собираю фактуру для книги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501226
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501226,
					"content": "Посмотрим... Чтобы создать нужную атмосферу, нужно забраться ещё выше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501227
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501227,
					"content": "Что? Эй, нас подожди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700501228,
					"content": "Вы с Гийаррой забираетесь на самый верх чайного поля...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501229
					]
				},
				{
					"id": 700501229,
					"content": "Фух... А здесь прохладно... Но какие яркие ощущения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501230
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501230,
					"content": "Ты правда собираешься простоять здесь всю ночь с поднятыми руками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700501231,
					"content": "Да, я уже решила. Искусство требует жертв...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501232
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501232,
					"content": "Постойте, пожалуйста, рядом со мной, всего одну ночь... Всего одну ночь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700501217,
					"content": "Нет другого, более безопасного способа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				}
			]
		},
