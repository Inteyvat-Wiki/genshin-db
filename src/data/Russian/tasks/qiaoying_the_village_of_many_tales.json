						"position": [
							2163.671,
							286.632,
							1547.632
						],
						"pointId": 311400056
					}
				]
			},
			"dialogs": [
				{
					"id": 700500501,
					"content": "...Видишь? Паймон же говорила, это обычный котёнок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700500502,
					"content": "Не могу поверить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500503
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500503,
					"content": "Мяу? Мяу... Мяу-мяу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500504,
						700500506
					],
					"speakerTitle": "Озадаченный котёнок"
				},
				{
					"id": 700500504,
					"content": "Ты знаком со зверями Сюаньвэнь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500505
					]
				},
				{
					"id": 700500505,
					"content": "Мяу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Озадаченный котёнок"
				},
				{
					"id": 700500508,
					"content": "Котёнок разворачивается и сердито уходит...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500509
					]
				},
				{
					"id": 700500509,
					"content": "И всё равно... Быть может, это вовсе не котёнок, а детёныш зверя Сюаньвэнь? Сейчас он мирно живёт в деревне Цяоин, а потом вырастет и сожрёт все чайные кусты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500510
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500510,
					"content": "Госпожа Гийарра, снова вы... Послушайте, я ведь говорила, Сюаньвэнь - опасный зверь, он так просто к себе не подпустит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500511
					],
					"speakerTitle": "Хун Фэнь"
				},
				{
					"id": 700500511,
					"content": "О, госпожа Хун Фэнь, какое совпадение! Что вас сюда привело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500512
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500512,
					"content": "Ох... Перестаньте рассуждать здесь о преступлениях, очень вас прошу. Вдруг дети отнесутся к вашим словами серьёзно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500513
					],
					"speakerTitle": "Хун Фэнь"
				},
				{
					"id": 700500513,
					"content": "Вы знакомы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500514
					]
				},
				{
					"id": 700500514,
					"content": "Да. Когда я прибыла сюда, госпожа Хун Фэнь помогла мне с багажом. И подробно проконсультировала о местном фольклоре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500515
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500515,
					"content": "Я уже много раз говорила, что зверь Сюаньвэнь никогда не появится в деревне, но вы не хотите слушать. Мало того...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500516
					],
					"speakerTitle": "Хун Фэнь"
				},
				{
					"id": 700500516,
					"content": "Пусть даже в деревне их нет, у меня имеются и другие способы собрать материал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500517
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500517,
					"content": "Ну вот, опять... Госпожа Гийарра, переубеждать вас бесполезно. Но всё же я хочу попросить вас не отправляться на поиски за пределами деревни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500518
					],
					"speakerTitle": "Хун Фэнь"
				},
				{
					"id": 700500518,
					"content": "В действительности звери Сюаньвэнь очень опасны, и, если один из них повстречается вам на пути... Гм... Словом, ни в коем случае не уходите из деревни без сопровождения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500519
					],
					"speakerTitle": "Хун Фэнь"
				},
				{
					"id": 700500519,
					"content": "Хун Фэнь уходит. Она выглядит ещё более измотанной, чем котёнок, за которым вы гнались.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500520
					]
				},
				{
					"id": 700500520,
					"content": "Ну, раз госпожа Хун Фэнь так настаивает, нам придётся отправиться на поиски фактуры в другое место. За мной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500506,
					"content": "Извини, мы обознались.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500507
					]
				},
				{
					"id": 700500507,
					"content": "Мяу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Озадаченный котёнок"
				}
			]
		},
		{
			"id": 7005006,
			"completionStepIds": [
				7005006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7005006",
							"2"
						],
						"stepId": 7005006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гийарра"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2276.275,
							287.313,
							1542.857
						],
						"pointId": 311400058
					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "Как вам? Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500602,
					"content": "Чайный котёл.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "Точно! Чайный... чайный котёл? Очень оригинально! И он стоит ровно посередине деревни, так что наверняка это не просто котёл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500604,
					"content": "Гм... А что если... В нём и живёт зверь Сюаньвэнь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500605,
					"content": "Знаешь, это уже больше похоже на фантастический роман.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "Если так пойдёт дальше, в твоей книге скоро появится кто-то из Адептов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700500608,
					"content": "Не думаю, что такая тема подходит для криминального романа...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "...Вот именно! Именно такой реакции я и хочу! Наверное, вам кажется, что криминальный роман, сюжет которого разворачивается вокруг зверя Сюаньвэнь, покажется читателю слишком «абсурдным»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500610,
					"content": "Ну, вообще-то да. Как можно строить сюжет криминального романа вокруг какого-то легендарного зверя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700500611,
					"content": "Подожди, или ты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#Ха-ха, {NICKNAME}, ты очень {F#догадлива}{M#догадлив}. Ты оправдываешь свою репутацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500613,
					"content": "Именно! Я хочу написать роман о таком абсурдном преступлении, что в него почти невозможно поверить. У вас была очень интересная реакция, как и у госпожи Хун Фэнь. Я обязательно включу этот эпизод в свою книгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500614,
					"content": "Ну, а зверь Сюаньвэнь... Ему отведена роль преступника! Легендарный зверь, который пожирает деревенских злодеев, но всегда остаётся незамеченным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500615,
					"content": "Во время очередного праздника люди находят своего односельчанина убитым за пределами деревни. Его растерзал какой-то дикий зверь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500616,
					"content": "Но на второй день праздника главный герой встречает погибшего, который должен быть мёртв, но оказался жив, а вскоре после этого появляется новая жертва...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500617,
					"content": "А потом? Что потом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700500618,
					"content": "Я ещё не придумала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500619,
					"content": "...Мне пора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "Ну ладно тебе! Когда допишу, непременно пришлю вам по книге с автографом. На самом деле я хотела попросить вас об одном одолжении!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500621,
					"content": "Госпожа Хун Фэнь сказала, что мне не стоит уходить из деревни без сопровождения. И я запомнила её слова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500622,
					"content": "Но... если мы пойдём вместе, получится, что у меня есть самое настоящее сопровождение! И я могу погулять по окрестностям!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500623,
					"content": "Конечно, далеко мы не пойдём! Ну что, согласитесь меня выручить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500624,
					"content": "Ладно... Только чтобы узнать, чем закончится история.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "Ну что, в путь? Давайте пойдём в ту сторону. Там есть одно интересное местечко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500625,
					"content": "Оплату услуг принимаем по стандартной схеме.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "Конечно! Об этом не переживайте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
					],
					"speakerTitle": "Гийарра"
				},
				{
					"id": 700500606,
					"content": "Ты уверена, что пишешь криминальный роман?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				}
			]
		},
		{
			"id": 7005008,
			"completionStepIds": [
				7005008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
