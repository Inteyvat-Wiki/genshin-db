			},
			"dialogs": [
				{
					"id": 722460301,
					"content": "Госпожа Сумида, вы уже придумали, куда мы отправимся дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460302
					],
					"speakerTitle": "Кама"
				},
				{
					"id": 722460302,
					"content": "Я слышала, что в Мондштадте находится очень большая библиотека...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сумида"
				}
			]
		},
		{
			"id": 7224604,
