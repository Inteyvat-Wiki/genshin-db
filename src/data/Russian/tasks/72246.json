						],
						"stepId": 7224602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сумида",
					"Кама"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460101,
					"content": "Какой красивый браслет! Какая красивая ваза! Товары из Ли Юэ очень красивы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460102
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460102,
					"content": "Подождите, нет. Эти простые термины не подходят такому романисту, как я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460103
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460103,
					"content": "Возможно, мне следует купить самую изысканную вазу, чтобы использовать её в качестве справочного материала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460104
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460104,
					"content": "Да, именно так я и напишу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460105
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460105,
					"content": "«Поворотным моментом стал Глаз Бога, спрятанный в вазе!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460106
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460106,
					"content": "Да, это может быть очень интересно! Что ты думаешь, Кама?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460107
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460107,
					"content": "Госпожа Сумида, я не думаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460108
					],
					"speakerTitle": "Кама"
				},
				{
					"id": 722460108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460109
					],
					"speakerTitle": "Кама"
				},
				{
					"id": 722460109,
					"content": "По моему личному мнению, описание вазы должно быть умеренным. Преувеличенное описание станет слишком очевидным. Краткое описание оставит читателя неудовлетворенным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460110
					],
					"speakerTitle": "Кама"
				},
				{
					"id": 722460110,
					"content": "Хм, ты прав! Это надо записать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460111
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460111,
					"content": "Прошу прощения! Давайте найдём другое место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460112
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460112,
					"content": "И ещё, я тысячу раз просила не называть меня госпожой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460113
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460113,
					"content": "С другой стороны, когда один из путешественников называет другого госпожой, это тоже не такое уж редкое развитие сюжета, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сумида"
				}
			]
		},
		{
			"id": 7224602,
			"completionStepIds": [
				7224603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224603",
							"2"
						],
						"stepId": 7224603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сумида",
					"Кама"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460201,
					"content": "Ах, это изумительно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460202
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460202,
					"content": "Её по праву называют самой большой библиотекой на севере! Когда у меня будет возможность, я прочту залпом всю «Меланхолию Веры»! Это великолепно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460203
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460203,
					"content": "Госпожа Сумида, держите себя в руках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460204
					],
					"speakerTitle": "Кама"
				},
				{
					"id": 722460204,
					"content": "Прости. Я слишком взволнована...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460205
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460205,
					"content": "Я просто боюсь, что вы можете пострадать. Эта дама-библиотекарь, похоже, очень могущественна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460206
					],
					"speakerTitle": "Кама"
				},
				{
					"id": 722460206,
					"content": "Правда? Я подумала, что она обычная ленивая ведьма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460207
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460207,
					"content": "Хм, дай-ка подумать. Подобные персонажи, как правило, самые сильные. Лучше не нарываться на неё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460208
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460208,
					"content": "Вообще-то, я могла бы написать историю, основанную как раз на таком персонаже. Что-то вроде «Маг великой библиотеки»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460209
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460209,
					"content": "Как ваше путешествие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460210
					]
				},
				{
					"id": 722460210,
					"content": "Давно не виделись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460211
					],
					"speakerTitle": "Кама"
				},
				{
					"id": 722460211,
					"content": "#О, {F#прославленная}{M#прославленный} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460212
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460212,
					"content": "Наше путешествие... Знаете, раньше я часто отправлялась в путешествия, чтобы собрать материал для книг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460213
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460213,
					"content": "Я училась описывать грозы в ущелье Мусодзин. Я была на голове змея, чтобы описать демонического змея. Я уговорила Каму вступить в армию, чтобы лучше понять жизнь мятежников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460214
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460214,
					"content": "Бедный Кама...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460215
					]
				},
				{
					"id": 722460215,
					"content": "Я в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460216
					],
					"speakerTitle": "Кама"
				},
				{
					"id": 722460216,
					"content": "Но это путешествие. Оно настоящее. У него нет никакой цели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460217
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460217,
					"content": "Я только сейчас поняла, что в этом мире, как и в «Путешествиях Кино», есть много интересного, о чём стоит написать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460218
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460218,
					"content": "Мы с Камой посетили известные достопримечательности и магазины. После чего разбили лагерь в дикой природе, обменивались историями с незнакомыми путешественниками у костра...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460219
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460219,
					"content": "А когда мы проснулись, то обнаружили, что все наши вещи пропали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460220
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460220,
					"content": "Вы их нашли?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460221
					]
				},
				{
					"id": 722460221,
					"content": "Да. Мы нашли банду воров. Когда выяснилось, что в банде десять человек, я подумала, что не видать нам больше своих вещей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460222
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460222,
					"content": "Но Кама каким-то непостижимым образом уговорил их вернуть вещи. Они даже дали ему монету с изображением ворона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460223
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460223,
					"content": "Я подумала, что из этого может получиться отличная история, но Кама отказался рассказать мне подробности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460224,
						722460225
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460224,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				},
				{
					"id": 722460226,
					"content": "Я просто сделал то, что должен был. Вам не стоит беспокоиться ни о чём, госпожа Сумида.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460227
					],
					"speakerTitle": "Кама"
				},
				{
					"id": 722460227,
					"content": "Кама, на тебя действительно можно положиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460228
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460228,
					"content": "Когда ты рядом, я уверена, что нам не грозят никакие неприятности. Даже если наше приключение приведёт нас на край света!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460229
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460229,
					"content": "Кстати, ты очень изменился после инцидента на острове Цуруми. Появились вещи, которые ты хочешь попробовать, появилось собственное мнение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460230
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460230,
					"content": "Госпожа Сумида, если это вам не нравится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460231
					],
					"speakerTitle": "Кама"
				},
				{
					"id": 722460231,
					"content": "Я думаю, что это великолепно! Твоё мнение стоит того, чтобы принять его во внимание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460232,
						722460233
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460232,
					"content": "Не буду вам мешать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460234,
					"content": "#Увидимся, {NICKNAME}. Давайте встретимся в конце, как в «Цветах для принцессы Фишль».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460235
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460235,
					"content": "#{NICKNAME}, спасибо! Береги себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кама"
				},
				{
					"id": 722460233,
					"content": "Возможно, мы встретимся снова.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460225,
					"content": "Кама человек многих талантов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				}
			]
		},
		{
			"id": 7224603,
			"completionStepIds": [],
