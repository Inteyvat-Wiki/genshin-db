				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460401,
					"content": "«Мир огромен и бесконечен...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460402
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460402,
					"content": "Это цитата из «Дзёрури Кидотай»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460403
					],
					"speakerTitle": "Кама"
				},
				{
					"id": 722460403,
					"content": "Да. У тебя хорошая память.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460404
					],
					"speakerTitle": "Сумида"
				},
				{
					"id": 722460404,
					"content": "Вы рассказали мне эту историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кама"
				}
			]
		}
	]
