				"points": []
			},
			"dialogs": [
				{
					"id": 20040101,
					"content": "Давай посмотрим, где же этот человек, о котором говорила Аяка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20040102,
					"content": "Зачем вам это? Столько лет и вдруг - уходите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040103
					],
					"speakerTitle": "Махиру"
				},
				{
					"id": 20040103,
					"content": "Верно, мы совсем не были к этому готовы, и вдруг эта новость...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040104
					],
					"speakerTitle": "Кэндзиро"
				},
				{
					"id": 20040104,
					"content": "Дети так мечтают, что вы ещё с ними поиграете... Прошу вас, подумайте об этом ещё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040105
					],
					"speakerTitle": "Кэндзиро"
				},
				{
					"id": 20040105,
					"content": "Это, наверное, о нём говорила Аяка. Пойдём посмотрим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 200402,
			"completionStepIds": [
				200402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200402",
							"2"
						],
						"stepId": 200402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040201,
					"content": "Кажется, это дневник Тэдзимы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20040202,
					"content": "Давай посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20040203,
					"content": "«Сегодня мы с деревенскими пошли жарить вяленую рыбу, но я не уследил, и всё подгорело, пришлось сказать, что это просто сорт рыбы такой».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20040204,
					"content": "«Сегодня я спас ребёнка, который упал в воду. Он сказал, что его друг Хофу всё ещё в воде. Я полдня искал, а потом оказалось, что так звали его домашнего краба».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20040205,
					"content": "«Сегодня я запускал воздушного змея, но нитка оборвалась, и я долго за ним гнался. Я понял, что мне его не поймать, нашёл где присесть и просто смотрел, как он улетает всё дальше и дальше».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20040206,
					"content": "Хм... Это просто истории об обычной деревенской жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20040207,
					"content": "А? Подожди! Вот эта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20040208,
					"content": "«Сегодня я снова пошёл молиться в святилище и долго там пробыл. Омамори, что ты мне подарила, уже немного выцвел, но это всё равно самое ценное, что у меня есть...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20040209,
					"content": "Эта информация нам может пригодиться! Пойдём сходим в святилище!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 200403,
			"completionStepIds": [
				200403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
