			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ясухико Таро"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726860101,
					"content": "Могу я узнать ваше имя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860102
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860102,
					"content": "#Меня зовут {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860103
					]
				},
				{
					"id": 726860103,
					"content": "Отлично, я записал. Могу я спросить, готовы ли вы рискнуть своей честью воина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860104,
						726860105
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860104,
					"content": "Стоп, что?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				},
				{
					"id": 726860106,
					"content": "А? Значит, разве вы не воин, решивший принять участие в состязании?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860107
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860107,
					"content": "Впервые слышу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860108
					]
				},
				{
					"id": 726860108,
					"content": "Вы не слышали о «Дуэли на мечах»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860109
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860109,
					"content": "Невозможно, я же расклеивал объявления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860110
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860110,
					"content": "И где именно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726860111,
					"content": "Вот здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860112
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860112,
					"content": "Но это же бесполезно! Их же никто не увидит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726860113,
					"content": "Это всё комиссия Ясиро виновата! Придумали тут правило «никакого оружия и сражений во время праздника». Я попытался организовать дуэли на Рито, но они отказались, и рекламу вешать запретили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860114
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860114,
					"content": "Поэтому пришлось установить арену здесь, а указатель поставить неподалёку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860115
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860115,
					"content": "В общем, у нас уже четверо участников. С вами получается пятеро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860116
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860116,
					"content": "#Так кто-то и вправду решил поучаствовать. Странно. Кстати, Паймон тоже не помнит, зачем ты сюда {M#пришёл}{F#пришла}, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726860117,
					"content": "Вы смогли найти это место без каких-либо подсказок. Это значит, что вы могучий воин со стойким духом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860118
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860118,
					"content": "Те, кто жаждет достичь вершин воинского мастерства, всегда будут притягиваться друг к другу. Так уж устроен мир, и этому не стоит удивляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860119
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860119,
					"content": "Паймон понятия не имеет, в каком мире ты живёшь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726860120,
					"content": "Итак, вы хотите принять участие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860121
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860121,
					"content": "Если сможете победить всех четырёх соперников, то получите награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860122
					],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860122,
					"content": "Я подумаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860123
					]
				},
				{
					"id": 726860123,
					"content": "Хорошо, не торопитесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ясухико Таро"
				},
				{
					"id": 726860105,
					"content": "О, нет-нет, прощайте.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				}
			]
		}
	]
}