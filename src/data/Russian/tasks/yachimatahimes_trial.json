			"dialogs": [
				{
					"id": 722690101,
					"content": "#Я Эки из дзибасири. Герой Сангономии, ты досто{F#йна}{M#ин} принять испытание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690102
					],
					"speakerTitle": "Эки"
				},
				{
					"id": 722690102,
					"content": "Я отвечаю за испытание проницательности. Разгадай все головоломки, чтобы вернуть Огни высоких врат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Эки"
				},
				{
					"id": 722690103,
					"content": "Поле боя непрестанно меняется. Держи ухо востро, а глаза широко раскрытыми, чтобы понять ситуацию и совладать с неизвестностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Эки"
				}
			]
