				"points": []
			},
			"dialogs": [
				{
					"id": 705330101,
					"content": "Вот это сюрприз! Кто бы мог подумать, что моё изобретение можно использовать таким образом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330102
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705330102,
					"content": "#Привет, путешественни{F#ца}{M#к}! Рад тебя снова видеть. Кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330103,
						705330105
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705330103,
					"content": "#Я думал{F#а}, ты покинул Мондштадт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330104
					]
				},
				{
					"id": 705330104,
					"content": "Да, таков был план, но... Всё меняется, знаешь ли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705330108,
					"content": "Ладно, не будем об этом. Давай поговорим о деле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330109
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705330109,
					"content": "На этот раз мондштадтская Гильдия искателей приключений пригласила меня, чтобы я создал несколько механических картин. Они основаны на дизайне карт, и их можно будет разбирать и собирать снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330110
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705330110,
					"content": "Карточная игра называется... Как же она называется? А, точно, «Священный призыв семерых».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330111
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705330111,
					"content": "По словам Гильдии, эти картины будут использовать как мини-игру в каком-то Гран-при Короля священного призыва, чтобы немного разрядить атмосферу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330112
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705330112,
					"content": "Ох, это всё слишком сложно для меня. Мне следует сосредоточиться на своих изобретениях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330113
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705330113,
					"content": "Ах да, картины, которые я сделал в Мондштадте, у меня с собой. Если хочешь, можешь пока их пособирать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705330105,
					"content": "С изобретением опять что-то не заладилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330106
					]
				},
				{
					"id": 705330106,
					"content": "Нет, не в этот раз. Кхе... Правильнее было бы сказать, что с ним никогда не было никаких проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330107
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705330107,
					"content": "В прошлый раз, когда мне понадобилась твоя помощь, проблема была с монстрами, а не с изобретением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Феликс Йог"
				}
			]
		}
	]
}