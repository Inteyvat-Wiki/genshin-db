							"2200901",
							"2"
						],
						"stepId": 2200901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сорайя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220090101,
					"content": "Похитители сокровищ совсем распоясались...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090102
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090102,
					"content": "Ты меня ищешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090103
					]
				},
				{
					"id": 220090103,
					"content": "#Да. У меня к тебе дело. Та Бао Эр, о которой ты упоминал{F#а} ранее... Тщательное расследование показало, что она - Похититель сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090104
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090104,
					"content": "Она действовала в одиночку, потому что хотела заграбастать все сокровища себе. Или служила авангардом для главных сил Похитителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090105
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090105,
					"content": "Выходит, она ещё и мастер маскировки, раз так ловко обвела вокруг пальца опытного искателя приключений вроде тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090106
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090106,
					"content": "Если её не остановить, а в придачу мы ещё имеем свирепствующих в округе Похитителей сокровищ, то все реликвии поблизости окажутся под угрозой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090107
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090107,
					"content": "#Поэтому я хотела бы, чтобы ты их остановил{F#а}. Даже если не получится справиться со всеми ними, так хоть спасём парочку реликвий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090108,
						220090110,
						220090117
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090108,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090109
					]
				},
				{
					"id": 220090109,
					"content": "Благодарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090110,
					"content": "Откуда тебе известно, где они?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090111
					]
				},
				{
					"id": 220090111,
					"content": "Если моя догадка верна, то эта группа Похитителей сокровищ следует за мной по пятам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090112
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090112,
					"content": "Я привожу их к сокровищам, а этим жадным негодяям всё мало!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090113
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090113,
					"content": "Где бы я ни остановилась, они начинают там рыть, рассчитывая найти что-нибудь ценное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090114
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090114,
					"content": "Где они появятся, узнать несложно, нужно лишь чуток подумать. Но мне, как учёному, такие умозаключения даются легко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090115
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090115,
					"content": "Вот только бой совсем не по моей части. Это удел опытных искателей приключений вроде тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090116
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090116,
					"content": "Пожалуйста, скорее верни эти реликвии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090117,
					"content": "Я с ними разберусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090118
					]
				},
				{
					"id": 220090118,
					"content": "Пожалуйста, подожди. Их нужно остановить, но сразу раскрывать свои карты перед Бао Эр не следует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090119
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090119,
					"content": "Похитители сокровищ действуют разрозненно, и выследить их тяжело. Теперь, когда тебе удалось войти к ним в доверие, нам выпала редкостная возможность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090120
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090120,
					"content": "Они в долине Гуйли неспроста. Не отходи от Бао Эр, вдруг удастся выяснить их планы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090121
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090121,
					"content": "Поэтому продолжай действовать под прикрытием. Я уверена, что ты найдёшь их уязвимое место, и... быстро со всем покончишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090122
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090122,
					"content": "Запомни: бери реликвии и сразу же уходи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				}
			]
		},
