				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сорайя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220090301,
					"content": "Ну, как всё прошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090302
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090302,
					"content": "Вот реликвии.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090303
					]
				},
				{
					"id": 220090303,
					"content": "Ух, я так и думала. Они и правда шли за мной по пути моего исследования и копали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090304
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090304,
					"content": "В раскопках они ничего не смыслят, но зато их много. Куча людей с лопатами в конце концов на что-нибудь да и наткнётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090305
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220090305,
					"content": "Благодарю тебя. Если бы не ты, кто знает, что бы с этими реликвиями произошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				}
			]
		}
	]
}