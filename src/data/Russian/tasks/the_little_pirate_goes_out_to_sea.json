			},
			"dialogs": [
				{
					"id": 210270201,
					"content": "#Путешественни{F#ца}{M#к}? Малыш Мэн? Чем могу вам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 210270202,
					"content": "#Э-э-э... Ну... {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270203,
					"content": "Пусти к себе на кухню, пожалуйста.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "Ну конечно. А почему вы вдруг решили готовить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 210270205,
					"content": "Вот как... Ну, пользуйтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 210270206,
					"content": "Попутешествуешь - больше не будешь таким привередливым в еде, малыш Мэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 210270207,
					"content": "Да, я тоже так думаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270208,
					"content": "#{NICKNAME}, научи меня вкусно готовить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270209,
					"content": "Когда мы с папой отправимся в путешествие, я его удивлю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270210,
					"content": "Так держать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210270211,
					"content": "#{NICKNAME}, что приготовим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
