			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Малыш Мэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270101,
					"content": "#{NICKNAME}! Хорошо, что ты здесь, а то я уже думал самому идти искать тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270102,
					"content": "Малыш Мэн, что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210270103,
					"content": "В прошлый раз мы с тобой бросили бутылку с моей запиской...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270104,
					"content": "Я ни на что не надеялся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270105,
					"content": "И тут несколько дней назад мой отец сказал, что к нему вдруг обратился один из его деловых партнёров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270106,
					"content": "Хотят начать вести грибной бизнес. Едут в Сумеру, чтобы изучить рынок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270107,
					"content": "Они спросили моего отца, не хочет ли он съездить с ними...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270108,
					"content": "...и взять меня с собой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270109,
					"content": "Папа сначала не согласился, но... дядя внезапно достал письмо и сказал, что ему нужно поговорить с моим отцом наедине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270110,
					"content": "А потом отец согласился взять меня с собой в Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270111,
					"content": "Я не знаю, почему отец внезапно передумал... но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270112,
					"content": "#Я поеду в Сумеру! В Сумеру! {NICKNAME}, это невероятно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270113,
					"content": "Мои поздравления!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "#Должно быть, бутылка с посланием помогла. Спасибо, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270117,
					"content": "Папа сказал, что после Сумеру они отправятся в деревню Цяоин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270118,
					"content": "Деревня Цяоин?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "Э-э, папа сказал, что это деревня, где есть чайная плантация. Такое название действительно сложно запомнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270120,
					"content": "Но пока не будем об этом. Прежде нужно попасть в Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270121,
					"content": "Сумеру далеко. Должно быть, раньше путешествия занимали не один день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270122,
					"content": "Говорят, к путешествию следует тщательно подготовиться. Дорога дальняя, в пути всякое может произойти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270123,
					"content": "#{NICKNAME}, ты часто путешествуешь. Поделись советами, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270124,
					"content": "Например...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270125,
					"content": "Что обычно едят в дороге?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270126,
					"content": "Папа сказал мне, что они готовят сами. Но я знаю только несколько простых блюд. Не уверен, насколько они хороши...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270127,
					"content": "#О-хо-хо; Готовка! А мы ж спецы в кулинарии, да, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210270128,
					"content": "Я научу тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "Сперва нужно найти очаг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210270131,
					"content": "Думаю... мы можем попросить шеф-повара Мао, чтобы он пустил нас на свою кухню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210270132,
					"content": "Шеф-повар Мао? Он выглядит довольно страшным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270133,
					"content": "Почему? Нет, он очень хороший.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210270134,
					"content": "Д-да? Но каждый раз, как мы с отцом там кушали и я выбирал из еды цветы цинсинь, он хмурился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 210270129,
					"content": "Положись на меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "Может, я тоже поеду в Сумеру.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "Да? Давайте поедем все вместе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Малыш Мэн"
				}
			]
		},
