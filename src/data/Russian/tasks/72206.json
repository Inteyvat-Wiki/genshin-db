			"dialogs": [
				{
					"id": 722060401,
					"content": "Как дела? Я готов к расширению своего мировоззрения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060402
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060402,
					"content": "Эти грибы подойдут?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7220605,
			"completionStepIds": [
				7220607
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220607",
							"2"
						],
						"stepId": 7220607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Абэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060501,
					"content": "О! Ха-ха... Ух ты, у них такая странная форма! У них тоже есть душа? В них хранятся воспоминания людей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060502
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060502,
					"content": "А эти мягкие, похожие на крылья штуки... Они могут летать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060503
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060503,
					"content": "Ох уж моё бесконечное любопытство! Лодочник, должно быть, уже начинает злиться. Думаю, мне пора идти. Да, пора сесть в лодку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Абэ"
				}
			]
		}
	]
}