			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Абэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060101,
					"content": "Эй! Я здесь, знаешь ли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060102
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060102,
					"content": "Что такое с нынешней молодежью? Ни капли вежливости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060103,
						722060105
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060103,
					"content": "П-простите меня!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060104
					]
				},
				{
					"id": 722060104,
					"content": "Так-то лучше. Что касается этих грибов, давайте просто назовём это моим подарком... Но остальное не трогай, понятно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060105,
					"content": "Это ваши грибы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060106
					]
				},
				{
					"id": 722060106,
					"content": "Тебе какое дело? Просто прекрати срывать их, когда тебе вздумается, и убирайся отсюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Абэ"
				}
			]
		},
		{
			"id": 7220602,
			"completionStepIds": [
				7220603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
