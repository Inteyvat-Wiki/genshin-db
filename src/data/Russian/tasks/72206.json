				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060201,
					"content": "#Ох! Он только что... Ты это видел{F#а}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060202,
						722060203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722060202,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				},
				{
					"id": 722060204,
					"content": "Страшно-то как! Давай просто возьмём пару грибов и уйдём отсюда, хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722060203,
					"content": "Это иллюзия.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				}
			]
		},
		{
			"id": 7220603,
			"completionStepIds": [
				7220605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220604",
							"3"
						],
						"stepId": 7220604,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220605",
							"2"
						],
						"stepId": 7220605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Абэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060301,
					"content": "Эй! Разве я не предупреждал вас?! Вы глухие или слепые, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060302
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060302,
					"content": "Смотри, это призрак!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060303
					]
				},
				{
					"id": 722060303,
					"content": "Что? Призрак? Где он?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060304,
						722060305
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060304,
					"content": "Вот прямо здесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				},
				{
					"id": 722060306,
					"content": "А-а-а-а! Уходи! Изыди! Именем моего клана Абэ! Уходи отсюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060307
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060307,
					"content": "Абэ! Абэ! За всю свою жизнь я не встречал такого злого духа! Почему ты не уходишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060308
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060308,
					"content": "Я - дух из других земель.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060309
					]
				},
				{
					"id": 722060309,
					"content": "Злой дух из-за туманного моря? Я не боюсь тебя! Великая Громовая птица изгонит тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060310,
						722060311
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060310,
					"content": "Громовая птица больше не поможет тебе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060312,
					"content": "#Что ты сказал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060313,
						722060314
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060313,
					"content": "Все ушли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060315,
					"content": "Что... Что ты говоришь? Не пытайся меня напугать. У меня мурашки по коже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060316
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060316,
					"content": "В последнее время людей на острове действительно становится всё меньше и меньше. Кина сказала, что все садятся на лодку... Кто знает, куда убежал этот ребёнок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060317
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060317,
					"content": "Подожди. Дух из-за пределов этого острова... Разве ты тоже не уходишь? На серебряной лодке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060318,
						722060319
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060318,
					"content": "#Я не видел{F#а} здесь никакой лодки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060320,
					"content": "Я знал. Я знал, что чужеземцы не могут видеть эту лодку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060321
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060321,
					"content": "#Спасибо, что посоветовал{F#а} мне сесть в лодку, злой дух. Это... Просто я живу здесь так долго, и всё же я так многого ещё не видел и не сделал... Я не могу просто покинуть это место!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060322
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060322,
					"content": "Что вам нужно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060323
					]
				},
				{
					"id": 722060323,
					"content": "Нужно? А? Не то чтобы мне что-то было нужно. Я просто хочу увидеть что-то новое, понимаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060324
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060324,
					"content": "Когда я был ещё совсем маленьким, я поспорил с Уной, что за пределами нашего острова есть разные виды грибов, но она мне не поверила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060325
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060325,
					"content": "Позже её муж ушёл в море, отправился к землям чужаков. Он так и не вернулся. Говорят, что его дух бродит по чужим землям... Бедняга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060326
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060326,
					"content": "С тех пор Уна живёт одна. Каждый раз, когда я думаю об этом, я... эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060327,
						722060328
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060327,
					"content": "Не беспокойтесь о ней слишком сильно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060329,
					"content": "Я даже попросил священника... Хотя бы дать ему пристанище... А? А, точно! Грибы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060330
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060330,
					"content": "Что ж, скоро я сяду в лодку. У меня не так уж много сожалений... Я просто не видел ничего, что лежит за пределами нашего острова... целыми днями ухаживаю за грибами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060331
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060331,
					"content": "Пожалуйста, привези грибы из-за туманного моря. Я бы хотел посмотреть, как они выглядят!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060332
					],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060332,
					"content": "Прошу, помоги мне, злой чужеземный дух!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Абэ"
				},
				{
					"id": 722060328,
					"content": "Итак, о грибах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060319,
					"content": "Эта лодка не для меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060314,
					"content": "Пора прощаться",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060311,
					"content": "Туманного моря больше нет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060305,
					"content": "Это я!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				}
			]
		},
		{
