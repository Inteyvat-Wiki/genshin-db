			"dialogs": [
				{
					"id": 400511701,
					"content": "Цуми правда нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400511702,
					"content": "Не могли же мы упустить её по пути сюда?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400511703,
					"content": "...Ну почему всегда так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511704
					]
				},
				{
					"id": 400511704,
					"content": "Ой, ладно тебе, не падай духом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400511705,
					"content": "О хорошем подумай. Большинство солдат было эвакуировано. Если здесь только что проходили вишапы, никто хотя бы не пострадал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400511706,
					"content": "Хоть и от одной мысли об этом негоднике выходит Паймон из себя, нам остаётся только попробовать сделать, как он сказал. Давай направим сюда свет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
