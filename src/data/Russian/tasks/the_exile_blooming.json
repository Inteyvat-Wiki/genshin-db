			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Саббах"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930501,
					"content": "Если бы не вы, боюсь, я никогда бы не увидела, как прорастают розы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930502
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930502,
					"content": "Если бы я знала, что так будет, то в первую очередь привезла бы сюда книги, а не семена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930503,
						731930519
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930503,
					"content": "Ты не местная?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930504
					]
				},
				{
					"id": 731930504,
					"content": "Удивлены? Думаю, это значит, что я хорошо здесь адаптировалась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930505
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930505,
					"content": "Когда я впервые попала сюда, всё было мне чуждо. От еды и одежды до образа жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930506
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930506,
					"content": "Но прошло время, и я постепенно ко всему привыкла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930507
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930507,
					"content": "Но это не значит, что я приняла своё нынешнее положение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930508
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930508,
					"content": "Розы, которые цветут в городе Сумеру, по-прежнему сложно вырастить в этом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930509
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930509,
					"content": "Ты учёная?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930510
					]
				},
				{
					"id": 731930510,
					"content": "Когда-то я... могла называть себя учёной, но не сейчас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930511
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930511,
					"content": "Я сказала то, что не должна была говорить, и узнала о том, чего не следовало знать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930512
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930512,
					"content": "Это противоречило правилам Академии, поэтому я больше не учёная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930513
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930513,
					"content": "О чём ты говоришь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930514
					]
				},
				{
					"id": 731930514,
					"content": "Любопытство не только является движущей силой поиска мудрости, но и источником проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930515
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930515,
					"content": "Я поняла это только после того, как меня изгнали сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930516
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930516,
					"content": "Думаю, в целях безопасности лучше не рассказывать вам подробности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930517
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930517,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930518
					]
				},
				{
					"id": 731930518,
					"content": "Кхе-кхе... но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930535
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930535,
					"content": "Мне казалось, что искатели приключений приходят и уходят, и никогда не возвращаются после того, как сделают свою работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930536
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930536,
					"content": "Я не ожидала, что у меня будет шанс снова поболтать с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930537
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930537,
					"content": "По правде говоря, у меня не так много друзей, с которыми можно открыто поговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930538
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930538,
					"content": "Как ты думаешь, потом... у тебя будет время помочь мне удобрить растения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930539
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930539,
					"content": "Думаю, да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930540
					]
				},
				{
					"id": 731930540,
					"content": "Хорошо. Я буду тебя ждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930519,
					"content": "Зачем выращивать сумерские розы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930520
					]
				},
				{
					"id": 731930520,
					"content": "Ты, вероятно, мало о них знаешь. Эти растения имеют широкое применение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930521
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930521,
					"content": "Их можно есть, использовать в качестве лекарства или подарка, а ещё они стоят больших денег.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930522
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930522,
					"content": "И это только некоторые способы использования их в повседневной жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930523
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930523,
					"content": "Цветы, листья и стебли сумерской розы не всегда были такими, какими мы видим их сегодня. Когда-то они имели разные формы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930524
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930524,
					"content": "Я считаю, что географические изменения привели к изменению морфологических характеристик сумерских роз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930525
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930525,
					"content": "Из этого эволюционного процесса можно извлечь географическую и историческую информацию о прошлом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930526
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930526,
					"content": "Это не объяснишь в двух словах, а рассказывать об этом искателям приключений, вероятно, тоже против правил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930527
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930527,
					"content": "Если вас интересует эволюция растений, то отправляйтесь в Академию. У них больше информации на эту тему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930528
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930528,
					"content": "Так это для исследований?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930529
					]
				},
				{
					"id": 731930529,
					"content": "Я больше не учёная, поэтому не имею права заниматься исследованиями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930530
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930530,
					"content": "#Если хочешь знать причину... я скажу. Ты слишком уж любопыт{F#на}{M#ен}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930531
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930531,
					"content": "В моём прежнем доме росло много сумерских роз. Цветы были прекрасны, и я видела их каждый день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930532
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930532,
					"content": "Если бы это было возможно, я хотела бы, как раньше, видеть их каждый день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930533
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930533,
					"content": "Вот и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930534
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930534,
					"content": "Понимаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930535
					]
				}
			]
		},
		{
			"id": 7320301,
			"completionStepIds": [
				7320301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320301",
							"2"
						],
						"stepId": 7320301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Саббах"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030101,
					"content": "Вы сдержали своё слово и пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030102
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030102,
					"content": "Я приготовила цыплёнка в масле. Угощайтесь, если голодны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030103
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030103,
					"content": "Цыплёнок в масле! Паймон готова съесть целую тарелку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030104,
						732030105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732030104,
					"content": "Паймон, где твои манеры...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				},
				{
					"id": 732030106,
					"content": "Ой! Паймон просит прощения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732030107,
					"content": "Всё в порядке, не нужно формальностей. Любить еду тоже хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030108
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030108,
					"content": "Я подам блюдо, как только разогрею его. Примите это в качестве благодарности за вашу помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030109
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030109,
					"content": "Ух ты... Это очень мило, Саббах! Розы, которые ты посадила, обязательно вырастут и зацветут, как ты и хотела!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732030110,
					"content": "Ха-ха, всё это время я старалась держать почву влажной, чтобы саженцам растений было хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030111
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030111,
					"content": "Только меня беспокоит, что растут они довольно медленно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030112
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030112,
					"content": "Когда завязь в хорошем состоянии, новые листья должны появиться очень быстро, а с этими растениями ничего не происходит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030113
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030113,
					"content": "Неужели почва недостаточно плодородна... Если они останутся в таком состоянии, то я буду ещё лучше удобрять почву.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030114,
						732030115
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030114,
					"content": "Снова удобрить растения.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030116,
					"content": "Не могли бы вы снова мне помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030117
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030117,
					"content": "Пара пустяков. Предоставь это нам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732030115,
					"content": "Попробовать использовать силу Дендро.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030105,
					"content": "Извини, Паймон всегда так себя ведёт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				}
			]
		},
		{
			"id": 7320303,
			"completionStepIds": [
				7320303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320303",
							"2"
						],
						"stepId": 7320303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Саббах"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030301,
					"content": "Ещё раз спасибо. Я рада видеть, что здесь растут сумерские розы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030302
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030302,
					"content": "Пока вы говорили с Саббах, начали прорастать новые листья...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030303
					]
				},
				{
					"id": 732030303,
					"content": "Они постепенно вытянулись и показались цветочные бутоны...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030304
					]
				},
				{
					"id": 732030304,
					"content": "Бутончики медленно раскрылись и превратились в сумерские розы.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030305
					]
				},
				{
					"id": 732030305,
					"content": "Саббах сорвала розу и отдала вам с Паймон.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030306
					]
				},
				{
					"id": 732030306,
					"content": "Не стоило! У тебя не так много роз, чтобы дарить нам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732030307,
					"content": "Всё в порядке. Если бы не ваша помощь, эти розы никогда бы здесь не выросли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030308,
						732030309
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030308,
					"content": "Сейчас на это нет времени.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				},
				{
					"id": 732030310,
					"content": "Сад, конечно, великолепен, но и в одной розе есть своя красота. Меня интересуют розы с тех пор, как я была учёным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030311
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030311,
					"content": "Что? Оказывается, Саббах была учёным?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732030312,
					"content": "Да, я ещё не успела вам об этом рассказать... Я не всегда жила в деревне Аару, а «переехала» сюда из Академии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030313
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030313,
					"content": "Разве Паймон не говорила, что Саббах красноречива, как настоящий учёный?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732030314,
					"content": "Паймон поняла. Ты выращиваешь розы, чтобы продолжить их исследование, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732030315,
					"content": "Не совсем. Не думаю, что интерес учёного к объекту должен ограничиваться только исследованием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030316
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030316,
					"content": "Я делаю это потому, что люблю этот мир и хочу понять его и жизненный цикл растений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030317
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030317,
					"content": "Например, раньше я изучала влияние изменения географической среды Сумеру на эволюцию роз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030318
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030318,
					"content": "Подумайте, если бы окружающая среда Сумеру совершенно изменилась, как бы адаптировались розы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030319
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030319,
					"content": "Стали бы они вьющимися растениями? В таком случае стены ограды Академии сегодня могли бы быть покрыты розами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030320
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030320,
					"content": "Стали бы они кустарниками? Один огромный букет роз, представляете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030321
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030321,
					"content": "Может быть, появились бы разные цвета: белые, красные, золотые... Это был бы совершенно новый вид.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030322
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030322,
					"content": "Конечно, сейчас мало кто способен открыть новые виды, не говоря уже о культивировании, как это делали некоторые ведущие учёные в прошлом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030323
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030323,
					"content": "Я хочу сказать, что в каждой розе скрыт огромный потенциал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030324
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030324,
					"content": "Изучение этих возможностей доставляло мне огромное удовольствие. В то время я с радостью каждый день собирала образцы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030325
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030325,
					"content": "Оглядываясь назад, я понимаю, что это было очень весело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030326
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030326,
					"content": "В любом случае возьмите. Для меня это не потеря, а возможность поделиться радостью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030327
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030327,
					"content": "Если вам всё ещё неловко, то просто почаще приносите мне сумерские розы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030328
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030328,
					"content": "Разговаривая с вами, я чувствую себя спокойно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030329
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030329,
					"content": "Что бы я ни говорила, вы никогда не перебивали и не считали, что это глупости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030330
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030330,
					"content": "У меня есть для вас небольшой подарок. Хотя для меня это сейчас бесполезно, но вам может понравиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030331
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030331,
					"content": "Будем приходить к тебе чаще.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030332
					]
				},
				{
					"id": 732030332,
					"content": "Обязательно заходите ко мне почаще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030309,
					"content": "Ничего.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				}
			]
		},
		{
			"id": 7320304,
