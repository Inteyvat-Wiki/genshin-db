				"objectNames": [
					"Саббах"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030401,
					"content": "#Ты не выглядишь, как человек, обладающий Глазом Бога, но можешь использовать силу Дендро, так что ты не {F#обычная искательница}{M#обычный искатель}приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030402
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030402,
					"content": "Говорят, что действительно существуют люди, которые могут управлять силой элементов без помощи Глаза Бога, но слухи о них очень скверные. Ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030403
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732030403,
					"content": "Одним словом, я считаю, что ты милый и добрый человек, так что остерегайся ложного пути!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Саббах"
				}
			]
		}
	]
}