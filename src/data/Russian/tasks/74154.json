			},
			"dialogs": [
				{
					"id": 741540201,
					"content": "Что-то нечисто... Даже Паймон это понятно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME}, ты очень {F#умная}{M#умный}. Что будем делать дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741540203,
					"content": "Бенуа просит о помощи, но настаивает на обратном...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "Тогда, может быть, ещё раз осмотрим дом Бенуа? Помнишь странные ящики у заднего окна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741540208,
					"content": "Там наверняка что-то спрятано, и это может оказаться тем самым доказательством, которое ты ищешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741540204,
					"content": "Может быть, эта парочка из Флёв Сандр...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "#Судя по их реакции, я бы сказал{F#а}, что они что-то затевают...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "У меня есть несколько теорий, но нет доказательств.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
