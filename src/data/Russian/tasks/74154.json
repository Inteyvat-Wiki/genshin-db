						"pointId": 7528
					},
					{
						"sceneId": 3,
						"position": [
							3582.002,
							435.073,
							4514.881
						],
						"pointId": 7529
					}
				]
			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "Учитывая вашу настойчивость, я не ожидал, что вы оставите всё как есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540702,
					"content": "Я думал, что вы побежите в Палату Жардинаж, но вы этого не сделали. Похоже, у вас появились личные соображения на этот счёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540703,
					"content": "Почему вы держите Бенуа здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "Честно говоря, я начинаю вами восхищаться. Если бы вы сумели применить свой энтузиазм с большей пользой, вас ждало бы блестящее будущее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540706,
					"content": "Жаль только, что у вас ничего не выйдет. Вы что, правда не боитесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540707,
					"content": "#Не на {F#ту}{M#того} нарвался.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "О? Так ты действительно не понимаешь, что здесь происходит? Или ты думаешь, что находишься на стороне справедливости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540709,
					"content": "Кстати, торговца, о котором говорили в новостях, что он утонул, звали Брандт. Болтать он был мастак...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540710,
					"content": "И знаешь что? Согласно отчёту, он вовсе не утонул, а был убит и сброшен в озеро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540711,
					"content": "После столь длительного расследования всё, что удалось выяснить Сумеречному двору, - это то, что он был убит, а убийца виновен в чудовищном преступлении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540712,
					"content": "Так говорили в новостях. Кто знает, что произошло на самом деле, и кто из них больше заслуживал смерти - убийца или жертва?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540713,
					"content": "Хм... Это сложный вопрос, и я пока не определился с ответом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540714,
					"content": "Ладно, я отвлёкся! Это не имеет никакого отношения к тому, что нам предстоит обсудить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540715,
					"content": "Ты о чём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741540716,
					"content": "Я хочу сказать, что действовать безрассудно, не разобравшись в ситуации, - это глупо и может привести к нежелательным последствиям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540717,
					"content": "Быть свидетелем несправедливости и ничего не делать - вот что глупо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "Ха-ха... Возможно, если бы мы встретились при других обстоятельствах, то могли бы стать друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540720,
					"content": "Мне нравится ход твоих мыслей, но у меня есть дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540721,
					"content": "Мои нервы на исходе. Ещё раз увижу вас рядом с моим домом - приму меры. Попомните мои слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "Атос"
				},
				{
					"id": 741540722,
					"content": "Атос уходит, бормоча что-то невразумительное.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "Его странное поведение удивляет вас, и вы задумываетесь, чью сторону занять в этом вопросе...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "Вдруг вы слышите слабое постукивание, доносящееся со стороны заднего окна, а вслед за этим, после едва слышного скрипа, из окна падает записка...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "Записка написана корявым почерком. Похоже, кто-то писал её в спешке и, судя по всему, использовал для этого кофе...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "Быстро, посмотри, что там написано!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741540727,
					"content": "Это Бенуа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741540728,
					"content": "Тсс!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "...Прости! В общем, будем следить за кошачьей миской и ждать сигнала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741540718,
					"content": "Я предпринимаю меры всякий раз, когда вижу несправедливость.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "Как вы связаны с Бенуа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
			]
		},
		{
			"id": 7415408,
