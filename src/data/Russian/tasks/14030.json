			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нёвиллет",
					"Ризли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140305101,
					"content": "Я хотел бы ещё раз поблагодарить крепость Меропид от имени Сумеречного двора за помощь в ликвидации последствий вчерашнего побега.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305102
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140305102,
					"content": "#Всё благодаря помощи старшей медсестры, {F#путешественницы}{M#путешественника} и Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305103
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 140305103,
					"content": "Похоже, Сиджвин в хорошем настроении. Надеюсь, в последнее время она не слишком усердствовала на работе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305104
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140305104,
					"content": "Она единственный постоянный медицинский персонал в крепости, но есть много людей с медицинскими знаниями, готовых помочь ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305105
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 140305105,
					"content": "Рад слышать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305106
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140305106,
					"content": "Ха-ха, ты так заботишься о старшей медсестре, будто ты её родной отец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305107
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 140305107,
					"content": "По правде говоря, именно так я себя и воспринимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305108
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140305108,
					"content": "Разве это не подчёркивает твой возраст?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305109
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 140305109,
					"content": "Безусловно. По правде говоря, я часто забываю, что я намного старше тебя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305110
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140305110,
					"content": "Кстати, чем ты занимался до того, как получил эту работу? Плавал целыми днями с востока на запад и с севера на юг?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305111
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 140305111,
					"content": "Да. Иногда я также плавал с поверхности ко дну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305112
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140305112,
					"content": "Ого, впечатляет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305113
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 140305113,
					"content": "...Прошу прощения, это была шутка. Пожалуйста, не воспринимай её слишком серьёзно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305114
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140305114,
					"content": "Не могу ничего обещать. У меня безудержное воображение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ризли"
				}
			]
		},
		{
