			"trigger": {
				"objectNames": [
					"Ламия",
					"Чжэнь Чэнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680101,
					"content": "Добро пожаловать в общество помощи животным «Когтистый Конвой»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680102
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680102,
					"content": "Привет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680104
					]
				},
				{
					"id": 716680104,
					"content": "#А, это ты, {NICKNAME}. Привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680105
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680105,
					"content": "Наша гильдия проводит мероприятие. Может быть, оно и тебя заинтересует?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680106
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680106,
					"content": "Что за мероприятие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680107
					]
				},
				{
					"id": 716680107,
					"content": "Проще говоря, мы просим людей присоединиться к «Когтистому Конвою», обществу спасения животных, которое функционирует на средства торговой гильдии «Фэйюнь», и помочь нам позаботиться о брошенных или находящихся под угрозой исчезновения животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680108
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680108,
					"content": "Гильдия сотрудничает с волонтёрами из разных стран, помогая решить широко распространённую проблему бездомных животных путём опекунства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680109
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680109,
					"content": "В последние годы наша организация значительно расширилась, и мы начали рассматривать возможность сотрудничать с такими исследователями, как госпожа Ламия, в области сохранения животных, находящихся под угрозой исчезновения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680110
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680110,
					"content": "Я рада, что результаты моих исследований можно применить в этом русле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680111
					],
					"speakerTitle": "Ламия"
				},
				{
					"id": 716680111,
					"content": "Ха-ха! Мы тоже очень рады сотрудничать с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680112
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680112,
					"content": "Благодаря нашим волонтёрам и таким дальновидным исследователям, как госпожа Ламия, у многих бездомных животных теперь есть дом, а исчезающие виды находятся под защитой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680113
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680113,
					"content": "Помимо Ли Юэ, приюты для животных «Когтистого Конвоя» можно найти везде, где действует торговая гильдия «Фэйюнь», например в Мондштадте и Сумеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680114
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680114,
					"content": "Мы проводим это мероприятие, чтобы выразить благодарность нашим волонтёрам и показать всем, как много у нас соратников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680115
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680115,
					"content": "Ты можешь войти на территорию, где живут взятые на попечение животные, посмотреть, как они живут, и получить небольшой подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680116
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680116,
					"content": "Подарок подготовили наши работники и опекуны животных. Прежде чем претендовать на подарок, нужно будет подготовить ответный подарок для опекунов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680117
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680117,
					"content": "Когда придёт время, подарок будет передан опекуну. Он призван передать чувства, поэтому нет необходимости в дорогих подарках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680118
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680118,
					"content": "#Ну, что скажешь, {NICKNAME}? Интересно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680119,
						716680120
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680119,
					"content": "Конечно, я посмотрю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				},
				{
					"id": 716680121,
					"content": "Замечательно! Мы рады, что с нами такая знаменитость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680122
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680122,
					"content": "#Если готов{F#а}, можешь отдать подарок прямо сейчас. Наши сотрудники передадут его соответствующему опекуну после окончания мероприятия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680123
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680123,
					"content": "Кстати, исходя из моего личного опыта, одни опекуны предпочитают региональные деликатесы, а другие - вкусную еду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680120,
					"content": "Я хочу поучаствовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				}
			]
		},
