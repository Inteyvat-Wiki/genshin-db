			"completionStepIds": [
				7166804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166804",
							"2"
						],
						"stepId": 7166804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ламия",
					"Чжэнь Чэнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680401,
					"content": "Хорошо, мы упакуем эту еду в коробку и отправим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680402
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680402,
					"content": "Поведение каждого животного уникально. Мы не запираем их в клетках. Вместо этого мы нанимаем профессиональных смотрителей, которые следят за их физическим состоянием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680403
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680403,
					"content": "Их поиск - непростая задача. Для этого тебе понадобится специальное устройство под названием «зеркало слежения», которое разработала госпожа Ламия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680404
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680404,
					"content": "Я не столь сведущ в этой области, поэтому будет лучше, если она сама тебе всё объяснит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680405
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680405,
					"content": "Да, позволь мне всё объяснить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680406
					],
					"speakerTitle": "Ламия"
				},
				{
					"id": 716680406,
					"content": "Технология, лежащая в основе зеркала слежения, связана с Акашей, и оно довольно сложно в эксплуатации. Однако не волнуйся, оно протестировано и не представляет опасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680407
					],
					"speakerTitle": "Ламия"
				},
				{
					"id": 716680407,
					"content": "Мы закрепили микропередатчики на всех животных, осталось лишь считать сигнал устройства, и зеркало покажет всё, что можно увидеть с ракурса животного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680408
					],
					"speakerTitle": "Ламия"
				},
				{
					"id": 716680408,
					"content": "Данный прибор нуждается в доработке, но для обнаружения активных животных нам вполне хватит и этих кадров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680409
					],
					"speakerTitle": "Ламия"
				},
				{
					"id": 716680409,
					"content": "#Вот и всё. Если готов{F#а}, то мы рады приветствовать тебя в «Когтистом Конвое»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680410
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716680410,
					"content": "Используй зеркало слежения, чтобы найти наших друзей-животных. Тебя ждут не только подарки опекунов, но и сами животные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжэнь Чэнь"
				}
			]
		},
