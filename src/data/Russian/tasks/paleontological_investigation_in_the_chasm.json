			"trigger": {
				"objectNames": [
					"Хедив"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500601,
					"content": "Насчёт странных камней...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500602
					]
				},
				{
					"id": 710500602,
					"content": "Тех, что на фотографии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500603
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500603,
					"content": "Дай взглянуть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500604
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500604,
					"content": "Вот...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500605
					]
				},
				{
					"id": 710500605,
					"content": "Сразу видно, что снимок сделан на новое устройство из Фонтейна. Поразительная чёткость изображения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500606
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500606,
					"content": "Я уже пробовал одну экспериментальную камеру, но снимки получались размытыми, а чтобы поднять её, требовалось два человека. В итоге теперь она пылится где-то в Академии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500607,
						710500608
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500607,
					"content": "Пылится...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				},
				{
					"id": 710500609,
					"content": "И не говори... Я отдал за неё стоимость своего обеда. Похоже, придётся купить новую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500610
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500610,
					"content": "Вернёмся к нашему камню. Посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500611
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500611,
					"content": "Да, это определённо окаменелость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500612
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500612,
					"content": "Окаменелость?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500613
					]
				},
				{
					"id": 710500613,
					"content": "Да, и здесь можно увидеть представителей морской фауны... Как интересно. В Ли Юэ говорят «бескрайнее море поглощает леса и поля». Или как-то в этом роде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500614
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500614,
					"content": "Тот факт, что окаменелости присутствуют в Разломе, говорит о том, что эти существа когда-то были достаточно быстро погребены. Только в этом случае останки могли так хорошо сохраниться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500615
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500615,
					"content": "Я слышал, что здесь время от времени происходят землетрясения... Вполне логично, активная геологическая деятельность является одним из необходимых условий для образования окаменелостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500616
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500616,
					"content": "Эта находка, безусловно, расширит наши представления древних существ, которые когда-то населяли это место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500617
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500617,
					"content": "Но одной фотографии недостаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500619
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500619,
					"content": "Если увидишь другие такие окаменелости, принеси мне их фотографии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500620
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500620,
					"content": "Сколько фотографий тебе нужно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500621
					]
				},
				{
					"id": 710500621,
					"content": "Дай подумать. Четырёх или пяти фотографий для отчёта будет вполне достаточно. Да, принеси мне пять фотографий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500622
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500622,
					"content": "Я дам за них хорошую цену. Это потрясающая находка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500608,
					"content": "Довольно расточительно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				}
			]
		},
		{
