		},
		{
			"id": 7105016,
			"completionStepIds": [
				7105209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105209",
							"2"
						],
						"stepId": 7105209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хедив"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500902,
					"content": "Неплохо, нечасто встречаются хорошие снимки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500903
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500903,
					"content": "Благодаря этим фотографиям отряд георазведки полностью окупится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500904
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500904,
					"content": "Как видишь, это скелеты древних морских существ. У них очень чёткие формы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500905
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500905,
					"content": "Это доказывает, что до формирования Разлома здесь был океан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500906
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500906,
					"content": "Эх, если бы такие окаменелости были найдены в Сумеру, их можно было бы сразу перевезти в академию для изучения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500907
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500907,
					"content": "В следующий раз надо будет обсудить этот вопрос с Департаментом по делам граждан. Мы можем нанять кого-нибудь для охраны, но нужно быть осторожными и не дать шахтёрам испортить эти окаменелости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500908
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500908,
					"content": "Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500909,
						710500910
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500909,
					"content": "Но?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				},
				{
					"id": 710500911,
					"content": "Этих снимков должно хватить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500912
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500912,
					"content": "Как я уже говорил, ископаемые, которые сохранились в таком хорошем состоянии, могли образоваться только в особых условиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500913
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500913,
					"content": "То есть они должны быть очень быстро погребены под землёй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500914
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500914,
					"content": "Окаменелости Разлома встречаются только на определённой высоте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500918,
						710500919
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500918,
					"content": "На определённом уровне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500920,
					"content": "С точки зрения геологии она ничтожно мала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500915
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500915,
					"content": "Они образовались за очень короткий промежуток времени и находятся довольно близко друг к другу... Это свидетельство серьёзных и стремительных экологических изменений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500916
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500916,
					"content": "Например, сильный толчок или что-то в этом роде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500917
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500917,
					"content": "Что же всё-таки произошло в Разломе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500919,
					"content": "Разница в высоте между верхом и низом довольно велика, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500910,
					"content": "Тебе нужно больше снимков?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				}
			]
		},
