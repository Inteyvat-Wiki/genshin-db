						],
						"stepId": 7320111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011101,
					"content": "«Покинув Бригаду тридцати, я каждый день прихожу сюда выпить кофе».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011102
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732011102,
					"content": "«Каждый день хозяйка варит один и тот же кофе, а рассказчик повторяет одну и ту же историю».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011103
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732011103,
					"content": "«Возможно, подобный кругооборот выражает самую суть жизни в Сумеру».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7320112,
			"completionStepIds": [
				7320112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320112",
							"2"
						],
						"stepId": 7320112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011201,
					"content": "«Рассказы господина Маддаха стары как мир, но он прекрасно умеет держать слушателя в напряжении!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011202
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732011202,
					"content": "«Сейчас все получают новости через Акашу, поэтому техническая сложность и художественная зрелость мастерства Маддаха часто остаётся незамеченной».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011203
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732011203,
					"content": "«Это всё пустое. Каждой форме искусства отведено своё время. Как только все \"выгоды\" от неё получены, наступает новая эпоха, где уже нет места старым формам».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011204
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732011204,
					"content": "«Это подобно тому, как перезрелые плоды должны упасть на землю и сгнить, чтобы дать пищу новым растениям».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011205
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732011205,
					"content": "«Вот почему я не люблю утилитаристов! Искусство - драгоценный плод отдыха и досуга. Как можно говорить здесь о \"выгоде\", деятели искусства не какие-нибудь торгаши!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011206
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732011206,
					"content": "«Отдых и досуг - это что-то из словаря людей, которые топчут шарообразную землю. Пустышка, химера. Лучше пораскинь мозгами и ответь на вопрос: как производство продукта может быть отделено от получения прибыли?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011207
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732011207,
					"content": "«До чего же горячий спор. Как бы там ни было, господину Кавеху пришла пора оплатить счёт за месяц. Снова записать всё на счёт господина аль-Хайтама?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011208
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732011208,
					"content": "«Нет, я хочу, чтобы этот баловень судьбы испытал на своей шкуре суровость мира коммерции».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011209
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732011209,
					"content": "«Дорогая хозяйка, запишите долг этого человека на госпожу Сангема-бай. Ведь искусством можно заниматься, только если под рукой есть горячий кофе!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
