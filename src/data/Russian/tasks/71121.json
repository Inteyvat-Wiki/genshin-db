					"Странный торговец"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711210201,
					"content": "Большое спасибо! Ох, если бы не вы, мои товары пропали бы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210202
					],
					"speakerTitle": "Странный торговец"
				},
				{
					"id": 711210202,
					"content": "У меня с собой не так много моры. Прошу, примите это в качестве небольшой благодарности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210203
					],
					"speakerTitle": "Странный торговец"
				},
				{
					"id": 711210203,
					"content": "О, это очень щедро с твоей стороны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711210204,
					"content": "Ха-ха, что ж, здесь наши пути расходятся. Надеюсь, мы ещё встретимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Странный торговец"
				}
			]
		},
		{
