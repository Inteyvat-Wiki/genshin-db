			"dialogs": [
				{
					"id": 711215101,
					"content": "Пожалуйста, пощадите! Я не заодно с ними!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215102
					],
					"speakerTitle": "Странный торговец"
				},
				{
					"id": 711215102,
					"content": "Ты кто такой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215103
					]
				},
				{
					"id": 711215103,
					"content": "Я... Я... Это долгая история. Они кое-что украли, поэтому мне нужно сделать опись и вернуть вещи, вот и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215104
					],
					"speakerTitle": "Странный торговец"
				},
				{
					"id": 711215104,
					"content": "Вы прогнали всех воров, значит, моя работа здесь закончена. Я пойду, если вы не возражаете!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215105
					],
					"speakerTitle": "Странный торговец"
				},
				{
					"id": 711215105,
					"content": "П-подожди!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215106
					]
				},
				{
					"id": 711215106,
					"content": "Всё в порядке. Увидимся позже!",
