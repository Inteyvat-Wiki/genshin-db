				"points": []
			},
			"dialogs": [
				{
					"id": 711210301,
					"content": "П-пощадите, умоляю... О, это вы?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210302
					],
					"speakerTitle": "Странный торговец"
				},
				{
					"id": 711210302,
					"content": "Снова ты?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210303
					]
				},
				{
					"id": 711210303,
					"content": "Хе-хе, какая неожиданность... Ха-ха, вы занимайтесь своими делами, а я пойду, пожалуй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210304
					],
					"speakerTitle": "Странный торговец"
				},
				{
					"id": 711210304,
					"content": "Посмотрим, какие сокровища они оставили. Ну... не волнуйтесь, у меня всё записано... Я лишь верну то, что подлежит мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210305
					],
					"speakerTitle": "Странный торговец"
				},
				{
					"id": 711210305,
					"content": "П-подожди!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210306
					]
				},
				{
					"id": 711210306,
					"content": "Всё в порядке. Увидимся позже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Странный торговец"
				}
			]
		},
