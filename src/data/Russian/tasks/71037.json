	"talks": [
		{
			"id": 7103701,
			"completionStepIds": [
				7103702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103702",
							"2"
						],
						"stepId": 7103702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжи Цюн",
					"Цзинь У",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370101,
					"content": "Ох, знакомый воздух шахт... Давненько я сюда не спускалась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370102
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370102,
					"content": "Не расслабляйся, Чжи Цюн. Я вот ощущаю что-то непонятное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370103
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370103,
					"content": "Да ладно, наверно, просто на подъёмнике укачало. Мы же не могли просто спрыгнуть вниз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370104
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370104,
					"content": "Ты... Ты, возможно, слишком долго пробыла на поверхности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370105
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370105,
					"content": "А Паймон ничего не чувствует... Вы, шахтёры, похоже, хорошо распознаёте запахи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710370106,
					"content": "Ха-ха, слабый нос в шахтах может привести к смерти. Но теперь всё в порядке, зяблики прекрасно себя чувствуют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370107
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370107,
					"content": "Посмотрите, здесь вырос светоносный кристалл... А когда мы спускались в шахту в прошлый раз, такого не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370108
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370108,
					"content": "И правда. Давайте посмотрим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370109
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370109,
					"content": "Эй... Это Паймон должна была сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7103702,
			"completionStepIds": [
				7103704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103704",
							"2"
						],
						"stepId": 7103704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзинь У",
					"Чжи Цюн",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370201,
					"content": "Надо же, светоносный кристалл так близко к поверхности... Я всегда думала, что они не могут появиться в таких местах, где структура нарушена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370202
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370202,
					"content": "Эти кристаллы - проявления «нечто» под землёй, должно быть, они попали сюда по горным жилам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370203
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370203,
					"content": "Эй! Не говори ерунды. Это просто местные породы, подвергшиеся кристаллизации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370204
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370204,
					"content": "Анализ, проведённый по поручению Цисин, показывает, что они состоят из местных пород. Вот только какие-то внешние силы придали им особую кристаллическую форму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370205
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370205,
					"content": "#Ух ты, а этот кристалл похож на твой Адъювант, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710370231,
					"content": "#{NICKNAME}, может, взглянем на Адъювант светоносного камня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710370232,
					"content": "Да, светоносный камень и эти кристаллы состоят из одного и того же вещества. Из-за структурного сходства они естественным образом резонируют друг с другом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370206,
						710370207
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370206,
					"content": "Очень странно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				},
				{
					"id": 710370208,
					"content": "Эй, это всё, что ты можешь сказать?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710370209,
					"content": "Для начала оставим ссоры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370210
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370210,
					"content": "Мы не ссорились...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370211
					]
				},
				{
					"id": 710370211,
					"content": "Да, мы не...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710370212,
					"content": "В общем, ссоритесь вы или нет, нам с Чжи Цюн нужно разбить временный лагерь впереди. Пожалуйста, никуда не уходите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370213
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370213,
					"content": "Кристаллы, которые мы обнаружили, будут очень полезны для последующего исследования. Пожалуйста, сообщите мне, если вы ещё что-то обнаружите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370214
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370214,
					"content": "Я ещё не забыла своё ремесло, так что смогу помочь вам с обработкой кристаллов. Это наверняка пригодится вам в дальнейших приключениях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370215
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370215,
					"content": "Ну, и это... не ссорьтесь, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370216
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370216,
					"content": "Ладно, ладно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710370217,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370218
					]
				},
				{
					"id": 710370218,
					"content": "Хорошие детки, позже дам вам конфеток. Если обнаружите здесь что-нибудь странное, сразу сообщайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370219
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370219,
					"content": "Кстати, Цзинь У, насчёт той истории с дядей Хэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370220
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370220,
					"content": "#Я не забыла об этом. {NICKNAME}, раз ты здесь, пожалуйста, окажи мне ещё одну услугу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370221
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370221,
					"content": "Дядя Хэ был когда-то заслуженным работником нашей шахты. Он один из тех несчастных, кто пропал, когда несколько лет назад шахтёров эвакуировали из Разлома... Он страдал глухотой и, вероятно, не услышал сигнала тревоги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370222
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370222,
					"content": "Пенсия от зала Хуэйшань и зала Шэнлу довольно большая. Его семья уже организовала похороны... Но хотя я не любительница фантастических историй, мне кажется, что он по-прежнему жив и находится где-то внизу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370223
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370223,
					"content": "Он чуть ли не всю жизнь проработал в шахте... Как избежать катастрофы в шахте, как спастись, как дождаться спасения и так далее - он всё это знал и многому меня научил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370224
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370224,
					"content": "Поэтому я уверена, что даже спустя столько времени он жив... Я не хочу оставлять поиски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370225
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370225,
					"content": "Я укажу вам несколько мест, где дядя Хэ работал до эвакуации шахтёров... Вдруг там найдутся какие-нибудь подсказки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370226
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370226,
					"content": "А я отправляюсь исследовать глубины шахты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370233
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370233,
					"content": "Ах да, не забудьте свои сладости, детишки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370227,
						710370229
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370227,
					"content": "Ты не идёшь с нами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370228
					]
				},
				{
					"id": 710370228,
					"content": "Она ещё должна помочь нам нарисовать несколько карт. Пути в подземных шахтах Разлома запутаны и сложны. Без этих карт мы далеко не уйдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370229,
					"content": "Береги себя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370230
					]
				},
				{
					"id": 710370230,
					"content": "Всё в порядке, я уже не новичок. Не волнуйся обо мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370207,
					"content": "Удивительно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				}
			]
		},
		{
			"id": 7103703,
			"completionStepIds": [
				7103709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103709",
							"2"
						],
						"stepId": 7103709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзинь У"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370301,
					"content": "О, вы вернулись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370302
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370302,
					"content": "Дядя Хэ оставил несколько записок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370303
					]
				},
				{
					"id": 710370303,
					"content": "Что? Он правда что-то оставил! Расскажи мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370306
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370306,
					"content": "Вы рассказываете Цзинь У о найденном.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710370304
					]
				},
				{
					"id": 710370304,
					"content": "Хм... чёрная магма... светоносный камень... грибы?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370305
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370305,
					"content": "Хм. Это странно. И очень знакомо. Вернёмся в лагерь. Лучше не задерживаться здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзинь У"
				}
			]
		},
		{
			"id": 7103704,
			"completionStepIds": [
				7103711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103711",
							"2"
						],
						"stepId": 7103711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзинь У",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370401,
					"content": "Мы на месте... Странно, где Чжи Цюн?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370402
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370402,
					"content": "Чжи Цюн! Чжи Цюн!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370403
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370403,
					"content": "Ох, готова поспорить, она убежала куда-то снова рисовать свои карты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370404,
						710370405
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370404,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370407
					]
				},
				{
					"id": 710370407,
					"content": "Она нарисовала эту карту, когда вы ушли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370408
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370408,
					"content": "Вероятно, она снова отправилась исследовать глубины. Пора бы ей понять, что впереди опасно и не стоит рисковать, оставляя всех позади и действуя в одиночку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370409
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370409,
					"content": "Проблемы одного грозят неприятностями для всех. И скажу сразу, мой кулак не знает пощады...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370410
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370410,
					"content": "Звучит... страшно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710370411,
					"content": "Очень страшно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370412
					]
				},
				{
					"id": 710370412,
					"content": "Ладно, меньше слов, больше дела. Либо помогите мне обустроить лагерь, либо идите вперёд и разведайте дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370413
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370413,
					"content": "Извините, галантные манеры не мой конёк... Я просто стараюсь ради общего блага.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370414
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370414,
					"content": "Кстати, если увидите по пути необработанные кристаллы светоносного камня или его руду, пожалуйста, принесите их мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370415
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370415,
					"content": "Я знаю, как с их помощью сделать Адъювант более эффективным. Судя по моему опыту... это пригодится в шахтах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710370405,
					"content": "Чжи Цюн в опасности?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370406
					]
				},
				{
					"id": 710370406,
					"content": "Пока нет... Но если она и дальше будет убегать, не предупредив меня, то очень скоро окажется в беде!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370407
					],
					"speakerTitle": "Цзинь У"
				}
			]
		},
		{
