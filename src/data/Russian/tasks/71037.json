				{
					"id": 710370901,
					"content": "К тому времени, когда вы вернётесь, Чжи Цюн практически закончит работу над картой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370902
					],
					"speakerTitle": "Цзинь У"
				},
				{
