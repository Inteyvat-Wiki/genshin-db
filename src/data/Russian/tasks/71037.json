			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжи Цюн",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370501,
					"content": "#А, {NICKNAME}, здравствуй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370502,
						710370510
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370502,
					"content": "Цзинь У хочет с тобой поговорить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370503
					]
				},
				{
					"id": 710370503,
					"content": "Опять эти советы по соблюдению техники безопасности, да? Я так устала их слышать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370504
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370504,
					"content": "Я тоже выросла в шахтах. Как я могу не знать о здешних опасностях?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370505
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370505,
					"content": "Что касается неведомых опасностей, то опытные шахтёры, опираясь на опыт, судят, опасно что-то или нет... а затем, в свою очередь, результатами подтверждают свой опыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370506
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370506,
					"content": "#Я сыта по горло их высокомерием... Ты ведь искатель{F#ница} приключений, наверняка ты думаешь, как я?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370507
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370507,
					"content": "#Если бы Айрис просто предупредила тебя об опасностях Драконьего хребта, а ты бы послушно {F#отказалась}{M#отказался} от мысли отправиться туда, сколько захватывающих приключений было бы упущено!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370508
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370508,
					"content": "Даже не пытайся меня уговаривать. Я не хочу ссориться из-за такого пустяка... Может, сменим тему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370509
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370509,
					"content": "Взгляни. Я сейчас изучаю местность, чтобы составить карты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370512,
					"content": "Только...я обнаружила, что путь вперёд преграждает... какая-то странная штука.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370513
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370513,
					"content": "Если ты возьмёшь образцы или сделаешь несколько фотографий, то и Департамент по делам граждан, и Гильдия искателей приключений наверняка будут очень рады.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370514
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370514,
					"content": "Я бы сама этим занялась, но... я уронила фотокамеру, когда спускалась в шахты, так что теперь полностью полагаюсь на тебя, хе-хе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370515
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370515,
					"content": "И ещё пара мест... Здесь и здесь. Я видела там следы Похитителей сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370516
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370516,
					"content": "Прости, где тут какое место? Паймон ничего не поняла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710370517,
					"content": "Тут просто кучка крестиков и линий...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370518
					]
				},
				{
					"id": 710370518,
					"content": "Ха-ха, прошу прощения... Сила привычки. Совсем забыла, что не все наделены интуицией картографа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370519
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370519,
					"content": "Но ничего, я пойду с вами и покажу дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370520
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370520,
					"content": "Мы можем отправиться в любое из этих мест. Выбирайте, какое вам больше нравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370521,
						710370522
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370521,
					"content": "Тогда вперёд.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710370522,
					"content": "В пути будь осторожна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370523
					]
				},
				{
					"id": 710370523,
					"content": "Спасибо за заботу! Буду помнить об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710370510,
					"content": "Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370511
					]
				},
				{
					"id": 710370511,
					"content": "Ну... как я уже сказала, изучаю местность, чтобы составить карты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Чжи Цюн"
				}
			]
		},
