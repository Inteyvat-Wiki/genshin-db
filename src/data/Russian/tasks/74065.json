						],
						"pointId": 6253
					}
				]
			},
			"dialogs": [
				{
					"id": 740650101,
					"content": "#Ого, глядите-ка, это {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650102,
						740650103
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740650102,
					"content": "Мы знакомы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				},
				{
					"id": 740650104,
					"content": "К чему эта холодность? В моём сердце навечно осталось то прошлое событие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650105
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740650105,
					"content": "То прошлое событие? А! У нас есть к тебе парочка вопросов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740650106,
					"content": "Вот... вот как? Ох уж моя память!.. А что было в прошлый раз? Полностью вылетело из головы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650107
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740650107,
					"content": "Мудрецы говорят, что лучше смотреть в будущее, а не оглядываться на прошлое. Давайте мы лучше обсудим наше сегодняшнее сотрудничество!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650108
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740650108,
					"content": "У меня в голове засел план, как сорвать неплохой куш, да только нужна помощь. Если у вас есть время, не хотите ли послушать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650109
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740650109,
					"content": "Пф, не думай, что нас легко одурачить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740650110,
					"content": "Говоришь, можно сорвать большой куш?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650111
					]
				},
				{
					"id": 740650111,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740650112,
					"content": "#Вот, за что я вас люблю, {M#господин}{F#госпожа} {NICKNAME}, так это за умение вести дела! Итак, как говорится, в путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650113
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740650113,
					"content": "Давайте так, я назову число, которым вы останетесь довольны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650114
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740650114,
					"content": "Сто купонов! Что скажете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650115
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740650115,
					"content": "Сто?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740650116,
					"content": "О, судя по вашему виду, вы тронуты моей щедростью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650117,
						740650119
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740650117,
					"content": "Да этого не хватит, чтобы купить пробку от бутылки Фонты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650118
					]
				},
				{
					"id": 740650118,
					"content": "Именно! Паймон поверить не может, что ты посмел такое предложить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740650121,
					"content": "Моя щедрость недостаточна? Ох уж эта молодёжь! Не цените доброго отношения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650122
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740650122,
					"content": "Знаете, что за подобный пустяк, на котором ещё и заработать можно, местные голодранцы бы передрались...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650123
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740650123,
					"content": "Декабрэ, мелкий ты жулик, наконец-то попался! В прошлый раз, когда я поймал тебя у почтового отделения, ты тоже спихивал свои поручения на новичков за полцены...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650124
					],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650124,
					"content": "#{NICKNAME}, Паймон? Вы же не верите бредням этого парня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650125,
						740650127
					],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650125,
					"content": "Ещё бы, он уже раз нас обманул.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650126
					]
				},
				{
					"id": 740650126,
					"content": "Ох, я всё-таки опоздал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650130,
					"content": "В общем, ни одному его слову нельзя верить. Он специально выбирает тех, кто только попал в крепость Меропид и ещё не знает правил. Уже столько людей пострадало из-за него!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650131
					],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650131,
					"content": "Какой ещё обман... Подлая клевета. Какая между нами разница? Разве вы, стражники, не заставляете людей за купоны делать за вас сложную работу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650132
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740650132,
					"content": "Но мы не складываем проценты себе в карман.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650133
					],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650133,
					"content": "Что за намёки? Без доказательств попрошу не брызгать слюной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650134
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740650134,
					"content": "О, так нужны доказательства? Идём, у нас в одиночке спокойно и просторно, лучшее место, чтобы просматривать материалы. Точно. В стволе жеодовой шахты меня ещё ждут проблемы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650135
					],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650135,
					"content": "#Кстати, {NICKNAME} и Паймон, если у вас есть возможность, вы могли бы помочь мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650136
					],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650136,
					"content": "Но у нас и свои дела бывают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740650137,
					"content": "Что насчёт щедрого вознаграждения? Тогда я в деле.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650138
					]
				},
				{
					"id": 740650138,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740650139,
					"content": "Ха-ха, конечно, согласно регламенту. Вы знаете принятые нормы, и я не собираюсь прибегать к уловкам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650140
					],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650140,
					"content": "Дела обстоят вот как: там инороды Фонтмера в стволе жеодовой шахты... Если всё оставить как есть, то это создаст угрозу. Необходимо поскорее от них избавиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650141
					],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650141,
					"content": "Сначала я запру этого прохвоста в одиночке. Мне понадобится какое-то время, чтобы объяснить всё коллегам... Я встречусь с вами, как только освобожусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650142
					],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650142,
					"content": "Хорошо, только не задерживайся слишком долго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740650143,
					"content": "Я постараюсь освободиться поскорее, но все эти процедуры... Многое зависит не от меня. Рассчитываю на вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650127,
					"content": "В этот раз пока нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650128
					]
				},
				{
					"id": 740650128,
					"content": "В этот раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650129
					],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650129,
					"content": "Эм... было кое-что в прошлом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740650119,
					"content": "#Я сам{F#а} дам тебе сто за работу и ещё заработаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650120
					]
				},
				{
					"id": 740650120,
					"content": "Ха! Так ты поди и задумал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740650103,
					"content": "У меня плохое предчувствие...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				}
			]
		},
		{
			"id": 7406503,
			"completionStepIds": [
				7406503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406503",
							"2"
						],
						"stepId": 7406503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мопуаль"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740650301,
					"content": "Почему ты только пришёл? Мы уже прогнали всех этих инородов Фонтмера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740650302,
					"content": "А, тогда позвольте мне наверстать упущенное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650303
					],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650303,
					"content": "Наверстать упущенное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740650304,
					"content": "Ну конечно! Когда я приехал на место, всю работу за меня уже сделали другие! А я? Я ничего не сделал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650305
					],
					"speakerTitle": "Мопуаль"
				},
				{
					"id": 740650305,
					"content": "Это вам. Спасибо, сегодня я смогу спать спокойно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мопуаль"
				}
			]
		}
	]
}