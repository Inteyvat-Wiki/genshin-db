					"Кадзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721290401,
					"content": "#Неплохо, чужестран{F#ка}{M#ец}! Облака почти разошлись. Похоже, моя догадка была верной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290402
					],
					"speakerTitle": "Кадзи"
				},
				{
					"id": 721290402,
					"content": "Теперь нужно починить ещё два оберега в Голове змея и шахте Дзякоцу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290403
					],
					"speakerTitle": "Кадзи"
				},
				{
					"id": 721290403,
					"content": "Если не возражаешь, я оставлю эти два оберега на тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290404
					],
					"speakerTitle": "Кадзи"
				},
				{
					"id": 721290404,
					"content": "Так точно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290405
					]
				},
				{
					"id": 721290405,
					"content": "Большое тебе спасибо за помощь. И хотя я не богач, обещаю справедливо тебя наградить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290406
					],
					"speakerTitle": "Кадзи"
				},
				{
					"id": 721290406,
					"content": "Не знаю, когда это случилось, но воссоединение семьи стало чуть ближе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290407
					],
					"speakerTitle": "Кадзи"
				},
				{
					"id": 721290407,
					"content": "Кстати, когда закончишь, найдёшь меня в западной части острова. А ещё в форт Мумэи вторглись мятежники. Возможно, это как-то связано с произошедшей переменой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кадзи"
				}
			]
		},
