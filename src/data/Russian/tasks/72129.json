			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721290101,
					"content": "Что это? Хм... Ракушка? Паймон не знает, для чего она, но... Возьмём её с собой пока что.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290102
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 721290102,
					"content": "Этот каменный фонарь такой странный... От него бросает в дрожь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721290103,
					"content": "А что это написано на фонарном столбе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721290104,
					"content": "«Проходящим здесь путешественникам: если у вас есть вопросы по поводу этого оберега, ступайте в ущелье Мусодзин и поговорите с господином Кадзи».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290105
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 721290105,
					"content": "На вид эта надпись совсем недавняя, а ниже - несколько стёртых дождём строк более мелким почерком:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290106
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 721290106,
					"content": "«Скажите господину Кадзи, что мы пробовали... Но безуспешно... Возможно, он найдёт это где-то поблизости...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290107
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 721290107,
					"content": "«Скажите господину Кадзи, чтобы как можно скорее пришёл в поселение беженцев. Семья по нему скучает».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290108
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 721290108,
					"content": "Похоже, господин Кадзи печётся об этом фонаре. Так почему бы нам не сходить в ущелье Мусодзин и не спросить его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7212902,
			"completionStepIds": [
				7212905
			],
