			},
			"dialogs": [
				{
					"id": 721290201,
					"content": "Вы смотрите на оберег, и внезапно ощущаете, как в вашу сторону течёт странная энергия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290202
					],
					"speakerTitle": "Прикоснуться к оберегу"
				},
				{
					"id": 721290202,
					"content": "Вы осознаёте, что она вам не сопротивляется, а о чём-то просит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290203
					],
					"speakerTitle": "Прикоснуться к оберегу"
				},
				{
					"id": 721290203,
					"content": "Что ж... В этом обереге определённо чего-то не хватает. Осмотрим окрестности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721290204,
					"content": "Используй чувство стихий, чтобы изучить оставленные поблизости следы элементов. Возможно, что-то найдёшь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
