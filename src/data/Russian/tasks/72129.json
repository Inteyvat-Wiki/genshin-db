			"dialogs": [
				{
					"id": 721290601,
					"content": "#Как дела? Уже закончил{F#а} восстанавливать оберег?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290602,
						721290603
					],
					"speakerTitle": "Кадзи"
				},
				{
					"id": 721290602,
					"content": "Пока ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290604
					]
				},
				{
					"id": 721290604,
					"content": "Ничего. Не торопись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кадзи"
				},
				{
					"id": 721290603,
					"content": "Всё ещё этим занимаюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290605
					]
				},
				{
					"id": 721290605,
					"content": "Если не можешь починить его, не страшно. Главное не оставайся слишком долго в этом опасном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кадзи"
				}
			]
