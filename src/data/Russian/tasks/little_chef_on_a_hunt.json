			},
			"dialogs": [
				{
					"id": 110000401,
					"content": "Готова поспорить, что эти кабаны очень вкусные!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000402
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000402,
					"content": "У меня уже слюнки текут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сян Лин"
				}
			]
		},
		{
			"id": 1100005,
			"completionStepIds": [
				1100005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100005",
							"2"
						],
						"stepId": 1100005,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"100061",
							"3"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сян Лин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000501,
					"content": "Ого, сколько всего! Так... Это я потушу, а это пожарю с грибами. Интересно, как это будет сочетаться со слаймовым желе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000502,
						110000504
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000502,
					"content": "Она сейчас словно в другом мире...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000503
					]
				},
				{
					"id": 110000503,
					"content": "Совсем забыла про нас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110000506,
					"content": "Прошу прощения, я слишком глубоко задумалась о новых рецептах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000507
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000507,
					"content": "Как я и обещала - особое угощение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000508
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000508,
					"content": "Ты ставишь на нас эксперименты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110000509,
					"content": "Ммм... Как же вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110000510,
					"content": "Расскажешь, как это готовить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110000511,
					"content": "Да, конечно! Только я пока ещё не записала рецепт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000512
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000512,
					"content": "Давай я приготовлю ещё одну порцию, а ты будешь смотреть и запоминать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000513
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000513,
					"content": "Такое сложное блюдо! С первого раза всё не запомнить. К тому же у нас нет котла и приправ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110000514,
					"content": "Да ладно тебе! Всё очень просто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000515
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000515,
					"content": "Мы можем готовить на плоском булыжнике, смазанном кабаньим жиром. Сейчас сделаем жаровню из камней. Хворост для растопки, ветки для костра...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000516
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000516,
					"content": "Цветок-сахарок для сладости. А в пещере неподалёку есть соляное месторождение. Там мы возьмём соль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000517,
						110000518
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000517,
					"content": "Она говорит об этом с такой лёгкостью...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000519
					]
				},
				{
					"id": 110000519,
					"content": "Ха-ха! Мне ни за что не устоять перед возможностью попробовать что-нибудь новенькое. Но не могу же я носить с собой целую кухню?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000520
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000520,
					"content": "Минутку! Сейчас я всё подготовлю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000521
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000521,
					"content": "Эй! Вы что творите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000601
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 110000601,
					"content": "Это естественная среда обитания кабанов! Здесь на них нельзя охотиться! Они же все просто убегут отсюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000602
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 110000602,
					"content": "Охотники не убивают курицу, которая несёт яйца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000603
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 110000603,
					"content": "Ой... Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000604
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000604,
					"content": "Нет ничего лучше мяса кабанов, выросших в естественных условиях. А если мы всех их распугаем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000605
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000605,
					"content": "Это будет большая потеря для кулинарного искусства! Да что там, для всего человечества!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000606,
						110000607
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000606,
					"content": "Хм. Можно и так сказать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000608
					]
				},
				{
					"id": 110000608,
					"content": "Прости, пожалуйста. Я слишком увлеклась и не подумала о последствиях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000609
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000609,
					"content": "Ай, извиняйся теперь перед Драффом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000610
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 110000610,
					"content": "Он всегда настаивает на том, чтобы мы неукоснительно соблюдали правила охоты. Сейчас он, должно быть, очень расстроен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000611,
						110000612
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 110000611,
