			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сян Лин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000301,
					"content": "Тсс! Потише, пожалуйста. Я охочусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000302
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000302,
					"content": "Я слышала, что в Мондштадте можно найти любые ингредиенты. И это действительно оказалось так!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000303,
						110000304
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000303,
					"content": "Ты охотница?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				},
				{
					"id": 110000305,
					"content": "Нет, я шеф-повар! Я ищу самые необычные продукты по всему континенту!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000306
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000306,
					"content": "Меня зовут Сян Лин, я из Ли Юэ. А вы кто такие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000307
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000307,
					"content": "#Меня зовут {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000308
					]
				},
				{
					"id": 110000308,
					"content": "Здрасьте, я Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110000309,
					"content": "Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000310
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000310,
					"content": "Что?! Почему ты на меня так смотришь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110000311,
					"content": "Какое необычное создание... Интересно, вкусная ли она?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000312,
						110000314
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000312,
					"content": "Это мой хороший друг.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000313
					]
				},
				{
					"id": 110000313,
					"content": "Как жаль. Друзей есть нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000316,
					"content": "Похоже, что вы и вправду хорошие друзья! У меня тоже есть хороший друг. Его зовут Гоба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000317
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000317,
					"content": "Совсем как известный деликатес из Ли Юэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110000318,
					"content": "О, да! Я люблю их обоих! И друга, и деликатес!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000319
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000319,
					"content": "Хорошо. Хочешь немного поохотиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000320
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000320,
					"content": "В этих местах полно разной дичи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000321
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000321,
					"content": "Из меня охотник совсем никудышный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000322
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000322,
					"content": "Звучит, как непростая работёнка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110000323,
					"content": "В награду тебя будет ждать особое угощение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000324
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000324,
					"content": "#Особое угощение? Да {NICKNAME} всем охотникам охотник! Конечно мы тебе поможем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000325,
						110000326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110000325,
					"content": "На чьей ты стороне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000327,
					"content": "Не переживай, твой маленький друг уже дал ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000328
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000328,
					"content": "Мне всё равно, как ты это сделаешь. Просто принеси мне немного сырого мяса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000329
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000329,
					"content": "Я рассчитываю на тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110000326,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000314,
					"content": "Давай попробуем!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000315
					]
				},
				{
					"id": 110000315,
					"content": "Нельзя! НЕЛЬЗЯ! Паймон несъедобная!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110000304,
					"content": "Ты искательница приключений?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				}
			]
		},
		{
			"id": 1100004,
