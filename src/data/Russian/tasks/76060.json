			"dialogs": [
				{
					"id": 760600301,
					"content": "Хорошо, эти подойдут. Что думаешь, Маалаус?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600302,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600303
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760600303,
					"content": "Паймон кажется, что она счастлива! Хе-хе, интересно, что получится на этот раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600305
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760600305,
					"content": "О, уже готово?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600307
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760600307,
					"content": "Маалаус кажется опечаленной. Это из-за картины? Посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600308,
					"content": "Коломбина... гуляет под луной и смотрит на ночное небо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600309,
					"content": "Ах... Должно быть, я смотрю на настоящую Луну за лживым небом. Раньше я часто гуляла так по полуночи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600310
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600310,
					"content": "Раньше?.. Ах, да...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600311,
					"content": "(Сейчас Коломбина практически не выходит за пределы этого сада... хотя и родилась в Нод-Крае...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600312
					]
				},
				{
					"id": 760600312,
					"content": "Да, я смотрела на небо и задавалась вопросом: что же на самом деле находится там, на настоящей Морозной Луне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600313
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600313,
					"content": "Может быть, там так же, как здесь, обитает множество маленьких животных...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600314
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600314,
					"content": "А может быть... там вообще ничего нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600315
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600315,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600316,
						760600319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600316,
					"content": "Можно взять с собой туда нескольких...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600317
					]
				},
				{
					"id": 760600317,
					"content": "Ха... Интересная мысль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600318
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600318,
					"content": "Но... Луна находится за лживым небом, и я бы не рискнула отправлять их в это путешествие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600322,
					"content": "(Один - «дом», где она не может свободно передвигаться... другой - «дом», о котором она ничего не знает...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600323
					]
				},
				{
					"id": 760600323,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600324
					]
				},
				{
					"id": 760600324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600325
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760600325,
					"content": "Маалаус и другие куухенки будут очень скучать по тебе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600326,
					"content": "Я тоже буду скучать по ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600327
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600327,
					"content": "Но только я могу отправиться в это путешествие... и только я могу найти ответы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600328
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600328,
					"content": "И кто знает? Каким бы ни был ответ... Возможно, это будет нечто прекрасное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600329
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600329,
					"content": "Т-Тогда мы приедем к тебе в гости! И Маалаус захватим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600330
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600330,
					"content": "Хорошо. Может быть, мы сможем устроить выставку на Луне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600331
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600331,
					"content": "Да, отличная идея! Договорились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600332
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600332,
					"content": "Ну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600333
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600333,
					"content": "Я надеюсь, я искренне надеюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600319,
					"content": "Там могут быть другие милые существа...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600320
					]
				},
				{
					"id": 760600320,
					"content": "Хм, надеюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600321
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600321,
					"content": "И ещё надеюсь... если они там есть, то они будут рады внезапному и неожиданному возвращению своей «богини».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "Субретка"
				}
			]
		},
