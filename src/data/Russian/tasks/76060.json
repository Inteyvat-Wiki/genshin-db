			"dialogs": [
				{
					"id": 760600101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600102
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760600102,
					"content": "Это же Маалаус?! Она опять уходила в поисках вдохновения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600103,
					"content": "Да. Она такая с тех пор, как вернулась... Будто погрузилась в свои мысли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600104
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600104,
					"content": "Может, на этот раз тема очень глубокая... Знаешь, как когда великий художник осознаёт фундаментальную истину о мире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600105,
					"content": "Маалаус подарила нам множество картин. На целую выставку хватит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600106,
					"content": "Хе-хе, Паймон не может дождаться, чтобы рассказать всем о стремительном становлении нашей маленькой художницы! Ах да, но сначала нужно получить разрешение Коломбины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600107,
					"content": "Хм? Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600108
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600108,
					"content": "Потому что почти все картины посвящены тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600109
					]
				},
				{
					"id": 760600109,
					"content": "О... Я не против. Звучит интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600110
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760600110,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600111
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760600111,
					"content": "О, похоже, Маалаус определилась с выбором! Быстрее, давай посмотрим, какие у нас есть краски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760600112,
					"content": "На этот раз... Выберем глубокие и спокойные цвета!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
