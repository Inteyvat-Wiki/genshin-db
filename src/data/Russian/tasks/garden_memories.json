	"talks": [
		{
			"id": 1300301,
			"completionStepIds": [
				1300301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300301",
							"2"
						],
						"stepId": 1300301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030101,
					"content": "В общем, загрязнённая зона появилась из-за утечки артерий земли в лесу, а теперь всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130030102,
					"content": "Вот оно что, спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030103
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 130030103,
					"content": "Когда остатки энергии из артерий рассеются, сделаем объявление, что лес больше не опасен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030104
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 130030104,
					"content": "Вот ваша награда, как мы и договаривались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030105
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 130030105,
					"content": "Вы выходите из Гильдии искателей приключений, и Паймон отводит вас в укромное место...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130030106
					]
				},
				{
					"id": 130030106,
					"content": "Карката... Его придётся сдать в Академию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130030107,
					"content": "Он и так сломан, но всё равно, Паймон как-то не по себе от мысли, что скоро его разберут на части.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130030108,
					"content": "Мне тоже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030109
					]
				},
				{
					"id": 130030109,
					"content": "А давай тогда завтра пойдём к Тигнари и попросим его не избавляться от Каркаты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130030110,
					"content": "Хочется пойти прямо сейчас, но Тигнари сказал: «Обо всём остальном поговорим завтра». Если пойти сейчас, он только ещё больше разозлится, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130030111,
					"content": "Похоже на то.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030112
					]
				},
				{
					"id": 130030112,
					"content": "Тогда решено! Завтра пойдём к Тигнари и упросим его не демонтировать Каркату!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1300303,
			"completionStepIds": [
				1300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300303",
							"2"
						],
						"stepId": 1300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тигнари",
					"Карката"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030301,
					"content": "Тигнари...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130030302,
					"content": "Тсс, тише.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030303
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030303,
					"content": "Дафна сиреневая, семейство Волчниковые, род Дафны. Обладает сильным противосудорожным действием, может использоваться в порошках для анестезии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030304
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030304,
					"content": "Согласно двум группам экспериментальных данных, крайне токсична для рыб... Не отвлекайся, записывай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030305
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030305,
					"content": "Гу-ру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030306
					],
					"speakerTitle": "Карката"
				},
				{
					"id": 130030306,
					"content": "Карката?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130030307,
					"content": "Гу-ру! Гу-ру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030308
					],
					"speakerTitle": "Карката"
				},
				{
					"id": 130030308,
					"content": "Я ведь просил потише! Растения шума не боятся, зато у меня в ушах звенит от ваших криков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030309
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030309,
					"content": "Ты что, не стал его демонтировать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130030310,
					"content": "А зачем мне его демонтировать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030311
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030311,
					"content": "Но ты ведь сам говорил: «Законы Академии предписывают...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130030312,
					"content": "Так вот почему вы заявились сюда в такую рань. Да, я сам виноват, плохо объяснил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030313
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030313,
					"content": "Я имел в виду, что законы Академии предписывают уничтожить все результаты исследований механической жизни, поэтому нельзя, чтобы Академии стало известно о лаборатории Абаттуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030314
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030314,
					"content": "Значит, ты остался там, чтобы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030315
					]
				},
				{
					"id": 130030315,
					"content": "Сначала я отремонтировал Каркату. В Академии я проходил факультатив в даршане Спантамад. Не думал, что однажды эти знания пригодятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030316
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030316,
					"content": "Потом мы вместе похоронили Абаттуи. Часть лабораторных материалов я оставил себе на память, всё остальное сжёг, а пепел закопал, чтобы уничтожить улики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030317
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030317,
					"content": "Я всё равно не состою в Академии, почему я должен подчиняться её законам? Наоборот, я страж леса Авидья. Значит, обязан оберегать жизни всех лесных обитателей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030318
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030318,
					"content": "Любая жизнь имеет смысл, и Карката - не исключение. Он уже существует. Значит, нельзя его просто так выбросить или уничтожить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030319
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030319,
					"content": "Ха-ха! Вот и отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130030320,
					"content": "Гу-ру-ру?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030321
					],
					"speakerTitle": "Карката"
				},
				{
					"id": 130030321,
					"content": "Погоди, ты сейчас сказал «любая жизнь». Значит, ты признаёшь, что Карката - самое настоящее живое существо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130030322,
					"content": "Я просто не исключаю такой вероятности. Иначе трудно объяснить, почему он решил «починить» Абаттуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030323
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030323,
					"content": "Но Абаттуи почти не оставил журналов с записями экспериментов. Никто не знает, сколько команд он на самом деле задал Каркате.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030324
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030324,
					"content": "Может, такое поведение стало следствием конфликта между разными командами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030325
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030325,
					"content": "Строго говоря, мы не можем заключить, что Карката - самое настоящее живое существо. Но пока остаётся такая вероятность, я предпочитаю в неё верить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030326
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030326,
					"content": "Гу-ру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030327
					],
					"speakerTitle": "Карката"
				},
				{
					"id": 130030327,
					"content": "Кстати скажу, что исследования механической жизни мне не очень интересны, я оставил Каркату, потому что здесь он будет в безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030328
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030328,
					"content": "Но теперь вижу, что из него выходит неплохой ассистент. По крайней мере, я могу доверить ему вести записи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030329
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030329,
					"content": "Что скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030330
					],
					"speakerTitle": "Тигнари"
				},
				{
					"id": 130030330,
					"content": "Гу-ру! Гу-ру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Карката"
				}
			]
		},
