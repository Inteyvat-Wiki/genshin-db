			"trigger": {
				"objectNames": [
					"Хуссени"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700270101,
					"content": "Ты как раз вовремя. Калибровка шипов Пурсины проходит гладко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270102
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700270102,
					"content": "Если мы сможем заполучить нужные нам компоненты, их можно будет восстановить в кратчайшие сроки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270103
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700270103,
					"content": "#Я уже немного собрал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270104
					]
				},
				{
					"id": 700270104,
					"content": "#Спасибо, ты очень помог{F#ла}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270105
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700270105,
					"content": "Теперь, когда у нас появились детали, это не займёт много времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270106
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700270106,
					"content": "Есть ещё один небольшой вопрос, который я бы хотел обсудить с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270107
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700270107,
					"content": "#Пока ты последние несколько дней собирал{F#а} эти компоненты, я внимательно изучил внутреннее устройство имеющихся у нас шипов Пурсины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270108
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700270108,
					"content": "Это очень сложные инструменты, чего и следовало ожидать от такого умелого человека, как Пурсина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270109
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700270109,
					"content": "Даже небольшая регулировка может сильно повлиять на работу всей машины, поэтому я немного беспокоился, дадут ли наши калибровки желаемый эффект.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270110
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700270110,
					"content": "По соображениям безопасности я хотел бы попросить тебя провести несколько пробных запусков. Затем я проведу дальнейшую калибровку на основе данных, собранных тобой в ходе этих испытаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270111
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700270111,
					"content": "Так мы сможем гарантировать, что наши шипы работают с максимальной эффективностью. В противном случае есть риск, что они могут не сработать с этой аномальной моделью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270112,
						700270113
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700270112,
					"content": "Очень честно с твоей стороны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				},
				{
					"id": 700270114,
					"content": "Я впервые работаю с шипами Пурсины, поэтому лучше проявить осторожность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270115
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700270115,
					"content": "#Что ж, я оставляю испытания в твоих надёжных руках, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700270113,
					"content": "Я понимаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				}
			]
		}
	]
}