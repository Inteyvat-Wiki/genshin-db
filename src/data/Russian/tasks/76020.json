			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ирмари"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760200101,
					"content": "Эх, сегодня тоже не повезло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200102,
						760200105,
						760200112,
						760200117
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200102,
					"content": "Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200103
					]
				},
				{
					"id": 760200103,
					"content": "Рыбу ловлю. Но пока что на крючок попалась лишь какая-то ерунда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200104
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200104,
					"content": "Ладно бы это были безделушки с затонувших кораблей, уличные торговцы их с руками бы оторвали. Однажды я вытащил сапог с половиной... Ладно, замолкаю, а не то всю рыбу распугаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200105,
					"content": "Поблизости есть что-нибудь примечательное?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200106
					]
				},
				{
					"id": 760200106,
					"content": "Тоже охотишься за сокровищами? Ищешь «Великое сокровище», что скрывается к востоку от луны, на запад от солнца... Нетрудно догадаться, что здесь его нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200107
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200107,
					"content": "Кстати, в этих местах когда-то случилось немало кораблекрушений. Возможно, сокровища прячутся на затонувших кораблях, но найти их будет не так-то просто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200108
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200108,
					"content": "В таверне выжившие матросы рассказывали, что та ночь была безлунной, но среди вздымающихся до небес огромных волн что-то светилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200109
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200109,
					"content": "Говорят, то был Одноглазый Кратти - чудовище, что ведёт вечную борьбу с Морским змеем за власть над морем. Оно способно поглотить даже луну!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200110
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200110,
					"content": "Долгое время после этого море было чернее смолы, и корабли обходили эти проклятые воды стороной, боялись, что призраки на дно утащат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200111
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200111,
					"content": "Говорят, что призраки до сих пор бродят поблизости, но как по мне, чушь это всё, таким только детишек пугать. Я в такую чепуху не верю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200112,
					"content": "Об этом дереве...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200113
					]
				},
				{
					"id": 760200113,
					"content": "С ним и правда что-то нечисто. Тут раньше был водоворот... Око Кратти - так его прозвали матросы. А потом раз - и внезапно посреди водоворота вдруг выросло дерево.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200114
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200114,
					"content": "Однако в те времена странностей было куда больше. Если подумать, всё началось, когда с неба посыпались камни... Быть может, и это дерево свалилось откуда-то с небес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200115
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200115,
					"content": "Временами можно увидеть блестящие штучки - настоящая диковинка! Я подумал, может, и новая рыба заведётся, вот и пришёл сюда попытать счастье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200116
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200116,
					"content": "Со мной как-то рыбачил один парень, всё время жаловался, что слышит какие-то странные песни... В общем, он так испугался, что больше я его здесь не видел. Хм... Он лишь наполовину Дитя Морозной Луны, а причуд у него - на целый народ хватит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200117,
					"content": "Не буду мешать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200118
					]
				},
				{
					"id": 760200118,
					"content": "Пустяки. Тут и намёка на рыбу нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ирмари"
				}
			]
		},
