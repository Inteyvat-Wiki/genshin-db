						],
						"pointId": 13689
					}
				]
			},
			"dialogs": [
				{
					"id": 760200301,
					"content": "Ого... Здесь целая россыпь блестящих штучек, которые мы видели раньше! Вот только... где это мы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760200302,
					"content": "Может, мы оказались под тем странным деревом? И что это там за зеленоватые штуковины в середине?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7602004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
