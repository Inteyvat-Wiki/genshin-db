					},
					{
						"sceneId": 3,
						"position": [
							2190.965,
							200.227,
							8784.622
						],
						"pointId": 13688
					}
				]
			},
			"dialogs": [
				{
					"id": 760200701,
					"content": "Чудеса да и только...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200702
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200702,
					"content": "Вы это видели? Дерево только что внезапно засветилось, да и эти маленькие штуки тоже. Жаль, что это не рыба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200703
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200703,
					"content": "Так значит, эта штуковина посередине - его корень? Паймон не знает, как это работает, но он так красиво блестит, гораздо лучше, чем когда был тусклым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760200704,
					"content": "Вы рассказываете о случившемся...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760200705
					]
				},
				{
					"id": 760200705,
					"content": "В это трудно поверить... Но вам нет смысла меня обманывать. Выходит, и мой трусливый спутник, полукровка из Детей Морозной Луны, не врал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200706
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200706,
					"content": "Ну и что с того? Это всего лишь призраки прошлого. Пусть и дальше поют свои песни, мне-то что. У живых свои дела есть. Нам нужно рыбу ловить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200707
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200707,
					"content": "Да, вы ведь тоже охотники за сокровищами. Штуковина, которую вы только что подобрали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200708
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200708,
					"content": "Это и есть <color=#00E1FFFF>Знак Мудреца</color>? На вид обычное перо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760200709,
					"content": "Один знакомый торговец говорил, если собрать пять <color=#00E1FFFF>Знаков Мудреца</color>, найдёшь «Великое сокровище», спрятанное к востоку от луны, на запад от солнца. Не знаю только, правда это или выдумки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200710
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200710,
					"content": "Охотники за сокровищами верят, что всё правда. И гоняются за своим «Великим сокровищем», словно полоумные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200711
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760200711,
					"content": "Это ведь сокровище! Если честно, Паймон тоже очень интересно, как его найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760200712,
