				{
					"id": 400711001,
					"content": "Ох, помогите, кто-нибудь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711002
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400711002,
					"content": "Ой, это разве не статуя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711003,
					"content": "Какая я тебе статуя?! Я Леон, рыцарь Нирваны Ночи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711004
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400711004,
					"content": "Рыцарь? Что-то непохоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711005,
					"content": "Непохоже? Ох, ну даже если и так, прошу, не судите Озвальдо строго. Это он создал доспехи для Вороньих рыцарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711006
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400711006,
					"content": "Озвальдо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711007
					]
				},
				{
					"id": 400711007,
					"content": "#{NICKNAME}, ты ведь знаешь, да? Полное имя Оза - Озвальдо Храфнавинс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711008,
						400711009
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711008,
					"content": "Да, знаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				},
				{
					"id": 400711010,
					"content": "Мегистус всё-таки полегче выговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711011
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400711011,
					"content": "Определённо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711012
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400711012,
					"content": "Ха-ха, похоже на то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711013
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711013,
					"content": "Уважаемые господа, мне бы очень не хотелось прерывать вашу приятную беседу, но... полагаю, вам не сообщили, что ворота впереди заперты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711014
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400711014,
					"content": "Да, полная неожиданность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711015
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711015,
					"content": "Но если вы великодушно соизволите протянуть мне руку помощи, то в благодарность я с превеликим удовольствием научу, как открыть ворота.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711016
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400711016,
					"content": "Ну тогда мы определённо должны тебе помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711009,
					"content": "Теперь знаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				}
			]
		},
		{
			"id": 4007112,
			"completionStepIds": [
				4007112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
