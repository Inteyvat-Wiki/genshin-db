			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Синь Янь",
					"Каэдэхара Кадзуха",
					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710201,
					"content": "#Ты {M#проснулся}{F#проснулась}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400710202,
					"content": "Ох, уже утро...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710203
					]
				},
				{
					"id": 400710203,
					"content": "В чём дело? Что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710204
					]
				},
				{
					"id": 400710204,
					"content": "Ты, наверное, не поверишь, но не случилось абсолютно ничего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400710205,
					"content": "#Ты проснул{F#ась}{M#ся}? Тогда давай сразу к делу. Ничего подозрительного поблизости мы не нашли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710206
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400710206,
					"content": "Судя по предыдущим видениям, здесь должен быть какой-то предмет, открывающий вход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710207
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400710207,
					"content": "Странно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710208
					]
				},
				{
					"id": 400710208,
					"content": "Может, время ещё не пришло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710209
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400710209,
					"content": "Думаешь, нужно ещё подождать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710210
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400710210,
					"content": "Да. К тому же здесь нет Фишль. Она-то заинтересована в том, чтобы найти вход, намного больше нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710211
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400710211,
					"content": "Давайте подождём. Дадим миру грёз... то есть, Фишль немного времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710212
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400710212,
					"content": "Одобрив предложение Моны, все решили сделать перерыв на чай. После чего, разделившись на две группы, вновь принялись за поиски.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710213
					]
				},
				{
					"id": 400710213,
					"content": "После тщетных блужданий на побережье наконец-то обнаружился загадочный предмет.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710214
					]
				},
				{
					"id": 400710214,
					"content": "Ой, тут что-то в песке валяется!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400710215,
					"content": "Книга? А рядом фигурка ворона?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710216
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400710216,
					"content": "Эта фигурка очень похожа на Оза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400710217,
					"content": "Почему они тут вместе лежат? Это ворон принёс книгу сюда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710218
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400710218,
					"content": "Что это? Дневник?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710219
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400710219,
					"content": "Ну-ка... «Песнопения священного царства»? Впервые вижу книгу с таким названием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710220
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400710220,
					"content": "Судя по обложке... Неужели её написала Фишль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400710221,
					"content": "Названия вроде «Песнопения священного царства» - это в её стиле. Мне нравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710222
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400710222,
					"content": "В названии книги ощущается что-то возвышенное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710223
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400710223,
					"content": "И что дальше? Надо к ней притронуться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400710224,
					"content": "Фишль до сих пор нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710225
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400710225,
					"content": "Неважно, давайте зайдём в мир грёз и осмотримся. Если Фишль найдёт книгу, она наверняка скоро появится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710226
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400710226,
					"content": "Это точно! Мы как будто подглядываем в её дневник, она наверняка захочет войти и остановить нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4007103,
			"completionStepIds": [
				4007103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
