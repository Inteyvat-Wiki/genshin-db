				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мона",
					"Синь Янь",
					"Каэдэхара Кадзуха",
					"Арнольд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711501,
					"content": "Ой! Мы вернулись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711502,
					"content": "Как же так?! Почему мы вернулись? Мы ведь не дослушали историю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711503,
					"content": "Какое противное чувство. Всё равно что купить поддельные учебники по астрологии. Или когда в самый разгар ужина вдруг вспоминаешь, что забыл дома кошель с морой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711504
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711504,
					"content": "О-о-о!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711505,
					"content": "О-о-ох! Кошмар!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711506
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711506,
					"content": "Похоже, их это здорово расстроило.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711507
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400711507,
					"content": "Честно говоря, мне тоже не нравятся книги с открытым финалом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711508
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400711508,
					"content": "Ха-ха, ну а кому такое нравится? Давайте попробуем вновь войти в тот мир грёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711509
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400711509,
					"content": "Отличная идея! Ну, идём же!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711510,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711511
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400711511,
					"content": "Никакой реакции. И мы до сих пор здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711512
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400711512,
					"content": "Странно. Только недавно путь был свободен, а теперь нас туда не пускает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711513
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400711513,
					"content": "Да что же это такое?! Как можно не давать людям дочитать книгу до конца?! Какая жестокость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711514
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711514,
					"content": "Эх... Может, дело в том, что эту книгу мы как раз и дочитали до конца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711515
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400711515,
					"content": "Перед тем, как покинуть мир грёз, мы заметили, что книга была на последней странице. Думаю, «Песнопения священного царства» состоят не из одного тома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711516
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400711516,
					"content": "А с лёгкими романами всегда так. Хочешь узнать, что будет дальше? Тогда покупай второй том, третий и ещё, и ещё. Фу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711517,
					"content": "Уф, я обязательно узнаю, чем всё закончилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711518
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711518,
					"content": "О да, концовка... Всех вечно интересует, чем книга заканчивается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711519
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400711519,
					"content": "А? Кто это там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711520
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711520,
					"content": "О-о-о нет, она меня заметила... Смирно-смирно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711521
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400711521,
					"content": "Кто ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711522
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711522,
					"content": "Я Арнольд Спроси-Меня-Как-Добраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711523
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400711523,
					"content": "Довольно очевидный намёк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711524
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711524,
					"content": "Арнольд, позволь спросить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711525
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711525,
					"content": "Не Арнольд, а Арнольд Спроси-Меня-Как-Добраться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711526
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400711526,
					"content": "Можно спросить, Арнольд Спроси-Меня-Как-Добраться?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711527
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711527,
					"content": "Конечно, госпожа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711528
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400711528,
					"content": "Есть ли у «Песнопений священного царства» продолжение? И где его найти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711529
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711529,
					"content": "О-о-о, вы обратились по адресу. «Песнопения священного царства» - это священное писание Нирваны Ночи в трёх томах. Последние два тома можно отыскать на высотах столичного города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711530
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400711530,
					"content": "Чтобы найти второй том, вам нужно подняться на самый верх башни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711531
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400711531,
					"content": "Башня... Речь о вон той башне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711532
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711532,
					"content": "Совершенно верно. В этой башне хранится священное писание. Попасть в неё можно с помощью секретного прохода. Чтобы найти его, вам стоит обыскать ту пещеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711533
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400711533,
					"content": "Хорошо. Спасибо, Арнольд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711534
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711534,
					"content": "Не Арнольд, а Арнольд Спроси-Меня-Как-Добраться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711535
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400711535,
					"content": "Больше прелестная госпожа не хочет меня ни о чём спросить? Например, есть ли у меня девушка или сколько я зарабатываю в месяц...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711536
					],
					"speakerTitle": "Арнольд"
				},
				{
					"id": 400711536,
					"content": "Нет, спасибо, до свидания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711537
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711537,
					"content": "Думаю, этот ворон нас больше не интересует. В пещере есть потайной ход, по которому можно попасть в башню. Идём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711538
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711538,
					"content": "Милая госпожа! Неужели я вам совсем не любопытен? А ведь за вашу красоту я готов раскрыть вам все тайны Нирваны Ночи! Госпожа!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арнольд"
				}
			]
		}
	]
}