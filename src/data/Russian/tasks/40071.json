				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рассказчик",
					"Мона",
					"Синь Янь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710301,
					"content": "«Хотя в умах простых людей не сохранилось воспоминаний о тех временах, однако учёные знают, что повелительница Фишль фон Луфтшлосс Нарфидорт правила миром в эпоху Хаоса, шесть столетий до эпохи Святых».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710302
					],
					"speakerTitle": "Рассказчик"
				},
				{
					"id": 400710302,
					"content": "Чего? Рассказчик?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710303
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400710303,
					"content": "Ну да, это же книга. Там непременно должен быть кто-то, кто ведёт повествование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710304
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400710304,
					"content": "По этому пути нам уже не пройти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400710305,
					"content": "Там какой-то механизм. Словно ждёт, когда мы к нему подойдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710306
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400710306,
					"content": "Только у Паймон такое ощущение, что здесь всё как-то слишком нарочито?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400710307,
					"content": "Это же как-никак священное царство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710308
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400710308,
					"content": "Всё тут прямо так и привлекает внимание, будто специально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400710309,
					"content": "Что и ожидалось от Фишль - пугающая прямолинейность во всём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Синь Янь"
				}
			]
		},
