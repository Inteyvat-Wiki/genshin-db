			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Леон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711201,
					"content": "О великие герои, мне не передать словами те эмоции, что наполняют моё сердце в это мгновенье. От всего сердца вас благодарю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711202
					],
					"speakerTitle": "Леон"
				},
				{
					"id": 400711202,
					"content": "Запомните этот пароль: «Да будет мой народ свободен от оков древних порядков».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Леон"
				}
			]
		},
		{
			"id": 4007113,
			"completionStepIds": [
				4007113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007113",
							"2"
						],
						"stepId": 4007113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Синь Янь",
					"Мона",
					"Каэдэхара Кадзуха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711301,
					"content": "Дальше пути нет. Только книга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711302,
					"content": "Полагаю, мы сейчас услышали историю из этой книги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711303
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400711303,
					"content": "Значит, священное царство, упомянутое в ней, и есть Нирвана Ночи. А сама книга - дань уважения принцессе от её народа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711304
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711304,
					"content": "Думаю, это автобиография.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711305
					]
				},
				{
					"id": 400711305,
					"content": "Книга уже подошла к концу, но история, похоже, ещё продолжается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711306
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400711306,
					"content": "Продолжается? Паймон хочет узнать продолжение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711307,
					"content": "Тогда нам стоит продолжить наше исследование. А эта книга... Раз мы его прочитали, то, пожалуй, стоит её закрыть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				}
			]
		},
		{
			"id": 4007114,
			"completionStepIds": [
				4007114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007114",
							"2"
						],
						"stepId": 4007114,
						"stateName": "QUEST_STATE_UNFINISHED"
