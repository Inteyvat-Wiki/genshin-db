			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мона",
					"Фишль",
					"Мама Фишль",
					"Папа Фишль",
					"Каэдэхара Кадзуха",
					"Синь Янь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711401,
					"content": "А? Мы переместились, но не обратно на пляж.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711402
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711402,
					"content": "Похоже, мы где-то в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711403,
					"content": "Досточтимая Королева осуждения, приветствую вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711404
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400711404,
					"content": "Эми, деточка, мама приготовила тебе отбивную котлетку и рыбацкий бутерброд. Ешь, пока горячее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711405
					],
					"speakerTitle": "Мама Фишль"
				},
				{
					"id": 400711405,
					"content": "Кхм! Мама...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711406
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400711406,
					"content": "Ох, прошу прощения, совсем забыла. Принцесса осуждения, известно ль вам, что близится час обеда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711407
					],
					"speakerTitle": "Мама Фишль"
				},
				{
					"id": 400711407,
					"content": "Конечно, мама.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711408
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400711408,
					"content": "Ох, смотрите какая красота за окном! Принцесса, королева, не желаете ли вы отобедать на природе с моим величеством, Королём осуждения. Мы вместе полюбуемся красивыми видами и насладимся дарованными небесами яствами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711409
					],
					"speakerTitle": "Папа Фишль"
				},
				{
					"id": 400711409,
					"content": "С удовольствием!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711410
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400711410,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711411
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711412
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400711412,
					"content": "Кто-нибудь что-нибудь хочет сказать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711413
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400711413,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711414
					]
				},
				{
					"id": 400711414,
					"content": "Ладно, я скажу. Значит, настоящее имя Фишль - Эми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711415
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400711415,
					"content": "Получается так. А те голоса принадлежали её маме и папе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711416,
					"content": "Что вы на меня так смотрите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711417
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711417,
					"content": "Прошу прощения за вопрос, но... Мегистус - это твоя настоящая фамилия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711418
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400711418,
					"content": "Сомневаться во мне вздумал? Я гениальный астролог, и моё полное имя - Астрологист Мона Мегистус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711419
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711419,
					"content": "Прошу прощения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711420
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400711420,
					"content": "Не длинновато ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711421
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400711421,
					"content": "Только у истинных гениев может быть такое имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711422
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711422,
					"content": "Вряд ли это связано.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711423,
					"content": "И что вы обо всём этом думаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711424
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711424,
					"content": "В одном мы убедились. Закрытие книги - способ изменения этого мира грёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711425
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400711425,
					"content": "Родные Фишль подыгрывают ей. Как это мило!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711426
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400711426,
					"content": "Но вряд ли они стали бы баловать её так всегда. Судя по голосу, это её воспоминания из детства. После взросления многое может измениться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711427
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711427,
					"content": "Мона, тебе многое известно о Фишль!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711428
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400711428,
					"content": "Мы же подруги, что в этом такого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711429
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711429,
					"content": "Где она сейчас может быть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711430
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400711430,
					"content": "Судя по тому, что мы услышали, Фишль куда-то ушла. Нам тоже стоит двигаться. Наверняка мы что-нибудь найдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				}
			]
		},
		{
			"id": 4007115,
			"completionStepIds": [
				4007115
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007115",
							"2"
						],
						"stepId": 4007115,
						"stateName": "QUEST_STATE_UNFINISHED"
