			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сайрус"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100601,
					"content": "Как всё прошло? Тебе удалось узнать мнение людей о гильдии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100602
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100602,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100603
					]
				},
				{
					"id": 700100603,
					"content": "Значит, теперь ты понимаешь, что я имею в виду... Вот так у нас обстоят дела. Я уже давно к этому привык.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100604
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100604,
					"content": "Мне всё равно какой способ использовать. Я буду благодарить Архонтов, лишь бы был результат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100605
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100605,
					"content": "Полагаю, ты собираешься вернуться на Драконий хребет к Айрис, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100606
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100606,
					"content": "#Будь любез{M#ен}{F#на}, передай ей это письмо. Ей определённо захочется узнать, как сейчас дела в гильдии. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100607
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100607,
					"content": "Надеюсь, у нас на этот раз появятся новобранцы... Но будут ли те, кто придёт к нам таким манером, надёжными искателями приключений?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайрус"
				}
			]
		},
		{
			"id": 7001007,
			"completionStepIds": [
				7001002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
