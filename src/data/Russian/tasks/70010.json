				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Шестипалый Хосе"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100401,
					"content": "#Эй, {F#подруга}{M#дружище}! Не хочешь послушать моё последнее творение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100402
					],
					"speakerTitle": "Шестипалый Хосе"
				},
				{
					"id": 700100402,
					"content": "Мы хотим поговорить о Гильдии...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100403
					]
				},
				{
					"id": 700100403,
					"content": "#Вы набираете рекрутов? Прости, {F#подруга}{M#дружище}, но меня такое не интересует. Носиться повсюду, как угорелый, барду ни к чему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100404
					],
					"speakerTitle": "Шестипалый Хосе"
				},
				{
					"id": 700100404,
					"content": "К тому же в Мондштадте для написания эпосов есть источник гораздо лучше - это рыцари Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100405
					],
					"speakerTitle": "Шестипалый Хосе"
				},
				{
					"id": 700100405,
					"content": "Извини, но набор в Гильдию искателей приключений меня не интересует. Да и о спасателях кошек легенд не сложишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100406
					],
					"speakerTitle": "Шестипалый Хосе"
				},
				{
					"id": 700100406,
					"content": "Вот, взгляни на эти фотографии.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100407
					]
				},
				{
					"id": 700100407,
					"content": "Это... Драконий хребет? Поистине великолепный вид...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100408
					],
					"speakerTitle": "Шестипалый Хосе"
				},
				{
					"id": 700100408,
					"content": "Возможно, прогулка по такому месту придаст мне нового вдохновения. Да и выглядит не так уж опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100409
					],
					"speakerTitle": "Шестипалый Хосе"
				},
				{
					"id": 700100409,
					"content": "Хм... Позже я загляну в Гильдию. Даже если я не вступлю, так найму искателя приключений, который меня сопроводит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100410
					],
					"speakerTitle": "Шестипалый Хосе"
				},
				{
					"id": 700100410,
					"content": "Путешествие по Драконьему хребту... Дрожу от нетерпения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шестипалый Хосе"
				}
			]
		},
		{
			"id": 7001005,
			"completionStepIds": [
				7001012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001012",
							"2"
						],
						"stepId": 7001012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хелен"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100501,
					"content": "Да? Чем могу помочь? Я как раз собиралась исполнить песню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100502
					],
					"speakerTitle": "Хелен"
				},
				{
					"id": 700100502,
					"content": "Мы хотим поговорить о Гильдии...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100503
					]
				},
				{
					"id": 700100503,
					"content": "Ах, вы по поводу набора рекрутов? Я видела объявление, но мне это неинтересно. Зачем мне становиться искателем приключений, когда я могу защитить Мондштадт песней?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100504
					],
					"speakerTitle": "Хелен"
				},
				{
					"id": 700100504,
					"content": "Я слышала, что большая часть поручений - разная мелкая работа. Никакой выгоды для себя я в этом не вижу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100505
					],
					"speakerTitle": "Хелен"
				},
				{
					"id": 700100505,
					"content": "#Извини, но я, пожалуй, откажусь. Спасибо, что подумал{F#а} обо мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100506
					],
					"speakerTitle": "Хелен"
				},
				{
					"id": 700100506,
					"content": "Вот, взгляни на эти фотографии.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100507
					]
				},
				{
					"id": 700100507,
					"content": "Хм? Это ведь Драконий хребет, да? И статуя семи Архонтов, окружённая снегом... Поразительный пейзаж.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100508
					],
					"speakerTitle": "Хелен"
				},
				{
					"id": 700100508,
					"content": "Там, наверное, очень высоко? Говорят, что оттуда открывается вид на многие километры вокруг. А если там спеть, то эхо унесёт слова вдаль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100509
					],
					"speakerTitle": "Хелен"
				},
				{
					"id": 700100509,
					"content": "Хорошо, я обязательно зайду в Гильдию попозже. Насколько я помню, там можно нанимать искателей приключений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100510
					],
					"speakerTitle": "Хелен"
				},
				{
					"id": 700100510,
					"content": "Никогда бы не подумала, что приключения могут привести в такие места... Как увлекательно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хелен"
				}
			]
		},
		{
			"id": 7001006,
			"completionStepIds": [
				7001015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
