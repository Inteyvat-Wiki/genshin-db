						],
						"stepId": 7001008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Айрис"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100201,
					"content": "Я насчёт поручения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100202
					]
				},
				{
					"id": 700100202,
					"content": "О, у тебя уже всё готово?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100203
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100203,
					"content": "Всё сделано в лучшем виде.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100204
					]
				},
				{
					"id": 700100204,
					"content": "#Благодарю за хорошо проделанную работу. Я уже всё упаковала. Не мог{F#ла} бы ты доставить мою посылку малышу в Мондштадт? Только не забудь после этого вернуться за оплатой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100205
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100205,
					"content": "Не знаю, хватит ли этого, но если он хочет привлечь людей, то описания чудовищ и руда должны быть для них самыми интересными...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айрис"
				}
			]
		},
		{
			"id": 7001003,
			"completionStepIds": [
				7001009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001009",
							"2"
						],
						"stepId": 7001009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сайрус"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100301,
					"content": "Эх, от этого плана не будет никакого толку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100302
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100302,
					"content": "Тебе посылка от Айрис...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100303
					]
				},
				{
					"id": 700100303,
					"content": "Хм? Она мне что-то отправила? Ах да, точно, точно. Я попросил её кое о чём, но потом эта просьба напрочь вылетела из моей головы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100304
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100304,
					"content": "Ты даже на Праздник ветряных цветов работаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100305
					]
				},
				{
					"id": 700100305,
					"content": "Праздник ветряных цветов? Что ты, у меня нет на это времени. Наш прошлый план по набору рекрутов в гильдию устарел, и я занят составлением нового...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100306
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100306,
					"content": "Дай-ка посмотреть, что там отправила Айрис...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100307
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100307,
					"content": "Руда... Бесполезно... Молодёжь сейчас таким не заинтересовать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100308
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100308,
					"content": "Карты? Эх... Членам гильдии они пригодятся, да. Но вряд ли они помогут привлечь людей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100309
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100309,
					"content": "Записи о чудовищах? Надо сделать несколько копий для наших искателей приключений, но набору рекрутов они не помогут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100310
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100310,
					"content": "Ого, а это что? Эти фотографии хороши. Великолепный пейзаж, да ещё и выглядит безопасно. Такое обязательно кого-нибудь заинтересует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100311
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100311,
					"content": "Почему ты выбрал именно их?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100312
					]
				},
				{
					"id": 700100312,
					"content": "Похоже, он отбросил всё, что по-настоящему связано с приключениями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700100313,
					"content": "Ты не понимаешь, в каком состоянии сегодня находится Гильдия. Нынешняя молодёжь уже не интересуется монстрами, рудой и топографическими картами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100314
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100314,
					"content": "Чтобы привлечь новых людей, нужно нечто... наглядное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100315
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100315,
					"content": "Сейчас Праздник ветряных цветов, и каждому молодому человеку хочется показать своё обаяние оригинальным, но относительно безопасным способом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100316
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100316,
					"content": "Поход по Драконьему хребту - один из таких способов. Если кто-то заинтересуется этими фотографиями, то возможно, что он придёт в гильдию, чтобы узнать о них побольше, и, может быть, даже подаст заявку на вступление...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100317
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100317,
					"content": "А если нет, тогда... немного дополнительных поручений нам не помешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100319
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100319,
					"content": "Взгляни на эти две фотографии. Они обе сделаны рядом с главной дорогой. Если быть осторожным, то останешься целым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100320
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100320,
					"content": "Неужели всё настолько запущенно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100321
					]
				},
				{
					"id": 700100321,
					"content": "Ну, вот как у нас обстоят дела. Других идей у меня нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100322
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100322,
					"content": "Если ты мне не веришь, возьми эти фотографии и покажи их людям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100323
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100323,
					"content": "Сначала скажи, что у нас идёт набор рекрутов, и в качестве «наглядного материала» покажи эти две фотографии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100324
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 700100324,
					"content": "Тогда ты поймёшь, почему мне в голову пришла именно такая идея.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайрус"
				}
			]
		},
		{
			"id": 7001004,
			"completionStepIds": [
				7001011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001011",
							"2"
						],
						"stepId": 7001011,
						"stateName": "QUEST_STATE_UNFINISHED"
