			"dialogs": [
				{
					"id": 700100701,
					"content": "Я насчёт поручения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100702
					]
				},
				{
					"id": 700100702,
					"content": "#Ох, наконец-то ты вернул{M#ся}{F#ась}! Почему так долго? Наверняка Сайрус добавил тебе работы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100703
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100703,
					"content": "#Я помогал{F#а} ему узнать мнения людей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100704
					]
				},
				{
					"id": 700100704,
					"content": "Что это там малыш снова затевает... Что? Письмо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100705
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100705,
					"content": "В этом письме описывается текущее положение дел в гильдии.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100706
					]
				},
				{
					"id": 700100706,
					"content": "Какое длинное... Выходит, всё это время он был занят. Даже на Праздник ветряных цветов не отдыхал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100707
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100707,
					"content": "Раз уж он так упорно трудится, мондштадтское отделение Гильдии обязательно обретёт новых членов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100708
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100708,
					"content": "С достаточным количеством новобранцев он мог бы освободиться от мелких дел и снова отправиться со мной на поиски приключений... Ах, было бы здорово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100709
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100709,
					"content": "Я внимательно прочту это письмо. Однако теперь, когда Сайрус добавил тебе работы, я просто обязана увеличить твою награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100710
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100710,
					"content": "Вот, прими это. Спасибо тебе за труд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айрис"
				}
			]
		},
