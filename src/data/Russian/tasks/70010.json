	"talks": [
		{
			"id": 7001001,
			"completionStepIds": [
				7001003
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001003",
							"2"
						],
						"stepId": 7001003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Айрис"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100101,
					"content": "Я насчёт поручения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100102
					]
				},
				{
					"id": 700100102,
					"content": "#Узнал{F#а} о моём поручении и сразу же поторопил{F#ась}{M#ся} ко мне? Верно, мне действительно пригодилась бы твоя помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100103
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100103,
					"content": "А именно, мне нужны фотографии двух мест на Драконьем хребте. Я отмечу их на твоей карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100104
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100104,
					"content": "Награду ты получишь в соответствии с правилами Гильдии искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100105
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100105,
					"content": "Что скажешь? Возьмёшься за это поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100106
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100106,
					"content": "Зачем тебе фотографии этих двух мест?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100107
					]
				},
				{
					"id": 700100107,
					"content": "Ну... В общем, это связано с Сайрусом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100108
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100108,
					"content": "Ранее он попросил меня добыть для него диковинок Драконьего хребта. Он сказал, что хочет сделать их частью своей программы по набору рекрутов в гильдию во время Праздника ветряных цветов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100109
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100109,
					"content": "Праздник уже начался, но он со мной так и не связался. Занят, наверное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100110
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100110,
					"content": "Если так подумать, то он ведь уже в том возрасте, когда праздничные приготовления становятся важнее работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100111
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100111,
					"content": "Наверное, он уже слишком стар для всей этой гильдейской суеты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100112
					]
				},
				{
					"id": 700100112,
					"content": "Думаешь? Что-то мне так не кажется. На самом деле... Ай, неважно. Давай об этом пока не будем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100113
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100113,
					"content": "Я уже собрала немного руды и составила несколько топографических карт и описаний чудовищ. Я бы хотела, чтобы их дополняли фотографии живописных мест Драконьего хребта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100114
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100114,
					"content": "#Ну как, {NICKNAME}, не желаешь ли ты помочь мне и отправиться на Драконий хребет, чтобы сделать фотографии этих двух мест?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100115
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100115,
					"content": "Положись на меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100116
					]
				},
				{
					"id": 700100116,
					"content": "Отлично, тогда я оставлю эту работу тебе. Я уже оставила две отметки на твоей карте. Просто сходи туда и возвращайся, как всё сделаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100117
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100117,
					"content": "Ты не думаешь навестить город?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100118
					]
				},
				{
					"id": 700100118,
					"content": "В городе слишком оживлённо. Мне куда больше нравится здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100119
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100119,
					"content": "Да и сомневаюсь я, что смогу бросить свою работу и уйти. У меня тут дел невпроворот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100120
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 700100120,
					"content": "Я отметила места с хорошим видом на твоей карте. Просто сходи туда и возвращайся, как всё сделаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айрис"
				}
			]
		},
		{
			"id": 7001002,
			"completionStepIds": [
				7001008
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001008",
