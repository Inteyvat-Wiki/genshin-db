			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Арашакун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670401,
					"content": "Это ты Арашакун?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670402,
					"content": "У-у-у... Да, меня действительно зовут Арашакун. Ой, не подходите так близко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670403
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670403,
					"content": "Спасибо, что спасли меня. Н-но всё же близко не подходите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670404
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670404,
					"content": "Так Арашакуну спокойнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670405
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670405,
					"content": "Что? Мы же только что спасли тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670406,
					"content": "Ой, простите! Простите за грубость... только не сердитесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670407
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670407,
					"content": "Арашакун оказался здесь в западне и ещё не оправился от страха. Надеюсь, вы простите Арашакуна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670408
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670408,
					"content": "Ничего, ничего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670409,
					"content": "Спасибо. Арашакун всё ещё не знает ваших имён...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670410
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670410,
					"content": "Паймон зовут Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670411,
					"content": "#Меня зовут {NICKNAME}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670412
					]
				},
				{
					"id": 730670412,
					"content": "#{M#Золотой}{F#Золотая} нара {NICKNAME} и Паймон... А откуда вы знаете имя Арашакуна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670413
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670413,
					"content": "Мы прочитали записи в доме...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670414
					]
				},
				{
					"id": 730670414,
					"content": "#{F#Светловолосая}{M#Светловолосый} нара {F#увидела}{M#увидел} записи, {F#отправилась}{M#отправился} по следам Арашакуна и {F#спасла}{M#спас} его из западни. {F#Какая добрая и сильная}{M#Какой добрый и сильный} нара!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670415
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670415,
					"content": "У-у-у... Если бы Арашакун не потерял храбрость, то его бы не окружили...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670416
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670416,
					"content": "Об этом мы прочли в записях. Кстати, ты написал, что потерял «храбрость». Что это означает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670417,
					"content": "Это давняя история...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670418
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670418,
					"content": "Много лун назад у Арашакуна не было «храбрости», совсем как сейчас... Хрустнет ветка - и Арашакун всю ночь глаз не сомкнёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670419
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670419,
					"content": "Но у трусливого Арашакуна был друг нара, готовый составить Арашакуну компанию. Не такой могучий, как нара Варуна, но тоже очень хороший нара!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670420
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670420,
					"content": "Он никогда не дразнил Арашакуна из-за его трусости. А когда Арашакун боялся, он брал Арашакуна за руку... Арашакун никогда не забудет своего друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670421
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670421,
					"content": "Но однажды Волосатый король демонов в маске похитил этого нару...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670422
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670422,
					"content": "Постой, а что это за Волосатый король демонов в маске?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670423,
					"content": "У Волосатого короля демонов в маске лицо всё в шерсти, а сам он носит маску.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670424
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670424,
					"content": "...А, теперь понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670425,
						730670427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670425,
					"content": "Паймон, ты поняла, что это?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670426
					]
				},
				{
					"id": 730670426,
					"content": "Было бы странно, если бы Паймон поняла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670429,
					"content": "Но именно этот Волосатый король демонов в маске похитил друга Арашакуна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670430
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670430,
					"content": "...Волосатый король демонов в маске коварный. Стоит Арашакуну только подумать о нём, как Арашакун сразу же начинает трястись от страха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670431
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670431,
					"content": "У-у-у... Когда похитили друга нару, Арашакун очень боялся Волосатого короля демонов в маске, но ещё больше Арашакун боялся больше не увидеть друга нару...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670432
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670432,
					"content": "Поэтому Арашакун очень постарался! Закрыл глаза! Стиснул зубы! И руками его, руками! Вот так Арашакун спас друга нару.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670433
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670433,
					"content": "После этого друг нара сделал из цветов «амулет храбрости» и сказал Арашакуну: «Арашакун очень хороший и храбрый аранара, не трусливый аранара!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670434
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670434,
					"content": "Вот так Арашакун получил «храбрость»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670435
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670435,
					"content": "Но ведь «Закрыл глаза! Стиснул зубы! И руками его, руками!» и было храбрым поступком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670436
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670436,
					"content": "Нет-нет, Арашакун получил «храбрость» от друга нары только после этого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670437
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670437,
					"content": "Но ты же спас своего друга. Ты сам совершил храбрый поступок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670438
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670438,
					"content": "Нет-нет. Во время спасения друга Арашакун так боялся, что у него от страха тряслись руки и ноги. А когда Арашакун получил «храбрость», руки и ноги больше не тряслись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670439
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670439,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670440,
						730670441
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670440,
					"content": "Амулет - это всего лишь символ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670442,
					"content": "#У-у-у... Нара {NICKNAME} говорит очень непонятно. Арашакун только уверен, что только с «амулетом храбрости» у Арашакуна есть «храбрость»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670443
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670443,
					"content": "«Храбрость» украли, поэтому Арашакун отправился на поиски в пещеру Волосатого короля демонов в маске, чтобы снова отыскать «храбрость»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670444
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670444,
					"content": "А получилось, что несколько слаймов окружили тебя в пещере... К счастью, этот Волосатый король демонов в маске не увидел тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670445
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670445,
					"content": "#К слову... {NICKNAME}, помнишь, мы подобрали брошенную хиличурлами вещицу. Может, это и есть амулет Арашакуна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670446
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670446,
					"content": "Арашакун, кажется, мы нашли твою «храбрость»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670447
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670447,
					"content": "#Правда? Нара {NICKNAME} и Паймон действительно нашли «храбрость» Арашакуна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670441,
					"content": "Храбрость у тебя была всегда!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670427,
					"content": "Ответ в стиле аранар...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670428
					]
				},
				{
					"id": 730670428,
					"content": "Ага. Паймон ни малейшего понятия не имеет, что это за «Волосатый король демонов в маске»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Паймон"
				}
			]
		},
