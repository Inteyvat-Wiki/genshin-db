				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670601,
					"content": "Это он! Это он!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670602
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670602,
					"content": "Это и есть «амулет храбрости» Арашакуна. За несколько дней вдали от Арашакуна амулет немного потускнел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670603
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670603,
					"content": "Но ничего страшного, Арашакун позаботится о нём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670604
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670604,
					"content": "«Арашакун очень хороший и храбрый аранара, не трусливый аранара!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670605
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670605,
					"content": "#Спасибо вам, нара {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670606
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670606,
					"content": "Арашакун вернул свою «храбрость», и теперь ничто не остановит его. Арашакун уже побеждал Волосатого короля демонов в маске, и победит его вновь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670607
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670607,
					"content": "(Ух ты, он теперь даже говорит по-другому.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670608,
					"content": "#Волосатый король демонов в маске принёс много бед. За мной, нара {NICKNAME} и Паймон, вместе накажем его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670609
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670609,
					"content": "Арашакун чувствует, что сегодня чудовищу в его же логове придёт конец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670610
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670610,
					"content": "#Ладно, {NICKNAME}, пойдём. Хоть увидим, что из себя представляет Волосатый король демонов в маске.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7306707,
