				"points": []
			},
			"dialogs": [
				{
					"id": 730670101,
					"content": "Хм, эти хиличурлы обронили какую-то странную штуковину...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670102,
					"content": "Смотри, она сделана из цветов. Но странно, что эти обычные на вид цветы до сих пор не завяли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670103,
					"content": "И Паймон чувствует, что в нём много энергии Дендро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670104,
						730670106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670104,
					"content": "Эта вещь принадлежит аранарам...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670105
					]
				},
				{
					"id": 730670105,
					"content": "Да, точно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670108,
					"content": "В этой штучке из цветов столько энергии Дендро, что она не завяла даже в лапах хиличурлов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670109,
						730670110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670109,
					"content": "Может быть, её всё время носили с собой...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670111,
					"content": "Да, давай вернём её аранарам как можно скорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670112,
					"content": "#{NICKNAME}, давай войдём в дом. Может, потерявший вещицу растяпа горюет там внутри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670110,
					"content": "Наверное, это очень ценная вещь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670106,
					"content": "Эта вещь может принадлежать Дендро хиличурлу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670107
					]
				},
				{
					"id": 730670107,
					"content": "Вряд ли. Скорее всего, вещь эту потеряли местные аранары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7306702,
			"completionStepIds": [
				7306705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
