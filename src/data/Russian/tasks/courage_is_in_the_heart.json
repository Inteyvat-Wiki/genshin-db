			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670301,
					"content": "Хм... Значит, эти записи оставил аранара Арашакун?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670302,
					"content": "Но почему почерк становился то огромным, то мелким? Большие буквы ещё можно прочесть, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670303,
					"content": "У Паймон глаза болят от этих меленьких буковок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670304,
					"content": "Выходит, у тебя проблемы с мелкими буквами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670305
					]
				},
				{
					"id": 730670305,
					"content": "Паймон обычно читает буквы среднего размера, а к мелким она не привыкла, и всё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670306,
					"content": "Хм, неужели этот Арашакун больше не появлялся тут после того, как написал последние страницы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670307,
					"content": "Давай проверим пещеру на востоке. Смотри, тут написано, что «храбрость» потерялась. Как такое может потеряться? Любопытно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7306704,
			"completionStepIds": [
				7306713
			],
