			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Арашакун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670701,
					"content": "Паймон смутно догадывалась... Но на самом деле Волосатым королём демонов в маске был хиличурл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670702,
					"content": "Хиличурл?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670703
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670703,
					"content": "Ага, Волосатый король демонов в маске и есть хиличурл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670704,
					"content": "Значит, все хиличучу - Волосатые короли демонов в маске?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670705
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670705,
					"content": "Нет-нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730670706,
					"content": "Можно и так сказать, Арашакун.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670707
					]
				},
				{
					"id": 730670707,
					"content": "Ага, Арашакун понял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670708
					],
