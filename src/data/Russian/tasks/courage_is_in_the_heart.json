				},
				{
					"id": 730670708,
					"content": "#Когда рядом нара {NICKNAME} и Паймон, Арашакун непобедим! Даже коварный Волосатый демон в маске не сравнится с нами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670709
					],
					"speakerTitle": "Арашакун"
				},
				{
					"id": 730670709,
					"content": "Этот день Арашакун отметит большой записью!",
					"roleType": "TALK_ROLE_NPC",
