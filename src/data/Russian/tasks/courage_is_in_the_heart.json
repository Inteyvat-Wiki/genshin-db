				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670201,
					"content": "(Первые страницы исписаны мельчайшим почерком...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670202
					],
					"speakerTitle": "Хаотичные записки"
				},
				{
					"id": 730670202,
					"content": "«У-у-у... Поверить не могу, что нара хочет дружить с Арашакуном. Какой хороший нара! Нара не только не сторонится трусливого Арашакуна, но ещё и научил Арашакуна писать слова нар...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670203
					],
					"speakerTitle": "Хаотичные записки"
				},
				{
					"id": 730670203,
					"content": "«Хороший нара утешил Арашакуна, когда Арашакуну упал на голову лист, и тот перепугался. Нара навсегда останется хорошим другом Арашакуна!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670204
					],
					"speakerTitle": "Хаотичные записки"
				},
				{
					"id": 730670204,
					"content": "(Через несколько страниц почерк стал ещё мельче и неразборчивее...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670205
					],
					"speakerTitle": "Хаотичные записки"
				},
				{
					"id": 730670205,
					"content": "«У-у-у, нару похитил Волосатый король демонов в маске. У него длиннющие руки, и сам он весь такой страшный...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670206
					],
					"speakerTitle": "Хаотичные записки"
				},
				{
					"id": 730670206,
					"content": "«...Н-но я обязан спасти нару, у-у-у...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670207
					],
					"speakerTitle": "Хаотичные записки"
				},
				{
					"id": 730670207,
					"content": "(Почерк на следующих страницах крупный и размашистый...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670208
					],
					"speakerTitle": "Хаотичные записки"
				},
				{
					"id": 730670208,
					"content": "«Я победил Волосатого короля демонов в маске и спас нару. Друг нара подарил Арашакуну «храбрость». Арашакун больше не трус».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670209
					],
					"speakerTitle": "Хаотичные записки"
				},
				{
					"id": 730670209,
					"content": "«У Арашакуна есть «храбрость», и он смело сражался с волосатыми монстрами в масках. Нарам окрестностей больше не нужно их бояться!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670210
					],
					"speakerTitle": "Хаотичные записки"
				},
				{
					"id": 730670210,
					"content": "(На последних страницах почерк снова мелкий...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670211
					],
					"speakerTitle": "Хаотичные записки"
				},
				{
					"id": 730670211,
					"content": "«У-у-у! Как же так?! «Храбрость» потерялась. «Храбрость», которую нара подарил Арашакуну... Её точно украл Волосатый король демонов в маске».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670212
					],
					"speakerTitle": "Хаотичные записки"
				},
				{
					"id": 730670212,
					"content": "«Волосатый король демонов в маске страшно длиннорук и коварен. Но Арашакун ни на что не годен без своей «храбрости»! Арашакун должен отправиться в <color=#00E1FFFF>пещеру на востоке</color> искать её...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хаотичные записки"
				}
			]
		},
		{
			"id": 7306703,
