			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дзюнъя",
					"Нанако"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060101,
					"content": "Третий человек, оставшийся без Глаза Бога, должен быть каким-то известным в этих краях мечником.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060102,
					"content": "Говорят, что он нынешний мастер школы «Мэйкё сисуй»... Звучит впечатляюще...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060103,
					"content": "Это их зал, и там как раз кто-то есть. Давай с ними поговорим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060104,
					"content": "Не волнуйся, Нанако! С учителем всё будет в порядке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060105
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060105,
					"content": "Бандиты, которые приходили в зал, были сильными, но он всё равно их раскидал, так ведь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060106
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060106,
					"content": "Да, но я всё равно за него волнуюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060107
					],
					"speakerTitle": "Нанако"
				},
				{
					"id": 20060107,
					"content": "Раньше его никакая опасность не могла сломить, но на этот раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060108
					],
					"speakerTitle": "Нанако"
				},
				{
					"id": 20060108,
					"content": "Это потому что в него демон вселился! После обряда экзорцизма он сразу же придёт в норму!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060109
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060109,
					"content": "Привет... Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060110,
					"content": "...Вы кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060111
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060111,
					"content": "Просто бездельники вы или пришли дебоширить, пока учителю нездоровится, - проваливайте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060112
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060112,
					"content": "Не заставляйте меня доставать меч, а не то пожалеете!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060113
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060113,
					"content": "Нет, ты не так понял! Мы просто пришли... Э...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060114,
					"content": "Мы хотим стать учениками.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060115
					]
				},
				{
					"id": 20060115,
					"content": "...Учениками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060116
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060116,
					"content": "Да-да! Мы столько слышали про могучего мастера школы «Мэйкё сисуй». Мы только ради этого и проделали такой длинный путь - чтобы найти его и попросить тренировать нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060117,
					"content": "Но вот мы тут, и услышали, как вы говорите, про демонов или что-то такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060118,
					"content": "Хм... Судя по одежде, вы действительно не похожи на местных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060119
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060119,
					"content": "Примите мои извинения... Последнее время много кто пытается доставить нам проблемы, так что мы держим ухо востро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060120
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060120,
					"content": "Боюсь, что вы прибыли немного некстати. На учителя наложили порчу, и он ещё не восстановился. Он пока не принимает новых учеников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060121,
						20060122
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060121,
					"content": "Мы можем подождать, пока он выздоровеет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060123
					]
				},
				{
					"id": 20060123,
					"content": "#Вижу, что ты искренне хочешь стать {M#учеником}{F#ученицей}. Ладно, давай так - мы с Нанако тебе побольше расскажем о том, что произошло с учителем, а тогда уже ты решишь уйти или остаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060124
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060124,
					"content": "Нашего учителя зовут Домон, но ты это уже, конечно, знаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060125
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060125,
					"content": "Он самоучка, но достиг небывалых высот во владении мечом. Потом он одолел много выдающихся мастеров, не проиграв ни одного боя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060126
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060126,
					"content": "Он говорил, что хочет стать величайшим мечником в мире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060127
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060127,
					"content": "Он тренировал нас, но одновременно оттачивал и свои навыки. Его страсть передалась нам, и мы изо всех сил пытались не отставать от него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060128
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060128,
					"content": "Но потом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060129
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060129,
					"content": "Недавно у учителя конфисковали Глаз Бога, и он стал другим человеком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060130
					],
					"speakerTitle": "Нанако"
				},
				{
					"id": 20060130,
					"content": "Он постоянно бормочет какую-то чепуху и не разрешает нам тренироваться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060131
					],
					"speakerTitle": "Нанако"
				},
				{
					"id": 20060131,
					"content": "Мы с Дзюнъя обсудили и решили, что в него вселился демон. Поэтому мы пригласили жриц Великого храма Наруками провести обряд экзорцизма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060132
					],
					"speakerTitle": "Нанако"
				},
				{
					"id": 20060132,
					"content": "Но если честно... я не до конца уверена, что он поправится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060133
					],
					"speakerTitle": "Нанако"
				},
				{
					"id": 20060133,
					"content": "Великий храм Наруками? Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060134,
					"content": "Вы не знаете о Великом храме Наруками? Это самое большое святилище на острове Наруками. Говорят, верховная жрица храма очень близка к самому сёгуну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060135
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060135,
					"content": "Не то что бы мы могли пригласить верховную жрицу, конечно... Но даже обычные жрицы Великого храма Наруками очень сильны в делах экзорцизма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060136
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060136,
					"content": "Так что не волнуйся, Нанако. С учителем всё будет хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060137
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060137,
					"content": "Обряд будет проводиться вечером. Если хотите, то можете тоже прийти посмотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060138
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060138,
					"content": "То есть потеря Глаза Бога может привести к одержимости? Думаю, нам стоит прийти и убедиться самим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060122,
					"content": "#Я не уйду, пока не стану его {M#учеником}{F#ученицей}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060123
					]
				}
			]
		},
		{
			"id": 200602,
			"completionStepIds": [
				200603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200603",
							"2"
						],
						"stepId": 200603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дзюнъя",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060201,
					"content": "Ш-ш... Вы пришли? Хорошо, что вы не пришли раньше - у учителя опять случился припадок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060202
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060202,
					"content": "Только что Нанако его поддерживала и услышала, что учитель бормочет какие-то имена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060203
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060203,
					"content": "Она спросила, кто это, но он вдруг впал в ужас и оттолкнул её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060204
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060204,
					"content": "Ему как будто стало плохо, он закрыл уши и стал озираться налитыми кровью глазами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060205
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060205,
					"content": "Он всё выкрикивал имена - некоторые из них нам знакомы, некоторые нет. Похоже, это всё имена мастеров, которых он раньше одолел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060206
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060206,
					"content": "Среди них был Андзай. Они раньше вместе учились, и Андзай был старшим. Но много лет назад учитель одолел его, и Андзай с тех пор странствует по миру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060207
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060207,
					"content": "Учитель много раз его имя прокричал... Эх... К счастью, жрицы смогли оглушить его и теперь можно продолжить экзорцизм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060208
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060208,
					"content": "Ритуал уже начался, нам остаётся только терпеливо ждать. Надеюсь, что учитель скоро поправится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060209
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060209,
					"content": "Постойте тут пока, я пойду схожу за водой - он, когда проснётся, наверняка захочет попить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060210
					],
					"speakerTitle": "Дзюнъя"
				},
				{
					"id": 20060210,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060211,
					"content": "Кто это там крадётся? Неужели они хотят помешать обряду экзорцизма?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060212,
					"content": "Мы не можем этого допустить! Скорее, в погоню!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 200604,
			"completionStepIds": [
				200605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200605",
							"2"
						],
						"stepId": 200605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060401,
					"content": "Как... Как вы... меня так догнали... так быстро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060402
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060402,
					"content": "Вы точно ученики Домона? Бегаете вы даже быстрее него...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060403
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060403,
					"content": "Хотя... Мы не виделись несколько лет. Может быть, он стал ещё сильнее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060404
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060404,
					"content": "Кхм! Это мы тут задаём вопросы! Ты кто такой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060405,
					"content": "Что это ты тут крадёшься, а? Сразу видно, что ничего хорошего от тебя не жди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060406,
					"content": "Ничего хорошего? Пф. Мы вообще-то с Домоном тренировались вместе ещё в те времена, когда вас в помине не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060407
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060407,
					"content": "Я не люблю говорить о тех временах, но если вам надо знать, то я ещё и постарше Домона!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060408
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060408,
					"content": "Старший соученик? Неужели ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060409,
					"content": "Андзай. Да, это я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060410
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060410,
					"content": "Почему ты убегал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060411
					]
				},
				{
					"id": 20060411,
					"content": "...Потому что я не хочу видеть Домона или кого бы то ни было, связанного с ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060412
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060412,
					"content": "Когда-то мы вместе изучали «Мэйкё сисуй» у одного мастера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060413
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060413,
					"content": "Я начал тренироваться за пять лет до него, и для всех я был рассудительным старшим сотоварищем, на которого можно положиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060414
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060414,
					"content": "Последователи школы «Мэйкё сисуй» стремятся «очистить разум от волнений», поэтому большинство учеников безразличны к славе и богатству. Я был таким же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060430
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060430,
					"content": "Но Домон был не таким. Когда он стал учеником, первым же делом подошёл к учителю и спросил с улыбкой до ушей, как стать лучшим мастером в мире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060415
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060415,
					"content": "Учитель тогда ругал его и говорил, что нельзя использовать меч для погони за славой. Он сказал, что Домон тренируется всего пару дней, а уже мечтает о звании лучшего мечника, и такая импульсивность никогда не позволит ему стать мастером.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060416
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060416,
					"content": "Я тогда тоже так думал... Но навыки Домона стремительно улучшались, и он даже стал меня догонять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060417
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060417,
					"content": "Только тогда я понял, что Домон уже давно «очистил разум от волнений».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060418
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060418,
					"content": "В его разуме была только одна мысль - стать лучшим в мире. Он стремился только к совершенству техники меча, и ничто не могло его поколебать на этом пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060419
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060419,
					"content": "Да уж, похоже, он крут... Но почему ты не хочешь его больше видеть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060420,
					"content": "Потому что до его прихода я был уверен, что стану следующим мастером школы «Мэйкё сисуй».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060431
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060431,
					"content": "Из всех учеников я был самым одарённым и тренировался дольше всех. Все возлагали на меня большие надежды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060421
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060421,
					"content": "Но появился Домон, и всё изменилось. Тогда я проиграл не только бой - я проиграл свою честь и своё положение. Я навсегда сбежал из школы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060422
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060422,
					"content": "Потом я слышал, что он вызвал на дуэль и учителя. Тот был уже в преклонном возрасте, и бой забрал у него последние силы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060423
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060423,
					"content": "После этого я не хотел иметь с ним ничего общего. Но в глубине сердца я всё равно уважал его мастерство и преданность искусству меча.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060424
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060424,
					"content": "Когда я услышал, что он сошёл с ума, я сначала не поверил. Он? Сошёл с ума? Его разум был острее меча - он довёл искусство «Мэйкё сисуй» до совершенства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060425
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060425,
					"content": "Поэтому я и пришёл незаметно посмотреть. И к своему изумлению услышал, как он выкрикивает моё имя... Я думал, что он давно уже про меня забыл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060426
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060426,
					"content": "Так что я вовсе не хотел ему навредить, я просто хотел убедиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060427
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060427,
					"content": "...Я вам всё рассказал. Идите обратно - экзорцизм уже, наверное, завершается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060428
					],
					"speakerTitle": "???"
				},
				{
					"id": 20060428,
					"content": "Хм... Похоже, что в этот раз мы ошиблись. Он вовсе не собирался мешать экзорцизму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060429
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20060429,
					"content": "Но Паймон даже не знает, стоит ли взять его с собой... Пойдём сначала посмотрим, как проходит экзорцизм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
