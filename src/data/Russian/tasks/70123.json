			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012301",
							"2"
						],
						"stepId": 7012301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джоэль"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230101,
					"content": "Где же папа?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230102
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230103
					]
				},
				{
					"id": 701230103,
					"content": "А, здравствуй... Я... Я не могу найти своего папу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230104
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230104,
					"content": "Он обещал, что покажет мне снег в горах, но его до сих пор здесь нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230105
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230105,
					"content": "Наверное, он нашёл карту сокровищ или что-нибудь такое, и поэтому не пришёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230106
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230106,
					"content": "Я добрался сюда сам. Раз он не идёт ко мне, значит, я пойду к нему... По крайней мере, я так думал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230107
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230107,
					"content": "Но папы не оказалось и здесь... Тот дядя рыцарь сказал, что видел, как он шёл к вершине...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230108
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230108,
					"content": "Я хотел пойти искать его, но дядя рыцарь меня не пускает. Мне ничего не остаётся, как ждать папу здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230109
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230109,
					"content": "Но... Но он ещё не вернулся, и я очень волнуюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230110
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230110,
					"content": "#Если ты идёшь в горы, то не мог{F#ла} бы ты помочь мне найти папу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230111,
						701230112
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230111,
					"content": "Я помогу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				},
				{
					"id": 701230113,
					"content": "Так ты поможешь? Ура!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230114
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230114,
					"content": "Дай подумать... Дяденька рыцарь сказал, что папа упоминал о восхождении по <color=#00E1FFFF>укрытой снегом тропе</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230115
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230115,
					"content": "Затем он говорил, что пойдёт к <color=#00E1FFFF>западному склону горы</color>, чтобы прикинуть, как <color=#00E1FFFF>взобраться на вершину</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230116
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230116,
					"content": "Пожалуйста, осмотри сначала эти места. Может, папа всё ещё где-то там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230117
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230117,
					"content": "Мы ведь с ним договаривались, что пойдём посмотреть на снег. Он выполнит своё обещание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230112,
					"content": "Где мне его искать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				}
			]
		}
	]
}