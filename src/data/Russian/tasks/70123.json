					"Джоэль"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230101,
					"content": "Где же папа?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230102
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230103
					]
				},
				{
					"id": 701230103,
					"content": "А, здравствуй... Я... Я не могу найти своего папу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230104
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230104,
					"content": "Он обещал, что покажет мне снег в горах, но его до сих пор здесь нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230105
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230105,
					"content": "Наверное, он нашёл карту сокровищ или что-нибудь такое, и поэтому не пришёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230106
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230106,
					"content": "Я добрался сюда сам. Раз он не идёт ко мне, значит, я пойду к нему... По крайней мере, я так думал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230107
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230107,
					"content": "Но папы не оказалось и здесь... Тот дядя рыцарь сказал, что видел, как он шёл к вершине...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230108
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230108,
					"content": "Я хотел пойти искать его, но дядя рыцарь меня не пускает. Мне ничего не остаётся, как ждать папу здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230109
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230109,
					"content": "Но... Но он ещё не вернулся, и я очень волнуюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230110
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230110,
					"content": "#Если ты идёшь в горы, то не мог{F#ла} бы ты помочь мне найти папу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230111,
						701230112
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230111,
					"content": "Я помогу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				},
				{
					"id": 701230113,
					"content": "Так ты поможешь? Ура!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230114
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230114,
					"content": "Дай подумать... Дяденька рыцарь сказал, что папа упоминал о восхождении по <color=#00E1FFFF>укрытой снегом тропе</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230115
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230115,
					"content": "Затем он говорил, что пойдёт к <color=#00E1FFFF>западному склону горы</color>, чтобы прикинуть, как <color=#00E1FFFF>взобраться на вершину</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230116
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230116,
					"content": "Пожалуйста, осмотри сначала эти места. Может, папа всё ещё где-то там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230117
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230117,
					"content": "Мы ведь с ним договаривались, что пойдём посмотреть на снег. Он выполнит своё обещание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230112,
					"content": "Где мне его искать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				}
			]
		},
		{
			"id": 7012302,
			"completionStepIds": [
				7012302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012301",
							"3"
						],
						"stepId": 7012301,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230201,
					"content": "Пока всё хорошо. Погода ясная, припасов достаточно, а чудовища ведут себя мирно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230202
					],
					"speakerTitle": "Аккуратные записи"
				},
				{
					"id": 701230202,
					"content": "В рюкзаке я вдруг обнаружил шестой том книги «Принцесса-кабан». Должно быть, её подложил Джоэль. Ох уж этот проказник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230203
					],
					"speakerTitle": "Аккуратные записи"
				},
				{
					"id": 701230203,
					"content": "В ней рассказывается о том, как храбрая Принцесса-кабан вместе с друзьями восходит на снежную гору... К вершине снежной горы взбираюсь и я. Судя по тому, как гладко всё идёт, может быть, книжка приносит мне удачу. Спасибо, Джоэль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230204
					],
					"speakerTitle": "Аккуратные записи"
				},
				{
					"id": 701230204,
					"content": "В общем, я пополню в следующем лагере припасы, запишу, как обстоят дела, и спущусь вниз. Всё-таки меня ждёт Джоэль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аккуратные записи"
				}
			]
		},
		{
			"id": 7012303,
			"completionStepIds": [
				7012303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012302",
							"3"
						],
						"stepId": 7012302,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230301,
					"content": "По дороге ничего непредвиденного не случилось, погода такая же ясная. Похоже, мне наконец-то везёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230302
					],
					"speakerTitle": "Аккуратные записи"
				},
				{
					"id": 701230302,
					"content": "Может, стоит попробовать быстренько взобраться на вершину...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230303
					],
					"speakerTitle": "Аккуратные записи"
				},
				{
					"id": 701230303,
					"content": "Попробую только разок. Если что, я тут же начну спускаться к подножию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аккуратные записи"
				}
			]
		},
		{
			"id": 7012304,
			"completionStepIds": [
				7012304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012303",
							"3"
						],
						"stepId": 7012303,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230401,
					"content": "Пик вдруг накрыла снежная буря. Я еле успел спрятаться в этой пещере. Да ещё и половину припасов потерял...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230402
					],
					"speakerTitle": "Небрежные записи"
				},
				{
					"id": 701230402,
					"content": "Вдруг почему-то обрушились камни, и проход оказался завален. Плохо дело...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230403
					],
					"speakerTitle": "Небрежные записи"
				},
				{
					"id": 701230403,
					"content": "Но... Думаю, я всё ещё могу выбраться. Хоть и другой конец пещеры выходит к обрыву, внизу нет ничего, кроме высокого снега. Если я спущусь вниз, а потом спрыгну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230404
					],
					"speakerTitle": "Небрежные записи"
				},
				{
					"id": 701230404,
					"content": "Через день-другой припасы закончатся. Нужно действовать..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230405
					],
					"speakerTitle": "Небрежные записи"
				},
				{
					"id": 701230405,
					"content": "Я обещал Джоэлю показать снег. Я должен выполнить обещание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230406
					],
					"speakerTitle": "Небрежные записи"
				},
				{
					"id": 701230406,
					"content": "Да, если кто-нибудь найдёт мои записи, пожалуйста, положите в эту миску еды, покормите лис.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230407
					],
					"speakerTitle": "Небрежные записи"
				},
				{
					"id": 701230407,
					"content": "Всё это время, что я провёл в каменном мешке, они были рядом. Если получится, я очень хотел бы прийти к ним вместе с Джоэлем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Небрежные записи"
				}
			]
		},
		{
			"id": 7012305,
			"completionStepIds": [
				7012305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012305",
							"2"
						],
						"stepId": 7012305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джоэль"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230501,
					"content": "Ну что? О моём папе что-нибудь известно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230502,
						701230511
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230502,
					"content": "Вот что мы нашли в пещере у вершины...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230503
					]
				},
				{
					"id": 701230503,
					"content": "Папа... Нет, не может быть. Мой папа отличный искатель приключений. Он со всем справится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230504
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230504,
					"content": "Он написал, что нашёл способ сойти с горы... Он точно спустился, живой и невредимый... Ведь так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230505
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230505,
					"content": "Он, наверное, уже спустился, и с ним всё в порядке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230506
					]
				},
				{
					"id": 701230506,
					"content": "Точно... Сейчас он, возможно, отдыхает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230507
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230507,
					"content": "Или... Или разбил на вершине новый лагерь и решил передохнуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230508
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230508,
					"content": "В общем, пусть папа отдохнёт... А потом он точно придёт за мной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230509
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230509,
					"content": "Я буду ждать его здесь. Спасибо за помощь. Вот, возьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230511,
					"content": "#Я ничего не наш{F#ла}{M#ёл}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230512
					]
				},
				{
					"id": 701230512,
					"content": "Как... Совсем? Но дядя рыцарь говорил, что папа шёл к вершине горы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230513
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230513,
					"content": "Может, он ошибся? Или... папа разбил новый лагерь где-нибудь ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230514
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230514,
					"content": "Ладно. Я, пожалуй, подожду его здесь... Если папа меня не застанет, то будет переживать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230515
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230515,
					"content": "Спасибо тебе за помощь. Вот, возьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230516
					],
					"speakerTitle": "Джоэль"
				},
				{
					"id": 701230516,
					"content": "Где же ты, папа?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джоэль"
				}
			]
		},
		{
			"id": 7012306,
			"completionStepIds": [
