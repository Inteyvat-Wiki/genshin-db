					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420402
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420402,
					"content": "(Сокровища, что ещё никто не нашёл... Эх, лучше не питать иллюзий.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
