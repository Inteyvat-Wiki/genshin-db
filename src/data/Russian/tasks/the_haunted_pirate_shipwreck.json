							2427.081,
							200.4,
							8922.118
						],
						"pointId": 14143
					},
					{
						"sceneId": 3,
						"position": [
							2427.91,
							200.376,
							8922.991
						],
						"pointId": 14144
					}
				]
			},
			"dialogs": [
				{
					"id": 760420201,
					"content": "Судя по твоей одежде... ты тоже охотник за сокровищами? Вы, охотники, приходите сюда снова и снова, и всё равно не теряете интереса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420202
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760420202,
					"content": "Старик верно подметил. Говорят, раньше здесь несколько охотников за сокровищами попали в беду, а потом они стали всем говорить, будто их атаковали призраки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420203
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420203,
					"content": "Я во всё это не верю, поэтому я пришла сюда, чтобы узнать, в чём дело... Конечно, если я случайно наткнусь на какое-нибудь ненайденное сокровище, буду только рада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420204
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420204,
					"content": "Итак, расскажите мне, что означает вся эта болтовня о призраках, нападающих на людей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420205
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420205,
					"content": "Если кто и нападает на людей - это сами люди. Хотя, по правде говоря, этот - самый жуткий из всех - он живой, но, думаю, давно умер внутри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420206
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760420206,
					"content": "...Что? Постой, ты что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420207
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420207,
					"content": "Я точно ничего не путаю. Слыхали про «Атлас»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420208
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760420208,
					"content": "Да. Но разве он не затонул уже давно? Это ведь где-то здесь поблизости случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420209
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420209,
					"content": "Самое ценное на корабле - это «дар», что ведёт к «Великому сокровищу» Рида Миллера. Но до сих пор никто его не нашёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420210
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420210,
					"content": "Ты много знаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420211
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760420211,
					"content": "Хм, это и есть профессиональная сноровка. То есть вы пытаетесь сказать, что нападение на охотников за сокровищами как-то связано с «Атласом»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420212
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420212,
					"content": "Именно так. Произошла трагедия. Но есть выжившие. Один из них - Харк Рваная Пасть. Он единственный выживший с «Атласа».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420213
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760420213,
					"content": "Говорят, что сперва он побывал в Снежнограде, а потом присоединился к какому-то каравану. Недавно он натворил дел в Нашгороде, за что караван больше не стал его терпеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420214
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760420214,
					"content": "В тот день охотники за сокровищами пытались искать что-то рядом с обломками «Атласа». Харк их застал и устроил им разборку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420215
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760420215,
					"content": "Это его корабль. Даже если затонул, всё равно важен для него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420216
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420216,
					"content": "Да. Говорят, он больше не решался на дальние рейсы. Видимо, завязал с пиратством. Но таким людям, как он, жить честным трудом совсем непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420217
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760420217,
					"content": "Те, на кого в своё время нападал «Атлас», вряд ли просто так смирятся с этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420218
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420218,
					"content": "Но он сам выбрал эту работу и не жалуется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420219
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420219,
					"content": "Мы все ошибаемся, важно уметь исправлять ошибки. Харк был рулевым, но продолжал ошибаться. Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420220
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760420220,
					"content": "Похоже, Харк попал в беду в Нашгороде и вернулся сюда. Для него это место и конец, и начало пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420221
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420221,
					"content": "Но и на этот раз он поступил неправильно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420222
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420222,
					"content": "Что ж, говорят, натуру не изменить. Он натворил здесь немало бед, а потом исчез, будто его и не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420223
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760420223,
					"content": "Говорят, в Нашгороде «Флагман» назначил награду за его голову. Но с тех пор никто не видел этого парня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420224
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760420224,
					"content": "Рыбу ты не особо ловишь? А вот ни одна сплетня мимо тебя, похоже, не проскользнёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420225
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420225,
					"content": "У тебя ядовитый язык... Тогда ещё одна хорошая новость: обломки «Атласа» вон там, так что можешь смело попытать удачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420226
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760420226,
					"content": "Попытать удачу? А если он внезапно выскочит и нападёт на меня, ты поможешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420227
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760420227,
					"content": "Что ты, что ты! Я всего лишь рыболов, чем я могу помочь? Разве что провожу тебя до ближайшего места и покажу путь... Тут всё равно больше нечего ловить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420228
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760420228,
					"content": "Эх, верно. Ну и что, если не смогу победить? Убегать я умею не хуже, чем драться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ягода"
				}
			]
		},
