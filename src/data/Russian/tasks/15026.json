					}
				]
			},
			"dialogs": [
				{
					"id": 150260401,
					"content": "Хм, так вот где живёт Ситлали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260402,
					"content": "Э-э... Я не успела навести порядок. Можете жаловаться, если хотите. Великая шаманка не обязана заниматься всякой рутиной вроде уборки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260403
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260403,
					"content": "К тому же в лёгких романах главные герои всегда неряшливы. А у тех, кто держит всё в чистоте, обычно скучная жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260404
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260404,
					"content": "И вообще, никакая я не отшельница. Я выше поверхностных правил этикета, вот и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260405
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260405,
					"content": "(Она явно слишком переживает из-за того, что мы о ней думаем...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260406,
					"content": "Кстати, о заклинании, которое я использовала для передачи вам своих ощущений... Побочных эффектов больше нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260407
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260407,
					"content": "Великая шаманка должна проверять такие вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260408
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260408,
					"content": "Это когда мы слышали твои мысли? Да нет, всё давно прошло. Значит, об этом можно не беспокоиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260409,
					"content": "#Тогда, {NICKNAME}, почему я слышу твои мысли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260410
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260410,
					"content": "Серьёзно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260411,
					"content": "#(Ох, она услышала, как я {F#назвала}{M#назвал} её отшельницей... Это её задело? А я-то {F#думала}{M#думал}, она «выше поверхностных правил этикета»...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260412
					]
				},
				{
					"id": 150260412,
					"content": "Я всё ещё слышу тебя, знаешь ли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260413
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260413,
					"content": "#Прости, если {F#обидела}{M#обидел}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260414
					]
				},
				{
					"id": 150260414,
					"content": "Хватит болтать. Я что-нибудь придумаю. Хм, сначала вы слышите мои мысли, теперь я слышу ваши...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260415
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260415,
					"content": "Это было самое обычное заклинание. Я использовала его на вас, и теперь оно чудит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260416
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260416,
					"content": "Ладно. Скажите, зачем вы здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260417
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260417,
					"content": "Ну, нас попросили... попросить тебя... стать консультантом. У них есть несколько вопросов об истории Натлана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260418,
					"content": "Значит, они уговорили героя Натлана замолвить за них словечко? Похоже, они знают, что я не люблю, когда мне досаждают просьбами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260419
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260419,
					"content": "Они щедро заплатят!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260420,
					"content": "Неважно. Я занята.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260421
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260421,
					"content": "Ты совсем не выглядишь занятой... Паймон так и знала, что из этого ничего не выйдет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260422,
					"content": "А если это моя просьба?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260423
					]
				},
				{
					"id": 150260423,
					"content": "Твоя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260424
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260424,
					"content": "Да, на нас возложили священный долг помочь вашему племени соткать особый свиток!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260425
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260425,
					"content": "А? Значит, теперь выбрали вас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260426
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260426,
					"content": "Мы тоже удивились! Мы ведь понятия не имели, как ткать такие свитки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260427,
					"content": "Но благодаря помощи вождя Бирама нам удалось добиться некоторого прогресса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260428
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260428,
					"content": "Мы ещё не закончили, но выяснили, что ключ к созданию свитка - особый вид цвета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260429
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260429,
					"content": "Историческое событие, о котором они хотят узнать, тоже связано с цветом. Если поможешь им, вдруг и нам это будет полезно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260430
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260430,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260431
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260431,
					"content": "Опять этот её взгляд... Неужели Паймон плохо объяснила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260432
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260432,
					"content": "Не пойму, это случайность или всё шло к этому с самого начала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260433
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260433,
					"content": "Эм... Значит, ты нам не поможешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260434
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260434,
					"content": "Мне... нужно подумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260435
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260435,
					"content": "Значит, надежда ещё есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260436
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260436,
					"content": "Эй! Вы ещё не закончили? Дайте нам ответ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260437
					],
					"speakerTitle": "Грудок"
				},
				{
					"id": 150260437,
					"content": "Ясно ведь договорились, что разговаривать будем мы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260438
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260438,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260439
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260439,
					"content": "Ситлали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
