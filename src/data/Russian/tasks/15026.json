			"dialogs": [
				{
					"id": 150260201,
					"content": "Значит, это здесь живёт великая шаманка? Довольно далеко от цивилизации... Надеюсь, нас не ввели в заблуждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260202
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260202,
					"content": "Для Ситлали жить в таком месте вполне нормально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260203,
					"content": "Это граффити тоже её работа? Интересно, это связано с культурой племени?.. Если бы мне удалось его скопировать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260204
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150260204,
					"content": "Мы здесь по делу, Алье. Как и договаривались, вы пытаетесь её убедить, а мы ждём снаружи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260205
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260205,
					"content": "Хорошо, постучим в дверь! Надеюсь, она не страдает от похмелья...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260206,
					"content": "Ситлали? Ты там? Нам нужна твоя помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260207,
					"content": "...Тишина. Может, её нет дома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260208,
					"content": "Давайте попробуем другое имя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260209
					]
				},
				{
					"id": 150260209,
					"content": "Э-э... Бабушка Ицтли? Ты дома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260210,
					"content": "Дверь резко открывается, и вас встречает резкий запах спиртного.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150260211
					]
				},
				{
					"id": 150260211,
					"content": "Эй, мелюзга! Если пришли бросить мне вызов, сначала запишитесь на приём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260212
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260212,
					"content": "(Выходит, Ситлали настоящая отшельница...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260213
					]
				},
				{
					"id": 150260213,
					"content": "#...{NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260214
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260214,
					"content": "Дверь тут же захлопывается.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150260215
					]
				},
				{
					"id": 150260215,
					"content": "...Похоже, мы выбрали не лучшее время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260216,
					"content": "Кхе-кхе! Вы ещё здесь? Заходите, поговорим внутри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260217
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 150260217,
					"content": "Ну, по крайней мере, нас не прогнали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
