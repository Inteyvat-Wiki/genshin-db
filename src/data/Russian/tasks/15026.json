			"dialogs": [
				{
					"id": 150260101,
					"content": "Кхм! Что вы здесь делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260102,
					"content": "Вообще-то мы выполняем приказ. Если что-то не нравится, обращайтесь к нашему нанимателю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260103
					],
					"speakerTitle": "Грудок"
				},
				{
					"id": 150260103,
					"content": "Эй, что за тон? И вообще, разве Фатуи работают с наёмниками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260104,
					"content": "Кхе-кхе! Это Грудок. Я нанял его моим телохранителем в Натлане. Как видите, он не слишком общителен. Простите, если он вас обидел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260105
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260105,
					"content": "Изначально я хотел нанять кого-то из местных племён, но жрец посоветовал мне Грудока и его отряд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260106
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260106,
					"content": "Мне сказали, что они отличные бойцы и у них есть свободное время. Судя по всему, репутация у Фатуи в Натлане довольно неплохая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260107
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260107,
					"content": "Вот как... Значит, ты из Фонтейна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260108,
					"content": "#Точно! Моё имя Монлюсон, к вашим услугам. Я занимаюсь издательским делом. А вы... Постойте, вы же {M#путешественник и его}{F#путешественница и её} летающая фея!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260109
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260109,
					"content": "Ты знаешь о нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260110,
					"content": "#{F#Золотоволосая путешественница}{M#Золотоволосый путешественник} с парящим компаньоном... Без сомнений, это вы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260111
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260111,
					"content": "Ваши подвиги в Фонтейне подходят для бестселлера! Я же книжный торговец, как я могу вас не узнать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260112
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260112,
					"content": "#Ух ты, мы такие знаменитые, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260113,
					"content": "Сегодня мне определённо повезло! Знаю, это неожиданно, но я как раз искал вас. У меня просьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260114
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260114,
					"content": "Значит, ты специально отправился за нами в Натлан? Немного странно, если честно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260115,
					"content": "Обещаю, вас щедро вознаградят!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260116
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260116,
					"content": "...Ну, он перешёл сразу к делу. Может, выслушаем его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260117,
						150260118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260117,
					"content": "У меня такое чувство, что нам от этого не отвертеться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260119
					]
				},
				{
					"id": 150260119,
					"content": "Кхе-кхе! Ладно, мы выслушаем тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260120,
					"content": "Вы знаете великую шаманку Ситлали? Мне нужна её помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260121
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260121,
					"content": "Эм... Да, но вероятность того, что она поможет первому встречному...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260122,
					"content": "С её характером? Почти нулевая.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260123
					]
				},
				{
					"id": 150260123,
					"content": "Да, Ситлали не любит иметь дело с незнакомцами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260124,
					"content": "#Я слышал об этом от членов её племени. Но мне сказали, что если кто и сможет её убедить, так это {F#золотоволосая путешественница}{M#золотоволосый путешественник}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260125
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260125,
					"content": "Если вам удастся, я удвою плату!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260126
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260126,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260127,
					"content": "А зачем тебе её помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260128
					]
				},
				{
					"id": 150260128,
					"content": "Да, точно... нам ведь нужно узнать, чего ты хочешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260129,
					"content": "Долго рассказывать. Дело связано с историей племени, поэтому лучше передам слово эксперту. Алье, если можешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260130
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260130,
					"content": "Конечно! Редко удаётся найти слушателей для таких рассказов... Приятно познакомиться. Я Алье, учёный из Исследовательского института Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260131
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150260131,
					"content": "Я специализируюсь на археологии - не самом популярном направлении. Поэтому меня пригласили в команду господина Монлюсона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260132
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150260132,
					"content": "Слышали легенду о великой шаманке Уитцилин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260133,
						150260134
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150260133,
					"content": "Звучит знакомо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260135
					]
				},
				{
					"id": 150260135,
					"content": "Да, согласно местным записям, она была мастером работы с цветом и жила более двухсот лет назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260136
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150260136,
					"content": "Из всех её подвигов наиболее известный «Битва семи цветов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260137
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150260137,
					"content": "По легенде, битва началась из-за вторжения Бездны. Это была одна из самых жестоких битв в истории Натлана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260138
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150260138,
					"content": "Удивительно, но Натлану удалось переломить ход сражения, несмотря на огромный перевес врага. Ключом к победе стал «цвет», который Уитцилин создала на поле боя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260139
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150260139,
					"content": "Этот «цвет» был необычным. Иллюзорным, но в то же время обладавшим физической формой. Легенда гласит, что Уитцилин использовала этот «цвет», чтобы построить величественный лабиринт прямо на поле боя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260140
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150260140,
					"content": "...И заточила всех врагов внутри. Это позволило её союзникам перейти в наступление и одержать победу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260141
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150260141,
					"content": "Кхе-кхе! В общем, это история в общих чертах. Не будем отнимать у вас много времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260142
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260142,
					"content": "Именно эта история привела меня в Натлан. Я часто публикую книги об истории разных народов. Они всегда хорошо продаются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260143
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260143,
					"content": "Когда я впервые услышал эту легенду, я захотел включить её в свою следующую коллекцию, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260144
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260144,
					"content": "Исторические записи о Натлане крайне скудны. Мы не смогли ни определить место битвы, ни найти доказательства её существования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260145
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260145,
					"content": "Даже среди Повелителей Ночного Ветра ведутся споры о подлинности истории. Некоторые считают её мифом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260146
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260146,
					"content": "Если так, то история не годится для публикации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260147
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260147,
					"content": "Хм? Но если это история в книжке, разве важно, была ли она на самом деле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260148
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260148,
					"content": "Видите ли, девиз нашего сборника - «Восстановление исторической правды». Конечно же, все истории должны быть достоверны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260149
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260149,
					"content": "Вот почему я здесь. Говорят, у Повелителей Ночного Ветра есть традиция записывать события прошлого. Я хочу изучить их записи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260150
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260150,
					"content": "Но мне отказали в доступе к обсидиановому алтарю. Я подавал заявку за заявкой, но получил только несколько обычных тканых свитков, которые не дали никакой информации. Я хочу популяризировать их историю, а они устроили из этого целую проблему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260151
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260151,
					"content": "Согласно моим исследованиям, их свитки считаются священными реликвиями и историческими записями. Разумеется, доступ к ним редко предоставляют чужакам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260152
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150260152,
					"content": "К тому же те свитки, которые нам всё-таки дали, содержат огромное количество информации. Если бы у меня было больше времени, я мог бы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260153
					],
					"speakerTitle": "Алье"
				},
				{
					"id": 150260153,
					"content": "Мы уже это обсуждали, Алье. Нет смысла тратить время на свитки, если у нас есть вариант получше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260154
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260154,
					"content": "Ситлали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260155
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260155,
					"content": "Да, вы прекрасно знаете, что Ситлали живёт на свете уже более двухсот лет. Это значит, что она застала эпоху Битвы семи цветов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260156
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260156,
					"content": "Если она согласится быть моим консультантом, другие исторические записи не понадобятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260157
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260157,
					"content": "Ах, вот что вам нужно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260158
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260158,
					"content": "Так что скажете? Я увеличу оплату в четыре раза, если это поможет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260159
					],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260159,
					"content": "Мы и хотели бы помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260160,
						150260161
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260160,
					"content": "Нам всё равно придётся обратиться к ней, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260162
					]
				},
				{
					"id": 150260162,
					"content": "О, точно! Поручение вождя тоже связано с Уитцилин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260163
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260163,
					"content": "Кто знает, возможно, Битва семи цветов укажет нам правильное направление!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260164
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260164,
					"content": "Ладно, мы попробуем уговорить Ситлали. Только дайте нам всё уладить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260165
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150260165,
					"content": "Хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Монлюсон"
				},
				{
					"id": 150260161,
					"content": "У нас остаётся долг, который нужно выполнить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260162
					]
				},
				{
					"id": 150260134,
					"content": "Это та, которая работала с красками, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260135
					]
				},
				{
					"id": 150260118,
					"content": "Если хорошо заплатят...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260119
					]
				}
			]
		},
