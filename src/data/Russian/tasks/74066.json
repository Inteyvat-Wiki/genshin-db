				]
			},
			"dialogs": [
				{
					"id": 740660901,
					"content": "(Готово! Начинайте!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660902,
					"content": "Первый вопрос. Как вы считаете, разумно ли поддерживать низкие цены в купонной столовой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660903
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660903,
					"content": "(Хм... Как бы ответить? Есть! Прибегнем к универсальной формуле.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660904
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660904,
					"content": "(В книге пишут, что фразу «трудно не согласиться с вашим мнением, но...» можно использовать в любой ситуации. Даже с магом Бездны поговорить можно. Просто замечательно.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660905,
						740660909,
						740660914
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660905,
					"content": "Разумно, Паймон такое по душе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660906
					]
				},
				{
					"id": 740660906,
					"content": "А? И не думай, что Паймон можно скормить какую-то пакость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660907
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660907,
					"content": "А если за еду не придётся платить?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660908
					]
				},
				{
					"id": 740660908,
					"content": "Ты... ты такое предлагаешь... Нет! Ни за что! Да Паймон лучше умрёт от голода!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660918,
					"content": "Кхе-кхе, позвольте перебить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660919
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660919,
					"content": "Да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660920
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660920,
					"content": "Согласно регламенту, давать ответы на вопросы нужно быстро. Давайте перейдём к следующему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660921
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660921,
					"content": "Хо... хорошо... Раз уж есть регламент...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660922
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660922,
					"content": "Второй вопрос. Вы считаете, что в столовой достаточный ассортимент продуктов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660923
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660923,
					"content": "Да купить-то много чего можно... Только уж очень невкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660924,
						740660929,
						740660932
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660924,
					"content": "Да, больше мяты, чем во всё Тейвате растёт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660925
					]
				},
				{
					"id": 740660925,
					"content": "Паймон лучше уж мяту будет есть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660926
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660926,
					"content": "Правда? Тогда сегодня у нас салат из мяты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660927
					]
				},
				{
					"id": 740660927,
					"content": "Нет! Паймон ничего не будет! У-у-у! Паймон хочет цыплёнка в медовом соусе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660928
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660928,
					"content": "Итак... вернёмся к анкете? Я отмечаю «да»?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660935,
					"content": "Ох, как же нелегко! Переходим к следующему вопросу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660936
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660936,
					"content": "Прежде, чем задать третий вопрос, я бы хотела напомнить, что в данном опросе необходимо отвечать быстро. Поэтому...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660937
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660937,
					"content": "Итак, третий вопрос. Вызывает ли интерес нынешняя система случайных блюд?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660938
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660938,
					"content": "Уделите больше внимания вкусу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660939
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660939,
					"content": "Я согласна с твоим мнением, но... разве система случайных блюд, когда ты совершенно не знаешь, какое блюдо станет следующим, не становится приятным сюрпризом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660940
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660940,
					"content": "И верно!.. После твоих слов Паймон согласна, что это очень интересно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660941
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660941,
					"content": "Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660942
					]
				},
				{
					"id": 740660942,
					"content": "Что? Монглан дело говорит, как тут возразишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660943
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660943,
					"content": "Кхм, пожалуйста, отвечайте побыстрее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660944,
						740660949,
						740660951
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660944,
					"content": "Вызывает интерес, и записочки тоже весьма интересны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660945
					]
				},
				{
					"id": 740660945,
					"content": "Точно! Да, каждый раз ведь есть ещё и записка. Это как лотерея, совсем недурно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660946
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660946,
					"content": "«Усердно работай и добьёшься успеха!» Очень здорово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660947
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660947,
					"content": "Работа гида действительно непроста.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660948
					]
				},
				{
					"id": 740660948,
					"content": "Хи-хи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660957,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660958
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660958,
					"content": "Четвёртый вопрос. Как вы думаете, допустимо ли продавать в столовой товары, вызывающие привыкание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660959
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660959,
					"content": "(Что? А? Почему она вдруг ускорилась?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660960
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660960,
					"content": "(«Захватить инициативу»? «Подвести к теме»? Нет-нет, всё не то. Может... снова прибегнуть к универсальному ответу?..)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660961,
						740660962
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660961,
					"content": "(Не совсем удачно... Все эти вопросы...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660963,
					"content": "Кхм, пожалуйста, не думайте слишком долго, но отвечайте серьёзно. Как я и говорила раньше, отвечайте, как вы действительно думаете, без лишних размышлений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660964,
						740660965,
						740660966
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660964,
					"content": "Весьма разумно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660967,
					"content": "Хорошо, спасибо за ваши ответы. И теперь самый главный вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660968
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660968,
					"content": "Просто проигнорировала? Наши ответы на самом деле были вовсе не нужны?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660969
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660969,
					"content": "Обобщая свои предыдущие ответы, довольны ли вы на настоящий момент столовой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660970
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660970,
					"content": "А какие были до этого вопросы? Паймон немного запамятовала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660971
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660971,
					"content": "Ничего страшного, главное, чтобы вы были довольны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660972
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660972,
					"content": "Ну ладно... Но Паймон кажется, что что-то не так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660973
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660973,
					"content": "Кстати, если ответите «нет», то купонов вам не видать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660974
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660974,
					"content": "Ну это уже слишком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660975
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660975,
					"content": "#А что вы думаете, {M#господин}{F#госпожа}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660976
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660976,
					"content": "Не надо игнорировать Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660977,
						740660978,
						740660981
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660977,
					"content": "#Да, я вполне {M#доволен}{F#довольна}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660982,
					"content": "Хорошо. Спасибо за уделённое время, ваша поддержка - наш стимул к развитию. Пожалуйста, поставьте здесь подпись и получите свои купоны. Летающий умный заводной механизм, который находится сбоку от вас, тоже может подписать и получить разрешение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660983
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660983,
					"content": "А? И Паймон получила долю?! Паймон же не участвовала, правда можно? Подожди-ка, Паймон - это Паймон! А не какой-то там летающий механизм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660984
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660984,
					"content": "Хорошо. В общем, наш принцип - это относиться с уважением ко всем выдвинутым предложениям, поэтому все люди... и роботы получают свою долю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660985
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660985,
					"content": "Паймон же уже сказала, что никакой она не летающий заводной механизм, а Паймон! Хватить игнорировать Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660986
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660986,
					"content": "Принято... В общем, чтобы сэкономить ваше драгоценное время, я могу заполнить анкету сама. Не волнуйтесь, это никак не скажется на количестве купонов, никаких проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660987
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660987,
					"content": "Полагаю, все ваши ответы - «удовлетворительно»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660988
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660988,
					"content": "Да! Купоны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660989
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660989,
					"content": "Ну раз так, то просто подпишите здесь, а остальное представьте мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660990
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660990,
					"content": "Ладненько! Раз можно получить купоны и сэкономить силы, то мы рассчитываем на тебя, Монглан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660991
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660991,
					"content": "Спасибо за вашу поддержку. Пожалуйста, возьмите свои купоны, встретимся во время следующего анкетирования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660992
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660992,
					"content": "Получив купоны, вы и Паймон попрощались с госпожой Монглан.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740660993
					]
				},
				{
					"id": 740660993,
					"content": "#{NICKNAME}, если сейчас так подумать... Кажется, Монглан вовсе никакого дела не было до наших ответов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660994
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660994,
					"content": "Причина в формулировке вопросов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660995
					]
				},
				{
					"id": 740660995,
					"content": "Хм... Да. Эта анкета действительно была странной. И кажется... Монглан очень устала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660996
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660996,
					"content": "«Искусство переговоров» провалилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660997
					]
				},
				{
					"id": 740660997,
					"content": "Какое там искусство! Как и ожидалось, от этой книги никакого прока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660998,
						740661000,
						740661002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660998,
					"content": "Да, вся проблема в книге.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660999
					]
				},
				{
					"id": 740660999,
					"content": "Точно-точно! И ты думаешь, что с этой книгой что-то не так? Однако ради купонов об этом можно пока забыть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740661000,
					"content": "Да нет, проблема в Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661001
					]
				},
				{
					"id": 740661001,
					"content": "Что? Но... Паймон же делала всё так, как написано в книге. Посмотри, «поэтому я повышаю голос...». Это в книге не то написано!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740661002,
					"content": "Трудно не согласиться с твоим мнением, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661003
					]
				},
				{
					"id": 740661003,
					"content": "Эй! Нечего водить за нос Паймон! Какое там искусство! Как и ожидалось, никакого прока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660978,
					"content": "#Нет, абсолютно не {M#доволен}{F#довольна}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660979
					]
				},
				{
					"id": 740660979,
					"content": "#Нет-нет-нет, отмечай, что {M#доволен}{F#довольна}, нам нужны купоны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660980
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660980,
					"content": "Довольны? Принято.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660982
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660981,
					"content": "#Хотя в принципе я {M#доволен}{F#довольна}, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660965,
					"content": "Неразумно, следует...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660966,
					"content": "Трудно не согласиться с твоим мнением, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660962,
					"content": "(Это... подводка к теме?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660949,
					"content": "Не вызывает интерес, потому что Паймон никогда не попадается то, что она хочет поесть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660950
					]
				},
				{
					"id": 740660950,
					"content": "...Каждый раз вкус ну очень странный. Откуда же здесь взяться восторгу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660951,
					"content": "Трудно не согласиться с твоим мнением, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660952
					]
				},
				{
					"id": 740660952,
					"content": "Вот если бы после каждых восемнадцати обедов выдавали что-то действительно вкусное, было бы неплохо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660953
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660953,
					"content": "Почему восемнадцати?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660954
					]
				},
				{
					"id": 740660954,
					"content": "А это не Паймон придумала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660955
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660955,
					"content": "Как говорится, хм, в день обычно три приёма пищи, к воскресенью как раз проходит шесть дней. Поэтому в субботу ты съедаешь свой восемнадцатый ужин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660956
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660956,
					"content": "И вот в воскресенье можно поесть что-нибудь вкусненькое! Так каждую неделю будет отличное настроение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660929,
					"content": "Нет! Даже господину Вулси не достаётся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660930
					]
				},
				{
					"id": 740660930,
					"content": "Да он и не хочет есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660931
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660931,
					"content": "Поняла, то есть в целом, ассортимент недостаточный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660932,
					"content": "Трудно не согласиться с твоим мнением, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660933
					]
				},
				{
					"id": 740660933,
					"content": "Без разницы, мы всё равно не едим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660934
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660934,
					"content": "О... Я знаю, что вы читали ту книгу... В общем, я отмечаю «да», верно?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660909,
					"content": "Неразумно, необходимо повысить цены!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660910
					]
				},
				{
					"id": 740660910,
					"content": "А?! Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660911
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660911,
					"content": "Не хочу получше, хочу подороже!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660912
					]
				},
				{
					"id": 740660912,
					"content": "Что за странные мысли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660913
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660913,
					"content": "#Ты... ты в порядке? Ты {M#какой-то странный}{F#какая-то странная} сегодня. Съел{F#а} что-нибудь не то?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660914,
					"content": "Трудно не согласиться с твоим мнением, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660915
					]
				},
				{
					"id": 740660915,
					"content": "Но?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660916
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660916,
					"content": "#Но ещё есть куда расти! Вот было бы чуть-чуть повкуснее, да, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660917
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660917,
					"content": "Или бы продавали цыплёнка в медовом соусе!.. Точно! Тогда Паймон бы каждый день ела здесь от пуза!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}