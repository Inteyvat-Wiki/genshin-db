					}
				]
			},
			"dialogs": [
				{
					"id": 740660301,
					"content": "Стойка регистрации... О, это здесь! Попытаем удачу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660302,
					"content": "Госпожа Монглан, здравствуйте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660304
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660304,
					"content": "(Ого! На вид суровая дама.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660305,
					"content": "(Почему бы не опробовать «Искусство переговоров»?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660306
					]
				},
				{
					"id": 740660306,
					"content": "(И верно! Кто бы знал, что эта книга может здесь пригодиться.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660307,
					"content": "Посмотрим-ка... Паймон нашла! «Если вы возьмёте инициативу в свои руки и надавите на противника...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660308,
					"content": "Вот оно! Надавить на противника! Паймон поняла! Интонация потвёрже, голос погромче!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660309,
					"content": "Эй! Госпожа Монглан! Здравствуйте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660310,
					"content": "Я вас слышу. Вам чем-то помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660311
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660311,
					"content": "А? И правда работает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660312,
					"content": "#Хи-хи, госпожа Монглан, мы бы хотели пройти анкетирование! О, точнее, нет, Паймон всего лишь сопровождает {M#его}{F#её}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660313,
					"content": "#(Не волнуйся, {NICKNAME}, с нами книга. Паймон будет тайком подсматривать в книгу и подсказывать тебе! В общем... В общем, просто слушай, что говорит Паймон.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660314,
					"content": "Снова увидели сообщение в книге...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660315
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660315,
					"content": "Ага! Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660316,
					"content": "Сколько же записок распространили... Хотя... неважно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660317
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660317,
					"content": "Кхе-кхе, пожалуйста, подождите. Сначала я объясню вам правила. В данном опросе всего пять вопросов, пожалуйста, отвечайте искренне и быстро. Обращаю ваше внимание: быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660318
					],
					"speakerTitle": "Монглан"
				},
				{
					"id": 740660318,
					"content": "Понятно? Можем начинать, как будете готовы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Монглан"
				}
			]
		},
