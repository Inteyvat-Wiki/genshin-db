			"dialogs": [
				{
					"id": 740660201,
					"content": "«Искусство переговоров»...? Пф, судя по названию, эта книга очень скучная! Паймон совершенно не интересно... А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660202,
					"content": "Что? Здесь вложена записка? Хм... «Пройдите к стойке регистрации, чтобы принять участие в опросе относительно степени удовлетворённости купонной столовой. Получите купоны за участие в исследовании...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740660203,
					"content": "Купоны! Ура! Видишь? Можно получить купоны! Можно получить почти даром, идём скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7406603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
