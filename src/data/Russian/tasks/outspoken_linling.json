			},
			"dialogs": [
				{
					"id": 413360301,
					"content": "Отлично, они подойдут. А теперь давай-ка навестим заведующего Сяо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лин"
				}
			]
		},
		{
			"id": 4133604,
			"completionStepIds": [
				4133604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133604",
							"2"
						],
						"stepId": 4133604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Линь Лин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360401,
					"content": "Вон он, заведующий Сяо. Давай посмотрим, чем он занимается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360402
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360402,
					"content": "Хм, дай подумать... Заведующего Сяо я знаю довольно давно, и написать для него пожелание не должно составить особого труда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360403
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360403,
					"content": "Вот, как тебе такое:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360404
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360404,
					"content": "«Он мрачный старик, с ним не сладить никак...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360405,
						413360406
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360405,
					"content": "Что?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				},
				{
					"id": 413360407,
					"content": "«Но за личиною хмурой таится добряк».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360408,
						413360409
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360408,
					"content": "Н-да...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360410,
					"content": "Я и название придумала... «И впрямь добряк».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360411
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360411,
					"content": "Верно подмечено, как считаешь? С виду заведующий Сяо та ещё злюка, но на деле он славный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360412
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360412,
					"content": "Какие-нибудь другие варианты у тебя есть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360413
					]
				},
				{
					"id": 413360413,
					"content": "Нет, пока только этот. Да и как продолжить, я тоже не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360414
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360414,
					"content": "Может, ты хочешь попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360415
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360415,
					"content": "Первая строка такая: «Нрав крутой и властный взгляд...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360416
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360416,
					"content": "«Он пример для всех ребят».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360417
					]
				},
				{
					"id": 413360417,
					"content": "Неплохо, неплохо... Пойдёт. Ещё нужно название...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360418
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360418,
					"content": "Эм... «Каменная безмятежность»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360419
					]
				},
				{
					"id": 413360419,
					"content": "О, я и не подозревала, что у тебя такой поэтический дар. Это отличные строки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360420
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360420,
					"content": "Подожди, я сейчас напишу их на фонарике...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360421
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360421,
					"content": "Готово. Давай подарим его заведующему Сяо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360409,
					"content": "Горшочек, не вари...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360406,
					"content": "Ты что, шутишь, что ли...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				}
			]
		},
		{
			"id": 4133605,
			"completionStepIds": [
				4133605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
