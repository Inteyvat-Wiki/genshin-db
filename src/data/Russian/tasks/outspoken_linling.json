			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Заведующий Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360501,
					"content": "Здравствуй, Линь Лин. По какому ты делу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360502
					],
					"speakerTitle": "Заведующий Сяо"
				},
				{
					"id": 413360502,
					"content": "#Помните, вы просили меня придумать пару строк для вашего праздничного благословения? У нас с путешественни{F#цей}{M#ком} всё готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360503
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360503,
					"content": "Видите, мы даже написали их на небесном фонаре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360504
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360504,
					"content": "Ох, большое вам спасибо. Позвольте мне прочесть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360505
					],
					"speakerTitle": "Заведующий Сяо"
				},
				{
					"id": 413360505,
					"content": "«Нрав крутой и властный взгляд, он пример для всех ребят...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360506
					],
					"speakerTitle": "Заведующий Сяо"
				},
				{
					"id": 413360506,
					"content": "«Каменная безмятежность»... Хе-хе, очень неплохо, спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360507
					],
					"speakerTitle": "Заведующий Сяо"
				},
				{
					"id": 413360507,
					"content": "Не стоит благодарности, заведующий Сяо. У меня тут ещё для вас строки, которые я сочинила сама...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360508,
						413360509
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360508,
					"content": "Нам пора! Нас срочно ждут в другом месте!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				},
				{
					"id": 413360510,
					"content": "Точно! Ладно... Наш следующий клиент - Дэ Гуй. Пойдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360511
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360511,
					"content": "Строками для Дэ Гуя я особенно горжусь. Прочитаю их тебе, когда мы его найдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360509,
					"content": "У нас ещё остались фонари, которые нужно раздать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				}
			]
		},
