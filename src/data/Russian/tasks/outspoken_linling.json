						413360817
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360817,
					"content": "«На лодках своих по лазурным волнам...»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360818
					]
				},
				{
					"id": 413360818,
					"content": "О, вот это хорошо было. А название?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360819
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360819,
					"content": "Пусть будет... «Рыбный рынок Би Бо»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360820
					]
				},
				{
					"id": 413360820,
					"content": "«Свежайшую рыбу приносит он нам на лодках своих по лазурным волнам...» Под заголовком «Рыбный рынок Би Бо».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360821
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360821,
					"content": "«Нету днём крысы хитрее него, ну а ночью он, кажись, ничего...» Под названием «Славный малый».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360822
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360822,
					"content": "Хм... Да, у тебя лучше получилось. Мои строки слишком уж выразительны. Такого обычно на небесных фонарях не пишут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360823
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360823,
					"content": "Хорошо! Напишем на фонарике твои строки и передадим его Би Бо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360812,
					"content": "Это никуда не годится!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360813
					]
				},
