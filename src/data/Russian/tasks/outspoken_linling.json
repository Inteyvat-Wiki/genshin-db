					"nextDialogs": [
						413360702
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 413360702,
					"content": "#Помните, вы попросили написать для вас пару строчек на небесном фонаре? Мы с путешественни{F#цей}{M#ком} всё уже сделали.",
					"roleType": "TALK_ROLE_NPC",
