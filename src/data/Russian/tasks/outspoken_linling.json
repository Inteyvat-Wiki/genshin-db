						413360703
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360703,
					"content": "Вот, держите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360704
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360704,
					"content": "О, спасибо! Так, почитаем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360705
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 413360705,
					"content": "«Чаши вина пробирают до дрожи, а шарики в супе на жемчуг похожи...» «Глубины наших глубин».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360706
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 413360706,
					"content": "И в самом деле, очень славно. Спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360707
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 413360707,
					"content": "#Не за что. Этим вдохновенным строкам мы обязаны путешественни{F#це}{M#ку}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360708
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360708,
					"content": "Кстати, у меня на этой бумажке написано ещё пару строк. Я их сама сочинила. Будет время - можете прочесть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360709
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 413360709,
					"content": "Обязательно! Спасибо вам. А мне нужно возвращаться к делам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360710
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 413360710,
					"content": "«В \"Три чашки\" зашёл. Заказал, заплатил. Принесли. Это что, уже кто-то пил?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360711
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 413360711,
					"content": "Итак, на очереди у нас Би Бо. Он тоже просил оформить ему небесный фонарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лин"
				}
			]
