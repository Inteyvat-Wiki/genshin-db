			},
			"dialogs": [
				{
					"id": 102030201,
					"content": "В следующий раз я буду аккуратней...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030202
					],
					"speakerTitle": "Одиночная камера"
				},
				{
					"id": 102030202,
					"content": "В следующий раз, когда я отправлюсь в эпическое приключение, это будет самым безопасным приключением на свете!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030203
					],
					"speakerTitle": "Одиночная камера"
				},
				{
					"id": 102030203,
					"content": "Говорят, что у Гильдии искателей приключений есть свод правил. Может быть, стоит спросить у них...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030204
					],
					"speakerTitle": "Одиночная камера"
				},
				{
					"id": 102030204,
					"content": "Ох, если бы Сайрус это услышал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102030205,
					"content": "Он бы попросил Джинн увеличить срок заключения Кли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
