				"points": []
			},
			"dialogs": [
				{
					"id": 102030101,
					"content": "Эх... Кли - не простой ребёнок. На самом деле, она рыцарь. Рыцарь Искорка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030102
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102030102,
					"content": "Не может быть! Даже Кли - рыцарь Ордо Фавониус?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030103,
						102030104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102030103,
					"content": "Не завидуй, Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				},
				{
					"id": 102030105,
					"content": "Да! Паймон думает, что это нечестно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102030106,
					"content": "Но стоит признать, что этот титул подходит Кли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102030107,
					"content": "Хоть она и доставляет ордену немало хлопот, но с ней точно не соскучишься!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030108
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102030108,
					"content": "Насчёт её прошлого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030109
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102030109,
					"content": "Когда-нибудь ты поймёшь, в чём дело...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030110
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102030110,
					"content": "#Прошу тебя, {NICKNAME}, приглядывай за ней...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102030104,
					"content": "Звучит круче, чем «почётный рыцарь»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				}
			]
		},
