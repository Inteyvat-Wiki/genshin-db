				"objectNames": [
					"Даймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722700101,
					"content": "#Я Даймон из дзибасири. Герой Сангономии, ты досто{F#йна}{M#ин} принять испытание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700102
					],
					"speakerTitle": "Даймон"
				},
				{
					"id": 722700102,
					"content": "Доблесть - это сила, позволяющая победить всех врагов любыми способами. Просто победи всех противников и выпусти Пламя Высоких Ворот, чтобы открылся проход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700103
					],
					"speakerTitle": "Даймон"
				},
				{
					"id": 722700103,
					"content": "Следует сказать, что все эти противники - иллюзии, рожденные солнечными фантазмами, и великие враги, что отпечатались в твоём сердце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700104
					],
					"speakerTitle": "Даймон"
				},
				{
					"id": 722700104,
					"content": "Но и так без должной осторожности ждёт тебя погибель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700105
					],
					"speakerTitle": "Даймон"
				},
				{
					"id": 722700105,
					"content": "Я подожду в Башне трёх миров, пока ты завершишь испытание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Даймон"
				}
			]
		},
