			"dialogs": [
				{
					"id": 745050101,
					"content": "Здра... Здравствуйте! Меня... зовут... Ар... Арманд...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050102
					],
					"speakerTitle": "Арманд"
				},
				{
					"id": 745050102,
					"content": "Ты нервничаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745050103,
					"content": "П-п-простите... Слишком м-много людей... Я за-за-заикаюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050104
					],
					"speakerTitle": "Арманд"
				},
				{
					"id": 745050104,
					"content": "Не волнуйся. Торопиться некуда, мы просто пришли опробовать игрушку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745050105,
					"content": "О-о-о. К-к-конечно... Я подготовил для вас... и-и-инструкцию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050106
					],
					"speakerTitle": "Арманд"
				},
				{
					"id": 745050106,
					"content": "Это так мило с твоей стороны, Арманд! Мы обязательно внимательно изучим её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745050107,
					"content": "Н-ничего страшного, если вы не прочтёте. И-и-играть очень п-п-просто и весело... Хотите попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050108
					],
					"speakerTitle": "Арманд"
				},
				{
					"id": 745050108,
					"content": "Да, спасибо, я попробую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745050109
