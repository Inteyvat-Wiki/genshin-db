			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Роальд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750101,
					"content": "Вы всё ещё на этом острове. Очень хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750102
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750102,
					"content": "Как ваши дела? Что интересного произошло? Расскажите обо всём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750103,
						721750105
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750103,
					"content": "Ничего сногсшибательного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750104
					]
				},
				{
					"id": 721750104,
					"content": "Это в порядке вещей. На таких островах нет недостатка в загадках. Я уверен, что в конце концов вы на что-нибудь наткнётесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750107,
					"content": "Вообще-то, у Паймон есть вопрос: что ты здесь делаешь, Роальд?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721750108,
					"content": "Я? Я просто собираю свои вещи и готовлюсь к отъезду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750109
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750109,
					"content": "Туман здесь слишком причудливый. Стоит ненадолго зайти в него, и ты потеряешь дорогу... Не успеешь оглянуться, как окажешься там, откуда начал свой путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750110
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750110,
					"content": "Я забыл дорогу, которую Кама указал мне. Попытался найти местных жителей, которые могли бы указать мне путь, но не смог найти никакой дороги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750111
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750111,
					"content": "Компас, тени на земле... ничто из этого не помогает определить направление. Я даже пытался использовать свои ботинки, но нет! Я не мог сделать ни шагу дальше в туман.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750112
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750112,
					"content": "Ботинки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721750113,
					"content": "Он имеет в виду, что использовал их в качестве путевых маркеров.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750114
					]
				},
				{
					"id": 721750114,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721750115,
					"content": "#Ха-ха! Я не удивлён, что ты знаешь об этом способе, {NICKNAME}! Полагаю, ты хорошо знаком{F#а} с маленькими хитростями искателей приключений. Тебе ещё многому предстоит научиться, Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750116
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750116,
					"content": "Паймон ещё нужно многому научиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750117
					]
				},
				{
					"id": 721750117,
					"content": "Да ладно, это просто называется «попробовать на авось»! Паймон не нужно этому учиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721750118,
					"content": "В любом случае мой прогресс исследования остановился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750119
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750119,
					"content": "Если бы я привязал веревку к ближайшему дереву и попытался пройти вперёд, крепко держась за другой её конец, я, вероятно, смог бы сделать ещё несколько попыток.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750120
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750120,
					"content": "Почему бы тебе не попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721750121,
					"content": "Я использовал запасные ботинки, которые взял с собой, чтобы определить, где я нахожусь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750122,
						721750124
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750122,
					"content": "Ботинки оказались на один раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750123
					]
				},
				{
					"id": 721750123,
					"content": "Хе-хе, на самом деле это не так. Просто я бросал слишком много ботинок и забывал их подбирать... Поэтому они просто закончились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750126,
					"content": "Подождите. Точно! Я наконец-то вспомнил! Я хочу попросить вас кое о чём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750127
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750127,
					"content": "Эй, хватит скакать туда-сюда! Я подумала, что ты собираешься укусить меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721750128,
					"content": "Ха-ха, прошу прощения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750129
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750129,
					"content": "Как вы знаете, у меня есть довольно постыдная привычка постоянно что-то забывать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750130
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750130,
					"content": "Моя плохая память не раз играла со мной злую шутку, особенно если учесть, что я искатель приключений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750131
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750131,
					"content": "И одной из моих целей приезда на остров Цуруми было собрать нечто, известное как светящиеся грибы. По словам Санго, эти грибы могут помочь улучшить память и снять нагрузку с мозга. Говорят, что они даже могут улучшить зрение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750132
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750132,
					"content": "В последний раз, когда я приезжал сюда с Камой, я был так озабочен «знакомством с местными жителями», что забыл собрать грибы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750133
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750133,
					"content": "Я также не ожидал, что, приехав на остров в одиночку, столкнусь со столькими проблемами. Очень жаль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750134
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750134,
					"content": "Так что если вы планируете искать приключения в этой местности, не могли бы вы помочь мне собрать несколько этих светящихся грибов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750135,
						721750137
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750135,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750136
					]
				},
				{
					"id": 721750136,
					"content": "Премного благодарен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750137,
					"content": "Только не забудь обо мне, когда придёт время.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750138
					]
				},
				{
					"id": 721750138,
					"content": "Ха-ха, не переживайте, я точно не забуду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750124,
					"content": "Очень жаль...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750125
					]
				},
				{
					"id": 721750125,
					"content": "И не говорите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750105,
					"content": "Мы всё ещё исследуем это место.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750106
					]
				},
				{
					"id": 721750106,
					"content": "Правда? Ха-ха! Тогда не смею вас задерживать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Роальд"
				}
			]
		},
		{
			"id": 7217503,
