				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217517",
							"3"
						],
						"stepId": 7217517,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217510",
							"2"
						],
						"stepId": 7217510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Роальд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750301,
					"content": "Этого достаточно. Спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750302
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750302,
					"content": "Кстати, сообщите мне, если найдёте что-нибудь рядом с церемониальным местом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750303
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750303,
					"content": "Чуть не забыл. Я полагаю, что у вас с собой фотокамера из Фонтейна, верно? Это довольно дорогое устройство... Если позволит бюджет, я обязательно куплю себе такую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750304
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750304,
					"content": "Я слышал, как местные историки рассказывали, что древние жители острова Цуруми с помощью красок изображали на стенах пещер древнюю, ныне забытую историю, и что этим рисункам более тысячи лет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750305
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750305,
					"content": "Во время моей предыдущей поездки сюда мне удалось увидеть эти изображения при свете церемониального костра... Они занимали мои мысли в течение нескольких беспокойных ночей, и их действительно было трудно забыть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750306
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750306,
					"content": "Я сомневаюсь, что кто-либо видел эти рисунки целиком. Если вы сможете принести доказательства их существования, это, несомненно, станет большим прорывом для Гильдии искателей приключений в исторической области.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750307
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750307,
					"content": "Если вы найдёте эти легендарные рисунки, сделайте как можно больше чётких фотографий. Я куплю у вас фотографии для своих дневников по справедливой цене в награду за ваш труд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750308
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750308,
					"content": "Ну что, договорились?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750309,
						721750311
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750309,
					"content": "Конечно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750310
					]
				},
				{
					"id": 721750310,
					"content": "Большое спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750311,
					"content": "Главное, чтобы ты не потерял дневник!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750312
					]
				},
				{
					"id": 721750312,
					"content": "Я... постараюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Роальд"
				}
			]
		},
		{
			"id": 7217504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
