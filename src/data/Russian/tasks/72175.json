			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Роальд",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750401,
					"content": "Привет! Нашли что-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750402,
						721750405
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750402,
					"content": "Ничего особенного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750403
					]
				},
				{
					"id": 721750403,
					"content": "Не торопитесь. Я буду здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750404
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750404,
					"content": "Кстати, спасибо за светящиеся грибы. Они очень свежие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750407,
					"content": "Тебе легко говорить. Разве не мы дали тебе эти грибы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721750408,
					"content": "Да ладно, не надо переживать по пустякам. Я же их ел, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750409
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750409,
					"content": "Ах ты... опять забыл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721750405,
					"content": "Мы работаем над этим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750406
					]
				},
				{
					"id": 721750406,
					"content": "Отдохните немного, если вы устали. Хотите грибочек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "Роальд"
				}
			]
		},
		{
			"id": 7217506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217501",
							"3"
						],
						"stepId": 7217501,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217517",
							"2"
						],
						"stepId": 7217517,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
