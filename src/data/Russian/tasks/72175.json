			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Роальд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750601,
					"content": "#Привет, {NICKNAME}. И тебе привет, летающая подруга!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750602
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750602,
					"content": "И тебе привет, забывашка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721750603,
					"content": "Меня зовут Паймон, понятно? Пай-мон! Не надо забывать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721750604,
					"content": "Не забуду, Паймончик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750605
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721750605,
					"content": "Так ты просто дразнил Паймон? Где твои манеры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721750606,
					"content": "#Знаешь что, {NICKNAME}? Просто отдай ему те странные грибы. Паймон с ним больше не разговаривает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721750607,
					"content": "Этого достаточно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7217518,
			"completionStepIds": [
				7217509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217502",
							"3"
						],
						"stepId": 7217502,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217509",
							"2"
						],
						"stepId": 7217509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Роальд",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721751801,
					"content": "#Вот мы и встретились снова, {NICKNAME}! И...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751802
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751802,
					"content": "?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721751803,
					"content": "Могу я спросить, за сколько вы продадите свою летающую подругу? Мне кажется, она довольно интересная!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751804
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751804,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751805,
						721751807
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721751805,
					"content": "С тобой всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751806
					]
				},
				{
					"id": 721751806,
					"content": "С ним определённо что-то не так! Кажется, у него снова приступ амнезии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721751809,
					"content": "О чём вы говорите, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751810
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751810,
					"content": "П-ф-ф... ха-ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751811
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751811,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751812
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721751812,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751813
					]
				},
				{
					"id": 721751813,
					"content": "Ха-ха-ха-ха-ха! Только посмотрите на свои лица! Ха-ха-ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751814
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751814,
					"content": "Нет сил смеяться... Ой, уморили! Прошу прощения за шутку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751815
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751815,
					"content": "Ни разу не смешно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751816,
						721751817
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721751816,
					"content": "Боюсь, я не понимаю вашего чувства юмора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751818,
					"content": "Хорошо-хорошо, больше никаких шуток. Ещё раз прошу прощения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751819
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751819,
					"content": "Паймон думала, что всемирно известный искатель приключений будет более серьёзным человеком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751820
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721751820,
					"content": "Ха-ха. Возможно, лучше не иметь убеждённого мнения об искателях приключений. Гильдия известна как сборище чудаков. Я бы даже назвал себя самым нормальным из них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751821
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751821,
					"content": "Нормальным тебя сложно назвать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751822
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721751822,
					"content": "Тем не менее спасибо за грибы. Пока что их действие не очень заметно. Возможно, чтобы они подействовали, их нужно употреблять подольше, а может, они вообще не обладают лечебными свойствами... Но в любом случае они очень вкусные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751823
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751823,
					"content": "Нужно держать себя в руках и не съесть их все. Надо оставить немного для моего друга в Сумеру, чтобы он смог исследовать их лекарственные свойства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751824
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751824,
					"content": "Мне кажется, что ты просто забудешь об этом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751825
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721751825,
					"content": "Ладно, поговорим о деле. Вы уже начали искать рисунки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751826
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751826,
					"content": "Эти фотографии подойдут?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751827
					]
				},
				{
					"id": 721751827,
					"content": "Не могу выразить словами, как я вам благодарен! Именно так здесь благодарят, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751828
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751828,
					"content": "Давайте посмотрим. Интересно, очень интересно. Хм, вы нашли ещё какие-нибудь рисунки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751829,
						721751830
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751829,
					"content": "Это все рисунки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751831,
					"content": "Хм, тогда это ещё интереснее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751832
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751832,
					"content": "Что это значит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751833
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721751833,
					"content": "Жители острова Цуруми поклонялись чудовищной птице, которая обладала силой Электро. Их культура была сосредоточена вокруг ритуалов и церемоний, связанных с ней. Большинство людей, которые хоть немного разбираются в истории, не опровергают эту точку зрения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751834
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751834,
					"content": "Но на предоставленных вами рисунках нет никаких признаков присутствия Громовой птицы. Похоже, что люди поклонялись чему-то другому...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751835
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751835,
					"content": "Солнце, луна, звёзды... и какие-то странные символы... что бы это ни было. Возможно, жители острова Цуруми уже достигли определённой степени развития цивилизации до пришествия Громовой птицы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751836
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751836,
					"content": "Кроме того здесь изображён туман и лунный свет, звёзды и тьма... Хм, я не могу объяснить это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751837
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751837,
					"content": "Тебе лучше не думать слишком много, Роальд. Кто знает, как это отразится на твоей памяти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751838
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721751838,
					"content": "Простите. Я был так поглощен своими мыслями, что забыл о вашем присутствии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751839
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751839,
					"content": "Ещё раз спасибо за ваши труды. Думаю, этого достаточно для написания моего следующего дневника... На случай, если он попадёт в руки историков, я упомяну вас в разделе благодарностей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751840
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751840,
					"content": "Думаю, мне пора отчитаться перед Гильдией. Простите за то, что отнял у вас столько времени. Надеюсь, мы ещё встретимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751841
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751841,
					"content": "Какой занятой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751842
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721751842,
					"content": "Чуть не забыл, есть ещё одно дело. Ничего серьёзного, но я надеюсь, что вы поможете мне присмотреть за одним человеком. Это тот ребёнок, о котором я упоминал ранее. Его зовут... Эм... Как же его зовут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751843
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751843,
					"content": "Ру! Его зовут Ру! В этот раз я принёс ему угощение... Надеюсь, оно ещё не испортилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751844
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751844,
					"content": "С момента моего прошлого прибытия на остров, я всё время думаю о нём. Ему, должно быть, непросто жить в таком опасном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751845
					],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751845,
					"content": "#Не смею больше отнимать ваше время. Давайте встретимся снова на следующем этапе наших путешествий, {NICKNAME}! К звёздам и к безднам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Роальд"
				},
				{
					"id": 721751830,
					"content": "Это всё, что мы нашли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751817,
					"content": "Наверное, это способ забывчивых людей выжить в этом мире.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751807,
					"content": "Светящиеся грибы вроде помогали ему раньше?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751808
					]
				},
				{
					"id": 721751808,
					"content": "Да, точно! Почему мне кажется, что ему стало хуже?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}