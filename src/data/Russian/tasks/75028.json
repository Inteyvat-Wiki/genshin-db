			"dialogs": [
				{
					"id": 750280101,
					"content": "Ты... сильнее, чем кажешься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280102
					],
					"speakerTitle": "Мышь"
				},
				{
					"id": 750280102,
					"content": "Ох, кому мы перешли дорогу? Кто мог послать громилу, чтобы проучить нас?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280103
					],
					"speakerTitle": "Филин"
				},
				{
					"id": 750280103,
					"content": "#Пожалуйста, {M#братишка}{F#сестрёнка}, скажи, чем мы тебя обидели? Мы больше так не будем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280104
					],
					"speakerTitle": "Филин"
				},
				{
					"id": 750280104,
					"content": "#Эй ты, ничтожество! Ты собираешься пресмыкаться перед {F#этой девчонкой}{M#этим парнишкой}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280105
					],
					"speakerTitle": "Мышь"
				},
				{
					"id": 750280105,
					"content": "Разве разговоры в грубой форме помогут нам заработать на жизнь? Мы же воры и мошенники. В торговле заврианами нет ничего такого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280106
					],
					"speakerTitle": "Филин"
				},
				{
					"id": 750280106,
					"content": "#Я лучше пойду с {M#братишкой}{F#сестрёнкой}, чем буду сидеть в ожидании, что меня ограбит более сильный бандит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280107
					],
					"speakerTitle": "Филин"
				},
				{
					"id": 750280107,
					"content": "#Не хочу хвастаться, {M#братишка}{F#сестрёнка}, но я уверен, что буду гораздо полезнее, чем эти двое. Позови меня, если тебе что-нибудь понадобится. Я всё сделаю в лучшем виде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280108
					],
					"speakerTitle": "Филин"
				},
				{
					"id": 750280108,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280109,
						750280111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280109,
					"content": "Я как раз подыскиваю себе помощника.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280110
					]
				},
				{
					"id": 750280110,
					"content": "Серьёзно?! Ни за что! Паймон накладывает вето на это решение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750280112,
					"content": "К тому же вы злодеи, а мы порядочные и ни за что не объединимся с теми, кто торгует заврианами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280113,
						750280114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750280113,
					"content": "На свете нет более порядочного человека, чем я.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280117
					]
				},
				{
					"id": 750280117,
					"content": "#Слушайте сюда. Какие бы планы у вас ни были на заврианов, лучше остановитесь, а то мы... В общем, {NICKNAME} покажет вам, что к чему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750280118,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280119,
					"content": "Разъярённые торговцы удаляются...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750280120
					]
				},
				{
					"id": 750280120,
					"content": "Паймон интересно, как там тот кукузавр. Пойдём, посмотрим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750280114,
					"content": "Мы всегда можем найти компромисс.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280115
					]
				},
				{
					"id": 750280115,
					"content": "#Эй, ты плохо влияешь на нашего друга! {REALNAME[ID(2)|SHOWHOST(true)]}, не волнуйся, мы не будем работать с торговцами заврианами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750280116,
					"content": "Р-р-р... Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280111,
					"content": "Спасибо за заботу, но я, пожалуй, откажусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280112
					]
				}
			]
		},
