			"dialogs": [
				{
					"id": 761500101,
					"content": "Кхе-кхе-кхе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500102
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 761500102,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500103
					]
				},
				{
					"id": 761500103,
					"content": "Я... в порядке. Мне приснился долгий-предолгий кошмар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500104
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 761500104,
					"content": "...Забудь. Считай, что я ничего не говорила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500105
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 761500105,
					"content": "Я больше не могу! Почему всё это происходит со мной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500106
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 761500106,
					"content": "Почему со мной всегда происходят такие вещи. Папа, мама, а потом и сестра...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500107
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 761500107,
					"content": "Всё в порядке, я здесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500108
					]
				},
				{
					"id": 761500108,
					"content": "...Я не сержусь на вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500109
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 761500109,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500110
					],
					"speakerTitle": "Декс"
				},
				{
					"id": 761500110,
					"content": "Что подобрал Декс?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500111
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 761500111,
					"content": "Я называю это фрагментом забвения. Возможно, это наш путь от смерти к жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500112
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761500112,
					"content": "Идём вместе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500113
					]
				},
				{
					"id": 761500113,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500114
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 761500114,
					"content": "Раз мы нашли Цайтлинд, давайте искать выход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500115
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761500115,
					"content": "Ты уверен, что мы сможем выбраться отсюда своими силами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500116
					],
					"speakerTitle": "Аларэ"
				},
				{
					"id": 761500116,
					"content": "Раз Меланта и Нихилита могут свободно приходить и уходить, и даже берут с собой людей, то и Декс должен быть способен на это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500117
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761500117,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500118
					],
					"speakerTitle": "Декс"
				},
				{
					"id": 761500118,
					"content": "У нас три фрагмента забвения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500119
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761500119,
					"content": "О, это временное название. Потому что я не знаю, зачем Декс собирает их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500120
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761500120,
					"content": "Декс, что будем делать дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500121
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 761500121,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500122
					],
					"speakerTitle": "Декс"
				},
				{
					"id": 761500122,
					"content": "Пойдём туда, куда он указывает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Историй"
				}
			]
		},
