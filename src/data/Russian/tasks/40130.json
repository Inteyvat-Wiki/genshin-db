				]
			},
			"dialogs": [
				{
					"id": 401300801,
					"content": "Привет, Фремине! Телькси! Мы здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401300802,
					"content": "#Привет, Паймон. Привет, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300803
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 401300803,
					"content": "-.. -... .-- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300804
					],
					"speakerTitle": "Телькси"
				},
				{
					"id": 401300804,
					"content": "Готова ли корона?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401300805,
					"content": "Да, мы ждём только Зурию. Она ещё не пришла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300806
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 401300806,
					"content": "Тогда подождём! А может, нам пойти поискать её? Она не так уж далеко. Она же говорила, что живёт вон на том холме?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300807
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401300807,
					"content": "#Привет, {NICKNAME}, Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300808
					],
					"speakerTitle": "Деларош"
				},
				{
					"id": 401300808,
					"content": "Хе-хе, кстати говоря...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401300809,
					"content": "Наконец-то я вас нашла... Я так рада, что с вами всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300810
					],
					"speakerTitle": "Деларош"
				},
				{
					"id": 401300810,
					"content": "Деларош, почему ты здесь? И что с нами могло случиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300811
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401300811,
					"content": "Что могло случиться? Конечно же, водяной Телькси! После того как я дала вам на днях поручение, я начала волноваться и пошла разузнавать о пропавшем мальчике...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300812
					],
					"speakerTitle": "Деларош"
				},
				{
					"id": 401300812,
					"content": "Да? Это мы уже выяснили! Это был всего лишь Фремине. И в исчезновении рыбы тоже он виноват. Не волнуйтесь, мы поможем вам вернуть рыбу, как только закончим эту работу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300813
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401300813,
					"content": "Простите, я недавно нырял там...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300814
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 401300814,
					"content": "Фремине? Ты нырял? Нет-нет-нет... всё было совсем не так. Я слышала совершенно другое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300815
					],
					"speakerTitle": "Деларош"
				},
				{
					"id": 401300815,
					"content": "Мне рассказали, что примерно месяц назад ребёнок привязал к своему телу кучу тяжёлых ракушек и вошёл в воду. Он так и не вернулся... Что это, если не влияние водяного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300816
					],
					"speakerTitle": "Деларош"
				},
				{
					"id": 401300816,
					"content": "Ты уверена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300817
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401300817,
					"content": "Уверена на сто процентов! Я порасспрашивала нескольких знакомых рыбаков. Ребёнку было всего восемь лет... Его звали Леско. Леско Дестре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300818
					],
					"speakerTitle": "Деларош"
				},
				{
					"id": 401300818,
					"content": "Леско Дестре?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300819
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 401300819,
					"content": "Да, именно так! Говорят, что семья взяла себе эту фамилию после переезда в город из местечка под названием Дестре. Так вот, его мать - довольно известный торговец произведениями искусства, а отец скончался в результате несчастного случая много лет назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300820
					],
					"speakerTitle": "Деларош"
				},
				{
					"id": 401300820,
					"content": "Эх... Естественно, его мать была потрясена случившимся и тяжело заболела. Говорят, что она покинула Кур-де-Фонтейн. Никто не знает, куда она уехала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300821
					],
					"speakerTitle": "Деларош"
				},
				{
					"id": 401300821,
					"content": "Не может быть... Леско Дестре... Зурия Дестре... Невероятное совпадение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300822
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401300822,
					"content": "Похоже, нам необходимо сходить к Дестре.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300823
					]
				},
				{
					"id": 401300823,
					"content": "Простите, госпожа! Нам нужно срочно кое-что проверить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300824
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 401300824,
					"content": "А, ладно... Работайте тогда... Я только хотела убедиться, что с вами всё в порядке. Тогда я пойду обратно... Пожалуйста, будьте осторожнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Деларош"
				}
			]
		},
