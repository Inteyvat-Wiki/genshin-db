			"dialogs": [
				{
					"id": 413330401,
					"content": "Хм... Мне кажется, или... этот миндальный тофу странно пахнет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330402
					],
					"speakerTitle": "Железный Куай"
				},
				{
					"id": 413330402,
					"content": "Таким деликатесом Цзы Вэй угостить я не могу. Пожалуйста, принеси другую порцию.",
					"roleType": "TALK_ROLE_NPC",
