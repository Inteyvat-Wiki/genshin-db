					"Железный Куай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330301,
					"content": "#Ох, ты уже вернул{F#ась}{M#ся}? Миндальный тофу приготовил{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330302,
						413330303
					],
					"speakerTitle": "Железный Куай"
				},
				{
					"id": 413330302,
					"content": "Разумеется.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 413330303,
					"content": "Мне нужно ещё немного времени...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330304
					]
				},
				{
					"id": 413330304,
					"content": "Ничего страшного. Мне всё равно нужно ещё как-то закончить этот стих...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Железный Куай"
				}
			]
		},
		{
			"id": 4133304,
			"completionStepIds": [
				4133306
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
