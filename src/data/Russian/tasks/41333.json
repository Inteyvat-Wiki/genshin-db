		{
			"id": 4133307,
			"completionStepIds": [
				4133309,
				4133310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133309",
							"2"
						],
						"stepId": 4133309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзы Вэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330701,
					"content": "С этого ракурса... созвездие напоминает собаку. Нужно придумать подходящее название...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330702
					],
					"speakerTitle": "Цзы Вэй"
				},
				{
					"id": 413330702,
					"content": "Ах, это ты, Железный Куай. Что ты тут делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330703
					],
					"speakerTitle": "Цзы Вэй"
				},
				{
					"id": 413330703,
					"content": "Эм, ну... Это... Я тут прогуливался за городом и нашёл одно славное местечко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330704
					],
					"speakerTitle": "Железный Куай"
				},
				{
					"id": 413330704,
					"content": "Славное местечко? То есть там хорошо видны звёзды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330705
					],
					"speakerTitle": "Цзы Вэй"
				},
				{
					"id": 413330705,
					"content": "Д-да, точно! Там хорошо видно звёзды. А ещё оттуда можно запустить небесные фонари. Я приготовил один для нас, вот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330706
					],
					"speakerTitle": "Железный Куай"
				},
				{
					"id": 413330706,
					"content": "Ещё я на нём стих написал... Т-ты прочти его там...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330707
					],
					"speakerTitle": "Железный Куай"
				},
				{
					"id": 413330707,
					"content": "«Метеор и лопата внезапно сошлись, яркие искры меж ними зажглись...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330708
					],
					"speakerTitle": "Цзы Вэй"
				},
				{
					"id": 413330708,
					"content": "Ну... Что ты загадал, не понять, но стих получился очень интересный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330709
					],
					"speakerTitle": "Цзы Вэй"
				},
				{
					"id": 413330709,
					"content": "Однако никому своё желание на фонарике показывать нельзя, иначе оно не исполнится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330710
					],
					"speakerTitle": "Цзы Вэй"
				},
				{
					"id": 413330710,
					"content": "И всё-таки, у тебя ко мне какое-то дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330711
					],
					"speakerTitle": "Цзы Вэй"
				},
				{
					"id": 413330711,
					"content": "Ну, я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330712,
						413330713
					],
					"speakerTitle": "Железный Куай"
				},
				{
					"id": 413330712,
					"content": "Он нашёл отличное место, чтобы запустить небесный фонарь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				},
				{
					"id": 413330714,
					"content": "Запустить небесный фонарь? Ох, прости... Но я как раз хотела уйти подальше от всех этих фонарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330715
					],
					"speakerTitle": "Цзы Вэй"
				},
				{
					"id": 413330715,
					"content": "Из-за них совсем не видно звёзд, поэтому я постараюсь уйти как можно дальше от праздника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330716
					],
					"speakerTitle": "Цзы Вэй"
				},
				{
					"id": 413330716,
					"content": "Спасибо тебе за доброту, но мне нужно идти. Счастливого Праздника морских фонарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330717
					],
					"speakerTitle": "Цзы Вэй"
				},
				{
					"id": 413330717,
					"content": "А... А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330718,
						413330719
					],
					"speakerTitle": "Железный Куай"
				},
				{
					"id": 413330718,
					"content": "Всё, ушла.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330720,
					"content": "Я... Я в норме. Должно быть, вышло слишком размыто. Цзы Вэй ничего не поняла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330721
					],
					"speakerTitle": "Железный Куай"
				},
				{
					"id": 413330721,
					"content": "Не волнуйся, я не расстроился. В один прекрасный день она поймёт мои намерения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330722
					],
					"speakerTitle": "Железный Куай"
				},
				{
					"id": 413330722,
					"content": "#Всё равно спасибо тебе за помощь, путешественни{F#ца}{M#к}. Вот, держи. Это тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330723
					],
					"speakerTitle": "Железный Куай"
				},
				{
					"id": 413330723,
					"content": "Ну, надо хотя бы запустить фонарь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Железный Куай"
				},
				{
					"id": 413330719,
					"content": "Не вешай нос.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330713,
					"content": "Если хочешь запустить фонарик, вы могли бы сходить вместе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				}
			]
		},
