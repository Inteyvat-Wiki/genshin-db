			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хуа Цин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131201,
					"content": "Смертный! Ты тоже погряз в царстве страданий?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131202
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411131202,
					"content": "Похоже, здесь происходит то же самое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131203,
					"content": "Скажите, а этот человек уже просыпался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131204,
					"content": "Нет, но он иногда говорит во сне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131205
					],
					"speakerTitle": "Хуа Цин"
				},
				{
					"id": 411131205,
					"content": "Что говорит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131206,
					"content": "«Холодно...» «Больше не могу...» И всё такое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131207
					],
					"speakerTitle": "Хуа Цин"
				},
				{
					"id": 411131207,
					"content": "Некоторые из пострадавших об этом упоминали.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131208
					]
				},
				{
					"id": 411131208,
					"content": "Горы, снег и холод... Где бы это могло быть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Оз"
				}
			]
		},
