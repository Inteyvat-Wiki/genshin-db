					"Фишль"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130901,
					"content": "Вот и он.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130902
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130902,
					"content": "Я чувствую в нём колоссальную энергию элементов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130903
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411130903,
					"content": "Сошло на землю сердце мрака...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130904
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411130904,
					"content": "А Фатуи он зачем? Из-за энергии элементов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130905
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411130905,
					"content": "Не исключено. Но в таком случае его сила привлекла бы других существ тоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130906
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130906,
					"content": "Давайте рассмотрим поближе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4111310,
