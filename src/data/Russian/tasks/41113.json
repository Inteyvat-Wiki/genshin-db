			},
			"dialogs": [
				{
					"id": 411131301,
					"content": "Этот человек уже просыпался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131302,
					"content": "Ещё нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131303
					],
					"speakerTitle": "Ян"
				},
				{
					"id": 411131303,
					"content": "А он что-нибудь говорил во сне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131304,
					"content": "Ну... Вчера он вдруг закричал: «Как высоко!». Не знаю, что это могло значить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131305
					],
					"speakerTitle": "Ян"
				},
				{
					"id": 411131305,
					"content": "Высоко? Может быть, высоко как в заснеженных горах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131306,
					"content": "Нечистая гора пронзает небо, неся в этот мир силу мрака...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131307
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411131307,
					"content": "Давайте расспросим об остальных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4111314,
			"completionStepIds": [
				4111314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111314",
							"2"
						],
						"stepId": 4111314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Братец Хуан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131401,
					"content": "Привет. Кто-нибудь из жертв уже проснулся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131402,
					"content": "Вот так совпадение! Только что как раз проснулся <color=#00E1FFFF>Гао Шестой</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131403
					],
					"speakerTitle": "Братец Хуан"
				},
				{
					"id": 411131403,
					"content": "Отлично! Тогда мы за ним!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131404,
					"content": "Он только проснулся, и ещё очень слаб. Если вы собираетесь его расспрашивать, то делайте это помягче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131405
					],
					"speakerTitle": "Братец Хуан"
				},
				{
					"id": 411131405,
					"content": "Приветствую тебя, несчастный. Тебе улыбнулось счастье ответить на вопросы Принцессы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131406
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411131406,
					"content": "Есть... Так хочется есть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131407
					],
					"speakerTitle": "Гао Шестой"
				},
				{
					"id": 411131407,
					"content": "Ты в порядке? Ты, похоже, крепко проголодался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131408,
					"content": "Ай... Ай...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131409,
						411131410
					],
					"speakerTitle": "Гао Шестой"
				},
				{
					"id": 411131409,
					"content": "Чего тебе хочется? Просто назови любое блюдо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				},
				{
					"id": 411131411,
					"content": "Хочу... Домашней еды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131412
					],
					"speakerTitle": "Гао Шестой"
				},
				{
					"id": 411131412,
					"content": "А что едят дома в деревне Цинцэ? Конечно же <color=#00E1FFFF>«Сельскую усладу»</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131410,
					"content": "Я тебе что-нибудь приготовлю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				}
			]
		},
		{
			"id": 4111315,
			"completionStepIds": [
				4111315
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111315",
							"2"
						],
						"stepId": 4111315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гао Шестой"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131101,
					"content": "Ох... Я снова среди живых!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131102
					],
					"speakerTitle": "Гао Шестой"
				},
				{
					"id": 411131102,
					"content": "Пока ты спал, тебе что-нибудь снилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131103,
					"content": "Ещё как... Этот сон выжал из меня все соки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131104
					],
					"speakerTitle": "Гао Шестой"
				},
				{
					"id": 411131104,
					"content": "Правда? Что же случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131105,
						411131107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131105,
					"content": "Во сне ты был на горе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131106
					]
				},
				{
					"id": 411131106,
					"content": "Да... Откуда ты знаешь? Высоченная гора, я такой горы никогда не видел, и вся в снегу... Там было очень холодно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Гао Шестой"
				},
				{
					"id": 411131109,
					"content": "Что ты там делал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131110,
					"content": "Не знаю... В меня будто кто-то вселился. И желал я лишь одного - взобраться на вершину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131111
					],
					"speakerTitle": "Гао Шестой"
				},
				{
					"id": 411131111,
					"content": "На вершине горы было что-то хорошее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131112,
					"content": "А кто его знает... Во сне я будто был кем-то другим. Не спрашивайте меня, почему. Я сам не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131113
					],
					"speakerTitle": "Гао Шестой"
				},
				{
					"id": 411131113,
					"content": "Значит, это не ты шёл к вершине?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131114
					]
				},
				{
					"id": 411131114,
					"content": "Как бы это объяснить... Мною словно кто-то управлял, кто-то вложил в мою голову навязчивую мысль карабкаться по горе. Всё это очень странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131115
					],
					"speakerTitle": "Гао Шестой"
				},
				{
					"id": 411131115,
					"content": "В глубины твоего разума вторгся посторонний?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131116
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411131116,
					"content": "Желание, не созданное разумом спонтанно, но появившееся в подсознании... И правда похоже на одержимость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131117,
						411131118
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411131117,
					"content": "Пора бы уже мне к этому привыкнуть, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131119,
					"content": "Другими словами, все, кто говорил, что им холодно и они устали... Они тоже шли по горе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131120,
					"content": "У всех был один и тот же сон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131121
					]
				},
				{
					"id": 411131121,
					"content": "Паймон в это совсем не верится... Скорее, расскажем обо всём <color=#00E1FFFF>Моне</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131118,
					"content": "Вы говорите совершенно разные вещи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131107,
					"content": "Тебе снилось заснеженное поле?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131108
					]
				},
				{
					"id": 411131108,
					"content": "Не поле, а гора. Очень высокая, и там было очень холодно... Мне снилось, что я стою у её подножия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Гао Шестой"
				}
			]
		},
