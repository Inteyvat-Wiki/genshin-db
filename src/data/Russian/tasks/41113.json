					"Цзин Лунь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131001,
					"content": "Мы закончили с метеоритами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411131002,
					"content": "Прекрасно! Вы здорово помогли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131003
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411131003,
					"content": "Кто-нибудь уже проснулся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131004
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411131004,
					"content": "Ой, этого я не знаю... Лучше посмотрите сами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзин Лунь"
				}
			]
		},
		{
