		},
		{
			"id": 4111307,
			"completionStepIds": [
				4111307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111307",
							"2"
						],
						"stepId": 4111307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130701,
					"content": "Мона, мы тут кое-что узнали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411130702,
					"content": "Высящаяся над облаками ледяная гора... Именно оттуда пустила свои побеги тьма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130703
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411130703,
					"content": "Ледяная гора? И это всё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130704
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130704,
					"content": "Всем снилась одна и та же покрытая льдом и снегом гора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130705
					]
				},
				{
					"id": 411130705,
					"content": "Это очень высокая гора, которую никто не видел, и там очень холодно. К тому же спящих что-то заставляло идти к её вершине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411130706,
					"content": "Идти к её вершине?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130707
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130707,
					"content": "Зачем кому-то взбираться на вершину этой горы? И почему желание этого человека так сильно, что воздействует на других?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130708
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130708,
					"content": "Возможно, в снегах той горы лежат останки замученного до смерти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130709
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411130709,
					"content": "Или... какого-нибудь смельчака, пожелавшего этот пик покорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130710
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411130710,
					"content": "Я погадаю ещё раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130711
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130711,
					"content": "Есть! Я что-то вижу... Очень размыто, но я могу прочесть... Его зовут <color=#00E1FFFF>Леонард</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130712
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130712,
					"content": "Ого, так быстро!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130713
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411130713,
					"content": "Я ведь вам говорила, что у меня талант!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130714
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130714,
					"content": "Леонард... Паймон никогда этого имени не слыхала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4111308,
			"completionStepIds": [
				4111308
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111308",
							"2"
						],
						"stepId": 4111308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130715,
					"content": "Даже простейшее гадание показало бы, что этот человек был Предвестником Фатуи! Вы были в опасности! Как у вас получилось с ним столкнуться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130716
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130716,
					"content": "Что? Тот юноша - Предвестник Фатуи? Их порочность не ведает предела!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130717
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411130717,
					"content": "Предвестник? Ну и дела...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130718
					]
				},
				{
					"id": 411130718,
					"content": "Встреча ваша была неслучайной - он что-то против вас задумал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130719
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130719,
					"content": "А ещё он очень силён! Я это почувствовала сразу, как только увидела его. Он куда сильнее, чем можно представить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130720
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130720,
					"content": "И хоть мне не очень хочется этого признавать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130721
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130721,
					"content": "Неужели его сила превосходит астрологический гений госпожи Моны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130722
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411130722,
					"content": "Я такого не говорила! Он может быть капельку сильнее, но в астрологии ему до меня далеко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130723
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130723,
					"content": "Точно... Ещё мы видели какого-то Фатуи у постоялого двора «Ваншу»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130724
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411130724,
					"content": "Чем могли метеориты заинтересовать каких-то Фатуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130725
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411130725,
					"content": "Они точно что-то замышляют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130726
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130726,
					"content": "Хм, может быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130727
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130727,
					"content": "Паймон поняла! Фатуи этот метеоритный дождь и вызвали! Ведь так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130728
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411130728,
					"content": "Паймон, это должна была сказать я!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130729
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130729,
					"content": "Хе-хе, прости... Паймон просто скора на язык.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130730
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411130730,
					"content": "Разве существует сила, способная вызвать метеоритный дождь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130731
					]
				},
				{
					"id": 411130731,
					"content": "Да... Когда это они научились вырывать из неба звёзды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130732
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411130732,
					"content": "Поделись своим мнением, Озвальдо Храфнавинс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130733
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411130733,
					"content": "Я считаю, что нет ничего невозможного, госпожа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130734
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411130734,
					"content": "Они не перестанут сеять семена зла, пока могут платить за это цену... Фатуи, Принцесса помнит ваши преступления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130735
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411130735,
					"content": "А ещё я верю в чудеса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130736
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411130736,
					"content": "Ты стала достойной частью моей свиты, посланница созвездий! Чтобы ты не пострадала от вероломных нападений тьмы, я отдам приказ своему слуге защищать тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130737
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 411130737,
					"content": "То есть мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130738
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411130738,
					"content": "Нет-нет-нет, не стоит! Паймон считает, у нас отличная команда, и ничего менять не нужно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130739
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411130739,
					"content": "Что ты, Фишль, я куда сильнее, чем тебе кажется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130740
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130740,
					"content": "Никто не заслуживает доверия больше вас, госпожа. Принцесса лишь беспокоится о вашей безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130741
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 411130741,
					"content": "Правда, не нужно. Кроме того вы подвергаетесь куда большей опасности, и моя защита, напротив, может пригодиться вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130742,
						411130744
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130742,
					"content": "Мона, ты такая славная.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130743
					]
				},
				{
					"id": 411130743,
					"content": "Т-ты что это говоришь такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130746,
					"content": "Пока давайте разберёмся с новой угрозой. Астролябия говорит мне, что упал новый метеорит, и он <color=#00E1FFFF>крупнее всех остальных</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				},
				{
					"id": 411130744,
					"content": "Фишль, ты такая славная.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130745
					]
				},
				{
					"id": 411130745,
					"content": "Н-ну конечно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "Фишль"
				}
			]
		},
		{
