			"dialogs": [
				{
					"id": 741560401,
					"content": "Паймон очень волнуется! Судя по тому, что написано в записке, нам нужно ждать его здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741560402,
					"content": "Тогда подождём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "Хорошо, решать тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741560405,
					"content": "После долгого ожидания окно со скрипом открывается, и в нём появляется знакомое лицо. Бенуа внимательно осматривается по сторонам и, увидев вас, осторожно вылезает наружу.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "Бенуа, что происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741560407,
					"content": "Быстрее, быстрее! Если меня обнаружат, то мне конец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бенуа Леруа"
				},
				{
					"id": 741560403,
					"content": "У меня к нему несколько вопросов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
