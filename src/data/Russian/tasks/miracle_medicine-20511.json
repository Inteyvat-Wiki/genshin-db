			"dialogs": [
				{
					"id": 205110401,
					"content": "#Ну что, наш{F#ла}{M#ёл} ягоды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110402
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110402,
					"content": "Да. Вот они.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110403
					]
				},
				{
					"id": 205110403,
					"content": "Это точно они? Я не вижу ничего особенного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110404
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110404,
					"content": "С виду обычные ягоды, как ни посмотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110405
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110405,
					"content": "Ну да ладно. Если так написано в рецепте, значит, так мы и сделаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110406
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110406,
					"content": "Спасибо! Вот тебе за твой труд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110407
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110407,
					"content": "Возможно, мне ещё придётся потом тебя побеспокоить. Пожалуйста, не отказывай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		}
