			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Энтони"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205110101,
					"content": "Подействует ли это лекарство?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "#Путешественни{F#ца}{M#к}! Как хорошо, что ты здесь. У меня как раз возникло затруднение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110104,
					"content": "Дело вот в чём. Помнишь мою младшую сестру, Анну? Она всю жизнь болеет, и ничто не может её излечить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110105,
					"content": "Но до меня дошёл слух, что в гавани Ли Юэ живёт искусный целитель, который справится с любым недугом. Поэтому я ищу кого-нибудь, кто бы принёс мне от него рецепт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110106,
					"content": "Эти ингредиенты крайне необычны, но попробовать стоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110107,
					"content": "Дай-ка взглянуть... Ты можешь принести мне ягоды, проглоченные Дендро слаймом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110108,
					"content": "А такое вообще существует?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "Я и сам не знаю. Едят ли Дендро слаймы ягоды?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110110,
					"content": "Я рассчитываю на тебя! К тому же я видел одно место со слаймами и ягодами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110111,
					"content": "Прошу, сходи туда. Надеюсь, ты найдёшь, что нужно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110112,
					"content": "Этот целитель шарлатан.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "Ты тоже так считаешь? Но я не знаю, к кому ещё обратиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110114,
					"content": "Я знаю одно место, где есть и Слаймы, и ягоды. Пожалуйста, поищи там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110115,
					"content": "Я сначала попробую готовое снадобье сам. Нельзя, чтобы Анне сделалось ещё хуже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110116,
					"content": "Ну или я поймаю для тебя Дендро слайма.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "Э... Что? И мне потом его ягодами пичкать, что ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110118,
					"content": "Нет, умоляю, не надо! Последний раз, когда я собирал для Анны травы, Дендро слаймы гнались за мной до самого Спрингвейла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110119,
					"content": "Я знаю одно место, где есть и Слаймы, и ягоды. Пожалуйста, поищи там. Надеюсь, ты найдёшь, что нужно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205110120,
					"content": "Но... Ес-если ты ничего не найдёшь... Принеси Дендро слайма ко мне. Я... Я сделаю это. Ради Анны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		},
