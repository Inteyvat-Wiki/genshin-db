				},
				{
					"id": 760500307,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500308
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 760500308,
					"content": "Ох, такая реакция означает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760500309,
					"content": "Поздравляю, ответ правильный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760500310,
					"content": "Это... длинношеий носорог.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500311
					]
				},
				{
					"id": 760500311,
					"content": "Ух ты! Длинношеий носорог с серьёзной травмой шеи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760500312,
					"content": "Хм... Я никогда раньше не видела такого существа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500313
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760500313,
					"content": "Правильный ответ: хладнорогий олень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500314
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760500314,
					"content": "Идите сюда, куухенки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760500315,
					"content": "Гарпун с одним загнутым назад зубцом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500316
					]
				},
				{
					"id": 760500316,
					"content": "У тебя богатая фантазия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500317
					],
					"speakerTitle": "Паймон"
