			"dialogs": [
				{
					"id": 760500101,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500102
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 760500102,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500103
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 760500103,
					"content": "Сегодня здесь так оживлённо! Все куухенки танцуют вокруг Коломбины!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760500104,
					"content": "Э-э... Это не танец. Скорее похоже, что они пытаются... похоронить её заживо под толщей милоты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760500105,
					"content": "П-помоги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500106
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760500106,
					"content": "Дай мне руку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500107
					]
				},
				{
					"id": 760500107,
					"content": "Фух... Спасибо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500108
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760500108,
					"content": "Почему куухенки так себя ведут? Обычно они не настолько энергичны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760500109,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500110
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 760500110,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500111
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760500111,
					"content": "Я решила поиграть с малышами, и, похоже, они очень увлеклись...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500112
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760500112,
					"content": "Они толпились вокруг тебя после игры... как щенки, не находишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760500113,
					"content": "Может, это их способ выразить благодарность.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500114
					]
				},
				{
					"id": 760500114,
					"content": "Только на этот раз их благодарность больше походила на неожиданный снежный буран...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500115
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760500115,
					"content": "Что и говорить, но Паймон готова поспорить, что ты не упускаешь шанс их побаловать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760500116,
					"content": "Не хотите попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500117,
						760500119
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760500117,
					"content": "Чтобы они толпились вокруг нас?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500118
					]
				},
				{
					"id": 760500118,
					"content": "Хм... Это можно устроить. Тебе лишь нужно дать правильный ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760500121,
					"content": "О, конечно. Будет интересно посмотреть, что за игра так увлекла куухенки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760500122,
					"content": "Давай же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500123
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760500123,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500124
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 760500124,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 760500119,
					"content": "Сыграть в игру с куухенки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500120
					]
				},
				{
					"id": 760500120,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
