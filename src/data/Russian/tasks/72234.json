					"Кабаяма"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340201,
					"content": "#Ты вернул{F#ась}{M#ся}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340202
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340202,
					"content": "#Пока не все места {M#нашёл}{F#нашла}? Очень жаль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340203
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340203,
					"content": "Расскажу о них ещё раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340204
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340204,
					"content": "Одно из таких мест находится под Каменными вратами в самой высокой точке Теснины. Другое - открытое пространство, окружённое кораллами, возле Храма вечной ночи, а последнее - рядом с возвышающимися руинами в Сердце змея.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340205
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340205,
					"content": "Я оставил метки во всех этих местах, повесил там фонарь, чтобы освещать путь. Ты легко найдёшь их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кабаяма"
				}
			]
		},
		{
			"id": 7223403,
			"completionStepIds": [
				7223411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
