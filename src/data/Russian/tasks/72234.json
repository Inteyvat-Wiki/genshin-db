					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кабаяма"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340301,
					"content": "#Ты вернул{F#ась}{M#ся}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340302
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340302,
					"content": "#Удалось найти все места?.. Ну, возможно, они не слишком интересны для {M#такого путешественника}{F#такой путешественницы}, как ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340303,
						722340304
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340303,
					"content": "Думаю, они уникальны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				},
				{
					"id": 722340305,
					"content": "Ах, жаль, что я раньше никому о них не рассказывал. Было приятно узнать твоё мнение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340306
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340306,
					"content": "Возможно, есть много более впечатляющих мест. Здесь внизу темно, да и в плане еды особого разнообразия нет. К тому же нужно остерегаться вишапов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340307
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340307,
					"content": "Но я живу здесь так долго, что люблю здешние края, понимаешь? И я по-прежнему скучаю по тем моим местам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340308
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340308,
					"content": "#Когда-нибудь {M#чувствовал}{F#чувствовала} такое? Даже это место станет домом, если пробыть здесь достаточно долго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340309,
						722340310
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340309,
					"content": "Возможно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340311,
					"content": "Вот как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340312
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340312,
					"content": "#Спасибо, что {M#выслушал}{F#выслушала} меня. Мне нечего дать тебе, только это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340310,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340304,
					"content": "#Довольно обычные. Я {M#видел}{F#видела} и более впечатляющие достопримечательности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				}
			]
		}
	]
}