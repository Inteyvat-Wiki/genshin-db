	"talks": [
		{
			"id": 7223401,
			"completionStepIds": [
				7223402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223402",
							"2"
						],
						"stepId": 7223402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кабаяма"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "Как? Нравится здесь сидеть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340102,
					"content": "#Ох, зачем так внезапно появляться?! Я {M#испугался}{F#испугалась}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "Извини, пожалуйста! Не хотел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340104,
					"content": "Меня зовут Кабаяма. Люблю сидеть там, где сейчас ты. Здесь очень тихо, можно спокойно поразмышлять о жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340105,
					"content": "Тебе уступить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "Спасибо, не надо. Кстати, ты не из здешних мест?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340107,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "#Ты, должно быть, многое {M#повидал}{F#повидала}. Я никогда не путешествовал, хотя жил в разных местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340109,
					"content": "Ох, эти переезды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340110,
					"content": "Поскольку в юности я часто переезжал, у меня почти не было друзей. Бродя по окрестностям в одиночку, я обнаружил прекрасный вид, но не с кем было им насладиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340111,
					"content": "Знаешь что? Почему бы мне не показать тебе здешние места? Если попадёшь туда, присядь и осмотрись, а потом вернись и поделись со мной твоими впечатлениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340112,
					"content": "Одно из таких мест находится под Каменными вратами в самой высокой точке Теснины. Другое - открытое пространство, окружённое кораллами, возле Храма вечной ночи, а последнее - рядом с возвышающимися руинами в Сердце змея.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "Кабаяма"
				},
				{
					"id": 722340113,
					"content": "Я оставил метки во всех этих местах, повесил там фонарь, чтобы освещать путь. Ты легко найдёшь их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кабаяма"
				}
			]
		},
		{
			"id": 7223402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
