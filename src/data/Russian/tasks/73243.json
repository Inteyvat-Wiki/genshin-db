			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431901,
					"content": "«Результаты рассмотрения дела Зандика... дастур... причина смерти... возможное убийство...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431902,
					"content": "«Зандик... после исключения... что касается элеазара... но не хватает доказательств...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431903,
					"content": "«Записи внезапно исчезают... год неизвестен... элеазар начинает распространяться...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431904,
					"content": "«Перед исчезновением... легенда о Варуне... сосредоточенный на...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431905,
					"content": "[Текст замазан краской, ничего нельзя разобрать.]",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324320,
			"completionStepIds": [
				7324320
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
