			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432001,
					"content": "«Изучив звёздную таблицу великого мудреца Табари, я вдруг понял, что войны Архонтов, падение древних государств и всё остальное всего лишь земные проекции движения небесных тел».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432002
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732432002,
					"content": "«Вечно только звёздное небо над нами».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432003
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732432003,
					"content": "«Гм, если отбросить лирику, получается, что учёные Ртавахисты просто берут все события тысячелетней истории и смешивают их в одну кучу?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432004
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732432004,
					"content": "«Я надеюсь, вместо того, чтобы целыми днями глазеть на звёзды, вы всё-таки обратитесь к исторической точке зрения».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432005
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732432005,
					"content": "«Ты ничего не понимаешь! Это называется законом познания мира. Не зря учёных из Вахуманы прозвали буквоедами».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
