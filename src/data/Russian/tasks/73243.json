				"points": []
			},
			"dialogs": [
				{
					"id": 732432101,
					"content": "«Я прибыл сюда из чужих краёв, с каждым днём в Академии я всё больше проникаюсь величием Дендро Архонта».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432102
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732432102,
					"content": "«В Мондштадте мне приходилось рыться в десятках книг, чтобы выяснить несколько точек зрения на простейший вопрос».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432103
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732432103,
					"content": "«Но с терминалом Акаши мы можем получить правильные знания, лишь думая в определённом русле. Мне кажется, в мире нет ничего совершеннее Акаши».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
