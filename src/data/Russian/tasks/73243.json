				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430101,
					"content": "Все объявления и указы Академии полностью перенесены в Акашу. Настоящая доска объявлений предназначена только для внеурочного общения между студентами и преподавателями Академии. Если вы не имеете отношения к Академии, просьба не оставлять здесь свои сообщения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324302,
			"completionStepIds": [
				7324302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324302",
							"2"
						],
						"stepId": 7324302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430201,
					"content": "«Чтобы атмосфера в Академии стала свободнее, чтобы научное общение приносило одну радость, чтобы научные работы писались легко...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430202
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430202,
					"content": "«Мы хотим, чтобы следующим Хранителем книг стал Викрам!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430203
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430203,
					"content": "«Добро пожаловать на вечер \"Друзей братства Викрама\"! Мы станем свидетелями появления нового Хранителя книг, молодого, симпатичного и весёлого».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324303,
			"completionStepIds": [
				7324303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324303",
							"2"
						],
						"stepId": 7324303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430301,
					"content": "«Никогда не забывайте о трёх добродетелях и шести грехах Академии».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430302
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430302,
					"content": "«Наставления, остроумие, честность. Вот к чему должен стремиться каждый учёный».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430303
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430303,
					"content": "«А Рифает на протяжении многих лет следует этим трём добродетелям».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430304
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430304,
					"content": "«Добро пожаловать в книжный клуб Фраваши. Следуем пути мудрости, шагаем в ногу с будущим Хранителем книг».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324304,
			"completionStepIds": [
				7324304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324304",
							"2"
						],
						"stepId": 7324304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430401,
					"content": "«Члены книжного клуба Фраваши, я восхищаюсь вашим стремлением к добродетели».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430402
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430402,
					"content": "«Однако мне рассказали, что половина научной работы Рифаета была написана кем-то за него».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430403
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430403,
					"content": "«Вот почему он совсем не рад своим академическим успехам!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430404
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430404,
					"content": "«Объявление - это не научная работа, чтобы подкреплять его доказательствами, но всё же такие голословные нападки здесь недопустимы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430405
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430405,
					"content": "«Сообщение выше пропитано завистью!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430406
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430406,
					"content": "«Более того, мне рассказывали, что Викрам своим красноречием завоевал сердца многих девушек».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430407
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430407,
					"content": "«А эти девушки даже не знают, что он женат. Ну что, завидуешь его успеху у женского пола?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430408
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430408,
					"content": "«Запрещается выступать с необоснованными нападками на учёных Академии. Лица, фабрикующие слухи, будут переданы матрам для дальнейшего разбирательства».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324305,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
							"2"
						],
						"stepId": 7324305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430501,
					"content": "«Эта доска объявлений не входит в систему Акаша, поэтому записи на ней можно читать напрямую».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430502
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430502,
					"content": "«Просьба бдительно следить за информационной безопасностью. Также запрещается посредством доски объявлений обмениваться знаниями, не предназначенными для общественного пользования».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324306,
			"completionStepIds": [
				7324306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324306",
							"2"
						],
						"stepId": 7324306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430601,
					"content": "«Внимание! Даже за пределами Академии студенты не должны забывать о дисциплине».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430602
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430602,
					"content": "«Единое управление знаниями является краеугольным камнем существования Города мудрости. Простая неосторожность может лишить вас права обучаться в Академии. Будьте внимательны».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324307,
			"completionStepIds": [
				7324307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324307",
							"2"
						],
						"stepId": 7324307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430701,
					"content": "«В последнее время произошло несколько случаев контрабанды Капсул знаний. После окончания расследования подробные обстоятельства каждого дела будут переданы наставникам и учащимся соответствующих даршанов через Акашу до следующего Дня Джнагарбхи».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430702
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430702,
					"content": "«Также просим наставников провести профилактические беседы со студентами, чтобы предотвратить возможные преступления, вызванные чрезмерной академической нагрузкой».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324308,
			"completionStepIds": [
				7324308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324308",
							"2"
						],
						"stepId": 7324308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430801,
					"content": "«Многие говорят, что Академия слишком спешит с внедрением Акаши. А я считаю, всё как раз наоборот. Махаматы работают крайне неэффективно, в некоторых аспектах сейчас дела обстоят даже хуже, чем раньше».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430802
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430802,
					"content": "«Только представьте, что мы будем распределять работу напрямую через Акашу, и торговля на бирже будет также вестись через Акашу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430803
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430803,
					"content": "«Тогда половину махамат можно будет распустить».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430804
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430804,
					"content": "«В твоих словах есть доля истины, может быть, именно поэтому внедрение системы постоянно откладывается».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324309,
			"completionStepIds": [
				7324309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324309",
							"2"
						],
						"stepId": 7324309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430901,
					"content": "«Ведь все знают, что главной задачей учёных является поиск тайной мудрости. Но современная Академия слишком загружена административной работой».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430902
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430902,
					"content": "«Сейчас многие студенты после окончания учёбы вынуждены прекратить свои исследования и занять пост махаматы. Что это, как не предательство изначального замысла Академии?».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430903
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430903,
					"content": "«А разве в Акаше ещё нет заключения по этой проблеме?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430904
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732430904,
					"content": "«Пока народ живёт во мраке суеверий, мы одни служим источником света, наиболее близким к истине. Мы и только мы должны нести свет в этот мир. А иначе Сумеру погрузится в хаос!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324310,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431001,
					"content": "«Я прибыл сюда из чужих краёв, с каждым днём в Академии я всё больше проникаюсь величием Руккхадеваты».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431002
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431002,
					"content": "«В Мондштадте мне приходилось рыться в десятках книг, чтобы выяснить несколько точек зрения на простейший вопрос».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431003
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431003,
					"content": "«Но с терминалом Акаши нужно будет всего лишь подумать о том или ином вопросе, и мы получим всю необходимую информацию. Мне кажется, в мире нет ничего совершеннее Акаши».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324311,
			"completionStepIds": [
				7324311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324311",
							"2"
						],
						"stepId": 7324311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431101,
					"content": "«Со времён пира Кавикавуса Академия ни разу не повышала ежегодное финансирование Кшахревара».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431102
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431102,
					"content": "«Авторы сообщений выше постоянно выступают за строгий контроль над внедрением и изучением механических технологий во имя мира и стабильности. Раз такое дело, давайте и Акашу тоже отключим!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431103
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431103,
					"content": "«Если бы не долгосрочные вложения госпожи Сангема-бай и других мудрых негоциантов, Кшахревар давно бы закрылся!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324312,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
						],
						"stepId": 7324312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431201,
					"content": "«Я полностью доверяю мудрецам и наставникам, но мне кажется, что Академия стала слишком зависима от Акаши».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431202
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431202,
					"content": "«Привыкнув получать знания с помощью Акаши, бродячие исследователи, которых мы отправляем на места, потеряли всякую способность к изучению материалов. И это очевидно для всех. Я считаю, необходимо законодательно ограничить доступ к Акаше для новых студентов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431203
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431203,
					"content": "«Как ты можешь такое говорить! Разве ты не знаешь, что даршаны в пустыне, не принявшие Акашу, давно погрузились в мракобесие? Дошло до того, что тамошние учёные пытаются обрести мудрость, поедая ядовитых змей!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431204
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431204,
					"content": "«После великой властительницы Руккхадеваты именно Акаша гарантирует истинность наших знаний».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324313,
			"completionStepIds": [
				7324313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324313",
							"2"
						],
						"stepId": 7324313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431301,
					"content": "Очередная лекция лесного стража Тигнари, посвящённая ботанике, как всегда, пройдёт в Пардис Дхяй. Приглашаем всех желающих, запись обязательна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431302
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431302,
					"content": "Присутствовать на лекции могут все, кому интересна ботаника!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431303
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431303,
					"content": "В связи с большим наплывом желающих Академия допускает на лекцию только учащихся из даршана Амурта и служащих Лесного дозора. Приносим извинения за неудобства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324314,
			"completionStepIds": [
				7324314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324314",
							"2"
						],
						"stepId": 7324314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431401,
					"content": "«Кто-нибудь уже прочёл новый роман издательского дома Яэ? На этот раз автор из Сумеру! Как же его зовут... Кажется, Пурсина. Явно учёный из Амурты».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431402
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431402,
					"content": "«Эх, если бы меня тогда приняли в Амурту, я бы тоже целыми днями гулял по горам и рекам, а в свободное время писал бы романы. А в итоге я поступил в Хараватат, с утра до ночи только читаю и пишу научные работы - никаких тебе полевых исследований».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431403
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431403,
					"content": "«А? Кто-то опубликовал свой роман в издательском доме Яэ вперёд меня? Теперь не быть мне настоящим экспертом в исследовании лёгких романов...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324315,
			"completionStepIds": [
				7324315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324315",
							"2"
						],
						"stepId": 7324315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431501,
					"content": "«Настоящий бизнес ведётся совсем не так, как написано в учебниках. Надо было мне оставаться на Большом базаре и спокойно вести своё дело...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431502
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431502,
					"content": "«Теперь я и научную работу закончить не могу, и деньги все потратил».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431503
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431503,
					"content": "«Если так пойдёт дальше, брошу учёбу и присоединюсь к Пустынникам».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324316,
			"completionStepIds": [
				7324316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324316",
							"2"
						],
						"stepId": 7324316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431601,
					"content": "«Я ничего не имею против людей из пустыни. Однако я считаю, что генералом махаматрой должен стать уважаемый учёный, который при решении вопросов будет полагаться на академические принципы, а не на свои кулаки».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431602
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431602,
					"content": "«Хе-хе, а по-моему, сейчас стало намного лучше, чем когда всем заправлял ваш человек из Ртавахиста. По крайней мере, теперь не отдаётся предпочтение одному даршану в ущерб другим. Думаешь, никто не знает, откуда у вас взялся такой показатель по публикациям?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431603
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431603,
					"content": "«Эй, кшахреварец! Предъяви доказательства, иначе я пожалуюсь матре».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324317,
			"completionStepIds": [
				7324317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324317",
							"2"
						],
						"stepId": 7324317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431701,
					"content": "«Принимать чужеземных студентов на учёбу - это ещё ладно, но разрешить им пользоваться Акашей...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431702
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431702,
					"content": "«Вдруг мозг чужеземцев окажет негативное влияние на Акашу? А самое главное - эта мера неизбежно приведёт к оттоку знаний! Кто знает, как это скажется на экономике и внешней торговле Сумеру?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431703
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431703,
					"content": "«Надо же, учёных тоже волнуют вопросы, касающиеся экономики. Впервые вижу...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431704
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431704,
					"content": "«Не зря говорят, что учёные из Хараватата живут в башне из слоновой кости. Только необходимость научиться синтезировать новую краску заставила меня поступить в Академию!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324318,
			"completionStepIds": [
				7324318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324318",
							"2"
						],
						"stepId": 7324318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431801,
					"content": "«Давно я не видел нашего пустынного карлика. Похоже, можно ненадолго расслабиться».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431802
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431802,
					"content": "«Не знаю, какая муха укусила этих ребят из матры, но из-за них я не смог сдать прошлогодний экзамен».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431803
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431803,
					"content": "«Насколько я помню, отметку за тот экзамен ставили не по посещаемости, так что надо было просто нормально учиться и не сваливать вину на других. Матр в последнее время не хватает, но всё равно советую тебе получше следить за своими словами».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431804
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431804,
					"content": "«Матры - пустышки, которые корчат из себя неизвестно что. Постой, мне пришло сообщение из Акаши...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431805
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732431805,
					"content": "«Похоже, нужно всё-таки вести себя осторожнее».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7324319,
			"completionStepIds": [
				7324319
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
