			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Комаки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500101,
					"content": "Здравствуй. Судя по твоему виду, ты не с этого острова, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500102,
						721500103
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500102,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500104
					]
				},
				{
					"id": 721500104,
					"content": "#Ты, наверное, {M#путешественник}{F#путешественница}, да? Тогда... не хочешь ли остановиться здесь ненадолго и погадать на дорогу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500105
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500105,
					"content": "Э? Погадать на дорогу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500106,
						721500107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500106,
					"content": "Погадать на дорогу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500108
					]
				},
				{
					"id": 721500108,
					"content": "Ха-ха, не надо так волноваться. Прошу прощения, это было несколько внезапно с моей стороны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500109
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500109,
					"content": "Я всего лишь хотела сказать, что святилище Ватацуми в нашей деревне Боро весьма чудодейственное. Поэтому решила пригласить вас погадать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500110
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500110,
					"content": "Я не имела в виду, что вам непременно грозит опасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500111
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500111,
					"content": "Да и возможно ли выразить столь простыми словами хитросплетение судеб, что ждёт нас впереди. Хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500112
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500112,
					"content": "Так значит просто гадание... Какое облегчение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500113,
					"content": "А сколько стоит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500114
					]
				},
				{
					"id": 721500114,
					"content": "Хе-хе, ничего не стоит. Не берём деньги за такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500115
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500115,
					"content": "Если бы люди, которые следят за святилищами, брали с путешественников деньги за желания, это встревожило бы дух Омиками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500116
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500116,
					"content": "Вы ведь всего лишь смертные. Как можем мы наживаться на желаниях других людей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500117
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500117,
					"content": "А, вот оно как.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500118,
					"content": "Так что, не хотите погадать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500119
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500119,
					"content": "Можно попробовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500120
					]
				},
				{
					"id": 721500120,
					"content": "Ха-ха, спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500121
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500121,
					"content": "В такое время везде неспокойно, и деревенская молодёжь вся работает в других местах. Вид таких молодых людей, как вы, наполняет моё старое сердце радостью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500122
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500122,
					"content": "А то, что вы, чужаки, с уважением относитесь к традициям острова Ватацуми - ещё большая редкость. Это замечательно, ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500123
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500123,
					"content": "Ладно, хватит болтать. Про гадание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500124
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500124,
					"content": "Но пока мы не начали, не могли бы вы мне кое с чем помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500125
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500125,
					"content": "Э? Всё-таки деньги надо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500126,
					"content": "Хе-хе, нет... Просто послушайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500127
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500127,
					"content": "Чудодейственность святилища в деревне Боро проистекает из растущей здесь «волшебной травы пучин».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500128
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500128,
					"content": "Как понятно из названия, это растение раньше росло на дне океана. Оттуда пришли и наши предки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500129
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500129,
					"content": "Тысячи лет назад праотцы нашей деревни перенесли эту траву с морского дна на сушу и очень бережно ухаживали за ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500130
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500130,
					"content": "Под защитой поколений жителей деревни волшебная трава пережила войны, природные бедствия и даже великое горе мученической смерти нашего Омиками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500131
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500131,
					"content": "Поскольку это глубоководное растение, для жизни ему требуется постоянный приток воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500132
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500132,
					"content": "А ещё оно испускает бледное свечение, ведь обычно оно растёт в кромешной тьме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500133
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500133,
					"content": "По тому, как переливается свет, мы судим, исполнится ли желание. А секрет здесь в источнике воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500134
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500134,
					"content": "Хе-хе, молодые жрицы постоянно сомневаются в надёжности ритуала гадания. Им кажется, что народные обряды недостаточно формальные, что они распространяют предрассудки и всё такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500135
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500135,
					"content": "Им больше нравятся ясные и простые для понимания теории, а не легенды, которые постепенно обращаются в прах, пока старики передают их из уст в уста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500136
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500136,
					"content": "Но всё же... мудрость стариков, мудрость поколений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500137
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500137,
					"content": "Может быть, её и нельзя обобщить в какую-то стройную теорию, но в ней всё равно содержится истина, которой нельзя пренебрегать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500138
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500138,
					"content": "Об источнике воды...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500139
					]
				},
				{
					"id": 721500139,
					"content": "Источник воды?.. А! Хе-хе, да... Прошу прощения, с возрастом я стала болтливой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500140
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500140,
					"content": "Чтобы вырастить волшебную траву, нужно взять воду из Пруда подношений на этом острове. Ведь в этой воде содержатся «желания».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500141
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500141,
					"content": "Вода правда может содержать желания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500142
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500142,
					"content": "Хе-хе, конечно. Желания всех людей собираются в этом пруду и растворяются в воде. Прямо как мёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500143
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500143,
					"content": "Человеческим глазом этого не увидеть, но можно почувствовать по густоте и сладости воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500144
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500144,
					"content": "То же и с памятью, и с верой... Все они следуют этому принципу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500145
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500145,
					"content": "#И ещё. Если пойдёшь за водой - будь {M#осторожен}{F#осторожна}... Сила желаний быстро растворится в воздухе, как только ты отойдёшь от Пруда подношений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500146
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500146,
					"content": "Прямо как мечты исчезают в потоке лет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500147
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500147,
					"content": "Увядание желаний тоже можно определить по весу и на ощупь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500148
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500148,
					"content": "Ого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500149
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500149,
					"content": "О...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500150
					]
				},
				{
					"id": 721500150,
					"content": "Хе-хе, прошу прощения, я опять отвлеклась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500151
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500151,
					"content": "Одним словом, не задерживайтесь, когда наберёте воду, и возвращайтесь как можно скорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500152
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500152,
					"content": "Иначе сила желаний полностью выветрится, и волшебная трава не получит необходимые питательные вещества...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500153
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500153,
					"content": "Когда закончишь, напомни мне ещё раз... Понадобится ещё одно действие, чтобы напитать волшебную траву и обеспечить действенность гадания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500154
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500154,
					"content": "Столько дел! Неужели жрицы тебе не помогают?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500155
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500155,
					"content": "Эх... Молодые жрицы считают, что это очень хлопотно, воротят нос от таких древних традиций, мало кто соглашается помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500156
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500156,
					"content": "Я вижу, что свечение волшебной травы затухает с каждым днём... Но никого это не тревожит так, как меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500157
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500157,
					"content": "Ну, хлопот тут и правда по горло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500158
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500158,
					"content": "Можно понять отношение жриц...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500159
					]
				},
				{
					"id": 721500159,
					"content": "Так вы поможете мне набрать воды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500160
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500160,
					"content": "Мы поможем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500161
					]
				},
				{
					"id": 721500161,
					"content": "Ну тогда спасибо вам огромное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500107,
					"content": "Меня ждёт опасность?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500108
					]
				},
				{
					"id": 721500103,
					"content": "Здравствуй, бабуля.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500104
					]
				}
			]
		},
		{
			"id": 7215002,
			"completionStepIds": [
				7215004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215003",
							"3"
						],
						"stepId": 7215003,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215004",
							"2"
						],
						"stepId": 7215004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Комаки",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500201,
					"content": "Вы вернулись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500202
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500202,
					"content": "Мы принесли, что ты просила.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500203
					]
				},
				{
					"id": 721500203,
					"content": "Чистая вода из Пруда подношений. Свежая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500204,
					"content": "Большое вам спасибо. Я сразу же полью ей волшебную траву.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500205
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500205,
					"content": "На чём я остановилась в тот раз... Ах да, нужно ещё кое-что сделать, чтобы волшебная трава засияла ещё ярче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500206
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500206,
					"content": "Только в среде, богатой Гидро, листья волшебной травы полностью раскрываются и могут проявить весь цвет «желаний».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500207
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500207,
					"content": "Если вкратце... На севере есть пещера, вода там содержит Гидро как раз в тех же пропорциях, что естественная среда волшебной травы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500208
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500208,
					"content": "Но в разных местах пещеры концентрация тоже разная... Лучше всего подходит кристально прозрачный Гидро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500209
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500209,
					"content": "Но если он помутнеет... Например, если его потревожит какое-нибудь существо, то будет уже трудно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500210
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500210,
					"content": "Ох, в моём возрасте я уже и сама не понимаю, что говорю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500211
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500211,
					"content": "Когда увидите, то сами всё поймёте, хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500212
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500212,
					"content": "Пещера тесно связана с тайной предков нашей деревни. Но, к сожалению, из-за войны мало кто из молодёжи ходит туда, чтобы подпитать волшебную траву.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500213
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500213,
					"content": "Ох... Говоря о молодых людях... Надеюсь, что вы вернётесь в целостности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500214
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500214,
					"content": "Ах да, ребятки. Если пойдёте туда за водой, то будьте очень осторожны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500215
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500215,
					"content": "Не беспокойся, бабуля!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500216,
						721500217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500216,
					"content": "#Я буду {M#внимателен}{F#внимательна}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				},
				{
					"id": 721500218,
					"content": "Хорошо, хорошо... Спасибо вам большое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500217,
					"content": "Не волнуйтесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				}
			]
		},
		{
			"id": 7215003,
			"completionStepIds": [
				7215007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215006",
							"3"
						],
						"stepId": 7215006,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215007",
