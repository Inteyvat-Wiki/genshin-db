			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Комаки",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500301,
					"content": "А, это вы. Проходите, отдыхайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500302
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500302,
					"content": "Бабушка Комаки, мы принесли воду, о которой вы говорили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500303,
					"content": "Это ведь «идеальная вода», о которой вы говорили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500304
					]
				},
				{
					"id": 721500304,
					"content": "Да, и её как раз достаточно. Спасибо за ваши труды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500305
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500305,
					"content": "Хе-хе, посмотрите на неё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500306
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500306,
					"content": "Судя по сиянию травы... Следующий год будет мирный и богатый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500307
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500307,
					"content": "О... Как вы поняли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500308,
					"content": "Сияние волшебной травы зависит от влажности воды и питательности людских желаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500309
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500309,
					"content": "Этот свет воплощает желания. Чем прекрасней желания, тем живее свет, тем больше надежды на будущее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500310
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500310,
					"content": "Ведь каждый мечтает, чтобы завтра было лучше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500311
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500311,
					"content": "Надо только, чтобы у каждого было желание сделать что-то, чтобы улучшить свою жизнь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500312
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500312,
					"content": "По сравнению с этим меркнут все трудности войны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500313
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500313,
					"content": "Эм... А это как-то связано с её действенностью?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500314,
					"content": "Конечно. Ведь так гласит древняя мудрость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500315
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500315,
					"content": "Желания побуждают людей к действию. А результаты действий утверждают их желания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500316
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500316,
					"content": "Пока мы сохраняем мирную жизнь, пока мы защищаем свои надежды от серости дней...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500317
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500317,
					"content": "Предсказания волшебной травы всегда будут действенными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500318,
						721500319
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500318,
					"content": "Похоже на попытки как-то рационально обосновать суеверия...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				},
				{
					"id": 721500320,
					"content": "Хе-хе, молодёжь, когда-нибудь и вы поймёте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500321
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500321,
					"content": "Кстати, сила желаний в воде ещё продержится пару дней, если хотите, то можете прийти ещё погадать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500319,
					"content": "...но в этом есть логика...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				}
			]
		},
		{
			"id": 7215004,
			"completionStepIds": [
				7215001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
