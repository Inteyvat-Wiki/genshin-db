					"Комаки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500401,
					"content": "Здравствуй. Судя по твоему виду, ты не с этого острова, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500402,
						721500403
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500402,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500404
					]
				},
				{
					"id": 721500404,
					"content": "#Ты, наверное, {M#путешественник}{F#путешественница}, да? Тогда... не хочешь ли остановиться здесь ненадолго и погадать на дорогу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500405
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500405,
					"content": "Э? Погадать на дорогу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500406,
						721500407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500406,
					"content": "Погадать на дорогу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500408
					]
				},
				{
					"id": 721500408,
					"content": "Ха-ха, не надо так волноваться. Прошу прощения, это было несколько внезапно с моей стороны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500409
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500409,
					"content": "Я всего лишь хотела сказать, что святилище Ватацуми в нашей деревне Боро весьма чудодейственное. Поэтому решила пригласить вас погадать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500410
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500410,
					"content": "Я не имела в виду, что вам непременно грозит опасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500411
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500411,
					"content": "Да и возможно ли выразить столь простыми словами хитросплетение судеб, что ждёт нас впереди. Хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500412
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500412,
					"content": "Так значит просто гадание... Какое облегчение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500413,
					"content": "А сколько стоит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500414
					]
				},
				{
					"id": 721500414,
					"content": "Хе-хе, ничего не стоит. Не берём деньги за такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500415
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500415,
					"content": "Если бы люди, которые следят за святилищами, брали с путешественников деньги за желания, это встревожило бы дух Омиками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500416
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500416,
					"content": "Вы ведь всего лишь смертные. Как можем мы наживаться на желаниях других людей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500417
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500417,
					"content": "А, вот оно как.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500418,
					"content": "Так что, не хотите погадать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500419
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500419,
					"content": "Можно попробовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500420
					]
				},
				{
					"id": 721500420,
					"content": "Ха-ха, спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500421
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500421,
					"content": "В такое время везде неспокойно, и деревенская молодёжь вся работает в других местах. Вид таких молодых людей, как вы, наполняет моё старое сердце радостью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500422
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500422,
					"content": "А то, что вы, чужаки, с уважением относитесь к традициям острова Ватацуми - ещё большая редкость. Это замечательно, ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500423
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500423,
					"content": "Ладно, хватит болтать. Про гадание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500424
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500424,
					"content": "Но пока мы не начали, не могли бы вы мне кое с чем помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500425
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500425,
					"content": "Э? Всё-таки деньги надо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500426
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500426,
					"content": "Хе-хе, нет... Просто послушайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500427
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500427,
					"content": "Чудодейственность святилища в деревне Боро проистекает из растущей здесь «волшебной травы пучин».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500428
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500428,
					"content": "Как понятно из названия, это растение раньше росло на дне океана. Оттуда пришли и наши предки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500429
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500429,
					"content": "Тысячи лет назад праотцы нашей деревни перенесли эту траву с морского дна на сушу и очень бережно ухаживали за ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500430
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500430,
					"content": "Под защитой поколений жителей деревни волшебная трава пережила войны, природные бедствия и даже великое горе мученической смерти нашего Омиками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500431
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500431,
					"content": "Поскольку это глубоководное растение, для жизни ему требуется постоянный приток воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500432
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500432,
					"content": "А ещё оно испускает бледное свечение, ведь обычно оно растёт в кромешной тьме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500433
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500433,
					"content": "По тому, как переливается свет, мы судим, исполнится ли желание. А секрет здесь в источнике воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500434
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500434,
					"content": "Хе-хе, молодые жрицы постоянно сомневаются в надёжности ритуала гадания. Им кажется, что народные обряды недостаточно формальные, что они распространяют предрассудки и всё такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500435
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500435,
					"content": "Им больше нравятся ясные и простые для понимания теории, а не легенды, которые постепенно обращаются в прах, пока старики передают их из уст в уста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500436
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500436,
					"content": "Но всё же... мудрость стариков, мудрость поколений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500437
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500437,
					"content": "Может быть, её и нельзя обобщить в какую-то стройную теорию, но в ней всё равно содержится истина, которой нельзя пренебрегать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500438
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500438,
					"content": "Об источнике воды...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500439
					]
				},
				{
					"id": 721500439,
					"content": "Источник воды?.. А! Хе-хе, да... Прошу прощения, с возрастом я стала болтливой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500440
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500440,
					"content": "Чтобы вырастить волшебную траву, нужно взять воду из Пруда подношений на этом острове. Ведь в этой воде содержатся «желания».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500441
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500441,
					"content": "Вода правда может содержать желания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500442
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500442,
					"content": "Хе-хе, конечно. Желания всех людей собираются в этом пруду и растворяются в воде. Прямо как мёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500443
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500443,
					"content": "Человеческим глазом этого не увидеть, но можно почувствовать по густоте и сладости воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500444
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500444,
					"content": "То же и с памятью, и с верой... Все они следуют этому принципу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500445
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500445,
					"content": "#И ещё. Если пойдёшь за водой - будь {M#осторожен}{F#осторожна}... Сила желаний быстро растворится в воздухе, как только ты отойдёшь от Пруда подношений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500446
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500446,
					"content": "Прямо как мечты исчезают в потоке лет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500447
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500447,
					"content": "Увядание желаний тоже можно определить по весу и на ощупь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500448
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500448,
					"content": "Ого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500449
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500449,
					"content": "А...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500450
					]
				},
				{
					"id": 721500450,
					"content": "Хе-хе, прошу прощения, я опять отвлеклась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500451
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500451,
					"content": "Одним словом, не задерживайтесь, когда наберёте воду, и возвращайтесь как можно скорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500452
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500452,
					"content": "Иначе сила желаний полностью выветрится, и волшебная трава не получит необходимые питательные вещества...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500453
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500453,
					"content": "Когда закончишь, напомни мне ещё раз... Понадобится ещё одно действие, чтобы напитать волшебную траву и обеспечить действенность гадания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500454
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500454,
					"content": "Столько дел! Неужели жрицы тебе не помогают?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500455
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500455,
					"content": "Эх... Молодые жрицы считают, что это очень хлопотно, воротят нос от таких древних традиций, мало кто соглашается помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500456
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500456,
					"content": "Вы не про Цуюко, случаем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500457
					]
				},
				{
					"id": 721500457,
					"content": "О да, это молодая жрица из святилища Сангономии уж точно смотрит на стариков свысока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500458
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500458,
					"content": "О, вы с ней встречались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500459
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500459,
					"content": "Ха-ха, эта девушка... Очень способная, но разве что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500460
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500460,
					"content": "Хе-хе... Не буду говорить. Рано или поздно молодёжь всё равно научится уважать суть, которую содержат старые легенды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500461
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500461,
					"content": "Эм... Чего? Паймон не поняла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500462
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500462,
					"content": "Я вижу, что свечение волшебной травы затухает с каждым днём... Но никого это не тревожит так, как меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500463
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500463,
					"content": "Ну, хлопот тут и правда по горло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500464
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721500464,
					"content": "Можно понять отношение жриц...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500465
					]
				},
				{
					"id": 721500465,
					"content": "Так вы поможете мне набрать воды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500466
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500466,
					"content": "Мы поможем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500467
					]
				},
				{
					"id": 721500467,
					"content": "Ну тогда спасибо вам огромное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721500407,
					"content": "Меня ждёт опасность?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500408
					]
				},
				{
					"id": 721500403,
					"content": "Здравствуй, бабуля.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500404
					]
				}
			]
		},
		{
			"id": 7215005,
			"completionStepIds": [],
