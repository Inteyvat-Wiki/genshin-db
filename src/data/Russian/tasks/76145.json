				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кузьмич"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450101,
					"content": "Дела в последнее время идут скверно... Может, надо накопить денег и попробовать арендовать киоск в Нашгороде...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450113,
						761450102,
						761450115
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450113,
					"content": "Что у тебя есть хорошего?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450114
					]
				},
				{
					"id": 761450114,
					"content": "Так, разная мелочёвка из Натлана. Если что-то понравилось, берите, не стесняйтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450102,
					"content": "Кто ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450103
					]
				},
				{
					"id": 761450103,
					"content": "Ой, к нам пожаловал клиент! Привет, меня зовут Кузьмич, я странствующий негоциант из Снежной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450104
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450104,
					"content": "Ну, я так себя называю. А на самом деле просто веду мелкую торговлю, чтобы покрыть дорожные расходы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450105
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450105,
					"content": "Но когда я проезжал через Натлан, местные жители были так радушны, и я совсем потерял голову... Теперь надо распродать все эти товары, иначе даже на обратный билет денег не хватит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450106,
						761450110
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450106,
					"content": "Ты собираешься вернуться в Снежную?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450107
					]
				},
				{
					"id": 761450107,
					"content": "Да, как только продам товары, куплю билет на поезд и поеду домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450108
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450108,
					"content": "Там круглый год идёт снег, всюду лёд и стужа, из города никуда не выйти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450109
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450109,
					"content": "Но после долгой разлуки невольно начинаешь скучать по тем дням, когда можно было проспать целый день дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450110,
					"content": "Здесь явно не лучшее место для торговли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450111
					]
				},
				{
					"id": 761450111,
					"content": "Но чтобы арендовать киоск в деревне, придётся брать кредит в Банке северного королевства. А банковский филиал в Нашгороде пользуется не самой хорошей славой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450112
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450112,
					"content": "Ладно, здесь хотя бы людей много. А товар всегда найдёт своего покупателя, если кругом полно народу. Верно я говорю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450115,
					"content": "Извини, мне пора идти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450116
					]
				},
				{
					"id": 761450116,
					"content": "Эй, куда же вы! Взгляните на мои товары...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кузьмич"
				}
			]
		},
		{
			"id": 7614503,
			"completionStepIds": [
				7614503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614503",
							"2"
						],
						"stepId": 7614503,
						"stateName": "QUEST_STATE_UNFINISHED"
