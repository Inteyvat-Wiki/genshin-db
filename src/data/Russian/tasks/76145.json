				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кузьмич"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450301,
					"content": "Ох, ничего себе! Весь товар раскупили! Видать, есть у меня всё-таки коммерческая жилка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450302
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450302,
					"content": "Теперь я попрошу Светоносцев провести меня через Мрачные болота. А оттуда путь на север свободен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450303
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450303,
					"content": "Может, по дороге домой подвернётся ещё какой-нибудь товар... Что ж, прощайте, до новой встречи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кузьмич"
				}
			]
		},
		{
			"id": 7614504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614504",
							"2"
						],
						"stepId": 7614504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кузьмич"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450401,
					"content": "Какое совпадение, мы снова встретились! Не хотите что-нибудь купить? У меня снова товар залежался. Нужна ваша помощь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450407,
						761450402,
						761450409
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450407,
					"content": "Посмотрим, что у тебя тут есть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450408
					]
				},
				{
					"id": 761450408,
					"content": "Это всё местные диковинки. Не беспокойтесь, я сделаю хорошую скидку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450402,
					"content": "Зачем ты купил новый товар?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450403
					]
				},
				{
					"id": 761450403,
					"content": "Эх, как тут объяснить... Торговцу нельзя разбрасываться хорошими возможностями... А в Пирамиде мне как раз подвернулась такая возможность - продавец хотел срочно сбыть с рук партию товара по выгодной цене.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450404
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450404,
					"content": "У меня сразу глаза загорелись, и я забыл, что собирался домой. Купил всю партию. В итоге...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450405
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450405,
					"content": "Угадай, почему продавец хотел срочно сбыть товар с рук.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450406
					]
				},
				{
					"id": 761450406,
					"content": "Эх, не надо мной насмехаться. Лучше посмотрите, вдруг вам что-нибудь понравится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450409,
					"content": "Прости, мне пора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450410
					]
				},
				{
					"id": 761450410,
					"content": "Не хотите посмотреть ещё? У меня точно есть то, что вам нужно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кузьмич"
				}
			]
		},
		{
			"id": 7614506,
			"completionStepIds": [
				7614506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614506",
							"2"
						],
						"stepId": 7614506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кузьмич"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450601,
					"content": "Отлично, наконец все товары распроданы! Не зря я снизил цены и сделал ставку на оборот! Стратегия себя оправдала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450602
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450602,
					"content": "Вообще-то мне пора возвращаться в Снежную, но сейчас заработанных денег едва хватит на обратную дорогу... Я уехал из дома с пустыми карманами и не хочу возвращаться ни с чем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450603
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450603,
					"content": "Эх... Спасибо за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кузьмич"
				}
			]
		},
		{
			"id": 7614507,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614507",
							"2"
						],
						"stepId": 7614507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кузьмич"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450701,
					"content": "Ох, вот это судьба! Мы снова встретились. Ну как, хотите взглянуть на мой товар? На этот раз у меня много стоящих вещиц.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450709,
						761450702,
						761450706,
						761450711
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450709,
					"content": "Посмотрим, что у тебя есть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450710
					]
				},
				{
					"id": 761450710,
					"content": "Это всё старое снаряжение, списанное со склада Фатуи. Такого больше нигде не найдёте! Если что-то приглянулось - берите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450702,
					"content": "Ты вроде собирался вернуться в Снежную?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450703
					]
				},
				{
					"id": 761450703,
					"content": "Скажу без утайки: я из Новокитежграда, вся моя семья - шахтёры. Все упрямее домовых, и когда я сказал, что хочу уехать торговать, они были категорически против.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450704
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450704,
					"content": "Поэтому, уезжая, я пообещал, что вернусь с кучей денег... но кто бы мог подумать, что в итоге мне едва хватит моры на обратную дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450705
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450705,
					"content": "Теперь о больших деньгах можно забыть, но мне надо хоть немного заработать, чтобы было не стыдно смотреть в глаза родным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450706,
					"content": "Что ты делаешь на территории Фатуи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450707
					]
				},
				{
					"id": 761450707,
					"content": "Вы о чём это? Я законопослушный гражданин Снежной, для меня встреча с Фатуи всё равно что возвращение домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450708
					],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450708,
					"content": "Все мои товары - старое снаряжение, которое Фатуи списали со склада. Они специально попросили меня его распродать. Такого товара больше нигде не найдёшь, только у меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кузьмич"
				},
				{
					"id": 761450711,
					"content": "Нет, спасибо, я пойду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450712
					]
				},
				{
					"id": 761450712,
					"content": "Как жаль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кузьмич"
				}
			]
		},
		{
			"id": 7614509,
			"completionStepIds": [
				7614509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614509",
							"2"
						],
						"stepId": 7614509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кузьмич"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450901,
					"content": "Большое спасибо. Благодаря вам я могу вернуться домой со спокойной совестью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450902
					],
					"speakerTitle": "Кузьмич"
				},
