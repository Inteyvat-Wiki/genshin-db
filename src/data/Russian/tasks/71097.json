			"dialogs": [
				{
					"id": 710970101,
					"content": "Нашли староцветы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970102
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970102,
					"content": "Вот.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109702,
			"completionStepIds": [
				7109702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109702",
							"2"
						],
						"stepId": 7109702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Му Нин",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710970201,
					"content": "С этими тремя выходит девять. Этого должно хватить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970202
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970202,
					"content": "Вы так быстро справились с заданием зала Хуэйшань. Не зря о вас ходит столько слухов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970203
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970203,
					"content": "Проще жареной репы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710970204,
					"content": "Раз плюнуть, Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970205
					]
				},
				{
					"id": 710970205,
					"content": "Ой, да репа и жареная вкусная!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710970206,
					"content": "Тебя не переспоришь, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970207
					]
				},
				{
					"id": 710970207,
					"content": "Ха-ха... Мы все были свидетелями ваших героических подвигов в борьбе с морским чудовищем. Я полагаю, что для вас не было проблемой совершить такой подвиг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970208,
						710970209
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970208,
					"content": "Так и есть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				},
				{
					"id": 710970210,
					"content": "Вот уж не думал, что сотрудникам Департамента по делам граждан ещё и нужно искать староцветы в Разломе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970211
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970211,
					"content": "Кстати, ты говорил, что ругался с отцом и у тебя не было работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710970212,
					"content": "Как ты оказался в Департаменте по делам граждан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710970213,
					"content": "Вы же знаете, что я влез в долги? Мне некуда было идти, и я не хотел возвращаться домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970214
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970214,
					"content": "И в конце концов сборщики долгов нашли моего отца в зале Шэнлу... И я подумал, что отец бы переломал мне ноги за такие новости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970215
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970215,
					"content": "Но с твоими ногами всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710970216,
					"content": "Да... Мне стыдно об этом говорить, но отец вернул мои долги. Когда он нашёл меня, я жил на улице, словно побитая собака. Тогда он сказал мне: «Вот все твои долговые расписки. Теперь ты в долгу у меня».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970217
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970217,
					"content": "Так он заставил меня работать, чтобы я выплатил ему долг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970218
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970218,
					"content": "Так теперь ты должен своему отцу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710970219,
					"content": "Именно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970220
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970220,
					"content": "В те времена, когда я целыми днями в страхе прятался от сборщиков долгов, я и глаз не мог сомкнуть. Тогда я поклялся, что я исправлюсь, если жизнь даст мне второй шанс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970221
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970221,
					"content": "Но я не ожидал, что этот шанс даст мой отец, который всегда был недоволен моим поведением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970222
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970222,
					"content": "Он не набросился на меня, как обычно. Вместо этого мы поговорили начистоту. Как бы я хотел, чтобы мы могли поговорить об этом раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970223
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970223,
					"content": "Но даже если он и хотел поговорить, я бы не стал слушать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970224
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970224,
					"content": "Кажется, отец очень тебя любит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710970225,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970226
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970226,
					"content": "И теперь, несмотря ни на что, я должен хорошо делать свою работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970227
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970227,
					"content": "Будь то происшествие в Разломе или поиск староцветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970228
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970228,
					"content": "#Но в этот раз твою работу сделал{F#а} я.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970229
					]
				},
				{
					"id": 710970229,
					"content": "Найти человека для работы - тоже работа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970230
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970230,
					"content": "Но дело так быстро сделано исключительно благодаря вам. Я даже не ожидал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970231
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710970231,
					"content": "Хм, Паймон наконец-то почувствовала нотку благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710970209,
					"content": "Ну, были некоторые трудности...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				}
			]
		}
	]
}