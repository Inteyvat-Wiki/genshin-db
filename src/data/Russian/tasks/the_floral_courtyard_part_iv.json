				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "Я останусь здесь и буду направлять тех, кто придёт на праздник Иродори, чтобы они могли насладиться красотой «Подворья цветов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870202,
					"content": "Не забывайте возвращаться ежедневно, чтобы получать новые загадки. Всего их будет четыре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870203,
					"content": "Конечно же, если у вас есть другие вопросы, я с удовольствием на них отвечу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870204,
					"content": "Об этих цветах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "Цветы, которые я использую, предоставлены цветочницей Сакуей. Её цветы отличаются безупречным качеством и доступными ценами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870206,
					"content": "Возможно, вы уже встречались с Сакуей. Мы изучали искусство икебаны у одного мастера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870207,
					"content": "Сакуя очень хорошо разбирается в цветочном искусстве, но когда она услышала, что на празднике Иродори будет много людей, она, похоже, немного испугалась. Она сказала, что в такой обстановке ей будет трудно успокоиться и сосредоточиться на своей работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870208,
					"content": "Поэтому я рекламирую её работу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870209,
					"content": "Мы тоже можем помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726870219,
					"content": "У вас есть другие вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870220,
					"content": "Спасибо, госпожа Фусидзомэ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "Не за что. Можете обратиться ко мне в любое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870210,
					"content": "О комиссии Ясиро...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "Комиссия Ясиро всегда поддерживала цветочное искусство Инадзумы. Сама Сирасаги Химэгими спонсировала это событие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870212,
					"content": "С самого юного возраста она была весьма талантлива. Однажды я видела её икебану, и мне даже посчастливилось поделиться с ней своими впечатлениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870213,
					"content": "Пусть я и старше её, она превосходит меня в вопросах икебаны и понимания цветочного искусства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870214,
					"content": "Если обстоятельства позволяли, она ежегодно выделяла деньги на популяризацию икебаны. Говорят, что она даже использовала для этого свои сбережения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870215,
					"content": "Однажды она выразила своё искреннее желание, чтобы как можно больше людей понимали икебану и проявляли к ней больший интерес, чтобы больше людей захотело практиковать это искусство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870216,
					"content": "Цветочное искусство Инадзумы многим обязано Аяке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726870217,
					"content": "Надеюсь, её мечта сбудется.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "Благодарю вас обоих. Вы очень добры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726870222,
					"content": "У меня больше нет вопросов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "Хорошо. Можете обратиться ко мне в любое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фусидзомэ"
				}
			]
		}
	]
}