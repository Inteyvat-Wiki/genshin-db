			},
			"dialogs": [
				{
					"id": 726900101,
					"content": "Этот день наконец настал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900102
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726900102,
					"content": "Вы уже поняли суть композиции «Подворья цветов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900103
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726900103,
					"content": "Теперь настало время настоящей проверки вашего мастерства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900104
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726900104,
					"content": "Постой, а разве мы её ещё не прошли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726900105,
					"content": "Настоящая проверка... Значит, это будет самая сложная загадка? Ох, Паймон начинает переживать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726900106,
					"content": "Мы не так уж долго занимались икебаной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900107
					]
				},
				{
					"id": 726900107,
					"content": "Да, мастерство в цветочном искусстве достигается благодаря многолетней практике. Однако составление «Подворья цветов» больше зависит от внимательности и вдохновения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900108
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726900108,
					"content": "А в последнем вы проявили большой талант. Не думаю, что вам нужны дополнительные тренировки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900109
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726900109,
					"content": "Возможно, ваш богатый опыт путешествий дал вам такое видение прекрасного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900110
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726900110,
					"content": "Разве...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726900111,
					"content": "#Кстати, {NICKNAME}, мы и правда много где были и много что видели. Только подумать, что это дало нам столько вдохновения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726900112,
					"content": "Паймон интересно, сколько вдохновения ушло на обучение этому искусству?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900113,
						726900114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726900113,
					"content": "Не волнуйся, наше путешествие продолжится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				},
				{
					"id": 726900115,
					"content": "#Ох, ты прав{F#а}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726900116,
					"content": "Большое спасибо, госпожа Фусидзомэ! Если бы не вы, мы бы никогда не обнаружили наш скрытый талант!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726900117,
					"content": "Ха-ха, не стоит, ты слишком добра. Что ж, давайте завершим это путешествие самым прекрасным «Подворьем цветов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900118,
						726900122
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726900118,
					"content": "#Я готов{F#а} к загадке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900119
					]
				},
				{
					"id": 726900119,
					"content": "Сегодняшняя загадка цветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900120
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726900120,
					"content": "«Ветви, изогнутые, как радуги, окрашены в мириады цветов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900121
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726900121,
					"content": "Не могу дождаться, чтобы увидеть вашу лучшую работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726900122,
					"content": "#Я пока занят{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900123
					]
				},
				{
					"id": 726900123,
					"content": "Ничего страшного. Всё же для икебаны требуется сосредоточенность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900124
					],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726900124,
					"content": "Когда вы освободитесь, уверена, «Подворье цветов» поможет вам обрести покой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фусидзомэ"
				},
				{
					"id": 726900114,
					"content": "Вдохновение неисчерпаемо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				}
			]
		},
		{
			"id": 7269003,
