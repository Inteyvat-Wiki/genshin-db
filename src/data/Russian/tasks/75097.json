			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970201,
					"content": "...Да, здесь явно что-то не так. Ты по-прежнему не можешь получить силу элементов от статуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970202,
					"content": "Да что с ней не так?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970203,
						750970206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970203,
					"content": "Может, ей нужен ремонт? Статуя как-никак старая.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970204
					]
				},
				{
					"id": 750970204,
					"content": "Но она же светится, когда ты к ней прикасаешься!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970205,
					"content": "Эй! Статуя семи Архонтов... Ты исправно выполняешь свою работу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970208,
					"content": "Паймон не имеет ни малейшего понятия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970206,
					"content": "Наверное, это потому, что Натлан особенный...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970207
					]
				},
				{
					"id": 750970207,
					"content": "Кстати об этом. Может, всё дело в том, что Натлан постоянно подвержен влиянию Бездны?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7509703,
