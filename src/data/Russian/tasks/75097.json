			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970101,
					"content": "Хм? Паймон кажется или статуи семи Архонтов в Натлане какие-то не такие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970102,
					"content": "Разве реакция статуи не должна быть более... интенсивной при первом прикосновении? Например, жужжание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970103,
						750970105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970103,
					"content": "На мой взгляд всё в порядке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970104
					]
				},
				{
					"id": 750970104,
					"content": "С ней точно что-то не так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970108,
					"content": "#Хм, как бы это сказать... Паймон чувствовала, что раньше, когда ты {F#прикасалась}{M#прикасался} к статуям, связь была сильнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970109,
					"content": "На этот раз это больше похоже на выключатель - статуя загорается, только когда ты к ней прикасаешься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970110,
					"content": "#Точно! Раньше, когда ты {F#прикасалась}{M#прикасался} к статуям, ты чувствовал{F#а} силу элементов. Но в этот раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970111,
					"content": "Ты чувствуешь силу Пиро? Энергичную и горячую?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970112,
						750970113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970112,
					"content": "(Вы прислушиваетесь к ощущениям в теле...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970114,
					"content": "Хм... Что, совсем ничего?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970115,
					"content": "Всё-таки это довольно странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970113,
					"content": "(Нет ожидаемого обжигающего ощущения...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970105,
					"content": "#Вообще-то раньше это я жужжал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970106
					]
				},
				{
					"id": 750970106,
					"content": "#О! Значит, в этот раз ты забыл{F#а} пожужжать? В следующий раз будь внимательнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750970107,
					"content": "Тебе следует добавлять собственные звуковые эффекты каждый раз, когда ты прикасаешься к статуе семи Архонтов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7509702,
			"completionStepIds": [
				7509706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
