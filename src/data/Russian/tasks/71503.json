			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хуссени",
					"Хао",
					"Ту"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715030101,
					"content": "#Ты здесь, отлично. {NICKNAME}, мы обсуждаем доставку шипа Пурсины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030102
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030102,
					"content": "Оказывается, ситуация намного серьёзнее, чем мы думали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030103
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030103,
					"content": "Кхе-кхе, не пойдёт, тут слишком много чёрной грязи, к тому же она привлекает монстров, пронести прибор так просто не получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030104
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 715030104,
					"content": "Нам туда не пробраться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030105
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 715030105,
					"content": "Да мы даже до штольни не добрались. Давай, помоги мне, попробуем ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030106
					],
					"speakerTitle": "Ту"
				},
				{
					"id": 715030106,
					"content": "Если не получится, то выйдем и поищем помощников!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030107
					],
					"speakerTitle": "Ту"
				},
				{
					"id": 715030107,
					"content": "Да тут же просто перетащить что-то надо. Я суперзвезда шахты. Могу одной лопатой раскопать целую гору. Что мне сделают какие-то монстры Разлома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030108
					],
					"speakerTitle": "Ту"
				},
				{
					"id": 715030108,
					"content": "Хватит хвастаться, у тебя вон всё лицо покраснело от кашля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030109
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 715030109,
					"content": "Ерунда всё это, кхе-кхе, кхе-кхе-кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030110
					],
					"speakerTitle": "Ту"
				},
				{
					"id": 715030110,
					"content": "Дальше нам не пройти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030111
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030111,
					"content": "Чрезмерный контакт с чёрной грязью может привести к серьёзным последствиям, и монстров здесь много, это слишком опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030112
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030112,
					"content": "Но мы всё видели! В шахте, где стоял прибор, стало чисто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030113
					],
					"speakerTitle": "Ту"
				},
				{
					"id": 715030113,
					"content": "Если бы, кхе-кхе, проблему с чёрной грязью в штольне можно было бы решить раньше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030114
					],
					"speakerTitle": "Ту"
				},
				{
					"id": 715030114,
					"content": "Сейчас не нужно спешить. Идёт ли речь о решении проблемы или о проведении экспериментов, без подготовки и завершения испытаний поспешные действия могут быть опасны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030115
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030115,
					"content": "«Человеческая жизнь имеет решающее значение» - это одно из основополагающих правил руководства по эксплуатации лабораторий Академии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030116
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030116,
					"content": "Как учёный Академии я не могу пренебрегать этим правилом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030117
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030117,
					"content": "Ох, но если мы остановимся... Что же делать со всей этой чёрной грязью?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030118
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 715030118,
					"content": "Если чёрная грязь приманит ещё больше монстров... Тогда всем нам, кхе-кхе, отсюда не выбраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030119
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 715030119,
					"content": "Нужно подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030120
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030120,
					"content": "Так действительно не пойдёт. Для начала активируем шип здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030121
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030121,
					"content": "Здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030122
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 715030122,
					"content": "Да, я на глаз прикинул скорость выхода чёрной грязи. Скорость выше, чем вчера в шахте, но всё же это не основная зона, а значит очистка будет проходить быстрее, чем грязь появляется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030123
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030123,
					"content": "Монстров Разлома притягивает чёрная грязь. Возможно, она также оказывает на них определённое влияние.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030124
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030124,
					"content": "#Активировав здесь шип, мы сократим область влияния чёрной грязи. Заодно, {NICKNAME}, это и тебе поможет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030125
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030125,
					"content": "Если мы уберём чёрную грязь, то монстры не будут здесь собираться. Тогда мы сможем продвинуться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030126
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030126,
					"content": "Можно попробовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030127
					]
				},
				{
					"id": 715030127,
					"content": "Вам двоим пока лучше вернуться в лагерь, позже вам будет чем заняться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030128
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030128,
					"content": "Мне не нужен отдых, это всего лишь пустяки... Кхе-кхе, не время суперзвезде шахты прохлаждаться! Я могу помочь с монстрами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030129
					],
					"speakerTitle": "Ту"
				},
				{
					"id": 715030129,
					"content": "Хватит строить из себя крутого. Уж я-то тебя прекрасно знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030130
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 715030130,
					"content": "#Это ведь {NICKNAME}. Если {NICKNAME} берётся за дело, то нам беспокоиться не о чем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030131
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 715030131,
					"content": "#{NICKNAME}, ты, значит, займёшься очисткой местности от чёрной грязи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030132,
						715030133
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 715030132,
					"content": "Ага.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030134
					]
				},
				{
					"id": 715030134,
					"content": "#Кстати, {NICKNAME}, чёрной грязи здесь куда больше, чем я предполагал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030135
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030135,
					"content": "А ещё там, где есть чёрная грязь, особенно много монстров, осторожно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030136
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030136,
					"content": "Я не буду лезть на рожон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030137
					]
				},
				{
					"id": 715030137,
					"content": "Я говорю не о тебе, а о безопасности шипа Пурсины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030138
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030138,
					"content": "Не сомневаюсь в твоей силе, но шип Пурсины - это высокоточный и очень хрупкий прибор...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030139
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030139,
					"content": "Ни в коем случае нельзя повредить шип.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715030133,
					"content": "Я всё сделаю, не беспокойтесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030134
					]
				}
			]
		}
	]
}