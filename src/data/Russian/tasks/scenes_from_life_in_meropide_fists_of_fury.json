			"dialogs": [
				{
					"id": 740318101,
					"content": "#Я пацифист{F#ка} и не люблю сражений.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740318102
					]
				},
				{
					"id": 740318102,
					"content": "#Пацифист{F#ка} - в смысле сражаешься за мир во всём мире? Ну, каждому своё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740318103
					],
					"speakerTitle": "Низами"
				},
				{
					"id": 740318103,
					"content": "#Но это же не война, просто тренировка. Тренировка ради борьбы за мир! Раз уж ты пацифист{F#ка}, то мы и подавно должны помериться силами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740318104
					],
					"speakerTitle": "Низами"
				},
				{
					"id": 740318104,
					"content": "Логично. Давай потренируемся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740318105
					]
				},
				{
					"id": 740318105,
					"content": "Ха! Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740318106
					],
					"speakerTitle": "Низами"
