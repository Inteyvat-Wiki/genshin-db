			"dialogs": [
				{
					"id": 740310301,
					"content": "Ха-ха, вот это весело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310302
					],
					"speakerTitle": "Низами"
				},
				{
					"id": 740310302,
					"content": "Я знал, что не ошибся. Ты и правда отличный противник!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310303,
						740310305
					],
					"speakerTitle": "Низами"
				},
				{
					"id": 740310303,
					"content": "Ты тоже неплох.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740310304
					]
				},
				{
					"id": 740310304,
					"content": "Ха-ха, похоже, мне всё ещё нужно много тренироваться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310307
					],
					"speakerTitle": "Низами"
				},
				{
					"id": 740310307,
					"content": "Как и ты, я честный человек. Мы договаривались о купонах, держи. Если найдёшь время, можем сразиться ещё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Низами"
				},
				{
					"id": 740310305,
					"content": "Тебе ещё нужно поучиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740310306
					]
				},
				{
					"id": 740310306,
					"content": "Кхм, а ты не церемонишься, отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310307
					],
					"speakerTitle": "Низами"
				}
			]
