				"points": []
			},
			"dialogs": [
				{
					"id": 710703001,
					"content": "#А? Ой, привет. А я думал ты уже {M#ушёл}{F#ушла}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710703002
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710703002,
					"content": "Энергетические показатели здесь заметно стабилизировались. Всё благодаря тебе. Когда я вернусь, обязательно упомяну тебя в своей работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710703003
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710703003,
					"content": "Но как формальный наниматель отряда георазведки я ещё надолго останусь наблюдать за ситуацией здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710703004
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710703004,
					"content": "Мне пора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710703005
					]
				},
				{
					"id": 710703005,
					"content": "Не буду тогда задерживать. Но мы всегда рады тебя видеть в отряде!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хедив"
				}
			]
		}
