			"dialogs": [
				{
					"id": 710701901,
					"content": "Извини... У меня голова немного кружится, но это ничего! Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701902,
						710701907
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710701902,
					"content": "Что ты тут делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701903
					]
				},
				{
					"id": 710701903,
					"content": "Я ведь бард старой закалки, так что здесь я ищу вдохновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701904
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710701904,
					"content": "Ну, ты только что выглядел очень даже ничего, а сейчас кажется, что ты при смерти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701905
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710701905,
					"content": "Я никогда раньше не спускался в шахты... И в спешке я потянул мышцы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701906
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710701906,
					"content": "Ой, как больно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710701907,
					"content": "Не буду беспокоить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701908
					]
				},
				{
					"id": 710701908,
					"content": "Ох, это масло совершенно не помогает... Что ж, ещё увидимся. Приходи, когда будет, что рассказать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Талиесин"
				}
			]
		},
