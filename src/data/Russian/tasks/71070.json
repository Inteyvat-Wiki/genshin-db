			},
			"dialogs": [
				{
					"id": 710702801,
					"content": "#Ха-ха, ты {M#вернулся}{F#вернулась}. Присаживайся, отдохни. Чувствуй себя как дома!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702802,
						710702803
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710702802,
					"content": "Это место сложно назвать домом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				},
				{
					"id": 710702804,
					"content": "Ха-ха-ха! А у тебя острый язык!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702805
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710702805,
					"content": "Благодаря вашей помощи атмосфера в лагере стала более непринуждённой. Приношу извинения, если я показалась вам слишком строгой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702806
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710702806,
					"content": "Всё важное сделано, теперь нужно приниматься за долгосрочную работу... Создание постоянного наблюдательного пункта под землёй, чтобы следить за любыми изменениями ситуации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702807
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710702807,
					"content": "Через некоторое время можно будет открыть часть шахт, но спускаться глубже пока нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702808
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710702808,
					"content": "Мы должны перекрыть эту область и не пускать сюда шахтёров... Нет, никого сюда не пускать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710702803,
					"content": "Так значит я - пещерный житель?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				}
			]
		},
