	"talks": [
		{
			"id": 7107001,
			"completionStepIds": [
				7107001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107001",
							"2"
						],
						"stepId": 7107001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзинь У",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710700101,
					"content": "А вот и вы. Благодаря вам путь свободен. И Чжи Цюн тоже нам много помогла. Большое вам спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700102,
						710700113,
						710700122
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700102,
					"content": "О лагере...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700103
					]
				},
				{
					"id": 710700103,
					"content": "Неплохо, да? Моя работа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700104
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700104,
					"content": "Меня всему научил мой отец, когда мне было десять лет... Как ставить лагерь, как изготовлять кристальные лампы и как обращаться с горным оборудованием...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700105
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700105,
					"content": "Шли годы обучения, отец старел... А когда его глаза перестали видеть, мне пришлось отвечать за безопасность оборудования в шахтах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700106
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700106,
					"content": "И потом тоже. Ты же видишь, что лет мне уже немало. О жизни и рассказать-то нечего. У меня был мужчина, а потом его не стало. Была дочь, но она уехала учиться в Сумеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700107
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700107,
					"content": "Порой, когда мужчины из шахт рано покидают нас и оставляют детей, я забочусь о них... Всегда ношу с собой сладости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700108
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700108,
					"content": "И вот почему для меня дети всегда пахнут конфетами. Смотрят на меня с надеждой, что я угощу их вкусненьким или подарю красивые камушки для игр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700109
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700109,
					"content": "Ух ты! Цзинь У, а сейчас у тебя есть конфетки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710700110,
					"content": "Конфетки? Ну, не такие пёстрые, как в городе, но ты же не будешь привередничать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700111
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700111,
					"content": "Так вот ты о каких конфетах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710700112,
					"content": "Люди приходят и уходят, оставляя мне лишь воспоминания. И, конечно, вы, искатели приключений, что спускаются в шахты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700113,
					"content": "Расскажи о Чжи Цюн...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700114
					]
				},
				{
					"id": 710700114,
					"content": "Чжи Цюн была из последнего поколения Шахтёров. Она родилась в деревне Миньюнь. Вообще-то, все шахтёры в Разломе из деревни Миньюнь... Просто Чжи Цюн появилась на свет не в то время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700115
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700115,
					"content": "Ах, не поймите меня неправильно, я не говорю, что сейчас трудные времена. Я просто говорю, что рудные жилы в Миньюнь иссякли давным-давно, так что работы там уже прекратились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700116
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700116,
					"content": "А когда Чжи Цюн оказалась в Разломе, случилось происшествие... Этому ребёнку не суждено быть шахтёром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700117
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700117,
					"content": "Уф...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700118
					]
				},
				{
					"id": 710700118,
					"content": "А потом каждый пошёл своей дорогой. Я осталась в шахтах, ведь кто-то должен следить за оборудованием. Она же выбрала путь искателя приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700119
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700119,
					"content": "Но она ни капельки не повзрослела. Совсем себя не бережёт. Наверное, из-за того, что слишком мало времени провела в шахтах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700120
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700120,
					"content": "Я почти уверена, что, если бы она привыкла к жизни в шахтах, если бы она спасла кого-нибудь, она бы ценила жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700121
					],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700121,
					"content": "Мне неловко просить тебя, но я надеюсь, что ты присмотришь за ней. Мне бы не хотелось, чтобы она погибла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзинь У"
				},
				{
					"id": 710700122,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700123
					]
				},
				{
					"id": 710700123,
					"content": "Береги себя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзинь У"
				}
			]
		},
		{
			"id": 7107017,
			"completionStepIds": [
				7107002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107002",
							"2"
						],
						"stepId": 7107002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Клитофо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "Привет! Как проходит путешествие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "Клитофо"
				},
				{
					"id": 710701702,
					"content": "Неплохо, а как у тебя дела?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "Спасибо за ту возможность. После того, как наша попытка создать детонатор увенчалась успехом, все хотели, чтобы я остался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "Клитофо"
				},
				{
					"id": 710701704,
					"content": "Что я буду делать на поверхности... Ха, да я ещё и не знаю! Возможно, стану Похитителем сокровищ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "Клитофо"
				},
				{
					"id": 710701705,
					"content": "Возможно?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "Да нет, конечно же! Я к Похитителям сокровищ ни ногой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "Клитофо"
				},
				{
					"id": 710701708,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "Береги себя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Клитофо"
				},
				{
					"id": 710701706,
					"content": "Правда?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				}
			]
		},
		{
			"id": 7107018,
			"completionStepIds": [
				7107003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107003",
							"2"
						],
						"stepId": 7107003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хедив"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701801,
					"content": "#Это же... Ох, привет. Ты мне помешал{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701802
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710701802,
					"content": "Теперь мы квиты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701804
					]
				},
				{
					"id": 710701804,
					"content": "Ладно, ладно, давайте к делу. Всё плохо. Очень плохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701805
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710701805,
					"content": "Тебе уже попадался фрагмент сияющего кристалла, да? Если моя догадка верна, то на глубине должен быть ещё один побольше... Но ты и без меня это уже знаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701806
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710701806,
					"content": "Теоретически, наши показания должны были стабилизироваться, как только этот фрагмент вернулся в исходное положение. Так и произошло... Но форма сигнала неправильная... всё неправильно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701807,
						710701808
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710701807,
					"content": "Что всё это значит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				},
				{
					"id": 710701809,
					"content": "#Занятия прогуливал{F#а}, да? Ну ладно, по-простому, у нас здесь сталкивается две огромные силы, словно жернова на бобовой мельнице, понимаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701810
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710701810,
					"content": "Хотя и в большем масштабе времени, в настоящее время нас раздавливают эти две силы - одна сверху, а другая снизу - и скоро мы превратимся в бобовую пасту!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701811
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710701811,
					"content": "Если не веришь мне, то подожди немного и всё увидишь собственными глазами. Та искательница приключений Чжи Цюн... Я видел, что случается с теми, кто подходит слишком близко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701812
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710701812,
					"content": "Сегодня она кашляет кровью, а завтра выкашляет свои лёгкие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701813
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710701813,
					"content": "Я могу помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701814
					]
				},
				{
					"id": 710701814,
					"content": "Ты? Дай-ка подумать... Должен же быть какой-то способ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701815
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710701815,
					"content": "Но сейчас важно, чтобы вы продолжили исследования, пока не выясните, что там произошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701816
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710701816,
					"content": "Не беспокойтесь, я не стану сидеть сложа руки. Мне нужно обеспечить безопасность отряда георазведки, иначе мои деньги пропадут впустую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701817
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710701817,
					"content": "Ты и мою безопасность обеспечишь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701818
					]
				},
				{
					"id": 710701818,
					"content": "#Ну... должен признать, что твои способности превосходят все ожидания. Поэтому ты сам{F#а} можешь обеспечить свою безопасность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701819
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710701819,
					"content": "Ох, что я такое несу... Если с тобой что-то случится, то я обязательно всё возмещу, годится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710701808,
					"content": "Объясни человеческим языком, пожалуйста.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				}
			]
		},
