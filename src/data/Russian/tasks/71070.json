					"Клитофо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710702901,
					"content": "#О, ты {F#пришла}{M#пришёл}! Добро пожаловать в команду взрывников и снабженцев напитками отряда георазведки Разлома!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702902
					],
					"speakerTitle": "Клитофо"
				},
				{
					"id": 710702902,
					"content": "Команда состоит из меня одного. Клитофо к твоим услугам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702903
					],
					"speakerTitle": "Клитофо"
				},
				{
					"id": 710702903,
					"content": "#Ха-ха, этот стакан за мой счёт! Я безмерно благодарен тебе за всё, что ты для нас сделал{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702904,
						710702905
					],
					"speakerTitle": "Клитофо"
				},
				{
					"id": 710702904,
					"content": "Что ты будешь делать дальше?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				},
				{
					"id": 710702906,
					"content": "Теперь я официально являюсь частью отряда георазведки, поэтому должен находиться здесь вместе со всеми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702907
					],
					"speakerTitle": "Клитофо"
				},
				{
					"id": 710702907,
					"content": "Хм... если бы только Хедив и Цзинь У помогли мне подать заявку на большее количество помощников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702908
					],
					"speakerTitle": "Клитофо"
				},
				{
					"id": 710702908,
					"content": "Боюсь, что к тому времени я уже не буду главой команды взрывников и её единственным членом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Клитофо"
				},
				{
					"id": 710702905,
					"content": "Ты останешься здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				}
			]
		},
