			"dialogs": [
				{
					"id": 761260101,
					"content": "Ягода? И... господин Сомпайнко, чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260102
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761260102,
					"content": "Я... ну... это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260103
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260103,
					"content": "Он хочет посетить поселение Детей Морозной Луны, но стесняется, поэтому просит тебя помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260104
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761260104,
					"content": "Да! Да, именно так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260105
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260105,
					"content": "Здравствуйте, госпожа Люликки! Рад вас видеть. Э-э-э... Это образец окаменелости из Натлана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260106
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260106,
					"content": "Спасибо, господин Сомпайнко. Мы давно знакомы, не нужно церемоний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260107
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761260107,
					"content": "А? Как вы заметили меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260108
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260108,
					"content": "Когда я раздавала еду, вы рядом ходили, наблюдали. Кружили вокруг, но не вставали в очередь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260109
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761260109,
					"content": "Я подумала, что вы тоже хотите взять, но стесняетесь, поэтому оставила специально для вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260110
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761260110,
					"content": "Но вы никогда ничего не брали. Если бы вы сегодня не пришли, мне пришлось бы кого-то просить уточнить, нужна ли вам помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260111
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761260111,
					"content": "Э... э... простите, я не знал, как можно обратиться к вам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260112
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260112,
					"content": "Так что, госпожа Люликки? Могу я заглянуть к Детям Морозной Луны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260113
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260113,
					"content": "Конечно. У нас и так есть несколько гостей из других мест. Но зачем вам это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260114
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761260114,
					"content": "Я хотел бы сделать несколько фотографий и заметок, просмотреть некоторые записи и, если возможно... расспросить кого-нибудь о местных легендах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260115
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260115,
					"content": "Я из Ассоциации реликвий заврианов в Натлане. Если смогу собрать что-нибудь по своей теме, это будет просто идеально!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260116
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260116,
					"content": "О... То есть вы хотите почитать архивы? Хмм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260117
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 761260117,
					"content": "Раз вы так хорошо общаетесь, то считаю поручение выполненным. Мне нужно доложить боссу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260118
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761260118,
					"content": "Спасибо, госпожа Ягода! Это... я оплачу ваши услуги, нельзя же, чтобы вы зря пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260119
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260119,
					"content": "Пожалуйста, обязательно передайте мою благодарность боссу Нефер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260120
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260120,
					"content": "Хорошо, тогда я пойду. Приятного вам общения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ягода"
				}
			]
		},
