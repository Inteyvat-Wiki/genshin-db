							9492.938
						],
						"pointId": 14110
					}
				]
			},
			"dialogs": [
				{
					"id": 761260201,
					"content": "А... Ягода? Как ты здесь оказалась? Эм... босс Нефер сейчас свободна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260202
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260202,
					"content": "(Так и знала, что он пришёл к боссу Неф... Хм-хм, я сама с ним справлюсь.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260203
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761260203,
					"content": "Всё в порядке. Босс попросила меня помочь тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260204
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761260204,
					"content": "А? Ч-что вы говорите, неужели босс Нефер?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260205
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260205,
					"content": "Ты ведь хотел навестить поселение Детей Морозной Луны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260206
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761260206,
					"content": "Ты хочешь сперва подружиться с Люликки, чтобы она помогла тебе попасть в поселение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260207
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761260207,
					"content": "А?! Босс Нефер знает об этом? Я ведь держал всё в тайне, почти никому не говорил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260208
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260208,
					"content": "(Сейчас самое время сказать ту крутую фразу! Как там босс Неф говорит... Хм... А!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260209
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761260209,
					"content": "Кхе-кхе...Господин Сомпайнко, когда хранишь секрет, нужно уметь скрывать даже сам факт того, что хранишь секрет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260210
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761260210,
					"content": "Иначе стена, что вы построили в голове, рано или поздно даст трещину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260211
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761260211,
					"content": "Эх, я никогда не умел скрывать свои мысли, даже когда жил в родном городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260212
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260212,
					"content": "(Получилось! Недаром я так долго тренировалась, хе-хе!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260213
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761260213,
					"content": "Ладно, раз вы всё знаете, не могли бы вы помочь меня представить? Я ведь чужак, просто так к Люликки не подойти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260214
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260214,
					"content": "Не волнуйся, Люликки очень добрая. Она тепло примет любого гостя, даже если он не человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260215
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761260215,
					"content": "Правда? Серьёзно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260216
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260216,
					"content": "Но всё равно будет лучше, чтобы вы меня представили... Эм, если вы знакомы с ней...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260217
					],
					"speakerTitle": "Сомпайнко"
				},
				{
					"id": 761260217,
					"content": "Конечно! Они как раз закончили раздавать еду. Пойдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260218
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761260218,
					"content": "А... босс сказала, что в этот раз плата не потребуется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260219
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761260219,
					"content": "Спасибо вам! Я сейчас же соберу вещи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сомпайнко"
				}
			]
		}
	]
}