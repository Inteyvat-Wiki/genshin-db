			"dialogs": [
				{
					"id": 756710101,
					"content": "Чирик! Чирик-чирик! Чирик-чирик!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710102
					],
					"speakerTitle": "Басима Пятая"
				},
				{
					"id": 756710102,
					"content": "Что... происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710103,
						756710104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756710103,
					"content": "Ты посылаешь... секретное сообщение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				},
				{
					"id": 756710105,
					"content": "Да! Это техника общения с милыми зябликами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710106
					],
					"speakerTitle": "Басима Пятая"
				},
				{
					"id": 756710106,
					"content": "Ох, я забыла поздороваться с вами и сказать вступительные слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710107
					],
					"speakerTitle": "Басима Пятая"
				},
				{
					"id": 756710107,
					"content": "Приветствую вас, добрые путники! Я Басима Пятая, учёная из Амурты, восходящая звезда торговли и эксперт по очаровательным животным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710108
					],
					"speakerTitle": "Басима Пятая"
				},
				{
					"id": 756710108,
					"content": "Расслабьте своё тело, очистите разум и узрите кое-что очень важное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710109
					],
					"speakerTitle": "Басима Пятая"
				},
				{
					"id": 756710109,
					"content": "Зяблики милее всех на свете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756710110,
					"content": "Абсолютно верно! Поздравляю! Вас так очаровали зяблики, что вы сразу даёте правильные ответы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710111
					],
					"speakerTitle": "Басима Пятая"
				},
				{
					"id": 756710111,
					"content": "Странно. По какой-то причине, когда Паймон увидела настольную игру, в голове сразу всплыла эта фраза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756710112,
					"content": "#Что-то знакомое, да, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710113,
						756710115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756710113,
					"content": "Мы ведь уже встречались?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710114
					]
				},
				{
					"id": 756710114,
					"content": "Точно! И не раз встречались. Радостно видеть, как вы полны энергии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Басима Пятая"
				},
				{
					"id": 756710117,
					"content": "Сыграешь в мою игру? Семнадцатая версия, третье поколение «Щебечущих шаров»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710118
					],
					"speakerTitle": "Басима Пятая"
				},
				{
					"id": 756710118,
					"content": "В игре вы узнаете удивительные истории о маленьком зяблике и более крупном древнем краснопёром зяблике, победившем поморников!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710119
					],
					"speakerTitle": "Басима Пятая"
				},
				{
					"id": 756710119,
					"content": "Круто! Мы любим лёгкие и весёлые игры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710120,
						756710121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756710120,
					"content": "#Готов{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710122,
					"content": "Хорошо! Надеюсь, вы найдёте подходящий вам вариант игры и получите незабываемые впечатления!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Басима Пятая"
				},
				{
					"id": 756710121,
					"content": "...начать играть!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710115,
					"content": "Можем начать с твоего любимого! «Зяблики самые милые!»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710116
					]
				},
				{
					"id": 756710116,
					"content": "Именно! Даже если сейчас не можешь вспомнить прошлое, нестрашно, главное - наслаждаться настоящим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Басима Пятая"
				},
				{
					"id": 756710104,
					"content": "Это что... какой-то код?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				}
			]
		}
	]
}