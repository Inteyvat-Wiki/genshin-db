			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тирзад"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552501,
					"content": "... А, это вы. Вам есть что добавить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552502,
						730552507,
						730552511
					],
					"speakerTitle": "Тирзад"
				},
				{
					"id": 730552502,
					"content": "Расскажи о Джебраиле.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552503
					]
				},
				{
					"id": 730552503,
					"content": "Как я мог в нём сомневаться?! Я такой глупец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552504
					],
					"speakerTitle": "Тирзад"
				},
				{
					"id": 730552504,
					"content": "Я очень благодарен ему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552505
					],
					"speakerTitle": "Тирзад"
				},
				{
					"id": 730552505,
					"content": "Раньше я во всём сомневался, будь то учёба или жизнь. У меня больше нет сомнений. Я твёрдо решил следовать выбранному мной пути, каким бы трудным он ни оказался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552506
					],
					"speakerTitle": "Тирзад"
				},
				{
					"id": 730552506,
					"content": "Это самое малое, что я могу сделать в память о нём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тирзад"
				},
				{
					"id": 730552507,
					"content": "Расскажи о царе Дешрете.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552508
					]
				},
				{
					"id": 730552508,
					"content": "Я начинаю сомневаться в достоверности того, что я читал до этого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552509
					],
					"speakerTitle": "Тирзад"
				},
				{
					"id": 730552509,
					"content": "Эта молитва... вызывает не поддающееся описанию, странное чувство. Ещё и слова Самиила... После возвращения надо будет детальнее изучить этот вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552510
					],
					"speakerTitle": "Тирзад"
				},
				{
					"id": 730552510,
					"content": "Конечно, в первую очередь надо закончить работу, как и планировалось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тирзад"
				},
				{
					"id": 730552511,
					"content": "Расскажи о Джехт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552512
					]
				},
				{
					"id": 730552512,
					"content": "Эх! Я бы хотел что-то сделать для неё, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552513
					],
					"speakerTitle": "Тирзад"
				},
				{
					"id": 730552513,
					"content": "Я бессилен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552514
					],
					"speakerTitle": "Тирзад"
				},
				{
					"id": 730552514,
					"content": "Она отказывается что-либо говорить. Если бы она сказала, что хочет, я бы сделал всё возможное, чтобы исполнить её желание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тирзад"
				}
			]
		},
		{
			"id": 7305526,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330601",
							"2"
						],
						"stepId": 7330601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джехт",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552601,
					"content": "Прости. Я не очень хорошо контролирую свои эмоции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552602
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 730552602,
					"content": "Не надо извиняться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552603
					]
				},
				{
					"id": 730552603,
					"content": "Да... Мы знаем, что ты переживаешь тяжёлый период своей жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730552604,
					"content": "Спасибо вам! Пусть ваше путешествие пройдёт благополучно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552605
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 730552605,
					"content": "Паймон тоже надеется, что у тебя всё будет хорошо. Обязательно должно быть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7305527,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
