			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бонифаций",
					"Нахтигар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552701,
					"content": "Где Омид и Мирсад? Они...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552702
					],
					"speakerTitle": "Бонифаций"
				},
				{
					"id": 730552702,
					"content": "Они в порядке. Просто... у них другие планы, поэтому они не будут работать с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552703
					],
					"speakerTitle": "Нахтигар"
				},
				{
					"id": 730552703,
					"content": "А? Что нам делать? Мы не можем делать всё вдвоём. Нам нужно нанять больше людей! Но кто захочет приехать в деревню Аару...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552704
					],
					"speakerTitle": "Бонифаций"
				},
				{
					"id": 730552704,
					"content": "Ладно, поговорим об этом позже. Сайрус благополучно вернулся, и это определённо повод для радости. Я больше никогда не отпущу его в такое опасное место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552705
					],
					"speakerTitle": "Бонифаций"
				},
				{
					"id": 730552705,
					"content": "Ты что такое говоришь? Мы торговцы вьючными яками. Что мы будем есть, если они не буду работать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552706
					],
					"speakerTitle": "Нахтигар"
				},
				{
					"id": 730552706,
					"content": "Ветром сыт не будешь. Кроме того, попробуй здесь открыть рот, и он тут же будет полон песка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552707
					],
					"speakerTitle": "Нахтигар"
				},
				{
					"id": 730552707,
					"content": "Но мы не можем позволить Сайрусу рисковать. Ты выглядишь сильным и выносливым, поэтому ты понесёшь вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552708
					],
					"speakerTitle": "Бонифаций"
				},
				{
					"id": 730552708,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нахтигар"
				}
			]
		}
	]
