			"dialogs": [
				{
					"id": 220050101,
					"content": "Не могу найти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220050102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "#Эй! А ты откуда взял{F#ась}{M#ся}? Нельзя так незаметно подкрадываться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220050104,
					"content": "Кто я? Я... исследователь. Сейчас я исследую древнюю архитектуру долины Гуйли. Можешь звать меня Бао Эр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220050105,
					"content": "Я так увлеклась исследованиями, что даже потеряла свою коробку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220050106,
					"content": "А в ней лежит сокр... Эм... Очень важная реликвия. Поищешь мою коробку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220050107,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "Отлично! Думаю, что я обронила её где-то здесь... Или где-то там. Прошу тебя, найди мою коробку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220050108,
					"content": "Как выглядит твоя коробка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "Ну... Обыкновенная коробка. Квадратная такая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220050112,
					"content": "Зачем класть реликвию в коробку? Потому что... Так удобнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220050113,
					"content": "Ещё я положила в коробку разную одежду, чтобы не повредить реликвию. Пожалуйста, помоги мне найти коробку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220050109,
					"content": "Реликвия?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "Это... Это просто очень ценная реликвия. Я бы объяснила подробнее, но боюсь ты не поймёшь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220050115,
					"content": "Её ценность очевидна только экспертам. Таким как я, например. Пожалуйста, помоги мне найти коробку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бао Эр"
				}
			]
		},
