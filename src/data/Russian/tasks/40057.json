						"stepId": 4005710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Камисато Аяка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570501,
					"content": "Вы аккуратно опускаете лист бумаги в воду...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570502
					]
				},
				{
					"id": 400570502,
					"content": "Ого, смотрите! Работает! На бумаге появляются новые слова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570503,
					"content": "Дай Паймон прочитать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570504,
					"content": "Хм, в истории говорится, что после того, как Сумидзомэ получила собрание сочинений от Акахито и опустила их в воду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570505,
					"content": "Украденные строки были размыты... Но почему это произошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570506,
					"content": "Видишь ли, Паймон, в прошлом, когда печать ещё не была изобретена, рукописный текст в книгах легко исчезал под воздействием влаги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570507
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 400570507,
					"content": "Чтобы текст сохранялся дольше, либо пользовались особыми чернилами, либо покрывали поверхность бумаги водонепроницаемым покрытием после завершения работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570508
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 400570508,
					"content": "Производство особых чернил отнимает много времени и сил, да и водонепроницаемое покрытие тоже довольно сложно получить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570509
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 400570509,
					"content": "Однако, поскольку сборник стихов Акахито был важным подарком сёгуну, несомненно, для его защиты использовался один из этих двух методов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570510
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 400570510,
					"content": "Но что касается якобы украденных стихов, на них не только не было печати Акахито, но и слова размывались под воздействием жидкости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570511,
						400570512
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 400570511,
					"content": "Значит, это стихотворение писал не Акахито.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570513
					]
				},
				{
					"id": 400570513,
					"content": "Значит, Акахито не крал ничью работу! Его подставили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570514,
					"content": "Да, кажется, история Сумидзомэ именно об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570515
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570515,
					"content": "История весьма печальна. Зато теперь я знаю, как написать портреты Акахито и Сумидзомэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570516
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570516,
					"content": "Кадзуха, Аяка, хотели бы вы стать моделями для моих картин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570517
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570517,
					"content": "С радостью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570518
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 400570518,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570519
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570519,
					"content": "Отлично! В этот раз будет сразу два портрета!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570520,
					"content": "Да, и теперь, когда все четыре истории собраны, история Пяти Касэн полностью завершена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570512,
					"content": "Его дописал кто-то другой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570513
					]
				}
			]
		},
