							"2"
						],
						"stepId": 4005703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каэдэхара Кадзуха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570101,
					"content": "#Приветствую, {NICKNAME}, Паймон. Я слышал, что на празднике Иродори будут проводники, но не ждал, что ими окажетесь вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570102
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570102,
					"content": "Хе-хе, а мы не ожидали, что ты вернёшься в качестве гостя праздника!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570103,
					"content": "Я и сам удивился, когда получил приглашение. Но я так долго скитался в чужих краях, что рад вернуться на родину и отдать дань уважения старым друзьям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570104
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570104,
					"content": "Кадзуха, когда мы тебя заметили, ты, кажется, что-то искал. Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570105,
					"content": "Видите ли, когда я спускался с корабля, то неожиданно услышал лёгкие шаги позади.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570106
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570106,
					"content": "Это точно не было похоже на походку обычного пассажира, но когда я обернулся, этот человек уже исчез. Я услышал только всплеск воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570107
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570107,
					"content": "Я не успел разглядеть, кто это был, но зато нашёл этот странный клочок бумаги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570108
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570108,
					"content": "А на этой бумаге, случаем, не стихотворение написано?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570109,
					"content": "Откуда ты знаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570110
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570110,
					"content": "Вы рассказываете Кадзухе о событиях последних дней...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570111
					]
				},
				{
					"id": 400570111,
					"content": "Удивительно. Даже не верится, что такое бывает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570112
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570112,
					"content": "Кадзуха, можешь показать нам этот листок?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570113
					]
				},
				{
					"id": 400570113,
					"content": "Конечно, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570114
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570114,
					"content": "В прошлый раз стихотворение закончилось упоминанием Акахито. Очевидно, что эта история о нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570115,
					"content": "В ней говорится, что Акахито получил своё имя из-за любви к красным печатям, однако сёгун узнала, что он присвоил чужое стихотворение, и вскоре его изгнали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570116,
					"content": "М-да, по мнению Паймон, сегодняшняя история довольно грустная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570117,
					"content": "Другие истории были не лучше...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570118
					]
				},
				{
					"id": 400570118,
					"content": "Не думаю, что с историей что-то не так. И меня когда-то сёгун объявила преступником, так что я не особо отличаюсь от Акахито.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570119
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570119,
					"content": "Согласно истории, Акахито был изгнан из-за своих проступков. А ты не совершал ничего дурного, Кадзуха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570120,
					"content": "#{NICKNAME}, ты чего {M#задумался}{F#задумалась}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570121,
						400570122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570121,
					"content": "Печать, упомянутая в истории...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570123
					]
				},
				{
					"id": 400570123,
					"content": "Кстати, вы упоминали, что у вашего друга проблемы из-за того, что он не может быстро написать своё имя, так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570124
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570124,
					"content": "В Ли Юэ и Инадзуме есть такое выражение: «Печать - всё равно что подпись». Возможно, печать смогла бы помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570125
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570125,
					"content": "Во время плаваний я иногда вырезаю что-нибудь из дерева, чтобы скоротать время. Если нужен штамп для печати, я мог бы помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570126
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570126,
					"content": "Ого, отличная идея! Быстрее, нужно рассказать Альбедо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570122,
					"content": "...Возможно, она поможет Син Цю?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570123
					]
				}
			]
		},
		{
			"id": 4005702,
			"completionStepIds": [
				4005704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005704",
							"2"
						],
						"stepId": 4005704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570201,
					"content": "Альбедо, мы придумали, как помочь Син Цю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570202,
					"content": "Вы рассказываете Альбедо о разговоре с Кадзухой...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570203
					]
				},
				{
					"id": 400570203,
					"content": "Интересно... История о Пяти Касэн появилась вновь, и опять как нельзя вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570204
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570204,
					"content": "Печать, значит? Дайте-ка подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570205
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570205,
					"content": "Это и вправду отличное решение. Если использовать печать, Син Цю больше не придётся страдать из-за почерка. Однако...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570206,
						400570207
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570206,
					"content": "Однако?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570208
					]
				},
				{
					"id": 400570208,
					"content": "Подпись Син Цю уже была опубликована, а потому будет не слишком удобно использовать печать в новых книгах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570209
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570209,
					"content": "Но у меня есть другая идея. С использованием печати, конечно же. Давайте отправимся в ресторан «Призрачная беседка» и обсудим её с остальными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570207,
					"content": "Есть другая проблема?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570208
					]
				}
			]
		},
		{
			"id": 4005703,
			"completionStepIds": [
				4005706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005706",
							"2"
						],
						"stepId": 4005706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Син Цю"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570301,
					"content": "Да, вот так, Чжэнь Юй! Ваш почерк сегодня гораздо лучше, что означает, что вчерашние уроки прошли не зря!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570302
					],
					"speakerTitle": "Хираяма"
				},
				{
					"id": 400570302,
					"content": "Прошу прощения, но я больше не могу. Мои руки так болят, что я больше не могу ими двигать... Не стоило мне читать романы на уроках каллиграфии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570303
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 400570303,
					"content": "У вас же только что был десятиминутный перерыв. Ну же, вы справитесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570304
					],
					"speakerTitle": "Хираяма"
				},
				{
					"id": 400570304,
					"content": "Когда дело касается сроков, нет никого суровее господина Хираямы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570305
					],
					"speakerTitle": "Онодэра"
				},
				{
					"id": 400570305,
					"content": "Неудивительно, что госпожа Яэ всегда отправляла именно его разбираться с проблемными писателями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570306
					],
					"speakerTitle": "Мурата"
				},
				{
					"id": 400570306,
					"content": "Ой, как страшно! Прошло совсем немного времени, а Син Цю уже похож на ходячего мертвеца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570307,
					"content": "Господин Хираяма, мы нашли возможное решение нашей проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570308
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570308,
					"content": "Как в Ли Юэ, так и в Инадзуме вместо подписей часто используют печати. С печатью понадобится гораздо меньше времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570309
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570309,
					"content": "Конечно же, одной печати будет недостаточно. Поэтому я предлагаю, чтобы каждая подпись состояла из двух частей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570310
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570310,
					"content": "Во-первых, мы используем персональную печать. Возьмём подпись Чжэнь Юя за основу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570311
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570311,
					"content": "Во-вторых, я также придумаю простой, но элегантный узор, который Чжэнь Юй сможет легко повторить. И тогда ему останется изобразить в книгах лишь его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570312
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570312,
					"content": "Дайте-ка подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570313
					],
					"speakerTitle": "Хираяма"
				},
				{
					"id": 400570313,
					"content": "Кажется, это может сработать! Автор не только будет писать своей рукой, но и результат должен получиться очень красивым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570314
					],
					"speakerTitle": "Хираяма"
				},
				{
					"id": 400570314,
					"content": "То есть я спасён от этих мучений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570315
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 400570315,
					"content": "Господин Хираяма, мне вдруг пришло в голову, что причина, по которой мы отказались от раздачи автографов раньше, в том, что писателю требовалось слишком много времени, чтобы подписать каждую книгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570316
					],
					"speakerTitle": "Онодэра"
				},
				{
					"id": 400570316,
					"content": "Но если мы воспользуемся методом, предложенным Мелом, у нас будет достаточно времени для автограф-сессии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570317
					],
					"speakerTitle": "Онодэра"
				},
				{
					"id": 400570317,
					"content": "И если все писатели будут подписывать книги тем же способом, то подпись Чжэнь Юя не будет выделяться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570318
					],
					"speakerTitle": "Онодэра"
				},
				{
					"id": 400570318,
					"content": "Если это возможно, то, безусловно, я буду рад придумать узор и для других писателей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570319
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570319,
					"content": "А вырезание печатей предоставьте мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570320
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400570320,
					"content": "В таком случае я свяжусь с другими двумя писателями, принимающими участие в презентации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570321
					],
					"speakerTitle": "Хираяма"
				},
				{
					"id": 400570321,
					"content": "Вскоре прибывают остальные писатели...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570322
					]
				},
				{
					"id": 400570322,
					"content": "Для меня большая честь использовать подпись, придуманную Мелом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570323
					],
					"speakerTitle": "Сатоми"
				},
				{
					"id": 400570323,
					"content": "Мой псевдоним довольно сложный и не подходит для автографов. Однако с этим новым способом моя мечта наконец сбудется!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570324
					],
					"speakerTitle": "Кадэнокодзи Кэндзабуро"
				},
				{
					"id": 400570324,
					"content": "Отлично! Кажется, всем пришлась по душе эта идея.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570325,
					"content": "Прошу прощения, что отнял у вас столько времени, Чжэнь Юй. Пожалуйста, отдохните как следует следующие пару дней. Мы обо всём позаботимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570326
					],
					"speakerTitle": "Хираяма"
				},
				{
					"id": 400570326,
					"content": "Книги, которые Чжэнь Юй уже успел подписать, можно будет использовать в качестве главных призов в следующих мероприятиях издательского дома Яэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570327
					],
					"speakerTitle": "Хираяма"
				},
				{
					"id": 400570327,
					"content": "Фух... Мы справились, мероприятие спасено!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570328
					],
					"speakerTitle": "Онодэра"
				},
				{
					"id": 400570328,
					"content": "Благодаря всеобщим стараниям мы с Онодэрой наконец-то избавлены от всей этой суматохи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570329
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 400570329,
					"content": "Хе-хе, да уж. Ты наконец свободен, Син Цю. Почему бы тебе не подышать свежим воздухом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4005704,
			"completionStepIds": [
				4005708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
