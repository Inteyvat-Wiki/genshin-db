			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Камисато Аяка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570401,
					"content": "У нас есть ещё немного времени, куда отправимся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570402,
					"content": "#{NICKNAME}, вот ты где.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570403
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 400570403,
					"content": "Ой, это же Аяка и Венти... Какая интересная парочка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570404,
					"content": "Я как раз собиралась на место проведения праздника, чтобы подготовить урок икебаны, когда нашла странный листок бумаги на подставке для цветов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570405
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 400570405,
					"content": "Этот бард как раз был поблизости, и он сказал мне, что вы уже находили подобные записки. Поэтому мы отправились вас искать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570406
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 400570406,
					"content": "Но листок, который она нашла, отличается от тех, что мы видели ранее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570407
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 400570407,
					"content": "Вот он, пожалуйста, взгляните.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570408
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 400570408,
					"content": "Все предыдущие стихотворения были примерно одной длины, но это состоит всего из двух строк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400570409,
					"content": "И хотя это короткое предложение, оно не находится ни рядом с заголовком, ни по центру страницы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570410
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570410,
					"content": "Хм, расположение текста указывает на то, что на листе, помимо этих двух строк, написано что-то ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570411
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 400570411,
					"content": "Буквально здесь написано: «Окуните бумагу в воду, и тогда явится истина».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570412
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 400570412,
					"content": "У меня дома есть собрание необычных историй древности. В ней упоминается об особых чернилах, которые проявляются при намокании и исчезают, когда высыхают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570413
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 400570413,
					"content": "Значит, окунём его? Поблизости как раз есть пруд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		},
		{
			"id": 4005705,
			"completionStepIds": [
				4005710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005710",
