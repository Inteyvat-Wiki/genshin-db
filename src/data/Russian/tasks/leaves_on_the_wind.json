			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Доктор Эдит"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030501,
					"content": "#Наш{F#ла}{M#ёл} что-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030502
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030502,
					"content": "#Я наш{F#ла}{M#ёл} эти листья.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030503
					]
				},
				{
					"id": 207030503,
					"content": "#...Листья? Дай взглянуть. Ты даже положил{F#а} их в коробку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030504
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030504,
					"content": "Когда держишь эти листья в руках, то действительно чувствуешь ветер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030505
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030505,
					"content": "Каждый лист действительно дышит этой силой... Если бы у меня был Глаз Бога, я бы не потратила так много времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030506
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030506,
					"content": "Спасибо! Это очень ценный материал. Я найду ему достойное применение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030507
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030507,
					"content": "Но у меня нет возможности сохранить эти листья, а так их «ветер» исчезнет слишком быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030508
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030508,
					"content": "Возьми, это тебе за труды. Кто знает, может быть, в будущем мне снова придётся попросить тебя помочь мне со сбором материалов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доктор Эдит"
				}
			]
		}
	]
}