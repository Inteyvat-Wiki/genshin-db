			"dialogs": [
				{
					"id": 207030301,
					"content": "Что именно нужно найти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030303
					]
				},
				{
					"id": 207030303,
					"content": "Ты можешь видеть элементы, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030304,
					"content": "Я думаю, тебе нужно лишь идти по следам ветра, чтобы найти то, что нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
