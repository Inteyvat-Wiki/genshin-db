			"dialogs": [
				{
					"id": 207030201,
					"content": "Я сделаю это!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030202
					]
				},
				{
					"id": 207030202,
					"content": "Замечательно! Я рассчитываю на тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030303
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030303,
					"content": "Ты можешь видеть элементы, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030304,
					"content": "Я думаю, тебе нужно лишь идти по следам ветра, чтобы найти то, что нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030305,
					"content": "Я подожду тебя под деревом. Если ты найдёшь что-нибудь, приноси мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доктор Эдит"
				}
			]
		},
