			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Доктор Эдит"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030401,
					"content": "Надо сказать, человек вроде тебя гораздо лучше подходит на роль исследователя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030402,
					"content": "У тебя богатый опыт приключений и неплохие физические данные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030403,
					"content": "А самое главное, хотя у тебя и нет Глаза Бога, ты всё равно можешь контролировать элементы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030404,
					"content": "Элементы... Есть ли в этом мире такая тема исследования, в которой не будет фигурировать это слово? Для учёного возможность контролировать элементы действительно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030405,
					"content": "Ах, опять я о своём... Прошу прощения, не принимай близко к сердцу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доктор Эдит"
				}
			]
		},
		{
			"id": 2070305,
			"completionStepIds": [
				2070303
			],
