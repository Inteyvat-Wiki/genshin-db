				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Доктор Эдит"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030101,
					"content": "...И этот материал я использовать не могу. Какая жалость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030102
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030103
					]
				},
				{
					"id": 207030103,
					"content": "Я хочу написать новую книгу об истории Мондштадта, в которой ветер был бы основной темой, и здесь я ищу вдохновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030104
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030104,
					"content": "Это самое подходящее место для поиска вдохновения - здесь есть Статуя семи Архонтов, символизирующая Ветер, а это дерево связано с великим героем Веннессой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030105
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030105,
					"content": "Но - только не смейся - мне, человеку без Глаза Бога, найти или собрать потоки ветра очень тяжело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030106
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030106,
					"content": "Поэтому так называемый поиск вдохновения для меня заключается в том, что я просто всматриваюсь в никуда. У меня есть немного материалов, но все это - второсортные выжимки из чужих книг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030107
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030107,
					"content": "Так и живут на этом континенте люди без Глаза Бога - на всё они вынуждены тратить много усилий, а результат не радует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030108
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030108,
					"content": "Без Глаза Бога не воспользуешься энергией элементов... И в жизни, и в науке не имеющие его люди вынуждены жить подобно чужакам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030109
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030109,
					"content": "Ха-ха, наверное, с точки зрения богов только тот, кто обладает Глазом Бога, может быть главным героем этого мира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030110
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030110,
					"content": "Прости меня за мою болтливость. Хотя я и говорю всё это, я не брошу своё исследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030111
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030111,
					"content": "У меня нет Глаза Бога, но свою учёную степень я по ветру не пущу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030112
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030112,
					"content": "К тому же говорят, что, хотя у тебя нет Глаза Бога, ты всё равно можешь видеть элементы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030113
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030113,
					"content": "#Не мог{F#ла} бы ты принести мне некоторые вещи со следами Анемо элемента? Это бы здорово помогло моему исследованию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030114
					],
					"speakerTitle": "Доктор Эдит"
				},
				{
					"id": 207030114,
					"content": "#{M#Путешественник}{F#Путешественница}, не {M#мог}{F#могла} бы ты забраться на дерево и поискать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доктор Эдит"
				}
			]
		},
