					}
				]
			},
			"dialogs": [
				{
					"id": 761360301,
					"content": "(Может, <color=#FFCC33FF>Ягода</color> захочет посмотреть, что там в сундуке...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761360302
					]
				},
				{
					"id": 761360302,
					"content": "Хе-хе... Посмотрим, сколько я заработала за последнее время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360303
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761360303,
					"content": "В прошлый раз босс обещала мне премию. Почему бы мне не...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360304
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761360304,
					"content": "Почему здесь нет моры? Только записка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360305
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761360305,
					"content": "«Дорогая Ягода, закрой. Твоей премии здесь нет».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360306
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761360306,
					"content": "Пф, босс опять пытается меня напугать. Может, есть двойное дно?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360307
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761360307,
					"content": "Нет никакого двойного дна. Вот твоя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360308
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761360308,
					"content": "О, спасибо, босс, я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360309
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761360309,
					"content": "А-а-а-а-а! Б-босс, я просто делала инвентаризацию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360310
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761360310,
					"content": "Я сейчас же вернусь к работе. Сейчас же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360311
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761360311,
					"content": "Стоять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360312
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761360312,
					"content": "Есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360313
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761360313,
					"content": "Закрой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360314
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761360314,
					"content": "Есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360315
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761360315,
					"content": "Ступай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360316
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761360316,
					"content": "Есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ягода"
				}
			]
		},
