					"Нимрод"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200490101,
					"content": "Мне срочно нужно выпить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490102
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200490102,
					"content": "Но если Юри узнает, то мне крышка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490103
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200490103,
					"content": "Всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490104
					]
				},
				{
					"id": 200490104,
					"content": "А? Да, всё в порядке... выпить охота!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490105
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200490105,
					"content": "Моя жёнушка Юри на дух не переносит спиртное, поэтому дома мне пить нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490106
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200490106,
					"content": "Лишь иногда удаётся пропустить по стаканчику, пока она ходит за покупками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490107
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200490107,
					"content": "Первый шаг - это признать проблему.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490108
					]
				},
				{
					"id": 200490108,
					"content": "Эй, полегче! Ты так говоришь, как будто я один в Мондштадте такой любитель выпить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490109
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200490109,
					"content": "Можешь отвлечь Юри ненадолго? Я быстренько управлюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490110
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200490110,
					"content": "Когда она идёт за покупками, она может полдня что-нибудь выбирать. Главное, чтобы был выбор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490111
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200490111,
					"content": "Пока есть из чего выбирать, она будет выбирать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490112,
						200490114
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200490112,
					"content": "Понятно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490113
					]
				},
				{
					"id": 200490113,
					"content": "Ха-ха! Славно! Пусть твой стакан всегда будет полон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200490114,
					"content": "Сколько времени ты планируешь пить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490115
					]
				},
				{
					"id": 200490115,
					"content": "Хех! А сколько времени у меня есть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490116
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200490116,
					"content": "Я просто хочу спокойно насладиться этим прекрасным напитком, не думая о времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490117
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200490117,
					"content": "Только один стакан. Обещаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нимрод"
				}
			]
		},
