			"dialogs": [
				{
					"id": 200490401,
					"content": "Благодарю тебя! Мой муж недавно бросил пить ради меня. Ему это далось очень непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490402
					],
					"speakerTitle": "Юри"
				},
				{
					"id": 200490402,
					"content": "Возможно, любимые фрукты подбодрят его немного.",
