			"dialogs": [
				{
					"id": 200490201,
					"content": "Хм... Закатники или яблоки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490202
					],
					"speakerTitle": "Юри"
				},
				{
					"id": 200490202,
					"content": "Эх... Вот бы Нимрод был здесь, тогда я бы просто взяла то, что он хочет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490203
					],
					"speakerTitle": "Юри"
				},
				{
					"id": 200490203,
					"content": "Простите, мадам, но закатники у нас закончились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490204
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200490204,
					"content": "Ясно. В таком случае я возьму яблоки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490205
					],
					"speakerTitle": "Юри"
				},
				{
					"id": 200490205,
					"content": "Ой... Мисс Юри, прошу прощения, но эти яблоки не самые свежие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490206
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200490206,
					"content": "Действительно? Но у меня нет другого выбора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490207
					],
					"speakerTitle": "Юри"
				},
				{
					"id": 200490207,
					"content": "Позвольте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200490208,
					"content": "Позволить что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490209
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200490209,
					"content": "Помочь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490210
					]
				},
				{
					"id": 200490210,
					"content": "Не переживайте! Мы раздобудем для вас свежие <color=#00E1FFFF>закатники</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200490211,
					"content": "Правда? Вот спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490212
					],
					"speakerTitle": "Куинн"
				},
				{
					"id": 200490212,
					"content": "Отлично! Нимрод любит закатники больше, чем яблоки. Я буду ждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Юри"
				}
			]
		},
