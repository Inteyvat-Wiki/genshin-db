				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кулемана"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940501,
					"content": "Десять, двадцать... С такой выручкой моры нам хватит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940502,
						751940510
					],
					"speakerTitle": "Кулемана"
				},
				{
					"id": 751940502,
					"content": "Не хочешь заработать ещё больше?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940503
					]
				},
				{
					"id": 751940503,
					"content": "#Ха-ха, нет! Надо уметь вовремя остановиться! Хорошо, что ты {F#оказалась так снисходительна и согласилась}{M#оказался так снисходителен и согласился} помочь. Иначе я могла угодить в беду со своими подвесками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940504
					],
					"speakerTitle": "Кулемана"
				},
				{
					"id": 751940504,
					"content": "И вообще, думать только о выручке скучно. Для меня это всего лишь хобби. А вот наблюдения за вулканом - настоящее дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940505
					],
					"speakerTitle": "Кулемана"
				},
				{
					"id": 751940505,
					"content": "Деньги всегда можно заработать, но если мы не успеем предупредить людей о скором извержении вулкана... потери будут невосполнимы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940506
					],
					"speakerTitle": "Кулемана"
				},
				{
					"id": 751940506,
					"content": "Вы не получаете финансирования от Палаты советников?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940507
					]
				},
				{
					"id": 751940507,
					"content": "Мы не стали подавать заявку. Я могу представить, сколько забот сейчас у Палаты советников, не хочу добавлять им нагрузку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940508
					],
					"speakerTitle": "Кулемана"
				},
				{
					"id": 751940508,
					"content": "Мы с попутчиками другое дело. Мы странствуем по свету и сами зарабатываем себе на жизнь. И давно привыкли к этому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940509
					],
					"speakerTitle": "Кулемана"
				},
				{
					"id": 751940509,
					"content": "Для нас не составляет труда наблюдать за вулканом во время путешествия, как для вас - помогать людям! Это часть самого путешествия!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кулемана"
				},
				{
					"id": 751940510,
					"content": "Ладно, увидимся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940511
					]
				},
				{
					"id": 751940511,
					"content": "Пока! До встречи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кулемана"
				}
			]
		},
		{
