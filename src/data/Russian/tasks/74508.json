				]
			},
			"dialogs": [
				{
					"id": 745080101,
					"content": "Спустя какое-то время вы с Паймон приходите к стенду Удивительного турнира плесенников...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745080102
					]
				},
				{
					"id": 745080102,
					"content": "О! Мягкие, милые плесенники такие классные! Хочу ещё поиграть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080103
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 745080103,
					"content": "Как тебя зовут?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080104
					]
				},
				{
					"id": 745080104,
					"content": "Меня зовут Анджиани. Я тренировала Туренну до того, как она вступила в Особый патруль!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080105
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 745080105,
					"content": "#Мы с ней совсем не похожи! Совсем! Я не сдамся вам лишь потому, что вы элитные {M#воины}{F#воительницы} уровня мегабосса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080106
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 745080106,
					"content": "Так эта высокомерная мелюзина... бывший инструктор Туренны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745080107,
					"content": "Не беспокойтесь, Золотой метеор и Серебряный спутник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080108
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 745080108,
					"content": "Недавно Туренне поручили новое задание, так что она вернулась на базу Особого патруля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080109
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 745080109,
					"content": "Вместо себя она отправила Анджиани, чтобы та отвечала за безопасность нашего мероприятия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080110
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 745080110,
					"content": "Ей очень понравился Удивительный турнир плесенников. Мы отлично провели время вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080111
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 745080111,
					"content": "Да! Мне и настольная игра, и плесенники нравятся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080112
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 745080112,
					"content": "Они мягкие и милые, как тидалья... хи-хи-хи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080113,
						745080114
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 745080113,
					"content": "А что это у тебя слюнки потекли?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				},
				{
					"id": 745080115,
					"content": "Никто и не собирается их есть! Только обнимать и тискать... Это ведь не запрещено? Хания мне как раз разрешает Огнерадость тискать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080116
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 745080116,
					"content": "#В-вот и тискай свою Огнерадость! А {NICKNAME} с Паймон будут обниматься с Бам-бам-шапочкой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745080117,
					"content": "Да ладно тебе жадничать! Я хочу тискать всех!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080118
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 745080118,
					"content": "Хания сказала, что вы в этой игре эксперты. Так почему бы вам тогда со мной не посоревноваться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080119
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 745080119,
					"content": "Если я выиграю, то вы разрешите мне тискать и Бам-бам-шапочку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080120
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 745080120,
					"content": "Вот же ж! Она нас недооценивает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745080121,
					"content": "#{NICKNAME}, давай покажем ей мощь ветеранов Удивительного турнира плесенников!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080122,
						745080123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745080122,
					"content": "А ещё Кубка лотоса нилотпала!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080124,
					"content": "Да-да-да! Не зря же мы столько титулов заработать успели. А значит, проиграть не должны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745080123,
					"content": "А ещё неразлучных звёзд сияющей доблести!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080114,
					"content": "Плесенников есть нельзя!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				}
			]
		}
	]
}