			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мадам Пин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140101,
					"content": "Ничто не вечно под луной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140102,
						10140105
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140102,
					"content": "Здравствуйте.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140103
					]
				},
				{
					"id": 10140103,
					"content": "Ох, вы пришли посмотреть на цветы, молодые люди?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140104
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140104,
					"content": "К сожалению, почти все мои глазурные лилии увяли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140107,
					"content": "А почему они все... увяли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140108,
					"content": "В моё время люди говорили, что глазурные лилии могут понимать сердца людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140109
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140109,
					"content": "Они будут цвести и распускаться под звуки смеха и пения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140110
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140110,
					"content": "Но если рядом с ними будут часто обсуждать сплетни и коварство, они очень быстро увянут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140111
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140111,
					"content": "Значит, эти цветы могут чувствовать настроение людей в Ли Юэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140112,
					"content": "Да, слухи о смерти Властелина Камня повсюду, и они несут очень неприятную энергетику.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140113
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140113,
					"content": "Кто-то говорит, что это всё коварная схема Фатуи. Другие говорят, что во всём виноваты Цисин. Третьи вообще говорят, что страшное существо из морских глубин должно вот-вот проснуться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140114
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140114,
					"content": "Эта гавань словно куча сухих веток. Одна искра, и всё в огне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140115
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140115,
					"content": "Простите, я знаю, что с возрастом стала много ворчать. Вы что-то хотели, молодые люди?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140116,
						10140121
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140116,
					"content": "Мы хотели бы одолжить Колокольчик очищения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140117
					]
				},
				{
					"id": 10140117,
					"content": "Ах, эта старая безделушка... Я помню, что она у меня есть, но совсем не могу вспомнить, где именно она лежит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140118
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140118,
					"content": "Помню, когда я была молодой, мой лучший друг любил носить его на шее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140119
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140119,
					"content": "Он заметил, как я смотрю на него, и подарил его мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140120
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140120,
					"content": "Потом он сказал, что если кто-то попросит его одолжить, я ни в коем случае не должна отказать в их просьбе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140127,
					"content": "За столько лет многие приходили одолжить колокольчик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140128
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140128,
					"content": "Но с каких-то пор люди перестали спрашивать о нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140129
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140129,
					"content": "Я уже стара и еле шевелюсь. Вам придётся подождать, пока я найду этот колокольчик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140130,
						10140133
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140130,
					"content": "Мы можем поискать его сами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140131
					]
				},
				{
					"id": 10140131,
					"content": "Да, бабуля! Покажите, где вы живёте, и мы сами найдём этот колокольчик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140132,
					"content": "А ещё мы, эм... Можем помочь вам прибраться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140135,
					"content": "Хорошо, детишки... Не волнуйтесь, я не могла спрятать этот колокольчик очень далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140136
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140136,
					"content": "А вы тут рядом живёте, бабуля? Рядом с террасой Юйцзин? Наверное, это очень дорогой район...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140137,
					"content": "Ха-ха-ха, разве такая старушка, как я, может позволить себе купить дом в этом городе? Видите этот чайничек? Вся моя домашняя утварь помещается в него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140138
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140138,
					"content": "Вся утварь? Здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140139,
						10140140,
						10140143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140139,
					"content": "Вы имеете в виду, что тут лежат ваши ключи от дома?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140146
					]
				},
				{
					"id": 10140146,
					"content": "Хи-хи-хи... Послушайте меня, детки. Колокольчик находится в этом чайнике. Если вы хотите его забрать, то загляните внутрь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140140,
					"content": "Вы хотите сказать, что у вас нет ничего, кроме колокольчика?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140141
					]
				},
				{
					"id": 10140141,
					"content": "Эй, ты чего грубишь бабуле?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140142
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140142,
					"content": "И даже если это так, колокольчик наверняка стоит целое состояние, да, бабуля?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140143,
					"content": "Паймон, заходи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140144
					]
				},
				{
					"id": 10140144,
					"content": "Что?! Нет, я туда не полезу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140145,
					"content": "И вообще, зачем мне туда лезть? Ведь можно просто открыть крышку и посмотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140133,
					"content": "Я дипломированный специалист Ордо Фавониус по поиску пропавших вещей!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140134
					]
				},
				{
					"id": 10140134,
					"content": "#Ты правда гордишься этим, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140121,
					"content": "Мы хотели бы у вас кое-что одолжить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140122
					]
				},
				{
					"id": 10140122,
					"content": "И что же? Ох, наверное, вы имеете в виду Колокольчик очищения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140123
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140123,
					"content": "У меня больше нечего просить... Только этот колокольчик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140124
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140124,
					"content": "Но когда-то давным-давно он принадлежал не мне, а моему лучшему другу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140125
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140125,
					"content": "В молодости я была такой красивой... И постоянно просила его отдать этот колокольчик мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140126
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140126,
					"content": "Он не смог мне отказать. Но он сказал, что я должна проститься с ним, если кто-то придёт его одолжить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140105,
					"content": "У вас что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140106
					]
				},
				{
					"id": 10140106,
					"content": "Нет, ничего страшного. Просто очень жаль, что все эти глазурные лилии увяли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Мадам Пин"
				}
			]
		},
		{
			"id": 101402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101406",
							"2"
						],
						"stepId": 101406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мадам Пин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140201,
					"content": "А вы совсем не торопитесь с поисками колокольчика, да, детки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140202
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140202,
					"content": "Вы там поосторожнее. Я давненько не прибиралась в этом чайнике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140203
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140203,
					"content": "У вас такая красивая одежда... Будьте осторожны, не испачкайтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мадам Пин"
				}
			]
		},
		{
			"id": 101403,
			"completionStepIds": [
				101403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101403",
							"2"
						],
						"stepId": 101403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мадам Пин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140301,
					"content": "Шустрая молодёжь, вы его очень быстро нашли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140302,
						10140305,
						10140308
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140302,
					"content": "Вы одна из Адептов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140303
					]
				},
				{
					"id": 10140303,
					"content": "Да, я уже очень давно не слышала, чтобы ко мне так обращались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140304
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140304,
					"content": "Я уверена, что вы уже и сами догадались, Адепт я или нет, детишки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140312,
					"content": "Эм... В общем, Паймон поняла то, что ничего не поняла. Всё же, бабуля, вы отдадите нам колокольчик за просто так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140313,
					"content": "В смысле, вам не кажется странным, что мы пришли одолжить колокольчик сразу после смерти Властелина Камня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140314,
					"content": "Ха-ха, наивные дети. За всё время существования гавань Ли Юэ пережила бесчисленное количество бед и невзгод, и множество Адептов покинули этот мир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140315
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140315,
					"content": "И всегда первым делом мы проводили Церемонию Вознесения. Это важнейшая часть прощания с Адептом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140316
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140316,
					"content": "А вот бегать по городу и ловить убийцу до проведения Церемонии Вознесения - это какой-то шиворот-навыворот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140317
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140317,
					"content": "Теперь, когда вы пришли одолжить колокольчик, я поняла, что некоторый мой хороший знакомый решил вернуть традиции на круги своя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140318
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140318,
					"content": "Так почему я не должна отдавать вам колокольчик?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140319,
						10140322
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140319,
					"content": "А что, если он его не вернёт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140320
					]
				},
				{
					"id": 10140320,
					"content": "Не вернёт? Ха-ха-ха... Тогда, боюсь, древней старушке придётся его навестить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140321
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140321,
					"content": "Всё равно мы с ним давно не виделись. Как хотелось бы посидеть и поговорить за кружечкой чая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140326,
					"content": "Как бы то ни было, я думаю, у вас куча дел, раз вы занимаетесь проведением церемонии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140327
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140327,
					"content": "Ах да, пожалуйста, передайте тому, кто вас отправил ко мне, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140328
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140328,
					"content": "Если найдётся свободный вечерок, пусть заходит ко мне на чай. Хоть богатства мои скудны, но угостить чаем хорошего человека я точно смогу себе позволить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140329
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140329,
					"content": "Обязательно передадим, бабуля! Не болейте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140322,
					"content": "Можно мне оставить его себе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140323
					]
				},
				{
					"id": 10140323,
					"content": "Эй! Это колокольчик бабули! Мы должны возвращать то, что берём попользоваться на время!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10140324,
					"content": "Ты хочешь оставить его себе? А ты любишь говорить правду в лицо, да? Ха-ха-ха... Ну, можешь оставить себе, если хочешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140325
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140325,
					"content": "Но не забывай, что этот колокольчик может заскучать по дому и найти свой способ вернуться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140305,
					"content": "Вы одна из группировки Цисин?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140306
					]
				},
				{
					"id": 10140306,
					"content": "Цисин... Эта детвора давным-давно перестала включать нас в свой совет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140307
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140307,
					"content": "Однако они в последнее время и сами неплохо справляются. А нам, старикам, и без политики весело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140308,
					"content": "Неужели вы одна из Фатуи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140309
					]
				},
				{
					"id": 10140309,
					"content": "#Фатуи? {M#Мальчик}{F#Девочка}, у тебя с головой всё в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140310
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140310,
					"content": "Я уже слишком стара для этого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140311
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 10140311,
					"content": "Но если они решат зайти слишком далеко, я буду вынуждена вмешаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Мадам Пин"
				}
			]
		},
		{
			"id": 101404,
			"completionStepIds": [
				101407
			],
