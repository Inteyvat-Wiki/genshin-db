						],
						"pointId": 70
					}
				]
			},
			"dialogs": [
				{
					"id": 401360201,
					"content": "Я их сюда препроводила. Теперь они на твоём попечении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360202
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360202,
					"content": "Другие дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360203
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 401360203,
					"content": "Что-то вроде того. Меня ждут на одном мероприятии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360204
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360204,
					"content": "Это редкость в нашей сфере деятельности... Нашла новое хобби?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360205
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 401360205,
					"content": "Сегодня особенный случай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360206
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360206,
					"content": "Шеврёз, Ризли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360207,
					"content": "Праздничные мероприятия - это прекрасно... Они объединяют людей. И даже у меня стало больше посетителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360208
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 401360208,
					"content": "В конце концов, это фестиваль «Фонтиналия». Большое мероприятие для всего Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360209
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360209,
					"content": "Это точно. Сиджвин даже приготовила на всех праздничные питательные коктейли. Так сказать, чувствуешь вкус праздника с пользой для здоровья...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360210
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 401360210,
					"content": "Вы говорили о работе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360211,
					"content": "Уже поговорили. Я ведь обещала «маякнуть» господину Ризли, так ведь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360212
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360212,
					"content": "Хм... Но я ещё не обещал ничего конкретного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360213
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 401360213,
					"content": "Но ты и не отказал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360214
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360214,
					"content": "Как насчёт того, чтобы раздать всем, к примеру, газеты, в которых будет описано, что он сделал со своей служанкой двадцать лет назад?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360215
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360215,
					"content": "Боюсь, тогда кое-кому будет уж очень несладко жить в крепости...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360216
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 401360216,
					"content": "А другие двое будут приравнены к героям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360217
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360217,
					"content": "Кстати о двух героях... Вы пришли ко мне с каким-то делом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360218
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 401360218,
					"content": "Эм... Вообще-то мы пришли, чтобы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360219,
					"content": "Чтобы пригласить меня на церемонию? Не волнуйтесь. Я помню, что она сегодня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360220
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360220,
					"content": "Тогда нам нужно поторопиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360221,
					"content": "До свидания, герцог! Желаю хорошо повеселиться на фестивале «Фонтиналия»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360222,
					"content": "И вы хорошо проведите время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ризли"
				}
			]
		},
