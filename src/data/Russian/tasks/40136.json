			"dialogs": [
				{
					"id": 401360101,
					"content": "Прошло некоторое время...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401360102
					]
				},
				{
					"id": 401360103,
					"content": "Ксавье! Давно не виделись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360104,
					"content": "Здравствуйте! Извините, что совсем пропал. После того как фильм был смонтирован, я занимался продвижением и подготовкой к премьере.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360105
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 401360105,
					"content": "Церемония награждения уже сегодня, да? Интересно, получим ли мы премию «Фурина»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360106,
					"content": "Думаю, нас ждёт успех с вероятностью девяносто процентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360107
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401360107,
					"content": "Фурина! Ты уже здесь. Ты пришла раньше остальных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360108,
					"content": "Остальные тоже скоро должны прийти. Кстати о награде... Ксавье, не стоит ли нам придумать название нашей команде, чтобы нас могли объявить в случае победы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360109
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401360109,
					"content": "Хм?.. Но мы же ещё даже не знаем, получим ли что-то... Я не хочу сглазить раньше времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360110
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 401360110,
					"content": "Открой ты уже глаза! Ты же видел, как люди реагируют на наш фильм! Не было ни одного негативного отзыва!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360111
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401360111,
					"content": "Ты же ведь сам общался с работниками оперного театра. Они ведь просили тебя увеличить число показов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360112
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401360112,
					"content": "Должно быть, моры со сборов тебе хватит, чтобы открыть полноценную кинокомпанию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360113
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401360113,
					"content": "Но это же не только моя заслуга! Всё это стало возможным благодаря каждому члену нашей команды! Будет неправильно, если название буду придумывать я один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360114
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 401360114,
					"content": "В общем, ты подумай. Уверена, все согласятся с твоим выбором.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360115
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401360115,
					"content": "#Ладно... Но перед этим, {NICKNAME}, Паймон, могу я попросить вас посетить крепость Меропид?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360116
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 401360116,
					"content": "Мы разве не идём на церемонию награждения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360117,
					"content": "Я хотел попросить вас позвать Шеврёз. Она ведь исполнила одну из главных ролей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360118
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 401360118,
					"content": "У меня в последнее время совсем не было возможности встретиться с ней, так что я даже не успел пригласить её на церемонию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360119
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 401360119,
					"content": "Но в газете писали, что сегодня капитан Особого патруля лично сопроводит осуждённых по делу об убийстве в крепость Меропид.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360120
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 401360120,
					"content": "Вот как... Теперь Паймон поняла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360121,
					"content": "Мы легко справимся с этим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360122
					]
				},
				{
					"id": 401360122,
					"content": "Да! Подожди нас здесь, Ксавье, и пока попробуй придумать нашей съёмочной группе какое-нибудь красивое название!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360123,
					"content": "Хорошо. Спасибо, что согласились помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				}
			]
		},
