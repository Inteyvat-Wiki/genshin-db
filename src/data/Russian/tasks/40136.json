				]
			},
			"dialogs": [
				{
					"id": 401360301,
					"content": "Итак, премию «Фурина» первого кинофестиваля «Фонтиналия» получает фильм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360302
					],
					"speakerTitle": "Ведущий кинофестиваля"
				},
				{
					"id": 401360302,
					"content": "«Два мушкетёра»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360303
					],
					"speakerTitle": "Ведущий кинофестиваля"
				},
				{
					"id": 401360303,
					"content": "Это же мы! Мы победили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360304,
					"content": "Поздравляю, господин Ксавье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360305
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 401360305,
					"content": "Мы победили... Я не могу в это поверить... Я-я... так вам всем благодарен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360306
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 401360306,
					"content": "Видишь? Мои прогнозы в сфере развлечений Фонтейна всегда точны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360307
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401360307,
					"content": "Поприветствуем на сцене продюсера картины «Два мушкетёра», господина Ксавье!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360308
					],
					"speakerTitle": "Ведущий кинофестиваля"
				},
				{
					"id": 401360308,
					"content": "Спасибо... Спасибо всем за то, что так тепло приняли наш фильм. Я хотел бы выразить отдельную благодарность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360309
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 401360309,
					"content": "Время пролетело так незаметно, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360310
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360310,
					"content": "Да... Кажется, будто только вчера ты учила меня, как держать в руках мушкет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360311
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 401360311,
					"content": "Ты ещё вернёшься в Фонтейн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360312
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360312,
					"content": "Конечно! Мне очень нравятся эти земли! Здесь так много интересного, что мне ещё предстоит узнать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360313
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 401360313,
					"content": "А ты когда-нибудь посетишь Инадзуму?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360314
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 401360314,
					"content": "Я никогда не думала об этом... Но сейчас эта мысль показалась мне интересной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360315
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360315,
					"content": "Я буду тебя ждать! Приезжай в гости. Я напою тебя чаем и угощу нашими местными десертами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360316
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 401360316,
					"content": "Хорошо, тогда будем на связи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360317
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360317,
					"content": "Ты закончил здесь со всеми делами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360318
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 401360318,
					"content": "Да. Было бы здорово, если бы ты тоже вновь приехала к нам в Инадзуму когда-нибудь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360319
					],
					"speakerTitle": "Камисато Аято"
				},
				{
					"id": 401360319,
					"content": "Как дела у магазина «Ткани и кимоно Огуры»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360320
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 401360320,
					"content": "Всё отлично, насколько я знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360321
					],
					"speakerTitle": "Камисато Аято"
				},
				{
					"id": 401360321,
					"content": "Передавай привет Огуре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360322
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 401360322,
					"content": "Передам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360323
					],
					"speakerTitle": "Камисато Аято"
				},
				{
					"id": 401360323,
					"content": "Я слышала, что на острове прекратились грозы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360324
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 401360324,
					"content": "И война прекратилась тоже. На островах теперь мирно и спокойно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360325
					],
					"speakerTitle": "Камисато Аято"
				},
				{
					"id": 401360325,
					"content": "Это приятно слышать. Стало быть, погода сейчас самая подходящая, чтобы вывешивать ткани сушиться на солнышке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360326
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 401360326,
					"content": "Ещё раз спасибо всей съёмочной группе. Без вас я бы никогда не создал этот фильм и тем более никогда не стоял бы на этой сцене.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360327
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 401360327,
					"content": "Мы вместе со всей съёмочной группой решили, что будем называться кинокомпанией «Мушкетёры»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360328
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 401360328,
					"content": "Ах, это отличное название!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360329,
					"content": "В таком случае приглашаем всех членов кинокомпании «Мушкетёры» на сцену для общего фото!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360330
					],
					"speakerTitle": "Ведущий кинофестиваля"
				},
				{
					"id": 401360330,
					"content": "Ого! Паймон не знала, что мы ещё и фотографироваться будем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360331
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401360331,
					"content": "Режиссёр Фурина, я считаю, что именно вы должны держать награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360332
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 401360332,
					"content": "Что? Нет-нет-нет. Это будет слишком неловко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360333
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401360333,
					"content": "Но такой чести может быть удостоен только режиссёр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360334
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 401360334,
					"content": "И я так считаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360335
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 401360335,
					"content": "Это должна быть ты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360336
					]
				},
				{
					"id": 401360336,
					"content": "Тебе остаётся только согласиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360337
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 401360337,
					"content": "Все готовы? Три, два, один...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360338
					],
					"speakerTitle": "Ведущий кинофестиваля"
				},
				{
					"id": 401360338,
					"content": "Кинокомпания «Мушкетёры»!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
