			"dialogs": [
				{
					"id": 220080401,
					"content": "Нет! Я не хочу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080402
					],
					"speakerTitle": "Хун Доу"
				},
				{
					"id": 220080402,
					"content": "Если выпьешь лекарство, я дам тебе миндальный тофу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080403
					]
				},
				{
					"id": 220080403,
					"content": "Ммм... Миндальный тофу! Но мне сначала надо выпить лекарство... Фу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080404
					],
					"speakerTitle": "Хун Доу"
				},
				{
					"id": 220080404,
					"content": "Доудоу, пожалуйста, будь умницей... Выпей лекарство, и тебе станет получше. А потом тебя ждёт миндальный тофу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080405
					],
					"speakerTitle": "Чэнь Сян"
				},
				{
					"id": 220080405,
					"content": "Фу... Если доктор Бай Чжу такой умный, то почему же он не придумает лекарство со вкусом миндального тофу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хун Доу"
				}
			]
		}
