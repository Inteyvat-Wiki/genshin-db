			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чэнь Сян"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "Доудоу, будь хорошей девочкой, скушай лекарство. Тебе сразу станет лучше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "Чэнь Сян"
				},
				{
					"id": 220080102,
					"content": "Нет! Не хочу! Не буду! Не вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "Хун Доу"
				},
				{
					"id": 220080103,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "#Привет, путешественни{F#ца}{M#к}! У нашей Доудоу слабенькое здоровье. Господин Бай прописал ей вот это лекарство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "Чэнь Сян"
				},
				{
					"id": 220080105,
					"content": "Но она отказывается его принимать. Ей не нравится вкус этого лекарства. К сожалению, все травяные лекарства очень горькие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "Чэнь Сян"
				},
				{
					"id": 220080106,
					"content": "Она соглашается пить лекарство, только когда я пообещаю миску миндального тофу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "Чэнь Сян"
				},
				{
					"id": 220080107,
					"content": "#Путешественн{F#ица}{M#ик}, если у тебя найдётся минутка, принеси мне миску миндального тофу, пожалуйста. Я останусь здесь, чтобы убедить малышку Доудоу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "Чэнь Сян"
				},
				{
					"id": 220080108,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "Спасибо. Малышке Доудоу хватит одной порции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чэнь Сян"
				},
				{
					"id": 220080110,
					"content": "Что у неё за болезнь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "Эх... Хотела бы я знать... Господин Бай говорит, что эту болезнь невозможно вылечить. Но лекарство хотя бы помогает справляться с симптомами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "Чэнь Сян"
				},
				{
					"id": 220080112,
					"content": "Боюсь, что ей придётся принимать лекарство всю жизнь. А она ещё так молода... Даже думать об этом не хочу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "Чэнь Сян"
				},
				{
					"id": 220080113,
					"content": "Если бы я только могла забрать её болезнь себе... Нам остаётся лишь надеяться, что ей не станет хуже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "Чэнь Сян"
				},
				{
					"id": 220080114,
					"content": "#Путешественн{F#ица}{M#ик}, прошу тебя, принеси мне миндальный тофу. Одной порции будет достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чэнь Сян"
				},
				{
					"id": 220080115,
					"content": "Привет, Доудоу. Ты почему не хочешь пить лекарство?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "Оно такое горькое! А вот у Лулу лекарство совсем не горькое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "Хун Доу"
				},
				{
					"id": 220080117,
					"content": "Доудоу, Лулу с друзьями просто притворялись. Они пили не настоящее лекарство, а сладкую воду от миндального тофу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "Чэнь Сян"
				},
				{
					"id": 220080118,
					"content": "Значит мне не станет лучше от миндального тофу? Придётся пить это противное лекарство...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "Хун Доу"
				},
				{
					"id": 220080119,
					"content": "Хорошая девочка... Когда ты поправишься, ты сможешь есть всё, что захочешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "Чэнь Сян"
				},
				{
					"id": 220080120,
					"content": "Почему они не могут сделать лекарство со вкусом миндального тофу? Это нечестно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "Хун Доу"
				},
				{
					"id": 220080121,
					"content": "#Ох, бедная девочка... Путешественн{F#ица}{M#ик}, пожалуйста, принеси мне порцию миндального тофу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чэнь Сян"
				}
			]
		},
