			"dialogs": [
				{
					"id": 700190101,
					"content": "Yoyo dala si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190102
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700190102,
					"content": "Mimi tomo. Mimi mani ye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190103
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700190103,
					"content": "Yoyo mani mi? Mi muhe Upa Celi nini. Mi muhe mi nunu si, mi muhe mi nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190104
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700190104,
					"content": "Он сказал, что мечтает не видеть солнца. Сказал, что хочет заснуть и умереть. Почему же он так страдает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190105
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700190105,
					"content": "Biat. Mi muhe <color=#00E1FFFF>celi lata</color>. Mi nunu nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190106
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700190106,
					"content": "Может быть, ему станет лучше, если он получит, что хочет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элла Маск"
				}
			]
		},
