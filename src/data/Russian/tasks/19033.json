				"points": []
			},
			"dialogs": [
				{
					"id": 1903201201,
					"content": "Фух, как я устал. Наконец-то перерыв.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201202
					],
					"speakerTitle": "Чжоу Лян"
				},
				{
					"id": 1903201202,
					"content": "Кажись, я немного перестарался. Несколько человек здорово перепугались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201203
					],
					"speakerTitle": "Чжоу Лян"
				},
				{
					"id": 1903201203,
					"content": "Скажи, пожалуйста, ты кто?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201204
					]
				},
				{
					"id": 1903201204,
					"content": "А? Эй, тебе сюда нельзя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201205
					],
					"speakerTitle": "Чжоу Лян"
				},
				{
					"id": 1903201205,
					"content": "#Ай, проехали. Ты, наверное, всё слышал{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201206
					],
					"speakerTitle": "Чжоу Лян"
				},
				{
					"id": 1903201206,
					"content": "Я здесь работаю привидением, но сейчас у меня перерыв, поэтому я свой костюм снял. В нём так жарко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201207,
						1903201208
					],
					"speakerTitle": "Чжоу Лян"
				},
				{
					"id": 1903201207,
					"content": "Выходит, настоящих привидений здесь нет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				},
				{
					"id": 1903201209,
					"content": "А как же. Откуда здесь привидениям взяться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201210
					],
					"speakerTitle": "Чжоу Лян"
				},
				{
					"id": 1903201210,
					"content": "Ни мы, ни участники испытания видеть настоящих привидений не желаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201211
					],
					"speakerTitle": "Чжоу Лян"
				},
				{
					"id": 1903201211,
					"content": "Сюда приходят за атмосферой или же, скорее, за возможностью. Каждому охота пощекотать нервы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201212
					],
					"speakerTitle": "Чжоу Лян"
				},
				{
					"id": 1903201212,
					"content": "В опасной ситуации наружу выходят те слова и поступки, на которые обычно недостаёт храбрости. Для этого Испытание смелости и существует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201213,
						1903201214
					],
					"speakerTitle": "Чжоу Лян"
				},
				{
					"id": 1903201213,
					"content": "Я тоже так считаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201215,
					"content": "Так, мне пора возвращаться к работе. Желаю тебе и твоему другу хорошо провести время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжоу Лян"
				},
				{
					"id": 1903201214,
					"content": "(Это очень разочарует Чун Юня.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201208,
					"content": "Так это всё специально, чтобы пугать людей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				}
			]
		}
	]
}