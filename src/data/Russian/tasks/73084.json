			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Афрату"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730840101,
					"content": "Вы Пустынники, пришедшие по поручению, которое оставил я, Афрату? Если нет, пожалуйста, оставайтесь здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840102
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840102,
					"content": "Впереди очень опасно. Я поручил Цитадели Регзара прислать Пустынников разобраться с этим. Обычные люди не должны здесь находиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840103
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840103,
					"content": "Я махамата. Если с вами что-то случится, ответственность будет на мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840104,
						730840106
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840104,
					"content": "Мы не обычные люди.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840105
					]
				},
				{
					"id": 730840105,
					"content": "Все неопытные искатели приключений так говорят. Самоуверенность в пустыне может сыграть с вами злую шутку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840108
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840108,
					"content": "Видите вон ту огромную машину? Это реликвия легендарного древнего народа Дахри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840109
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840109,
					"content": "Дахри?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840110
					]
				},
				{
					"id": 730840110,
					"content": "Вероятно, вам больше знакомо слово Каэнри'ах? Дахри - это архаичное имя, которое мы любим использовать в Вахумане.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840111
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840111,
					"content": "Легенда гласит, что пятьсот лет назад Рыцарь Лебедя из Дах{RUBY#[S]Каэнри'ах}ри повёл эти машины против демонов, хлынувших из чёрной Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840112
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840112,
					"content": "После той войны осталось три голема руин. Они были запечатаны мудрецами. Это один из них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840113
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840113,
					"content": "Предполагается, что он пролежал здесь сотни лет, не двигаясь, но по неизвестной причине недавно он внезапно активизировался и начал атаковать людей, живущих неподалёку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840114
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840114,
					"content": "Он без разбору стреляет лазерной пушкой по всему живому. Впервые мы видим такую опасную способность у запечатанного голема руин и не можем её игнорировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840115
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840115,
					"content": "Ядра хаоса, обеспечивающие энергией эти машины, долгое время были деактивированы. Удивительно, что они всё ещё работоспособны спустя сотни лет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840116
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840116,
					"content": "Ядра хаоса? Очень похоже на стражей руин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730840117,
					"content": "Если вы знаете о стражах руин, мне будет проще всё объяснить. Голем руин - это увеличенная версия стража руин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840118
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840118,
					"content": "Отличие от стража руин состоит в том, что, хотя голем руин и оснащён автономной системой, он нуждается в управлении человеком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840119
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840119,
					"content": "Самое интересное, что мудрецы запечатали проход в голема руин при помощи потока суды, поэтому маловероятно, что кто-то смог активировать его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840120
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840120,
					"content": "Может быть, кто-то нашёл другой способ пробраться внутрь. Или, возможно, существует пусковое устройство, о котором мы не знаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840121
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840121,
					"content": "Единственный способ узнать это - заглянуть внутрь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840122
					]
				},
				{
					"id": 730840122,
					"content": "Всё верно, но Пустынники куда-то запропастились. Даже не знаю, чем они там заняты в Цитадели Регзара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840123
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840123,
					"content": "Печать Академии - это не проблема. Главная проблема - огромный камень, который блокирует вход в голема руин. Я один не могу убрать его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840124
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840124,
					"content": "Мы можем помочь решить эту проблему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730840125,
					"content": "#Разумеется, мы это сделаем за вознаграждение, которое причитается Пустынникам за это поручение. Верно, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730840126,
					"content": "Вы искатели приключений? Если вы простые жители, я не могу позволить вам рисковать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840127
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840127,
					"content": "Лазерная пушка - это не шутки. Если я позволю вам погибнуть понапрасну, даже не знаю, как сообщу об этом в Академию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840128,
						730840130
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840128,
					"content": "Мы официально зарегистрированные искатели приключений.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840129
					]
				},
				{
					"id": 730840129,
					"content": "В таком случае с формальностями разобрались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840132
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840132,
					"content": "В конце концов, мне нужно провести важное исследование, и я не могу стоять здесь вечно. Я оставляю за вами право быстро решить эту проблему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840133
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840133,
					"content": "Поручение состоит в том, чтобы проникнуть в голема руин, отключить его автономную систему и, если возможно, выяснить причину случившегося.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840134
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840134,
					"content": "Переключатель автономной системы, похоже, находится в кабине пилота. С помощью переключателя мы можем активировать ручной режим, но перед этим мы должны снять пломбу, чтобы войти в кабину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840135
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840135,
					"content": "Хм... Согласно записям, сила печати поддерживается механизмами под названием поток суды. Достаточно разрушить их, чтобы снять печать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840136
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840136,
					"content": "Только будьте осторожны, чтобы не повредить его внутреннюю структуру. В конце концов, это важная реликвия, зарегистрированная Академией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840137
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840137,
					"content": "Хе-хе, договорились. Мы всё сделаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730840130,
					"content": "Мы всемирно известные искатели приключений.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840131
					]
				},
				{
					"id": 730840131,
					"content": "Правда? Позже я свяжусь с Гильдией искателей приключений и всё уточню, а пока поверю вам на слово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840132
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840106,
					"content": "Там что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840107
					]
				},
				{
					"id": 730840107,
					"content": "Произошло нечто неожиданное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840108
					],
					"speakerTitle": "Афрату"
				}
			]
		},
		{
			"id": 7308402,
			"completionStepIds": [
				7308402,
				7308418
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"73026",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308402",
							"2"
						],
						"stepId": 7308402,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308418",
							"2"
						],
						"stepId": 7308418,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Афрату"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730840201,
					"content": "Вы Пустынники, пришедшие по поручению, которое оставил я, Афрату? Если нет, пожалуйста, оставайтесь здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840202
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840202,
					"content": "Впереди очень опасно. Я поручил Цитадели Регзара прислать Пустынников разобраться с этим. Обычные люди не должны здесь находиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840203
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840203,
					"content": "Я махамата. Если с вами что-то случится, ответственность будет на мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840204,
						730840206
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840204,
					"content": "Мы не обычные люди.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840205
					]
				},
				{
					"id": 730840205,
					"content": "Все неопытные искатели приключений так говорят. Самоуверенность в пустыне может сыграть с вами злую шутку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840208
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840208,
					"content": "Видите вон ту огромную машину? Это реликвия легендарного древнего народа Дахри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840209
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840209,
					"content": "Дахри?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840210
					]
				},
				{
					"id": 730840210,
					"content": "Вероятно, вам больше знакомо слово Каэнри'ах? Дахри - это архаичное имя, которое мы любим использовать в Вахумане.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840211
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840211,
					"content": "Легенда гласит, что пятьсот лет назад Рыцарь Лебедя из Дах{RUBY#[S]Каэнри'ах}ри повёл эти машины против демонов, хлынувших из чёрной Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840212
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840212,
					"content": "После той войны осталось три голема руин. Они были запечатаны мудрецами. Это один из них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840213
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840213,
					"content": "Предполагается, что он пролежал здесь сотни лет, не двигаясь, но по неизвестной причине недавно он внезапно активизировался и начал атаковать людей, живущих неподалёку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840214
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840214,
					"content": "Он без разбору стреляет лазерной пушкой по всему живому. Впервые мы видим такую опасную способность у запечатанного голема руин и не можем её игнорировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840215
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840215,
					"content": "Ядра хаоса, обеспечивающие энергией эти машины, долгое время были деактивированы. Удивительно, что они всё ещё работоспособны спустя сотни лет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840216
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840216,
					"content": "Паймон не поняла ни слова, но этот голем руин похож на того, что мы видели на горе Девантаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730840217,
					"content": "Но тот здоровяк не стал бы нападать на людей без разбора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730840218,
					"content": "О, вы знаете про голема руин. Значит, мне не нужно ничего объяснять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840219
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840219,
					"content": "Как вы знаете, его отличие от стража руин состоит в том, что, хотя голем руин и оснащён автономной системой, он нуждается в управлении человеком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840220
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840220,
					"content": "Самое интересное, что мудрецы запечатали проход в голема руин при помощи потока суды, поэтому маловероятно, что кто-то смог активировать его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840221
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840221,
					"content": "Может быть, кто-то нашёл другой способ пробраться внутрь. Или, возможно, существует пусковое устройство, о котором мы не знаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840222,
						730840227
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840222,
					"content": "Если бы Джазари был здесь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840223
					]
				},
				{
					"id": 730840223,
					"content": "Точно! Господин Джазари специализируется на големах руин! Если бы он был здесь, то поспешил бы поскорее пробраться внутрь и всё изучить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730840224,
					"content": "О, вы знакомы с Джазари? Да, он проводил некоторые исследования этих машин. Я просил его помочь с исследованием, но он, похоже, уединился и занят написанием чего-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840225
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840225,
					"content": "Возможно, именно в этом и заключается наивность Кшахревара? Если бы он уделял больше внимания внутренней работе Академии, то не остановился бы на дастуре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840226
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840226,
					"content": "Мы можем помочь с исследованием. Мы как-то уже помогали господину Джазари в его делах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730840231,
					"content": "#Разумеется, мы это сделаем за вознаграждение, которое причитается Пустынникам за это поручение. Верно, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730840232,
					"content": "Правда? Если вы уже таким занимались, ваша помощь будет очень кстати.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840233
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840233,
					"content": "Вот только, если вы не искатели приключений, а простые жители, я не могу позволить вам так рисковать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840234
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840234,
					"content": "Возможно, вы раньше и помогали исследовать подобные механизмы, но этот не похож на остальные. Его лазерная пушка - не шутки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840235
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840235,
					"content": "Если я позволю вам погибнуть понапрасну, я не знаю, как сообщу об этом в Академию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840236,
						730840238
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840236,
					"content": "Мы официально зарегистрированные искатели приключений.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840237
					]
				},
				{
					"id": 730840237,
					"content": "В таком случае с формальностями разобрались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840240
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840240,
					"content": "В конце концов, мне нужно провести важное исследование, и я не могу стоять здесь вечно. Я оставляю за вами право быстро решить эту проблему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840241
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840241,
					"content": "Поручение состоит в том, чтобы проникнуть в голема руин, отключить его автономную систему и, если возможно, выяснить причину случившегося.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840242
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840242,
					"content": "Переключатель автономной системы, похоже, находится в кабине пилота. С помощью переключателя мы можем активировать ручной режим, но перед этим мы должны снять пломбу, чтобы войти в кабину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840243
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840243,
					"content": "Хм... Согласно записям, сила печати поддерживается механизмами под названием поток суды. Достаточно разрушить их, чтобы снять печать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840244
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840244,
					"content": "Только будьте осторожны, чтобы не повредить его внутреннюю структуру. В конце концов, это важная реликвия, зарегистрированная Академией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840245
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840245,
					"content": "Хе-хе, договорились. Мы всё сделаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730840238,
					"content": "Мы всемирно известные искатели приключений.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840239
					]
				},
				{
					"id": 730840239,
					"content": "Правда? Позже я свяжусь с Гильдией искателей приключений и всё уточню, а пока поверю вам на слово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840240
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840227,
					"content": "Единственный способ узнать это - заглянуть внутрь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840228
					]
				},
				{
					"id": 730840228,
					"content": "Всё верно, но Пустынники куда-то запропастились. Даже не знаю, чем они там заняты в Цитадели Регзара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840229
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840229,
					"content": "Печать Академии - это не проблема. Главная проблема - огромный камень, который блокирует вход в голема руин. Я один не могу убрать его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840230
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840230,
					"content": "О, кажется, мы можем помочь. В конце концов, однажды мы уже были внутри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730840206,
					"content": "Там что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840207
					]
				},
				{
					"id": 730840207,
					"content": "Произошло нечто неожиданное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840208
					],
					"speakerTitle": "Афрату"
				}
			]
		},
		{
			"id": 7308403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Афрату"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730840301,
					"content": "Я махамата, который отвечает за эту область, но на самом деле меня отправили сюда на временное задание, потому что я был в экспедиции и случайно оказался поблизости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840302
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840302,
					"content": "Кроме того, я из Ваху{RUBY#[D]школа этиологии}маны. Мои знания о големах руин ограничиваются несколькими словами в учебниках истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840303
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730840303,
					"content": "Тем не менее если получится побольше узнать об истории древнего Дах{RUBY#[D]Каэнри'ах}ри, я смогу использовать это в моих будущих исследованиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Афрату"
				}
			]
		},
		{
			"id": 7308417,
			"completionStepIds": [
				7308417
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308417",
							"2"
						],
						"stepId": 7308417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Афрату"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730841701,
					"content": "Как обстоят дела? Я заметил некоторые изменения в поведении голема руин. Вам удалось попасть внутрь и отключить его автономную систему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841702,
						730841704
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730841702,
					"content": "Это было несложно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841703
					]
				},
				{
					"id": 730841703,
					"content": "Как здорово! Поручение выполнено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841706
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730841706,
					"content": "Вам удалось выяснить, почему он неожиданно активировался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841707
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730841707,
					"content": "Вы рассказываете Афрату о том, что обнаружили внутри голема руин.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730841708
					]
				},
				{
					"id": 730841708,
					"content": "Хм, заросли лиан? Это не характерно для экологии пустыни. Конечно, я не специалист, но, похоже, это как-то связано с артериями земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841709
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730841709,
					"content": "Я получал подобные сообщения о том, что руинные механизмы с повреждёнными ядрами могут «оживать» благодаря артериям земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841710
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730841710,
					"content": "Должно быть, существует множество связей между механизмами, созданными народом Дахри, и артериями земли, о которых мы пока что ничего не знаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841711
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730841711,
					"content": "Более того, печати древних мудрецов были созданы при помощи артерий земли, поэтому если с артериями земли произошли какие-то изменения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841712
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730841712,
					"content": "Если моё предположение верно, то проблемы возникнут со всеми запечатанными големами руин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841713
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730841713,
					"content": "Это сулит много проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841714
					]
				},
				{
					"id": 730841714,
					"content": "Я должен сообщить об этом в Академию. Одному мне не справиться с подобным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841715
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730841715,
					"content": "Целью моей поездки было исследование руин народа Дахри. Мне потребовалось немало сил и времени, чтобы получить разрешение Академии. Я даже связался с местной группой исследователей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841716
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730841716,
					"content": "Кто бы мог подумать, что, едва покинув город, я окажусь в такой передряге? Я не мог отказаться от выполнения прямого приказа Академии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841717
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730841717,
					"content": "Теперь, когда проблема решена, я могу продолжить своё исследовательское путешествие. Дальнейшую работу я оставлю тому, кого пришлёт Академия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841718
					],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730841718,
					"content": "Пожалуйста, возьмите своё вознаграждение. Если судьба будет к нам благосклонна, не сомневаюсь, что мы ещё встретимся в пустыне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Афрату"
				},
				{
					"id": 730841704,
					"content": "Мы его отключили.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841705
					]
				},
				{
					"id": 730841705,
					"content": "Ага, больше он не будет атаковать местных жителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841706
					],
					"speakerTitle": "Афрату"
				}
			]
		}
	]
}