			"dialogs": [
				{
					"id": 760510101,
					"content": "#{NICKNAME}, Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510102
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510102,
					"content": "Что такое, Коломбина? Похоже, тебя что-то беспокоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510103,
					"content": "У вас есть краска?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510104
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510104,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510105
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760510105,
					"content": "О! Ты... Маалаус, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510106,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510107
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760510107,
					"content": "Хочешь порисовать? Похоже, ты вымазалась в краске... Как это произошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510108,
					"content": "Маалаус ненадолго отлучилась и вернулась в таком виде. Думаю, краску будет нелегко смыть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510109
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510109,
					"content": "Может, Маалаус попала в беду, когда искала вдохновение?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510110,
					"content": "Впрочем, выглядит неплохо. Как настоящая художница!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510111,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510112
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760510112,
					"content": "Ах да, краски... Нам просто нужно дать Маалаусу что-нибудь цветное, да? Как в прошлый раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510113,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510114
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760510114,
					"content": "Хе-хе, что за счастливая куухенки! Маалаус, наверное, придумал что-то очень интересное... Что-то весёлое и оптимистичное, это точно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510115,
					"content": "Давайте найдём тёплые, радостные цвета!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
