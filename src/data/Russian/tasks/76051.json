			},
			"dialogs": [
				{
					"id": 760510301,
					"content": "Это подойдёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510302,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510303
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760510303,
					"content": "О! Сразу начала рисовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510304,
					"content": "Э-э... Уважаемые члены жюри, приготовьтесь восхищаться! Какой шедевр наша талантливая художница куухенки представит нам сегодня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510305,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510306
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760510306,
					"content": "Что? Уже закончила? Паймон не успела закончить своё вступление!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510307,
					"content": "Давай посмотрим. О! Ещё один портрет Коломбины. Ничего неожиданного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510308,
						760510309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510308,
					"content": "Очень красиво...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				},
				{
					"id": 760510310,
					"content": "Этот... лес где-то в Нод-Крае? Здесь так много милых зверушек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510311,
					"content": "Боюсь... чтобы увидеть это, тебе придётся вернуться во времена, когда я ещё не покинула Детей Морозной Луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510312
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510312,
					"content": "Ого, Паймон завидует! Милые маленькие животные и правда вот так собирались вокруг тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510313,
					"content": "Да, большинство из них привлекала куувяки вокруг меня. Они чувствовали себя в безопасности, устраиваясь поудобнее рядом со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510314
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510314,
					"content": "Это же круто! Можно было гладить их сколько угодно, и они не убегали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510315,
					"content": "Хм... Я бы сказала, что самые приятные на ощупь были барсуки-стиляги с большими пушистыми хвостами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510316
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510316,
					"content": "Шерсть на шее хладнорогого оленя тоже довольно мягкая, на неё было удобно класть голову.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510317
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510317,
					"content": "А вам что нравится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510318
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510318,
					"content": "Эм, у нас нет подобного опыта, чтобы судить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510319,
					"content": "Но, скорее всего, Паймон выбрала бы погладить хвост барсука-стиляги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510320,
					"content": "Барсуки-стиляги бывают довольно пугливыми. Если хочешь их погладить, сначала нужно, чтобы они почувствовали себя в безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510321
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510321,
					"content": "Ах... Но я бы побереглась, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510322
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510322,
					"content": "Почему? Они... кусаются или что? П-Паймон обещает быть очень ласковой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510323,
					"content": "Нет. Я имею в виду опасность свыше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510324
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510324,
					"content": "Опасность свыше?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510325,
					"content": "Да... Ибисы часто охотятся на маленьких животных. Мне пришлось вынести им предупреждение, чтобы они перестали преследовать куухенки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510326
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510326,
					"content": "Ты только сейчас рассказываешь об этом Паймон?! Чудо, что Паймон ещё не унесли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510327,
					"content": "Ах... В следующий раз, когда я увижу их, скажу, что тебя тоже нельзя трогать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510328
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510328,
					"content": "В следующий раз? Нет, найди их прямо сейчас, иначе Паймон побоится выйти наружу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510329,
					"content": "В таком случае я обязательно скажу им, что Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510330,
						760510332,
						760510334
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510330,
					"content": "Самый лучший компаньон!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510331
					]
				},
				{
					"id": 760510331,
					"content": "Именно! Они не могут просто так похищать компаньонов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510336,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510337
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 760510337,
					"content": "Малышку... кажется, заинтересовала идея о том, что ибис может унести Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510338
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760510338,
					"content": "Даже не вздумай рисовать такую картинку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510332,
					"content": "Лучший проводник во всём Тейвате.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510333
					]
				},
				{
					"id": 760510333,
					"content": "Э-э... Паймон рада, что ты так думаешь, но... Они, наверное, даже не знают, что такое «проводник».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510334,
					"content": "Обычный источник пропитания, который приводит к расстройству желудка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510335
					]
				},
				{
					"id": 760510335,
					"content": "Нет, даже не вкладывай им эту мысль в голову! А вдруг они решат рискнуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760510309,
					"content": "#При взгляде на него я чувствую себя {F#счастливой}{M#счастливым}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				}
			]
		},
