							14.845
						],
						"pointId": 237
					},
					{
						"sceneId": 1004,
						"position": [
							-19.315,
							0,
							14.928
						],
						"pointId": 238
					}
				]
			},
			"dialogs": [
				{
					"id": 401440101,
					"content": "О, это ты, милашка! Чем обязана твоему визиту?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440102
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440102,
					"content": "#Хочешь книгу в библиотеке взять? Или, может быть, {M#соскучился}{F#соскучилась} по кое-кому?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440103,
						401440105
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440103,
					"content": "Мы пришли к тебе в гости.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440104
					]
				},
				{
					"id": 401440104,
					"content": "#Хе-хе, ты всё {M#такой же заботливый}{F#такая же заботливая}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440107,
					"content": "Увы, не везёт... У меня сейчас куча важных дел. Угощу вас послеобеденным чаем в другой раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440108
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440108,
					"content": "О, ты действительно занята... работой? Редкое событие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401440109,
					"content": "Ха-ха, верно. Последний раз я была так поглощена исследованиями, наверное, только в Академии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440110
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440110,
					"content": "Я давно так много не размышляла. Это довольно утомительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440111,
						401440112
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440111,
					"content": "Пишешь научную работу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440113,
					"content": "Если интересуешься, почему бы тебе не присоединиться к веселью?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440114
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440114,
					"content": "Что скажешь? Хочешь облегчить мою участь учёного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440115
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440115,
					"content": "Не очень-то вежливо перекладывать свою работу на других!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401440116,
					"content": "#Значит, отказываешься, {NICKNAME}? Была бы редкая возможность поработать вместе... И вознаграждение хорошее. Но если не хочешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440117,
						401440118
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440117,
					"content": "Рассказывай, что надо делать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440119,
					"content": "Как ты, вероятно, знаешь, рыцари Ордо Фавониус уже давно проводят исследования в области алхимии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440120
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440120,
					"content": "Но большая часть исследований проводилась в лабораторных условиях. Обычные люди об алхимии практически ничего не знают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440121
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440121,
					"content": "А это значит, что до сих пор многие наши исследования и открытия не использовались в повседневной жизни. Мы вложили немало моры в исследования, но наши успехи не на виду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440122
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440122,
					"content": "Заметив такое несоответствие, Джинн решила, что отныне мы будем делиться результатами своего труда с обычными людьми. Пока мы представили несколько видов алхимических зелий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440123
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440123,
					"content": "У меня уже есть опыт в этой сфере. Хотя обычно я работаю в библиотеке, в прошлом я помогала управлять запасами зелий для рыцарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440124
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440124,
					"content": "Зельеварение было в числе моих научных специализаций в те времена, поэтому Джинн решила, что я лучше всех подхожу для такой работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440125
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440125,
					"content": "Но чтобы создать зелья, необходимые в повседневной жизни, нужно было внести множество изменений в используемые ингредиенты, а также упростить весь алхимический процесс...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440126
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440126,
					"content": "В общем, то, что начиналось как относительно простой исследовательский проект, вскоре превратилось в сложную задачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440127
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440127,
					"content": "Хочешь, чтобы мы помогли с исследованиями? Ты понимаешь, мы в алхимии-то не эксперты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401440128,
					"content": "Не беспокойтесь. Я придумала для вас подходящую работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440129
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440129,
					"content": "Алхимические технологии становятся всё более продвинутыми, но широкая общественность не особо знает о наших исследованиях. Нам нужно собрать отзывы людей. Иначе мы не узнаем, удовлетворяем ли мы их потребности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440130
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440130,
					"content": "Но если мы хотим одновременно проводить исследования и собирать отзывы, нам нужно действовать более эффективно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440131
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440131,
					"content": "Я решила, что лучшим решением будет открыть магазин зелий! Таким образом, мы сможем продолжать заниматься алхимией и в то же время будем общаться с людьми и изучим их потребности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440132
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440132,
					"content": "О! Убить двух зайцев одним выстрелом! Отличная идея, Лиза!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401440133,
					"content": "#Ну, конечно же! И лучше всех справится самый опытный из нас. {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440134
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440134,
					"content": "Когда я училась в Академии, студенты часто помогали друг другу в исследовательских проектах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440135
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440135,
					"content": "Уверена, мои милашки не упустят возможность. Вы сможете испытать пыл юношеского задора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440136
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440136,
					"content": "Говоришь красиво, но Паймон всё равно кажется, что ты хочешь свалить на нас свою работу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440137,
						401440139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401440137,
					"content": "Можем считать, что оказываем Лизе услугу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440138
					]
				},
				{
					"id": 401440138,
					"content": "Я знала, что могу на тебя рассчитывать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440141,
					"content": "Когда закончим с делами, я лично прослежу, чтобы вы были щедро вознаграждены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440142
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440142,
					"content": "Первоначальные приготовления сделаны. Сейчас отправимся в магазин. Поговорим на месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440139,
					"content": "#Я всегда готов{F#а} к испытаниям.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440140
					]
				},
				{
					"id": 401440140,
					"content": "Мне нравится твой энтузиазм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440118,
					"content": "Сначала хочу узнать подробности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440112,
					"content": "Работаешь над исследовательским проектом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440105,
					"content": "Мимо проходили...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440106
					]
				},
				{
					"id": 401440106,
					"content": "И решили заглянуть ко мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Лиза"
				}
			]
		},
