			"dialogs": [
				{
					"id": 401440201,
					"content": "Вот мы и в магазине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440202
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440202,
					"content": "Ого! Ты уже немало сделала! Неужели всё сама?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401440203,
					"content": "Это результат совместной работы всех рыцарей Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440204
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440204,
					"content": "Джинн собрала первоначальные средства для открытия магазина. Альбедо и Сахароза предоставили ингредиенты и оборудование, необходимые для приготовления зелий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440205
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440205,
					"content": "Логистический союз взялся осуществлять все будущие поставки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440206
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440206,
					"content": "А с вашей помощью будет ещё легче. Будто груз с плеч упал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440207
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440207,
					"content": "Рыцари последние несколько дней всем рассказывали о нашем магазине. Мы должны быть готовы к открытию, как только закончим последние приготовления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440208
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 401440208,
					"content": "Ладно, не будем медлить. Возьмите эти ингредиенты и попробуйте сварить зелье, хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лиза"
				}
			]
