			},
			"dialogs": [
				{
					"id": 741460201,
					"content": "#...Вычисления остановлены. {M#Господин}{F#Госпожа} {NICKNAME}, какими будут ваши распоряжения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460202,
						741460209,
						741460214,
						741460220
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460202,
					"content": "Расскажи о текущей обстановке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460203
					]
				},
				{
					"id": 741460203,
					"content": "В результате общения с океанидой Анн и уцелевшим членом Ордо Нарциссенкрейц была получена достоверная информация.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460204
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460204,
					"content": "Я прототип 4ACV07, сконструирован Гильотеном для защиты и сопровождения моей хозяйки, госпожи Мари-Анн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460205
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460205,
					"content": "К сожалению, в данный момент невозможно получить больше данных о госпоже Мари-Анн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460206
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460206,
					"content": "Океанида Анн могла предоставить очень небольшое количество информации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460207
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460207,
					"content": "Уцелевший член Ордо Нарциссенкрейц Катерпиллер предоставил в моё распоряжение не всю имеющуюся информацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460208
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460208,
					"content": "Требуется больше времени для анализа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460209,
					"content": "Я хочу узнать больше о Сеймуре.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460210
					]
				},
				{
					"id": 741460210,
					"content": "Я прототип 4ACV07, сконструирован Гильотеном для защиты и сопровождения моей хозяйки, госпожи Мари-Анн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460211
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460211,
					"content": "Я оснащён оптическим устройством, блоком памяти, логическим блоком и различными функциональными модулями по последнему слову техники Института натурфилософии Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460212
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460212,
					"content": "Это позволяет мне не только записывать информацию о повседневной жизни госпожи Мари-Анн, но и выступать в качестве помощника агента.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460213
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460213,
					"content": "Моя приоритетная цель на данный момент: найти госпожу Мари-Анн и обеспечить её безопасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460214,
					"content": "Мне хотелось бы больше узнать о Мари-Анн...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460215
					]
				},
				{
					"id": 741460215,
					"content": "Я был разработан для того, чтобы сопровождать и защищать мою хозяйку, госпожу Мари-Анн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460216
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460216,
					"content": "Моя приоритетная цель на данный момент: найти госпожу Мари-Анн и обеспечить её безопасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460217
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460217,
					"content": "В поведении океаниды Анн частично проявляются черты, схожие с поведением госпожи Мари-Анн в прошлом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460218
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460218,
					"content": "Но составляющие их элементы... (механический шум), ... (механический шум).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460219
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460219,
					"content": "Подсказка: регулярная дефрагментация пространства записей эффективно снижает шанс возникновения подобных неполадок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 741460220,
					"content": "Распоряжений нет, счастливо оставаться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460221
					]
				},
				{
					"id": 741460221,
					"content": "#Принято. Удачи, {M#господин}{F#госпожа} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сеймур"
				}
			]
		},
		{
			"id": 7414603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7414601",
							"2"
						],
						"stepId": 7414601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерпиллер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741460301,
					"content": "Привет. Хочешь ещё что-нибудь обсудить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460302,
						741460311,
						741460317,
						741460324
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460302,
					"content": "Как ты сейчас?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460303
					]
				},
				{
					"id": 741460303,
					"content": "Отлично, спустя сотни лет здесь наконец-то снова кипит жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460304
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460304,
					"content": "Шучу. Думаю, что наша встреча произошла неслучайно. Было бы слишком глупо и скучно списать её на обычное совпадение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460305
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460305,
					"content": "Наша встреча должна быть знаком какого-то нового начала - подобно тому, как набухает бутон, перед тем как сокрытое в нём существо вырвется наружу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460306
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460306,
					"content": "Но до того как наступит истинный конец, кто сможет узреть смысл среди нелепиц и поверить, что подобные явления знаменуют приход торжественного часа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460307
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460307,
					"content": "Кроме Нарциссенкрейца... В прошлом я называл его хозяином, но ничто не мешает назвать его наставником.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460308
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460308,
					"content": "Прямо как наши пути пересеклись под часами Судного дня. Может, если мы пройдём по этому сплетенью дорог, то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460309
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460310
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460310,
					"content": "Об остальном лучше поведать, когда мы достигнем конца пути...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460311,
					"content": "Мне хотелось бы больше узнать о тебе, Катерпиллер...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460312
					]
				},
				{
					"id": 741460312,
					"content": "А что про меня говорить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460313
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460313,
					"content": "Я чувствую, что в моей природе присутствуют противоречащие друг другу сущности. Каждая из них по отдельности чиста, но по отношению друг к другу они инородны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460314
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460314,
					"content": "Поэтому когда они смешиваются, то загрязняют друг друга. Ты можешь понять, о чём я?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460315
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460315,
					"content": "Моя суть ненадёжна... Иногда я храбрец, иногда злой дракон. Моя личность - возведённая из чужих рассказов ложь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460316
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460316,
					"content": "Но я верю, что ответ есть, единственно верный ответ. Стрелки часов снова движутся, и я готов сделать этот шаг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460317,
					"content": "Расскажи о Лануар...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460318
					]
				},
				{
					"id": 741460318,
					"content": "Это было так недолго... Я и не думал, что мне так сильно захочется играть роль её защитника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460319
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460319,
					"content": "Это такой необычный опыт. Возможно, меня привлекла её чистота, ведь как раз это качество мне недоступно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460320
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460320,
					"content": "Но её чистоту сохранила крепость Меропид... Совершенно недостойное её место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460321
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460321,
					"content": "Чтобы дать ей шанс сделать выбор, пришлось сначала отнять у неё само право выбирать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460322
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460322,
					"content": "А теперь грешный мир уже оставил следы в её сердце...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460323
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460323,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 741460324,
					"content": "Поговорим позже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460325
					]
				},
				{
					"id": 741460325,
					"content": "Я буду здесь, пока не настанет время отправиться в путь.",
