				"objectNames": [
					"Анн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741460101,
					"content": "#Рыцарь {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460102,
						741460107,
						741460114,
						741460120
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460102,
					"content": "Про текущую обстановку...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460103
					]
				},
				{
					"id": 741460103,
					"content": "Мне что-то приходит на ум... Какие-то смутные ощущения. Не знаю, можно ли назвать это воспоминаниями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460104
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460104,
					"content": "Хотя неясно, что служит людям хранилищем памяти - мозг или сердце...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460105
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460105,
					"content": "Но у океанидов ведь нет ни того, ни другого, одна только вода...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460106
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460106,
					"content": "Как было бы здорово, если бы я могла просто сидеть здесь и бормотать про дефрагментацию данных, как этот глупый пёс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460107,
					"content": "Мне хотелось бы больше узнать об Анн...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460108
					]
				},
				{
					"id": 741460108,
					"content": "Я не знаю, что ещё могу тебе сообщить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460109
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460109,
					"content": "Я - воплощённая часть «Мари-Анн», но... Она отказалась от меня и от других людей... то есть существ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460110
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460110,
					"content": "Принцессы Лирис, которую я пыталась спасти, не существует, и даже «Мари-Анн» вовсе не Мари-Анн и не хозяйка этой глупой собаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460111
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460111,
					"content": "Не знаю почему, но при виде этого пса у меня внутри что-то поднимается... Как будто надувается пузырь, готовый лопнуть, когда вернутся воспоминания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460112
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460112,
					"content": "Катерпиллер, похоже, что-то знает, но не хочет рассказывать то, в чём не уверен полностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460113
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460113,
					"content": "Даже после прихода в Нарциссенкрейц ничего яснее не стало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460114,
					"content": "Мне хотелось бы больше узнать о принцессе Лирис...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460115
					]
				},
				{
					"id": 741460115,
					"content": "Принцесса Лирис - добрая и смелая, поэтому она готова попасть в неприятности, лишь бы помочь друзьям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460116
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460116,
					"content": "Раньше я думала, что и я когда-то была спутницей под её защитой. А значит, отправиться ей на выручку, когда она попала в беду, - мой долг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460117
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460117,
					"content": "Она, возможно, и не хотела бы, чтобы я бралась за её спасение. Ведь она так добра, что скорее подвергнет опасности себя, чем друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460118
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460118,
					"content": "Но разве могла я остаться в стороне и по-прежнему считать себя её другом и быть достойной её защиты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460119
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460119,
					"content": "Мои «воспоминания» такие же неуловимые, как водовороты на морской глади. А вот чувства и желания так реальны. Даже сейчас, когда я знаю, что она только персонаж истории...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анн"
				},
				{
					"id": 741460120,
					"content": "Тебе стоит отдохнуть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460121
					]
				},
				{
					"id": 741460121,
					"content": "#Спокойной ночи, рыцарь {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анн"
				}
			]
		},
		{
			"id": 7414602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
