				"objectNames": [
					"Киспе"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300101,
					"content": "О Архонты, у нас не хватает людей и припасов. Я не могу обработать и половины ран...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300102
					],
					"speakerTitle": "Киспе"
				},
				{
					"id": 50300102,
					"content": "Если бы только нам помог кто-то более опытный... Нет-нет, сейчас не время ворчать. Выше нос!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Киспе"
				}
			]
		},
		{
			"id": 503002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"503002",
							"2"
						],
						"stepId": 503002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Авхина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300201,
					"content": "Я видела, что вы привели Куичи... Мне очень жаль. Она действительно перспективный молодой врач.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300202
					],
					"speakerTitle": "Авхина"
				},
				{
					"id": 50300202,
					"content": "Мы с ней много раз сотрудничали. Она очень серьёзно относится к качеству лекарств. Иногда она даже платит из собственного кармана, чтобы вылечить пациентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300203
					],
					"speakerTitle": "Авхина"
				},
				{
					"id": 50300203,
					"content": "Она всегда говорила, что для неё опыт важнее денег.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300204
					],
					"speakerTitle": "Авхина"
				},
				{
					"id": 50300204,
					"content": "Только овладев самыми совершенными навыками врачевания, она сможет спасти больше людей. А главное вылечить человека, которого она больше всего хочет спасти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300205
					],
					"speakerTitle": "Авхина"
				},
				{
					"id": 50300205,
					"content": "Какая жалость. Доктор не может исцелить себя сам. И теперь Натлан потерял одного из самых талантливых людей поколения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Авхина"
				}
			]
		},
