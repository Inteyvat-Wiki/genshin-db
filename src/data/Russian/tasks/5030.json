				"points": []
			},
			"dialogs": [
				{
					"id": 50300801,
					"content": "Это вы! Спасибо вам за поддержку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300802
					],
					"speakerTitle": "Утурунку"
				},
				{
					"id": 50300802,
					"content": "Многие в Натлане считают сражения с Бездной за честь, но эмоции заставляют их действовать опрометчиво. Они попадают в опасные ситуации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300803
					],
					"speakerTitle": "Утурунку"
				},
				{
					"id": 50300803,
					"content": "Вы были правы: важно бороться, но также важно оставаться в живых. Мы сражаемся за людей, которых любим, а также за возможность увидеть их снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300804
					],
					"speakerTitle": "Утурунку"
				},
				{
					"id": 50300804,
					"content": "Я поделился вашими мыслями со своими братьями по оружию, и они тоже вдохновились. Теперь все сражаются с большей решимостью, и мы переломили ход событий!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300805
					],
					"speakerTitle": "Утурунку"
				},
				{
					"id": 50300805,
					"content": "Так что ещё раз... спасибо вам от всего сердца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Утурунку"
				}
			]
		},
