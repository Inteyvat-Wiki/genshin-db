			"dialogs": [
				{
					"id": 411410101,
					"content": "#Ну, я {M#пошёл}{F#пошла}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411410102
					]
				},
				{
					"id": 411410102,
					"content": "Хорошо, поторопись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411410103
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 411410103,
					"content": "Постарайся <color=#00E1FFFF>во что бы то ни стало избегать монстров. Если на тебя попадут странные элементы или слишком сильно ударят, то еде конец</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411410104
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 411410104,
					"content": "Если еда испортится, то клиент её не примет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411410105
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 411410105,
					"content": "Ладно, давай резво. Не заставляй клиентов ждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
