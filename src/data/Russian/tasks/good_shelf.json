			"dialogs": [
				{
					"id": 790730101,
					"content": "Добро пожаловать! Приветствую вас в лесу Благословений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730102
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730102,
					"content": "Вы держите путь в лес или хотите посетить соревнования по прыжкам в Пруд песни дождя? В любом случае желаю вам удачи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сю Ди"
				}
			]
		},
		{
			"id": 7907303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4016401",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сю Ди"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730301,
					"content": "Старайтесь избегать дракона, который может нагрянуть, когда угодно. Не позволяйте ему задерживать ваше путешествие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730302
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730302,
					"content": "Я уже подумывал дать дракону несколько бумажных моделек. Это могло бы поднять ему настроение. Незачем беспорядок на моих полках устраивать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730303
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730303,
					"content": "Но... этот дракон явно не желал внимать моим крикам и каждый раз улетал восвояси...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сю Ди"
				}
			]
		},
		{
			"id": 7907304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4016401",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сю Ди"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730401,
					"content": "Но теперь нам незачем беспокоиться о внезапных визитах дракона. Вы как раз вовремя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730402
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730402,
					"content": "Говорят, у дракона нынче добрый нрав.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730403
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730403,
					"content": "Хочу прихватить с собой несколько бумажных моделек и навестить его. Надеюсь, дракону понравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сю Ди"
				}
			]
		},
		{
			"id": 7907305,
			"completionStepIds": [
				7907301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сю Ди"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730501,
					"content": "Ох! Совсем забыл рассказать вам о своих выдающихся работах и этой особенной полке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730502
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730502,
					"content": "Вы только взгляните! В этом Чудесном автомате лежат все бумажные модельки, которые я придумал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730503
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730503,
					"content": "Чтобы их сделать, я ходил... ой, скорее, прыгал по всему миру и завёл немало друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730504
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730504,
					"content": "Например, белка-летяга Кланш, который так и норовил утянуть меня в ветряной поток, чтобы я попробовал полетать. Девитт, который любит моделирование так же, как и я... О, и, конечно же, вечно серьёзный Алоф.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730505
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730505,
					"content": "Они великодушно согласились стать прототипами для моих бумажных моделек. Теперь я могу делиться этими забавными безделушками со всеми!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730506
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730506,
					"content": "Возьмите эти астромонеты, считайте их приветственным подарком. Положите их в Чудесный автомат и поверните ручку. А потом посмотрите, какой подарок преподнесут вам капли росы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730507
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730507,
					"content": "Если захотите продолжить игру после того, как закончатся монеты, придётся добывать их самостоятельно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730508
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730508,
					"content": "А как добыть монеты.... Ха-ха-ха, вам подскажут мои хорошие друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730509
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730509,
					"content": "Полученные подарки вы можете поставить на хорошую полку позади меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730510
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730510,
					"content": "А если серьёзно, то именно эта полка вдохновила меня на создание Чудесного автомата и бумажных моделек...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730511
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730511,
					"content": "Но это длинная история... Если захотите, я обязательно вам её расскажу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730512
					],
					"speakerTitle": "Сю Ди"
				},
				{
					"id": 790730512,
					"content": "А теперь крутите Чудесный автомат! Во имя росы, желаю вам не только получить желанный подарок, но и зарядиться хорошим настроением на весь день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сю Ди"
				}
			]
		}
	]
}