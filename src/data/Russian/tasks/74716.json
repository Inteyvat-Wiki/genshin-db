					}
				]
			},
			"dialogs": [
				{
					"id": 747160101,
					"content": "Отлично... Основную часть подводной свалки мы разобрали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160102
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747160102,
					"content": "#Вы мне очень помогли, {NICKNAME} и Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160103
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747160103,
					"content": "Да ну, перестань! Мы даже не устали. И это погружение принесло нам много находок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160104,
						747160105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747160104,
					"content": "Мы помогли восстановить подводную среду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				},
				{
					"id": 747160106,
					"content": "Спасибо вам... Я провёл время весело и с пользой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160107
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747160107,
					"content": "Не благодари! К тому же Паймон считает, что Фремине тоже очень вырос за последнее время! Ты стал надёжным помощником и на суше, и под водой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747160108,
					"content": "Только не смущайся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160109
					]
				},
				{
					"id": 747160109,
					"content": "Х-хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160110
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747160110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160111
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747160111,
					"content": "Простите, я не знаю, что сказать, кроме обычного «спасибо».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160112
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747160112,
					"content": "Возможно... мне нужно ещё немного практики?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160113
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747160113,
					"content": "Не торопись, спешить тут некуда. Даже если это обычная тренировка, двигайся в своём ритме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160114,
						747160115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747160114,
					"content": "Если будет такая возможность, поработаем вместе как-нибудь ещё.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160116,
					"content": "Да... хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160117
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747160117,
					"content": "...Я думал, что после расчистки дна мне нужно будет побыть какое-то время в одиночестве под водой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160118
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747160118,
					"content": "Вот странно, после разговора с вами... даже небо кажется таким спокойным. Я хотел... поделиться с вами своими чувствами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160119
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747160119,
					"content": "Ну... я пойду к Лини и остальным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160120
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747160120,
					"content": "Все прочие данные подводной разведки оставляю вам. Надеюсь, вы найдёте то, что ищете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160121
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747160121,
					"content": "Ух ты, я ещё наверху услышала, как вы радуетесь. Что-то хорошее случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160122
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747160122,
					"content": "Ага! Мы выловили почти весь мусор, который мешал рыбкам, и ещё нашли оставшиеся части фортепиано!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747160123,
					"content": "Да? Посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160124
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747160124,
					"content": "...И правда. Всё на месте. Теперь я смогу починить фортепиано.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160125
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747160125,
					"content": "Да, вряд ли оно станет таким, как было, но научить его снова играть красивую музыку я смогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160126
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747160126,
					"content": "Ты выглядишь такой счастливой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747160127,
					"content": "Д-да? Ну и ладно, сейчас я возьмусь за починку, это не займёт много времени. А вы пока помогите мне здесь всё украсить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160128
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747160128,
					"content": "Такому роскошному инструменту нужна подходящая сцена, ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160129
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747160129,
					"content": "Она и правда счастлива...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747160130,
					"content": "Ого! Какое красивое фортепиано!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160131,
						747160132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747160131,
					"content": "Очень изящное!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160133,
					"content": "Хм, а то. Ведь это я его починила. Я ещё и механические соединения усилила, и корпус подновила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160134
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747160134,
					"content": "Вы тоже неплохо поработали. Такая сцена ему очень подходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160135
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747160135,
					"content": "Да ну, мелочи! Ладно, хватит разговоров. Давай лучше ты нам что-нибудь сыграешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747160136,
					"content": "...А? Прямо сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160137
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747160137,
					"content": "А когда? Ты ведь починила фортепиано, чтобы играть на нём, разве нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160138
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747160138,
					"content": "Сегодня... пожалуй, не стоит! Лучше как-нибудь в другой раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160139,
						747160140
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747160139,
					"content": "Забыла ноты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160141,
					"content": "Хм... Надоело! Я просто хочу побыть с ним наедине и спокойно вспомнить прошлое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160142
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747160142,
					"content": "Вы правда думаете, что от пары дурацких провокаций я возьму и соглашусь? Ха, идите потренируйтесь ещё немного, тогда и поговорим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747160140,
					"content": "Стесняешься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160132,
					"content": "Какое роскошное!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160115,
					"content": "Если понадобится помощь, мы всегда рядом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160105,
					"content": "И нашли много прекрасных сокровищ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				}
			]
		}
	]
}