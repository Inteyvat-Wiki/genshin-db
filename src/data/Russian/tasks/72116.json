			"trigger": {
				"objectNames": [
					"Ксавье"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721160101,
					"content": "Это займёт какое-то время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160102
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160102,
					"content": "Тебе удалось собрать все необходимые данные?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160103
					]
				},
				{
					"id": 721160103,
					"content": "А, это ты! Прекрасно. Мы пока собрали не все необходимые данные. Думаю, потребуется ещё немного времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160104
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160104,
					"content": "Но и мне тоже нужно время, чтобы обдумать наш аварийный очиститель...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160105,
						721160107
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160105,
					"content": "А что это такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160106
					]
				},
				{
					"id": 721160106,
					"content": "Я просто решил провернуть кое-какой фокус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160109,
					"content": "Как ты помнишь из наших предыдущих разговоров, мы должны решить сразу две проблемы: Фатуи и энергия Татаригами в горне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160110
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160110,
					"content": "Я не сомневаюсь, что с Фатуи ты справишься. Значит, моя задача - справиться с Татаригами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160111
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160111,
					"content": "Специально для её выполнения я собрал этот аварийный очиститель. Однако чтобы он заработал, мне опять нужна твоя помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160112,
						721160113
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160112,
					"content": "Какая?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160117
					]
				},
				{
					"id": 721160117,
					"content": "В любом случае для того, чтобы это устройство могло правильно функционировать внутри горна, мне потребуются особые материалы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160118
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160118,
					"content": "Кристальный костный мозг содержит инертную форму такой же энергии Татаригами и очень пригодится мне для решения этой задачи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160119
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160119,
					"content": "По правде сказать, секрет знаменитой нефритовой стали как раз и заключается в том, что во время горячей обработки в металл добавляют именно этот материал, который значительно повышает прочность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160120
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160120,
					"content": "Конечно же, есть особый метод, который является коммерческой тайной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160121
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160121,
					"content": "Если память меня не подводит, эту кристаллическую руду можно найти поблизости. Пожалуйста, принеси мне три куска руды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160122
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160122,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160123
					]
				},
				{
					"id": 721160123,
					"content": "Отлично, большое спасибо. Не забудь: найди и принеси мне три куска кристального костного мозга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160113,
					"content": "#Я думал{F#а}, у него есть какое-то официальное название...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160114
					]
				},
				{
					"id": 721160114,
					"content": "Так это и есть официальное название - аварийный очиститель!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160115
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160115,
					"content": "Разве что... Ты имеешь в виду официальный код продукта и дату производства?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160116
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160116,
					"content": "Ну, поскольку устройство чисто аварийное, эти параметры ему не нужны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160117
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721160107,
					"content": "А это тоже относится к числу «аварийных мер»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160108
					]
				},
				{
					"id": 721160108,
					"content": "Пожалуй, да, хотя в обычной ситуации при обслуживании клиентов я бы воздержался от помощи такого рода...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Ксавье"
				}
			]
		},
