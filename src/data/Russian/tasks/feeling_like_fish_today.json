						],
						"pointId": 8778
					}
				]
			},
			"dialogs": [
				{
					"id": 750150401,
					"content": "#Ну, что Паймон говорила? Если кто и сможет одолеть этого скользкого противника, так это {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750150402,
					"content": "Кстати, о навыках: если бы мы просто закинули всю наживку и позволили рыбе наесться досыта, чтобы она перевернулась и всплыла на поверхность... это ведь всё равно считалось бы «рыбалкой», верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750150403,
					"content": "Р-р-р... Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150404
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150404,
					"content": "#Значит, {REALNAME[ID(2)|SHOWHOST(true)]} тоже так считает? Паймон может сказать это по тому, как сверкают твои глаза! Хе-хе, давай так и сделаем в следующий раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750150405,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150406,
					"content": "#Погоди, ещё не готово! Нужно подождать, пока {NICKNAME} закончит жарить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750150407,
					"content": "Как только рыба будет готова, все сядут за стол и съедят свою порцию.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150408
					]
				},
				{
					"id": 750150408,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150409
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150409,
					"content": "Ах... Жареная рыба - это нечто особенное. А тот факт, что Паймон её поймала, делает рыбу ещё вкуснее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750150410,
					"content": "Отличная работа, Паймон! Отныне рыбалка на тебе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150411
					]
				},
				{
					"id": 750150411,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750150412,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150413,
					"content": "#Кто не работает, тот не ест. Понятно, {REALNAME[ID(2)|SHOWHOST(true)]}? В следующий раз тебе придётся помочь, если хочешь полакомиться рыбой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750150414,
					"content": "Р-р-р?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150415
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150415,
					"content": "Смотрите-ка, кто прикидывается дурачком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
