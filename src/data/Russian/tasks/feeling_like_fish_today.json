			},
			"dialogs": [
				{
					"id": 750150101,
					"content": "Ух ты, какая сильная рыба. Как она вообще может плавать так быстро после такой долгой борьбы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750150102,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150103,
					"content": "#Не волнуйся, {NICKNAME} обязательно поймает рыбу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
