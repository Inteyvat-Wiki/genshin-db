						],
						"pointId": 14157
					}
				]
			},
			"dialogs": [
				{
					"id": 761150201,
					"content": "...Я вас не трогал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150202
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761150202,
					"content": "Значит, ты понимаешь, зачем мы здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150203
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761150203,
					"content": "...Это было давно. Теперь я хочу лишь спокойно жить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150204
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761150204,
					"content": "Отбирая чужую жизнь? Сначала с Юхани ничего не вышло, а потом Дервент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150205
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761150205,
					"content": "Но всё тайное становится явным. Больше никто не пострадает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150206
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761150206,
					"content": "...Юхани? Я хотел стать им?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150207
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761150207,
					"content": "Он был никем... Имел что-то? Только потому, что он милее выглядит и умеет льстить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150208
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761150208,
					"content": "Мы с ним одинаковые! Всё, что он брал, всегда принадлежало мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150209
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761150209,
					"content": "А господин Дервент и торговец? Что они сделали тебе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150210
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761150210,
					"content": "...Они? Они задавали вопросы, которых задавать не стоило. Как и вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150211
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761150211,
					"content": "Умрите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дервент"
				}
			]
		},
