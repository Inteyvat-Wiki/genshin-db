				]
			},
			"dialogs": [
				{
					"id": 761150301,
					"content": "Жалкие люди, застрявшие во вчерашнем дне... Как я и думала, скучновато.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150302
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761150302,
					"content": "Столько лет он держался, не делал зла, но в итоге всё равно сорвался... Или он всегда был злодеем? Раз плохой, значит, уже не изменится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150303,
						761150304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761150303,
					"content": "Делать добро куда труднее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				},
				{
					"id": 761150305,
					"content": "Даже сейчас он мог признать свою вину и раскаяться. Но опять пошёл по кривой дорожке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150306
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761150306,
					"content": "Ошибки тянулись одна за другой - и вот финал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150307
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761150307,
					"content": "#Хватит разговоров. Ещё одно дело закрыто. Доказательства по заказу пусть {NICKNAME} передаст Лешеку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150308
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761150308,
					"content": "#С вами, боссом и {NICKNAME}, всегда спокойнее! Будто в отпуске побывала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150309
					],
					"speakerTitle": "Ягода"
				},
				{
