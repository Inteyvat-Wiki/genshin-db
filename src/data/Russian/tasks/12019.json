				"points": []
			},
			"dialogs": [
				{
					"id": 120190101,
					"content": "Что такое? Ты хочешь поговорить о чём-то ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190102,
						120190105,
						120190109,
						120190113
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120190102,
					"content": "О молоке с данго...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190103
					]
				},
				{
					"id": 120190103,
					"content": "Не сомневаюсь, что этот напиток пришёлся ей по вкусу. Представляю, как она радовалась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190104
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120190104,
					"content": "Она наверняка хотела сказать: «Откройте один из своих магазинов в Царстве эвтюмии!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120190105,
					"content": "О сёгуне Райдэн...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190106
					]
				},
				{
					"id": 120190106,
					"content": "Та кукла, да. Я слышала, что изменить её правила работы очень сложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190107
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120190107,
					"content": "Полагаю, с такой проблемой ещё никто никогда не сталкивался. Вы можете представить, насколько это сложно, если даже мудрая и могущественная Эи испытывает затруднения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190108
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120190108,
					"content": "Даже Мусо но хитотати здесь не поможет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120190109,
					"content": "Насчёт романов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190110
					]
				},
				{
					"id": 120190110,
					"content": "Превращение в сёгуна - забавная идея, не находите? Лёгкие романы такими быть и должны - развлекательными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190111
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120190111,
					"content": "Хотя, для Эи... да, наверное, слишком продвинуто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190112
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120190112,
					"content": "Может, стоит заказать продолжение: «Реинкарнация в Гудзи Яэ»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120190113,
					"content": "Нет, у меня всё.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}