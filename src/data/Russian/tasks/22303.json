			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дэ Гуй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223030101,
					"content": "Вести бизнес становится всё труднее и труднее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030102
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 223030102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030103
					]
				},
				{
					"id": 223030103,
					"content": "Эм? Я говорю, что держать здесь таверну становится всё труднее и труднее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030104
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 223030104,
					"content": "Когда у ресторанов долгая история, это и благословение, и проклятье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030105
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 223030105,
					"content": "С одной стороны, у тебя появляется репутация, как у исторического места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030106
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 223030106,
					"content": "С другой стороны, людям наскучивает есть и пить одно и то же. В больших ресторанах такой проблемы, конечно, не существует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030107
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 223030107,
					"content": "Но у меня маленькая таверна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030108
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 223030108,
					"content": "Завсегдатаям надоели старые напитки, и они постепенно перестают ходить ко мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030109
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 223030109,
					"content": "Я слышал, что в Мондштадте хорошо развито виноделие. Особенно популярно вино из одуванчиков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030110
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 223030110,
					"content": "Я не уверен, что это вино действительно делают из одуванчиков. Хотелось бы попробовать хоть стаканчик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030111
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 223030111,
					"content": "#Не мог{F#ла} бы ты принести мне несколько одуванчиков из Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030112,
						223030114
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 223030112,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030113
					]
				},
				{
					"id": 223030113,
					"content": "Отлично. Не переживай, тебя будет ждать щедрая награда. В Ли Юэ мы не бросаем слов на ветер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 223030114,
					"content": "Вино из одуванчиков?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030115
					]
				},
				{
					"id": 223030115,
					"content": "Тебе кажется, что у него странный вкус? Возможно. Но я слышал, что этот напиток очень популярен в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030116
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 223030116,
					"content": "Однако если я просто скопирую мондштадтский рецепт, то в Ли Юэ никто не купит это вино.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030117
					],
					"speakerTitle": "Дэ Гуй"
				},
				{
					"id": 223030117,
					"content": "Для начала принеси мне несколько <color=#00E1FFFF>одуванчиков</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэ Гуй"
				}
			]
		},
