	"talks": [
		{
			"id": 7105801,
			"completionStepIds": [
				7105802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
