			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катарина",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580101,
					"content": "Кхе-кхе... Стой! Ты кто? Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580102
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580102,
					"content": "И... почему нападаешь на меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580103
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580103,
					"content": "Это мы должны спросить! Что ты тут вынюхиваешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580104,
					"content": "Ты злодейка, тебе и объясняться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580105
					]
				},
				{
					"id": 710580105,
					"content": "Катарина... Катарина Снежневна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580106
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580106,
					"content": "Моё имя - наименее секретная информация, и я могу выдать только её. Извините.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580107
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580107,
					"content": "Уф... мы просто хотели узнать, что происходит. Мы не собирались тебя допрашивать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580108,
					"content": "Прошу прощения, но это всё, что я могу сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580109
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580109,
					"content": "Что тут делают Фатуи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580110
					]
				},
				{
					"id": 710580110,
					"content": "Это засекречено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580111
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580111,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580112
					]
				},
				{
					"id": 710580112,
					"content": "М-да, а злодеи любят посекретничать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580113,
					"content": "Ага, точно, мы такие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580114
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580114,
					"content": "Так, анкетирование окончено... У нас тут наметились проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катарина"
				}
			]
		},
		{
			"id": 7105802,
			"completionStepIds": [
				7105804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105804",
							"2"
						],
						"stepId": 7105804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катарина",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580201,
					"content": "Спасибо... что не воткнули нож мне в спину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580202,
						710580203
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580202,
					"content": "Прими мою благодарность в ответ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				},
				{
					"id": 710580204,
					"content": "Уж не знаю, что у тебя в голове, но тут не лучшее место, чтобы за мной приударить... Хочешь побеседовать - приходи в моё убежище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580207
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580207,
					"content": "Катарина уходит.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710580205
					]
				},
				{
					"id": 710580205,
					"content": "Что? Она же Фатуи! И мы так просто её отпустим и не передадим Миллелитам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580206,
					"content": "Эм... Ну ладно. Она не причинила нам вреда, давай и мы её пощадим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580203,
					"content": "Фатуи настолько мнительны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				}
			]
		},
		{
			"id": 7105805,
			"completionStepIds": [
				7105806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105806",
							"2"
						],
						"stepId": 7105806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катарина",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580501,
					"content": "А я вас как раз жду. Располагайтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580502
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580502,
					"content": "У меня тут немного чёрного чая. Нет, он закончился. Сахар... эм, тоже. Молоко... Фу, прокисло. Лучше выкину... Ох, мне так неловко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580503
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580503,
					"content": "А вот огненной воды сколько хочешь... ещё есть немного сушек и повидло. На чаепитие наберётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580504
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580504,
					"content": "Ого! Вы на чаепитии огненную воду пьёте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580505,
					"content": "Да, а что такого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580506,
						710580508
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580506,
					"content": "Эм... Я всё-таки откажусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580507
					]
				},
				{
					"id": 710580507,
					"content": "А чего? Хе-хе, тут никто на тебя косо не посмотрит. Давай же, не стесняйся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580510,
						710580511
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580510,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580512
					]
				},
				{
					"id": 710580512,
					"content": "«Правильным распределением продуктов питания и информации можно заставить любознательных замолчать».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580513
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580513,
					"content": "Так говорится в нашем руководстве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580514
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580514,
					"content": "А где информация?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580515
					]
				},
				{
					"id": 710580515,
					"content": "А? Ну вот же только что была.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580516
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580516,
					"content": "Что?.. О чём ты вообще?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580517,
					"content": "Руководство по подготовке передовых сил Фатуи, Приложение 4-4, статья 32: «Правильным распределением продуктов питания и информации можно заставить любознательных замолчать». Не благодари.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580518
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580518,
					"content": "В обмен на спасение моей жизни я даже раскрыла содержание конфиденциального руководства! Как вам такая искренность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580519
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580519,
					"content": "И что нам с этим делать?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580520,
					"content": "Ха-ха, ладно, шутки в сторону... Если серьёзно, то спасибо вам большое за помощь и, пожалуйста, не истолковывайте превратно мои добрые намерения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580521
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580521,
					"content": "Ну... учитывая все ваши злодеяния, Паймон трудно поверить, что у Фатуи добрые намерения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580522
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580522,
					"content": "Что ты задумала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580523
					]
				},
				{
					"id": 710580523,
					"content": "Меня не удивляет, что посторонние не могут понять философию Фатуи. Но когда мы не говорим об идеях и точках зрения, мы просто обычные люди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580524
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580524,
					"content": "И кроме того, какова бы ни была наша цель, мы только и делаем, что готовимся к решающему бою.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580525
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580525,
					"content": "Решающему бою?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580526
					]
				},
				{
					"id": 710580526,
					"content": "Да, в конце концов все мы столкнёмся с общим врагом и долгой ночью, от которой не скрыться... В Снежной все об этом знают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580527
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580527,
					"content": "А потому каждая из пролитых ради этого бездушного мира капель крови и слёз... не напрасна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580528
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580528,
					"content": "Так выпьем? Нет? Хм, что ж, я тогда сама...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580529,
						710580531
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580529,
					"content": "Вот так ты оправдываешь ваши злые поступки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580530
					]
				},
				{
					"id": 710580530,
					"content": "Может быть... не знаю, мне всё равно. Вы хотели объяснений, я вам их дала... Вероятно, вам они не по душе. Вот так вот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580534
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580534,
					"content": "Уф... Паймон не понимает, почему мы вдруг заговорили о таких серьёзных вещах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580535
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580535,
					"content": "Кстати, я уже представилась, но я ещё не знаю ваших имён.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580536,
						710580537
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580536,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580538
					]
				},
				{
					"id": 710580538,
					"content": "Паймон - это Паймон. Ты точно слышала обо мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580539
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580539,
					"content": "Ого! Эти имена!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580540
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580540,
					"content": "Хм! Что? Должно быть, слухи распространились по всему Тейвату, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580541
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580541,
					"content": "Извините, я не слышала о вас. Ни разу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580542
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580542,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580543
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580543,
					"content": "Без обид, но меня уже давно сюда перебросили. Я почти ничего не знаю о поверхности, кроме того, что поступает по линии снабжения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580544
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580544,
					"content": "То есть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580545
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580545,
					"content": "Ваша линия снабжения давно прервалась?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580546
					]
				},
				{
					"id": 710580546,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580547
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580547,
					"content": "Чаепитие окончено, мне нужно отдохнуть. Прошу прощения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580548
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580548,
					"content": "Эй! Мы же ничего не поели!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580549
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580549,
					"content": "Убирайтесь! Сами же побрезговали моей огненной водой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580550
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580550,
					"content": "Да потому что эту штуку людям нельзя давать пить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580551,
						710580552
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580551,
					"content": "Ладно, Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580553
					]
				},
				{
					"id": 710580553,
					"content": "Хм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580554
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710580554,
					"content": "#Кстати! {NICKNAME}, пожалуйста, задержись немного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580555
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580555,
					"content": "Ох... Ничего такого, просто... если вдруг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580556
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580556,
					"content": "Заходи ещё как-нибудь... если тебя не затруднит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580552,
					"content": "У людей разные вкусы, понимаешь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580553
					]
				},
				{
					"id": 710580537,
					"content": "#Возможно, ты обо мне слышала. Я {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580538
					]
				},
				{
					"id": 710580531,
					"content": "Хм. Весьма высокопарно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580532
					]
				},
				{
					"id": 710580532,
					"content": "Ха!.. Вам точно нужно попробовать огненную воду из Снежной и повидло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580533
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580533,
					"content": "Ну зачем столько серьёзности... ты слишком много думаешь. Просто верь в то, во что хочешь верить. Вот она «вера».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580534
					],
					"speakerTitle": "Катарина"
				},
				{
					"id": 710580511,
					"content": "Ты опять что-то замышляешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580512
					]
				},
				{
					"id": 710580508,
					"content": "Мы пришли не чаи гонять...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580509
					]
				},
				{
					"id": 710580509,
					"content": "Я знаю, знаю... не накручивай себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580510,
						710580511
					],
					"speakerTitle": "Катарина"
				}
			]
		}
	]
}