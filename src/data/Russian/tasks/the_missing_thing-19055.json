			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Горо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551601,
					"content": "#{NICKNAME}, ещё раз прошу прощения, я ввёл тебя в заблуждение. Я виноват перед тобой, но... я не мог поступить иначе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551602
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 190551602,
					"content": "Я понимаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551603
					]
				},
				{
					"id": 190551603,
					"content": "А Кокоми знает об этом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551604
					]
				},
				{
					"id": 190551604,
					"content": "Госпожа Сангономия... Скажу так: война принесла много зла и многому нас научила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551605
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 190551605,
					"content": "Так всё-таки знает или нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 190551606,
					"content": "И вам совсем не интересно, кто протолкнул новый закон? Точно не комиссия Кандзё, им это не принесло бы прямой выгоды, и у нас там нет никаких знакомств.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551607
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 190551607,
					"content": "Да, кажется, вам помогали сами Архонты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 190551608,
					"content": "Ха-ха, Архонты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551609
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 190551609,
					"content": "Не так давно на острове Наруками проходил праздник Иродори, мы с госпожой Сангономией тоже были в числе приглашённых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551610
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 190551610,
					"content": "Я ждал на рынке, а её превосходительство ушла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Горо"
				}
			]
		},
		{
			"id": 1905517,
