				"points": []
			},
			"dialogs": [
				{
					"id": 190551701,
					"content": "Она пошла навестить Мико.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551702
					]
				},
				{
					"id": 190551702,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551802
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 190551802,
					"content": "Она направилась в комиссию Кандзё к госпоже Мико якобы для рецензирования книги, но, похоже, они обсудили и другие вопросы. Содержание этого разговора не предавалось огласке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551803
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 190551803,
					"content": "После её возвращения у нас начали активно развивать торговлю, и на острове Наруками тоже вскоре появился проект нового закона о торговле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551804
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 190551804,
					"content": "И как вы думаете, её превосходительство знает об этом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Горо"
				}
			]
		},
