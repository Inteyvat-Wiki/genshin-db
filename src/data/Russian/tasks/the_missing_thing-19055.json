			"dialogs": [
				{
					"id": 190550901,
					"content": "Тодороки, товар прибыл, надо его подсчитать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550902
					],
					"speakerTitle": "Токуда"
				},
				{
					"id": 190550902,
					"content": "Да, идём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550903
					],
					"speakerTitle": "Тодороки"
				},
				{
					"id": 190550903,
					"content": "Тодороки... Ой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550904
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 190550904,
					"content": "Тсс, молчи! Пойдём тихонько следом за ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сиканоин Хэйдзо"
				}
			]
		},
		{
			"id": 1905510,
			"completionStepIds": [
				1905504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
