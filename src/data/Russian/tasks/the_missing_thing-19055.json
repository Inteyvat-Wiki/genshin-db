				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Токуда",
					"Тодороки",
					"Масаси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551001,
					"content": "У дяди хорошая разведка: когда мы оказались на месте, эти нобуси ещё сладко спали, ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551002
					],
					"speakerTitle": "Токуда"
				},
				{
					"id": 190551002,
					"content": "Мы накрыли их всех сразу, и товар удалось вернуть, вот он.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551003
					],
					"speakerTitle": "Токуда"
				},
				{
					"id": 190551003,
					"content": "Дай-ка я пересчитаю. Да, всё на месте, спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551004
					],
					"speakerTitle": "Тодороки"
				},
				{
					"id": 190551004,
					"content": "Не за что! Ведь только благодаря караванам Тодороки в деревне снизились цены на продовольствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551005
					],
					"speakerTitle": "Токуда"
				},
				{
					"id": 190551005,
					"content": "Да, верно! А ещё Тодороки помог нам вылечить старые раны - война подорвала наше здоровье, но снадобья, которые привёз Тодороки, оказались настоящим спасением!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551006
					],
					"speakerTitle": "Масаси"
				},
				{
					"id": 190551006,
					"content": "Всё благодаря нашим покровителям, без них ничего бы не получилось. Как обстоят дела с хранилищами в деревне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551007
					],
					"speakerTitle": "Тодороки"
				},
				{
					"id": 190551007,
					"content": "Нужно сегодня же всё проверить, завтра утром я буду в Сангономии на встрече с генералом Горо, а сразу после этого отправляемся в путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551008
					],
					"speakerTitle": "Тодороки"
				},
				{
					"id": 190551008,
					"content": "Не беспокойся, Тодороки, мы уже подготовили список. Следуй за нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Масаси"
				}
			]
		},
