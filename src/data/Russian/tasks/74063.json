						],
						"pointId": 6249
					}
				]
			},
			"dialogs": [
				{
					"id": 740630201,
					"content": "А? Откуда здесь фотокамера?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740630202,
					"content": "«Где новости, там и камера». Разве вы не слышали такую поговорку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630203,
						740630206
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630203,
					"content": "Кажется, слышали.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630204
					]
				},
				{
					"id": 740630204,
					"content": "Я ведь её только что придумала, где же вы могли её слышать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630205
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630205,
					"content": "Эх, похоже, в этом мире придумать что-то новое уже попросту невозможно. Что бы ты ни сказал и ни написал, - всё это уже было создано другими людьми до тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630208,
					"content": "Фотокамера здесь, а где же новости?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630209
					]
				},
				{
					"id": 740630209,
					"content": "Журналистика... подобна рыбалке. Нужно быть терпеливым и вовремя принимать правильное решение, чтобы поймать сенсационную рыбку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630210
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630210,
					"content": "Ой, я имею в виду, поймать сенсационную новость. А? Как-то это тоже странно звучит. В общем, забудьте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630211,
						740630213
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630211,
					"content": "Судя по всему, ты любитель. Не настоящий журналист, верно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630212
					]
				},
				{
					"id": 740630212,
					"content": "Ты меня недооцениваешь. Хе-хе, я журналист-любитель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630222,
					"content": "Да и вообще, причём тут журналистика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740630223,
					"content": "Притом, что мне необходимо завершить проект от моих наставников. А именно, запечатлеть интересные моменты из будней стражи крепости Меропид с помощью фотокамеры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630224
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630224,
					"content": "Однако в прошлый раз обработка соответствующих материалов заняла слишком много времени... взгляните, и всё сами поймёте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630225
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630225,
					"content": "Нелли достала большую стопку документов, густо исписанных различными терминами и подписями. Вы взглянули на них, и у вас тотчас же закружилась голова...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740630226
					]
				},
				{
					"id": 740630226,
					"content": "Все важные мероприятия в крепости уже закончились. Я не успела застать стражу за работой. Если провести аналогию с рыбалкой, сейчас ловить нечего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630227
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630227,
					"content": "А? Но ведь часть стражи ещё здесь, разве нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740630228,
					"content": "Да, но мне бы хотелось поймать что-нибудь поинтереснее, добыть платиновый материал. Какой смысл ловить рыбу в речке, если у тебя был шанс порыбачить в самом океане?.. Теперь-то наставники меня вряд ли похвалят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630229,
						740630230
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630229,
					"content": "Не привередничай, а то и вовсе с пустыми руками уйдёшь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630233
					]
				},
				{
					"id": 740630233,
					"content": "Это верно. Я должна взглянуть в лицо правде и не пытаться поймать рыбу, которая мне не по зубам... У-у-у, ну и никчёмный же из меня рыбак вышел... то есть, никчёмный журналист-любитель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630234
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630234,
					"content": "Ладно, отставить грусть. Пора воспрянуть духом! Если у вас есть время... не могли бы вы оказать мне маленькую услугу? Пожалуйста! Я заплачу вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630235
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630235,
					"content": "Как быстро она грустить перестала... Всё зависит от того, что именно тебе нужно. Может, ты сперва расскажешь нам, что это ещё за маленькая просьба?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630236
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740630236,
					"content": "Как мне кажется, тот страж, Гренвиль, может создать такую же невероятную сенсацию, как и бюро обслуживания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630237
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630237,
					"content": "Если бы мне удалось заполучить его фотографию, я бы отличную статью накатала. Такую, что наставники сразу бы рты разинули.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630238
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630238,
					"content": "Вот только он всё никак здесь не появляется! Не могли бы вы заманить его поближе, чтобы я смогла фотографию сделать, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630239,
						740630241
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630239,
					"content": "Может, тебе просто подойти к нему и попросить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630240
					]
				},
				{
					"id": 740630240,
					"content": "Нет, так его поза получится неестественной. Он будет нервничать перед камерой. Разве получится тогда хорошее фото?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630243,
					"content": "Мне кажется, лучше поступить так... выключить усилитель, пожаловаться Гренвилю, что он сломался, и попросить его сходить проверить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630244
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630244,
					"content": "Так у меня точно получится запечатлеть интересный момент в работе стражей крепости Меропид!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630245
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630245,
					"content": "Да ещё и проект наконец завершу. Два дела за раз! Пожалуйста, пожалуйста, помогите мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630246
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630246,
					"content": "#Вроде ничего сложного. Поможем ей, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740630241,
					"content": "А что если взять фотокамеру и пойти к нему прямо с ней?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630242
					]
				},
				{
					"id": 740630242,
					"content": "Э-э... а здесь фон лучше подходит. Тем более, если он увидит фотокамеру, начнёт нервничать. Встанет сразу как-нибудь наигранно, и фото получится не таким живым...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630230,
					"content": "Тогда продолжай ждать появления океана. Пока!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630231
					]
				},
				{
					"id": 740630231,
					"content": "Вы уже уходите? Правда уходите? И вы даже мне не поможете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630232
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630232,
					"content": "Ой... ну мы ведь не можем наколдовать тебе твой «платиновый материал».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740630213,
					"content": "Новости мне неинтересны, а вот рыбалка - другое дело.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630214
					]
				},
				{
					"id": 740630214,
					"content": "#В самом деле? Вот здорово! Если честно, я в этом деле новичок. У меня не всё получается, а спросить совета не у кого. Вот, если бы ты поймал{F#а} бюро обслуживания, а оно начало кусаться... что бы ты сделал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630215,
						740630216,
						740630217
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630215,
					"content": "#Просто отпустил{F#а} бы его.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630219,
					"content": "#Вот как. Значит, ты поступил{F#а} бы так. Хм, это очень ценный совет. Надо его записать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630220
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630220,
					"content": "А! Почему мы вдруг заговорили о рыбалке? Как же хорошо вы ориентируетесь в беседе! Похоже, мне как журналисту-любителю предстоит ещё многому научиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630221
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630221,
					"content": "Так это ты сама тему о рыбалке завела!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740630216,
					"content": "#Стукнул{F#а} бы его хорошенько, чтоб не брыкалось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630217,
					"content": "#Приготовил{F#а} бы из него блюдо и накормил{F#а} Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630218
					]
				},
				{
					"id": 740630218,
					"content": "#Ой! {NICKNAME}, я, конечно, верю в твой кулинарный талант, но эта штука не похожа на съедобную!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740630206,
					"content": "Не слышали.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630207
					]
				},
				{
					"id": 740630207,
					"content": "О-о-о! Ну, вот теперь услышали. Запомните, если захотите процитировать эту фразу где-нибудь ещё, обязательно укажите источник! То есть меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Нелли"
				}
			]
		},
		{
			"id": 7406303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
