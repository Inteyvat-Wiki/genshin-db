						],
						"stepId": 7406303,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406304",
							"2"
						],
						"stepId": 7406304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нелли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740630301,
					"content": "Я обязана сделать фото, которые впечатлят наставников!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630302
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630302,
					"content": "Ах, да ещё и платиновый материал заполучить хочется...",
					"roleType": "TALK_ROLE_NPC",
