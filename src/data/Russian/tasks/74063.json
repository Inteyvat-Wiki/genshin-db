			},
			"dialogs": [
				{
					"id": 740630401,
					"content": "Привет! Мы тут заметили, что один из усилителей звука сломался... вон там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740630402,
					"content": "Опять сломался? Как странно... Я же попросил Клайнса его починить. Похоже, я с этим справлюсь лучше. Раньше ведь достаточно было пару раз по нему стукнуть, и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630403
					],
					"speakerTitle": "Гренвиль"
				},
				{
					"id": 740630403,
					"content": "Спасибо, что сообщили. Пойду проверю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630404
					],
					"speakerTitle": "Гренвиль"
				},
				{
					"id": 740630404,
					"content": "Удачи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
