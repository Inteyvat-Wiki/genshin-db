			"dialogs": [
				{
					"id": 740630501,
					"content": "Наконец-то я завершу проект от своих наставников! Теперь-то я могу смело назвать себя настоящей журналисткой! Спасибо вам огромное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630502
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630502,
					"content": "Похоже, фото получилось хорошим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740630503,
					"content": "Да, смотрите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630504,
						740630506
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630504,
					"content": "Не очень динамично, но зато художественно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630505
					]
				},
				{
					"id": 740630505,
					"content": "Наверное, это новый вид искусства, который мы не понимаем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740630508,
					"content": "Такое фото точно можно в журналистике использовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740630509,
					"content": "А что не так? Я думаю, новость точно взлетит! Наставники небось и представить себе не могут, что я такую сенсацию сумею добыть. Наверняка удивятся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630510
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630510,
					"content": "Странные у вас, конечно, критерии оценивания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740630511,
					"content": "Эх вы! Это ведь как раз тот самый случай, когда «символизм важнее сущности». Я уверена, что наставники точно сумеют уловить смысл моей работы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630512
					],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630512,
					"content": "В любом случае спасибо за помощь. Вот, возьмите! Эх, было бы здорово свидеться с вами вновь. Где-нибудь, где тоже рыбку можно половить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нелли"
				},
				{
					"id": 740630506,
					"content": "Какое динамичное фото! Кажется, что он вот-вот начнёт двигаться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630507
					]
				},
				{
					"id": 740630507,
					"content": "Хм, а у Паймон вот голова кружится, если долго на это фото смотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630508
					],
					"speakerTitle": "Паймон"
				}
			]
