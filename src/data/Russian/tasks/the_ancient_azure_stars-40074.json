			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каэдэхара Кадзуха",
					"Оз",
					"Фишль",
					"Мона",
					"Синь Янь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400740901,
					"content": "Обстановка поменялась. Это уже не тот пляж, с которого мы ушли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740902
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400740902,
					"content": "Эта область похожа на горы Мондштадта. Может, именно туда нас и перенесло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740903
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400740903,
					"content": "Но нас по-прежнему окружает бескрайнее море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740904
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400740904,
					"content": "Поблизости должен быть ещё один пруд, в который можно войти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740905
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400740905,
					"content": "Вон там!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740906
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400740906,
					"content": "Хм? Почему-то не пускает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740907
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400740907,
					"content": "Кажется, там что-то плавает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740908
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400740908,
					"content": "Это что, картина? Или...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740909
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400740909,
					"content": "Она будто указывает на определённое место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740910
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400740910,
					"content": "Она ожидает, что принцесса поведёт верных вассалов к избранному судьбою месту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740911
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400740911,
					"content": "Почему ты опять за главную? Ладно, неважно. Давайте просто найдём это место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				}
			]
		},
		{
			"id": 4007411,
