				"points": []
			},
			"dialogs": [
				{
					"id": 400741201,
					"content": "Госпожа Мегистус... это так печально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741202
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400741202,
					"content": "Ох, только не утешайте меня, не то мне будет неловко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741203
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741203,
					"content": "В такие моменты слова будут лишними. Хочешь, обнимемся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741204
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400741204,
					"content": "Не надо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741205
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741205,
					"content": "Это переживания из моего прошлого. Тогда я только начинала заниматься астрологией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741206
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741206,
					"content": "Теперь же я мастер своего дела, и мнения обычных людей значат для меня совсем немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741207
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741207,
					"content": "Кто бы мог подумать, что даже великого придворного мага Мегистус не обошли трудности и тревоги стези профессиональной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741208
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400741208,
					"content": "Тяжело, когда люди не понимают тебя... Хорошо, что ты с этим справилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741209
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400741209,
					"content": "Знаете, для некоторых это было так невыносимо, что они бросали астрологию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741210
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741210,
					"content": "Но я талантлива, а значит, мне под силу то, что не под силу остальным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741211
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741211,
					"content": "В таком прекрасном месте твои слова звучат особенно сильно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741212,
						400741213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400741212,
					"content": "Мона, ты бесподобна!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				},
				{
					"id": 400741214,
					"content": "Хорошо, хорошо, продолжайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741215
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741215,
					"content": "Кхм... Извините, что прерываю, но там какая-то дверь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741216
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400741216,
					"content": "Ладно, можете продолжить хвалить меня, когда разрешим все тайны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741213,
					"content": "Конечно, Мона - настоящий талант.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				}
			]
		}
	]
