			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мона",
					"Синь Янь",
					"Каэдэхара Кадзуха",
					"Фишль",
					"Оз"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400740201,
					"content": "Чаша для гадания говорит мне, что мир грёз находится здесь. Теперь нам нужно найти вход...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740202
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400740202,
					"content": "Это не он вон там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400740203,
					"content": "Похоже на... пруд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740204
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400740204,
					"content": "Нам же не нужно туда нырять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400740205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740206
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400740206,
					"content": "У нас тут кто-то не умеет плавать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740207
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400740207,
					"content": "Вряд ли проблема в этом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740208
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400740208,
					"content": "Ха, испугался? Ну ладно, тогда я пойду первая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740209
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400740209,
					"content": "Ну началось! С водой на «ты», вот и выпендривается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740210
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400740210,
					"content": "Кхм! Миледи, в речах следует быть избирательнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740211
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400740211,
					"content": "О-ой! Точно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740212
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400740212,
					"content": "Я пошла! Увидимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740213
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400740213,
					"content": "А? Мона нырнула в пруд и исчезла! Давайте за ней!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4007403,
			"completionStepIds": [
				4007403
			],
