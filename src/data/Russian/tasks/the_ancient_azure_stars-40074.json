					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400740301,
					"content": "Какое великолепное сооружение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740302
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400740302,
					"content": "Ух ты! Впервые вижу нечто подобное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740303
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400740303,
					"content": "Мона, твой мир грёз поистине удивителен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740304
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400740304,
					"content": "Конечно, ему ещё далеко до Нирваны Ночи, но тем не менее впечатляет. Неплохо, госпожа Мегистус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740305
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400740305,
					"content": "(Ох, повезло же, что это не какая-нибудь лекция со старухой... Моя репутация спасена...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740306
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400740306,
					"content": "Ну конечно, а чего же ещё ожидать от мира грёз гениального астролога?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740307
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400740307,
					"content": "Итак, начнём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				}
			]
		},
		{
			"id": 4007409,
			"completionStepIds": [
				4007409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007409",
							"2"
