				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400741101,
					"content": "Эй, все сюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741102
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400741102,
					"content": "Все проснулись? Мона сказала, что хочет объявить о чём-то важном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741103
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400741103,
					"content": "Первые лучи солнца после возвращения Нирваны Ночи несомненно освежают до глубины души.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741104
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400741104,
					"content": "Миледи хочет сказать, что она готова к следующему испытанию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741105
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400741105,
					"content": "И мы хорошо поспали и поели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400741106,
					"content": "Хорошо. Тогда я начну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741107
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741107,
					"content": "Я только что сверилась с чашей для гадания и узнала, что на том острове появился новый мир грёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741108
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741108,
					"content": "И... если интуиция не подводит меня, он связан со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741109
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741109,
					"content": "Значит, настал черёд Моны. Ты уже побывала с нами в наших мирах грёз. Теперь нам пора заглянуть в твой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741110
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400741110,
					"content": "Эм... я уверена, там нет ничего интересного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741111
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741111,
					"content": "Вы стесняетесь, госпожа Мегистус?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741112
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400741112,
					"content": "В-вовсе нет! А-ха-ха... Я нисколько не переживаю о том, что, увидев мой жалкий мир грёз, вы станете относиться ко мне иначе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741113
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741113,
					"content": "Так всё и выложила нам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741114
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400741114,
					"content": "Ну... астрологов считают возвышенными, не такими, как все... Но что, если мой мир грёз окажется совсем иным?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741115
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741115,
					"content": "Отбрось свои страхи. Твоя принцесса не столь глупа, чтобы иметь предубеждения касательно вида мира грёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741116
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400741116,
					"content": "Я тоже. У меня, конечно, в отношении тебя есть определённые ожидания... Но ты прекрасный человек, Мона, и тебе не нужно стараться оправдать ожидания других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741117
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400741117,
					"content": "Уверен, у человека с добрым сердцем и мир грёз будет добрый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741118
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400741118,
					"content": "Да-да! Кроме того, мы же не просто поглазеть идём. У нас дела, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741119,
						400741120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400741119,
					"content": "Да! Может быть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				},
				{
					"id": 400741121,
					"content": "...Раз так, тогда ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741122
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741122,
					"content": "Просто не стройте больших ожиданий, и тогда я не буду нервничать. Итак, вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				},
				{
					"id": 400741120,
					"content": "...там мы найдём ключ к разгадке иллюзий.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				}
			]
		},
		{
