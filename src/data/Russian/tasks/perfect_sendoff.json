				"points": []
			},
			"dialogs": [
				{
					"id": 111130801,
					"content": "Ого, там даже все наши имена!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130802
					],
					"speakerTitle": "Большой Г"
				},
				{
					"id": 111130802,
					"content": "Хе-хе, класс. Да, ты только что говорил, что запускаешь фонари каждый год. Имён в них с каждым годом тоже будет больше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130803
					],
					"speakerTitle": "Большой Г"
				},
				{
					"id": 111130803,
					"content": "Например, имена детей Маленького У, или жены Му Му...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130804
					],
					"speakerTitle": "Большой Г"
				},
				{
					"id": 111130804,
					"content": "Вообще-то у меня есть хорошая новость. Му Му скоро станет отцом. Он только об этом и говорит. Видно, что радуется и переживает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130805
					],
					"speakerTitle": "Дядюшка Мэн"
				},
				{
					"id": 111130805,
					"content": "Ха-ха-ха, интересно, какой из этого растяпы выйдет отец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130806
					],
					"speakerTitle": "Большой Г"
				},
				{
					"id": 111130806,
					"content": "О, нет-нет-нет, видел бы ты его сейчас. Он поумнел настолько...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дядюшка Мэн"
				}
			]
		},
