	"talks": [
		{
			"id": 1111301,
			"completionStepIds": [
				1111301
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
