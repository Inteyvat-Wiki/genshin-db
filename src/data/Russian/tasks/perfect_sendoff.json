			"dialogs": [
				{
					"id": 111131101,
					"content": "Вы новенькие? Какое совпадение! Я тоже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131102
					],
					"speakerTitle": "Чжу Мин"
				},
				{
					"id": 111131102,
					"content": "Виды здесь просто потрясающие! Я думал, тут будет кромешная тьма и холод вне пространства и времени!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131103
					],
					"speakerTitle": "Чжу Мин"
				},
				{
					"id": 111131103,
					"content": "Здесь я могу привести в порядок свои чувства, что замечательно. Ха-ха, наверное, я просто не знал, чего ожидать.",
					"roleType": "TALK_ROLE_NPC",
