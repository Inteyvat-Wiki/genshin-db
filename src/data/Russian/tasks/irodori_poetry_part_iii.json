				"points": []
			},
			"dialogs": [
				{
					"id": 726930101,
					"content": "А, вот и ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930102
					],
					"speakerTitle": "Отомо"
				},
				{
					"id": 726930102,
					"content": "Вчера Лэннэ написал о нашем сожалении, что мы не встретились раньше, и поэтому сегодня я тоже хочу подарить ему стих.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930103
					],
					"speakerTitle": "Отомо"
				},
				{
					"id": 726930103,
					"content": "Ха-ха, это большая честь для меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930104
					],
					"speakerTitle": "Лэннэ"
				},
				{
					"id": 726930104,
					"content": "Хотя я уже старик, но после встречи с друзьями из Мондштадта я очень заинтересовался этим местом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930105
					],
					"speakerTitle": "Отомо"
				},
				{
					"id": 726930105,
					"content": "В этом стихотворении я подражаю бардам Мондштадта, а также упоминаю некоторые пейзажи оттуда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930106
					],
					"speakerTitle": "Отомо"
				},
				{
					"id": 726930106,
					"content": "#К сожалению, я никогда не был в Мондштадте... Ты не мог{F#ла} бы помочь мне и сделать несколько фотографий <color=#00E1FFFF>диковинок Мондштадта</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930107
					],
					"speakerTitle": "Отомо"
				},
				{
					"id": 726930107,
					"content": "Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930108
					]
				},
				{
					"id": 726930108,
					"content": "Ха-ха, тогда я рассчитываю на тебя. Как и раньше, хватит всего 4 фотографий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Отомо"
				}
			]
		},
		{
			"id": 7269302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
