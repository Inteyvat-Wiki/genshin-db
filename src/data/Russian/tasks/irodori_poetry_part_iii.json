			"trigger": {
				"objectNames": [
					"Лэннэ",
					"Отомо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930601,
					"content": "Стихотворение Отомо действительно вырвалось за рамки обычного стиля Инадзумы, но в то же время в нём используется древний стиль для описания незабываемых человеческих переживаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930602
					],
					"speakerTitle": "Лэннэ"
				},
				{
					"id": 726930602,
					"content": "Возможно, он хочет сказать, что, хотя Мондштадт и Инадзума могут показаться очень разными, у них есть общая красота. Как и мы двое, несмотря на то что принадлежим к разным нациям, всё равно смогли сблизиться как поэты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930603
					],
					"speakerTitle": "Лэннэ"
				},
				{
					"id": 726930603,
					"content": "Ах, подумать только, что ты смог так быстро понять чувства, вложенные в это стихотворение, несмотря на свою молодость...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930604
					],
					"speakerTitle": "Отомо"
				},
				{
					"id": 726930604,
					"content": "Раньше я не верил, что бывает дружба между людьми с большой разницей в возрасте, но теперь я знаю, что это правда. Радостная правда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930605
					],
					"speakerTitle": "Отомо"
				},
				{
					"id": 726930605,
					"content": "#И ещё {F#юная госпожа}{M#юный господин}, с {F#которой}{M#которым} нам повезло встретиться... Нас определённо свела судьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930606
					],
					"speakerTitle": "Отомо"
				},
				{
					"id": 726930606,
					"content": "Действительно. Путь в Инадзуму был непростым, но теперь всё это не важно. Даже когда я вернусь в Мондштадт, я буду помнить всё, что видел здесь, в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930607
					],
					"speakerTitle": "Лэннэ"
				},
				{
					"id": 726930607,
					"content": "И это в том числе благодаря твоим фотографиям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930608
					],
					"speakerTitle": "Лэннэ"
				},
				{
					"id": 726930608,
					"content": "Надеюсь, что однажды, мы трое снова встретимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930609
					],
					"speakerTitle": "Отомо"
				},
				{
					"id": 726930609,
					"content": "Обязательно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лэннэ"
				}
			]
		},
