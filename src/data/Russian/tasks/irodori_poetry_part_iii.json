			},
			"dialogs": [
				{
					"id": 726930501,
					"content": "Дикие фрукты символизируют болезненные переживания. Это не радостное воспоминание, как первый вкус алкоголя или первое чтение стихотворения, но, тем не менее, оно оставляет глубокое впечатление.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лэннэ"
				}
			]
		},
		{
			"id": 7269306,
			"completionStepIds": [
				7269305
			],
