				"points": []
			},
			"dialogs": [
				{
					"id": 751420301,
					"content": "Расскажите о Руинах Извержения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420302
					]
				},
				{
					"id": 751420302,
					"content": "Ага, тебя заинтересовали Руины Извержения? Я о них много знаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420303
					],
					"speakerTitle": "Дутсе"
				},
				{
					"id": 751420303,
					"content": "Давным-давно... когда в Натлане было тихо и мирно, как в раю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420304
					],
					"speakerTitle": "Дутсе"
				},
				{
					"id": 751420304,
					"content": "На самом деле, это случилось пятьсот лет назад, когда Натлан сильнее всего пострадал от Бездны. Вулкан изверг из себя огромный фрагмент руин, он вышел на поверхность целым и невредимым!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420305
					],
					"speakerTitle": "Дунийя"
				},
				{
					"id": 751420305,
					"content": "Дунийя, ты чего? Зачем перебиваешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420306
					],
					"speakerTitle": "Дутсе"
				},
				{
					"id": 751420306,
					"content": "Потому что ты всегда затягиваешь одно и то же: «Давным-давно...» Надоело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420307
					],
					"speakerTitle": "Дунийя"
				},
				{
					"id": 751420307,
					"content": "...Вообще-то так я слышал эту историю от дяди Кимоси. А он состоял в исследовательской группе, собранной Палатой советников!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420308
					],
					"speakerTitle": "Дутсе"
				},
				{
					"id": 751420308,
					"content": "Но я слышал, что рядом с Руинами Извержения снова заметили следы Бездны. Интересно, как там дядя Кимоси...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420309
					],
					"speakerTitle": "Дутсе"
				},
				{
					"id": 751420309,
					"content": "Если ты отправишься туда, можешь передать ему привет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дутсе"
				}
			]
		},
		{
			"id": 7514204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
