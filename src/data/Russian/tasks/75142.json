				"points": []
			},
			"dialogs": [
				{
					"id": 751420101,
					"content": "#{F#Героиня}{M#Герой} из далёких земель, что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420102
					],
					"speakerTitle": "Дунийя"
				},
				{
					"id": 751420102,
					"content": "#Ты не смог{F#ла} отыскать Раскоп и Руины Извержения? Ничего не поделать, придётся нарушить запрет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420103
					],
					"speakerTitle": "Дутсе"
				},
				{
					"id": 751420103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420104
					],
					"speakerTitle": "Дунийя"
				},
				{
					"id": 751420104,
					"content": "Эх... Ладно. Я не буду выходить за границы лагеря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420105
					],
					"speakerTitle": "Дутсе"
				},
				{
					"id": 751420105,
					"content": "#{NICKNAME}... Ты хочешь ещё что-то спросить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дунийя"
				}
			]
		},
		{
			"id": 7514202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7514201",
							"2"
						],
						"stepId": 7514201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дунийя",
					"Дутсе"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751420201,
					"content": "Расскажите о Раскопе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420202
					]
				},
				{
					"id": 751420202,
					"content": "На самом деле правильнее говорить «Раскоп Руин таинственного источника». Раскоп находится к югу от Священной горы. Там много руин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420203
					],
					"speakerTitle": "Дунийя"
				},
				{
					"id": 751420203,
					"content": "Говорят, эти руины в давние времена оставили там драконы. Дедушка Мпосо опасается, что на руины позарятся Похитители сокровищ, и каждый день обходит Раскоп с дозором...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420204
					],
					"speakerTitle": "Дунийя"
				},
				{
					"id": 751420204,
					"content": "Дедушка Мпосо всегда любил разные руины и реликвии. Он даже вступил в Ассоциацию реликвий заврианов. И при встрече он обязательно рассказывает нам какую-нибудь историю о былых временах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420205
					],
					"speakerTitle": "Дунийя"
				},
				{
					"id": 751420205,
					"content": "Но рассказывает он неинтересно. Скука смертная! С кучей дурацких подробностей, какие-то узоры на руинах, какой-то там тотемный пульт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420206
					],
					"speakerTitle": "Дутсе"
				},
				{
					"id": 751420206,
					"content": "Культ, а не пульт... Дело в том, что дедушка Мпосо больше археолог, чем рассказчик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420207
					],
					"speakerTitle": "Дунийя"
				},
				{
					"id": 751420207,
					"content": "Говорят, однажды он даже спускался в жерло вулкана, чтобы провести исследование. Думаю, он вам поможет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дунийя"
				}
			]
		},
		{
			"id": 7514203,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
