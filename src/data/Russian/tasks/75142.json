				"points": []
			},
			"dialogs": [
				{
					"id": 751420401,
					"content": "Нет, больше нет вопросов!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420402
					]
				},
				{
					"id": 751420402,
					"content": "Тогда желаем тебе удачи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420403
					],
					"speakerTitle": "Дунийя"
				},
				{
					"id": 751420403,
					"content": "Ха-ха, заглядывай к нам почаще!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дутсе"
				}
			]
		},
		{
