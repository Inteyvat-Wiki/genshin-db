			"dialogs": [
				{
					"id": 150470501,
					"content": "Вселитесь в иктомизавра и вернитесь...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150470502
					]
				},
				{
					"id": 150470502,
					"content": "Муалани, мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150470503,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470504
					]
				},
				{
					"id": 150470504,
					"content": "#О, привет! Ну что за милаха! А где {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470505
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470505,
					"content": "#Эм... У {M#него}{F#неё}... у {M#него}{F#неё} вдруг живот прихватило...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150470506,
					"content": "(Паймон, что за дурацкая отговорка... Ладно, главное, чтобы Муалани ничего не заподозрила...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470507
					]
				},
				{
					"id": 150470507,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470508
					]
				},
				{
					"id": 150470508,
					"content": "Да какой ты добрый малыш! Любишь мерцающие рогатые грибы? Вот, держи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470509
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470509,
					"content": "(Интересный вкус. Грибная мякоть плотная и нежная. Как ни странно, это очень вкусно...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470510
					]
				},
				{
					"id": 150470510,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470511
					]
				},
				{
					"id": 150470511,
					"content": "Ха-ха, рада, что понравилось! Держи, это всё тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470512
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470512,
					"content": "Можно мне тебя погладить? Давай дружить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470513
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470513,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470514
					],
					"speakerTitle": "Детёныш иктомизавра"
				},
				{
					"id": 150470514,
					"content": "И ещё... Не поможешь нам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Муалани"
				}
