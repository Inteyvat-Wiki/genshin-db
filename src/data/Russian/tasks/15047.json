					}
				]
			},
			"dialogs": [
				{
					"id": 150470401,
					"content": "...Ой, оказывается, здесь ещё не закончена стройка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470402
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470402,
					"content": "Смотрите, иктомизавр-работник! Давайте попросим его помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150470403,
					"content": "Привет! Как думаешь, получится это всё достроить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470404
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470405
					],
					"speakerTitle": "Детёныш иктомизавра"
				},
				{
					"id": 150470405,
					"content": "Поставить... здесь... и построить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470406
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470407
					],
					"speakerTitle": "Детёныш иктомизавра"
				},
				{
					"id": 150470407,
					"content": "Похоже, он тебя не понимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150470408,
					"content": "Да... Что же делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470409
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470409,
					"content": "Стоп! Я кое-что придумала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470410
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470410,
					"content": "И-и-и!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470411
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470412
					],
					"speakerTitle": "Детёныш иктомизавра"
				},
				{
					"id": 150470412,
					"content": "И-и-и! И-и-и! И-и-и!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470413
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470413,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470414
					],
					"speakerTitle": "Детёныш иктомизавра"
				},
				{
					"id": 150470414,
					"content": "Ха... Нет, бесполезно! Он не понимает язык кохолазавров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470415
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470415,
					"content": "Может, лучше...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470416
					]
				},
				{
					"id": 150470416,
					"content": "...Придумала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470417
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470417,
					"content": "Что опять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150470418,
					"content": "Ифа рассказывал, что иктомизавры без ума от мерцающих рогатых грибов, и угадайте, что я сегодня с собой прихватила?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470419
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470419,
					"content": "Отлично! Теперь мы спасены! Он поест, и мы сразу будем на одной волне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470420
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470420,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470421
					],
					"speakerTitle": "Детёныш иктомизавра"
				},
				{
					"id": 150470421,
					"content": "Отправляясь в далёкое путешествие, нужно взять с собой побольше припасов... Качина была права. Надо будет её поблагодарить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470422
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470422,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470423
					],
					"speakerTitle": "Детёныш иктомизавра"
				},
				{
					"id": 150470423,
					"content": "Э... Как-то не похоже, что он стал с нами на одной волне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150470424,
					"content": "Кошмар... Моя мечта пройти все испытания залива Прибоя пошла прахом в первый же день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470425
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470425,
					"content": "#{NICKNAME}, {F#великая героиня}{M#великий герой} {NICKNAME}, у тебя есть идеи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470426,
						150470427
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470426,
					"content": "Идеи всегда есть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				},
				{
					"id": 150470428,
					"content": "Давай попробуем. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150470427,
					"content": "...Я позову на помощь другого иктомизавра.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				}
			]
		},
