			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хоффман"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230301,
					"content": "Тебе удалось прогнать Похитителей сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230302
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230302,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230303
					]
				},
				{
					"id": 411230303,
					"content": "#Замечательно. Ты меня сильно выручил{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230304
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230304,
					"content": "Надеюсь, Похитители сокровищ запомнят этот урок, и больше пользоваться чужой бедой не станут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230305
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230305,
					"content": "Если это всё...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230306
					]
				},
				{
					"id": 411230306,
					"content": "Э... Пожалуйста, подожди. Есть ещё кое-что, о чём я хотел бы тебя попросить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230307
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230307,
					"content": "По правде говоря, за это время нам поступило много отчётов о странном поведении чудовищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230308
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230308,
					"content": "Согласно им, после падения метеоритов чудовища стали особенно агрессивными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230309
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230309,
					"content": "Защита Мондштадта крепка, и за него нам переживать нечего. Вот только один из метеоритов упал у Спрингвейла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230310
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230310,
					"content": "На помощь охотникам Спрингвейла мы отправили рыцарей, но патрулирование сильно усложняет местность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230311
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230311,
					"content": "Страшно представить, что случится, если в деревню проберутся чудовища...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230312
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230312,
					"content": "#Не мог{F#ла} бы ты отправиться в Спрингвейл и прояснить ситуацию с чудовищами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230313,
						411230315
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230313,
					"content": "Нет проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230314
					]
				},
				{
					"id": 411230314,
					"content": "Спасибо тебе. Я постараюсь отправить тебе в поддержку парочку рыцарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230315,
					"content": "Как дела в Спрингвейле?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230316
					]
				},
				{
					"id": 411230316,
					"content": "Если честно... Не блеск. К многочисленным последствиям падения метеоритов добавились чудовища и Похитители сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230317
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230317,
					"content": "Справляться со всем сразу нам слишком трудно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230318
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230318,
					"content": "Я рассчитываю на тебя. Также я постараюсь отправить тебе в поддержку парочку рыцарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хоффман"
				}
			]
		},
		{
			"id": 4112304,
			"completionStepIds": [
				4112304
			],
