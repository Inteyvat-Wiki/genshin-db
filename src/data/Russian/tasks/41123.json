			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Робкий Морро"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230401,
					"content": "А-а-а! Не-не под...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230402
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 411230402,
					"content": "А? Т-ты не чудовище. К-кто ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230403
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 411230403,
					"content": "Расскажи о ситуации с чудовищами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230404
					]
				},
				{
					"id": 411230404,
					"content": "О ситуации с чудовищами? Ситуация предельно ясна! Они только что за мной гнались!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230405
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 411230405,
					"content": "Здесь была их целая стая, и они будто собирались напасть на деревню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230406
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 411230406,
					"content": "Хвала моим быстрым ногам, иначе я бы уже где-нибудь остывал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230407
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 411230407,
					"content": "Где чудовища сейчас?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230408
					]
				},
				{
					"id": 411230408,
					"content": "Рядом с деревней. Пройди чуть дальше, и сразу их увидишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230409
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 411230409,
					"content": "Скорее, спрячься где-нибудь. Я передохну маленько, а потом предупрежу всех в деревне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Робкий Морро"
				}
			]
		},
		{
			"id": 4112308,
			"completionStepIds": [
				4112308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112308",
							"2"
						],
						"stepId": 4112308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Робкий Морро"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230801,
					"content": "#А? Опять ты? Чем это ты занимал{F#ась}{M#ся}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230802
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 411230802,
					"content": "#Перебил{F#а} всех чудовищ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230803
					]
				},
				{
					"id": 411230803,
					"content": "Всех?.. В одиночку? Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230804
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 411230804,
					"content": "Не веришь - сходи и посмотри.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230805
					]
				},
				{
					"id": 411230805,
					"content": "Я не трус, но я боюсь. Если чудовища меня увидят, так тут же съедят...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230806
					],
					"speakerTitle": "Робкий Морро"
				},
				{
					"id": 411230806,
					"content": "Правда это или нет, я просто доложу рыцарям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230807
					],
					"speakerTitle": "Робкий Морро"
				},
				{
