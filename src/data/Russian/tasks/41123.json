			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хоффман"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230101,
					"content": "#Приветствую тебя, путешественн{F#ица}{M#ик}! Будь любез{F#на}{M#ен}, в ближайшее время город не покидай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230102
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230103
					]
				},
				{
					"id": 411230103,
					"content": "#Ты уже, наверное, уже видел{F#а} те метеориты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230104
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230104,
					"content": "По неизвестной причине они стали падать чаще, чем обычно, и снаружи стало ещё опаснее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230105
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230105,
					"content": "В городе забот всё больше, и рыцари еле справляются. В добавок ко всему этому у города были обнаружены следы деятельности Похитителей сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230106
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230106,
					"content": "Эти ребята за мора удавят родную мать. Боюсь, они хотят воспользоваться ситуацией...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230107
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230107,
					"content": "Могу ли я попросить тебя помочь нам прогнать этих воришек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230108
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230108,
					"content": "Обычно это входит в обязанности рыцарей, но сейчас все заняты. Ты поможешь нам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230109,
						411230111
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230109,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230110
					]
				},
				{
					"id": 411230110,
					"content": "Огромное тебе спасибо. Мне крайне неловко в такие времена просить тебя о помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230111,
					"content": "Разве Похитители сокровищ метеоритов не боятся?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230112
					]
				},
				{
					"id": 411230112,
					"content": "Хм. Могу поспорить, мысли о деньгах придают им храбрости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230113
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230113,
					"content": "Огромное тебе спасибо. Мне крайне неловко в такие времена просить тебя о помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хоффман"
				}
			]
		},
		{
			"id": 4112303,
			"completionStepIds": [
				4112303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
