			},
			"dialogs": [
				{
					"id": 411230901,
					"content": "Ну, что там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230902
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230902,
					"content": "В Спрингвейле теперь безопасно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230903
					]
				},
				{
					"id": 411230903,
					"content": "Гора с плеч... Я переживал, что никого не смогу отправить на помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230904
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230904,
					"content": "Спасибо. За помощь тебе полагается награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230905
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411230905,
					"content": "Эх... Метеориты, чудовища... Ещё бы чего не случилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хоффман"
				}
			]
		},
