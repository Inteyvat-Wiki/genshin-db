			"trigger": {
				"objectNames": [
					"Хедив"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500401,
					"content": "Расскажи мне о грибах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500402
					]
				},
				{
					"id": 710500402,
					"content": "Сразу видно опытного искателя приключений: уже есть первые находки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500403
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500403,
					"content": "#Ты точно {F#нашла}{M#нашёл} этот гриб здесь? Странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500404
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500404,
					"content": "Грибы не могут расти под землёй?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500405
					]
				},
				{
					"id": 710500405,
					"content": "Дело не в этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500406
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500406,
					"content": "Просто этот гриб очень похож на те, что растут в Сумеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500407
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500407,
					"content": "Но одного вида грибов недостаточно... Выводы можно будет делать только при наличии достаточно большой выборки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500408
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500408,
					"content": "#Это хороший образец... Раз ты {F#принесла}{M#принёс} этот, ты {F#должна}{M#должен} знать, где взять ещё. Почему бы тебе не принести несколько для меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500409
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500409,
					"content": "Если ты принесёшь мне нужное количество грибов, то получишь достаточно большое вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500410
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500410,
					"content": "Сколько грибов тебе нужно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500411
					]
				},
				{
					"id": 710500411,
					"content": "Дай подумать... Для начала восьми будет достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500412
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500412,
					"content": "Принеси их мне, и награда не заставит себя ждать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хедив"
				}
			]
		},
		{
			"id": 7105007,
			"completionStepIds": [
				7105003
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105003",
							"2"
						],
						"stepId": 7105003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хедив"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500701,
					"content": "Вот твои грибы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500702
					]
				},
				{
					"id": 710500702,
					"content": "Премного благодарен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500703
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500703,
					"content": "С твоей помощью моё исследование продвигается... «гладко, словно парящий на крыльях тигр», как говорят в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500704
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500704,
					"content": "Как тигр с крыльями?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500705
					]
				},
				{
					"id": 710500705,
					"content": "Можно и так сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500706
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500706,
					"content": "Эти грибы, как получилось, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500707
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500707,
					"content": "Очень странно. Эти грибы идентичны одному из видов грибов, которые произрастают в Сумеру. Но почему они светятся? Неужели это потому что они растут в темноте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500708
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500708,
					"content": "Если флуоресцентные элементы могут эволюционировать, то почему в самих грибах нет никаких изменений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500709,
						710500710
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500709,
					"content": "Ничего не понятно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				},
				{
					"id": 710500711,
					"content": "Проще говоря, грибы эволюционируют, приспосабливаясь к окружающей среде, но этот вид гриба явно более приспособлен к произрастанию в лесной среде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500712
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500712,
					"content": "Поэтому нет сомнений, что он первоначально рос в Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500713
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500713,
					"content": "А люминесценция?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500714
					]
				},
				{
					"id": 710500714,
					"content": "Тот факт, что этот гриб не является здешним видом, позволяет предположить, что люминесценция - не продукт эволюции, а скорее результат аномальных экологических воздействий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500715
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500715,
					"content": "Возможно, гриб поглотил энергию осколков, упавших с неба...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500716,
						710500717
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500716,
					"content": "Осколков?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500718,
					"content": "Кхе-кхе... Я сказал осколков? Я имел в виду, что когда кусочки грибов падают сверху...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500719
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500719,
					"content": "...происходят изменения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500720
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500720,
					"content": "Так и есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500721
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500721,
					"content": "#Большое спасибо за собранные грибы! Ты мне очень помог{F#ла}. Ты хорошо {F#потрудилась}{M#потрудился}, тебе надо отдохнуть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500722
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500722,
					"content": "Мне нужно провести ещё несколько исследований. Не хочу, чтобы меня отвлекали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500717,
					"content": "Каких осколков?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500710,
					"content": "Что-то не так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				}
			]
		}
	]
}