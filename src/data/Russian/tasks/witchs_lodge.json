			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Николь"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5481.038,
							194.726,
							9711.116
						],
						"pointId": 15006
					},
					{
						"sceneId": 3,
						"position": [
							5480.359,
							194.706,
							9710.449
						],
						"pointId": 15007
					},
					{
						"sceneId": 3,
						"position": [
							5482.168,
							194.832,
							9712.457
						],
						"pointId": 15008
					}
				]
			},
			"dialogs": [
				{
					"id": 766731132,
					"content": "Теперь попросим Николь добавить пару штрихов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766731133,
					"content": "#Убрал{F#а} лишние камни? Дай-ка посмотрю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731134
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731134,
					"content": "Хе-хе, вот и готово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731101
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766731101,
					"content": "Ой, хижина ведьмы! Когда это она тут появиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766731102,
					"content": "Так вот она, сила ведьмы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731103
					]
				},
				{
					"id": 766731103,
					"content": "#«Это и есть сила ведьмы? - на лице {F#девушки}{M#юноши} отразилось изумление. - Невероятно».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731104
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731104,
					"content": "#Ага! Наконец-то история продолжается! Итак, что случилось с ведьмой и её {F#юной гостьей}{M#юным гостем}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766731105,
					"content": "Они жили долго и счастливо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731106
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731106,
					"content": "...Конец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731107
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731107,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731108,
						766731109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766731108,
					"content": "И как это случилось?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				},
				{
					"id": 766731110,
					"content": "Ох... Что с вами поделать?! Раз уж вам так хочется послушать, начну рассказ с самого начала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731111
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731111,
					"content": "#«Всё, чего желает моё сердце, - это исполнить твои желания» - {F#сказала девушка}{M#сказал юноша}. Эти слова привлекли пристальное внимание великой ведьмы Николь Коко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731112
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731112,
					"content": "Но как только они начали сближаться, внезапно появились незваные гости и похитили ведьму!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731113
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731113,
					"content": "#{F#Девушка была потрясена, но в этот момент появилась ведьма Алинас и заключила с ней договор, наделив её магической силой.}{M#Юноша был потрясён, но в этот момент появилась ведьма Алинас и заключила с ним договор, наделив его магической силой.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731114
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731114,
					"content": "Но после прохождения изнурительной программы выяснилось, что за этим стоит некий заговор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731115
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731115,
					"content": "Оказывается, великая ведьма Николь Коко на самом деле была инопланетным существом, старшей дочерью короля планеты кошек Мяутреса III.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731116
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731116,
					"content": "Она изображала ведьму, но её истинной целью было обманом заставить весь мир поклоняться планете кошек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731117
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731117,
					"content": "#«О великая ведьма... неужели ты всё это время лгала мне?» - голос {F#девушки}{M#юноши} дрожал, а сердце рвалось на части.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731118
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731118,
					"content": "«Оставь меня. Между нашей планетой и вашей неизбежно разразится война. Мы были врагами с самого начала».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731119
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731119,
					"content": "Ведьма отвернулась, чтобы никто не увидел её слёз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731120
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731120,
					"content": "#{F#Девушка храбро схватила ведьму за запястье и поклялась никогда не расставаться с ней. Тронутая её упорством, ведьма решила поднять знамя восстания!}{M#Юноша храбро схватил ведьму за запястье и поклялся никогда не расставаться с ней. Тронутая его упорством, ведьма решила поднять знамя восстания!}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731121
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731121,
					"content": "#В этот момент Алинас, которая ранее помогала {F#девушке}{M#юноше}, встала на сторону короля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731122
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731122,
					"content": "#Она оказалась второй дочерью Мяутреса III. Она помогала {F#девушке}{M#юноше}. Но лишь для того, чтобы подтолкнуть сестру к предательству и получить право на престол...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731123
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731123,
					"content": "#Николь продолжает свою длинную и бессвязную историю. После множества странных поворотов сюжета даже {F#главная героиня}{M#главный герой} перестаёт быть человеком...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766731124
					]
				},
				{
					"id": 766731124,
					"content": "#В общем, вот такая история. {F#В итоге девушка, которая к этому моменту превратилась в кошку, вместе с ведьмой успешно сорвала заговор.}{M#В итоге юноша, который к этому моменту превратился в кота, вместе с ведьмой успешно сорвал заговор.} Затем они вернулись в хижину ведьмы и жили долго и счастливо. Конец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731125
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731125,
					"content": "У-у-у... Это было прекрасно. Путешествие, полное любви и борьбы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766731126,
					"content": "Выглядит так, будто начало и конец принадлежат разным историям...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731127
					]
				},
				{
					"id": 766731127,
					"content": "Ничего не поделаешь. Все творения рано или поздно выходят из-под контроля своего создателя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731128
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731128,
					"content": "Мы, ангелы, яркий тому пример. Когда-то нам было поручено вести людей, но из-за того, что некоторые из нас выбрали другой путь, вся наша раса была наказана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731129
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731129,
					"content": "Даже небесный порядок не может полностью контролировать то, что он создал... Что уж говорить обо мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731130
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731130,
					"content": "Судьба непостижима, и всё же... я надеюсь, что смогу привести тех, кого встречаю, к счастливому концу их истории. Это касается и персонажей моих рассказов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731131
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731131,
					"content": "История закончилась, и я немного устала. В следующий раз, когда у меня будет хорошая история, я обязательно поделюсь ею с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731135
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731135,
					"content": "Она оказалась второй дочерью Мяутреса III.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731136
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731136,
					"content": "#Она помогала {F#девушке}{M#юноше}. Но лишь для того,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731137
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731137,
					"content": "чтобы подтолкнуть сестру к предательству и получить право на престол...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Николь"
				},
				{
					"id": 766731109,
					"content": "Слишком много пропущено в процессе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				}
			]
		},
