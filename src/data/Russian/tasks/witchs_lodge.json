						"sceneId": 3,
						"position": [
							5487.895,
							196.07,
							9688.167
						],
						"pointId": 14930
					}
				]
			},
			"dialogs": [
				{
					"id": 766730801,
					"content": "#{F#Давным-давно жила-была девушка, которая сбежала из дома. Она потратила последнюю мору и брела холодной зимой куда глаза глядят, дрожа от холода в лёгкой одежде...}{M#Давным-давно жил-был юноша, который сбежал из дома. Он потратил последнюю мору и брёл холодной зимой куда глаза глядят, дрожа от холода в лёгкой одежде...}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730802
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730802,
					"content": "#{F#В этот момент девушка оступилась и провалилась в странное место. Не успела она опомниться, как раздался голос...}{M#В этот момент юноша оступился и провалился в странное место. Не успел он опомниться, как издалека голос...}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730803
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730803,
					"content": "#«Это тайная хижина великой и бессмертной ведьмы Николь Коко. О {F#несчастная девушка}{M#несчастный юноша}, поведай мне о своём самом сокровенном желании, и под моим руководством ты его исполнишь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730804
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730804,
					"content": "А-а-а... Паймон, кажется, слышала странный голос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766730805,
					"content": "Николь Коко... Кто это? Мы с ней знакомы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7667309,
			"completionStepIds": [
				7667309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667309",
							"2"
						],
						"stepId": 7667309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730901,
					"content": "Николь, мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766730902,
					"content": "Как быстро! Невероятно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730903
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730903,
					"content": "Паймон польщена! Но как мы передадим тебе снимки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730904
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766730904,
					"content": "Пока оставьте их у себя. Я прибуду через пару дней, тогда и обсудим всё, что касается скульптур.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730905
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730905,
					"content": "Отлично, тогда не прощаемся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7667310,
