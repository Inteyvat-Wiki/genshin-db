							9710.385
						],
						"pointId": 14939
					},
					{
						"sceneId": 3,
						"position": [
							5480.907,
							194.819,
							9712.115
						],
						"pointId": 14940
					},
					{
						"sceneId": 3,
						"position": [
							5481.945,
							194.575,
							9709.521
						],
						"pointId": 14942
					}
				]
			},
			"dialogs": [
				{
					"id": 766730201,
					"content": "#{F#Девушка была поражена}{M#Юноша был поражён} благородством и красотой ведьмы, и после долгого молчания {M#он торжественно обратился}{F#она торжественно обратилась} к ведьме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730202
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730202,
					"content": "#«О великая ведьма из далёких краёв, как ты прекрасна и мудра! В тот момент, когда я увидел{F#а} тебя, сердце моё затрепетало. Теперь всё, чего оно жаждет, - это исполнить твои желания».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730203
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730203,
					"content": "На лице ведьмы появилась едва заметная улыбка: «Раз так, тогда выполни для меня несколько посильных дел. Твой проводник здесь, а награда ждёт тебя в скором времени».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730204
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730204,
					"content": "Проводник... это светящийся шар?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7667303,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730301,
					"content": "#«Секретная хижина... Где эта секретная хижина?» - {F#сказала молодая странница}{M#сказал молодой странник} с выражением недоумения на лице.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730302
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730302,
					"content": "#Услышав вопрос {F#девушки}{M#юноши}, ведьма вдруг заговорила в растерянности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730303
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730303,
					"content": "(Хм, а есть ли смысл делать её такой? ...Эх, ладно, пока оставлю как есть. Господин Девятый сможет позже отредактировать.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730304
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730304,
					"content": "#«Э-э-э, довольно невежливо задавать такие вопросы, {F#девушка}{M#юноша}. Хижина ведьмы находится на реконструкции. Очень скоро её великолепие поразит тебя».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730305
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730305,
					"content": "«Это будет твоим испытанием. Приложи все усилия и помоги великой ведьме обустроить её жилище».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осмотреть"
				}
			]
		},
		{
			"id": 7667304,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730401,
					"content": "#«Что ж, {F#девушка}{M#юноша}. Теперь ты знаешь о проблемах, с которыми столкнулась ведьма... Николь Коко нужна твоя помощь, чтобы обустроить свои священные владения».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730402
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730402,
					"content": "#Ведьма улыбнулась и налила {F#гостье}{M#гостю} чашку чая: «Какой выбор ты сделаешь?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730403,
						766730404
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730403,
					"content": "Сочту за честь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				},
				{
					"id": 766730405,
					"content": "Минуточку! Разве не стоит дважды подумать, прежде чем ввязываться в это? Мы же ничего не знаем об этой женщине. И она кажется странной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766730406,
					"content": "Хм... но эта чашка выглядит знакомой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730407,
						766730408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766730407,
					"content": "Наконец-то поняла?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730409,
					"content": "Николь Коко... А! Она... ведьма Н.? Николь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766730410,
					"content": "Правильный ответ. А как тебе история?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730411
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730411,
					"content": "#Так... история ведь не закончена? Что произошло дальше? Что стало с {F#девушкой}{M#юношей} и ведьмой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766730412,
					"content": "Я ещё не придумала. Остальное додумаю, когда закончу строить хижину ведьмы. Возможно, тогда у меня появится новое вдохновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730413
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730413,
					"content": "Раз вы слышите мой голос, значит, вы сейчас в Нод-Крае. Не могли бы вы помочь мне кое с чем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730414,
						766730416
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730414,
					"content": "С чем именно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730415
					]
				},
				{
					"id": 766730415,
					"content": "Я планирую создать новые скульптуры во время строительства хижины. Правда, пока у меня нет вдохновения, поэтому хочу поручить вам сделать несколько впечатляющих снимков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730418,
					"content": "Серьёзно? Ладно, мы поможем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730419
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766730419,
					"content": "Подожди здесь. Посмотрим, что сможем найти. Но не забудь закончить рассказ, когда скульптуры будут готовы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766730416,
					"content": "Это имеет отношение к скульптурам?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730417
					]
				},
				{
					"id": 766730417,
					"content": "Да, я планирую создать несколько новых скульптур, чтобы украсить своё жилище. Правда, пока у меня нет вдохновения. Не могли бы вы сделать несколько впечатляющих снимков?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730408,
					"content": "Это кто-то, кого мы знаем...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730404,
					"content": "Великая ведьма Николь Коко, жду твоих указаний!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				}
			]
		},
		{
