			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5461.151,
							198.892,
							9742.186
						],
						"pointId": 14953
					}
				]
			},
			"dialogs": [
				{
					"id": 766730101,
					"content": "#Продолжая путь, {M#юноша заметил}{F#девушка заметила} множество изящных скульптур во владениях ведьмы. «Что это?» - в недоумении спросил{F#а} он{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730102
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730102,
					"content": "«Это враги ведьмы, которые жаждали её силы, поэтому она превратила их в камень».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730103
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730103,
					"content": "Хм, мне нравится. Это было спонтанное решение, но, смею сказать, очень удачное. Ведьма должна быть могущественной и опасной... Опасность придаёт ей загадочность, а без загадочности мир становится скучным и унылым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730104
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730104,
					"content": "(С другой стороны, разве не слишком жестоко превращать людей в камень? Никто не захочет долго общаться с таким странным человеком. Лучше воспринять сказанное ранее как предостережение.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730105
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730105,
					"content": "#После этих слов {F#девушка покрылась}{M#юноша покрылся} холодным потом. В этот момент раздался смех ведьмы: «Хе-хе, ты и правда поверил{F#а}? Это всего лишь способ остановить время с помощью скульптуры».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730106
					],
					"speakerTitle": "Осмотреть"
				},
				{
					"id": 766730106,
					"content": "#«Скульптура - вот что мне нужно, чтобы ты сделал{F#а}. В домике ведьмы не хватает милых творений».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осмотреть"
				}
			]
		},
		{
			"id": 7667302,
			"completionStepIds": [
				7667302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
