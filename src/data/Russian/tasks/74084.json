			},
			"dialogs": [
				{
					"id": 740841101,
					"content": "...А!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841102
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841102,
					"content": "Откуда там мелюзина? Эй! Скорее уходи от вишапа, это опасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841103,
					"content": "Внезапно появившаяся мелюзина протягивает руку, чтобы погладить вишапа по голове, и взбешённый вишап послушно ложится.\\nОн открывает рот, выплёвывает сверкающую каплю, а затем разворачивается и прыгает в воду.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740841104
					]
				},
				{
					"id": 740841104,
					"content": "А? В чём дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841105,
					"content": "Ключ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841106
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841106,
					"content": "К... какой ключ? Эта капля - ключ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841107,
					"content": "Пашив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841108
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841108,
					"content": "Гм... Эта капля - Пашив?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841109,
					"content": "Мелюзина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841110
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841110,
					"content": "Ох! Что это значит? Капля - это мелюзина? У Паймон голова идёт кругом. В чём же дело? Это ведь ты здесь мелюзина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841111,
					"content": "Пашив...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841112
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841112,
					"content": "Гм... Ты Пашив? Подожди, не отвечай... После твоего ответа Паймон точно станет ещё хуже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841113,
					"content": "Паймон будет называть тебя Пашив, хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841114,
					"content": "Мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841115
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841115,
					"content": "#{NICKNAME}... Что же делать? Паймон её совершенно не понимает. О чём она говорит?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841116,
					"content": "Ты нас понимаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841117
					]
				},
				{
					"id": 740841117,
					"content": "Пашив...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841118
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841118,
					"content": "Эта капля - ключ, так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841119
					]
				},
				{
					"id": 740841119,
					"content": "Пашив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841120
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841120,
					"content": "Ты не человек, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841121
					]
				},
				{
					"id": 740841121,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841122
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841122,
					"content": "Гм... Не стоит грубить, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841123,
					"content": "Я не человек, правильно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841124
					]
				},
				{
					"id": 740841124,
					"content": "М... мелюзина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841125
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841125,
					"content": "Ага! Подожди-ка, Паймон, кажется, поняла... «Пашив» - это «да», а «мелюзина» - «нет». Правильно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841126,
					"content": "Пашив! Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841127
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820737,
					"content": "Пашив! Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820738
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841127,
					"content": "Оказывается, тебя зовут не Пашив... Прости, Паймон перепутала твоё имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841128,
					"content": "Пашив... Нравится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841129
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841129,
					"content": "Тебе нравится это имя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841130
					]
				},
				{
					"id": 740841130,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841131
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841131,
					"content": "#Отлично! Тогда мы так и будем тебя называть, хи-хи. Паймон зовут Паймон, это {NICKNAME}. Приятно познакомиться. Спасибо, что помогла нам прогнать вишапа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841132,
					"content": "Синяя штука, хорошая штука, ключ, защищать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841133
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841133,
					"content": "Синяя штука - это тот вишап?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841134
					]
				},
				{
					"id": 740841134,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841135
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841135,
					"content": "Неужели он помогал тебе защищать ключ? Вы с ним друзья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841136,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841137
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841137,
					"content": "Фиолетовая штука, забрать ключ... Синяя штука, обморок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841138
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841138,
					"content": "Ф-фиолетовая штука? Это кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841139,
					"content": "#Фиолетовая штука, плохая штука! Синяя штука, Паймон, {NICKNAME}, хорошая штука!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841140
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841140,
					"content": "Так... Ладно, Паймон понимает, что ты нас хвалишь, но звучит очень странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841141
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841141,
					"content": "Фиолетовая штука, очень сильно плохая, Эринии, мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841142
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841142,
					"content": "Мелюзина Эринии? Гм... «Эринии-нет»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841143,
					"content": "С островом Эриний что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841144
					]
				},
				{
					"id": 740841144,
					"content": "Эринии, мелюзина, сейчас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841145
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841145,
					"content": "Пашив, Эринии, защищать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841146
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841146,
					"content": "С островом Эриний происходит что-то плохое, и ты хочешь его защитить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841147
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841147,
					"content": "#Паймон, {NICKNAME}, Эринии, пом, пом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841148
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841148,
					"content": "#Гм... Пом-пом? Эм... Ты хочешь, чтобы {NICKNAME} и Паймон дважды сделали острову Эриний «пом-пом»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841149
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841149,
					"content": "Мелюзина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841150
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841150,
					"content": "Тебе нужна наша помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841151
					]
				},
				{
					"id": 740841151,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841152
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841152,
					"content": "Оказывается, «пом» значит «помощь». Это хорошо. Сделать острову «пом-пом» было бы гораздо сложнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841153
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841153,
					"content": "Пом-пом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841154,
						740841158
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841154,
					"content": "А награда будет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841155
					]
				},
				{
					"id": 740841158,
					"content": "Как же нам помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841159
					]
				},
				{
					"id": 740841155,
					"content": "Наг... рада?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841156
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841156,
					"content": "#Ох, {NICKNAME}, ты посмотри на Пашив. Она толком не говорит и, наверняка, не сможет найти других желающих помочь. Давай просто возьмёмся за дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841157
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841157,
					"content": "Как же нам помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841159
					]
				},
				{
					"id": 740841159,
					"content": "Ключ, ключ, ключ, число.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841160
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841160,
					"content": "А потом? Что за число ключей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841161
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841161,
					"content": "Ключ! Ключ! Ключ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841162
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841162,
					"content": "Три ключа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841163
					]
				},
				{
					"id": 740841163,
					"content": "Пашив! Ключ, туман-путь, юг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841164
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841164,
					"content": "Ключ, источник, север...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841165
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841165,
					"content": "Ключ, ива, восток...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841166
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841166,
					"content": "Ох, так вот в чём дело... Паймон нужно записать... Всего три ключа: туманный путь на юге, источник на севере и ива на востоке... Верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841167
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841167,
					"content": "Ключ, ключ, ключ, площадь, запад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841168
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841168,
					"content": "На площади с запада есть ещё три ключа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841169
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841169,
					"content": "Собрать три ключа и отправиться на площадь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841170
					]
				},
				{
					"id": 740841170,
					"content": "#Паймон, мелюзина! {NICKNAME}, Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841171
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841171,
					"content": "#Эх, Пашив, не говори так, будто {NICKNAME} умнее Паймон! Паймон с {M#ним}{F#ней} на одном уровне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841172
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841172,
					"content": "Давайте подытожим. Мы уже добыли один ключ. Кажется, остаётся получить ещё два.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841173
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841173,
					"content": "Эриний, мелюзина... Пашив, защищать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841174
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841174,
					"content": "Не переживай. Пусть мы не знаем, что произошло, но мы поможем тебе защитить остров Эриний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841175
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841175,
					"content": "Паймон хочет ещё кое-что дополнить. Пашив, если вдруг ты случайно увидишь бесхозную вещицу, такую золотистую кругленькую... или некий ценный сундук...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841176
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841176,
					"content": "Будет здорово, если ты нам об этом расскажешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841177
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841177,
					"content": "Пашив задумчиво почесала голову, затем радостно подпрыгнула два раза и в спешке удалилась.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740841178
					]
				},
				{
					"id": 740841178,
					"content": "#Ох, она взяла и убежала. Наверное, что-то срочное. {NICKNAME}, давай отправимся на поиски двух других ключей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
