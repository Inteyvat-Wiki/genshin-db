			"dialogs": [
				{
					"id": 740841201,
					"content": "...Мелюзина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841202
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841202,
					"content": "Пашив? А ты откуда появилась?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841203,
					"content": "След простыл, Пашив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841204
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841204,
					"content": "Ох, поскорее уходи от вишапа, это опасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841205,
					"content": "Паймон добрая, Пашив! Опасность, мелюзина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841206
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841206,
					"content": "Пашив протягивает руку, чтобы погладить вишапа по голове, и взбешённый вишап послушно ложится.\\nОн открывает рот, выплёвывает сверкающую каплю, а затем разворачивается и прыгает в воду.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740841207
					]
				},
				{
					"id": 740841207,
					"content": "Ключ, ключ, Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841208
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841208,
					"content": "Ого! Вишап сам отдал ключ? Удивительно, что он тебя слушается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841209,
					"content": "Синяя штука, хорошая штука, ключ, защищать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841210
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841210,
					"content": "Синяя штука - это тот вишап?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841211
					]
				},
				{
					"id": 740841211,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841212
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841212,
					"content": "Неужели он помогал тебе защищать ключ? Вы с ним друзья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841213,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841214
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841214,
					"content": "Фиолетовая штука, забрать ключ... Синяя штука, обморок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841215
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841215,
					"content": "Ф-фиолетовая штука? Это кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841216,
					"content": "#Фиолетовая штука, плохая штука! Синяя штука, Паймон, {NICKNAME}, хорошая штука!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841217
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841217,
					"content": "Так... Ладно, Паймон понимает, что ты нас хвалишь, но звучит очень странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841218,
					"content": "Фиолетовая штука, очень сильно плохая, Эринии, очень мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841219
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841219,
					"content": "Понятно... Ты самая необычная мелюзина из тех, которых Паймон встречала... Кстати, на памяти Паймон большинство мелюзин живут в Кур-де-Фонтейне или в деревне Меруси... Почему ты здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841220,
					"content": "Кур-де-Фонтейн? Деревня Меруси?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841221
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841221,
					"content": "Судя по твоему недоумению, ты никогда не слышала эти названия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841222,
					"content": "Кур-де-Фонтейн, мелюзина... Деревня Меруси, мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841223
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841223,
					"content": "Хм... Эринии, Пашив, дом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841224
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841224,
					"content": "Эринии, Пашив, защищать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841225
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841225,
					"content": "Постой. Хочешь сказать, что здесь твой дом? Ты защищаешь свой дом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841226,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841227
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841227,
					"content": "Но дом мелюзин в деревне Меруси, нет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841228
					]
				},
				{
					"id": 740841228,
					"content": "Да, странно. Разве мелюзины могут рождаться в других местах? Кажется, здесь больше нет других мелюзин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841229,
					"content": "Пашив, ты одна здесь живёшь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841230
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841230,
					"content": "Одна? Мелюзина. Новый валет! Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841231
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841231,
					"content": "Новый... валет? Валет? Какой валет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841232,
					"content": "#Новый валет! Паймон - Паймон, {NICKNAME} - {NICKNAME}. Новый валет - Новый валет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841233
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841233,
					"content": "Так кто же этот Новый валет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841234
					]
				},
				{
					"id": 740841234,
					"content": "Пашив... Может, ты хочешь сказать, что Нового валета зовут Новый валет, как Паймон зовут Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841235,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841236
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841236,
					"content": "А-ха! Оказывается, вот в чём дело. Паймон права, Паймон тоже умная!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841237,
						740841238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841237,
					"content": "Какое странное имя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841239
					]
				},
				{
					"id": 740841238,
					"content": "Какое классное имя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841239
					]
				},
				{
					"id": 740841239,
					"content": "Новый валет, Пашив, знания, пом-пом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841240
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841240,
					"content": "Да... Ты хочешь сказать, что Новый валет учил тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841241,
					"content": "Пашив! Очень много. Язык, мудрость... Очень много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841242
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841242,
					"content": "Хм, Паймон кажется, что не очень уж и много...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841243
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841243,
					"content": "Пашив, Новый валет, защищать, пом-пом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841244
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841244,
					"content": "Он тоже помогает тебе защищать это место?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841245
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841245,
					"content": "Мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841246
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841246,
					"content": "Ты помогаешь ему защищать это место?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841247
					]
				},
				{
					"id": 740841247,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841248
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841248,
					"content": "Вот оно что... Так кто же этот Новый валет? Почему ему нужна твоя помощь, чтобы защитить это место?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841249
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841249,
					"content": "Здесь действительно произошло что-то плохое. Надписи на каменной табличке были кем-то стёрты, и осталось ещё много скверны... Это дело рук того фиолетового?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841250
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740841250,
					"content": "Паймон любопытная, Пашив! Но время очень не очень много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841251
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841251,
					"content": "Ключ, ключ, ключ, площадь, запад. Пом-пом, пом-пом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841252
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740841252,
					"content": "Мы поторопимся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841253
					]
				},
				{
					"id": 740841253,
					"content": "#Паймон, Пашив! {NICKNAME}, Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841254
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740831040,
					"content": "Пашив дважды радостно подпрыгнула, а потом второпях удалилась.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740841255,
					"content": "Кажется, времени немного. Хорошо, что у нас уже два ключа. Нужно собраться и достать третий ключ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}