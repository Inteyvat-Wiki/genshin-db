			"dialogs": [
				{
					"id": 740840801,
					"content": "...Мелюзина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840802
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740840802,
					"content": "Пашив, ты как здесь оказалась? Скорее отойди от вишапа, это опасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740840803,
					"content": "Паймон добрая, Пашив! Опасность, мелюзина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840804
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740840804,
					"content": "Пашив протягивает руку, чтобы погладить вишапа по голове, и взбешённый вишап послушно ложится.\\nОн открывает рот, выплёвывает сверкающую каплю, а затем разворачивается и прыгает в воду.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740840805
					]
				},
				{
					"id": 740840805,
					"content": "Это ключ! Вишап всё время держал его во рту! Но почему он так охотно отдал его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740840806,
					"content": "Синяя штука, хорошая штука, ключ, защищать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840807
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740840807,
					"content": "Синяя штука - это тот вишап?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740840808
					]
				},
				{
					"id": 740840808,
					"content": "Пашив, ты дружишь с этим вишапом? Он помогает тебе охранять ключ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740840809,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840810
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740840810,
					"content": "Фиолетовая штука, забрать ключ... Синяя штука, обморок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840811
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740840811,
					"content": "Ф-фиолетовая штука? Это кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840812
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740840812,
					"content": "#Фиолетовая штука, плохая штука... Синяя штука, Паймон, {NICKNAME}, хорошая штука!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840813
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740840813,
					"content": "Так... Ладно, Паймон понимает, что ты нас хвалишь, но звучит очень странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840814
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740840814,
					"content": "Фиолетовая штука, очень сильно плохая, Эринии, очень мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840815
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740840815,
					"content": "Ты имеешь в виду...Этому острову угрожает та фиолетовая штука? Хорошо, что ключ теперь в наших руках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840816
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740840816,
					"content": "#Паймон, {NICKNAME}, Пашив! Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840817
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740840817,
					"content": "Ключ, ключ, ключ, площадь, запад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840818
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740840818,
					"content": "Ясно. Пашив, не нервничай. Мы сейчас отправляемся на площадь на западе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
