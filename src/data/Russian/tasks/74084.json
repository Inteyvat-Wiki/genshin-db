					"nextDialogs": [
						740840602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740840602,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840603
					],
					"speakerTitle": "Спящий вишап"
				},
				{
					"id": 740840603,
					"content": "Караул! Вишап проснулся! Бежим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740840604,
					"content": "Вишап у алтаря просыпается, его глаза светятся гневом и злобой...\\nВы с Паймон быстро плывёте к берегу... Но вишап следует за вами по пятам...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
