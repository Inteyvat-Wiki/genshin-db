			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джазари"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730261301,
					"content": "Я же сказал, что всё нужно делать по инструкции...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261302
					],
					"speakerTitle": "Джазари"
				},
				{
					"id": 730261302,
					"content": "Мы ничего не трогали...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261303
					]
				},
				{
					"id": 730261303,
					"content": "Рука просто взяла и упала. Паймон думает, что проблема в роботе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730261304,
					"content": "Ладно, спишу на несчастный случай во время эксперимента. Ох... Надеюсь, это не скажется на моём отчёте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261305
					],
					"speakerTitle": "Джазари"
				},
				{
					"id": 730261305,
					"content": "Что ж, видимо, голема уже не запустить. Так что вам больше нет смысла тут оставаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261306
					],
					"speakerTitle": "Джазари"
				},
				{
					"id": 730261306,
					"content": "Я знаю, что вы тут исследуете загрязнение руин, но от голема сейчас мало толку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261307
					],
					"speakerTitle": "Джазари"
				},
				{
					"id": 730261307,
					"content": "Тем не менее вы можете достичь весьма неожиданных результатов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261308
					],
					"speakerTitle": "Джазари"
				},
				{
					"id": 730261308,
					"content": "Что ж, больше я вас не задерживаю. Моё исследование окончено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261309
					],
					"speakerTitle": "Джазари"
				},
				{
					"id": 730261309,
					"content": "Вы можете вернуться ко мне, когда закончите свою работу... Если меня не накажут за уничтожение голема руин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261310
					],
					"speakerTitle": "Джазари"
				},
				{
					"id": 730261310,
					"content": "Тогда я помогу вам официально подать заявку на исследование ядер хаоса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261311
					],
					"speakerTitle": "Джазари"
				},
				{
					"id": 730261311,
					"content": "Только я не буду ответственным на этом проекте. Но половина финансирования ваша.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261312
					],
					"speakerTitle": "Джазари"
				},
				{
					"id": 730261312,
					"content": "Каждый может начать карьеру в Академии, была бы тяга к знаниям! Дерзайте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джазари"
				}
			]
		}
	]
}