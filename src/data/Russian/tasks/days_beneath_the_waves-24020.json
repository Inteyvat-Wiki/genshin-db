	"talks": [
		{
			"id": 2402001,
			"completionStepIds": [
				2402001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402001",
							"2"
						],
						"stepId": 2402001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ив"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200101,
					"content": "Ну и невезение! Опять лезть под воду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200102,
						240200103
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				},
				{
					"id": 240200104,
					"content": "Ах, это ты. Как приятно встретиться! Я... я чуть не погиб там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200105
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200105,
					"content": "Я выполнял подводные работы, как обычно. Погрузился под воду, не зацепился за водоросли, увернулся от мусора, не порезался и не проткнул костюм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200106
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200106,
					"content": "Но когда я приступил к собиранию предметов, из грязи вылезли монстры и напали на меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200107
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200107,
					"content": "Не помню, что это были за твари. Они так быстро накинулись, что мне пришлось всплывать как можно быстрее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200108
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200108,
					"content": "Но вскоре я столкнулся со странными механическими рыбами, и они тоже набросились на меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200109
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200109,
					"content": "Не знаю, как я только добрался до берега без единой царапины...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200110,
						240200111
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200110,
					"content": "Это ведь опасно. Не стоит здесь работать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200112,
					"content": "Но я не могу! Голдман назначил мне именно это место... Хотя многие здесь уже получили увечья, а кто-то и похуже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200113
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200113,
					"content": "Со временем даже угрозы и штрафы перестали помогать, никто не хотел здесь работать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200114
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200114,
					"content": "Тогда он сменил тактику и предложил работникам на этом участке в три раза больше моры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200115
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200115,
					"content": "Вот и вышло, что мы с приятелями, которым тоже нужна мора, взялись за работу. Мы даже подводные копья взяли для защиты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200116
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200116,
					"content": "Правда, оружия хватило всего на несколько дней. Одни копья сломались, другие потерялись... Приятели отправились за новыми копьями, а я остался сторожить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200117,
						240200118
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200117,
					"content": "И ты полез под воду? Зачем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200119,
					"content": "Их так долго нет! Они словно забыли, что если вовремя не начать, придётся остаться допоздна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200120
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200120,
					"content": "Давай помогу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200121
					]
				},
				{
					"id": 240200121,
					"content": "Нет, не пойдёт! Там настоящие чудовища, и бьются они по-настоящему! Простой искатель приключений с ними не справится. Я не позволю тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200122,
						240200123
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200122,
					"content": "#Я не {F#простая искательница}{M#простой искатель} приключений.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200124,
					"content": "Ну... Пожалуй, что нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200125
					],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200125,
					"content": "#Хорошо. Если ты настаиваешь, я отмечу место на карте... Но будь {F#осторожна}{M#осторожен}, я прошу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ив"
				},
				{
					"id": 240200123,
					"content": "#Я разве {F#похожа на простую искательницу}{M#похож на простого искателя} приключений?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200118,
					"content": "Ты погрузился без оружия?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200111,
					"content": "Это очень опасно. Выбери другое место для работы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200103,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				}
			]
		},
		{
			"id": 2402002,
