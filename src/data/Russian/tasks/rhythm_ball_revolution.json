			},
			"dialogs": [
				{
					"id": 755080101,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080102
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 755080102,
					"content": "#А вот и наши любимые {F#гостьи}{M#гости}! Значит, всё готово к веселью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080103
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 755080103,
					"content": "Привет, Муалани! Шилонен, ты тоже тут?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755080104,
					"content": "И Мидзуки? Ты что, приехала из Инадзумы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755080105,
					"content": "Да! Натланские друзья мне как вторая семья, а племя Народа Родников - как второй дом за пределами Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080106
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 755080106,
					"content": "И мне нужно следить за делами в натланском филиале бань «Аиса», чтобы жители Натлана тоже могли воспользоваться нашей помощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080107
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 755080107,
					"content": "Да, госпожа Мидзуки очень серьёзно относится к своим обязанностям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080108
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080108,
					"content": "По сравнению с ней даже самый образцовый сотрудник покажется бездельником...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080109,
						755080110
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080109,
					"content": "Шилонен, ты тоже пользуешься услугами Мидзуки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080111
					]
				},
				{
					"id": 755080111,
					"content": "Мне в последнее время снятся странные сны... Например, договорились с заказчиком, что работа займёт четыре недели, а он внезапно сокращает срок до одной недели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080112
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080112,
					"content": "Или приходит срочный заказ: «Изготовить украшение в виде сферы, чтобы оно внушало ощущение опасности...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080113,
						755080114
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080113,
					"content": "Я знаю, это подвеска в виде слайма или плесенника!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080115
					]
				},
				{
					"id": 755080115,
					"content": "#Ого, ты так быстро высказал{F#а} предположение! Или это ты досаждаешь Шилонен во сне своими заказами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755080116,
					"content": "А это... опасные сущности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080117
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080117,
					"content": "На самом деле срок здесь не так важен, но работать с круглыми украшениями непросто. И если поторопиться, результат может не обрадовать заказчика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080118
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080118,
					"content": "А во сне у меня отбоя нет от таких заказов. Так что я доделала все заказы и решила опробовать на себе услуги госпожи Мидзуки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080119
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080119,
					"content": "И знаете, это работает. Днём я заснула, и никакие странные сны мне больше не снились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080120
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080120,
					"content": "Для меня большая честь помочь госпоже Шилонен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080121
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 755080121,
					"content": "Но мне показалось, что в победе над странными снами ваша заслуга намного больше моей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080122
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 755080122,
					"content": "Ладно, главное, что сейчас у всех отличное настроение! Самое время как следует расслабиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080123
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 755080123,
					"content": "Народ Родников возрождает традицию вечеринок на воде! Повеселимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080124,
						755080125
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 755080124,
					"content": "Вечеринки на воде?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080126
					]
				},
				{
					"id": 755080126,
					"content": "Ура-а-а! Повеселимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755080127,
					"content": "Э... Только Паймон никогда раньше не была на таких вечеринках. Наверное, там будет много вкусных угощений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755080128,
					"content": "Но как обычно натланцы развлекаются на вечеринках?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080129,
						755080130,
						755080131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755080129,
					"content": "Гоняют по волнам на кохолазаврах?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080132
					]
				},
				{
					"id": 755080132,
					"content": "А Паймон можно так попрыгать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755080133,
					"content": "Ой, да вы у меня опытные экстремалы! Честно говоря, я тоже сразу подумала об этих развлечениях!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080134
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 755080134,
					"content": "Но вождь Амина сказала серьёзным тоном... Кхм... «Для обычного человека в таких развлечениях слишком много экстрима!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080135
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 755080135,
					"content": "«Даже во время игры в пляжный волейбол кто-то может не рассчитать силы и случайно травмировать товарища по команде!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080136
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 755080136,
					"content": "«А если на вечеринке человек вместо весёлых впечатлений получит психологическую травму, работы у госпожи Мидзуки только прибавится!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080137
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 755080137,
					"content": "Она права. Я всегда рада помочь, но не хотелось бы самой наносить клиентам травмы. Так что пусть лучше все останутся целы и невредимы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080138
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 755080138,
					"content": "Хе-хе, вот поэтому я и решила с тобой посоветоваться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080139
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 755080139,
					"content": "Кажется, вы уже что-то придумали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755080140,
					"content": "Да, мы пришли к взаимопониманию. Не все люди имеют опыт занятий экстремальным спортом. А мы хотим привлечь на вечеринку как можно больше гостей, и чтобы они не чувствовали себя спасовавшими перед опасными заданиями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080141
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 755080141,
					"content": "Мы всё обсудили, я рассказала про Фестиваль цветов Микавы, и госпожа Муалани очень заинтересовалась весёлыми и лёгкими играми, которые мы там проводим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080142
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 755080142,
					"content": "Нам пришла в голову мысль придать игре Акицу Ханэасоби колорит Натлана. И мы придумали лёгкую и весёлую игру «Мяч под ритмы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080143
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 755080143,
					"content": "Игра из Инадзумы... с колоритом Натлана... Какое неожиданное сочетание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080144,
						755080145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755080144,
					"content": "#Я видел{F#а} Деку танцев в племени Детей Эха...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080146
					]
				},
				{
					"id": 755080146,
					"content": "#И это ты ещё не слышал{F#а}, как она звучит на максимальную громкость. Наверное, ты здорово ловишь ритм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080147
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080147,
					"content": "Значит, тебе понравится! Участникам нужно будет отбивать мяч и разбивать блоки, попадая в ритм музыки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080148
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080148,
					"content": "Никакой сложной техники, никакой опасности, только свобода и инстинкты. Эта игра понравится любому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080149
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080149,
					"content": "#Конечно, одарённые участники вроде тебя, {NICKNAME}, во время игры смогут выбивать особый ритм и по-новому раскрывать звучащую музыку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080150
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080150,
					"content": "Разные диджеи придают одной и той же мелодии совершенно разное звучание. Думаю, в ритмичных играх действует похожий принцип.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080151
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080151,
					"content": "Кто знает... Быть может, лёгкий фоновый трек в твоём исполнении приобретёт трансовое или арткорное звучание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080152
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080152,
					"content": "Не могу дождаться начала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080153
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755080153,
					"content": "#Паймон ничегошеньки не поняла! Но {NICKNAME} наверняка отлично справится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080154,
						755080155
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755080154,
					"content": "Отлично, музыка и игры! Это по моей части!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080156
					]
				},
				{
					"id": 755080156,
					"content": "Да, именно такой настрой нам и нужен! Главное, чтобы вам с Паймон было весело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080157
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 755080157,
					"content": "Я запасусь напитками и вкусняшками, и мы будем наблюдать за игрой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080158
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 755080158,
					"content": "Только не забывайте, что чрезмерное перевозбуждение тоже вредно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080159
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 755080159,
					"content": "Ты ведь не хочешь, чтобы перед сном в голове бесконечно крутились мелодии из Деки танцев, не давая заснуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080160
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 755080160,
					"content": "Спасибо! Мы повеселимся от души!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080161
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755080161,
					"content": "Кстати, если за подбор музыки отвечает Шилонен... Паймон не против послушать во сне классные мелодии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755080155,
					"content": "Я буду очень стараться!",
					"roleType": "TALK_ROLE_PLAYER",
