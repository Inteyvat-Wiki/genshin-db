			"dialogs": [
				{
					"id": 401890801,
					"content": "Похоже, эта сотрудница вжилась в роль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890802,
						401890803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401890802,
					"content": "Успехов в работе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				},
				{
					"id": 401890804,
					"content": "Ха-ха-ха, вы молодцы. Вы отличные боссы. Даже лучше, чем я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890805
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890805,
					"content": "Теперь «Страна кинофантазий Шевальмарин» официально открыта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890806
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890806,
					"content": "Управление парком развлечений - это долгосрочный проект. Поспешив, ничего не добьёшься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890807
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890807,
					"content": "Работа почти закончена. Давайте сделаем небольшой перерыв и дождёмся отчёта о доходах за этот период.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890803,
					"content": "Я буду внимательно следить за работой персонала!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				}
			]
		},
