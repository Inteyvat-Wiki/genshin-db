			"dialogs": [
				{
					"id": 401891301,
					"content": "О! Нас ждёт классическая импровизация Эскофье: «таинственные блюда, вдохновлённые ключевыми ингредиентами»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Навия"
				}
			]
		},
		{
