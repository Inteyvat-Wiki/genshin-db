			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Навия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401890429,
					"content": "#Я готов{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890401
					]
				},
				{
					"id": 401890401,
					"content": "#Дорогие {M#напарники}{F#напарницы}, пришло время познакомиться со «Страной кинофантазий Шевальмарин»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890402
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890402,
					"content": "Как я уже говорила, «Страну кинофантазий Шевальмарин» организовали энтузиасты, а Спина-ди-Росула отвечает за планирование, строительство и эксплуатацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890403
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890403,
					"content": "Энтузиасты, как правило, не являются полноценными экспертами. Обычно они занимаются оформлением киосков для мероприятий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890404
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890404,
					"content": "А мы отвечаем за долгосрочное планирование и разработку пособий по стандартным игровым процессам для различных видов активностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890405
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890405,
					"content": "Долгосрочное планирование... разработка... Очень сложно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401890406,
					"content": "Мы проводим большую часть времени в приключениях! И у нас никогда не было собственного ларька. Как думаешь, мы справимся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890407,
						401890408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401890407,
					"content": "Не все большие начальники учились в школах торговли, знаешь ли!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				},
				{
					"id": 401890409,
					"content": "#Вот это я понимаю! {M#Мой напарник много чего повидал на своём веку!}{F#Моя напарница много чего повидала на своём веку!} Можно сказать, что ты способствовал{F#а} развитию некоторых крупнейших торговых предприятий Тейвата!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890410
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890410,
					"content": "Итак! Прежде всего, давайте посмотрим, как будет проходить фестиваль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890411
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890411,
					"content": "#Кажется, Паймон начинает понимать. {NICKNAME}, а ты что думаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890412,
						401890413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401890412,
					"content": "Ха-ха, в этом деле я мастер.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890414,
					"content": "Да! Вместе мы справимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401890415,
					"content": "Навия упомянула «пособия по стандартным игровым процессам»... Значит, есть и нестандартные?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401890416,
					"content": "Конечно! У каждого своё представление о кино и развлечениях, поэтому мы предлагаем широкий выбор увлекательных аттракционов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890417
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890417,
					"content": "Если мы будем недостаточно внимательны, одни посетители могут заблудиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890418
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890418,
					"content": "А другие случайно возьмут в руки опасный реквизит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890419
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890419,
					"content": "Чтобы избежать путаницы, нам нужно составить «стандартное пособие» для каждого вида активности. Представьте, что это что-то вроде пошагового руководства!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890420,
						401890421
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890420,
					"content": "#Понятно. Ты хочешь, чтобы я стал{F#а} твоим подопытным кроликом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890422,
					"content": "Если мы первые, кто опробует площадку, нас могут ждать всевозможные «весёлые сюрпризы»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401890423,
					"content": "Если мы окажемся в трудной ситуации, нам придётся полагаться на свои навыки, чтобы выстоять!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401890424,
					"content": "#Я бы никогда не стала подвергать {M#своего напарника}{F#свою напарницу} опасности. Я тщательно проверила все объекты до вашего прибытия и могу заверить, что они совершенно безопасны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890425
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890425,
					"content": "#Я хотела, чтобы ты {F#познакомилась}{M#познакомился} с аттракционами раньше других и {F#поделилась}{M#поделился} своим мнением!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890426
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890426,
					"content": "Хе-хе, в этом вся Навия - всегда следит за тем, чтобы мы были в безопасности и веселились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401890427,
					"content": "Мне не терпится узнать, что вы думаете! Ваше мнение очень важно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890428
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890428,
					"content": "В общем, давайте начнём с «Красочного приключения» и составим первое пособие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Навия"
				},
				{
					"id": 401890421,
					"content": "#Понятно. Ты хочешь, чтобы я задал{F#а} планку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890413,
					"content": "Будем обучаться в процессе работы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890408,
					"content": "Нам не раз случалось вести крупные проекты!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				}
			]
		},
