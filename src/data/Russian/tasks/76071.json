			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Берина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760710101,
					"content": "Если бы у меня получилось сделать вкусный хлеб, он бы поднял всем настроение. Но в нынешней ситуации это непростая задача...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710102,
						760710103
					],
					"speakerTitle": "Берина",
					"speakerSubtitle": "Ратник"
				},
				{
					"id": 760710102,
					"content": "А в чём сложность?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710105
					]
				},
				{
					"id": 760710105,
					"content": "Дело в том, что я хочу испечь новый грибной хлеб. Мама пекла мне такой в детстве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710106
					],
					"speakerTitle": "Берина",
					"speakerSubtitle": "Ратник"
				},
				{
					"id": 760710106,
					"content": "Насколько я помню, сначала нужно было сделать начинку из грибов и ягод, а затем заполнить начинкой замешанное тесто и запечь всё в духовке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710107
					],
					"speakerTitle": "Берина",
					"speakerSubtitle": "Ратник"
				},
				{
					"id": 760710107,
					"content": "Самое важное - использовать муку из свежесобранной ржи. Именно она придаёт хлебу тот самый аромат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710108
					],
					"speakerTitle": "Берина",
					"speakerSubtitle": "Ратник"
				},
				{
					"id": 760710108,
					"content": "Мне нужно собрать немного ржи, но в последнее время некому присматривать за полем, и вокруг появилось много странных существ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710109
					],
					"speakerTitle": "Берина",
					"speakerSubtitle": "Ратник"
				},
				{
					"id": 760710109,
					"content": "Если бы господин Валдиш был здесь, он бы справился с ними, но у меня совсем нет опыта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710110
					],
					"speakerTitle": "Берина",
					"speakerSubtitle": "Ратник"
				},
				{
					"id": 760710110,
					"content": "Тебя не затруднит собрать немного ржи? Совсем немного, прошу. В награду я научу тебя готовить тёплый грибной хлеб.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Берина",
					"speakerSubtitle": "Ратник"
				},
				{
					"id": 760710103,
					"content": "Что ж, увидимся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710104
					]
				},
				{
					"id": 760710104,
					"content": "Ой, погоди... Можешь мне помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710105
					],
					"speakerTitle": "Берина",
					"speakerSubtitle": "Ратник"
				}
			]
		},
