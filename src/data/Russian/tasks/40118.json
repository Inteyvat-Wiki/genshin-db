				"points": []
			},
			"dialogs": [
				{
					"id": 401180901,
					"content": "Потомок прославленного клана Лоуренс многому научился во время своего путешествия. Например... печь лепёшки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180902
					],
					"speakerTitle": "Лессиг"
				},
				{
					"id": 401180902,
					"content": "Ага, такая температура будет в самый раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180903
					],
					"speakerTitle": "Лессиг"
				},
				{
					"id": 401180903,
					"content": "Не думала, что ты умеешь печь лепёшки... ты ведь из тех людей, которые на кухне даже не появляются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180904
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 401180904,
					"content": "Я как раз хотел попросить тебя уделить мне немного времени. Научишь меня, как готовить твои фирменные закуски?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180905
					],
					"speakerTitle": "Лессиг"
				},
				{
					"id": 401180905,
					"content": "А? Но на это уйдёт много времени... И мы здесь не для того, чтобы укреплять наши семейные связи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180906
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 401180906,
					"content": "Значит, тебе опять не дают покоя семейные связи? Но ты ведь сама сказала, что мы обычные люди. Почему бы нам не научить друг друга чему-нибудь, как это делают обычные родственники?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лессиг"
				}
			]
		},
		{
			"id": 4011810,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
