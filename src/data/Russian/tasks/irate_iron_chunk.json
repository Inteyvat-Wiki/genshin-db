				{
					"id": 730161601,
					"content": "Пф, а ты и в самом деле кое-что умеешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161602
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161602,
					"content": "Он похвалил нас! Хе-хе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161603,
					"content": "Теперь мы можем спуститься под землю, поспешим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161604
					],
					"speakerTitle": "Арабалика"
				},
				{
