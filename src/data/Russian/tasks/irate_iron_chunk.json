				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арабалика",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160301,
					"content": "Нара... и умеющее летать нечто?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160302
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160302,
					"content": "#Именно! Вообще-то, я - умеющая летать Паймон, а {M#он}{F#она} - {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160303,
					"content": "А ты, должно быть, Арабалика. Ты совсем нас не боишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160304,
					"content": "#{M#Золотой}{F#Золотая} нара {M#принёс}{F#принесла} с собой запах Арапанду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160305
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160305,
					"content": "Эм... Мы действительно от Арапанду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160306,
					"content": "Я не чувствую злобы, но если хотите напасть на меня, то поспешите, пока эта железяка ещё двигается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160307
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160307,
					"content": "Так вот что значит «воспользоваться моментом, пока аранара в опасности». Ни за что! Паймон на такое не способна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160308,
					"content": "Почему нет? Если Арабалика - ваш враг, напасть на меня с двух сторон - это лучшее решение. Даже во время охоты на животных используют этот метод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160309
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160309,
					"content": "Хм... звучит разумно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160310,
					"content": "Паймон совсем запуталась.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160311
					]
				},
				{
					"id": 730160311,
					"content": "В общем! Мы ни за что не воспользуемся чужой бедой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160312,
					"content": "Потому что аранары - наши друзья.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160313
					]
				},
				{
					"id": 730160313,
					"content": "#Да-да-да! Именно так! Потому что все аранары - наши друзья! А Паймон и {NICKNAME} так с друзьями не поступают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160314,
					"content": "Хм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160315
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160315,
					"content": "О... почему он выглядит очень недовольным?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160316,
						730160318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160316,
					"content": "Паймон не удалось произвести на него хорошее впечатление.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160317
					]
				},
				{
					"id": 730160317,
					"content": "Но Паймон ничего такого не сделала. Эх, у него такой сложный характер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160320,
					"content": "Точно, Арапанду говорил, что у Арабалики сильный араракалари. Должно быть, именно благодаря этому он только что сразил стража руин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160321,
					"content": "Паймон знает про араракалари?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160322
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160322,
					"content": "О! Конечно, Паймон знает! Это очень-очень мощная... способность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160323,
					"content": "Хм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160324
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160324,
					"content": "Ой! Паймон снова впала в немилость...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160325,
					"content": "Тогда перейдём к делу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160326
					]
				},
				{
					"id": 730160326,
					"content": "Да! Мы пришли сюда, чтобы помочь излечить машину Варуны. Здесь должны быть её ветви и листья. Но почему Паймон их не видит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160327,
					"content": "Какие ещё «ветви» и «листья»! Лучше уж сказать «корни»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160328
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160328,
					"content": "А? Вот как? Но Арапанду говорил, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160329,
					"content": "Машина Варуны получает энергию от корневой системы, распространённой по всей ване.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160330
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160330,
					"content": "Ну да, звучит логично...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160331
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160331,
					"content": "Так вот, корни - под землёй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160332
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160332,
					"content": "#Эти камни и обломки железа не принадлежат аранарам. Чтобы спуститься, сначала придётся разобраться с железяками. Они очень сильные, но {M#золотой}{F#золотая} нара тоже {M#силён}{F#сильна}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160333
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160333,
					"content": "#Ну, конечно же! {NICKNAME} уже со счёта {M#сбился}{F#сбилась}, сколько нам их попадалось на нашем пути!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160334
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160334,
					"content": "О? Арабалика с удовольствием посмотрел бы на способности нары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160335
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160335,
					"content": "О? Как же он смог спуститься так глубоко? А! Неужели он отправился к стражу руин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160336
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160336,
					"content": "#{NICKNAME}, давай скорее за ним!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160318,
					"content": "Может, он со всеми так себя ведёт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160319
					]
				},
				{
					"id": 730160319,
					"content": "Разве такое возможно? С виду он очень милый, а характер такой неприятный!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7301607,
			"completionStepIds": [
				7301607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301607",
							"2"
						],
						"stepId": 7301607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арабалика",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160701,
					"content": "Мы уже разобрались с большой железякой. Осталось миновать водяной поток - и можно спускаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160702
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160702,
					"content": "Но столько времени прошло, теперь здесь всё совершенно по-другому. Вполне возможно, что под землёй будут ещё железяки. Арабалика чувствует их запах. Плохо пахнет. Будьте осторожнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160703
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160703,
					"content": "#Нара {NICKNAME} обладает необходимыми способностями. За {M#него}{F#неё} я спокоен, но Паймон так же слаба, как Аранакула. Смотри, чтобы тебя не проглотили грибы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160704
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160704,
					"content": "Эх, это Арабалика слишком силён! Нам приходилось видеть разных аранар, но никто из них не смог бы справиться со стражем руин одним ударом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160705,
					"content": "Паймон почти ничего не знает об аранарах. Если бы тут был Арадаша, с этой железякой мы бы покончили в два счёта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160706
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160706,
					"content": "Араракалари Арадаши когда-то был очень сильным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160707
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160707,
					"content": "Когда-то? А сейчас чего?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160708,
					"content": "А сейчас Арадаши больше нет. Вот и приходится Арабалике вдвое усерднее тренироваться, чтобы усилить араракалари.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160709
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160709,
					"content": "Вот бы и Паймон научиться пользоваться араракалари!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160710,
						730160714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160710,
					"content": "Тогда в следующей битве рассчитываю на тебя, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160711
					]
				},
				{
					"id": 730160711,
					"content": "#Хи-хи, Паймон будет тебя защищать, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160712,
					"content": "Ты уж постарайся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160713
					]
				},
				{
					"id": 730160713,
					"content": "Паймон справится! Ты можешь поручить Паймон что угодно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160718,
					"content": "А Паймон - мечтательница. Не знаю уж, к добру это или нет. Но сейчас нам нужно найти каменный механизм, чтобы отвести воду. В противном случае нам не спуститься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160719
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160719,
					"content": "Аранара может прокопать вглубь земли, но не погрузиться в воду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160720
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730160720,
					"content": "#{NICKNAME}, давай осмотримся вокруг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160714,
					"content": "Паймон, тебе этому не научиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160715
					]
				},
				{
					"id": 730160715,
					"content": "Да было бы желание, и Паймон обязательно научится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730160716,
					"content": "Все так говорят...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160717
					]
				},
				{
					"id": 730160717,
					"content": "Может, переберёмся в безопасное место, поедим, отдохнём и попросим Арабалику обучить Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7301610,
			"completionStepIds": [
				7301610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301610",
							"2"
						],
						"stepId": 7301610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Арабалика"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161001,
					"content": "Кажется... кажется всё сломано и уже не оживёт? Паймон испугалась до смерти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161002,
					"content": "Пф! И что? Всего лишь несколько заржавевших железяк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161003,
					"content": "Сейчас в ване небезопасно. Паймон поплатится, если не станет внимательнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161004
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161004,
					"content": "Ой! Арабалика слишком строг!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161005,
					"content": "Ты, Паймон, слишком беспечна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161006
					]
				},
				{
					"id": 730161006,
					"content": "Вот как? Тогда если Паймон будет говорить так же строго, как Арабалика, то станет такой же сильной, как он?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161007
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161007,
					"content": "Ты не к другим должна стать строже, а к себе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161008
					]
				},
				{
					"id": 730161008,
					"content": "Хорошо, тогда начну прямо с завтрашнего дня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161009
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161009,
					"content": "Подытожим. Раз каменные ветви здесь, то теперь нужно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161010
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161010,
					"content": "Найти три камня и повернуть их в эту сторону.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161011
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161011,
					"content": "Снова он опередил Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161012
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161012,
					"content": "Кстати, манера вести разговор у Арабалики почти такая же, как у Арапанду, совсем не дружит с метафорами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161013,
						730161015
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161013,
					"content": "Зато так их гораздо легче понять.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161014
					]
				},
				{
					"id": 730161014,
					"content": "Да, когда говорят прямо, и в самом деле понятнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161017,
					"content": "Из-за того, что Арапанду думает слишком много, Арабалика думает очень мало. Арабалика разбирается только в том, как защищать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161018
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161018,
					"content": "Когда-то Арапанду вместе с нарой Варуной защищал вану. Они пробрались сквозь чёрную грязь и излечили машину Варуны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161019
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161019,
					"content": "#Уже много времени прошло с тех пор, как нара Варуна {M#покинула}{F#покинул} вану. На Праздник Утсава {M#она}{F#он}, быть может, тоже не вернётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161020
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161020,
					"content": "#Арапанду должен это знать. Никто не скажет, сколько прошло времени, но достаточно, чтобы из семени выросло дерево, чья крона достаёт до небес. Нара, {M#покинувшая}{F#покинувший} вану, уже не вернётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161021
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161021,
					"content": "Но Арапанду всё равно хочет ещё раз исцелить машину Варуны - ради ваны, ради Праздника Утсава, ради нары Варуны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161022
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161022,
					"content": "Вот оно как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161023
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161023,
					"content": "#Арабалика никогда не видел нару Варуну, но о {F#нём}{M#ней} помнят в ване.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161024
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161024,
					"content": "Арабалика, в отличие от Арапанду, не думает о столь многих вещах. Арабалика только знает, что достаточно силён, чтобы защищать аранар и вану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161025
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161025,
					"content": "#И пусть нара Варуна не с нами, но аранары смогут исцелить {M#её}{F#его} машину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161026
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161026,
					"content": "Да! Вы можете рассчитывать на нашу помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161027
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161027,
					"content": "#Здесь странный запах железа, что-то не так. Нара {NICKNAME}, выясни. Арабалика подождёт вас здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161028
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161028,
					"content": "Непонятно, что почувствовал Арабалика, но во всём, что касается леса, аранары разбираются лучше нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161029
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161029,
					"content": "#{NICKNAME}, давай постараемся отыскать три отдельных листа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161015,
					"content": "Всё-таки это не слишком похоже на аранар.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161016
					]
				},
				{
					"id": 730161016,
					"content": "А что тогда, по-твоему, похоже на аранар? Паймон не понимает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Паймон"
				}
			]
		},
