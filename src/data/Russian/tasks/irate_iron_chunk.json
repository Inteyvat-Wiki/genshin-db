			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Арабалика"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161501,
					"content": "Уф! Паймон перепугалась! Хорошо, что Арабалика пришёл на помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161502,
					"content": "Арабалика уже говорил. Если Паймон не станет внимательнее, окажется в беде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161503
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161503,
					"content": "У-у-у... Ты прав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161504,
					"content": "Стражи не просто спят в руинах, знаете ли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161505
					]
				},
				{
					"id": 730161505,
					"content": "Да, стражи охраняют что-то от нарушителей. В конце концов, мы для них чужаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161506,
					"content": "#Нара {NICKNAME} и Паймон - чужаки в ване, но не Арабалика. Железяка сбита с толку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161507
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161507,
					"content": "Плохая железяка. Придётся Арабалике сделать её хорошей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161508
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161508,
					"content": "Ха! Паймон будет хорошей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161509,
					"content": "Паймон, ловлю тебя на слове.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161510
					]
				},
				{
					"id": 730161510,
					"content": "Само собой разумеется. Начнём с завтрашнего дня... нет, прямо сейчас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161511,
					"content": "#Только аранара сможет пробудить этот камень. Нара {NICKNAME}, Паймон, подождите, Арабалика всё сделает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161512
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161512,
					"content": "Ох!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161513,
					"content": "Теперь мы стали ещё на шаг ближе к исцелению машины Варуны! А после этого в чаще Апам уже не будет столько спор. Паймон как вспомнила, аж в носу защекотало!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161514,
					"content": "Машина Варуны сможет очистить дождь. Больше не будет чёрного дождя и такого количества спор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161515
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161515,
					"content": "Но грибы никуда не денутся. Паймон, будь осторожнее. Учись на ошибках Аранакулы, он чуть не угодил к грибам на обед.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161516
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161516,
					"content": "Ох, Паймон будет осторожной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730161517,
					"content": "#Здесь вы справитесь без меня, я возвращаюсь в Уголок отдыха и займусь поисками Арапанду. Нара {NICKNAME}, Паймон, не хотите вернуться вместе с Арабаликой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161518,
						730161520
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161518,
					"content": "Да, пойдём вместе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161519
					]
				},
				{
					"id": 730161519,
					"content": "Да, в ване небезопасно. Лучше путешествовать вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730161520,
					"content": "Нас ещё ждут другие дела.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161521
					]
				},
				{
					"id": 730161521,
					"content": "#Нара {NICKNAME}, Паймон, будьте осторожнее. Да хранит вас Арамухукунда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арабалика"
				}
			]
		},
