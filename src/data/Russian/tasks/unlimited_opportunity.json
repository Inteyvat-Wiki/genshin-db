				},
				{
					"id": 411311305,
					"content": "С этим могут возникнуть проблемы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311306
					]
				},
				{
					"id": 411311306,
					"content": "Проблемы? Какие ещё проблемы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311307
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411311307,
					"content": "#Когда ты собирал{F#а} цветы, они на тебя напали? Неужели существуют цветы, которые нападают на людей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311308
					],
					"speakerTitle": "Иванович"
				},
				{
