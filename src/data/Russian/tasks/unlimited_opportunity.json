				},
				{
					"id": 411311102,
					"content": "И вряд ли ты примешь моё поручение. Что ж, дело хозяйское.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311103
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411311103,
					"content": "Сейчас быстро нанять охрану не выйдет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311104
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411311104,
					"content": "Но я не сдамся! Метеорит я не заполучу - ну и ладно. Но я всё равно найду, как использовать эту возможность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311105
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411311105,
					"content": "#Ну, путешественни{F#ца}{M#к}, за метеоритами я не пойду. Но ты помоги мне вот в чём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311106
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411311106,
					"content": "Раз эти метеориты столь притяга... То есть опасны, что теряешь сознание от малейшего прикосновения к ним...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311107
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411311107,
					"content": "Тогда всё вокруг них тоже должно было подвергнуться их влиянию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311108
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411311108,
					"content": "#Путешественни{F#ца}{M#к}, пожалуйста, отправься к месту падения метеорита и принеси мне, скажем, растение, цветок - да что угодно, всё пойдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311109,
						411311111
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411311109,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311110
					]
				},
				{
					"id": 411311110,
					"content": "Спасибо. Упускать такую возможность было бы преступлением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411311111,
					"content": "Скажи, все торговцы такие настойчивые?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311112
					]
				},
				{
					"id": 411311112,
					"content": "Ха-ха-ха, приму это за комплимент. Ну, дело теперь за тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иванович"
				}
			]
