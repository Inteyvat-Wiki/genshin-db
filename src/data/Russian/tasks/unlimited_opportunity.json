			"trigger": {
				"objectNames": [
					"Иванович"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310201,
					"content": "Вокруг них куча монстров.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310202
					]
				},
				{
					"id": 411310202,
					"content": "#Поэтому ты мне, путешественн{F#ица}{M#ик}, и нуж{F#на}{M#ен}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иванович"
				}
			]
		},
		{
			"id": 4113103,
			"completionStepIds": [
				4113103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иванович"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310301,
					"content": "#Уверен{F#а}, кому-то такая идея в голову уже пришла...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310302
					]
				},
				{
					"id": 411310302,
					"content": "Вот. Именно поэтому нам и следует поторопиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310303
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310303,
					"content": "#Путешественн{F#ица}{M#ик}, если ты желаешь помочь, нам следует немедленно выдвигаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310304
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310304,
					"content": "Каждая секунда болтовни стоит мне кучу мора!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310305
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310305,
					"content": "У-у-у... Да он нас совсем не слышит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411310306,
					"content": "А если мы скажем ему, что его план не принесёт ни монеты? Или что метеориты действительно опасны? Может, он тогда прислушается?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4113104,
			"completionStepIds": [
				4113104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иванович"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310401,
					"content": "Если ты прикоснёшься к метеориту, то потеряешь сознание.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310402
					]
				},
				{
					"id": 411310402,
					"content": "Хм? А, я тоже об этом слышал. Да, это определённо проблема...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310403
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310403,
					"content": "Но, думаю, обойти её поможет какое-нибудь приспособление, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310404
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310404,
					"content": "...О, засомневался. Он теперь что, подсчитывает затраты с прибылью?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411310405,
					"content": "Гнём свою линию. Нужно убедить его, что предприятие это денег не принесёт, а метеориты слишком опасны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
