	"talks": [
		{
			"id": 4113101,
			"completionStepIds": [
				4113122
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иванович"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310101,
					"content": "Хм... На этом можно неплохо заработать. Вот только есть одна проблемка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310102
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310102,
					"content": "Что за проблемка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310103
					]
				},
				{
					"id": 411310103,
					"content": "#А? О, путешественн{F#ица}{M#ик}! Твоё появление очень кстати. Не заинтересует ли тебя одно... Скажем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310107
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310107,
					"content": "...Удивительное, масштабное, свежее, гарантированно прибыльное деловое предложение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310108
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310108,
					"content": "Капелька твоей помощи - и мы оба получим кучу денег.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310104,
						411310109
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310104,
					"content": "Банк северного королевства ограбить невозможно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310105
					]
				},
				{
					"id": 411310105,
					"content": "Ах, ну конечно. Даже все стражники там из Снежной. Я... Постой. Ты что это имеешь в виду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310106,
					"content": "Вижу, путешествия расширили твои горизонты. Такое может прийти в голову только человеку с богатым воображением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310112
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310112,
					"content": "Мой план основательный и надёжный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310113
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310113,
					"content": "Ты ведь знаешь, что с неба падали метеориты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310114
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310114,
					"content": "Так вот. Я хочу найти такой метеорит и отколоть от него пару кусков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310115
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310115,
					"content": "Потом я найму мастера, который сделает из них украшения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310116
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310116,
					"content": "Только представь себе - ювелирные изделия из метеорита. Кольца, ожерелья, браслеты, серёжки - богачи с радостью отдадут за них свои деньги!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310117
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310117,
					"content": "#Твоя задача, путешественн{F#ица}{M#ик}, донельзя проста - не давай чудовищам беспокоить меня во время работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310118
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310118,
					"content": "Ну что, договорились?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310119
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310119,
					"content": "Подходить к метеоритам нельзя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310120
					]
				},
				{
					"id": 411310120,
					"content": "Это ещё почему? Нельзя упускать такую сочную возможность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310109,
					"content": "Ты обнаружил лазейку в законах Ли Юэ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310110
					]
				},
				{
					"id": 411310110,
					"content": "Вообще-то законы Ли Юэ написаны настолько хорошо, что лазеек в них практически не найти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310111
					],
					"speakerTitle": "Иванович"
				},
				{
					"id": 411310111,
					"content": "Кхм, но я вовсе не об этом! Мой план никаких законов не нарушает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Иванович"
				}
			]
		},
		{
			"id": 4113102,
			"completionStepIds": [
				4113102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
