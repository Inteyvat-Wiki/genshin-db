			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хамбэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020101,
					"content": "Грибы здесь вроде ничего, внесу в свой список.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020102
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020102,
					"content": "Хамбэй? Знакомое имя, где-то мы его уже слышали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020103,
						230020104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230020103,
					"content": "Это не тот, что в Татарасуне...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				},
				{
					"id": 230020105,
					"content": "Точно! Это он перевернул вверх дном Горн Микагэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020106,
						230020107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230020106,
					"content": "Он атташе, здесь, наверное, по службе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020108,
					"content": "Он на самом деле в Сумеру! Паймон думала, что новости про атташе - это всё шутка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230020109,
					"content": "Так, светлые волосы, летающая малышка рядом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020110
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020110,
					"content": "#Вы, должно быть, путешественни{F#ца}{M#к}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020111,
						230020112
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020111,
					"content": "Да, это я.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020114
					]
				},
				{
					"id": 230020114,
					"content": "Ха-ха, а вот и вы. Ёсукэ писал мне о вас. Говорит, это вы с господином Ксавье починили Горн Микагэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020115
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020115,
					"content": "Ах, мне так неудобно! Пока вы с господином Ксавье чинили Горн Микагэ, я был завален бумагами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020116
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020116,
					"content": "А разве бумаги важнее Горна?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020117
					]
				},
				{
					"id": 230020117,
					"content": "Не самый разумный выбор приоритетов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230020118,
					"content": "Ну вы сами подумайте: разве удалось бы починить Горн Микагэ без необходимых документов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020119
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020119,
					"content": "Эвакуация сотрудников, подготовка материалов, переброска специалистов, а ещё нужно было согласовать потребности всех сторон в производстве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020120
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020120,
					"content": "Без всего этого ваши усилия бы не увенчались успехом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020121
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020121,
					"content": "Всё точно, как сказал Тораносукэ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020122
					]
				},
				{
					"id": 230020122,
					"content": "Да уж, слухи не врут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230020123,
					"content": "Тораносукэ? Что могу сказать: имея дело с господином, который пренебрегает делопроизводством, точно не оберёшься лишней работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020124
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020124,
					"content": "Но я больше не занимаюсь Горном Микагэ. Теперь я атташе в Сумеру, заведую грибной торговлей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020125
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020125,
					"content": "#Ах! Путешественни{F#ца}{M#к}, Ёсукэ много про вас рассказывал. Думаю, что вам можно доверять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020126
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020126,
					"content": "Не могли бы вы помочь мне в одном деле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020127
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020127,
					"content": "Я как раз занимаюсь поиском надёжного поставщика грибов. Тут достаточно торговцев...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020128
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020128,
					"content": "Но все их образцы слишком уж безупречные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020129
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020129,
					"content": "Вот я и думаю, что необходимо наведаться в места, где они выращивают эти грибы. Так я точно смогу оценить качество продукции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020130
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020130,
					"content": "Как вы видите, я человек, далёкий от дикой природы, у меня совсем нет в этом опыта. Боюсь, что если один пойду в лес, беды не миновать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020131
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020131,
					"content": "Вы не могли бы помочь мне в этом деле? Сходить в лес за грибами и принести их мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020132,
						230020133
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020132,
					"content": "Почему бы и нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020134,
					"content": "Вы согласны? Отлично! Насчёт вознаграждения не переживайте, я уже подготовил все необходимые документы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020135
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020135,
					"content": "Так, смотрите: это договор о найме, расчёт суммы вознаграждения, а это сведения об обязательствах сторон и соглашение о конфиденциальности. Точно! Вот ещё карта грибной местности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020136
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020136,
					"content": "Вы и Хамбэй внимательно изучаете все бумаги. Очень утомительный процесс...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230020137
					]
				},
				{
					"id": 230020137,
					"content": "Отлично! Теперь, когда вы со всем ознакомлены, я отправлю эти бумаги в сёгунат. Как только получим одобрение, мы с вами официально состоим в трудовых отношениях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020138
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020138,
					"content": "Но до тех пор я выплачу вам вознаграждение за собственный счёт. Всё-таки закупка грибов - дело особой срочности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020139
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020139,
					"content": "Разумеется, по итогам дела я всё опишу в докладе сёгунату. В конце концов, ваше вознаграждение также подлежит налогообложению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020140
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020140,
					"content": "#Я... Я пош{F#ла}{M#ёл} за грибами!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020141
					]
				},
				{
					"id": 230020141,
					"content": "Да? Спасибо большое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020142
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020142,
					"content": "Мы ведь не вляпаемся в очередные неприятности, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020143,
						230020145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230020143,
					"content": "Я это специально, чтобы понаблюдать за ним.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020144
					]
				},
				{
					"id": 230020144,
					"content": "А, да? Ладно, в этом есть смысл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230020147,
					"content": "Ну что ж, вы мне не верите... Всё будет хорошо! Я тщательно всё подготовил, вам ничего не помешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020148
					],
					"speakerTitle": "Хамбэй"
				},
				{
					"id": 230020148,
					"content": "Мы говорим совсем не о таких проблемах. Ох, пошли уже соберём ему эти грибы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230020145,
					"content": "Понаблюдать, какие проблемы он ещё может создать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020146
					]
				},
				{
					"id": 230020146,
					"content": "Ах! Если он и вправду что-то натворит, нам же никто здесь не поможет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230020133,
					"content": "А что нам за это будет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020112,
					"content": "А это Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020113
					]
				},
				{
					"id": 230020113,
					"content": "Паймон! А не какая-то там «летающая малышка»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230020107,
					"content": "Он, наверное, пришёл за грибами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020104,
					"content": "О ком говорили Тораносукэ и Ёсукэ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				}
			]
		},
