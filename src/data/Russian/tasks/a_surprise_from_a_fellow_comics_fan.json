			"dialogs": [
				{
					"id": 706970101,
					"content": "#{NICKNAME}! Не ожидала встретить тебя в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970102
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706970102,
					"content": "Я впервые в таком климате. Здесь очень холодно! Но сколько впечатлений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970103
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706970103,
					"content": "Я играла в снежки, слепила своего первого снеговика... А ещё здесь столько комиксов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970104
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706970104,
					"content": "«Сага Пылких Сердец» очень популярна в Инадзуме, но я не ожидала, что найду так много поклонников этой серии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970105
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706970105,
					"content": "Я так увлеклась обсуждением комиксов с друзьями из Натлана, что не смогла удержаться - и сделала фигурку одного из персонажей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970106
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706970106,
					"content": "#Кстати, ты слышал{F#а} про «Сагу Пылких Сердец»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970107
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706970107,
					"content": "Вы говорите с Ёимией о Пылких Сердцах...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706970108
					]
				},
				{
					"id": 706970108,
					"content": "Не может быть! Твои друзья тоже любят эти комиксы? Какое совпадение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970109
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 706970109,
					"content": "Вот, возьми фигурку Фиетены. Она идеально подойдёт для лагеря Легиона Пылких Сердец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ёимия"
				}
			]
		}
	]
