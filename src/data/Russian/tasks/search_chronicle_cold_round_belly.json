			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ранджит"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716670101,
					"content": "О, это вы! Давно не виделись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670102
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 716670102,
					"content": "Тебе удалось подружиться с Пиро орхидеей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670103
					]
				},
				{
					"id": 716670103,
					"content": "Ах, зачем напоминать. После твоих «переговоров» она действительно успокоилась, но лишь на короткое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670104
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 716670104,
					"content": "Как только она восстановилась, начала снова пытаться меня убить! Знаете что? Вы были правы. С этим существом невозможно подружиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670105
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 716670105,
					"content": "Всё же у неё вкусные плоды. Думаю, моим друзьям из Натлана понравятся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670106
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 716670106,
					"content": "Интересно, что это за вкус?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716670107,
					"content": "Хочешь попробовать? Если да, я мог бы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670108
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 716670108,
					"content": "Н-нет! Кстати, следующий в твоём списке древний геовишап?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716670109,
					"content": "Верно. Честно говоря, думаю, что это отличный выбор. Древние геовишапы похожи на тепетлизавров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670110
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 716670110,
					"content": "По пути из Сумеру в Натлан они будут одними из первых, кого вы встретите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670111
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 716670111,
					"content": "Как скажешь. Паймон особо не надеется, правда... Почему бы тебе не выбрать детёныша геовишапа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716670112,
					"content": "...У них некруглые животики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670113
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 716670113,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716670114,
					"content": "У детёнышей геовишапа нет круглых животиков. Думаю, это всё из-за их невероятно быстрых движений. Ни шанса накопить жир...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670115
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 716670115,
					"content": "Но главная причина всё же в отсутствии... эффектности. Моих друзей из Натлана не удивить какими-то там детёнышами геовишапа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670116
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 716670116,
					"content": "А вот древний геовишап - это уже другое дело. Даже как просто история. И в конце концов, сильному герою нужны сильные противники, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670117
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 716670117,
					"content": "Хорошо. Хватит медлить. Древний геовишап ждёт нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670118,
						716670119
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 716670118,
					"content": "Ладно, пошли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716670119,
					"content": "Мне некогда. Увидимся позже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670120
					]
				},
				{
					"id": 716670120,
					"content": "Хорошо. Я подожду тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ранджит"
				}
			]
		}
	]
}