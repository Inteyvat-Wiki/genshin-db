			},
			"dialogs": [
				{
					"id": 742540601,
					"content": "Какой тихий и приятный денёк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540602,
						742540603
					],
					"speakerTitle": "Мари-Анн"
				},
				{
					"id": 742540602,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 742540604,
					"content": "Гм, спасибо за приглашение. Сандроне... сестрёнка Сандроне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мари-Анн"
				},
				{
					"id": 742540603,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
