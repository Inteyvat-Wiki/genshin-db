			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аранакула",
					"Арапанду"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600201,
					"content": "#{M#Золотой}{F#Золотая} нара, похоже, ничего не боится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600202
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730600202,
					"content": "#{M#Золотой}{F#Золотая} нара - {M#храбрый}{F#храбрая} нара, совсем как нара Варуна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600203
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730600203,
					"content": "#Я беспокоюсь за Арабалику в руинах Дахри и за Аракунти в роще Сновидений. Но с {M#золотым}{F#золотой} нарой им ничего не угрожает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600204
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730600204,
					"content": "#После исцеления машины Варуны всякие негодяи перестанут бесчинствовать в питомнике. {NICKNAME}, я хочу подарить тебе цветы, выращенные там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранакула"
				}
			]
		},
		{
			"id": 7306003,
			"completionStepIds": [],
