				"points": []
			},
			"dialogs": [
				{
					"id": 730600601,
					"content": "В Монументе ясны много негодяев, но Аранакула вернулся. Вот и хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600602
					],
					"speakerTitle": "Арабалика"
				},
				{
					"id": 730600602,
					"content": "#Это {M#золотой}{F#золотая} нара, он{F#а} помог{F#ла} Аранакуле остаться незамеченным, а ещё расчистил{F#а} каменное воспоминание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600603
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730600603,
					"content": "Когда машина Варуны исцелится, цветы вернутся в питомник. Аранары помнят об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600604
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730600604,
					"content": "Остался один Аракунти, он сейчас в роще Сновидений. Когда Аракунти вернётся, мы сможем избавить машину Варуны от скверных насекомых, что подтачивают её корни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арапанду"
				}
			]
		},
