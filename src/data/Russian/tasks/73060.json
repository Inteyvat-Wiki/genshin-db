				"points": []
			},
			"dialogs": [
				{
					"id": 730600501,
					"content": "Арабалика скоро вернётся из руин Дахри. У Арабалики такой сильный араракалари, что с ним не страшны ни плесенники, ни железяки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600502
					],
					"speakerTitle": "Арапанду"
				},
				{
					"id": 730600502,
					"content": "Будь у Аранакулы хотя бы вполовину сил Арабалики, питомник был бы под надёжной защитой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600503
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730600503,
					"content": "Но у Аранакулы нет даже четверти силы Арабалики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600504
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730600504,
					"content": "Хнык-хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600505
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730600505,
					"content": "#Аранакула станет смелым, как {M#золотой}{F#золотая} нара, но для этого нужно время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арапанду"
				}
			]
