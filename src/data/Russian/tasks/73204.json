			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Аффан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040101,
					"content": "Что вы здесь делаете? Пришли посмеяться над стариком, который «выращивает камни»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040102
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040102,
					"content": "Я в порядке! Мне не нужна помощь жителей деревни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040103
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040103,
					"content": "Эй, не нужно сразу быть таким враждебным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040104,
					"content": "Ты ошибся. Мы не жители деревни Аару и пришли не для того, чтобы посмеяться над тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040105,
						732040107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040105,
					"content": "Мы просто прохожие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040106
					]
				},
				{
					"id": 732040106,
					"content": "Прохожие? Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040110,
					"content": "Обычно сюда приходят некоторые старые знакомые, которые то и дело просят меня отказаться от питомника и вернуться в деревню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040111
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040111,
					"content": "И несколько сорванцов, которые прибегают пошалить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040112
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040112,
					"content": "На самом деле, я впервые вижу людей в таких нарядах. Что вы здесь делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040113,
						732040116
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040113,
					"content": "Мы путешественники, которые ищут своих родных.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040114
					]
				},
				{
					"id": 732040114,
					"content": "Да, ради этой цели мы прошли очень длинный путь и преодолели множество опасностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040115,
					"content": "#{NICKNAME} - очень добродетельный человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040119,
					"content": "Нам и в голову не придёт издеваться над одиноким пожилым человеком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040120,
					"content": "Так что не беспокойся, мы не плохие люди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040121,
					"content": "Хм. Я хочу перед вами извиниться, произошло недоразумение. Мне следовало внимательнее посмотреть, прежде чем говорить глупости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040122
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040122,
					"content": "Прошу прощения, мои юные друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040123
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040123,
					"content": "Вы так молоды, но можете сами о себе позаботиться. Это впечатляет. Я в вашем возрасте был куда слабее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040124
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040124,
					"content": "Если я правильно понял, то могу обратиться к вам за помощью, когда у меня возникнет проблема?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040125
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040125,
					"content": "Что? Это значит, что у тебя есть для нас поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040126,
					"content": "У тебя возникли какие-то трудности?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040127
					]
				},
				{
					"id": 732040127,
					"content": "Изначально у меня было два питомника. Один из них здесь, а другой находится на западе от деревни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040128
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040128,
					"content": "В силу своего возраста я не могу ухаживать за ними в одиночку, поэтому не появлялся в другом саду несколько дней. Его разрушили какие-то странные чёрные существа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040129
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040129,
					"content": "Это очень опасно. Когда я вошёл туда, я подумал, что уже никогда не выберусь. Лучше туда больше не ходить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040130
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040130,
					"content": "Сейчас моё самое большое желание - вылечить почву в питомнике, чтобы потом снова посадить там цветы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040131
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040131,
					"content": "#Звучит не очень сложно. Ну что, {NICKNAME}? Мы возьмёмся за это поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040132,
					"content": "Не беспокойся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040133
					]
				},
				{
					"id": 732040133,
					"content": "Этот питомник находится на западе от деревни. Не заблудитесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040134
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040134,
					"content": "Пустяки, не переживай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040116,
					"content": "Мы искатели приключений, которые исследуют мир.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040117
					]
				},
				{
					"id": 732040117,
					"content": "Верно. Мы прошли много высоких гор и великих озёр, чтобы добраться до Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040118,
					"content": "Можно сказать, мы... э-э... искатели приключений с большим сердцем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040107,
					"content": "Говорят, что здесь выращивают цветы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040108
					]
				},
				{
					"id": 732040108,
					"content": "Верно, я выращиваю цветы, а не какие-то дурацкие камни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040109
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040109,
					"content": "Я просто подумал... Ах, неважно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Аффан"
				}
			]
		},
		{
			"id": 7320404,
			"completionStepIds": [
				7320404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320404",
							"2"
						],
						"stepId": 7320404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аффан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040401,
					"content": "Вы уже вернулись? Как насчёт питомника? Его ещё можно спасти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040402
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040402,
					"content": "Проблема решена.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040403
					]
				},
				{
					"id": 732040403,
					"content": "Вы объясняете Аффану, что такое зона Увядания.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732040404
					]
				},
				{
					"id": 732040404,
					"content": "Так вот в чём дело. А я удивлялся, как в здоровой почве могли вдруг появиться эти чёрные существа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040405
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040405,
					"content": "Отлично! Теперь я могу сажать семена со спокойной душой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040406
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040406,
					"content": "Когда эти три семечка прорастут, зацветут и дадут новые семена, я посажу их в поле. Скоро здесь всё будет усыпано этими цветами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040407
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040407,
					"content": "Ой, это... камни странной формы? Разве из них могут вырасти цветы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040408,
					"content": "Дедушка Аффан, где ты это купил? Не давай себя одурачить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040409,
					"content": "У вас действительно доброе сердце, но не беспокойтесь. Эти цветочные семена нельзя купить за мору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040410
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040410,
					"content": "Это три очень ценных семечка, которые мне оставил проклятый... кхе-кхе... друг. Конечно, они отличаются от обычных саженцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040411
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040411,
					"content": "Это звучит странно. Дедушка Аффан, что именно ты выращиваешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040412,
					"content": "Хе-хе, то, что я выращиваю, - это желание друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040413
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040413,
					"content": "Какая странная манера разговаривать. Разве можно вырастить что-то подобное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040414,
					"content": "Дитя, ты всё равно не поймёшь. Приходите сюда снова - и всё увидите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040415
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040415,
					"content": "Не обращайте внимания на то, что здесь сейчас пусто. Вскоре они прорастут и расцветут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040416
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040416,
					"content": "Их будет появляться всё больше и больше, станет очень красиво. Ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040417
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040417,
					"content": "Хорошо, вы выполнили поручение, поэтому заслужили вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040418
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040418,
					"content": "Возьмите. Мне особо нечего дать. Тут всё, что у меня есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040419
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732040419,
					"content": "Фух, поручение выполнено. От всей этой беготни Паймон проголодалась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040420,
					"content": "#Очевидно, что бегал{F#а} только я.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040421
					]
				},
				{
					"id": 732040421,
					"content": "Паймон всё время говорила с тобой, а это тоже отнимает много энергии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040422,
					"content": "#Не жадничай, {NICKNAME}. Как насчёт того, чтобы взять вознаграждение и купить что-нибудь вкусненькое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040423,
					"content": "Давай посмотрим, какое вознаграждение и сколько мы можем купить еды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040424,
					"content": "Сейчас посмотрим...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040425
					]
				},
				{
					"id": 732040425,
					"content": "Ну, еды здесь больше, чем моры... Шаурма, тахчин и много овощей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040426
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040426,
					"content": "Здесь слишком много... Неужели мы забрали всю еду дедушки Аффана за целый день?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040427,
					"content": "Дедушке Аффану, должно быть, нелегко жить одному за пределами деревни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040428
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040428,
					"content": "Он отдал нам не только мору, но и всю свою еду... Паймон как-то не по себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040429
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040429,
					"content": "Более того, он явно сажает семена, похожие на камни, но при этом говорит, что выращивает... чьё-то желание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040430
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040430,
					"content": "Возможно ли, что он слишком долго прожил один и начал фантазировать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732040431,
					"content": "Это вызывает беспокойство. Давай навестим его позже, как будет минутка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
