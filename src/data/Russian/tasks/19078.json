			"trigger": {
				"objectNames": [
					"Адан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780401,
					"content": "Привет! Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780402,
						190780403
					],
					"speakerTitle": "Адан"
				},
				{
					"id": 190780402,
					"content": "Ты знаком с Альками?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				},
				{
					"id": 190780404,
					"content": "Альками? Ты про того знаменитого богача? Он не так давно заказал у меня мебель, заплатил очень хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780405
					],
					"speakerTitle": "Адан"
				},
				{
					"id": 190780405,
					"content": "Говорят, раньше он был известным архитектором, заработал себе целое состояние. А теперь открыл курсы, чтобы и другие могли повторить его путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780406
					],
					"speakerTitle": "Адан"
				},
				{
					"id": 190780406,
					"content": "Если бы не стоимость обучения, я бы и своего ребёнка туда записал. Архитекторы хорошо зарабатывают...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Адан"
				},
				{
					"id": 190780403,
					"content": "#Хотел{F#а} расспросить тебя об Альками.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				}
			]
		},
