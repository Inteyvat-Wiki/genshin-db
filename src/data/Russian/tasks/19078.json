			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аабид",
					"Адиль"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780801,
					"content": "Слышал? Альками нанял Кавеха преподавать у него на курсах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780802
					],
					"speakerTitle": "Аабид"
				},
				{
					"id": 190780802,
					"content": "Хе, теперь от желающих поучиться архитектуре отбоя не будет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780803
					],
					"speakerTitle": "Адиль"
				},
				{
					"id": 190780803,
					"content": "Завидуешь? Вообще-то Альками никогда не был выдающимся архитектором. Учиться у него просто нечему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780804
					],
					"speakerTitle": "Аабид"
				},
				{
					"id": 190780804,
					"content": "Это так, но надо признать, что реклама у него работает неплохо... Всё-таки выдержать вступительные экзамены в Академию может далеко не каждый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780805
					],
					"speakerTitle": "Адиль"
				},
				{
					"id": 190780805,
					"content": "Если ты не прошёл экзамены в Академию или просто хочешь поскорее приступить к первым заказам, тебе прямая дорога на курсы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780806
					],
					"speakerTitle": "Адиль"
				},
				{
					"id": 190780806,
					"content": "Да уж, в деловой хватке ему не откажешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аабид"
				}
			]
		},
