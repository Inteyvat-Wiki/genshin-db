				"points": []
			},
			"dialogs": [
				{
					"id": 732670801,
					"content": "Ого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670802
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670802,
					"content": "Ничего себе, как быстро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670803
					],
					"speakerTitle": "Карима"
				},
				{
					"id": 732670803,
					"content": "Очень хорошо! Отличная скорость и устойчивость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670804
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670804,
					"content": "Айтен, Карима, запоминайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670805
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670805,
					"content": "Не геройствуйте в опасных ситуациях, и если нужно отступить, делайте это решительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670806
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670806,
					"content": "Особенно это касается тебя, Айтен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670807
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670807,
					"content": "Поняла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670808
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670808,
					"content": "Хорошо! А дальше мы... выйдем из деревни, чтобы вы смогли своими глазами увидеть битву.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670809
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670809,
					"content": "Ура! Отец как раз только что наточил мой деревянный меч, и он у меня с собой. А что у тебя, Карима?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670810
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670810,
					"content": "У меня с собой небольшой лук и стрелы. Правда, мама дала мне стрелы без наконечников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670811
					],
					"speakerTitle": "Карима"
				},
				{
					"id": 732670811,
					"content": "Ха-ха-ха! У вас с собой есть лук и меч, а ещё ваши сердца наполнены отвагой. Это всё, что вам нужно, чтобы ступить на тропу приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670812
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670812,
					"content": "#Но помните, когда мы выйдем из деревни, не бегайте где попало, а держитесь рядом со мной и с путешественни{F#цей}{M#ком}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670813,
						732670814
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670813,
					"content": "Ты правда хочешь вместе с ними выйти из деревни?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				},
				{
					"id": 732670815,
					"content": "Не волнуйся, я эти места заранее проверил, там всего лишь несколько тощих скорпионов, они не опасные. Всё будет хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670816
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670816,
					"content": "Кроме того, ведь с ними будем мы оба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670817,
						732670818
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670817,
					"content": "Ты и меня сейчас посчитал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670819,
					"content": "#Не бросай дело на полпути, путешественни{F#ца}{M#к}. А я заплачу тебе по правилам искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670820
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670820,
					"content": "Приготовьтесь, мы выдвигаемся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670821
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670821,
					"content": "Ура!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670822
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670822,
					"content": "Ох... Я немного волнуюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Карима"
				},
				{
					"id": 732670818,
					"content": "#Разве я уже на что-то {F#согласилась}{M#согласился}?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670814,
					"content": "С двумя детьми...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				}
			]
		},
		{
			"id": 7326710,
			"completionStepIds": [
				7326710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326710",
							"2"
						],
						"stepId": 7326710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Айтен",
					"Карима",
					"Атия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732671001,
					"content": "Ох, эти скорпионы такие... огромные! Лучше к ним не подходить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671002
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732671002,
					"content": "Я запустила в них стрелой, а им хоть бы что!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671003
					],
					"speakerTitle": "Карима"
				},
				{
					"id": 732671003,
					"content": "И как тебе так легко удалось с ними расправиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671004,
						732671005
					],
					"speakerTitle": "Карима"
				},
				{
					"id": 732671004,
					"content": "Результат длительных тренировок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				},
				{
					"id": 732671006,
					"content": "Ох, а Кандакия говорит, что я делаю успехи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671007
					],
					"speakerTitle": "Карима"
				},
				{
					"id": 732671007,
					"content": "Карима, не унывай! Продолжай в том же духе и однажды обретёшь огромную силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671008
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732671008,
					"content": "И ты, Айтен, если будешь и дальше тренироваться, то вступление в ряды Пустынников - дело времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671009
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732671009,
					"content": "Ох, если бы только Дэхья могла обучить меня боевым искусствам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671010
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732671010,
					"content": "В следующий раз, когда увижу Кандакию, попрошу её снова меня потренировать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671011
					],
					"speakerTitle": "Карима"
				},
				{
					"id": 732671011,
					"content": "Эти детишки полны энтузиазма, ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671012,
						732671013
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732671012,
					"content": "Тебе так и не удалось никого нанять.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671014,
					"content": "Кхм, давай не будем об этом, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671015
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732671015,
					"content": "Поговорим о работе в другой раз. К тому же мои слова не пропали даром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671016
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732671016,
					"content": "Выслушав мою речь, молодёжь захотела увидеть мир. Хотя... никто из них не загорелся желанием стать Пустынником.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671017
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732671017,
					"content": "Не будем об этом. Нужно вернуть этих двоих в деревню. Дома их наверняка уже обыскались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671018
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732671018,
					"content": "#Вот твоя награда. Спасибо за помощь, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671019
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732671019,
					"content": "Эх, а ведь мне ещё предстоит обо всём доложить, как же быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671020
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732671020,
					"content": "Дядя Атия, а ты ведь нас так и не испытал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671021
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732671021,
					"content": "А? Ах, да... Испытаю, как только вернёмся в деревню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Атия"
				},
				{
					"id": 732671013,
					"content": "Что же ты будешь делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671005,
					"content": "Просто вы ещё маленькие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				}
			]
		}
	]
}