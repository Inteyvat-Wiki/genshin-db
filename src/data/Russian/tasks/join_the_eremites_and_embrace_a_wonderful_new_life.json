					"Карима"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670601,
					"content": "Дядя Атия! Ты ещё набираешь людей в ряды Пустынников?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670602
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670602,
					"content": "Айтен, ты что, снова убежала? Ты говорила с матерью?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670603
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670603,
					"content": "Говорила! Мама работает, поэтому я сама пошла к Кариме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670604
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670604,
					"content": "Здравствуйте, дядя Атия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670605
					],
					"speakerTitle": "Карима"
				},
				{
					"id": 732670605,
					"content": "Дядя Атия, что ты думаешь о нашем прошлом разговоре?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670606
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670606,
					"content": "Я всё время занимаюсь, а ещё тренируюсь с Каримой... Скоро она уже не сможет меня обогнать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670607
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670607,
					"content": "Кто это не сможет тебя обогнать? Я просто в тот раз плохо пообедала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670608
					],
					"speakerTitle": "Карима"
				},
				{
					"id": 732670608,
					"content": "В общем, я уже давно тренируюсь по твоей программе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670609
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670609,
					"content": "Дядя Атия, испытай меня сегодня ещё раз! Может, я уже могу вступить в ряды Пустынников!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670610,
						732670611
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670610,
					"content": "Это о них ты говорил?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				},
				{
					"id": 732670612,
					"content": "Кхе... Ладно! Айтен, сегодня я, как вербовщик Пустынников, проведу для тебя повторное испытание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670613
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670613,
					"content": "Отлично! Карима, ты тоже пройди испытание! Сделаем это вместе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670614
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670614,
					"content": "Но я не хочу вступать в ряды Пустынников, я просто хочу остаться в деревне и защищать её...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670615
					],
					"speakerTitle": "Карима"
				},
				{
					"id": 732670615,
					"content": "Но... было бы неплохо, если бы дядя Атия испытал меня, ведь я использовала методы тренировки Кандакии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670616
					],
					"speakerTitle": "Карима"
				},
				{
					"id": 732670616,
					"content": "Что?! Когда ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670617
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670617,
					"content": "Ха-ха-ха, какие вы обе энергичные! Это здорово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670618
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670618,
					"content": "Айтен, не кисни! Как будет возможность, я отведу тебя на тренировку к Дэхье, идёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670619
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670619,
					"content": "Правда?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670620
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670620,
					"content": "Пустынники всегда держат своё слово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670621
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670621,
					"content": "#Однако прежде чем мы начнём испытания, пусть сначала путешественни{F#ца}{M#к} покажет нам некоторые стандартные движения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670622,
						732670624
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670622,
					"content": "А как насчёт того, чтобы спросить меня?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670623
					]
				},
				{
					"id": 732670623,
					"content": "#Я не мог провести им демонстрацию раньше. И сейчас я не могу бегать туда-сюда и оставить их без присмотра. Я рассчитываю на твою помощь, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670626,
					"content": "#Кхм... Наш{F#а} путешественни{F#ца}{M#к} - очень {F#сильная искательница приключений}{M#сильный искатель приключений}, и мне стоило большого труда уговорить {F#её}{M#его} провести вам демонстрацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670627
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670627,
					"content": "Айтен, Карима, будьте осторожнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670628
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670628,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670629
					],
					"speakerTitle": "Айтен"
				},
				{
					"id": 732670629,
					"content": "Искатели приключений... это люди из Гильдии искателей приключений?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670630
					],
					"speakerTitle": "Карима"
				},
				{
					"id": 732670630,
					"content": "И наёмники, и стражники порой сталкиваются с ситуациями, когда при исполнении своего долга им приходится временно отступать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670631
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670631,
					"content": "В таком случае мы должны... бежать как можно быстрее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670632
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670632,
					"content": "#Путешественни{F#ца}{M#к}, пожалуйста, давай продемонстрируем им... эм... быстрое отступление!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670633
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670633,
					"content": "Стартуй отсюда. Покажи им пример.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670624,
					"content": "Ты до этого не проводил им демонстрацию?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670625
					]
				},
				{
					"id": 732670625,
					"content": "Как я мог продемонстрировать им какие-то стандартные приёмы, когда я должен был одновременно следить за ними?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670634
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670634,
					"content": "#Я рассчитываю на тебя, {F#путешественница}{M#путешественник}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Атия"
				},
				{
					"id": 732670611,
					"content": "О желающих завербоваться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				}
			]
		},
		{
			"id": 7326708,
