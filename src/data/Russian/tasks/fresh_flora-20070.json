			"dialogs": [
				{
					"id": 200700501,
					"content": "#Эй, путешественни{F#ца}{M#к}! Подойди, пожалуйста!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700502
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200700502,
					"content": "Помнишь, я просила тебя закопать цветы на Драконьем хребте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700503
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200700503,
					"content": "Уже прошёл день, и мне хотелось бы взглянуть, как на них подействовал холод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700504
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200700504,
					"content": "#Не мог{F#ла} бы ты сходить в горы и забрать цветы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700505,
						200700507
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200700505,
					"content": "Будет сделано.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700506
					]
				},
				{
					"id": 200700506,
					"content": "Тогда жду тебя с цветами. Поскорее возвращайся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флора"
				},
				{
					"id": 200700507,
					"content": "Напомни, где мы их закапывали?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700508
					]
				},
				{
					"id": 200700508,
					"content": "#Уже забыл{F#а}? У <color=#00E1FFFF>статуи семи Архонтов</color>, у <color=#00E1FFFF>водоёма в горах</color>, а ещё рядом с <color=#00E1FFFF>пещерой</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700509
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200700509,
					"content": "Я отмечу эти места у тебя на карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флора"
				}
			]
		}
	]
