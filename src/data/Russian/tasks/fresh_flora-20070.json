			"dialogs": [
				{
					"id": 200700301,
					"content": "Ну, как там цветы, которые мы закопали на Драконьем хребте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700302
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200700302,
					"content": "Они все у меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700303
					]
				},
				{
					"id": 200700303,
					"content": "Тебе удалось забрать все коробки? Отлично! Дай мне на них взглянуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700304
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200700304,
					"content": "Хе-хе, выглядит неплохо, хм... Этот способ таки работает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700305
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200700305,
					"content": "Но горы от Мондштадта далеко, и не хотелось бы каждый раз тебя беспокоить. Стоит придумать какой-нибудь способ поудобнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700306
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 200700306,
					"content": "Спасибо тебе за помощь. Вот твоя награда за труды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флора"
