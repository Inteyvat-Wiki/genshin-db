				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кудзирай Момидзи",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630101,
					"content": "Вы вернулись. Простите, что опять вас беспокою.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630102
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630102,
					"content": "Ты хорошо выглядишь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630103
					]
				},
				{
					"id": 726630103,
					"content": "Ха-ха, спасибо за комплимент. Я наконец поняла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630104
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630104,
					"content": "Наверное, некоторые вещи нельзя торопить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630105
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630105,
					"content": "Сходите со мной на западную отмель вечером? Я хочу вам кое-что дать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630106
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630106,
					"content": "Ого! Какое-нибудь морское сокровище?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726630107,
					"content": "Приходите и узнаете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кудзирай Момидзи"
				}
			]
		},
		{
			"id": 7266302,
			"completionStepIds": [
				7266304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266304",
							"2"
						],
						"stepId": 7266304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кудзирай Момидзи",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630201,
					"content": "Вот оно, это место. Тогда мой отец ушёл отсюда в последнее плавание. Была точно такая же ночь. И больше я его не видела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630202
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630202,
					"content": "Ты, наверное, очень по нему скучаешь? Твоё желание было увидеть его снова, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726630203,
					"content": "Ха-ха, я действительно очень по нему скучаю. Но люди моря рано или поздно всегда в него возвращаются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630204
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630204,
					"content": "Моё желание - стать более великим рыбаком, чем мой отец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630205
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630205,
					"content": "В детстве я всегда хотела пойти в море с отцом, но он просил маму отвести меня домой. Он даже иногда брал соседского мальчика, но меня взять не соглашался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630206
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630206,
					"content": "Он постоянно говорил что-то типа «Момидзи, хватит торчать у моря, иди займись девчачьими делами» или «Вот тебе денег, купи себе юбочку, нечего постоянно к лодке бегать»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630207
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630207,
					"content": "Я не понимала. Почему? Что за девчачьи дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630208
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630208,
					"content": "Мне можно покупать конфеты, собирать цветы, быть маленькой принцессой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630209
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630209,
					"content": "Но нельзя отправиться в приключение, выйти в море, бороздить океан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630210
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630210,
					"content": "Чем больше мне запрещали, тем больше мне хотелось. Когда отец пропал, я стала рыбаком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630211
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630211,
					"content": "Я переплыву моря, которые он не смог переплыть. Я поймаю большую рыбу, которую он не смог поймать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630212
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630212,
					"content": "Я унаследую рыболовные техники семьи Кудзирай. Я приумножу её славу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630213
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630213,
					"content": "Пусть легенда о Лунном левиафане - просто легенда. Я не остановлюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630214
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630214,
					"content": "У тебя всё получится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630215
					]
				},
				{
					"id": 726630215,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630216
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630216,
					"content": "Раз уж божественная рыба не здесь, я предам свои желания морю. Думаю, отец их увидит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630217
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630217,
					"content": "У вас есть желания? Давайте вместе. Напишем свои желания, засунем их в бутылки и забросим со всей силы в море. Однажды они обязательно исполнятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630218
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630218,
					"content": "Ого... А так можно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726630219,
					"content": "Но у Паймон так много желаний, какое же выбрать... Так сложно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726630220,
					"content": "Спасибо вам большое за всё! Я даже не знаю, как вас отблагодарить. Вот небольшой подарок. Надеюсь, вы примете...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630221
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630221,
					"content": "Ой! Смотрите, что это?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726630222,
					"content": "Какая большая стая рыб! Да ещё и светится! Кажется, им нравятся наши бутылки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726630223,
					"content": "Когда они собираются, как будто в море сияет луна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726630224,
					"content": "Это... Это же луннопёрки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630225
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630225,
					"content": "А! Я поняла... Я поняла! Оказывается это и был Лунный левиафан!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630226
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630226,
					"content": "А? Это Лунный левиафан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630227
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726630227,
					"content": "Да, я никогда не забуду, как он выглядел. Эти блёстки лунного сияния... Тогда Лунный левиафан тоже возник, когда Цзя Вэй кинул бутылку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630228
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630228,
					"content": "Неудивительно, что за все эти годы никто так и не смог поймать Лунного левиафана!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630229
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630229,
					"content": "Это всё потому, что это просто стайка луннопёрок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630230
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630230,
					"content": "Этим луннопёркам, оказывается, нравятся обычные бутылки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630231
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630231,
					"content": "Хе-хе, может быть, им нравятся желания, которые люди изливают в бутылки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726630232,
					"content": "Ха-ха! Тогда смотрите, как Кудзирай Момидзи сейчас их всех поймает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630233
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630233,
					"content": "И мы тоже! Мы тоже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630234
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726630234,
					"content": "Тогда позволь мне подарить вам эту удочку. Это особая удочка семьи Кудзирай для ловли Лунного левиафана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630235
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630235,
					"content": "Хоть она и не выражает полностью, как я вам благодарна, но всё-таки примите её как знак моей признательности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630236
					],
					"speakerTitle": "Кудзирай Момидзи"
				},
				{
					"id": 726630236,
					"content": "Давайте поймаем ей всех луннопёрок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кудзирай Момидзи"
				}
			]
		}
	]
}