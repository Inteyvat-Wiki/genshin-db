	"talks": [
		{
			"id": 7266301,
			"completionStepIds": [
				7266301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
