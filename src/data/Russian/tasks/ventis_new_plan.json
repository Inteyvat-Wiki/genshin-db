			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3750101,
					"content": "Не вышло. Я так и думал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750102
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750102,
					"content": "Так и думал?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3750103,
					"content": "Просто хотел узнать, насколько мало влияния у новобранца Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750104
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750104,
					"content": "Лучшему воину полагается лучший меч, однако...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750105
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750105,
					"content": "Быть может, я сочиню об этом песню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750106
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750106,
					"content": "Ты на что намекаешь? Думаешь, мы недостаточно хороши?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3750107,
					"content": "Нет. Во мне говорит разочарованность в Мондштадте, который не способен разглядеть величайшего воина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750108
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750108,
					"content": "Ну что ж, раз у нас не получилось достать лиру законным способом... Нам придётся её украсть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750109
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750110,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750111
					]
				},
				{
					"id": 3750109,
					"content": "Я готов выслушать любые предложения. У кого есть идеи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750110
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750112,
					"content": "Я не собираюсь нарушать закон!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750113
					]
				},
				{
					"id": 3750111,
					"content": "Говори, не стесняйся! Для этого тебе дана свобода слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750112
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750113,
					"content": "Ха-ха. Чуть что, сразу на попятную.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750114
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750114,
					"content": "Но боюсь, что тебе всё-таки придётся это сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750115
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750115,
					"content": "Я умею только петь и ничего более.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750116
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750116,
					"content": "Кроме того, в случае неудачи за меня некому будет поручиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750117
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750117,
					"content": "Как можно поручиться за того, кого поймали на краже?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3750118,
					"content": "#{NICKNAME} - это совсем другое дело. Ты суперзвезда Ордо Фавониус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750119
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750119,
					"content": "Даже если тебя поймают, тебе ничего не будет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750120
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750140,
					"content": "Ночью собор не охраняется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750141,
					"content": "Если тебя поймают, то дела будут плохи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750120,
					"content": "Прекрати говорить, что нас поймают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3750122,
					"content": "Погоди. Ты притворялся Барбатосом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750123
					]
				},
				{
					"id": 3750121,
					"content": "#Что скажешь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750122
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750123,
					"content": "Ну... Что-то вроде того...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750124
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750125,
					"content": "Если ты правда Архонт, то мы тебя искали.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750126
					]
				},
				{
					"id": 3750124,
					"content": "Почему ты спрашиваешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750125
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750126,
					"content": "Это ещё почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750127
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3750128,
					"content": "Я помогу Двалину, даже если ты не Архонт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750129
					]
				},
				{
					"id": 3750127,
					"content": "#Когда будет достаточно времени, я расскажу, почему {NICKNAME} ищет Анемо Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3750130,
					"content": "Я добуду для тебя Небесную лиру.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750131,
					"content": "Я не хочу, чтобы вы потеряли друг друга.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750129,
					"content": "В самом деле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750130,
						3750131
					],
					"speakerTitle": "Венти"
				}
			]
		},
