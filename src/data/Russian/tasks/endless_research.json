				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Алрани"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100101,
					"content": "Эх... Так писать диссертацию никак невозможно. Что же делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100102
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100103
					]
				},
				{
					"id": 718100103,
					"content": "Я... А? Это ты! Помнишь меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100104
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100104,
					"content": "#Я была в клетке Похитителей сокровищ на перевале Линцзю... Ха-ха... Спасибо, что спас{F#ла} меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100105
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100105,
					"content": "Что ты тут делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100106
					]
				},
				{
					"id": 718100106,
					"content": "После спасения я пошла искать Сорайю на постоялый двор «Ваншу» и мне повезло - я нашла её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100107
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100107,
					"content": "Сорайя такая добрая - она не только накормила меня, но и помогла разобрать мои записи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100108
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100108,
					"content": "Но... потом она сказала, что многие в Академии уже писали на выбранную мной тему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100109
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100109,
					"content": "Я точно не пройду, если только не напишу гениальную работу... Она говорит, что лучше сменить подход: написать, например, что-то об элементах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100110
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100110,
					"content": "Но я не могу использовать элементы, ведь у меня нет Глаза Бога. Не знаю даже, с чего начать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100111
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100111,
					"content": "Поэтому я просто наудачу брожу по городу, вдруг мне что-то попадётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100112
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100112,
					"content": "#Постой... А ты ведь очень необычно сражал{M#ся}{F#ась}, когда меня спасал{F#а}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100113
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100113,
					"content": "У тебя есть Глаз Бога?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100114
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100114,
					"content": "Нет, у меня нет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100115
					]
				},
				{
					"id": 718100115,
					"content": "А? Ты так сражаешься даже без Глаза Бога? Как же это возможно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100116
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100116,
					"content": "Нет, сейчас об этом думать не стоит, наверняка это очень сложно... Но я хотела бы попросить тебя об одолжении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100117
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100117,
					"content": "Можешь ещё раз показать, как ты сражаешься? Возможно, я смогу приметить что-то, что поможет мне с диссертацией...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100118
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100118,
					"content": "Прошу! Если я не напишу эту работу, то в Академии мне конец...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100119,
						718100122
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100119,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100120
					]
				},
				{
					"id": 718100120,
					"content": "Спасибо тебе! Пойдём за город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100121
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100121,
					"content": "Я видела здесь группу хиличурлов. Покажи на них, как ты сражаешься!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100122,
					"content": "В Академии настолько ужасно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100123
					]
				},
				{
					"id": 718100123,
					"content": "Очень, очень ужасно... Я каждый раз просыпаюсь в слезах, когда она мне снится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100124
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100124,
					"content": "Уж лучше сидеть в клетке, чем снова защищаться и переписывать работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100125
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100125,
					"content": "Ладно, хватит об Академии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100126
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100126,
					"content": "Я видела здесь группу хиличурлов. Покажи на них, как ты сражаешься!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Алрани"
				}
			]
		},
		{
			"id": 7181002,
			"completionStepIds": [
				7181003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181003",
							"2"
						],
						"stepId": 7181003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Алрани"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100201,
					"content": "Ух ты... Твой стиль действительно уникален.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100202
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100202,
					"content": "Ах да, я слышала, что владельцы Глаза Бога могут чувствовать элементальные следы. Это называют чувством стихий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100203
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100203,
					"content": "Хотя у тебя нет Глаза Бога, но я видела, как ты используешь силу элементов... Наверное, и чувство стихий у тебя есть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100204
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100204,
					"content": "Я тут недалеко видела пару слаймов. Можешь, пожалуйста, показать своё чувство стихий? Найди слаймов с его помощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Алрани"
				}
			]
		},
		{
			"id": 7181003,
			"completionStepIds": [
				7181009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181009",
							"2"
						],
						"stepId": 7181009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Алрани"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100301,
					"content": "Ха-ха... Человеку без Глаза Бога типа меня совсем и не видно, когда ты используешь чувство стихий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100302
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100302,
					"content": "Наверное, только владельцы Глаза Бога могут это почувствовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100303
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100303,
					"content": "Но спасибо тебе за демонстрацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100304
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100304,
					"content": "Эх, как бы мне хотелось получить Глаз Бога... Лучше всего Электро. И выглядит круто, и защищаться можно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100305
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100305,
					"content": "Нет, Электро Глаз Бога, наверное, сложнее всего получить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100306
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100306,
					"content": "Если постараться, то всё возможно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100307
					]
				},
				{
					"id": 718100307,
					"content": "Да нет же, тут старание не поможет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100308
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100308,
					"content": "Ах, ты не знаешь? Где-то год уже никто не получал Электро Глаз Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100309
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100309,
					"content": "Говорят, что в Академии специально долго изучали этот вопрос и решили, что это всё воля Электро Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100310
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100310,
					"content": "А ещё я слышала, что правящий Инадзумой Электро Архонт объявил «охоту на Глаза Бога» и конфискует их у владельцев по всей Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100311
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100311,
					"content": "А тех, кто откажется отдавать, жестоко наказывают...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100312
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100312,
					"content": "Я как-то хотела поехать в Инадзуму, чтобы написать об этом исследовательскую работу, но... Но там, похоже, довольно опасно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100313
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100313,
					"content": "Ничего страшного, у тебя же нет Глаза Бога.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100314
					]
				},
				{
					"id": 718100314,
					"content": "Не говори так! Да и подумай, если владельцы Глаза Бога так страдают, то что же говорить об обычных людях?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100315
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100315,
					"content": "Лучше уж я спокойно допишу работу в Ли Юэ, побыстрее вернусь в Академию Сумеру и сдам её. А то если дальше тянуть, то проблем не оберёшься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100316
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100316,
					"content": "Ах да, я же так и не отблагодарила тебя за всё. Вот, возьми в благодарность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100317
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 718100317,
					"content": "Уж теперь я точно допишу её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Алрани"
				}
			]
		}
	]
}