	"talks": [
		{
			"id": 7181001,
			"completionStepIds": [
				7181001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181001",
							"2"
						],
						"stepId": 7181001,
						"stateName": "QUEST_STATE_UNFINISHED"
