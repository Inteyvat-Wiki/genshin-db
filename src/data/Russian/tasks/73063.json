			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Арагару"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730630501,
					"content": "#{F#Золотая}{M#Золотой} нара и белая леталка, вы пришли! Я Арагару.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630502
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630502,
					"content": "Растения и грибы рассказали мне, что вы придёте. Долго же мне пришлось ждать вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630503
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630503,
					"content": "А? Мы знакомы?.. Тебе что-то от нас нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730630504,
					"content": "Нужно! Очень, очень важное дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630505
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630505,
					"content": "Эй, успокойся. Не торопись, выкладывай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730630506,
					"content": "Марана становится всё больше. Леса боятся говорить, боятся дышать... Марана хочет поглотить их...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630507
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630507,
					"content": "Чтобы остановить Марану, Аранага готовит обряд арахаомы. Вот только для арахаомы... нужен цветок барсам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630508
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630508,
					"content": "Вот как... А где найти этот цветок барсам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630509,
						730630511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730630509,
					"content": "Паймон, в этот раз ты произнесла название правильно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630510
					]
				},
				{
					"id": 730630510,
					"content": "Хе-хе! Цве-ток бар-сам! Круто, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730630512,
					"content": "Цветок барсам растёт там же, где и грибы. Там много лун назад были дома нар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630513
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630513,
					"content": "Но потом... грязь покрыла сновидения нар, а их воспоминания породили новую растительность, которая засыхала и вновь прорастала поколение за поколением... Туда нам и нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630514
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630514,
					"content": "Хм... Не совсем понятно, но очень страшно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730630515,
					"content": "Совсем не страшно. Растениям нравятся места, которых боятся нары. Поэтому их там много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630516
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630516,
					"content": "Там руны аранар и нар. Они помогают не забывать. И вспоминать, если забыл. Там вы и найдёте цветок барсам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630517
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630517,
					"content": "Тогда давайте вместе отправимся туда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630518
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730630518,
					"content": "Ой, точно, ещё кусава!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630519
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630519,
					"content": "Кусава делает аранар сильными. Эта сила расчистит путь! Арагару раздробит камни! Ха! Ха! Бух!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630520
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630520,
					"content": "Глядите-ка, как силён этот малыш!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630521
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730630521,
					"content": "Хе-хе, да, силён! Хм... Но только если камень с трещинами и покрыт зелёной лозой. Если камень целый, мне не раскрошить его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630522,
						730630525
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630522,
					"content": "А что такое кусава?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630523
					]
				},
				{
					"id": 730630523,
					"content": "Кусава хранит воспоминания и сны. Она толстая, горькая и полная силы. Это плод цветущих растений, а также семя новой жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630524
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630524,
					"content": "Вот, возьми. Береги её. Аранары дают её только тем, кто действительно важен, так что... не ешь её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630527
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630527,
					"content": "Хм... уже прошло много лун, осталось совсем немного. Там всегда ходячие грибы, их всё больше... Плохо дело. Поспешим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630525,
					"content": "Что такое цветок барсам?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630526
					]
				},
				{
					"id": 730630526,
					"content": "Цветок барсам - добрый друг аранар, рождённый для приготовления арахаомы. Это источник эликсира. Нужно пожертвовать соком, чтобы очистить арахаому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630527
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730630511,
					"content": "Его, наверно, нелегко найти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630512
					]
				}
			]
		},
		{
			"id": 7306306,
			"completionStepIds": [
				7306306
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
