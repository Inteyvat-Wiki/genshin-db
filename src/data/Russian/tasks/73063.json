			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Арагару"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730633501,
					"content": "Ах! Ой! Кхе-кхе! Ч-чего это вдруг хлынула вода?! Паймон чуть не утонула!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633502,
						730633503,
						730633504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730633502,
					"content": "Как холодно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730633506
					]
				},
				{
					"id": 730633506,
					"content": "Королевство Кхаб - сон цветка барсам. С пробуждением цветка барсам сон растворяется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633507
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730633507,
					"content": "Воду больше не удержать, вот она и вырывается наружу! Плюх-плюх! Чистая и холодненькая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633508
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730633508,
					"content": "Хм... Вот если бы нас смыло с концами, ты бы по-другому заговорил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730633509,
					"content": "Хе-хе, Арагару знает, где нара и белая леталка, а растения могут подсказать мне ваше местоположение. Вы не потеряетесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633510
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730633510,
					"content": "Так, у нас есть цветок барсам. Теперь нам нужно найти гриб зохру и траву яджна. После этого можно попросить Аранагу приготовить арахаому!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633511,
						730633516
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730633511,
					"content": "Мы уже раздобыли гриб зохра.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730633512
					]
				},
				{
					"id": 730633512,
					"content": "#Да, спасибо, нара {NICKNAME} и белая леталка! Аранага сказал бы, что «ты совсем как нара Варуна»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633513
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730633513,
					"content": "#Хи-хи, то есть, нара {NICKNAME} и белая леталка большие молодцы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633514
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730633514,
					"content": "Теперь разыщи Аранагу. Аранаге наверняка нужна твоя помощь. Он сейчас в лесу Мотийимы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633515
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730633515,
					"content": "Хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633521
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730633521,
					"content": "Далее... Я отправлюсь в лес Мотийимы, чтобы подготовиться к обряду арахаомы. Встретимся там!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730633516,
					"content": "Расскажи мне об Аранаге.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730633517
					]
				},
				{
					"id": 730633517,
					"content": "Аранага самый старший и интересный из нас троих. Он знает много интересных историй и может многое рассказать о нарах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633518
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730633518,
					"content": "Но также он много чего о нарах забыл... Мы втроём уже много чего не помним. Что-то развеялось, как пыльца на ветру, а что-то затуманилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633519
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730633519,
					"content": "Однако Аранага знает и помнит больше всех. Поэтому нам нравится с ним играть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633520
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730633520,
					"content": "Он в садах леса Мотийимы приглядывает за Мотийимой. Отправляйтесь туда, и вы найдёте его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633521
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730633503,
					"content": "Как мокро.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730633506
					]
				},
				{
					"id": 730633504,
					"content": "Как шумно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730633505
					]
				},
				{
					"id": 730633505,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633506
					],
					"speakerTitle": "Паймон"
				}
			]
		},
