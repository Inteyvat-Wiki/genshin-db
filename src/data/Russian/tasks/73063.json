					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730631101,
					"content": "Вот здесь! Смотри!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631102
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730631102,
					"content": "Это что такое? Какой-то детский рисунок... что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730631103,
					"content": "Воспоминания! Воспоминания аранар могут храниться в клубнях и семенах, течь в жилах листьев... А воспоминания нар вырезаются на камнях!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631104
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730631104,
					"content": "Хе-хе, каждый раз, когда луна высоко в небе, мы, трое аранар, приходим сюда и вспоминаем истории из прошлого. Совсем как нары!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631105
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730631105,
					"content": "Хм... тогда что означает этот рисунок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730631106,
					"content": "Это не рисунок, а руна... Это река света, в которой распускаются звёздами цветы. Река и звёзды направили к нам храбрых нар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631107
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730631107,
					"content": "Повелитель растений в сердцах храбрых нар зародил ростки мудрости и приказал аранарам провести их... к пещере с сияющей водой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631108
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730631108,
					"content": "Хм... Это они. Рядом есть и другие руны. Давайте посмотрим на них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арагару"
				}
			]
		},
		{
			"id": 7306316,
			"completionStepIds": [
				7306316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
