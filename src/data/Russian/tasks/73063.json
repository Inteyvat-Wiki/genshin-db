					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730633101,
					"content": "Это то самое место!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633102
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730633102,
					"content": "Но здесь... всё заросло лозой. Нам никак не попасть внутрь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730633103,
					"content": "Хи-хи, белая леталка, не паникуй. Смотри!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арагару"
				}
			]
		},
		{
			"id": 7306335,
			"completionStepIds": [
				7306334
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306334",
