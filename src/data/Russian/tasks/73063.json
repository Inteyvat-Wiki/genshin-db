			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арагару",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730632301,
					"content": "Это и есть Королевство Кхаб. Здесь прячутся сладкие сны растений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632302
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632302,
					"content": "Видишь? Там растёт цветок барсам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632303
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632303,
					"content": "Ух ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632304,
						730632306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730632304,
					"content": "Здесь так тихо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632305
					]
				},
				{
					"id": 730632305,
					"content": "Ага, так тихо, что у Паймон мурашки по коже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730632308,
					"content": "Королевство Кхаб очень слабое... Грибы пришли и поглотили много питательных веществ, но цветок барсам не пострадал... пока что.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632309
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632309,
					"content": "Давайте разрушим печать и поговорим с ним!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632310
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632310,
					"content": "Хорошо, мы разрушим печать, а ты поговоришь с ним!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730632306,
					"content": "Цветок барсам вот здесь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632307
					]
				},
				{
					"id": 730632307,
					"content": "Ох, здесь всё выглядит так необычно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632308
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7306329,
			"completionStepIds": [
				7306329
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306329",
							"2"
						],
						"stepId": 7306329,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Арагару"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730632901,
					"content": "Арагару просто поговорит с цветком барсам, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730632902,
					"content": "Тсс! Тише, не разбуди его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632903
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632903,
					"content": "Арагару разговаривает с цветком барсам...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730632904
					]
				},
				{
					"id": 730632904,
					"content": "Мы вырвали цветок барсам из его сновидения, поэтому он очень зол.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632905
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632905,
					"content": "А?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632906
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730632906,
					"content": "Но ради арахаомы он простит нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632907
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632907,
					"content": "Цветок барсам, цветок барсам, ради арахаомы, ради возрождения Мотийимы... ты присоединишься к нам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632908
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632908,
					"content": "Хм?.. Что?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632909,
						730632911
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730632909,
					"content": "Паймон, ты что делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632910
					]
				},
				{
					"id": 730632910,
					"content": "Паймон пытается услышать, что ему отвечает цветок барсам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632913
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730632913,
					"content": "Прекрасно! Цветок барсам согласился отправиться вместе с нами на приключения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632914
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632914,
					"content": "Ура! Цветок барсам у нас в руках!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632915
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730632915,
					"content": "Ох, а ещё... цветок барсам советует тебе беречь голову.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632916
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632916,
					"content": "...В смысле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632917
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730632917,
					"content": "Береги голову и корни, иначе они повредятся, когда придёт вода...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632918
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632918,
					"content": "Хм? Погодите... что это за звук?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632919
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730632919,
					"content": "Осторожно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632911,
					"content": "Ты понимаешь, о чём они?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632912
					]
				},
				{
					"id": 730632912,
					"content": "...Паймон ничего не слышит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632913
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7306331,
			"completionStepIds": [
				7306331
			],
			"beginWay": "TALK_BEGIN_MANUAL",
