				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730632001,
					"content": "Ух ты!.. Как это у тебя получилось, Арагару? Паймон тоже так хочет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632002,
						730632003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730632002,
					"content": "Вряд ли этому можно научиться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632004
					]
				},
				{
					"id": 730632004,
					"content": "Хе-хе, Арагару умеет говорить с лозой, поэтому она расступается! Язык лозы похож на песню, однако нарам очень тяжело учить его. Но Арагару научит, если нара так этого хочет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632005
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632005,
					"content": "Паймон тоже хочет! Арагару, потом обязательно научи Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632006
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730632006,
					"content": "Хорошо, только если я не забуду вас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730632003,
					"content": "Я тоже хочу научиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632004
					]
				}
			]
		},
