					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730631601,
					"content": "Королевство Кхаб находится перед пещерой... Проходя мимо, мы должны быть осторожны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631602
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730631602,
					"content": "Это земля, где спят нары. Когда-то здесь были каменные дома нар. Но когда они заснули, хозяевами здесь стали растения из их снов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631603
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730631603,
					"content": "Ого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730631604,
					"content": "Белая леталка всё поняла?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631605
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730631605,
					"content": "Не очень...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730631606,
					"content": "Эх, это потому, что ты очень глупая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631607,
						730631608
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730631607,
					"content": "Вот как...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730631609
					]
				},
				{
					"id": 730631609,
					"content": "Эй, ты на чьей стороне?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730631608,
					"content": "Так вот почему...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730631609
					]
				}
			]
		},
		{
			"id": 7306320,
			"completionStepIds": [
				7306320
			],
			"beginWay": "TALK_BEGIN_MANUAL",
