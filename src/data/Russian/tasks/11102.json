			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020201,
					"content": "Это вы... Я вас помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020202
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020202,
					"content": "Я как раз очищал это место от существ, поражённых демоническим проклятием. Кажется, я вам помешал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020203
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020203,
					"content": "(Хм, он обычно не такой вежливый. В чём же дело...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020204,
					"content": "Но ты же тоже изгоняешь демонов. Как ты мог нам помешать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020205,
					"content": "Дело в том, что мутация этих монстров произошла из-за меня. Вернее, из-за моей кармы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020206
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020206,
					"content": "Мутации, карма... Неужели...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020207,
						111020208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020207,
					"content": "В книге «Яксы: Защитники Адептов» упоминалось...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				},
				{
					"id": 111020209,
					"content": "Да-а, кажется, Паймон припоминает, что Сяо ещё называют Защитником Яксой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020210,
					"content": "Тогда получается... О-ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020211,
					"content": "Ох, бедный Сяо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020212,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020213,
						111020214
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020213,
					"content": "Мы прочитали о твоём прошлом в книге.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020215,
					"content": "Ах. Это та книга с нелепыми догадками эрудитов, живших сотни лет назад?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020216
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020216,
					"content": "Ничто не вечно, и всё - страдание. Мы, Яксы, не нуждаемся в чужих слезах и сочувствии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020217
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020217,
					"content": "Моим ушедшим товарищам такое отношение тоже не понравилось бы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020218
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020218,
					"content": "Ой... Прости нас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020219,
					"content": "Это уже не имеет значения. Как бы то ни было, мне ещё нужно очистить пещеру от демонического влияния, поэтому здесь я с вами прощаюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020220
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020220,
					"content": "П-подожди! Возьми нас с собой, мы тебе поможем, честное слово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020221,
					"content": "В этом нет необходимости. Я привык действовать в одиночку. Да и к тому же я сам являюсь причиной этих мутаций...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020222
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020222,
					"content": "Ну тогда ты можешь принять это в качестве извинений за невежливость Паймон! Ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020224
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020224,
					"content": "...Идём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020214,
					"content": "Мы только что прочитали книгу «Яксы: Защитники Адептов».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020208,
					"content": "То есть Сяо - последний Якса?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				}
			]
		},
		{
			"id": 1110204,
			"completionStepIds": [
				1110204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110204",
							"2"
						],
						"stepId": 1110204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020401,
					"content": "От этого места у Паймон мурашки по коже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020402,
					"content": "Я проведу ритуал истребления всего зла, чтобы очистить это место от кармы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020403
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020403,
					"content": "Сохраняйте спокойствие и ни в коем случае не позволяйте гневу поверженных Архонтов захватить вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сяо"
				}
			]
		},
		{
			"id": 1110206,
			"completionStepIds": [
				1110205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110205",
							"2"
						],
						"stepId": 1110205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020601,
					"content": "Как много заражённых демоническим влиянием существ... Очень странно. Приди мы позже, и последствия могли быть куда хуже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020602
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020602,
					"content": "Вы упомянули о каком-то Звездохвате. Кто это такой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020603
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020603,
					"content": "О-о, сейчас Паймон тебе расскажет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020604,
					"content": "Люди так легко ведутся на ложь об «исполняющих желания Адептах»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020605
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020605,
					"content": "Ты ведь Адепт, Сяо. Ты умеешь исполнять желания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020606,
					"content": "Прежние жители Ли Юэ никогда бы не обратились к Адептам с такими эгоистичными просьбами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020607
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020607,
					"content": "Что нужно было людям, населявшим Ли Юэ тысячи лет назад, так это силы, чтобы защитить свою родную землю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020608
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020608,
					"content": "Но для современных людей идея об Адептах, исполняющих желания, намного более привлекательна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020609,
					"content": "Но меня не касается то, насколько слабы нынче люди. Я лишь чту изначальную волю Властелина Камня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020610
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020610,
					"content": "Паймон опять ляпнула что-то не то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020611,
					"content": "А... Ну да, точно! Тот выдававший себя за Адепта тип использовал Печать согласия, чтобы изгонять демонов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020612,
					"content": "Вот как? Глупец. Изгоняет демонов, но не уничтожает их... Неудивительно, что они все собрались здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020613
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020613,
					"content": "Если так будет продолжаться, ситуация может выйти даже из-под моего контроля... Нужно забрать у него Печать согласия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020614,
						111020615
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020614,
					"content": "Всего лишь забрать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020616
					]
				},
				{
					"id": 111020616,
					"content": "Паймон тоже так думает! Нужно хорошенько проучить этого обманщика!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020617
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020617,
					"content": "А у нас как раз есть настоящий Адепт... Если им займётся Сяо, Звездохват никогда больше не посмеет выдавать себя за Адепта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020618,
					"content": "Нет. Я истребляю только демонов. Я не убиваю простых смертных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020619
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020619,
					"content": "Паймон не предлагала убивать его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020620
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020620,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020621
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020621,
					"content": "Если мы заставим его прекратить творить зло, это сделает Ли Юэ лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020622
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020622,
					"content": "Я обладаю способностью, которая называется «Странствие по снам». Она даёт возможность душе путешествовать во время сна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020623
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020623,
					"content": "Но с её помощью можно и призывать души других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020624
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020624,
					"content": "Вот это настоящее искусство Адепта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020625,
						111020626
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111020625,
					"content": "Это будто явление во сне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020627
					]
				},
				{
					"id": 111020627,
					"content": "Сначала нужно провести ритуал. Вам придётся помочь мне собрать некоторые предметы: курильницу, семь ламп и что-нибудь, что поможет снизить температуру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020628
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 111020628,
					"content": "Снизить температуру... Туманный цветок подойдёт?",
					"roleType": "TALK_ROLE_NPC",
