			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Железная Доуэр"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2083.502,
							359.483,
							2715.594
						],
						"pointId": 311500088
					}
				]
			},
			"dialogs": [
				{
					"id": 711160202,
					"content": "Не буду вас благодарить, но, если вы когда-нибудь окажетесь в затруднительном положении, то позовите, и я примчусь на помощь в мгновение ока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "Железная Доуэр"
				},
				{
					"id": 711160203,
					"content": "Ого! С чего такая любезность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711160204,
					"content": "Не буду ходить вокруг да около. В последнее время у меня проблемы с финансами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "Тебе нужна мора? Ха-ха, понимаю, но с этим могут возникнуть затруднения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "Железная Доуэр"
				},
				{
					"id": 711160206,
					"content": "Босс забрал всё, что у нас было. Мы остались ни с чем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Железная Доуэр"
				},
				{
					"id": 711160210,
					"content": "Босс?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "Наш босс - предводитель банды «Железо и соль». Он с кучкой фонтейнских псов пошёл туда, к подножию скалы, а нас оставил здесь держать оборону.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "Железная Доуэр"
				},
				{
					"id": 711160212,
					"content": "Вы же видели, что произошло? Эти лягушатники пробрались сюда, пока босс отсутствовал, и всадили нам нож в задницу, в самом прямом смысле!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "Железная Доуэр"
				},
				{
					"id": 711160213,
					"content": "Ах! Нож в задницу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711160214,
					"content": "Ужас!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "Ты что, думаешь, я первый день на этом свете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "Железная Доуэр"
				},
				{
					"id": 711160216,
					"content": "#Раз они раскрыли себя и набросились на нас, то босс тоже может оказаться в ловушке. Ты говорил{F#а}, что никогда не закрываешь глаза на несправедливость. Можешь ещё раз помочь нам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "Железная Доуэр"
				},
				{
					"id": 711160217,
					"content": "Пока босс в безопасности, вы будете обеспечены самыми роскошными блюдами и сможете жить припеваючи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "Железная Доуэр"
				},
				{
					"id": 711160218,
					"content": "Где он? Я пойду проверю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "На том пляже под скалой. Ты увидишь его, когда окажешься там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "Железная Доуэр"
				},
				{
					"id": 711160220,
					"content": "Мне нужно закончить здесь дела, после чего я присоединюсь к вам. Идите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Железная Доуэр"
				},
				{
					"id": 711160207,
					"content": "#Я увидел{F#а} несправедливость и {F#пришла}{M#пришёл} на помощь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "#Ты поступил{F#а} в высшей степени благородно! В таком случае мне есть что рассказать вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "Железная Доуэр"
				},
				{
					"id": 711160209,
					"content": "Наш босс, скорее всего, сам находится в затруднительном положении. Ему наверняка нужна помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Железная Доуэр"
				}
			]
		},
