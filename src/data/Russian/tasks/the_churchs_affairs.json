			"dialogs": [
				{
					"id": 190010201,
					"content": "Сестра Барбара... Куда же ты ушла?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Виктория"
				}
			]
		},
		{
			"id": 1900303,
			"completionStepIds": [
				1900303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1900303",
							"2"
						],
						"stepId": 1900303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Виктория"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030301,
					"content": "#О, ты вернул{F#ась}{M#ся}! Если ты ищешь Барбару... В общем, она ещё не вернулась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030302,
						190030303
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030302,
					"content": "Мы нашли Барбару в Вольфендоме.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				},
				{
					"id": 190030304,
					"content": "Хвала Барбатосу! С ней всё в порядке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030305
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030305,
					"content": "Но, похоже, она не собирается возвращаться в ближайшее время. Возможно, стоит перепоручить её церковные обязанности кому-то другому...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030306
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030306,
					"content": "Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030307
					]
				},
				{
					"id": 190030307,
					"content": "Это очень любезно с твоей стороны. Если честно, я бы не хотела тебя беспокоить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030308
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030308,
					"content": "Но... Эм... Может быть, ты сможешь навести порядок вокруг собора?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030309
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030309,
					"content": "Каждый день здесь проходит огромное количество людей. Они приносят много грязи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030310
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030310,
					"content": "Обычно уборкой занимается сестра Барбара... Без неё пыль быстро накапливается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030311
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030311,
					"content": "Уборкой всего этого огромного места занимает одна Барбара?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030312
					]
				},
				{
					"id": 190030312,
					"content": "Верно. Она всегда настаивает на том, что справится с уборкой одна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030313
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030313,
					"content": "Но после уборки она часто выглядит измотанной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030314
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030314,
					"content": "Честно говоря, я удивлена, что ты хочешь помочь... Вернее, что Барбара позволила тебе помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030315
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030315,
					"content": "В конце концов, это облегчит её ношу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030316
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030316,
					"content": "Позволь поручить уборку тебе, почётный рыцарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030303,
					"content": "Барбара помогает Таннеру на винокурне «Рассвет».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				}
			]
		},
