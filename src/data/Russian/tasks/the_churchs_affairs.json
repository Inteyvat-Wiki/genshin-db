					"Виктория"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030601,
					"content": "Да? Что-то ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030602,
					"content": "Об отпуске Барбары...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "Сестра Барбара отпросилась на полдня. Она сказала, что хочет встретиться с другом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030604,
					"content": "Должна признаться, что для Барбары несвойственно просить отгул, чтобы встретиться с друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030605,
					"content": "#Но это не имеет отношения к делу... О чём ты хотел{F#а} спросить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030606,
					"content": "Коралловый чай удивительных видений и печали с пузырьками...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "Ах! Хочешь сказать, что Барбара собирается сопровождать тебя, чтобы купить этот... напиток?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030608,
					"content": "Получается, ты и есть тот друг, о котором она говорила, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030609,
					"content": "Хм... Учитывая, что ты почётный рыцарь, полагаю, проблем не возникнет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030610,
					"content": "Прошу тебя, позаботься о сестре Барбаре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030611,
					"content": "Почему Барбара должна отчитываться о всех своих действиях?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "Как тебе известно, по разным причинам Барбара пользуется огромной популярностью в Мондштадте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030613,
					"content": "И хотя её фанаты действуют исключительно из лучших побуждений, иногда их бывает слишком много для сестры Барбары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030614,
					"content": "Мы можем уберечь её, пока она находится в соборе, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030615,
					"content": "Если фанаты будут докучать ей в нерабочее время, то она сможет надеяться только на саму себя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030616,
					"content": "Не говоря уже о том, что она слишком... мила. Она просто не сможет отказать мондштадтцам, даже если будет находиться на грани полного истощения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030617,
					"content": "Поэтому мы решили, что Барбара будет сообщать нам о своём расположении. На тот случай, если понадобится спасти её от толпы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030618,
					"content": "Надеюсь, Барбара перестанет быть такой требовательной к себе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Виктория"
				}
			]
		},
		{
			"id": 1900307,
			"completionStepIds": [
				1900307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
