					"Виктория"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030701,
					"content": "Хм? Привет. Чем ещё могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030702
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030702,
					"content": "О маршруте Барбары...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030703
					]
				},
				{
					"id": 190030703,
					"content": "Сестра Барбара желает отправиться в Шепчущий лес, чтобы собрать травы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030704
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030704,
					"content": "Понятно... На самом деле, сестра Барбара только что отпросилась на полдня, чтобы встретиться с другом. Теперь она внезапно намерена пойти собирать травы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030705
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030705,
					"content": "Полагаю, Барбара знает, что делает... Ты собираешься отправиться с ней вместе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030706
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030706,
					"content": "Да, я буду сопровождать Барбару.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030707
					]
				},
				{
					"id": 190030707,
					"content": "Значит, Барбара в хороших руках. Пожалуйста, позаботься о ней, почётный рыцарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030708
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030708,
					"content": "Почему Барбара должна отчитываться о всех своих действиях?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030709
					]
				},
				{
					"id": 190030709,
					"content": "Как тебе известно, по разным причинам Барбара пользуется огромной популярностью в Мондштадте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030710
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 190030710,
