				},
				{
					"id": 721650303,
					"content": "Хе-хе, что там у нас сегодня с удачей, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721650304,
					"content": "Хм... Предсказание волшебной травы гласит, что сегодня тебе улыбнётся удача.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650305
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650305,
					"content": "Добрый дух Электро направит ваш путь. Вы найдёте его рядом с водоёмом в центре острова Ватацуми, прямо под Сангономией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650306
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650306,
					"content": "Ура!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721650307,
					"content": "Это должно быть правдой. Гадания обычно очень точные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650308
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650308,
					"content": "Хм, почему-то после твоих слов Паймон только начала ещё больше сомневаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721650309,
					"content": "Паймон всегда так себя ведёт, не обращай внимания, бабушка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650310
					]
				},
				{
					"id": 721650310,
					"content": "Ха-ха, ничего-ничего, молодёжь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650311
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650311,
					"content": "#Эй, подожди-ка, что это ты хочешь сказать, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
