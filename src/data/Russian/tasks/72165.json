			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Комаки",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721650101,
					"content": "Вы вернулись. У вас есть ко мне какое-то дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650102
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650102,
					"content": "Погадай мне!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650103
					]
				},
				{
					"id": 721650103,
					"content": "#Я тоже хочу узнать, насколько удачлив{F#а} сегодня будет {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721650104,
					"content": "Хм... Судя по узорам на листьях волшебной травы, сегодня тебе улыбнётся удача.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650105
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650105,
					"content": "Вы найдёте свою удачу в самой высокой точке Ватацуми, в древнем месте подношений богам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650106
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650106,
					"content": "Хм... Почему у Паймон не получается ничего из этого разглядеть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721650107,
					"content": "Ха-ха, это древнее искусство уроженцев этих мест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650108
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650108,
					"content": "По-моему, ты пытаешься обмануть Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7216502,
			"completionStepIds": [
				7216503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
