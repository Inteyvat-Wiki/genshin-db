			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Комаки",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721650201,
					"content": "Здравствуйте. Что привело вас сюда сегодня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650202
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650202,
					"content": "Погадай мне!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650203
					]
				},
				{
					"id": 721650203,
					"content": "Хе-хе, что там у нас сегодня с удачей, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721650204,
					"content": "Ох, волшебная трава говорит, что сегодня удача от вас отвернулась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650205
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650205,
					"content": "Вам предстоит неожиданная встреча, сулящая злоключения, в пещере на юге острова Ватацуми - гнезде отбросов и злодеев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650206
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650206,
					"content": "Ой, вот невезение! Тогда нам, наверно, лучше держаться подальше от этого места...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721650207,
					"content": "Ха-ха, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650208
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650208,
					"content": "...справившись с неудачей, вы можете что-то обрести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650209
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650209,
					"content": "Обрести? Это про сокровища, да? Сокровища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721650210,
					"content": "Я этого не говорила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650211
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650211,
					"content": "А...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721650212,
					"content": "Но не говорила и того, что их там нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650213
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650213,
					"content": "Ох, бабуля, ну почему ты такая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
