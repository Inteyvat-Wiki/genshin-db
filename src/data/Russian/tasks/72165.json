				},
				{
					"id": 721650403,
					"content": "Паймон тоже хочет узнать, ждёт ли нас сегодня удача!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721650404,
					"content": "Хм, волшебная трава сулит неудачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650405
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650405,
					"content": "Разрушенное святилище на востоке окутано зловещей аурой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650406
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650406,
					"content": "Ой, звучит страшно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721650407,
					"content": "Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650408
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650408,
					"content": "Посмевший сразиться со злым роком получит справедливое вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650409
					],
					"speakerTitle": "Комаки"
				},
				{
					"id": 721650409,
					"content": "Звучит похоже на то, что ты говорила раньше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650410
					]
				},
				{
					"id": 721650410,
					"content": "Ах, но ведь такова жизнь... Новый опыт всегда рядится в одежды прошлых событий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Комаки"
				}
			]
