			"dialogs": [
				{
					"id": 700960401,
					"content": "У тебя очень плавные движения, совсем не как у механизма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960402
					],
					"speakerTitle": "Лоэн"
				},
				{
					"id": 700960402,
					"content": "Атаки господина Лоэна точны, прямо как у машины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960403
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 700960403,
					"content": "Ура! Новые детали! Можно забрать их и сделать новые модули!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960404
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 700960404,
					"content": "Значит... э-э-э... у вас появилось свободное время?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960405
					],
					"speakerTitle": "Лоэн"
				},
				{
					"id": 700960405,
					"content": "Инеффа! Найди ещё несколько! Чем больше, тем лучше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960406
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 700960406,
					"content": "Поняла... Прошу прощения. Поговорим позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960407
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 700960407,
					"content": "Спустя некоторое время...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700960408
					]
				},
				{
					"id": 700960408,
					"content": "Хр-р-р... Хр-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960409
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 700960409,
					"content": "Айно спит... Так устала, играя в Терновом порту?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700960410,
					"content": "С ней часто такое бывает - батареи быстро разряжаются. Простите, господин Лоэн, но боюсь, что сейчас я не могу двигаться. Я должна быть здесь, пока Айно не погрузится в глубокий сон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960411
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 700960411,
					"content": "...Ничего страшного. Я видел достаточно, чтобы понять, на что ты способна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960412
					],
					"speakerTitle": "Лоэн"
				},
				{
					"id": 700960412,
					"content": "Надеюсь, эта информация будет вам полезна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960413
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 700960413,
					"content": "Кстати, человек, который рассказал нам об особых механизмах, также упоминал Драконий хребет. Почему бы вам не заглянуть туда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Инеффа"
				}
			]
		},
