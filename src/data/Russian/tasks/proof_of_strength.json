			"dialogs": [
				{
					"id": 700960701,
					"content": "Эх, впервые сама взялась за дело, и вот как всё обернулось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960702,
						700960704
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 700960702,
					"content": "Всё поначалу даётся с трудом...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960703
					]
				},
				{
					"id": 700960703,
					"content": "К тому же всё закончилось неплохо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700960704,
					"content": "За какое дело ты впервые сама взялась?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960705
					]
				},
				{
					"id": 700960705,
					"content": "Хм... Это «Уроки ведьм». Потом объясню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Николь"
				}
			]
		},
