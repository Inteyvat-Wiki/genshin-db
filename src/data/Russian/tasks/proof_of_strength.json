				]
			},
			"dialogs": [
				{
					"id": 700960301,
					"content": "Инеффа, Инеффа! Смотри на ту мельницу! Мне нужно, чтобы ты запечатлела принцип её работы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960302
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 700960302,
					"content": "Принято. Готовлюсь сделать снимок ветряной мельницы. Хочешь, чтобы и ты в этот раз оказалась на снимке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960303
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 700960303,
					"content": "#Э? {NICKNAME}, Паймон и Лоэн! Привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960304
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 700960304,
					"content": "Могучий древний дракон из Нод-Края... Паймон начинает понимать, в чём дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700960305,
					"content": "Анализирую ситуацию... Господин Лоэн хочет провести со мной тренировочный бой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960306
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 700960306,
					"content": "Одним словом, да. Именно на это я и надеялся. Во время экспедиции в Нод-Крае я и подумать не мог, что у тебя такое интересное прошлое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960307
					],
					"speakerTitle": "Лоэн"
				},
				{
					"id": 700960307,
					"content": "Но это всё неважно. Я давно хотел проверить свои силы в схватке с тобой... Что скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960308
					],
					"speakerTitle": "Лоэн"
				},
				{
					"id": 700960308,
					"content": "Хе-хе! Инеффа! Покажи ему, на что ты способна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960309
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 700960309,
					"content": "Приношу свои извинения. Согласно расписанию на сегодня, нам предстоит посетить Мондштадт, чтобы собрать особые компоненты. По моим оценкам, сражение с вами может повлиять на ход наших действий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960310
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 700960310,
					"content": "Точно... чуть не забыла. Мы слышали, что в Мондштадте появился какой-то гигантский робот... Вот почему мы здесь! Но потом я отвлеклась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960311
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 700960311,
					"content": "Понятно... Ладно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960312
					],
					"speakerTitle": "Лоэн"
				},
				{
					"id": 700960312,
					"content": "Лоэн... Неужели ты так просто сдашься?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700960313,
					"content": "Если я помогу вам разобраться со стражами руин, в вашем графике появится свободное время, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лоэн"
				}
			]
		},
