				]
			},
			"dialogs": [
				{
					"id": 740450201,
					"content": "Пука, а вот и мы! Держи свой «дар».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450202,
					"content": "Вы отдаёте Пуке «дар».",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "Ой, это он! Спасибо вам, спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450204,
					"content": "Пока мы искали «дар», нашли кое-что ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450205,
					"content": "Мы никогда прежде не встречали такую руду. Подумали, вдруг камешек ценный, и решили прихватить его с собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450206,
					"content": "Кажется, ты говорила, что часто собираешь в округе симпатичные камни. Наверное, знаешь, что это за руда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450207,
					"content": "Посмотрим... Да, красивый! Но никакой ценности он не представляет, это обычный камень...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450208,
					"content": "Да, в других местах вы такой руды не найдёте, но здесь, рядом с рудными жилами, похожих камней очень много!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450209,
					"content": "Значит, это обычный камень? А Паймон думала, мы нашли драгоценность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450210,
					"content": "Вряд ли он нам пригодится. Давай его куда-нибудь выбросим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450211,
					"content": "Но если в других местах мы такой руды не найдём...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "Ой, ты хочешь сказать, мы заработаем кучу моры, если попробуем её продать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450214,
					"content": "#Это мысль! Вряд ли кто-то ещё додумался отправиться в деревню мелюзин на поиски руды. Наверное, люди никогда не видели таких камней... Ты просто умница, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450215,
					"content": "Так, давай отнесём этот камень в Кур-де-Фонтейн и покажем местным торговцам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450216,
					"content": "Если у вас будут другие вопросы о руде, всегда рада помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450217,
					"content": "У меня нет своей мастерской, как у сестрицы, и я плохо разбираюсь в оценке и обработке камней...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450218,
					"content": "Мне нравится собирать не ценные, а интересные камни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450219,
					"content": "Поэтому я хорошо знаю местные рудные жилы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450220,
					"content": "Хорошо, спасибо тебе, Пука.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450212,
					"content": "Но если такая руда встречается только здесь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
