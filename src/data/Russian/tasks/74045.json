				]
			},
			"dialogs": [
				{
					"id": 740450401,
					"content": "Добро пожаловать! В нашем магазине представлен самый богатый в городе выбор драгоценных камней. Также у нас вы можете найти разнообразные изделия ручной работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450402
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450402,
					"content": "Что-нибудь заинтересовало? Или у вас особый запрос? Буду рад выслушать и помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450403
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450403,
					"content": "Мы принесли чудесную руду...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450404
					]
				},
				{
					"id": 740450404,
					"content": "Да! Если в твоём магазине такой богатый ассортимент, наверняка ты сможешь её оценить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450405,
					"content": "Ах, я понял! Вы хотите продать материал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450406
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450406,
					"content": "Вы обратились по адресу! Мы предлагаем самые честные цены во всём Фонтейне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450407
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450407,
					"content": "Давайте посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450408
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450408,
					"content": "Вы показываете Чесилу необычную руду, которую нашли в деревне мелюзин.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450409
					]
				},
				{
					"id": 740450409,
					"content": "О... Даже я не видел ничего подобного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450410
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450410,
					"content": "Изумительное сияние, глянцевая текстура... Вы нашли очень редкую руду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450411
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450411,
					"content": "Неловко спрашивать, но... позвольте узнать, что это за руда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450412,
						740450414,
						740450416
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450412,
					"content": "Понятия не имею.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450413
					]
				},
				{
					"id": 740450413,
					"content": "Поэтому вы и пришли сюда, чтобы провести оценку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450419,
					"content": "Как жаль, что вы принесли только один камень...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450420
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450420,
					"content": "Если организовать стабильные поставки такой руды... мы создадим украшения, которые покорят весь Фонтейн!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450421
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450421,
					"content": "(Пука говорила, что возле рудных жил таких камней очень много. Наверное, стоит спросить у неё...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450422,
						740450424,
						740450427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450422,
					"content": "У нас есть большой запас такой руды.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450423
					]
				},
				{
					"id": 740450423,
					"content": "Правда? Это просто чудесно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450430,
					"content": "Раз так, я готов купить у вас этот камень и все следующие партии. Запустим производство новых изделий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450431
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450431,
					"content": "А чтобы вы были уверены, что мне можно доверять, заплачу вам вперёд. Просто в следующий раз принесите побольше такой руды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450432
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450432,
					"content": "Что думаете? По-моему, я предлагаю честную сделку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450433
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450433,
					"content": "Хе-хе, Паймон согласна! По рукам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450434
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450434,
					"content": "Отлично, вот ваша мора...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450435
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450435,
					"content": "Интересно, какие украшения получатся из новой руды... Ха-ха, мне уже не терпится посмотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450436
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450436,
					"content": "Буду ждать вас здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450424,
					"content": "Но мы не можем сказать, где её добывают. Коммерческая тайна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450425
					]
				},
				{
					"id": 740450425,
					"content": "Да, конечно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450426
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450426,
					"content": "Но главное, что у вас есть налаженный канал поставки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450427,
					"content": "В окрестностях Элинаса таких камней полно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450428
					]
				},
				{
					"id": 740450428,
					"content": "#Эй! Ты зачем ему рассказал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450429
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450429,
					"content": "Значит, вы нашли её в окрестностях Элинаса? Да, никому не приходило в голову заняться там разведкой руды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740450414,
					"content": "Наверное, разновидность «паймонической руды»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450415
					]
				},
				{
					"id": 740450415,
					"content": "А? Что ещё за странное название?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450416,
					"content": "Конечно же, «сверкающее кристаллическое золото».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450417
					]
				},
				{
					"id": 740450417,
					"content": "#Ого, ты сейчас это придумал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450418,
					"content": "Какое интересное название! И выглядит ваша руда ему под стать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Чесил"
				}
			]
		},
