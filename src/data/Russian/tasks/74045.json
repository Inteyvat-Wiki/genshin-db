			"dialogs": [
				{
					"id": 740450101,
					"content": "Пука, что ты опять здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450102,
					"content": "Монстры в округе больше не появятся, но вдруг здесь есть другие опасности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450103,
					"content": "В общем, не стоит тебе убегать одной из деревни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450104,
					"content": "#{NICKNAME} и Паймон, я и не убегала... Я просто искала свой «дар»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450105
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450105,
					"content": "А? Ты потеряла свой «дар»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450106,
					"content": "Да... Он должен быть там, где я обычно собираю камни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450107
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450107,
					"content": "Гм... Может, он незаметно выпал, пока ты застряла в ловушке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450108,
					"content": "У-у-у... Да, наверное... Я очень испугалась и не заметила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450109
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450109,
					"content": "Даже вспоминать страшно, как я там застряла, но «дар» мне очень нужен. Я должна его отыскать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450110
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450110,
					"content": "Гм... Но отпускать тебя одну слишком опасно. Тогда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450111,
					"content": "#{NICKNAME}, может, мы сходим туда ещё раз и вернём Пуке её «дар»? Пука, иди домой и жди нас там!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450112,
						740450113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740450112,
					"content": "Запросто.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				},
				{
					"id": 740450114,
					"content": "#{NICKNAME}, Паймон, спасибо! Я буду сидеть дома и ждать вас, никуда не убегу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450113,
					"content": "#Я давно хотел{F#а} исследовать то место.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				}
			]
		},
		{
