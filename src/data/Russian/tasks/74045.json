			},
			"dialogs": [
				{
					"id": 740450601,
					"content": "Вот мы и встретились снова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450602
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450602,
					"content": "У вас появились вопросы о руде? Буду рада помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450603
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450603,
					"content": "Хотя не уверена, что смогу ответить на все вопросы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450604,
						740450607,
						740450609
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450604,
					"content": "Расскажи о драгоценных камнях...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450605
					]
				},
				{
					"id": 740450605,
					"content": "Возле местных рудных жил много красивых блестящих камней, но до настоящих драгоценностей им далеко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450606
					],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450606,
					"content": "Если бы я нашла настоящие драгоценные камни, открыла бы собственную мастерскую. Совсем как сестрица Слуази!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450607,
					"content": "Расскажи о применении руды...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450608
					]
				},
				{
					"id": 740450608,
					"content": "А? Я никогда не думала о её применении... Я собираю камни, потому что они красивые...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пука"
				},
				{
					"id": 740450609,
					"content": "У меня больше нет вопросов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450610
					]
				},
				{
					"id": 740450610,
					"content": "Хе-хе, спасибо, что заглянули!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пука"
				}
			]
		}
	]
