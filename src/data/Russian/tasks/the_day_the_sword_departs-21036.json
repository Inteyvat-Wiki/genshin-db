				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360401,
					"content": "Уф... Это и правда было непросто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360402
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360402,
					"content": "Извини... Только выставил себя дураком. Кажется, я не сильно продвинулся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360403
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360403,
					"content": "#Мне нужно ещё тренироваться... Спасибо, путешественни{F#ца}{M#к}! Вот твоё вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360404
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360404,
					"content": "На чём ты решил уехать из Ли Юэ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360405
					]
				},
				{
					"id": 210360405,
					"content": "Я... Думаю, что отправлюсь в путешествие по воде на торговом корабле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360406
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360406,
					"content": "Что же до первого пункта назначения... Для начала я хочу отправиться в Фонтейн, побыть там немного, а потом уже решить, что делать дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360407
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360407,
					"content": "Ох, не знаю, смогу ли уговорить Цю Эр поехать со мной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				}
			]
		},
		{
			"id": 2103605,
			"completionStepIds": [
				2103605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2103605",
							"2"
						],
						"stepId": 2103605,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2103601",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360501,
					"content": "Уф... уф... уф... Как... Как ты так быстро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360502,
						210360504
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360502,
					"content": "Это ты бежишь слишком медленно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360503
					]
				},
				{
					"id": 210360503,
					"content": "Я восхищён... Я восхищён!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360506,
					"content": "#Спасибо тебе, путешественни{F#ца}{M#к}, за тренировку! Прими это в качестве моей благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360507,
						210360510
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360507,
					"content": "Как дела у Цю Эр?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360508
					]
				},
				{
					"id": 210360508,
					"content": "Эх, продолжает меня игнорировать. Я, я не знаю, как с ней поговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360509
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360509,
					"content": "Ох... Почему же это стало такой проблемой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360510,
					"content": "Расскажи об искательнице приключений...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360511
					]
				},
				{
					"id": 210360511,
					"content": "О ней? Гм... Я её встретил в Гильдии искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360512
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360512,
					"content": "Она сказала, что едет в Разлом по поручению гильдии. Услышав, что я хочу присоединиться, она и меня пригласила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360513
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360513,
					"content": "Но взамен... Я должен помогать ей с поручением. В основном нужно искать предметы, это совсем не сложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360514
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360514,
					"content": "Вот только она... очень болтливая. Я не знал, что делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360504,
					"content": "А тебе нужно продолжать тренироваться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360505
					]
				},
				{
					"id": 210360505,
