			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360201,
					"content": "Противостояние противнику.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360202
					]
				},
				{
					"id": 210360202,
					"content": "Хорошо! Я давно хотел применить на деле свои навыки фехтования...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360203
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360203,
					"content": "Только боюсь, что ты не успеешь разглядеть мои движения.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360204
					]
				},
				{
					"id": 210360204,
					"content": "П-правда? Ха-ха-ха, тогда мне придётся просить тебя ещё об одном одолжении: действуй не так быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360205
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360205,
					"content": "Давай посмотрим... Поблизости есть одно местечко, где собралось много монстров. Давай пойдём туда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				}
			]
		},
		{
			"id": 2103603,
			"completionStepIds": [
				2103601,
				2103606
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
