						],
						"stepId": 2103601,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2103602",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360301,
					"content": "Ориентирование на местности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360302
					]
				},
				{
					"id": 210360302,
					"content": "Отлично! Искательница приключений помогла мне проложить маршрут для ориентирования... Ох, я здесь тренируюсь именно благодаря ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360303
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360303,
					"content": "Она говорит, что нужно просто как можно скорее добраться до финиша... Но, кажется, я каждый раз трачу слишком много времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360304
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360304,
					"content": "Поэтому хочу попросить тебя мне показать, как быстро двигаться по маршруту. А я буду следовать сзади.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360305,
						210360306
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360305,
					"content": "Разумеется.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360308
					]
				},
				{
					"id": 210360308,
					"content": "Но спасибо тебе. Пойдём к месту тренировки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210360306,
					"content": "Постарайся не отстать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360307
					]
				},
				{
					"id": 210360307,
					"content": "Хм... Я... Буду стараться. По правде говоря, я не лучший бегун...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360308
					],
					"speakerTitle": "Сунь Юй"
				}
			]
		},
		{
			"id": 2103604,
			"completionStepIds": [
				2103604
			],
