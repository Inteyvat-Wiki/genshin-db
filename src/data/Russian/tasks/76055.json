			},
			"dialogs": [
				{
					"id": 760550101,
					"content": "(<color=#FFCC33FF>Лаума</color>, кажется, что-то услышала...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760550102
					]
				},
				{
					"id": 760550102,
					"content": "...Странно. Я сейчас слышала звуки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550103
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760550103,
					"content": "(Гости! Сюда, сюда! Вращайте колесо, потом остановите колесо, и будут вкусняшки!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550104
					],
					"speakerTitle": "Павлов"
				},
				{
					"id": 760550104,
					"content": "(Э? Почему не вращаете колесо? Давайте, вперёд! Вкусняшки ждут!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550105
					],
					"speakerTitle": "Павлов"
				},
				{
					"id": 760550105,
					"content": "Похоже... будто говорит какой-то щеночек. Вращайте колесо, будут вкусняшки... Что это всё значит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550106
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760550106,
					"content": "(Гости! Это я! Давайте, вперёд! Вращайте колесо! Иначе я останусь без вкусняшек!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550107
					],
					"speakerTitle": "Павлов"
				},
				{
					"id": 760550107,
					"content": "Ты голоден? У меня есть печенье. Вот, держи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550108
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760550108,
					"content": "(Мм? Ты не хочешь вращать колесо? Но даёшь мне еду... Ладно, поем, потом разберёмся.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550109
					],
					"speakerTitle": "Павлов"
				},
				{
					"id": 760550109,
					"content": "(Спасибо, гостья. Зови меня Павлов. Спасибо за печенье, было очень-очень вкусно! Но ты не стала вращать колесо.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550110
					],
					"speakerTitle": "Павлов"
				},
				{
					"id": 760550110,
					"content": "Пожалуйста... Но что ты имеешь в виду, когда просишь меня вращать колесо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550111
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760550111,
					"content": "(Если колесо повернётся, а потом остановится, оттуда выпадет вкусняшка. Так всегда бывает.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550112
					],
					"speakerTitle": "Павлов"
				},
				{
					"id": 760550112,
					"content": "(Гостья, тебе не хочется повернуть колесо? Все очень радуются, когда вращают колесо!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550113
					],
					"speakerTitle": "Павлов"
				},
				{
					"id": 760550113,
					"content": "Нет, спасибо. Похоже... тебе здесь неплохо живётся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550114
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760550114,
					"content": "(Хорошо живётся, очень хорошо! Со мной играют люди, со мной играет колесо, у меня есть вкусняшки!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550115
					],
					"speakerTitle": "Павлов"
				},
				{
					"id": 760550115,
					"content": "Вот и отлично. Передавай привет своему хозяину. Мне пора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550116
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760550116,
					"content": "(Пока, гостья! Приходи ещё!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Павлов"
				}
			]
		},
