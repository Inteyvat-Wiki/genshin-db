					"Манку"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750190601,
					"content": "#Скажу прямо... Я понимаю, какой силой обладает {NICKNAME}, но прошу минуточку внимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750190602,
					"content": "Пускай Пакалю не удалось получить древнее имя, но нельзя недооценивать его силу... если за последние годы он не забросил свои тренировки, конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750190603,
					"content": "Если вы готовы к сражению, можно начинать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Манку"
				}
			]
		},
		{
