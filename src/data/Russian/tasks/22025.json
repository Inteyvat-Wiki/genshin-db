			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тан Вэнь",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250101,
					"content": "Ах... Я так голодна... Мне нехорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250102
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220250102,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250103
					]
				},
				{
					"id": 220250103,
					"content": "Я не уверена... Чувствую себя очень вялой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250104
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220250104,
					"content": "#Наверное, это результат вчерашнего вечера, когда я принесла домой и съела то изысканное блюдо, которое ты приготовил{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250105
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220250105,
					"content": "Хотя то блюдо оказалось... довольно необычным, но оно, по крайней мере, было достаточно питательным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250106
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220250106,
					"content": "Затем я хотела хорошенько выспаться и также хорошенько поработать сегодня, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250107
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220250107,
					"content": "Каждый раз, когда я собиралась заснуть, интересный запах того блюда внезапно всплывал из недр моего желудка! Что мгновенно будило меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250108
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220250108,
					"content": "Это продолжалось по кругу и я провалялась в подобном полусонном состоянии прям до рассвета...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250109
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220250109,
					"content": "Ничего страшного, если просто приходится меньше спать. В прошлом мне иногда доводилось работать сверхурочно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250110
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220250110,
					"content": "Главное - это то, что произошло сегодня! Я думала, что буду в порядке после того, как встану и что-нибудь съем, но я не ожидала, что даже когда я съела кое-что другое, вкус вчерашнего блюда все еще остаётся во рту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250111
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220250111,
					"content": "То блюдо взаправду оказалось таким интенсивным?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250112
					]
				},
				{
					"id": 220250112,
					"content": "Ах, я думаю... только блюдо с не менее уникальным вкусом может избавить меня от этого интересного послевкусия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250113
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220250113,
					"content": "Блюдо с уникальным вкусом? Почему бы нам не пройтись по округе и не спросить у людей, знают ли они такое блюдо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220250114,
					"content": "Тогда мы можем приготовить одно для мисс Тан Вэнь... Может быть, это решит её проблему!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220250115,
					"content": "Правда? Это замечательно, огромное вам спасибо! Если это вас не затруднит, вы не могли бы отправиться на остров Рито и спросить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250116
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220250116,
					"content": "Я помню... Ли Сяо, торговец с острова Рито, очень хорошо разбирается в еде, и Цю Юэ из торговой компании «Чуюй» - её тоже можно считать гурманом-любителем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тан Вэнь"
				}
			]
		},
		{
			"id": 2202502,
			"completionStepIds": [
				2202502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
