				"points": []
			},
			"dialogs": [
				{
					"id": 745230401,
					"content": "В этом ветре... чувствуется солёный вкус прилива, древесный запах далёких торговых кораблей и... ещё ветер приносит вести о старых друзьях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230402
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 745230402,
					"content": "#Сколько лет, сколько зим, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230403,
						745230404
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 745230403,
					"content": "Давно не виделись, Кадзуха.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				},
				{
					"id": 745230405,
					"content": "Флот Южного Креста остановился в Инадзуме для пополнения припасов. Раз уж меня занесло в родные края, я решил пройтись и взглянуть на знакомые пейзажи, да вновь послушать шёпот здешних ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230406
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 745230406,
					"content": "Ветра на острове Рито шумнее, чем где бы то ни было. В них слышны отголоски расставаний и встреч, надежд и сомнений... Эти места полны историй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230407,
						745230408
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 745230407,
					"content": "Можно тебя сфотографировать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230409,
					"content": "Всё в мире имеет форму, и ветер не исключение. Его облик можно увидеть в падающих листьях, в поднимающихся волнах или в развевающихся полах одеяния путешественника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230410
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 745230410,
					"content": "Надеюсь, моё присутствие поможет тебе уловить этот мимолётный облик ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230411,
						745230412
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 745230411,
					"content": "Тогда я начинаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230413,
					"content": "Ты точно сможешь запечатлеть поэзию этого мгновения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 745230412,
					"content": "Не уходи и слушай ветер, как раньше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230408,
					"content": "Хочется сохранить в памяти эти ветра.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230404,
					"content": "Откуда ты здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				}
			]
		}
	]
