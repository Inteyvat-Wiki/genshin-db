				"points": []
			},
			"dialogs": [
				{
					"id": 718140401,
					"content": "Привет. Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140402
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 718140402,
					"content": "#Я наш{F#ла}{M#ёл} в море это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140403
					]
				},
				{
					"id": 718140403,
					"content": "Хм? Позволь мне взглянуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140404
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 718140404,
					"content": "Верно, эта коробка действительно из Нефритового дворца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140405
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 718140405,
					"content": "Но что это такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140406
					]
				},
				{
					"id": 718140406,
					"content": "В этой коробке лежат несколько бумаг и приказов, которые ещё предстоит рассмотреть. Удивительно, что они смогли так хорошо сохраниться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140407
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 718140407,
					"content": "Тем не менее твоя находка сэкономит нам немного работы. На устранение последствий падения Нефритового дворца уходит уйма времени и усилий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140408
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 718140408,
					"content": "#Спасибо, что прин{F#есла}{M#ёс} её мне. Вот, прими это в знак благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бай Вэнь"
				}
			]
		},
