			"dialogs": [
				{
					"id": 752750201,
					"content": "(Старинная каменная табличка, надпись на ней практически стёрлась...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752750202
					],
					"speakerTitle": "Каменная табличка"
				},
				{
					"id": 752750202,
					"content": "...Кионгози ушёл более десяти лет назад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752750203
					],
					"speakerTitle": "Каменная табличка"
				},
				{
					"id": 752750203,
					"content": "...великая победа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752750204
					],
					"speakerTitle": "Каменная табличка"
				},
				{
					"id": 752750204,
					"content": "...Постройте алтарь... для утешения духов павших...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каменная табличка"
				}
			]
		},
