			"dialogs": [
				{
					"id": 730220101,
					"content": "Привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220102,
					"content": "Хр-р-р... Хр-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220103
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220103,
					"content": "Эй! Привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220104,
					"content": "Ммм... Вкусный плод. Хр-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220105
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220105,
					"content": "Уф, кажется он крепко спит. Точно... По словам Арапакати, нужно использовать <color=#00E1FFFF>силу Дендро</color>, чтобы он очнулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220106,
					"content": "#{NICKNAME}, Паймон с этим справится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7302202,
			"completionStepIds": [
				7302207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302207",
							"2"
						],
						"stepId": 7302207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"73022"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Арафала"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220201,
					"content": "А? Это вы! Давно не виделись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220202
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220202,
					"content": "Ого, где это я? В какой-то пещере? Уф... голова кружится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220203
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220203,
					"content": "А ты кто? Почему здесь спишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220204,
					"content": "Я... Уф, голова кружится. Дайте-ка подумать... Меня зовут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220205
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220205,
					"content": "Меня зовут Арафала! Ха, вспомнил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220206
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220206,
					"content": "Так ты Арафала! Мы тебя повсюду ищем, а ты дрыхнешь в этой пещере.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220207,
					"content": "Арафала... Откуда вы знаете моё имя?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220208
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220208,
					"content": "А? Нары?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220209
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220209,
					"content": "Ну, теперь он полностью проснулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220210,
					"content": "Это точно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220211
					]
				},
				{
					"id": 730220211,
					"content": "У-у-у, я не готов. Не делайте из меня кашу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220212
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220212,
					"content": "Что? Да кому нужно делать из тебя кашу?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220213,
					"content": "М-моя сестрёнка всегда говорит, что если я буду вот так вот засыпать, то придут плохие нары и сделают из меня кашу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220214,
						730220217
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220214,
					"content": "А ты вкусный на вид!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220215
					]
				},
				{
					"id": 730220215,
					"content": "А-а-а!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220216
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220216,
					"content": "#Эй! {NICKNAME}, не шути так! Арафала, никто не будет делать из тебя кашу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220218,
					"content": "...Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220219
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220219,
					"content": "Правда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220220,
					"content": "Правда-правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220221
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220221,
					"content": "#Мы тебя не обманываем. Паймон зовут Паймон, а эт{F#а}{M#от} высок{F#ая}{M#ий} нара - {NICKNAME}. Арапакати попросила найти тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220222,
					"content": "Арапакати? Она в порядке? Я так долго здесь пробыл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220223
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220223,
					"content": "Как долго? Паймон думает, примерно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220224,
					"content": "Дай-ка подумать... Много-много лун назад ростки показались из земли и превратились в большие деревья. Во сколько раз они были выше Арапакати?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220225,
						730220227
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220225,
					"content": "В семь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220226
					]
				},
				{
					"id": 730220226,
					"content": "#Ого! У тебя превосходная память, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220229,
					"content": "Ох, как много времени прошло. Вот беда-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220230
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220230,
					"content": "В общем, скоро начнётся Праздник Утсава...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220231,
					"content": "Вы объясняете ситуацию Арафале.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220232
					]
				},
				{
					"id": 730220232,
					"content": "А? Неужто справлять решили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220233
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220233,
					"content": "Да, и Арапакати хочет, чтобы ты вернулся в Ванарану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220234
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220234,
					"content": "Ох... Но ведь я ещё не завершил свои кулинарные практики...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220235
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220235,
					"content": "Да? Но ты же спал, вот Паймон и подумала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220236
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220236,
					"content": "Спал? Нет, я просто размышлял о прошлом. И вовсе не спал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220237
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220237,
					"content": "Кажется, сон для аранар особенно важен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220238,
					"content": "Хм... Как бы вам объяснить... Мы впадаем в спячку, когда нам угрожает опасность. А потом вся наша память и все наши мечты сжимаются в семечко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220239
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220239,
					"content": "Когда опасность минует и наступит подходящее время, семечко возвращается в лес и из него вырастет новый аранара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220240,
						730220241,
						730220242
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220240,
					"content": "Звучит жестоко...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220244,
					"content": "#Но я знаю, что нарам нужно спать. У меня был друг нара. Так{F#ой}{M#ая} же золот{F#ой}{M#ая}, как ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220245
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220245,
					"content": "#Раньше мы с {F#ней}{M#ним} приходили сюда и срывали «непревзойдённые свежие плоды».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220246
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220246,
					"content": "#С тех пор я их тут и срываю. Если {F#она}{M#он} вернётся или я встречу нового друга нару, мы сможем отведать их вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220247
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220247,
					"content": "В этот раз я нарвал очень много плодов... Ой, а куда они делись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220248
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220248,
					"content": "Так это ты раскидал закатники по дороге?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220249
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220249,
					"content": "Я так много уронил?.. Ну ничего. Хе-хе, самые вкусные и свежие всё равно остались у меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220250
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220250,
					"content": "Уф... Но как же я так много потерял?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220251
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220251,
					"content": "Я помню, как я отправлялся с братьями попрактиковаться в кулинарии, но они так и не поняли, что свежие плоды - лучшие ингредиенты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220252
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220252,
					"content": "Но пока я их собирал... Да, точно, когда я их собирал, появился огромный-преогромный монстр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220253
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220253,
					"content": "Этот огромный монстр был в пять раз больше Арафалы и с очень длинным хвостом. Даже земля дрожала под его ногами. А ещё у него была аура Мараны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220254
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220254,
					"content": "А ещё он был такой твёрдый, что даже Араме и Арабалике не так-то просто было бы разорвать его на части.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220255
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220255,
					"content": "Что? Они такие сильные?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220256
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220256,
					"content": "Да, но я не такой сильный. Так что мне пришлось спрятаться здесь. Я думал о прошлом, пока ждал, когда он уйдёт. А потом увидел вас передо мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220257
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220257,
					"content": "Кстати, по дороге сюда мы видели дракона руин. Это и есть твой монстр?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220258
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220258,
					"content": "Его так нары называют?.. Наверное, это был он.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220259,
						730220260
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220259,
					"content": "Мы с ним справились.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220264
					]
				},
				{
					"id": 730220264,
					"content": "#Ого! Нара {NICKNAME} ведь куда меньше того монстра, а так{F#ая}{M#ой} {F#сильная}{M#сильный}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220265
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220265,
					"content": "Хм, тогда пойдёмте. Хорошие нары, пойдёмте есть плоды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220260,
					"content": "Ой, этот огромный монстр такой страшный!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220261
					]
				},
				{
					"id": 730220261,
					"content": "Такой уж страшный?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220262
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220262,
					"content": "Да. Похоже, даже нара понимает, какой он был страшный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220263
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220263,
					"content": "#Не переживай! {NICKNAME} справил{F#ась}{M#ся} с этим монстром ещё до встречи с тобой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220264
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220241,
					"content": "Звучит удобно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220242,
					"content": "Паймон, а ты можешь стать семечком?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220243
					]
				},
				{
					"id": 730220243,
					"content": "Эй! А такая Паймон чем тебе не угодила?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220244
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220227,
					"content": "Это у Паймон превосходная память.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220228
					]
				},
				{
					"id": 730220228,
					"content": "Хи-хи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220217,
					"content": "Да, никто не будет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220218
					]
				}
			]
		},
		{
			"id": 7302203,
			"completionStepIds": [
				7302207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302207",
							"2"
						],
						"stepId": 7302207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"0",
							"73022"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Арафала"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220301,
					"content": "А, это вы! Давно не виделись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220302
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220302,
					"content": "Ого, где это я? В какой-то пещере? Уф... голова кружится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220303
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220303,
					"content": "А ты кто? Почему здесь спишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220304,
					"content": "Я... Уф, голова кружится. Дайте-ка подумать... Меня зовут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220305
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220305,
					"content": "Меня зовут Арафала! Ха, вспомнил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220306
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220306,
					"content": "Так ты Арафала! Мы тебя повсюду ищем, а ты дрыхнешь в этой пещере.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220307,
					"content": "Арафала... Откуда вы знаете моё имя?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220308
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220308,
					"content": "А? Нары?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220309
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220309,
					"content": "Ну, теперь он полностью проснулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220310,
					"content": "Это точно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220311
					]
				},
				{
					"id": 730220311,
					"content": "У-у-у, я не готов. Не делайте из меня кашу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220312
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220312,
					"content": "Что? Да кому нужно делать из тебя кашу?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220313,
					"content": "М-моя сестрёнка всегда говорит, что если я буду вот так вот засыпать, то придут плохие нары и сделают из меня кашу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220314,
						730220317
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220314,
					"content": "А ты вкусный на вид!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220315
					]
				},
				{
					"id": 730220315,
					"content": "А-а-а!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220316
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220316,
					"content": "#Эй! {NICKNAME}, не шути так! Арафала, никто не будет делать из тебя кашу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220318,
					"content": "...Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220319
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220319,
					"content": "Правда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220320,
					"content": "Правда-правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220321
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220321,
					"content": "#Мы тебя не обманываем. Паймон зовут Паймон, а эт{F#а}{M#от} высок{F#ая}{M#ий} нара - {NICKNAME}. Арапакати попросила найти тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220322,
					"content": "Арапакати? Она в порядке? Я так долго здесь пробыл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220323
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220323,
					"content": "Как долго? Паймон думает, примерно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220324,
					"content": "Дай-ка подумать... Много-много лун назад ростки показались из земли и превратились в большие деревья. Во сколько раз они были выше Арапакати?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220325,
						730220327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220325,
					"content": "В семь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220326
					]
				},
				{
					"id": 730220326,
					"content": "#Ого! У тебя превосходная память, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220329,
					"content": "Ох, как много времени прошло. Вот беда-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220330
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220330,
					"content": "В общем, скоро начнётся Праздник Утсава...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220331
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220331,
					"content": "Вы объясняете ситуацию Арафале.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220332
					]
				},
				{
					"id": 730220332,
					"content": "А? Неужто справлять решили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220333
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220333,
					"content": "Да, и Арапакати хочет, чтобы ты вернулся в Ванарану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220334
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220334,
					"content": "Ох... Но ведь я ещё не завершил свои кулинарные практики...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220335
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220335,
					"content": "Да? Но ты же спал, вот Паймон и подумала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220336
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220336,
					"content": "Спал? Нет, я просто размышлял о прошлом. И вовсе не спал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220337
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220337,
					"content": "Кажется, сон для аранар особенно важен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220338
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220338,
					"content": "Хм... Как бы вам объяснить... Мы впадаем в спячку, когда нам угрожает опасность. А потом вся наша память и все наши мечты сжимаются в семечко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220339
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220339,
					"content": "Когда опасность минует и наступит подходящее время, семечко возвращается в лес и из него вырастет новый аранара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220340,
						730220341,
						730220342
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220340,
					"content": "Звучит жестоко...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220344,
					"content": "#Но я знаю, что нарам нужно спать. У меня был друг нара. Так{F#ой}{M#ая} же золот{F#ой}{M#ая}, как ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220345
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220345,
					"content": "#Раньше мы с {F#ней}{M#ним} приходили сюда и срывали «непревзойдённые свежие плоды».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220346
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220346,
					"content": "#С тех пор я их тут и срываю. Если {F#она}{M#он} вернётся или я встречу нового друга нару, мы сможем отведать их вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220347
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220347,
					"content": "В этот раз я нарвал очень много плодов... Ой, а куда они делись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220348
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220348,
					"content": "Так это ты раскидал закатники по дороге?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220349
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220349,
					"content": "Я так много уронил?.. Ну ничего. Хе-хе, самые вкусные и свежие всё равно остались у меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220350
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220350,
					"content": "Уф... Но как же я так много потерял?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220351
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220351,
					"content": "Я помню, как я отправлялся с братьями попрактиковаться в кулинарии, но они так и не поняли, что свежие плоды - лучшие ингредиенты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220352
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220352,
					"content": "Но пока я их собирал... Да, точно, когда я их собирал, появился огромный-преогромный монстр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220353
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220353,
					"content": "Этот огромный монстр был в пять раз больше Арафалы и с очень длинным хвостом. Даже земля дрожала под его ногами. А ещё у него была аура Мараны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220354
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220354,
					"content": "А ещё он был такой твёрдый, что даже Араме и Арабалике не так-то просто было бы разорвать его на части.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220355
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220355,
					"content": "Что? Они такие сильные?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220356
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220356,
					"content": "Да, но я не такой сильный. Так что мне пришлось спрятаться здесь. Я думал о прошлом, пока ждал, когда он уйдёт. А потом увидел вас передо мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220357
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220357,
					"content": "Пока там бродит этот жуткий громадный монстр, я никуда не пойду. Прости, сестрёнка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220358
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220358,
					"content": "Ты что! Скоро же начнётся Праздник Утсава. Нельзя тебе его пропускать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220359
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220359,
					"content": "Но если я выйду из этой пещеры, мне нужно будет заботиться о своей безопасности. А ведь на Празднике Утсава не должно быть никаких забот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220360
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220360,
					"content": "Ох-ох... Нара Варуна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220361
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220361,
					"content": "Эй, он...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220362
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220362,
					"content": "#{NICKNAME}, что же нам делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220363,
						730220364
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220363,
					"content": "Покончим с этим монстром.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220365,
					"content": "Но с Ужасом Бури всё равно не сравнится. Интересно, какое было бы лицо у аранар, если бы они его повстречали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220366
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220366,
					"content": "«Размером с миллион Арафал!»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220367
					]
				},
				{
					"id": 730220367,
					"content": "«А туловище такое длинное, что вмещает в себя всю траекторию движения луны!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220368
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220368,
					"content": "Давай прогоним этого монстра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220364,
					"content": "Ой, этот огромный монстр такой страшный!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220341,
					"content": "Звучит удобно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220342,
					"content": "Паймон, а ты можешь стать семечком?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220343
					]
				},
				{
					"id": 730220343,
					"content": "Эй! А такая Паймон чем тебе не угодила?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220344
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220327,
					"content": "Это у Паймон превосходная память.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220328
					]
				},
				{
					"id": 730220328,
					"content": "Хи-хи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220317,
					"content": "Да, никто не будет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220318
					]
				}
			]
		},
		{
			"id": 7302204,
