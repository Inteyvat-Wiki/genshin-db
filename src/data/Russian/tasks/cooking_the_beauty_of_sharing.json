			},
			"dialogs": [
				{
					"id": 730220401,
					"content": "Ох-ох-ох... Когда же я смогу вернуться?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220402
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220402,
					"content": "(Сперва нужно избавиться от огромного монстра, а затем вернуться к нему...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7302205,
			"completionStepIds": [
				7302209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302209",
							"2"
						],
						"stepId": 7302209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арафала",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220501,
					"content": "Хр-р... Хр-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220502
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220502,
					"content": "Арафала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220503,
					"content": "А? Это ты, Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220504
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220504,
					"content": "#Агась! Мы с хорошими новостями. {NICKNAME} прогнал{F#а} того огромного монстра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220505,
					"content": "#Ого! Нара {NICKNAME} ведь куда меньше того монстра, а так{F#ая}{M#ой} {F#сильная}{M#сильный}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220506,
						730220507
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220506,
					"content": "Пара пустяков.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				},
				{
					"id": 730220508,
					"content": "Хм, тогда пойдёмте. Хорошие нары, пойдёмте есть плоды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220507,
					"content": "Было трудно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				}
			]
		},
		{
			"id": 7302206,
			"completionStepIds": [
				7302204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302204",
							"2"
						],
						"stepId": 7302204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арафала",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220601,
					"content": "Пора бы уже и из «непревзойдённого свежего плода» что-нибудь приготовить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220602
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220602,
					"content": "А в чём вообще разница между обычными плодами и... «непревзойдёнными»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220603,
					"content": "Ну конечно. Для вас, нар, все плоды одинаковые. Но на самом деле это не так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220604
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220604,
					"content": "«Непревзойдённые свежие плоды» растут только на крепких деревьях. Как подует ветер, так они сразу же начинают петь. Самыми первыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220605
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220605,
					"content": "Всё, что рождается под покровом крепких деревьев, - настоящий дар для нас. То же касается и «непревзойдённых свежих плодов». По словам моего друга нары, вкус их так же сладок, как прекрасное пение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220606
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220606,
					"content": "Это какая же тогда вкуснятина получится, ммм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220607,
					"content": "Арафала начал готовить...\\nОн разделил лежащий в руке фрукт на несколько частей...\\nЗатем Арафала протянул вам несколько кусочков на пробу.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220608
					]
				},
				{
					"id": 730220608,
					"content": "Вы попробовали непревзойдённый свежий фрукт.\\nВаши ожидания оправдались в полной мере. Он и правда оказался невероятно свежим на вкус.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220609
					]
				},
				{
					"id": 730220609,
					"content": "Вкусно. Благодарю тебя, крепкое древо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220610
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220610,
					"content": "Погоди, и это что, вся готовка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220611,
					"content": "«Непревзойдённые свежие плоды» уже сами по себе являются «величайшим лакомством». Вкус их и так идеален. Вот и лишние телодвижения ни к чему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220612
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220612,
					"content": "Словами этого не описать. Просто попробуйте, и сразу всё поймёте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220613
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220613,
					"content": "Какая вкуснятина. Паймон будто... будто фруктом лакомится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220614,
					"content": "Так это и есть фрукт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220615
					]
				},
				{
					"id": 730220615,
					"content": "Это точно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220616
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220616,
					"content": "Разве у вас, нар, нет такого блюда? Нарезанные фрукты кладут на тарелку, а потом ставят на деревянные доски?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220617
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220617,
					"content": "У нас есть такое блюдо? А, подожди-ка! Ты говоришь о фруктовой нарезке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220618,
					"content": "Разве её можно считать «блюдом»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220619,
						730220621
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220619,
					"content": "Наверное, можно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220620
					]
				},
				{
					"id": 730220620,
					"content": "Паймон кажется, что это странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220623,
					"content": "К чему такая дотошность? Поиск новых ингредиентов - это тоже своего рода кулинарное искусство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220624
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220624,
					"content": "Такое занятие помогает сблизиться с лесом, обойти каждый его уголок. В этом и есть истинный смысл кулинарной практики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220625
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220625,
					"content": "Вот как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220626
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220626,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220627
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220627,
					"content": "Раз уж я сорвал «непревзойдённый свежий плод» и приготовил из него «величайшее лакомство», сегодняшняя кулинарная практика завершена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220628
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220628,
					"content": "Теперь можно со спокойной душой возвращаться в Ванарану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220629
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220629,
					"content": "#Если бы не нара {NICKNAME} и Паймон, я бы так и остался сидеть в той пещере вместе с монстром неподалёку. Пропустил бы весь Праздник Утсава.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220630
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220630,
					"content": "Ну, тогда в путь! В Ванарану!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220631
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730220631,
					"content": "А если бы я пропустил Праздник Утсава, сестрёнка бы мне такую головомойку устроила... Даже думать об этом страшно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730220621,
					"content": "Вряд ли...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220622
					]
				},
				{
					"id": 730220622,
					"content": "Она ведь даже не прошла эту... как её... термическую обработку! Странно называть её «блюдом».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "Паймон"
				}
			]
		},
