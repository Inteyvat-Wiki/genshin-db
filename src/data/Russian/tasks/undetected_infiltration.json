			]
		},
		{
			"id": 7105407,
			"completionStepIds": [
				7105413
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105413",
							"2"
						],
						"stepId": 7105413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Янь Бо",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540701,
					"content": "Отличная работа! Спасибо за помощь, и, кстати, вот обещанное вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540702
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540702,
					"content": "Вот это да! Сколько моры! Когда вы успели переодеться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540723
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540723,
					"content": "Когда вы сражаетесь... Неважно... Нам нужно было переодеться в форму на случай, если вы по ошибке примете нас за других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540703
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540703,
					"content": "Миллелиты в неоплатном долгу перед вами! В соответствии с нашим соглашением вы можете осмотреться и взять понравившееся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540704
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540704,
					"content": "Разумеется, кроме контрабанды, которую мы опечатаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540705,
						710540707
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540705,
					"content": "Поздравляю с успешным выполнением задания!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540706
					]
				},
				{
					"id": 710540706,
					"content": "Ха-ха, без вашей помощи всё прошло бы не так гладко. Спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540709,
					"content": "Я хотел сказать... просто не уподобляйтесь этим мелким воришкам и не ищите лёгких путей. Тогда мы не будем вас преследовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540710
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540710,
					"content": "Мы вовсе не такие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540711
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540711,
					"content": "Ха-ха, разумеется...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540712
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540712,
					"content": "#Ты {F#способна}{M#способен} использовать силу элементов. С такой силой нужно считаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540713
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540713,
					"content": "На выполнение задания у нас могут уйти недели, а то и месяцы, а вы справляетесь с ним значительно быстрее... Если элементальные силы использовать во зло, они могут с лёгкостью вызвать ужасающие разрушения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540714
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540714,
					"content": "Поэтому я считаю, что отсутствие Глаза Бога не так уж и плохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540715
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540715,
					"content": "Я видел тех, кто готов был расстаться с жизнью в погоне за нечеловеческими способностями только для того, чтобы в итоге стать марионеткой в чужих руках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540716
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540716,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540717
					]
				},
				{
					"id": 710540717,
					"content": "В мире намного больше обычных людей, у которых нет Глаза Бога, а те, кто действительно может их понять и защитить, в большинстве своём такие же обычные люди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540718
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540718,
					"content": "Для меня большая честь выполнять свой долг по защите обычных людей, ведь я и сам обычный человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540719
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540719,
					"content": "Если в один прекрасный день никто не удостоится Глаза Бога или Адепты, охраняющие Ли Юэ, покинут нас... я не откажусь от своей обязанности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540720
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540720,
					"content": "Простите, я увлёкся разговором с самим собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540721
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540721,
					"content": "Нам ещё нужно проверить и запротоколировать контрабанду, поэтому буду краток.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540722
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540722,
					"content": "От имени моих сослуживцев я ещё раз благодарю вас за помощь и желаю вам успехов на вашем дальнейшем пути. Пока Миллелиты на страже города, у зла нет шансов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Янь Бо"
				},
				{
