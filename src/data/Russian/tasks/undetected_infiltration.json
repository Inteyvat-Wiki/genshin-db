					"content": "Я предлагаю вам для начала зачистить <color=#00E1FFFF>продовольственный лагерь</color>.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540302
					]
				},
				{
					"id": 710540302,
					"content": "Хорошо, мы изымем их продовольствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Янь Бо"
				}
			]
