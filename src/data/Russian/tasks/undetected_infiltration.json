					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Янь Бо",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540101,
					"content": "Не надо! Остановись! Пожалуйста, позволь нам всё объяснить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540102
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540102,
					"content": "Вы Похитители сокровищ. Сдавайтесь! Не нужны нам ваши объяснения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540103,
					"content": "#Миллелиты, административный район Разлома, командир отряда Янь Бо. Рад увидеть тебя воочию, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540104
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540104,
					"content": "И тебя, знаменитая летающая героиня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540105
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540105,
					"content": "Меня зовут Паймон! Пора бы уже запомнить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540106,
					"content": "Ха-ха... прощу прощения, виноват! Боюсь, произошло небольшое недопонимание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540107,
						710540109
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540107,
					"content": "Так вы не Похитители сокровищ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540108
					]
				},
				{
					"id": 710540108,
					"content": "Как раз наоборот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540112,
					"content": "Скажем так. Эта мастерская действительно была опорным пунктом Похитителей сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540113
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540113,
					"content": "После того как рабочие покинули это место, эти парни любыми способами старались просочиться сюда. Сначала просто воровали руду и кристаллы глазурного песка для контрабанды и играли в прятки с нашими патрулями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540114
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540114,
					"content": "Затем они осмелели настолько, что заняли старые склады, оставшиеся от шахтёров, и начали делать дешёвые украшения на продажу! На это больно смотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540115
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540115,
					"content": "Больно смотреть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540116
					]
				},
				{
					"id": 710540116,
					"content": "Такими некачественными украшениями можно обмануть только доверчивых туристов, которые никогда не были в Ли Юэ, или людей, которые черпают знания из книг, но на самом деле плохо разбираются в вещах... Хотят завоевать рынок Ли Юэ, продавая вещи по низкой цене? Пришло время положить конец их торговой марке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540117
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540117,
					"content": "Вряд ли у них вообще когда-нибудь была торговая марка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540118,
					"content": "Ха-ха, верно. Глупо предполагать, что таким образом можно что-то заработать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540119
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540119,
					"content": "Мы прибыли, чтобы очистить это место от Похитителей сокровищ. И мы прятались здесь, выдавая себя за них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540120
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540120,
					"content": "Мы уже узнали, что их лидеры находятся в контакте с Фатуи и, возможно, готовят сделку, связанную с торговлей опасными материалами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540121,
						710540124
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540121,
					"content": "Расскажи мне о связи Похитителей сокровищ с Фатуи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540122
					]
				},
				{
					"id": 710540122,
					"content": "Несмотря на то, что ранее мы сорвали планы Фатуи, отдельные их представители до сих пор осуществляют свою деятельность в Ли Юэ за пределами города... Мы не должны недооценивать их возможности и боевую мощь. Они очень опасны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540123
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540123,
					"content": "Если бы Похитители сокровищ решили сговориться с ними против Миллелитов... то обеспечение безопасности стало бы большой головной болью для нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540126,
					"content": "Короче говоря, у нас было готово всё необходимое для генерального наступления. Нам оставалось только вывести их на чистую воду и выяснить, что они замышляют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540127
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540127,
					"content": "И тут появились мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540128,
					"content": "О вас ходят легенды, но мы не думали, что вы настолько хороши в бою... Вы вывели из строя большую часть моего отряда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540129
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540129,
					"content": "Конечно, есть и другая причина, по которой мы находимся здесь. Здесь находится один из затворов формации Цисин. Нельзя допустить, чтобы он попал в руки Похитителей сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540130,
						710540132
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540130,
					"content": "Неловко вышло...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540131
					]
				},
				{
					"id": 710540131,
					"content": "Ха-ха-ха, всё в порядке! Это наша вина, мы не заметили, что это были вы... Я отдал приказ расчистить для вас дорогу, но кто бы мог подумать, что вы придёте так скоро!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540134,
					"content": "Командир Миллелитов такой обходительный! Значит, мы можем идти, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540135,
					"content": "То, что я не виню вас, не означает, что законы Ли Юэ для вас не писаны. Простите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540136
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540136,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540137,
						710540138
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540137,
					"content": "В следующий раз говори всё сразу!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540139,
					"content": "Хм... давайте посмотрим: провокация, вмешательство в правоохранительную работу Миллелитов, попытка разрушить формацию Цисин и... разрушение места преступления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540140
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540140,
					"content": "Даже с учётом всех извинений со стороны Миллелитов... Поздравляю, в Ли Юэ вам будет положена еда и проживание за казённый счёт на пять-десять лет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540141
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540141,
					"content": "Что???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540142,
						710540144
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540142,
					"content": "Мне положен адвокат?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540143
					]
				},
				{
					"id": 710540143,
					"content": "Мы требуем адвоката!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540146,
					"content": "Кхе-кхе... но... Прошу, дослушайте меня до конца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540147
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540147,
					"content": "Граждане и чужеземные гости могут использовать любые средства, чтобы помочь Миллелитам в их делах и получить причитающиеся им вознаграждения или компенсации... это прописано в законах Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540148
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540148,
					"content": "Как видите, это сражение не было напрасным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540149
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540149,
					"content": "Что нам полагается за помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540150
					]
				},
				{
					"id": 710540150,
					"content": "Опечатанные украденные вещи трогать нельзя, но если вы готовы помочь, то сможете забрать себе любые ценности, на которые случайно наткнётесь во время ареста. Например, тайный клад Похитителей сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540151
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540151,
					"content": "Кроме того, мы с сослуживцами собрали немного моры. Надеюсь, вы примете её без возражений. Здесь немного, но мы не рассчитывали, что нам понадобится такая «помощь» со стороны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540152
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540152,
					"content": "Эм... значит, нам не только не придётся садиться в тюрьму, но мы ещё и получим вознаграждение! Верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540153
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540153,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540154
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540154,
					"content": "Тогда мы с удовольствием вам поможем! Показывай дорогу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540155,
						710540156
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540155,
					"content": "Подожди...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540157,
					"content": "Я пока пойду к месту сбора. Не опаздывайте, иначе нам придётся начать без вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540158
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540158,
					"content": "Мы догоним!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540159
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540159,
					"content": "Эй!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540160
					]
				},
				{
					"id": 710540160,
					"content": "Поторопись! Мы поможем Миллелитам раскрыть дело и получим много моры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540156,
					"content": "Я ещё не...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540144,
					"content": "#Знать бы раньше... Я бы здесь вообще камня на камне не оставил{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540145
					]
				},
				{
					"id": 710540145,
					"content": "Мы просто победили кучку негодяев, а они оказались государственными служащими! Мы не виноваты, что вы были одеты как Похитители сокровищ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710540138,
					"content": "Ты всё подстроил!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540132,
					"content": "#Получается, что я побил{F#а} не тех.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540133
					]
				},
				{
					"id": 710540133,
					"content": "В этом есть и доля нашей вины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540124,
					"content": "Расскажи мне об опасных материалах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540125
					]
				},
				{
					"id": 710540125,
					"content": "Мой информатор сказал, что Фатуи что-то покупали у Похитителей сокровищ и расплачивались большим количеством моры и военными припасами... но он нашёл только еду и бытовые предметы, так что, возможно, это был трюк для отвода глаз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540109,
					"content": "Вы Миллелиты?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540110
					]
				},
				{
					"id": 710540110,
					"content": "Ха-ха, простите, что не успели вам всё объяснить... Мы думали, что вы пришли сюда сеять хаос и разрушения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540111
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540111,
					"content": "По правде говоря, вы не далеки от истины...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7105402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
