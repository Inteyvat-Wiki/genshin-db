			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Янь Бо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540201,
					"content": "Я не сомневался, что ты согласишься помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540202
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540202,
					"content": "Контрабандисты должны провести сделку с Фатуи в большом лагере на востоке. Они разбили ещё три маленьких лагеря по дороге к большому лагерю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540203
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540203,
					"content": "Согласно данным осведомителя на юго-востоке находится <color=#00E1FFFF>продовольственный лагерь</color>, на востоке находится <color=#00E1FFFF>оружейный лагерь</color>, а на северо-востоке находится <color=#00E1FFFF>алхимический лагерь</color>. Если мы сможем захватить эти три лагеря врасплох, то полностью отрежем их от снабжения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540204
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540204,
					"content": "Так получилось, что из-за инцидента с Нефритовым дворцом численность патрулирующих этот район Миллелитов сократилась, что позволило преступникам ослабить бдительность. Это идеальный момент для внезапной атаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540205
					],
					"speakerTitle": "Янь Бо"
				},
				{
					"id": 710540205,
					"content": "Только... из-за предыдущего недоразумения у нас сейчас достаточно людей, чтобы зачистить только один лагерь. Но, если тебе понадобится помощь, можешь на нас рассчитывать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Янь Бо"
				}
			]
		},
		{
			"id": 7105403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
