			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Додокоммуникатор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670201,
					"content": "Кто бы мог подумать, что мы столкнёмся с подобными загадками в таком красивом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670202
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400670202,
					"content": "И как тебе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670203
					]
				},
				{
					"id": 400670203,
					"content": "Неплохо, но помощь не будет лишней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670204
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400670204,
					"content": "И что от нас требуется?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400670205,
					"content": "Ммм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670206
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400670206,
					"content": "Ну... хм... ничего?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670207
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400670207,
					"content": "Что? Т-ты недооцениваешь нас?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400670208,
					"content": "Нет-нет, я просто поняла, что, хоть ты и не слишком много болтаешь, но одно твоё тихое присутствие способствует наилучшему исходу дел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670209
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400670209,
					"content": "Компаньон, который нужен всем. Думаю, все здесь рады твоему присутствию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670210
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400670210,
					"content": "Несмотря на то, что ожидания - тяжкий груз, но... Наблюдательность может пригодиться астрологу не только при взгляде на звёздное небо. Замечать сильные стороны людей - тоже своего рода наблюдение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670211
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400670211,
					"content": "Так ты хотела сделать комплимент?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400670212,
					"content": "Просто говорю как есть, ничего не преувеличивая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670213
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400670213,
					"content": "Ага, ты не хочешь признавать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670214
					]
				},
				{
					"id": 400670214,
					"content": "...что говоришь комплименты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400670215,
					"content": "Хватит смеяться! Я же сказала, это была объективная оценка, а не комплимент! Не комплимент!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670216
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400670216,
					"content": "#Я продолжу наблюдать за звёздами. Остаёмся на связи, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				}
			]
		},
		{
