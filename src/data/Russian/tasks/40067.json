					"Каэдэхара Кадзуха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670601,
					"content": "Так ты исполнил своё желание, Кадзуха?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400670602,
					"content": "Можно и так сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670603
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400670603,
					"content": "Вы увидели меня в прошлом и попрощались с ним. Моя история может стать достоянием прошлого лишь после вашего свидетельства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670604
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400670604,
					"content": "Важно не корить себя за былое, а ценить связи с другими людьми, которые возникли в ходе жизненного пути. У людей, застрявших в прошлом, нет будущего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670605
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400670605,
					"content": "Поэтому, пожалуйста, поверьте мне, когда я говорю, что, пройдя долгий путь, я намерен идти дальше. И на этом пути я всегда буду ценить вашу поддержку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				}
			]
		},
		{
