			},
			"dialogs": [
				{
					"id": 400671001,
					"content": "Эй, приятель! Ты в порядке? Тебя подвезти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671002
					],
					"speakerTitle": "Прислушаться"
				},
				{
					"id": 400671002,
					"content": "Пираты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671003
					],
					"speakerTitle": "Прислушаться"
				},
				{
					"id": 400671003,
					"content": "Ага, пираты! Так ты идёшь или нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Прислушаться"
				}
			]
		},
		{
			"id": 4006712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
