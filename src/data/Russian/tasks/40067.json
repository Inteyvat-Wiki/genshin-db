					"Оз"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671201,
					"content": "Кадзуха, вот ты где.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400671202,
					"content": "Вы как раз вовремя. Я размышлял о своей жизни и как раз дошёл до текущего момента.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671203
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400671203,
					"content": "Что ты думаешь о бонсае клана Каэдэхара?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671204,
						400671207
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400671204,
					"content": "Он хранит немало воспоминаний о прошлом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671205
					]
				},
				{
					"id": 400671205,
					"content": "В пережитках истории часто присутствует оттенок сожаления. Клан Каэдэхара тому пример.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671206
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400671206,
					"content": "Но не беда. Однажды распавшееся может быть воссоздано вновь. Если не дома, то на чужбине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400671209,
					"content": "Такой интересный мираж. Жизнь в нём предстаёт театральной постановкой, и каждая следующая сцена интереснее предыдущей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671210
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400671210,
					"content": "А ещё говорят, что астрологов ничем не удивишь. Раз даже ты заинтригована, мир грёз удался на славу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671211
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400671211,
					"content": "Кхм... Как твоё расположение духа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671212
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400671212,
					"content": "Миледи осведомляется о твоём благополучии и надеется, что твоё сердце не слишком исполнено страданий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671213
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400671213,
					"content": "От таких воспоминаний сильно не обрадуешься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400671214,
					"content": "Ха-ха, и вправду. Спасибо за вашу заботу. К счастью, для меня всё это в прошлом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671215
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400671215,
					"content": "Когда я впервые увидел этот бонсай, мне на ум пришла такая мысль... Мне нужно было дождаться вас. Возможно, именно поэтому я был оставлен здесь в одиночестве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400671207,
					"content": "Пусть не всё сложилось идеально, тебе не в чем себя винить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671208
					]
				},
				{
					"id": 400671208,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				}
			]
		},
