			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каэдэхара Кадзуха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670501,
					"content": "В горшке должно находиться засохшее растение, но его нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670502
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400670502,
					"content": "...Пока мы были в разлуке, у меня было много времени на размышления. Думаю, теперь я наконец-то всё понял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670503
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400670503,
					"content": "Этот мир грёз... я. Пустой горшок - состояние моего сердца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670504
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400670504,
					"content": "Для чистого сердца весь мир чист. Когда душа свободна от бремени, таким же видится весь мир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670505
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400670505,
					"content": "Чистота и свобода от бремени... Это то, что я сейчас чувствую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670506
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400670506,
					"content": "Но в этом есть и тень сожаления. Ведь свобода от бремени - это ещё и пустота.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670507
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400670507,
					"content": "Вот почему в моём мире грёз появился бонсай. Это шанс исполнить моё желание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670508
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400670508,
					"content": "Хоть я никогда не осознавал этого, но в глубине души мне всегда хотелось создать свой бонсай. Быть может, в этом и состоит сохранение традиций клана Каэдэхара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				}
			]
		},
