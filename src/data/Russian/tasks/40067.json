			},
			"dialogs": [
				{
					"id": 400670401,
					"content": "Ты Каэдэхара? Взбирайся на лодку, я тебя вывезу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670402
					],
					"speakerTitle": "Прислушаться"
				},
				{
					"id": 400670402,
					"content": "Почему вы помогаете мне? Ведь я же в розыске.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670403
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400670403,
					"content": "Ну конечно, Ясиро... Кхм! Анонимный спонсор заплатил мне, чтобы помочь тебе выбраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670404
					],
					"speakerTitle": "Прислушаться"
				},
				{
					"id": 400670404,
					"content": "Но это всё, чем они смогут тебе помочь. Дальше тебе придётся полагаться только на себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Прислушаться"
				}
			]
		},
		{
			"id": 4006705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
