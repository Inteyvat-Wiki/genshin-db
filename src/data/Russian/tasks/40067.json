				"objectNames": [
					"Фишль",
					"Мона",
					"Синь Янь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670301,
					"content": "Что здесь случилось? Всё сломано...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400670302,
					"content": "Увы, чем выше было положение рода, тем сокрушительнее его упадок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670303
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400670303,
					"content": "Разруха и ни единого человека. Должно быть, так всё и закончилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670304
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400670304,
					"content": "Идём.",
