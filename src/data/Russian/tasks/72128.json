					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280205
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280205,
					"content": "Просто дай мне взамен сущую мелочь, и сможешь открыть сундуки с сокровищами, чтобы получить что-то ценное.",
					"roleType": "TALK_ROLE_NPC",
