				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721280501,
					"content": "#Ты открыл{F#а} сундук с сокровищами, да? Ха-ха-ха, надеюсь, тебе повезло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280502
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280502,
					"content": "Ты что, собираешь эти ракушки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280503
					]
				},
				{
					"id": 721280503,
					"content": "#Ты очень проницател{M#ен}{F#ьна}. Да, я собираю эти ракушки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280504
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280504,
					"content": "Но пока что я не могу тебе рассказать, почему я их собираю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280505,
						721280509
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280505,
					"content": "В них есть что-то особенное?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280506
					]
				},
				{
					"id": 721280506,
					"content": "С деловой точки зрения в них, конечно же, есть что-то особенное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280507
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280507,
					"content": "«Ракушки, которые когда-то подверглись действию Татаригами...» Ха-ха-ха, да, за них можно получить хорошую цену!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280508
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280508,
