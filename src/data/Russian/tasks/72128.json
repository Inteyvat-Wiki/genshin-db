			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Такаси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721280102,
					"content": "Эй, погоди, ты не можешь вот так просто открывать эти сундуки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280103,
						721280105
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280103,
					"content": "Это что, твои сундуки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280104
					]
				},
				{
					"id": 721280104,
					"content": "Разумеется! Я нарочно поставил сюда эти сундуки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280106
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280106,
					"content": "Там внутри самые разнообразные сокровища, которые я собрал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280107
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280107,
					"content": "#Если хочешь открыть эти сундуки с сокровищами - почему бы и нет. Но... Ты долж{M#ен}{F#на} дать мне что-то взамен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280108,
						721280110
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280108,
					"content": "Ты хочешь мору?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280109
					]
				},
				{
					"id": 721280109,
					"content": "Ха-ха-ха, нет, мора не пойдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280111
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280111,
					"content": "Мне нужны ракушки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280112
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280112,
					"content": "Ты найдёшь много таких ракушек на пляже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280113
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280113,
					"content": "Если хочешь открыть сундук и получить сокровища, выменяй его у меня за ракушки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280114
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280114,
					"content": "#Но... Я не скажу тебе, что там в этих сундуках с сокровищами, и что ты можешь получить. Давай-ка посмотрим, насколько ты удачлив{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280115
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280115,
					"content": "Как всё устроено? Если хочешь открыть эти сундуки с сокровищами, дай мне взамен ракушки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280110,
					"content": "Так чего же ты хочешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280111
					]
				},
				{
					"id": 721280105,
					"content": "А что там внутри?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280106
					]
				}
			]
		},
