				},
				{
					"id": 721280202,
					"content": "Ты говоришь об этих сундуках с сокровищами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280203
					]
				},
				{
					"id": 721280203,
					"content": "Да, всё верно, об этих сундуках с сокровищами.",
					"roleType": "TALK_ROLE_NPC",
