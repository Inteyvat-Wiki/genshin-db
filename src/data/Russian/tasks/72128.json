			"dialogs": [
				{
					"id": 721280401,
					"content": "Да, то что надо! Как раз такие ракушки мне и нужны. Выбери сундук с сокровищами и открой его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280402,
						721280403
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280402,
					"content": "Только один сундук?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280404
					]
				},
				{
					"id": 721280404,
					"content": "Сожалею, но за один раз ты можешь выбрать и открыть только один из этих сундуков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280405
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280405,
					"content": "Ладно, выбери сундук с сокровищами и открой его. Хе-хе, желаю удачи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Такаси"
				},
				{
					"id": 721280403,
					"content": "А можно все посмотреть? И открыть все сразу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280404
					]
				}
			]
		},
		{
			"id": 7212805,
			"completionStepIds": [
