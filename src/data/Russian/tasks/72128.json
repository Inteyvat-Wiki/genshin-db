			"dialogs": [
				{
					"id": 721280201,
					"content": "#Хм-м? Ты путешественни{F#ца}{M#к}? Ха-ха-ха-ха! Ты как раз вовремя. У меня для тебя есть хорошие новости.",
					"roleType": "TALK_ROLE_NPC",
