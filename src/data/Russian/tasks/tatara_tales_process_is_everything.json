	"talks": [
		{
			"id": 7211801,
			"completionStepIds": [
				7211802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211802",
							"2"
						],
						"stepId": 7211802,
						"stateName": "QUEST_STATE_UNFINISHED"
