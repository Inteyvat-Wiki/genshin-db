			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ксавье"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "Отлично! Позволь взглянуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180402,
					"content": "Кажется, нам повезло. Горн Микагэ довольно стабилен, и внутреннего перенасыщения энергией пока не произошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180403,
					"content": "Такую концентрацию моё устройство должно выдержать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180404,
					"content": "Мы должны очистить всю эту энергию?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "Если бы это устройство так могло - ох, я бы давно уже подал заявку на патент. Но наш изысканный друг всего лишь может снизить уровни энергии в локализованной области.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180406,
					"content": "Однако причина деактивации горна Микагэ и даже отказ программы автоматического перезапуска заключается во внутреннем перенасыщении порченной энергией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180407,
					"content": "Как только мы найдём область с наивысшей концентрацией и очистим её, мы сможем перезапустить ядро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180408,
					"content": "В этот момент горн Микагэ восстановит работу, а дальше... а это уже не наша забота.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180409,
					"content": "Вот такой у меня план. И прежде чем приступать к его реализации, мне ещё нужно сделать несколько приготовлений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				}
			]
		},
