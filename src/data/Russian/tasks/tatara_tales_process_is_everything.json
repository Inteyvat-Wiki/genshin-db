			"dialogs": [
				{
					"id": 721180301,
					"content": "#Ну что, разведал{F#а} обстановку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180302
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180302,
					"content": "Ещё бы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211804,
			"completionStepIds": [
				7211809
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211809",
							"2"
						],
						"stepId": 7211809,
						"stateName": "QUEST_STATE_UNFINISHED"
