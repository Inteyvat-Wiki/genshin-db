				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ксавье"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180101,
					"content": "Что ж! И наконец-то всё готово! К счастью, я помню все спецификации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180102
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180102,
					"content": "Значит, мы войдём внутрь, чтобы очистить энергию Татаригами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180103
					]
				},
				{
					"id": 721180103,
					"content": "Я бы и сам с радостью так поступил, да, но я не должен покидать свой пост здесь - пусть даже на секунду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180104
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180104,
					"content": "Кроме того, поскольку некоторые материалы найти не удалось, мне пришлось импровизировать и в срочном порядке заменить их другими. Поэтому надёжность устройства оставляет желать лучшего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180105
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180105,
					"content": "Хм-м. Скажем так, в некоторых ситуациях оно может не обеспечивать необходимой эффективности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180106
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180106,
					"content": "Его прекрасно можно использовать в нормальных условиях, но я сомневаюсь, что оно выдержит какие-то экстремальные условия. Кроме того, не стоит его сильно трясти, чтобы некоторые компоненты не сместились...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180107
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180107,
					"content": "Собственно, нам ещё нужно провести определённые приготовления, прежде чем мы сможем поместить нашего дружка в рабочую среду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180108
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180108,
					"content": "#Я хочу, чтобы ты {M#отправился}{F#отправилась} к горну Микагэ и записал{F#а} для меня кое-какие данные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180109,
						721180111
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180109,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180110
					]
				},
				{
					"id": 721180110,
					"content": "Спасибо тебе большое. Я тут буду ждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180111,
					"content": "Нам и впрямь нужно соблюдать такую осторожность?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180112
					]
				},
				{
					"id": 721180112,
					"content": "Конечно. Сказать правду, даже сейчас я всё равно отказался от некоторых шагов. Если бы здесь был господин Флуа, мы бы здесь ещё неделю возились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180113
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721180113,
					"content": "В целом, будем поступать, как того требует наша уникальная ситуация. Мы же все состоим в аналитической комиссии... и я официально наделю нас полномочиями действовать сообразно обстоятельствам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				}
			]
		},
