					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120221002
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120221002,
					"content": "Ах, если бы только вся работа делалась сама по себе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
