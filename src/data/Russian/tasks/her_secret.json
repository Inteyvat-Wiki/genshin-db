			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220601,
					"content": "#{NICKNAME}, это ведь она, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120220602,
					"content": "Даже закладка есть. В других книгах закладок нет, а значит, она их уже прочла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120220603,
					"content": "Буквы вроде и знакомые, но Паймон ничегошеньки не понимает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120220604,
					"content": "Вернёмся к Кокоми и почитаем ей вслух!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1202207,
			"completionStepIds": [
				1202204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202204",
							"2"
						],
						"stepId": 1202204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сибата",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220701,
					"content": "Вы ищете её превосходительство?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "Сибата"
				},
				{
					"id": 120220702,
					"content": "Боюсь, сейчас её нет. Где она может быть, я не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "Сибата"
				},
				{
					"id": 120220703,
					"content": "Как странно... Значит, нам ничего не остаётся, как вернуться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120220704,
					"content": "Не обязательно. У её превосходительства есть указание и на такой случай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "Сибата"
				},
				{
					"id": 120220705,
					"content": "Посмотрим... Да, номер девяносто восемь: <color=#00E1FFFF>«Если ко мне пришли гости, а я неизвестно где, пусть идут на юг к дереву с пурпурной звездой»</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "Сибата"
				},
				{
					"id": 120220706,
					"content": "В примечании сказано, что это указание применимо лишь когда её превосходительство не оставила других пояснений, а её гости - люди особенного статуса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "Сибата"
				},
				{
					"id": 120220707,
					"content": "Насколько я понимаю, вы соответствуете этим условиям. Я всегда держу указания под рукой. Уверен, так и следует поступить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "Сибата"
				},
				{
					"id": 120220708,
					"content": "Кокоми учла любую ситуацию! Тогда мы поищем то место, о котором она написала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
