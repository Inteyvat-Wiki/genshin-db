					"content": "Мне нужно немного времени, чтобы подготовиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490602
					]
				},
				{
					"id": 722490602,
					"content": "Буду ждать.",
