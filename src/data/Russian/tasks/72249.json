		},
		{
			"id": 7224902,
			"completionStepIds": [
				7224904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224904",
							"2"
						],
						"stepId": 7224904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Абэраку",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722490201,
					"content": "Невероятно! Получилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490202
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490202,
					"content": "Прошу, отнесите эти подношения... подношения... вам следует...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490203
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490203,
					"content": "...заберите их, чтобы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490204
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490204,
					"content": "...чтобы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490205
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490205,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722490206,
					"content": "Ох, братец, тебя всё сложнее понять!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722490207,
					"content": "Отнесите их к месту подношения... соедините части души моей, чтобы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490208
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490208,
					"content": "Эй, господин призрак?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722490209,
					"content": "Чтобы... чтобы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490210
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490210,
					"content": "Что «чтобы»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722490211,
					"content": "...чтобы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490212
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490212,
					"content": "Ах, этого парнишку не понять! Но, похоже, мы должны куда-то отнести эти подношения, насколько Паймон поняла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722490213,
					"content": "Они лежат здесь так долго. Кто знает, будет ли что-нибудь съедобное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722490214,
					"content": "Лучше их не есть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490215
					]
				},
				{
					"id": 722490215,
					"content": "Эй! Паймон не ест всё подряд! Ясно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722490216,
					"content": "#Но всё равно возьмём с собой подношения, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7224903,
			"completionStepIds": [
				7224905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224905",
