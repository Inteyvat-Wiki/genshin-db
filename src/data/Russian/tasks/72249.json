			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Абэраку",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722490301,
					"content": "Меня зовут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490302
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490302,
					"content": "...Абэраку, создатель Гелиоса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490303
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490303,
					"content": "Мм, а что такое «Гелиос»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722490304,
					"content": "Это что-то впечатляющее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722490305,
					"content": "Да! Это я организовал строительство Гелиоса силами всего народа, чтобы мы могли противостоять Дракону глубин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490306
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490306,
					"content": "На это никто, кроме меня, в Бякуякоку больше не был способен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490307
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490307,
					"content": "Хм. Полагаю, это впечатляет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722490308,
					"content": "Но почему такой великий человек заперт здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722490309,
					"content": "Меня предали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490310
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490310,
					"content": "Когда небесное королевство рухнуло в бездонные глубины, народ был измучен драконами, и поэтому я - да, именно я - начал строить Гелиос, чтобы спасти нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490311
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490311,
					"content": "Но... эти жадные людишки! Как только их жизни оказались вне опасности, они начали обманывать и лгать. Они даже выступали за то, чтобы посадить на трон детей. Смехотворно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490312
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490312,
					"content": "Даже я стал мишенью их заговоров, меня оставили гнить в тюрьме!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490313
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490313,
					"content": "Да падёт на них чума! Да будут они прокляты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490314
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490314,
					"content": "Да, кстати, ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490315,
						722490317
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490315,
					"content": "Я?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490316
					]
				},
				{
					"id": 722490316,
					"content": "Да, ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722490320,
					"content": "Ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490321
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490321,
					"content": "Когда-то здесь лежали мои священные одеяния, но за прошедшие годы они почти сгнили, на них нельзя надеяться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490322
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490322,
					"content": "Но если сможете пройти испытание, тогда я передам вам подношения, в которые я вложил свои мысли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490323
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490323,
					"content": "Я молюсь за ваш... успех...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490324
					],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490324,
					"content": "Это опасно. Скажите мне, как будете готовы, - и начнём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Абэраку"
				},
				{
					"id": 722490317,
					"content": "Паймон, я думаю, он говорит с тобой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490318
					]
				},
				{
					"id": 722490318,
					"content": "Нет, он явно смотрит на тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722490319,
					"content": "(И выглядит нервно.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "Паймон"
				}
			]
		},
