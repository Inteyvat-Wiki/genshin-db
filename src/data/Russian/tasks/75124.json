					},
					{
						"sceneId": 3,
						"position": [
							-1639.219,
							200.16,
							10051.38
						],
						"pointId": 10424
					},
					{
						"sceneId": 3,
						"position": [
							-1640.835,
							200.051,
							10051.92
						],
						"pointId": 10425
					}
				]
			},
			"dialogs": [
				{
					"id": 751240101,
					"content": "Ай, опять убежала. Так, в плавательном круге осталась только одна... Что же делать?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240102
					],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240102,
					"content": "Сколько это будет продолжаться?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240103
					],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240103,
					"content": "О, здесь кто-то фотографирует... птиц течений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751240104,
					"content": "Они действительно довольно милые...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240105,
						751240107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751240105,
					"content": "Всё вихляют да покачиваются...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240106
					]
				},
				{
					"id": 751240106,
					"content": "Да, они так мило бредут вперевалочку. А когда надуваются как шарики и плывут... Паймон становится радостно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751240109,
					"content": "Истинно так, моя прелестная маленькая госпожа с серебряными волосами! Тот, кто сотворил этих птиц течений, заслуживает всех похвал мира...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240110
					],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240110,
					"content": "Сколь невероятно... О, прошу прощения, я не представился. Я фотограф-любитель птиц течений. Называйте меня Жонвель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240111
					],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240111,
					"content": "#Хорошо! Паймон зовут Паймон, а это {NICKNAME}... Но всё же почему ты печально вздыхаешь, хотя вокруг полно птиц течений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751240112,
					"content": "Это долгая история... Позвольте кратко изложить её для вас. Видите ли, фотографов-любителей птиц течений много, и все мы хотим сделать самые интересные фотографии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240113
					],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240113,
					"content": "А на днях у меня появилась блестящая идея - поместить всех птиц течений в кадре в плавательные круги!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240114,
						751240117
					],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240114,
					"content": "Какой в этом смысл?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240115
					]
				},
				{
					"id": 751240115,
					"content": "Разумеется, смысла в этом нет. Ясно же, что птицы течений, которые плавают по воде сами по себе, но при этом с плавательным кругом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240116
					],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240116,
					"content": "...это такая же бессмыслица, как и зарабатывать мору с помощью моры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240120,
					"content": "Ты возлагаешь на птичек слишком большую ношу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751240121,
					"content": "Это то, что называется, сюрреалистической фотографией: в снимке необходимо найти глубокий смысл... Ах, к сожалению, возникли некоторые неприятности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240122
					],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240122,
					"content": "В реальности птицы течений не носят плавательных кругов... следовательно, сделать такую фотографию нельзя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240123
					],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240123,
					"content": "Неспроста она называется «сюрреалистической»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240124
					]
				},
				{
					"id": 751240124,
					"content": "#Постой. Выходит, всего лишь нужно надеть плавательные круги на всех птиц течений? {NICKNAME}, мы, любители птиц течений, не оставим товарища в беде!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240125,
						751240127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751240125,
					"content": "Да, выручим собрата-любителя!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240126
					]
				},
				{
					"id": 751240126,
					"content": "Верно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751240129,
					"content": "Правда? Вы поможете мне?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240130
					],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240130,
					"content": "Хе-хе, если ты только дашь нам несколько хороших фотографий, когда закончишь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751240131,
					"content": "Т-тогда я буду перед вами в долгу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240127,
					"content": "Хотя, по правде, мне больше нравятся белки-летяги...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240128
					]
				},
				{
					"id": 751240128,
					"content": "Сейчас не время для таких разговоров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751240117,
					"content": "Обычному человеку вряд ли такое придёт в голову...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240118
					]
				},
				{
					"id": 751240118,
					"content": "Подумайте только - птицы течений, которые умеют плавать, и всё равно с плавательными кругами - какое наслоение смыслов это создаст на фото?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240119
					],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240119,
					"content": "Это в полной мере раскроет темы «чрезмерного употребления» и «расточительства»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Жонвель"
				},
				{
					"id": 751240107,
					"content": "Если честно, мне больше нравятся белки-летяги...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240108
					]
				},
				{
					"id": 751240108,
					"content": "Белки-летяги, конечно, тоже милые. Но нужно быть бессердечным, чтобы при плавающих туда-сюда птицах течений сказать, что «белки-летяги милее них»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Паймон"
				}
			]
		},
