			"dialogs": [
				{
					"id": 747120101,
					"content": "#{NICKNAME}, Паймон, у меня отличные новости! Проблема решена!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120102
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747120102,
					"content": "Операция по спасению буйных рыбок успешно завершена!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120103
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747120103,
					"content": "Когда водолазы расчистят свалку на дне, а больные рыбки окончательно восстановятся, мы сможем вернуть их в родную среду обитания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120104
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747120104,
					"content": "Спасибо тебе большое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747120105
					]
				},
				{
					"id": 747120105,
					"content": "Хе-хе, Сиджвин, без тебя у нас бы ничего не получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747120106,
					"content": "Я написала подробный отчёт и передала его во Дворец Мермония. Скоро уполномоченный сотрудник составит правила и распространит их по всем организациям...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120107
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747120107,
					"content": "Кроме того, я слышала, что некоторые репортёры и даже один режиссёр тоже заинтересовались этой темой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120108
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747120108,
					"content": "Вдруг однажды мы увидим фильм о том, как важно сохранять чистоту подводного мира?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120109
					],
					"speakerTitle": "Сиджвин"
				},
				{
					"id": 747120109,
					"content": "Да, некоторые особо упрямые и беспечные люди не понимают обычных объяснений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747120110,
					"content": "Им нужно показывать страшные фильмы... Например, о том, как рыбы, обитавшие в грязном море, мутировали в гигантских чудовищ, которые крушат всё на своём пути!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747120111,
					"content": "Чтобы после такого фильма негодяям, которые привыкли бросать всякий мусор в воду, снились кошмары! Вот тогда до них наконец дойдёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747120112,
					"content": "Отличная идея!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сиджвин"
				}
			]
		}
	]
}