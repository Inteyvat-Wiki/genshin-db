			},
			"dialogs": [
				{
					"id": 740820701,
					"content": "Кристально чистая капля появилась на алтаре.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740820702,
					"content": "Эта капля... Не то ли самое сокровище?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820703,
					"content": "Она не похожа на сокровище.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820704
					]
				},
				{
					"id": 740820704,
					"content": "Паймон тоже так считает... Это было бы слишком легко... Что же это тогда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820705,
						740820710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820705,
					"content": "А вдруг это важнейший предмет для победы над Владыкой тьмы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820706
					]
				},
				{
					"id": 740820706,
					"content": "Что? Тогда дело плохо. Скорее! Верни её на место! Надеюсь, ещё не поздно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820707,
					"content": "А?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820708
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820708,
					"content": "Нам конец! Владыка тьмы явился!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820709,
					"content": "Владыка тьмы? Мелюзина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820715,
					"content": "Паймон так испугалась... Оказывается, это мелюзина... Как ты здесь оказалась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820716,
					"content": "Ключ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820717
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820717,
					"content": "К... какой ключ? Эта капля - ключ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820718
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820718,
					"content": "Пашив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820719
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820719,
					"content": "Гм... Эта капля - Пашив?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820720
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820720,
					"content": "Мелюзина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820721
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820721,
					"content": "Ох! Что это значит? Капля - это мелюзина? У Паймон голова идёт кругом. В чём же дело? Это ведь ты здесь мелюзина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820722
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820722,
					"content": "Пашив...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820723
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820723,
					"content": "Гм... Ты Пашив? Подожди, не отвечай... После твоего ответа Паймон точно станет ещё хуже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820724
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820724,
					"content": "Паймон будет называть тебя Пашив, хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820725
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820725,
					"content": "Мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820726
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820726,
					"content": "#{NICKNAME}... Что же делать? Паймон её совершенно не понимает. О чём она говорит?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820727
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820727,
					"content": "Ты нас понимаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820728
					]
				},
				{
					"id": 740820728,
					"content": "Пашив...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820729
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820729,
					"content": "Эта капля - ключ, так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820730
					]
				},
				{
					"id": 740820730,
					"content": "Пашив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820731
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820731,
					"content": "Ты не человек, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820732
					]
				},
				{
					"id": 740820732,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820733
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820733,
					"content": "Гм... Не стоит грубить, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820734
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820734,
					"content": "Я не человек, правильно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820735
					]
				},
				{
					"id": 740820735,
					"content": "М... мелюзина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820736
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820736,
					"content": "Ага! Подожди-ка, Паймон, кажется, поняла... «Пашив» - это «да», а «мелюзина» - «нет». Правильно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820737
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820737,
					"content": "Пашив! Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820738
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820738,
					"content": "Оказывается, тебя зовут не Пашив... Прости, Паймон перепутала твоё имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820739
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820739,
					"content": "Пашив... Нравится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820740
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820740,
					"content": "Тебе нравится это имя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820741
					]
				},
				{
					"id": 740820741,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820742
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820742,
					"content": "#Отлично! Тогда так и будем тебя называть. Хи-хи. Паймон зовут Паймон, а это {NICKNAME}. Рады с тобой познакомиться, Пашив. Паймон никогда раньше не встречала таких мелюзин, как ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820743
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820743,
					"content": "#Паймон, Пашив! {NICKNAME}, Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820744
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820744,
					"content": "Эринии... Мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820745
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820745,
					"content": "...Эринии нет? Или... Гм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820746
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820746,
					"content": "С островом Эриний что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820747
					]
				},
				{
					"id": 740820747,
					"content": "Эринии, мелюзина, сейчас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820748
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820748,
					"content": "Пашив, Эринии, защищать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820749
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820749,
					"content": "С островом Эриний происходит что-то плохое, и ты хочешь его защитить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820750
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820750,
					"content": "#Паймон, {NICKNAME}, Эринии, пом, пом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820751
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820751,
					"content": "#Гм... На этот раз пять слов, эх... Ты хочешь, чтобы Паймон и {NICKNAME} дважды сделали острову Эриний «пом-пом»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820752
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820752,
					"content": "Мелюзина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820753
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820753,
					"content": "Тебе нужна наша помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820754
					]
				},
				{
					"id": 740820754,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820755
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820755,
					"content": "Оказывается, «пом» значит «помощь». Это хорошо. Сделать острову «пом-пом» было бы гораздо сложнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820756
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820756,
					"content": "Пом-пом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820757,
						740820761
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820757,
					"content": "А награда будет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820758
					]
				},
				{
					"id": 740820758,
					"content": "Наг... рада?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820759
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820759,
					"content": "#Ох, {NICKNAME}, ты посмотри на Пашив. Она толком не говорит и, наверняка, не сможет найти других желающих помочь. Давай просто возьмёмся за дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820760
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820760,
					"content": "Как же нам помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820762,
					"content": "Ключ, ключ, ключ, число.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820763
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820763,
					"content": "А потом? Что за число ключей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820764
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820764,
					"content": "Ключ! Ключ! Ключ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820765
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820765,
					"content": "Три ключа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820766
					]
				},
				{
					"id": 740820766,
					"content": "Пашив! Ключ, туман-путь, юг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820767
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820767,
					"content": "Ключ, источник, север...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820768
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820768,
					"content": "Ключ, ива, восток...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820769
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820769,
					"content": "Ох, так вот в чём дело... Паймон нужно записать... Всего три ключа: туманный путь на юге, источник на севере и ива на востоке... Верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820770
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820770,
					"content": "Ключ, ключ, ключ, площадь, запад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820771
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820771,
					"content": "На площади с запада есть ещё три ключа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820772
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820772,
					"content": "Собрать три ключа и отправиться на площадь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820773
					]
				},
				{
					"id": 740820773,
					"content": "#Паймон, мелюзина! {NICKNAME}, Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820774
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820774,
					"content": "#Эх, Пашив, не говори так, будто {NICKNAME} умнее Паймон! Паймон с {M#ним}{F#ней} на одном уровне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820775
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820775,
					"content": "Давайте подытожим. Мы уже добыли один ключ. Кажется, остаётся получить ещё два.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820776
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820776,
					"content": "Эринии, мелюзина... Пашив, защищать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820777
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820777,
					"content": "Не переживай. Пусть мы не знаем, что произошло, но мы поможем тебе защитить остров Эриний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820778
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820778,
					"content": "Паймон хочет ещё кое-что дополнить. Пашив, если вдруг ты случайно увидишь бесхозную вещицу, такую золотистую кругленькую... или некий ценный сундук...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820779
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820779,
					"content": "Будет здорово, если ты нам об этом расскажешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820780
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820780,
					"content": "Пашив задумчиво почесала голову, затем радостно подпрыгнула два раза и в спешке удалилась.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740820781,
					"content": "#Ох, она взяла и убежала. Наверное, что-то срочное. {NICKNAME}, давай отправимся на поиски двух других ключей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820761,
					"content": "Как же нам помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820710,
					"content": "Может быть, кто-то просто оставил её здесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820711
					]
				},
				{
					"id": 740820711,
					"content": "Что? О нет, мы что, стали воришками? Как неловко вышло... Давай положим её назад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820712,
					"content": "А?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820713
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740820713,
					"content": "Это конец! Хозяин вернулся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820714,
					"content": "Хозяин? Мелюзина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Пашив"
				}
			]
		},
