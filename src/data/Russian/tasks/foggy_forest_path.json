			"dialogs": [
				{
					"id": 740821001,
					"content": "Отлично! Ещё один ключ у нас. Осталось найти последний и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821002,
					"content": "Ключ, ключ, Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821003
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821003,
					"content": "Ох, Пашив, ты откуда здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821004
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821004,
					"content": "След простыл, Пашив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821005
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821005,
					"content": "Понятно... Ты самая необычная мелюзина из тех, которых Паймон встречала... Кстати, на памяти Паймон большинство мелюзин живут в Кур-де-Фонтейне или в деревне Меруси... Почему ты здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821006
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821006,
					"content": "Кур-де-Фонтейн? Деревня Меруси?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821007
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821007,
					"content": "Судя по твоему недоумению, ты никогда не слышала эти названия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821008
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821008,
					"content": "Кур-де-Фонтейн, мелюзина... Деревня Меруси, мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821009
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821009,
					"content": "Хм... Эринии, Пашив, дом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821010
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821010,
					"content": "Эринии, Пашив, защищать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821011
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821011,
					"content": "Постой. Хочешь сказать, что здесь твой дом? Ты защищаешь свой дом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821012
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821012,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821013
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821013,
					"content": "Но дом мелюзин в деревне Меруси, нет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821014
					]
				},
				{
					"id": 740821014,
					"content": "Да, странно. Разве мелюзины могут рождаться в других местах? Кажется, здесь больше нет других мелюзин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821015
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821015,
					"content": "Пашив, ты одна здесь живёшь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821016
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821016,
					"content": "Одна? Мелюзина. Новый валет! Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821017
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821017,
					"content": "Новый... валет? Валет? Какой валет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821018
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821018,
					"content": "#Новый валет! Паймон - Паймон, {NICKNAME} - {NICKNAME}. Новый валет - Новый валет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821019
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821019,
					"content": "Так кто же этот Новый валет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821020
					]
				},
				{
					"id": 740821020,
					"content": "Пашив... Может, ты хочешь сказать, что Нового валета зовут Новый валет, как Паймон зовут Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821021
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821021,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821022
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821022,
					"content": "А-ха! Оказывается, вот в чём дело. Паймон права, Паймон тоже умная!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821023,
						740821024
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821023,
					"content": "Какое странное имя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821025
					]
				},
				{
					"id": 740821024,
					"content": "Какое классное имя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821025
					]
				},
				{
					"id": 740821025,
					"content": "Новый валет, Пашив, знания, пом-пом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821026
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821026,
					"content": "Да... Ты хочешь сказать, что Новый валет учил тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821027
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821027,
					"content": "Пашив! Очень много. Язык, мудрость... Очень много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821028
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821028,
					"content": "Хм, Паймон кажется, что не очень уж и много...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821029
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821029,
					"content": "Пашив, Новый валет, защищать, пом-пом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821030
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821030,
					"content": "Он тоже помогает тебе защищать это место?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821031
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821031,
					"content": "Мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821032
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821032,
					"content": "Ты помогаешь ему защищать это место?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821033
					]
				},
				{
					"id": 740821033,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821034
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821034,
					"content": "Вот оно что... Так кто же этот Новый валет? Почему ему нужна твоя помощь, чтобы защитить это место?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821035
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821035,
					"content": "Здесь действительно произошло что-то плохое. Надписи на каменной табличке были кем-то стёрты, и мы увидели много скверны... Это были враги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821036
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740821036,
					"content": "Паймон любопытная, Пашив! Но время очень не очень много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821037
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821037,
					"content": "Ключ, ключ, ключ, площадь, запад. Пом-пом, пом-пом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821038
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740821038,
					"content": "Мы поторопимся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821039
					]
				},
				{
					"id": 740821039,
					"content": "#Паймон, Пашив! {NICKNAME}, Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821040
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740831040,
					"content": "Пашив дважды радостно подпрыгнула, а потом второпях удалилась.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740821041,
					"content": "Кажется, времени немного. Хорошо, что у нас уже два ключа. Нужно собраться и достать третий ключ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
