			"dialogs": [
				{
					"id": 740820401,
					"content": "(Большая часть надписи стёрта, можно едва различить только слова: «...чистая роса... три...»)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820402
					],
					"speakerTitle": "Таинственный алтарь"
				},
				{
					"id": 740820402,
					"content": "Ужасно! Здесь тоже всё стёрто. Значит, написано что-то секретное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820403,
						740820406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820403,
					"content": "Чистая роса?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820404
					]
				},
				{
					"id": 740820404,
					"content": "Что значит «чистая роса»? Прозрачные капли воды? Но здесь вокруг везде вода!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820405,
					"content": "А это слово «три» ведь не может указывать на три капли воды? Какая морока...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820409,
					"content": "Скорее спроси своё удивительное чутьё на сокровища!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820410
					]
				},
				{
					"id": 740820410,
					"content": "Паймон уже спросила! Оно говорит... что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820411,
					"content": "Говорит, что «три» как-то связано с водой. Поэтому нам нужно поискать поблизости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820406,
					"content": "Три?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820407
					]
				},
				{
					"id": 740820407,
					"content": "«Три» - это количество?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820408,
					"content": "«Чистая роса» подразумевает прозрачные капли воды? Но здесь вокруг везде вода... Какая морока...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Паймон"
				}
			]
		},
