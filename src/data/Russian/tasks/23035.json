	"talks": [
		{
			"id": 2303501,
			"completionStepIds": [
				2303501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303501",
							"2"
						],
						"stepId": 2303501,
