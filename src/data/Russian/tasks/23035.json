				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Фукумото"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350101,
					"content": "До чего же хочется вернуться в Инадзуму... Как со мной могло такое случиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350102,
						230350103
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350102,
					"content": "Что с тобой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				},
				{
					"id": 230350104,
					"content": "#Путешественни{F#ца}{M#к}? Не будем о романе. Думаю, группа учёных, которая работает над «Священным призывом семерых», скоро бросит это дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350105
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350105,
					"content": "Один учёный, с которым я дружу, говорит, что при работе над «Священным призывом семерых» они столкнулись со множеством самых разных проблем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350106
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350106,
					"content": "Например, на один недостаток игры указал учёный из Хараватата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350107
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350107,
					"content": "Он заметил, что текст на картах слишком длинный. И люди, не привыкшие читать длинные тексты, могут не захотеть играть в «Священный призыв семерых».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350108
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350108,
					"content": "Учёные привыкли читать длинные тексты, для них это не составляет труда. Но многим игрокам такое придётся не по нраву, из-за обилия текста на картах они могут вовсе отказаться играть в «Священный призыв семерых».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350109
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350109,
					"content": "Тот учёный посоветовал вдвое сократить текст на некоторых картах для удобства игроков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350110,
						230350111
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350110,
					"content": "Это... это правда необходимо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350112,
					"content": "Я тоже не считаю обилие текста большой проблемой... Но учёные продолжают тщательно над ней работать. Ведь речь идёт об игре, а игра должна приносить удовольствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350113
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350113,
					"content": "Ладно, не будем об этом... Сейчас есть куда более важный вопрос. Мне обещали найти модель, но возникли проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350114
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350114,
					"content": "Я тебе рассказывал: один учёный обещал познакомить меня с господином Тигнари и господином Сайно и попросить их попозировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350115
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350115,
					"content": "Но учёные сейчас так заняты... Видимо, пока придётся об этом забыть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350116,
						230350117
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350116,
					"content": "Что же теперь делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350118,
					"content": "Тот учёный не смог мне помочь, но предложил одну идею.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350119
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350119,
					"content": "Он сказал, что господин Сайно иногда играет в карты в кафе «Пуспа».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350120
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350120,
					"content": "Можно попытать удачу... Или ждать, пока учёные освободятся и помогут мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350121
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350121,
					"content": "Так ты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350122
					]
				},
				{
					"id": 230350122,
					"content": "Эх, когда они освободятся, я уже допишу свой роман.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350123
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350123,
					"content": "Поэтому нужно рассчитывать только на себя. Посмотрим, смогу ли я найти господина Сайно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350124
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350124,
					"content": "Но даже если мне повезёт и я встречу господина Сайно в кафе, как с ним заговорить? Да уж, задача...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350128,
						230350129
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350128,
					"content": "Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350130,
					"content": "Правда?! Это отлично! Но как же ты... Ладно, не хочу совать свой нос в чужие дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350131
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350131,
					"content": "Не будем терять времени. Пойдём скорее в кафе «Пуспа». Надеюсь, мы встретим там господина Сайно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350129,
					"content": "Мы с Сайно хорошо знакомы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350117,
					"content": "И как ты думаешь с ними познакомиться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350111,
					"content": "Не такие и длинные эти тексты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350103,
					"content": "Как идёт работа над романом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				}
			]
		},
		{
			"id": 2303503,
			"completionStepIds": [
				2303503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303503",
							"2"
						],
						"stepId": 2303503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Фукумото"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350301,
					"content": "Тсс... Это ведь господин Сайно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350302
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350302,
					"content": "Костюм, причёска и цвет волос... таким и должен быть герой романа о карточной игре!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350303,
						230350305
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350303,
					"content": "Не вижу никакой связи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350304
					]
				},
				{
					"id": 230350304,
					"content": "Сейчас не лучшее время для объяснений, просто поверь моей интуиции...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350309,
					"content": "#Путешественни{F#ца}{M#к}, пожалуйста, попроси господина Сайно попозировать мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350305,
					"content": "Тогда у меня полно знакомых, которые могут стать книжными героями...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350306
					]
				},
				{
					"id": 230350306,
					"content": "Правда? Просто замечательно! Я как раз собираю материалы для третьей книги из цикла «Король священного призыва». Но эта книга уже не будет строиться на правилах «Священного призыва семерых».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350307
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350307,
					"content": "Я решил придумать новый способ сражения, например... Все карты парят в воздухе, а соперники должны одновременно вести игру и собирать карты, при этом стараясь отбить карты у противника...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350308
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350308,
					"content": "Ха-ха-ха! Будет очень интересно, только представь! Но сейчас важно другое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Фукумото"
				}
			]
		},
		{
			"id": 2303504,
			"completionStepIds": [
				2303504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303504",
							"2"
						],
						"stepId": 2303504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сайно"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350401,
					"content": "Хм... Кажется, получилась неплохая колода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350402
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350402,
					"content": "Но с такими картами будет непросто отразить быструю атаку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350403
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350403,
					"content": "Сайно, что делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350404
					]
				},
				{
					"id": 230350404,
					"content": "#{NICKNAME}? Не думал, что встречу тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350405
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350405,
					"content": "Я пытаюсь собрать колоду карт «Священного призыва семерых», подходящую для медленной атаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350406
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350406,
					"content": "По моей задумке, с такой колодой у игрока будет много ресурсов и разных сильных карт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350407
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350407,
					"content": "По правде говоря, такую колоду очень сложно собрать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350408
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350408,
					"content": "Сейчас некоторые игроки «Священного призыва семерых» предпочитают использовать колоды для быстрой атаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350409
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350409,
					"content": "В начале игры они сразу бросаются в бой, выкладывают много карт, чтобы как можно быстрее одержать победу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350410
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350410,
					"content": "Но мне такая тактика не по душе. Мне нравится долгое противоборство, когда соперники разными способами накапливают ресурсы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350411
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350411,
					"content": "Игрок использует каждую возможность, чтобы постепенно накопить преимущества и уверенно одержать победу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350412
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350412,
					"content": "Да, да! Всё верно! Таким и должен быть главный герой моего романа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350413
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350413,
					"content": "Прошу прощения! Эм... Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350414,
						230350415
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350414,
					"content": "Это Фукумото.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350415,
					"content": "Это автор романа «Король священного призыва».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350416,
					"content": "Здравствуйте, генерал махаматра. Вы... Едва ли вы обо мне слышали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350417
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350417,
					"content": "Я читал твой роман. Хорошая работа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350418
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350418,
					"content": "Для меня это большая честь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350419
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350419,
					"content": "В этом романе меня больше всего поразило, что, проигрывая, главный герой разными способами доставал карты, которых не было в его колоде, и в конце концов одержал победу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350420
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350420,
					"content": "Я понимаю, что этого требовал сюжет, но такой путь к победе расходится с сутью игры «Священный призыв семерых».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350421
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350421,
					"content": "Ну... Я часто играю в «Священный призыв семерых», но игрок из меня не очень... И если описывать карточную игру в романе как своего рода соревнование, получится неинтересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350422
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350422,
					"content": "Хм, да? У меня как раз готовы две колоды. Можем сыграть несколько партий - возможно, это подарит тебе вдохновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350423,
						230350424
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350423,
					"content": "(Теперь они будут в карты дуться...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350424,
					"content": "(Ему лишь бы в карты поиграть...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350425,
					"content": "А? Игр... Играть с вами? С огромным удовольствием, правда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350426,
						230350427
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 230350426,
					"content": "Дай я всё объясню.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350427,
					"content": "У Фукумото есть просьба...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350428,
					"content": "Вы рассказываете о просьбе Фукумото...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230350429,
					"content": "Нужно, чтобы я попозировал для иллюстрации «Короля заклинаний»? Без проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350430
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 230350430,
					"content": "#Отлично! Путешественни{F#ца}{M#к}, скорее! Сделай для меня несколько снимков!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фукумото"
				}
			]
		},
