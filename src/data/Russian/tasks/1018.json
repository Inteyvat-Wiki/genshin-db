			"trigger": {
				"objectNames": [
					"Чайльд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10031801,
					"content": "Вы вернулись. Как всё прошло в Заоблачном пределе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031802
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031802,
					"content": "Понятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031806,
					"content": "Я лично не видел всех Адептов... Не судьба, как говорится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031807
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031807,
					"content": "Если у тебя будет время, можешь наведаться к Адептам ещё раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031808
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031808,
					"content": "Но сведения об Охотнике на демонов представляют большую ценность. В качестве награды я тоже хочу поделиться с тобой информацией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031809
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031809,
					"content": "Что касается смерти Архонта... Реакция Цисин озадачила меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031810
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031810,
					"content": "Цисин объявили, что, поскольку убийца ещё не найден, они не позволят никому проститься с экзувией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031811
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031811,
					"content": "Они пытаются контролировать всю информацию... Но даже Цисин не удастся скрыть произошедшее, ведь на Церемонии Сошествия присутствовало столько людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031812
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031812,
					"content": "Экзувия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031813
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10031813,
					"content": "В Ли Юэ все знают, что Властелин Камня также был одним из Адептов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031814
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031814,
					"content": "Гео Архонт известен не только как бог контрактов, но и как верховный Адепт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031815
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031815,
					"content": "Давным-давно просветлённые и всемогущие Адепты заключили контракт, согласно которому они обязаны защищать Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031816
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031816,
					"content": "Вот оно что... Поэтому они так беспокоятся о благополучии Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031817
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10031817,
					"content": "Конечно. Они в этом заинтересованы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031818
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031818,
					"content": "Если правящая группировка Цисин не будет соблюдать условия контракта, у Адептов будет право вмешаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031819
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031820,
					"content": "Это ставит меня в затруднительное положение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031821,
					"content": "Это недопустимое поведение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031819,
					"content": "Душа Гео Архонта вознеслась на небеса, зачем же Цисин скрывает его тело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031820,
						10031821
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031822,
					"content": "Да! Мы сами пришли в Ли Юэ на поиски Гео Архонта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031823
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10031823,
					"content": "Если Цисин никого не подпускают к экзувии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031824
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10031824,
					"content": "#То {NICKNAME} не сможет встретиться с семью Архонтами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031825
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10031826,
					"content": "Не твоё дело.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031827,
					"content": "Я не могу об этом говорить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031825,
					"content": "Хм. Ты хочешь встретиться с семью Архонтами? Зачем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031826,
						10031827
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031828,
					"content": "Хороший ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031829
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031829,
					"content": "Хороший рыцарь не должен доверять Фатуи, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031830
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031830,
					"content": "Но на этот раз я хочу тебе помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031831
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031831,
					"content": "Правда? Ты серьёзно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031832
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10031832,
					"content": "Дай мне немного времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031833
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031833,
					"content": "Мне нужно кое-кого отыскать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031834
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031834,
					"content": "Того, кто поможет вам найти выход из сложного положения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031835
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031835,
					"content": "Замечательно. Чем больше Цисин хотят замять эту ситуацию, тем сильнее всё погружается в хаос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031836
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 10031836,
					"content": "Если хочешь узнать, чем всё это закончится, постарайся остаться в живых до нашей следующей встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайльд"
				}
			]
		},
