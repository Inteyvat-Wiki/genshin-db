				]
			},
			"dialogs": [
				{
					"id": 741650101,
					"content": "Я... чувствую «разум». Прибывшие, кто вы - преемники Нарциссенкрейца или угроза?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650102
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650102,
					"content": "Вы достали оружие. Ответ очевиден.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650103
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650103,
					"content": "Нарциссенкрейц...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650104
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741650104,
					"content": "Что? Это Нарциссенкрейц?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741650105,
					"content": "Раз вы услышали моё имя, то знаете о моём намерении спасти мир. Раз услышали вы имя моё, то в сознании вашем посеяно семя спасения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650106
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650106,
					"content": "Раз вы направляете на меня оружие своё, значит, вы объяты ложью. В таком случае я не буду тратить свою энергию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650107
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650107,
					"content": "Радуйтесь и ликуйте. А теперь верните мне Чудесный меч и спрячьтесь. Ибо, когда всё будет сказано и сделано, я дам вам ответы и покажу всё, что должен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650108
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650108,
					"content": "Мы не отдадим тебе Чудесный меч.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741650109,
					"content": "Глупцы, глупцы. Но я прощаю вас и готов спасать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650110
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650110,
					"content": "Я почувствовал, что четыре ортанта повернулись вспять, но картина древа потока ещё не закончена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650111
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650111,
					"content": "У меня нет возможности спасти всех. Я проявлю всё своё сострадание, даже если это будет означать истощение моих жизненных сил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650112
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650112,
					"content": "Если у меня будет возможность спасти только половину людей, я постараюсь сделать всё возможное, чтобы спасти шестерых из десяти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650113
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650113,
					"content": "Я иду за Чудесным мечом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нарциссенкрейц"
				}
			]
		},
		{
			"id": 7416502,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
