				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нарциссенкрейц",
					"Анн"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.815,
							-76,
							3381.435
						],
						"pointId": 6766
					},
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650201,
					"content": "Не бывать этому... Я уже достиг точки невозврата. Как я дошёл до такого состояния?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650202
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650202,
					"content": "Контроль над Первозданным морем также полностью утрачен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650203
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650203,
					"content": "Почему так произошло? Почему же вы так поступили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650204
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650204,
					"content": "Новый мир не может родиться. Всё умрёт в оболочке, в скорлупе мечты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650205
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650205,
					"content": "Паймон считает, что это ты должен поскорее проснуться от своего сна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741650206,
					"content": "Люди со всего мира должны сообща постараться предотвратить конец света.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741650207,
					"content": "Я понял. Виноват Чудесный меч, ибо он не поддерживал меня. С каждым новым взмахом он уменьшал волю существ, собравшихся вокруг меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650208
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650208,
					"content": "Пока наконец ко мне не вернулась моя слабая смертная суть - моя личность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650209,
						741650215
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650209,
					"content": "Первозданное море разливается не так быстро.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650210
					]
				},
				{
					"id": 741650210,
					"content": "Я уже давно заметил, что во входных значениях первой заложенной мной мировой формулы произошли изменения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650211
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650211,
					"content": "Кто захватил власть над жизнью? Кто создал страну зверей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650212
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650212,
					"content": "Есть ещё одна переменная, и это ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650213
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650213,
					"content": "Человек, которому суждено увидеть поражение всепоглощающего кита и который доведёт дело до конца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650214
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650214,
					"content": "Хм, понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650221,
					"content": "Я тоже мечтал стать кем-то вроде тебя. Но эта мечта теперь разбита вдребезги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650222
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650222,
					"content": "Всё, что я делаю, бессмысленно, как пустой сон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650223
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650223,
					"content": "Нет, даже не так хорошо, как сон. По крайней мере, сны безвредны. А они отдали слишком многое за это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650224
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650224,
					"content": "Нарциссенкрейц.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650225
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741650225,
					"content": "Ах, это ты. А я и не заметил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650226
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650226,
					"content": "Ты знаешь, кто я?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650227
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741650227,
					"content": "Имя - это всего лишь обращение. Я очень хорошо знаю, какие два цвета смешались в твоей душе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650228
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650228,
					"content": "Директор Лирис, не понимая, что произошло, подхватила ещё дышащую Мари-Анн и обняла её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650229
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650229,
					"content": "Не в силах разобраться в столь сложном настоящем и будущем, Лирис сделала то единственное, что могла, - задержала прошлое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650230
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650230,
					"content": "Меня зовут Анн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650231
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741650231,
					"content": "Привет, Анн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650232
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650232,
					"content": "Я готова тебя простить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650233
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741650233,
					"content": "Ты говоришь странные вещи. Во-первых, мной двигали лишь благородные и священные цели. Никаких личных чувств.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650234
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650234,
					"content": "Никто не может судить или критиковать меня. Да и прощение мне не нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650235
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650235,
					"content": "Твои намерения могут быть благородными, но твоё безумие ранило очень многих людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650236
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741650236,
					"content": "Ты даже формулу перепутал. Разве странно, что тебя прощают за ошибку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650237
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741650237,
					"content": "...Ты права. Мне очень жаль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650238
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650238,
					"content": "Нарциссенкрейц, возвращайся с нами. Тебе нужно встретиться с остальными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650239
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 741650239,
					"content": "Кажется, он стал гораздо охотнее сотрудничать. Но такая просьба...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650240
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741650240,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650241
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650241,
					"content": "Но разве обычно не должна быть фаза внутреннего конфликта с часами последующих уговоров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650242
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741650242,
					"content": "Как я уже говорил, я не чувствую себя виноватым ни в чём. Моя миссия провалилась, но мир всё равно был спасён.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650243
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650243,
					"content": "Пусть другие укоряют меня и насмехаются надо мной. Моё сердце опустело, в нём осталась только жажда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650244
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650244,
					"content": "Жажда чего?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650245
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741650245,
					"content": "Я тоже хочу вернуться к самому началу - к тому времени, когда герой Нарциссенкрейц ещё не вступил на свой путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650246
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650246,
					"content": "Но это уже невозможно. В конце концов, не сам человек решает свою судьбу, теперь я не способен даже о чём-либо мечтать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650247
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650247,
					"content": "#Ну что ж, рыцарь {NICKNAME}, когда будешь готов{F#а}, давай снова запечатаем Первозданное море и покинем это место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анн"
				},
				{
					"id": 741650215,
					"content": "Тот кит уже побеждён.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650216
					]
				},
				{
					"id": 741650216,
					"content": "Я должен был заметить, что во входных значениях первой заложенной мной мировой формулы произошли изменения - появилась некая «переменная».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650217
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650217,
					"content": "Не всё, что приходит извне Вселенной, можно назвать «сошествием» или «переменной».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650218
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650218,
					"content": "Оказывается, я забыл об одной «переменной». И это ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650219
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650219,
					"content": "Свидетель всего сущего, регистратор всего сущего, архитектор всего сущего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650220
					],
					"speakerTitle": "Нарциссенкрейц"
				},
				{
					"id": 741650220,
					"content": "Только тот, чьи ценности равны мировым, достоин этого звания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Нарциссенкрейц"
				}
			]
		},
