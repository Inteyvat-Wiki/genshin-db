			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эмбер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530501,
					"content": "Волчья шерсть. В Ли Юэ из такой шерсти делают кисти для каллиграфии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530502
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530502,
					"content": "Она совсем не похожа на шерсть мондштадтских волков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530503
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530503,
					"content": "На разных частях тела волосы разные. У волков тоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4530504,
					"content": "Посмотри на это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530505
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530505,
					"content": "Ещё один клок. А это что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530506,
						4530507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4530506,
					"content": "Семечко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				},
				{
					"id": 4530508,
					"content": "Это волчий крюк. Посмотри, на семечке много маленьких крючков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530509
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530509,
					"content": "Они растут только в Вольфендоме и каньоне Светлой короны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530510
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530510,
					"content": "Значит, это всё-таки волки из Вольфендома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4530511,
					"content": "Возможно, что на их территорию вторглись другие волчьи стаи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530512
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530512,
					"content": "Это хорошая зацепка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530513
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530513,
					"content": "Но сначала я поговорю с жителями деревни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530507,
					"content": "Что в нём особенного?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				}
			]
		},
		{
