					"nextDialogs": [
						4530803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4530803,
					"content": "Недостаточно кальция в организме.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
