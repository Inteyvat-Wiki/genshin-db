			"dialogs": [
				{
					"id": 4530101,
					"content": "Бедняга... Он даже не может стоять...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530102
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 4530102,
					"content": "Какой ужас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530103
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530103,
					"content": "Но... у него нет ран.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4530104,
					"content": "Он так сильно испугался волков, что теперь не может пошевелиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530105
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 4530105,
					"content": "Это... ужасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530106
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530106,
					"content": "Ты запомнил что-нибудь необычное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530107
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530107,
					"content": "Я... Я... Первый р-раз в жизни у-увидел в-волка... он был очень с-страшный!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530108
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4530108,
					"content": "Никаких зацепок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530109
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530109,
					"content": "Нужно осмотреться вокруг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				}
			]
		},
		{
			"id": 45305,
			"completionStepIds": [
				45305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
