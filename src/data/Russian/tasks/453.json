				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530601,
					"content": "Как идёт расследование?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530602
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4530602,
					"content": "Ого! Ты стоишь на ногах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4530603,
					"content": "Хвала богам, я поправился! Мне удалось восстановиться после этого ужасного потрясения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530604
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4530604,
					"content": "Вам удалось что-нибудь выяснить, рыцари?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530605
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4530605,
					"content": "Судя по шерсти, которую мы нашли, волки пришли из Вольфендома. Пока это всё, что мы знаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530606
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530606,
					"content": "Не переживайте! Мы сейчас же отправляемся в Вольфендом, чтобы всё выяснить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530607
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530607,
					"content": "Рыцари Ордена Фавониус в ответе за вашу безопасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530608
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530608,
					"content": "Ну хоть так. Лучше поздно, чем никогда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530609
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4530609,
					"content": "Как грубо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4530610,
					"content": "Ну а пока... Мы будем сами решать свои проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530611
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4530611,
					"content": "Пожалуйста, не делайте глупостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530612
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530612,
					"content": "Ха-ха! Мы знаем, как разобраться с этими волками. Они заплатят за всё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530613
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4530613,
					"content": "Пойдём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530614
					],
					"speakerTitle": "Великолепный Хопкинс"
				},
				{
					"id": 4530614,
					"content": "Это ужасно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530615
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 4530615,
					"content": "Что именно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530616
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4530616,
					"content": "Их перспективы на будущее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530617
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 4530617,
					"content": "#Соглас{M#ен}{F#на}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530618
					]
				},
				{
					"id": 4530618,
					"content": "Молодые люди бывают крайне вспыльчивы. Если тебя не затруднит, пригляди за ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530619
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 4530619,
					"content": "Без проблем! В конце концов, это наша работа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530620
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530620,
					"content": "Мы займёмся этим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530621
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4530621,
					"content": "Держим путь в Вольфендом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
