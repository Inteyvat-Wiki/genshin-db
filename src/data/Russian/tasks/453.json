			"dialogs": [
				{
					"id": 4530701,
					"content": "Следы когтей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4530702,
					"content": "Мы можем узнать, сколько было волков и какого они размера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4530703,
					"content": "Как минимум два волка... И они...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4530704,
					"content": "Большие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530705
					]
				},
				{
					"id": 4530705,
					"content": "Да.. Они... Как минимум два метра ростом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4530706,
					"content": "Паймон... Ты когда-нибудь видела волка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530707
					]
				},
				{
					"id": 4530707,
					"content": "Ну... Волки достаточно редкие создания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
