			"dialogs": [
				{
					"id": 751120301,
					"content": "#Хм... {M#Чужеземный воин}{F#Чужеземная воительница}, у меня есть к тебе просьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
