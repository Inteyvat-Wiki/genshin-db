				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140501,
					"content": "Ой! Вы вернулись так скоро? Поручение выполнено?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140502
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140502,
					"content": "Да, выполнено.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140503
					]
				},
				{
					"id": 708140503,
					"content": "Ничего себе! Я только что была в гильдии и рассортировала все поручения согласно тому, что дала вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140504
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140504,
					"content": "Поручений, связанных с чудовищами, целая куча. Так искатели приключений этим постоянно и занимаются...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140505
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140505,
					"content": "Ещё нам докладывали о занявших дороги Похитителях сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140506
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140506,
					"content": "Разве это задание для искателей приключений? По мне так с ними обязаны разбираться Миллелиты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140507,
						708140509
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140507,
					"content": "А поручи это дело мне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140508
					]
				},
				{
					"id": 708140508,
					"content": "Ну, раз так... Выходит, что нет ничего, с чем бы искатели приключений не справились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140511,
					"content": "Тогда я подготовлю соответствующее вознаграждение, а вы беритесь за это поручение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140512
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140512,
					"content": "Что, ещё одно поручение? Нам ведь за прошлое не...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 708140513,
					"content": "Я уже переговорила с мисс Лань. Справитесь с заданием - получите ещё больше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140514
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140514,
					"content": "Так-то лучше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140515
					]
				},
				{
					"id": 708140515,
					"content": "Я знала, что вы мне поможете!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140516
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140516,
					"content": "Два поручения одним махом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140517
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140517,
					"content": "Секретный способ мисс Лань и правда работает. Они с радостью берут поручения и остаются довольны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140509,
					"content": "Лишь бы платили прилично...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140510
					]
				},
				{
					"id": 708140510,
					"content": "Искатели приключений так хороши... Кажется, им под силу абсолютно всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Тянь Тянь"
				}
			]
		},
