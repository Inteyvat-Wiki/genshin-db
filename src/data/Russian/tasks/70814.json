					"Тянь Тянь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140301,
					"content": "В-вы искатель приключений? Вы за поручениями, да?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140302
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140302,
					"content": "Эм... Подождите, пожалуйста... Так, что у меня тут... «Гонки на планерах», «Гид по выживанию», ещё «Тренер по скалолазанию»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140303
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140303,
					"content": "Это больше похоже на биржу труда...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140304
					]
				},
				{
					"id": 708140304,
					"content": "Знаю! Мисс Лань тоже так говорит. Но это ведь приключения! Я о них читала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140305
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140305,
					"content": "Если эти поручения не давать, то какие давать тогда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140306
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140306,
					"content": "Ну, какие-нибудь с уничтожением чудовищ, например...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140307
					]
				},
				{
					"id": 708140307,
					"content": "Н-но это опасно! То есть в предместье Лиша их много, и они представляют угрозу для прохожих.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140308
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140308,
					"content": "Но обычным людям с ними не справиться. Так и покалечиться можно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140309,
						708140311
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140309,
					"content": "Просто оставь это мне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140310
					]
				},
				{
					"id": 708140310,
					"content": "Серьёзно? Тогда... Поручение ваше. Я скажу мисс Лань, чтобы она оплатила ваши услуги должным образом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140311,
					"content": "Искатели приключений - люди не обычные.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140312
					]
				},
				{
					"id": 708140312,
					"content": "Вот как... Т-тогда поручение ваше. Я скажу мисс Лань, чтобы она оплатила ваши услуги должным образом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тянь Тянь"
				}
			]
		},
