			"dialogs": [
				{
					"id": 708140701,
					"content": "Вы уже выполнили поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140702
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140702,
					"content": "Готово.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140703
					]
				},
				{
					"id": 708140703,
					"content": "Ого... Неужели искатели приключений так могучи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140704
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140704,
					"content": "Вы не против, если я задам пару вопросов об искателях приключений и поручениях?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140705
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140705,
					"content": "Хм... Какие ещё поручения, кроме истребления чудовищ, принимают искатели приключений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140706,
						708140707,
						708140708
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140706,
					"content": "Мы помогаем чинить дома и телеги.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140709,
					"content": "Ого, то есть искатели приключений делают всё? Удивительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140710
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140710,
					"content": "Спасибо! Надо бы всё записать... Ах, да. Вот ваша награда. Здесь очень много!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140711
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140711,
					"content": "Когда вы придёте в следующий раз, я дам вам только лучшие поручения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тянь Тянь"
				},
