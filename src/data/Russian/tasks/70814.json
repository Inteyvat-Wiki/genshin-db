			"dialogs": [
				{
					"id": 708140201,
					"content": "Что-нибудь ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140202
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 708140202,
					"content": "Ты нашла тот меч, который искала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140203
					]
				},
				{
					"id": 708140203,
					"content": "#...О, ты ещё не забыл{F#а}. К сожалению, я не имею ни малейшего понятия, где он может быть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140204
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 708140204,
					"content": "Я, похоже, пока только на этапе бесплодных поисков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140205
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 708140205,
					"content": "Если появится связанное с ним поручение, не исключено, что оно достанется именно тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140206
					],
					"speakerTitle": "Мисс Лань"
				}
			]
		},
		{
			"id": 7081403,
			"completionStepIds": [
				7081401
			],
