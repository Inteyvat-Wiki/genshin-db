			"dialogs": [
				{
					"id": 708140401,
					"content": "Неужели все искатели приключений занимаются такими опасными вещами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140402
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 708140402,
					"content": "А если они поранятся?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тянь Тянь"
				}
			]
		},
		{
			"id": 7081405,
			"completionStepIds": [
