			"dialogs": [
				{
					"id": 50202001,
					"content": "Атея... одна из старейшин, которую я уважаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202002
					],
					"speakerTitle": "Амина"
				},
				{
					"id": 50202002,
					"content": "После смерти моего дедушки старейшины выбрали меня вождём племени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202003
					],
					"speakerTitle": "Амина"
				},
				{
					"id": 50202003,
					"content": "У меня всегда было много новых и смелых идей, поэтому никто и не сомневался, что я смогу привести наше племя к новому будущему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202004
					],
					"speakerTitle": "Амина"
				},
				{
					"id": 50202004,
					"content": "Но я долго не знала, что делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202005
					],
					"speakerTitle": "Амина"
				},
				{
					"id": 50202005,
					"content": "Атея всегда поддерживала меня. Даже когда я ошибалась, она не ругала, а помогала разобраться, чтобы в следующий раз я могла сделать лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202006
					],
					"speakerTitle": "Амина"
				},
				{
					"id": 50202006,
					"content": "Я очень её уважаю. А поэтому... буду следовать её советам и постараюсь стать достойным вождём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Амина"
				}
			]
		}
	]
