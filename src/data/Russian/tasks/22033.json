			},
			"dialogs": [
				{
					"id": 220330201,
					"content": "Уже готово? Ты, часом, не повар под прикрытием?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330202
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220330202,
					"content": "Мм... Не могу дождаться, так хочется попробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330203,
						220330204
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220330203,
					"content": "Милости прошу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220330204,
					"content": "Посмотрим... О каких блюдах мы только что говорили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330205
					]
				},
				{
					"id": 220330205,
					"content": "Верно... Рисовые пампушки, печенье лотоса и трёхцветное данго!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220330206,
					"content": "Давай выберем одно и подадим его мисс Тан Вэнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 2203303,
			"completionStepIds": [
				2203303
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203303",
							"2"
						],
						"stepId": 2203303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тан Вэнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330301,
					"content": "Ах! Вот оно то самое! Вкус дома, который я воображала в своих мечтаниях... Он... *всхлипывает* Я так тронута...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330302
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220330302,
					"content": "Огромное спасибо! Я чувствую себя вновь ожившей после всей этой великолепной пищи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330303
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220330303,
					"content": "Это тебе и попутного ветра тебе в твоих путешествиях, друг мой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тан Вэнь"
				}
			]
		},
		{
			"id": 2203304,
			"completionStepIds": [
				2203304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203304",
							"2"
						],
						"stepId": 2203304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тан Вэнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330401,
					"content": "Хм, этот вкус... что-то не очень похоже на что бы то ни было из Ли Юэ, хотя и на инадзумскую кухню тоже не особо. Это какой-то новый для меня вкус...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330402
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220330402,
					"content": "Хотя это не та кухня, которой мне так хотелось отведать, я всё равно довольна тем, что смогла попробовать такое необычное блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330403
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220330403,
					"content": "#Благодарю тебя, путешественни{F#ца}{M#к}. Пожалуйста, прими это от меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тан Вэнь"
				}
			]
		},
		{
			"id": 2203305,
			"completionStepIds": [
				2203305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203305",
							"2"
						],
						"stepId": 2203305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тан Вэнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330501,
					"content": "Эх? Похоже, что это всего лишь ещё одно инадзумское блюдо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330502
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220330502,
					"content": "Мне кажется, что я просила не об этом... Что же, неважно, как бы там ни было - грех жаловаться на такую сытную еду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330503
					],
					"speakerTitle": "Тан Вэнь"
				},
				{
					"id": 220330503,
					"content": "#В любом случае спасибо тебе, путешественни{F#ца}{M#к}. Пожалуйста, возьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тан Вэнь"
				}
			]
		},
		{
			"id": 2203306,
			"completionStepIds": [
				2203306
			],
			"beginWay": "TALK_BEGIN_AUTO",
