			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330701,
					"content": "Итак, какую закуску нам приготовить? Как насчёт того, чтобы самим выбрать что-нибудь для неё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220330702,
					"content": "Посмотрим... Мои любимые закуски в последнее время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220330703,
					"content": "Дешевые, но вкусные рисовые пампушки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220330704,
					"content": "Восхитительно хрустящее печенье лотоса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220330705,
					"content": "Мягкое и немного клейкое трёхцветное данго!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220330706,
					"content": "Это всё - твои любимые блюда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330707
					]
				},
				{
					"id": 220330707,
					"content": "Хе-хе, доверься моему вкусу! Поспеши и выбери одно из них...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330708,
						220330710,
						220330712,
						220330714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220330708,
					"content": "Рисовые пампушки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330709
					]
				},
				{
					"id": 220330709,
					"content": "Отлично! Скорее же приготовим мисс Тан Вэнь рисовые пампушки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220330710,
					"content": "Печенье лотоса.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330711
					]
				},
				{
					"id": 220330711,
					"content": "Да! Вперёд готовить печенье лотоса для мисс Тан Вэнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220330712,
					"content": "Трёхцветное данго.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330713
					]
				},
				{
					"id": 220330713,
					"content": "Замечательно! Приступаем к приготовлению трёхцветного данго для мисс Тан Вэнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220330714,
					"content": "Дай ещё подумаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330715
					]
				},
				{
					"id": 220330715,
					"content": "Мм, давай решим и скорее приступим к приготовлению блюда для мисс Тан Вэнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
