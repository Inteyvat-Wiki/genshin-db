			},
			"dialogs": [
				{
					"id": 741185001,
					"content": "#Я всегда к вашим услугам, {F#милая}{M#милый} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185002,
						741185008,
						741185014
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741185002,
					"content": "Что вы собираетесь делать дальше?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185003
					]
				},
				{
					"id": 741185003,
					"content": "Думаю, мы должны установить личности этих людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185004
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741185004,
					"content": "Мы уже поставили в известность жандармов, но пока у нас нет ни одной зацепки. И офицеры не знают, с чего начинать поиски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185005
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741185005,
					"content": "И потом, Кур-де-Фонтейн - большой город, офицеры не смогут охранять нас всюду, куда бы мы ни пошли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185006
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741185006,
					"content": "А теперь с нами госпожа Кайя... и всё стало ещё сложнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185007
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741185007,
					"content": "Надеюсь, господин Гарсия сумеет убедить госпожу Кайю как можно скорее уехать из Фонтейна. Тогда мы сможем следовать выработанному плану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741185008,
					"content": "Но ведь исследования Гарсии зашли в тупик, разве нет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185009
					]
				},
				{
					"id": 741185009,
					"content": "«Тупик» означает, что функции машины невозможно вывести на новый уровень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185010
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741185010,
					"content": "Тем не менее Числовая машина способна решать великое множество практических задач.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185011
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741185011,
					"content": "Просто господин Гарсия мало заботится о том, как внедрить своё изобретение в жизнь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185012
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741185012,
					"content": "Думаю, именно поэтому в его жизни столько огорчений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185013
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741185013,
					"content": "И возможно, именно поэтому он так вжился в роль отчаявшегося исследователя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741185014,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185015
					]
				},
				{
					"id": 741185015,
					"content": "Спасибо вам за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				}
			]
		},
