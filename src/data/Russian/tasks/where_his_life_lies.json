				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лу Тун"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3508.936,
							459.464,
							3665.876
						],
						"pointId": 5698
					}
				]
			},
			"dialogs": [
				{
					"id": 741180301,
					"content": "...Здесь нас не услышат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180302
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180302,
					"content": "Я расскажу всё по порядку. В Сумеру вы помогли нам усовершенствовать Числовую машину, и нам удалось добиться прорыва в её производительности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180303
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180303,
					"content": "Господин Гарсия был очень воодушевлён и решил продолжать работу над машиной. Но, по его словам, приводная система традиционных механизмов имеет свои ограничения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180304
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180304,
					"content": "Производительность Числовой машины достигла своего предела, поэтому мы решили вернуться в Фонтейн, чтобы найти новые идеи для исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180305
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180305,
					"content": "Но когда мы вернулись, господину Гарсии назначил встречу один странный тип.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180306
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180306,
					"content": "Он сказал, что готов спонсировать исследования господина Гарсии, готов даже помочь ему собрать команду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180307
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180307,
					"content": "Но взамен он хочет, чтобы господин Гарсия поделился с ним проектом Числовой машины со всеми данными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180308,
						741180309
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180308,
					"content": "Гарсия никогда на такое не пойдёт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				},
				{
					"id": 741180310,
					"content": "Да! Он хочет заполучить результаты чужих исследований! Это ведь самый настоящий грабёж!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741180311,
					"content": "Именно. Поэтому господин Гарсия ответил резким отказом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180312
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180312,
					"content": "Но после мы заметили, что за нами следят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180313
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180313,
					"content": "Мало того, пока нас не было, кто-то побывал в нашем жилище, рылся в вещах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180314
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180314,
					"content": "Они старались действовать незаметно, но господин Гарсия увидел, что некоторые вещи лежат не на своих местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180315
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180315,
					"content": "Ужас какой... Ему отказали, а он решил добиться своего силой?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741180316,
					"content": "Обнаружив, что кто-то рылся в наших вещах, мы решили как можно скорее собрать денег на обратную дорогу и вернуться в Петрикор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180317
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180317,
					"content": "Там мы выйдем на связь с остальными членами Клуба праздных мечтателей и вместе придумаем, как решить проблему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180318
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180318,
					"content": "И потом, Петрикор... можно сказать, это крепость господина Гарсии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180319
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180319,
					"content": "Для него нет места безопаснее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180320
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180320,
					"content": "Изначально мы планировали отправиться в Петрикор уже сегодня, потому я и хотел просить вас о сопровождении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180321
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180321,
					"content": "Не думал, что мы встретим здесь госпожу Кайю... Из соображений безопасности мне пришлось отправить их с господином Гарсией в город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180322,
						741180323
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180322,
					"content": "Что я могу сделать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180324,
					"content": "Видимо, нам придётся отложить возвращение в Петрикор. Прошу, отыщите господина Гарсию и не отходите от него ни на шаг. Как я уже говорил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180325
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180325,
					"content": "#Под защитой {F#знаменитой путешественницы}{M#знаменитого путешественника} мы избежим многих неприятностей в дороге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180326,
						741180327
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180326,
					"content": "Я пойду к нему сейчас же.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180330
					]
				},
				{
					"id": 741180330,
					"content": "Господин Гарсия расскажет обо всём госпоже Кайе. А что будет дальше... зависит от госпожи Кайи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180331
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180331,
					"content": "Словом, нам нужно как можно скорее вернуться в город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180327,
					"content": "Им ведь ничего не угрожает?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180328
					]
				},
				{
					"id": 741180328,
					"content": "Не думаю. Пока господин Гарсия остаётся в Кур-де-Фонтейне, он в безопасности, ведь город постоянно патрулируют жандарматоны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180329
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180329,
					"content": "Если злодеи надумают применить силу, Палата Жардинаж сможет уладить проблему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180330
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180323,
					"content": "Чем я могу помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180309,
					"content": "Вряд ли это порядочный человек.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				}
			]
		},
