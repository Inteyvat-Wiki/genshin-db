			"dialogs": [
				{
					"id": 741180501,
					"content": "Добрый день. Чем я могу вам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180502
					],
					"speakerTitle": "Монт"
				},
				{
					"id": 741180502,
					"content": "Ну, если коротко...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180503
					]
				},
				{
					"id": 741180503,
					"content": "Вы вводите офицера Монт в курс дела...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180504
					]
				},
				{
					"id": 741180504,
					"content": "Значит, дело касается господина Гарсии. Я поняла. Идите за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180505
					],
					"speakerTitle": "Монт"
				},
				{
					"id": 741180505,
					"content": "Так мы хотя бы отпугнём того подозрительного типа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Монт"
				}
			]
		},
		{
