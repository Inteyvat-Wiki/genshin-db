							4553.841
						],
						"pointId": 5693
					}
				]
			},
			"dialogs": [
				{
					"id": 741180101,
					"content": "...Господин, я думаю, нам стоит вернуться в Петрикор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180102
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180102,
					"content": "Пусть господина Ксавье и господина Феликса там сейчас нет, но Мекантре и Бабис должны быть в деревне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180103
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180103,
					"content": "Может, они дадут вам какие-то советы или подсказки. Даже если они ничем не помогут, хотя бы выслушают вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180104
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180104,
					"content": "Дорогой мой Лу Тун, нет... Исследования Мекантре и Бабиса сейчас находятся на самом подъёме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180105
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 741180105,
					"content": "В своём последнем письме они упомянули, что в Петрикор приехал некий учёный господин из Исследовательского института.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180106
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 741180106,
					"content": "Этот господин Боссюэ обладает богатым опытом и обширными познаниями, с его помощью они прояснили множество вопросов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180107
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 741180107,
					"content": "А я... эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180108,
						741180109
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 741180108,
					"content": "Гарсия?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				},
				{
					"id": 741180110,
					"content": "#{NICKNAME}, какая неожиданная встреча! Не думал, что мы увидимся в Фонтейне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180111
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180111,
					"content": "Хотя... вы опять появились в самый подходящий момент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180112
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180112,
					"content": "#Да, подходящий момент... И всё равно я очень рад тебя видеть, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180113
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 741180113,
					"content": "Ого, какой у него измученный вид! И чёрные круги под глазами... Похоже, сил у него не осталось ни капельки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741180114,
					"content": "Гарсия, что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180115
					]
				},
				{
					"id": 741180115,
					"content": "Мы... эм... в ходе своего исследования господин столкнулся с беспрецедентными трудностями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180116
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180116,
					"content": "Но это долгая история. Сейчас мы направляемся в оперный театр «Эпиклез», нужно помочь театру подбить счета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180117
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180117,
					"content": "А когда работа будет сделана, сможем сесть где-нибудь в спокойном месте и как следует побеседовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180118
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180118,
					"content": "У вас появилась работа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180119
					]
				},
				{
					"id": 741180119,
					"content": "Не назвал бы это работой. Иногда нас нанимают, чтобы выполнить разные расчёты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180120
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180120,
					"content": "В последнее время в театре «Эпиклез» выступало много разных трупп, и театру срочно нужно навести порядок в бухгалтерских книгах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180121
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180121,
					"content": "Поэтому, чтобы заработать денег на дорогу до Петрикора, мы... я решил взять это поручение вместо господина Гарсии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180122
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180122,
					"content": "Это всё равно как забивать гвозди микроскопом! Подобные «расчёты» настолько просты, что их выполнит даже ребёнок. Я мог бы сделать всё это за день, даже не пользуясь Числовой машиной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180123
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 741180123,
					"content": "Именно поэтому для нас это отличный способ заработка. Господин Гарсия, нам пора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180124
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180124,
					"content": "#Да, {NICKNAME}, могу я попросить вас составить нам компанию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180125
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180125,
					"content": "#Под защитой {F#знаменитой путешественницы}{M#знаменитого путешественника} мы избежим многих неприятностей в дороге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180126
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180126,
					"content": "Конечно, мы заплатим подобающее вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180127,
						741180128
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180127,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180129,
					"content": "Как знать... Хе-хе, ладно, давайте отправимся в путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180128,
					"content": "Вряд ли в городе вас будут подстерегать опасности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180109,
					"content": "Ты вернулся в Фонтейн?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				}
			]
		},
		{
