			"dialogs": [
				{
					"id": 741180401,
					"content": "...Как я и думал, они продолжают следить за господином Гарсией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180402
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180402,
					"content": "Видите, у стола рядом со стойкой сидит мужчина, перед ним шляпа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180403
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180403,
					"content": "Уверен, это он следил за нами все последние дни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180404,
						741180405
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180404,
					"content": "Я позову жандармов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				},
				{
					"id": 741180406,
					"content": "Правильное решение... И я как раз вижу рядом офицера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180407
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180407,
					"content": "Раньше мы уже сообщали о наших проблемах офицеру Монт, она всё знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180408
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180408,
					"content": "Уверен, она нам поможет. И в присутствии офицера жандармерии эта шайка не станет совершать глупости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180409
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 741180409,
					"content": "#{NICKNAME}, пожалуйста, объясни офицеру Монт, что происходит. А я пока поговорю с господином Гарсией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180410
