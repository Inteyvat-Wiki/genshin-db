			"trigger": {
				"objectNames": [
					"Араджа",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730470101,
					"content": "#Нара {NICKNAME}, Паймон, а вот и вы. Хе-хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470102
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730470102,
					"content": "Выглядишь так радостно, Араджа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730470103,
					"content": "Хе-хе-хе... Так здорово видеть Ванарану такой оживлённой. Столько аранар вернулось домой, эх! Даже и не представлялось, что смогу присутствовать на Празднике Утсава...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470104,
						730470105
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730470104,
					"content": "Разве это твой первый раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470107
					]
				},
				{
					"id": 730470107,
					"content": "Есть одна история, повествующая о моём участии в этом празднике. Это было давным-давно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470108
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730470108,
					"content": "Там были я, Арамухукунда, Арана, Арадзи... Все аранары отмечали Праздник Утсава вместе с нарой Варуной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470109
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730470109,
					"content": "То были тяжкие времена. Но на Празднике Утсава мы все смеялись и пели. Это моя любимая история.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470110
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730470110,
					"content": "А? Значит, это не первый раз Араджи на Празднике Утсава?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730470111,
					"content": "Судя по сохранившимся историям, да. Но всё уже давно позабыто. Об этом мне потом Арана и другие рассказали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470112
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730470112,
					"content": "Так вот почему слова Араджи звучат, как слова деда. Наверное, ты стареешь, вот и не помнишь ничего!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730470113,
					"content": "#А может это и к лучшему... Нара {NICKNAME}, Паймон, примете ли вы от меня этот подарок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470114
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730470114,
					"content": "Это цветочек...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730470115,
					"content": "Угу. Надеюсь, отныне он всегда будет сопровождать вас в ваших будущих путешествиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470116,
						730470117
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730470116,
					"content": "Я с радостью приму этот подарок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470118,
					"content": "Время нар гораздо ценнее времени аранар. Не буду мешать вам наслаждаться весельем. Позже я бы хотел, чтобы вы отыскали Аракави. Он тоже готовится к церемонии Праздника Утсава.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730470117,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470105,
					"content": "#Я тоже рад{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470106
					]
				},
				{
					"id": 730470106,
					"content": "И Паймон рада! Но разве это первый раз, когда Араджа участвует в Празднике Утсава?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470107
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}