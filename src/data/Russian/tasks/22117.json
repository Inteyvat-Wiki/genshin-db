			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мадам Пин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170301,
					"content": "Ребятишки, чего это вы так легко одеты? Вы же простудитесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170302
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170302,
					"content": "Бабушка, это то, что вы ищете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170303
					]
				},
				{
					"id": 221170303,
					"content": "Надо посмотреть поближе... Да, это оно! Значит, я всё-таки оставила её на горе. Эх, дырявая моя голова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170304
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170304,
					"content": "Спасибо вам, ребятишки. В этой коробке всё равно лежат одни старушечьи безделушки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170305
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170305,
					"content": "А вот это - вам. Спасибо ещё раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170306
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170306,
					"content": "Надо сразу положить коробочку в чайничек, пока я не забыла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мадам Пин"
				}
			]
		},
		{
			"id": 2211704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
