			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мадам Пин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170401,
					"content": "Ребятишки, чего это вы так легко одеты? Вы же простудитесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170402,
						221170406
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170402,
					"content": "Расскажите про янтарные ловушки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170403
					]
				},
				{
					"id": 221170403,
					"content": "Их делает мой старый друг. В эти ловушки обычно попадаются монстры и бандиты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170404
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170404,
					"content": "За много лет янтарь поймал много разных интересных вещей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170405
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170405,
					"content": "Ох уж этот зловещий янтарь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170406,
					"content": "Ваш чайник...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170407
					]
				},
				{
					"id": 221170407,
					"content": "Ой, спасибо вам! Мой чайничек снова со мной. Выглядит совсем как новенький!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170408
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170408,
					"content": "За этим я сюда и приехала, чтобы обновить свой чайник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170409
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170409,
					"content": "Когда он будет в идеальном состоянии, я смогу пригласить гостей и напоить их чаем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мадам Пин"
				}
			]
		}
	]
