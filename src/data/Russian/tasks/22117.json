			"trigger": {
				"objectNames": [
					"Мадам Пин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170101,
					"content": "Неужели я оставила её на горе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170102
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170102,
					"content": "Мадам Пин! Что вы здесь делаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170103
					]
				},
				{
					"id": 221170103,
					"content": "Как здорово, что я вас здесь встретила... Но вы как-то слишком легко одеты. Здесь такой сильный ветер, вы можете простудиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170104
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170104,
					"content": "Я возвращалась в город с горы Хулао, где я встретилась со своим старым другом. Мы очень мило побеседовали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170105
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170105,
					"content": "Но на полпути обратно я поняла, что... Оставила кое-что на вершине горы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170106
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170106,
					"content": "Я уже и так проделала большой путь, и подниматься в гору второй раз... Это слишком много ходьбы для меня... И там повсюду этот надоедливый янтарь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170107
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170107,
					"content": "Ребята, может вы заберётесь для меня на гору? Я буду очень благодарна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170108,
						221170111
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170108,
					"content": "О каком друге вы говорите?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170109
					]
				},
				{
					"id": 221170109,
					"content": "Он живёт на горе Хулао. Вы, должно быть, его встречали... От его янтаря одни проблемы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170110
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170110,
					"content": "У меня уже проблемы с памятью, наверное, я просто забыла положить коробочку в свой чайник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170111,
					"content": "Что именно вы там оставили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170112
					]
				},
				{
					"id": 221170112,
					"content": "Коробочку... Кажется. Память подводит меня. Почему же я сразу не положила её в свой чайничек? Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170113
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170113,
					"content": "По крайней мере, есть шанс, что коробочка попала в янтарную ловушку. Поэтому её будет несложно найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170114
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170114,
					"content": "Ребята, прошу вас, помогите старушке. Принесите мне коробочку с горы Хулао.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170115
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 221170115,
					"content": "Будьте осторожны! Кто знает, что ещё могло попасться в янтарную ловушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мадам Пин"
				}
			]
		},
		{
			"id": 2211703,
			"completionStepIds": [
				2211703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
