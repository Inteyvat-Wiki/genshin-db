					"nextDialogs": [
						240000306
					],
					"speakerTitle": "Карон"
				},
				{
					"id": 240000306,
					"content": "Но ему не стоит питать больших надежд на расторопность Дворца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000307
