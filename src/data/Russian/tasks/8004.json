			"dialogs": [
				{
					"id": 80040501,
					"content": "Мне пришлось немало потрудиться, чтобы получить разрешение на добычу полезных ископаемых. Надеюсь, всё это было не напрасно. Я рассчитываю на вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Юэ Хуэй"
				}
			]
