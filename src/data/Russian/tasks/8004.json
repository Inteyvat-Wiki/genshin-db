			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040101,
					"content": "#А, путешественни{M#к}{F#ца}. Ты вовремя, хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040102
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 80040102,
					"content": "Катерина, есть новые поручения? И... почему это ты так рада видеть нас сегодня? Что ты натворила?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040103,
					"content": "Сегодня я ходила в святилище, чтобы погадать, и жрица сказала мне, что сейчас подходящее время для «неожиданной встречи с друзьями».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040104
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 80040104,
					"content": "Катерина гадает в храме? Это Паймон только кажется, или в это действительно крайне сложно поверить?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040105,
					"content": "А главное - как ты побывала в Инадзуме и вернулась в тот же день? Мы же в Ли Юэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040106,
					"content": "У меня тоже есть личная жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040107
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 80040107,
					"content": "Значит, под словами «неожиданная встреча с друзьями» ты подразумеваешь встречу с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040108,
					"content": "Кто знает?.. Когда предвкушаешь неожиданную встречу, приятно увидеть кого угодно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040109
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 80040109,
					"content": "Вообще-то мы видимся почти каждый день. Ну и ладно, главное, чтобы ты была счастлива.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040110,
						80040111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040110,
					"content": "Неожиданная встреча с друзьями...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				},
				{
					"id": 80040112,
					"content": "#Ты хочешь сказать... Ох, Паймон поняла, о чём ты, {NICKNAME}... Будем надеяться, что предсказания жрицы действительно работают...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040113,
					"content": "#Мы должны {M#её}{F#его} найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040114,
					"content": "Я... сказала что-то не то? Похоже, вы чем-то опечалены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040115
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 80040115,
					"content": "Ничего, ничего. Давай ближе к делу. Есть для нас новое поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040116,
					"content": "Да. У нас есть поручение от одного шахтёра. Нужно провести расследование в Разломе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040117
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 80040117,
					"content": "Что? Проход в Разлом открыт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040118,
					"content": "Пусть тот, кто оставил запрос, сам расскажет подробности. Его зовут Юэ Хуэй. Он должен быть сейчас где-то в Разломе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040119
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 80040119,
					"content": "Хорошо, Катерина. Тогда мы пойдём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040120,
					"content": "Что ж, к звёздам и к безднам!.. На этот раз и правда придётся спуститься к безднам. Удачи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				},
				{
					"id": 80040111,
					"content": "Возможно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				}
			]
		},
		{
			"id": 800402,
			"completionStepIds": [
				800402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800402",
							"2"
						],
						"stepId": 800402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Юэ Хуэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040201,
					"content": "Привет! Ты Юэ Хуэй, да? Нас послала Гильдия искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040202,
					"content": "О, да, рад вас видеть. Это действительно я разместил поручение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040203
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040203,
					"content": "#Постой-ка. Мне отчего-то знакомо твоё лицо... Ты {M#известный искатель}{F#известная искательница} приключений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040204,
						80040205
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040204,
					"content": "Сложно объяснить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				},
				{
					"id": 80040206,
					"content": "Хорошо. Позвольте сперва представиться. Я Юэ Хуэй, шахтёр, недавно я получил разрешение на добычу полезных ископаемых в Разломе. У меня в команде несколько человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040207
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040207,
					"content": "Как тебе удалось получить разрешение на добычу полезных ископаемых в Разломе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040208,
					"content": "Чиновники террасы Юйцзин наконец-то одумались и разрешили добычу полезных ископаемых на небольшой глубине, приставив Миллелитов для защиты. Мы были одними из первых, кто получил разрешение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040209
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040209,
					"content": "Но недавно кое-что произошло, и теперь мои товарищи нервничают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040210
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040210,
					"content": "Что именно? Похоже, мы об этом не слышали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040211,
					"content": "Тут такое дело... Сложно сказать, насколько проблема серьёзная. Просто немного странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040212
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040212,
					"content": "Во время отдыха один из шахтёров заметил нескольких проходивших мимо хиличурлов. Они были будто в трансе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040213
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040213,
					"content": "Даже не взглянув на него, они направились прямо в глубину Разлома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040214
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040214,
					"content": "После этого мой товарищ начал внимательнее следить за обстановкой и обнаружил, что эта история повторяется раз за разом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040215
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040215,
					"content": "Может быть, хиличурлам просто любопытно? Ну там, захотелось прогуляться, посмотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040216,
					"content": "Вряд ли. Самое странное: он обнаружил, что хиличурлы, ушедшие к Разлому...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040217
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040217,
					"content": "...больше не возвращались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040218
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040218,
					"content": "Это дорога в один конец. Как только хиличурлы заходят внутрь, они больше никогда не выходят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040219
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040219,
					"content": "И в последнее время это происходит всё чаще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040220
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040220,
					"content": "«Зачем хиличурлы туда идут? Что с ними происходит? Может быть, нам грозит беда?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040221
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040221,
					"content": "Эти мысли мучают шахтёров. Многие посходили с ума от страха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040222
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040222,
					"content": "Хм... Ну ещё бы... От одной только мысли волосы встают дыбом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040223,
						80040224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040223,
					"content": "Даже не хочу представлять, что происходит внутри Разлома...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040225,
					"content": "Да. Самый сильный страх - это страх неизвестности. Если мы узнаем правду, моим людям будет легче вернуться к работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040226
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040226,
					"content": "Мы правда... э-э-э... хотим принять это поручение? Кхм, господин шахтёр, нам надо сначала всё обдумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040227
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040227,
					"content": "Да, мы берёмся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040228
					]
				},
				{
					"id": 80040228,
					"content": "#Эй! {M#Мог}{F#Могла} бы и притвориться, что интересуешься мнением Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040229,
						80040230
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040229,
					"content": "Подобные странности происходят неспроста...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040231,
					"content": "#А, вот ты о чём... Ну тогда ладно, может, там и правда найдутся какие-то подсказки о {M#твоей сестре}{F#твоём брате}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040232,
					"content": "#Если мы не возьмёмся за это дело, ты {M#сам}{F#сама} себя потом измучаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040233,
					"content": "Что решили? Берётесь? Давить не буду, но... не хочу, чтобы разрешение на добычу полезных ископаемых пропало зря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040234
					],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040234,
					"content": "Ага, мы берёмся. Нам тоже любопытно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040235,
					"content": "Отлично. Буду вам обязан. Укажу вам примерное место, где собираются хиличурлы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Юэ Хуэй"
				},
				{
					"id": 80040230,
					"content": "Подозреваю, что здесь замешан орден Бездны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040224,
					"content": "Это и правда очень странно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040205,
					"content": "Давай лучше сразу к делу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				}
			]
		},
		{
			"id": 800403,
			"completionStepIds": [
				800403,
				800404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
