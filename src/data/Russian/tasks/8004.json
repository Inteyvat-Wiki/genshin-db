			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040301,
					"content": "Да это же... город!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040302,
					"content": "Город... который висит в пустоте... да ещё вверх ногами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040303,
						80040304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040303,
					"content": "Потрясающее зрелище...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040402
					]
				},
				{
					"id": 80040402,
					"content": "#{NICKNAME}, этот город тебе ничего не напоминает?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040403,
					"content": "Хм... Что-то знакомое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040404,
					"content": "Осквернённая статуя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040405
					]
				},
				{
					"id": 80040405,
					"content": "Да, да! Очень похоже: так же странно, так же перевёрнуто и так же жутко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040406,
					"content": "Тогда... Может, орден Бездны и правда замешан в происходящем в Разломе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040407,
					"content": "Мы должны разобраться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040408,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040409,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040410,
						80040411
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040410,
					"content": "Дайнслейф?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				},
				{
					"id": 80040412,
					"content": "Я тоже не ожидал встретить вас здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040413
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040413,
					"content": "Давненько мы не виделись, Дайн... Подожди, как тебя занесло в Разлом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040414,
					"content": "Разлом?.. Мы в глубинах Разлома? Ого... Здесь я ещё не бывал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040415
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040415,
					"content": "Я хочу тебя о многом расспросить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040416
					]
				},
				{
					"id": 80040416,
					"content": "Понимаю твои чувства. В прошлый раз наши встреча и расставание прошли в большой спешке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040417
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040417,
					"content": "Теперь наши пути снова пересеклись... Похоже, тебе суждено получить ответы на твои вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040418,
						80040419
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040418,
					"content": "Сначала объясни, как ты здесь оказался.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040420,
					"content": "Догадаться несложно. Недавно я вышел на след другого Вестника Бездны и пустился за ним в погоню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040421
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040421,
					"content": "Увы, после того как я загнал его в угол, он прибегнул к их излюбленной уловке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040422
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040422,
					"content": "Я прошёл через портал за ним, но, разумеется, без толку. Он привёл меня не в то место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040423,
						80040424
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040423,
					"content": "Это же произошло, когда ты прошёл через портал в прошлый раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040425,
					"content": "Да. Исходя из моего опыта, могу только сделать вывод, что... порталы Бездны не просто соединяют одну точку с другой. Это целая сеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040426
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040426,
					"content": "Они могут выбрать, куда именно перенестись. И это может быть любое место в сети порталов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040427
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040427,
					"content": "Похоже на то, как работают обычные точки телепортации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040428
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040428,
					"content": "#В общем, хотя в тот раз я вошёл в портал сразу после {M#твоей сестры}{F#твоего брата}, но после выхода...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040429
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040429,
					"content": "...я обнаружил себя в одиночестве в логове Ужаса Бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040430
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040430,
					"content": "Кстати, что случилось с глазом первого культиватора?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040431,
					"content": "Он в надёжном месте. Я не допущу, чтобы он попал в руки ордена Бездны, пока не узнаю всю подоплёку операции «Плетение судьбы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040432,
						80040433
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040432,
					"content": "Почему бы тебе не рассказать мне, кто ты на самом деле?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040434,
					"content": "О, ты помнишь это имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040435
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040435,
					"content": "В мои намерения не входило скрывать его от тебя. Когда-то это имя олицетворяло славу Каэнри'ах, но теперь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040436
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040436,
					"content": "...оно скорее жестокая шутка, проклятие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040437
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040437,
					"content": "Сумеречный Меч - так меня называли, когда я служил капитаном дворцовой стражи в те времена, когда моя родина была уничтожена. Думаю, моё нежелание упоминать это прозвище вполне оправдано.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040438
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040438,
					"content": "#Похоже, {M#твоя сестра говорила}{F#твой брат говорил} правду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040439,
						80040440
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040439,
					"content": "#Кстати, о той истории с тобой и {M#моей сестрой}{F#моим братом}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040441,
					"content": "Мы были попутчиками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040442
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040442,
					"content": "Это было мучительное путешествие в поисках судьбы, вот только... мы не дошли вместе до места назначения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040443
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040443,
					"content": "Место назначения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040444
					]
				},
				{
					"id": 80040444,
					"content": "Прежде чем продолжишь засыпать меня вопросами, я напомню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040445
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040445,
					"content": "Если мои подозрения относительно «телепортационной сети» верны и раз я только что был перенесён сюда, то очевидно, что ордену Бездны важно наличие здесь узла телепортации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040446
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040446,
					"content": "#Хочешь сказать, что орден Бездны замышляет здесь что-то? Паймон и {NICKNAME} догадывались о чём-то подобном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040447
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040447,
					"content": "Я имею в виду, что в этот момент за каждым нашим шагом, скорее всего, наблюдает орден Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040448
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040448,
					"content": "Бр-р, не пугай так Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040449,
						80040450
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80040449,
					"content": "Сперва нужно всё разузнать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040451,
					"content": "Мудро. Там у скалы виднеется огонёк костра. Давайте пойдём туда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80040450,
					"content": "Поверю тебе. Пока что.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040440,
					"content": "Что тогда произошло?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040433,
					"content": "Кто такой Сумеречный Меч?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040424,
					"content": "#В тот раз тебе тоже не удалось догнать {M#мою сестру}{F#моего брата}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040419,
					"content": "Что сейчас случилось с порталом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040411,
					"content": "Неожиданно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				},
				{
					"id": 80040304,
					"content": "Кто бы мог подумать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040402
					]
				}
			]
		},
