			"dialogs": [
				{
					"id": 745280401,
					"content": "А, это ты. Наши пути снова пересеклись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280402,
						745280403
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 745280402,
					"content": "Скирк, давно не виделись.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				},
				{
					"id": 745280404,
					"content": "Смотрю на шрамы, оставленные в этом мире. Взрыв превратил это место в руины...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280405
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 745280405,
					"content": "Однако люди уже успели воздвигнуть на них что-то новое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280406
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 745280406,
					"content": "Всё имеет свой конец, и тем не менее гибель всегда ведёт к рождению новых возможностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280407
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 745280407,
					"content": "Твоя сила выросла с нашей последней встречи. Похоже, ты не ленишься на тренировках. Так держать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280408,
						745280409
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 745280408,
					"content": "На самом деле, у меня есть маленькая просьба...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280410,
					"content": "Хочешь сделать фото? В этом мире я всего лишь гостья. Стоит ли оставлять в нём след моего присутствия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280411,
						745280412
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 745280411,
					"content": "Но для меня ты не просто гостья.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280413,
					"content": "...Раз ты так хочешь, то хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280414
					],
					"speakerTitle": "Скирк"
				},
				{
					"id": 745280414,
					"content": "Я в твоём распоряжении. Можем начать в любой момент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Скирк"
				},
				{
					"id": 745280412,
					"content": "Каждая встреча достойна памяти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280409,
					"content": "Я хочу сфотографировать тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280403,
					"content": "Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				}
			]
		}
	]
