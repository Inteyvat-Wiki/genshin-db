			"dialogs": [
				{
					"id": 200390101,
					"content": "Я хочу побольше узнать об алхимии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390102
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 200390102,
					"content": "Древнее искусство алхимии... Я бы хотел, чтобы больше людей ценило это занятие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390103
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 200390103,
					"content": "Тебя тоже интересует алхимия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390104
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 200390104,
					"content": "Очень интересует.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200390105
					]
				},
				{
					"id": 200390105,
					"content": "#Ну что ж, почему бы тебе само{F#й}{M#му} не попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390106
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 200390106,
					"content": "Для начала стоит освоить базовые вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимей"
				}
			]
		},
