			"dialogs": [
				{
					"id": 200390401,
					"content": "Давай начнём с громового масла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390402
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 200390402,
					"content": "Базовый алхимический продукт. Идеально подходит для новичков в алхимии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390403
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 200390403,
					"content": "Для громового масла тебе понадобятся электро кристалл и жаба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390404
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 200390404,
					"content": "И то и другое можно легко найти за городом. Что? Ты не видишь связи между Электро кристаллом и эфирным маслом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390405
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 200390405,
					"content": "Потому что её нет! Электрический кристалл нужен для шокового эффекта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390406
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 200390406,
					"content": "Когда у тебя всё будет готово, попробуй приготовить громовое масло. Настало время экспериментов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390407
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 200390407,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
