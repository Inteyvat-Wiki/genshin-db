	"talks": [
		{
			"id": 7267401,
			"completionStepIds": [
				7267401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267401",
							"2"
						],
						"stepId": 7267401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иорой"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740101,
					"content": "Привет, Иорой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740102,
					"content": "Ой! Раскрыли меня! Как... Погодите, этот запах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740103
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740103,
					"content": "Так это вы. Столько времени прошло. Не узнал по запаху вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740104
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740104,
					"content": "А ты совсем не изменился, Иорой. Всё так же боишься людей и торчишь в камне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740105,
					"content": "А? О чём это ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740106,
						726740107
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740106,
					"content": "Надеюсь, ты скоро избавишься от печати.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				},
				{
					"id": 726740108,
					"content": "Хах, это всего-то человеческая печать! Я чуть-чуть постараюсь и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740109
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740109,
					"content": "Кхм.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740110
					]
				},
				{
					"id": 726740110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740111
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740111,
					"content": "#Ну, в любом случае вы хорошо заботитесь о ребятишках. Мои маленькие тануки всегда говорят, что любят играть с их {F#тётей}{M#дядей} Жёлтой Шёрсткой, котор{F#ая}{M#ый} так вкусно пахнет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740112,
						726740113,
						726740114
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740112,
					"content": "#{F#Тётя}{M#Дядя} Жёлтая Шёрстка...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740115,
					"content": "А я-то думал, что все человеки такие же, как тот парень, который запечатал нас, — злые и страшные. Но, кажется, есть и хорошие среди вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740116,
						726740117
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740116,
					"content": "Большинство хороших.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740118,
					"content": "#Верно! Мы с {NICKNAME} почти всегда встречали только хороших людей! Ты украл тот гребень, вот тебя и запечатали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740119,
					"content": "Уф, но я уже вернул его! Если вам когда-нибудь попадётся тот парень, что учился магии у Рэйдзэмбо, то передайте ему, чтобы вытащил меня из этого камня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740120
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740120,
					"content": "Хм! Если поразмыслить, то во всём виновата эта подлая кицунэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740121
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740121,
					"content": "(Иорой брюзжит как старик, да?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740122,
					"content": "(Ну, он уже старенький.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740123
					]
				},
				{
					"id": 726740123,
					"content": "Что ж, раз ваши руки и ноги не окаменели, то наверняка вы всюду побывали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740124
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740124,
					"content": "Да! Мы приехали с той стороны океана, представляешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740125,
					"content": "Вы рассказываете Иорою о ваших приключениях в Мондштадте и Ли Юэ.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740126
					]
				},
				{
					"id": 726740126,
					"content": "Сколько всего в мире мест... Это так удивительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740127
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740127,
					"content": "Всё это время жил рассказами маленьких тануки я. Совсем ничего не знаю о большом мире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740128
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740128,
					"content": "Однажды, стоя на вершине горы Ёго, по ту сторону океана увидел высокую-превысокую гору я. Наверное, даже выше, чем Ёго. И до сих пор гадаю я, что за место это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740129,
						726740131
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740129,
					"content": "По ту сторону океана...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740130
					]
				},
				{
					"id": 726740130,
					"content": "Это же Драконий хребет, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740132,
					"content": "Хм, Драконий хребет? От одного только имени мороз пробирает изнутри. Кто знает, что там забыл этот парень...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740133
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740134
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740134,
					"content": "Я ведь уже сказал, что хорошие вы? Поэтому...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740135
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740135,
					"content": "В воздухе запахло просьбой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740136,
					"content": "Мм! Даже в таком состоянии я всё ещё Тайный защитник рощи, я берегу лес Тиндзю по указу Её Превосходительства! Если бы я не был запечатан в камне, я бы взял огромный, как восемь татами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740137,
						726740138
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740137,
					"content": "Ясно. Чем мы можем помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740143
					]
				},
				{
					"id": 726740143,
					"content": "Мне самому не сдвинуться, но маленькие тануки могут. Я прошу вас взять тануки на тренировку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740144
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740144,
					"content": "Возьмите с собой Китибоси. Он так по вам скучает после того, как вместе играли вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740145,
						726740146
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740145,
					"content": "Ну, мы могли бы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740147,
					"content": "Угу, мы совсем не понимаем, что говорит Китибоси. Не трудно ли нам будет в пути?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740148
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740148,
					"content": "Не думаю. Мы, тануки, понимаем человеческую речь от природы. Это вы, человеки, не умеете говорить по-нашему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740149
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740149,
					"content": "Что? А так бывает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740150
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740150,
					"content": "Но в пути...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740151
					]
				},
				{
					"id": 726740151,
					"content": "Неплохо было бы разговаривать по дороге.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740152
					]
				},
				{
					"id": 726740152,
					"content": "#Как Паймон и {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740153
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740153,
					"content": "Хм, ну ладно. Раз уж я об этом заговорил, не использовал ли кто-то однажды нашу магию, чтобы приготовить вам еду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740154
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740154,
					"content": "Вы не смотрите, что в камне я. Приготовить вам еду, от которой вы будете понимать Китибоси, вполне возможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740155
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740155,
					"content": "Ура! Еда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740156
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740156,
					"content": "Ещё не значит, что она будет вкусной...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740157
					]
				},
				{
					"id": 726740157,
					"content": "Ну-ну, не стоит недооценивать мое кулинарное мастерство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740158
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740158,
					"content": "Хотя вы не уверены, откуда Иорой это взял...\\nВы с Паймон раскладываете «аппетитные» яства прямо на каменном животе Иороя.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740159
					]
				},
				{
					"id": 726740159,
					"content": "О, это так вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740160
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740160,
					"content": "Конечно. Я ведь тот самый Иорой, который однажды приготовил ассорти из сашими из комочков грязи и шерсти тануки и так обманул Четверых óни Огата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740161
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740161,
					"content": "Это так здорово, Иорой! А из чего была еда, которую мы только что съели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740162
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740162,
					"content": "Некоторые вопросы лучше не задавать, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740163
					]
				},
				{
					"id": 726740163,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740164
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740164,
					"content": "Ладно. Идём поговорим с Китибоси!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740146,
					"content": "Один вопрос...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740138,
					"content": "Ну...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740139
					]
				},
				{
					"id": 726740139,
					"content": "#О, Паймон знает, о чём ты, {NICKNAME}. А что насчёт сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740140,
					"content": "Сокровища? Ну конечно же! Ведь я вождь пятисот пяти бакэ-дануки! Ни одно из сокровищ Инадзумы не ускользнуло от моего взгляда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740141
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740141,
					"content": "Тогда чем мы можем помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740142
					]
				},
				{
					"id": 726740142,
					"content": "Да! Мы лучшие помощники!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740131,
					"content": "Судя по направлению, это Драконий хребет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740132
					]
				},
				{
					"id": 726740117,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740113,
					"content": "Вкусно пахнет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740114,
					"content": "#Не {F#тётя}{M#дядя}, а {F#сестрёнка}{M#братик}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740107,
					"content": "Паймон хотела сказать, что мы надеемся, ты скоро избавишься от печати.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				}
			]
		},
		{
			"id": 7267402,
			"completionStepIds": [
				7267402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267402",
							"2"
						],
						"stepId": 7267402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Китибоси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740201,
					"content": "Эй, Китибоси, давненько не виделись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740202,
					"content": "Мм! Белый Помпон и Жёлтая Шёрстка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740203
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740203,
					"content": "Жёлтая Шёрстка - это я?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740204
					]
				},
				{
					"id": 726740204,
					"content": "Эй! Кого ты назвал Белым Помпоном?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740205,
					"content": "Мм, сильная. Понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740206
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740206,
					"content": "#Меня зовут {NICKNAME}, а это Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740207
					]
				},
				{
					"id": 726740207,
					"content": "И лучше бы тебе это запомнить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740208,
					"content": "Щёлк-щёлк фиалковая дыня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740209
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740209,
					"content": "Что? Фиалковая дыня? И что значит это твоё «щёлк-щёлк»?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740210,
					"content": "Ну, по крайней мере, мы можем вроде как общаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740211,
					"content": "Именно, что «вроде как».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740212
					]
				},
				{
					"id": 726740212,
					"content": "#В любом случае, {NICKNAME}, давай-ка снова сходим к Иорою. Как-никак нам предстоит долгая дорога с Китибоси.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740213,
					"content": "Иорой! Ура!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740214
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740214,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7267403,
			"completionStepIds": [
				7267403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267403",
							"2"
						],
						"stepId": 7267403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иорой"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740301,
					"content": "Мм! Ну как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740302
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740302,
					"content": "Мм! Рад видеть Белого Помпона и Жёлтую Шёрстку! Фиалковая дыня бабах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740303
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740303,
					"content": "Фиалковая дыня бабах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740304
					]
				},
				{
					"id": 726740304,
					"content": "Мм, поразительно, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740305
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740305,
					"content": "Бабах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740306
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740306,
					"content": "Так что значит «фиалковая дыня бабах»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740307
					]
				},
				{
					"id": 726740307,
					"content": "Бабах - это бабах, а фиалковая дыня - фиалковая дыня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740308
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740308,
					"content": "Ну, вижу я, что общение наладилось у вас. Мои кулинарные навыки, как обычно, на высоте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740309,
						726740311
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740309,
					"content": "«Наладилось», значит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740310
					]
				},
				{
					"id": 726740310,
					"content": "Не наладилось! Совсем не наладилось! Мы не понимаем Китибоси!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740312,
					"content": "Дело вот в чём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740313,
					"content": "Вы рассказываете Иорою, как вы пообщались.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740314
					]
				},
				{
					"id": 726740314,
					"content": "Мм, вон оно как. Беспокоиться не надо. Это потому, что к ауре Китибоси не привыкли вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740315
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740315,
					"content": "Не спешите! Привыкните к ауре и понимать его будете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740316
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740316,
					"content": "И долго нужно не спешить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740317,
					"content": "Ну... Мм... Дайте подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740318
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740318,
					"content": "Мм! В любом случае спешить не надо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740319
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740319,
					"content": "Спешить плохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740320
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740320,
					"content": "Ты сам не знаешь, так ведь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740321
					]
				},
				{
					"id": 726740321,
					"content": "Хм! Я - Иорой, долго-предолгоживущий король бакэ-дануки. Я не как человеки, мне нет дела до времени!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740322
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740322,
					"content": "(Хотя он и провёл большую часть своего времени, запечатанный в этой каменной статуе...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740323,
					"content": "Тогда откуда ты так хорошо знаешь человеческий язык, Иорой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740324
					]
				},
				{
					"id": 726740324,
					"content": "Ммм, какая дерзость! Лучше бы вы спросили, как вы, человеки, можете разговаривать с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740325
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740325,
					"content": "Жил долго-предолго я, и стал могучим. Пообщался своё с человеками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740326
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740326,
					"content": "Давным-давно я много разговаривал с тэнгу, кицунэ, óни, ёкаями и человеками. И хотя истории человеков частенько о них самих, по крайней мере половина из них связана с бакэ-дануки, которые превратились в людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740327
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740327,
					"content": "Половина оставшейся половины о самих человеках, а другая половина - о других ёкаях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740328
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740328,
					"content": "Но даже в этой половине, добрая половина касается нас, тануки, которые приняли обличье других ёкаев. Тогда ещё половина историй тануки обо мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740329
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740329,
					"content": "Мм, теперь понимаете вы, что я величайший из всех. Не тяжкий труд разговаривать с вами, молодыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740330
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740330,
					"content": "Понятно. Пять шестнадцатых про Иороя, верно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740331
					]
				},
				{
					"id": 726740331,
					"content": "Мм? Пять шестнадцатых? А это вкусно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740332
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740332,
					"content": "Звучит вкусно. Хочу съесть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740333
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740333,
					"content": "#{NICKNAME} имеет в виду процент историй о тебе, Иорой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740334
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740334,
					"content": "Иорой. Сильный!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740335
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740335,
					"content": "Ха, ну конечно же! Поучись моей силе. Да-да, поучись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740336
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740336,
					"content": "А? Если подумать, то мы начинаем понимать Китибоси, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740337
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740337,
					"content": "Белый Помпон умная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740338
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740338,
					"content": "Это вроде и похвала, но Паймон не рада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740339
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740339,
					"content": "Хорошо, хорошо. Передаю это дитя вам. Покажите ему мир и обучите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740340
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740340,
					"content": "Когда молодым тануки был я, отправился в паломничество по восемнадцати местам Инадзумы по следу великого бакэ-дануки Цукумо, ни разу не сбившись с пути тануки. И так великим стал я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740341
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740341,
					"content": "Да? А тогда почему же ты торчишь в камне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740342
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740342,
					"content": "Мха-ха-ха! В камне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740343
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740343,
					"content": "Э?! И ты тоже, Китибоси?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740344
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740344,
					"content": "Кхм! Давайте, эм, вернёмся к теме! Куда нам следует отправиться сначала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740345,
						726740347
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740345,
					"content": "В то место, о котором говорил Иорой...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740346
					]
				},
				{
					"id": 726740346,
					"content": "Ага! Тогда на Драконий хребет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740348
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740348,
					"content": "«Если есть гора - на неё надо подняться»! Ах, Паймон ждала возможности сказать что-нибудь такое классное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740349
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740349,
					"content": "Гора! Там!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740350
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740350,
					"content": "Уф, звучит так морозно... Не застуди пузико, Китибоси, а то заболеешь. И тогда не сможешь барабанить по животу на выступлениях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740351
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740351,
					"content": "#И ещё хорошо кушай и слушайся {F#тётю}{M#дядю} Жёлтую Шёрстку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740352
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726740352,
					"content": "#Понятно! Слушаться {F#тётю}{M#дядю} Жёлтую Шёрстку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740353,
						726740354,
						726740355
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740353,
					"content": "Мы присмотрим за Китибоси, не переживай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740356,
					"content": "Рады познакомиться с тобой, Китибоси!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740357
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726740357,
					"content": "Мм! Не беспокойтесь! Китибоси присмотрит за вами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740358
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726740358,
