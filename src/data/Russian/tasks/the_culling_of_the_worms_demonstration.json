			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Винаяк",
					"Шрия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735160101,
					"content": "Ты это видела, Шрия?! Наша унутобойная пушка просто потрясающая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160102
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735160102,
					"content": "Хотел бы я, чтобы рецензенты с нашей защиты были здесь и это видели. Они сразу забыли бы про свои замшелые взгляды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160103
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735160103,
					"content": "Так всё и правда прошло без осложнений... А я-то думала, что кончится как с экспериментальным устройством №3...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160104
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735160104,
					"content": "Кхм... Мы учимся на своих ошибках. Я уже не тот, что раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160105
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735160105,
					"content": "Сколько же у вас было аварий?.. Ну, как бы то ни было, в этот раз эксперимент удался!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735160106,
					"content": "Да! И пока всё идёт гладко, можем испробовать пушку в другом месте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160107
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735160107,
					"content": "По свидетельствам очевидцев, количество унутов в этой области исчисляется как минимум двузначным числом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160108
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735160108,
					"content": "Постой-ка... Двузначное число?! Ты же не собираешься разбираться с ними по одному? На это уйдёт много времени!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735160109,
					"content": "А в чём проблема? Если тебя беспокоит обслуживание унутобойной пушки, то на этот счёт волноваться не стоит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160110
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735160110,
					"content": "Погоди-погоди! Речь о том, что придётся снова и снова проделывать одно и то же, и это будет долго. Может, пушка и не сломается, но сломаемся мы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735160111,
					"content": "Винаяк, не всем, чтобы вернуть силы, достаточно вдохнуть аромат машинного масла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160112
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735160112,
					"content": "Да? Хм, кажется, в следующий раз надо будет учесть производительность живых компонентов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160113
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735160113,
					"content": "В общем, я предлагаю на этом закончить. У нас есть данные полного цикла и полученный после битвы образец, с ними я на шаг ближе к решению загадки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160114
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735160114,
					"content": "Какой загадки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735160115
					]
				},
				{
					"id": 735160115,
					"content": "Агрессивного поведения унутов и аномальных параметров окружающей среды... Если мы поймём причины, то справимся с напастью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160116
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735160116,
					"content": "Пожалуйста, дайте мне ещё один день на исследование. Завтра к этому времени у нас должны быть результаты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шрия"
				}
			]
		}
	]
}