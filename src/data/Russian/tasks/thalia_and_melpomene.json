			"dialogs": [
				{
					"id": 740760101,
					"content": "Это единственное оставшееся место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760102
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760102,
					"content": "Хорошо, что вход по-прежнему запечатан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760103
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 740760103,
					"content": "Кажется, Жакоб не смог разгадать загадку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760104
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 740760104,
					"content": "Или, может быть, он нашёл ответ, но не смог его донести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760105
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760105,
					"content": "Паймон нужно подумать. До этого у нас были ответы: «Тень», «Жизнь» и «Любовь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760106,
					"content": "Затем, опираясь на прошлые закономерности, мой логический модуль предположил, что надпись выглядит следующим образом:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760107
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 740760107,
					"content": "«Всегда неразлучна с тобой»... «Возникает мгновенно, расходится с тобой, не покидает тебя даже во сне»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760108
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 740760108,
					"content": "А в самом конце написано - «Первородная капля».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760109,
					"content": "Катерпиллер и Сеймур, вы знаете, какой у этой загадки ответ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
