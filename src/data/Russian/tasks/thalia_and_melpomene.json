			"dialogs": [
				{
					"id": 740760501,
					"content": "Это впереди блок «личность»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760502
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 740760502,
					"content": "Невозможно проанализировать материю впереди по плотности. Вес материи составляет... ноль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760503
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 740760503,
					"content": "Кажется, мы взяли последний. Так мы хотя бы можем противостоять нашему противнику.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760504
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760504,
					"content": "Если посмотреть с другой стороны, то, по крайней мере, мы сможем помешать Ордо Нарциссенкрейц выковать Чудесный меч.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760505,
					"content": "Не совсем так, Паймон. Наша конечная цель - выковать Чудесный меч и с его помощью нарушить их планы.",
					"roleType": "TALK_ROLE_NPC",
