					}
				]
			},
			"dialogs": [
				{
					"id": 740760401,
					"content": "У меня есть мысли по поводу выражения «Первородная капля».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760402
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760402,
					"content": "Кажется, речь идёт о первом дожде после сотворения мира. Думаю, эта идея была популярна в Древнем Фонтейне и в Ордо Нарциссенкрейц.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760403
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760403,
					"content": "Но как нам найти нечто подобное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760404,
					"content": "Эта капля уже слилась со всеми водами. В каждой капле содержится «первородная капля».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760405
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760405,
					"content": "Точно так же первородный Адепт рассеял вокруг свой великий потенциал, поэтому в каждом человеке содержится божественные частицы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760406
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760406,
					"content": "Если бы ответ был таким простым, наши предшественники смогли бы без труда предоставить ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760407,
					"content": "Верно. Кажется, я ошибся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760408
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760408,
					"content": "Пусть это неверный ответ, но хороший. Думаю, тот, кто составлял загадки, ничего не знает о романтике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760409
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760409,
					"content": "И теперь он смеётся над тобой, потому что ты не разбираешься в безопасности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760410,
					"content": "Я не могу дать ответ. О первородной капле найдено одна тысяча двести результатов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760411
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 740760411,
					"content": "«Легенда гласит, что первую в мире каплю вина выпил Анемо Архонт...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760412,
						740760414
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 740760412,
					"content": "Ладно, не нужно продолжать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760413
					]
				},
				{
					"id": 740760413,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 740760416,
					"content": "По этому поводу... Думаю, мне есть чем поделиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760417
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 740760417,
					"content": "Есть легенда о том, что океанид - это первая слеза прошлого Гидро Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760418
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 740760418,
					"content": "А самую первую слезу на земле пролила первая океанида, которая поняла человечество.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760419
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 740760419,
					"content": "А разве самую первую в мире слезу не должен был проронить первый человеческий младенец?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760420,
					"content": "Животные плачут, чтобы выделить соли. А люди в те мирные времена, даже когда только начинали дышать после рождения, - уже улыбались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760421
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 740760421,
					"content": "Так гласит легенда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760422
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 740760422,
					"content": "Вообще я думаю, что крик ребёнка следует рассматривать как безэмоциональный акт, подобно тому, как животное выделяет соли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760423
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 740760423,
					"content": "Согласно сумерским учебникам Амурты, младенцы плачут по двум причинам: из-за внешних раздражителей и для того, чтобы быстрее наполнить лёгкие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760424
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 740760424,
					"content": "Значит, ответ - океанида?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760425
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760425,
					"content": "Неудивительно, что до нас никто не смог предоставить правильный ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760426,
						740760428
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760426,
					"content": "Надежда умирает последней.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760427
					]
				},
				{
					"id": 740760427,
					"content": "Думаю, это надёжное направление!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760430,
					"content": "Судя по моему пониманию Ордо Нарциссенкрейц, такой ответ кажется разумным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760431
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760431,
					"content": "Красная Королева, мечтающая неизвестно о чём, мечтательница, которая никогда не расскажет, что на самом деле скрывает её сердце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760432
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760432,
					"content": "Тебя ещё сложнее понять, чем загадку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760433
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760433,
					"content": "Разницы нет. Это конец, и ответ всё равно будет объявлен после этих событий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760434
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760434,
					"content": "Анн, рассчитываю на тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760435
					]
				},
				{
					"id": 740760435,
					"content": "Хорошо, я попробую. Если у меня не получится, скорее придумайте новый ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760436
					],
					"speakerTitle": "Анн"
				},
				{
					"id": 740760436,
					"content": "Получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760437
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760437,
					"content": "Нужно собрать все элементы, иначе Чудесный меч попадёт в руки Ордо Нарциссенкрейц.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760428,
					"content": "Думаю, это надёжное направление!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760429
					]
				},
				{
					"id": 740760429,
					"content": "Это гораздо лучше, чем безуспешно пытаться найти вино Анемо Архонта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760414,
					"content": "Нужно попробовать. Отправимся в Мондштадт...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760415
					]
				},
				{
					"id": 740760415,
					"content": "Если твоя надежда ещё не умерла, то нужно хотя бы выбрать правильное направление!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Паймон"
				}
			]
		},
