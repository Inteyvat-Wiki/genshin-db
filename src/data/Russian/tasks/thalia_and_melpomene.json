			"dialogs": [
				{
					"id": 740760201,
					"content": "Это единственное оставшееся место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760202
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760202,
					"content": "Все предыдущие поиски не принесли результата...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760203,
					"content": "Да. Но вход сюда всё ещё закрыт, а значит, у нас ещё есть шанс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760204
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760204,
					"content": "Кажется, наши соперники не разгадали эту загадку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760205
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760205,
					"content": "Здесь есть следующая надпись: «Всегда неразлучна с тобой»... «Возникает мгновенно, расходится с тобой, не покидает тебя даже во сне»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760206
					],
					"speakerTitle": "Сеймур"
				},
				{
					"id": 740760206,
					"content": "А в самом конце написано - «Первородная капля».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760207,
					"content": "Думаю, что подобные загадки уже были в нескольких местах. Вы помните разгадки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760208
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740760208,
					"content": "«Тень».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760209
					]
				},
				{
					"id": 740760209,
					"content": "«Жизнь».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760210
					]
				},
				{
					"id": 740760210,
					"content": "«Любовь».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760211
					]
				},
				{
					"id": 740760211,
					"content": "Эм, ответы становятся всё более абстрактными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740760212,
					"content": "Катерпиллер и Сеймур, вы знаете ответ на эту загадку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
