					}
				]
			},
			"dialogs": [
				{
					"id": 747150101,
					"content": "Фремине, ты почему такой уставший? Наверное, перегрузил себя подводными работами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747150102,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150103
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150103,
					"content": "Не прячься от нас в водолазном шлеме! Мы же друзья, расскажи нам всё как есть, не держи в себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747150104,
					"content": "...Да, ты права.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150105
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150105,
					"content": "Сейчас под водой мне встретился один очень неприятный человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150106
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150106,
					"content": "Неприятный человек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747150107,
					"content": "Эм... с чего бы начать. По законам Фонтейна, если владелец затонувшего груза получил страховую компенсацию, груз становится невостребованной собственностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150108
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150108,
					"content": "Из-за этого закона некоторые люди видят в погружениях способ разбогатеть. Поднимают на сушу чужие вещи, а потом продают их за мору...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150109
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150109,
					"content": "Такая работа не требует особых умений, поэтому среди водолазов оказалось немало людей, которые думают только о наживе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150110
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150110,
					"content": "Порой они прибегают к жестоким методам, чтобы разогнать рыб и пухленей, которые им мешают... Некоторые поручения я не беру именно из-за таких людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150111
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150111,
					"content": "Так вот в чём дело... Паймон тебя прекрасно понимает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747150112,
					"content": "Только что под водой мне снова встретился такой тип. Я набрался смелости и попытался остановить его. Но в итоге он наговорил мне грубостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150113
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150113,
					"content": "Как же так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150114,
						747150115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747150114,
					"content": "Ты всё сделал правильно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				},
				{
					"id": 747150116,
					"content": "Спасибо, вы очень добрые, но... хоть мне это даётся тяжело и отнимает много сил, я всё же хочу сам попытаться что-то изменить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150117
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150117,
					"content": "Я люблю плавать под водой, рассматривать узоры берилловых ракушек, чувствовать дыхание ромаринов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150118
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150118,
					"content": "Когда подводный мир принимает тебя, ты ощущаешь его доброту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150119
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150119,
					"content": "Я думаю, таким и должно быть общение с природой... мы не должны эгоистично брать всё, что хотим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150120
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150120,
					"content": "Фремине, отлично сказано! Видишь? Когда тебе очень хочется что-то сказать или сделать, намного лучше выразить это, а не держать в себе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747150121,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150122
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150122,
					"content": "Фремине?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747150123,
					"content": "Простите... я немного стесняюсь. В общем... я... я буду стараться и дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150124
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150124,
					"content": "Чуть не забыл... это последние данные подводной разведки, держите. Они должны вам пригодиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747150115,
					"content": "В следующий раз мы тоже попытаемся их остановить!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				}
			]
		}
	]
}