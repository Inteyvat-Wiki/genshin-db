			"trigger": {
				"objectNames": [
					"Вэнь Цзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716730101,
					"content": "Хм... В этой картине как будто чего-то не хватает. Может, нужно больше вдохновения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730102
					],
					"speakerTitle": "Вэнь Цзи"
				},
				{
					"id": 716730102,
					"content": "Привет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730103
					]
				},
				{
					"id": 716730103,
					"content": "#Ох, да это же {NICKNAME}! Давно хотелось познакомиться лично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730104
					],
					"speakerTitle": "Вэнь Цзи"
				},
				{
					"id": 716730104,
					"content": "Как видите, я выполняю указания Департамента по делам граждан и занимаюсь здесь организацией праздничных развлечений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730105
					],
					"speakerTitle": "Вэнь Цзи"
				},
				{
					"id": 716730105,
					"content": "Хм... Ты собираешься учить других рисовать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730106
					]
				},
				{
					"id": 716730106,
					"content": "Ах, вовсе нет! Ни о каком обучении речи не идёт, я буду рисовать для других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730107
					],
					"speakerTitle": "Вэнь Цзи"
				},
				{
					"id": 716730107,
					"content": "Праздник морских фонарей с каждым годом лишь набирает масштабы. Число гостей растёт, включая и туристов, прибывающих из-за границы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730108
					],
					"speakerTitle": "Вэнь Цзи"
				},
				{
					"id": 716730108,
					"content": "И хотя Департамент по делам граждан организовал для них бесплатную возможность сделать памятные фотоснимки, фотографии всё же не могут передать истинный дух Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730109
					],
					"speakerTitle": "Вэнь Цзи"
				},
				{
					"id": 716730109,
					"content": "Поэтому мне поручили отправиться в порт и рисовать для приезжающих туристов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730110
					],
					"speakerTitle": "Вэнь Цзи"
				},
				{
					"id": 716730110,
					"content": "В гавани Ли Юэ сейчас особенно популярна легенда об Адепте Белой Лошади, поэтому было решено сделать именно её темой рисунков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730111
					],
					"speakerTitle": "Вэнь Цзи"
				},
				{
					"id": 716730111,
					"content": "Уж очень хочется отразить на картинах энергию этого места. Как здесь говорят, «дракон взлетает, тигр прыгает». Вот я и рисую для гостей белых лошадей в галопе. Ну не прекрасно ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730112
					],
					"speakerTitle": "Вэнь Цзи"
				},
				{
					"id": 716730112,
					"content": "#{NICKNAME}, есть ли у вас какая-нибудь идея для картины?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730113
					],
					"speakerTitle": "Вэнь Цзи"
				},
				{
					"id": 716730113,
					"content": "Да, довольно много...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730114
					]
				},
				{
					"id": 716730114,
					"content": "Вот как? Отлично! В таком случае не стесняйтесь предлагать, я тут же возьмусь за кисть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэнь Цзи"
				}
			]
		}
	]
}