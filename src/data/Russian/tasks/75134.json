			"dialogs": [
				{
					"id": 751340201,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340202,
					"content": "Ого, снаружи всё поражено разложением Бездны. Нас может завалить в любой момент. Как думаешь, это то, на что указывал Коко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751340203,
					"content": "И неизвестно, что внутри. Хотя Паймон уверена, что никакого Алтаря там нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751340204,
					"content": "«Сухая логика никуда нас не приведёт...»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340205
					]
				},
				{
					"id": 751340205,
					"content": "Теперь Паймон понимает. Коко не хотел сюда идти из-за Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751340206,
					"content": "Мы должны разобраться с Бездной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340207
					]
				},
				{
					"id": 751340207,
					"content": "Да. И Коко не хотел сюда идти из-за Бездны. Мы должны от неё избавиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751340208,
					"content": "#Идём, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340209
					]
				},
				{
					"id": 751340209,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340210,
					"content": "Стойте, а как же Паймон? Ну вы даёте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751340211,
					"content": "Давайте избавимся от этой гадости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
