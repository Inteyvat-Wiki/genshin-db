			"dialogs": [
				{
					"id": 222000301,
					"content": "#Ты наш{M#ёл}{F#ла} самое питательное блюдо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000302,
						222000304
					],
					"speakerTitle": "И Чэн"
				},
				{
					"id": 222000302,
					"content": "Вот оно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000303
					]
				},
				{
					"id": 222000303,
					"content": "Превосходно! Дай мне попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "И Чэн"
				},
				{
					"id": 222000304,
					"content": "Пока ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000305
					]
				},
				{
					"id": 222000305,
					"content": "Ладно. Если ты ищешь рыбацкий бутерброд, то его обычно продают в ресторане «Народный выбор».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000307
					],
					"speakerTitle": "И Чэн"
				},
				{
					"id": 222000307,
					"content": "А, я слышал, торговец из Мондштадта говорил, что в «Хорошем охотнике» подают суп с морепродуктами, должно быть, очень вкусно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000308
					],
					"speakerTitle": "И Чэн"
				},
				{
					"id": 222000308,
					"content": "Ещё есть рыбный шашлычок и цыплёнок в медовом соусе, их должно быть очень просто сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000309
					],
					"speakerTitle": "И Чэн"
				},
				{
					"id": 222000309,
					"content": "*УРЧАНИЕ* Ой, от перечисления блюд я ещё сильнее хочу есть... *УРЧАНИЕ*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "И Чэн"
				}
			]
		},
