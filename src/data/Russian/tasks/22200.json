					"И Чэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000201,
					"content": "О, я слышал, что мондштадтские блюда неплохи... Например, рыбный шашлычок, рыбацкий бутерброд, цыплёнок в медовом соусе... Суп с морепродуктами должен быть вкусным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000202
					],
					"speakerTitle": "И Чэн"
				},
				{
					"id": 222000202,
					"content": "Пожалуйста, просто выбери блюдо, которым можно легко наесться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000203
					],
					"speakerTitle": "И Чэн"
				},
				{
					"id": 222000203,
					"content": "Если я поем, мой живот наконец перестанет урчать целый день...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "И Чэн"
				}
			]
		},
