				]
			},
			"dialogs": [
				{
					"id": 747000101,
					"content": "Хе-хе, Паймон ужасно нравится украшать аквариумы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747000102,
					"content": "Раз Сандроне не возражает, надо почаще нырять и собирать всякие штуки, чтобы тут стало совсем красиво!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747000103,
					"content": "Эй, вы. Идите сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000104
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747000104,
					"content": "А? Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747000105,
					"content": "Вот, это вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000106
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747000106,
					"content": "Что это?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747000107,
					"content": "Это аппарат для передвижения под водой, который я немного доработала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000108
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747000108,
					"content": "Ого, круто! Спасибо тебе, Сандроне! Ты такая хорошая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747000109,
					"content": "Это всего лишь небольшой прибор, ерунда. Я заметила, что вы ловили рыбу, как бы это сказать... очень... примитивно... на это было невыносимо смотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000110
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747000110,
					"content": "Неужели... мы выглядели настолько плохо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747000111,
					"content": "Очень неэффективно, неумело и совершенно неэлегантно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000112
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747000112,
					"content": "Прости, что тебе пришлось на это смотреть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000113
					]
				},
				{
					"id": 747000113,
					"content": "Да не извиняйся, у всех свои привычки. Но раз вы хотите и дальше украшать океанариум, лучше возьмите это устройство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000114
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747000114,
					"content": "Под водой в Фонтейне водятся не только безобидные и красивые маленькие рыбки, но и множество крупных, агрессивных хищников. Так что я забочусь не только о вашей продуктивности, но и о безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000115,
						747000116
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747000115,
					"content": "Большое спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				},
				{
					"id": 747000117,
					"content": "Ладно. Если собираетесь нырять, лучше вам поторопиться. Когда вернётесь, не забудьте рассказать, как вам устройство. Я доработаю его с учётом ваших отзывов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 747000116,
					"content": "Я возьму устройство с собой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				}
			]
		}
	]
}