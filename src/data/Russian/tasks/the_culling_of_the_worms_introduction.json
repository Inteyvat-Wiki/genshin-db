	"talks": [
		{
			"id": 7351301,
			"completionStepIds": [
				7351301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351301",
							"2"
						],
						"stepId": 7351301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Шрия",
					"Винаяк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735130101,
					"content": "...И зачем ты заказал заклёпки по индивидуальному проекту? Они-то уж точно не влияют на эффективность, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130102
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735130102,
					"content": "...Клёпаная броня - это воплощение идеалов Кшахревара!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130103
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735130103,
					"content": "Вы так и ругаетесь со вчерашнего дня?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130104
					]
				},
				{
					"id": 735130104,
					"content": "А, вы уже здесь! Нет, не совсем. На самом деле вчера мы вели дебаты о финансировании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130105
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735130105,
					"content": "Хм... А сейчас мы спорили на другую тему. Но я и сама не заметила, как мы опять вернулись к вопросу о финансах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130106
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735130106,
					"content": "На другую тему?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130107
					]
				},
				{
					"id": 735130107,
					"content": "Я отполировал каждый шов у компонентов до блеска, а Шрия пытается отказаться от задуманного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130108
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735130108,
					"content": "Отказаться?! Я просто хочу немного отложить план!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130109
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735130109,
					"content": "Ты что, не видишь, что с параметрами окружающей среды что-то не так? Если мы продолжим сборку, то эффективность зарядки устройства будет ниже расчётной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130110
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735130110,
					"content": "Нам нужно выяснить, что здесь происходит, устранить все внешние воздействия, а затем приступить к сборке в соответствии с планом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130111
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735130111,
					"content": "Идеальные и реальные условия часто не совпадают. Стоит ли беспокоиться из-за таких пустяков?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130112
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735130112,
					"content": "При проектировании я учёл диапазон отказоустойчивости. Это ни на что не повлияет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130113
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735130113,
					"content": "И вообще, иногда приходится проводить эксперимент ещё до того, как разобрался, в чём проблема.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130114
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735130114,
					"content": "...Ты этой логикой руководствовался, когда устроил тот эксперимент с устройством №2? Оно ещё тогда взорвалось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130115
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735130115,
					"content": "Это... Это другое! Тогда я ещё не понимал, что надо оставлять допуск на ошибки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130116
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735130116,
					"content": "...Есть ли более безопасный способ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130117
					]
				},
				{
					"id": 735130117,
					"content": "Дайте подумать... Может, для начала отключим функцию стрельбы у орудия и проведём только имитацию зарядки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130118
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735130118,
					"content": "Нет, так не пойдёт. Я тебе не доверяю, так что снимем модуль зажигания орудия, и я его постерегу. А с остальным можешь делать, что тебе вздумается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130119
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735130119,
					"content": "Снять модуль зажигания? Тогда от унутобойной пушки останется одна видимость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130120
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735130120,
					"content": "Ты же говорил, что мы просто смоделируем процесс зарядки? Ты всё-таки собирался стрелять из пушки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130121
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735130121,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130122,
						735130123
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735130122,
					"content": "Давайте отключим функцию стрельбы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130124
					]
				},
				{
					"id": 735130124,
					"content": "Уф, ладно... Будем считать это пробной сборкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130125
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735130125,
					"content": "#Вот бы сразу так... Подозреваю, что установка прибора привлечёт немало монстров. В этом случае мы надеемся на твою помощь, искатель{F#ница} приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735130123,
					"content": "Всегда стоит начинать с хорошего каркаса.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130124
					]
				}
			]
		}
	]
}