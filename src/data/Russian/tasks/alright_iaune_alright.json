			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Айюн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130101,
					"content": "Эх... Не знаю, почему так случилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130102,
						240130103
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130102,
					"content": "Айюн?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				},
				{
					"id": 240130104,
					"content": "#Ох, {F#путешественница}{M#путешественник}. Ты {F#пришла}{M#пришёл} за кофе? Позволь угостить тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130105
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130105,
					"content": "В чём дело? Ты плохо выглядишь. Кто-то заставляет тебя работать допоздна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240130106,
					"content": "Спасибо, что беспокоитесь обо мне. Однако в этот раз проблема моя собственная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130107
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130107,
					"content": "Я всё думаю про смысл своей работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130108
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130108,
					"content": "Я верил, что Палата Жестьон должна быть справедливой, эффективной и сильной организацией, в которой все будут помогать друг другу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130109
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130109,
					"content": "Я верил, что под управлением Палаты Жестьон мы увидим процветание Кур-де-Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130110
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130110,
					"content": "Но теперь я вижу, что это подобно руинам механического здания. Люди хаотично дёргают за рычаги и нажимают на случайные кнопки... Только внешний его облик остаётся благопристойным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130111
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130111,
					"content": "Всё работает лишь по причине невероятно удачных совпадений, а не благодаря разумному замыслу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130112
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130112,
					"content": "Я... Я хочу что-то с этим сделать, но не могу. Боюсь, что малейшее движение - и эта махина рассыпется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130113
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130113,
					"content": "Роялт советует расслабиться, ведь мои ошибки не могут сделать ситуацию ещё хуже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130114
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130114,
					"content": "Странный способ утешить человека...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240130115,
					"content": "Эх... Простите, что жалуюсь. Я пришёл сюда, чтобы немного отвлечься от грустных мыслей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130116
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130116,
					"content": "Я сделаю тебе кофе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130117
					]
				},
				{
					"id": 240130117,
					"content": "Правда? Ты умеешь варить кофе? Это так здорово! Я всегда хотел научиться, но времени не находилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130118
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130118,
					"content": "Пожалуйста, свари. Я подожду. Надеюсь, мне повезёт, и работа меня здесь не отыщет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130103,
					"content": "Ты сегодня не работаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				}
			]
		},
		{
			"id": 2401302,
			"completionStepIds": [
				2401302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401302",
							"2"
						],
						"stepId": 2401302,
						"stateName": "QUEST_STATE_UNFINISHED"
