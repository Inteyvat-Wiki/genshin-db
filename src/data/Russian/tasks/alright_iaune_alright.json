				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Айюн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130401,
					"content": "#{F#Путешественница}{M#Путешественник}... Ты сделал{F#а} этот кофе для меня?.. Мне так неловко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130402,
						240130403
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130402,
					"content": "Ничего страшного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				},
				{
					"id": 240130404,
					"content": "Этот кофе... Намного лучше, чем то, что наливают в Палате Жестьон! Совершенно другой уровень...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130405
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130405,
					"content": "Если бы я пил такой кофе каждый день, то я бы не клевал носом каждую минуту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130406
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130406,
					"content": "Спасибо за кофе. Допью и вернусь к работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130407,
						240130408
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130407,
					"content": "Старайся изо всех сил.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130409,
					"content": "Разумеется. Мне нужно скорее улучшить навыки и привыкнуть к работе, чтобы стать самостоятельным, как господин Роялт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130410
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130410,
					"content": "Эх... Сколько же кошмаров придётся вытерпеть прежде...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				},
				{
					"id": 240130408,
					"content": "Не вешай нос.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130403,
					"content": "Пей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				}
			]
		},
		{
			"id": 2401331,
			"completionStepIds": [
				2401306
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
