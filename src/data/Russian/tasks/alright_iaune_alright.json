			},
			"dialogs": [
				{
					"id": 240133101,
					"content": "Неплохо звучит! Давай займёмся приготовлением!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240133102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240133102,
					"content": "Вы начинаете готовить кофе...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240133103
					]
				},
				{
					"id": 240133103,
					"content": "Ох, какой аромат! Отдадим кофе Айюну. Это должно поднять ему настроение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
