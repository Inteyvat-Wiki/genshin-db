				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аруэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130201,
					"content": "#Ах, {F#путешественница}{M#путешественник}! Решил{F#а} помочь? Милости прошу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130202
					],
					"speakerTitle": "Аруэ"
				},
				{
					"id": 240130202,
					"content": "Вовсе нет, мы лишь хотим приготовить кофе для нашего друга. Он...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130203,
						240130204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240130203,
					"content": "...немного не в духе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				},
				{
					"id": 240130205,
					"content": "А, ваш друг - это Айюн, тот парень, который вон там сидит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130206
					],
					"speakerTitle": "Аруэ"
				},
				{
					"id": 240130206,
					"content": "Вы знакомы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130207
					]
				},
				{
					"id": 240130207,
					"content": "Мы с Роялтом давние друзья. Он мне рассказал, что к ним пришёл умный и усердный сотрудник. Это он про Айюна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130208
					],
					"speakerTitle": "Аруэ"
				},
				{
					"id": 240130208,
					"content": "Не переживайте. У всех молодых людей, недавно устроившихся на службу в Палату Жестьон, бывает такой период в жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130209
					],
					"speakerTitle": "Аруэ"
				},
				{
					"id": 240130209,
					"content": "Когда такой человек находит место себе по душе, ему становится легче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130210
					],
					"speakerTitle": "Аруэ"
				},
				{
					"id": 240130210,
					"content": "Ух ты, откуда у тебя столько опыта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 240130211,
					"content": "Потому что я был эдакой «репкой», крепко сидящей в Палате Жестьон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130212
					],
					"speakerTitle": "Аруэ"
				},
				{
					"id": 240130212,
					"content": "Но когда мне надоело это сидение, я выкопал себя и... открыл кофейню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130213,
						240130214
					],
					"speakerTitle": "Аруэ"
				},
				{
					"id": 240130213,
					"content": "Похоже, много чего произошло...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130215,
					"content": "Ха-ха, верно. Но сейчас я всего лишь хозяин этого кафе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130216
					],
					"speakerTitle": "Аруэ"
				},
				{
					"id": 240130216,
					"content": "Ладно. Вы хотели сделать кофе для Айюна? Я отрегулирую аппарат, а вы приходите, как будете готовы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аруэ"
				},
				{
					"id": 240130214,
					"content": "Кажется, ты просто кладезь историй...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130204,
					"content": "...устал на работе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				}
			]
		},
