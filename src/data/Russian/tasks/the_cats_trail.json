			"dialogs": [
				{
					"id": 220410101,
					"content": "Ты как раз вовремя. Нэко кое о чём беспокоится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410102
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220410102,
					"content": "Что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410103
					]
				},
				{
					"id": 220410103,
					"content": "Ты помнишь того ребёнка, Комбумару?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410104
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220410104,
					"content": "Этот маленький негодник ушёл поиграть неподалеку и не вернулся. Нэко беспокоится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410105
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220410105,
					"content": "Пожалуйста, помоги найти Комбумару и вернуть его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410106,
						220410108
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220410106,
					"content": "Не вопрос.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410107
					]
				},
				{
					"id": 220410107,
					"content": "#Замечательно. Помни, ты {F#должна}{M#должен} найти Комбумару и вернуть его в святилище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220410108,
					"content": "Он единственный, кто убежал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410109
					]
				},
				{
					"id": 220410109,
					"content": "Да... Возможно, ему не понравилось, что Нэко отругала его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410110
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220410110,
					"content": "Почему этот ребёнок не слушается Нэко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410111
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220410111,
					"content": "Пожалуйста, найди Комбумару и верни его в святилище.",
