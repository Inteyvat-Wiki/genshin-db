			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???",
					"Джули",
					"Парвана",
					"Сюй Дун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000201,
					"content": "Да-да, я вас слушаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000202
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000202,
					"content": "Извините, вы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000203
					]
				},
				{
					"id": 728000203,
					"content": "Я Камэи Мунэхиса, и я просто мимо проходил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000204
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000204,
					"content": "Ух ты... Этот человек выглядит, как самурай...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000205
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 728000205,
					"content": "С... самурай? Это самурай из сёгуната... Говорят, сёгунат относится к чужестранцам довольно... подозрительно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000206
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 728000206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000207
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000207,
					"content": "Не беспокойтесь. Я ушёл из сёгуната. Я больше не самурай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000208
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000208,
					"content": "Я часто прихожу сюда в поисках еды. Но сегодня обратил внимание на бродящих вокруг демонов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000209
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000209,
					"content": "Они присвоили себе всю еду. И мне пришлось уничтожить их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000210,
						728000212,
						728000214
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000210,
					"content": "Как часто вы здесь бываете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000211
					]
				},
				{
					"id": 728000211,
					"content": "Обычно здесь не так много монстров. Я часто прихожу сюда собирать фрукты или охотиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000217,
					"content": "Что ж, больше мне добавить нечего. Если убить этих демонов, остальные их собратья в округе ещё какое-то время не отважатся сунуть сюда нос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000218
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000218,
					"content": "Если вы тоже пришли за едой, ищите. Я взял только то, что мне нужно. Тут явно ещё что-то осталось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000219
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000219,
					"content": "Что ж, до встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000220
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000220,
					"content": "Он что, взял и просто ушёл? Он ведёт себя точно так же, как один самурай, о котором мне когда-то рассказывали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000221
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 728000221,
					"content": "Но что он имел в виду, когда сказал, что ушёл из сёгуната? Самураи, покинувшие сёгунат - это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000222,
						728000223
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 728000222,
					"content": "Они совсем как враги, с которыми мы прежде сталкивались.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000224,
					"content": "Да, а ещё люди рассказывают о самурае, который ушёл из сёгуната, и теперь бродит по округе и зарабатывает себе на хлеб, грабя людей на улицах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000225
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 728000225,
					"content": "Не то чтобы он был похож на плохого человека, но нам лучше оставаться начеку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000226
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 728000226,
					"content": "Ладно, ладно. Мы ведь за ингредиентами сюда пришли? Но в сложившейся ситуации дальше нам лучше не ходить, это может оказаться опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000227
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000227,
					"content": "#Эт{F#а}{M#от} путешественни{F#ца}{M#к} сопровождает нас уже так давно. Он{F#а}, должно быть, устал{F#а}. Давайте приготовим что-нибудь прямо здесь, отдохнём немного и вернёмся в город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000228
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000228,
					"content": "Тот парень сказал, что тут ещё остались ингредиенты, верно? Давайте осмотримся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000223,
					"content": "Как кайраги.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000212,
					"content": "Вы убили всех этих демонов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000213
					]
				},
				{
					"id": 728000213,
					"content": "Да, это ведь обычные монстры. Справиться с ними проще простого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000214,
					"content": "Почему вы ищете себе пропитание в глуши?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000215
					]
				},
				{
					"id": 728000215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000216
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000216,
					"content": "У меня есть свои причины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7280003,
