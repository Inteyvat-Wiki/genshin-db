				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сюй Дун",
					"Джули",
					"Парвана"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000301,
					"content": "Мы планировали найти свежие ингредиенты... Впрочем, эти вполне подойдут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000302
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000302,
					"content": "Как жаль. Мне так хотелось приготовить для тебя что-нибудь вкусное. Но, кажется, придётся довольствоваться тем, что есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000303,
						728000306
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000303,
					"content": "Ничего страшного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000304
					]
				},
				{
					"id": 728000304,
					"content": "#Ты ведь так выложил{F#ась}{M#ся}, сопровождая нас. Ответ «Ничего» меня не устраивает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000305
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000305,
					"content": "Я это запомню и угощу тебя чем-нибудь вкусненьким в следующий раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000308,
					"content": "Джули, суп готов? Не забывай: нельзя, чтобы Парвана...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000309
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000309,
					"content": "Нет, нет, пусть немного побулькает на медленном огне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000310
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 728000310,
					"content": "Всё нормально. Сейчас я приправлю этот суп, следуя своему улучшенному рецепту. Добавим немного пряностей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000311
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 728000311,
					"content": "Не понимаю я этот твой улучшенный рецепт. Хватит уже, Сюй Дун! Иди сюда, скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000312
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 728000312,
					"content": "Парвана! Эй! Что за странные добавки ты туда кидаешь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000313
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000313,
					"content": "Странные добавки? Это мой особый соус! Ему была посвящена моя дипломная работа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000314
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 728000314,
					"content": "Мне это не нужно! Давайте сегодня съедим что-нибудь приличное! Джули, останови её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000315
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000315,
					"content": "Фи, да что вы понимаете... Ладно, сейчас всё будет идеально. Я приготовлю всем приправам приправу. С ней любое блюдо получится вкусным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000316
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 728000316,
					"content": "Всем приправам приправа... Такое, вообще, возможно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000317
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000317,
					"content": "Никто никогда не готовил ничего подобного, так что это сделаю я! Уж я покажу этим упёртым скептикам из Академии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000318
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 728000318,
					"content": "Ха-ха... Что ж, жду не дождусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000319
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000319,
					"content": "#Кстати, путешественни{F#ца}{M#к}, спасибо тебе за то, что уделяешь нам столько времени. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000320
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000320,
					"content": "Я приготовлю для тебя что-нибудь с собой. Когда отправишься на поиски приключений, важно, чтобы у тебя было достаточно еды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000321
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000321,
					"content": "В нашу следующую встречу я приготовлю для тебя что-нибудь вкусное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 728000306,
					"content": "Что ж, в следующий раз я найду тебя и предложу устроить для меня пир.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000307
					]
				},
				{
