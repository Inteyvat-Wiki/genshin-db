			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кэйа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4861001,
					"content": "Кэйа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4861002,
					"content": "О, я как раз ждал вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861003
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4861003,
					"content": "Я узнал, что Джинн нездоровится. От лица Ордо Фавониус благодарю вас за оказанную помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861004
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4861004,
					"content": "Так вежливо и обходительно. Непохоже на Кэйю, насколько Паймон его знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4861005,
					"content": "Ха-ха! Того требуют обстоятельства. Мы ведь говорим о действующем магистре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861006
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4861006,
					"content": "У меня к тебе есть ещё кое-что, кроме благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861007
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4861007,
					"content": "Работа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861008
					]
				},
				{
					"id": 4861008,
					"content": "Верно. Ты читаешь мои мысли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861009
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4861009,
					"content": "Награда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861010
					]
				},
				{
					"id": 4861010,
					"content": "Ха-ха! Хорошая попытка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861011
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4861011,
					"content": "Но перед тем как мы обсудим награду, я попрошу тебя о небольшой услуге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861012
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4861012,
					"content": "Выполнить поручения Джинн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861013
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4861013,
					"content": "Именно. Хотя Джинн собиралась поручить эти дела кому-то другому...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861014
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4861014,
					"content": "...я думаю, что без её чуткого руководства эти поручения не будут выполнены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861015
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4861015,
					"content": "Так что я рассчитываю на твою помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861016
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4861016,
					"content": "Я буду спокоен, если сам почётный рыцарь займётся этими делами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861017
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4861017,
					"content": "А почему бы тебе самому ими не заняться, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861018
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4861018,
					"content": "Ха-ха! Поверь, малышка Паймон, у меня есть куда более серьёзные дела. Очень важные дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861019
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 4861019,
					"content": "Понятненько. Значит <color=#00E1FFFF>Сара, Чарльз и Маргарита</color>, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861020
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4861020,
					"content": "Да. Спасибо за помощь. До встречи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэйа"
				}
			]
		},
