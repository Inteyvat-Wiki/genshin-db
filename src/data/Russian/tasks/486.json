					"nextDialogs": [
						4860817
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 4860817,
					"content": "Похоже, что она хочет от нас избавиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860818
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860818,
					"content": "Гм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860819
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 4860819,
					"content": "#Ничего. Больше не будем вам мешать. Пойдём, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 48610,
			"completionStepIds": [
				48610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
