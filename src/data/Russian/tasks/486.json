					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860513
					]
				},
				{
					"id": 4860513,
					"content": "#{NICKNAME}, какая же ты всё-таки размазня! Нам разве больше нечем заняться?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860514,
					"content": "Сара и Чарльз тоже нуждаются в нашей помощи. Давай сначала поговорим с Джинн!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860515,
					"content": "Вы собираетесь к Джинн? Какое совпадение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860516
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 4860516,
					"content": "Я думала, что ты ищешь котика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860517,
					"content": "Ищу! Я собиралась попросить Джинн поискать котика!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860518
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 4860518,
					"content": "Серьёзно? Ты собиралась попросить Джинн поискать твоего котика?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860519
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860519,
					"content": "А что в этом такого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860520
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 4860520,
					"content": "Джинн очень добрая и отзывчивая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860521
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 4860521,
					"content": "Хм. Весомый довод.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860522
					]
				},
				{
					"id": 4860522,
					"content": "Это уже слишком...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860523
					]
				},
				{
					"id": 4860523,
					"content": "Пожалуйста, поговори об этом с Джинн. А я бесплатно налью тебе в «Кошкином хвосте».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860524
					],
					"speakerTitle": "Маргарита"
				},
				{
					"id": 4860524,
					"content": "Эм... Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860525
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860525,
					"content": "Поверить не могу! Мы что, будем говорить с Джинн о сбежавшем котике?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
