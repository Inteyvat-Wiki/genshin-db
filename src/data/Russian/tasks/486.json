			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сара"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860203,
					"content": "Что случилось, Сара?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860204
					]
				},
				{
					"id": 4860204,
					"content": "#Спасибо, я не голод{M#ен}{F#на}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860205
					]
				},
				{
					"id": 4860202,
					"content": "Наконец-то вы пришли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860203
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860205,
					"content": "Я здесь не для этого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860206
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860206,
					"content": "#У меня есть просьба к Ордо Фавониус, и я хочу, чтобы ты передал{F#а} её действующему магистру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860207
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860207,
					"content": "Ты хотела обратиться к Джинн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860209,
					"content": "Мы с ней не разлей вода.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860210
					]
				},
				{
					"id": 4860211,
					"content": "Мы виделись всего несколько раз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860212
					]
				},
				{
					"id": 4860213,
					"content": "Я её покорный слуга.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860214
					]
				},
				{
					"id": 4860208,
					"content": "Вы хорошо знаете Джинн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860209
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860210,
					"content": "Правда? Наверное, здорово иметь таких друзей как Джинн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860211
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860212,
					"content": "Я слышала, что она относится к тебе с большим уважением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860213
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860214,
					"content": "Слуга? Не знала, что в Ордо Фавониус распространена подобная практика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860215
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860215,
					"content": "#{NICKNAME} шутит. Как всегда, неудачно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860216,
					"content": "В чём заключается твоя просьба к Джинн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860217,
					"content": "Я бы и сама сходила к рыцарям, но у меня полно работы в ресторане, нет ни минутки свободного времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860218
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860218,
					"content": "Как назло, именно сейчас торговые пути наших поставщиков захватили хиличурлы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860219
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860220,
					"content": "Поэтому ты решила обратиться к рыцарям.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860221
					]
				},
				{
					"id": 4860222,
					"content": "Ясно. Ты хочешь, чтобы кто-то серьёзно поговорил с охотниками.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860223
					]
				},
				{
					"id": 4860219,
					"content": "Дело в том, что охотники в Спрингвейле отвечают только за добычу мяса. Поставки - это не их занятие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860220
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860221,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860222
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860223,
					"content": "Нет! Разве это поможет решить проблему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860225,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860226
					]
				},
				{
					"id": 4860224,
					"content": "Пожалуйста, <color=#00E1FFFF>попросите Джинн</color> отправить отряд рыцарей зачистить дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860225
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860226,
					"content": "Фух. Теперь я могу быть спокойна. Джинн точно с этим разберётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860227
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860227,
					"content": "Похоже, что все здесь рассчитывают на Джинн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860228,
					"content": "Похоже на то. Кстати, наш <color=#00E1FFFF>бармен Чарльз</color> тоже хотел о чём то попросить Джинн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860229
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860229,
					"content": "Поговорите с ним?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860230
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 4860230,
					"content": "Ладно. Согласились помочь тебе, поможем и ему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 48603,
			"completionStepIds": [
				48603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48603",
							"2"
						],
						"stepId": 48603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чарльз"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860301,
					"content": "Малыш, мы здесь не подаём фруктовый сок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860302
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4860302,
					"content": "Эй, как грубо! Вообще-то мы собираемся тебе помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860303,
					"content": "#Помочь? Ты т{M#от}{F#а} сам{M#ый}{F#ая} новеньк{M#ий}{F#ая} из Ордо Фавониус, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860304
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4860304,
					"content": "Хм... Скорее всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860305,
					"content": "Отлично. Тогда передай Джинн, что мне нужна налоговая компенсация за прошедший квартал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860306
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4860306,
					"content": "Придётся снова обращаться к Эльзеру и объединять счета. В Мондштадте очень высокие налоги на алкоголь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860307
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4860307,
					"content": "Причём здесь Джинн?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860308
					]
				},
				{
					"id": 4860308,
					"content": "А винокурня «Рассвет» процветает.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860309
					]
				},
				{
					"id": 4860309,
					"content": "Господин Дилюк умеет вести дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860310
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4860310,
					"content": "Какое отношение Джинн имеет к счетам? Она теперь занимается ещё и бухгалтерским учётом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860311,
					"content": "Действующий магистр лично проверяет все счета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860312
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4860312,
					"content": "В конце концов, винная промышленность - основной источник прибыли городской казны. Джинн не может допустить никаких махинаций.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860313
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4860313,
					"content": "Как же сложно быть Джинн...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860314,
					"content": "Действующий магистр делает нашу жизнь намного лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860315
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4860315,
					"content": "Да, нам очень повезло, но мы стали принимать это как должное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860316
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4860316,
					"content": "Как у тебя получается спокойно спать по ночам, зная, как много всего приходится делать Джинн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860317,
					"content": "После твоих слов мне стало как-то не по себе. Надо будет в следующий раз налить ей за счёт заведения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860318
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4860318,
					"content": "Хотя вряд ли у неё найдется время выпивать в баре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860319
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 4860319,
					"content": "Звучит как дешёвая отговорка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4860320,
					"content": "#{NICKNAME}, пойдём скорее к <color=#00E1FFFF>Джинн</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
