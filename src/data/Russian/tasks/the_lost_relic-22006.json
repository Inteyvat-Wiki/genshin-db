			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сорайя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "#Спасибо тебе, путешественн{F#ица}{M#ик}! Это было ужасно... Похитители сокровищ в последнее время совсем обнаглели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060302,
					"content": "Кто ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "Меня зовут Сорайя. Я странствующий учёный. Прямо сейчас я занята исследованиями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060304,
					"content": "Несколько дней назад исследования привели меня в руины, где я обнаружила нефритовый диск с записями событий Войны Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060305,
					"content": "Но на обратном пути на меня напали Похитители сокровищ. Я попыталась убежать, но у меня не получилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060306,
					"content": "Если бы не ты, то пропала бы я вместе с нефритовым диском. Благодарю тебя ещё раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060307,
					"content": "Ты тоже учёный?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "#В смысле, тоже? Ты встречал{F#а} других учёных? Не помнишь их имена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060309,
					"content": "Бао Эр... Где-то я слышала это имя... Точно. Один из Похитителей сокровищ жаловался, что Бао Эр забирает все сокровища себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060310,
					"content": "Какое странное совпадение... Расскажи мне больше про эту Бао Эр, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060311,
					"content": "Вот, что я про неё помню...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "Хм... Эта Бао Эр говорила тебе о тех местах, которые я изучала. Возможно это и не совпадение вовсе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060313,
					"content": "Если она действительно из Похитителей сокровищ, то это значит, что за мной следят. Разбойники хотят, чтобы я привела их к сокровищам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060314,
					"content": "Бао Эр хотела забрать все сокровища себе, поэтому она отделилась от группы. Но эта область слишком велика для одного человека...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060315,
					"content": "#Похоже, что Бао Эр решила использовать тебя, путешественн{F#ица}{M#ик}. Готова поспорить, что она присматривалась и к этому месту тоже, но я и Похитители сокровищ добрались сюда раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060316,
					"content": "Это всего лишь моя догадка, но... Бао Эр - это очень странное имя, не так ли? Может быть, это прозвище или подпольная кличка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060317,
					"content": "#Путешественн{F#ица}{M#ик}, могу ли я попросить тебя отвлечь Бао Эр? Что бы ни случилось, этот нефритовый диск не должен оказаться в руках подозрительных личностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060318,
					"content": "Договорились.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "Спасибо. Но если ты вернёшься с пустыми руками, это будет выглядеть подозрительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060321,
					"content": "Можешь отдать ей вот эту безделушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060322,
					"content": "Вряд ли Бао Эр выручит за неё состояние, но, надеюсь, что это хотя бы не вызовет у неё лишних подозрений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060325,
					"content": "Ладно, тебе пора возвращаться. Мы только что победили Похитителей сокровищ, но так как сейчас Бао Эр работает в одиночку, то разбойники не смогут доложить о тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060326,
					"content": "Ах, да... Если найдёшь что-нибудь во время охоты за сокровищами для Бао Эр, то можешь принести это мне. Я остановилась на постоялом дворе «Ваншу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060327,
					"content": "Эх... Хоть мои способности и ограничены, но сохранять реликвии я умею.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060319,
					"content": "Если я вернусь с пустыми руками, у Бао Эр возникнут сомнения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "Действительно... Можешь отдать ей эту безделушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 220060324,
					"content": "Вряд ли Бао Эр выручит за неё состояние, но, надеюсь, что это хотя бы не вызовет у неё лишних подозрений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Сорайя"
				}
			]
		},
