				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060601,
					"content": "#Где ты бродил{F#а} так долго? Наш{F#ла}{M#ёл} что-нибудь интересное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060602,
						220060603
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060602,
					"content": "#Я наш{F#ла}{M#ёл} вот это.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060604
					]
				},
				{
					"id": 220060604,
					"content": "Эм... Неплохо, но... Это не совсем то, что мне нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060605
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060605,
					"content": "Но это тоже ценная реликвия. Я о ней позабочусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060609,
					"content": "Благодарю за помощь. Возьми, это тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060610
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060610,
					"content": "Эх... Но та другая потерянная реликвия... Надеюсь, с ней всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060603,
					"content": "Это то, что ты искала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060606
					]
				},
				{
					"id": 220060606,
					"content": "Это интересная штуковина, но искала я не её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060607
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060607,
					"content": "Эй, ты не умеешь правильно обращаться с реликвиями! Не разбей её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060608
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060608,
					"content": "Пускай лучше она побудет у меня. Я найду для неё достойное применение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "Бао Эр"
				}
			]
		},
		{
