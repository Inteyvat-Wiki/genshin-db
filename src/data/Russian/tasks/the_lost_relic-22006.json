			"dialogs": [
				{
					"id": 220060101,
					"content": "Не могу найти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060102
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060102,
					"content": "Что ты потеряла на этот раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060103
					]
				},
				{
					"id": 220060103,
					"content": "Ох, я ничего не потеряла НА ЭТОТ РАЗ! Я всё ищу свою коробку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060104
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060104,
					"content": "Где же она может быть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060105
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060105,
					"content": "Помоги мне найти коробку. Мы не можем просто так бросить такую ценность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060106,
						220060107
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060106,
					"content": "Хорошо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060108
					]
				},
				{
					"id": 220060108,
					"content": "Я буду искать в этой стороне, а ты в той.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060109
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060109,
					"content": "Мы обязаны найти её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060107,
					"content": "Что за реликвия на этот раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060110
					]
				},
				{
					"id": 220060110,
					"content": "Это... Это очень древняя реликвия! Ей больше тысячи лет! Это реликвия времен Войны Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060111
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 220060111,
					"content": "Короче, это очень ценная реликвия, и я просто обязана её найти! Помоги мне, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бао Эр"
				}
			]
		},
