				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210340501,
					"content": "#Ну что, путешественни{F#ца}{M#к}, с монстрами в лагере покончено?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340502,
						210340503
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340502,
					"content": "Всё чисто.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				},
				{
					"id": 210340504,
					"content": "Всего лишь горстка обычных монстров, это было легко. И мне повезло, я нашла обломок длинного меча. Ценная находка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340505
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340505,
					"content": "У меня ничего нет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340506
					]
				},
				{
					"id": 210340506,
					"content": "Не расстраивайся. Зато теперь я знаю, что там можно не искать. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340507
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340507,
					"content": "Вот твоё вознаграждение, спасибо за работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340508,
						210340509
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340508,
					"content": "Если удастся собрать все осколки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340510,
					"content": "Идея очень простая... Я хочу выковать новый Скрытый клинок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340511
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340511,
					"content": "Чертежи, в которых было описано устройство Скрытого клинка, утеряны... И я не знаю, какие материалы использовались при ковке... Но обязательно что-нибудь придумаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340512
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340512,
					"content": "Если я правда смогу выковать новый Скрытый клинок, мой брат наверняка... Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340509,
					"content": "Зачем ты собираешь эти осколки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340503,
					"content": "Как дела у тебя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				}
			]
		},
