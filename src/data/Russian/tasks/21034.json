					"Мисс Лань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210340101,
					"content": "Хм, наверное, он здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340102,
						210340103
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340102,
					"content": "Мисс Лань?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				},
				{
					"id": 210340104,
					"content": "#Путешественни{F#ца}{M#к}, не ожидала тебя здесь встретить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340105
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340105,
					"content": "#Помнишь рукоять меча, которую ты для меня отыскал{F#а}? Оказалось, когда-то она действительно была частью Скрытого клинка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340106
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340106,
					"content": "Забавно - я смогла опознать её по метке, которую сама же украдкой вырезала, когда была маленькой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340107
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340107,
					"content": "Я тогда просила брата, чтобы он отдал мне Скрытый клинок, если решит взять себе новый меч.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340108
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340108,
					"content": "Ха-ха, мы и подумать не могли... что от Скрытого клинка мне достанется одна рукоять. Получается... Скрытый клинок и правда превратился в обломки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340109
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340109,
					"content": "Ладно, не будем об этом. Раз уж мы встретились, хочу попросить тебя ещё об одном одолжении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340110
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340110,
					"content": "Впереди находятся два лагеря монстров. Эти монстры собрали в округе немало сломанного оружия и оттащили его к себе в логово. Не знаю, зачем оно им понадобилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340111
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340111,
					"content": "Гильдия искателей приключений решила очистить окрестности от монстров. Эта задача должна была стать очередным поручением Гильдии, но я решила, что не хочу им делиться. Быть может, здесь меня ждут осколки Скрытого клинка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340112
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340112,
					"content": "#Путешественни{F#ца}{M#к}, давай разделимся, и каждый пойдёт зачищать свой лагерь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340113
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340113,
					"content": "В лагере слева засела толпа хиличурлов. С одним хиличурлом ты справишься без труда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340114
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340114,
					"content": "Но там их очень и очень много. Если они накинутся на тебя целой толпой, придётся постараться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340115
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340115,
					"content": "Справа - лавачурл с каменным панцирем. Думаю, ты и без меня знаешь, как он опасен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340116
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340116,
					"content": "Я попросила тебя о помощи, так что выбор за тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340103,
					"content": "Что ты тут делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				}
			]
		},
