			},
			"dialogs": [
				{
					"id": 210340401,
					"content": "#Как дела? Всех монстров одолел{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340402
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340402,
					"content": "Ты что... уже расправилась со своими монстрами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340403
					]
				},
				{
					"id": 210340403,
					"content": "А? Да, конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340404
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340404,
					"content": "Я всё-таки глава Гильдии искателей приключений Ли Юэ. А они всего лишь кучка обычных монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				}
			]
		},
		{
			"id": 2103405,
			"completionStepIds": [
				2103404
