				{
					"id": 210340801,
					"content": "Хм, наверное, он здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340802,
						210340803
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340802,
					"content": "Мисс Лань?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340804
					]
				},
				{
					"id": 210340804,
					"content": "#{NICKNAME}! Какая удача, что мы снова встретились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340805
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340805,
					"content": "Да, я снова нашла в Гильдии несколько... хе-хе, «подходящих» поручений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340806
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340806,
					"content": "Всё как в прошлый раз. И мне снова нужна твоя помощь, чтобы избавиться от монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340807
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340807,
					"content": "В лагере слева засела толпа хиличурлов. С одним хиличурлом ты справишься без труда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340808
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340808,
					"content": "Но там их очень и очень много. Если они накинутся на тебя целой толпой, придётся постараться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340809
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340809,
					"content": "Справа - лавачурл с каменным панцирем. Думаю, ты и без меня знаешь, как он опасен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340810
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340810,
					"content": "Я попросила тебя о помощи, так что выбор за тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 210340803,
					"content": "Ты всё ищешь осколки своего меча?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340804
					]
				}
