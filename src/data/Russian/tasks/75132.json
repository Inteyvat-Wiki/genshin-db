			"dialogs": [
				{
					"id": 751320601,
					"content": "#Ах, {M#Чужеземный воин}{F#Чужеземная воительница}... Я чувствую... ваши деяния.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320602
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320602,
					"content": "Поразительно! Сила разложения вернулась к Владыке Ночи. Я чувствую радость ночных душ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320603
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320603,
					"content": "Примите это как воздаяние. Те, кто достиг величия, должны быть вознаграждены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Воля загадочного граффити"
				}
			]
		}
