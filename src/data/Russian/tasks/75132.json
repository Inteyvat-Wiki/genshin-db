			"dialogs": [
				{
					"id": 751320501,
					"content": "Остерегайтесь чёрного врага, что бродит рядом. Берегитесь врага, что подвергает всё разложению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320502,
					"content": "#{M#Чужеземный воин}{F#Чужеземная воительница}... О чём вы хотите спросить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320503,
						751320506,
						751320509,
						751320512
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320503,
					"content": "Расскажи о картинах, на которых изображены герои...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320504
					]
				},
				{
					"id": 751320504,
					"content": "К востоку, в пещерах, где колышутся светящиеся деревья, как говорят рассказчики со свитками в руках, скрывается ужас, затаившийся в историях из прошлого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320505
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320505,
					"content": "Возможно, эта тень использует истории прошлого, чтобы найти способ сбежать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320506,
					"content": "Расскажи о таинственном море...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320507
					]
				},
				{
					"id": 751320507,
					"content": "К западу в тумане покоится остров. Когда-то он был святилищем для проведения ритуальных обрядов. Там жили те, кто давным-давно заключил договор с иктомизаврами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320508
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320508,
					"content": "Но из него хлынула грязь, святилище превратилось в чёрную помойную яму, которую запечатали и предали забвению... Но коварный враг так просто не сдастся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320509,
					"content": "Расскажи о блёклом тумане...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320510
					]
				},
				{
					"id": 751320510,
					"content": "Этот мерзкий туман появился, когда был разрушен древний город Очканатлан. Изначально он был запечатан... Но время и память - лютые враги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320511
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320511,
					"content": "Если бы... Ах... Если бы кто-нибудь мог снова развеять этот блёклый туман...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320512,
					"content": "У меня нет вопросов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320513
					]
				},
				{
					"id": 751320513,
					"content": "Прошу... Запомните... Будьте осторожны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Воля загадочного граффити"
				}
			]
		},
