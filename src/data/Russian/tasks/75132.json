			"dialogs": [
				{
					"id": 751320101,
					"content": "#...Ах, {M#чужеземец, прибывший}{F#чужеземка, прибывшая} издалека...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320102
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320102,
					"content": "Прошу вас, прислушайтесь к моим словам. Я ворон-проводник, а также прощальная печаль истинного владыки ночи, размышляющего о поэзии... Или же я всего лишь одна из миллиарда мыслей, заблудившихся в лучах лунного света.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320103
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320103,
					"content": "Прошу вас, прислушайтесь к моим словам. Подземная духовная река оборвалась, и я могу говорить с вами только через это изображение и призываю вас остерегаться чёрного врага.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320104
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320104,
					"content": "Когда-то это разбитое зеркало отражало яркие блики. Но ныне тёмная дымка распространилась на три области. Запомните их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320105
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320105,
					"content": "Первая - на востоке. Тени, затаившиеся среди картин ушедших легендарных героев, постепенно начали проявляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320106
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320106,
					"content": "Вторая - на западе, в таинственном море, где чёрные воплощения подражают голосу Полуночного Короля, словно надоедливые попугаи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320107
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320107,
					"content": "Третья - под скалами, в блёклом тумане, что давно должен был рассеяться, но расползся после того, как сожжённый город снова начал бушевать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320108
					],
					"speakerTitle": "Воля загадочного граффити"
				},
				{
					"id": 751320108,
					"content": "#{M#Чужеземный воин}{F#Чужеземная воительница}, будьте настороже... Остерегайтесь чёрного врага, что бродит рядом. Берегитесь врага, что подвергает всё разложению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Воля загадочного граффити"
				}
			]
		},
