			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арагару",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580201,
					"content": "Ну как, что-нибудь нашлось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580202
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730580202,
					"content": "Только приказы, из которых ничего не понять. И вот это! Сухой цветок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730580203,
					"content": "А?.. Можешь отдать его мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580204
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730580204,
					"content": "Его оставили негодяи - вдруг он какой-нибудь ядовитый! Не боишься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730580205,
					"content": "Не беспокойся, этот цветок я уже видел... Кто-то знакомый... Можешь отдать цветок мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580206
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730580206,
					"content": "Возьми.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580207
					]
				},
				{
					"id": 730580207,
					"content": "#Спасибо, нара {NICKNAME} и белая леталка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580208
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730580208,
					"content": "Арагару относит засохшие цветы в лес Мотийимы...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7305804,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
