			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арагару",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580101,
					"content": "#{M#Золотой}{F#Золотая} нара, белая леталка! Опять вы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580102
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730580102,
					"content": "Ой! В другой раз сначала здоровайся! Паймон опять перепугалась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580103,
						730580104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730580103,
					"content": "Мы - друзья.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				},
				{
					"id": 730580105,
					"content": "#Гм... Может, и правда... Значит, {M#золотой}{F#золотая} нара и белая леталка, непохожие на негодяев, могут помочь мне ещё кое в чём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580106
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730580106,
					"content": "#Буду рад{F#а} помочь. Я {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580107
					]
				},
				{
					"id": 730580107,
					"content": "А я Паймон! На этот раз запомни как следует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730580108,
					"content": "На этот раз?.. Гм... Кхе-кхе, а я Арагару!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580109
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730580109,
					"content": "#Мы уже были с тобой здесь однажды, но ты всё забыл... Эх, как тебе объяснить... {NICKNAME}, давай расскажем ему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730580110,
					"content": "Вы рассказываете Арагару о ваших общих приключениях.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730580111
					]
				},
				{
					"id": 730580111,
					"content": "Вот как... Я ничего не помню, но мне почему-то хочется вам верить... К тому же у вас есть мой цветок, я его чувствую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580112
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730580112,
					"content": "Да, точно! Плохие нары ушли из лагеря, давайте посмотрим, что они оставили после себя? Вдруг сможем узнать, что они замышляют!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730580104,
					"content": "Мы помогли тебе прогнать негодяев.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				}
			]
		},
		{
			"id": 7305802,
			"completionStepIds": [
				7305804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
