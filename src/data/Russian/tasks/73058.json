					"Арагару"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580401,
					"content": "Давайте отправимся в лагерь плохих нар! Нужно узнать, что они здесь делают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730580402,
					"content": "Как ты определяешь, что они плохие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#Ну... Это сложно объяснить! Но я знаю наверняка, что нара {NICKNAME} и белая леталка не такие! Я в это верю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арагару"
				}
			]
		},
