			"dialogs": [
				{
					"id": 790000401,
					"content": "Нашли! Сокровища, сокровища, что же внутри?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790000402,
					"content": "Что? На крышке есть замок. Ещё и с паролем... Можно открыть, только если знать пароль?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000403,
						790000404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790000403,
					"content": "Может, получится его сломать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000405
					]
				},
				{
					"id": 790000405,
					"content": "Подожди! А что, если мы повредим сокровища внутри?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790000406,
					"content": "Давай лучше подумаем, как нам его открыть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790000410,
					"content": "Смотри. Если в этой коробке хранится какая-то семейная реликвия, да ещё и закрыта она на замок с паролем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790000411,
					"content": "Это значит, что и человек, закрывший эту коробку, считает, что пароль легко запомнить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790000412,
					"content": "Похоже, нашей единственной надеждой остаются эти ракушки, сохраняющие звук.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790000413,
					"content": "Давай ещё раз попытаемся внимательно расслышать что-нибудь похожее на пароль в этих ракушках...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790000404,
					"content": "Нужно придумать, как его открыть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000407
					]
				},
				{
					"id": 790000407,
					"content": "А вокруг нет никаких каменных табличек, фресок, записок, гравировок и блокнотов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790000408,
					"content": "Каких-то учёных, Похитителей сокровищ и искателей приключений тоже нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000409
					]
				},
				{
					"id": 790000409,
					"content": "Да уж, с нами такого ещё не бывало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
