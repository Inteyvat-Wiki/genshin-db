			},
			"dialogs": [
				{
					"id": 751450101,
					"content": "О Избранник драконов, Избранник драконов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450102,
					"content": "Священная гора прямо перед тобой... Если... то нужно избавиться от врага, что таится в тени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450103,
					"content": "#{M#Избранник}{F#Избранница} драконов... войди... войди в Священную гору...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450104,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450105,
					"content": "Это что было... извержение вулкана?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450106
					]
				},
				{
					"id": 751450106,
					"content": "Нет, вулкан стоял тихо... А вы видели, как он извергается?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450107,
					"content": "#{NICKNAME}? {REALNAME[ID(2)|SHOWHOST(true)]}? Что с вами? Вы о чём задумались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450108,
					"content": "Вы похожи на двух детективов из лёгкого романа, которые внезапно узнали правду, кто является убийцей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450109,
						751450112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450109,
					"content": "Нам действительно открылась правда, но другая...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450110
					]
				},
				{
					"id": 751450110,
					"content": "(Вы рассказываете Паймон о том, что увидели...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450111
					]
				},
				{
					"id": 751450111,
					"content": "#Что? Ты увидел{F#а} ту же самую картину, как когда мы только прибыли в Натлан и впервые повстречали малыша?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450118,
					"content": "И странные образы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450119,
					"content": "Э-э?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450120,
					"content": "#{NICKNAME}, ты ведь и в тот раз говорил{F#а}, что видел{F#а} странные слова... Паймон сама ничего не видела, но вдруг они принадлежат одному и тому же человеку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450121,
					"content": "#Я уверен{F#а}, что так и есть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450122
					]
				},
				{
					"id": 751450122,
					"content": "Но в этот раз вы видели... огромные руины и Бездну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450123,
					"content": "И «Священную гору»... Хм, натланцы называют «Священной горой» свой вулкан. Вдруг ваше видение как-то связано с вулканом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450124,
					"content": "Паймон кажется, что тот, кто устроил нашу встречу с малышом, хочет, чтобы мы вошли в Священную гору...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450125,
					"content": "#Вдруг там мы сможем выяснить, откуда взялся {REALNAME[ID(2)|SHOWHOST(true)]}... Или даже встретим его родных...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450126,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450127,
					"content": "Словом... Надо бы нам разузнать побольше об этом вулкане.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450128,
					"content": "Слушайте! Удел Благодатных Земель - одно из шести племён Натлана - находится как раз рядом с вулканом! Надо отправиться туда и всё разузнать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450112,
					"content": "Настоящий убийца пирожного... это ты, Паймон!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450113
					]
				},
				{
					"id": 751450113,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450114,
					"content": "Да ладно! Как вы узнали? Паймон была уверена, что никто не видел, как она ест маленькую госпожу пироженку... Шутка! На самом деле Паймон съела не пирожное, а пламенное тушёное мясо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450115,
					"content": "Стоп... Но что вы всё-таки увидели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751450116,
					"content": "(Вы рассказываете Паймон о том, что увидели...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450117
					]
				},
				{
					"id": 751450117,
					"content": "Значит, снова странные слова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Паймон"
				}
			]
		},
