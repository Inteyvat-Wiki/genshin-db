			"dialogs": [
				{
					"id": 718173201,
					"content": "#Спасибо. Ты мне очень помог{F#ла}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718173202
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718173202,
					"content": "Видишь, как я занят? Все отмечают Праздник морских фонарей, а я ещё даже свой фонарик не сделал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718173203
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718173203,
					"content": "К слову, ты делать небесные фонари умеешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718173204
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718173204,
					"content": "Мне неловко о таком тебя просить, но у меня совсем нет времени искать материалы для небесного фонаря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718173205
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718173205,
					"content": "#Не мог{F#ла} бы ты сделать мне один... Нет, два, два небесных фонаря?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718173206
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718173206,
					"content": "Один я оставлю себе, а другой, пожалуйста, отнеси Цзян Сюэ. Он обычно рыбачит у постоялого двора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718173207
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718173207,
					"content": "Этот пройдоха... Обычно он приходит сюда бесплатно поесть, но сегодня почему-то его не было...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
