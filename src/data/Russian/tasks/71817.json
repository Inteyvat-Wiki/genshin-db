			},
			"dialogs": [
				{
					"id": 718170101,
					"content": "Какой ужас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170102
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718170102,
					"content": "Что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170103
					]
				},
				{
					"id": 718170103,
					"content": "Праздник морских фонарей случился, вот что. Почти все работники постоялого двора ушли праздновать в город, и теперь у нас завал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170104
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718170104,
					"content": "Прости, на разговоры нет времени, нужно готовиться к вечернему наплыву гостей. Боюсь, не будет даже секунды, чтобы присесть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170105
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718170105,
					"content": "#Раз уж ты потрудил{F#ась}{M#ся} навестить меня, так почему бы тебе вечером не помочь мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170106
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718170106,
					"content": "Эх... Полцарства за помощника! Где это Юй Хуа запропастилась?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
			]
		},
		{
			"id": 7181702,
			"completionStepIds": [
				7181701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
