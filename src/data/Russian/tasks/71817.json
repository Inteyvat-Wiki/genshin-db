						"stepId": 7181701,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_IS_DAYTIME",
						"rawParams": [
							"0"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181722",
							"3"
						],
						"stepId": 7181722,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Улыбчивый Янь Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718170201,
					"content": "Это не дело. У меня уже руки отваливаются...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170202
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718170202,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170203
					]
				},
				{
					"id": 718170203,
					"content": "#О, путешественни{F#ца}{M#к}! Мне позарез нужна помощь... Ты как, подсобишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170204
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718170204,
					"content": "С чем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170205
					]
				},
				{
					"id": 718170205,
					"content": "На Праздник морских фонарей почти все наши работники ушли праздновать в город. У нас сейчас завал, и мы будем рады любой помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170206
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718170206,
					"content": "Но ты не переживай, мы грузить тебя не будем. Тебе нужно будет лишь подать пару блюд и купить немного ингредиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170207
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718170207,
					"content": "Так, посмотрим, с чем ты сейчас можешь помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
			]
		},
		{
			"id": 7181703,
			"completionStepIds": [
				7181702
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
