				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718170301,
					"content": "Ох! Я забыл взять заказы у гостей внизу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170302
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718170302,
					"content": "Вот что, спустись и прими заказ у наших иноземных гостей, Гёльдерлина и Каспара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170303
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718170303,
					"content": "Они уже заждались, поэтому могут быть не в духе. Не забудь принести им <color=#00E1FFFF>два</color> бесплатных блюда. Для этого хорошо подойдёт <color=#00E1FFFF>вкусный куриный шашлычок с грибами</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170304
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718170304,
					"content": "Когда подашь их, сразу спроси, чего гости хотели бы в качестве основного блюда, чтобы не пришлось бегать дважды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170305
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718170305,
					"content": "Ну, давай. Не заставляй гостей ждать ещё дольше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
			]
		},
