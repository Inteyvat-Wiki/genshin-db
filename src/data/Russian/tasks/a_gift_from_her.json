			"dialogs": [
				{
					"id": 761230101,
					"content": "Ммм, какой аромат! Неужели у Коломбины снова время обеда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230102,
					"content": "Куухенки... выстроились в очередь, а Коломбина разливает суп?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230103,
					"content": "Подождите немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230104
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230104,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230105
					],
					"speakerTitle": "Куухенки"
				},
				{
					"id": 761230105,
					"content": "Вау, как вкусно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230106,
					"content": "Вкусный освежающий фруктовый суп... Паймон никогда не пробовала ничего подобного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230107,
					"content": "Хочешь ещё одну порцию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230108
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230108,
					"content": "Две порции!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230109,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230110
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 761230110,
					"content": "Учишься готовить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230111
					]
				},
				{
					"id": 761230111,
					"content": "Да. Я попросила у Инеффы несколько простых рецептов и попробовала их приготовить. Куухенки и зверушки остались довольны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230112
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230112,
					"content": "В процессе приготовления возникли сложности?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230113
					]
				},
				{
					"id": 761230113,
					"content": "Хм, рукава слишком широкие, можно случайно задеть кастрюлю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230114
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230114,
					"content": "(Так дело не в сложности приготовления.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230115
					]
				},
				{
					"id": 761230115,
					"content": "Когда дело доходит до десертов, я немного теряюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230116
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230116,
					"content": "Нужно правильно подобрать температуру и пропорции...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230117
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230117,
					"content": "(Похоже, она нечасто готовила для себя.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230118
					]
				},
				{
					"id": 761230118,
					"content": "(Сложно научиться готовить десерты самостоятельно, методом проб и ошибок...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230119
					]
				},
				{
					"id": 761230119,
					"content": "Хочешь, я помогу тебе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230120
					]
				},
				{
					"id": 761230120,
					"content": "Хорошо. Давай начнём с крумкаке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230121
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230121,
					"content": "Через некоторое время...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230122
					]
				},
				{
					"id": 761230122,
					"content": "Хочешь попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230123,
						761230124
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230123,
					"content": "(Откусить маленький кусочек)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				},
				{
					"id": 761230125,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230126
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230126,
					"content": "(Сперва очень кисло...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230127
					]
				},
				{
					"id": 761230127,
					"content": "(Но после того, как проглотишь, появляется сладость... Может, станет вкуснее, когда привыкну?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230128
					]
				},
				{
					"id": 761230128,
					"content": "Ну как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230129,
						761230130
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230129,
					"content": "Сойдёт...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230131,
					"content": "Паймон что-то пропустила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230132,
					"content": "Паймон, попробуй.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230133
					]
				},
				{
					"id": 761230133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230134,
					"content": "У-у-у, как кисло! За что вы так с Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230135,
					"content": "Ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230136
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230136,
					"content": "Послевкусие неплохое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230137
					]
				},
				{
					"id": 761230137,
					"content": "Всё дело в первом кусочке! Неужели никто не мог предупредить, чтобы Паймон откусила поменьше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230138
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230138,
					"content": "#Если бы ты не сказал{F#а}, Паймон подумала бы, что ты хочешь подшутить и посмотреть на реакцию Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230139,
					"content": "Ладно, я попробую ещё раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230140
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230140,
					"content": "Проходит больше времени...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230141
					]
				},
				{
					"id": 761230141,
					"content": "Вот, попробуй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230142
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230142,
					"content": "(Мм!.. Намного лучше!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230143,
						761230144
					]
				},
				{
					"id": 761230143,
					"content": "Очень вкусно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230145,
					"content": "Правда? Паймон тоже хочет! Ммм!.. Вот это да! Вкуснотища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230146
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230146,
					"content": "Думаете, получилось достаточно хорошо, чтобы преподнести в качестве подарка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230147
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230147,
					"content": "Конечно! О, Коломбина, ты учишься готовить крумкаке, потому что хочешь сделать кому-то подарок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230148
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230148,
					"content": "Да... Хочу подарить друзьям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230149
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230149,
					"content": "Хорошая идея.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230150
					]
				},
				{
					"id": 761230150,
					"content": "Помните, как вы впервые пришли сюда? Вы приготовили для меня еду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230151
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230151,
					"content": "Еда не помогла мне восстановить утраченную силу, но зато дала возможность почувствовать себя спокойнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230152
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230152,
					"content": "Тогда я не задумывалась о причинах, но теперь я всё понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230153
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230153,
					"content": "Время и усилия, которые мы тратим на приготовление, превращают простую еду в творение, наделённое душой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230154
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230154,
					"content": "Я наслаждалась не столько самой едой, сколько теплотой и добротой рук, которые её приготовили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230155
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230155,
					"content": "И чем меньше эти руки ищут вознаграждения, тем больше тепла и доброты нужно, чтобы ответить взаимностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230156
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230156,
					"content": "Ах, Паймон стало неловко от твоих слов... Честно говоря, тогда мы очень хотели завоевать твою благосклонность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230157,
						761230158
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230157,
					"content": "Но сейчас всё по-другому.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230159,
					"content": "Да. Но теперь я всё понимаю, и хотела бы сделать что-то большее... Это прекрасное чувство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230160
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230160,
					"content": "Пойдёте со мной навестить наших друзей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230161
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230161,
					"content": "Помимо крумкаке, я также приготовила другие подарки. Но их нужно передать тайно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230162
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230162,
					"content": "Почему именно тайно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230163
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230163,
					"content": "Вы всегда преподносили мне приятные сюрпризы. А теперь мой черёд. Очень хочется увидеть, как порадуются мои друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230164
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230164,
					"content": "Фух, мы столько мест обежали! Доставили все подарки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230165
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230165,
					"content": "Однако их реакция была неожиданной. Некоторые даже не поняли, что это подарки от тебя, Коломбина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230166
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230166,
					"content": "Айно сразу же принялась есть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230167
					]
				},
				{
					"id": 761230167,
					"content": "Ничего страшного, я этого и ожидала. Главное, чтобы друзья были рады подаркам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230168
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230168,
					"content": "Лаума точно поняла, что крумкаке и венок на столе были от тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230169
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230169,
					"content": "Паймон понимает, почему она не решилась надеть венок. Но крумкаке... Она смотрела на угощение добрых десять минут, но так и не съела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230170
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230170,
					"content": "#Я уже начал{F#а} бояться, что она захочет сохранить их как реликвии...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230171
					]
				},
				{
					"id": 761230171,
					"content": "Похоже, Ягода сильно испугалась... Может, не стоило тайком класть подарки позади неё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230172
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230172,
					"content": "Она аж подпрыгнула от испуга...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230173
					]
				},
				{
					"id": 761230173,
					"content": "Может быть, она от природы более настороженная? Но она немного успокоилась, когда Ашру подошёл к когтеточке, которую ты подарила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230174
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230174,
					"content": "Я рассчитываю, что вы доставите подарки другим нашим друзьям за пределами Нод-Края.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230175
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230175,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230176
					],
					"speakerTitle": "Ибис"
				},
				{
					"id": 761230176,
					"content": "#{F#Должна}{M#Должен} сказать, ты прекрасно умеешь выбирать подарки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230177
					]
				},
				{
					"id": 761230177,
					"content": "Это вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230178
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230178,
					"content": "О! Настала наша очередь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230179
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230179,
					"content": "А? Сладости? Паймон думала, что будут крумкаке, как у всех!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230180
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761230180,
					"content": "Ты ведь уже пробовала их. Разве не лучше попробовать что-то новенькое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230181,
						761230182
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230181,
					"content": "Ммм... Очень вкусно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230183,
					"content": "Приятно слышать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230184
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230184,
					"content": "Ещё один подарок для тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230185
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230185,
					"content": "Это... планер?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230186
					]
				},
				{
					"id": 761230186,
					"content": "Говорят, что небо принадлежит птицам, суша - зверям...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230187
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230187,
					"content": "А огромное пространство между небом и землёй создано для искателей приключений, парящих на планерах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230188
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230188,
					"content": "В те дни, когда он с тобой, твой путь будет таким же ясным, как при лунном свете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230189
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230189,
					"content": "Мне очень нравится. Спасибо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230190
					]
				},
				{
					"id": 761230190,
					"content": "Спасибо, что ты рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761230182,
					"content": "Вкуснее, чем сладости в Ночь лунной молитвы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230158,
					"content": "Если хочешь что-нибудь поесть, скажи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230144,
					"content": "Ты быстро учишься!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230130,
					"content": "Но есть над чем поработать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
