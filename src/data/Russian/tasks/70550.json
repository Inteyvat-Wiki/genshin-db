						],
						"stepId": 7055010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кли"
				],
				"points": [
					{
						"sceneId": 51205,
						"position": [
							2198.146,
							230.219,
							-780.029
						],
						"pointId": 1
					},
					{
						"sceneId": 51205,
						"position": [
							2198.069,
							230.089,
							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500301,
					"content": "Та-дам! Готово! Этот напиток тебе точно понравится!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500302
					]
				},
				{
					"id": 705500302,
					"content": "Ого! Напиток с додоконфетой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500303
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500303,
					"content": "Стаканчик весь такой оранжевый, будто Додоко лежит на белом облачке... И такая погода нравится Кли намного больше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500304
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500304,
					"content": "Попробуешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500305
					]
				},
				{
					"id": 705500305,
					"content": "Мм... вкуснотища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500306
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500306,
					"content": "Кли будет пить медленно, нельзя взять и проглотить залпом такую вкусноту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500307
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500307,
					"content": "#Чудеса... {M#Дядя}{F#Тётя} почётный рыцарь, ты будто добавил{F#а} в напиток солнечный свет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500308
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500308,
					"content": "Кли так устала от игр... Но теперь чувствует себя хорошо! На душе тепло и так спокойно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500309
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500309,
					"content": "#*зевает* {M#Дядя}{F#Тётя} почётный рыцарь, ты {M#лучший}{F#лучшая}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500310,
						705500311
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500310,
					"content": "Кли, придумаешь, как будет называться этот напиток?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				},
				{
					"id": 705500312,
					"content": "Можно? Надо подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500313
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500313,
					"content": "Когда погода радует и настроение хорошее, Додоко захочется спеть песенку, правильно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500314
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500314,
					"content": "Додоко поёт, и Кли подпевает... так что назовём это... «Дуэт Додоко»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500315,
						705500316
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500315,
					"content": "Отличное название!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500317,
					"content": "#Хе-хе, спасибо, {M#дядя}{F#тётя} почётный рыцарь! И спасибо за вкусный напиток для Кли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500318
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500318,
					"content": "Расскажу маме, что самый вкусный напиток в Мондштадте называется «Дуэт Додоко»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500319,
						705500320
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500319,
					"content": "#Я рад{F#а}, что тебе понравилось!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500321,
					"content": "Тогда Кли запишет для тебя мамино заклинание на бумажке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500322
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500322,
					"content": "И ты тоже научишься делать сладости! Какие захочешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500323
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500323,
					"content": "До встречи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500320,
					"content": "#Я {F#прошла}{M#прошёл} испытание наставника Кли!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500316,
					"content": "Кли, ты круче всех придумываешь названия!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500311,
					"content": "Наверняка тебе в голову придёт самое крутое название!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				}
			]
		}
	]
}