				"points": [
					{
						"sceneId": 51205,
						"position": [
							2198.146,
							230.219,
							-780.029
						],
						"pointId": 1
					},
					{
						"sceneId": 51205,
						"position": [
							2198.069,
							230.089,
							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500201,
					"content": "«Хорошая погода» готова. Попробуй скорее!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500202
					]
				},
				{
					"id": 705500202,
					"content": "Ого, так вот какого цвета должна быть «Хорошая погода»? Фиолетовое небо... это звёздная ночь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500203,
						705500204
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500203,
					"content": "Может, это ясный вечер после заката?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				},
				{
					"id": 705500205,
					"content": "Давай Кли попробует... а потом ты подумаешь над названием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500206
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500206,
					"content": "Ага, допила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500207
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500207,
					"content": "Вкусно! Он кислый и сладкий одновременно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500208
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500208,
					"content": "С таким напитком Кли за один присест съест целые две жареные рыбки! Или три, или четыре... или даже пять!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500209
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500209,
					"content": "Но одного стакана мало. Теперь приготовь Кли такой напиток... чтобы он был похож на торт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500210,
						705500211,
						705500212
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500210,
					"content": "Хорошо. Приготовить тебе «Десерт в бокале»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500213,
					"content": "#Хм... Кли не знает, какой напиток выбрать. Давай подумаем вместе, {M#дядя}{F#тётя} почётный рыцарь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500214
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500214,
					"content": "Ты принесла какие-то очень интересные сладости.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500215
					]
				},
				{
					"id": 705500215,
					"content": "Это? Хе-хе... Мама научила меня готовить их на алхимическом верстаке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500216
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500216,
					"content": "Нужен сахар, много сахара! Ещё цветы от маминой подружки из Фонтейна, звёздный мёд от тёти Барбелот и ещё волшебное варенье, которое маме подарила тётя Тавия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500217
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500217,
					"content": "Кладёшь все материалы на алхимический верстак, загадываешь нужную форму, повторяешь за мамой заклинание, и... Бах! У тебя додоконфета!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500218,
						705500219
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500218,
					"content": "Вот это технология...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500220,
					"content": "#Кли угостит {M#дядю}{F#тётю} почётного рыцаря додоконфетками! Если хочешь, научу тебя заклинанию, которому меня научила мама.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500221
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500221,
					"content": "Ты тоже сможешь готовить себе любые сладости, какие захочешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500222,
						705500223
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500222,
					"content": "Спасибо за чудесный рецепт, Кли!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500224,
					"content": "Хе-хе, если что-то будет непонятно, спрашивай у Кли! Кли эксперт по волшебным сладостям!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500225
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500225,
					"content": "Какие у тебя сегодня планы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500226
					]
				},
				{
					"id": 705500226,
					"content": "Ну, мама недавно дала Кли одну крутую книжку, чтобы Кли каждый вечер читала по главе и училась всякому нужному, а потом вовремя ложилась спать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500227
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500227,
					"content": "По этой книжке Кли научилась делать штуку под названием «пропеллент», теперь Прыг-скок бомбы прыгают ещё выше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500228,
						705500229
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500228,
					"content": "#Э... не уверен{F#а}, что это то, чему тебе нужно учиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500230,
					"content": "Совсем не сложно! Очень похоже на изготовление бомб, главное - работать аккуратно. Представь, что ты точишь карандаш, который может в любую секунду взорваться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500231
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500231,
					"content": "Время перед сном мы тоже проводим с пользой! Мама садится рядом и рассказывает Кли разные сказки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500232
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500232,
					"content": "Мама сделала такой... фонарь из самоцветов, и когда он загорается, на потолке появляются картинки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500233
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500233,
					"content": "Мама показывает на нём картинки из сказок?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500234
					]
				},
				{
					"id": 705500234,
					"content": "Да! Пока мама рассказывает сказку, огоньки на потолке складываются в красивые картинки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500235
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500235,
					"content": "А иногда мама засыпает раньше, чем заканчивается сказка, и тогда Кли укрывает маму одеялом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500236
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500236,
					"content": "#Когда Кли научится пользоваться этим фонариком, она будет рассказывать сказки {M#дяде}{F#тёте} почётному рыцарю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500237,
						705500238
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500237,
					"content": "Хорошо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500239,
					"content": "Хе-хе, Кли запомнила так много сказок! Она может рассказывать их хоть каждый день!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500240
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500240,
					"content": "Ты ещё будешь сегодня ужинать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500241
					]
				},
				{
					"id": 705500241,
					"content": "Ага! Дома Кли будет читать книжку и есть... солёные орешки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500242
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500242,
					"content": "Раньше после ужина Кли всегда ела пирожные! Но магистр Джинн сказала, что в пирожных слишком много сахара. Перед сном их есть очень вредно, от них толстеешь, а ещё могут разболеться зубки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500243
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500243,
					"content": "Поэтому мама послушалась совета тёти Барбелот и стала давать Кли орешки. Мама говорит, что орешки помогают развивать память!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500244
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500244,
					"content": "Орешки на вкус совсем пресные, будто траву жуёшь. Но если их посолить, получается очень даже вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500245
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500245,
					"content": "Отличный выход, орешки питательные и полезные.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500246
					]
				},
				{
					"id": 705500246,
					"content": "Надо поискать ингредиенты, которые будут одновременно сладкими и полезными...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500247
					]
				},
				{
					"id": 705500247,
					"content": "Да... Кли всё равно любит сладкое! Например, пирожные! Может, сделать слой крема потоньше... или добавить побольше фруктов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500248
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500248,
					"content": "Да, точно! Мамина подруга, которая всегда носит очки, привезла ей большой мешок фруктов из Фонтейна. Они такие кругленькие! Называются «пузырины».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500249
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500249,
					"content": "Кли съела несколько штук сразу, они оказались очень сладкими! И магистр Джинн не возражала, она сказала так: «Сладость фруктов - не то же самое, что сладость сахара!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500250
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500250,
					"content": "Так что, если без орешков никак, вдруг их можно в соке вымачивать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500251
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500251,
					"content": "Кстати, Кли, ты ведь не забываешь завтракать, всегда ешь три раза в день?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500252
					]
				},
				{
					"id": 705500252,
					"content": "Три раза в день? Хе-хе, Кли иногда ест пять раз в день, а иногда даже семь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500253
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500253,
					"content": "Серьёзно?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500254
					]
				},
				{
					"id": 705500254,
					"content": "На приключения уходит очень много сил, а если съесть слишком много еды за раз, бегать будет тяжело... Поэтому лучше есть немного, но часто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500255
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500255,
					"content": "Раньше дядя Альбедо собирал для Кли обед в дорогу, и это всегда было произведение искусства - прямо как картинка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500256,
						705500257
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500256,
					"content": "Да, узнаю Альбедо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500258,
					"content": "Когда дядя Альбедо занят на Драконьем хребте, Кли присоединяется к кому-то из других рыцарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500259
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500259,
					"content": "У Кэйи всегда самый опрятный лагерь, а Эмбер иногда устраивает себе лагерь на дереве, вот весело! А тётя Герта готовит вкуснее всех!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500260
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500260,
					"content": "Когда мама вернулась, у Кли появилось ещё больше интересных и вкусных блюд. Например, из рыбы и рыбного бульона мама делает желейные кубики! Это называется «радужная заливная рыба»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500261,
						705500262
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500261,
					"content": "У меня даже слюнки потекли...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500263,
					"content": "А ещё Кли обожает шоколадные хрустяшки! Это новое изобретение мамы, для них нужны шоколад и печенье! Они немного горькие, но такие хрустящие, рассыпчатые и ароматные! И после горечи во рту очень сладко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500264
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500264,
					"content": "#Хрустяшки наполняют Кли силой... В следующий раз Кли принесёт {M#дяде}{F#тёте} почётному рыцарю попробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500265
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500265,
					"content": "Так, я знаю, что можно улучшить!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500266
					]
				},
				{
					"id": 705500266,
					"content": "Приготовлю тебе ещё один вкусный напиток!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500267
					]
				},
				{
					"id": 705500267,
					"content": "Так быстро? Ура!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500268
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500268,
					"content": "Интересно, какой будет вкус... Кли очень хочет попробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500262,
					"content": "Еда для настоящего искателя приключений...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500257,
					"content": "Тоже мечтаю попробовать стряпню Альбедо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500238,
					"content": "Буду ждать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500229,
					"content": "Эм... это так просто?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500223,
					"content": "Я буду учиться и однажды тоже приготовлю себе сладости!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500219,
					"content": "Какой чудесный десерт...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500211,
					"content": "Хорошо, приготовлю Кли ещё один вкусный напиток!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500212,
					"content": "С каким вкусом? Выбирай любой!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500204,
					"content": "Название напитка не сочетается с цветом. Я его изменю!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				}
			]
		},
		{
			"id": 7055003,
			"completionStepIds": [
				7055010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
