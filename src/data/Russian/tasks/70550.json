				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кли"
				],
				"points": [
					{
						"sceneId": 51205,
						"position": [
							2198.146,
							230.219,
							-780.029
						],
						"pointId": 1
					},
					{
						"sceneId": 51205,
						"position": [
							2198.069,
							230.089,
							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500101,
					"content": "#Ой! Это {M#дядя}{F#тётя} почётный рыцарь? Ура-а-а!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500102,
						705500103
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500102,
					"content": "Да это же Кли!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				},
				{
					"id": 705500104,
					"content": "#Ха-ха, тётя Эола рассказала Кли, что тётя Герта нашла в киоск {F#крутую помощницу}{M#крутого помощника}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500105
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500105,
					"content": "#И когда Кли увидела здесь {M#дядю}{F#тётю} почётного рыцаря, то поняла, что это самый лучший киоск с напитками во всём Тейвате!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500106,
						705500107
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500106,
					"content": "Спасибо, Кли! Надеюсь, однажды так и будет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500108,
					"content": "То есть... сейчас твой киоск не лучший в Тейвате?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500109
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500109,
					"content": "Тогда... у тебя лучший киоск среди всех киосков с напитками, где была Кли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500110
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500110,
					"content": "#И... какой бы напиток ни приготовил{F#а} {M#дядя}{F#тётя} почётный рыцарь, Кли он точно понравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500111,
						705500112
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500111,
					"content": "На этот раз ты должна быть построже, Кли!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500113,
					"content": "Ой... Правда? Но Кли совсем не умеет быть с тобой строгой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500114
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500114,
					"content": "Кли подумает... Придумала! Я буду как дядя Альбедо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500115
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500115,
					"content": "Дядя Альбедо всегда очень строгий, когда проверяет работы дяди Тимея! В прошлый раз он сильно ругался, и Кли запоминала каждое его слово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500116,
						705500117
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500116,
					"content": "Отлично! Кли будет моим учителем!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500118,
					"content": "Хе... Тогда сейчас Кли сделает суперкрутой заказ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500119
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500119,
					"content": "Скоро Кли вместе с мамой пойдёт глушить рыбу... Только магистру Джинн не говори!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500120
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500120,
					"content": "Сегодня Кли с мамой взорвали очень много рыбы... Только не говори магистру Джинн!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500121
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500121,
					"content": "В последние дни Кли много играла с мамой, было так весело! Даже если Кли посадят за это, не беда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500122
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500122,
					"content": "Поэтому Кли хочет заказать «Хорошую погоду»! Ясный солнечный день всегда поднимает Кли настроение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500123,
						705500124
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500123,
					"content": "Принято, наставница Кли, приступаю к работе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500125,
					"content": "Хе-хе, интересно, какой будет вкус...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кли"
				},
				{
					"id": 705500124,
					"content": "Понятно, алхимик Кли, приступаю к работе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500117,
					"content": "Хорошо, великий алхимик Кли!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500112,
					"content": "На этот раз можешь смело меня критиковать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500107,
					"content": "Спасибо, Кли! Я стараюсь сделать киоск лучшим!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500103,
					"content": "Ура! И добро пожаловать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				}
			]
		},
		{
			"id": 7055002,
