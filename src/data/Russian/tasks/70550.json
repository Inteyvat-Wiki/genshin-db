	"talks": [
		{
			"id": 7055001,
			"completionStepIds": [
				7055002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
