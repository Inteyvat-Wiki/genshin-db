			"dialogs": [
				{
					"id": 751031101,
					"content": "#Ух ты, птицы течений и вправду прилетели! Спасибо тебе, {M#золотоволосый}{F#золотоволосая} {M#братец}{F#сестрица}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751031102
					],
					"speakerTitle": "Пания"
				},
				{
					"id": 751031102,
					"content": "Гру, ру-у!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751031103
					],
					"speakerTitle": "Ивай"
				},
				{
					"id": 751031103,
					"content": "Я подготовила много рыбы! Если мы сможем приманить этих птиц течений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751031104
					],
					"speakerTitle": "Пания"
				},
				{
					"id": 751031104,
					"content": "#{NICKNAME}, давай <color=#00E1FFFF>вытащим</color> остальных птиц на берег!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пания"
				}
			]
		}
