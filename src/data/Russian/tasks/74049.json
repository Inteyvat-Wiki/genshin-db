			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Косынзяна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740490101,
					"content": "#Ой, это же {NICKNAME} и Паймон, которые приносят цветочки из далёких земель!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490102
					],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490102,
					"content": "Привет, Косынзяна! Как растут цветы, что мы принесли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490103,
					"content": "Эм... Не знаю, целый день не ходила их проведать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490104
					],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490104,
					"content": "М? Тебе ведь они так понравились! Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490105,
					"content": "Цветы из далёких земель так трудно достать, поэтому я очень хочу хорошо о них заботиться. Но при одной мысли, что цветы могут засохнуть прямо у меня на глазах, мне становится страшно... поэтому я боюсь туда идти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490106
					],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490106,
					"content": "Надо же, как сильно ты беспокоишься... Ну, может, проведаем их вместе? Если что-то окажется не так, мы поможем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490107,
					"content": "От беспокойства проку всё равно не будет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490108
					]
				},
				{
					"id": 740490108,
					"content": "Вы правы... Пойдём вместе! Когда вы рядом, у меня появляется уверенность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Косынзяна"
				}
			]
		},
		{
			"id": 7404902,
			"completionStepIds": [
				7404905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
