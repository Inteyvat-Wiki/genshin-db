			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Косынзяна"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490201,
					"content": "У-у-у... Мои драгоценные цветы... Всё пропало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490202
					],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490202,
					"content": "Ох, как жаль... Значит, твои цветы гибнут из-за протогенов расщелин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490203,
					"content": "Теперь... теперь я буду днями и ночами дежурить у цветника, ни шагу отсюда не сделаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490204
					],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490204,
					"content": "Подожди, Косынзяна, успокойся немного. Давай придумаем другой способ! Зачем вообще протогенам расщелины понадобились твои цветы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490205,
						740490206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490205,
					"content": "Когда ты приносила сюда другие цветы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				},
				{
					"id": 740490207,
					"content": "Нет, никогда! Эти негодяи творят пакости, только когда я не вижу! Как же я зла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490208
					],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490208,
					"content": "Ой, Паймон даже не думала, что Косынзяна умеет так сердиться! Видно, ты и правда очень любишь свои цветы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490209,
					"content": "Но помните, когда Косынзяна подошла, протогены не стали разбегаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490210,
					"content": "Может, их интересуют вовсе не цветы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490211
					]
				},
				{
					"id": 740490211,
					"content": "Да, очень даже может быть. Давайте посмотрим, вдруг рядом с цветником найдётся что-то ещё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490206,
					"content": "...на тебя нападали протогены?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				}
			]
		},
		{
			"id": 7404903,
			"completionStepIds": [
				7404908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7404908",
