						],
						"stepId": 7404908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Косынзяна"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490301,
					"content": "#{NICKNAME}, как здорово! Бац - и уродливые механизмы превратились в прекрасные детали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490302
					],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490302,
					"content": "Ну, теперь никто больше не будет портить твой сад.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490303
					]
				},
				{
					"id": 740490303,
					"content": "Они тут хорошо потоптались, но уцелевшие цветы выглядят совсем не плохо. Протогены расщелины больше сюда не вернутся, теперь твой цветник будет красивым и пышным!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490304,
					"content": "Как хорошо... Но я усвоила урок. Ценные цветы нужно беречь и хорошо за ними ухаживать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490305
					],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490305,
					"content": "#{NICKNAME}, Паймон... Вы принесли мне цветы из далёких земель, помогли защитить мой сад. Как мне вас отблагодарить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490306
					],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490306,
					"content": "Ой, перестань, не надо благодарить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490307,
					"content": "#Придумала! Это цветы я собрала сама, они очень ценные! {NICKNAME}, Паймон! Дарю их вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490308
					],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490308,
					"content": "Эм... Если они такие ценные, наверное, нам тоже стоит разбить свой садик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490309,
					"content": "Кстати, это ведь тидалья? Неужели тидалья тоже считается цветком?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490310,
					"content": "Тидалья - растение, и очень красивое растение. А значит, тоже цветок. Люди называют науку о растениях «биологией». Чтобы стать хорошим садовником, я немного училась биологии. Хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490311
					],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490311,
					"content": "Что-то тут явно не так, но Паймон и сама плохо разбирается в классификации растений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490312,
					"content": "Я буду очень стараться! И стану классным садовником! Люди говорят, что классные садовники, которым удалось вывести новый сорт цветов, привозят свои цветы на специальную ярмарку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490313
					],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490313,
					"content": "Я тоже хочу участвовать в ярмарках! И получать призы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490314
					],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490314,
					"content": "Это очень здорово, но Паймон всё равно кажется, что тут есть какое-то недопонимание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490315,
					"content": "Косынзяна хочет участвовать в ярмарках, чтобы показать людям новые сорта цветов, которые она выведет, правильно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490316,
					"content": "Но её восприятие красоты слишком отличается от принятого у людей... Не окажется ли так, что люди посчитают её цветы чересчур странными?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490317,
					"content": "Паймон так озабочена садоводческими перспективами Косынзяны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490318
					]
				},
				{
					"id": 740490318,
					"content": "Конечно! Ведь Паймон её наставница! Если Косынзяна получит приз на ярмарке, Паймон будет просто счастлива!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490319,
						740490323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490319,
					"content": "Не стоит придавать большое значение призам и наградам. Главное - получать радость от своей работы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490320
					]
				},
				{
					"id": 740490320,
					"content": "Это правда. Главное, чтобы тебе самой нравились цветы, которые ты выращиваешь! Какая разница, что скажут люди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490321,
					"content": "Просто ухаживай за своим садом, любуйся цветами и радуйся каждому дню!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490322,
					"content": "Да! Под моим присмотром цветочки из далёких земель будут расти здоровыми и крепкими!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Косынзяна"
				},
				{
					"id": 740490323,
					"content": "Ты уже сделала свой первый шаг к успеху.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490324
					]
				},
				{
					"id": 740490324,
					"content": "Точно! Наверное, цветы, которые выведет Косынзяна, будут выглядеть немного странно, но многие люди ценят оригинальность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740490325,
					"content": "Косынзяна! Дай нам знать, когда выведешь новый сорт цветов, договорились?",
