		},
		{
			"id": 35801,
			"completionStepIds": [
				35802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"35802",
							"2"
						],
						"stepId": 35802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джинн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3580101,
					"content": "...а потом я привёл их сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580102
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3580102,
					"content": "Мондштадт благодарен ветрам, что принесли вас сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580103
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3580103,
					"content": "Меня зовут Джинн. Я действующий магистр Ордо Фавониус. А это Лиза, наш библиотекарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580104
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3580104,
					"content": "Милашки, вы пришли, чтобы спасти нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580105
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3580105,
					"content": "Вы такие сладенькие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580106
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3580106,
					"content": "Жаль, что вы появились в такое время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580107
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3580107,
					"content": "Ужас Бури пробудился и с тех пор постоянно досаждает нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580108
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3580108,
					"content": "Дракон нарушил потоки стихий в Мондштадте. Некогда упорядоченные элементы и артерии земли стали похожи на клубок ниток, с которым игрался котёнок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580109
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3580109,
					"content": "Для магов это худшее, что может произойти. Ещё чуть-чуть и меня разорвёт на миллионы маленьких частичек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580110
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3580110,
					"content": "#Всё, что мы можем сделать на данный момент, - это расклеить по городу объявления о пропаже {F#твоего брата}{M#твоей сестры}. Сейчас все наши силы уходят на борьбу с драконом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580111
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3580111,
					"content": "#Прошу тебя, задержись в Мондштадте на некоторое время. Мы обязательно поможем тебе найти {F#брата}{M#сестру}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580112,
						3580114
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3580112,
					"content": "Я не могу оставить вас один на один с Ужасом Бури.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580113
					]
				},
				{
					"id": 3580113,
					"content": "Паймон тоже хочет помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3580116,
					"content": "Славно. Нам нужен план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580117
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3580117,
					"content": "Теперь, когда Ужас Бури летает прямо над городом, у нас наконец появился шанс положить этому конец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580118
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3580118,
					"content": "Лиза выяснила откуда дракон черпает свою силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580119
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3580119,
					"content": "Хм... И откуда же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580120
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 3580120,
					"content": "Из <color=#00E1FFFF>храмов Хранителей четырёх ветров</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580121
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3580121,
					"content": "Эта сила позволяет ему создавать такие разрушительные ураганы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580122
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 3580122,
					"content": "Наша цель - разобраться с <color=#00E1FFFF>тремя</color> храмами из четырёх.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580123
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3580123,
					"content": "Надеюсь, мне не нужно объяснять, почему только с тремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580124
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3580124,
					"content": "Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580125,
						3580126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3580125,
					"content": "Наверное, в Мондштадте так принято.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580127,
					"content": "Рыцари, времени у нас мало!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580128
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3580128,
					"content": "Буря усиливается. На этот раз мы не сможем просто переждать её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580129
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3580129,
					"content": "Мы должны действовать сейчас же! Немедленно направляемся в <color=#00E1FFFF>руины заброшенного храма</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джинн"
				},
				{
					"id": 3580126,
					"content": "Потом спросишь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580114,
					"content": "Отлично. Где я могу остановиться? Поблизости есть гостиница?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580115
					]
				},
				{
					"id": 3580115,
					"content": "Эй! Мы здесь ещё не закончили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}