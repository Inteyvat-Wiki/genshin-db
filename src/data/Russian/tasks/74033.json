			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерпиллер",
					"Митул"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4596.75,
							-46.38,
							4590.743
						],
						"pointId": 4614
					},
					{
						"sceneId": 3,
						"position": [
							4595.909,
							-46.38,
							4592.177
						],
						"pointId": 5582
					},
					{
						"sceneId": 3,
						"position": [
							4595.084,
							-46.38,
							4591.131
						],
						"pointId": 5768
					}
				]
			},
			"dialogs": [
				{
					"id": 740330401,
					"content": "Митул, ты как? Не слишком долго просидел в ловушке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330402
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740330402,
					"content": "Мои спасители! Вы здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330403
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330403,
					"content": "А где же Кобленц? Он не с вами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330404
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330404,
					"content": "Это он прислал нас, сказал, что ты в западне. Но по дороге он наткнулся на охранников и ушёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330405
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740330405,
					"content": "Я так и знал, что ему не стоит доверять! Наверное, он сбежал, потому что чувствовал себя виноватым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330406
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330406,
					"content": "Сами посудите, можно ли в бизнесе выйти на прибыль, если не рисковать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330407
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330407,
					"content": "Ну ладно он увалень, да ещё и трус... Речь ведь идёт уже не только о Чистейшей воде, теперь здесь ещё и Фонта есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330408
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330408,
					"content": "И как нам теперь выживать после прихода Фонты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330409
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330409,
					"content": "О...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740330410,
					"content": "Что, вам тоже нравится Фонта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330411,
						740330413
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330411,
					"content": "А тебе нет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330412
					]
				},
				{
					"id": 740330412,
					"content": "Конечно, мне нравится Фонта. Должен признать, что Фонта - мощный соперник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330415,
					"content": "Довольно слов, я должен пойти стрясти должок с Кобленца. Кстати, он же вам не заплатил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330416
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330416,
					"content": "Нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330417
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740330417,
					"content": "Иногда мне так и хочется сунуть его в какую-нибудь бочку, чтобы он как следует подумал над своим поведением. В общем, возьмите эти купоны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330418
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330418,
					"content": "Прошу, возьмите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330419
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740330419,
					"content": "А? Это всё нам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740330420,
					"content": "Конечно, вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330421
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740330421,
					"content": "Хи-хи, тогда мы возьмём! Можно будет сходить в «Тряпьё и кости», вдруг там есть что-то новенькое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740330422,
					"content": "И раз уж я доставил вам столько проблем, я хотел бы хоть как-то компенсировать ваши старания. У меня есть несколько бутылей прекрасного полезного напитка, не хотите попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330423
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330423,
					"content": "Прекрасный... полезный напиток?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740330424,
					"content": "Он даже ещё более полезен для здоровья, чем Чистейшая вода!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330425,
						740330428
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330425,
					"content": "Наливай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330426
					]
				},
				{
					"id": 740330426,
					"content": "(Эй! Катерпиллер же предупреждал, что не стоит пить то, что он предложит...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740330427,
					"content": "#Забудь о том, что только что сказал{F#а} {M#путешественник}{F#путешественница}! Мы уже выпили... ик... уже выпили очень много всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740330431,
					"content": "Какая жалость! Такой прекрасный полезный напиток. Обязательно попробуем его, как представится такая возможность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330432
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740330432,
					"content": "Сейчас точно не будете? Ну ладно. Разыщите меня, как будет время. Я с радостью вас угощу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330433
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330433,
					"content": "Что ж, позвольте откланяться. Мне нужно разыскать Кобленца...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330434
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330434,
					"content": "У меня есть другие дела, мне пора идти. Не переживайте по поводу купонов. <color=#00E1FFFF>Если у меня появятся какие-то зацепки, я приклею сообщения на доску</color>. Увидимся позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330435
					],
					"speakerTitle": "Катерпиллер"
				},
				{
					"id": 740330435,
					"content": "Пока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740330428,
					"content": "Есть Фонта?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330429
					]
				},
				{
					"id": 740330429,
					"content": "Есть-то есть... а? Ты не доверяешь моему полезному напитку? Говорю тебе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330430
					],
					"speakerTitle": "Митул"
				},
				{
					"id": 740330430,
					"content": "#{M#Он}{F#Она} не это имел{F#а} в виду! Просто... просто мы уже выпили много разного. В нас уже ничего не лезет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740330413,
					"content": "Более или менее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330414
					]
				},
				{
					"id": 740330414,
					"content": "О? Кажется, у вас есть вкус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Митул"
				}
			]
		}
	]
}