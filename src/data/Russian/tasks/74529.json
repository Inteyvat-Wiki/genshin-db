				"points": []
			},
			"dialogs": [
				{
					"id": 745290401,
					"content": "#О, приветствую, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 745290402,
					"content": "Ситлали, давно не виделись.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "Ну что ты такое говоришь? Мои старые кости тоже иногда требуют прогулки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 745290405,
					"content": "А ещё, прошлой ночью я гадала на удачу и предсказала, что, если сегодня выйду из дома, случится что-то хорошее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 745290406,
					"content": "И вот! Стоило выйти, как удача сама меня нашла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 745290407,
					"content": "Пусть удача не приходит одна!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "Я бы и не против... Вот только, знаешь, я уже две ночи не сплю толком, дочитывая последний том романа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 745290410,
					"content": "Посмотри, как я выгляжу. Круги под глазами уже исчезли или нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 745290411,
					"content": "Выглядишь свежо, как всегда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "Правда? Надеюсь, ты говоришь правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 745290414,
					"content": "Давай договоримся: все плохие фотографии останутся у меня... а ты заберёшь только самую красивую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 745290412,
					"content": "Ты сияешь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "Позволь мне тебя сфотографировать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "Удивительно встретить тебя здесь, обычно ты дома и спишь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
}