				]
			},
			"dialogs": [
				{
					"id": 751360201,
					"content": "Что это? Похоже на пирофосфорит, только светится, и из него вырываются языки пламени. Кажется, он намного мощнее того, что у Боны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360202,
					"content": "Так вот как должны выглядеть настоящие пирофосфориты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360203,
					"content": "Ай! Горячо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360204
					]
				},
				{
					"id": 751360204,
					"content": "#Не трогай всё подряд, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360205,
					"content": "#Я не {F#думала}{M#думал}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360206
					]
				},
				{
					"id": 751360206,
					"content": "Кто бы говорил.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360207
					]
				},
				{
					"id": 751360207,
					"content": "Р-р-р! Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360208,
					"content": "#Что такое, {REALNAME[ID(2)|SHOWHOST(true)]}? Ты что-то об этом знаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360209,
					"content": "#Ого! {REALNAME[ID(2)|SHOWHOST(true)]}! Похоже, ты наконец сможешь продемонстрировать свои навыки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360210,
					"content": "Значит, теперь ты у нас будешь отвечать за все горячие находки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360211,
					"content": "И-и! Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360212,
					"content": "Эй! Эй! Сюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360213
					],
					"speakerTitle": "Бона"
				},
				{
					"id": 751360213,
					"content": "Смотри! Это Бона!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360214,
					"content": "Как она туда попала? Она что, приземлилась... Ладно, давай сперва посмотрим, что там!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
