			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-306.442,
							1277.558,
							9810.905
						],
						"pointId": 8612
					}
				]
			},
			"dialogs": [
				{
					"id": 751360101,
					"content": "Мы... Мы живы! Как же хорошо снова стоять на твёрдой земле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360102,
					"content": "Но ты ведь летаешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360103
					]
				},
				{
					"id": 751360103,
					"content": "Эй! Парить над землёй и болтаться в небе по воле ветра - разные вещи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360104,
					"content": "Хотя эта «земля» и не выглядит такой уж надёжной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360105
					]
				},
				{
					"id": 751360105,
					"content": "Не надо пугать Паймон! Если вы упадёте, Паймон вас двоих не вытащить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360106,
					"content": "Чип, ку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360107
					],
					"speakerTitle": "Кокоуик"
				},
				{
					"id": 751360107,
					"content": "Это тот самый «Тонатиу»? Ура, получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360108,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360109
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360109,
					"content": "Хотя он больше похож на огромный клубок ниток, чем на корабль! Или на змею. Как он весь перепутался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360110,
					"content": "Но он хотя бы выглядит безопаснее, так что давай полетим туда... Эм, стоп. А где Бона?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360111,
					"content": "Она говорила, что у неё большой опыт полётов, но Паймон всё равно немного беспокоится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360112,
					"content": "Если направление ветра было верным...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360113
					]
				},
				{
					"id": 751360113,
					"content": "#Ты {F#права}{M#прав}. Скорее всего, она приземлилась где-то рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360114,
					"content": "Здесь стоять смысла нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360115
					]
				},
				{
					"id": 751360115,
					"content": "Верно, нам пора идти. Возможно, она уже ждёт нас на корабле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751360116,
					"content": "Вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
