			"dialogs": [
				{
					"id": 750180101,
					"content": "Шра-а-а-а!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180102
					],
					"speakerTitle": "Курурук"
				},
				{
					"id": 750180102,
					"content": "Не шуми. Как поправишься, если не будешь принимать лекарство?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180103
					],
					"speakerTitle": "Маскал"
				},
				{
					"id": 750180103,
					"content": "#Она в опасности! {NICKNAME}, мы должны ей помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
