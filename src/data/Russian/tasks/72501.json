			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Асагири"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 725010201,
					"content": "Почему госпожа Морико всегда даёт мне такие странные рукописи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010202,
						725010203
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010202,
					"content": "Всё работаешь над иллюстрациями?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010203,
					"content": "Опять нет вдохновения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010204,
					"content": "#О, путешественни{F#ца}{M#к}, это ты! Давно не виделись! Я думала, ты уже отправил{F#ась}{M#ся} покорять новые края.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010205
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010205,
					"content": "Эх... Поправить бы мне здоровье, и я бы тоже путешествовала, как ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010206
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010206,
					"content": "И госпожа Морико не смогла бы каждый день меня поторапливать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010207
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010207,
					"content": "Мои прошлые работы получили очень хорошие отзывы, и многие авторы теперь просят, чтобы иллюстрации для их книг делала именно я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010230
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010230,
					"content": "Хотя госпожа Морико освободила меня от многих заказов, всё равно работы целый воз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010208,
					"content": "Ко всему прочему, авторы, которые работают с издательским домом Яэ, стали обращаться ко всё более... обширному материалу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010209,
					"content": "Раньше я думала, что они будут писать только об Инадзуме, немного о Мондштадте и Ли Юэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010210
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010210,
					"content": "Но теперь сюжеты их романов разворачиваются и в Сумеру, а скоро переместятся в Фонтейн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010216
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010216,
					"content": "#Ну, вернёмся к делу... Путешественни{F#ца}{M#к}, твоя фотокамера в порядке?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010217,
						725010218
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010217,
					"content": "Вроде бы да...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010218,
					"content": "Ты снова хочешь попросить меня сделать фотографии?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010219,
					"content": "В прошлый раз я ведь предложила тебе неплохое вознаграждение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010220
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010220,
					"content": "#Путешественни{F#ца}{M#к}, пожалуйста, помоги мне ещё раз. Мне нужны фотографии со всего света!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010221,
						725010224
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010221,
					"content": "Хорошо, можешь на меня рассчитывать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010222
					]
				},
				{
					"id": 725010224,
					"content": "Оставь своё поручение в Гильдии искателей приключений...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010225
					]
				},
				{
					"id": 725010222,
					"content": "Спасибо тебе большое! Вот, я уже приготовила блокнот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010223
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010223,
					"content": "#Если бы ты сам{F#а} не {F#пришла}{M#пришёл}, мне бы всё равно пришлось просить госпожу Морико послать за тобой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010225,
					"content": "Нет, нет! Пожалуйста, прошу тебя! Я оставляла поручение в Гильдии искателей приключений, но так и не нашла никого, кто владел бы камерой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010226
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010226,
					"content": "#Помоги мне, путешественни{F#ца}{M#к}, если я не сдам иллюстрации, госпожа Морико снова поселится у меня дома!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010227
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010227,
					"content": "Я не вынесу эту её разваренную вишнёвую кашу! Спаси меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010228
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 725010228,
					"content": "Ладно, ладно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010229
					]
				},
				{
					"id": 725010229,
					"content": "Фух... Хорошо... Подожди немного, я найду свой блокнот...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асагири"
				}
			]
		}
	]
}