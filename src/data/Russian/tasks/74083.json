					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830204
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830204,
					"content": "След простыл, Пашив!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830205
					]
				},
				{
					"id": 740830205,
					"content": "#Паймон, Пашив! {NICKNAME}, Пашив! Ключ, ключ, ключ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830206
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830206,
					"content": "Площадь, запад!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830207,
					"content": "Хе-хе. Ты хочешь сказать это? Не нервничай, отправимся прямо сейчас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
