			"dialogs": [
				{
					"id": 740820701,
					"content": "Кристально чистая капля появилась на алтаре.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740830102,
					"content": "Эта капля... Не то ли самое сокровище?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830103,
					"content": "Она не похожа на сокровище.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830104
					]
				},
				{
					"id": 740830104,
					"content": "Паймон тоже так считает... Это было бы слишком легко... Что же это тогда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830105,
						740830110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830105,
					"content": "А вдруг это важнейший предмет для победы над Владыкой тьмы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830106
					]
				},
				{
					"id": 740830110,
					"content": "Может быть, кто-то просто оставил её здесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830111
					]
				},
				{
					"id": 740830106,
					"content": "Что? Тогда дело плохо. Скорее! Верни её на место! Надеюсь, ещё не поздно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830107,
					"content": "А?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830108
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830108,
					"content": "Нам конец! Владыка тьмы явился!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830109,
					"content": "Владыка тьмы? Мелюзина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830111,
					"content": "Что? О нет, мы что, стали воришками? Как неловко вышло... Давай положим её назад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830112,
					"content": "А?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830113
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830113,
					"content": "Это конец! Хозяин вернулся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830114,
					"content": "Хозяин? Мелюзина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830115,
					"content": "Паймон так испугалась... Оказывается, это мелюзина... Как ты здесь оказалась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830116,
					"content": "Ключ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830117
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830117,
					"content": "К... какой ключ? Эта капля - ключ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830118,
					"content": "Пашив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830119
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830119,
					"content": "Гм... Эта капля - Пашив?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830120,
					"content": "Мелюзина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830121
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830121,
					"content": "Ох! Что это значит? Капля - это мелюзина? У Паймон голова идёт кругом. В чём же дело? Это ведь ты здесь мелюзина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830122,
					"content": "Пашив...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830123
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830123,
					"content": "Гм... Ты Пашив? Подожди, не отвечай... После твоего ответа Паймон точно станет ещё хуже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830124,
					"content": "Паймон будет называть тебя Пашив, хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830125,
					"content": "Мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830126
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830126,
					"content": "#{NICKNAME}... Что же делать? Паймон её совершенно не понимает. О чём она говорит?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830127,
					"content": "Ты нас понимаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830128
					]
				},
				{
					"id": 740830128,
					"content": "Пашив...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830129
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830129,
					"content": "Эта капля - ключ, так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830130
					]
				},
				{
					"id": 740830130,
					"content": "Пашив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830131
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830131,
					"content": "Ты не человек, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830132
					]
				},
				{
					"id": 740830132,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830133
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830133,
					"content": "Гм... Не стоит грубить, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830134,
					"content": "Я не человек, правильно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830135
					]
				},
				{
					"id": 740830135,
					"content": "М... мелюзина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830136
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830136,
					"content": "Ага! Подожди-ка, Паймон, кажется, поняла... «Пашив» - это «да», а «мелюзина» - «нет». Правильно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830137,
					"content": "Пашив! Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830138
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830138,
					"content": "Оказывается, тебя зовут не Пашив... Прости, Паймон перепутала твоё имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830139,
					"content": "Пашив... Нравится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830140
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830140,
					"content": "Тебе нравится это имя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830141
					]
				},
				{
					"id": 740830141,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830142
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830142,
					"content": "#Отлично! Тогда так и будем тебя называть. Хи-хи. Паймон зовут Паймон, а это {NICKNAME}. Рады с тобой познакомиться, Пашив. Паймон никогда раньше не встречала таких мелюзин, как ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830143,
					"content": "#Паймон, Пашив! {NICKNAME}, Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830144
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830144,
					"content": "Эринии... Мелюзина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830145
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830145,
					"content": "...Эринии нет? Или... Гм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830146
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830146,
					"content": "С островом Эриний что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830147
					]
				},
				{
					"id": 740830147,
					"content": "Эринии, мелюзина, сейчас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830148
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830148,
					"content": "Пашив, Эринии, защищать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830149
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830149,
					"content": "С островом Эриний происходит что-то плохое, и ты хочешь его защитить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830150
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830150,
					"content": "#Паймон, {NICKNAME}, Эринии, пом, пом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830151
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830151,
					"content": "#Гм... На этот раз пять слов, эх... Ты хочешь, чтобы Паймон и {NICKNAME} дважды сделали острову Эриний «пом-пом»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830152
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830152,
					"content": "Мелюзина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830153
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830153,
					"content": "Тебе нужна наша помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830154
					]
				},
				{
					"id": 740830154,
					"content": "Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830155
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830155,
					"content": "Оказывается, «пом» значит «помощь». Это хорошо. Сделать острову «пом-пом» было бы гораздо сложнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830156
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830156,
					"content": "Пом-пом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830157,
						740830161
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830157,
					"content": "А награда будет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830158
					]
				},
				{
					"id": 740830161,
					"content": "Как же нам помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830158,
					"content": "Наг... рада?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830159
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830159,
					"content": "#Ох, {NICKNAME}, ты посмотри на Пашив. Она толком не говорит и, наверняка, не сможет найти других желающих помочь. Давай просто возьмёмся за дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830160
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830160,
					"content": "Как же нам помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830162,
					"content": "Ключ, ключ, ключ, число.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830163
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830163,
					"content": "А потом? Что за число ключей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830164
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830164,
					"content": "Ключ! Ключ! Ключ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830165
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830165,
					"content": "Три ключа?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830166
					]
				},
				{
					"id": 740830166,
					"content": "Пашив! Ключ, туман-путь, юг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830167
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830167,
					"content": "Ключ, источник, север...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830168
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830168,
					"content": "Ключ, ива, восток...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830169
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830169,
					"content": "Ох, так вот в чём дело... Паймон нужно записать... Всего три ключа: туманный путь на юге, источник на севере и ива на востоке... Верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830170
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830170,
					"content": "Ключ, ключ, ключ, площадь, запад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830171
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830171,
					"content": "На площади с запада есть ещё три ключа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830172
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830172,
					"content": "Собрать три ключа и отправиться на площадь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830173
					]
				},
				{
					"id": 740830173,
					"content": "#Паймон, мелюзина! {NICKNAME}, Пашив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830174
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830174,
					"content": "#Эх, Пашив, не говори так, будто {NICKNAME} умнее Паймон! Паймон с {M#ним}{F#ней} на одном уровне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830175
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830175,
					"content": "Давайте подытожим. Мы уже добыли один ключ. Кажется, остаётся получить ещё два.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830176
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830176,
					"content": "Эринии, мелюзина... Пашив, защищать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830177
					],
					"speakerTitle": "Пашив"
				},
				{
					"id": 740830177,
					"content": "Не переживай. Пусть мы не знаем, что произошло, но мы поможем тебе защитить остров Эриний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830178
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830178,
					"content": "Паймон хочет ещё кое-что дополнить. Пашив, если вдруг ты случайно увидишь бесхозную вещицу, такую золотистую кругленькую... или некий ценный сундук...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830179
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740830179,
					"content": "Будет здорово, если ты нам об этом расскажешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830180
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740820780,
					"content": "Пашив задумчиво почесала голову, затем радостно подпрыгнула два раза и в спешке удалилась.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740830181,
					"content": "#Ох, она взяла и убежала. Наверное, что-то срочное. {NICKNAME}, давай отправимся на поиски двух других ключей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
