			"dialogs": [
				{
					"id": 760240101,
					"content": "Хм. Сопротивление бесполезно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760240102,
					"content": "Впервые вижу хорька-барахольщика так близко... Да, Паймон! Тебе тоже придётся называть его большим боссом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240115
					],
					"speakerTitle": "Ауни"
				},
				{
					"id": 760240115,
					"content": "Ч-что? Паймон не будет называть этого злобного хорька-барахольщика большим боссом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760240118,
					"content": "Ты права, плохиша никто не станет называть боссом. И на его похороны никто не придёт... да и вообще, не бывает у таких похорон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240132
					],
					"speakerTitle": "Ауни"
				},
				{
					"id": 760240132,
					"content": "Да, точно! Хелка говорила, что бывают такие странные люди, которые едят странное мясо, например мясо хорьков-барахольщиков. А есть те, кто любит делать из них чучела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240133
					],
					"speakerTitle": "Ауни"
				},
				{
					"id": 760240133,
					"content": "И в том, и в другом случае похороны не понадобятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240134
					],
					"speakerTitle": "Ауни"
				},
				{
					"id": 760240134,
					"content": "Ух... Ауни говорит об этом как ни в чём не бывало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760240135,
					"content": "(Он выглядит очень напуганным...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240136
					],
					"speakerTitle": "Босс хорьков-барахольщиков"
				},
				{
					"id": 760240136,
					"content": "Стой! Не смей бежать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760240137,
					"content": "А? Он не бежит... он ждёт нас? Ладно, давайте посмотрим, что там происходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7602402,
