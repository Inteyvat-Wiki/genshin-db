						"pointId": 360700070
					}
				]
			},
			"dialogs": [
				{
					"id": 760240401,
					"content": "Кстати, Паймон заметила, что хорьки-барахольщики всегда убегают к тому холмику...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760240402,
					"content": "Да, это принесли громилы, тренировавшие хорьков-барахольщиков. С помощью этой штуковины большой босс так навалял громилам, что они катались по земле и на ноги встать не могли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240403,
						760240404
					],
					"speakerTitle": "Ауни"
				},
				{
					"id": 760240403,
					"content": "Трудно это себе представить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240406
					]
				},
				{
					"id": 760240406,
					"content": "#Ладно, давайте лучше пойдём и осмотрим тот холмик. Только осторожнее: вдруг хорьки-барахольщики устроили там засаду! {NICKNAME}, ты тоже осторожнее! Не то тебя так отделают, что будешь кататься по земле и на ноги встать не сможешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760240404,
					"content": "Жаль, меня там не было...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240405
					]
				},
				{
					"id": 760240405,
					"content": "#И что бы ты сделал{F#а}? Помог{F#ла} им? Нет, ты бы стоял{F#а} рядом и {F#любовалась}{M#любовался} представлением!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240406
					],
					"speakerTitle": "Паймон"
				}
			]
		},
