				"points": []
			},
			"dialogs": [
				{
					"id": 708190201,
					"content": "Спасибо за щедрость. Однако сёстры церкви Фавония не могут принимать подарки от мирян.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190202
					],
					"speakerTitle": "Ханнелора"
				},
				{
					"id": 708190202,
					"content": "Мне довольно и того, что я чувствую этот прекрасный аромат, принесённый морским бризом. Настоящий верующий должен оставлять прекрасное ветру, а не владеть им в одиночку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190203
					],
					"speakerTitle": "Ханнелора"
				},
				{
					"id": 708190203,
					"content": "Но я ценю твою доброту, она тепла, словно южный ветер. В знак благодарности прими от меня эту книгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190204
					],
					"speakerTitle": "Ханнелора"
				},
				{
					"id": 708190204,
					"content": "Да хранит тебя Анемо Архонт. Пусть твой путь будет подобен этому аромату: полон добродетели, свободы и милосердия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ханнелора"
				}
			]
		},
