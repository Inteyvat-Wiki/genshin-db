				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мело Ломброзо",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741810101,
					"content": "Мадам Мело! Что вы здесь делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741810102,
					"content": "О, это вы, ребята... Я услышала о своём непутёвом муже, который свил здесь маленькое гнёздышко, и решила зайти посмотреть, как у него дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810103
					],
					"speakerTitle": "Мело Ломброзо"
				},
				{
					"id": 741810103,
					"content": "Подумать не могла, что найду такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810104
					],
					"speakerTitle": "Мело Ломброзо"
				},
				{
					"id": 741810104,
					"content": "Оказывается, у него было при себе это фото.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810105
					],
					"speakerTitle": "Мело Ломброзо"
				},
				{
					"id": 741810105,
					"content": "Хи-хи, вы очень много значите для дяди Рошера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741810106,
					"content": "Когда мы раньше начинали сомневаться в вас, только дядя Рошер продолжал настаивать, что вы не причастны ни к чему плохому! Хоть мне и непонятно, откуда у него на тот момент была такая уверенность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741810107,
					"content": "Возможно, всё дело в том, что он настоящий мужчина.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810108
					]
				},
				{
					"id": 741810108,
					"content": "Дело в этом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810109
					],
					"speakerTitle": "Мело Ломброзо"
				},
				{
					"id": 741810109,
					"content": "Да! А кстати, он же говорил, что проиграл ваш кулон в азартные игры? Всё это ложь! На самом деле ему было очень неловко сказать правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741810110,
					"content": "Про это я уже давно догадалась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810111
					],
					"speakerTitle": "Мело Ломброзо"
				},
				{
					"id": 741810111,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741810112,
					"content": "У моего мужа много недостатков. Он немного робкий, трусоватый, несколько упрямый, но я знаю, что он человек прагматичный. Его могли где-то обдурить, но в то, что он заядлый игрок, я никогда не поверю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810113
					],
					"speakerTitle": "Мело Ломброзо"
				},
				{
					"id": 741810113,
					"content": "Я ничего не стала ему говорить, потому что ждала, пока он сам признается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810114
					],
					"speakerTitle": "Мело Ломброзо"
				},
				{
					"id": 741810114,
					"content": "Ух ты... это же замечательно... жаль, что сейчас он не с нами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741810115,
					"content": "(Тсс... посмотрите туда. Я полностью уверена, что он прячется вон в том ящике.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810116
					],
					"speakerTitle": "Мело Ломброзо"
				},
				{
					"id": 741810116,
					"content": "(Как так?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741810117,
					"content": "(Кхм... Обычно, когда мы ругаемся, он тихонько пробирается в шкаф и думает, что я его не замечаю.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810118
					],
					"speakerTitle": "Мело Ломброзо"
				},
				{
					"id": 741810118,
					"content": "(Мне его позвать?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810119
					]
				},
				{
					"id": 741810119,
					"content": "(Не стоит беспокоиться. Мне интересно, как долго он захочет прятаться сегодня.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810120
					],
					"speakerTitle": "Мело Ломброзо"
				},
				{
					"id": 741810120,
					"content": "Точно, у меня к вам есть одна просьба. Пожалуйста, если встретите Дугу и агента Талокард, передайте им кое-что от меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810121
					],
					"speakerTitle": "Мело Ломброзо"
				},
				{
					"id": 741810121,
					"content": "Я привела в порядок несколько комнат, пусть они приходят погостить в любое время. И, конечно же, двери семьи Ломброзо также всегда открыты для вас двоих.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810122
					],
					"speakerTitle": "Мело Ломброзо"
				},
				{
					"id": 741810122,
					"content": "#{NICKNAME}, но ведь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741810123,
					"content": "Мы поняли, госпожа.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810124
					]
				},
				{
					"id": 741810124,
					"content": "Что ж... хорошо, тогда не смеем более вас беспокоить, госпожа! Желаю дяде Рошеру как можно скорее принять себя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741810125,
					"content": "Спасибо. Я, в свою очередь, желаю вам найти ответы на все вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мело Ломброзо"
				}
			]
		},
