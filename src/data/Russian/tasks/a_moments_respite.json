							-0.011,
							17.085,
							0.896
						],
						"pointId": 61
					}
				]
			},
			"dialogs": [
				{
					"id": 40190301,
					"content": "Меня глаза обманывают, или двое заключённых вернулись, после того как поднялись на поверхность? Странные ветры дуют в последнее время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190302
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 40190302,
					"content": "Мы хотели узнать, как дела в крепости! Всё в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190303,
					"content": "Мы почти не пострадали. Месье Нёвиллет успел вовремя позаботиться о самом страшном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190304
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 40190304,
					"content": "Хм... Если дела обстоят подобным образом, почему бы вам не попросить месье Нёвиллета остаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190305,
					"content": "О, блестящий план. Давайте уговорим юдекса сменить величественное здание суда Кур-де-Фонтейна на лужу в глуши.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190306
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 40190306,
					"content": "Боюсь, это не сработает...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190307
					]
				},
				{
					"id": 40190307,
					"content": "Он примчался в спешке и убыл, даже не заглянув на чашку чая. Правда прихватить подарок госпожи Сиджвин не забыл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190308
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 40190308,
					"content": "Он, похоже, очень занят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190309,
					"content": "Госпожа Клоринда тоже уже ушла. И тоже забрала с собой подарок от госпожи Сиджвин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190310
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 40190310,
					"content": "А что за подарки? Молочные коктейли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190311,
					"content": "Нёвиллет получил молочный коктейль. А Клоринда - губную помаду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190312
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 40190312,
					"content": "А?! Ничего себе разница!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190313,
					"content": "Нёвиллет сам виноват - так много работает, что заставляет Сиджвин волноваться о его здоровье. Ну а девушкам наша главная медсестра любит дарить разные штучки для красоты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190314
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 40190314,
					"content": "Ах да, для вас у меня тут тоже есть подарки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190315
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 40190315,
					"content": "Тоже от Сиджвин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190316,
					"content": "Нет, от вашего покорного слуги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190317
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 40190317,
					"content": "Вы уже завершили свою работу в крепости, так что можете вернуться в наземный мир в любое время. Но поскольку вы ещё не отбыли весь срок заключения, можете продолжать пользоваться своей камерой до окончания срока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190318
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 40190318,
					"content": "Правда? Тогда мы можем остаться здесь надолго!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190319,
					"content": "Еда всё ещё за счёт заведения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190320
					]
				},
				{
					"id": 40190320,
					"content": "Можете бесплатно обедать в столовой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190321
					],
					"speakerTitle": "Ризли"
				},
				{
					"id": 40190321,
					"content": "Ура!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190322,
					"content": "Не забудьте только заполнить бланки на освобождение, когда соберётесь выходить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ризли"
				}
			]
		},
