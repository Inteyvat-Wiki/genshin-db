				]
			},
			"dialogs": [
				{
					"id": 40190201,
					"content": "А теперь угадай - что будет на следующей карте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190202
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 40190202,
					"content": "Уф... Оскалившаяся кошка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190203
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 40190203,
					"content": "А, вот и вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190204
					],
					"speakerTitle": "Линетт"
				},
				{
					"id": 40190204,
					"content": "#{NICKNAME}, Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190205
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 40190205,
					"content": "Привет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190206
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 40190206,
					"content": "Похоже, твоё здоровье идёт на лад, Фремине!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190207,
					"content": "Ага. Благодаря общей поддержке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190208
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 40190208,
					"content": "Да, кстати! Я смог лично поблагодарить госпожу Клоринду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190209
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 40190209,
					"content": "Ух ты! И что она ответила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190210,
					"content": "Сказала, что это пустяки... Как будто спасение чужой жизни не имеет для неё никакого значения. Ещё она сказала, чтобы я не переживал об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190211
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 40190211,
					"content": "Она просто не хотела навешивать на тебя груз благодарности. Она права, не стоит уделять этому много внимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190212
					],
					"speakerTitle": "Линетт"
				},
				{
					"id": 40190212,
					"content": "Ага...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190213
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 40190213,
					"content": "О, вот о чём мы должны вам рассказать! У оперного театра мы встретили Слугу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190214,
					"content": "Вы виделись с «Отцом»? О чём-то с ней поговорили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190215
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 40190215,
					"content": "Она вела довольно э-э... загадочные речи. А ещё сказала, что надеется на сотрудничество с нами в будущем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190216,
					"content": "Это было неожиданно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190217
					]
				},
				{
					"id": 40190217,
					"content": "Она относится к вам даже лучше, чем мы думали... Потрясающе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190218
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 40190218,
					"content": "#Тебе стоит поверить ей, {NICKNAME}. Она ощущает свою ответственность и, когда придёт время, соберёт все доступные ей силы. И будет рада видеть рядом и тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190219
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 40190219,
					"content": "Да. «Отец» очень сильна и надёжна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190220
					],
					"speakerTitle": "Линетт"
				},
				{
					"id": 40190220,
					"content": "О, вы напомнили Паймон: Слуга тоже считает, что Лини очень уж гордый парень! Она сказала, что ты должен научиться иногда полагаться и на других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190221,
					"content": "Кхм... Ладно, принято.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190222
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 40190222,
					"content": "Звучит вполне в духе «Отца»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190223
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 40190223,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190224
					],
					"speakerTitle": "Лини"
				},
				{
					"id": 40190224,
					"content": "Вы побудете здесь ещё пару дней?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190225
					],
					"speakerTitle": "Линетт"
				},
				{
					"id": 40190225,
					"content": "Похоже на то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190226,
					"content": "Отлично. Я устрою чаепитие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190227
					],
					"speakerTitle": "Линетт"
				},
				{
					"id": 40190227,
					"content": "Правда? Тогда Паймон хочет ещё торта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190228,
					"content": "Судя по слову «ещё», наверху вас сладким уже угостили. О, это так мило.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190229
					],
					"speakerTitle": "Линетт"
				},
				{
					"id": 40190229,
					"content": "В следующий раз выпьете с нами чая с пирожными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линетт"
				}
			]
		},
