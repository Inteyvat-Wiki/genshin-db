					}
				]
			},
			"dialogs": [
				{
					"id": 40190401,
					"content": "А? Вы... вернулись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190402
					],
					"speakerTitle": "Кюсто"
				},
				{
					"id": 40190402,
					"content": "Кюсто! Лаверюн!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190403,
					"content": "Дело ведь не в том, что вас поймали и вернули назад, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190404
					],
					"speakerTitle": "Лаверюн"
				},
				{
					"id": 40190404,
					"content": "А? Ничего подобного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190405,
					"content": "Ух! А мне-то казалось, что вам удалось сбежать из тюрьмы во время переполоха. В моих глазах вы были легендарными беглецами из тюрьмы, а теперь хотите сказать, что... вы не выходили отсюда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190406
					],
					"speakerTitle": "Кюсто"
				},
				{
					"id": 40190406,
					"content": "Ха-ха-ха... Ох, прости... У нас были кое-какие дела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190407,
					"content": "Ладно, можете не рассказывать всех подробностей. Мы рады вас видеть. Вообще-то он за вас волновался, знаете ли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190408
					],
					"speakerTitle": "Лаверюн"
				},
				{
					"id": 40190408,
					"content": "Эй, только я волновался, хочешь сказать? Сам-то ведь тоже как на иголках сидел!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190409
					],
					"speakerTitle": "Кюсто"
				},
				{
					"id": 40190409,
					"content": "Не без этого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190410
					],
					"speakerTitle": "Лаверюн"
				},
				{
					"id": 40190410,
					"content": "Меня пару дней назад тоже перевели на кухню. До сих пор помню, как Кюсто бормотал над каждой морковкой: «Как там дела у тех двоих? Как думаешь, они выбрались живыми?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190411
					],
					"speakerTitle": "Лаверюн"
				},
				{
					"id": 40190411,
					"content": "И каждый раз я в ответ говорил: «С ними точно всё хорошо! Где бы они ни были, наверняка сейчас отдыхают где-нибудь с бокалами в руках и любуются пейзажами».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190412
					],
					"speakerTitle": "Лаверюн"
				},
				{
					"id": 40190412,
					"content": "Эй! Что плохого в том, чтобы беспокоиться о своих товарищах по отсидке? Тем более они всегда так охотно слушали мою болтовню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190413
					],
					"speakerTitle": "Кюсто"
				},
				{
					"id": 40190413,
					"content": "Эта парочка... Они куда душевнее и добрее, чем Паймон поначалу казалось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190414,
						40190415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 40190414,
					"content": "Качество бесплатного питания наверняка в последнее время взлетело до небес.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				},
				{
					"id": 40190416,
					"content": "...Ну, может, так и есть, раз ты говоришь. А за вами я буду следить, чтобы всё до кусочка съели!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кюсто"
				},
				{
					"id": 40190415,
					"content": "Ваша еда всех заключённых заманит в столовую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				}
			]
		},
