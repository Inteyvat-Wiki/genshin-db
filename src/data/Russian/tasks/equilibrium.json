							"102103",
							"2"
						],
						"stepId": 102103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бу Юнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "(Кэ Цин сказала, надо говорить так...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210302,
					"content": "Простите, здесь продаётся луна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210303,
					"content": "Да. Сколько вам нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "Бу Юнь"
				},
				{
					"id": 10210304,
					"content": "Мне не очень удобно говорить о цифрах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210305,
					"content": "Прекрасный ответ. Пожалуйста, поднимайтесь. Ах да... У вас запланирована встреча с Нин Гуан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "Бу Юнь"
				},
				{
					"id": 10210306,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210307,
					"content": "(Однако они использовали не гостевой пароль, а пароль Нефритового Равновесия. Что-то здесь не так...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бу Юнь"
				}
			]
		},
		{
			"id": 102104,
			"completionStepIds": [
				102104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102104",
							"2"
						],
						"stepId": 102104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нин Гуан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210401,
					"content": "#Я ожидала тебя, пришедш{M#ий}{F#ая} из Заоблачного предела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210402
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210402,
					"content": "Нин Гуан!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210403,
					"content": "Мы приготовили подарок в честь нашей встречи. Надеемся, что он вам понравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210404,
					"content": "Это мне? Благодарю. Не стоило утруждать себя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210405
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210405,
					"content": "Для нас это не составило ни малейшего труда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210406,
						10210408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210406,
					"content": "Нефритовый дворец очень красивый.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210407
					]
				},
				{
					"id": 10210407,
					"content": "Я рада, что тебе здесь нравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210409
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210409,
					"content": "Дворец парит в облаках над горными вершинами. Весь город виден как на ладони.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210410
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210410,
					"content": "Я начала копить деньги на постройку дворца, когда только начала заниматься коммерцией. С тех пор как я стала Волей Небес, я не жалею денег на лучших мастеров, которые постоянно расширяют дворец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210411
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210411,
					"content": "В начале он был размером с комнату, а сейчас он достаточно большой, чтобы затмить луну над Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210412
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210412,
					"content": "Настанет день, и его тень покроет все семь королевств.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210413
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210413,
					"content": "(А у Воли Небес весьма амбициозные планы...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210414
					]
				},
				{
					"id": 10210414,
					"content": "Редкие чужестранцы удостаиваются чести подняться в Нефритовый дворец. Однако в письмах действующий магистр Ордо Фавониус высоко отзывается о тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210415
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210415,
					"content": "#Поэтому мой взгляд прикован к тебе с того момента, как ты прибыл{F#а} в Ли Юэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210416
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210416,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210417,
					"content": "Я поняла, куда вы движетесь, когда вы направились в гостиницу «Ваншу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210418
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210418,
					"content": "Верр Голдет тоже работает на тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210419
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210419,
					"content": "Нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210420
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210420,
					"content": "Весь персонал постоялого двора работает на меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210421
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210421,
					"content": "##%^%*&...!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210422,
					"content": "По пути мы встретили Нефритовое Равновесие...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210423
					]
				},
				{
					"id": 10210423,
					"content": "Рядом с баллистой Гуй Чжун, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210424
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210424,
					"content": "Ты всё это время следила за нами с небес?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210425
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210425,
					"content": "Ха-ха... Боюсь, с такой высоты я едва ли смогла бы вас разглядеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210426
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210426,
					"content": "Мне хватает глаз и ушей. Вы двое - очень интересные персонажи. Естественно, мне стало интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210427
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210427,
					"content": "Кэ Цин сказала, что Цисин не желают зла Властелину Камня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210428
					]
				},
				{
					"id": 10210428,
					"content": "#Ты больше {M#общался}{F#общалась} с Адептами, поэтому я не жду, что ты с лёгкостью нам доверишься. Я пригласила тебя, чтобы прояснить некоторые недопонимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210408,
					"content": "Я впервые поднимаюсь так высоко...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210409
					]
				}
			]
		},
		{
			"id": 102106,
			"completionStepIds": [
				102106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102106",
							"2"
						],
						"stepId": 102106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нин Гуан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210601,
					"content": "Ого! Какой огромный зал! Паймон никогда раньше не бывала в таких роскошных местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210602,
					"content": "Расслабьтесь. Чувствуйте себя как дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210603
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210603,
					"content": "Серьёзно? Прямо как дома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210604,
					"content": "Я пригласила вас как друзей. Когда друзья приходят в гости, самое главное - хорошо провести время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210605
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210605,
					"content": "А что это там?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210606
					]
				},
				{
					"id": 10210606,
					"content": "Ого! Это же легендарная стена, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210607,
					"content": "А вы неплохо осведомлены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210608
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210608,
					"content": "Даже сказители слагают о ней истории... Все хотят кусочек бумаги с этой доски!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210609,
					"content": "Эта стена хранит многие тайны Ли Юэ, а купцы всегда хотят узнать чужие секреты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210610
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210610,
					"content": "#Как я понимаю, тебя не интересуют коммерческие тайны, верно? Ты особенн{M#ый}{F#ая}, и, должно быть, сам{F#а} это хорошо знаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210611
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210611,
					"content": "Я бы хотела заслужить твоё доверие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210612
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210612,
					"content": "Кто же более достоин твоего доверия? Кэ Цин или я?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210613,
						10210614
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210613,
					"content": "Выбор между верой в богов и неверием...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				},
				{
					"id": 10210615,
					"content": "Ха-ха. Ты выбираешь Кэ Цин? Я так и думала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210616
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210616,
					"content": "Изначально я думала, что она слишком категорично смотрит на вещи. Мне часто приходится решать проблемы, которые она создаёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210617
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210617,
					"content": "Но однажды она сказала: «Времена Адептов давно прошли. Если даже Цисин не готовы это признать, то какое же тогда будущее ждёт Ли Юэ?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210618
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210618,
					"content": "Эти слова развеяли многие мои сомнения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210619
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210619,
					"content": "Не стану отрицать, что всё выглядит так, будто смерть Властелина Камня нам на руку. Но ради благополучия Ли Юэ мы не можем позволить слухам о захвате власти запятнать нашу репутацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210620
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210620,
					"content": "Стоит полагать, Фатуи приложили руку к распространению этих слухов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210621
					]
				},
				{
					"id": 10210621,
					"content": "Действительно... Ты умеешь читать между строк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210622
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210622,
					"content": "Я приказала оцепить территорию и спрятать экзувию, чтобы стабилизировать ситуацию. Я не могла допустить повторения мондштадтского инцидента.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210623
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210623,
					"content": "После кончины Властелина Камня деятельность Фатуи в регионе вышла далеко за рамки простой дипломатической миссии. Как Воля Небес Цисин, я не могу лишь заботиться о приличиях, подвергая опасности жителей Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210624
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210624,
					"content": "Мы позволили провести Церемонию Вознесения, чтобы выиграть немного времени и восстановить контроль над администрацией города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210625
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210625,
					"content": "Хм... Именно так и говорил Чжун Ли. Цисин разрешили провести Церемонию Вознесения, чтобы использовать нас в своих целях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210626
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210626,
					"content": "Точно! Говоря о целях... Можно я ещё кое-что спрошу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210627
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210627,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210628
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210628,
					"content": "Я слышала, что те, кто приносит дары в Нефритовый дворец, всегда получают что-то взамен. Касается ли это нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210629
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210629,
					"content": "Паймон! Сейчас не самый подходящий момент.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210630
					]
				},
				{
					"id": 10210630,
					"content": "Ха-ха-ха... Ничего страшного. Я ценю прямоту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210631
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210631,
					"content": "Мы доставили вам немало хлопот, не так ли? Как насчёт... Я разрешу вам выбрать здесь любой предмет и забрать его с собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210632
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10210632,
					"content": "Да! Паймон ждала, что ты это скажешь! Я хочу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210633
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210633,
					"content": "<color=#00E1FFFF>Кусочек бумаги</color> с той стены!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210634
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210634,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210635
					]
				},
				{
					"id": 10210635,
					"content": "Не смотри на меня так! Даже крохотный кусочек бумаги с той стены стоит целое состояние.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210636
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210636,
					"content": "Ты только представь, сколько моры мы сможем за него выручить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210614,
					"content": "Мне близок скептицизм Кэ Цин.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				}
			]
		},
		{
			"id": 102108,
			"completionStepIds": [
				102108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
