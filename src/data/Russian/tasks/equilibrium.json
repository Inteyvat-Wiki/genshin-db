				{
					"id": 10213001,
					"content": "Вы спасли дядюшку Мэна! Спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213002
					],
					"speakerTitle": "Син Си"
				},
				{
					"id": 10213002,
					"content": "Ладно... Ну а теперь, я должна почистить эти горшки.",
					"roleType": "TALK_ROLE_NPC",
