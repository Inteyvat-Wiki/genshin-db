			"trigger": {
				"objectNames": [
					"Нин Гуан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10213101,
					"content": "Значит, вы приняли решение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213102
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10213102,
					"content": "Не спрашивайте меня. Просто примите решение и возьмите, что вам нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213103
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10213103,
					"content": "А после почему бы не отдохнуть в Нефритовом дворце или не отправиться на прогулку? Отдых - это важная часть любого путешествия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213104,
						10213106
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10213104,
					"content": "Благодарю за гостеприимство.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213105
					]
				},
				{
					"id": 10213105,
					"content": "К чему подобная учтивость? Расслабься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10213106,
					"content": "Нам пора идти. Пока...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213107
					]
				},
				{
					"id": 10213107,
					"content": "#Уже уходите? Хорошо. Надеюсь, что когда мы увидимся в следующий раз, ты уже совершишь правильный поступок... Или будешь готов{F#а} его совершить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нин Гуан"
				}
			]
		}
	]
