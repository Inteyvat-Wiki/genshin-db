					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210201,
					"content": "Хм? Мне кажется, или пахнет чем-то сладеньким?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210202,
					"content": "#Ты это слышал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210203,
						10210205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210203,
					"content": "Кто-то зовёт на помощь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210204
					]
				},
				{
					"id": 10210204,
					"content": "Звук доносится со стороны вон тех руин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210207,
					"content": "Ох! Похитители сокровищ заперли кого-то внутри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210205,
					"content": "Похоже на песню.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210206
					]
				},
				{
					"id": 10210206,
					"content": "Нет, непохоже! Кто-то зовёт на помощь! Звук доносится со стороны вон тех руин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 102103,
			"completionStepIds": [
				102103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
