			"trigger": {
				"objectNames": [
					"Закария"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230380101,
					"content": "#Путешественни{F#ца}{M#к}! Скорее иди сюда, у меня есть к тебе просьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380102
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230380102,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380103
					]
				},
				{
					"id": 230380103,
					"content": "Ты помнишь Маруфа? Это тот врач из деревни Аару, который просил тебя взять у меня рецепт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380104
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230380104,
					"content": "Так вот, он на себе испытал собственноручно изготовленное лекарство, после чего несколько дней мучился от рвоты и поноса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380105
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230380105,
					"content": "Поспрашивав, я узнал, что на его пациента не подействовал отвар, после чего у него внезапно возникла идея самому изменить его состав.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380106
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230380106,
					"content": "Ума не приложу, что он мог туда добавить для получения такого эффекта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380107
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230380107,
					"content": "Хм, если бы он просто изменил пропорции ингредиентов изначального рецепта и способ приготовления, то ничего подобного бы не случилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380108
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230380108,
					"content": "Он ведь уже не в первый раз наступает на те же грабли, так почему же до сих пор...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380109
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230380109,
					"content": "Ладно, ему наверняка тоже приходится нелегко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380110
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230380110,
					"content": "#Если у тебя есть желание помочь, путешественн{F#ица}{M#ик}, не мог{F#ла} бы ты достать для меня немного лекарственных ингредиентов? В этот раз я лично приготовлю лекарство, и нужно будет, чтобы ты его передал{F#а} Маруфу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380111,
						230380112
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230380111,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380114
					]
				},
				{
					"id": 230380114,
					"content": "В этот раз Маруф изменил состав моего рецепта от головной боли, который я ему передавал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380115
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230380115,
					"content": "Для рецепта не хватает красноплодников. Достань мне, пожалуйста, три штучки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Закария"
				},
				{
					"id": 230380112,
					"content": "А он так уже делал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380113
					]
				},
				{
					"id": 230380113,
					"content": "Да, я уже и не помню, сколько раз. Хорошо хоть, он не работает с опасными средствами, иначе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380114
					],
					"speakerTitle": "Закария"
				}
			]
		},
