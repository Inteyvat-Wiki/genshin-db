			"dialogs": [
				{
					"id": 230381101,
					"content": "Хм, с ингредиентами всё правильно, и метод готовки верный. Что же случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381102
					],
					"speakerTitle": "Маруф"
				},
				{
					"id": 230381102,
					"content": "#Путешественни{F#ца}{M#к}? Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381103
					],
					"speakerTitle": "Маруф"
				},
				{
					"id": 230381103,
					"content": "#Я принес{F#ла} лекарство от Закарии.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381104
					]
				},
				{
					"id": 230381104,
					"content": "Тогда ты, наверно, уже знаешь, что я натворил. Ох, как неловко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381105
					],
					"speakerTitle": "Маруф"
				},
				{
					"id": 230381105,
					"content": "Неважно, выпей лекарство.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381106
					]
				},
				{
					"id": 230381106,
					"content": "Ох, ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381107
					],
					"speakerTitle": "Маруф"
				},
				{
					"id": 230381107,
					"content": "Маруф выпивает зелье...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230381108
					]
				},
				{
					"id": 230381108,
					"content": "Фух... Сразу стало лучше. Закария и правда прекрасный врач.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381109
					],
					"speakerTitle": "Маруф"
				},
				{
					"id": 230381109,
					"content": "Почему ты изменил рецепт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381110
					]
				},
				{
					"id": 230381110,
					"content": "Помнишь лекарство, которое мы варили вместе в прошлый раз? Оно не очень хорошо сработало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381111
					],
					"speakerTitle": "Маруф"
				},
				{
					"id": 230381111,
					"content": "Я подумал, что, возможно, я ошибся при варке или пропустил несколько ингредиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381112
					],
					"speakerTitle": "Маруф"
				},
				{
					"id": 230381112,
					"content": "Так что я сварил ещё одну порцию на базе собственного опыта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381113
					],
					"speakerTitle": "Маруф"
				},
				{
					"id": 230381113,
					"content": "В качестве меры предосторожности я для начала попробовал его сам. Остальное тебе известно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381114
					],
					"speakerTitle": "Маруф"
				},
				{
					"id": 230381114,
					"content": "#Я отправил посыльного за лекарством от доктора Закарии, но ты его опередил{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381115
					],
					"speakerTitle": "Маруф"
				},
				{
					"id": 230381115,
					"content": "#Спасибо, путешественни{F#ца}{M#к}. Я немного отдохну и снова открою приём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381116
					],
					"speakerTitle": "Маруф"
				},
				{
					"id": 230381116,
					"content": "Меня долго не было, должно быть, жители деревни совсем заждались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381117
					],
					"speakerTitle": "Маруф"
				},
				{
					"id": 230381117,
					"content": "Эх, вот только травы опять заканчиваются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Маруф"
				}
			]
		}
