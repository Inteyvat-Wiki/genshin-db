					"Матага"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290601,
					"content": "У тебя неплохо получается, если будешь стараться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290602
					],
					"speakerTitle": "Матага"
				},
				{
					"id": 750290602,
					"content": "#Ха, поверил{F#а}? Напрасно! В моём словаре нет слов вроде «неплохо» и «сносно»! Не таким будет моё напутствие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290603
					],
					"speakerTitle": "Матага"
				},
				{
					"id": 750290603,
					"content": "#Нужно стремиться быть лучшим! Если лучшим стал кто-то другой, ты проиграл{F#а}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290604
					],
					"speakerTitle": "Матага"
				},
				{
					"id": 750290604,
					"content": "Если не трусишь, попробуй ещё раз! Продолжай тренировки, пока не превзойдёшь меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Матага"
				}
			]
		},
		{
			"id": 7502907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502904",
							"3"
						],
						"stepId": 7502904,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
