			},
			"dialogs": [
				{
					"id": 721170301,
					"content": "Как всё прошло? Тебе удалось собрать все маячки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170302
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721170302,
					"content": "Всё у меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170303
					]
				},
				{
					"id": 721170303,
					"content": "Браво! А теперь дай мне время на модификацию устройства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170304
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721170304,
					"content": "И всё же действия Фатуи становятся всё более странными. Они все собрались вокруг ядра горна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170305
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721170305,
					"content": "Надеюсь, они не вынашивают очередной коварный план... Или, скорее, что они не планируют ничего такого, с чем мы не смогли бы справиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				}
			]
		},
