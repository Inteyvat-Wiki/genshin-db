					"Ксавье"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721170101,
					"content": "#Ты как раз вовремя, путешественни{F#ца}{M#к}! Почти все данные собраны, и теперь самое время забрать наши маячки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170102,
						721170104
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721170102,
					"content": "Так точно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170103
					]
				},
				{
					"id": 721170103,
					"content": "Что ж, ступай. И лучше поспеши и будь осторожнее, чтобы Фатуи тебя не заметили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721170104,
					"content": "Откуда тебе это известно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170105
					]
				},
				{
					"id": 721170105,
					"content": "К этим маячкам обычно прилагается очень подробная инструкция.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170106
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721170106,
					"content": "Там описаны самые разные условия работы и приводится время, необходимое для сбора данных в каждом из случаев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170107
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721170107,
					"content": "Поскольку мы имеем дело с неизвестным источником энергии, я решил, что нужно просто выставить датчики на максимальное ожидание. В любом случае я рассчитываю на вас в деле сбора маячков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				}
			]
		},
		{
			"id": 7211702,
