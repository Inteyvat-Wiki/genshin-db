			"dialogs": [
				{
					"id": 400340601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340602
					],
					"speakerTitle": "Кагэромару"
				},
				{
					"id": 400340602,
					"content": "Гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340603
					],
					"speakerTitle": "Кагэромару"
				},
				{
					"id": 400340603,
					"content": "Это... Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340604,
						400340606,
						400340608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340604,
					"content": "Шляпоклык.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340605
					]
				},
				{
					"id": 400340605,
					"content": "Ну нет! Что это за прозвище такое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340609,
					"content": "В любом случае, кажется, он не собирается нападать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340610
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400340610,
					"content": "Гав-гав...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340611
					],
					"speakerTitle": "Кагэромару"
				},
				{
					"id": 400340611,
					"content": "Ой, он куда-то бежит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340612,
					"content": "Бежит и оглядывается на нас. Может, он хочет, чтобы мы отправились следом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340613
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400340613,
					"content": "Скорее за ним.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340614
					]
				},
				{
					"id": 400340614,
					"content": "Хм, может быть, нам скоро откроется истина... Наверно, всё окажется так, как предсказывала Санго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400340606,
					"content": "Ножепёс.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340607
					]
				},
				{
					"id": 400340607,
					"content": "Это Шляпоклык, и точка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400340608,
					"content": "Чёрная тень.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340609
					]
				}
			]
		},
		{
			"id": 4003409,
			"completionStepIds": [
