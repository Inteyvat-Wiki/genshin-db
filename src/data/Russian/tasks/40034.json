			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340901,
					"content": "#Фух, дело сделано. Но это было так странно! Сначала Кагэромару казался таким дружелюбным, а потом, не успели мы оглянуться, как началась драка! Хорошо ещё, что с нами {NICKNAME}, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340902,
					"content": "#Почему же Кагэромару так интересует {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340903
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340903,
					"content": "Гав-гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340904
					],
					"speakerTitle": "Кагэромару"
				},
				{
					"id": 400340904,
					"content": "Мне слышится радость в его голосе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340905
					]
				},
				{
					"id": 400340905,
					"content": "И как ты это можешь разобрать! Я в замешательстве!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340906
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340906,
					"content": "#Если я не ошибаюсь, Кагэромару считает, что {NICKNAME} - его {F#хозяйка}{M#хозяин}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340907
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400340907,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340908
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340908,
					"content": "Что?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340909
					]
				},
				{
					"id": 400340909,
					"content": "Я кое-что слышал о том, как заключаются контракты между ниндзя и их собаками. Говорят, что воин должен победить в бою понравившегося ему пса-ниндзя, чтобы получить его одобрение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340910
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400340910,
					"content": "Ниндзя ищут себе сильных компаньонов, как и псы-ниндзя. Контракт может быть заключён, только когда обе стороны убедятся в силе второго участника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340911
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400340911,
					"content": "#Вот только {NICKNAME} не ниндзя... И...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340912
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340912,
					"content": "Хм-м.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340913
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340913,
					"content": "В чём дело, Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340914
					]
				},
				{
					"id": 400340914,
					"content": "#{NICKNAME}, для начала пообещай мне одну вещь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340915
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340915,
					"content": "Какую?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340916
					]
				},
				{
					"id": 400340916,
					"content": "Сначала дай обещание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340917
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340917,
					"content": "Эм-м, хорошо, обещаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340918
					]
				},
				{
					"id": 400340918,
					"content": "Даже если ты заключишь контракт с Кагэромару, Паймон всё равно останется твоим самым лучшим компаньоном!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340919
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340919,
					"content": "Конечно, Паймон - мой лучший компаньон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340920
					]
				},
				{
					"id": 400340920,
					"content": "Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340921,
						400340922
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340921,
					"content": "Ну, в сравнении с кошками и собаками...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				},
				{
					"id": 400340923,
					"content": "Хи-хи. Мы с тобой самые лучшие друзья навсегда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340924
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340924,
					"content": "Кхм, вас действительно связывают тесные узы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340925
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400340925,
					"content": "Но вернёмся к разговору: если Кагэромару так силён, зачем тот человек в письме просил присмотреть за ним?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340926
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400340926,
					"content": "#Я знаю ответ! Вот, например, {NICKNAME} очень {F#сильная}{M#сильный}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340927
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340927,
					"content": "Да, это правда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340928
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400340928,
					"content": "#Но если когда-нибудь что-то случится и мы расстанемся, я тоже буду сильно переживать. Дело не в том, {F#сильна}{M#силён} ли {NICKNAME} или нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340929
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340929,
					"content": "#Это был просто пример! Конечно, я не хочу накликать беду, я и {NICKNAME} - лучшие друзья, и мы всегда будем вместе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340930
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340930,
					"content": "Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340931
					]
				},
				{
					"id": 400340931,
					"content": "Рассуждения Паймон вполне логичны. Тогда остаётся один вопрос: зачем этому псу красть животных у жителей деревни?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340932
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400340932,
					"content": "Ум-м... Здесь даже смекалка Паймон даёт сбой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340933
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340933,
					"content": "#Жалко, что Кагэромару не умеет говорить. А то {NICKNAME} мог{F#ла} бы спросить его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340934
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340934,
					"content": "Давайте разыщем Санго.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340935
					]
				},
				{
					"id": 400340935,
					"content": "Точно, у нас же есть Санго! Самое время мозгу группы показать себя, идём к ней!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340936
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400340936,
					"content": "Хорошо. Только сначала я верну спрятанных животных. Встретимся позже в агентстве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400340922,
					"content": "Паймон явно понадёжнее будет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				}
			]
		},
		{
			"id": 4003410,
			"completionStepIds": [
				4003410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003410",
							"2"
						],
						"stepId": 4003410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Санго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341001,
					"content": "Санго, мы вернулись! Вот что произошло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341002
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400341002,
					"content": "А, вот в чём дело. Думаю, я догадываюсь, почему Кагэромару пытался отстоять животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341003
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400341003,
					"content": "Наверное, он хотел сделать других животных сильнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341004
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400341004,
					"content": "Должно быть, в детстве он был слабым, а сильным стал, уже когда вырос. Вполне логично, что он хотел помочь другим животным пройти тот же путь с помощью тренировок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341005
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400341005,
					"content": "#Но после встречи с тобой, видя твою готовность защищать слабых, Кагэромару признал тебя {F#своей хозяйкой}{M#своим хозяином}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341006
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400341006,
					"content": "Это также связано с его рыцарским отношением к слабым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341007
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400341007,
					"content": "Ну, во всяком случае, таковы мои выводы на основании имеющихся у нас улик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341008
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400341008,
					"content": "Как именно дела обстоят на самом деле, мы вряд ли сможем точно узнать, поскольку Кагэромару не умеет говорить. Но думаю, что я недалека от истины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341009
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400341009,
					"content": "Хм, звучит логично. Хотя чего ещё ожидать от мозга группы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341010
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341010,
					"content": "Гав-гав-гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341011
					],
					"speakerTitle": "Кагэромару"
				},
				{
					"id": 400341011,
					"content": "Ты согласен с Санго?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341012
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341012,
					"content": "Ха-ха, спасибо за лестные слова, но не рассчитывай на скидку, если однажды решишь поручить мне расследование. В любом случае дело можно считать закрытым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341013
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400341013,
					"content": "#Спасибо, {NICKNAME} и Паймон, это во многом благодаря вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341014
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400341014,
					"content": "Ах да, чуть не забыла. Какие у вас впечатления от использования Сети вездесущности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341015,
						400341016
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400341015,
					"content": "Очень удобно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				},
				{
					"id": 400341017,
					"content": "Хорошо, принято к сведению. Я отправлю ваш отзыв подруге. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341018
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400341018,
					"content": "#Для нас это пара пустяков! Не стесняйтесь обращаться к нам, если у вас возникнут какие-либо проблемы. {NICKNAME} справится с любым делом в кратчайшие сроки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341019
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341019,
					"content": "#Путешественни{F#ца}{M#к}, тебе и впрямь не занимать мастерства. Но оставим эти любезности, сентиментальность - враг истины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				},
				{
					"id": 400341016,
					"content": "У меня всё время такое чувство, что она сейчас сломается.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				}
			]
		},
		{
			"id": 4003411,
			"completionStepIds": [
				4003411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003411",
							"2"
						],
						"stepId": 4003411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кагэромару"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341101,
					"content": "Уф, наконец-то дело закончено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341102,
					"content": "Что? Тут какое-то... письмо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341103
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400341103,
					"content": "Давайте прочитаем его. В конце концов, это последняя подсказка, которая у нас есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341104
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400341104,
					"content": "Хе-хе, точно! Дайте-ка Паймон посмотрит, что там...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341105,
					"content": "«Тому, кто проч...» и что-то там что-то там... Да тут ничего не разберёшь, всё испорчено!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341106,
					"content": "Наверное, это значит «тому, кто прочтёт это письмо».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341107
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400341107,
					"content": "А, ну да, похоже на то. Так, что тут дальше? «Наш клан специализируется на обучении псов-ниндзя. Цель этого обучения - обеспечить ниндзя надёжными спутниками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341108,
					"content": "Боюсь, я вряд ли вернусь из своего последнего похода. Я ни о чём не жалею. Меня занимает лишь судьба Кагэромару.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341109,
					"content": "Щенком он был слишком слаб, а потому никто из ниндзя не заключил контракт с ним в качестве компаньона. Но для меня это не имело значения. Как дрессировщик, я не хотел отказываться ни от одной собаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341110,
					"content": "С каждым днём тренировок Кагэромару становился все сильнее. К сожалению, он не захотел заключить контракт ни с одним ниндзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341111,
					"content": "Война еще не началась, но комиссия Тэнрё поторапливает меня. У меня больше нет возможности оставаться с ним - пора отправляться в путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341112,
					"content": "Я могу лишь оставить это письмо. Если вы найдёте его, пожалуйста, позаботьтесь о Кагэромару.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341113,
					"content": "Его можно узнать по старому шраму на морде. А ещё он ведёт себя не так, как другие собаки».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341114,
					"content": "Так Кагэромару, о котором говорится в письме - это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341115
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400341115,
					"content": "...тот самый пёс, который привёл нас сюда, я полагаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341116
					]
				},
				{
					"id": 400341116,
					"content": "Его действительно ни с кем не перепутать! Подождите, тут ещё что-то есть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341117,
					"content": "«Я понимаю, что это самонадеянная просьба, но у меня нет другого выбора. И ещё: если однажды он захочет заключить контракт и приведёт сюда того, за кем он хочет следовать, то вот как это можно сделать...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341118,
					"content": "Что, серьёзно? Бросил писать на самом интересном месте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400341119,
					"content": "Наверное, автор думал, что это невозможно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341120
					]
				},
				{
					"id": 400341120,
					"content": "Конечно, ведь Кагэромару с самого начала не хотел ни с кем заключать контракт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341121
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400341121,
					"content": "Гав-гав...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341122
					],
					"speakerTitle": "Кагэромару"
				},
				{
					"id": 400341122,
					"content": "#А? Он снова убежал, и на этот раз в здание. Давай за ним, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
