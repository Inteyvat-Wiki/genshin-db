			"dialogs": [
				{
					"id": 750360801,
					"content": "Расти, семечко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750360802,
					"content": "Расти, цветочек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750360803,
					"content": "...А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750360804,
					"content": "Хм...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360805
					]
				},
				{
					"id": 750360805,
					"content": "#Ах, {NICKNAME}, энергия флогистона угасла. Должно быть, семечко впитало её, но... Никакой реакции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750360806,
					"content": "Р-р-р?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360807,
						750360811
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360807,
					"content": "Возможно, семенам нужно время, чтобы прорасти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360808
					]
				},
				{
					"id": 750360808,
					"content": "Правда? Об этом Паймон не подумала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750360809,
					"content": "Семена одуванчика разлетаются как маленькие зонтики, если на них слегка подуть, волчьи крюки прикрепляются к волчатам и убегают с ними в далёкие края...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750360810,
					"content": "Семена - живучие создания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750360815,
					"content": "В таком случае оставим его на время и вернёмся позже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360816
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750360816,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360811,
					"content": "Может, семечко чего-то испугалось?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360812
					]
				},
				{
					"id": 750360812,
					"content": "Правда? Хм, возможно, Паймон слишком нетерпелива...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360813
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750360813,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} выкопал семечко, питательные вещества украли летающие насекомые, а ещё всякие монстры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360814
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750360814,
					"content": "Эта схватка, должно быть, показалась семечку ужасной грозой. Вполне естественно, что оно спряталось в земле, не решаясь прорасти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Паймон"
				}
			]
