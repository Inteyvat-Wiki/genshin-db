					"Эекатль"
				],
				"points": [
					{
						"sceneId": 101,
						"position": [
							561.16,
							819.386,
							-45.567
						],
						"pointId": 52
					},
					{
						"sceneId": 101,
						"position": [
							562.786,
							818.938,
							-45.043
						],
						"pointId": 910101004
					}
				]
			},
			"dialogs": [
				{
					"id": 751490301,
					"content": "«А я уже официально представлял вам его? Кажется, нет...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490302
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490302,
					"content": "«Ну, ничего страшного. Добро пожаловать в первый Свящ{RUBY#[D]Страну Первозданного огня}енный город Толлан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490303
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490303,
					"content": "Паймон... не ожидала, что вулкан будет так выглядеть изнутри...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751490304,
					"content": "Это точно вулкан? Может, мы прошли через вулкан и оказались в другом месте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751490305,
					"content": "Р-р-р... Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490306
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490306,
					"content": "«Без сомнений, мы внутри Священной горы. Но даже я не помню, когда видел это место в последний раз...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490307
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490307,
					"content": "«Ах... Я понял, в насколько плохом ты состоянии, только когда свет снова озарил тебя...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490308
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490308,
					"content": "Эекатль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751490309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490310
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490310,
					"content": "Р-р-р?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490311,
					"content": "«О, прошу прощения. Я на мгновение погрузился в ненужные сентиментальные мысли...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490312
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490312,
					"content": "Низкий уровень заряда... Перехожу в режим ожидания. Необходимо заменить или подключить... источник энергии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490313
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490313,
					"content": "«Ха-ха, похоже, что Эекатль был в слишком длительном \"изгнании\", недолго ему осталось...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490314
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490314,
					"content": "А? Неужели Эекатль обречён умереть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751490315,
					"content": "«Того, кого вы называете Эекатль, давно уже нет... Для перезапуска Толлана требуется огромное количество энергии, и нельзя допускать лишнего расхода. Вы должны...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490316
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490316,
					"content": "«...уничтожить печать на одном из двух Астральных{RUBY#[D]Цицимитль} собраний... и на другом... Только тогда вы сможете по-настоящему активировать Небесную ось в центре»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490317
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490317,
					"content": "«Эм...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490318
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490318,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490319
					]
				},
				{
					"id": 751490319,
					"content": "«Всё хорошо... мы ещё... встретимся...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490320
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490320,
					"content": "«Эх... Ступай вперёд, Избранник драконов... О боль потери жизненной силы, даже спустя столько лет я... я не могу к этому привыкнуть...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490321
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490321,
					"content": "Р-р?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490322
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490322,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490323
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490323,
					"content": "Свет вокруг Эекатля исчез... И он больше не двигается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751490324,
					"content": "Паймон всё ещё не понимает, кто говорил - Эекатль или кто-то другой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490325,
						751490326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751490325,
					"content": "Когда-нибудь мы узнаем...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490327
					]
				},
				{
					"id": 751490327,
					"content": "Да. И всё же, насчёт Астральных собраний, о которых он только что говорил... Это те самые большие огненные шары? И Небесная ось... Мы понятия не имеем, что это такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490328
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751490328,
					"content": "Начнём поиски странных штуковин, о которых он говорил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751490329,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490326,
					"content": "Идёмте дальше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490327
					]
				}
			]
		},
