			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эекатль",
					"#{REALNAME[ID(2)|SHOWHOST(true)]}"
				],
				"points": [
					{
						"sceneId": 101,
						"position": [
							561.16,
							819.386,
							-45.567
						],
						"pointId": 52
					},
					{
						"sceneId": 101,
						"position": [
							562.786,
							818.938,
							-45.043
						],
						"pointId": 910101004
					}
				]
			},
			"dialogs": [
				{
					"id": 751490201,
					"content": "«Должен сказать, это место не всегда было таким мрачным... Даже несмотря на то, что мы, несомненно, находимся внутри вулкана...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490202
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490202,
					"content": "«Но после окончания войны весь город был разрушен. И столь гигантская механическая конструкция вряд ли могла продолжать функционировать...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490203
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490203,
					"content": "Война?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751490204,
					"content": "«Да, война между оставшимися потомками драконов и людьми - война, в которой был убит изначальный повелитель огня...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490205
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490205,
					"content": "«Хозяин этого места давно мёртв, и никто, кроме города, не в силах выжить... Хотя как знать? Возможно, город тоже уже умер».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490206
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490206,
					"content": "«...Хм. Или, возможно, многие вещи, существовавшие в прошлом, были не более чем иллюзиями».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490207
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490207,
					"content": "Р-р-р?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490208,
					"content": "«Каждый из нас получит выгоду. Ты получишь то, за чем пришёл, а я надеюсь позаимствовать твою силу, чтобы решить парочку своих проблем...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490209
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490209,
					"content": "«Вам нужно добраться до Сердца Священной горы... Но, к сожалению, из-за войны силы горы оказались заблокированы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490210
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490210,
					"content": "«И хотя сила печатей подобна нити, способной запутать лишь ребёнка, клятва предписывает, что активировать их может только \"человек\"...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490211
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490211,
					"content": "«Интересно, что бедное дитя, которое использовало этот способ, чтобы проникнуть на Священную гору, в итоге было уничтожено кем-то ещё, кто использовал почти такие же средства».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490212
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490212,
					"content": "«Хе-хе. Так было всегда... Как последователи тирана изгоняются героями, так и их потомки после долгих лет скитаний прекращают тиранию в каком-нибудь другом месте...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490213
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490213,
					"content": "«Жизнь похожа на поставленную пьесу. Причина и следствие, месть и бунт... Все сцены веками повторяются одна за другой...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490214
					],
					"speakerTitle": "Эекатль"
				},
				{
					"id": 751490214,
					"content": "«Ой, я отвлёкся. Давай уже... включи его. Пусть этот умирающий город ещё немного поживёт. Сейчас только ты можешь это сделать».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эекатль"
				}
			]
		},
		{
