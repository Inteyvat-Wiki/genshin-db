						],
						"stepId": 1104004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Розария"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400401,
					"content": "С-сестра Розария, вот вы где! Хор скоро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400402
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 110400402,
					"content": "Я уже говорила, что не собираюсь принимать в этом участие. У меня есть более важные дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400403
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400403,
					"content": "Но ведь... это памятное событие. Церковь надеется, что все сёстры будут на нём присутствовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400404
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 110400404,
					"content": "«Надеется»?! Я не припомню, что обязана исполнять чьи-то «надежды»! В моём контракте об этом не сказано ни слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400405
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400405,
					"content": "Да... Я понимаю, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400406
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 110400406,
					"content": "Но что? Ты организатор события, не так ли? Не находишь это забавным?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400407
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400407,
					"content": "Что именно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400408
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 110400408,
					"content": "Так далеко от Мондштадта, в такой-то час... Держу пари, что даже если выдвинуться сейчас же, ты всё равно не успеешь к церемонии открытия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400409
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400409,
					"content": "Кто знает... Может, кто-то хочет выставить тебя на посмешище?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400410
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400410,
					"content": "Что?! Нет! Они не такие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400411
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 110400411,
					"content": "Ха! Людей определяют их поступки, а не твои впечатления. Эх... Может быть, ты доверяешь всем без разбора?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400412
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400412,
					"content": "Не волнуйся, даже если ты вернёшься ни с чем, никто тебя винить не станет. Не могу представить, что кто-то кроме тебя, будучи в здравом уме, решил, что я там появлюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400413
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400413,
					"content": "Но если ещё немного задержишься - обязательно опоздаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400414
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400414,
					"content": "...Ты права! Это памятное событие очень важно. Если я опоздаю... Н-ну, я пошла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400415
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 110400415,
					"content": "Хм, кажется, эта монашка мастерски умеет заговаривать зубы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400416,
					"content": "Я заметила вас ещё на подходе. Кто вы такие? Чего вы это тут подслушиваете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400417
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400417,
					"content": "Осторожней! Она похожа на опасную злодейку... или, по меньшей мере, на обманщицу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400418,
					"content": "Да ну? Я давно состою в церкви Фавония. А ты мелкий неопознанный летающий объект. И кто из нас опаснее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400419
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400419,
					"content": "Она всё слышала! Но Паймон шептала так тихо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400420,
					"content": "#А чужезем{F#ка}{M#ец}, за котор{F#ой}{M#ым} ты следуешь... Хм, так вот ты как{F#ая}{M#ой}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400421
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400421,
					"content": "#Почётный рыцарь, спасший нас от Ужаса Бури. Учитывая твой титул, расспрашивать тебя, почему ты подслушивал{F#а}, я не стану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400422
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400422,
					"content": "Иначе, в зависимости от твоих ответов, в худшем случае я бы могла арестовать тебя прямо здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400423
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400423,
					"content": "Что?! С каких пор монахини могут арестовывать людей?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400424,
					"content": "Смотреть сквозь пальцы на скрытые угрозы нельзя. Или ты откажешь сёстрам в чувстве справедливости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400425
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400425,
					"content": "Хм, как-то это неправильно. Но Паймон ничего в ответ придумать не может...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400426
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400426,
					"content": "Поговорим лучше о вас. Зачем вы пришли в горы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400427,
						110400428
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400427,
					"content": "Мы ищем Альбедо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400431
					]
				},
				{
					"id": 110400431,
					"content": "Если это он, то на вашем месте я бы обратила внимание на следы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400432
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400432,
					"content": "После метели здесь много кто прошёл. Надеюсь, следы ещё не засыпало снегом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400433
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400433,
					"content": "Так... ты тоже его ищешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400434
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400434,
					"content": "Нет, это просто моя профессиональная привычка. На тех следах я почувствовала налёт элементальной энергии. Немного бдительности никогда не повредит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400435,
						110400436
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400435,
					"content": "Для сестёр ты слишком загадочна...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400437,
					"content": "Мне всё равно, что вы там думаете. Идём. Я хочу посмотреть, чем он занимается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400436,
					"content": "Ты, случайно, не сыщик?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400428,
					"content": "Мы пришли в поисках истины сего мира.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400429
					]
				},
				{
					"id": 110400429,
					"content": "#Но ты ведь всего лишь путешественни{F#ца}{M#к}. Сомневаюсь, что ты хорошо разбираешься в алхимии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400430
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110400430,
					"content": "Неважно. Я догадываюсь, кого именно вы ищете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400431
					],
					"speakerTitle": "Розария"
				}
			]
		},
		{
			"id": 1104005,
			"completionStepIds": [
				1104002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104002",
							"2"
						],
						"stepId": 1104002,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066501",
							"3"
						],
						"stepId": 7066501,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сахароза"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400501,
					"content": "Ой, кажется, Тимея здесь сегодня нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400502,
					"content": "(А? Это же...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400503
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400503,
					"content": "#Ой! Да... Привет, {NICKNAME} и Паймон! Простите, вы ищете Тимея по делу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400504
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400504,
					"content": "Нет, нет. Просто странно, что он не здесь. Паймон думала, что он всегда стоит тут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400505,
					"content": "Понятно. Альбедо послал за ним, и он ушёл, а я осталась приглядывать за лавкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400506
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400506,
					"content": "Если что-нибудь понадобится, просто позовите. Если нет, я... я сяду вон там, почитаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400507
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400507,
					"content": "#Хе-хе, спасибо! Не беспокойся, основы алхимии мы уже знаем, не так ли, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400508,
					"content": "Ага, так что мы не будем тебя беспокоить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400509
					]
				},
				{
					"id": 110400509,
					"content": "#Конечно, ты ведь всё-таки {F#тa самая легендарная путешественница, которая избавила}{M#тот самый легендарный путешественник, который избавил} наш город от Ужаса Бури...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400510
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400510,
					"content": "Ой, но это значит, ты сможешь помочь Альбедо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400511
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400511,
					"content": "Мы постоянно слышим от вас с Тимеем про этого Альбедо. Он тоже занимается алхимией в Мондштадте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400225,
						110400226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400225,
					"content": "Мне не знакомо это имя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400227,
					"content": "Прошу прощения, я забыла его представить. Альбедо - главный алхимик Ордо Фавониус. Он обучал Тимея и меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400228
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400228,
					"content": "Но из учителей алхимии мы встречали только Тимея. Получается, что... Альбедо - учитель учителя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400229,
					"content": "Верно. Он посвятил свою жизнь познанию истины и сделал много важных открытий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400230
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400230,
					"content": "Часто к нему обращаются за помощью алхимики из далёких краёв. Они говорят, что даже небольшие указания господина Альбедо помогают им решать самые непостижимые проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400231
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400231,
					"content": "Ого! Паймон и подумать не могла, что он такой крутой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400232,
					"content": "Угу. Но мне кажется, что недавно он столкнулся с какими-то трудностями в своём исследовании. Каждый раз, когда я его вижу, он выглядит весьма озадаченно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400233,
						110400234
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400233,
					"content": "Не думаю, что я смогу чем-то помочь такому алхимику.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400235,
					"content": "Уверена, Альбедо хотел бы услышать о твоих невероятных подвигах. Это должно вдохновить его на что-то потрясающее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400236
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400236,
					"content": "Альбедо - настоящий джентльмен. Я не сомневаюсь, что награда будет соразмерна твоей помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400237,
						110400239
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400237,
					"content": "Он может сделать меня сильнее?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400238
					]
				},
				{
					"id": 110400238,
					"content": "Почему бы и нет? В конце концов, поиск предела человеческих способностей - одна из областей исследований Альбедо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400241,
					"content": "Прямо сейчас Тимей с Альбедо проводят исследования в горах. Я бы с радостью отвела вас двоих прямо к ним, но кто-то должен присматривать за магазином.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400242
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400242,
					"content": "Придётся вам самим отправиться к подножию горы на их поиски. Ищите утончённого джентльмена с внешностью настоящего учёного, и... ммм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400243
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400243,
					"content": "Прошу прощения, я не знаю, как его ещё описать. Вам придётся полагаться на своё чутьё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400244
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 110400244,
					"content": "Хватит переживать! Мы справимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400239,
					"content": "Он может сделать Паймон сильнее?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400240
					]
				},
				{
					"id": 110400240,
					"content": "Эй... Паймон в этой области помощь не нужна. Но если Альбедо пожелает заплатить Паймон за помощь, то Паймон готова принять крупную сумму морой. Хи-хи-хи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110400234,
					"content": "#Я знаком{F#а} лишь с самыми основами алхимии.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400226,
					"content": "#Я что-то о нём слышал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				}
			]
		}
	]
}