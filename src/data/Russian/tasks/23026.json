			},
			"dialogs": [
				{
					"id": 230260401,
					"content": "Поднимите, пожалуйста, голову. Вы видите большое дерево, на котором держится Академия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260402
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260402,
					"content": "Следующий мой вопрос очень простой, однако многие не знают ответ на него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260403
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260403,
					"content": "Итак, внимание: как называется дерево, на котором расположена Академия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260404,
						230260406,
						230260408
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260404,
					"content": "Великое древо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260405
					]
				},
				{
					"id": 230260405,
