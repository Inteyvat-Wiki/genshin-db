					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260101,
					"content": "Не слишком ли сложны эти вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260102
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260102,
					"content": "#А? Путешественни{F#ца}{M#к}! Пожалуйста, постой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260103
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260103,
					"content": "Ты это мне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260104
					]
				},
				{
					"id": 230260104,
					"content": "Да! Ха-ха-ха! Я лишь потому решился побеспокоить вас, что отчаянно нуждаюсь в вашей помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260105,
						230260106,
						230260107
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260105,
					"content": "Ты что-то потерял?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260108,
					"content": "А? Ты в этом что-то понимаешь? Ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260109
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260109,
					"content": "Нет, нет! Я ничего не терял и от недостатка материалов тоже не страдаю! А что до вдохновения... Я и сам могу его найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260110
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260110,
					"content": "Кхе-кхе, на самом деле сейчас я занят составлением брошюры с часто задаваемыми вопросами, чтобы помочь новеньким студентам быстрее усвоить различные термины, распространённые в Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260111
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260111,
					"content": "Проще говоря, в нём сложные слова объясняются с помощью вопросов и ответов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260112
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260112,
					"content": "Таким образом, обучение будет более эффективным и интересным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260113
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260113,
					"content": "Однако я не до конца понимаю, насколько сложны эти вопросы. Не могли бы вы мне с этим помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260114,
						230260116
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260114,
					"content": "#Я не очень хорошо знаком{F#а} с Академией...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260115
					]
				},
				{
					"id": 230260115,
					"content": "Ха-ха-ха! Это не страшно! После того, как вы ответите на мои вопросы, вы будете неплохо представлять ситуацию в Академии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260119,
					"content": "Не переживайте! Никаких глобальных дилемм, обычные повседневные вопросики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260120
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260120,
					"content": "Что ж, начнём. Внимание, вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260116,
					"content": "И почему у меня чувство дежавю?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260117
					]
				},
				{
					"id": 230260117,
					"content": "Ты о тех вопросах, которые задавал тебе Свен в Мондштадте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230260118,
					"content": "Но в тот раз он заранее дал нам ответы для подготовки! А этот исследователь, по всей видимости, так делать не собирается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230260106,
					"content": "Тебе нужны материалы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260107,
					"content": "Ты ищешь вдохновение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				}
			]
		},
		{
