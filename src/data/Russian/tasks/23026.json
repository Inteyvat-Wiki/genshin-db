					"Зирьяб"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260201,
					"content": "Кхе-кхе... Должно быть, вы уже знаете, что каждый даршан Академии имеет свои сильные стороны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260202
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260202,
					"content": "Итак, вопрос: у какого даршана больше всего студентов? Он в основном занимается исследованием биологии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260203,
						230260205,
						230260207
					],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260203,
					"content": "Амурта.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260204
					]
				},
				{
					"id": 230260204,
					"content": "Хорошо, совершенно верно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260205,
					"content": "Армута.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260206
					]
				},
				{
					"id": 230260206,
					"content": "Эх, это не совсем верный ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зирьяб"
				},
				{
					"id": 230260207,
					"content": "Амарата.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260208
					]
				},
				{
					"id": 230260208,
					"content": "Ха-ха, очень жаль, но этот ответ неверен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зирьяб"
				}
			]
		},
		{
			"id": 2302603,
			"completionStepIds": [],
