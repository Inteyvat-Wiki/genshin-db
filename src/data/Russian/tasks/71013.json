			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710131501,
					"content": "<color=#00E1FFFF>Глаз Бога</color>... Артефакт из других миров. Говорят, что это подарок от божеств, но никто не знает как именно его получить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131502
					],
					"speakerTitle": "Сокровища руин"
				},
				{
					"id": 710131502,
					"content": "В древних текстах сказано, что божества с сочувствием относятся к смертным и даруют <color=#00E1FFFF>Глаза Бога</color> самым достойным, чтобы те боролись со злом и защищали порядок. Но я... Я больше не хочу сражаться с монстрами. Я хочу общаться с ними. Я хочу понимать их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131503
					],
					"speakerTitle": "Сокровища руин"
				},
				{
					"id": 710131503,
					"content": "Этот <color=#00E1FFFF>Глаз Бога</color>... Мне больше не нужен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сокровища руин"
				}
			]
		},
