					"Му Нин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710830201,
					"content": "Ну как там внизу? Не встретили ничего опасного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830202,
						710830210
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710830202,
					"content": "(Рассказать всё Му Нину)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830203
					]
				},
				{
					"id": 710830203,
					"content": "Вот оно как. Звучит довольно опасно. Боюсь, что придётся попросить тебя позаботиться о Цзинь У и Чжи Цюн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830204
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710830204,
					"content": "Разве ты не останавливать меня должен?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830205
					]
				},
				{
					"id": 710830205,
					"content": "Такая уж моя обязанность, да. Но ты очень быстро всегда убегаешь, и я не могу тебя догнать. Как же я тебя остановлю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830206
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710830206,
					"content": "Не так уж и быстро я бегаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830207
					]
				},
				{
					"id": 710830207,
					"content": "Ещё как быстро! Раз в отчёте так написано, значит, так и есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830208
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710830208,
					"content": "Ладно, получается, что всё-таки быстро бегаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830209
					]
				},
				{
					"id": 710830209,
					"content": "#Именно. Так что будь, пожалуйста, {M#осторожен}{F#осторожна}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710830210,
					"content": "Всё в порядке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830211
					]
				},
				{
					"id": 710830211,
					"content": "Очень хорошо, очень хорошо. Если ничего такого не случится, то и Цисин не будут ко мне слишком строги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Му Нин"
				}
			]
		}
	]
