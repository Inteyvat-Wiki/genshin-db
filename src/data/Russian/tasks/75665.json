			"dialogs": [
				{
					"id": 756650101,
					"content": "Привет! Добро пожаловать в пункт снабжения Экспедиции заврианов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650102
					],
					"speakerTitle": "Винеш"
				},
				{
					"id": 756650102,
					"content": "Ого, сколько здесь заврианчиков! Все отправляются на поиски океанского зефира?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756650103,
					"content": "Время не ждёт, отряд искателей океанского зефира тронулся в путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650104
					],
					"speakerTitle": "Винеш"
				},
				{
					"id": 756650104,
					"content": "Эти заврята тоже очень хотят помочь, но как ни старались Ифа и Какуку обучить их, они всё равно не понимают, что такое океанский зефир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650105
					],
					"speakerTitle": "Винеш"
				},
				{
					"id": 756650105,
					"content": "Чтобы не расстраивать малышей, Ифа разрешил им тоже присоединиться к экспедиции. Пусть добывают то, что сами захотят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650106
					],
					"speakerTitle": "Винеш"
				},
				{
					"id": 756650106,
					"content": "Добычей могут быть их любимые злакофрукты или сокровища, которыми они так интересуются. Всё равно. Главное, чтобы все живыми и невредимыми вернулись назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650107
					],
					"speakerTitle": "Винеш"
				},
				{
					"id": 756650107,
					"content": "Вот оно как! Кажется, они очень рады. Нужно помнить о безопасности, там повсюду злющие монстры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756650108,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650109
					],
					"speakerTitle": "Бойкий детёныш тепетлизавра"
				},
				{
					"id": 756650109,
					"content": "Мы будем проводниками заврианчиков. Если хотите, тоже можете принять участие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Винеш"
				}
			]
		}
	]
}