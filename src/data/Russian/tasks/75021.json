							-2071.525,
							194.475,
							7589.419
						],
						"pointId": 8296
					}
				]
			},
			"dialogs": [
				{
					"id": 750210301,
					"content": "Фух! Я бы один не справился, спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210302
					],
					"speakerTitle": "Орко"
				},
				{
					"id": 750210302,
					"content": "Так это и есть упавшая звезда? Если присмотреться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210303,
						750210306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750210303,
					"content": "А-а-а-а-а! Таинственная сила проникает в моё тело!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210304
					]
				},
				{
					"id": 750210304,
					"content": "Что?! Правда? Но мы же даже осколки ещё не нашли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750210305,
					"content": "Кстати, об осколках. Здесь есть подсказки, где их искать? Паймон ничего не видит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750210308,
					"content": "Что будем делать дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750210309,
					"content": "Придётся прибегнуть к грубой силе. <color=#00E1FFFF>Ударь по нему всей мощью тепетлизавра</color>, и, возможно, мы узнаем, где находятся недостающие осколки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210310
					],
					"speakerTitle": "Орко"
				},
				{
					"id": 750210310,
					"content": "Грубая сила может решить большинство проблем! Так говорит мой отец. Но я до сих пор не пробудил в себе силу, да и своего завриана у меня нет... Так что ты - всё, что у меня есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Орко"
				},
				{
					"id": 750210306,
					"content": "Какой странный камень.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210307
					]
				},
				{
					"id": 750210307,
					"content": "Он определённо выглядит необычно... Может, Паймон чего-то не понимает, но Паймон не чувствует никакой таинственной силы, исходящей от него?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
