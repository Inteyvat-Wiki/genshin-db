			},
			"dialogs": [
				{
					"id": 401970301,
					"content": "Великолепно! Нарисую <color=#E77E70FF>красные</color>.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970302
					]
				},
				{
					"id": 401970302,
					"content": "#Вкус соуса болоньезе?.. Это можно считать неожиданным поворотом! Ты победил{F#а}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401970401,
					"content": "#Ну что ж! Теперь, когда ты {F#стала гордой обладательницей}{M#стал гордым обладателем} памятной карты, можешь нарисовать на ней столько разных усов, сколько захочешь.",
					"roleType": "TALK_ROLE_NPC",
