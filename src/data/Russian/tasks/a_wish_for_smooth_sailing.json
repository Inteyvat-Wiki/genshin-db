			"dialogs": [
				{
					"id": 401970201,
					"content": "Отлично! Нарисую <color=#C4D6EAFF>белые</color>.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "Со вкусом сливок, да? Классика, но... очень вкусная! Одобряю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401970401,
					"content": "#Ну что ж! Теперь, когда ты {F#стала гордой обладательницей}{M#стал гордым обладателем} памятной карты, можешь нарисовать на ней столько разных усов, сколько захочешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401970402,
					"content": "Похоже, это очень вкусная карта. Мы будем беречь её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401970403,
					"content": "Отлично! Для нас главное, чтобы вы были довольны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401970404,
					"content": "Всё в полном порядке! А теперь пора расслабиться. Забудьте о работе и веселитесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Навия"
				}
			]
		},
		{
			"id": 4019703,
			"completionStepIds": [
				4019703,
