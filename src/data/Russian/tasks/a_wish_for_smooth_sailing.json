			"dialogs": [
				{
					"id": 401970101,
					"content": "Настало время добавить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970102
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401970102,
					"content": "Соль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970103
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 401970103,
					"content": "Перец, вообще-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970104
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401970104,
					"content": "Блестяще!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970105
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 401970105,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401970106,
					"content": "Вы случайно не новое десертное меню обсуждаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401970107,
					"content": "В десерте перец явно не к месту.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970108
					]
				},
				{
					"id": 401970108,
					"content": "Это не десерт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970109
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 401970109,
					"content": "Мы обсуждаем сценарий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970110
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401970110,
					"content": "Что?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970111
					]
				},
				{
					"id": 401970111,
					"content": "Дорогой друг, фотограф, начинающий режиссёр! Наше творчество должно соответствовать бурному энтузиазму наших поклонников!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970112
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401970112,
					"content": "На моей сцене нет места скучным постановкам! Повороты сюжета должны сбивать зрителей с толку, подобно облаку перца, заставляя удивлённо чихать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970113
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401970113,
					"content": "Та же логика применима и в ресторанном деле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970114
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 401970114,
					"content": "Однажды Эмилия упомянула, что перец можно использовать в парфюмерии. Возможно, я смогу найти ему применение и в десертах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970115
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 401970115,
					"content": "Хм... Перечная нотка дополнит нежную сладость крема?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970116
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401970116,
					"content": "Ого, а вы неплохо сработались...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401970117,
					"content": "Хотя Паймон с трудом представляет, каким будет на вкус перечный торт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401970118,
					"content": "Что-что? Эскофье готовит новый торт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970119
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401970119,
					"content": "Да, и она привносит в него перчинку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970120
					]
				},
				{
					"id": 401970120,
					"content": "Как интересно! Когда будет готово, дай знать - я с удовольствием попробую!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970121
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401970121,
					"content": "Паймон кажется, или все ещё больше воодушевились, закончив работу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401970122,
					"content": "А как иначе? Когда твои труды окупаются... вот тогда и надо праздновать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970123
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401970123,
					"content": "Это как с макаронами - не удерживай себя от добавления нужного количества сахара из боязни пересластить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970124
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401970124,
					"content": "Если когда и стоит добавить сахар, так это при приготовлении макарон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970125
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401970125,
					"content": "Добавь сахар!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970126
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401970126,
					"content": "Добавь сахар!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970127
					],
					"speakerTitle": "Лепин-Полин"
				},
				{
					"id": 401970127,
					"content": "...Минутку. Могу я спросить, какой сахар мы будем добавлять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970128
					],
					"speakerTitle": "Лепин-Полин"
				},
				{
					"id": 401970128,
					"content": "Лепин-Полин! Всё готово?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970129
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401970129,
					"content": "Конечно! Всё по плану!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970130
					],
					"speakerTitle": "Лепин-Полин"
				},
				{
					"id": 401970130,
					"content": "А? Ты была занята каким-то важным делом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401970131,
					"content": "Именно так. Вот, возьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970132
					],
					"speakerTitle": "Лепин-Полин"
				},
				{
					"id": 401970132,
					"content": "Это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970133
					]
				},
				{
					"id": 401970133,
					"content": "Ух ты! Это панорама парка развлечений с изображениями всех участников!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401970134,
					"content": "Раз уж парк развлечений имел такой успех, мы решили создать уникальный сувенир на память о нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970135
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401970135,
					"content": "Мы строили парк вместе, кирпичик за кирпичиком. Поэтому решили, что и карту будем рисовать все вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970136
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 401970136,
					"content": "Если честно, всё было реализовано в основном благодаря Лепин-Полин, нашему эксперту в рисовании. Но и мы тоже постарались оставить свой след.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970137
					],
					"speakerTitle": "Эскофье"
				},
				{
					"id": 401970137,
					"content": "Верно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970138
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401970138,
					"content": "#И в довершение всего, {NICKNAME}, я предоставляю тебе особую привилегию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970139
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 401970139,
					"content": "Можешь дорисовать мне усы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фурина"
				}
			]
		},
