					"Иорой"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080801,
					"content": "О-ох... Как же я хочу почесать себе пузико...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080802
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080802,
					"content": "М-м? Зачем вы вернулись? Идите и найдите <color=#00E1FFFF>Сёсэя, Гёбу Кобан и Китибoси</color> и поиграйте с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080803
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080803,
					"content": "А теперь ступайте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иорой"
				}
			]
		},
		{
			"id": 7210809,
			"completionStepIds": [
				7210807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210807",
							"2"
						],
						"stepId": 7210807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иорой"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080901,
					"content": "Хе-хе, отлично! Кажется, они очень довольны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080902
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080902,
					"content": "...Что? О, не проблема. Давайте я спрошу у них за вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080903
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080903,
					"content": "Гёбу Кобан спрашивает: «Если вы люди, почему вы пахнете, как тануки?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080904
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080904,
					"content": "...А ведь верно! А ну-ка объяснитесь! Почему вы пахнете, как тануки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080905
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080905,
					"content": "Что? И ты только сейчас спросил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080906,
						721080907
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721080906,
					"content": "Жрица в маске...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				},
				{
					"id": 721080908,
					"content": "Точно! Так всё и было!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080909
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721080909,
					"content": "Жрица в маске щедро нас накормила и сказала, что использовала магию, которой тайно обучалась у бакэ-дануки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080910
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721080910,
					"content": "Что? Да как она смела тайно изучать нашу магию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080911
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080911,
					"content": "Хм-м... Может быть... просто возможно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080912
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080912,
					"content": "Вот пронырливая кицунэ. Если она всё ещё жива, могла бы зайти поздороваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080913
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080913,
					"content": "Она жрица в маске. Сказала, что ты её старый друг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080914
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721080914,
					"content": "В маске? Не знаю никаких масок, и жриц тоже не знаю. Но я знаю одну кицунэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080915
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080915,
					"content": "Кстати, эта пронырливая кицунэ уже появлялась в обличье жрицы. Как она выглядит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080916
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080916,
					"content": "Она носит белую лисью маску...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080917
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721080917,
					"content": "Что-то ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080918,
						721080920
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080918,
					"content": "Короткие чёрные волосы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080919
					]
				},
				{
					"id": 721080919,
					"content": "Платье жрицы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721080922,
					"content": "Хм-м... Я её не знаю. Никогда таких не встречал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080923
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080923,
					"content": "Ну конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080924
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721080924,
					"content": "...Да? Ну и ладно, предоставьте это мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080925
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080925,
					"content": "Сёсэй сказал: «Играть с вами было весело. Спасибо!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080926
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080926,
					"content": "Паймон тоже была вне себя от радости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080927
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721080927,
					"content": "По поводу гребня...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080928
					]
				},
				{
					"id": 721080928,
					"content": "Я самый знаменитый в мире бакэ-дануки Иорой. Конечно же, я сдержу своё слово. Можете забрать гребень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080929
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080929,
					"content": "Но зачем он вам? От него несёт лисой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080930
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080930,
					"content": "Дело вот в чём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721080920,
					"content": "Платье жрицы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080921
					]
				},
				{
					"id": 721080921,
					"content": "Короткие чёрные волосы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721080907,
					"content": "Съели что-то не то...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				}
			]
		},
