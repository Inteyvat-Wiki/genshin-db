				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721081101,
					"content": "И всё? Просто куча камней...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721081102,
					"content": "Да? Кажется, он использует какую-то магию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721081103,
					"content": "Ого! Камни пропали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081104,
						721081105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721081104,
					"content": "Это поразительно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721081106
					]
				},
				{
					"id": 721081106,
					"content": "Так это и есть магия бакэ-дануки? Кажется, это довольно забавно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721081107,
					"content": "Спасибо, Китибоси! Давай в следующий раз сыграем в прятки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721081108,
					"content": "Ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 721081105,
					"content": "Как жутко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721081106
					]
				}
			]
		},
