			"dialogs": [
				{
					"id": 721080931,
					"content": "В общем, тут кое-что произошло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080932
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080932,
					"content": "Из-за него я провёл в заточении...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080933,
						721080934,
						721080935
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080933,
					"content": "Сотню лет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080936,
					"content": "Ох! Хватит меня дразнить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080937
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080937,
					"content": "Ладно, не обращайте внимания. Дело прошлое. А еще у меня есть отличная идея по поводу барьера в лесу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080938
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080938,
					"content": "Давным-давно, когда я сражался с коварной кицунэ, однажды я увидел кое-что на берегу моря к востоку отсюда. Похоже на элемент Электро с воротами, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080939
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080939,
					"content": "Когда тот парень сражался с демонами, я беспокоился, что некоторые из них могут вырваться и навредить нам. Поэтому я использовал магию, чтобы наложить печать на это место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080940
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080940,
					"content": "Дай-ка подумать. Печать под скалой на востоке, вы говорите... Китибоси, отведи их туда и сними печать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080941
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080941,
					"content": "Спасибо, Иорой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080942
					]
				},
				{
					"id": 721080942,
					"content": "Ладно, хватит болтать. Идите быстрее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080943
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080943,
					"content": "Если снова встретите ту коварную кицунэ, не забудьте передать от меня привет. Просто скажите ей... дайте-ка подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080944
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080944,
					"content": "Слушай, гадина, я просто в бешенстве. Вернись и сразись со мной! Нам ещё предстоит свести счёты! И помоги мне снять печать, раз уж ты рядом! Всё верно, я прошу не потому, что не в состоянии сделать это сам, а потому что ты всё ещё должна мне одну услугу! Передайте кицунэ, что я по ней скучаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080945
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 721080945,
					"content": "Мне придётся запомнить довольно много!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721080934,
					"content": "Тысячу лет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080935,
					"content": "Миллион лет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				}
			]
		}
