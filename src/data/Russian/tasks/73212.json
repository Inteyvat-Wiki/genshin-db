						"stepId": 7326422,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бабель"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732121701,
					"content": "#Здравствуйте, {M#уважаемый повелитель}{F#уважаемая повелительница} джиннов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121702
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121702,
					"content": "Я всё ещё расследую нападение на вас. Не переживайте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121703
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121703,
					"content": "Я гарантирую вашу безопасности в племени Танит, но если вы отправитесь в пустыню... будьте предельно осторожны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121704,
						732121711,
						732121714,
						732121721
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121704,
					"content": "Расскажи об Оазисе вечности...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121705
					]
				},
				{
					"id": 732121705,
					"content": "Позвольте мне от лица племени Танит выразить вам с Джехт благодарность за ваш вклад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121706
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121706,
					"content": "Оазис вечности важен не только Джехт... Он также является религиозным центром племени Танит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121707
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121707,
					"content": "Тот, кто им завладеет, получит трон Набу Маликаты, Королевы оазисов... Для её потомков это очень важно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121708
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121708,
					"content": "Не могу понять... Насколько же он ценный?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121709
					]
				},
				{
					"id": 732121709,
					"content": "Ха-ха, он бесценный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121710
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121710,
					"content": "...его нельзя оценить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121711,
					"content": "Как в последнее время Джехт? Занята?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121712
					]
				},
				{
					"id": 732121712,
					"content": "Хотя Оазис вечности уже находится под нашим управлением, но нельзя позволить, чтобы к нему приближались всякие негодяи. Сейчас именно Танит защищает Оазис вечности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121713
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121713,
					"content": "Думаю, что никто не справится с этим заданием лучше Джехт. Она защищает своих родителей, так ведь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121714,
					"content": "О предателях...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121715
					]
				},
				{
					"id": 732121715,
					"content": "Предполагаю, что предатели закопошились, потому что мы проложили путь к Оазису вечности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121716
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121716,
					"content": "Для них наша богиня - символ высочайшей силы и источник несметных богатств... Я не могу терпеть такое оскорбление независимо от того, спит она или нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121717,
						732121719
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121717,
					"content": "Ты ещё веришь, что она проснётся?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121718
					]
				},
				{
					"id": 732121718,
					"content": "Конечно, верю... Рано или поздно она вернёт свой божественный облик и отведёт нас в край цветов. Но до этого мы... Танит будет исполнять её волю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121719,
					"content": "Мы там были, её нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121720
					]
				},
				{
					"id": 732121720,
					"content": "Она там, вы просто её не увидели. Но она там, она всегда будет там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121721,
					"content": "До свидания.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121722
					]
				},
				{
					"id": 732121722,
					"content": "#Берегите себя, {M#уважаемый повелитель}{F#уважаемая повелительница} джиннов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабель"
				}
			]
		}
	]
}