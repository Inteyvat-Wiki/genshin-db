			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732120501,
					"content": "(Пустой разбитый сосуд, ещё не занесён песком. Кажется, его выронили совсем недавно.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120502
					],
					"speakerTitle": "Исследовать"
				},
				{
					"id": 732120502,
					"content": "Смотри! Кувшин ещё не занесло песком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120503,
						732120505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120503,
					"content": "Товары разбросаны по пути следования каравана...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120504
					]
				},
				{
					"id": 732120504,
					"content": "Навевает недобрые мысли... Возможно, по пути они потеряли ещё что-то. Давай проверим, что там впереди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120505,
					"content": "Продолжим поиски.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120506
					]
				},
				{
					"id": 732120506,
					"content": "Да... Они наверняка потеряли ещё что-то вдоль пути. Давай проверим, что там впереди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
