			]
		},
		{
			"id": 7321216,
			"completionStepIds": [
				7321213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321213",
							"2"
						],
						"stepId": 7321213,
						"stateName": "QUEST_STATE_UNFINISHED"
