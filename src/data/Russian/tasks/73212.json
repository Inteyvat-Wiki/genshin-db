			"dialogs": [
				{
					"id": 732121001,
					"content": "В-вы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121002
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732121002,
					"content": "А что? Ты этого не ожидал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732121003,
					"content": "#Н-нет, я очень рад, что вы в-вернулись, {M#уважаемый повелитель}{F#уважаемая повелительница} д-джиннов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121004
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732121004,
					"content": "К-кстати, а что там с к-караваном?.. Как идёт расследование?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121005
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732121005,
					"content": "На караван было совершено нападение, и весь товар разграбили.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121006
					]
				},
				{
					"id": 732121006,
					"content": "Ужас, ужас! Это снова дело рук тех п-предателей. Это т-точно они!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121007
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732121007,
					"content": "Предателей?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121008
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732121008,
					"content": "П-предатели - те, что спутались с с-северянами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121009
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732121009,
					"content": "А к-кроме этого, ч-что вы ещё о-обнаружили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121010
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732121010,
					"content": "На нас напали Пустынники.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121011
					]
				},
				{
					"id": 732121011,
					"content": "Мы только закончили расследование с караваном, как внезапно появились Пустынники и напали на нас! Они ещё сказали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121012
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732121012,
					"content": "Они сказали, что нас знают.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121013
					]
				},
				{
					"id": 732121013,
					"content": "Эм... Именно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121014
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732121014,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121015
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732121015,
					"content": "Т-так вот оно ч-что... Они и в-вас выследили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121016
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732121016,
					"content": "Вот ваше в-в-вознаграждение. Теперь расскажите о с-случившемся Бабель. Н-нельзя медлить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121017
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732121017,
					"content": "Да, хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121018
					]
				},
				{
					"id": 732121018,
					"content": "#Д-до свидания, {M#уважаемый повелитель}{F#уважаемая повелительница} джиннов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Юфтен"
				}
			]
		},
		{
			"id": 7321211,
			"completionStepIds": [
				7321211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321211",
							"2"
						],
						"stepId": 7321211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бабель"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732121101,
					"content": "#Это ты, {M#уважаемый повелитель}{F#уважаемая повелительница} джиннов. Что заставило тебя так спешить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121102
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121102,
					"content": "Караван Юфтена ограбили предатели.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121103
					]
				},
				{
					"id": 732121103,
					"content": "Правда?.. Ну, это неудивительно. Северяне из снежных земель постоянно проникают на наши территории. Многие поддаются искушению и, поверив им, становятся нашими врагами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121104
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121104,
					"content": "Они постоянно сеют хаос. Грабежи и нападения происходят последние несколько месяцев...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121105
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121105,
					"content": "Ох... Прости, я не хотела тебя прерывать. Продолжай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121106
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121106,
					"content": "Предатели нас выследили.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121107
					]
				},
				{
					"id": 732121107,
					"content": "Мы только закончили расследование с караваном, как внезапно появились Пустынники и напали на нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732121108,
					"content": "Правда?.. Какой ужас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121109
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121109,
					"content": "Похоже... Даже после гибели Адерфи и Азарика эти дикие псы продолжают на нас скалиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121110
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121110,
					"content": "Так, вы оставайтесь здесь, отдохните и успокойтесь. Я лично проконтролирую, чтобы вы были в безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121111
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121111,
					"content": "Джехт пока не вернулась с задания племени. Когда она вернётся, я поручу ей вместе с вами заняться этим делом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121112
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121112,
					"content": "А до тех пор я приложу все усилия, чтобы выяснить, какие злодеи на вас напали... Будьте спокойны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121113
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121113,
					"content": "Ой, есть ещё кое-что! Те, кто нас задержали, кажется, нас знали! Возможно, они из племени!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732121114,
					"content": "Всё возможно... Но это не важно. На правах гостей вы будете под защитой... Пока вы здесь, вам никто не причинит вреда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121115
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121115,
					"content": "Если кто-то попытается вас тронуть в племени Танит, то, кто бы он ни был, будет иметь дело со мной, матриархом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121116
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121116,
					"content": "Вам нужно отдохнуть. А про предателей я выясню всё, что смогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121117
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121117,
					"content": "Я также прослежу за Джехт. Как только она вернётся, я вам сразу сообщу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121118
					],
					"speakerTitle": "Бабель"
				},
				{
					"id": 732121118,
					"content": "Спасибо, матриарх Бабель!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732121119,
					"content": "Совершенно не за что.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабель"
				}
			]
		},
