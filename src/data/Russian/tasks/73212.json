				"objectNames": [
					"Джехт"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732120401,
					"content": "#{NICKNAME}, привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120402
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732120402,
					"content": "Спасибо за то, что на тебя можно рассчитывать в приключении. И спасибо за... родителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120403
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732120403,
					"content": "Не стоит благодарности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120404
					]
				},
				{
					"id": 732120404,
					"content": "Хи-хи, если бы не другие поручения Бабель, я бы с радостью отправилась с тобой в пустыню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120405
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732120405,
					"content": "Я знаю ещё очень много интересных мест. Когда у меня будет время, я обязательно вас туда отведу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120406
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 732120406,
					"content": "Но... сейчас неподходящее время. Предатели, сговорившиеся с северянами, жаждут завладеть нашими землями. Я должна следить за ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джехт"
				}
			]
		},
		{
