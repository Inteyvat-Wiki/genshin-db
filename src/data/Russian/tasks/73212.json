			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732120801,
					"content": "(Свёрнутый ковёр в хорошем состоянии. На нём вышита метка племени Танит, а поверхность испещрена зловещими пятнами...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120802
					],
					"speakerTitle": "Исследовать"
				},
				{
					"id": 732120802,
					"content": "Этот ковёр... очень странный...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120803
					]
				},
				{
					"id": 732120803,
					"content": "Ох... Почему такой дорогой ковёр здесь лежит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120804,
					"content": "Возможно, здесь был бой...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120805
					]
				},
				{
					"id": 732120805,
					"content": "Да... вполне возможно... Это бы многое объясняло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120806,
					"content": "Наверно, во время схватки между караваном и грабителями некоторые товары были повреждены, а другие просто потерялись в общей суматохе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120807
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120807,
					"content": "Очень проницательно, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120808
					]
				},
				{
					"id": 732120808,
					"content": "Ха, Паймон - голова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120809,
					"content": "Значит, караван и разбойники дрались и двигались, дрались и двигались, дрались и двигались... Поэтому по всей дороге остались разбитые ящики и сосуды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120810,
					"content": "Да, звучит разумно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120811
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120811,
					"content": "Вовсе нет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120812
					]
				},
				{
					"id": 732120812,
					"content": "Э, что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120813,
						732120814
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120813,
					"content": "Испорченное бандиты, скорее всего, выбросили позже...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120815
					]
				},
				{
					"id": 732120815,
					"content": "То есть?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120816
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120816,
					"content": "Мы не обнаружили следов борьбы вдоль дороги.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120817
					]
				},
				{
					"id": 732120817,
					"content": "Значит, так всё было... Гм, всё же я была близка... Очень близка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120818
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120818,
					"content": "Хм... И всё-таки у Паймон такое чувство, что что-то не так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120819,
						732120820
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120819,
					"content": "Что именно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120821
					]
				},
				{
					"id": 732120821,
					"content": "Тебе... не кажется, что всё слишком хорошо сходится? Как будто улики были специально приготовлены для нас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120822,
						732120823
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120822,
					"content": "Ох... Ты слишком подозрительна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120824
					]
				},
				{
					"id": 732120824,
					"content": "Эй, смотри! Там же повозка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120825
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120825,
					"content": "Она практически неузнаваема... Но на ней есть метка племени Танит... хоть и очень размытая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120826
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120826,
					"content": "Итак, дело можно закрывать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120827
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120827,
					"content": "Всё очевидно. Караван попал в засаду, а весь товар разграбили и увезли. Нужно вернуться к Юфтену и рассказать обо всём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120828
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120828,
					"content": "Да, давай возвращаться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120829
					]
				},
				{
					"id": 732120829,
					"content": "Извините, но я прошу вас задержаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120830
					],
					"speakerTitle": "Ассасин Пустынников"
				},
				{
					"id": 732120830,
					"content": "А? Вы кто такие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120831
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120831,
					"content": "Мы друзья Джехт. Вы проделали большую работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120832
					],
					"speakerTitle": "Ассасин Пустынников"
				},
				{
					"id": 732120832,
					"content": "А, вот оно что. Ну, друзья Джехт - наши друзья! Мы уже здесь закончили, можем вернуться вместе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120833
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120833,
					"content": "Ха-ха, не торопитесь. Гостям не следует уходить столь поспешно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120834
					],
					"speakerTitle": "Ассасин Пустынников"
				},
				{
					"id": 732120834,
					"content": "Погоди, Паймон... С ними что-то не так.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120835
					]
				},
				{
					"id": 732120835,
					"content": "Джехт хочет, чтобы вы остались в пустыне ещё немного... Она поручила нам позаботиться о вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120836
					],
					"speakerTitle": "Ассасин Пустынников"
				},
				{
					"id": 732120836,
					"content": "Не разочаруйте её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120837
					],
					"speakerTitle": "Ассасин Пустынников"
				},
				{
					"id": 732120837,
					"content": "#А?.. {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120838
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120838,
					"content": "Паймон, прячься.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120839
					]
				},
				{
					"id": 732120839,
					"content": "Да, хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120823,
					"content": "Возможно. Но у нас пока всё равно недостаточно доказательств.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120824
					]
				},
				{
					"id": 732120820,
					"content": "Пора Паймон использовать свою интуицию!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120821
					]
				},
				{
					"id": 732120814,
					"content": "...чтобы было легче скрываться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120815
					]
				}
			]
		},
