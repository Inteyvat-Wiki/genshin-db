			"trigger": {
				"objectNames": [
					"Юфтен"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732120101,
					"content": "#А, э-это в-вы, {M#уважаемый повелитель}{F#уважаемая повелительница} джиннов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120102
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732120102,
					"content": "Я х-хочу попросить вас помочь... с одним в-важным делом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120103,
						732120105
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732120103,
					"content": "Не торопись, я слушаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120104
					]
				},
				{
					"id": 732120104,
					"content": "Да, рассказывай не спеша, мы тебе поможем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120107,
					"content": "У м-меня пропала партия... пропала партия... п-партия товара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120108
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732120108,
					"content": "Ну и ну! Пропало аж три партии товара!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120109,
					"content": "Нет, одна... п-партия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120110
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732120110,
					"content": "Я заказал Анаитское Благословение, но т-товар так и не п-пришёл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120111
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732120111,
					"content": "Возможно, это дело рук с-северян... Ведь матриарх Бабель в-всегда выступает против них, разыскивая предателей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120112
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732120112,
					"content": "П-после гибели Адерфи и Азарика... они стали чаще себя проявлять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120113
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732120113,
					"content": "Л-ладно, это к делу не относится. Последний раз к-караван с Анаитским Благословением д-дозорные видели в этой области...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120114
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732120114,
					"content": "Надеюсь, вы поможете мне н-найти товар или х-хотя бы... сообщите об уликах, к-которые оставил караван.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120115
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732120115,
					"content": "Хорошо, я помогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120116
					]
				},
				{
					"id": 732120116,
					"content": "Караван просто исчез? Как будто кто-то напал на него и разграбил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120117,
					"content": "Огромное спасибо! В-возьмите мясо в б-благодарность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120118
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732120118,
					"content": "Так любезно с твоей стороны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732120105,
					"content": "Чем я могу помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120106
					]
				},
				{
					"id": 732120106,
					"content": "Не торопись, некуда спешить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120107
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7321203,
