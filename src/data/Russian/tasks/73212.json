			"dialogs": [
				{
					"id": 732120301,
					"content": "Как дела? Е-е-есть новости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120302
					],
					"speakerTitle": "Юфтен"
				},
				{
					"id": 732120302,
					"content": "Мы всё ещё ищем пропавший караван.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120303
					]
				},
				{
					"id": 732120303,
					"content": "П-п-прошу поторопиться. Умоляю вас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Юфтен"
				}
			]
		},
		{
