			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732121601,
					"content": "Ох... Всё разломано... Паймон в ярости! Эти хиличурлы всё испортили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121602,
						732121604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732121602,
					"content": "Подожди, это вряд ли сделали хиличурлы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121603
					]
				},
				{
					"id": 732121603,
					"content": "А?.. Но... Именно у хиличурлов здесь разбит лагерь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121606,
						732121608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732121606,
					"content": "Мы ещё не нашли повозки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121607
					]
				},
				{
					"id": 732121607,
					"content": "Да... Всё верно! Повозок и даже их обломков здесь нет... И в жилищах хиличурлов от них ни следа... Странно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732121610,
					"content": "Пойдём дальше по дороге.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121611
					]
				},
				{
					"id": 732121611,
					"content": "Ладно. Если это сделали не хиличурлы, то кто же тогда?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732121608,
					"content": "Смотри, в лагере нет повозок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121609
					]
				},
				{
					"id": 732121609,
					"content": "Верно! Если хиличурлы ограбили караван, то они бы бросили повозки на месте нападения, чтобы потом их разобрать. Но мы не нашли ни повозок, ни их обломков... Это очень странно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732121604,
					"content": "Подожди, ограбление вряд ли произошло здесь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121605
					]
				},
				{
					"id": 732121605,
					"content": "Но хиличурлы разбили лагерь прямо посреди пути! Смотри, если заблокировать этот участок, то можно без труда кого-нибудь ограбить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121606,
						732121608
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7321217,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
