			"dialogs": [
				{
					"id": 200680201,
					"content": "#Ты уже собрал{F#а} грибы филанемо? Их под карнизами в южной части города растёт немало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
