				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Грейс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680501,
					"content": "Пожалуйста, отнеси эти картофельные оладьи Тимми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680502,
						200680506
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680502,
					"content": "Мама, о которой говорит Тимми...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680503
					]
				},
				{
					"id": 200680503,
					"content": "Это я. Я давно забочусь о детях, которые остались без родителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680504
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680504,
					"content": "Тимми пробыл со мной дольше всех. Он даже стал называть меня мамой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680505
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680505,
					"content": "Но всё-таки я не его настоящая мать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680506,
					"content": "Почему Тимми так сердится?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680507
					]
				},
				{
					"id": 200680507,
					"content": "Да как ты вообще смеешь задавать такой вопрос?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680508
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680508,
					"content": "Мальчик почти ни с кем не дружит, и кроме Норы с Глорией он водится только с мелкими животными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680509
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680509,
					"content": "А голуби даже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
