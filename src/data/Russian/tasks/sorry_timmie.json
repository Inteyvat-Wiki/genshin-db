			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Грейс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680101,
					"content": "Эх, что же мне делать?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680102
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680102,
					"content": "Что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680103
					]
				},
				{
					"id": 200680103,
					"content": "#Ага, явил{F#ась}{M#ся}, значит. Тимми рассказал мне, что ты сделал{F#а} с утками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680104
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680104,
					"content": "Ты... Ты... Как бы это сказать... Я слышала о твоих заслугах, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680105
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680105,
					"content": "Разве это достойное применение твоей силе и отваге?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680106,
						200680107,
						200680108
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680106,
					"content": "Мне ужасно хотелось есть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680109
					]
				},
				{
					"id": 200680109,
					"content": "Если тебе есть захотелось, почему было не заработать на хлеб честным трудом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680110
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680110,
					"content": "Люди с твоими способностями пригодились бы в Гильдии искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680113,
					"content": "Ну, это уже в прошлом. Вот только Тимми очень расстроился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680114
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680114,
					"content": "Я... Когда-то отец Тимми учил меня готовить. Любимое блюдо Тимми - Мондштадтские картофельные оладьи с грибами филанемо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680115
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680115,
					"content": "Чтобы приготовить их, мне нужны три гриба филанемо. Это подбодрит Тимми, и заодно послужит твоим извинением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680116,
						200680117
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680116,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680118
					]
				},
				{
					"id": 200680118,
					"content": "Возвращайся поскорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680120,
					"content": "Насколько я помню, грибов филанемо полно под карнизами домов в южной части города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680121
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680121,
					"content": "Скорей возвращайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680117,
					"content": "Сейчас насобираю целую гору!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680119
					]
				},
				{
					"id": 200680119,
					"content": "Мне нужно всего три! Что я буду делать с целой горой грибов? Или это для того, чтобы задабривать Тимми в будущем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680107,
					"content": "Я нечаянно, честное слово!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680111
					]
				},
				{
					"id": 200680111,
					"content": "#Голубей с утками ты случайно перебил{F#а}, да? Могучих врагов, что встают у тебя на пути, ты тоже побеждаешь случайно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680108,
					"content": "Сила - это результат подобных тренировок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680112
					]
				},
				{
					"id": 200680112,
					"content": "#Да ты... Ай, ладно. Поглядеть на тебя, ты креп{F#ка}{M#ок} и ум{F#на}{M#ён}, что та дубина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Грейс"
				}
			]
		},
