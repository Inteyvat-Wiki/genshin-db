					"Тимми"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680301,
					"content": "...Кушайте, кушайте и улетайте скорее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680302,
						200680303,
						200680304
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200680302,
					"content": "Как дела, Тимми?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680305
					]
				},
				{
					"id": 200680305,
					"content": "Опять ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200680308,
					"content": "#Чего ты задумал{F#а}? Собираешься снова бить голубей с утками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680309,
						200680310
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200680309,
					"content": "#Я прин{F#есла}{M#ёс} тебе картофельных оладий.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680311,
					"content": "#Картофельные оладушки? Где ты научил{F#ась}{M#ся} их так готовить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680312
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200680312,
					"content": "А, знаю, тебе мама рассказала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680313
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200680313,
					"content": "#Хочешь подкупить меня, значит? Я прекрасно помню, что ты сделал{F#а} с птичками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680314
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200680314,
					"content": "Но раз уж мама прислала тебя с оладушками, значит, она правда хочет, чтобы я успокоился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680315
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200680315,
					"content": "Ей ещё за Норой и Глорией присматривать надо. Ей и так трудно, а я уже взрослый и всё понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680316
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200680316,
					"content": "Ты уясни только: делаю я это только чтобы не доставлять хлопот маме. А тебя я ещё не простил. Ясно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680317
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200680317,
					"content": "Но я всего лишь ребенок. Вы, взрослые, непременно забудете, чего наобещали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680318
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200680318,
					"content": "Вот папа вернётся, я ему всё про тебя расскажу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200680310,
					"content": "Хочешь оладушек?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680303,
					"content": "Тимми, я, это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680306
					]
				},
				{
					"id": 200680306,
					"content": "Опять ты? Чего тебе от меня надо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 200680304,
					"content": "Что-то случилось, Тимми?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680307
					]
				},
				{
					"id": 200680307,
					"content": "У тебя ещё хватает наглости спрашивать?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Тимми"
				}
			]
		},
		{
			"id": 2006804,
			"completionStepIds": [
				2006804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
