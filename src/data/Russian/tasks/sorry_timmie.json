					"Грейс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680401,
					"content": "Этого достаточно, спасибо. Минуточку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680402
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680402,
					"content": "Готово. Пожалуйста, отнеси эти картофельные оладьи Тимми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680403
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680403,
					"content": "И, пожалуйста, больше так не делай. От подобных поступков больше беды, чем блага.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680404
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680404,
					"content": "Мой тебе совет: не расстраивай Тимми... или меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680405
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200680405,
					"content": "Хотя, если б все прислушивались к советам, у сестры Виктории не было бы столько хлопот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Грейс"
				}
			]
		},
		{
			"id": 2006805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2006803",
