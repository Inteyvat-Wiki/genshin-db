				"points": []
			},
			"dialogs": [
				{
					"id": 206030501,
					"content": "Вы вернулись так быстро! Значит, ничего серьёзного не случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030502
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206030502,
					"content": "В окрестностях полно монстров...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206030503
					]
				},
				{
					"id": 206030503,
					"content": "Что? Монстры всё ещё бродят по окрестностям, да ещё и в гораздо большем количестве?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030504
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206030504,
					"content": "Странно... Мы ведь уже отбили самое крупное наступление на Мондштадт, почему же они продолжают бродить прямо у стен города?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030505
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206030505,
					"content": "Может быть, они готовятся к новому нападению? Нельзя этого допустить! Мне нужно срочно созвать всех искателей приключений и раздать им новые поручения. Нельзя игнорировать эту угрозу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030506
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206030506,
					"content": "Проведение разведывательных операций и устранение опасности в городских окрестностях входят в зону компетенции Гильдии искателей приключений. Время показать всем, на что мы способны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030507
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 206030507,
					"content": "Ах, да, это тебе. Спасибо за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайрус"
				}
			]
		}
	]
