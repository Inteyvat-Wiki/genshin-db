			"dialogs": [
				{
					"id": 731010401,
					"content": "#Нара {NICKNAME} ну прямо как нара Варуна из легенд! {F#Настоящая героиня}{M#Настоящий герой}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731010402
					],
					"speakerTitle": "Араюта"
				},
				{
					"id": 731010402,
					"content": "На этот раз мы с Арадашаной не будем помогать тебе сдерживать Железоглыбу. Зато она станет чуть больше походить на Железоглыбу из легенд! Но не бойся. Арасата и Арасаха продолжат тебе помогать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731010403
					],
					"speakerTitle": "Араюта"
				},
				{
					"id": 731010403,
					"content": "#Ну что, нара {NICKNAME}, справишься?",
					"roleType": "TALK_ROLE_NPC",
