				"points": []
			},
			"dialogs": [
				{
					"id": 731010101,
					"content": "#Эй, нара {NICKNAME}! Что, тоже хочешь попробовать сразиться с Железоглыбой в сновидениях?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731010102
					],
					"speakerTitle": "Арадашан"
				},
				{
					"id": 731010102,
					"content": "Мы будем уровень за уровнем ослаблять влияющий на Железоглыбу араракалари. Затем мы сможем узреть истинную силу Железоглыбы, ведь араракалари перестанет сдерживать его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731010103
					],
					"speakerTitle": "Арадашан"
				},
				{
					"id": 731010103,
					"content": "Арадашан не сможет помочь тебе подавить Железоглыбу. Но ничего! Арасата, Араюта и Арасаха тоже не промах. Ну, попробуешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арадашан"
				}
			]
		},
