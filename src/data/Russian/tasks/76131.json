			"dialogs": [
				{
					"id": 761310701,
					"content": "А? Эта штука ещё работает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310702,
					"content": "А вдруг там есть какая-то информация? Давайте откроем и посмотрим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310703,
					"content": "Так это и есть послание, которое инопланетное существо передало драконам?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310704,
					"content": "Вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310705
					],
					"speakerTitle": "Яйцо"
				},
				{
					"id": 761310705,
					"content": "Выходит, проект «Созерцатель луны» был призван отправить сообщение обратно во Вселенную?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310706,
					"content": "Если дело только в этом, почему нельзя было использовать Око Ибни-Белума?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310707,
					"content": "Может, Паймон что-то упустила? Паймон ещё раз проверит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310708,
					"content": "Ого! В конце есть сноска!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310709,
					"content": "«Моей \"дочери\", Нин Нин».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310710,
					"content": "Нин Нин?! Стоп!.. Яйцо, так ты дочь Лусалима?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310711
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310711,
					"content": "Тогда как ты стала такой?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310712,
					"content": "Я... Я не знаю... У меня нет этих воспоминаний... Почему я ничего не помню?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310713
					],
					"speakerTitle": "Яйцо"
				},
				{
					"id": 761310713,
					"content": "Нам нужно осмотреть ядро Луны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310714
					]
				},
				{
					"id": 761310714,
					"content": "Н-но как же Коломбина? Мы всё ещё не нашли ни единой зацепки, связанной с её исчезновением...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310715
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310715,
					"content": "Её исчезновение может быть связано с ядром Луны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310716
					]
				},
				{
					"id": 761310716,
					"content": "Точно, то знакомое чувство, о котором она говорила, должно быть связано с ядром Луны... Паймон предлагает поторопиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
