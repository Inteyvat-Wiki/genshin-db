							-712.362,
							6197.159
						],
						"pointId": 275
					}
				]
			},
			"dialogs": [
				{
					"id": 761310401,
					"content": "Отсюда можно проникнуть вглубь базы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310402
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 761310402,
					"content": "Кто бы мог подумать, что база до сих пор работает. Поразительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310403,
					"content": "Ну, это же технология драконов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310404
					]
				},
				{
					"id": 761310404,
					"content": "В таком случае давайте не будем отвлекать их от дел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310405
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 761310405,
					"content": "Серьёзно? Паймон думала, раз ты с нами, мы тут всё вверх дном перевернём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310406,
					"content": "Ты не боишься, что всё повторится, как когда мы прилетели на Луну? С трудом успели на корабль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310407
					],
					"speakerTitle": "Яйцо"
				},
				{
					"id": 761310407,
					"content": "Ах... Паймон совершенно забыла об этом! Уф. А вообще, зачем базе система самоуничтожения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310408,
					"content": "Придётся пробраться туда тихонько, как в старые добрые времена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761310409,
					"content": "Да. Честно говоря, мне тоже хотелось бы узнать, что там внутри... да и тайком проникнуть в собственный «дом» - это довольно... необычно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310410
					],
					"speakerTitle": "Коломбина"
				},
				{
					"id": 761310410,
					"content": "К тому же здесь у меня возникает странное ощущение, что это место мне знакомо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Коломбина"
				}
			]
		},
		{
			"id": 7613105,
