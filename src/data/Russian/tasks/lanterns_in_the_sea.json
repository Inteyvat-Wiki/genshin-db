			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400050401,
					"content": "Что ты задумал?! Выкладывай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050402,
					"content": "Ладно, ладно! Я сдаюсь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050403
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050403,
					"content": "Сдавайся, иначе познаешь гнев Паймон!!! ...Что? Ты уже сдаёшься? Так быстро?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050404,
					"content": "На самом деле я всего лишь начинающий вор и очень хочу стать одним из Похитителей сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050405
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050405,
					"content": "Начинающий вор?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050406,
					"content": "Да... У меня совсем нет опыта, да ещё и один работаю... Похитители сокровищ для меня настоящие герои...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050407
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050407,
					"content": "Подожди...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050408,
					"content": "...Поэтому я придумал крутое задание, чтобы проявить себя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050409
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050409,
					"content": "Подожди! Я не понимаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050410,
					"content": "Паймон ожидала увидеть опытного поджигателя, настоящего злодея!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050411,
					"content": "Поджигателя? Почему поджигателя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050412
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050412,
					"content": "Прекрати притворяться! Ты прекрасно понимаешь, о чём я! Паймон видела, как ты смотрел на легковоспламеняющиеся строительные материалы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050413,
					"content": "Ах, вот ты о чём, я понял... Я просто изучал место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050414
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050414,
					"content": "Я не собирался ничего делать со строительными материалами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050415
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050415,
					"content": "Не собирался?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050416,
					"content": "Я только хотел стырить самый большой за последние 20 лет плаустрит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050417
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050417,
					"content": "Я планировал ночью спилить цепи, которые его держат. Камень полетел бы в сторону моря...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050418
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050418,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050419
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050419,
					"content": "Затем я бы как-нибудь спустил камень и спрятал бы его в небольшой бухте в Облачном море. Идеальное преступление!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050420
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050420,
					"content": "Я бы не назвала его идеальным... Как же ты собирался спустить плаустрит в воду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050421,
					"content": "Именно этот вопрос я и пытался решить, поэтому не начинал действовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050422
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050422,
					"content": "У этого парня точно не всё в порядке с головой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050423,
					"content": "#{NICKNAME}, настало время преподать ему урок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050424,
					"content": "Давай расскажем Защитнику Якса, что мы узнали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
