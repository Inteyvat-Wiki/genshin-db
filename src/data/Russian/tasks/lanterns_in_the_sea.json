			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400050201,
					"content": "Значит, вы, ребята, из Похитителей сокровищ, да? Кажется, я намекал в письме, чтобы вы, как я, пришли в костюмах, масках, и всё такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050202
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050202,
					"content": "...Но вы, друзья, пришли в своей обычной одежде. Да уж, хе-хе, это действительно... смело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050203
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050203,
					"content": "Хм! Знаешь что? Нам не нужно прятать лица за масками, потому что мы, в отличие от тебя, не планируем совершать ничего противозаконного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050204,
					"content": "Эй! Ты чего делаешь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050205,
						400050206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050205,
					"content": "Он правда просил надеть маску...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				},
				{
					"id": 400050207,
					"content": "Погодите-ка... Да никакие вы не Похитители сокровищ! Отвечайте, кто вы такие?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 400050206,
					"content": "А что? Выглядит довольно симпатично...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				}
			]
		},
		{
			"id": 4000504,
			"completionStepIds": [
				4000504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000504",
							"2"
						],
						"stepId": 4000504,
						"stateName": "QUEST_STATE_UNFINISHED"
