			"dialogs": [
				{
					"id": 400050501,
					"content": "Понятно. Человеческая глупость не знает границ. Но меня это нисколько не волнует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050502
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400050502,
					"content": "#Хорошо. Я на месте. Отсюда хорошо видно лунный фонарь. Зачем ты меня сюда позвал{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050503,
						400050504
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400050503,
					"content": "Из-за лунного фонаря.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				},
				{
					"id": 400050505,
					"content": "Ты один из героев Ли Юэ. Почему же ты не участвуешь в празднике?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050506,
					"content": "Я терпеть не могу толпу. Тем более толпу счастливых людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050507
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400050507,
					"content": "Я слишком долго страдал и убивал. Это всё, что я умею.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050508
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400050508,
					"content": "Я не хочу об этом говорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050509
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400050509,
					"content": "Пока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050510
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400050510,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050511
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400050511,
					"content": "Если у тебя возникнут трудности с демонами или духами, просто назови моё имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050512
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400050512,
					"content": "Я вижу каждый фонарь и слышу все просьбы о помощи. Неважно, от кого они исходят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050513
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400050513,
					"content": "Да... С Новым годом!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050514
					]
				},
				{
					"id": 400050514,
					"content": "С Новым годом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400050504,
					"content": "Из-за Праздника морских фонарей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				}
			]
		}
	]
}