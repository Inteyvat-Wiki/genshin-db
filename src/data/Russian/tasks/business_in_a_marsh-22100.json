				"points": []
			},
			"dialogs": [
				{
					"id": 221000201,
					"content": "#Как идут дела? Избавил{F#ась}{M#ся} от монстров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000202
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221000202,
					"content": "Пока ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000203
					]
				},
				{
					"id": 221000203,
					"content": "Ладно-ладно. Не спеши. Монстры держатся вдали и не представляют особой угрозы постояльцам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000204
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221000204,
					"content": "Но если кто-то из них заблудится и потревожит покой одного молодого джентльмена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000205
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221000205,
					"content": "Тростниковые острова охватит паника. Это негативно отразится на делах в гостинице.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				}
			]
		},
