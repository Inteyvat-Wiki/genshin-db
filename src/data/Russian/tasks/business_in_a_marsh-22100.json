			"dialogs": [
				{
					"id": 221000301,
					"content": "#Как идут дела? Избавил{F#ась}{M#ся} от монстров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000302
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221000302,
					"content": "Проблема решена.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000303
					]
				},
				{
					"id": 221000303,
					"content": "Отлично! Неплохо сработано!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000304
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221000304,
					"content": "Вот твоя награда, как я и обещал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000305
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221000305,
					"content": "Надеюсь, что монстры больше нас не потревожат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000306
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221000306,
					"content": "Интересно, кто же этот джентльмен? Нужно спросить у босса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
