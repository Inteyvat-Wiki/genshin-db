			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжи Хуа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400201,
					"content": "Кажется, я съел что-то несвежее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400202
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 413400202,
					"content": "#Я прин{F#есла}{M#ёс} лекарства от травника Гуя...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400203
					]
				},
				{
					"id": 413400203,
					"content": "Ой, спасибо! Это лекарства для желудка, которые я у него просил, да? Кажется, у меня несварение... Я будто камней с песком наелся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400204
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 413400204,
					"content": "Я шёл себе по улице, там перекусил, тут перекусил, и вдруг объелся, как разбойник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400205
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 413400205,
					"content": "Что ты такое съел?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400206
					]
				},
				{
					"id": 413400206,
					"content": "О, чего я только не ел! Жареный рис, рыбу, холодец, горы салатов... А ещё я потребил немного отличного вина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400207,
						413400208
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 413400207,
					"content": "Ну, тут нечему удивляться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				},
				{
					"id": 413400209,
					"content": "#Для этого лекарства и существуют, так? Ты сам{F#а} подумай, если вволю не есть и не пить, то зачем такой праздник?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400210
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 413400210,
					"content": "Спасибо тебе за лекарство. Мне наверняка стоит воспользоваться случаем и передохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 413400208,
					"content": "Не стоит во всём себе потакать. Даже если на дворе праздник.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				}
			]
		},
		{
			"id": 4134003,
			"completionStepIds": [
				4134004
			],
