			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Травник Гуй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400101,
					"content": "Прости, что беспокою тебя во время праздника. На каждый Праздник морских фонарей число больных резко увеличивается, и мы не справляемся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400102
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400102,
					"content": "Почему так происходит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400103
					]
				},
				{
					"id": 413400103,
					"content": "В это время все стремятся закончить всякую работу и провести время с семьёй. Ну, а там горы еды, вино рекою...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400104
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400104,
					"content": "Таким образом, случаев несварения не избежать, не говоря уже о других болезнях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400105
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400105,
					"content": "Я всегда всем советую не переедать, но кто сейчас меня послушает?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400106
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400106,
					"content": "Несколько человек только что попросили меня принести им лекарство от несварения и других желудочных болезней. Но я не могу просто так оставить хижину «Бубу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400107
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400107,
					"content": "#Путешественни{F#ца}{M#к}, не поможешь ли ты мне отнести лекарства?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Травник Гуй"
				}
			]
		},
		{
			"id": 4134002,
			"completionStepIds": [
				4134003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134003",
							"2"
						],
						"stepId": 4134003,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
