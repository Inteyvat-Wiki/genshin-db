			"dialogs": [
				{
					"id": 413400701,
					"content": "Здравствуй. Я своё желание уже написал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400702
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400702,
					"content": "Сейчас самое подходящее время... Давай запустим фонарик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400801
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400801,
					"content": "А желаю я... Чтобы болезни и беды обходили жителей Ли Юэ стороной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400802
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400802,
					"content": "Как же процветание хижины «Бубу»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400803
					]
				},
				{
					"id": 413400803,
					"content": "Ха-ха, это ведь моё личное желание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400804
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400804,
					"content": "Я составляю рецепты потому, что не хочу видеть причиняемые болезнями муки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400805
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400805,
					"content": "Как гласит пословица: «пусть лекарства вечно пылятся на своих полках».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400806
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400806,
					"content": "Ха-ха, а если все будут здоровыми, у меня появится много свободного времени, что тоже хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400807
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400807,
					"content": "Ай, совсем запамятовал! Есть ещё кое-кто, кому нужно доставить лекарство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400808
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400808,
					"content": "Прости, но мне пора! Счастливого Праздника морских фонарей тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Травник Гуй"
				}
			]
