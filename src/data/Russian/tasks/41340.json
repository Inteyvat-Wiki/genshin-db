			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гуань Хай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400301,
					"content": "Ой-ой-ой... Ух, ёлки... У тебя ко мне дело какое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400302
					],
					"speakerTitle": "Гуань Хай"
				},
				{
					"id": 413400302,
					"content": "#Я прин{F#есла}{M#ёс} лекарства от травника Гуя...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400303
					]
				},
				{
					"id": 413400303,
					"content": "О, о, спасибо! Именно то, что я заказывал... Очень своевременно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400304
					],
					"speakerTitle": "Гуань Хай"
				},
				{
					"id": 413400304,
					"content": "Ух, хорошо, когда под рукой лекарство. Должно быть, меня вчера продуло бризом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400305
					],
					"speakerTitle": "Гуань Хай"
				},
				{
					"id": 413400305,
					"content": "Разве у тебя не несварение?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400306
					]
				},
				{
					"id": 413400306,
					"content": "Чего? Не гони на мой желудок. Я в детстве заклёпку переварил. Ну а ранее я съел всего лишь три жареных рыбки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400307
					],
					"speakerTitle": "Гуань Хай"
				},
				{
					"id": 413400307,
					"content": "До сих пор ни один из моих друзей не может съесть и выпить больше меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400308
					],
					"speakerTitle": "Гуань Хай"
				},
				{
					"id": 413400308,
					"content": "Ладно, хорош болтать. Мне нужно поскорее принять лекарство. У меня впереди ещё вечер с выпивкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400309,
						413400310
					],
					"speakerTitle": "Гуань Хай"
				},
				{
					"id": 413400309,
					"content": "Просто позаботься о здоровье.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				},
				{
					"id": 413400311,
					"content": "Ха-ха-ха, что ты, я ещё не такой дряхлый!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400312
					],
					"speakerTitle": "Гуань Хай"
				},
				{
					"id": 413400312,
					"content": "Но, спасибо за заботу. Я буду относиться к этому вопросу внимательнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гуань Хай"
				},
				{
					"id": 413400310,
					"content": "Поздно будет пить минеральные воды, если откажут почки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				}
			]
		},
		{
			"id": 4134004,
