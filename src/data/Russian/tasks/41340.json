				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Травник Гуй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400401,
					"content": "Благодарю тебя за помощь. Все лекарства оказались у своих заказчиков?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400402,
						413400403
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400402,
					"content": "Что-то мне кажется, они будут наступать на свои грабли вновь и вновь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				},
				{
					"id": 413400404,
					"content": "С этим ничего не поделать. Если человек за собой не следит, от болезней желудка будет очень трудно избавиться. Нам только и остаётся, что выписывать при проявлении симптомов лекарства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400405
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400405,
					"content": "Но, наверное, сейчас я могу перевести дух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400406
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400406,
					"content": "А что насчёт небесных фонарей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400407
					]
				},
				{
					"id": 413400407,
					"content": "Мы... обычно их не запускаем. Их запускают, чтобы загадывать желания, но вот чего загадывать хижине «Бубу»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400408
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400408,
					"content": "Все коммерсанты желают своему делу процветания, но аптекарская хижина, которая должна лечить и спасать, такого пожелать не может.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400409,
						413400410
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400409,
					"content": "Добрый ты человек, Гуй.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400411,
					"content": "А вообще мне хотелось бы запустить фонарик. Праздник всё-таки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400412
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400412,
					"content": "Последние дни было много работы, и в сборке небесного фонаря я ничуть не продвинулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400413
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400413,
					"content": "Я могу заниматься им только в перерывах. Пока я его соберу, Праздник морских фонарей уже кончится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400414
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 413400414,
