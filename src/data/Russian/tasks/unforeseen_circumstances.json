			"dialogs": [
				{
					"id": 191211401,
					"content": "Вы спрашиваете меня, что может сделать Тома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211402
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 191211402,
					"content": "Он и так достаточно занят, вам не кажется? Я почти не вижу его здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211403
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 191211403,
					"content": "А когда я вижу его в комиссии Ясиро, он занят домашними делами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211404
					],
					"speakerTitle": "Такаси"
				},
				{
					"id": 191211404,
					"content": "Я думаю, он должен продолжать делать то, что делает. Каждый живёт по-своему, и Тома не исключение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Такаси"
				}
			]
		},
