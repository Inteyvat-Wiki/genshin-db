			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Климена"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440501,
					"content": "#Ты... {M#нашёл}{F#нашла} уздечку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440502
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440502,
					"content": "Можно... позволь мне взглянуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Климена"
				}
			]
		},
		{
			"id": 7224406,
			"completionStepIds": [
				7224415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224415",
							"2"
						],
						"stepId": 7224415,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Климена"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440601,
					"content": "Ах... Это она, Божественная уздечка. Та самая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440602
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440602,
					"content": "Я и не думала, что однажды увижу её вновь. Скажи, откуда у тебя это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440603
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440603,
					"content": "От Абэраку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440604
					]
				},
				{
					"id": 722440604,
					"content": "От самого Абэраку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440605
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440605,
					"content": "Как странно. Я ясно помню, что он был великим деятелем в те дни, когда наша страна только была основана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440606
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440606,
					"content": "Но сказали, что он планировал узурпировать трон Сына Солнца, и Абэраку обвинили в измене.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440607
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440607,
					"content": "Но ты говоришь, что он сам передал тебе Золотую уздечку. Возможно, здесь какая-то тайна, которой я не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440608
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440608,
					"content": "Судьба распорядилась так, что Золотая уздечка здесь... Ах, я помню лица тех детей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440609
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440609,
					"content": "Я смогу наконец искупить свои грехи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440610
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440610,
					"content": "#Путешественни{M#к}{F#ца}, брось Золотую уздечку в бассейн в Месте призыва душ. Мы наверняка сможем оживить их души с её помощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440611
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440611,
					"content": "Чтобы они стали целыми вновь и смогли отправиться в новое перерождение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Климена"
				}
			]
		},
		{
			"id": 7224411,
			"completionStepIds": [
				7224423
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224423",
							"2"
						],
						"stepId": 7224423,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722441101,
					"content": "Раз, два, три... Мы почтили все семь гробниц!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722441102,
					"content": "Вернёмся к святилищу и расскажем об этом духу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7224412,
			"completionStepIds": [
				7224425
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224425",
							"2"
						],
						"stepId": 7224425,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Климена"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722441201,
					"content": "Ах, Пирамумон. Ты так любил книги, говорил, что должен существовать мир за пределами наших знаний, хотя я тогда тебе не верила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441202
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441202,
					"content": "Я всегда улыбалась и качала головой, когда ты рассказывал мне о своих странных мыслях. Увы, увы! Я должна была поверить тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441203
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441203,
					"content": "Ты говорил, что однажды сбежишь из Дайнити Микоси и отправишься в дальние края...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441204
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441204,
					"content": "Иди, Пирамумон. Пусть никто не наденет на тебя снова оковы. Иди, будь свободен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441205
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441205,
					"content": "А ты, Орупэусу, Орупэусу. Что бы я отдала, чтобы снова услышать твоё пение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441206
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441206,
					"content": "Не было человека, который, услышав твой чистый, ясный голос, не захотел бы подпевать тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441207
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441207,
					"content": "В ночь перед Обрядом возвращения к солнцу тебе вдруг захотелось услышать мой голос, услышать, как я пою.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441208
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441208,
					"content": "Ты сказал, что как бы ужасно я ни пела, ты не будешь смеяться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441209
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441209,
					"content": "Ты знал, не так ли? Знал, что этот обряд будет твоим последним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441210
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441210,
					"content": "И всё же я... Я до конца...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441211
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441211,
					"content": "Климена?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441212
					]
				},
				{
					"id": 722441212,
					"content": "Я прошу прощения. Я утратила контроль над своими чувствами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441213
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441213,
					"content": "Домоправительница, служащая Сынам Солнца, обязана блюсти свою чистоту... Она не должна выходить замуж.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441214
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441214,
					"content": "У меня не было своих детей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441215
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441215,
					"content": "Эти дети, которым я служила и которые росли на моих глазах... В какой-то момент они стали мне ближе, чем могли бы быть родные дети.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441216
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441216,
					"content": "#Спасибо тебе, путешественни{M#к}{F#ца}. Спасибо, что {M#нашёл}{F#нашла} Золотую уздечку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441217
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441217,
					"content": "Она прошла через руки каждого Сына Солнца. Она впитала достаточно воспоминаний, чтобы заполнить недостающее в их душах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441218
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441218,
					"content": "Даже если эти воспоминания двусторонние.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441219,
						722441220
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441219,
					"content": "Двусторонние?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				},
				{
					"id": 722441221,
					"content": "Конечно. В этом случае воспоминания двойные. С одной стороны, у тебя есть твои собственные воспоминания, а с другой - воспоминания других людей о тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441222
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441222,
					"content": "Таким образом пробелы заполняются как собственными воспоминаниями Сынов Солнца, которые хранит уздечка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441223
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441223,
					"content": "Так и воспоминаниями о них как о детях, которых народ Бякуякоку порицает, о тех, кто стал детьми греха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441224
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441224,
					"content": "Моих собственных воспоминаний недостаточно, поэтому мне пришлось дополнить их воспоминаниями жителей нашей страны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441225
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441225,
					"content": "И именно благодаря этим проступкам, в которых они обвинены, они остались в памяти народа Бякуякоку и могут оставить своё призрачное существование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441226
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441226,
					"content": "#Спасибо, путешественни{M#к}{F#ца}. Теперь моё самое большое желание исполнилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441227
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441227,
					"content": "Наконец-то мне... легко и спокойно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441228
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441228,
					"content": "Да, я... наконец-то смогу снова быть с этими детьми...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Климена"
				},
				{
					"id": 722441220,
					"content": "У воспоминаний есть стороны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				}
			]
		},
