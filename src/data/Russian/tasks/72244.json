			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Климена"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440201,
					"content": "#Всего было семь Сынов Солнца. {M#Путешественник}{F#Путешественница}, пожалуйста, почти за меня их могилы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Климена"
				}
			]
		},
		{
			"id": 7224403,
			"completionStepIds": [
				7224410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224410",
							"2"
						],
						"stepId": 7224410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Климена"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440301,
					"content": "Семь Тёмных светил зажжены...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440302
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440302,
					"content": "Вы выполнили свою задачу. Я этого не забуду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440303
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440303,
					"content": "Теперь я открою для вас... путь к Месту вызова духов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440304
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440304,
					"content": "#Путешественни{F#ца}{M#к} из далёких земель, я знаю, что ты уже мне очень {M#помог}{F#помогла}... Но, пожалуйста, подари им покой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440305
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440305,
					"content": "Иди по этому пути. Я встречу тебя на другой стороне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Климена"
				}
			]
		},
		{
			"id": 7224404,
			"completionStepIds": [
				7224413
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224413",
							"2"
						],
						"stepId": 7224413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Климена"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440401,
					"content": "#Ты {M#пришёл}{F#пришла}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440402
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440402,
					"content": "Это Место призыва душ, и именно здесь мои последние мысли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440403
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440403,
					"content": "По достижении определённого возраста Сыны Солнца проходили церемонию и входили в Дайнити Микоси в день своего рождения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440404,
						722440405
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440404,
					"content": "Они входили туда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440406
					]
				},
				{
					"id": 722440406,
					"content": "Да, и эта церемония была известна как Обряд возвращения к солнцу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440407
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440407,
					"content": "Сыны Солнца рождаются из Дайнити Микоси и возвращаются туда же, прежде чем смертный мир сможет их запятнать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440408
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440408,
					"content": "Температура Дайнити Микоси такова, что его свет может согреть всю Бякуякоку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440409
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440409,
					"content": "От Сынов Солнца остались лишь обрывки душ, которые возвратились в Место вызова душ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440410
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440410,
					"content": "Но я всё ещё верю, что, возможно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440411
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440411,
					"content": "Возможно, что?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440412
					]
				},
				{
					"id": 722440412,
					"content": "Если я открою Место вызова душ, то своими воспоминаниями дополню то, что осталось от их душ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440426
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440426,
					"content": "Я попробую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440427
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440427,
					"content": "Пирамумон... Орупэусу... Я здесь. Вернитесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440428
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440429
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440429,
					"content": "Ну как?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440430
					]
				},
				{
					"id": 722440430,
					"content": "Эх... Из семи Сынов Солнца я сама растила Пирамумона и Орупэусу. Если даже они не вернутся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440413
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440413,
					"content": "Похоже, что одних моих воспоминаний недостаточно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440414
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440414,
					"content": "Если бы был какой-то предмет, хранящий отпечаток их душ... Если бы у меня была Золотая уздечка, знак власти Сынов Солнца, то она бы помогла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440415
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440415,
					"content": "Жаль, что уздечка давно утеряна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440416
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440416,
					"content": "Эх... Бякуякоку всё ещё ненавидит этих детей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440417
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440417,
					"content": "Возможно, моё желание освободить их души - несбыточная мечта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440418
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440418,
					"content": "...Но всё же, помоги в последний раз. Найди Божественную уздечку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440419
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440419,
					"content": "Я знаю, что шансы найти её весьма невелики, и, конечно, с моей стороны невежливо просить тебя опять об услуге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440420
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440420,
					"content": "Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440421,
						722440422
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440421,
					"content": "Я понимаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440423,
					"content": "Я... Спасибо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440424
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440424,
					"content": "Но уздечка потеряна очень давно. Не нужно спешить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440425
					],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440425,
					"content": "Если узнаешь что-то о ней, скажи мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Климена"
				},
				{
					"id": 722440422,
					"content": "Надеюсь на лучшее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440405,
					"content": "То есть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440426
					]
				}
			]
		},
		{
			"id": 7224405,
