			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арана",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730380201,
					"content": "Это араракалари Араны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380202
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380202,
					"content": "Она и есть моя подруга?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380203
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380203,
					"content": "#Ага. А теперь, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380204,
					"content": "(Использовать биджу.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7303803,
			"completionStepIds": [
				7303803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303803",
							"2"
						],
						"stepId": 7303803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рана",
					"Паймон",
					"Арана"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730380301,
					"content": "Хнык-хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380302
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380302,
					"content": "Проснулась?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380303,
						730380304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380303,
					"content": "Ты меня слышишь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380305
					]
				},
				{
					"id": 730380305,
					"content": "#Ого! Я опять заснула? Где это мы? {NICKNAME}, Паймон, как хорошо, что с вами всё в порядке! Я переживала, что Увядание вам навредит. А ещё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380306
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380306,
					"content": "Арана? Это ты?! Арана...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380307
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380307,
					"content": "#Приветствую тебя, {M#друг}{F#подруга} нара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380308
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380308,
					"content": "Я так долго тебя ждала... Мне снился очень длинный сон, в котором я встретила тебя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380309
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380309,
					"content": "Во сне я заблудилась в лесу и не могла отыскать ни дом, ни родителей. Я заплакала, а ты, заслышав мой плач, нашла меня и спела песню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380310
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380310,
					"content": "А потом мы стали лучшими друзьями и часто играли в лесу. Ты подарила мне цветок, научила многим интересным вещам и посвятила в тайны леса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380311
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380311,
					"content": "Например, что грибы-звёзды - это отражения небесных звёзд, упавших на землю. А ещё, если увидишь раскрывшийся лотос...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380312
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380312,
					"content": "Если увидишь раскрывшийся лотос, удача будет сопутствовать вплоть до следующего появления луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380313
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380313,
					"content": "Точно! А потом мне приснилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380314
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380314,
					"content": "Мне приснилось, будто я повзрослела и стала лесным стражем, опорой деревни Вимара. Но взрослые не верят в сказки о лесных духах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380315
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380315,
					"content": "Мне приснилось, будто я забыла о тебе. Я считала, что истории об аранарах - это всего лишь детские сказки, а лес - просто земля, поросшая деревьями, где нет места магии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380316
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380316,
					"content": "Проснувшись, я не на шутку испугалась. Что бы я делала, если бы забыла тебя... К счастью, это был всего лишь сон! Я безумно рада снова тебя видеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380317
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380317,
					"content": "Арана, где ты была?! Я ждала тебя целую вечность. Ждала, когда ты отведёшь меня в лес... волшебный лес, полный тайн...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380318
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380318,
					"content": "Прости. Я ничего не помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380319
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380319,
					"content": "Как?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380320
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380320,
					"content": "Эм... Рана, не обижайся на Арану. Дело в том, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380321,
					"content": "«...Когда мы тебя искали, встретили Арану. Она сказала...»",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730380322
					]
				},
				{
					"id": 730380322,
					"content": "Грибы леса Мотийимы, бой у Исхода дождя. Нутро голема руин, песня среди роз. Аранары, играющие братьев и сестёр, веселье Праздника Утсава...\\nВы не спеша рассказываете Ране и Аране о днях, проведённых с аранарами.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730380323
					]
				},
				{
					"id": 730380323,
					"content": "Оказывается, это я всё забыла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380324
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380324,
					"content": "Биджа - это плод воспоминаний... Паймон считает, что связанные с тобой воспоминания невероятно ценны для Араны. Возможно, именно это помогло тебе вспомнить прошлое при исцелении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380325,
					"content": "#Спасибо... {NICKNAME}, Паймон... Вы столько всего пережили, чтобы мне помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380326,
						730380328
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380326,
					"content": "Пожалуйста. Мы тоже почерпнули много нового из этого приключения.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380327
					]
				},
				{
					"id": 730380327,
					"content": "Точно! Кого тебе нужно благодарить, так это Арану и Араму...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380329,
					"content": "Спасибо... Прости меня, Арана...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380330
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380330,
					"content": "У-у-у... Как я могла о тебе забыть... Ты наверняка меня ненавидишь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380331
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380331,
					"content": "Не знаю. Я ничего не помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380332
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380332,
					"content": "Это не беда. Раз уж прежняя я отказалась от своих воспоминаний, значит, ты для меня намного важнее и ценнее, чем память о прошлом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380333
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380333,
					"content": "Хм... Паймон не знает, будут ли эти слова справедливы по отношению к Аране...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380334
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380334,
					"content": "#Араджа сказал, что аранары живут очень долго! Паймон думает, что вместе вы ещё сможете создать уйму драгоценных воспоминаний, как Паймон и {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380335
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380335,
					"content": "И то правда... У нас полным-полно времени, чтобы вместе исследовать просторы леса, мира и необъятность будущего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380336
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380336,
					"content": "Пока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380337
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380337,
					"content": "#Проблема с Мараной и зонами Увядания была практически полностью решена, пока я спала. Огромное вам спасибо, {NICKNAME}, Паймон и аранары...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380338
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380338,
					"content": "Пускай это прозвучит несколько импульсивно, но я хочу отправиться в путешествие с Араной. Вот только мне не даёт покоя, что ребятишки деревни Вимара могут снова оказаться в опасности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380339
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380339,
					"content": "Ой, Паймон забыла, что вопрос со злодеем так и не был решён...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380340
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380340,
					"content": "У меня есть кое-какие соображения на этот счёт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380341
					]
				},
				{
					"id": 730380341,
					"content": "Что? Кто? Почему Паймон ничего об этом не знает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380342
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380342,
					"content": "Правда?! Кто это сделал? Хочу устроить им хорошую взбучку напоследок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380343,
						730380344
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380343,
					"content": "Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380345
					]
				},
				{
					"id": 730380345,
					"content": "Вот как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380346
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380346,
					"content": "#Я верю тебе, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380347
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380347,
					"content": "Может, это прозвучит странно... но мне кажется, что злодей принёс что-то кроме неприятностей. Если бы дети не потерялись, я бы не усилила Лесной дозор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380348
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380348,
					"content": "А если бы я не усилила дозор, то в нужное время и в нужном месте не столкнулась бы с плесенником и не встретила бы тебя и Паймон, две добрые души, которые не прошли мимо нуждающегося в помощи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380349
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380349,
					"content": "#Так я и познакомилась с вами, {NICKNAME} и Паймон. Я вам многим обязана, вы спасли меня и помогли воссоединиться с дорогим другом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380350
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380350,
					"content": "#Спасибо, {NICKNAME}. Спасибо, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380351
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380351,
					"content": "Ерунда, Рана! Но если ты уйдёшь, Иотам, Кавус и Судабе будут сильно тосковать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380352
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380352,
					"content": "#Они сильнее, чем кажутся. К тому же они знакомы с {M#путешественником}{F#путешественницей}. Да и кто сказал, что я не вернусь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380353
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380353,
					"content": "#Я обязательно вернусь, расскажу им уйму историй и познакомлю с Араной так же, как познакомила их с тобой, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380354
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380354,
					"content": "Вот и славно. Паймон было показалось, что ты не вернёшься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380355
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380355,
					"content": "Арана, хочешь отправиться со мной в путешествие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380356
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380356,
					"content": "Хочу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380357
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380357,
					"content": "Ты столько забыл ради меня. Но мы последуем совету Паймон и вместе создадим множество новых воспоминаний, заполнив пустоту в твоём сердце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380358
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380358,
					"content": "Меня зовут Рана. Хочешь стать моим другом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380359
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380359,
					"content": "Да. Нара Рана, мы были хорошими друзьями прежде и останемся ими в будущем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380360
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380360,
					"content": "Хм, как странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380361
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380361,
					"content": "Из груди Раны исходит тёплый, прозрачный, но в то же время яркий свет, похожий на сердцебиение.\\nОна пытается прикрыть и прощупать его руками, но свет словно нарочно вонзился ей в ладони.\\nКогда этот свет погас, в её руках появилось изящное украшение.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730380362
					]
				},
				{
					"id": 730380362,
					"content": "Глаз Бога.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380363
					]
				},
				{
					"id": 730380363,
					"content": "Паймон впервые видит такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380364
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380364,
					"content": "Похоже, Архонты исполнили моё желание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380365
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380365,
					"content": "#Теперь нам не о чем беспокоиться в путешествии! Даже зона Увядания мне не страшна. Надеюсь, я буду сражаться так же ловко, как и ты, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380366
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380366,
					"content": "Ещё столько всего нужно сделать, со всеми поздороваться. И не забыть сказать Тигнари о путешествии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380367
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380367,
					"content": "#Спасибо, Паймон и Арана. Спасибо тебе, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380368
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380368,
					"content": "#Спасибо вам, Паймон и {M#золотой}{F#золотая} нара {NICKNAME}. Я потеряла память, но знаю, что вы хорошие нары. Вы помогли мне встретиться с нарой Раной. Я очень рада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380369,
						730380372
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380369,
					"content": "Были рады знакомству.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380370,
						730380371
					]
				},
				{
					"id": 730380370,
					"content": "Береги себя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380373,
					"content": "Рана, Арана... Паймон желает вам доброго пути. Не забывайте нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380374
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380374,
					"content": "«Не пасуй перед проливным дождём, не бойся зимней стужи, не поддавайся летнему зною...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380375
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380375,
					"content": "#Я уже слышала это. {NICKNAME}, Паймон, я уверена, мы встретимся ещё раз, к тому времени я стану намного сильнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380376
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730380376,
					"content": "Мы обязательно ещё встретимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380371,
					"content": "Надеюсь, твоё путешествие будет очень насыщенным.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380372,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380344,
					"content": "Пока у меня нет веских доказательств...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380345
					]
				},
				{
					"id": 730380328,
					"content": "Поблагодари лучше Арану и Араму.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380329
					]
				},
				{
					"id": 730380304,
					"content": "Похоже, всё в порядке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380305
					]
				}
			]
		}
	]
}