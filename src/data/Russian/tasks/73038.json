	"talks": [
		{
			"id": 7303801,
			"completionStepIds": [
				7303801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303801",
							"2"
						],
						"stepId": 7303801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арана",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730380101,
					"content": "#Ашваттха... Странно. Откуда она здесь? {M#Золотой}{F#Золотая} нара и белая леталка... Арана вас не знает, но вы кажетесь знакомыми. Кто вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380102
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380102,
					"content": "Арана действительно всё забыла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380103,
					"content": "#Паймон зовут Паймон, а {M#его}{F#её} - {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380104,
					"content": "Мы друзья Араны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380105
					]
				},
				{
					"id": 730380105,
					"content": "Я вам верю. Вы не похожи на злодеев...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380106
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380106,
					"content": "Арана всё поняла. Похоже, в моём сердце образовалась дыра, и его покинули все важные воспоминания. Но при взгляде на вас и Ашваттху мне многое открылось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380107
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380107,
					"content": "Это биджа? Я хотела помочь подруге и отдала свои воспоминания, чтобы Ашваттха принесла плод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380108
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380108,
					"content": "Арана, ты молодец! А ты помнишь, что произошло с подругой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380109,
					"content": "Не помню, но это не имеет значения. Раз биджа у вас, значит, вы мои друзья, которым можно доверять, и вы нары, получившие одобрение Ашваттхи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380110
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380110,
					"content": "Прошу, передайте биджу моей подруге, ей нужна помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380111,
						730380113
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380111,
					"content": "Я понимаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380112
					]
				},
				{
					"id": 730380112,
					"content": "Арана, пойдём с нами! Твоя подруга наверняка захочет снова тебя увидеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380115
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380115,
					"content": "Нет, я не пойду. Арана лишилась воспоминаний. Если подруга поймёт, что Арана её забыла, то расстроится и решит, будто Арана не дорожит друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380116
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380116,
					"content": "Арана, подруга, которой ты хочешь помочь, очень славная... и к тому же она хорошая нара. Даже если ты её забыла, она всё равно снова захочет подружиться с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380117,
					"content": "Так что давай пойдём вместе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730380118,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380119
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380119,
					"content": "Хорошо, я вам верю, вы мои друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арана"
				},
				{
					"id": 730380113,
					"content": "Пойдём с нами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380114
					]
				}
			]
		},
		{
			"id": 7303802,
			"completionStepIds": [
				7303802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
