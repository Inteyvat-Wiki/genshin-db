				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110101,
					"content": "#К звёздам и к безднам! Чем могу помочь, путешественни{F#ца}{M#к}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110102,
						20110103
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 20110102,
					"content": "О путешествии в Инадзуму...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				},
				{
					"id": 20110104,
					"content": "#Ах да, я слышала, что ты уже {M#договорился}{F#договорилась} с капитаном Южного Креста, и они отвезут тебя в Инадзуму. Верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110105
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 20110105,
					"content": "На самом деле я так давно не была в тех краях. У меня нет никаких полезных сведений для тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110106
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 20110106,
					"content": "#Вот ты где! Ты путешественни{F#ца}{M#к}, {M#которого}{F#которую} Бэй Доу повезёт в Инадзуму, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110107,
						20110109
					],
					"speakerTitle": "Хай Лун"
				},
				{
					"id": 20110107,
					"content": "Я весь день тебя жду!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110108
					]
				},
				{
					"id": 20110108,
					"content": "Ой, да? Хе-хе... Большая честь встретиться с тобой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110110
					],
					"speakerTitle": "Хай Лун"
				},
				{
					"id": 20110110,
					"content": "Мы заканчиваем пополнять припасы. Как только команда будет в сборе, можно отправляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110111
					],
					"speakerTitle": "Хай Лун"
				},
				{
					"id": 20110111,
					"content": "Капитан Бэй Доу послала меня за тобой. Отчаливаем сразу, как ты поднимешься на борт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110112
					],
					"speakerTitle": "Хай Лун"
				},
				{
					"id": 20110112,
					"content": "А Бэй Доу держит своё слово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20110113,
					"content": "Конечно! Капитан очень принципиальна во многих отношениях. Вы и сами в этом скоро убедитесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110114
					],
					"speakerTitle": "Хай Лун"
				},
				{
					"id": 20110114,
					"content": "Так вы отправляетесь? Тогда можно вас поздравить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110115
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 20110115,
					"content": "Куда бы не завело вас путешествие, к звёздным высотам или в глубины бездны, каждый шаг - новое достижение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110116
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 20110116,
					"content": "До скорой встречи! Попутного ветра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110117,
						20110118
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 20110117,
					"content": "Катерина...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110119,
					"content": "Ох... Так не хочется расставаться... Мы ведь каждый день почти видимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20110120,
					"content": "Хе-хе, ну тогда по прибытии сразу отыщите меня. Я буду ждать вас на острове Наруками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110121,
						20110122
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 20110121,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110123,
					"content": "Так в Инадзуме тоже есть Катерина! Ну тогда нечего сопли распускать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20110124,
					"content": "Ха-ха. Думаю, вам пора прощаться с Ли Юэ. Я своё дело сделал, и мне пора обратно. Корабль стоит на якоре рядом с каменным лесом Гуюнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110125
					],
					"speakerTitle": "Хай Лун"
				},
				{
					"id": 20110125,
					"content": "Хорошо. Спасибо, что такой путь проделал ради нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20110126,
					"content": "Просто выполняю приказы. Увидимся на Алькоре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хай Лун"
				},
				{
					"id": 20110122,
					"content": "#...Я так и знал{F#а}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110118,
					"content": "Мы будем по тебе скучать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110109,
					"content": "Вот и наши сведения.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110110
					]
				},
				{
					"id": 20110103,
					"content": "О флоте Южного Креста...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				}
			]
		},
		{
			"id": 201103,
			"completionStepIds": [
				201103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201103",
							"2"
						],
						"stepId": 201103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бэй Доу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110301,
					"content": "А, вы наконец пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110302
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110302,
					"content": "Все эти годы, хоть в бури, хоть в ливни, флот Южного Креста всегда отправлялся вовремя. Другой бы уже любовался удаляющимися парусами с берега.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110303,
						20110304
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110303,
					"content": "Прошу прощения, капитан!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				},
				{
					"id": 20110305,
					"content": "Ха-ха-ха, не напрягайся, я пошутила. Вы как раз вовремя, команда только что закончила последние приготовления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110306
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110306,
					"content": "Ну, раз все в сборе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110307
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110307,
					"content": "Мы отправляемся в страну, окружённую грозами и штормами... Страну «вечности»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110308
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110308,
					"content": "Поднять якорь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20110304,
					"content": "Для меня большая честь быть на борту!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				}
			]
		},
		{
			"id": 201107,
			"completionStepIds": [
				201107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201107",
							"2"
						],
						"stepId": 201107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тома"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110701,
					"content": "Ну наконец-то вы доплыли. Я вас уже заждался, капитан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110702
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20110702,
					"content": "И у нас тут пара зайцев... кхм, дорогих гостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110703
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20110703,
					"content": "Пф!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20110704,
					"content": "Это всё из-за вашего всемогущего сёгуна. Штормы вокруг Инадзумы усилились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110705
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110705,
					"content": "Прорваться-то мы прорвались, но задержались из-за погоды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110706
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110706,
					"content": "Давайте я вас представлю. Это Тома, торговый партнёр, с которым я недавно познакомилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110707
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110707,
					"content": "Хех, а вас я уже давно жду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110708
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20110708,
					"content": "Тома, эти двое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110709
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110709,
					"content": "Уже наслышан, ведь слава бежит впереди них. Даже штормам не заглушить слухи об их подвигах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110710,
						20110711
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20110710,
					"content": "Приятно познакомиться, Тома.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110712
					]
				},
				{
					"id": 20110712,
					"content": "Хе-хе, как приятно слышать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110713
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20110713,
					"content": "Ха, вот и славненько.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110714
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110714,
					"content": "#{NICKNAME}, Тома давно уже на Рито крутится. Можно сказать, что он местный авторитет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110715
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110715,
					"content": "По любым вопросам обращайтесь к Томе. Но если он попытается вас дурить, то будет иметь дело со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110716
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110716,
					"content": "Хе-хе-хе... Не волнуйтесь. Я уверен, что мы отлично поладим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110717
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20110717,
					"content": "Хорошо. Если всё в порядке, то мне пора. Не хочу, чтобы меня тут застукали - у нас на корабле ещё разыскиваемый преступник прячется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110718
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110718,
					"content": "А, точно, Кадзуха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110719
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20110719,
					"content": "#До встречи, путешественни{F#ца}{M#к}. Помни, с какими «штормами» тебе ни пришлось бы столкнуться, борись до конца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110720,
						20110721
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20110720,
					"content": "Мы справимся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110722
					]
				},
				{
					"id": 20110722,
					"content": "Попутного ветра, капитан Бэй Доу! Пока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110723
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20110723,
