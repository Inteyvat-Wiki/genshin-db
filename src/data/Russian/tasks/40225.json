					}
				]
			},
			"dialogs": [
				{
					"id": 402250101,
					"content": "Это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402250102,
					"content": "«Алькор»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250103
					]
				},
				{
					"id": 402250103,
					"content": "Это второй корабль флота. «Алькор» патрулирует у каменного леса Гуюнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250104
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 402250104,
					"content": "Бэй Доу! Прославленный капитан наёмников, бороздящий морские просторы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402250105,
					"content": "Ха-ха, мы же не впервые встречаемся. К чему все эти церемонии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250106
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 402250106,
					"content": "Долгая история...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402250107,
					"content": "Не стойте столбом, садитесь, поговорим. Я скажу ребятам, чтобы они проявили гостеприимство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250108
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 402250108,
					"content": "#Вот оно что, не ожидала, что ты знаком{F#а} с хозяйкой Куратория тайн. У тебя действительно обширные связи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250109
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 402250109,
					"content": "Хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402250110,
					"content": "Кстати, насчёт регистрации...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250111
					]
				},
				{
					"id": 402250111,
					"content": "Паймон чуть не забыла! Нужно зарегистрировать всех участников выставки. И товары, которые ты планируешь продавать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402250112,
					"content": "Что касается участников выставки, запиши меня и нескольких моих ребят. Остальные останутся на корабле. А насчёт товаров... Вот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250113
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 402250113,
					"content": "Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402250114,
					"content": "Давным-давно Нин Гуан занялась модернизацией баллисты Гуй Чжун. Красавица, которую вы видите здесь, - одна из новых усовершенствованных моделей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250115
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 402250115,
					"content": "Она обладает невероятной огневой мощью и оснащена системой дистанционного управления, что позволяет наносить точные удары даже на больших расстояниях. Уверена, от желающих её приобрести отбоя не будет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250116
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 402250116,
					"content": "Ты уверена, что такие вещи можно продавать?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402250117,
					"content": "Ха-ха, не волнуйся, новейшее снаряжение, которым сейчас вооружены Миллелиты, куда современнее этого. Эту можно считать антиквариатом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250118
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 402250118,
					"content": "...Ладно, как и говорила Нефер, здесь можно торговать чем угодно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402250119,
					"content": "Но кто вообще это купит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250120
					]
				},
				{
					"id": 402250120,
					"content": "Я уверена, желающие найдутся. На Торговую выставку Нод-Края съезжаются покупатели со всего Тейвата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250121
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 402250121,
					"content": "Е Лань?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402250122,
					"content": "Прошу прощения. Виновата, была занята разгрузкой и забыла сказать, что Е Лань тоже на борту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250123
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 402250123,
					"content": "Ничего страшного! Кстати, Е Лань, ты тоже участвуешь в выставке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402250124,
					"content": "Нет, я здесь по работе. Капитан Бэй Доу любезно предложила меня подвезти, так что регистрировать меня не нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250125
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 402250125,
					"content": "#Давненько не виделись, {NICKNAME}. Если будет возможность, передай от меня привет хозяйке Куратория тайн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250126
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 402250126,
					"content": "Что планируешь делать на этот раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250127
					]
				},
				{
					"id": 402250127,
					"content": "Не могу вдаваться в подробности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250128
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 402250128,
					"content": "Это означает, что нам пора перестать задавать вопросы, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402250129,
					"content": "Именно так.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250130
					]
				},
				{
					"id": 402250130,
					"content": "Мне пора. Когда закончу с делами, угощу вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250131
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 402250131,
					"content": "Ха-ха, не терпится попробовать Нод-Край на вкус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250132
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 402250132,
					"content": "Вы зарегистрированы. Идём, мы проводим на выставку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
