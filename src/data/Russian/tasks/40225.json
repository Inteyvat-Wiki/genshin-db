			"dialogs": [
				{
					"id": 402250201,
					"content": "Бэй Доу приказывает команде разгрузить товары и следует за вами на выставку.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "Мы пришли? Отличное место!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 402250203,
					"content": "#{NICKNAME}, как будешь {F#свободна}{M#свободен}, помоги мне протестировать дальнее наведение. Это очень увлекательно, тебе точно понравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бэй Доу"
				}
			]
		}
