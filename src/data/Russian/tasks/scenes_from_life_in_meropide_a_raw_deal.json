					}
				]
			},
			"dialogs": [
				{
					"id": 740610401,
					"content": "Эй, постойте! Фух... Догнал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610402
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740610402,
					"content": "Почему ты так запыхался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740610403,
					"content": "Я только закончил с работой на заброшенном производственном участке и сразу побежал сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610404
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740610404,
					"content": "Ну как? Вы отправили письмо? Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610405,
						740610406
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740610405,
					"content": "Письмо подписано именем «Белый Ландыш».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610407
					]
				},
				{
					"id": 740610407,
					"content": "Хм, вот как она себя назвала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610408
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740610408,
					"content": "Хорошо. По правде сказать, одна девушка попросила меня отправить за неё это письмо. Она выглядела нездорово, поэтому я согласился, и даже ни одной моры не взял! Я плачу тебе из собственного кармана...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610409
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740610409,
					"content": "А?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610410,
						740610411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740610410,
					"content": "Судя по содержимому письма, она и правда больна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610412
					]
				},
				{
					"id": 740610412,
					"content": "Я, наверное, взял не то письмо, когда уходил. Плохо, так я не успею ко дню рождения сына...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610413
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740610413,
					"content": "А? Ты взял не то письмо? Правду говорят, что Декабрэ совсем не везёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740610414,
					"content": "Может, такова моя судьба. Эх, нет времени на разговоры. Нужно спешить за письмом. Вдруг я ещё успею.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610415
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740610415,
					"content": "Вот ваша награда, спасибо за помощь. Мне нужно отправить письмо сыну. Ещё увидимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610416
					],
					"speakerTitle": "Декабрэ"
				},
				{
					"id": 740610416,
					"content": "Он так быстро убежал, а у Паймон к нему куча вопросов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740610417,
					"content": "Ладно, главное, что мы получили свои купоны. А?! Почему так мало? Этого не хватит на еду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610418,
						740610420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740610418,
					"content": "Видимо, сегодня придётся голодать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610419
					]
				},
				{
					"id": 740610419,
					"content": "Паймон не хочет, она ужасно проголодалась. У-у!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740610420,
					"content": "Мы можем взять ещё одно поручение на стояние в очереди.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610421
					]
				},
				{
					"id": 740610421,
					"content": "Нет уж, лучше голодать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740610411,
					"content": "В самом деле?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610412
					]
				},
				{
					"id": 740610406,
					"content": "Ты и есть Белый Ландыш?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610407
					]
				}
			]
		}
