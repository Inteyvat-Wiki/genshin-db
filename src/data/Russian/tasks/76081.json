						],
						"pointId": 13989
					}
				]
			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "Приятно было сразиться с вами, господин Сигурд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760810202,
					"content": "Жаль, что герой заканчивает свою жизнь так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760810203,
					"content": "Странствуя в одиночестве по земле, которой ты посвятил себя и за которую умер... предвидел ли ты этот день, когда давал клятву светоносца?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760810204,
					"content": "Даже если так, возможно, всё равно были сомнения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760810205,
					"content": "Я ещё приду к вам в гости. До свидания, господин Сигурд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флинс"
				}
			]
		},
		{
			"id": 7608103,
