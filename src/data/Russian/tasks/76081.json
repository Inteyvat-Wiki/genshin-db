						],
						"pointId": 13645
					}
				]
			},
			"dialogs": [
				{
					"id": 760810301,
					"content": "Господин Сигурд, вы мой спаситель! Если бы вы не повели Светоносцев против врага на юг, меня бы, наверное, уже не было в живых и кто знает, где бы покоились мои кости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810302
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760810302,
					"content": "Но почему же ваша душа не обрела покой и до сих пор скитается, продолжая сражаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810303
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760810303,
					"content": "Из-за скверны Дикой Охоты даже ваш облик раздроблен на части... Неужели вы так и не покинули то поле битвы? Для вас война ещё не закончилась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810304
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760810304,
					"content": "В этом, возможно, мы даже похожи. Истинный покой придёт только тогда, когда Дикая Охота полностью исчезнет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810305
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760810305,
					"content": "Для меня большая честь встретиться с вами, господин Сигурд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810306
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760810306,
					"content": "Я знаю, для Светоносцев лучший способ общения - это скрестить клинки в дружеском поединке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810307
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760810307,
					"content": "Позвольте же показать вам доблесть нового поколения Светоносцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иллуги"
				}
			]
		},
