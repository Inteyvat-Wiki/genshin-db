					}
				]
			},
			"dialogs": [
				{
					"id": 760810401,
					"content": "Благодарю за поединок, господин Сигурд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760810402,
					"content": "Не волнуйтесь, после вашей жертвы старик Никита стал новым Старшиной и возглавил восстановление легиона Светоносцев вместе с теми, кого вы спасли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760810403,
					"content": "И теперь наших сил достаточно, чтобы защитить эти земли даже от Дикой Охоты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760810404,
					"content": "Ваши жертвы не были напрасными, ваши подвиги и ваша воля не были и не будут забыты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760810405,
					"content": "Прощайте, господин Сигурд. Я буду навещать вас. Да обретёт ваша душа покой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иллуги"
				}
			]
		},
		{
			"id": 7608199,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760819901,
					"content": "Его метод борьбы с монстрами... Нет, этой легендарной личности суждено было умереть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819902
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760819902,
					"content": "Может, он каким-то образом снова проснулся? Хм... Если будет минутка, сходи на пляж к северо-востоку от Мшистых пустошей. Там его могила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819903
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760819903,
					"content": "Я слышал от старика истории о легендарном Старшине Сигурде, с которым он сражался бок о бок в прошлом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819904
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760819904,
					"content": "Фиолетовое сияние меча, золотые волосы... всё как в легенде. Неужели тот человек, что встретился мне недавно, - это он?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819905
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760819905,
					"content": "Его могила находится на берегу к северо-востоку от Мшистых пустошей. При случае стоит туда наведаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иллуги"
				}
			]
		}
	]
}