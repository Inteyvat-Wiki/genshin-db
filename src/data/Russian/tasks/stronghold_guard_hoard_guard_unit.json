			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Синяя Молния",
					"Росток"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766800101,
					"content": "#О, {NICKNAME} и Паймон, привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800102
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800102,
					"content": "Раз уж мы встретились, не хотите взглянуть на моего хорька? Его зовут Росток, он прелесть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800103
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800103,
					"content": "...Мяу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800104
					],
					"speakerTitle": "Росток"
				},
				{
					"id": 766800104,
					"content": "Эй-эй-эй, Росток, не говори так! Они, похоже, не понимают язык Ашру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800105
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800105,
					"content": "...Гурр?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800106
					],
					"speakerTitle": "Росток"
				},
				{
					"id": 766800106,
					"content": "И на языке зябликов тоже не надо. Госпожа Басима уже вернулась в Сумеру на отдых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800107
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800107,
					"content": "Простите, мой Росток слишком много общался с разными животными и слегка запутался... Временно дезориентирован, хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800108
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800108,
					"content": "Пусть пока отдохнёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800109,
						766800110
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800109,
					"content": "Ты тоже эксперт по животным?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800111
					]
				},
				{
					"id": 766800111,
					"content": "Хм... А почему Паймон чувствует, что ты разговариваешь с нами, будто мы давние друзья? Ты что, следила за нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766800112,
					"content": "Спокойно, спокойно, я своя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800113
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800113,
					"content": "Я работаю на госпожу Е Лань, а вы - её самые почётные гости. Думаю, не нужно объяснять, на чьей я стороне, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800114,
						766800115
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800114,
					"content": "Да, действительно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800116
					]
				},
				{
					"id": 766800116,
					"content": "Фух, так бы сразу и сказала! А то Паймон уже успела переволноваться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766800117,
					"content": "Кстати, что ты делаешь с Ростком в этой глуши?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766800118,
					"content": "Стоим на посту... Вернее, я проверяю, насколько хорошо справляется мой «легион по охране припасов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800119,
						766800120
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800119,
					"content": "Припасов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800121
					]
				},
				{
					"id": 766800121,
					"content": "Раз уж мы свои, думаю, можно вам довериться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800122
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800122,
					"content": "Здесь, неподалёку, у меня под землёй спрятан тайный склад. Но в последнее время его то и дело обчищают разные монстры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800123
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800123,
					"content": "Так что я раскошелилась и заказала у вундеркинда-механика из мастерской «Дзынь-Клац» собственную охранную систему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800124
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800124,
					"content": "Кхм, если точнее - целый комплекс безопасности. Он сам выбирает точки размещения, а его функции можно комбинировать самыми разными способами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800125
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800125,
					"content": "Мастер-механик как раз собиралась везти свои творения на выставку, так что мне повезло урвать этот «прототип» для испытаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800126
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800126,
					"content": "Я выстроила вокруг склада многоуровневую оборону... и теперь заманиваю «гостей» - то есть монстров - в ловушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800127
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800127,
					"content": "Так я и проверю эффективность разных конфигураций защиты, и соберу данные для мастера - два дела разом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800128,
						766800129
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800128,
					"content": "Заполучила творение Айно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800130
					]
				},
				{
					"id": 766800130,
					"content": "Хочешь испытать? Я уже отбила с их помощью не одну атаку - очень даже снимает стресс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800131
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800131,
					"content": "Давайте, попробуйте! Заодно посмотрю, как вы действуете. Вдруг почерпну что-то новое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800132
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800132,
					"content": "И, конечно, оплата будет щедрой. Своим друзьям я заплачу минимум вдвое больше, чем обычному консультанту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800133,
						766800134
					],
					"speakerTitle": "Синяя Молния"
				},
				{
					"id": 766800133,
					"content": "Конечно! Своим надо платить больше!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800135
					]
				},
				{
					"id": 766800135,
					"content": "Конечно! Ты ведь помогаешь Е Лань. Все в выигрыше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766800136,
					"content": "Мы готовы! Особенно если учесть, что помочь тебе - значит косвенно помочь Е Лань, а это всем на пользу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766800134,
					"content": "Хех, неловко как-то.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800135
					]
				},
				{
					"id": 766800129,
					"content": "Звучит довольно занятно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800130
					]
				},
				{
					"id": 766800120,
					"content": "Легион по охране?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800121
					]
				},
				{
					"id": 766800115,
					"content": "Друзья Е Лань - наши друзья.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800116
					]
				},
				{
					"id": 766800110,
					"content": "Ты тоже друг животных?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800111
					]
				}
			]
		}
	]
}