				"points": []
			},
			"dialogs": [
				{
					"id": 726530101,
					"content": "#Путешественни{F#ца}{M#к}, ты {F#вернулась}{M#вернулся}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530102
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726530102,
					"content": "#Я осмотрела кристаллы, которые ты {F#принесла}{M#принёс} ранее. Они кажутся довольно... «молодыми».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530103
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726530103,
					"content": "То есть, они образовались в результате относительно недавней кристаллизации элементов... Проводя параллель, я сказала бы, что они напоминают свежие, чуть более глубокие следы на снегу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530104
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726530104,
					"content": "Так что на этот раз я попрошу тебя поискать «следы», которые еще менее «глубоки»... И пройти по ним до самого их источника!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530105
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726530105,
					"content": "«Неглубокими следами» в данном случае я называю залежи элемента Электро, сконцентрированные у поверхности земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530106
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726530106,
					"content": "Если нам удастся собрать достаточно таких образцов для сравнения, мы сможем составить общую карту маршрута.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530107
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726530107,
					"content": "Глубокие и неглубокие следы... карты маршрутов... Паймон понятия не имеет, о чём идёт речь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726530108,
					"content": "Хм... Как-то всё сложно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726530109
					]
				},
				{
					"id": 726530109,
					"content": "Что ж, пожалуй, аналогия получилась не очень. Но, думаю, ты прекрасно во всём разберёшься, как только окажешься на месте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530110
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726530110,
					"content": "Ладно, довольно бесполезной болтовни. Пора выдвигаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Му Чжэнь"
				}
			]
		}
	]
