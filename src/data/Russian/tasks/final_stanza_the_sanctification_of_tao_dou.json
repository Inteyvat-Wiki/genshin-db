					"Сяо",
					"Е Лань"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							874.587,
							265.046,
							326.911
						],
						"pointId": 10622
					}
				]
			},
			"dialogs": [
				{
					"id": 401870401,
					"content": "#Тебе стоило пойти с {F#путешественницей}{M#путешественником} к грани в тот день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870402
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 401870402,
					"content": "#Я понимаю, что ты заботишься о благополучии {F#путешественницы}{M#путешественника}. Но факт остаётся фактом. Это бы ничем не помогло. Если бы что-то пошло не так, я бы только мешала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870403
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 401870403,
					"content": "К тому же Нин Гуан изменила план и отправила меня в Разлом. Я не могу быть в двух местах одновременно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870404
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 401870404,
					"content": "Если тебя это не устраивает, почему бы тебе не подать жалобу на террасу Юйцзин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870405
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 401870405,
					"content": "Хм... пожаловаться Воле Небес на Волю Небес?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870406
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 401870406,
					"content": "Вообще-то я имела в виду Нефритовое Равновесие. Она не боится конфронтаций.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870407
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 401870407,
					"content": "...Забудь. Главное, что всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870408
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 401870408,
					"content": "Хех. Постоялый двор «Ваншу» - прекрасное место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870409
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 401870409,
					"content": "Как и весь Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870410
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 401870410,
					"content": "Ха-ха, хорошо сказано.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870411
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 401870411,
					"content": "Хозяин, ещё одну порцию «Креветок в росе» с пряным соусом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870412
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 401870412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870413
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 401870413,
					"content": "...И миндальный тофу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Е Лань"
				}
			]
		},
		{
			"id": 4018705,
			"completionStepIds": [
				4018706
			],
