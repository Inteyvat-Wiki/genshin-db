					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бэй Доу",
					"Нин Гуан"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-647.266,
							258.226,
							428.226
						],
						"pointId": 10623
					}
				]
			},
			"dialogs": [
				{
					"id": 401870501,
					"content": "Бедствие миновало. Почему тогда у тебя такой угрюмый вид, Воля Небес?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870502
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 401870502,
					"content": "#Благодаря госпоже Ху и {F#путешественнице}{M#путешественнику} катастрофы удалось избежать. Но мы всё ещё не знаем, что стало её причиной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870503
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 401870503,
					"content": "Капитан, ты, как всегда, хорошо осведомлена. Я доверяю твоей интуиции. Ты знаешь, что недавно в Натлане произошли важные события, связанные с артериями земли и вопросами жизни и смерти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870504
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 401870504,
					"content": "Заставляет задуматься, не связаны ли они каким-то образом на более глубоком уровне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870505
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 401870505,
					"content": "Если так, то это выходит за рамки Ли Юэ и Натлана. Я сообщу своим деловым партнёрам и буду следить за похожими случаями в других странах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870506
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 401870506,
					"content": "Но сейчас... предлагаю отложить тревоги и насладиться чудесным видом. Следующий раз такая возможность представится только через год.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870507
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 401870507,
					"content": "Хе-хе, разумеется. Тебе не нужно учить меня соблюдать баланс между работой и отдыхом, я ведь не Кэ Цин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870508
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 401870508,
					"content": "Тогда почему ты до сих пор носишь ту же старую шпильку? Я же говорила тебе, купи новую на мои деньги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870509
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 401870509,
					"content": "Я бы не посмела потратить мору капитана Бэй Доу без окончательного подтверждения. А вдруг ты шутишь? Я бы этого никогда не пережила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870510
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 401870510,
					"content": "Ха-ха, мне самой выбрать тебе новую? Хорошо, меня это устраивает. Пойдём прогуляемся по ярмарке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870511
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 401870511,
					"content": "Ну надо же... С каких это пор наша прямолинейная капитанша научилась читать между строк, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870512
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 401870512,
					"content": "Ха-ха, хватит! Ты идёшь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870513
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 401870513,
					"content": "Почему бы и нет? Пойдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нин Гуан"
				}
			]
		},
		{
			"id": 4018706,
			"completionStepIds": [
				4018707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4018707",
