			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кэ Цин",
					"Гань Юй"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-576.45,
							254.38,
							465.98
						],
						"pointId": 10624
					}
				]
			},
			"dialogs": [
				{
					"id": 401870601,
					"content": "Гань Юй, всё ещё работаешь? Тяжело тебе приходится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870602
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 401870602,
					"content": "#Хм? О, Кэ Цин... Нет, всё в порядке, ничего необычного. {NICKNAME} и госпожа Ху - настоящие звёзды этого года.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870603
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 401870603,
					"content": "Не повод недооценивать твой вклад. Конечно, они были главными героями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870604
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 401870604,
					"content": "Но мы тоже сыграли свою роль. И сделали всё хорошо. Департамент по делам граждан отреагировал с рекордной скоростью, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870605
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 401870605,
					"content": "Хотя на первый взгляд этот инцидент кажется незначительным в сравнении с бедствиями времён Войны Архонтов, опасность была большая. Если бы мы не нашли решение, последствия могли бы быть катастрофическими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870606
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 401870606,
					"content": "Ты права... На самом деле у меня есть вопрос о методе Семи-Восьми Врат, который мы использовали. Почему я никогда не видела никаких записей о нём в павильоне Лунного моря?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870607
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 401870607,
					"content": "О, ты хочешь узнать об истоках ритуала? Нин Гуан всё выдумала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870608
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 401870608,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870609
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 401870609,
					"content": "Ха-ха. Шучу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870610
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 401870610,
					"content": "По правде говоря, письмо со всей ключевой информацией внезапно появилось на террасе Юйцзин в тот день, когда нам это понадобилось. Даже Е Лань не смогла выяснить, откуда оно взялось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870611
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 401870611,
					"content": "Погоди... информация появилась из ниоткуда? Тогда... разве это не была рискованная стратегия со стороны Нин Гуан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870612
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 401870612,
					"content": "Может показаться, что так. Но если задуматься, всё становится на свои места...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870613
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 401870613,
					"content": "Сколько людей во всём Ли Юэ могут знать о беде и тайном искусстве, а также обладать способностью доставить письмо, не оставив следов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870614
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 401870614,
					"content": "Ах... Ты имеешь в виду... Наставницу и её друзей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870615
					],
					"speakerTitle": "Гань Юй"
				},
				{
					"id": 401870615,
					"content": "Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гань Юй"
				}
			]
		},
		{
