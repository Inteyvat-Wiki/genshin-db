				"points": []
			},
			"dialogs": [
				{
					"id": 230390101,
					"content": "#{M#Братец}{F#Сестрица}! Подожди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390102
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390102,
					"content": "#Можно спросить... ты искатель{F#ница} приключений? Ну, из тех, что побывали во многих местах и очень хорошо сражаются?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390103,
						230390104
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390103,
					"content": "Пожалуй.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				},
				{
					"id": 230390105,
					"content": "#Видишь, Хилми, я же говорил, что это точно искатель{F#ница} приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390106
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390106,
					"content": "А разве искатели приключений не носят всегда такую зелёную одежду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390107,
						230390108
					],
					"speakerTitle": "Хилми"
				},
				{
					"id": 230390107,
					"content": "Я не новичок, мне уже не нужно так одеваться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390109,
					"content": "Ух ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390110
					],
					"speakerTitle": "Хилми"
				},
				{
					"id": 230390110,
					"content": "Ух ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390111
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390111,
					"content": "#Тогда, {M#братец}{F#сестрица}, ты точно сможешь нам помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390112
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390112,
					"content": "Видишь здание деревенского склада? Дядя Хабачи говорит, что внутри хранятся очень важные вещи, которые нужно защищать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390113
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390113,
					"content": "Ещё он нам говорил, что если плохие люди нападут на деревню, первым делом он поднимет и отключит подъёмник, чтобы перекрыть путь по висячему мосту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390114
					],
					"speakerTitle": "Хилми"
				},
				{
					"id": 230390114,
					"content": "Но между складом и подъёмником приличное расстояние и, чтобы отключить подъёмник, Хабачи придётся бежать изо всех сил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390115
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390115,
					"content": "Вот мы и предложили ему потренироваться вместе, но он даже не стал с нами разговаривать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390116
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390116,
					"content": "Лучше б он не обращал на нас внимания, когда мы собираемся пускать по воде камешки, пф-ф...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390117
					],
					"speakerTitle": "Хилми"
				},
				{
					"id": 230390117,
					"content": "Короче! Если плохиши нападут на деревню, а Хабачи не сможет бежать, то подъёмник придётся отключать нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390118
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390118,
					"content": "#{M#Братишка}{F#Сестрёнка}, ты же {M#искатель}{F#искательница} приключений - наверняка отлично умеешь бегать. Можешь потренироваться вместе с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390119,
						230390121
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390119,
					"content": "Ладно, побегаю с вами немного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390120
					]
				},
				{
					"id": 230390120,
					"content": "#Здорово! Спасибо, {M#братец}{F#сестрица}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390126,
					"content": "#Мы уже выбрали место для старта. Пойдём туда, {M#братец}{F#сестрица}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390127
					],
					"speakerTitle": "Хилми"
				},
				{
					"id": 230390127,
					"content": "Хе-хе, в этот раз твоим противником буду я. Предупреждаю, я очень хорошо бегаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хилми"
				},
				{
					"id": 230390121,
					"content": "Последую примеру Хабачи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390122
					]
				},
				{
					"id": 230390122,
					"content": "Эх... Поиграй с нами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390123
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390123,
					"content": "#Потренируйся с нами, {M#братец}{F#сестрица}, ну пожа-а-алуйста!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390124
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390124,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390125
					]
				},
				{
					"id": 230390125,
					"content": "#Здорово! Спасибо, {M#братец}{F#сестрица}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Эбейд"
				},
				{
					"id": 230390108,
					"content": "#Ну, просто я особенн{F#ая}{M#ый}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390104,
					"content": "Можно сказать и так...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				}
			]
		},
