						730860202
					]
				},
				{
					"id": 730860202,
					"content": "В деревянном ящике можно много чего спрятать. Например... разные блестящие элементальные кристаллы. Вот только Арагита забыл, <color=#00E1FFFF>где спрятан блестящий Дендро кристалл</color>. Нара помнит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730860206
					],
					"speakerTitle": "Арагита"
				},
				{
					"id": 730860206,
					"content": "Давай начнём!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
