			},
			"dialogs": [
				{
					"id": 706560101,
					"content": "Привет! Пришли бросить вызов этому подземелью?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560102,
						706560103
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 706560102,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				},
				{
					"id": 706560104,
					"content": "Позвольте мне объяснить. Я Плауэн из Гильдии искателей приключений, и я отвечаю за охрану входа в это подземелье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560105
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 706560105,
					"content": "Согласно записям Гильдии искателей приключений, это подземелье появляется только в особых случаях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560106
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 706560106,
					"content": "Сейчас как раз проходит Праздник ветряных цветов, поэтому мы немного изменили интерьер, чтобы превратить его в уникальное испытание, прежде чем открывать его для публики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560107
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 706560107,
					"content": "А это не опасно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560108
					]
				},
				{
					"id": 706560108,
					"content": "Не волнуйтесь, это специальное праздничное событие. Для тех, кто не имеет приключенческого опыта, есть опытные искатели приключений, которые будут сопровождать вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560109
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 706560109,
					"content": "Но учитывая ваш богатый опыт, сомневаюсь, что вам понадобится помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560110
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 706560110,
					"content": "Вы можете исследовать подземелье самостоятельно или вместе с друзьями. Вы в любом случае получите награду за прохождение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560111,
						706560112
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 706560111,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560113,
					"content": "Тогда я больше не буду вас задерживать. Веселитесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 706560112,
					"content": "Если есть награда, можно попробовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560103,
					"content": "Похоже, это какое-то особое подземелье.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				}
			]
		}
	]
}