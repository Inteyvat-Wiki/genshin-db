							"2401002",
							"2"
						],
						"stepId": 2401002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бусико"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100201,
					"content": "Привет. Чего желаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100202
					],
					"speakerTitle": "Бусико"
				},
				{
					"id": 240100202,
					"content": "Я по поводу красок для Дэпьери...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100203
					]
				},
				{
					"id": 240100203,
					"content": "Ах, ему краски нужны? Вот они.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100204
					],
					"speakerTitle": "Бусико"
				},
				{
					"id": 240100204,
					"content": "Он так быстро их расходует! Можно подумать, что он просто выливает их и приходит за новыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100205
					],
					"speakerTitle": "Бусико"
				},
				{
					"id": 240100205,
					"content": "Ладно... Вот краски. Отнесёшь ему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бусико"
				}
			]
		},
		{
			"id": 2401003,
