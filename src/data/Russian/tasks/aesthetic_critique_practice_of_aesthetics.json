			"trigger": {
				"objectNames": [
					"Дэпьери"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100501,
					"content": "Спасибо! Теперь красок мне хватит на какое-то время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100502
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100502,
					"content": "Только не выливай их в воду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100503
					]
				},
				{
					"id": 240100503,
					"content": "В воду? Ха-ха. Да, в ваших словах есть доля правды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100504
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100504,
					"content": "Вот только когда я выдавливаю краску и непосредственно выливаю её на холст, а затем использую шпатель и лопатку, создаются особые, впечатляющие штрихи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100505
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100505,
					"content": "Спасибо за помощь. С красками я могу продолжить писать картину. Приходите позже, увидите результат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100506
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100506,
					"content": "Благодаря вам моя работа снова продвигается в верном направлении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100507
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100507,
					"content": "#Для меня будет честью, если вы будете {F#первой}{M#первым}, кто оценит готовую картину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэпьери"
				}
			]
		},
