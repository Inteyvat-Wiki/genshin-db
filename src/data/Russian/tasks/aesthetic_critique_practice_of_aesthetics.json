				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дэпьери"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100301,
					"content": "Нас не должны сдерживать конкретные формы... Нужно передавать красоту через символы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100302
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100302,
					"content": "Нет, нет... Всё не то. Композиция слишком прямолинейная...",
					"roleType": "TALK_ROLE_NPC",
