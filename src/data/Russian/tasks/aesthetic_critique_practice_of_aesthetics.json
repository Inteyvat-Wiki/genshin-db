			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дэпьери"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100101,
					"content": "Идея неплохая, но разве это осуществимо?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100102
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100102,
					"content": "Как продвигается картина?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100103
					]
				},
				{
					"id": 240100103,
					"content": "Ах, это вы! Спасибо за помощь в прошлый раз. Фотографии вышли очень вдохновляющими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100104
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100104,
					"content": "У меня уже есть приблизительный замысел и некоторые наброски, но... чего-то не хватает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100105
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100105,
					"content": "Не пойми меня превратно, в моих набросках достаточно эстетической ценности, но всё же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100106
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100106,
					"content": "Я чувствую, что им не хватает чего-то особенного, чего-то, что может помочь им выйти за рамки обыденности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100107
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100107,
					"content": "Моё восприятие... слишком конкретное. Переведи образы из головы на холст как есть, и красота, которую я силюсь передать, будет необратимо утрачена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100108
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100108,
					"content": "Эх... Боюсь, это сложность, с которой встречается каждый художник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100109,
						240100119
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100109,
					"content": "Пробовал нарисовать что-то другое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100110
					]
				},
				{
					"id": 240100110,
					"content": "Идея похвальная, но, боюсь, проблему не решить простой сменой объекта рисования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100111
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100111,
					"content": "Будь то горы или реки, птицы или звери, или даже мир людской... Ничто не избежит той же участи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100112
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100112,
					"content": "Именно ради решения этой проблемы некоторые из моих коллег деконструируют предметы на части и преобразуют их в соответствии со своими ощущениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100113
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100113,
					"content": "Такое искусство подчёркивает внутренние эмоции лучше всего, а результат на холсте... Как бы получше объяснить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100114
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100114,
					"content": "В общем, будь то персонаж или пейзаж... Даже лучи света несут в себе то необыкновенное ощущение красоты, которое невозможно ухватить привычными органами чувств.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100115
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100115,
					"content": "Многие, взглянув на картину, могут решить, что автор этой картины просто не умеет рисовать или сошёл с ума.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100116
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100116,
					"content": "Но если спокойно присмотреться к ней и почувствовать её настрой, то вы будто услышите громогласный рёв, издаваемый картиной от лица художника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100117
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100117,
					"content": "Этот рёв исходит из его души, выражает его чувства... И чувства эти, как правило, очень сильны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100118
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100118,
					"content": "Но рёв этот не дано слышать ушами. Он должен проникнуть в самую душу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100124,
					"content": "Что же до меня... Мне бы не хотелось полностью отказываться от конкретики, поэтому я избрал другой путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100125
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100125,
					"content": "Я решил сфокусироваться на цветах, для чего мне требуется найти густые краски и ясные штрихи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100126
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100126,
					"content": "В то же время мне необходимо ослабить световую композицию и расположение элементов... Всё это повлияет на мою экспрессию, поэтому придётся попросить их временно покинуть сцену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100127
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100127,
					"content": "Проблема в том, что насыщенные цвета заставляют использовать большое количество краски. Приходится выдавливать её прямиком на холст, чтобы достичь нужного эффекта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100128
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100128,
					"content": "Короче говоря... у меня закончилась краска. Но я не могу просто так собрать свой холст. Это негативно скажется на творческом процессе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100129
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100129,
					"content": "#{F#Путешественница}{M#Путешественник}, не могли бы вы отправиться в город к Бусико и принести мне красок? Они наверняка уже готовы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100130
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100130,
					"content": "Или... Может быть, вы сможете раздобыть нектар попрыгуньи? Тогда я и сам краску изготовлю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100131,
						240100134
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100131,
					"content": "Из нектара можно сделать краску?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100132
					]
				},
				{
					"id": 240100132,
					"content": "Ха-ха, ну разумеется. Кое-кто из моих друзей даже из яиц краски делает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100133
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100133,
					"content": "Говорят, такие краски создают самые деликатные, но при этом насыщенные оттенки. Они идеально подходят для пейзажей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100136,
					"content": "Я знаю, что ты хороший человек. Разве ты откажешь в маленькой просьбе художнику?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100137,
						240100138
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100137,
					"content": "Хорошо, хорошо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100139,
					"content": "Хорошо, большое спасибо! Я буду ждать тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100138,
					"content": "Что поделать?.. Помогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100134,
					"content": "Ты сам делаешь краски?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100135
					]
				},
				{
					"id": 240100135,
					"content": "Ха-ха, конечно! Это первое, чему учится художник. Так удаётся достичь полного контроля над картиной, которую пишешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100119,
					"content": "Не хочешь попробовать другой художественный стиль?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100120
					]
				},
				{
					"id": 240100120,
					"content": "Верно. Некоторые мои коллеги рассуждали так же, и сейчас они пытаются использовать метафорический подход для создания более абстрактных картин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100121
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100121,
					"content": "Есть среди них и те, кто полностью отказался от изображения конкретных объектов и выражает себя через неясные мазки красок... Они называют себя «неодескрицпионистами».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100122
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100122,
					"content": "По правде сказать, даже мне сложно понять их работы до конца. В лучшем случае я вижу некий ритм и структуру линий в этих разноцветных пятнах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100123
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240100123,
					"content": "А что эти картины выражают?.. Здесь мне сложно обойтись без разъяснений самого автора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Дэпьери"
				}
			]
		},
		{
			"id": 2401002,
			"completionStepIds": [
				2401002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
