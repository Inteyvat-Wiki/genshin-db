			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Маноу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "Привет! Дружище! Тут есть действительно классные вещи, и цены отличные! Хочешь взглянуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "Маноу"
				},
				{
					"id": 752650102,
					"content": "А? Разве это не игрушечные кохолазавры? Паймон видела их на Беззаботной ярмарке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752650103,
					"content": "Да, но мои дешевле. Даю скидку пятьдесят процентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "Маноу"
				},
				{
					"id": 752650104,
					"content": "Почему так дёшево?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "Хе-хе, не волнуйся! У меня свои методы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "Маноу"
				},
				{
					"id": 752650106,
					"content": "Они могут быть дешевле, но цвета немного не те... Это ведь не подделка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752650107,
					"content": "Подделка?! Ну что за глупости... А ну, вали отсюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "Маноу"
				},
				{
					"id": 752650108,
					"content": "Уходите! Не буду вам ничего продавать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Маноу"
				}
			]
		},
		{
			"id": 7526502,
