					"Маноу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650301,
					"content": "Эй! У меня есть классное предложение для вас. Погодите, это опять вы?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650302
					],
					"speakerTitle": "Маноу"
				},
				{
					"id": 752650302,
					"content": "Я же сказал, что не буду вам ничего продавать. Не понимаете? Уходите, не мешайте мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650303
					],
					"speakerTitle": "Маноу"
				},
				{
					"id": 752650303,
					"content": "Ты... Лучше попроси у нас прощения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752650304,
					"content": "Что с вами не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650305
					],
					"speakerTitle": "Маноу"
				},
				{
					"id": 752650305,
					"content": "Ты продаёшь подделки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650306
					]
				},
				{
					"id": 752650306,
					"content": "Хм? И что? Советую вам не лезть не в своё дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Маноу"
				}
			]
		},
