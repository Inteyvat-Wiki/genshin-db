			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Конда Дэнсукэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370301,
					"content": "#Ты избавил{F#ась}{M#ся} от всех?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370302
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 220370302,
					"content": "Все грибы здесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370303
					]
				},
				{
					"id": 220370303,
					"content": "#Это всё? Мне кажется, что их было гораздо больше. Ты действительно все выдернул{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370304
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 220370304,
					"content": "В любом случае я очень тебе благодарен. Прими это в качестве компенсации за твои труды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370305
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 220370305,
					"content": "Должен сказать, что эти удобрения просто потрясающие. Грибы выросли неимоверно быстро. Если бы только они могли помогать урожаю вырастать так же быстро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370306
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 220370306,
					"content": "Когда у меня будет время, я обязательно приду купить ещё удобрений и опробовать их...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Конда Дэнсукэ"
				}
			]
		},
