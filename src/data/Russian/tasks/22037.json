			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вахид"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370101,
					"content": "О нет... как такое могло случиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370102
					],
					"speakerTitle": "Вахид"
				},
				{
					"id": 220370102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370103
					]
				},
				{
					"id": 220370103,
					"content": "#Путешественни{F#ца}{M#к}, я как раз искал тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370104
					],
					"speakerTitle": "Вахид"
				},
				{
					"id": 220370104,
					"content": "Ты ещё помнишь Конду Дэнсукэ? Он приходил в магазин несколько дней назад, спрашивал об удобрениях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370105
					],
					"speakerTitle": "Вахид"
				},
				{
					"id": 220370105,
					"content": "Он доволен удобрениями?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370106
					]
				},
				{
					"id": 220370106,
					"content": "Я бы так не сказал. Строго говоря, я думаю, что господин Конда Дэнсукэ чувствует себя потерянным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370107
					],
					"speakerTitle": "Вахид"
				},
				{
					"id": 220370107,
					"content": "Потерянным?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370108
					]
				},
				{
					"id": 220370108,
					"content": "Ну, дело вот в чём. После твоего предыдущего посещения господин Дэнсукэ использовал наши удобрения в соответствии с твоими инструкциями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370109
					],
					"speakerTitle": "Вахид"
				},
				{
					"id": 220370109,
					"content": "Хотя урожай рос хорошо, в то же время... из ниоткуда появилось множество грибов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370110
					],
					"speakerTitle": "Вахид"
				},
				{
					"id": 220370110,
					"content": "Честно говоря, после того, как господин Конда рассказал мне об этом, я тоже чувствую себя немного потерянным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370111
					],
					"speakerTitle": "Вахид"
				},
				{
					"id": 220370111,
					"content": "Это определенно как-то связано с удобрениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370112
					],
					"speakerTitle": "Вахид"
				},
				{
					"id": 220370112,
					"content": "#Путешественни{F#ца}{M#к}, не мог{F#ла} бы ты пойти в деревню Конда и помочь господину Конде избавиться от грибов на его полях?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370113,
						220370116
					],
					"speakerTitle": "Вахид"
				},
				{
					"id": 220370113,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370114
					]
				},
				{
					"id": 220370114,
					"content": "Займись этим, а я пока проведу некоторые исследования в магазине, чтобы узнать, что именно вызвало это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370115
					],
					"speakerTitle": "Вахид"
				},
				{
					"id": 220370115,
					"content": "Эх! Если бы только Алрани была здесь. Она бы точно уже выяснила причину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вахид"
				},
				{
					"id": 220370116,
					"content": "Как насчёт того, чтобы попросить Алрани заняться этим вопросом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370117
					]
				},
				{
					"id": 220370117,
					"content": "Если бы она была здесь, мы бы быстро всё выяснили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370118
					],
					"speakerTitle": "Вахид"
				},
				{
					"id": 220370118,
					"content": "Но она до сих пор не вернулась, и я понятия не имею, куда она пошла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370119
					],
					"speakerTitle": "Вахид"
				},
				{
					"id": 220370119,
					"content": "#Поэтому рассчитываю на тебя, путешественни{F#ца}{M#к}. Я проведу небольшое исследование в магазине, чтобы узнать, что именно вызвало это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вахид"
				}
			]
		},
		{
			"id": 2203702,
			"completionStepIds": [
				2203702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
