				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370201,
					"content": "Откуда же взялись эти грибы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370202,
						220370203
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 220370202,
					"content": "Я здесь, чтобы помочь вам избавиться от грибов!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370205
					]
				},
				{
					"id": 220370205,
					"content": "Тебя прислал господин Вахид, чтобы помочь мне избавиться от них?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370206
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 220370206,
					"content": "Хм, тогда милости прошу. Их слишком много. Это не работа для такого старика, как я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370207
					],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 220370207,
					"content": "Как случилось так, что они так быстро везде повылезали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Конда Дэнсукэ"
				},
				{
					"id": 220370203,
					"content": "Приношу свои извинения за доставленные вам неудобства!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370204
					]
				},
				{
					"id": 220370204,
					"content": "Ты про грибы? Ну хотя бы на моём обеденном столе теперь в них нет недостатка, это уж точно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370205
					],
					"speakerTitle": "Конда Дэнсукэ"
				}
			]
		},
		{
			"id": 2203703,
			"completionStepIds": [
				2203703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
