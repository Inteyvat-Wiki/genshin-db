			"dialogs": [
				{
					"id": 230042401,
					"content": "Ого! Это что, деревце, которое я сделал для змей? Сколько воспоминаний... Ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042402
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230042402,
					"content": "Что ещё за деревце для змей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230042403,
					"content": "Это игрушка для змеек, чтобы они не скучали, ведь не могут же они вечно на мне висеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042404
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230042404,
					"content": "Спасибо, что вернули эту вещицу. Вот, возьмите в награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042405
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230042405,
					"content": "Как же мне пришло в голову смастерить такое? Сколько воспоминаний...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гулабгир"
