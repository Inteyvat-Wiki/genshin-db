			"dialogs": [
				{
					"id": 230040901,
					"content": "Точно! Оно самое! Я был уверен, что оставил корм в лагере.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040902
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230040902,
					"content": "Почему лагерь находится в зарослях?! Ты не боишься уколоться, пока спишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040903
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230040903,
					"content": "Ну что ты, у меня большой опыт выживания в дикой природе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040904
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230040904,
					"content": "Когда я разбивал этот лагерь, вокруг не было столько зарослей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040905
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230040905,
					"content": "Ты давно не был в лесу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040906
					]
				},
				{
					"id": 230040906,
					"content": "Ну, какое-то время. А вот сколько точно, не помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040907
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230040907,
					"content": "Ха-ха-ха, я уж и подзабыть успел, как лагеря-то размещать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040908
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230040908,
					"content": "Старые мои лагеря уже давным-давно заброшены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040909
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230040909,
					"content": "Интересно, как бы сложилась моя жизнь, останься я в тропическом лесу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040910
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230040910,
					"content": "...Ой, что-то я увлёкся. Вот твоя награда за труды. Держи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гулабгир"
				}
			]
		},
