				"points": []
			},
			"dialogs": [
				{
					"id": 230042001,
					"content": "Ого! Жемчужина... Вот это да... Где вы её нашли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042002
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230042002,
					"content": "В лагере в одном из горшков. Это ты её там оставил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230042003,
					"content": "Это реквизит для выступлений. Я играл на флейте, а мои крошки извивались в танце с этой жемчужиной на голове.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042004
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230042004,
					"content": "Но этот трюк уже давно не приносит денег, пришлось отказаться от его исполнения. Я даже не заметил, что жемчужина пропала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042005
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230042005,
					"content": "Как бы то ни было, спасибо, что помогли её вернуть. Примите это вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гулабгир"
				}
			]
		},
