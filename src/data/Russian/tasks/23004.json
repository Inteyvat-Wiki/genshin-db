				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230042201,
					"content": "Ого! Шляпки... Ха-ха-ха, я смастерил их для моих змеек. И как же я мог про них забыть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042202
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230042202,
					"content": "Чтобы привлечь ребятишек, я сделал для каждой змейки колпачок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042203
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230042203,
					"content": "Красный для Джори, зелёный для Амума, жёлтый для Ганы, а синий для Драка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042204
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230042204,
					"content": "Как мило! Паймон не сомневается, что шоу имело успех!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230042205,
					"content": "Начиналось всё неплохо, но стоило змейкам открыть пасть, как дети принимались хныкать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042206
					],
					"speakerTitle": "Гулабгир"
				},
				{
					"id": 230042206,
					"content": "Не будем об этом... Прошу, примите от меня в благодарность эту награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гулабгир"
				}
			]
