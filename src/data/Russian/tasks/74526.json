			"dialogs": [
				{
					"id": 745260401,
					"content": "#А, {NICKNAME}, вот и ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260402,
						745260403
					],
					"speakerTitle": "Нилу"
				},
				{
					"id": 745260402,
					"content": "Нилу, ты тренируешься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				},
				{
					"id": 745260404,
					"content": "Нет-нет. Я как раз обдумываю новый танец, вдохновлённый падисарами после дождя, когда на лепестках ещё висят капельки росы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260405
					],
					"speakerTitle": "Нилу"
				},
				{
					"id": 745260405,
					"content": "Это только черновой вариант. Движения пока не отточены, и чувствую, что ещё чего-то не хватает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260406,
						745260407
					],
					"speakerTitle": "Нилу"
				},
				{
					"id": 745260406,
					"content": "Звучит очень красиво...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260408,
					"content": "Моё фото? Но я же сказала, что ещё не очень хорошо освоила движения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260409,
						745260410
					],
					"speakerTitle": "Нилу"
				},
				{
					"id": 745260409,
					"content": "Работа над постановкой танца...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260411,
					"content": "Ах, хорошо! Тогда я вложу все свои чувства в движения... Прошу, поймай в объективе прекрасный момент цветения падисары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нилу"
				},
				{
					"id": 745260410,
					"content": "...это тоже часть искусства.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260407,
					"content": "Могу я сфотографировать тебя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260403,
					"content": "Я тебе не мешаю?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				}
			]
		}
	]
