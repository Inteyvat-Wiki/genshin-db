			"dialogs": [
				{
					"id": 230080101,
					"content": "Возможно, у меня всё получится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080102
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080102,
					"content": "#Путешественни{F#ца}{M#к}! Путешественни{F#ца}{M#к}, постой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080103,
						230080104
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080103,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				},
				{
					"id": 230080105,
					"content": "Мне нужна слизь слайма!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080106
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080106,
					"content": "Тут такое дело... Все эти дни я экспериментировал с принесённой тобой глиной, смешивая в разных пропорциях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080107
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080107,
					"content": "У меня долго ничего не получалось, но в итоге я нашёл подходящую пропорцию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080108
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080108,
					"content": "В такой пропорции глинобетон не совсем пригоден для работы, но после затвердевания он становится очень крепким и прочным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080109
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080109,
					"content": "Возможно, глины со слизью слаймов маловато...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080110
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080110,
					"content": "#Путешественни{F#ца}{M#к}, принеси мне три бутылочки слизи слайма!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080111
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080111,
					"content": "С помощью слизи слайма я смогу сделать идеальную глину!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080104,
					"content": "Опять что-то ищешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				}
			]
		},
