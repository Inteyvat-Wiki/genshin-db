			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аким"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230080301,
					"content": "Великолепно! Подожди немного, и ты увидишь результат!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080302
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080302,
					"content": "Через некоторое время...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230080303
					]
				},
				{
					"id": 230080303,
					"content": "Мои предположения были верны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080304
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080304,
					"content": "У сырой глины отличные вяжущие свойства, однако после затвердевания она быстро трескается. А если её смешать с землёй от попрыгуний, то в твёрдом виде получившаяся смесь становится более эластичной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080305
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080305,
					"content": "Но с такой глиной невозможно работать до её затвердевания из-за слабой пластичности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080306
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080306,
					"content": "Но после добавления слизи слайма пластичность смеси стала намного лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080307
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080307,
					"content": "Я не знаю почему, но если попытаться описать, то глина сама стала как слайм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080308,
						230080309
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080308,
					"content": "«Слаймоглина».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080311
					]
				},
				{
					"id": 230080311,
					"content": "Мне кажется, всё дело в слизи, которая повлияла на глину. Поэтому я подумал, а что если добавить слизь слайма сразу в глину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080312
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080312,
					"content": "После проведённых испытаний, можно сделать вывод, что прочность и пластичность глины меняется, в зависимости от объёма добавленной слизи слайма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080313
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080313,
					"content": "Другими словами, это не только строительный материал, но и материал для гончарного дела и других направлений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080314,
						230080315
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080314,
					"content": "Поздравляю!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080316,
					"content": "Спасибо. Как говорили мудрецы, курочка по зёрнышку клюёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080317
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080317,
					"content": "Несмотря на то, что эта глина кажется невзрачной, но из неё получится соорудить целые башни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080318
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080318,
					"content": "Я решил назвать эту смесь «глинобетоном».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080319
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080319,
					"content": "И теперь нужно проверить, что из этого глинобетона можно сделать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080320
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080320,
					"content": "Проблемы с домами, которые давно всех мучили, возможно, скоро будут разрешены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080321
					],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080321,
					"content": "#Спасибо тебе, путешественни{F#ца}{M#к}. Вот забери свою награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аким"
				},
				{
					"id": 230080315,
					"content": "Всё-таки есть результат.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080309,
					"content": "Паймон должно понравиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080310
					]
				},
				{
					"id": 230080310,
					"content": "Паймон не ест глину!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080311
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}