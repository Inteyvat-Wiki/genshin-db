		},
		{
			"id": 2300803,
			"completionStepIds": [
				2300803
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300803",
							"2"
						],
						"stepId": 2300803,
						"stateName": "QUEST_STATE_UNFINISHED"
