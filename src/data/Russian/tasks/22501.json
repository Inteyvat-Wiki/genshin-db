			},
			"dialogs": [
				{
					"id": 225010601,
					"content": "Разве каждое твоё творение должно потрясти мир?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010602
					]
				},
				{
					"id": 225010602,
					"content": "Верно подмечено. Жемчужины поэзии рождаются без умысла, случайно падая мастеру в руки. Но этот стих не даёт мне покоя уже давно, и я хотел бы поскорее его закончить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цин Чжоу"
				}
