				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010501,
					"content": "Но рядом с метеоритами бродят чудовища.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010502
					]
				},
				{
					"id": 225010502,
					"content": "Ха-ха, ну конечно. Я побывал во многих местах Ли Юэ и повидал немало всяких тварей. Но ежели и впрямь опасен путь... Не страшно, я найму себе сопровождение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цин Чжоу"
				}
			]
		},
		{
