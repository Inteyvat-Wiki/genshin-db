						"stepId": 2250101,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250102",
							"2"
						],
						"stepId": 2250102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цин Чжоу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010201,
					"content": "Что ты имеешь в виду под «не очень хорошая»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010202
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 225010202,
					"content": "Если прикоснуться к метеориту, можно потерять сознание...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010203
					]
				},
				{
					"id": 225010203,
					"content": "Ах, мне об этом известно. Но если к ним просто подойти и посмотреть, то несчастье мне грозить не должно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010204
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 225010204,
					"content": "Ты должен пообещать, что к метеоритам не прикоснёшься.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010205
					]
				},
				{
					"id": 225010205,
					"content": "Ну... Я всеми силами постараюсь от этого воздержаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цин Чжоу"
				}
			]
		},
		{
			"id": 2250103,
			"completionStepIds": [
				2250103
			],
