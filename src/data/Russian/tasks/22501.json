					"Цин Чжоу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010401,
					"content": "Почему бы тебе не писать стихи здесь?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010402
					]
				},
				{
					"id": 225010402,
					"content": "Так не пойдёт. Если я буду оставаться в четырёх стенах, не зная жизни, то стихи мои будут пустыми стенаниями больного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цин Чжоу"
				}
			]
		},
		{
			"id": 2250105,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
