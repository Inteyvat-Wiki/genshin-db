			},
			"dialogs": [
				{
					"id": 225010301,
					"content": "Есть и получше способ смотреть на метеориты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010302
					]
				},
				{
					"id": 225010302,
					"content": "#Способ получше, хм?.. Ты, наверное, прав{F#а}. Если смотреть лишь на метеориты, не обращая внимание на всё, что их окружает, то много чего можно упустить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цин Чжоу"
				}
			]
		},
		{
			"id": 2250104,
			"completionStepIds": [
				2250104
			],
			"beginWay": "TALK_BEGIN_NONE",
