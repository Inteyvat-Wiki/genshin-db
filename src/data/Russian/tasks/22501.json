	"talks": [
		{
			"id": 2250101,
			"completionStepIds": [
				2250101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250101",
							"2"
						],
						"stepId": 2250101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цин Чжоу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010101,
					"content": "Хм... Не звучит эта строка, не звучит! Эх, стало быть, придётся пойти и посмотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010102
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 225010102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010103
					]
				},
				{
					"id": 225010103,
					"content": "Приветствую, приветствую! Моё имя Цин Чжоу. Я осмелюсь назвать себя поэтом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010104
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 225010104,
					"content": "Недавно ко мне на ум пришли замечательные строки, но для продолжения не хватило искры. Я до сих пор силюсь найти подходящие слова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010105
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 225010105,
					"content": "В небе произошло необыкновенное явление, и на землю упала россыпь огненных метеоритов. Редчайшее зрелище, скажу я тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010106
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 225010106,
					"content": "Я подумал, что их вид придаст мне недостающего вдохновения, и тогда строки польются сами собой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010107
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 225010107,
					"content": "Это не очень хорошая идея...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010108
					]
				},
				{
					"id": 225010108,
					"content": "Не очень хорошая? Что ты пытаешься этим сказать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цин Чжоу"
				}
			]
		},
		{
			"id": 2250102,
			"completionStepIds": [
				2250102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250101",
							"3"
