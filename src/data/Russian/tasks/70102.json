			"dialogs": [
				{
					"id": 701020301,
					"content": "Насчёт драконьих клыков...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020302
					]
				},
				{
					"id": 701020302,
					"content": "#Хорошо, что ты заш{F#ла}{M#ёл}. Насчёт тех клыков... А, так ты уже всё собрал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020303
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 701020303,
					"content": "Прости, но у меня тут возникла одна проблемка. Сколько бы я этот клык молотом ни бил, он не даёт даже крошки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020304
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 701020304,
					"content": "Может, это и правда драконий клык... Согласно прочитанным мной материалам, обрабатывается он несколькими особенными способами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020305
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 701020305,
					"content": "Один из них - наполнить клык некой... «жизненной силой» дракона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020306
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 701020306,
					"content": "А потом использовать его в работе с остальными клыками дракона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020307
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 701020307,
					"content": "Но я не имею ни малейшего понятия, как именно наполнять вещи жизненной силой дракона...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020308
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 701020308,
					"content": "#А ты, путешественни{F#ца}{M#к}, не знаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020309
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 701020309,
					"content": "Я что-нибудь придумаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020310
					]
				},
				{
					"id": 701020310,
					"content": "Вот и отлично... Держи клык. Дело теперь за тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020311
					],
					"speakerTitle": "Орбан"
				},
				{
					"id": 701020311,
					"content": "Эх, если это и в самом деле клык дракона, выходит, что драконы - штука тонкая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Орбан"
				}
