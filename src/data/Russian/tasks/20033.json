			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Анна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330201,
					"content": "#Готово! Спасибо, путешественни{F#ца}{M#к}. Задание по сопровождению на этот раз прошло гладко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330202
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330202,
					"content": "Но... неужели поручения искателей приключений всегда проходят таким образом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330203,
						200330205
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330203,
					"content": "Бывают и другие поручения.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330204
					]
				},
				{
					"id": 200330204,
					"content": "Звучишь ты что-то совсем отчаянно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200330207,
					"content": "Ясно... Хорошо, я буду трудиться не покладая рук!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330208
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330208,
					"content": "А когда накоплю денег, отправлюсь вместе с братом, папой и мамой путешествовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330209
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330209,
					"content": "Энтони всегда хотел путешествовать, но... ему приходилось ухаживать за мной, когда я болела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330210
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330210,
					"content": "Но теперь я выздоровела и стала искательницей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330211
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330211,
					"content": "Хе-хе, настал час исполнить мечты брата!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330205,
					"content": "Со временем ты всё поймёшь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330206
					]
				},
				{
					"id": 200330206,
					"content": "Эй, не делай такой понурый вид...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "Анна"
				}
			]
		},
		{
			"id": 2003303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
