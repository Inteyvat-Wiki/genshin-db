			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Энтони"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330301,
					"content": "#Путешественни{F#ца}{M#к}, прошу тебя, присмотри за Анной. Последнее время она так взволнована...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330302
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200330302,
					"content": "Ты не хочешь, чтобы она была искателем приключений?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330303
					]
				},
				{
					"id": 200330303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330304
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200330304,
					"content": "Я уважаю мечты Анны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330305
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200330305,
					"content": "Она наконец переборола болезнь, и у неё появилась возможность осуществить свою мечту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330306
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200330306,
					"content": "Я её брат, и я... полностью поддерживаю её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330307
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200330307,
					"content": "Вот так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		}
	]
