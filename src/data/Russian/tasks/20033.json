			"trigger": {
				"objectNames": [
					"Анна",
					"Энтони"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330101,
					"content": "#Путешественни{F#ца}{M#к}, посмотри! Что скажешь о моей одежде? Красивая?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330102
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330102,
					"content": "Одежда эта... Неужели?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330103
					]
				},
				{
					"id": 200330103,
					"content": "Да! Я сдала экзамен, и теперь я официальная искательница приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330104,
						200330105
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330104,
					"content": "Очень красивая!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				},
				{
					"id": 200330106,
					"content": "Хе-хе, спасибо. Я ещё хотела дать её примерить брату, но он отказался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330107
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330107,
					"content": "Говорю же, меня приключения не интересуют... Если мы оба станем искателями приключений, кто позаботится о родителях?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330108
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200330108,
					"content": "А мы и родителей с собой возьмём, вместе посмотрим мир!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330109
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330109,
					"content": "Ну ты... Сдаюсь. Раз уж ты стала искательницей приключений, то уж изо всех сил старайся. О доме позабочусь я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330110
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200330110,
					"content": "Только обязательно будь осторожной! Смотри, чтобы не поранилась и не переутомилась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330111
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200330111,
					"content": "Да знаю я, знаю! А теперь меня ждёт поручение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330112
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330112,
					"content": "#Хочешь со мной, путешественни{F#ца}{M#к}? У меня к тебе ещё столько вопросов о приключениях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330113,
						200330114
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330113,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330115,
					"content": "Отлично. Итак, поручение это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330116
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330116,
					"content": "Сопровождение товарного аэростата!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				},
				{
					"id": 200330114,
					"content": "В путь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330105,
					"content": "Мои поздравления!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				}
			]
		},
		{
			"id": 2003302,
