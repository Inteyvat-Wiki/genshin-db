			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сёта"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270101,
					"content": "Лакированные изделия... как их делают...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270102
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270102,
					"content": "Зачем тебе лакированные изделия?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270103
					]
				},
				{
					"id": 220270103,
					"content": "#О, это ты, {F#сестрёнка}{M#братик}. Смотри, дело вот в чём. Ты когда-нибудь слышал{F#а} о божественном вмешательстве святилища?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270104
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270104,
					"content": "Насколько я слышал, если преподнести святилищу драгоценные подношения, возможно, твои желания сбудутся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270105
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270105,
					"content": "Я думаю, что красивая лакированная посуда очень ценна. Если бы я использовал её в качестве подношения святилищу, то обязательно получил бы ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270106
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270106,
					"content": "Однако у меня нет денег, чтобы купить лакированную посуду. Поэтому я хочу изготовить её сам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270107
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270107,
					"content": "Я слышал, что Нанацуки из магазина лакированных изделий Яёй очень хороша в этом деле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270108
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270108,
					"content": "#{F#Сестрёнка}{M#Братик}, ты не мог{F#ла} бы пойти спросить у неё кое-что про лакированную посуду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270109,
						220270111
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270109,
					"content": "Нет проблем. За дело!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270110
					]
				},
				{
					"id": 220270110,
					"content": "#Спасибо тебе, {F#сестрёнка}{M#братик}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270111,
					"content": "А сам ты не пойдёшь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270112
					]
				},
				{
					"id": 220270112,
					"content": "Нанацуки обычно такая строгая... У меня не хватает смелости самому обратиться к ней за помощью...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270113
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270113,
					"content": "#Но если ты будешь со мной, {F#сестрёнка}{M#братик}, то, наверное, всё пройдёт лучше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сёта"
				}
			]
		},
		{
			"id": 2202702,
			"completionStepIds": [
				2202702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
