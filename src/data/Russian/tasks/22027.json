			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Яёй Нанацуки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270201,
					"content": "Здравствуйте, вы что-то хотели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270202
					],
					"speakerTitle": "Яёй Нанацуки"
				},
				{
					"id": 220270202,
					"content": "Так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270203
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270203,
					"content": "Да, он хочет спросить тебя про лакированную посуду...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270204
					]
				},
				{
					"id": 220270204,
					"content": "А, так ты хочешь преподнести лакированную посуду в дар святилищу, и ты хочешь изготовить её сам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270205
					],
					"speakerTitle": "Яёй Нанацуки"
				},
				{
					"id": 220270205,
					"content": "Пожалуйста, Нанацуки. У меня есть одно желание, мне безумно хочется, чтобы оно исполнилось! Вот почему я... Не волнуйся, я никому не расскажу о твоей секретной формуле!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270206
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270206,
					"content": "Дело не в формуле лака. Если ты хочешь делать красивые лакированные изделия, даже не говоря о покраске, тебе потребуются долгие годы практики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270207
					],
					"speakerTitle": "Яёй Нанацуки"
				},
				{
					"id": 220270207,
					"content": "И дело не только во времени, а скорее в... капитале. Я наследница четвертого поколения в семье мастеров по изготовлению лакированных изделий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270208
					],
					"speakerTitle": "Яёй Нанацуки"
				},
				{
					"id": 220270208,
					"content": "Я даже ездила в Сумеру, чтобы изучить это искусство. Так что можешь даже не рассчитывать, что сможешь постичь его в одночасье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270209
					],
					"speakerTitle": "Яёй Нанацуки"
				},
				{
					"id": 220270209,
					"content": "Правда?.. Но я не могу придумать, что ещё преподнести в дар святилищу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270210
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270210,
					"content": "На мой взгляд, дело не в ценности предмета, подносимого святилищу. Предмет, который ты преподносишь, должен воплощать в себе твои чувства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270211
					],
					"speakerTitle": "Яёй Нанацуки"
				},
				{
					"id": 220270211,
					"content": "Если твои чувства и намерения искренние, просто предложив в дар свои любимые предметы, ты должен быть в состоянии получить ответ от Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270212
					],
					"speakerTitle": "Яёй Нанацуки"
				},
				{
					"id": 220270212,
					"content": "Искренние чувства и намерения... то, что мне нравится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270213
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270213,
					"content": "Хм, кажется, я понял... и в то же время не понял. Но всё равно спасибо, Нанацуки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270214
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270214,
					"content": "#Давай сначала вернёмся к святилищу, {F#сестрёнка}{M#братик}. Мне всё ещё нужна твоя помощь в выяснении того, что же я хочу преподнести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сёта"
				}
			]
		},
		{
			"id": 2202703,
			"completionStepIds": [],
