					"Сёта"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270401,
					"content": "Давай преподнесём трёхцветное данго.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270402
					]
				},
				{
					"id": 220270402,
					"content": "Правда? Да! У меня как раз есть один с собой. Моя мама приготовила его для меня, а я пока к нему даже не притронулся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270403,
					"content": "Тогда давай его и преподнесём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270601
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270601,
					"content": "О, великий Архонт, благослови меня и помоги моим желаниям исполниться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270602
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270602,
					"content": "#Спасибо, что был{F#а} со мной всё это время, {F#сестрёнка}{M#братик}. Пожалуйста, возьми. Это тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270603
					],
					"speakerTitle": "Сёта"
				},
				{
					"id": 220270603,
					"content": "Я вернусь сюда завтра, чтобы проверить ещё раз. Надеюсь, что получу ответ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сёта"
				}
			]
		},
