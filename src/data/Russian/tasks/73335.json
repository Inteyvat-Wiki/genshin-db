			"dialogs": [
				{
					"id": 733350701,
					"content": "Неплохо, Соруш! Ты очень быстро вернула жизнь этой местности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733350702,
					"content": "Пари обладают поразительными способностями.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350703
					]
				},
				{
					"id": 733350703,
					"content": "Вы напрасно волнуетесь! Моих сил более чем достаточно, чтобы с лёгкостью спасти цветы шуньяты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350704
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733350704,
					"content": "Тёмное разложение ширится, и эти цветки шуньяты лишь одни из множества жертв...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350705
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733350705,
					"content": "Другие цветочные поляны вряд ли уцелели. Сефана, наверное, в полной растерянности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350706
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733350706,
					"content": "Похоже, эта Сефана - очень милая пари и усердно заботится о цветах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733350707,
					"content": "#Поможем ей, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733350708,
					"content": "#Что ж, полагаю, ради этого пустяка можно и отвлечься ненадолго от великой миссии. {M#Мой}{F#Моя} яснапати, прошу тебя, обращай внимание на такие цветки шуньяты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350709
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733350709,
					"content": "Я скажу тебе, когда их увижу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350710
					]
				},
				{
					"id": 733350710,
					"content": "Ура! Давайте спасём красивые цветочки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
