			"dialogs": [
				{
					"id": 761870401,
					"content": "Десерты очень вкусные!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870402,
						761870403
					],
					"speakerTitle": "Мамер"
				},
				{
					"id": 761870402,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761870404,
					"content": "Э?! Так быстро? Ладно, спасибо, госпожа Сандроне! Увидимся в следующий раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мамер"
				},
				{
					"id": 761870403,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
