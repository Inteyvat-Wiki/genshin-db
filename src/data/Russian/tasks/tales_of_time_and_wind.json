					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100070401,
					"content": "Этот остров...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070402
					]
				},
				{
					"id": 100070402,
					"content": "...Что в нём особенного?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070403
					]
				},
				{
					"id": 100070403,
					"content": "Сам по себе остров ничем не примечателен. Как и большинство других островов, он представлял собой лишь скопление обычного песка и камней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070404
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 100070404,
					"content": "Пока ветер не принёс семена истории, и время не позволило им прорасти на этом острове.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070405
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 100070405,
					"content": "А затем ветер принёс новые истории, и время превратило их в легенды за пределами острова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070406
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 100070406,
					"content": "#{NICKNAME}, добро пожаловать на этот маленький остров, поистине благословлённый временем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070407
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 100070407,
					"content": "В далёком прошлом здесь встретились время и ветер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070408
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 100070408,
					"content": "Эй, эй, эй... Ты вдруг стал таким серьёзным, бродяжка. Паймон не уверена, что понимает, о чём идёт речь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100070409,
					"content": "Хе-хе, не торопись, дорогая Паймон. Лучшие истории всегда начинаются с небольшой интриги и напряжения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		},
