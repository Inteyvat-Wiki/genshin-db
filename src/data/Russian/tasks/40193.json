				]
			},
			"dialogs": [
				{
					"id": 401930201,
					"content": "Следуя настойчивым просьбам Итто, вы снова отправляетесь в бани «Аиса»...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930202
					]
				},
				{
					"id": 401930202,
					"content": "Ха-ха-ха! Вот здесь жарче всего! Посмотрим, кто продержится дольше всех! Кто в игре?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930203
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401930203,
					"content": "Хе-хе, разве я могу отказаться?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930204
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 401930204,
					"content": "Послушай... Это не сауна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930205
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401930205,
					"content": "Так тепло... *храп*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930206
					],
					"speakerTitle": "Саю"
				},
				{
					"id": 401930206,
					"content": "Эй, не засыпай в ванне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401930207,
					"content": "Ух... Моя шерсть такая тяжёлая. Голова кружится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930208
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 401930208,
					"content": "Ха-ха-ха! Если тебе тяжело переносить жару, Горо, выходи из... ванны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930209
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401930209,
					"content": "Эй! Не шуми!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930210
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 401930210,
					"content": "Тем временем за стенкой...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930211
					]
				},
				{
					"id": 401930211,
					"content": "Итто, как всегда, энергичен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930212
					],
					"speakerTitle": "Камисато Аято"
				},
				{
					"id": 401930212,
					"content": "Не стоит отвлекаться во время матча, брат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930213
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 401930213,
					"content": "#Ух ты! Ситуация накаляется! Каков твой следующий ход, {NICKNAME}? Что думаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930214
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 401930214,
					"content": "Хм... Я бы не спешила и постаралась закрепить своё преимущество.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930215
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 401930215,
					"content": "Или можно проявить настойчивость... Риск не самая плохая идея!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930216,
						401930217
					],
					"speakerTitle": "Сиканоин Хэйдзо"
				},
				{
					"id": 401930216,
					"content": "(Действовать медленно и уверенно.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				},
				{
					"id": 401930218,
					"content": "#О? Весьма умно, {NICKNAME}! Решающее поражение... Я сдаюсь! Теперь, согласно случайной жеребьёвке, следующим игроком станет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930219
					],
					"speakerTitle": "Камисато Аято"
				},
				{
					"id": 401930219,
					"content": "Аяка! Веселитесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930220
					],
					"speakerTitle": "Камисато Аято"
				},
				{
					"id": 401930220,
					"content": "О, э... Ладно! Пожалуйста, прояви терпение ко мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930221
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 401930221,
					"content": "(Аято наверняка специально проиграл, чтобы дать Аяке больше времени на игру...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 401930217,
					"content": "(Проявить напор!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				}
			]
		},
