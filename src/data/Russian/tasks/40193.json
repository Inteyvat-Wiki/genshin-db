			},
			"dialogs": [
				{
					"id": 401930101,
					"content": "#О, дружище! Говорят, что вчера вечером ты ходил{F#а} в бани «Аиса»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930102
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401930102,
					"content": "Я собираю команду, и мы пойдём праздновать! Ты с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930103
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401930103,
					"content": "Но мы только что были там...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401930104,
					"content": "#Да... Но наверняка ты скучал{F#а} по кому-то, да? Например, Синобу... и Горо... и ещё... Аято...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930105
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 401930105,
					"content": "Проще говоря, босс услышал об этом и теперь очень хочет пойти в баню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930106
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 401930106,
					"content": "В общем! Как только закончишь, заходи, и мы отмокнем! Тепло! Источники!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аратаки Итто"
				}
			]
		},
		{
