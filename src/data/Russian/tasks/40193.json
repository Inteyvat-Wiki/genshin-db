			"dialogs": [
				{
					"id": 401930301,
					"content": "Представляете, мы пользовались огромным успехом на Фестивале цветов Микавы! Было в три раза больше посетителей, чем обычно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930302
					],
					"speakerTitle": "Айкава Сусуму"
				},
				{
					"id": 401930302,
					"content": "Учитывая выручку на данный момент, думаю, что мы сможем заработать... вот столько!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930303
					],
					"speakerTitle": "Айкава Сусуму"
				},
				{
					"id": 401930303,
					"content": "Отличные новости! Возможно, мы даже превзойдём издательский дом Яэ в этом месяце...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930304
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 401930304,
					"content": "О? Выглядишь довольной... Устраиваешь вечеринку без меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930305
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 401930305,
					"content": "О, хе-хе... Да нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930306
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 401930306,
					"content": "Совсем забыла поделиться с тобой хорошими новостями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930307
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 401930307,
					"content": "Тридцать процентов доходов от фестиваля будут перечислены издательскому дому Яэ. В этом месяце мы ожидаем рекордную прибыль... Не хочешь нас поздравить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930308
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 401930308,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930309
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 401930309,
					"content": "Госпожа Мидзуки... Полагаю, поздравления уместны... Мы в 333-й раз соревнуемся с издательским домом Яэ в продажах, и наш лучший результат на сегодняшний день - второе место!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930310
					],
					"speakerTitle": "Айкава Сусуму"
				},
				{
					"id": 401930310,
					"content": "Ха-ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930311
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 401930311,
					"content": "...Желаю всем сладких снов этой ночью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эи"
				}
			]
		},
