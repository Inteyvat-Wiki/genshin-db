			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Араминали"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000101,
					"content": "#Нара {NICKNAME} хочет открыть «сундук»? Но в ване ещё так много аранар, которым нужна помощь. Вот если бы нара сходил{F#а} и помог{F#ла} им...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000102
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000102,
					"content": "Араминали до краёв наполнит «сундук» теми «сокровищами», что присылает Аранимба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араминали"
				}
			]
		},
		{
			"id": 7310002,
			"completionStepIds": [
				7310014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"2"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Араминали"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000201,
					"content": "#Араминали знает, что {M#золотой}{F#золотая} нара часто помогает аранарам, а значит, он{F#а} хорош{M#ий}{F#ая} нара. Поэтому Араминали отдаст этот «сундук» тебе, нара {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араминали"
				}
			]
		},
		{
			"id": 7310003,
			"completionStepIds": [],
