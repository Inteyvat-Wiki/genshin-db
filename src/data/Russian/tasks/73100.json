				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Араминали"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000301,
					"content": "#Араминали слышал, что нара {NICKNAME} хорошо показал{F#а} себя в ване...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000302
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000302,
					"content": "#«Сокровища» в «сундуке». Нара {NICKNAME}, открывай! Не стесняйся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араминали"
				}
			]
		},
		{
			"id": 7310004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"3"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
						"rawParams": [
							"73100",
							"32"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Араминали"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000401,
					"content": "#Нара {NICKNAME} и Паймон такие медлительные! Араминали уже давным-давно наполнил «сундук». Я так долго вас жду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000402
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000402,
					"content": "#Нара {NICKNAME}, «сундук» наполнен. Скорее открывай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араминали"
				}
			]
		},
		{
			"id": 7310005,
			"completionStepIds": [
				7310015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310015",
							"2"
						],
						"stepId": 7310015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Араминали",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000501,
					"content": "#Аранары рассказали Араминали, как много хорошего успели для них сделать нара {NICKNAME} и Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000502
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000502,
					"content": "Араминали обо всём известно. Эти хвалебные речи бегут по ветвям деревьев и пробираются сквозь ручейки. А в конце они вместе с ветерком попадают прямо в «уютное гнёздышко» Араминали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000503
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000503,
					"content": "#Потому Араминали наполнил «сундук» «сокровищами», а потом стал ожидать прихода нары по имени {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000504
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000504,
					"content": "#Те сверкающие штучки, которые принёс Аранимба, тоже отправились туда. Может, нара {NICKNAME} сочтёт их интересными?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000505
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000505,
					"content": "Аранимба не возвращался?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731000506
					]
				},
				{
					"id": 731000506,
					"content": "Аранимба ведь неугомонный аранара, а не большое дерево с глубокими корнями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000507
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000507,
					"content": "А... Араминали не чувствует себя здесь одиноко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731000508,
					"content": "Что значит «одиноко»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000509
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000509,
					"content": "Ну... это значит, когда рядом совсем-совсем никого нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731000510,
					"content": "В Ванаране очень много аранар, так что Араминали вовсе не чувствует себя «одиноко».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000511
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000511,
					"content": "Вот только ни Араямы, ни Аранимбы в Ванаране нет. Раньше мы втроём всегда чем-нибудь занимались вместе. Счастливое было время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000512
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000512,
					"content": "Араракалари у Араямы очень сильный. Слабым нарам не под силу его обидеть. А Аранимба умеет рисовать всякое. Красиво получается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000513
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000513,
					"content": "Но теперь остались только Араминали и его «сундуки»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000514
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000514,
					"content": "Араминали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731000515,
					"content": "Ничего, у Араминали есть много-много «сундуков». Интересно всё же, почему нарам так нравится открывать их...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000516
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000516,
					"content": "#Араминали - хозяин «сундуков». Раз наре нравятся «сундуки», значит, и Араминали {F#ей}{M#ему} тоже нравится, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000517
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000517,
					"content": "У Араминали больше нет «сокровищ». Придётся «сундукам» побыть пустым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000518
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000518,
					"content": "#Но даже без набитого «сундука» нара {NICKNAME} всё равно будет дружить с Араминали, правда же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араминали"
				}
			]
		},
		{
