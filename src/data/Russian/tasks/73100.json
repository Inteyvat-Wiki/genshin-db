			"dialogs": [
				{
					"id": 731000601,
					"content": "#Араминали ещё не готов! Да и «сундук» ещё не успел наполниться. Пусть нара {NICKNAME} и Паймон пока «побездельничают».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000602
					],
					"speakerTitle": "Араминали"
				},
				{
					"id": 731000602,
					"content": "Ой, нет, это не то слово... Араминали хотел сказать «осмотрятся». Может, встретите ещё аранару, которому нужна ваша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араминали"
				}
			]
		},
		{
			"id": 7310007,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310015",
							"3"
						],
						"stepId": 7310015,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Араминали"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000701,
					"content": "#В животе у Араминали полно еды, а вот «сундук» совсем голодный. Голодным быть плохо. Нара {NICKNAME} и Паймон всё время в пути, значит, наверняка тоже проголодались. Вот, возьмите грибы. Они придадут вам сил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араминали"
				}
			]
		}
