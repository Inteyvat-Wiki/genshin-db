					"content": "Пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650302
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650302,
					"content": "Орден Бездны любит устраивать лагеря в такого рода заброшенных руинах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650303
					],
					"speakerTitle": "Дилюк"
				},
				{
