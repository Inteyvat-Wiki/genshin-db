			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дилюк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650201,
					"content": "Дилюк! У нас для тебя плохие новости! Мы только что были в Ордо Фавониус и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4650202,
					"content": "Объявление войны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650203
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650203,
					"content": "Я в курсе. Спасибо, что проделали этот путь, чтобы оповестить меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650204
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650204,
					"content": "Но как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4650205,
					"content": "У винокурни «Рассвет» есть информаторы не только в криминальном подполье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650206
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650206,
					"content": "Здорово! Каков наш план, господин Дилюк?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4650207,
					"content": "Я готов выслушать ваши предложения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650208,
						4650213
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650208,
					"content": "Стоит объединиться с рыцарями...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650209
					]
				},
				{
					"id": 4650209,
					"content": "Нет. Так мы только сыграем на руку ордену Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650210
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650210,
					"content": "Они рассчитывают, что таким образом я открою свою личность перед рыцарями Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650211
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650211,
					"content": "Если Ордо Фавониус узнают, кто я, то они будут пытаться вмешаться во все мои дальнейшие планы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650212
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650212,
					"content": "В конце концов ни одна могущественная организация не хочет, чтобы их превзошёл кто-то посторонний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650217,
					"content": "М-да... Орден Бездны добавил нам проблем. Подлые мерзавцы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4650218,
					"content": "У меня есть одна идея. Но сперва мне нужно собрать больше информации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650219
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650219,
					"content": "А именно, понять, о чём говорится в зашифрованных частях письма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650220
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650220,
					"content": "В зашифрованных? В тех, от которых у Паймон начинают болеть глаза?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4650221,
					"content": "Это должен быть шифр, понятный только Ордену Бездны. Возможно, его используют для переписки между членами организации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650222,
						4650223
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650222,
					"content": "Зачем им отправлять сообщение, которое понятно только им самим?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650224,
					"content": "Значит, что письмо содержит не только вызов мне, но и приказы для них самих.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650225
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650225,
					"content": "Когда становишься героем для одних, тут же становишься врагом для других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650226
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650226,
					"content": "И так как я уже давно являюсь врагом ордена Бездны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650227
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650227,
					"content": "Они наконец-то сделали меня целью, против которой объединятся их отряды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650228
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650228,
					"content": "Ого... Чтобы быть супергероем, обязательно нужно быть настолько умным?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4650229,
					"content": "Я всего лишь понимаю своих врагов. Как я уже говорил, герои и злодеи - две стороны одной монеты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650230
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650230,
					"content": "Ну так что мы планируем делать с непонятной тарабарщиной в письме? Как мы её поймём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4650231,
					"content": "Очень просто. Когда что-то неясно, лучше просто спросить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650232
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650232,
					"content": "Мне удалось выяснить расположение их <color=#00E1FFFF>крепости</color>. Можешь ко мне присоединиться, если хочешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650223,
					"content": "Зачем вообще надо было его писать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650213,
					"content": "Переждать на винокурне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650214
					]
				},
				{
					"id": 4650214,
					"content": "И оставить всю работу рыцарям?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650215
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650215,
					"content": "Будь они под стать заданию, дело бы до такого не дошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650216
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650216,
					"content": "Ситуация не настолько серьёзная, чтобы мне пришлось залечь на дно и оставить рыцарей разбираться с последствиями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "Дилюк"
				}
			]
		},
