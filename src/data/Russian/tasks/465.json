		{
			"id": 46504,
			"completionStepIds": [
				46510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46510",
							"2"
						],
						"stepId": 46510,
						"stateName": "QUEST_STATE_UNFINISHED"
