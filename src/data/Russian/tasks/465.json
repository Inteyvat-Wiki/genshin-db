			},
			"dialogs": [
				{
					"id": 4650101,
					"content": "Хоффман!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4650102,
					"content": "Ах, это вы. Спасибо, что пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650103
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4650103,
					"content": "В тот раз мы говорили о Полуночном герое. Вы можете рассказать о нём что-нибудь ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650104,
						4650106
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4650104,
					"content": "Можно сначала спросить, в чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650105
					]
				},
				{
					"id": 4650105,
					"content": "Ах да, конечно, сперва я сам должен рассказать. Где мои манеры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4650108,
					"content": "Как бы то ни было, ситуация у нас такая. Взгляните.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650109
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4650109,
					"content": "Боги, ну и почерк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4650110,
					"content": "Можно посмотреть поближе? Хм, почти ничего не понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4650111,
					"content": "Именно. Написано хоть и на нашем языке, но больше напоминает какой-то шифр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650112
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4650112,
					"content": "Однако из незашифрованных частей можно понять общую суть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650119
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4650119,
					"content": "Это - официальное объявление войны Полуночному герою от Ордена Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650113
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4650113,
					"content": "Это значит, что злодеи хотят избавиться от Полуночного героя насовсем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4650114,
					"content": "Именно. Поэтому мы ищем способ с ним связаться, чтобы вместе подготовить ответные меры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650115
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4650115,
					"content": "В конце концов, это дело перестало касаться только Полуночного героя. Теперь оно касается всего Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650116,
						4650117
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4650116,
					"content": "Спасибо, что поделились с нами информацией.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650118,
					"content": "Если что-либо разузнаете, пожалуйста, сообщите мне в первую очередь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 4650117,
					"content": "Буду иметь в виду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650106,
					"content": "Простите, у меня ничего нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650107
					]
				},
				{
					"id": 4650107,
					"content": "Правда? Как жаль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Хоффман"
				}
			]
		},
		{
			"id": 46502,
			"completionStepIds": [
				46505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46505",
