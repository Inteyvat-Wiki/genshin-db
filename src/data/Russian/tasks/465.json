				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Допросить"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650401,
					"content": "Как вы меня здесь нашли?! Ордо Отбросиус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650402
					],
					"speakerTitle": "Допросить"
				},
				{
					"id": 4650402,
					"content": "Я не из Ордо Фавониус. А теперь говори! Каков ваш план?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650403
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650403,
					"content": "Письмо всё-таки дошло до тебя? Славно... Если думаешь, что я расскажу тебе все наши секреты, то ты глубоко заблуждаешься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650404
					],
					"speakerTitle": "Допросить"
				},
				{
					"id": 4650404,
					"content": "Похоже, ты не понимаешь, в какой ситуации оказался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651001
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4651001,
					"content": "Жечь <color=#00E1FFFF>Ладонью Огненной Кары</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651501
					]
				},
				{
					"id": 4651501,
					"content": "Ты используешь Глаз Бога, чтобы пускать пламя из рук? Ааа! Горячо!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650601
					],
					"speakerTitle": "Допросить"
				},
				{
					"id": 4650601,
					"content": "Поглядим, на сколько тебя хватит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650405
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4650405,
					"content": "Жечь <color=#00E1FFFF>Ладонью Огненной Кары</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651502
					]
				},
				{
					"id": 4651502,
					"content": "Стой! Остановись! П-пожалуйста, больно! Прошу... Не надо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650406,
						4651201
					],
					"speakerTitle": "Допросить"
				},
				{
					"id": 4650406,
					"content": "Жечь <color=#00E1FFFF>Ладонью Огненной Кары</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651402
					]
				},
				{
					"id": 4651402,
					"content": "Ух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651403
					],
					"speakerTitle": "Допросить"
				},
				{
					"id": 4651403,
					"content": "Притворяешься мёртвым? Этого огня не хватило бы даже... Хм. Похоже, он и вправду <color=#00E1FFFF>потерял сознание</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651404
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4651404,
					"content": "Эй! Будешь спать, когда я разрешу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651405
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4651405,
					"content": "ААА!!! Горячо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650901
					],
					"speakerTitle": "Допросить"
				},
				{
					"id": 4650901,
					"content": "Я скажу, всё скажу! Ау-ау-ау... П-прошу, не надо! Я <color=#00E1FFFF>всё</color> скажу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650902
					],
					"speakerTitle": "Допросить"
				},
				{
					"id": 4650902,
					"content": "Орден... Они собрали силу, которую объединяет ненависть к Полуночному герою...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650903
					],
					"speakerTitle": "Допросить"
				},
				{
					"id": 4650903,
					"content": "...и они двинутся к <color=#00E1FFFF>городским воротам</color> Мондштадта завтра в 10 вечера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650904
					],
					"speakerTitle": "Допросить"
				},
				{
					"id": 4650904,
					"content": "Я больше ничего не знаю... Пожалуйста... Не надо меня больше жечь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650905
					],
					"speakerTitle": "Допросить"
				},
				{
					"id": 4650905,
					"content": "Это всё? Хм. Надеюсь, ты не настолько глуп, чтобы скрывать что-то ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 4651201,
					"content": "Попробовать <color=#00E1FFFF>расспросить</color> о планах атаки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650901
					]
				}
			]
		},
		{
			"id": 46505,
