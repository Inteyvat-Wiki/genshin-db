			"dialogs": [
				{
					"id": 745310101,
					"content": "#{NICKNAME}, Паймон, вы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310102,
						745310103
					],
					"speakerTitle": "Нинетт"
				},
				{
					"id": 745310102,
					"content": "В этот раз мы сделали много снимков.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				},
				{
					"id": 745310104,
					"content": "Прекрасно! Большое вам спасибо за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310105
					],
					"speakerTitle": "Нинетт"
				},
				{
					"id": 745310105,
					"content": "Пока вы помогали мне с фотографиями, я подумала, что не могу сидеть и ничего не делать, иначе ничего не достигну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310106
					],
					"speakerTitle": "Нинетт"
				},
				{
					"id": 745310106,
					"content": "Поэтому я набралась храбрости и обратилась к прохожим. Я постаралась сделать несколько снимков сама! Думаю, теперь тестовых данных должно хватить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310107
					],
					"speakerTitle": "Нинетт"
				},
				{
					"id": 745310107,
					"content": "#Хм-хм, недаром ты моя ученица! И спасибо, {NICKNAME}, за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310108
					],
					"speakerTitle": "Лепин-Полин"
				},
				{
					"id": 745310108,
					"content": "Лепин-Полин! Когда ты вернулась? Нинетт сказала, что в последнее время ты занята другими делами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745310109,
					"content": "Я была занята большой-пребольшой сделкой, которая принесла мне кучу денег!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310110
					],
					"speakerTitle": "Лепин-Полин"
				},
				{
					"id": 745310110,
					"content": "У меня не было и минуты свободного времени. Спасибо, что позаботились о Нинетт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310111
					],
					"speakerTitle": "Лепин-Полин"
				},
				{
					"id": 745310111,
					"content": "У неё есть и талант, и вкус, вот только она немного робкая. С вашей помощью она сделала важный шаг вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310112
					],
					"speakerTitle": "Лепин-Полин"
				},
				{
					"id": 745310112,
					"content": "Ну и что же за сделка такая? Как же всё загадочно... Только не говори, что снова услышала какую-то странную новость и решила вложить все свои сбережения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745310113,
					"content": "Конечно же нет! Я, Лепин-Полин, умею учиться на своих ошибках! На этот раз это действительно стопроцентный, беспроигрышный суперпроект!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310114
					],
					"speakerTitle": "Лепин-Полин"
				},
				{
					"id": 745310114,
					"content": "(Как-то слабовато верится...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310115
					]
				},
				{
					"id": 745310115,
					"content": "Сейчас рассказывать рано. Вот когда всё будет готово, тогда я первым делом приглашу вас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лепин-Полин"
				},
				{
					"id": 745310103,
					"content": "Объектив «Особые мгновения» работает отлично.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				}
			]
		}
	]
}