					}
				]
			},
			"dialogs": [
				{
					"id": 716664001,
					"content": "Привет! Это снова я! Ну что, как продвигаются дела с Подготовительным лагерем Аратаки для боевых жуков?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664002
					],
					"speakerTitle": "Участник с мощным снаряжением"
				},
				{
					"id": 716664002,
					"content": "Ты как раз вовремя, Янь Фэй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716664003,
					"content": "Благодетельница! Спасибо за помощь с разрешением! И за эпичную вывеску!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664004
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716664004,
					"content": "Погоди, мне знаком этот взгляд... Ты тоже хочешь перевернуть какого-нибудь жука?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664005
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716664005,
					"content": "А? А что, нельзя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664006
					],
					"speakerTitle": "Участник с мощным снаряжением"
				},
				{
					"id": 716664006,
					"content": "У меня есть одна серьёзная клиентка, которая занимается международной торговлей. Так вот, однажды она осыпала меня подарками после того, как я помогла ей выиграть крупный судебный процесс, и среди них был очень необычный оникабуто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664007
					],
					"speakerTitle": "Участник с мощным снаряжением"
				},
				{
					"id": 716664007,
					"content": "В то время я не знала, как за ним ухаживать, и попросила бабушку позаботиться о нём. Сейчас он выглядит вполне прилично...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664008
					],
					"speakerTitle": "Участник с мощным снаряжением"
				},
				{
					"id": 716664008,
					"content": "Не возражаешь, если я присоединюсь? Ты же не боишься, что я не впишусь в твой стиль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664009
					],
					"speakerTitle": "Участник с мощным снаряжением"
				},
				{
					"id": 716664009,
					"content": "Нельзя сбрасывать со счетов вашу благодетельницу, король óни. Недостаток опыта она компенсирует одним из самых крепких и внушающих благоговение оникабуто, которых я когда-либо видел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664010
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 716664010,
					"content": "Это предложение, от которого я не могу отказаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664011
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716664011,
					"content": "Так, пора выдвинуть Правую руку короля óни с Алым воином. Я знаю, что дружище сохранит хладнокровие под любым натиском!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664012,
						716664013
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716664012,
					"content": "Даже не сомневайся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				},
				{
					"id": 716664014,
					"content": "#Значит, против меня выступит {NICKNAME}? Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664015
					],
					"speakerTitle": "Участник с мощным снаряжением"
				},
				{
					"id": 716664015,
					"content": "Я пока не совсем разобралась, как играть, поэтому заранее прошу прощения за возможные ошибки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Участник с мощным снаряжением"
				},
				{
					"id": 716664013,
					"content": "Благодарю за доверие!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				}
			]
		},
