			},
			"dialogs": [
				{
					"id": 716664101,
					"content": "Оникабуто Янь Фэй очень сильный! Интересно, чем мадам Пин его кормила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716664102,
					"content": "Видишь? Оникабуто твоей благодетельницы - это сила, с которой следует считаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664103
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 716664103,
					"content": "Но, как и в прошлый раз, когда мои генералы преподнесли тебе несколько неожиданных сюрпризов, самый могучий клинок не сможет сразить врага иначе, как в руках искусного мастера меча.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664104
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 716664104,
					"content": "О-о-очень мудрые слова, гранд-мастер... О-о-о-о... Хорошо, что дружище сохранил самообладание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664105
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716664105,
					"content": "Ух ты, потрясающе! Мне определённо нравятся бои жуков!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664106
					],
					"speakerTitle": "Участник с мощным снаряжением"
				},
				{
					"id": 716664106,
					"content": "Это так весело! Спасибо всем! Я останусь и поиграю ещё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Участник с мощным снаряжением"
				}
			]
		},
