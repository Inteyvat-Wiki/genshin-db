			},
			"dialogs": [
				{
					"id": 715040101,
					"content": "Кхе-кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040102
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715040102,
					"content": "Хуссени, ты как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 715040103,
					"content": "Чтобы придумать, как доставить шип Пурсины к выходу артерий земли, я провёл много времени в штольне и подвергся некоторому влиянию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040104
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715040104,
					"content": "Но это неопасно, я уже восстановил силы после небольшого отдыха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040105
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715040105,
					"content": "Тогда же я придумал план. Вот только придумать способ транспортировки шипа Пурсины посложнее, чем предлог для задержки сроков сдачи отчёта об исследованиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040106
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715040106,
					"content": "Если чёрная грязь покрывает землю, то преодолеть её можно по воздуху, аэростат как раз подойдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040107
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715040107,
					"content": "Аэростат - неплохая идея.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 715040108,
					"content": "Конечно, в какой-то степени она поможет решить проблему. Но большое количество чёрной грязи может заблокировать проход и помешать движению аэростата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040109
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715040109,
					"content": "И ещё чёрная грязь может привлечь монстров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040110
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715040110,
					"content": "Боюсь, с этим придётся разбираться вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040111
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715040111,
					"content": "#Не волнуйся, {NICKNAME} и Паймон смогут отогнать всех монстров, которые будут приближаться к аэростату.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040112,
						715040113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 715040112,
					"content": "Хочу посмотреть, как ты будешь этим заниматься.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				},
				{
					"id": 715040114,
					"content": "Паймон отвечает за моральную поддержку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 715040115,
					"content": "Ха-ха-ха, кхе-кхе... кхе-кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040116
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715040116,
					"content": "Так сильно смеялся, аж закашлялся... Ту и Хао помогут упаковать шип Пурсины и подготовить аэростат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040117
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715040117,
					"content": "Сначала я сам хотел упаковать шипы Пурсины, но теперь у меня от кашля руки трясутся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040118
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715040118,
					"content": "Мне так стыдно, кажется, мне следует заниматься не только академическими исследованиями, но и уделять внимание физическим упражнениям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040119
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715040119,
					"content": "Скорее разыщи их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715040113,
					"content": "Я одолжу тебе ненадолго свой меч.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				}
			]
		},
		{
			"id": 7150402,
