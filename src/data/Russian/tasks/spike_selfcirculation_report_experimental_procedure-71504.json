				"points": []
			},
			"dialogs": [
				{
					"id": 715040201,
					"content": "#{NICKNAME}, мы только всё упаковали, и ты уже здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040202
					],
					"speakerTitle": "Ту"
				},
				{
					"id": 715040202,
					"content": "Тот парень из Сумеру уже сказал тебе, что нужно использовать аэростат?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040203
					],
					"speakerTitle": "Ту"
				},
				{
					"id": 715040203,
					"content": "Что ещё за «тот парень из Сумеру»? Хуссени пришёл помочь нам убрать чёрную грязь, он большой учёный в Сумеру, прояви хоть каплю уважения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040204
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 715040204,
					"content": "Да ладно тебе, я просто по-свойски его называю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040205
					],
					"speakerTitle": "Ту"
				},
				{
					"id": 715040205,
					"content": "Ладно, аэростат готов, прибор, очищающий от чёрной грязи, тоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040206
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 715040206,
					"content": "#{NICKNAME}, если тебе нужна помощь суперзвезды шахт... Кхе-кхе... Кхе... Забудь, не думаю, что от меня будет толк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040207
					],
					"speakerTitle": "Ту"
				},
				{
					"id": 715040207,
					"content": "Ладно, отдохни хорошенько.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040208
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 715040208,
					"content": "#Так, если ты готов{F#а} выдвигаться, то можно запустить аэростат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ту"
				}
			]
		},
