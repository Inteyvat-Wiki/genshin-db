				},
				{
					"id": 150200502,
					"content": "Я верю в неё!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200503
					]
				},
				{
					"id": 150200503,
					"content": "Хорошо, тогда расправь крылья и лети!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Инканак"
				},
				{
					"id": 150200504,
					"content": "Мне нужно подготовиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
