			"dialogs": [
				{
					"id": 150200601,
					"content": "Это было потрясающе! Паймон не могла оторвать глаз от тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150200602,
					"content": "Ну что, есть проблемы с ареной?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200603
					]
				},
				{
					"id": 150200603,
					"content": "Хм... Нет, ничего особенного. Через несколько дней сможем провести испытания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200604
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150200604,
					"content": "Спасите!.. Спаси-и-ите!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200605
					],
					"speakerTitle": "Исидор"
				},
				{
					"id": 150200605,
					"content": "...Вы из клана Цветочного Пера? Пожалуйста, скорее, вы должны нам помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200606
					],
					"speakerTitle": "Исидор"
				},
				{
					"id": 150200606,
					"content": "Для начала успокойся. Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200607
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 150200607,
					"content": "Мы... На нас напал кукузавр!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200608
					],
					"speakerTitle": "Исидор"
				},
				{
					"id": 150200608,
					"content": "Мои друзья застряли посреди дороги с товаром... Пожалуйста, умоляю вас, спасите их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200609
					],
					"speakerTitle": "Исидор"
				},
				{
					"id": 150200609,
					"content": "А? Неужели кукузавры настолько агрессивны? Они часто нападают на людей без предупреждения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150200610,
					"content": "На моей памяти такого не было... но из каждого правила есть исключения. Давайте проверим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Часка"
				}
			]
		},
