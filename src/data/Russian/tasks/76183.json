			"dialogs": [
				{
					"id": 761830201,
					"content": "Иногда нужно и отдыхать от работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830202,
						761830203
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 761830202,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761830204,
					"content": "Хорошо. Увидимся в Снежной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 761830203,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
