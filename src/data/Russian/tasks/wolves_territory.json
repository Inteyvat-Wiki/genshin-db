			"dialogs": [
				{
					"id": 4510501,
					"content": "Вы правда поможете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510502
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510502,
					"content": "Волки охотятся сами. Всегда хорошо. Но ловушка - это интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510503
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510503,
					"content": "Ставим ловушку, гоним кабана. Да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510504
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510504,
					"content": "Не взорвись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рэйзор"
				}
			]
		},
		{
