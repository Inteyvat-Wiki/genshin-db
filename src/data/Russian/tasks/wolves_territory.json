			},
			"dialogs": [
				{
					"id": 4510101,
					"content": "Это Вольфендом! Жители Мондштадта редко здесь бывают...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510102,
					"content": "Несмотря на близость города, это место почти не тронуто цивилизацией. Здесь царят законы природы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510103,
					"content": "Выживает сильнейший! Даже слаймы здесь просто огрооомные!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510104,
					"content": "Такие вот здоровенные!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510105,
					"content": "Ой, они нас заметили. Готовься к бою!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 45103,
			"completionStepIds": [
				45104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45104",
							"2"
						],
						"stepId": 45104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рэйзор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4510301,
					"content": "Сп... Спасибо... А-а-а! Волки! Бежим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510303,
					"content": "Не бойтесь. Волки - друзья. А вы кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510304
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510304,
					"content": "Обычные путешественники. Просто проходили мимо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510305,
					"content": "Вы пахнете... знакомо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510306
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510306,
					"content": "Мы пахнем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510307,
					"content": "Ордо Фавониус, верно? Рыцари - друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510308,
						4510309
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510308,
					"content": "Как тебя зовут?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510310
					]
				},
				{
					"id": 4510310,
					"content": "Я Рэйзор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510311
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510311,
					"content": "Ты тоже рыцарь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510312,
					"content": "Нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510314,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510315,
					"content": "Что это за волки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510316
					]
				},
				{
					"id": 4510316,
					"content": "Моя стая. Моя семья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510317
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510317,
					"content": "Семья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510318,
					"content": "Семья. Я рос с ними. Я живу с ними. Семья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510319
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510319,
					"content": "У меня очень много вопросов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510320,
					"content": "Они сейчас злые. Я помог тебе. Засада не получилась. Кабан убежал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510321
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510321,
					"content": "#Не переживай. Паймон попросит - {NICKNAME} поймает вам кабана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510322,
					"content": "#{NICKNAME} - отличн{M#ый}{F#ая} охотни{M#к}{F#ца}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510323,
					"content": "Не надо. Рыцари помогают, волки голодают. Так всегда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510324
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510324,
					"content": "У нас получится, вот увидишь! Жди здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510309,
					"content": "Ты тоже рыцарь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510313
					]
				},
				{
					"id": 4510313,
					"content": "Я Рэйзор. Я не рыцарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "Рэйзор"
				}
			]
		},
		{
			"id": 45105,
