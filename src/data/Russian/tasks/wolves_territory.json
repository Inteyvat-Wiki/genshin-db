					"Рэйзор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4510601,
					"content": "Я же говорила!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510602,
					"content": "Спасибо! Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510603
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510603,
					"content": "Стая охотится. Ловит пять или шесть кабанов. Сегодня опять голодные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510604
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510604,
					"content": "Ох.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510605,
					"content": "Всё хорошо. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510606
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510606,
					"content": "Вы лучше, чем другой рыцарь. Красная девушка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510607
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510607,
					"content": "Она бы сожгла весь лес. Не поймали бы ни одного кабана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510608
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510608,
					"content": "Я пойду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510609
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510609,
					"content": "Здесь опасно. Берегите себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510610
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 4510610,
					"content": "Он такой странный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510611,
					"content": "Красная девушка? Из ордена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4510612,
					"content": "#{NICKNAME}, как ты думаешь, кто это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
