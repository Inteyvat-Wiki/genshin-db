	"talks": [
		{
			"id": 202102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202102",
							"2"
						],
						"stepId": 202102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Яэ Мико"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20210201,
					"content": "#А вот и {F#наша победоносная путешественница}{M#наш победоносный путешественник}. {F#Пришла}{M#Пришёл} в храм вознести молитву?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210202
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210202,
					"content": "Так ты ведь сама позвала нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210203,
					"content": "Ха-ха... шучу. Я как раз ждала вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210204
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210204,
					"content": "Похоже, у тебя хорошее настроение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210205,
					"content": "А как же! Я была рада встретить старого друга, с которым не виделась уже много лет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210206
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210206,
					"content": "#Между прочим... я слышала, что ты {F#сошлась}{M#сошёлся} в дворцовой дуэли с самим Предвестником Фатуи. Смелый и умный поступок. Я горжусь тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210207,
						20210208
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210207,
					"content": "Меня просто вдруг осенило.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210209
					]
				},
				{
					"id": 20210209,
					"content": "#Ты {F#одолела}{M#одолел} Синьору в равном бою, а значит, твоя сила превзошла все мои ожидания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210210
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210210,
					"content": "#Главное, что ты {F#победила}{M#победил}. Мои поздравления!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210211
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210211,
					"content": "Хе-хе, здорово хоть разок расстроить планы Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210212,
					"content": "Они причинили немало вреда, но хоть не получили Сердце Бога!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210213,
					"content": "Погодите... Вы упомянули «Сердце Бога»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210214
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210214,
					"content": "Эта такая штучка, похожая на шахматную фигуру?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210215
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210215,
					"content": "Да, это оно и есть! Ты уже видела его? Сердца Бога принадлежат семи - они связывают их с Селестией!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210216,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210217
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210217,
					"content": "Ты чего это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210218,
					"content": "Я отдала его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210219
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210219,
					"content": "Что?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210220
					]
				},
				{
					"id": 20210220,
					"content": "...Ты что сделала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210221,
					"content": "Ну... а как мне ещё было спасти вас от Сказителя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210222,
						20210223
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210222,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210224
					]
				},
				{
					"id": 20210224,
					"content": "Сказитель - номер шесть из Предвестников Фатуи. По силе он превосходит Синьору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210225
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210225,
					"content": "Я не из тех, кто просто так станет рисковать жизнью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210226
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210226,
					"content": "У Паймон впервые нет слов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210227
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210227,
					"content": "Но почему Сердце Бога было у тебя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210228
					]
				},
				{
					"id": 20210228,
					"content": "Когда Эи создала куклу, ей больше некуда было его класть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210229
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210229,
					"content": "Как самому близкому другу... Эи передала его мне, и с тех пор я хранила его в Великом храме Наруками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210230
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210230,
					"content": "Ей больше не нужна сила Сердца Бога. Также она говорила, что порвала с Селестией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210231
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210231,
					"content": "Таким образом, Сердце Бога не только бесполезно, но и может стать причиной конфликта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210232
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210232,
					"content": "Обменять его на главное действующее лицо моего плана было очень выгодно, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210233
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210233,
					"content": "Судя по результату, я заключила отличную сделку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210234
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210234,
					"content": "#Раз уж ты так говоришь, Паймон может лишь согласиться... Путешественни{F#ца}{M#к} намного ценнее Сердца Бога...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210235,
						20210236
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210235,
					"content": "Неудивительно, что Сказителя как ветром сдуло.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210237
					]
				},
				{
					"id": 20210237,
					"content": "А, ну и ладно. Что сделано, то сделано. Оставим это в прошлом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210238,
					"content": "Эм... Мико, ты ещё не сказала, зачем позвала нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210239
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210239,
					"content": "Хе-хе, чтобы отблагодарить вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210240
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210240,
					"content": "Правда?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210241,
					"content": "Вы собираетесь обойти весь Тейват. Ваше путешествие по Инадзуме подошло к концу, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210242
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210242,
					"content": "В знак признательности я отвечу на любые вопросы о пути предстоящем и о событиях прошлого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210243
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210243,
					"content": "Что бы тебе хотелось знать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210301,
					"content": "Расскажи о кукле сёгуна...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210302
					]
				},
				{
					"id": 20210302,
					"content": "Знания, по которым создавали эту куклу, уже утеряны. Наверное, лишь ей, как божеству, известно их происхождение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210303
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210303,
					"content": "Но... одна вещь может быть для вас интересной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210304
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210304,
					"content": "Прежде чем Эи начала преобразовывать свою божественную форму, она создала прототип куклы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210305
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210305,
					"content": "В-выходит, существует три сёгуна Райдэн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210306,
					"content": "Нет, прототип этот должен был лишь показать, что такое творение осуществимо. Его внешность и интеллект не были выполнены по образу Эи. Можно сказать, он был пробным изделием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210307
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210307,
					"content": "Сначала Эи собиралась просто от него избавиться. Быть может, она сочла это слишком жестоким, поэтому она решила только запечатать его силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210308
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210308,
					"content": "Потом эта кукла бродила по Инадзуме в виде обычного человека с собственным сознанием, пока... им не заинтересовались Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210309
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210309,
					"content": "Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210310,
					"content": "Сумрачные гении Фатуи внесли в прототип свои коррективы, не только разблокировав его силу, но и, похоже, сделав его сильнее, чем задумывалось изначально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210311
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210311,
					"content": "Неужели...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210312
					]
				},
				{
					"id": 20210312,
					"content": "Ага. Это божественное создание и есть тот, кто завладел Сердцем Бога... Сейчас этот прототип известен как Сказитель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210313
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210313,
					"content": "Вот это поворот!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210314,
					"content": "Да. Кто знает, совпадение это или ирония судьбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210401,
					"content": "Расскажи о прошлом сёгуне Райдэн...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210402
					]
				},
				{
					"id": 20210402,
					"content": "#Почти никто в Инадзуме не знает, что Электро Архонт однажды сменился... Удивительно, что тебе, {F#чужестранке}{M#чужестранцу}, это известно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210403
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210403,
					"content": "Нам Моракс рассказывал, что Электро Архонт, Баал, погибла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210404,
					"content": "Да. На самом деле, было два Архонта-близнеца, Баал и Вельзевул.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210405
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210405,
					"content": "...Архонты-близнецы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210406,
					"content": "Вместе они победили в Войне Архонтов, а когда Баал основала сёгунат, Вельзевул стала её кагэмуся, или «воином тени».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210407
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210407,
					"content": "Вельзевул и есть Эи, с которой мы знакомы. А Баал звали «Макото».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210408
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210408,
					"content": "Мир видел не двоих, а одного Архонта. Они дополняли друг друга и вместе правили Инадзумой, поэтому людям не было необходимости знать правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210409
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210409,
					"content": "Собственно, имя «Баал» и титул сёгун Райдэн относились к ним обеим до тех пор, пока...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210410
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210410,
					"content": "Пока что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210411,
					"content": "Несколько сотен лет тому назад Макото погибла в войне, в которой я не участвовала. С тех пор сёгунатом правила Эи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210412
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210412,
					"content": "Потеря сестры, должно быть, стала для неё ударом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210413,
						20210414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210413,
					"content": "Несколько столетий назад...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210415,
					"content": "С тех пор Эи начала меняться. Это было её величайшей утратой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210416
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210416,
					"content": "Кажется, Паймон стала лучше понимать Эи... Каким Архонтом была Макото?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210417,
					"content": "Я знала её не так долго, но... Она показалась мне мягким божеством, которая всегда ценила окружающую её красоту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210418
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210418,
					"content": "Ясно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210501,
					"content": "#Расскажи о {F#моём брате}{M#моей сестре}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210502
					]
				},
				{
					"id": 20210502,
					"content": "Прости, не имею ни малейшего понятия. И божество, которое вы упоминали, мне тоже незнакомо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210503
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210503,
					"content": "Сомнения насчёт Эи, если у тебя таковые остались, не обоснованы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210504
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210504,
					"content": "Она не только не подходит под описание, но и давно отказалась от Сердца Бога, порвав с Селестией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210505
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210505,
					"content": "После встречи с ней мне не кажется, что это она.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210506
					]
				},
				{
					"id": 20210506,
					"content": "Хорошо это слышать. Я её фамильяр, и из-за этого наши с тобой отношения могли стать несколько неловкими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210507
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210507,
					"content": "Не бойся, мы не собираемся драться с тобой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210508,
					"content": "Хе-хе-хе... Желаю вам удачи. Да откроется вам истина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210509
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210509,
					"content": "#Что же до местонахождения {M#твоей сестры}{F#твоего брата}, я задействую все средства для расследования, включая нескольких людей Аято из Сюмацубан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210510
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210510,
					"content": "Я дам тебе знать, если будут новости. Считай это частью моей благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210601,
					"content": "Расскажи, куда мне предстоит отправиться дальше...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210602
					]
				},
				{
					"id": 20210602,
					"content": "Думаю, после Инадзумы... будет удобно отправиться в Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210603
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210603,
					"content": "О, Сумеру! По пути нам повстречалось немало учёных оттуда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210604,
					"content": "Ну да, Сумеру - государство Архонта мудрости. Поиск мудрости и знаний там бесконечен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210605
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210605,
					"content": "Но эта их одержимость приводит к непостижимым вещам, к примеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210606
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210606,
					"content": "...В Сумеру знаниями управляют как ресурсом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210607
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210607,
					"content": "Знания... это ресурс?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210608,
					"content": "Да. Кто именно это придумал, мудрецы или малая властительница Кусанали, я не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210609
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210609,
					"content": "Малый властитель Кусанали? Какое миленькое имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210610,
					"content": "О, так вы не знаете? Это божество, в которое веруют люди Сумеру. А «малый властитель Кусанали» - ласковое прозвище, которое они ей дали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210611
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210611,
					"content": "Вероятно, вам есть что обсудить с ней? Желаю вам всего наилучшего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210701,
					"content": "У меня больше нет вопросов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210702
					]
				},
				{
					"id": 20210702,
					"content": "#Ты {M#уверен}{F#уверена}? Хорошо. Ах да, путешественни{F#ца}{M#к}, у тебя остался омамори, который я тебе дала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210703
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210703,
					"content": "Конечно. Я сохраню его.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210704
					]
				},
				{
					"id": 20210704,
					"content": "И всё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210705
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210705,
					"content": "#А я уже думала, что он будет красоваться у тебя на шее. А если бы кто-нибудь спросил, что это, ты бы с гордостью {F#ответила}{M#ответил}: «Это подарок от мудрой и прекрасной Яэ Мико».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210706
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210706,
					"content": "Да кто так вообще делает?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210707,
					"content": "#Хе-хе... ладно, ладно, больше не буду. Скажи, путешественни{F#ца}{M#к}, а какие надежды питаешь ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210708
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210708,
					"content": "#Наверное... встретиться с {F#братом}{M#сестрой}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210709
					]
				},
				{
					"id": 20210709,
					"content": "Вот как... но это же просто цель, которая заботит тебя в данный момент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210710
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210710,
					"content": "Твои стремления должны возноситься над землёй и затмевать звёзды, освещая саму судьбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210711
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210711,
					"content": "Быть может, потому у тебя нет Глаза Бога, что такие стремления ещё в тебе не зародились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210712
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210712,
					"content": "Продолжай своё путешествие, и такой момент настанет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210414,
					"content": "Каэнри'ах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210236,
					"content": "#Вот {F#какая}{M#какой} я, выходит, {F#ценная}{M#ценный}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210237
					]
				},
				{
					"id": 20210223,
					"content": "Значит, о нём можно забыть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210224
					]
				},
				{
					"id": 20210208,
					"content": "Даже не знаю, что на меня нашло.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210209
					]
				}
			]
		},
		{
			"id": 202103,
			"completionStepIds": [
				202102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202102",
							"2"
						],
						"stepId": 202102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Яэ Мико"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20210243,
					"content": "Что бы тебе хотелось знать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210301,
					"content": "Расскажи о кукле сёгуна...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210302
					]
				},
				{
					"id": 20210302,
					"content": "Знания, по которым создавали эту куклу, уже утеряны. Наверное, лишь ей, как божеству, известно их происхождение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210303
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210303,
					"content": "Но... одна вещь может быть для вас интересной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210304
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210304,
					"content": "Прежде чем Эи начала преобразовывать свою божественную форму, она создала прототип куклы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210305
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210305,
					"content": "В-выходит, существует три сёгуна Райдэн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210306,
					"content": "Нет, прототип этот должен был лишь показать, что такое творение осуществимо. Его внешность и интеллект не были выполнены по образу Эи. Можно сказать, он был пробным изделием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210307
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210307,
					"content": "Сначала Эи собиралась просто от него избавиться. Быть может, она сочла это слишком жестоким, поэтому она решила только запечатать его силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210308
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210308,
					"content": "Потом эта кукла бродила по Инадзуме в виде обычного человека с собственным сознанием, пока... им не заинтересовались Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210309
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210309,
					"content": "Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210310,
					"content": "Сумрачные гении Фатуи внесли в прототип свои коррективы, не только разблокировав его силу, но и, похоже, сделав его сильнее, чем задумывалось изначально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210311
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210311,
					"content": "Неужели...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210312
					]
				},
				{
					"id": 20210312,
					"content": "Ага. Это божественное создание и есть тот, кто завладел Сердцем Бога... Сейчас этот прототип известен как Сказитель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210313
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210313,
					"content": "Вот это поворот!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210314,
					"content": "Да. Кто знает, совпадение это или ирония судьбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210401,
					"content": "Расскажи о прошлом сёгуне Райдэн...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210402
					]
				},
				{
					"id": 20210402,
					"content": "#Почти никто в Инадзуме не знает, что Электро Архонт однажды сменился... Удивительно, что тебе, {F#чужестранке}{M#чужестранцу}, это известно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210403
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210403,
					"content": "Нам Моракс рассказывал, что Электро Архонт, Баал, погибла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210404,
					"content": "Да. На самом деле, было два Архонта-близнеца, Баал и Вельзевул.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210405
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210405,
					"content": "...Архонты-близнецы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210406,
					"content": "Вместе они победили в Войне Архонтов, а когда Баал основала сёгунат, Вельзевул стала её кагэмуся, или «воином тени».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210407
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210407,
					"content": "Вельзевул и есть Эи, с которой мы знакомы. А Баал звали «Макото».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210408
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210408,
					"content": "Мир видел не двоих, а одного Архонта. Они дополняли друг друга и вместе правили Инадзумой, поэтому людям не было необходимости знать правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210409
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210409,
					"content": "Собственно, имя «Баал» и титул сёгун Райдэн относились к ним обеим до тех пор, пока...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210410
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210410,
					"content": "Пока что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210411,
					"content": "Несколько сотен лет тому назад Макото погибла в войне, в которой я не участвовала. С тех пор сёгунатом правила Эи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210412
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210412,
					"content": "Потеря сестры, должно быть, стала для неё ударом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210413,
						20210414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210413,
					"content": "Несколько столетий назад...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210415,
					"content": "С тех пор Эи начала меняться. Это было её величайшей утратой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210416
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210416,
					"content": "Кажется, Паймон стала лучше понимать Эи... Каким Архонтом была Макото?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210417,
					"content": "Я знала её не так долго, но... Она показалась мне мягким божеством, которая всегда ценила окружающую её красоту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210418
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210418,
					"content": "Ясно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210501,
					"content": "#Расскажи о {F#моём брате}{M#моей сестре}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210502
					]
				},
				{
					"id": 20210502,
					"content": "Прости, не имею ни малейшего понятия. И божество, которое вы упоминали, мне тоже незнакомо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210503
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210503,
					"content": "Сомнения насчёт Эи, если у тебя таковые остались, не обоснованы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210504
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210504,
					"content": "Она не только не подходит под описание, но и давно отказалась от Сердца Бога, порвав с Селестией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210505
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210505,
					"content": "После встречи с ней мне не кажется, что это она.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210506
					]
				},
				{
					"id": 20210506,
					"content": "Хорошо это слышать. Я её фамильяр, и из-за этого наши с тобой отношения могли стать несколько неловкими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210507
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210507,
					"content": "Не бойся, мы не собираемся драться с тобой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210508,
					"content": "Хе-хе-хе... Желаю вам удачи. Да откроется вам истина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210509
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210509,
					"content": "#Что же до местонахождения {M#твоей сестры}{F#твоего брата}, я задействую все средства для расследования, включая нескольких людей Аято из Сюмацубан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210510
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210510,
					"content": "Я дам тебе знать, если будут новости. Считай это частью моей благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210601,
					"content": "Расскажи, куда мне предстоит отправиться дальше...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210602
					]
				},
				{
					"id": 20210602,
					"content": "Думаю, после Инадзумы... будет удобно отправиться в Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210603
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210603,
					"content": "О, Сумеру! По пути нам повстречалось немало учёных оттуда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210604,
					"content": "Ну да, Сумеру - государство Архонта мудрости. Поиск мудрости и знаний там бесконечен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210605
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210605,
					"content": "Но эта их одержимость приводит к непостижимым вещам, к примеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210606
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210606,
					"content": "...В Сумеру знаниями управляют как ресурсом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210607
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210607,
					"content": "Знания... это ресурс?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210608,
					"content": "Да. Кто именно это придумал, мудрецы или малая властительница Кусанали, я не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210609
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210609,
					"content": "Малый властитель Кусанали? Какое миленькое имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210610,
					"content": "О, так вы не знаете? Это божество, в которое веруют люди Сумеру. А «малый властитель Кусанали» - ласковое прозвище, которое они ей дали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210611
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210611,
					"content": "Вероятно, вам есть что обсудить с ней? Желаю вам всего наилучшего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210701,
					"content": "У меня больше нет вопросов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210702
					]
				},
				{
					"id": 20210702,
					"content": "#Ты {M#уверен}{F#уверена}? Хорошо. Ах да, путешественни{F#ца}{M#к}, у тебя остался омамори, который я тебе дала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210703
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210703,
					"content": "Конечно. Я сохраню его.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210704
					]
				},
				{
					"id": 20210704,
					"content": "И всё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210705
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210705,
					"content": "#А я уже думала, что он будет красоваться у тебя на шее. А если бы кто-нибудь спросил, что это, ты бы с гордостью {F#ответила}{M#ответил}: «Это подарок от мудрой и прекрасной Яэ Мико».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210706
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210706,
					"content": "Да кто так вообще делает?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20210707,
					"content": "#Хе-хе... ладно, ладно, больше не буду. Скажи, путешественни{F#ца}{M#к}, а какие надежды питаешь ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210708
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210708,
					"content": "#Наверное... встретиться с {F#братом}{M#сестрой}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210709
					]
				},
				{
					"id": 20210709,
					"content": "Вот как... но это же просто цель, которая заботит тебя в данный момент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210710
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210710,
					"content": "Твои стремления должны возноситься над землёй и затмевать звёзды, освещая саму судьбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210711
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210711,
					"content": "Быть может, потому у тебя нет Глаза Бога, что такие стремления ещё в тебе не зародились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210712
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210712,
					"content": "Продолжай своё путешествие, и такой момент настанет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20210414,
					"content": "Каэнри'ах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				}
			]
		}
	]
}