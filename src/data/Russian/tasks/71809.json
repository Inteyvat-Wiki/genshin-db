			"trigger": {
				"objectNames": [
					"Цин Чжоу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090401,
					"content": "Есть ли плоды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090402
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718090402,
					"content": "Изрядно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090403
					]
				},
				{
					"id": 718090403,
					"content": "Ах, изрядно? Извольте рассказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090404
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718090404,
					"content": "У южного причала много собак.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090405
					]
				},
				{
					"id": 718090405,
					"content": "Ах, прелестно, очень живописно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090406
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718090406,
					"content": "У хижины «Бубу» много зябликов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090407
					]
				},
				{
					"id": 718090407,
					"content": "Зяблики, ах... Как живописно, как лирично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090408
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718090408,
					"content": "Некоторым лишь бы пожрать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090409
					]
				},
				{
					"id": 718090409,
					"content": "Тоже прекрасно. Еда - первейшее дело. Особенно в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090410
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718090410,
					"content": "Есть в этом своя прелесть. Я запишу, однажды пригодится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090411
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718090411,
					"content": "Кто-то думает, что всё меняется слишком быстро.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090412
					]
				},
				{
					"id": 718090412,
					"content": "Да, это вполне естественно. Действительно, ныне в Ли Юэ большие перемены, и некоторые из них не нравятся и мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090413
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718090413,
					"content": "Однако эта тема необъятна. Боюсь, одним стихом не охватить... Но я всё же запишу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090414
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718090414,
					"content": "Довольно этого, я рад, что попросил вас о помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090415
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718090415,
					"content": "Пожалуй, в следующем сборнике увидим несколько новых стихов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090416
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718090416,
					"content": "Ах да, кроме земных благ примите и небольшой личный подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090417
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718090417,
					"content": "Когда выйдет мой сборник стихов, вы сможете обменять эту подпись на книгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цин Чжоу"
				}
			]
		},
