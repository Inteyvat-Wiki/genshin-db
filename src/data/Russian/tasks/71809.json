			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хао"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090201,
					"content": "Неплохо, неплохо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090202
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 718090202,
					"content": "Что неплохо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090203
					]
				},
				{
					"id": 718090203,
					"content": "#А, путешественн{F#ица}{M#ик}. В городе ведь такое дело случилось, так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090204
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 718090204,
					"content": "Неплохо, что потом беспорядка большого не было. А самое главное, что рестораны все открыты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090205
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 718090205,
					"content": "А то где бы я все свои любимые блюда ел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090206
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 718090206,
					"content": "А, так ты про еду...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090207
					]
				},
				{
					"id": 718090207,
					"content": "Не стоит недооценивать еду. Самый простой способ понять, хорош город или плох, - это попробовать местную еду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090208
					],
					"speakerTitle": "Хао"
				},
				{
					"id": 718090208,
					"content": "Ах, от этих разговоров есть захотелось. Пойду ещё поем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хао"
				}
			]
		},
		{
			"id": 7180903,
			"completionStepIds": [
				7180906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180906",
							"2"
						],
						"stepId": 7180906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дедуля Фаньэр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090301,
					"content": "Чем больше слушаю, тем меньше понимаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090302
					],
					"speakerTitle": "Дедуля Фаньэр"
				},
				{
					"id": 718090302,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090303
					]
				},
				{
					"id": 718090303,
					"content": "#О, путешественн{F#ица}{M#ик}. В чайном доме «Хэюй» новые оперы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090304
					],
					"speakerTitle": "Дедуля Фаньэр"
				},
				{
					"id": 718090304,
					"content": "Но эти оперы... Шумно-то оно шумно, но я что-то ничего не понимаю, а молодёжи нравится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090305
					],
					"speakerTitle": "Дедуля Фаньэр"
				},
				{
					"id": 718090305,
					"content": "Вы что думаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090306
					]
				},
				{
					"id": 718090306,
					"content": "Как бы это... Я бы лучше старые оперы послушал, уже и привык за столько лет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090307
					],
					"speakerTitle": "Дедуля Фаньэр"
				},
				{
					"id": 718090307,
					"content": "Но сейчас ведь весь Ли Юэ меняется. Пожалуй, пара новых опер не помешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090308
					],
					"speakerTitle": "Дедуля Фаньэр"
				},
				{
					"id": 718090308,
					"content": "Эх, но очень уж быстро это всё. Давно старых опер не было. Даже не знаю, Властелин... Нет, не стоит об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дедуля Фаньэр"
				}
			]
		},
		{
			"id": 7180904,
			"completionStepIds": [
				7180909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
