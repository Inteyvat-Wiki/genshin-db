			"dialogs": [
				{
					"id": 200230901,
					"content": "#Ты уже проведал{F#а} Нимрода?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230902
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230902,
					"content": "Он трезв как стёклышко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230903
					]
				},
				{
					"id": 200230903,
					"content": "Ты серьёзно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230904
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230904,
					"content": "К сожалению, у нас нет доказательств...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230905
					]
				},
				{
					"id": 200230905,
					"content": "Ничего страшного. У вас нет доказательств того, что он снова начал пить. Для меня этого достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230906
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230906,
					"content": "Будем считать его невиновным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230907
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230907,
					"content": "Если бы он снова запил, тебе не составило бы труда принести мне доказательства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230908
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230908,
					"content": "Прошу тебя, возьми это в награду за проделанную работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктория"
				}
			]
		}
	]
