			"dialogs": [
				{
					"id": 200230301,
					"content": "Здравствуй! Я могу чем-то помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230302
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 200230302,
					"content": "Расскажи мне о Нимроде...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230303
					]
				},
				{
					"id": 200230303,
					"content": "Он пьёт уже несколько часов. Только взгляни на его счёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230304
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 200230304,
					"content": "Если так продолжится, то надо будет звать Юри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230305
					],
					"speakerTitle": "Чарльз"
				},
				{
					"id": 200230305,
					"content": "Одолжить? Почему бы и нет? Но зачем вам это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чарльз"
				}
			]
		},
		{
