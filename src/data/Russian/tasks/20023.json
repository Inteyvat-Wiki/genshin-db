			"dialogs": [
				{
					"id": 200230401,
					"content": "#Ты уже проведал{F#а} Нимрода?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230402
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230402,
					"content": "Это счёт Нимрода в таверне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230403
					]
				},
				{
					"id": 200230403,
					"content": "Гм. Опять он за старое! Я так и знала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230404
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230404,
					"content": "Люди так легко забывают своё прошлое, если им не приходилось страдать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230405
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230405,
					"content": "Возьми это в качестве награды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230406
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230406,
					"content": "Что касается Нимрода... Мне нужно хорошенько над этим подумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктория"
				}
			]
		},
