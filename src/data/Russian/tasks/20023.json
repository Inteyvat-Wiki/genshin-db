			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нимрод"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230201,
					"content": "Ха-ха-ха! Каждый день я только и делаю, что жду этого момента!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230202
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200230202,
					"content": "#Я думал{F#а}, что ты бросил пить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230203
					]
				},
				{
					"id": 200230203,
					"content": "#А? Ты напугал{F#а} меня до смерти! Я подумал, что это моя жена!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230204
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200230204,
					"content": "Стаканчик-другой после тяжёлого рабочего дня помогает мне расслабиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230205
					],
					"speakerTitle": "Нимрод"
				},
				{
					"id": 200230205,
					"content": "Ладно, ладно! Допью и сразу домой. Жёнушка уже, вероятно, сходила за покупками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нимрод"
				}
			]
		},
		{
			"id": 2002303,
			"completionStepIds": [
				2002304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
