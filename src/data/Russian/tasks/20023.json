			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Виктория"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230101,
					"content": "Надеюсь, что он покается на этот раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230102
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230102,
					"content": "Покается в чём?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230103
					]
				},
				{
					"id": 200230103,
					"content": "Каждый день люди приходят ко мне, чтобы покаяться в своих грехах и попросить прощения у богов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230104
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230104,
					"content": "Но если слова не подкреплены действиями, то они ничего не стоят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230105
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230105,
					"content": "Взять, к примеру, Нимрода. На исповеди он много раз рассказывал о том, как хочет победить своё пристрастие к алкоголю, но он по-прежнему продолжает пить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230106
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230106,
					"content": "Если у тебя найдётся минутка, проведай его, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230107,
						200230110
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230107,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230108
					]
				},
				{
					"id": 200230108,
					"content": "Ах, да... Если он снова начал пить, то принеси мне какие-нибудь доказательства этого факта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230109
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230109,
					"content": "Тем, кто постоянно сбивается с праведного пути, необходимо протягивать руку помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230110,
					"content": "Употребление алкоголя считается грехом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230111
					]
				},
				{
					"id": 200230111,
					"content": "Алкоголь сам по себе не греховен, но напиваться до такого состояния, когда ты не можешь себя контролировать - это безусловно грех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230112
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230112,
					"content": "Если бы все вели себя так же безрассудно, как Нимрод, то наш город долго бы не простоял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230113
					],
					"speakerTitle": "Виктория"
				},
				{
					"id": 200230113,
					"content": "#Я считаю, что этот грех нужно пресекать на корню. Будь добр{F#а}, проведай Нимрода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Виктория"
				}
			]
		},
		{
			"id": 2002302,
			"completionStepIds": [
				2002302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
