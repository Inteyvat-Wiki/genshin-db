			},
			"dialogs": [
				{
					"id": 111229901,
					"content": "Постойте! Здесь следы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111229902,
					"content": "Их наверняка оставили шахтёры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229903
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111229903,
					"content": "Давайте найдём выход из перевала Линцзю. Если следов там не будет, значит, шахтёры ещё не покинули перевал. Ежели мы найдём новые следы, посмотрим, куда они нас приведут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				}
			]
		},
		{
			"id": 1112202,
			"completionStepIds": [
				1112202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112202",
							"2"
						],
						"stepId": 1112202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220201,
					"content": "Ой, тут следы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220202,
					"content": "По-видимому, они прошли перевал Линцзю и продолжили идти дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220203
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220203,
					"content": "Если мы пойдём по их следам, то узнаем, куда они направились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1112204,
			"completionStepIds": [
				1112204,
				1112210,
				1112211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112204",
							"2"
						],
						"stepId": 1112204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сяо Лин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220401,
					"content": "Приветики! Здесь шахтёры не проходили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220402,
					"content": "...Четыре или пять дней назад здесь прошли люди с корзинами на спинах, а в руках у них были кирки. Наверное, это были они.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220403
					],
					"speakerTitle": "Сяо Лин"
				},
				{
					"id": 111220403,
					"content": "Да, да, это они!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220404,
					"content": "Четыре или пять дней тому назад? Они прошли не дальше, чем мы предполагали. Должно быть, рельеф перевала Линцзю затруднил их продвижение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220405
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220405,
					"content": "Ой, как они странно выглядели! Четыре здоровяка с застывшими лицами... будто околдованные! А впереди ребёнок, вперевалочку так топал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220406
					],
					"speakerTitle": "Сяо Лин"
				},
				{
					"id": 111220406,
					"content": "Этот ребёнок... ты можешь его описать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220407
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220407,
					"content": "Я лишь мельком видела... синие волосы, росток с ноготок. Кажется... кажется, это была девочка! А ещё личико насупленное такое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220408
					],
					"speakerTitle": "Сяо Лин"
				},
				{
					"id": 111220408,
					"content": "И шли они по этому пути?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220409
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220409,
					"content": "Ага. Вот так они прямо и шли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220410
					],
					"speakerTitle": "Сяо Лин"
				},
				{
					"id": 111220410,
					"content": "За ними!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1112207,
			"completionStepIds": [
				1112207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112207",
							"2"
						],
						"stepId": 1112207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вань Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220701,
					"content": "Какие эти чудовища агрессивные. Они наверняка учуяли меня, когда я проходила рядом, и тут же набросились... Спасибо, что спасли мне жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220702
					],
					"speakerTitle": "Вань Юй"
				},
				{
					"id": 111220702,
					"content": "Меня зовут Вань Юй, я из зала Шэнлу. Отвечаю за исследование человеческой культуры и цивилизации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220703
					],
					"speakerTitle": "Вань Юй"
				},
				{
					"id": 111220703,
					"content": "Хм? Ты точно не... шахтёр?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220704,
					"content": "Шахтёр?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220705
					],
					"speakerTitle": "Вань Юй"
				},
				{
					"id": 111220705,
					"content": "Да. Мы ищем шахтёров. Четыре высоких парня с горным инструментом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220706,
					"content": "Кажется... я их видела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220707
					],
					"speakerTitle": "Вань Юй"
				},
				{
					"id": 111220707,
					"content": "Правда?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220708,
					"content": "Да. Позавчера я вышла от Южных небесных врат по направлению к перевалу Линцзю. Примерно на полпути мне повстречалась группа людей, четыре мужчины и ребёнок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220709
					],
					"speakerTitle": "Вань Юй"
				},
				{
					"id": 111220709,
					"content": "Нельзя ли поподробнее?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220710
					]
				},
				{
					"id": 111220710,
					"content": "Я спешила и не обратила на них внимания. Об их внешности ничего сказать не могу... простите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220711
					],
					"speakerTitle": "Вань Юй"
				},
				{
					"id": 111220711,
					"content": "Этого достаточно. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220712
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220712,
					"content": "Надеюсь, была вам полезна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220713
					],
					"speakerTitle": "Вань Юй"
				},
				{
					"id": 111220713,
					"content": "Я пойду тогда, мне ещё на научную конференцию надо. Ещё раз благодарю вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220714
					],
					"speakerTitle": "Вань Юй"
				},
				{
					"id": 111220714,
					"content": "По словам учёного, шахтёры шли в сторону Южных небесных врат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220715
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220715,
					"content": "А если это были другие люди?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220716
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220716,
					"content": "Ребенок и четверо взрослых. Совпадение? Паймон так не думает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220717
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220717,
					"content": "Это вполне могли быть не они.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220718
					]
				},
				{
					"id": 111220718,
					"content": "Э... но... но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220719
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220719,
					"content": "А давайте посмотрим, что поведает нам тот камень!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220720
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220720,
					"content": "Точно! Паймон чуть не позабыла о нашем секретном оружии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220721
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220721,
					"content": "Должно сработать. Сейчас я попробую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220722
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220722,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220723
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220723,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220724
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220724,
					"content": "Всё верно, это наши шахтёры. Они прошли по этой дороге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220725
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220725,
					"content": "То, как ты, Кунь Цзюнь, читаешь камни, я ещё долго не забуду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220726
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220726,
					"content": "Это умение, как правило, бесполезно. Но похвала от Чжун Ли - похвала поистине ценная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220727
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220727,
					"content": "Кунь Цзюнь, ты для нас как компас. Без тебя бы мы давно уже потерялись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220728
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220728,
					"content": "Ха-ха-ха-ха, ты так считаешь? Значит, наш поход удался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220729
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220729,
					"content": "У меня такое чувство... будто мы с вами распутываем преступление. Очень занимательно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220730
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220730,
					"content": "Пускай и занимательно, но мы должны сохранять бдительность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220731
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220731,
					"content": "Четыре взрослых мужчины словно под гипнозом... идут день и ночь по горам и холмам... за ребёнком. Всё это неспроста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220732
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220732,
					"content": "Правильно! Нужно оставаться начеку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220733
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220733,
					"content": "Вдобавок, на того учёного набросились детёныши геовишапа, но вели они себя куда агрессивнее, чем обычно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220734
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220734,
					"content": "По пути мы нашли немало зацепок. Пока что они вели нас в правильном направлении...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220735
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220735,
					"content": "Шахтёры вышли по направлению к Южным небесным вратам позавчера. Отсюда начинается опасная горная тропа. Если они действительно направились к Южным небесным вратам, то мы ещё можем их настигнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220736
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220736,
					"content": "Тогда не будем терять времени! Вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220737
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220737,
					"content": "Только что я сделал рядом отметку. Если дядюшка Дай пройдёт здесь, то сможет нас найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220738
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220738,
					"content": "Умница! Классический ход Чжун Ли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1112208,
			"completionStepIds": [
				1112208
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112208",
							"2"
						],
						"stepId": 1112208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Шахтёр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220802,
					"content": "Рядом лежит корзина... Должно быть, это один из шахтёров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220803
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220803,
					"content": "Эй, эй! Ты слышишь меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220804,
					"content": "Судя по его виду, он в обмороке от истощения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220805
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220805,
					"content": "Разбудим его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220806,
					"content": "Я ещё... могу копать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220807
					],
					"speakerTitle": "Шахтёр"
				},
				{
					"id": 111220807,
					"content": "А? Он что-то шепчет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220808,
						111220809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220808,
					"content": "Будто сопротивляется из последних сил...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				},
				{
					"id": 111220810,
					"content": "Какое неестественное упорство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220811
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220811,
					"content": "Неподалёку есть лагерь. Отведём его туда, чтобы он мог оправиться, а потом решим, что делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220809,
					"content": "Кажется, он пытается подняться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				}
			]
		},
		{
			"id": 1112209,
			"completionStepIds": [
				1112209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112209",
							"2"
						],
						"stepId": 1112209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220901,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220902
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220902,
					"content": "Как он? Будет жить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220903
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220903,
					"content": "Он переутомился и потерял сознание. К счастью, его жизни ничто не угрожает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220904
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220904,
					"content": "Как он смог так себя изнурить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220905
					]
				},
				{
					"id": 111220905,
					"content": "Паймон услышала, как он говорил что-то о копании. Может, он докопался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220906
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220906,
					"content": "Не исключено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220907,
						111220908
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220907,
					"content": "Странно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				},
				{
					"id": 111220909,
					"content": "Хм? Кажется, у него что-то в кармане...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220910
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220910,
					"content": "Это... осколки руды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220911
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220911,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220912
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220912,
					"content": "Я только что увидел воспоминания этих осколков. Этот человек вынес их из шахты. Он один из тех четырёх, которых мы ищем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220913
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220913,
					"content": "Хорошо бы понять, как он здесь оказался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220914
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220914,
					"content": "Его похитили, а потом... бросили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220915
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220915,
					"content": "Зачем его тащили сюда, если он не был нужен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220916
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220916,
					"content": "Могло случиться что-то, из-за чего он отстал от остальных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220917
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220917,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220918
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220918,
					"content": "С Паймон довольно! Слишком всё это загадочно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220919
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220919,
					"content": "Ох, постойте! Эти фрагменты заставили меня вспомнить, что у меня для вас кое-что есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220920
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220920,
					"content": "Что это? Что это? Неужто подарочек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220921
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220921,
					"content": "Кое-что... для нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220922
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220922,
					"content": "Как я вам уже говорил, до встречи с дядюшкой Даем я был словно в тумане. С тех пор как мы с вами взялись за это дело, туман начал понемногу рассеиваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220923
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220923,
					"content": "Я очень обрадовался, когда дядюшка Дай попросил вас помочь. Боюсь, без вас мне столько зацепок было бы не найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220924
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220924,
					"content": "Это кристаллы, которые я купил на рынке. Они, скажу я вам, не простые, а чрезвычайно редкие. По одному на память каждому из вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220925
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220925,
					"content": "Какой красивый... Переливается всеми цветами радуги! А под другим углом это словно другой кристалл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220926,
						111220927
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220926,
					"content": "Выглядит дорого...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220928,
					"content": "Пожалуйста, прими его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220929
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220929,
					"content": "Этот кристалл - для Чжун Ли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220930
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220930,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220931
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220931,
					"content": "Хм? Ч-что такое? Не нравится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220932
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220932,
					"content": "Нет, напротив... Просто я не рассчитывал в таких обстоятельствах получить подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220933
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220933,
					"content": "Благодарю. Я буду им дорожить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220934
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220934,
					"content": "Я рад, что они вам понравились. Приятно, когда твои подарки ценят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220935
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220935,
					"content": "Вон там есть ещё камни. Вы пока отдохните, а я пройдусь и пощупаю их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220936
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220936,
					"content": "Ты большой любитель камней, Кунь Цзюнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220937
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220937,
					"content": "Камни - кристаллы земли, осадок самого времени. Рядом с ними мне спокойно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220938
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220938,
					"content": "Отдохните. Когда будете готовы выдвигаться, позовёте. Я буду неподалёку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220939
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111220939,
					"content": "С ним ведь ничего не случится?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220940
					]
				},
				{
					"id": 111220940,
					"content": "Не переживай. Местность я уже осмотрел. Никакой опасности здесь нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220941
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220941,
					"content": "Да, я хотел бы кое-что с тобой обсудить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220942
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220942,
					"content": "Хм? С чего это ты вдруг стал такой серьёзный?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220943
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220943,
					"content": "#Путешественни{F#ца}{M#к}, знакомо ли тебе название «Жемчужина дракона»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220944
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220944,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220945
					]
				},
				{
					"id": 111220945,
					"content": "Это тот камень, который ищет Кунь Цзюнь? Что в нём такого особенного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220946
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220946,
					"content": "Жемчужина дракона - невероятно редкая руда, которую используют при ковке. Если обычные кристаллы рождаются под воздействием высоких температур, то Жемчужина дракона - дитя элементальной реакции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220947
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220947,
					"content": "Элементальные реакции могут создавать предметы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220948
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220948,
					"content": "Могут. Но лишь немногие способны просуществовать так долго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220949
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220949,
					"content": "Первая Жемчужина дракона появилась в пылу великой битвы тысячи лет назад. Мощные столкновения стихийной энергии дали жизнь элементальным кристаллам. Битва завершилась, а эти образования чудесным образом уцелели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220950
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220950,
					"content": "Ну и дела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220951
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220951,
					"content": "Но всё-таки они - кристаллы, редкие и малоизвестные. Кроме того, их залежи истощились сотни лет назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220952
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220952,
					"content": "Зачем тогда современному жителю Ли Юэ искать то, что уже давно покинуло недра Тейвата?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220953
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220953,
					"content": "Точно! Если Кунь Цзюню известно об их существовании, то почему он не знает, что их давно выкопали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220954
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220954,
					"content": "Странно... Паймон не понимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220955
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220955,
					"content": "Ещё остались люди из горного дела, которые сохранили к Жемчужинам дракона интерес. Но Кунь Цзюнь, который сам не знает, зачем ему этот камень, - это случай единичный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220956
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220956,
					"content": "Быть может, он держит истинные побуждения в тайне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220957
					]
				},
				{
					"id": 111220957,
					"content": "В тайне... Он злодей, получается?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220958
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111220958,
					"content": "Такой вывод делать ещё рано. Наберёмся терпения и продолжим наблюдать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220959
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220959,
					"content": "Не забывай, главное сейчас - спасти шахтёров. Остальное со временем станет явным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220960
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220960,
					"content": "Мы всё ближе к цели. Думаю, нам следует идти по этой дороге дальше. Одного мы уже нашли. Значит, недалеко и остальные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220961
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220961,
					"content": "Когда ты решишь, что привалу конец, позови Кунь Цзюня, и мы продолжим расследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220962
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220962,
					"content": "Спасённого шахтёра оставим в лагере. Когда всё разрешится, мы вернёмся и позаботимся о нём. Предлагаю оставить дядюшке Даю записку. Если он найдёт лагерь, то будет знать, что предпринять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111220927,
					"content": "Это правда мне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220908,
					"content": "Он ведь не сам сюда пришёл?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				}
			]
		},
