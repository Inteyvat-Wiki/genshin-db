			"dialogs": [
				{
					"id": 111224201,
					"content": "Привет! Ты здесь шахтёров не видел? Огромного роста, четыре человека!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111224202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111224202,
					"content": "Не мешай! Я тут облаками любуюсь, не видишь, что ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111224203
					],
					"speakerTitle": "Вэй"
				},
				{
					"id": 111224203,
					"content": "Ой, какие мы сердитые...",
