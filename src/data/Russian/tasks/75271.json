			"dialogs": [
				{
					"id": 752710501,
					"content": "Спасибо огромное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710502
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710502,
					"content": "Зики, должно быть, доставил вам немало хлопот. Его мыслительные процессы могут быть немного нетрадиционными, но именно это мне в нём и нравится.",
					"roleType": "TALK_ROLE_NPC",
