			"dialogs": [
				{
					"id": 752710101,
					"content": "Пожалуйста, не лопайте эти шарики! Если хотите поиграть с ними, я всегда могу дать тебе несколько.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710102
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710102,
					"content": "Какие необычные воздушные шары.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710103
					]
				},
				{
					"id": 752710103,
					"content": "Мне немного неловко это говорить, но для меня это важно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710104
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710104,
					"content": "По их внешнему виду вы, должно быть, уже догадались об их предназначении?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710105,
						752710107
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710105,
					"content": "Сделать предложение руки и сердца?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710106
					]
				},
				{
					"id": 752710106,
					"content": "Это признание в любви.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710109,
					"content": "Я планирую использовать эти шарики, наполненные моими чувствами, чтобы признаться в любви к Йопойи! Ну? Что вы думаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710110
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710110,
					"content": "Лучше красные.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710111
					]
				},
				{
					"id": 752710111,
					"content": "Хм... Логично... Неужели мне действительно не хватает немного романтики?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710112
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710112,
					"content": "Но Йопойи скоро придёт. Где искать красные шарики?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710107,
					"content": "Это признание в любви?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710108
					]
				},
				{
					"id": 752710108,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Зики"
				}
			]
		},
		{
			"id": 7527102,
