			"dialogs": [
				{
					"id": 752710201,
					"content": "#{M#Друг мой}{F#Дорогая подруга}, мне так повезло встретить тебя. Пожалуйста, помоги мне покрасить воздушный шарик в романтический красный цвет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зики"
