			"dialogs": [
				{
					"id": 752710601,
					"content": "Йопойи! Ты здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710602,
					"content": "Зики... Это ты? Почему ты так одет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "Йопойи"
				},
				{
					"id": 752710603,
					"content": "Твой любимый нанасийский костюм... Я взял напрокат. Классно, да? А эти шары я приготовил специально для тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710604,
					"content": "На самом деле, я давно хочу сказать тебе кое-что... Ты будешь моей девушкой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710605,
					"content": "Ты... шутишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "Йопойи"
				},
				{
					"id": 752710606,
					"content": "Нет! Йопойи, моя возлюбленная, пожалуйста, дай мне шанс!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710607,
					"content": "Может, ты головой ударился, пока в костюм влезал? Сегодня наша третья годовщина свадьбы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "Йопойи"
				},
				{
					"id": 752710608,
					"content": "Я знаю! Но... ты всегда говорила мне, что я не романтик и не признался тебе в любви как следует перед свадьбой... Так что, хотя и с запозданием, хочу признаться тебе в любви!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710609,
					"content": "Ха-ха-ха... О, понятно. Тогда я согласна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "Йопойи"
				},
				{
					"id": 752710610,
					"content": "Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710611,
					"content": "Да-да-да, мой любимый глупыш.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "Йопойи"
				},
				{
					"id": 752710612,
					"content": "Налетел порыв ветра, и влюблённые обнялись.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
