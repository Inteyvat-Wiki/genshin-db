				"points": []
			},
			"dialogs": [
				{
					"id": 752710301,
					"content": "Романтические красные воздушные шары! Как красиво... Моей любимой Йопойи точно понравится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710302
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710302,
					"content": "Да, дружище?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710303,
						752710304
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710303,
					"content": "Эм... Мне сложно сказать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				},
				{
					"id": 752710305,
					"content": "Спасибо тебе большое. Пожалуйста, не уходи. Я хочу, чтобы Йопойи познакомилась с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710306
					],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710306,
					"content": "Она скоро придёт. Мы договорились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зики"
				},
				{
					"id": 752710304,
					"content": "Конечно, она будет приятно удивлена.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				}
			]
		},
