			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010201,
					"content": "Наконец-то мы в <color=#00E1FFFF>Ли Юэ</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010202,
					"content": "#Прошу прощения, {F#мисс}{M#мистер}! Что это за прелюбопытное создание вращается вокруг вашей оси? За какую сумму вы изволите её продать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 400010203,
					"content": "Она не продаётся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010204,
					"content": "Она не продаётся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010209,
					"content": "Хахаха! Действительно, в последнее время я испытываю некоторые... Финансовые затруднения. Какой бы ни была ваша цена, скорее всего, эта покупка будет мне не по карману.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 400010210,
					"content": "Я обычный торговец и не имею дела с диковинными сокровищами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 400010211,
					"content": "Чем больше ты говоришь, тем подозрительнее ты мне кажешься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010212,
					"content": "Зачем ты так, а? Хочешь конфетку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 400010213,
					"content": "#{NICKNAME}, забудь, что я сказала! Этому человеку можно доверять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010214,
					"content": "Вы пришли в Ли Юэ на Праздник морских фонарей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 400010215,
					"content": "В этом году лунный фонарь станет особенно захватывающим зрелищем, ведь плаустрит, используемый для поднятия фонаря в воздух, будет самым большим за последние двадцать лет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 400010216,
					"content": "Он поистине огромный... Когда смотришь на него, начинаешь верить в легендарные летающие города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 400010217,
					"content": "Под ними должны быть такие же большие плаустриты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 400010218,
					"content": "Звучит круто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010219,
					"content": "Ха-ха! Надеюсь, мы ещё встретимся! Чувствуйте себя в Ли Юэ как дома! ...Ладно, не буду говорить за всю <color=#00E1FFFF>гавань</color>, но в моей лавке вам всегда будут рады!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бо Лай"
				},
				{
					"id": 400010205,
					"content": "Боюсь, что у вас нет столько денег.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010206,
					"content": "Звучит подозрительно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010207,
					"content": "Любопытно, о какой конкретно сумме идёт речь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010208,
					"content": "#Неважно. Ты хотел{F#а} сказать, что Паймон бесценна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4000103,
			"completionStepIds": [
				4000103
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000103",
							"2"
						],
						"stepId": 4000103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзян Чжоу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010301,
					"content": "#Смотри, {NICKNAME}! Камень действительно парит в воздухе! Цепь так туго натянута...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010302,
					"content": "Если бы не цепь, кто знает, куда бы он улетел?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010303,
					"content": "Плаустрит поднимет в воздух лунный фонарь. Весь Ночной рынок расположился вокруг него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010304
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 400010304,
					"content": "Привет. Кто вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010305,
					"content": "Меня зовут Цзян Чжоу. Я слежу за ходом строительства лунного фонаря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010306
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 400010306,
					"content": "Вы здесь новенькие? Первый раз на Празднике морских фонарей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010307
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 400010307,
					"content": "Верно... Как вы догадались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010308,
					"content": "Не припомню, чтобы в прошлом году на фестивале были такие странные создания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010309
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 400010309,
					"content": "Я с радостью отвечу на любые ваши вопросы о празднике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010310
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 400010310,
					"content": "Что такое лунный фонарь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010311
					]
				},
				{
					"id": 400010311,
					"content": "Вы увидите, как люди будут запускать в небо множество маленьких фонарей. Эти фонари называются «небесные фонари». Ещё есть один огромный фонарь, его собирают все жители Ли Юэ. Мы зовём его «лунный фонарь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010312
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 400010312,
					"content": "На Ночном рынке ты встретишь торговцев со всего Ли Юэ. Но они здесь не для того, чтобы заработать денег. Все вырученные средства пойдут на постройку лунного фонаря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010313
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 400010313,
					"content": "Вы тоже можете поучаствовать, если хотите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010314
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 400010314,
					"content": "Какая нам выгода?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010315,
					"content": "Лунный фонарь щедро вознаградит вас за усердные труды. В первое полнолуние нового года, когда мы прощаемся со старым и приветствуем новое, все ваши желания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010316
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 400010316,
					"content": "То есть - ничего конкретного, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010317,
					"content": "Не стоит во всём искать практическую выгоду. Иногда бывает полезно просто помечтать, смотря на звёзды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010318
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 400010318,
					"content": "Все, кто поучаствует в строительстве лунного фонаря, получат что-то с <color=#00E1FFFF>Ночного рынка</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010319
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 400010319,
					"content": "После усердной работы нас будут ждать вкусные лакомства, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400010320,
					"content": "#{NICKNAME}, за дело! Пойдём поговорим с торговцами на <color=#00E1FFFF>Ночном рынке</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4000106,
			"completionStepIds": [
				4000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000106",
							"2"
						],
						"stepId": 4000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мадам Пин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "В этом году лунный фонарь посвящён Могучему Повелителю Небесных Пределов... Уверена, что ему бы это понравилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010602,
					"content": "Расскажи мне про Могучего Повелителя Небесных Пределов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "Когда фонарь достроят, он будет выглядеть в точности как Могучий Повелитель Небесных Пределов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010604,
					"content": "Надеюсь, что рога получатся достаточно большими. Адепт ими очень гордился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010605,
					"content": "Согласно легенде его рога - дар Властелина Камня, Гео Архонта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010606,
					"content": "Но во время схватки ему пришлось пожертвовать всем. Когда гора треснула и накренилась, друг Адепта отрубил ему рога, чтобы спасти жителей деревни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010607,
					"content": "Он вбил клином свои рога в горную расщелину, а затем продолжил сражаться с демоном до последней капли крови...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010608,
					"content": "Благодаря его подвигу гора Тяньхэн гордо высится до сих пор, а его кровь, пролитая в схватке с демоном, превратилась в реку Бишуй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010609,
					"content": "Хе-хе... Верить в эту историю или нет, решать тебе. Спасибо за внимание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010610
					],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010610,
					"content": "Праздник морских фонарей существует потому, что люди на протяжении долгих веков предпочитают жить в мире и согласии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мадам Пин"
				},
				{
					"id": 400010611,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010612
					]
				},
				{
					"id": 400010612,
					"content": "Пока! Пусть пламя добродетели разносится по миру и никогда не погаснет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мадам Пин"
				}
			]
		},
