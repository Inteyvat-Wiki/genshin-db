						200160202
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200160202,
					"content": "Вы вернулись! Удалось доставить заказ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160203
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200160203,
					"content": "Вот плата за еду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160204
					]
				},
				{
					"id": 200160204,
					"content": "Так, что тут у нас... Да, всё верно. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160205
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200160205,
					"content": "<color=#00E1FFFF>Запеканка с овощами, ветчиной и крабом</color> для вас! Прямо из печи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сара"
				}
			]
		},
