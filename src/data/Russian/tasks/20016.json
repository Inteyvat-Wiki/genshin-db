			"dialogs": [
				{
					"id": 200160101,
					"content": "Заказ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200160102,
					"content": "#Путешественн{F#ица}{M#ик}! Ты как раз вовремя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200160103,
					"content": "#Прости, наверное, ты проголодал{F#а}с{F#ь}{M#я}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200160104,
					"content": "В последние время заказов становится всё больше. Я стараюсь прикреплять к ним метки и делить по районам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200160105,
					"content": "Но я потеряла метку от этого <color=#00E1FFFF>супа с морепродуктами и лилией Калла</color>. Я знаю только, что его заказал кто-то из Спрингвейла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200160106,
					"content": "Сможешь доставить этот <color=#00E1FFFF>суп с морепродуктами</color> адресату в Спрингвейле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200160107,
					"content": "Хорошо, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "Не волнуйтесь! Когда вернётесь, вас будет ждать роскошный ужин, я гарантирую это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200160109,
					"content": "Мы рассчитываем на тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сара"
				},
				{
					"id": 200160110,
					"content": "Но мы просто пришли поесть. Умираем с голоду!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "Как только вы вернётесь, я позабочусь о том, чтобы вам накрыли стол в «Хорошем охотнике». Я в долгу не останусь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сара"
				}
			]
		},
