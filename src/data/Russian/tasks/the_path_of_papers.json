			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нилуфар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731053001,
					"content": "Алрани, хоть бы с тобой всё было хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053002,
						731053005
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731053002,
					"content": "А как у Алрани обстояли дела в Академии?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053003
					]
				},
				{
					"id": 731053003,
					"content": "Она была очень старательной студенткой. Хотя иногда и застревала в странных местах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053004
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731053004,
					"content": "Алрани непревзойдённая ученица. Уверена, что и учёным она будет таким же непревзойдённым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731053005,
					"content": "Трудно ли студентам получить одобрение своих научных работ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053006
					]
				},
				{
					"id": 731053006,
					"content": "Честно говоря, да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053007
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731053007,
					"content": "Пройти комиссию очень сложно. Нужно принять во внимание свою исследовательскую направленность и проверить обширность источников информации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053008
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731053008,
					"content": "Ещё важно помнить, чтобы между твоей работой и работами других исследователей не было никаких совпадений или противоречий. И даже после раскрытия темы ты всё равно столкнёшься со всевозможными трудностями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053009
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731053009,
					"content": "Эх... Должна сказать, она чрезвычайно невезучая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нилуфар"
				}
			]
		},
