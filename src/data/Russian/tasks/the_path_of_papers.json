			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нарзам",
					"Алрани",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050701,
					"content": "Алрани! Ты собираешься выходить или нет?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050702
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731050702,
					"content": "Никуда я не пойду! Никаких больше академий! В Бездну это образование!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050703
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050703,
					"content": "Я же вам заплатила! Можете просто оставить меня в покое, а?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050704
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050704,
					"content": "Вот же упёртая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050705,
						731050706
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731050705,
					"content": "Мы тут это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				},
				{
					"id": 731050707,
					"content": "З-здравствуйте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050708,
					"content": "Хм? Вы кто такие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050709
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731050709,
					"content": "#Путешественни{F#ца}{M#к}! Хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050710
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050710,
					"content": "Так ты правда здесь, Алрани?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050711,
						731050712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050711,
					"content": "Хорошо, что с тобой всё в порядке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050713,
					"content": "Хнык... хнык... нет у них чести! Эту научную работу написала я! Я была первая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050714
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050714,
					"content": "Если бы я не застряла в Инадзуме, всё бы получилось! Хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050715
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050715,
					"content": "Тише-тише... неужели ты так легко сдашься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050716,
					"content": "Ох... ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050717
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050717,
					"content": "Я-я бросила Академию! Больше никаких научных работ! Пусть эти дураки сами пишут! Больше никакой учёбы! Пускай Академия делает всё, что хочет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050718
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050718,
					"content": "Я уже заплатила Нарзам за защиту! Теперь никто и никогда не заставит меня писать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050719
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050719,
					"content": "Пфф...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050720
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731050720,
					"content": "А вы?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050721
					]
				},
				{
					"id": 731050721,
					"content": "#Я и есть Нарзам. Занимаюсь... ну, ты и сам{F#а} знаешь, так что не буду нести всю приветственную чушь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050722
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731050722,
					"content": "#Я тебя знаю. Ты {F#та}{M#тот} сам{F#ая}{M#ый} путешественни{F#ца}{M#к}, что в последнее время шныряет по округе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050723
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731050723,
					"content": "Если тебе поручили забрать эту девчонку, валяй. Я мешать не буду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050724
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731050724,
					"content": "Эй! Я тебе за что плачу?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050725
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050725,
					"content": "Ну и на что твоих денег хватит? Так, на пару дней еды купить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050726
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731050726,
					"content": "Я всё равно не вернусь. Не хочу опять ломать голову над темой научной работы и заниматься полевыми исследованиями. Неделями напролёт без сна и отдыха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050727
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050727,
					"content": "Может быть, меня вообще схватят какие-нибудь плохие ребята или я наткнусь на свирепых монстров. Тогда опять не смогу закончить научную работу и пропущу комиссию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050728
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050728,
					"content": "Хнык-хнык... Нет... не хочу... лучше уж сидеть здесь взаперти... хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050729
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050729,
					"content": "#Путешественни{F#ца}{M#к}, п-пожалуйста, передай записку Нилуфар... Я-я сейчас напишу... Я правда не хочу возвращаться, не заставляй меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050738
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050738,
					"content": "Алрани всхлипнула и начала писать записку...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050730
					]
				},
				{
					"id": 731050730,
					"content": "Держи... хнык-хнык... зачем вообще люди придумали научные работы?!.. Хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050731
					],
					"speakerTitle": "Алрани"
				},
				{
					"id": 731050731,
					"content": "Всё-всё, успокойся. Никто тебя не забирает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050732
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731050732,
					"content": "Алрани... у неё прямо эмоциональное истощение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050733
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050733,
					"content": "Пусть пока побудет здесь, а мы тем временем отнесём записку Нилуфар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050734,
						731050735
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050734,
					"content": "Но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050736,
					"content": "Можете о нас не переживать. Она ведь нам заплатила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050737
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731050737,
					"content": "Да и... мне давно хотелось пообщаться с кем-нибудь образованным. Она мне пригодится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731050735,
					"content": "Похитители сокровищ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050712,
					"content": "Нилуфар рассказала нам о твоей научной работе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050706,
					"content": "Простите за беспокойство...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				}
			]
		},
