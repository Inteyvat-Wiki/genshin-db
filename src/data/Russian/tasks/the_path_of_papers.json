			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Нилуфар",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050101,
					"content": "Алрани... куда же ты ушла?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050102
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050102,
					"content": "Алрани?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050103
					]
				},
				{
					"id": 731050103,
					"content": "Ой, Паймон помнит это имечко. Это же та учёная, что вечно строчит свои научные статьи, да? Мы её на острове Ватацуми видели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050104,
					"content": "Точно! Она покинула Академию, чтобы собрать кое-какие материалы. К этому моменту Алрани уже должна была вернуться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050105,
					"content": "Ох, ты только взгляни на её обеспокоенный вид... Давай-ка спросим у неё, что случилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050106,
					"content": "Если всё хорошо и Алрани уже в Академии, мы можем просто проявить вежливость и поприветствовать её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050107,
					"content": "Здравствуйте! Мы по поводу Алрани...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050108
					]
				},
				{
					"id": 731050108,
					"content": "Вы же те самые искатели приключений, нанятые Гильдией, да?! Скажите, вы нашли Алрани?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050109
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050109,
					"content": "Знаю, я часто была к ней слишком строга, и мне жаль... но я действительно переживаю за неё! Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050110
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050110,
					"content": "Тише-тише. Мы вовсе не «те самые» искатели приключений. Так, просто мимо проходили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050111,
					"content": "Позвольте спросить, вы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050112
					]
				},
				{
					"id": 731050112,
					"content": "#Так вы не искател{F#ьницы}{M#и} приключений? Прошу прошения, от Гильдии до сих пор никаких новостей. Вот я... и волнуюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050149
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050149,
					"content": "Вы рассказываете о том, через что прошли с Алрани...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050113
					]
				},
				{
					"id": 731050113,
					"content": "#Значит, вы и есть {F#та}{M#тот} путешественни{F#ца}{M#к}, о котор{F#ой}{M#ом} говорила Алрани.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050114
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050114,
					"content": "Меня зовут Нилуфар, я учёная из Академии Сумеру. Вы это и так уже поняли, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050115
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050115,
					"content": "Как бы то ни было, теперь большую часть своего времени и сил я посвящаю помощи студентам в их исследованиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050116
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050116,
					"content": "В их числе и Алрани. Ох, как же непросто ей далась научная работа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050117
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050117,
					"content": "Так значит, вы та самая наставница Алрани?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050118
					]
				},
				{
					"id": 731050118,
					"content": "Алрани говорила, что ей пришлось переписать множество своих научных работ, потому что её наставница всегда была недовольна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050119,
					"content": "Ох, сейчас не время это обсуждать. Так что случилось с Алрани?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050120,
					"content": "Она... она исчезла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050121
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050121,
					"content": "Некоторое время назад Алрани вернулась из Инадзумы в приподнятом настроении. С собой у неё была научная работа, посвящённая культуре народа острова Ватацуми...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050122,
						731050123
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050122,
					"content": "Алрани была увлечена этой темой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				},
				{
					"id": 731050124,
					"content": "Я видела, что это великолепная научная работа. Да и написана по всем академическим стандартам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050125
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050125,
					"content": "Но... но она принесла её мне слишком поздно! До этого я просила её заранее прислать мне черновой вариант, но так и не получила ответа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050126
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050126,
					"content": "Когда она вернулась с законченной научной работой, кто-то уже подал точно такую же работу, которая успела пройти предварительное рецензирование!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050127
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050127,
					"content": "Я всеми силами пыталась помочь ей пройти рецензирование, но... её научную работу так и не одобрили...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050128
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050128,
					"content": "Как же так? Алрани так долго собирала материалы для этой статьи. И чего же она тянула до последнего с этой рецензией?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050129,
					"content": "Погодите-ка... это же было в Инадзуме... значит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050130,
					"content": "У-указ Сакоку!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050131
					]
				},
				{
					"id": 731050131,
					"content": "Как же так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050132,
					"content": "Я понятия не имела, как сообщить ей эти ужасные новости. Сперва я планировала тактично переговорить с ней через несколько дней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050133
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050133,
					"content": "Но какой-то болтун выложил ей всё как на духу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050134
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050134,
					"content": "Потом она пропала. Я проверила все закоулки Академии Сумеру, но её нигде не было. Поэтому я обратилась за помощью к Гильдии искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050135
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050135,
					"content": "Однако искатели нашли только потерянную записную книжку. И никаких следов Алрани.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050136
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050136,
					"content": "Они до сих пор ищут её...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050137
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050137,
					"content": "Я-я не знаю, что мне делать... хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050138,
						731050140
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050138,
					"content": "Я помогу найти Алрани.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050139
					]
				},
				{
					"id": 731050139,
					"content": "Да, мы вместе поможем! Начнём... начнём с того места, где искатели приключений нашли её записную книжку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050142,
					"content": "Правда? Я даже не знаю, как вас отблагодарить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050143
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050143,
					"content": "Я отмечу местонахождение записной книжки на карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050144
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050144,
					"content": "Точно, насчёт награды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050145,
						731050146
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050145,
					"content": "Поговорим об этом позже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050147,
					"content": "Правда? Спасибо вам большое. Я буду здесь на случай, если от Гильдии поступят какие-нибудь новости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050148
					],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050148,
					"content": "Алрани, хоть бы с тобой всё было хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нилуфар"
				},
				{
					"id": 731050146,
					"content": "Об этом я попрошу Алрани.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050140,
					"content": "Где это место?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050141
					]
				},
				{
					"id": 731050141,
					"content": "Мы поможем отыскать Алрани!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050123,
					"content": "Она посвятила ей много времени.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				}
			]
		},
		{
			"id": 7310505,
			"completionStepIds": [
				7310505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310505",
							"2"
						],
						"stepId": 7310505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гобли",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050501,
					"content": "П-прошу тебя, сжалься! Это всё недоразумение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050502,
						731050505
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050502,
					"content": "Нет никакого недоразумения.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050503
					]
				},
				{
					"id": 731050503,
					"content": "Что вы сделали с Алрани? А ну быстро выкладывайте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050504,
					"content": "А не то... а не то Паймон вас так отлупит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050507,
					"content": "Нет-нет-нет, прошу! Вы всё неправильно поняли! Всё совсем не так, как кажется...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050508
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050508,
					"content": "Мы бы не посмели докучать этой чертовке, но она!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050509,
						731050510
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050509,
					"content": "В смысле?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050511,
					"content": "Послушайте меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050512
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050512,
					"content": "Некоторое время назад нам не хватало денег, поэтому мы с сестрицей решили порыскать в округе в поисках заработка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050513
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050513,
					"content": "Пф! Заработком ты называешь воровство и грабёж?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050514,
					"content": "Ну... это всё-таки наша профессия, как-никак...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050515
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050515,
					"content": "Сидели мы себе в лагере, разрабатывали план. И вдруг видим, девчонка какая-то идёт с огроменной такой сумищей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050516
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050516,
					"content": "Мы как увидели её, так и обомлели. До чего бледная была, словно призрак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050517
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050517,
					"content": "И только мы приготовились схватить её, как она плюхнулась возле костра, заревела и стала сжигать какие-то книги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050518
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050518,
					"content": "Жуткое зрелище...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050519,
						731050520
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050519,
					"content": "Да уж... безобидной девушки испугались.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050521,
					"content": "Ай, мы хоть и Похитители сокровищ, но мы никогда никого не убивали. Мы просто берём бесхозные сокровища...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050522
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050522,
					"content": "Но это были ещё цветочки. Когда она кинула в нас мешок с морой и попросила запереть её где-нибудь, мы вообще дар речи потеряли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050523
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050523,
					"content": "Ч-чего?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050524,
						731050525
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731050524,
					"content": "Какая-то чушь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050526,
					"content": "Сперва все и пальцем боялись к ней прикоснуться. Но она устроила голодовку, требуя, чтобы мы её заперли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050527
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050527,
					"content": "В конце концов сестрица сказала нам соорудить клетку, чтобы посадить туда эту девчонку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050528,
						731050529
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050528,
					"content": "Какая у вас милая сестрица...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050530,
					"content": "Ну, сестрица всегда питала уважение к этим учёным. Она всё мечтает, что когда-нибудь и ей удастся пойти учиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050531
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050531,
					"content": "Кхм, в общем, девчонка сейчас вон там. Идите и сами взгляните. Сестрица, наверное, до сих пор сидит и уговаривает её выйти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050532
					],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050532,
					"content": "Если вы уведёте её отсюда, мы будем вам очень благодарны! Даже заплатить готовы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гобли"
				},
				{
					"id": 731050529,
					"content": "Вы были очень добры к Алрани.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050525,
					"content": "И вы выполнили её просьбу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050520,
					"content": "А вы точно Похитители сокровищ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050510,
					"content": "Так значит, она у вас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050505,
					"content": "Что вы сделали с Алрани?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050506
					]
				},
				{
					"id": 731050506,
					"content": "А ну быстро выкладывайте! А не то... а не то Паймон вас так отлупит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7310507,
			"completionStepIds": [
				7310507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
