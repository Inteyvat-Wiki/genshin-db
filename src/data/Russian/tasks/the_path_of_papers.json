					"Нарзам"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731053101,
					"content": "Хочешь спросить что-то ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053102,
						731053108
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731053102,
					"content": "Почему ты к ней так...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053103
					]
				},
				{
					"id": 731053103,
					"content": "Почему я так «хорошо» к ней отношусь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053104
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731053104,
					"content": "Не пойми меня неправильно. На это у меня есть три веские причины. Во-первых, Алрани заплатила мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053105
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731053105,
					"content": "Во-вторых, меня интересует только чужая мора, а не чужие жизни. Если я выкину её в дикий лес, это навредит моей репутации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053106
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731053106,
					"content": "В-третьих, она образованная девушка, которую ждёт прекрасное будущее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053107
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731053107,
					"content": "Думаю, помощь ей делает честь Похитителям сокровищ, которым до неё, как до луны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731053108,
					"content": "Сколько Алрани тебе заплатила?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053109
					]
				},
				{
					"id": 731053109,
					"content": "Немало. Она сказала, что заработала эту мору, создавая какие-то «удобрения». Не знаю, что это такое. И не особо хочу знать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053110
					],
					"speakerTitle": "Нарзам"
				},
				{
					"id": 731053110,
					"content": "Она нам заплатила. Значит, мы будем ей помогать. Вот и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нарзам"
				}
			]
		},
