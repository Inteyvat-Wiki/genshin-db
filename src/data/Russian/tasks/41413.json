			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джинн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130201,
					"content": "Джинн! Мы пришли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414130202,
					"content": "#Путешественни{F#ца}{M#к}! О, прошу прощения. В данной ситуации я должна обращаться к тебе как к почётному рыцарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130203
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 414130203,
					"content": "#Ты наверняка уже слышал{F#а}, что тебя выбрали Звездой анемоний. В этом году именно тебе предстоит преподнести анемонии Анемо Архонту Барбатосу от имени всех жителей Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130204
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 414130204,
					"content": "Однако... В этот раз всё будет немного по-другому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130205
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 414130205,
					"content": "У вас есть мы и Бродяжка, а значит, этот Праздник ветряных цветов будет ещё веселее, чем раньше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414130206,
					"content": "Да. Спасибо вам, что остались здесь. Надеюсь, вы продолжите наслаждаться гостеприимством Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130207
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 414130207,
					"content": "#Праздничная церемония вот-вот начнётся. Звезда анемоний, ты уже выбрал{F#а} свою анемонию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130208
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 414130208,
					"content": "Нам нужно выбрать цветок и преподнести его Анемо Архонту, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414130209,
					"content": "Именно. Выбирайте с умом. Не забывайте, что вы представляете весь Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130210
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 414130210,
					"content": "Венти, какие цветы тебе нравятся?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130211
					]
				},
				{
					"id": 414130211,
					"content": "М? ...Очень хитро с твоей стороны спросить меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130212
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414130212,
					"content": "Кхм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130213
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 414130213,
					"content": "Эй, вы двое! Хватит секретничать, дело серьёзное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414130214,
					"content": "Ха-ха, виноваты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130215
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414130215,
					"content": "Не спрашивай у меня, просто выбери то, что тебе нравится. Я доверяю твоему вкусу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130216
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 414130216,
					"content": "Итак, каков твой выбор, почётный рыцарь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130217,
						414130219,
						414130221,
						414130223,
						414130225,
						414130227
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 414130217,
					"content": "Одуванчик",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130218
					]
				},
				{
					"id": 414130218,
					"content": "Ага! Выбираешь любимчика народных масс! Анемонии должны быть одуванчиками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414130229,
					"content": "От лица всех жителей Мондштадта, пожалуйста, преподнеси анемонии статуе Анемо Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джинн"
				},
				{
					"id": 414130219,
					"content": "Ветряная астра",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130220
					]
				},
				{
					"id": 414130220,
					"content": "Ага! Выбираешь любимчика народных масс! Анемонии должны быть ветряными астрами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414130221,
					"content": "Сесилия",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130222
					]
				},
				{
					"id": 414130222,
					"content": "Ого, ты разделяешь взгляды Беатрис! Анемония - это сесилия! Не самый популярный вариант, но и у него есть свои защитники!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414130223,
					"content": "Трава-светяшка",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130224
					]
				},
				{
					"id": 414130224,
					"content": "Ого! Ты разделяешь взгляды Нимрода! Анемония - это трава-светяшка, маленький фонарик, освещающий тьму!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414130225,
					"content": "Цветок-сахарок",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130226
					]
				},
				{
					"id": 414130226,
					"content": "Ого! Ты разделяешь взгляды Сахарозы! Анемония - это цветок-сахарок, растение с богатой и древней историей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414130227,
					"content": "Волчий крюк",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130228
					]
				},
				{
					"id": 414130228,
					"content": "Ого! Ты разделяешь взгляды Рэйзора! Анемония - это волчий крюк, острый и колючий!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4141304,
			"completionStepIds": [
				4141304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
