					"nextDialogs": [],
					"speakerTitle": "Собака"
				}
			]
		},
		{
			"id": 7329504,
			"completionStepIds": [
				7329504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329504",
							"2"
						],
						"stepId": 7329504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Жюльен"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950401,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950402,
					"content": "Я... со мной... Спасибо, что спасли меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950403
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950403,
					"content": "Прошлой ночью мне приснился сон. Катерпиллер стоял в конце паломнического пути и махал мне рукой... Это было странно, потому что путь представлял собой череду пещер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950404
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950404,
					"content": "Там, в самом конце этого узкого пути, стоял Катерпиллер. Я побежал к нему, но тут меня разбудил лай...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950405
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950405,
					"content": "Не обращая внимания на лай, я счёл это хорошим предзнаменованием, взял свой набор для рисования набросков и отправился в путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950406
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950406,
					"content": "В итоге... В итоге я потерялся, а потом на меня напали хиличурлы. Я не только не смог убежать, но и потерял сумку с набросками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950407
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950407,
					"content": "Полагаю, для тебя это очередной день потерь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950408
					]
				},
				{
					"id": 732950408,
					"content": "Разве можно меня винить? Здесь ещё сложнее ориентироваться, чем в канализации Фонтейна! Я слышал, что в Сумеру люди живут на деревьях. Может быть, это место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950409
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950409,
					"content": "Сюда идут отходы со всего Сумеру?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950410
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950410,
					"content": "Очень вряд ли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950411,
					"content": "Ох... Моя жизнь - сплошная череда неудач. Одно непродуманное решение за другим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950412
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950412,
					"content": "Зачем я покинул своё убежище сегодня утром? Во сне я увидел хорошее предзнаменование, но это был лишь сон. Как получилось, что я принял его за реальность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950413
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950413,
					"content": "Ах, почему вчера я не был откровенен с вами и не рассказал правду о своих проблемах? Если бы я позволил вам быть моими проводниками, я бы не оказался в такой ситуации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950414
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950414,
					"content": "И зачем я вообще уехал из Фонтейна? Моя жизнь там была не такой уж плохой... Напротив, с тех пор как я покинул Фонтейн, со мной не произошло ничего хорошего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950415
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950415,
					"content": "Не сдавайся! Мы можем показать тебе потрясающие пейзажи, но сначала мы поможем тебе вернуть потерянные вещи. Не возражаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950416,
					"content": "Хотя мы не можем с уверенностью заявлять, что вернём их...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950417,
					"content": "Ха-ха, хиличурлы наверняка забрали их и использовали в качестве туалетной бумаги! Ну... В любом случае... это были не очень дорогие вещи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950418
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950418,
					"content": "Будь честен.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950419
					]
				},
				{
					"id": 732950419,
					"content": "Да. Даже если они стоят не много моры, они дороги тебе, не так ли? Мы поможем их найти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950420,
					"content": "Кстати, а где Перчик? Разве он не с тобой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950421,
					"content": "Бессердечное существо... Он давным-давно сбежал. Если я не ошибаюсь, он, вероятно, отдыхает в каком-нибудь своём укромном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950422
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950422,
					"content": "В это трудно поверить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950423,
					"content": "Ладно, почему бы тебе не вернуться в свой лагерь и не обработать раны? Мы найдём потерянные вещи, а потом присоединимся к тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950424,
					"content": "Спасибо вам... друзья. Ах, на кого мы можем положиться в этой жизни, если не на друзей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Жюльен"
				}
			]
		},
		{
			"id": 7329506,
			"completionStepIds": [
				7329506
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
