			"dialogs": [
				{
					"id": 732951201,
					"content": "Ах, друзья мои! Потерянные наброски...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732951202
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732951202,
					"content": "Мы их не нашли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732951203
					]
				},
				{
					"id": 732951203,
					"content": "Понятно. Ничего страшного. Они были не очень дорогими...",
					"roleType": "TALK_ROLE_NPC",
