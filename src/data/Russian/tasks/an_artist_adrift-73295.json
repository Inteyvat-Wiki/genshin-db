				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950901,
					"content": "Путь паломничества. Как я мог сбиться с пути?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950902
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950902,
					"content": "Путь паломничества?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950903
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950903,
					"content": "О, это ерунда. Просто... фигура речи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Жюльен"
				}
			]
		},
		{
			"id": 7329512,
			"completionStepIds": [],
