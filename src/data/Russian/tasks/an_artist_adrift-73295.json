			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Собака"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950601,
					"content": "А? Это Перчик? Похоже, он что-то охраняет! Знакомая ситуация...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950602,
					"content": "(Узнав вас, виляет хвостом.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950603
					],
					"speakerTitle": "Собака"
				},
				{
					"id": 732950603,
					"content": "Он охраняет наброски Жюльена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950604,
					"content": "Перчик дважды лает и быстро убегает...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732950605
					]
				},
				{
					"id": 732950605,
					"content": "Ну вот опять. Как и в прошлый раз... Кстати, а зачем хиличурлам наброски?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950606,
						732950608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950606,
					"content": "Возможно, они хотят украсить интерьер.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950607
					]
				},
				{
					"id": 732950607,
					"content": "Хм... С чего вдруг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950608,
					"content": "Возможно, они действительно используют их как туалетную бумагу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950609
					]
				},
				{
					"id": 732950609,
					"content": "#Фу! Как ты вообще мог{F#ла} такое подумать, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7329508,
			"completionStepIds": [
				7329508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329508",
							"2"
						],
						"stepId": 7329508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Жюльен"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950801,
					"content": "Перчик и правда вернулся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950802,
					"content": "Эй, Жюльен! Мы нашли твои наброски!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950803,
					"content": "Ах, друзья мои, спасибо вам! Подумать только, что вы прошли через всё это ради ничего не стоящих вещей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950804
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950804,
					"content": "Не говори так. Разве ты не прославленный художник из Фонтейна? Твои наброски можно дорого продать, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950805,
					"content": "Ну, наверное, да... Честно говоря, я не слишком задумываюсь о таких вещах. Ведь настоящее искусство бесценно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950806
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950806,
					"content": "Хе-хе, сразу видно, что ты прославленный художник! Твои слова наполнены... художественным талантом! Кстати, мы обнаружили, что Перчик охранял твои наброски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950807
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950807,
					"content": "Как и в прошлый раз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950808
					]
				},
				{
					"id": 732950808,
					"content": "Да! Паймон уверена, что ты ему очень дорог.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950809,
					"content": "Ты говоришь о Перчике, который всё время ведёт меня по странным тропам, сколько бы я его ни кормил, а потом бросает меня одного наедине с хиличурлами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950810
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950810,
					"content": "Ну... Возможно, у него были какие-то свои соображения на этот счёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950811
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950811,
					"content": "Что бы ты ни говорил, на самом деле он тебе очень нравится. Иначе ты бы не стал фотографировать его на особую фотокамеру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950812
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950812,
					"content": "Фотографировать? Какие фотографии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950813
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950813,
					"content": "Среди твоих набросков был снимок собаки, которая очень похожа на Перчика. Цвета были совершенно удивительными. Ты использовал какую-то специальную камеру, чтобы сделать снимок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950814
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950814,
					"content": "Эм... По правде говоря, это был мой рисунок, а не фотоснимок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950815
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950815,
					"content": "Правда? Неудивительно, что ты стал прославленным художником! Он выглядел очень реалистично, а цвета... подобраны весьма талантливо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950816
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950816,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950817
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950817,
					"content": "(Может, Паймон восхваляет не то, что нужно?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950818,
						732950819
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950818,
					"content": "(Не спрашивай меня. Я тоже ничего не понимаю.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950820
					]
				},
				{
					"id": 732950820,
					"content": "Я не хотел так рисовать. Я просто... Я просто хотел стать первоклассным художником. Скажите, неужели это действительно так сложно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950821
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950821,
					"content": "Ох... Простите, я не должен был врать вам, друзья. Стоит один раз соврать, как затем приходится врать ещё больше, а я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950822
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950822,
					"content": "По правде говоря, я всего лишь второсортный художник, который не может «правильно» различать цвета, как это делают другие, но я не хотел отказываться от своей мечты стать мастером.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950823
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950823,
					"content": "Поэтому я воспользовался помощью... друга, и теперь могу нарисовать что угодно в точности так, как оно выглядит, но мои проблемы с восприятием цвета никуда не делись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950824
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950824,
					"content": "Подожди. Ты сказал, что можешь нарисовать что угодно в точности так, как оно выглядит... Значит, эта способность не является результатом практики?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950825
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950825,
					"content": "Нет. У моего друга довольно обширные способности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950826
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950826,
					"content": "Правда? Я не верю!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950827
					]
				},
				{
					"id": 732950827,
					"content": "Или лучше сказать, что я потерял способность рисовать вещи не так, как они выглядят. Я полагаю, это то, что называют «платой за способности». Я знаю, звучит неправдоподобно, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950828
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950828,
					"content": "Жюльен делает для вас копию «Опыта искателя приключений».\\nВы изучаете копию и оригинал, и не находите между ними никакой разницы.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732950848
					]
				},
				{
					"id": 732950848,
					"content": "Разница, пожалуй, лишь в том, что после прочтения копия оставляет в голове странное чувство пустоты... \\nБудто вы читали её, но не прочли, будто время потрачено, а пользы никакой...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732950849
					]
				},
				{
					"id": 732950849,
					"content": "Внешне копия ничем не отличается от оригинала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950829
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950829,
					"content": "Ха-ха, я не стал знаменитым художником, но зато стал настоящим мастером подделок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950830
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950830,
					"content": "Но разве это не противозаконно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950831
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950831,
					"content": "...Разумеется. Именно поэтому, отбыв наказание, я твёрдо решил заняться чем-то законным. На этот раз я непременно стану настоящим художником!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950832
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950832,
					"content": "Но эта способность рисовать вещи с предельной точностью... Если бы кто-то другой, а не Катерпиллер, наделил меня ею, я бы назвал её проклятием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950833
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950833,
					"content": "Сейчас я похож на сломанную фотокамеру, способную создавать только фотографии с плохо подобранными цветами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950834
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950834,
					"content": "Я верил, что если совершу паломничество по пути океанид, то смогу найти лекарство... которое позволит мне различать цвета так, как различают другие, и наделит меня творческими способностями, сродни тем, что присущи невинным детям...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950835,
						732950837
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950835,
					"content": "Кто такой Катерпиллер?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950836
					]
				},
				{
					"id": 732950836,
					"content": "Мой друг... мой самый верный друг. Именно он сказал мне, что, пройдя по пути океанид, я смогу найти в Сумеру лекарство, способное излечить любые недуги и дать человеку новую жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950839
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950839,
					"content": "Звучит очень подозрительно! Что это за друг такой? Ты уверен, что он тебя не обманул?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950840
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950840,
					"content": "Он столько всего видел и знает. Зачем ему обманывать меня? Должно быть, это я в чём-то ошибся... Как я уже говорил, моя жизнь - это череда ошибок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950841
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950841,
					"content": "Боюсь, что это чудодейственное лекарство находится под надёжной охраной. Обычный человек вроде меня его ни за что не получит. Я... я уже смирился с этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950842
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950842,
					"content": "Готов поспорить, что даже Перчик не хотел следовать за мной в Сумеру, иначе он не пытался бы преграждать мне дорогу на каждом шагу, получая взамен лишь ругательства. Надо было оставить его в Фонтейне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950843
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950843,
					"content": "Паймон думает, что он по-прежнему хочет быть с тобой. Ему определённо нравятся твои рисунки... Нельзя просто взять и сдаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950844
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950844,
					"content": "Ты умеешь утешать... Но я больше не питаю надежд. Вы уже несколько раз приходили мне на помощь, но я так и не смог отплатить вам по достоинству...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950845
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950845,
					"content": "Как только я поправлюсь, займусь подготовкой к возвращению в Фонтейн. Это может показаться дерзкой просьбой, но не могли бы вы проводить меня обратно к главной дороге?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950846
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950846,
					"content": "Ох, если бы я сдался раньше или меньше пытался сохранить достоинство... Возможно, сейчас я шёл бы по правильному пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950847
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950847,
					"content": "Конечно, мы проводим тебя. Только сперва тебе нужно хорошенько отдохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950850
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732950850,
					"content": "Спасибо вам, друзья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950837,
					"content": "Что ещё за путь паломничества?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950838
					]
				},
				{
					"id": 732950838,
					"content": "Катерпиллер сказал, что, пройдя по пути океанид, конечной точкой которого является Сумеру, я смогу найти лекарство, способное излечить любые недуги и дать человеку новую жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950839
					],
					"speakerTitle": "Жюльен"
				},
				{
					"id": 732950819,
					"content": "(Возможно, это искусство за пределами твоего понимания, Паймон.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950820
					]
				}
			]
		},
		{
			"id": 7329509,
			"completionStepIds": [],
