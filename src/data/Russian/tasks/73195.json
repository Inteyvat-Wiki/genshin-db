			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951401,
					"content": "«Кстати, раньше мне встречалась неплохая такая наёмница. Звали её Пламенная Грива или как-то в этом роде...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951402
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951402,
					"content": "«Я частенько нанимал её, когда выходил в море по делам. Неважно, наткнёшься ты на Похитителей сокровищ или же Миллелитов, с ней тебе бояться нечего. Я и разбогател по-настоящему только благодаря ей».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951403
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951403,
					"content": "«Однако в последнее время она вдруг перестала брать поручения. Ещё говорят, что монстров на пути в Ли Юэ стало заметно больше... Если так пойдёт дальше, придётся держать деньги на бирже Калими».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951404
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951404,
					"content": "«Что-то не похож ты на человека, который занимается законным бизнесом. А по поводу Пламенной Гривы... Я слышал, недавно она заключила большой контракт с домом Хомаяни. Так что придётся тебе немного подождать».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951405
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951405,
					"content": "«И, кстати, дам тебе совет: лучше уж купить сотню ковров, чем вкладываться в биржу Калими!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951406
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951406,
					"content": "«Вы абсолютно правы! Пожалуйста, загляните в наш магазин, мы предложим вам сотню ковров и даже больше! Обращайтесь, мы готовы подробно рассказать о каждом из наших товаров!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
