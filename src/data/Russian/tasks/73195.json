			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951301,
					"content": "«С тех пор как я стал лесным стражем и начал проводить всё своё время в лесу, страшно хочется поговорить хоть с кем-нибудь, пусть даже с сумеречной птицей».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951302
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951302,
					"content": "«Если бы я понимал их язык, мне было бы не так скучно».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319514,
			"completionStepIds": [
				7319514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319514",
							"2"
