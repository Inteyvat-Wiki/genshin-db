			"dialogs": [
				{
					"id": 731950101,
					"content": "Данная доска объявлений создана господином визирем специально для освещения важных событий в городе Сумеру. При возникновении каких-либо вопросов оставьте своё сообщение здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319502,
			"completionStepIds": [
				7319502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319502",
							"2"
						],
						"stepId": 7319502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950201,
					"content": "«Объявление: Ищем специалистов по работе с тиграми ришболандами...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950202
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950202,
					"content": "Текст объявления замазан краской. Рядом косым детским почерком написано...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950203
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950203,
					"content": "«Ришболанд-раджа просто хочет поиграть!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319503,
			"completionStepIds": [
				7319503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319503",
							"2"
						],
						"stepId": 7319503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950301,
					"content": "«Если после поедания грибов вы стали видеть танцующих волшебных существ, не пугайтесь. Это нормальная реакция».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950302
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950302,
					"content": "«Однако если окружающие растения начинают с вами разговаривать, немедленно обратитесь за помощью к ближайшему лесному дозорному».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319504,
			"completionStepIds": [
				7319504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319504",
							"2"
						],
						"stepId": 7319504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950401,
					"content": "«По неизвестным причинам в последнее время в лесу увеличилось как количество зон Увядания, так и их площадь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950402
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950402,
					"content": "«Зона Увядания не только приводит к гибели растений, но также может быть смертельно опасной для диких животных и даже людей. Настоятельно просим вас не приближаться к заражённым зонам, очерченным лесными стражами».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950403
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950403,
					"content": "«Если вы заметили в лесу новый участок Увядания, пожалуйста, свяжитесь с ближайшим лесным дозорным, не пытайтесь бороться с Увяданием самостоятельно».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319505,
			"completionStepIds": [
				7319505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319505",
							"2"
						],
						"stepId": 7319505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950501,
					"content": "В ходе последних плановых проверок местных базаров матры обнаружили несколько случаев незаконной торговли Капсулами знаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950502
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950502,
					"content": "Торговля Капсулами знаний запрещена Академией и будет строго наказываться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950503
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950503,
					"content": "Академия не несёт ответственности за последствия незаконного использования Капсул знаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319506,
			"completionStepIds": [
				7319506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319506",
							"2"
						],
						"stepId": 7319506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950601,
					"content": "«Ежегодный Сабзеруз уже не за горами. Проводить грандиозный фестиваль будут там же, где и в прошлом году, - на Большом базаре».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950602
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950602,
					"content": "«Чтобы настроить всех на праздничный лад, наша госпожа пожаловала торговцев, которые прибыли на фестиваль, специальными выплатами».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950603
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950603,
					"content": "«Отпразднуем же день рождения малой властительницы Кусанали вместе!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319507,
			"completionStepIds": [
				7319507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319507",
							"2"
						],
						"stepId": 7319507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950701,
					"content": "«Наша госпожа ушла из дома и до сих пор не вернулась. Если вы увидите молодую девушку с каштановыми волосами, одетую в голубое платье и фиолетовую накидку, пожалуйста, свяжитесь с домом Хомаяни. За любую помощь вас будет ждать достойная награда!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950702
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950702,
					"content": "«Если же это объявление читаете вы, госпожа, пожалуйста, как можно скорее свяжитесь с нами. Родители очень о вас беспокоятся».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319508,
			"completionStepIds": [
				7319508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319508",
							"2"
						],
						"stepId": 7319508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950801,
					"content": "«Вернулся! Повелитель аль-Ахмар вернулся!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950802
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950802,
					"content": "«День его возвращения станет днём возмездия для всех вас, листоголовые!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950803
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950803,
					"content": "Информация недостоверна, в данный момент проводится расследование, кто распустил этот слух. Все события в Сумеру регулярно освещаются в Акаше. Пожалуйста, не доверяйте неподкреплённым слухам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319509,
			"completionStepIds": [
				7319509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319509",
							"2"
						],
						"stepId": 7319509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950901,
					"content": "«Друг мой, какими бы ни были твои заботы, всемогущая Сангема-бай обязательно поможет найти решение».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950902
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950902,
					"content": "«Немного моры, и я решу все твои проблемы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950903
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950903,
					"content": "«Хватит расстраиваться, пора действовать! Контактная информация...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950904
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731950904,
					"content": "Данная доска объявлений создана господином визирем для регулирования деятельности рынка. Пожалуйста, не размещайте здесь никаких объявлений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319510,
			"completionStepIds": [
				7319510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319510",
							"2"
						],
						"stepId": 7319510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951001,
					"content": "«Кто-нибудь знает, где найти хорошего рассказчика? Нужен человек, у которого все истории в точности одинаковы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951002
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951002,
					"content": "«Меня преследует жуткий джинн, угрожая убийством, если я не буду рассказывать ему одну и ту же историю каждый день. Прошёл уже месяц, и у меня мозги набекрень от этой ежедневной пытки...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951003
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951003,
					"content": "«Какая странная история. Но я слышал, что в кафе \"Пуспа\" есть рассказчик по имени Маддах. Возможно, он сумеет тебе помочь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319511,
			"completionStepIds": [
				7319511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319511",
							"2"
						],
						"stepId": 7319511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951101,
					"content": "«Я был во многих странах и видел бесчисленное количество выступлений. И у меня нет ни малейшего сомнения, что Нилу - лучшая танцовщица во всём Тейвате. Но эти всезнайки из Академии не только не оценили её таланта, но ещё и посмели критиковать! Настоящее оскорбление для искусства!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951102
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951102,
					"content": "«По своему опыту жизни в Мондштадте скажу, что надо организовать фан-клуб для Нилу. Тогда всякие выскочки, которые ничего не смыслят в искусстве, не посмеют больше её критиковать».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951103
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951103,
					"content": "«Фан-клуб?.. Это какой-то обычай Мондштадта? Но ведь красивое выступление - результат совместных усилий всех членов труппы. Превозносить одного артиста из труппы попросту несправедливо».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951104
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951104,
					"content": "«Более того, я считаю, что искусство не нуждается в фан-клубах. Оно способно объединять людей само по себе. Но приятно узнать, что вам нравится, как танцует Нилу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951105
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951105,
					"content": "«Судя по изящному почерку, ответ написан рукой некой юной особы? Как приятно найти родственную душу, которая разделяет мой интерес к танцевальному искусству. Позвольте пригласить вас на чашечку кофе?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951106
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951106,
					"content": "«Прошу прощения, но у меня много дел. По всем вопросам обращайтесь к моему менеджеру».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951107
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951107,
					"content": "«Тяжело это, наверное, когда тебя отшивают. Бедняга. Последнее сообщение написано очень сурово. Наверняка писал телохранитель какой-нибудь наследницы богатого дома».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319512,
			"completionStepIds": [
				7319512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319512",
							"2"
						],
						"stepId": 7319512,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951201,
					"content": "«В продаже имеются волшебные сосуды. Волшебные сосуды, в которых таятся джинны! Оплату, пожалуйста, оставляйте здесь. Всего-то одна мора, и ваша мечта исполнится!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951202
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951202,
					"content": "«Акция! Волшебные сосуды, исполняющие любое желание. Одна мора - и желание исполнено».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951203
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951203,
					"content": "«Я джинн. Исполню любое желание всего за одну мору».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951204
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951204,
					"content": "«Цитадель Регзара уже расследует недавнюю череду случаев мошенничества. Пожалуйста, не поддавайтесь панике».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951205
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731951205,
					"content": "«Все потерпевшие могут обратиться за консультацией (стоимость консультации - 1 мора)».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319513,
			"completionStepIds": [
				7319513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
