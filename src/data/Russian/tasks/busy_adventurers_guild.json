			"completionStepIds": [
				2050501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050501",
							"2"
						],
						"stepId": 2050501,
						"stateName": "QUEST_STATE_UNFINISHED"
