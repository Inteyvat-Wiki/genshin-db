			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050101,
					"content": "Прости, что снова тебя отвлекаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050102,
						205050104
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050102,
					"content": "Ничего страшного. Мы уже всё выполнили.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050103
					]
				},
				{
					"id": 205050103,
					"content": "Рада это слышать. Давай я вкратце расскажу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050106,
					"content": "Гильдия бесконечно благодарна тебе за выполненные поручения. Наша репутация становится всё лучше и лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050107
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050107,
					"content": "Поэтому мы получаем всё больше и больше заказов. Нам просто не хватает рук, чтобы выполнить их все.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050108
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050108,
					"content": "Вы хотите, чтобы мы привлекли больше людей в Гильдию и сделали из них профессиональных искателей приключений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 205050109,
					"content": "Ммм... Я немножко не об этом. Хотя новые люди нам бы не помешали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050110
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050110,
					"content": "Но у нас есть задачи, требующие незамедлительного решения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050111
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050111,
					"content": "Я хочу спросить, смогут ли ваши друзья нам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050112,
						205050114
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050112,
					"content": "Для начала нужно спросить их самих.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050113
					]
				},
				{
					"id": 205050113,
					"content": "Отлично! Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050117,
					"content": "Прямо сейчас нам очень нужны люди для <color=#00E1FFFF>экспедиций</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050118
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050118,
					"content": "Экспедиций?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050119
					]
				},
				{
					"id": 205050119,
					"content": "Мы организуем разведывательные экспедиции вокруг города, чтобы быть готовыми к любым угрозам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050120
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050120,
					"content": "У экспедиций нет строго установленных сроков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050121
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050121,
					"content": "Тем не менее снаряжать эти экспедиции в наших интересах. Если мы пропустим какую-либо опасность на начальной стадии, то последствия могут оказаться катастрофическими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050122
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050122,
					"content": "Звучит серьёзно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050123,
						205050125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 205050123,
					"content": "#Я уверен{F#а}, что мои друзья с пониманием отнесутся к моей просьбе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050124
					]
				},
				{
					"id": 205050124,
					"content": "Просто убеди их помочь Гильдии, а остальное я возьму на себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050127,
					"content": "Не будем терять время. Давай посмотрим, какие экспедиции доступны на данный момент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050128
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050128,
					"content": "Посмотреть экспедиции",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205050125,
					"content": "А награды?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050126
					]
				},
				{
					"id": 205050126,
					"content": "Ты и твои друзья получите щедрые награды за выполненные экспедиции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050114,
					"content": "Вы хотите, чтобы все мои друзья присоединились к Гильдии?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050115
					]
				},
				{
					"id": 205050115,
					"content": "Нет, я не совсем точно выразилась. Я понимаю, что у твоих друзей есть свои дела, и не каждому подходит жизнь искателя приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050116
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050116,
					"content": "Моя просьба состоит в другом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050104,
					"content": "Мы забыли забрать какую-то награду?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050105
					]
				},
				{
					"id": 205050105,
					"content": "Ха-ха! Нет, но я думаю, мне удастся тебя заинтересовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Катерина"
				}
			]
		},
		{
			"id": 2050502,
			"completionStepIds": [
				2050502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050502",
							"2"
						],
						"stepId": 2050502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050201,
					"content": "#Ты можешь начать экспедицию в любой момент. Тот, кого ты отправил{F#а} в экспедицию, по-прежнему сможет отправиться с тобой в приключения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050202
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050202,
					"content": "Длительность экспедиции зависит от её уровня. Когда экспедиция будет завершена, просто зайди ко мне, чтобы подтвердить её результаты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050203
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050203,
					"content": "Чем выше твой Ранг приключений, тем более опасные экспедиции станут тебе доступны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050204
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050204,
					"content": "С большой силой приходит и большая ответственность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 205050205,
					"content": "Конечно, в опасные экспедиции следует отправлять более опытных бойцов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050206
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 205050206,
					"content": "Гильдия благодарит тебя за проявленное понимание. Мы рассчитываем на тебя и твоих друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				}
			]
		}
	]
}