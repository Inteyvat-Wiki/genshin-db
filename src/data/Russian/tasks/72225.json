					"Ру"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722250101,
					"content": "Уй, как больно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250102
					],
					"speakerTitle": "Ку"
				},
				{
					"id": 722250102,
					"content": "#{NICKNAME}, Паймон! Вы пришли очень кстати...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250103
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250103,
					"content": "Что такое, в чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250104
					]
				},
				{
					"id": 722250104,
					"content": "Ай-ай-ай, кажется, я подвернул ногу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250105
					],
					"speakerTitle": "Ку"
				},
				{
					"id": 722250105,
					"content": "Ку опять поранился. Поможете нам сделать подношение гнездовью?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250106,
						722250108
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250106,
					"content": "#Знаете, я чего-то подобного и {F#ожидала}{M#ожидал}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250107
					]
				},
				{
					"id": 722250107,
					"content": "Ни о чём не переживайте, мы всё сделаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722250109,
					"content": "Большое вам спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250110
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250110,
					"content": "Ах да, Ру, ты же восприимчив к стихиям и всё такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722250111,
					"content": "Почему бы тебе не сделать подношение самому?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722250112,
					"content": "Ну... На прошлых церемониях я пытался, но вышло не очень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250113,
						722250115,
						722250116
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250113,
					"content": "И почему же?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250114
					]
				},
				{
					"id": 722250114,
					"content": "Сам не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250117
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250117,
					"content": "Ладно. Мы тогда позаботимся о гнездовье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722250115,
					"content": "Тогда я возьму всё на себя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250116,
					"content": "А ты позаботься о травмировавшемся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250108,
					"content": "Разумеется.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250109
					]
				}
			]
		},
		{
			"id": 7222502,
			"completionStepIds": [],
