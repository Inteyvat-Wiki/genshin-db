			},
			"dialogs": [
				{
					"id": 722250201,
					"content": "Пожалуйста, помогите нам с гнездовьем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250202
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250202,
					"content": "А я останусь с Ку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ру"
				}
			]
		},
		{
			"id": 7222503,
			"completionStepIds": [
				7222505
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7222505",
							"2"
						],
						"stepId": 7222505,
