			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ру",
					"Ку"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722250301,
					"content": "Теперь гнездовье светится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250302
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250302,
					"content": "Подношение, кажется, совершено. Простите. Думаю, вам пришлось непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250303
					],
					"speakerTitle": "Ку"
				},
				{
					"id": 722250303,
					"content": "Хе-хе, не забывай, что мы - мастера по решению проблем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722250304,
					"content": "Почти как церемония по перенаправлению света.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250305
					]
				},
				{
					"id": 722250305,
					"content": "Уладить три проблемки в трёх местах, чтобы справиться с проблемой побольше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722250306,
					"content": "Такое происходит с нами постоянно, не находишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722250307,
					"content": "Мне не очень понятно, о чём вы говорите, но у взрослых есть такая поговорка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250308
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250308,
					"content": "Называется «Правило трёх».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250309
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250309,
					"content": "Правило трёх... Что это означает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722250310,
					"content": "Ну... Смысл примерно такой, что для достижения результата всё нужно делать трижды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250311
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250311,
					"content": "Например, удача придёт, только если три раза случится счастливое знамение. Для дурных знамений то же самое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250312
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250312,
					"content": "Ещё говорят, что в любом деле нужно преодолеть трудности трижды, а на четвёртый раз тебя будет ожидать успех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250313
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250313,
					"content": "Погоди, это уже скорее «Правило четырёх», не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722250314,
					"content": "И то правда! Паймон отлично умеет считать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250315
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250315,
					"content": "Хе-хе, а как же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250316,
						722250318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722250316,
					"content": "При чём здесь это?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250317
					]
				},
				{
					"id": 722250317,
					"content": "Как бы то ни было, ты уверен, что Ку будет в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722250319,
					"content": "Не переживай, с ним всегда так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250320
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250320,
					"content": "Эх, как неловко вышло... надеюсь, это не скажется на церемонии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250321
					],
					"speakerTitle": "Ку"
				},
				{
					"id": 722250321,
					"content": "А если скажется, я потом не смогу смотреть тебе в глаза, Ру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250322
					],
					"speakerTitle": "Ку"
				},
				{
					"id": 722250322,
					"content": "Что ты, не надо так. Ты ведь всегда был так добр ко мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250323
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250323,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250324
					],
					"speakerTitle": "Ку"
				},
				{
					"id": 722250324,
					"content": "#{NICKNAME}, Паймон, идите первыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250325
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250325,
					"content": "Я пока побуду с Ку. А когда вы закончите с подношением, мы займёмся уборкой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ру"
				},
				{
					"id": 722250318,
					"content": "Кстати, как у Ку с ногой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250319
					]
				}
			]
		},
