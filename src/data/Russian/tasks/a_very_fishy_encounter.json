			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джала"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700460101,
					"content": "Прекрасно, все приготовления завершены...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460102
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460102,
					"content": "Соберись, Джала, тебе нужно как следует постараться и поймать их за несколько дней!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460103,
						700460104
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460103,
					"content": "Поймать? Поймать кого?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				},
				{
					"id": 700460105,
					"content": "Ого! Откуда в Фонтейне браконьер? Неужели на чёрном рынке большой спрос на животных?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700460106,
					"content": "Ну уж нет, мы тебя арестуем и отправим в Палату Жардинаж!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700460107,
					"content": "А, это вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460108
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460108,
					"content": "Да, конечно. Я только что из Палаты Жардинаж. Хотите, чтобы я показала дорогу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460109
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460109,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460110,
						700460112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700460110,
					"content": "Хорошо, мне нравятся открытые люди!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460111
					]
				},
				{
					"id": 700460111,
					"content": "Подождите, что-то не так... Тебя совсем не пугает мысль об аресте. Должно быть, ты регулярно совершаешь преступления... Или, может быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700460114,
					"content": "Я стою на защите справедливости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460115
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460115,
					"content": "Если быть точнее, то я являюсь консультантом Палаты Жардинаж по экологическим вопросам - Охотник-Освободитель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460116
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460116,
					"content": "Я охочусь на инвазивные виды рыб в водах Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460117
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460117,
					"content": "Инвазивные виды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460118,
						700460120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700460118,
					"content": "Звучит знакомо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460119
					]
				},
				{
					"id": 700460119,
					"content": "Да, Паймон припоминает, что-то такое случалось раньше в Мондштадте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700460122,
					"content": "Ладно, не будем ворошить прошлое. Важнее то, что происходит здесь и сейчас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460123
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460123,
					"content": "Эти рыбы не местные виды, сюда их выпустили торговцы, которые придерживаются странных убеждений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460124
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460124,
					"content": "Некоторые из этих рыб особенно свирепы, некоторые размножаются очень быстро, а некоторые нуждаются в специальном корме. Для местных водных обитателей они представляют огромную проблему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460125
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460125,
					"content": "Если такие рыбы занимают территорию местных обитателей и меняют экосистему, они могут повлиять на качество воды в Фонтейне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460126
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460126,
					"content": "Если мы не будем обращать внимание на долгосрочную проблему здоровья жителей Фонтейна, то вкус Фонты изменится практически сразу. Это плохо повлияет на экономику Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460127,
						700460128
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460127,
					"content": "Фонта! Защитим Фонту!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460129,
					"content": "Преуменьшение лишь усугубляет проблему! Мы не можем остаться в стороне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700460130,
					"content": "Мы опытные рыбаки. Может, мы тебе поможем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700460131,
					"content": "Я ждала, что вы это скажете!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460132
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460132,
					"content": "Я создала ловушку, которая приманит рыб.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460133
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460133,
					"content": "Покажите свою доблесть, почётный рыцарь и белая помощница! Я буду поддерживать вас в тылу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460134
					],
					"speakerTitle": "Джала"
				},
				{
					"id": 700460134,
					"content": "Почему-то Паймон кажется, что она нас отлично знает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700460128,
					"content": "Я не пью Фонту, но понимаю её важность.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460120,
					"content": "Это что?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460121
					]
				},
				{
					"id": 700460121,
					"content": "Паймон плохо помнит, но где-то мы уже слышали о таком. Должно быть, это было в Мондштадте давным-давно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700460112,
					"content": "Ой, кажется, мы что-то не так поняли?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460113
					]
				},
				{
					"id": 700460113,
					"content": "Да. Её совсем не пугает мысль об аресте. Должно быть, она регулярно совершает преступления... Или, может быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700460104,
					"content": "Браконьер?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				}
			]
		}
	]
}