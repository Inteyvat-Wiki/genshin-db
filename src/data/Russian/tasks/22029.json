			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Асакура"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290301,
					"content": "*тяжело дыша* Вы... действительно очень сильны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290302,
					"content": "Я... я многому научился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290303,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "Всё... нормально. Сейчас только передохну минутку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290306,
					"content": "Но вы действительно настолько сильны, что я начинаю верить вашему заявлению, что вам случилось однажды победить гигантского дракона...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290307,
					"content": "Потому что мне и правда случалось биться с гигантскими драконами и брать над ними верх...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "Ха-ха-ха... Верю, верю! Спасибо, что тренировались со мной. Я запомню то, чему научился в этом матче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290309,
					"content": "Если вы не возражаете, пожалуйста, впредь приходите и тренируйтесь со мной почаще. Имея такого сильного воина, как вы, в качестве партнёра по тренировкам... Я уверен, что скоро смогу покончить с этим делом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290310,
					"content": "С тем делом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "Кхм... Это просто маленькое желание, которое живёт у меня в сердце. Спасибо за помощь. Пожалуйста, примите это в качестве благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290312,
					"content": "Теперь мне нужно вернуться и передохнуть. Ваши атаки были очень могущественными...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290304,
					"content": "#Извини, я, должно быть, немножко перебрал{F#а} с «не сдерживайся»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
		{
			"id": 2202904,
