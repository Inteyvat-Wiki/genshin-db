				"points": []
			},
			"dialogs": [
				{
					"id": 220290201,
					"content": "Вы же сейчас сдерживались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290202
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290202,
					"content": "Не беспокойтесь о моей гордости. Пожалуйста, бейтесь со мной в полную силу. Я... должен стать сильнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асакура"
				}
			]
		},
		{
			"id": 2202903,
			"completionStepIds": [
				2202903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
