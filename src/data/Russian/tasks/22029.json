			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Асакура"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290101,
					"content": "Я должен! Я должен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290102
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290102,
					"content": "А? Кто ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290103
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290103,
					"content": "Я принимаю твоё поручение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290104
					]
				},
				{
					"id": 220290104,
					"content": "О, ты имеешь в виду мой запрос партнера по тренировкам. Верно, я размещал подобный запрос. Я хочу найти кого-нибудь для совместных тренировок по боевым искусствам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290105
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290105,
					"content": "#Так это ты его принял{F#а}? Мне кажется, я никогда раньше не встречал тебя в городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290106
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290106,
					"content": "Прошу прощения, я не ставлю под сомнение твою силу. Но я действительно не уверен, каковы твои навыки боевых искусств...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290107,
						220290109
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290107,
					"content": "В прошлом мне доводилось побеждать гигантских драконов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290108
					]
				},
				{
					"id": 220290108,
					"content": "#Ха-ха-ха... Неужели? Вообще-то, меня больше интересует, где ты их наш{M#ёл}{F#ла}. Я слышал о них, но никогда не видел собственными глазами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290112,
					"content": "#О, не волнуйся, я довольно способн{F#ая}{M#ый}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290113
					]
				},
				{
					"id": 220290113,
					"content": "Ха-ха, в любом случае слова ничего не значат. Давай узнаем всё на деле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290114,
						220290115
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290114,
					"content": "С удовольствием.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220290115,
					"content": "Кстати, почему ты оставил запрос анонимно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290116
					]
				},
				{
					"id": 220290116,
					"content": "Ну, на самом деле это из-за того, чем я... не горжусь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290117
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290117,
					"content": "#Гм, поскольку ты уже принял{F#а} его, я скажу тебе правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290118
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290118,
					"content": "Ранее я был на задании с несколькими досинами. На обратном пути мы столкнулись с группой кайраги, которые готовились к налёту на торговый караван.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290119
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290119,
					"content": "Мы бросились туда, чтобы спасти караван. Вначале мы одерживали верх, а они быстро отступали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290120
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290120,
					"content": "Но когда мы уже собирались передохнуть, из ниоткуда внезапно появилась ещё одна группа кайраги, и, похоже, ими командовал один из вождей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290121
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290121,
					"content": "Не успели мы с коллегами среагировать, как они уже навалились на нас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290122
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290122,
					"content": "Потеряв преимущество, всё, что мы могли, это отчаянно отбиваться от них, пока купцы не вернулись в город.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290123
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290123,
					"content": "А когда я бился с вождём кайраги... он забрал моё оружие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290124
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290124,
					"content": "После чего он поднял и держал моё оружие в воздухе, всё это время насмехаясь надо мной. Какое унижение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290125
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290125,
					"content": "Что случилось с этой группой торговцев?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290126
					]
				},
				{
					"id": 220290126,
					"content": "При отступлении мы столкнулись с другими патрульным, и кайраги поняли, что теперь пора отступать именно им.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290127
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290127,
					"content": "Этих самих купцов мы-то сопроводили до города. Но все их товары были... Эх! Это всё потому, что моих навыков оказалось недостаточно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290128
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290128,
					"content": "После возвращения мне также выдали другое оружие. Но я до сих пор не могу забыть о том, что произошло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290129
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290129,
					"content": "Поэтому я разместил этот заказ в надежде отточить своё мастерство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290130
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290130,
					"content": "Когда я стану достаточно сильным, я сам одолею этого кайраги и заберу своё оружие обратно, очистив это пятно с моего имени!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290109,
					"content": "#Я был{F#а} свидетелем падения бога.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290110
					]
				},
				{
					"id": 220290110,
					"content": "#Э, о чём ты говоришь? Ты имеешь в виду, что ты принимал{F#а} участие в Церемонии Сошествия в Ли Юэ, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290111
					],
					"speakerTitle": "Асакура"
				},
				{
					"id": 220290111,
					"content": "Ха-ха-ха, исходя из твоей логики, многие люди в Ли Юэ также «были свидетелями падения бога».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Асакура"
				}
			]
		},
		{
			"id": 2202902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
