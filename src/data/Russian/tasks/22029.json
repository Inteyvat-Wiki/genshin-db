					"content": "Приступим же!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290601
					]
				},
				{
					"id": 220290601,
					"content": "Мечи не лгут. Защищайтесь!",
					"roleType": "TALK_ROLE_NPC",
