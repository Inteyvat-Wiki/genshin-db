				},
				{
					"id": 726910203,
					"content": "Помните, вам нужно сделать <color=#00E1FFFF>4</color> фотографии диковинок Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лэннэ"
				}
			]
		},
