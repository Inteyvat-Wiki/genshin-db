			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120701,
					"content": "Бой закончился. Дилюк с лёгкостью справился с ними. Этого у него не отнять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120702,
					"content": "Но есть ли здесь настоящая опасность? Пока мы видели только иллюзии из прошлого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120703,
						705120704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120703,
					"content": "Дилюк из настоящего уже наверняка здесь побывал.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120705
					]
				},
				{
					"id": 705120705,
					"content": "Значит, Дилюк уже всё уладил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120706
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120706,
					"content": "А если мы прикоснёмся к тому застою артерий земли? Появятся ли чудовища? И как насчёт Дилюка из прошлого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120707,
					"content": "Мы уже имели дело с застоями артерий земли. Если этот такой же, то достаточно будет победить чудовищ, и он исчезнет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120708,
						705120709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120708,
					"content": "Паймон, тебе любопытен Дилюк из прошлого?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120710
					]
				},
				{
					"id": 705120710,
					"content": "Да нет, Паймон просто чуточку беспокоится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120711
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120711,
					"content": "Если какой-нибудь прохожий придёт сюда поглазеть, и вдруг на него выскочит чудовище - а-а-а! И бах, и бух его по голове! Вот это будет ужасненько.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120712,
					"content": "К чему все эти странные звуки?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120713
					]
				},
				{
					"id": 705120713,
					"content": "Потому что они передают всю опасность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120714,
					"content": "Но мы ведь пришли сюда помочь Дилюку, верно? Побудем здесь ещё немного, убедимся, что всё тихо, и тогда уже уйдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120715
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120715,
					"content": "А Паймон не чуждо чувство ответственности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120716
					]
				},
				{
					"id": 705120716,
					"content": "Хе-хе... вовсе нет. Паймон просто хочет вкусного виноградного сока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120717
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120717,
					"content": "#Так что, {NICKNAME}, ты уж постарайся. Когда получим сок, Паймон оставит тебе побольше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120709,
					"content": "Тебя заинтересовали аномалии артерий земли, Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120710
					]
				},
				{
					"id": 705120704,
					"content": "Даже если здесь и остались враги, так только жалкие недобитки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120705
					]
				}
			]
		},
