	"talks": [
		{
			"id": 7051202,
			"completionStepIds": [
				7051201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051201",
							"2"
						],
						"stepId": 7051201,
						"stateName": "QUEST_STATE_UNFINISHED"
