				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аделинда"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120201,
					"content": "Приветствую! Давно не виделись. Вы прекрасно выглядите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120202
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120202,
					"content": "Привет, Аделинда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120203,
					"content": "Вы, полагаю, пришли встретиться с господином Дилюком по важному делу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120204,
						705120205
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120204,
					"content": "Не сказать, что у нас что-то важное...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				},
				{
					"id": 705120206,
					"content": "Вот именно. Аделинда, раз уж ты здесь, может, поможешь нам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120207,
					"content": "Мы никогда не успеваем купить виноградный сок со скидкой, так что на этот раз решили заглянуть к вам пораньше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120208,
					"content": "Если нужно, мы оставим задаток побольше, а ты зарезервируй нам бутылочку, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120209,
					"content": "Конечно, без проблем! И никаких задатков не нужно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120210
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120210,
					"content": "Боюсь только, что вам придётся подождать. На приготовление виноградного сока со скидкой нам требуется немало времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120211
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120211,
					"content": "Каждое лето господин Дилюк лично отбирает две бочки лучшего винограда, чтобы сделать из него сок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120212
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120212,
					"content": "Погоди. А зачем продавать отличный продукт по низкой цене? Разве лучший виноград не самый дорогой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120213,
					"content": "Господин никогда этого не объяснял. Я могу лишь догадываться, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120214
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120214,
					"content": "Скидка - это такой приём. Скидки всегда привлекают клиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120215
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120215,
					"content": "Возможно, господин хочет таким образом сделать сок популярнее, чтобы выбор напитков был более разнообразным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120216
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120216,
					"content": "Это отличная альтернатива для сильно пьющих, потому что они перестанут напиваться и устраивать беспорядки, а непьющие откроют для себя нечто новое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120217,
						705120218
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120217,
					"content": "Разве это не навредит делам винокурни?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120219,
					"content": "Деньги для господина не главное. Думаю, он предпочёл бы видеть в меру пьющих гостей, а не горы прибыли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120220
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120220,
					"content": "Только представьте, если бы все могли наслаждаться хорошим вином, оставаясь в трезвом рассудке... Было бы здорово, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120221
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120221,
					"content": "Ого, Дилюк такой заботливый...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120222,
					"content": "Значит, сейчас Дилюк отбирает урожай винограда на этот год?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120223,
					"content": "Ещё нет. Перед тем как приступить к сбору, ему нужно решить несколько проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120224
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120224,
					"content": "Если у вас есть время, уверена, господин Дилюк с радостью бы встретился с вами и услышал ваши предложения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120225
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120225,
					"content": "Проблем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120226
					]
				},
				{
					"id": 705120226,
					"content": "Как вы знаете, господин, заслышав о приходе сомнительных гостей, считает нужным устроить им личный «приём». Нечто подобное случилось и в этот раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120227
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120227,
					"content": "Сегодня господин отправился в окрестности побережья Сокола. Не знаю, когда он вернётся... Может, вы пока зайдёте в дом и подождёте его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120228
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120228,
					"content": "Мне нужно подождать здесь гостей, но Хилли и Моко о вас позаботятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120229
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120229,
					"content": "Сомнительные... гости? Не понимаю, о чём это Аделинда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120230,
						705120234
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120230,
					"content": "Наверное, это связано с «другой работой» Дилюка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120231
					]
				},
				{
					"id": 705120231,
					"content": "А, ты имеешь в виду Полуноч...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120232,
					"content": "Кхе-кхе! Орден Бездны опять затеял какую-то пакость?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120233,
					"content": "Тогда мы должны что-то предпринять! Дилюк ведь наш друг!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120238,
					"content": "Здорово, что вы хотите помочь. Всё-таки господин доверяет вам, и на вас можно положиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120239
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120239,
					"content": "Спасибо, что вы вызвались помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120240
					],
					"speakerTitle": "Аделинда"
				},
				{
					"id": 705120240,
					"content": "Не стоит благодарности! Чем раньше Дилюк освободится, тем скорее мы купим вкусного виноградного сока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120241,
					"content": "#{NICKNAME}, пойдём на побережье Сокола!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120234,
					"content": "Тогда мы подождём Дилюка на винокурне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120235
					]
				},
				{
					"id": 705120235,
					"content": "Но... Паймон кажется, сидеть сиднем в доме Дилюка, пока он занят делом, не годится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120236
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120236,
					"content": "Идём на побережье Сокола и поможем Дилюку справиться с этими проблемами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120237
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120237,
					"content": "Дилюк очень сильный, но наша помощь ему точно не помешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120218,
					"content": "Вряд ли эта затея станет особенно прибыльной...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120205,
					"content": "...мы просто за виноградным соком",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				}
			]
		},
		{
			"id": 7051204,
			"completionStepIds": [
				7051204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051204",
							"2"
						],
						"stepId": 7051204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120401,
					"content": "Вряд ли это палатка Дилюка. Может, какой-нибудь искатель приключений разбил здесь лагерь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120402,
					"content": "Там ещё какая-то бумажка и записи. Что в них написано?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120403,
					"content": "«Полуночный герой! Странное явление, с которым мы столкнулись много лет назад, повторилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120404
					],
					"speakerTitle": "Исследовать"
				},
				{
					"id": 705120404,
					"content": "Тот раз вы полностью уладили эту проблему, но что-то повлияло на артерии земли, и запечатлённые ими монстры вырываются наружу вновь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120405
					],
					"speakerTitle": "Исследовать"
				},
				{
					"id": 705120405,
					"content": "Не сомневаюсь, что вы разберётесь с опаснейшими из них в кратчайшие сроки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120406
					],
					"speakerTitle": "Исследовать"
				},
				{
					"id": 705120406,
					"content": "В соответствии с регламентом я оповещу ключевых лиц».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120407
					],
					"speakerTitle": "Исследовать"
				},
				{
					"id": 705120407,
					"content": "Хм... Судя по тону записки, писал её кто-то из знакомых Дилюка. Назовём его пока «другом Дилюка».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120408,
					"content": "Он увидел что-то плохое, оставил Дилюку записку и ушёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120409,
					"content": "Как безответственно! А если бы её увидели посторонние? Ещё он оставил тут свои записи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120410,
					"content": "Паймон кое-что пришло в голову... Помнишь тот необычный застой артерий земли на побережье?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120411,
					"content": "Это, наверное, и есть то «странное явление»!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120412
					]
				},
				{
					"id": 705120412,
					"content": "А так всё выглядит нормально, ни одного монстра не видать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120413,
					"content": "#{NICKNAME}, прочтёшь записи друга Дилюка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120414,
					"content": "Если не хочешь, тогда пойдём и посмотрим на застой артерий земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7051205,
			"completionStepIds": [
				7051205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051205",
							"2"
						],
						"stepId": 7051205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120501,
					"content": "Ой! Откуда взялись все эти чудовища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120502,
					"content": "Погоди-ка... это Дилюк?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120503,
					"content": "Как-то он иначе выглядит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120504,
					"content": "Ты только посмотри, какое усердие, какая отвага! Вот он, Капитан Справедливость во всей красе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120505,
						705120506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120505,
					"content": "Должно быть, это Дилюк, который сражался здесь когда-то.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				},
				{
					"id": 705120507,
					"content": "Точно. Если присмотреться, этот Дилюк выглядит моложе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120508,
					"content": "Но что тогда случилось? Почему он здесь сражался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120509,
					"content": "Хм. Пожалуй, лучше спросить у него самого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120510,
					"content": "#{NICKNAME}, что будем делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120511,
						705120512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120511,
					"content": "Не стоит торопиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120513,
					"content": "Хорошо, посмотрим, как Дилюк из прошлого сражается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705120512,
					"content": "Для начала понаблюдаем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120506,
					"content": "Артерии земли показывают образы, которые они запечатлели.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				}
			]
		},
		{
			"id": 7051207,
			"completionStepIds": [
				7051207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051207",
