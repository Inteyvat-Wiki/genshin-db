			"dialogs": [
				{
					"id": 705000501,
					"content": "Что это за мясо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000502
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000502,
					"content": "Цельномороженое мясо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000503
					]
				},
				{
					"id": 705000503,
					"content": "Цельномороженое мясо... Название говорит само за себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000504
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000504,
					"content": "Что ж, качество неплохое. Но судя по виду, его нужно немного подержать на медленном огне, чтобы разморозить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000505
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000505,
					"content": "К счастью, у спроектированного мной «Чуда кулинарной машинерии» как раз есть функция разморозки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000506,
						705000512
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000506,
					"content": "Похоже, у этой машины есть все функции, которые только можно себе представить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000507
					]
				},
				{
					"id": 705000507,
					"content": "Ну что ты! Некоторых функций определённо не хватает. Например, автоматического сбора кухонных ингредиентов, автоматического контроля огня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000508
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000508,
					"content": "В эту машину можно внести еще немало улучшений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000509,
					"content": "Ладно, хватит пустой болтовни. Раз все ингредиенты собраны, я включаю машину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000510
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000510,
					"content": "#Следить за температурой поручаю тебе, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000511
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000511,
					"content": "Скажи мне, как у тебя всё будет готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000512,
					"content": "Ваша сила воистину велика.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000513
					]
				},
				{
					"id": 705000513,
					"content": "Лучше похвали не меня, а «Чудо кулинарной машинерии».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "Хранитель Облаков"
				}
			]
		},
