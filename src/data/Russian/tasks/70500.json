				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хранитель Облаков"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000101,
					"content": "Безлюдное царство стужи, где ветви деревьев похожи на хрусталь... Моё третье блюдо отлично подходит к местной обстановке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000102
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000102,
					"content": "Что вы собираетесь приготовить в этот раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000103
					]
				},
				{
					"id": 705000103,
					"content": "Известно ли тебе о способе готовки под названием «тушение»? Он попался мне на глаза при просмотре рецептов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000104
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000104,
					"content": "Меня так это заинтересовало, что у меня получился новый рецепт, посвящённый этому методу готовки - «Мясной гуляш».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000105
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000105,
					"content": "Рецепт несложный для моего «Чуда кулинарной машинерии», но сырое мясо для него требуется исключительно высшего качества.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000106
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000106,
					"content": "А потому, запустив машину, мне пришлось отправиться на поиски ингредиентов. Запахи привели меня сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000107
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000107,
					"content": "Но с местными снежными бурями шутки плохи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000108
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000108,
					"content": "#Путешественни{F#ца}{M#к}, тебе многое довелось повидать и ты знаешь толк в приключениях. Для тебя поход на Драконий хребет - пара пустяков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000109
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000109,
					"content": "Помоги мне достать ингредиенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000110,
						705000116
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000110,
					"content": "Третий рецепт я тоже хочу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000111
					]
				},
				{
					"id": 705000111,
					"content": "Конечно же, я тебя не забуду. Тогда ты займись поисками, а я подожду здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000112,
					"content": "Ой, а почему машина остановилась? Неужели из-за холода...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000113
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000113,
					"content": "Дай-ка я снова ее включу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000114
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000114,
					"content": "Чудо кулинарной машинерии... включено!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000115
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000115,
					"content": "#Вроде теперь все в порядке. Путешественни{F#ца}{M#к}, скорее отправляйся на поиски нужных ингредиентов, ты отыщешь их по запаху.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000116,
					"content": "Холод не даёт вам взлететь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000117
					]
				},
				{
					"id": 705000117,
					"content": "Что за шутки! Ты настолько меня недооцениваешь? Просто я... пока займусь ремонтом машины, вот и все!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000118
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 705000118,
					"content": "Возвращайся скорее, не заставляй меня ждать слишком долго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "Хранитель Облаков"
				}
			]
		},
