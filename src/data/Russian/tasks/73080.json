			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Альфонсо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730800101,
					"content": "(Пришла пора разоблачить этих негодяев из деревни Вимара.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800102
					]
				},
				{
					"id": 730800102,
					"content": "Привет, Альфонсо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800103,
					"content": "#Вы пришли. {NICKNAME}, что-то случилось? Если вы за Раной, она уже ушла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800104
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800104,
					"content": "Хотели поговорить с тобой...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800105
					]
				},
				{
					"id": 730800105,
					"content": "...о злодеях в деревне Вимара.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800106
					]
				},
				{
					"id": 730800106,
					"content": "#{NICKNAME} пообещал{F#а} Ране разобраться с теми, кто творит здесь зло. Поэтому она со спокойной душой отправилась в путешествие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800107,
					"content": "Ясно. Никаких зацепок у меня нет, но, если я чем-то могу помочь, спрашивайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800108
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800108,
					"content": "Сперва мы введём тебя в курс дела.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800109
					]
				},
				{
					"id": 730800109,
					"content": "Итак... кто из детей пропал первым?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800110,
						730800111,
						730800113,
						730800116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800110,
					"content": "Судабе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800119
					]
				},
				{
					"id": 730800119,
					"content": "Да. Паймон вспомнила, это точно была Судабе! Она услышала, что где-то в лесу есть трава, которая поможет улучшить зрение Амадии. Вот и направилась туда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800120,
					"content": "Это так. Тогда мы очень заволновались и отправили на поиски целый отряд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800121
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800121,
					"content": "Помню! Рана сказала, что ты организовал поисковую группу и принёс с собой карри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800122,
					"content": "Кто рассказал Судабе о траве?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800123
					]
				},
				{
					"id": 730800123,
					"content": "...это был я. Судабе - хорошая девочка. Она так сильно беспокоилась об Амадии. Помню, как однажды обмолвился с ней об этом. Но ещё я сказал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800124
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800124,
					"content": "Да, Паймон знает! Ты сказал ей не бродить по лесу в одиночку. Она и правда очень заботится о дедушке Амадии, это правда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800125,
					"content": "Ещё какие-нибудь вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800126
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800126,
					"content": "Кто пропал следующим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800127,
						730800128,
						730800130,
						730800132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800127,
					"content": "Кавус.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800135
					]
				},
				{
					"id": 730800135,
					"content": "Кавус собирался отыскать в лесу какого-то «друга», чтобы обсудить с ним пропажу сестры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800136
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800136,
					"content": "Точно! Он упоминал об этом. Альфонсо, ты случайно не знаешь, о каком «друге» он говорил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800138
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800138,
					"content": "Откуда мне знать? В лесу я не нашёл ни Кавуса, ни его друга. И, как вы знаете, позже он сам вернулся, ничего не помня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800139
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800139,
					"content": "Ещё вопросы? Больше никто не пропадал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800140
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800140,
					"content": "Паймон, говори.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800141
					]
				},
				{
					"id": 730800141,
					"content": "А? Ладно... Кхе-кхе, Иотам должен был стать следующим. Но на него наткнулись мы с Раной. Так он и спасся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800142
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800142,
					"content": "Как это случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800143
					]
				},
				{
					"id": 730800143,
					"content": "Иотам сказал, что слышал от тебя, Альфонсо, историю об огромном грибе в пещере. Он хотел сорвать его для Раны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800144
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800144,
					"content": "В лесу его начал преследовать злой Фатуи. Иотам испугался, побежал и попал в ловушку зоны Увядания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800145,
					"content": "Что? Он попал в зону Увядания?! Почему же он мне ничего не сказал?! Это же так опасно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800146
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800146,
					"content": "#Но... если он попал в зону Увядания, как ему удалось спастись? Ведь даже {NICKNAME}, что владеет элементами без Глаза Бога...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800147
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800147,
					"content": "(Хм... стоит ли рассказывать ему об Аране?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800148,
						730800149
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800148,
					"content": "(Стоит.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800150,
					"content": "Альфонсо, ты вряд ли нам поверишь, но в лесу есть феи, которых называют аранарами. Иотам и остальные детишки - друзья аранар, а друзья помогают друг другу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800151
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800151,
					"content": "Арана...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800152
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800152,
					"content": "Фатуи пали настолько низко, что стали нападать даже на детей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800153
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800153,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800154
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800154,
					"content": "И всё же... мы так и не узнали, кто же этот негодяй, что прячется в деревне Вимара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800155
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800155,
					"content": "Паймон, за нами кто-то наблюдает.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800156
					]
				},
				{
					"id": 730800156,
					"content": "Что? Где? Неужели это тот самый негодяй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800157
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800157,
					"content": "Сходи и проверь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800158
					]
				},
				{
					"id": 730800158,
					"content": "В одиночку?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800159,
						730800160
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800159,
					"content": "Если что-нибудь случится, кричи. Я сразу приду на помощь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800161,
					"content": "#Хм, ладно уж. Не всё тебе одн{M#ому}{F#ой} работать. Паймон тоже поучаствует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800162
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800162,
					"content": "Воодушевлённая Паймон улетела.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730800163
					]
				},
				{
					"id": 730800163,
					"content": "К чему этот театр?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800164,
						730800165
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800164,
					"content": "Меньше знает, крепче спит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800166,
					"content": "Поговорим в другом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800165,
					"content": "Не стоит ей знать всё.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800160,
					"content": "Ты маленькая и летать умеешь. Идеальный разведчик.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800149,
					"content": "(Он должен знать.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800128,
					"content": "Судабе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800129
					]
				},
				{
					"id": 730800129,
					"content": "Да нет же! Мы ведь только что говорили о Судабе. Паймон помнит... она говорила что-то о своём брате. Кажется, его зовут... Кавус?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800130,
					"content": "Иотам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800131
					]
				},
				{
					"id": 730800131,
					"content": "Разве? Иотама мы вместе с тобой спасали в самом конце. Паймон помнит, что... вторым был брат Судабе, Кавус. Правильно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800132,
					"content": "Чан Чан.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800133
					]
				},
				{
					"id": 730800133,
					"content": "Погоди ты, Чан Чан же из Ли Юэ. Разве это имеет к ней какое-либо отношение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800134,
					"content": "#Может, ты головой ушиб{F#лась}{M#ся}, {NICKNAME}? Осторожнее. Паймон помнит, что... вторым был брат Судабе. Вроде бы Кавус, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800111,
					"content": "Кавус.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800112
					]
				},
				{
					"id": 730800112,
					"content": "Это Судабе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800113,
					"content": "Иотам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800114
					]
				},
				{
					"id": 730800114,
					"content": "Ну нет же! Иотам был последним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800115,
					"content": "Это Судабе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800116,
					"content": "Тимми.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800117
					]
				},
				{
					"id": 730800117,
					"content": "Тимми? Ну нет, он же из Мондштадта и не имеет к этому никакого отношения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730800118,
					"content": "Какой ещё Тимми? Судабе это была.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "Альфонсо"
				}
			]
		},
		{
			"id": 7308002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308002",
							"2"
						],
						"stepId": 7308002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альфонсо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730800201,
					"content": "#И когда же ты начал{F#а} меня подозревать? Это всё из-за слов Судабе и Иотама?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800202
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800202,
					"content": "Тебе известно моё имя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800203
					]
				},
				{
					"id": 730800203,
					"content": "Не помню, чтобы Рана нас представляла друг другу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800204
					]
				},
				{
					"id": 730800204,
					"content": "Может, у меня просто отличный слух. Вот и услышал имя, когда она знакомила тебя с дедом Амадией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800205
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800205,
					"content": "Дедушка Амадия тоже не знает моего имени.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800206
					]
				},
				{
					"id": 730800206,
					"content": "...Да уж, тут я сплоховал. Но помимо Фатуи существует ещё одна большая организация - Гильдия искателей приключений. Я что, совсем не похож на одного из них?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800207,
						730800210
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800207,
					"content": "Ты слишком много всего обо мне знаешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800208
					]
				},
				{
					"id": 730800208,
					"content": "Тебе известно, что я управляю элементами без Глаза Бога.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800209
					]
				},
				{
					"id": 730800209,
					"content": "Конечно. О твоих подвигах знает весь мир, а не только Фатуи. По всей видимости, никаких доказательств моей причастности к ним у тебя нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800212
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800212,
					"content": "А это и не важно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800213
					]
				},
				{
					"id": 730800213,
					"content": "Верно говоришь. Только суду нужны доказательства. Ищейке же достаточно чутья, и она уже у добычи на хвосте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800214
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800214,
					"content": "Умные ищейки не идут на запах, что приведёт их к дракону. Но ты не из тех, кто сдаётся на полпути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800215
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800215,
					"content": "Ты специально сказал Ране не патрулировать лес...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800216
					]
				},
				{
					"id": 730800216,
					"content": "...чтобы она ненароком не влезла в дела Фатуи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800217
					]
				},
				{
					"id": 730800217,
					"content": "В этом есть доля истины. Но важно то, что я не хотел, чтобы Рана пострадала. Другие Фатуи не стали бы так поступать. Ведь ни Рана, ни Вимара ничего для них не значат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800218
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800218,
					"content": "Кто же ты на самом деле, «Альфонсо»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800219
					]
				},
				{
					"id": 730800219,
					"content": "Имя, данное мне при рождении, давно похоронено под толщей снега. А имя, что дал мне Дом очага - Трофим Снежевич.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800220
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800220,
					"content": "Снежевич из Дома очага...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800221
					]
				},
				{
					"id": 730800221,
					"content": "#Судя по твоей реакции, ты уже знаком{F#а} с моими «братьями» и «сёстрами».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800222
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800222,
					"content": "О, только не говори, кому именно посчастливилось увидеться с тобой. И о том, что с ними стало, я тоже знать не желаю. Раз они раскрыли тебе свои личности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800223
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800223,
					"content": "...значит, они предали её величество, а расплата за предательство... смерть. Нет у меня настроения выслушивать неприятные новости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800224
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800224,
					"content": "Дом очага - убежище, что создала Арлекино. Выросшие там дети не имеют меж собой никаких родственных связей... но узы их крепче, чем у кровных родственников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800225
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800225,
					"content": "С наступлением совершеннолетия «достойных» обучают, чтобы впоследствии они стали агентами и рассредоточились по разным уголкам земли в ожидании приказов. К несчастью, я тоже оказался в их рядах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800226
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800226,
					"content": "И что за приказ у тебя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800227
					]
				},
				{
					"id": 730800227,
					"content": "Поймать аранару. Дотторе желает исследовать связь между аранарами, снами и Увяданием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800228
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800228,
					"content": "Один из их проектов - использовать сны и зону Увядания в военных целях. Я же, как и все побеждённые тобою Фатуи, - являюсь частью исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800229
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800229,
					"content": "Мы не можем видеть аранар. А вот у Кавуса, Судабе и Иотама есть все возможности входить с ними в контакт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800230
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800230,
					"content": "Ты приказал Фатуи похитить их, чтобы приманить аранара.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800231
					]
				},
				{
					"id": 730800231,
					"content": "Всё верно. И у меня получилось. Но сила их и правда велика. Этому аранаре удалось улизнуть из хорошо охраняемого лагеря дважды, да ещё и прихватить с собой детей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800232
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800232,
					"content": "В этот раз Дотторе положил глаз на нечто стоящее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800233
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800233,
					"content": "#Могу я задать тебе вопрос, {NICKNAME}? Зачем тот аранара стёр у Кавуса и Судабе память? Боялся, что о нём узнают?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800234
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800234,
					"content": "Арана не хотела, чтобы у детей остались такие скверные воспоминания.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800235
					]
				},
				{
					"id": 730800235,
					"content": "Аранара не хотел, чтобы в будущем те пошли по вашим стопам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800236
					]
				},
				{
					"id": 730800236,
					"content": "Вот как... Значит, того аранара зовут Араной? Похоже на имя Раны, звучит красиво. Как будет шанс, поблагодари её за меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800237
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800237,
					"content": "Зачем тебе её благодарить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800238
					]
				},
				{
					"id": 730800238,
					"content": "Вимара мне будто дом родной. Рана и Иотам - словно кровные родственники, коих у меня никогда не было. А Судабе и Кавус - дорогие сердцу сестра и брат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800239
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800239,
					"content": "Надеюсь, они вырастут здоровыми и станут порядочными, добрыми людьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800240
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800240,
					"content": "Хоть Арана и усложнила мне задачу, я искренне ценю то, что она для них сделала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800241
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800241,
					"content": "#Я понял... Вот почему ты {F#отвлекла}{M#отвлёк} Паймон. Не стоит детям знать о всей той грязи, что присуща нашему взрослому миру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800242
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800242,
					"content": "«Успей же насладиться своим детством. К чему лежит душа - туда и следуй. Но помни, что однажды тьма придёт...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800243
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800243,
					"content": "Это то, чему учили нас в Доме очага. Однажды все мы вырастаем и неизбежно сталкиваемся с тёмным миром взрослых. Только готовясь к нему с раннего детства, ты сможешь защитить себя и тех, кого любишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800244
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800244,
					"content": "Но ваш подход к этому тоже имеет смысл. Быть может, если бы я вырос здесь, в Вимаре, был бы лучшей версией себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800245
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800245,
					"content": "Твоя болтовня бессмысленна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800246
					]
				},
				{
					"id": 730800246,
					"content": "Я понимаю, но мне досадно. Вот бы всю жизнь носить мне имя Альфонсо, а не Снежевич. Как бы хотелось мне взаправду стать Иотаму названым братом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800247
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800247,
					"content": "Хотел бы я быть добропорядочным членом общества, но я увяз в стальной системе. И как хотелось бы мне стать семьёй для Раны и детей, но у меня есть дом, что не могу предать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800248
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800248,
					"content": "Некоторые мои коллеги настолько сильны, что способны противостоять самому Предвестнику. Они не прикрепляются ни к какому городу и ни к какой стране. Даже такой свободный почётный рыцарь, как ты, не сумеет понять этого чувства...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800249,
						730800251
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800249,
					"content": "Я понимаю тебя...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800250
					]
				},
				{
					"id": 730800250,
					"content": "...но это не оправдывает твои поступки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800253
					]
				},
				{
					"id": 730800253,
					"content": "Ну, раз уж мы поговорили начистоту, что планируешь со мной делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800254,
						730800262
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800254,
					"content": "#Не приближайся к деревне Вимара, и чтобы я тебя больше не видел{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800255
					]
				},
				{
					"id": 730800255,
					"content": "...Вот как. Хорошо. Ты меня больше не увидишь. Так же, как и Фатуи. Провал миссии станет позором для моих братьев и сестёр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800256
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800256,
					"content": "Наверное, Иотам будет ждать, когда «Альфонсо» вернётся назад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800257,
						730800259
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800257,
					"content": "Уходи. Паймон вот-вот объявится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800258
					]
				},
				{
					"id": 730800258,
					"content": "До свидания. Нет... прощай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800259,
					"content": "#(Бой) Я передумал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800260
					]
				},
				{
					"id": 730800260,
					"content": "#Я знаю, как заканчивают все злодеи... но всё равно не сдамся. Пусть ты и {NICKNAME}, против котор{F#ой}{M#ого} у меня нет шансов, я буду бороться. Потому что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800261
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800261,
					"content": "Я волк в овечьей шкуре, капля яда в прекрасном вине... И имя мне Снежевич. Ну же, нападай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800262,
					"content": "(Бой) Я сдержу данное Ране обещание.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800263
					]
				},
				{
					"id": 730800263,
					"content": "Злодеи должны быть наказаны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800264
					]
				},
				{
					"id": 730800264,
					"content": "#Я знаю, как заканчивают все злодеи... но всё равно не сдамся. Пусть ты и {NICKNAME}, против котор{F#ой}{M#ого} у меня нет шансов, я буду бороться. Потому что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800265
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800265,
					"content": "Я волк в овечьей шкуре, капля яда в прекрасном вине... И имя мне Снежевич. Ну же, нападай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730800251,
					"content": "Мне тебя не понять.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800252
					]
				},
				{
					"id": 730800252,
					"content": "Даже не буду пытаться понять тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800253
					]
				},
				{
					"id": 730800210,
					"content": "Ты много знаешь о Фатуи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800211
					]
				},
				{
					"id": 730800211,
					"content": "Дурная слава о них ходит по всему миру. По всей видимости, никаких доказательств моей причастности к ним у тебя нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800212
					],
					"speakerTitle": "Альфонсо"
				}
			]
