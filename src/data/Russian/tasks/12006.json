			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Киминами Анна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060301,
					"content": "Ну что, записали рецепт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060601,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060602
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060602,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060603
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060603,
					"content": "Ой, как волнительно... Мне хочется сейчас же её приготовить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060604
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060604,
					"content": "#{NICKNAME}, Паймон, простите, что из-за меня пришлось повременить с едой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060605
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060605,
					"content": "Хе-хе, ничего! Еда всегда вкуснее, когда поработаешь и проголодаешься!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060606,
					"content": "Приступим же, пока не остыло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060607
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060607,
					"content": "Что скажете? Вам нравится инадзумская кухня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060608
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060609,
					"content": "Всё очень вкусно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060611
					]
				},
				{
					"id": 120060610,
					"content": "Было интересно попробовать что-то новое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060611
					]
				},
				{
					"id": 120060608,
					"content": "Она восхитительна! Вот это Паймон понравилось... О! И особенно вон то!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060609,
						120060610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060611,
					"content": "Ха-ха, вот и славно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060612
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060612,
					"content": "Да... Когда я пыталась готовить, вы... с хозяйкой ресторана разговаривали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060613
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060613,
					"content": "Она... ничего обо мне не говорила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060614
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060614,
					"content": "Разве что чуть-чуть. Она просто рада за тебя, и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060615,
					"content": "Рада... за меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060616
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060616,
					"content": "О... Значит, она вам рассказала! А она не...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060617
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060617,
					"content": "Ах, неважно... Я и сама знаю, что у меня нет друзей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060618
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060618,
					"content": "Всё не так плохо. Просто у большинства не было возможности поговорить с тобой наедине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060619
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060619,
					"content": "Благодарю за добрые слова, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060620
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060620,
					"content": "Но всё это правда. У меня... почти нет друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060621
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060622,
					"content": "Что ты такое говоришь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060624
					]
				},
				{
					"id": 120060623,
					"content": "#Я {M#твой друг}{F#твоя подруга}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060624
					]
				},
				{
					"id": 120060621,
					"content": "Обычно со мной только родные да слуги. Поэтому все наверняка удивились, что я пригласила вас в ресторан...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060622,
						120060623
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060624,
					"content": "Точно! Прямо сейчас рядом с тобой как минимум два друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060625
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060625,
					"content": "Ой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060626
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060626,
					"content": "Спасибо, я... я так рада!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060627
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060627,
					"content": "Простите меня... за несдержанность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060628
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060628,
					"content": "Что ты, нет ничего плохого в том, чтобы выражать свои чувства. Не стоит держать всё в себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060629
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060629,
					"content": "Согласна! Так что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060630
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060630,
					"content": "Я лишь хочу сказать... я так рада, что вы считаете меня другом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060631
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060631,
					"content": "Конечно считаем. Мы всегда так - если к нам по-хорошему, то и мы отвечаем взаимностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060632
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060632,
					"content": "Дружба значит так много! Взять, к примеру, твою маму - в своих записях она упоминала Цубаки, и теперь ты тоже хочешь с ней познакомиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060633
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060633,
					"content": "Да! Дружба крайне ценна, и я всегда буду дорожить нашими отношениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060634
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060634,
					"content": "Раз уж речь зашла об этом, кто она такая, эта Цубаки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060635
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060636,
					"content": "Прошу, расскажи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060637
					]
				},
				{
					"id": 120060635,
					"content": "Пока я могу только догадываться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060636
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060638,
					"content": "?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060639
					]
				},
				{
					"id": 120060637,
					"content": "Мне кажется, Цубаки... может оказаться посланницей кицунэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060638
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060639,
					"content": "Посланницей кицунэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060640
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060640,
					"content": "Да. Таково моё предположение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060641
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060641,
					"content": "Даже я никогда не слышала от матери ни слова об этом друге. Это так загадочно... Поэтому я решила, что это некто с выдающимися способностями, кого просто так не встретишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060642
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060642,
					"content": "А историй про посланниц кицунэ в Инадзуме полно ещё с древних времён.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060643
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060643,
					"content": "Доводилось ли вам слышать о Гудзи Яэ? Вот она посланница кицунэ и есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060644
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060644,
					"content": "Поэтому я задумалась, вдруг существуют другие посланницы кицунэ, о которых мы не знаем?.. Цубаки может быть одной из них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060645
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060645,
					"content": "Ух ты, в Инадзуме тоже есть сверхъестественные существа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060646
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060646,
					"content": "Под «тоже» ты подразумеваешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060647
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060647,
					"content": "До Инадзумы некоторое время мы провели в Ли Юэ. Там полно сверхъестественных существ, например, Адептов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060648
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060648,
					"content": "Самых разных. И в небе, и под землёй, и в воде...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060649
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060649,
					"content": "Вот как... Я читала о таком в книгах, но слышать о подобном из личного опыта крайне необычно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060650
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060650,
					"content": "Значит, Ли Юэ оправдывает свою репутацию... Его древняя культура породила прекраснейшие из легенд. Как увлекательно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060651
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060651,
					"content": "Тебе стоит как-нибудь посетить Ли Юэ вместе с нами. А лучше всего то... что там много разных вкусностей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060652
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060652,
					"content": "Правда? Было бы здорово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060653
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060653,
					"content": "#Говоря о вкусностях, {NICKNAME}, Паймон, насытились ли вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060654
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060654,
					"content": "Ещё как!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060655
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060655,
					"content": "Отлично. Зайдём тогда за нарядом, и потом уж навестим загадочную подругу моей матери.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камисато Аяка"
				}
			]
		},
