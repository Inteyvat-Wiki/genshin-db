			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Киминами Анна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060101,
					"content": "Мы уже на месте? О, так это один из тех ресторанов, которые выходят на улицу! Какое славное и душевное место!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060102,
					"content": "Добро пожаловать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060103
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060103,
					"content": "Здравствуйте, госпожа Киминами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060104
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060104,
					"content": "Ох, госпожа Камисато! Вы так пунктуальны. Ваш столик заказан как раз на это время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060105
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060105,
					"content": "Верно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060106
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060106,
					"content": "Мы будем придерживаться составленного ранее заказа. Что же до дела, которое мы с вами обсуждали... Благодарю вас за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060107
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060107,
					"content": "Хорошо, без проблем. Всё, о чём вы просили, готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060108
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060108,
					"content": "#Путешественни{F#ца}{M#к}, маленькая гостья, прошу вас подождать здесь, пока я буду готовить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060109
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060109,
					"content": "Прошу, присаживайтесь. Мне нужно кое-что уладить, но я мигом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060110,
						120060111
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060110,
					"content": "Случилось что-то?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060112
					]
				},
				{
					"id": 120060112,
					"content": "Кхм... ничего подобного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060113
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060113,
					"content": "Просто парочка мелочей. Я вернусь очень скоро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060114
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060114,
					"content": "Ушла... Должно быть, это что-то срочное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060115,
					"content": "Значит, вы друзья госпожи Камисато?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060116
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060116,
					"content": "Ха-ха, в нашем ресторане представлены блюда народной кухни. Элитными их не назовёшь... но вкус у них отменный! Надеюсь, вам понравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060117
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060117,
					"content": "Наш ресторан работает уже давно, и за эти годы мы успели близко познакомиться с кланом Камисато.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060118
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060118,
					"content": "Госпожа Камисато и её брат обожают нашу еду. Они постоянно посылают сюда кого-нибудь сделать заказ и отнести им его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060119
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060119,
					"content": "Я не ожидала её личного визита, тем более с кем-нибудь ещё. Впервые вижу, чтобы она шла в ресторан с друзьями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060120
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060120,
					"content": "Впервые за всё время?! Ого, выходит, мы важные особы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060121,
					"content": "Точно. И я не хочу прозвучать невежливо, но... насколько мне известно, друзей у госпожи Камисато немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060122
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060122,
					"content": "Удивительно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060123
					]
				},
				{
					"id": 120060123,
					"content": "Быть такого не может. Она так добра и вежлива. Паймон думала, её все обожают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060124,
					"content": "Я тоже так думала, но, как оказалось, отношения в обществе устроены несколько сложнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060125
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060125,
					"content": "Никто в округе про неё плохого сказать не может. Все считают её прекрасной, утончённой, великодушной, не говоря уже о высоком происхождении. Словом, в ней видят образцовую девушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060126
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060126,
					"content": "И не более того. Она кажется совершенной, но такой далёкой. Детишки из простых семей даже заговорить с ней не смеют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060127
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060127,
					"content": "Видите? Такая славная девушка, которой так сложно найти друзей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060128
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060128,
					"content": "Паймон бы ни за что не догадалась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060129,
					"content": "Мы с ней не так часто общаемся, но я всегда восхищалась тем, сколько ответственности она взяла на себя в таком юном возрасте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060130
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060130,
					"content": "Я так рада видеть её сегодня с друзьями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060131
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060131,
					"content": "Отдыхайте, приятного вам аппетита, и... побольше говорите с ней. Она будет признательна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060132
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060132,
					"content": "Считайте, что это просьба от всей округи... Позаботьтесь о ней ради нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060133
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060133,
					"content": "Ах!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060134
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060134,
					"content": "Хм? Это голос Аяки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060135,
					"content": "#Мне так жаль, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060136,
						120060137
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060136,
					"content": "Это что, взрыв?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060138
					]
				},
				{
					"id": 120060138,
					"content": "Не могли бы вы пройти со мной вот туда? Мне... нужна ваша помощь в одном деле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060139
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060139,
					"content": "Простите! Я не хотела так внезапно вас выхватывать... Просто... у меня случился кулинарный конфуз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060140
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060140,
					"content": "О, выходит, взорвалась кастрюля...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060141
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060141,
					"content": "Видите ли, этот дом находится рядом с рестораном. В нём живёт его владелец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060142
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060142,
					"content": "Вообще, этой семье принадлежит весь двор. Я попросила госпожу Киминами подготовить кухонные принадлежности и ингредиенты, чтобы приготовить особое блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060143
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060143,
					"content": "А зачем тебе готовить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060144
					]
				},
				{
					"id": 120060144,
					"content": "Ага! Если хочешь поесть, бери меню и заказывай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060145,
					"content": "На деле... я хотела приготовить подарок для Цубаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060146
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060146,
					"content": "Мама в записях упоминала, что Цубаки нравится иноземная кухня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060147
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060147,
					"content": "И я подумала, раз предстоит встреча с Цубаки, иноземное блюдо было бы неплохим подарком...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060148
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060148,
					"content": "Иноземная кухня... Подойдёт всё, что не готовят в Инадзуме, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060149
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060149,
					"content": "Тогда... У нас же преогромнейший выбор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060150,
						120060152
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060150,
					"content": "На самом деле... я великолепный повар.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060151
					]
				},
				{
					"id": 120060151,
					"content": "#Я тоже так подумала! Во время путешествий ты наверняка много {F#узнала}{M#узнал} о разных культурах и их кухнях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060154
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060154,
					"content": "Могу ли я поручить вам завершить это дело? Сделайте одолжение, ладно?.. Я буду вам очень благодарна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060155,
						120060156
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060155,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060157
					]
				},
				{
					"id": 120060157,
					"content": "Отлично! Но... Какое иностранное блюдо станет хорошим подарком?.. А ещё оно должно пережить путь до порога получателя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060158
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060158,
					"content": "Паймон придумала! Есть одно блюдо, которое идеально подходит для этой цели!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060159
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060159,
					"content": "Пицца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060160
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060160,
					"content": "Пицца?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060161
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060161,
					"content": "Это ассорти из ингредиентов и соуса на блине из теста. Запекается в духовке. Очень вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060162
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060162,
					"content": "...Звучит действительно неплохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060163
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060163,
					"content": "Можно ли придать ей инадзумского вкуса?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060164
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060164,
					"content": "Конечно! Пицца универсальна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060156,
					"content": "Настал мой звёздный час.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060157
					]
				},
				{
					"id": 120060152,
					"content": "Можно сказать, мои блюда не от мира сего.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060153
					]
				},
				{
					"id": 120060153,
					"content": "Эй! Обойдёмся без странностей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060154
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060137,
					"content": "Что происходит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060138
					]
				},
				{
					"id": 120060111,
					"content": "Будет драка? Помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060112
					]
				}
			]
		},
		{
			"id": 1200602,
			"completionStepIds": [
				1200603,
				1200608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200603",
							"2"
						],
						"stepId": 1200603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Камисато Аяка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060201,
					"content": "Испеклась, испеклась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060202,
					"content": "Вот и она.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060203
					]
				},
				{
					"id": 120060203,
					"content": "#Какой аромат... Ты прекрасно готовишь, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060204
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060204,
					"content": "Было бы здорово уметь хорошо готовить блюда со всего мира...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060205
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060205,
					"content": "Для этого достаточно выучить рецепт. Если хочешь, мы принесём тебе ещё больше рецептов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060206,
					"content": "Хорошо! Я с нетерпением жду возможности перенять твой кулинарный опыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060207
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060207,
					"content": "Как у вас дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060208
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060208,
					"content": "Ох, это... Госпожа Камисато, это блюдо о котором вы говорили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060209
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060209,
					"content": "#Да. Иноземное блюдо, которое {F#приготовила}{M#приготовил} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060210
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060210,
					"content": "Не могли бы вы его завернуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060211
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060211,
					"content": "Разумеется!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060212
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060212,
					"content": "Ой, а пахнет как! Вкус, должно быть, восхитителен. Очень хотелось бы иметь нечто подобное и в нашем меню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060213
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060213,
					"content": "Хе-хе, показать, как готовить его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060214,
					"content": "А что, так можно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060215
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060215,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060216
					]
				},
				{
					"id": 120060216,
					"content": "Самая вкусная еда - это та, которую разделяешь с другими. Паймон думает, в Мондштадте никто не возразит, если мы поделимся этим блюдом с Инадзумой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060217,
					"content": "Правда?! Ах, как хорошо! Мне всегда хотелось научиться готовить что-нибудь иностранное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060218
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060218,
					"content": "Если вы перепишете для меня рецепт, я бы внесла его в меню, а ещё поместила бы на доске объявлений на самом видном месте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060219
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060219,
					"content": "#Мы не пробовали ничего нового с тех самых пор, как наша страна стала закрытой. {NICKNAME}, ты {F#лучшая}{M#лучший}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060220
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060220,
					"content": "Я пока заверну пиццу для госпожи Камисато. Когда будете готовы, возвращайтесь в ресторан. Вас будет ждать еда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060221
					],
					"speakerTitle": "Киминами Анна"
				},
				{
					"id": 120060221,
					"content": "#Вместо того, чтобы дорого продать рецепт, ты {F#отдала}{M#отдал} его безвозмездно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060222
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060222,
					"content": "...Как великодушно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060223
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060223,
					"content": "Ладно тебе, Аяка...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060224
					]
				},
				{
					"id": 120060224,
					"content": "Я серьёзно... Я восхищаюсь тобой, а ещё горжусь, что мой друг - человек столь благородный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060225
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060225,
					"content": "Ах да, тебе ведь нужно записать рецепт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060226
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060226,
					"content": "#Да, {NICKNAME}, давай напишем всё поподробнее и отдадим его Киминами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060227
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060227,
					"content": "Итак, пицца! Начнём с основных ингредиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060228,
						120060230
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060228,
					"content": "Грибы и мука.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060229
					]
				},
				{
					"id": 120060229,
					"content": "Всё правильно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060232,
					"content": "Итак, следующая пара ингредиентов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060233,
						120060235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060233,
					"content": "Капуста и сыр.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060234
					]
				},
				{
					"id": 120060234,
					"content": "Да, именно так!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060239
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060239,
					"content": "Теперь запишем способ приготовления... «Поместить в духовку и запекать при высокой температуре до появления золотистой корочки».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060240
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060240,
					"content": "Готово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060241,
					"content": "Пусть наша репутация и рецепты опережают нас, куда бы мы ни отправились в Инадзуме!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060242
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060242,
					"content": "Не сомневаюсь, что так и будет. Это блюдо великолепно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060243
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060243,
					"content": "Круто. Поскорее передадим рецепт Киминами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060235,
					"content": "Трава наку и светящийся гриб.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060236
					]
				},
				{
					"id": 120060236,
					"content": "Ох... всё это влияние Сян Лин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060237
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060237,
					"content": "О? А кто такая Сян Лин?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060238
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060238,
					"content": "Это талантливый повар со странными предпочтениями... Тем не менее Паймон обожает её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060239
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060230,
					"content": "Морской гриб и фиалковая дыня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060231
					]
				},
				{
					"id": 120060231,
					"content": "Ты это серьёзно? Ладно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060232
					],
					"speakerTitle": "Паймон"
				}
			]
		},
