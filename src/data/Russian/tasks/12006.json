			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Огура Мио"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060401,
					"content": "Госпожа Камисато, ваш наряд готов. Он сложен и упакован.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060402
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 120060402,
					"content": "Да, другая вещь, о которой мы говорили, тоже готова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060403
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 120060403,
					"content": "Большое вам спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060404
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060404,
					"content": "Что вы, спасибо вам! Мне было очень приятно поработать над столь прекрасным одеянием. Увидимся в следующий раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060405
					],
					"speakerTitle": "Огура Мио"
				},
				{
					"id": 120060405,
					"content": "#{NICKNAME}, у меня есть для тебя подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060406
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060406,
					"content": "Хм? Правда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060407
					]
				},
				{
					"id": 120060407,
					"content": "Ох... какая шикарная вещица! Это украшение для волос?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060408,
					"content": "Это заколка в виде белой цапли. Её можно носить в волосах, или просто как украшение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060409
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060409,
					"content": "Я не могла обратиться к тебе за помощью и оставить с пустыми руками, и... это тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060410,
						120060411
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060410,
					"content": "Это прекрасный подарок. Спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060412
					]
				},
				{
					"id": 120060412,
					"content": "Я рада, что он тебе нравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060413
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060413,
					"content": "Раз уж речь о белых цаплях... это твой титул и означает, верно? Сирасаги Химэгими. Этот подарок словно частичка тебя. Он, как и ты, изящен и прекрасен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060414,
					"content": "Ты мне льстишь, Паймон. Если этот подарок будет напоминать обо мне, я не могу и мечтать о большем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060415
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120060415,
					"content": "Хе-хе, ну конечно же будет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060416,
					"content": "Теперь, когда мы получили то, за чем пришли, можем выдвигаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060417,
					"content": "Пора встретиться с Цубаки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120060411,
					"content": "Я буду им дорожить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060412
					]
				}
			]
		},
		{
			"id": 1200605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
