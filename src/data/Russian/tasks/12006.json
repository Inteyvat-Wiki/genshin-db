		},
		{
			"id": 1200606,
			"completionStepIds": [
				1200606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200606",
							"2"
						],
						"stepId": 1200606,
						"stateName": "QUEST_STATE_UNFINISHED"
