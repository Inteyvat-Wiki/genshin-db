			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Басима"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735280101,
					"content": "Прохожие, к вам обращается Басима, учёная из Амурты, с просьбой о помощи. Пожалуйста, не проходите мимо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280102
					],
					"speakerTitle": "Басима"
				},
				{
					"id": 735280102,
					"content": "Расслабьте тело, освободите разум и послушайте, что я вам скажу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280103
					],
					"speakerTitle": "Басима"
				},
				{
					"id": 735280103,
					"content": "Зяблики самые милые!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280104
					],
					"speakerTitle": "Басима"
				},
				{
					"id": 735280104,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735280105,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280106
					]
				},
				{
					"id": 735280106,
					"content": "Зяблики и правда очень милые, но ведь госпожа Басима - учёная? Не приведёт ли такая ничем не обоснованная фраза к яростным спорам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735280107,
					"content": "У Паймон сложилось впечатление, что учёные очень осторожны в своих высказываниях. Если бы Паймон была учёной, она бы даже не осмелилась сказать... эм... «Шарики с креветкой самые вкусные!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735280108,
					"content": "Нужно обязательно добавить уточнение, например: «Из всего разнообразия блюд кухни Ли Юэ, которые Паймон перепробовала за последнее время, больше всего понравилось это блюдо».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280109,
						735280110,
						735280111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735280109,
					"content": "Тогда я осмелюсь вот что сказать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280112,
					"content": "#Эй! {NICKNAME}, зачем же так неожиданно?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735280113,
					"content": "Даже если это не шутка, всё равно не надо так громко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735280114,
					"content": "Ха-ха-ха! Вот это правильный настрой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280115
					],
					"speakerTitle": "Басима"
				},
				{
					"id": 735280115,
					"content": "Именно потому, что я учёная, я и не хочу превращать каждое мгновение своей жизни в площадку для дебатов, боясь оговориться в каждом предложении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280116
					],
					"speakerTitle": "Басима"
				},
				{
					"id": 735280116,
					"content": "За мной ведь никто постоянно не следит, и ничего страшного не случится, если даже скажу немного не так. Незачем всё время дрожать от страха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280117
					],
					"speakerTitle": "Басима"
				},
				{
					"id": 735280117,
					"content": "Самые важные идеи нужно озвучивать с чувством, громко и смело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280118
					],
					"speakerTitle": "Басима"
				},
				{
					"id": 735280118,
					"content": "Если вы сыграете в мою настольную игру «Щебечущие шары», вы тоже, как и я, будете всем громко заявлять, что зяблики самые милые!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280119
					],
					"speakerTitle": "Басима"
				},
				{
					"id": 735280119,
					"content": "Щебечущие... шары? Это они лежит на столе позади тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735280120,
					"content": "Ага! Поиграв в эту игру, вы сами поймёте всю прелесть зябликов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280121
					],
					"speakerTitle": "Басима"
				},
				{
					"id": 735280121,
					"content": "К тому же эта игра - часть официальной развлекательной программы Миража Велуриям. Набрав много очков, вы получите награду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280122
					],
					"speakerTitle": "Басима"
				},
				{
					"id": 735280122,
					"content": "После таких расхваливаний Паймон стало любопытно. Да ещё и награды можно получить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735280123,
					"content": "#Что думаешь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280124,
						735280125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735280124,
					"content": "Давай попробуем!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280126,
					"content": "Ха-ха-ха, отлично! Надеюсь, вам понравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Басима"
				},
				{
					"id": 735280125,
					"content": "Посмотрим, насколько зяблики милые!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280110,
					"content": "Паймон самая милая!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280111,
					"content": "И мне всё нипочём!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				}
			]
		}
	]
}