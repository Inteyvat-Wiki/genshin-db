			"dialogs": [
				{
					"id": 201020701,
					"content": "Привет! Письмо отправлено?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020702
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020702,
					"content": "Тимми хочет отправить это письмо отцу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020703
					]
				},
				{
					"id": 201020703,
					"content": "Тимми всё ещё пишет письма отцу... Я полагаю, что Грейс тебе всё рассказала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020704
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020704,
					"content": "Я... Я не могу его отправить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020705,
						201020708,
						201020712
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020705,
					"content": "Просто не будем его отправлять?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020706
					]
				},
				{
					"id": 201020706,
					"content": "Я бы хотел... Но не могу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020707
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020707,
					"content": "Просто не могу. Я оставлю письмо себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020717,
					"content": "Довольно об этом. Я оставлю письмо себе. Считай, что оно отправлено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020718
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020718,
					"content": "Он понял бы, почему я так поступаю... Старый добрый друг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020719
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020719,
					"content": "Спасибо и тебе. Прошу, не рассказывай ничего Тимми? Я ведь могу тебе доверять? Вот твоя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020708,
					"content": "Сожги его.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020709
					]
				},
				{
					"id": 201020709,
					"content": "Ты говоришь, как настоящий искатель приключений! Всегда выбираешь самые решительные меры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020710
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020710,
					"content": "Но я не искатель приключений. Я просто старый охотник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020711
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020711,
					"content": "Я не собираюсь сжигать это письмо. Я даже не собираюсь его читать. Пускай оно просто пока полежит у меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020712,
					"content": "Отдай его мне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020713
					]
				},
				{
					"id": 201020713,
					"content": "А тебе оно зачем? Ты же не думаешь, что его адресат ещё жив?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020714
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020714,
					"content": "Туда, где он сейчас находится, не доходят письма...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020715
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020715,
					"content": "Раньше я тоже надеялся, что ещё увижусь с ним, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020716
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020716,
					"content": "Настало время примириться с суровой действительностью. Моего друга больше нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Драфф"
				}
			]
		},
