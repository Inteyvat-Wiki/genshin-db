	"talks": [
		{
			"id": 2010201,
			"completionStepIds": [
				2010201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010201",
							"2"
						],
						"stepId": 2010201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Драфф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020101,
					"content": "Эх... Интересно, как поживает мальчишка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020102
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020103
					]
				},
				{
					"id": 201020103,
					"content": "Гм? О, привет! Ты как раз вовремя. Помнишь, мы обсуждали письмо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020104
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020104,
					"content": "Если у тебя найдётся свободная минутка, отнеси это письмо Грейс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020105,
						201020107
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020105,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020106
					]
				},
				{
					"id": 201020106,
					"content": "Благодарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020107,
					"content": "#Почему я долж{F#на}{M#ен} этим заниматься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020108
					]
				},
				{
					"id": 201020108,
					"content": "После прошлого раза голубям я не доверяю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020109
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020109,
					"content": "А если я сам отправлюсь в Мондштадт, то обязательно столкнусь с тем мальчишкой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020110
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020110,
					"content": "Пожалуйста... Просто отнеси ей это письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Драфф"
				}
			]
		},
		{
			"id": 2010202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Драфф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020201,
					"content": "Ты всё ещё здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020202,
						201020205
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020202,
					"content": "Насчёт письма...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020203
					]
				},
				{
					"id": 201020203,
					"content": "#...Это случилось очень давно. Ты же не прочитал{F#а} письмо в прошлый раз, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020204
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020204,
					"content": "И не надо его читать... Оно длинное и скучное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020205,
					"content": "Кто тот мальчик?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020206
					]
				},
				{
					"id": 201020206,
					"content": "Если тебе так нужно об этом знать, то это парнишка, который кормит голубей на мосту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020207
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020207,
					"content": "Я говорил о нём. По... по ряду причин, я не хочу его видеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020208
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 201020208,
					"content": "#Довол{F#ьна}{M#ен}? А теперь за дело! Доставь письмо, пока Грейс не начала беспокоиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Драфф"
				}
			]
		},
		{
			"id": 2010203,
			"completionStepIds": [
				2010202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Грейс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020301,
					"content": "Странно... Почему его до сих пор нет? Может быть, что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020302
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020302,
					"content": "Тебе письмо от Драффа.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020303
					]
				},
				{
					"id": 201020303,
					"content": "А? А почему ты доставляешь? Ты же не голубь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020304
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020304,
					"content": "Что-то стряслось с голубями? В Спрингвейле каждый день происходит что-то странное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020305
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020305,
					"content": "Спасибо за письмо. Постой, у меня есть для тебя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020306
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020306,
					"content": "Насчёт письма...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020307
					]
				},
				{
					"id": 201020307,
					"content": "#Ох, ты его прочитал{F#а}? Ну ладно, там ничего секретного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020308
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020308,
					"content": "Как говорит об этом Драфф, это случилось давным-давно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020309
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020309,
					"content": "И пусть это было очень давно, мы никогда об этом не забудем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020310
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020310,
					"content": "Что же именно случилось очень давно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020311
					]
				},
				{
					"id": 201020311,
					"content": "Ты правда хочешь узнать? Похоже, тебе можно доверять... Обещай, что никому не расскажешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020312,
						201020313
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020312,
					"content": "Обещаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020316
					]
				},
				{
					"id": 201020316,
					"content": "Отец Тимми - хороший друг Драффа. Они вместе охотятся, пьянствуют и балагурят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020317
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020317,
					"content": "Рыцари много раз выносили им предупреждение. А сестра Виктория много раз с ними серьёзно беседовала. Однако эти меры ни на что не повлияли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020318
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020318,
					"content": "Но когда родился Тимми, его отец решил остепениться. Бросил пить и начал много работать, чтобы обеспечить ребёнка всем необходимым. Он хотел быть примером своему сыну во всём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020319
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020319,
					"content": "Он настолько серьёзно к этому подошёл, что даже Драффа заставил бросить пить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020320
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020320,
					"content": "Порой они не выдерживали трезвой жизни и пропускали по стаканчику яблочного сидра... или по бочке. Несколько раз и я к ним присоединилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020321
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020321,
					"content": "К сожалению, однажды во время охоты отец Тимми был серьёзно ранен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020322
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020322,
					"content": "Драфф сделал всё, что мог... Но, к сожалению, нам не удалось спасти его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020323
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020323,
					"content": "После этого Драфф попросил меня присматривать за Тимми, а сам вернулся в Спрингвейл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020324
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020324,
					"content": "Каждый месяц он присылает письмо и немного денег. Но он не может посмотреть Тимми в глаза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020325
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020325,
					"content": "Недавно он сказал, что хочет рассказать Тимми всю правду о том злополучном дне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020326,
						201020332,
						201020336
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020326,
					"content": "Ты не хочешь, чтобы Тимми узнал правду?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020327
					]
				},
				{
					"id": 201020327,
					"content": "Не хочу. Он всего лишь ребёнок... Не думаю, что стоит ему рассказывать сейчас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020328
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020328,
					"content": "Хоть он и говорит, что уже большой мальчик. Он так хорошо помогает мне с Норой и Глорией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020329
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020329,
					"content": "Но... разве сможет он вынести столь жестокую правду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020330
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020330,
					"content": "Может быть, когда он немного подрастёт... Но не сейчас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020331
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020331,
					"content": "Пусть лучше у него будет счастливое детство. Даже если он не будет знать всю правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020341,
					"content": "Не буду спорить, что Тимми растёт очень быстро. Он задаёт всё больше вопросов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020342
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020342,
					"content": "С ним становится тяжело общаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020343
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020343,
					"content": "Нора рассказывает, что Тимми хочет отправить отцу письмо и готовит для него разные подарки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020344
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020344,
					"content": "Но в последнее время он стал замкнутым и молчаливым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020345
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020345,
					"content": "Если у тебя найдётся минутка, можешь поговорить с Тимми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020346,
						201020348
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020346,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020347
					]
				},
				{
					"id": 201020347,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020348,
					"content": "Почему ты сама с ним не поговоришь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020349
					]
				},
				{
					"id": 201020349,
					"content": "Мне неловко, но... Хотя я и не хочу его травмировать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020350
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020350,
					"content": "Но каждый раз, когда он говорит, что хочет написать письмо отцу, у меня сердце кровью обливается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020351
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020351,
					"content": "Боюсь, что однажды я не выдержу и расскажу ему всё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020352
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020352,
					"content": "Но я не могу этого допустить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020353
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020353,
					"content": "Проверь, как идут дела у Тимми, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020332,
					"content": "Нельзя вечно скрывать от него правду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020333
					]
				},
				{
					"id": 201020333,
					"content": "Я понимаю. Но он такой славный мальчишка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020334
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020334,
					"content": "Я просто хочу, чтобы... Нет! Я настаиваю, чтобы у ребёнка было счастливое детство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020335
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020335,
					"content": "Какая бы тяжёлая жизнь не ждала его впереди, пусть у него будут хотя бы тёплые воспоминания о детстве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020336,
					"content": "Что плохого в том, чтобы знать правду?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020337
					]
				},
				{
					"id": 201020337,
					"content": "#Хм... Тебе легко так говорить. Тебе само{F#й}{M#му} через многое пришлось пройти... И это сделало тебя сильнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020338
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020338,
					"content": "Я уверена, что твои тяжёлые переживания помогли тебе стать успешным искателем приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020339
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020339,
					"content": "Но Тимми ещё слишком молод. Я не хочу, чтобы он страдал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020340
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020340,
					"content": "Пусть у мальчика будет счастливое детство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020313,
					"content": "Я не могу этого обещать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020314
					]
				},
				{
					"id": 201020314,
					"content": "Да что ты за человек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020315
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 201020315,
					"content": "Но почему-то я хочу тебе довериться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020316
					],
					"speakerTitle": "Грейс"
				}
			]
		},
		{
			"id": 2010204,
			"completionStepIds": [
				2010203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
