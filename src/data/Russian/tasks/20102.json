			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тимми"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020401,
					"content": "По-прежнему ни словечка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020402,
						201020405
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020402,
					"content": "Ты кормишь голубей?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020403
					]
				},
				{
					"id": 201020403,
					"content": "Я их уже покормил сегодня. Сейчас они в безопасном месте, где ты их не достанешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020404
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020404,
					"content": "А теперь я пишу письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020407,
					"content": "Мама Грейс говорит, что папа отправит мне письмо голубиной почтой, когда у него будет свободное время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020408
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020408,
					"content": "Но пока я не получил ни одного письма... Наверное, папа очень занят...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020409
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020409,
					"content": "Я решил, что если у папы совсем нет свободного времени, то я сам первый ему напишу. А внутрь конверта я положу какой-нибудь подарок. Но я ещё не придумал, какой именно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020410
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020410,
					"content": "Придумал! <color=#00E1FFFF>Одуванчики!</color> Мама говорит, что в Мондштадте все любят одуванчики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020411
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020411,
					"content": "Ты можешь принести мне несколько <color=#00E1FFFF>одуванчиков</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020412,
						201020414
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020412,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020413
					]
				},
				{
					"id": 201020413,
					"content": "#Ура! Спасибо тебе! Иногда ты бываешь ХОРОШ{F#ЕЙ}{M#ИМ}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020414,
					"content": "Может придумаешь другой подарок?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020415
					]
				},
				{
					"id": 201020415,
					"content": "Я хотел бы отправить что-то более серьёзное, но голубь не сможет доставить тяжёлый подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020416
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020416,
					"content": "Потому что папа работает ооооочень далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020405,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020406
					]
				},
				{
					"id": 201020406,
					"content": "Я пишу письмо отцу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "Тимми"
				}
			]
		},
