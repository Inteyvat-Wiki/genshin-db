				"points": []
			},
			"dialogs": [
				{
					"id": 201020601,
					"content": "#Ты прин{F#есла}{M#ёc} одуванчики?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020602
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020602,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020603
					]
				},
				{
					"id": 201020603,
					"content": "Отлично. Этого будет достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020604
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020604,
					"content": "Кладём семена одуванчиков... Запечатываем конверт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020605
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020605,
					"content": "Готово! Ура! Папа так обрадуется, когда получит от меня письмо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020606
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020606,
					"content": "Но... Я слышал, что для этого нужен специальный голубь... И я не знаю адрес...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020607
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020607,
					"content": "Точно! Я вспомнил, как мама Грейс говорила, про дядю Драффа из Спрингвейла и его почтовых голубей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020608
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020608,
					"content": "А ещё она рассказывала, что дядя Драфф знает папу. Наверное, у него получится отправить письмо по адресу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020609
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020609,
					"content": "Поможешь мне ещё разок? Отнеси письмо дяде Драффу и попроси его отправить голубя папе, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020610
					],
					"speakerTitle": "Тимми"
				},
				{
					"id": 201020610,
					"content": "И ещё! Не читай это письмо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимми"
				}
			]
		},
