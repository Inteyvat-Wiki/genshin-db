			"dialogs": [
				{
					"id": 201040301,
					"content": "#Ты!.. Как?! Зачем ты {M#сжёг}{F#сожгла} все стога?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040302
					],
					"speakerTitle": "Моко"
				},
				{
					"id": 201040302,
					"content": "Теперь простым наказанием мы не отделаемся, нас точно уволят...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040303
					],
					"speakerTitle": "Хилли"
				},
				{
					"id": 201040303,
					"content": "Это вышло случайно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040304
					]
				},
				{
					"id": 201040304,
					"content": "Лучше бы мы медленно убирали их один за другим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040305
					],
					"speakerTitle": "Моко"
				},
				{
					"id": 201040305,
					"content": "Всё... Всё пропало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040306
					],
					"speakerTitle": "Хилли"
				},
				{
					"id": 201040306,
					"content": "Что...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040307
					]
				},
				{
					"id": 201040307,
					"content": "#Путешественн{F#ица}{M#ик}, пожалуйста, уходи. Это наши обязанности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040308
					],
					"speakerTitle": "Моко"
				},
				{
					"id": 201040308,
					"content": "Мы не должны были прибегать к помощи человека, который ничего не знает об уборке. Это наша оплошность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040309
					],
					"speakerTitle": "Хилли"
				},
				{
					"id": 201040309,
					"content": "Что с нами сделает главная горничная, когда узнает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040310
					],
					"speakerTitle": "Моко"
				},
				{
					"id": 201040310,
					"content": "Нам конец...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хилли"
				}
			]
		},
