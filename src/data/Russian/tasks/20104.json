			"dialogs": [
				{
					"id": 201040201,
					"content": "Ну, как всё прошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040202
					],
					"speakerTitle": "Моко"
				},
				{
					"id": 201040202,
					"content": "Уборка закончена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040203
					],
					"speakerTitle": "Хилли"
				},
				{
					"id": 201040203,
					"content": "Всё чисто.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040204
					]
				},
				{
					"id": 201040204,
					"content": "О, замечательно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040205
					],
					"speakerTitle": "Моко"
				},
				{
					"id": 201040205,
					"content": "#Путешественн{F#ица}{M#ик}, ты лучш{F#ая}{M#ий}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040206
					],
					"speakerTitle": "Хилли"
				},
				{
					"id": 201040206,
					"content": "Теперь главная горничная не будет нас ругать! Спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040207
					],
					"speakerTitle": "Моко"
				},
				{
					"id": 201040207,
					"content": "Пожалуйста, возьми это в знак благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040208
					],
					"speakerTitle": "Хилли"
				},
				{
					"id": 201040208,
					"content": "Что ж, нам нужно ещё кое-где подмести. До встречи, и спасибо за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Моко"
				}
			]
		},
