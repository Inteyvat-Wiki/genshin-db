				"objectNames": [
					"Моко"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201040101,
					"content": "Что же делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040102
					],
					"speakerTitle": "Моко"
				},
				{
					"id": 201040102,
					"content": "Опять главная горничная отругает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040103
					],
					"speakerTitle": "Хилли"
				},
				{
					"id": 201040103,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040104
					]
				},
				{
					"id": 201040104,
					"content": "Госпожа Аделинда поручила нам подмести территорию вокруг винокурни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040105
					],
					"speakerTitle": "Моко"
				},
				{
					"id": 201040105,
					"content": "В других местах всё чисто, но на территории лежит множество стогов сена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040106
					],
					"speakerTitle": "Хилли"
				},
				{
					"id": 201040106,
					"content": "Господин Коннор сказал, что специально разложил их там для какого-то своего дела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040107
					],
					"speakerTitle": "Моко"
				},
				{
					"id": 201040107,
					"content": "Они были хорошо связаны, и ветер не раздул их, но нанёс много листьев, которые застряли в стогах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040108
					],
					"speakerTitle": "Хилли"
				},
				{
					"id": 201040108,
					"content": "Мы очень старались, но так и не смогли полностью очистить стога от листьев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040109
					],
					"speakerTitle": "Моко"
				},
				{
					"id": 201040109,
					"content": "Главная горничная обязательно отругает нас, если мы не справимся. Что же делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040110,
						201040112
					],
					"speakerTitle": "Хилли"
				},
				{
					"id": 201040110,
					"content": "Я сделаю это!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040111
					]
				},
				{
					"id": 201040111,
					"content": "Да? Ты поможешь нам? Огромное тебе спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Моко"
				},
				{
					"id": 201040112,
					"content": "Сложная уборка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040113
					]
				},
				{
					"id": 201040113,
					"content": "Листья запутались в стогах сена. Нам нужно извлечь их один за другим... Это будет очень медленно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040114
					],
					"speakerTitle": "Хилли"
				},
				{
					"id": 201040114,
					"content": "Если у тебя есть способ получше, мы будем благодарны за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хилли"
				}
			]
		},
