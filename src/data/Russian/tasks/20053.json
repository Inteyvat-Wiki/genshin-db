				"points": []
			},
			"dialogs": [
				{
					"id": 200530101,
					"content": "Ох, какая головная боль! Что же мне с этим делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530102
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200530102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530103
					]
				},
				{
					"id": 200530103,
					"content": "Готовлюсь к отборочным соревнованиям в Ордо Фавониус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530104
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200530104,
					"content": "Ох... Мне никогда не стать такой же сильной, как Джинн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530105
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200530105,
					"content": "Нужно больше уделять внимание технике, а не силе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530106
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200530106,
					"content": "Например, я хочу срубить все эти деревянные чучела одним ударом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530107
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200530107,
					"content": "Если у тебя найдётся минутка, подскажи, как это сделать, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530108,
						200530109
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200530108,
					"content": "Надо подумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530110
					]
				},
				{
					"id": 200530110,
					"content": "Конечно, не спеши. Эти чучела никуда не денутся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530111
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200530111,
					"content": "Да и я тоже никуда не денусь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200530114,
					"content": "Хм... Может начать с этой стороны, а потом в ту сторону кинуть бомбу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530115
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200530115,
					"content": "Ха-ха! Шучу. Даже не знаю, где мы возьмём бомбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200530109,
					"content": "Давай попробуем вместе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530112
					]
				},
				{
					"id": 200530112,
					"content": "Тебе нравится командный бой? Всегда приятно знать, что ты не один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530113
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200530113,
					"content": "Но я училась сражаться только в одиночку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Айлин"
				}
			]
		},
