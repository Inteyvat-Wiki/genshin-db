			"dialogs": [
				{
					"id": 740350301,
					"content": "Клавиша для машинки... Семан, можно ли по ней получить возмещение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350302
					],
					"speakerTitle": "Роялт"
				},
				{
					"id": 740350302,
					"content": "Не уверен. Но если можно получить возмещение за всю печатную машинку... то, наверное, можно и за клавишу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Семан"
				}
			]
