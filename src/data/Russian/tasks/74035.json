					"nextDialogs": [
						740350605
					]
				},
				{
					"id": 740350605,
					"content": "Вот эта пойдёт. Вот мора. Спасибо тебе, Эстель!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350606
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350606,
					"content": "В прошлый раз ты сказал, что мы с тобой пойдём кататься на лодке, Айюн! Эй! Айюн!",
					"roleType": "TALK_ROLE_NPC",
