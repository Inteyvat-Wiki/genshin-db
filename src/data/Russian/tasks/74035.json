			},
			"dialogs": [
				{
					"id": 740350401,
					"content": "Здравствуйте, господин Айюн! Чем могу вам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350402
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350402,
					"content": "Здравствуйте, госпожа Корнелия. Скажите, у нас есть запасные клавиши для печатных машинок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350403
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350403,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350404
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350404,
					"content": "На моей машинке не хватает одной клавиши, прошу выдать мне замену. Если же это невозможно... Помогите мне получить средства на покупку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350405
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350405,
					"content": "Получить средства на покупку на клавишу... в принципе, без проблем можно это сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350406
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350406,
					"content": "Распишитесь вот здесь. Пишите: «Из-за поломки печатной машинки прошу выделить средства на покупку одной клавиши». Далее напишите своё имя и название вашего отдела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350407
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350407,
					"content": "Хорошо! Эта клавиша нужна мне сегодня, у меня есть срочная работа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350408
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350408,
					"content": "Господин Айюн, вам ещё не доводилось обращаться за средствами на покупку общественной собственности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350409
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350409,
					"content": "Это совсем не так просто, как вы себе представляете... Расчёт средств производится за каждый предмет по отдельности, сначала мы в течение месяца собираем квитанции, а затем в конце месяца передаём их на проверку Палате Кардиналис.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350410
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350410,
					"content": "Процесс их утверждения связан с одобрением и выплатой заработной платы всем служащим Палаты Жестьон. Если же сумма расходов будет слишком большой, Палате Кардиналис нужно будет обратиться к самому месье Нёвиллету.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350427
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350427,
					"content": "Средства будут выделены только после того, как он произведёт полную проверку и поставит свою подпись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350411
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350411,
					"content": "Если у месье Нёвиллета появятся вопросы к какому-нибудь пункту расходов, соответствующий сотрудник также должен будет написать пояснение... Подавать документы мы как раз собираемся на днях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350412
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350412,
					"content": "Хотите сказать, если не повезёт, то мне ещё придётся получать согласие от месье Нёвиллета на возмещение стоимости этой клавиши?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350413
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350413,
					"content": "Таковы правила, господин Айюн. И в этом месяце сумма к возмещению будет немаленькая, скорее всего, потребуется утверждение месье Нёвиллета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350414
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350414,
					"content": "Этот месье Нёвиллет... Он же верховный судья?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740350415,
					"content": "Беспокоить его из-за какой-то клавиши... Паймон кажется, что это неправильно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350416,
						740350417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740350416,
					"content": "Есть ли какой-то другой способ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350418
					]
				},
				{
					"id": 740350418,
					"content": "Я тоже так думаю. Не нужно беспокоить месье Нёвиллета ради какой-то клавиши, правда не нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350419
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350419,
					"content": "Да, есть другой способ. Вы можете пойти и купить клавишу сами, а я напишу вам расписку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350420
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350420,
					"content": "Когда процедура возмещения расходов завершится и будут выделены средства, ваши издержки будут покрыты со счёта организации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350421
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350421,
					"content": "Отлично! Тогда так и сделаем! Одна клавиша не будет стоить дорого, я смогу купить её сам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350422
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350422,
					"content": "Тогда подпишитесь здесь и напишите: «Из-за поломки печатной машинки прошу возместить стоимость одной клавиши»... Вы пойдёте за клавишей к госпоже Эстель?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350423
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350423,
					"content": "Да, а что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350424
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350424,
					"content": "Чуть позже я отнесу этот документ на подпись господину Роялту, а затем схожу на сверку к госпоже Эстель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350425
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350425,
					"content": "Не беспокойтесь из-за этого, скорее покупайте клавишу, а с остальным разберусь я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350426
					],
					"speakerTitle": "Корнелия"
				},
				{
					"id": 740350426,
					"content": "#Спасибо! Вы так любезны, госпожа Корнелия! Я тогда пойду за клавишей... {F#Путешественница}{M#Путешественник}, нам пора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350417,
					"content": "Давайте попробуем что-нибудь другое!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350427
					]
				}
			]
		},
