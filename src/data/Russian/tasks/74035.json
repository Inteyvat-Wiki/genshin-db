			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Айюн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740350101,
					"content": "#Очень рад тебя видеть, {F#путешественница}{M#путешественник}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350102,
						740350103
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350102,
					"content": "Как твои дела?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				},
				{
					"id": 740350104,
					"content": "У тебя такие тёмные круги под глазами, и говоришь ты с трудом. Может, тебе стоит немного отдохнуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740350105,
					"content": "Мне... мне нельзя отдыхать. Вчера я мучился всю ночь, написал множество черновиков, но ни один не подошёл. Сейчас я начну переписывать снова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350106
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350106,
					"content": "Если я вам зачем-нибудь нужен, вам придётся подождать... Сядьте пока в кресло господина Роялта. Возможно, у него там есть кофе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350107
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350107,
					"content": "Мне... мне нужно писать дальше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350108
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350108,
					"content": "Так не пойдёт, «дорогие коллеги» - это недостаточно официально...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350103,
					"content": "Выглядишь неважно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				}
			]
		},
		{
			"id": 7403502,
			"completionStepIds": [
				7403504
			],
