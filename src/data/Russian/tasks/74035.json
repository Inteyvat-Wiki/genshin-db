							-0.955
						],
						"pointId": 32
					}
				]
			},
			"dialogs": [
				{
					"id": 740350201,
					"content": "#{F#Путешественница}{M#Путешественник}, очень рад нашей новой встрече. Кофе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350202,
						740350203
					],
					"speakerTitle": "Роялт"
				},
				{
					"id": 740350202,
					"content": "Кстати, раз уж об этом зашла речь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				},
				{
					"id": 740350204,
					"content": "Паймон тоже хотела спросить, но... в прошлый раз они так кричали, что Паймон боялась хоть что-то сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350243
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740350243,
					"content": "#Я думал{F#а}, меня сразу выкинут.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350205
					]
				},
				{
					"id": 740350205,
					"content": "Почему? Ха-ха-ха, не волнуйтесь, раз охрана вас пропустила, то к чему нам своевольничать и выгонять вас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350206
					],
					"speakerTitle": "Роялт"
				},
				{
					"id": 740350206,
					"content": "#Отличный пример разделения обязанностей. Здравствуйте, {F#путешественница}{M#путешественник}. Я Семан, очень рад встрече.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350207,
						740350208
					],
					"speakerTitle": "Семан"
				},
				{
					"id": 740350207,
					"content": "Здравствуйте.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350209,
					"content": "Господин Семан прежде работал в суде помощником секретаря. Из-за одного... запутанного дела его перевели в Палату Жестьон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350210
					],
					"speakerTitle": "Роялт"
				},
				{
					"id": 740350210,
					"content": "Многие проблемы, с которыми мы раньше не могли разобраться, были решены благодаря его рациональности и точности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350211
					],
					"speakerTitle": "Роялт"
				},
				{
					"id": 740350211,
					"content": "Вы слишком мне льстите. Я всего лишь использую свой прошлый опыт работы и оцениваю важность дел по ценности связанных с ними явлений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350212
					],
					"speakerTitle": "Семан"
				},
				{
					"id": 740350212,
					"content": "Хотя на практике порой встречается то, что невозможно оценить, но в таком случае мне помогает прекрасное знание человеческой психологии господина Роялта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350213
					],
					"speakerTitle": "Семан"
				},
				{
					"id": 740350213,
					"content": "То есть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350214
					]
				},
				{
					"id": 740350214,
					"content": "Проще говоря, господин Семан прекрасно умеет учитывать интересы всех сторон и даёт каждому почувствовать свою значимость. Это как выравнивание весов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350215
					],
					"speakerTitle": "Роялт"
				},
				{
					"id": 740350215,
					"content": "А если ему не удаётся разрешить ситуацию, то я прихожу на помощь и добавляю на весы «гирьки» красивых слов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350216,
						740350217
					],
					"speakerTitle": "Роялт"
				},
				{
					"id": 740350216,
					"content": "Похоже, Айюн очень много работает...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350218,
					"content": "Ага, такое ощущение, что он может бухнуться в обморок в любой момент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740350219,
					"content": "Это путь, который каждый должен пройти сам. Если я сейчас пойду и помогу Айюну закончить документ, он так ничему и не научится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350220
					],
					"speakerTitle": "Роялт"
				},
				{
					"id": 740350220,
					"content": "Он всегда строил какие-то нереалистичные фантазии относительно Палаты Жестьон. Но фантазии - удел юношей, а не сотрудников Палаты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350221
					],
					"speakerTitle": "Роялт"
				},
				{
					"id": 740350221,
					"content": "А я просто не умею составлять подобные документы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350222
					],
					"speakerTitle": "Семан"
				},
				{
					"id": 740350222,
					"content": "Вы очень прямолинейны...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350223
					]
				},
				{
					"id": 740350223,
					"content": "Ну, так зачем вы сюда пришли? Скажите, и я посмотрю, могу ли я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350224
					],
					"speakerTitle": "Роялт"
				},
				{
					"id": 740350224,
					"content": "Вдруг в панике забегает Айюн...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350225
					]
				},
				{
					"id": 740350225,
					"content": "Что за невезение! Господин Роялт, у вас есть запасная клавиша для печатной машинки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350226
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350226,
					"content": "Я сейчас печатал и вдруг обнаружил, что одна клавиша куда-то пропала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350227
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350227,
					"content": "Ты поискал вокруг? Возможно, она просто упала на пол.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350228
					],
					"speakerTitle": "Роялт"
				},
				{
					"id": 740350228,
					"content": "Или же она застряла в книге. А может, её накрыли какой-нибудь папкой... Ты везде посмотрел?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350229
					],
					"speakerTitle": "Семан"
				},
				{
					"id": 740350229,
					"content": "А ещё она может быть в стаканчике для ручек или в рукаве.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350230
					]
				},
				{
					"id": 740350230,
					"content": "А ещё в волосах или в чашке с чаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740350231,
					"content": "Я всё обыскал, проверил даже карманы на одежде и подошвы ботинок, но её нигде нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350232
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350232,
					"content": "Ладно, тогда тебе стоит обратиться к госпоже Корнелии, если где и есть запасные клавиши, то только у неё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350233
					],
					"speakerTitle": "Роялт"
				},
				{
					"id": 740350233,
					"content": "Или же лучше я просто куплю новую у Эстель. Это не должно занять много времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350234
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350234,
					"content": "Мой дорогой Айюн, зачем ты собираешься тратить собственную мору? Это собственность Палаты Жестьон, и будет правильнее обратиться к госпоже Корнелии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350235
					],
					"speakerTitle": "Роялт"
				},
				{
					"id": 740350235,
					"content": "Она не должна стоить очень дорого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350236
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350236,
					"content": "Дело здесь не в сумме. Это вопрос полномочий и ответственности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350237
					],
					"speakerTitle": "Семан"
				},
				{
					"id": 740350237,
					"content": "Ремонт собственности Палаты Жестьон должен производиться за счёт Палаты Жестьон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350238
					],
					"speakerTitle": "Семан"
				},
				{
					"id": 740350238,
					"content": "Если ты произведёшь ремонт на собственные средства и не обратишься за возмещением, то к концу года, когда будет производиться проверка служебных расходов, эта сумма не будет учтена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350239
					],
					"speakerTitle": "Семан"
				},
				{
					"id": 740350239,
					"content": "Ладно! Хорошо! Я пойду к госпоже Корнелии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350240,
						740350241
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350240,
					"content": "Даже просто купить что-то, оказывается, так сложно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350242,
					"content": "В Палате Жестьон это нормальное явление. Идём, нужно найти Корнелию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740350241,
					"content": "Даже что-то оплатить, оказывается, так сложно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350217,
					"content": "Не могли бы вы помочь ему?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350208,
					"content": "А вы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350203,
					"content": "Почему мне никто здесь не удивляется?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				}
			]
		},
