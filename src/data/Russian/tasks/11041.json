					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410401,
					"content": "Это Альбедо? Что ему в таком месте понадобилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110410402,
					"content": "Говорят, Альбедо - большой любитель рисования. Ради красивого пейзажа он пойдёт куда угодно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410403
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110410403,
					"content": "Как не посмотри, отсюда открывается прекрасный вид.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410404
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110410404,
					"content": "Но... Разве он не заметил тех хиличурлов? Ему не грозит опасность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110410405,
					"content": "Ой-ой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1104106,
			"completionStepIds": [
				1104106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104106",
							"2"
						],
						"stepId": 1104106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410601,
					"content": "Кто вы? Зачем вы их потревожили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410602
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410602,
					"content": "К счастью, я как раз закончил набросок. Было бы очень жаль оставить этого хиличурла незаконченным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410603,
						110410604
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410603,
					"content": "Так ты рисовал хиличурлов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				},
				{
					"id": 110410605,
					"content": "Зачем вообще рисовать этих хиличурлов? Разве они не все одинаковые?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110410606,
					"content": "Хм... Боюсь, объяснить это будет не так уж просто. Почему бы вам не взглянуть на рисунок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410607,
						110410608
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410607,
					"content": "Эм...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410609,
					"content": "Ух ты, какое потрясающее внимание к деталям! Но местами исполнение заметно страдает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110410610,
					"content": "Хиличурлов можно увидеть повсюду, и особого интереса они не заслуживают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410611
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410611,
					"content": "Но взгляните на эти образчики. Их комплекция, волосяной покров... Перед нами творение выдающейся жизненной силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410612
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410612,
					"content": "Так в цикличном существовании примитивных сообществ проявляет себя эволюция. Эволюция, а именно переход от небытия к существованию, от известного к неизвестному...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410613
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410613,
					"content": "Сбавь обороты. Чую, нас ждёт целая лекция, на что терпения у меня не хватит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410614
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110410614,
					"content": "Вы своего человека нашли. Мне пора уходить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410615
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110410615,
					"content": "А? Разве ты не хотела о чём-то его спросить? Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410616
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110410616,
					"content": "Какая странная...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410617
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110410617,
					"content": "Так вас привела сюда сестра Розария? Удивительно. Я даже не успел поблагодарить её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410618
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410618,
					"content": "Возвращаясь к разговору... Судя по её словам, вы искали меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410619
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410619,
					"content": "Ага. В Мондштадте мы повстречали девушку по имени Сахароза. Она говорила, что твоё исследование застопорилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410620
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110410620,
					"content": "Выходит, вас сюда послала Сахароза...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410621
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410621,
					"content": "Значит, если я не ошибаюсь, ты тот самый почётный рыцарь, о котором последнее время только и говорят в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410622
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410622,
					"content": "Я слышал о твоих действиях при нападении Ужаса Бури, о твоей необыкновенной способности управлять стихией, и ещё много чего загадочного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410623
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410623,
					"content": "Я сразу перейду к выводу. Возможно лишь одно - ты из другого мира, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410624,
						110410625
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410624,
					"content": "Именно так.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410626,
					"content": "Великолепно. Думаю, с вашей поддержкой моё исследование будет ожидать прорыв.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410627,
						110410628
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410627,
					"content": "Какое исследование?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410629,
					"content": "Ах, прошу прощения, я не хотел сбить вас с толку. Как бы это объяснить?.. Хм... Пожалуй, начну с природы жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410630
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410630,
					"content": "Постой, это слишком абстрактный предмет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410631
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110410631,
					"content": "Хм... Ты права. Что ж, вместо того, чтобы рассказывать, я лучше вам покажу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410632
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410632,
					"content": "Например, пробуждение жизни. Оживление засохших ветвей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410634
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410634,
					"content": "Разве такое возможно?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410635,
						110410636
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110410635,
					"content": "Алхимия поистине чудесна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410637,
					"content": "Однако... У меня есть особое семя, на которое упомянутый метод не воздействует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410639
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410639,
					"content": "Оно, как и ты, пришло из другого мира. Вопрос, как его прорастить, как заставить цвести, поставил меня в тупик. В этом мне ваша помощь и нужна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410640
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410640,
					"content": "Если это не под силу тебе, то куда уж нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410641
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110410641,
					"content": "Осмелюсь не согласиться. Формы жизни вне этого мира моему пониманию недоступны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410642
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410642,
					"content": "Но вы-то из мира другого. Если я как следует тебя изучу, то наверняка найду способ это семя прорастить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410643
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410643,
					"content": "Выходит, я стану объектом исследования?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410644
					]
				},
				{
					"id": 110410644,
					"content": "#{NICKNAME}, может, уйдём, пока не поздно? Странно всё это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410645,
						110410647
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110410645,
					"content": "А это опасно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410646
					]
				},
				{
					"id": 110410646,
					"content": "Возможно. Но я сделаю всё, чтобы гарантировать твою сохранность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410649,
					"content": "Нельзя терять времени. Пора сменить обстановку. Скорее, нас ждёт исследование!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410650
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410650,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410651
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110410651,
					"content": "#Похоже, Альбедо и путешественни{F#ца}{M#к} нашли общий язык.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410652
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 110410652,
					"content": "Ну, два сапога пара. Интересно... Представляет ли это угрозу Мондштадту?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Розария"
				},
				{
					"id": 110410647,
					"content": "Что я за это получу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410648
					]
				},
				{
					"id": 110410648,
					"content": "Мора, знания. А ещё ответ на интересующий тебя вопрос. Так уж получилось, что он у меня есть. Что скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110410636,
					"content": "Алхимия правда полезна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410628,
					"content": "Что-то я не понимаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
