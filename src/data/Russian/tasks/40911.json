			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тимей"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110301,
					"content": "А вот и ты! Это моя <color=#00E1FFFF>Элементальная жаровня</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110302
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110302,
					"content": "Давай посмотрим, сработает ли мой план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимей"
				}
			]
		},
		{
			"id": 4091104,
			"completionStepIds": [
				4091104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4091104",
							"2"
						],
						"stepId": 4091104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тимей"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110401,
					"content": "Нужно лишь разжечь её ещё несколько раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110402
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110402,
					"content": "#О, Путешественни{F#ца}{M#к}, как хорошо, что ты приш{F#ла}{M#ёл}! Ты ещё помнишь мою Элементальную жаровню?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110403
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110403,
					"content": "#Когда ты раз{F#ожгла}{M#жёг} её, мне удалось собрать много сведений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110404
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110404,
					"content": "Но самое важное - это то, что я убедился в стабильности её работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110405
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110405,
					"content": "С таким надёжным оборудованием можно будет провести ещё больше экспериментов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110406
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110406,
					"content": "#Путешественни{F#ца}{M#к}, не мог{F#ла} бы ты помочь мне опять зажечь Элементальную жаровню?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110407,
						409110409
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110407,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110408
					]
				},
				{
					"id": 409110408,
					"content": "Благодарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110409,
					"content": "Сколько экспериментов тебе нужно провести?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110410
					]
				},
				{
					"id": 409110410,
					"content": "Как можно больше, разумеется! Алхимикам без Глаза Бога вроде меня остаётся проводить исследования лишь таким дурацким способом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110411
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110411,
					"content": "#Я крайне признателен тебе, Путешественни{F#ца}{M#к}, за то, что ты поможешь мне разжечь Элементальную жаровню ещё раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимей"
				}
			]
		}
	]
}