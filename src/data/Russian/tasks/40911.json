			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тимей"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110102,
					"content": "Что произошло?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110103
					]
				},
				{
					"id": 409110101,
					"content": "#...Путешественни{F#ца}{M#к}! Привет! Постой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110102
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110103,
					"content": "Ладно... Мне неудобно тебя просить, но... Мне нужна твоя помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110104
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110104,
					"content": "Как ты знаешь, я не очень далеко продвинулся в изучении алхимии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110105
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110105,
					"content": "До меня дошло, что если повторять одни и те же вещи по многу раз, то это может и не привести к результату.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110106
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110107,
					"content": "Ты решил заняться натуральной биодинамической алхимией?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110108
					]
				},
				{
					"id": 409110109,
					"content": "Ты решил вернуться к истокам? Хочешь изучать древнюю алхимию?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110110
					]
				},
				{
					"id": 409110106,
					"content": "Поэтому я решил сосредоточиться на чём-то совершенно новом, посмотреть на алхимию другими глазами, сделать что-то абсолютно уникальное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110107,
						409110109
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110108,
					"content": "В этом нет ничего нового, разработки в сфере биодинамической алхимии ведутся уже давно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110110,
					"content": "Копаться в древних трудах по алхимии? Нет, я бы не стал тратить на это время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110111,
					"content": "Знаешь, что в алхимии самое главное? Элементы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110112
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110112,
					"content": "По ряду причин, большинство алхимиков работают с предметами, насыщенными элементальной энергией, а не с чистой элементальной энергией как таковой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110113
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110113,
					"content": "Из-за посторонних примесей процесс трансмутации становится менее эффективным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110114
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110114,
					"content": "Чтобы компенсировать эту потерю, алхимикам приходится использовать огромное количество элементальных материалов. Необходимо действовать максимально осторожно, поскольку примеси могут испортить результат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110115
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110115,
					"content": "К сожалению, это делает алхимию ещё менее доступной для тех, у кого нет Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110116
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110116,
					"content": "Вещи, насыщенные элементальной энергией, стоят немалых денег.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110117
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110117,
					"content": "В итоге алхимия становится не средством заработка, а дорогостоящим хобби для энтузиастов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110118
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110119,
					"content": "У меня нет Глаза Бога...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110120
					]
				},
				{
					"id": 409110121,
					"content": "Зачем ты меня искала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110122
					]
				},
				{
					"id": 409110118,
					"content": "Может быть, именно поэтому я не добился особых успехов в алхимии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110119,
						409110123
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110120,
					"content": "Действительно... Но я слышал, что ты всё равно можешь управлять элементальной энергией, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110122,
					"content": "У тебя нет Глаза Бога, но я слышал, что ты всё равно можешь управлять элементами. Это правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110123,
					"content": "Я придумал новый тип алхимического оборудования. <color=#00E1FFFF>Элементальная жаровня</color>! Принцип работы заключается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110124
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110124,
					"content": "Если вкратце, это сосуд, который может удерживать чистую элементальную энергию и генерировать элементальные реакции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110125
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110125,
					"content": "Если мне повезёт, то с помощью элементальной жаровни я смогу вывести свою алхимию на новый уровень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110126
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110126,
					"content": "Я уже всё подготовил. Мне осталось только найти кого-нибудь, кто смогу бы управлять элементальной энергией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110127
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110127,
					"content": "Если желаешь помочь мне, направляйся к <color=#00E1FFFF>храму Тысячи ветров</color>. Мои помощники уже всё там подготовили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110128
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 409110128,
					"content": "Надеюсь, на этот раз получится сотворить что-то действительно выдающееся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимей"
				}
			]
		},
		{
			"id": 4091103,
			"completionStepIds": [
				4091103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
