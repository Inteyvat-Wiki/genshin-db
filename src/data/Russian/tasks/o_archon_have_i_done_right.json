	"talks": [
		{
			"id": 7280302,
			"completionStepIds": [
				7280304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280304",
							"2"
						],
						"stepId": 7280304,
						"stateName": "QUEST_STATE_UNFINISHED"
