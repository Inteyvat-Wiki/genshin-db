					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780401,
					"content": "Мм! Ветер... сильный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780402
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780402,
					"content": "Мы не сможем пройти через штормовой барьер! Придётся идти в обход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780403,
					"content": "Осторожно, Китибоси. Просто иди за нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7267805,
			"completionStepIds": [
				7267807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267807",
							"2"
						],
						"stepId": 7267807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780501,
					"content": "Вот и пришли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780502,
					"content": "А какой отсюда вид! Посмотри туда — это то место, откуда мы пришли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780503,
					"content": "Паймон любит высокие места, мм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780504,
						726780505
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780504,
					"content": "С высоты всё видно и так здорово парить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780507
					]
				},
				{
					"id": 726780507,
					"content": "Ужастик Бури спит здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780508
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780508,
					"content": "Да... и очень-очень долго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780509,
					"content": "#И хотя {NICKNAME} и Паймон сражались с Ужасом Бури, но он не плохой дракон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780510,
					"content": "Много ему выпало страданий: его ранили, обманули плохие люди, а ещё он думал, что друг Анемо Архонт бросил его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780511,
					"content": "Мм... А что было потом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780512
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780512,
					"content": "#Потом? Ты помнишь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780513,
					"content": "#В пылу битвы я очистил{F#а} его отравленную кровь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780514
					]
				},
				{
					"id": 726780514,
					"content": "Но платформа, на которой мы сражались, рухнула. Сначала казалось, что мы и Анемо Архонт вот-вот провалимся в глубокое-преглубокое тёмное место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780515,
					"content": "Ой! Как страшно... И что вы сделали? Вы улетели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780516,
						726780519
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780516,
					"content": "Двалин спас нас и унёс прочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780517
					]
				},
				{
					"id": 726780517,
					"content": "Два?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780518
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780518,
					"content": "Так зовут Ужаса Бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780520,
					"content": "#На самом деле у Ужаса Бури есть своё имя, прямо как у Китибоси, Паймон и {NICKNAME}. Его зовут Двалин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780521
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780521,
					"content": "Ведь Двалин был ранен и обманут плохими людьми, поэтому он злился. Вот почему он напал на Мондштадт, и все подумали, что он плохой дракон и называли Ужасом Бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780522
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780522,
					"content": "Позже мы победили этих плохих людей и помогли Анемо Архонту очистить кровь, которая запятнала его. Именно тогда он понял, что Анемо Архонт не бросил его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780523
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780523,
					"content": "Ого! Ужастик Бури снова стал хорошим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780524
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780524,
					"content": "Точно! И именно поэтому Паймон привела тебя сегодня сюда на тренировку — рассказать историю Двалина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780525
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780525,
					"content": "Когда ты вырастешь, то, возможно, ты столкнёшься с непониманием и болью, и тебе будет тяжело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780526
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780526,
					"content": "Но ты не должен становиться плохим, потому что «ветра меняют своё направление»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780527
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780527,
					"content": "И однажды они задуют в сторону безоблачного будущего.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780528
					]
				},
				{
					"id": 726780528,
					"content": "Ммм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780529
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780529,
					"content": "Сложно понять, да, Китибоси?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780530
					]
				},
				{
					"id": 726780530,
					"content": "Я понял, но не совсем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780531
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780531,
					"content": "#Но Китибоси знает, что это важно. Он не забудет то, что сказали Паймон и {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780532
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780532,
					"content": "Хи-хи! Ну хоть не зря мы так долго рассказывали истории!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780533
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780533,
					"content": "Но никогда не будь капризным и шаловливым, а не то тебя снова запечатают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780534,
						726780535
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780534,
					"content": "Кажется, этот этап тренировки подошёл к концу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780536,
					"content": "Ммм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780537
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780537,
					"content": "Не грусти! И вернись к Иорою с улыбкой, а то ему тоже сделается грустно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780538
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780538,
					"content": "Ну ладно. Думаю, нам можно ещё последний разок побыть проводниками, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780539
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780539,
					"content": "Теперь нужно отвезти Китибоси к Иорою!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780540,
						726780541
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780540,
					"content": "В путь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780542,
					"content": "Мм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780541,
					"content": "Идём, Китибоси.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780535,
					"content": "Похоже, мы выполнили поручение Иороя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780519,
					"content": "Ужас Бури спас нас и унёс прочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780520
					]
				},
				{
					"id": 726780505,
					"content": "Ты знаешь, что они говорят о «дураках и дыме»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780506
					]
				},
				{
					"id": 726780506,
					"content": "Не в этом дело! Отсюда прекрасный вид и воздух замечательный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780507
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7267808,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
