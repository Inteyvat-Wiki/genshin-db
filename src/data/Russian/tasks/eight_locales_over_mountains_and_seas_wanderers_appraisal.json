			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780101,
					"content": "Этот город такой большой, но такой... угрюмый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780102
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780102,
					"content": "#Мы с {NICKNAME} и другими компаньонами сражались тут против Ужаса Бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780103,
					"content": "Ужас Бури - это такой большой страшный острозубый дракон, который вжух-вжух крыльями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780104,
						726780105
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780104,
					"content": "Ну, не такой уж и страшный.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				},
				{
					"id": 726780106,
					"content": "Ты помнишь ту статую Анемо Архонта в Мондштадте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780107,
					"content": "Статую Анемо Архонта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780108
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780108,
					"content": "Ту большую высокую статую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780109,
					"content": "Мм! Да! Анемо Архонт с большими руками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780110
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780110,
					"content": "Ужас Бури - хороший друг Анемо Архонта. Прежде Анемо Архонт тоже был из этого города...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780111,
					"content": "Ого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780112
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780112,
					"content": "Но если Ужастик Бури такой большой, то как он сюда залез?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780113,
						726780114
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780113,
					"content": "#Знаешь, я уже где-то слышал{F#а} этот вопрос...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780115,
					"content": "Паймон знает! Это потому что он не ходит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780116,
					"content": "О, Китибоси понимает. Ужастик Бури умеет летать. Ему не нужно ходить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780117
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780117,
					"content": "Аргх! Как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780118,
					"content": "Мм? Паймон не рада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780119
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780119,
					"content": "Э... Давай попозже об этом поговорим. А сейчас давайте сфотографируемся! Не шевелиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780120,
					"content": "Китибоси стоит ровно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780114,
					"content": "Это Ужас Бури.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780105,
					"content": "На самом деле, он довольно милый.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				}
			]
		},
		{
