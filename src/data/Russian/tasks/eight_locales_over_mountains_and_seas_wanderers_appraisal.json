			},
			"dialogs": [
				{
					"id": 726780301,
					"content": "Мм... красиво...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780302
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780302,
					"content": "Что такое, Китибоси?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780303,
					"content": "Такой угрюмый город. Очень грустно. Не знаю, почему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780304,
						726780305
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726780304,
					"content": "У меня такое же ощущение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				},
				{
					"id": 726780306,
					"content": "А теперь идём в центр города...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726780305,
					"content": "Это странно, Китибоси!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				}
			]
		},
		{
			"id": 7267804,
			"completionStepIds": [
				7267804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
