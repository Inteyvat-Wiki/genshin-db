			},
			"dialogs": []
		},
		{
			"id": 7267811,
			"completionStepIds": [
				7267811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267811",
							"2"
						],
						"stepId": 7267811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иорой"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726790101,
					"content": "Иорой, мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726790102,
					"content": "О, наконец-то вы вернулись. Как прошла тренировка Китибоси?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790103
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790103,
					"content": "Щёлк-щёлк, бабах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790104
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726790104,
					"content": "Мха-ха-ха! Хорошо, хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790105
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790105,
					"content": "Ох, мы снова не понимаем Китибоси...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726790106,
					"content": "Мы сняли много-много фото. Иорой, посмотри...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726790107,
					"content": "Вы показываете Иорою все фотографии с Китибоси.\\nВы также рассказываете обо всём, что случилось в пути.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726790108
					]
				},
				{
					"id": 726790108,
					"content": "И вот мы выполнили твою просьбу «провести Китибоси по восьми местам», Иорой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726790109,
					"content": "Мм! Хорошо, очень хорошо. Как и ожидал от приглянувшихся мне человеков я. Если бы были тануки вы, быть вам великими и прославленными. Возможно, всем вместе вполовину такими великими, как я!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790110
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790110,
					"content": "(Как-то не очень впечатляет...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726790111,
					"content": "Но раз мы выполнили задание, то, наверное, пора уходить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726790112,
					"content": "Уф... Ммм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790113
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726790113,
					"content": "Ну будет тебе, Китибоси. Смотри, Паймон тебя ещё кое-чему научит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726790114,
					"content": "Когда ты прощаешься с друзьями, всегда улыбайся! Так ваша следующая встреча будет ещё радостнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726790115,
					"content": "Мм? Ясно, сейчас помогу я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790116
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790116,
					"content": "Китибоси говорит: «Я понял, Белый Помпон».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790117
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790117,
					"content": "А? Неужели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790118,
						726790119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726790118,
					"content": "Китибоси снова не может говорить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				},
				{
					"id": 726790120,
					"content": "Прошло много времени. Эффект от еды тануки рассеялся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790121
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790121,
					"content": "Хм! Если бы не каменная печать, я бы сделал так, чтобы вы всегда понимали язык тануки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790122
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790122,
					"content": "Хм? Конечно, я передам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790123
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790123,
					"content": "«Китибоси усердно тренируется».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790124
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790124,
					"content": "«Он станет таким же сильным бакэ-дануки, как Иорой».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790125
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790125,
					"content": "Мм? Ха-ха-ха! Не задирай нос, маленький негодник. Вылитый я в том возрасте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790126
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790126,
					"content": "«Тогда Белому Помпону и Жёлтой Шёрстке не придётся есть еду тануки, чтобы понимать Китибоси».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790127
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790127,
					"content": "Мы будем ждать, Китибоси! В другой раз будем тренироваться вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726790128,
					"content": "Так держать, Китибоси.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790129
					]
				},
				{
					"id": 726790129,
					"content": "Не давай снова себя запечатать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790130
					]
				},
				{
					"id": 726790130,
					"content": "Мм?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790131
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790131,
					"content": "Мм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790132
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726790132,
					"content": "Ладно, не будем об этом. Ведь взяли с собой Китибоси вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790133
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790133,
					"content": "Ах да. Был один парень по имени Утамаро, который нарисовал запечатанного в лесу Тиндзю тануки. Он оставил несколько набросков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790134
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790134,
					"content": "Вы можете взять и, когда захотите вспомнить прекрасных тануки, сможете посмотреть на рисунки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790135
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790135,
					"content": "Эх, будь тануки вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790136
					],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790136,
					"content": "Мы бы уже превратились в камень?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790137
					]
				},
				{
					"id": 726790137,
					"content": "Хм, верно. Тогда ступайте. А мне нужно учить Китибоси магии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иорой"
				},
				{
					"id": 726790119,
					"content": "Мы снова не можем понимать Китибоси?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				}
			]
		}
	]
}