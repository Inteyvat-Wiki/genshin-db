						207400602
					]
				},
				{
					"id": 207400602,
					"content": "Трава-светяшка и цветок-сахарок растут в Шепчущем лесу, ветряную астру можно найти в долине Ветров, а сесилии растут на утёсе Звездолова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400603
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400603,
					"content": "В этих местах у тебя точно получится собрать самые свежие цветы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400604
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400604,
					"content": "Когда соберёшь, пожалуйста, возвращайся скорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флора"
