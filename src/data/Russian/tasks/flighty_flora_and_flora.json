			"dialogs": [
				{
					"id": 207400401,
					"content": "Насчёт тех цветов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400402
					]
				},
				{
					"id": 207400402,
					"content": "#Ты уже собрал{F#а} все цветы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400403
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400403,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400404
					]
				},
				{
					"id": 207400404,
					"content": "Ах, они такие свежие! Большое спасибо! Я высажу их перед прилавком, и они точно привлекут много клиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400405
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400405,
					"content": "Можно попросить тебя кое о чём ещё? Тот ураган сдул все мои одуванчики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400406
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400406,
					"content": "Очень красиво, когда ветер уносит семена одуванчика, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400407
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400407,
					"content": "В мондштадтском цветочном магазине никак нельзя без одуванчиков! Люди не поймут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400408
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400408,
					"content": "Однако нельзя просто так взять и собрать одуванчики. Их обязательно нужно вырастить из семян...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400409
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400409,
					"content": "Поэтому могу я попросить тебя принести мне немного семян одуванчика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400410,
						207400412
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400410,
					"content": "Конечно! Я принесу тебе семян.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400411
					]
				},
				{
					"id": 207400411,
					"content": "Большое спасибо! Ты найдёшь множество одуванчиков за стенами города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400412,
					"content": "Где мне их собрать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400413
					]
				},
				{
					"id": 207400413,
					"content": "За городскими стенами растёт очень много одуванчиков, собрать семена будет легко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флора"
				}
			]
		},
