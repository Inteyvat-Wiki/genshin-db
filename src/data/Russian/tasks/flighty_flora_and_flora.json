					]
				},
				{
					"id": 207400502,
					"content": "#Ты собрал{F#а} семена одуванчика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400503
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400503,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400504
					]
				},
				{
					"id": 207400504,
					"content": "Благодарю тебя! Этого будет достаточно. Я посажу семена в горшочки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400505
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400505,
					"content": "#...вместе с теми цветами, что ты собрал{F#а} для меня ранее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400506
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400506,
					"content": "Спасибо тебе ещё раз. Прими это в знак благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400507
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207400507,
					"content": "А мне нужно поскорее рассадить цветы. И семена одуванчика тоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флора"
				}
			]
		},
