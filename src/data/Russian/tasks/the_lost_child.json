			"dialogs": [
				{
					"id": 730031101,
					"content": "#{NICKNAME}, как хорошо, что ты здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031102,
						730031103
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730031102,
					"content": "Да, теперь не о чем переживать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730031105
					]
				},
				{
					"id": 730031105,
					"content": "Похоже, Альфонсо прав. Фатуи действительно очень опасны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031106
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730031106,
					"content": "Обсудим это позже. Наверняка Иотам в глубине пещеры. Идём же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рана"
				},
				{
					"id": 730031103,
					"content": "Ты хорошо справилась.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730031104
					]
				},
				{
					"id": 730031104,
					"content": "Правда? Хе-хе, наверное, всё потому, что со мной рядом ты и Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031105
					],
					"speakerTitle": "Рана"
				}
			]
