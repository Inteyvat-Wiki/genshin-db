					"content": "А? Тут следы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030607,
					"content": "Пойдём по ним. Может быть, это Рана оставила для нас подсказку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030606,
					"content": "Неужели эти следы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030607
					]
				}
			]
		},
