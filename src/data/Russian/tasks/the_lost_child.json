			"dialogs": [
				{
					"id": 730031001,
					"content": "Вы кто такие? Лучше бы вам пойти подобру-поздорову.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031002
					],
					"speakerTitle": "Сержант Фатуи"
				},
				{
					"id": 730031002,
					"content": "Ха, это ты кто такой, а?! Я лесной страж, и я ищу пропавшего ребёнка. Теперь вы назовитесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031003,
						730031004
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730031003,
					"content": "Это же Фатуи! Откуда они здесь взялись?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730031005
					]
				},
				{
					"id": 730031005,
					"content": "Ах, так это те самые Фатуи, о которых упоминал Альфонсо. Цель визита?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031006
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730031006,
					"content": "Альфонсо? Ну что ж. Кто бы вы ни были, так просто вам не уйти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031007
					],
					"speakerTitle": "Сержант Фатуи"
				},
				{
					"id": 730031007,
					"content": "Похоже, по-хорошему мы не договоримся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рана"
				},
				{
					"id": 730031004,
					"content": "Это Фатуи. Осторожнее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730031005
					]
				}
			]
		},
