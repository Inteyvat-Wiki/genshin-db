					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030301,
					"content": "Фух... Слава Архонтам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030302
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030302,
					"content": "Рана... Хнык-хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030303,
					"content": "Иотам, ты ведь уже такой большой. Не надо плакать. Вот сейчас расскажем об этой зоне учёным из Академии... и они сразу же всё здесь исправят...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030304,
					"content": "#И кстати, видел, как я сражалась... то есть, {F#тётя}{M#дядя} сражал{M#ся}{F#ась}. Обязательно скажи {M#ему}{F#ей} спасибо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030305,
					"content": "Рана...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030306,
					"content": "Тише, побереги силы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "Рана, тебе нужно отдохнуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030309,
					"content": "Ха... ха-ха... Не нужно. Просто голова немного кружится. И усталость навалилась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030310,
					"content": "Рана... прости меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030311,
					"content": "Т-ты чего?.. Ты ведь мой тигрёнок, а тигры не плачут!.. Иотам, а ты-то как, не поранился?.. Хорошо себя чувствуешь?.. Вдруг у тебя тоже голова кружится... и сил совсем нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030312,
					"content": "Я в порядке, но ты, Рана...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030313,
					"content": "Нет-нет! Ничего... Рана в полном порядке. Я ведь всё-таки бывалый лесной страж! Идём же!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030308,
					"content": "Я позову на помощь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030309
					]
				}
			]
		},
