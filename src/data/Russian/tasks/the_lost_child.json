				"points": []
			},
			"dialogs": [
				{
					"id": 730030101,
					"content": "Я рада, что отправилась сюда вместе с вами. Но нужно доложить Тигнари о расширении зон Увядания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030102
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030102,
					"content": "А? Это что, малыш из деревни Вимара?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030103,
					"content": "Что? Постой, Иотам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рана"
				}
			]
		},
		{
			"id": 7300302,
			"completionStepIds": [
				7300312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7300312",
							"2"
						],
						"stepId": 7300312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рана",
					"Иотам",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030201,
					"content": "Иотам... ты как тут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030202
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030202,
					"content": "#Хнык-хнык... Рана? И {M#какой-то дядя}{F#какая-то тётя}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030203
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030203,
					"content": "Ах? Как же ты попал в зону Увядания?.. Ох, сколько вокруг чудовищ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030204,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030205,
						730030206
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030205,
					"content": "Я помогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				},
				{
					"id": 730030207,
					"content": "Нет... У нас слишком мало времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030208
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030208,
					"content": "#Прошу тебя, {NICKNAME}, идём же скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030209
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030209,
					"content": "А ты, Иотам, стой там! Мы уже идём к тебе на помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030206,
					"content": "Что там за зелёная штука?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				}
			]
		},
		{
			"id": 7300303,
			"completionStepIds": [
				7300306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
