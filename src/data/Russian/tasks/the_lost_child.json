			},
			"dialogs": [
				{
					"id": 730030701,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030702
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030702,
					"content": "Эй! Рана! Ты здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030703,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030704
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030704,
					"content": "Что тут происходит? О, неужели это та штука, о которой говорили Иотам и Рана? Ара... кала... Как она там называлась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030705,
						730030708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030705,
					"content": "Араракалари?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030706
					]
				},
				{
					"id": 730030706,
					"content": "Да-да! Точно! Он ещё может противостоять разложению Мараны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030707,
					"content": "Угу. Умные нары. Араракалари отлично справляется с Мараной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030711,
					"content": "Ого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030712,
					"content": "Ого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030713,
						730030715
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030713,
					"content": "Неужели это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030714
					]
				},
				{
					"id": 730030714,
					"content": "Фух... Ты чего так пугаешь! Паймон подумала, что овощ заговорил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030716,
					"content": "Не овощ. Арана. Арана - друг. Арана - аранара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030717,
						730030722
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030717,
					"content": "Аранары...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030718
					]
				},
				{
					"id": 730030718,
					"content": "А? Аранары? Где-то мы уже слышали это слово...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030719
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030719,
					"content": "Арана...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030720
					]
				},
				{
					"id": 730030720,
					"content": "Кажется, Иотам упоминал это имя, когда рассказывал нам историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030721
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030721,
					"content": "Да. Нара Иотам - друг Араны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030727,
					"content": "#Аранары - дети леса. Живут вместе с деревьями. Не такие, как ты и нара {NICKNAME}. Ты будто дитя одуванчика. Всегда в пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030728
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030728,
					"content": "#Откуда ты знаешь имя {M#моего спутника}{F#моей спутницы}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030729
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030729,
					"content": "Неважно. Арана просто знает. Важно другое. Арана очень хочет помочь наре Ране.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030730,
						730030732
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030730,
					"content": "Наре Ране... Язык сломаешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030731
					]
				},
				{
					"id": 730030731,
					"content": "Помочь Ране? Что нам нужно сделать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030733
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030733,
					"content": "Спасибо вам. Вы хорошие нары. Нара Рана - очень важна для Араны. Она - друг. Поэтому Арана будет защищать её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030734
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030734,
					"content": "#Но этого мало. Нужно вылечить нару Рану. Найти биджу. {NICKNAME} отправится в Ванарану. Попросит помочь отыскать биджу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030735,
						730030736
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030735,
					"content": "Биджа...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030737,
					"content": "Нару Рану охватило разложение Мараны. Это очень опасно. Жуки-вредители грызут корни деревьев. Те засыхают. Плоды гниют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030738
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030738,
					"content": "Жизнь нар подобна дереву. Марана - жук-вредитель. Только биджа может спасти нару Рану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030739
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030739,
					"content": "Значит, нам нужно отправиться в какое-то место под названием «Ванарана»... попытаться найти «биджу». А затем мы сможем спасти Рану, так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030740
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030740,
					"content": "Пока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030741,
						730030744
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030741,
					"content": "А сейчас Рана...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030742
					]
				},
				{
					"id": 730030742,
					"content": "Не волнуйся. Здесь будет Арана. Поможет сопротивляться разложению Мараны. Чтобы не стало хуже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030743
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030743,
					"content": "Но без биджи лучше тоже не станет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030745
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030745,
					"content": "Идите по лесной тропе туда, откуда течёт вода. Так и попадёте в Ванарану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030746
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030746,
					"content": "А затем спойте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030747,
						730030748
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030747,
					"content": "Спеть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030750
					]
				},
				{
					"id": 730030750,
					"content": "(В голове заиграла какая-то мелодия...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030751
					]
				},
				{
					"id": 730030751,
					"content": "Это Песня великого сновидения. Только пропев эту мелодию, можно попасть в Ванарану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030752
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030752,
					"content": "Попасть в наши сны, наш мир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030748,
					"content": "Привлечём попрыгуний?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030749
					]
				},
				{
					"id": 730030749,
					"content": "#Нара {NICKNAME} так{F#ая}{M#ой} забавн{F#ая}{M#ый}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030750
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030744,
					"content": "Понятно. Как нам добраться до нужного места?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030745
					]
				},
				{
					"id": 730030736,
					"content": "...что это?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030732,
					"content": "Как мы можем ей помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030733
					]
				},
				{
					"id": 730030722,
					"content": "Арана...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030723
					]
				},
				{
					"id": 730030723,
					"content": "Кажется, Иотам упоминал это имя, когда рассказывал нам историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030724
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030724,
					"content": "Да. Нара Иотам - друг Араны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030725
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730030725,
					"content": "Аранары...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030726
					]
				},
				{
					"id": 730030726,
					"content": "А? Аранары? Где-то мы уже слышали это слово...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030715,
					"content": "Овощ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030716
					]
				},
				{
					"id": 730030708,
					"content": "Как-как, можно ещё раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030709
					]
				},
				{
					"id": 730030709,
					"content": "Какой-то ара... может противостоять разложению Мараны... Уф, ну и странные названия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030710,
					"content": "Араракалари. Противостоит Маране. Названия не странные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Арана"
				}
			]
		},
		{
			"id": 7300308,
			"completionStepIds": [
				7300314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7300314",
							"2"
						],
						"stepId": 7300314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рана",
					"Паймон",
					"Иотам"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030801,
					"content": "#Простите... {NICKNAME}, Паймон, мне нужно передохнуть... Иотам, подожди меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030802
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030802,
					"content": "Рана, ты точно в порядке?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030803,
					"content": "Мы позовём на помощь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030804
					]
				},
				{
					"id": 730030804,
					"content": "Нет-нет, всё хорошо!.. Мне просто нужно чуть-чуть отдохнуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030805
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030805,
					"content": "Прости, Рана... Прости меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030806
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030806,
					"content": "Ну что же ты... Я ведь уже сказала, что всё хорошо! Но всё же я на тебя зла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030807
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030807,
					"content": "Ты ведь обещал мне... не ходить в лес... Вот сейчас я отдохну и покажу тебе, как надо слушаться старших... Непослушный мальчик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030808
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030808,
					"content": "Хнык-хнык... Я просто услышал, как братик Альфонсо говорил, будто бы где-то здесь растут большие грибы! Хотел набрать свежих грибочков для Раны... чтобы Рана съела их и наполнилась жизненными силами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030809
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030809,
					"content": "Глупыш, не нужно было... Ничто так не придаёт мне жизненных сил, как забота о других людях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030810
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030810,
					"content": "Ха-ха-ха... Но грибы здесь и правда большие... вот бы набрать их и сварить карри. Вкусно, наверное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030811
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030811,
					"content": "Так это Альфонсо послал тебя сюда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030812
					]
				},
				{
					"id": 730030812,
					"content": "Нет. Братик Альфонсо сказал, чтобы я никуда не убегал. Но мне очень хотелось найти для Раны вкуснятину, вот и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030813
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030813,
					"content": "Альфонсо никогда бы так не поступил. Он же его старший брат...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030814
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030814,
					"content": "Ладно... Но как же тогда Иотам забрёл в мёртвую зону?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030815
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030815,
					"content": "В лесу мне показалось, будто бы за мной кто-то следит. Я испугался. Подумал, вдруг это воплощение Мараны. Вот и побежал... Хнык-хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030816
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030816,
					"content": "А в итоге в Марану и попал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030817
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030817,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030818,
						730030823
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030818,
					"content": "Марана?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030819
					]
				},
				{
					"id": 730030819,
					"content": "Это... зона Увядания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030820
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030820,
					"content": "Да, она самая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030821
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030821,
					"content": "Воплощение Мараны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030822
					]
				},
				{
					"id": 730030822,
					"content": "Угу. Чёрное-чёрное, высокое-превысокое... Очень плохое. Это та же Марана, только может ходить по земле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030828,
					"content": "Марана... какое странное название.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030829
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030829,
					"content": "Ага. Откуда я это знаю?.. Ах! Голова так и кружится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030830
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030830,
					"content": "Иотам, а это что? Зелёное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030831
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030832
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030832,
					"content": "Это араракалари... Он защищает нас от Мараны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030833
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030833,
					"content": "Всё запутаннее и запутаннее...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030834
					]
				},
				{
					"id": 730030834,
					"content": "Это... что-то вроде лесной магии... или музыки... Это ара...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030835,
						730030837
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030835,
					"content": "Что это такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030836
					]
				},
				{
					"id": 730030836,
					"content": "Рана, не думай сейчас об этом. Лучше хорошенько отдохни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030838
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030838,
					"content": "Я-я почти вспомнила, называется...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030839
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030839,
					"content": "Прости меня, Рана. Прости, пожалуйста... Я больше никогда-никогда не буду убегать! Буду всегда сидеть дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030840
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030840,
					"content": "Да, Иотам. Ты должен быть смышлёным, сильным. Знать, что хорошо, а что плохо... Знать также, какие грибы можно есть, а какие нельзя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030841
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030841,
					"content": "Х-хорошо, я понял. Прости...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030842
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030842,
					"content": "#Марана плохая, а лес добрый... Стань сильным, честным человеком и всегда помогай тем, кто в беде... так же, как помогают {NICKNAME} и Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030843
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030843,
					"content": "А ещё всегда помни, что лес помнит всё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030844
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030844,
					"content": "Ой, нет-нет-нет! Похоже, Ране всё хуже и хуже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030845,
						730030846
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030845,
					"content": "Нужно позвать на помощь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030847,
					"content": "Хм? А... нет-нет, я в порядке. Просто устала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030848
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030848,
					"content": "#{NICKNAME}, пожалуйста... отведи Иотама домой вместо меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030849
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030849,
					"content": "Угу, пойдём, Иотам. Рана, никуда не уходи! Мы мигом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030846,
					"content": "Рана, жди нас здесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030837,
					"content": "Не забивай этим голову. Отдыхай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030838
					]
				},
				{
					"id": 730030823,
					"content": "Воплощение Мараны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030824
					]
				},
				{
					"id": 730030824,
					"content": "Угу. Чёрное-чёрное, высокое-превысокое... Очень плохое. Это та же Марана, только может ходить по земле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030825
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030825,
					"content": "Марана?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030826
					]
				},
				{
					"id": 730030826,
					"content": "Это... зона Увядания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030827
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730030827,
					"content": "Да, она самая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
					],
					"speakerTitle": "Иотам"
				}
			]
