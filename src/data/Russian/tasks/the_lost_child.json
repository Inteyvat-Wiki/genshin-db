			"trigger": {
				"objectNames": [
					"Альфонсо",
					"Паймон",
					"Иотам"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030501,
					"content": "#Иотам? Как ты тут оказался... И {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030502
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730030502,
					"content": "Времени мало. Расскажем в двух словах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030503,
					"content": "Вы кратко рассказываете, что произошло.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730030504
					]
				},
				{
					"id": 730030504,
					"content": "...Понятно. Иотам, иди отдохни немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030505
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730030505,
					"content": "Угу. Простите меня, дядя Альфонсо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030506
					],
					"speakerTitle": "Иотам"
				},
				{
					"id": 730030506,
					"content": "#Ничего, главное, что ты в порядке. {NICKNAME}, подожди меня здесь. Я захвачу кое-какие лекарства, и сразу же пойдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030507
					],
					"speakerTitle": "Альфонсо"
				},
				{
					"id": 730030507,
					"content": "У нас нет на это времени. Будем ждать тебя на том месте.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030508
					]
				},
				{
					"id": 730030508,
					"content": "Да, мы должны вернуться и быть рядом с Раной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730030509,
					"content": "Эй, подождите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альфонсо"
				}
			]
		},
