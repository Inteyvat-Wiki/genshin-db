					"content": "Рана!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030604
					]
				},
				{
					"id": 730030604,
					"content": "Не отвечает... Ох, что же нам делать?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030605
					],
					"speakerTitle": "Паймон"
				},
				{
