			},
			"dialogs": [
				{
					"id": 4820202,
					"content": "Прочитали, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820203,
					"content": "Не могу сказать, что...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820201,
					"content": "А вот и вы! Прочитали руководство? Всё запомнили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820202,
						4820203
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820204,
					"content": "Да, понимаю тебя. Это всё непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820205
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820205,
					"content": "Руководство написано таким сухим языком. Мне совсем не понравилось. Только не говори об этом действующему магистру Джинн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820206
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820206,
					"content": "Правда? А мне понравились интересные истории из руководства...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4820207,
					"content": "Интересные истории? Ты имеешь в виду примеры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820208
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820208,
					"content": "Мне они тоже нравятся. Мой любимый - про взлёт с помощью Анемо слайма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820209
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820209,
					"content": "Если проткнуть слайма, то он оттолкнёт тебя ооочень высоко. Всегда хотела попробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820210
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820210,
					"content": "Я не об этом! Я про маленькую птичку, которая хотела летать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4820211,
					"content": "Что? Какая ещё птичка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820212
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820212,
					"content": "Дай мне посмотреть! Ой, это же моя детская книжка со сказками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820213
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820213,
					"content": "Я перепутала книжки. Прости меня, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820214
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820214,
					"content": "Как ты могла перепутать детские сказки и руководство по управлению планером?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4820215,
					"content": "Ох... Мне очень стыдно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820216
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820216,
					"content": "Наверное, это потому, что на самом деле именно эти сказки научили меня летать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820217
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820217,
					"content": "«Тебе нужен не ветер, а смелость! Смелость позволила первой птице подняться в небо!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820218
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820218,
					"content": "Эти сказки дали мне смелость летать, смелость быть скаутом, смелость стать Чемпионом Полётов Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820219
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820219,
					"content": "Вернёмся к экзамену!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820220
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820220,
					"content": "Не переживай, просто пари, как обычно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820221
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4820222,
					"content": "#Я готов{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4820221,
					"content": "Следуй за <color=#00E1FFFF>метками</color> до самого финиша.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Эмбер"
				}
			]
		},
