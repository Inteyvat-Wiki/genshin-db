				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Наджат"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "Ох... от этих красных стервятников нет никакого спасения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400202,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "#Ты... ты же путешественни{F#ца}{M#к}, верно? Эбейд рассказывал о тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400204,
					"content": "#Хе-хе, так неожиданно встретить путешественни{F#цу}{M#ка} в нашей деревне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400205,
					"content": "Ты знаешь господина Хабачи? Он всегда такой серьёзный... Прошу, не бери в голову, если он окажется вспыльчивым во время разговора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400206,
					"content": "В конце концов... большинство припасов в нашей деревне хранится на этом складе. Здесь не только еда, но и одежда, оружие и даже мора и другое имущество...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400207,
					"content": "В деревне не так много молодых людей, и им приходится заниматься самыми разными делами, в том числе защитой деревни... В итоге Хабачи приходится в одиночку охранять склад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400208,
					"content": "Я не могу ему ничем помочь, кроме ведения бухгалтерии и учёта товаров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400209,
					"content": "Ты сейчас говорила о красных стервятниках...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "Ой, даже не напоминай. Недавно на склад поступила партия сушёного мяса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400211,
					"content": "Не знаю, как запах из склада проникает наружу, но несколько красных стервятников то и дело прилетают и садятся на ближайшем холме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400212,
					"content": "До вяленого мяса на складе им не добраться, но стоит кому-нибудь неподалёку приняться за еду, и красные стервятники устраивают налёты с воздуха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400213,
					"content": "Стражникам деревни никак не удаётся от них избавиться, а господину Хабачи тем более не до этого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400214,
					"content": "#Путешественни{F#ца}{M#к}, если ты свобод{M#ен}{F#на}, помоги мне расправиться с этими красными стервятниками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400215,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "Спасибо тебе. Вот только эти красные стервятники жуть какие свирепые. Лучше к ним не приближаться... Воспользуйся луком: так ты сможешь справиться с ними без особых рисков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400217,
					"content": "На что они нападали?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "Много на что - на товары при погрузке и разгрузке, на мясо при сушке, на еду господина Хабачи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400219,
					"content": "Господину Хабачи на дежурстве часто приходится отвлекаться от еды. А красные стервятники не дремлют - подлетают и растаскивают всё мясо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400220,
					"content": "Ему нельзя покидать пост, поэтому он не может пойти и проучить красных стервятников. Приходится смотреть, как они улетают, а потом доедать то, что осталось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400221,
					"content": "#Путешественни{F#ца}{M#к}, пожалуйста, избавь нас от этих красных стервятников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наджат"
				}
			]
		},
