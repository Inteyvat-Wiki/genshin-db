			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Наджат"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400401,
					"content": "Ну как, тебе удалось избавиться от красных стервятников?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400402,
						230400403
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400402,
					"content": "Всё сделано в лучшем виде.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				},
				{
					"id": 230400404,
					"content": "Большое спасибо! Теперь господин Хабачи наконец сможет нормально поесть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400405
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400405,
					"content": "Чуть не забыла, вот, прими это в качестве награды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400406
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400406,
					"content": "Хм, что там ещё должно было поступить сегодня на склад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400403,
					"content": "Какое-то время они не будут вас беспокоить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				}
			]
		},
		{
			"id": 2304005,
			"completionStepIds": [
				2304005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
