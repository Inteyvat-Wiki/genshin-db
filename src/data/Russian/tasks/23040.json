				"objectNames": [
					"Наджат"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400801,
					"content": "#Путешественни{F#ца}{M#к}, ты как раз вовремя. Скорее отправляйся на помощь господину Хабачи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400802,
						230400803
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400802,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				},
				{
					"id": 230400804,
					"content": "Беда! Одна партия товаров на пути к деревне была перехвачена Похитителями сокровищ. Все свободные стражники уже отправились на помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400805
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400805,
					"content": "Хабачи сказал, что людей всё равно слишком мало, поэтому он сам взялся за оружие, чтобы присоединиться к стражникам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400806
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400806,
					"content": "Но говорят, в этот раз Похитителей сокровищ слишком много. Хабачи одному не справиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400807
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400807,
					"content": "#Путешественни{F#ца}{M#к}, я отмечу на твоей карте, куда он отправился. Скорее помоги ему, очень прошу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400808,
						230400810
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400808,
					"content": "Я отправляюсь немедленно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400809
					]
				},
				{
					"id": 230400809,
					"content": "#Спасибо тебе, путешественни{F#ца}{M#к}. Надеюсь, что с господином Хабачи ничего не случится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400810,
					"content": "Он вообще умеет сражаться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400811
					]
				},
				{
					"id": 230400811,
					"content": "С одним-двумя Похитителями сокровищ он сможет справиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400812
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400812,
					"content": "Но говорят, что в этот раз на караван напала целая банда, и если бы один из перевозчиков не примчался в деревню с вестями о нападении, то об этом так никто бы и не узнал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400813
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400813,
					"content": "Ах, если бы госпожа Кандакия не покинула деревню, то Похитители сокровищ на такое бы не отважились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400814
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400814,
					"content": "Увидели слабое место, вот и решили действовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400815
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400815,
					"content": "#Путешественни{F#ца}{M#к}, вся надежда на тебя, помоги господину Хабачи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400803,
					"content": "Почему ты так взволнована?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				}
			]
		},
