				"objectNames": [
					"Наджат"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400701,
					"content": "#Путешественни{F#ца}{M#к}, тебе удалось достать нужные товары?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400702
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400702,
					"content": "Да. Вот они.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400703
					]
				},
				{
					"id": 230400703,
					"content": "Замечательно! Товары можешь оставить там, огромное спасибо за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400704
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400704,
					"content": "Господин Хабачи ушёл на склад, чтобы провести учёт других товаров, так что я пока присмотрю за продуктами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400705
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400705,
					"content": "Ох, надеюсь, что эта партия продуктов не пострадала слишком сильно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наджат"
				}
			]
		},
		{
			"id": 2304008,
			"completionStepIds": [
				2304008
			],
