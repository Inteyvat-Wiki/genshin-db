	"talks": [
		{
			"id": 2304002,
			"completionStepIds": [
				2304002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304002",
							"2"
						],
						"stepId": 2304002,
