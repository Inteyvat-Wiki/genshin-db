			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Наджат"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400501,
					"content": "Эх, когда же господин Хабачи сможет хоть немного отдохнуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400502
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400502,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400503
					]
				},
				{
					"id": 230400503,
					"content": "#Путешественни{F#ца}{M#к}, ты как раз вовремя. Не мог{F#ла} бы ты мне кое с чем помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400504
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400504,
					"content": "Недавно в деревню была отправлена партия сушёных продуктов, и господин Хабачи уже приготовился принимать её на складе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400505
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400505,
					"content": "Однако красные стервятники учуяли запах еды, собрались в стаю и атаковали груз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400506
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400506,
					"content": "Охранникам удалось быстро прогнать их, но красные стервятники разбросали еду повсюду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400507
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400507,
					"content": "Все ушли, чтобы предупредить остальные команды по доставке грузов, а Хабачи собирает уцелевшие продукты. Может, ты возьмёшься помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400508,
						230400510
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400508,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400509
					]
				},
				{
					"id": 230400509,
					"content": "Тогда положусь на тебя. Мне очень неловко, но мне надо принять следующую партию товара, так что я не могу пойти сама.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400510,
					"content": "Господин Хабачи в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400511
					]
				},
				{
					"id": 230400511,
					"content": "Я предложила ему немного отдохнуть, а он ни в какую. Говорит, что после сбора продуктов ему ещё нужно будет провести на складе учёт. Не понимаю, как он всё это выдерживает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400512
					],
					"speakerTitle": "Наджат"
				},
				{
					"id": 230400512,
					"content": "#Товары должны быть возле Белого подъёмника. Путешественни{F#ца}{M#к}, пожалуйста, помоги нам вернуть эти товары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Наджат"
				}
			]
		},
