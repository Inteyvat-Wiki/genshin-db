					"Хабачи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230401002,
					"content": "#Фух... Большое тебе спасибо, путешественни{F#ца}{M#к}. Если бы не твоя помощь, то этот груз не удалось бы сохранить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401003,
						230401005
					],
					"speakerTitle": "Хабачи"
				},
				{
					"id": 230401003,
					"content": "Ты отлично сражаешься.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401004
					]
				},
				{
					"id": 230401004,
					"content": "Ха-ха, спасибо на добром слове. Но в одиночку я бы не справился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401007
					],
					"speakerTitle": "Хабачи"
				},
				{
					"id": 230401007,
					"content": "Как ни крути, боец из меня не самый лучший. Вот если бы госпожа Кандакия была здесь, то все эти Похитители сокровищ уже бы валялись на земле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401008
					],
					"speakerTitle": "Хабачи"
				},
				{
					"id": 230401008,
					"content": "Прошу прощения, сейчас не время для подобных разговоров, сначала я должен вернуть эти товары в деревню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401009
					],
					"speakerTitle": "Хабачи"
				},
				{
					"id": 230401009,
					"content": "#Путешественни{F#ца}{M#к}, здесь сейчас небезопасно, поскорее возвращайся назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401010
					],
					"speakerTitle": "Хабачи"
				},
				{
					"id": 230401010,
					"content": "Интересно, откуда эта банда Похитителей сокровищ настолько хорошо осведомлена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хабачи"
				},
				{
					"id": 230401005,
					"content": "Ты здесь один?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401006
					]
				},
				{
					"id": 230401006,
					"content": "Были и другие охранники, которые покинули деревню вместе со мной, но они отправились в другие места на поиск товаров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401007
					],
					"speakerTitle": "Хабачи"
				}
			]
		}
