			},
			"dialogs": [
				{
					"id": 722040901,
					"content": "#Ты {F#пришла}{M#пришёл}! Кито, Кина, поприветствуйте {F#гостью}{M#гостя}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040902
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040902,
					"content": "Я не знаю, куда они снова убежали... Простите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040903
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040903,
					"content": "Как вас зовут?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040904,
						722040905
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040904,
					"content": "#Здравствуйте, я {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040906
					]
				},
				{
					"id": 722040906,
					"content": "Мне пора уходить, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040907
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040907,
					"content": "Уходить?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040908
					]
				},
				{
					"id": 722040908,
					"content": "Лодочник часто приходит ко мне в последнее время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040909
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040909,
					"content": "Каждый раз он приходит тихо. В золотой шубе, в золотых штанах, с золотой короной на голове...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040910
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040910,
					"content": "Всё, как говорила мне мама, и как я говорила Кито и Кине... Он придёт, чтобы взять нас на борт своей серебряной лодки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040911
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040911,
					"content": "Лодка поплывёт по сверкающей реке в страну грёз. Там не будет тумана, там будет большой золотой дворец с семьюдесятью колыбелями и ещё семьюдесятью... Они будут качаться туда-сюда, туда-сюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040912
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040912,
					"content": "Там мы будем спать и станем частичками света... Мы станем мечтами детей этого мира...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040913,
						722040914
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040913,
					"content": "Ого...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040915,
					"content": "Лодочник сказал, что он пришёл от Кито и Кины, чтобы передать мне это. Хе-хе, детишки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040916
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040916,
					"content": "Ещё не время... Время ещё не пришло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040914,
					"content": "Вы говорите, что...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040905,
					"content": "#Я {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040906
					]
				}
			]
		},
