			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Уна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040701,
					"content": "Здравствуй. Здравствуй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040702
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040702,
					"content": "Мне очень жаль, но чем больше я старею, тем туманнее становится мой разум. Могу я ещё раз спросить, кто вы? Мы встречались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040703,
						722040704
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040703,
					"content": "#Меня зовут {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				},
				{
					"id": 722040705,
					"content": "Это имя мне не знакомо... Вы пришли из внешнего мира?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040706
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040706,
					"content": "Это очень странно. Вы не должны были сойти на берег без разрешения Громовой птицы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040707,
						722040708
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040707,
					"content": "Громовой птицы давно нет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040709,
					"content": "Глядя на вас, я вспоминаю своего бедного мужа. Я с трудом помню его лицо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040710
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040710,
					"content": "Мы тогда были молоды, наши умы были полны всевозможных безрассудных фантазий... Но некоторые люди совсем не взрослеют. Даже после того, как вы провели вместе столько времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040711
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040711,
					"content": "Он ушёл от меня, построил себе деревянный плот и попытался уплыть через море туда, где живут чужаки. Он сказал, что хочет там свободно охотиться и собирать цветы, которых никогда раньше не видел... Красивые цветы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040712
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040712,
					"content": "Он говорил это с самого детства... Он так и не повзрослел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040713
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040713,
					"content": "Позже ребёнок священника рассказал, что нашёл его... лежащим на пляже, безмолвным, как раковины, белее песка... Он сжимал в руке эти цветы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040714
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040714,
					"content": "Затем священник зарыдал, говоря, что... лодка наших предков отвергла его. Что отныне его душа будет скитаться только по чужим землям...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040715
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040715,
					"content": "Тогда я только родила нашего ребёнка... Как я могла сказать ему об этом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040716
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040716,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040717
					]
				},
				{
					"id": 722040717,
					"content": "Позже у моего ребёнка тоже родились дети. Я отправила своего ребёнка на борт серебряной лодки, а сама осталась здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040718
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040718,
					"content": "Теперь я беспокоюсь только о Кито и Кине...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040708,
					"content": "Нужно кое-что объяснить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040704,
					"content": "#Здравствуйте! Называйте меня {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				}
			]
		},
