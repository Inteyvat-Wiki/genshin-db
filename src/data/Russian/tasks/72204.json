					"Уна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040301,
					"content": "Всё становится менее ясным... Всё туманнее и туманнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040302,
						722040303
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040302,
					"content": "Здравствуйте.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				},
				{
					"id": 722040304,
					"content": "Моя память ухудшается с каждым днем. Это всё старость...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040305
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040305,
					"content": "Но что мне делать? Я не знаю, голодны ли Кито и Кина, в безопасности ли они, когда играют на улице...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040306,
						722040307
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040306,
					"content": "С ними всё в порядке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040308,
					"content": "Кито, Кина! Почему вы вернулись так поздно? С вами ничего не случилось по дороге? Вы ведь не лазили по деревьям?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040309
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040309,
					"content": "Вы заставляете свою старую бабушку волноваться! Я не знаю, что случилось, но мне кажется, что с каждым днём на этом острове становится всё меньше и меньше людей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040310
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040310,
					"content": "Я даже не всех помню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040311
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040311,
					"content": "Что я буду делать, если однажды забуду вас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040312
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040312,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040313
					]
				},
				{
					"id": 722040313,
					"content": "Вот. Возьмите эти лепестки. Если бабушка забудет вас, отдайте их мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040314
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040314,
					"content": "Ах, я хочу рассказать вам так много историй...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040307,
					"content": "Я могу вам чем-то помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040303,
					"content": "Что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				}
			]
		},
