				"points": []
			},
			"dialogs": [
				{
					"id": 722040201,
					"content": "Хорошо, хорошо. Бабушке нужно немного вздремнуть. Хр-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040202
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040202,
					"content": "Будьте осторожны... Не убегайте слишком далеко... Хр-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Уна"
				}
			]
		},
		{
			"id": 7220403,
			"completionStepIds": [
				7220402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
