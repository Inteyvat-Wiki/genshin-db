				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Уна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040101,
					"content": "Кито, Кина, это вы?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040102
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040102,
					"content": "Правда, вам пора перестать постоянно убегать. Мои старые ноги не могут угнаться за вами! Что я буду делать, если вы попадёте в неприятности, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040103,
						722040104
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040103,
					"content": "Здравствуйте!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				},
				{
					"id": 722040105,
					"content": "Шутники... Разве можно говорить такое старой женщине? Вы разбиваете мне сердце...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040106
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040106,
					"content": "Раз уж вы здесь, не убегайте пока, ладно? Составьте бабушке компанию ненадолго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040107,
						722040108
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040107,
					"content": "Простите, я...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040109,
					"content": "Итак, на чём я остановилась в той истории, которую начала рассказывать? Вспомнила... Это было, когда дед вашего деда был ещё молод...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040110
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040110,
					"content": "За туманным морем, на острове чужаков, жил клан Сумари. Говорят, что матриархом этого клана была женщина с внешностью лисицы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040111
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040111,
					"content": "Говорят, что на этой земле росли цветы цвета молнии, а народ Сумари строил жилища и жил в гармонии среди гор и равнин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040112
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040112,
					"content": "А потом... их цветы... Хр-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040113
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040113,
					"content": "Хр-р-р... за туманным морем, да...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040114,
						722040115
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040114,
					"content": "Бабушка, как вы себя чувствуете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040116,
					"content": "Кито? Кина? Вам надо идти? Извините, бабушка снова уснула...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040117
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040117,
					"content": "Не забудь их перед уходом... Бабушка хранила их для вас всё это время. Цветы с дальнего берега туманного моря. Не потеряйте их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040115,
					"content": "(Не будем ей мешать...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040108,
					"content": "Хорошо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040104,
					"content": "Вы меня с кем-то перепутали.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				}
			]
		},
		{
