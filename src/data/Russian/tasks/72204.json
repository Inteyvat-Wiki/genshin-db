			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Уна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040501,
					"content": "А, это Абэ? Как поживают грибы в твоём доме? Ха-ха... Не приставай больше к священнику. Я не соглашусь, сколько бы он ни просил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040502
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040502,
					"content": "Ха-ха! Мне жаль, но у меня полно забот по дому. Мне очень жаль, хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040503
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040503,
					"content": "Прости... мне жаль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040504,
						722040505
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040504,
					"content": "Здравствуйте, бабушка!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				},
				{
					"id": 722040506,
					"content": "Ах! Это ты! Иди сюда быстрее, позорище!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040507,
						722040508
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040507,
					"content": "Хм?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040509,
					"content": "Как прошла рыбалка? Ничего не поймал, говоришь... Ну, это не имеет значения. Плодов из нашего сада должно хватить. Просто этого недостаточно для подношения Громовой птице... А? Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040510
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040510,
					"content": "Что ты такое говоришь?! Церемония в этом году прошла хорошо! И в следующем году тоже всё будет хорошо. Священник даже сказал, что у нас будет здоровый ребёнок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040511
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040511,
					"content": "Почему ты говоришь об этом сейчас?! Ты забыл, что случилось с кланом Кама?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040512,
						722040513
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040512,
					"content": "Не надо так горячиться!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040514,
					"content": "Если ты хочешь отказаться от Громовой птицы, и чтобы волны поглотили тебя, ты волен идти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040515
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040515,
					"content": "Моё дитя... бедное дитя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040513,
					"content": "Кама?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040508,
					"content": "Что?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040505,
					"content": "Как вы поживаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				}
			]
		},
