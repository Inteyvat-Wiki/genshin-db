			"dialogs": [
				{
					"id": 722040401,
					"content": "Идите, идите играть. Бабушка будет здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040402
					],
					"speakerTitle": "Уна"
				},
				{
					"id": 722040402,
					"content": "Лепестки... лепестки... ваша родина... какая она?..",
					"roleType": "TALK_ROLE_NPC",
