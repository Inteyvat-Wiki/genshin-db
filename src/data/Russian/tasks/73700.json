	"talks": [
		{
			"id": 7370001,
			"completionStepIds": [
				7370001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370001",
							"2"
						],
						"stepId": 7370001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Зурван"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737000101,
					"content": "Незаметно мы переходим ко второй части обучения. Как идут дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000102,
						737000103
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737000102,
					"content": "Можно сказать, набираем обороты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				},
				{
					"id": 737000104,
					"content": "Хотя когда Соруш рассказывает нам истории, это похоже на некий самоанализ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000105,
					"content": "Диалог - хороший способ обучения для Соруш. Тем более что люди, с которыми она разговаривает, интереснее членов ордена скептиков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000106
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737000106,
					"content": "#Первоявленная, не торопитесь с выводами... {NICKNAME} - {M#выдающийся}{F#выдающаяся} яснапати, но не все в ордене скептиков...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000107
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000107,
					"content": "Возможно, у них встречаются не только лесть и обман, но и кратковременные проявления добродетели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000108
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737000108,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000109
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000109,
					"content": "#Я вижу, тебя всё ещё нужно убеждать. Пусть {NICKNAME} и Паймон оценят твои поступки. Конечно, это будет после того, как ты закончишь свой рассказ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зурван"
				},
				{
					"id": 737000103,
					"content": "Ещё есть куда расти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				}
			]
		},
		{
			"id": 7370006,
			"completionStepIds": [
				7370006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370006",
							"2"
						],
						"stepId": 7370006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Соруш"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737000601,
					"content": "Так тихо. Никого нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000602,
					"content": "Если бы даже Рашну была здесь, всё равно было бы тихо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000603
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000603,
					"content": "Да, но в её присутствии нам пришлось бы говорить потише. У неё всегда сонное выражение лица. Она выглядела не очень-то счастливой, когда мы разбудили её с помощью кори-барабанов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000604,
					"content": "Паймон слышала, что чем тише человек, тем страшнее он, когда сердится. Кто знает, какова Рашну в гневе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000605,
					"content": "Тогда, если это правда, то больше всего стоит бояться яснапати?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000606
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000606,
					"content": "#Что? О, Паймон знает {M#его}{F#её} лучше всех. Хотя {M#путешественник}{F#путешественница} не из тех, кто любит поговорить, {M#он}{F#она} всё равно очень мил{F#а}. Верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000607,
						737000609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000607,
					"content": "Я сейчас разозлюсь по-настоящему. Р-р-р.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000608
					]
				},
				{
					"id": 737000608,
					"content": "Совсем не страшно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000611,
					"content": "Ладно, вернёмся к делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000612
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000612,
					"content": "Как видишь, это дерево - барсом, а Рашну - его знакомая, хотя сейчас её нет здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000613
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000613,
					"content": "И?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000614,
					"content": "И? И ничего. Больше о Рашну и барсоме сказать нечего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000615
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000615,
					"content": "Такое ощущение, что Соруш что-то скрывает... Точно, насчёт кори-барабанов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000616
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000616,
					"content": "Скрывает? Абсурд. Что касается барабанов... Разве вы уже не знаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000617
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000617,
					"content": "Да. Паймон вспомнила, как Рашну сказала, что это она бросила куда-то кори-барабаны. Это очень удивило Наседжуна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000618,
					"content": "Если Паймон правильно помнит, Соруш тогда сильно нервничала и не отвечала на вопросы Наседжуна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000619
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000619,
					"content": "Создаётся впечатление, что архивы ордена скептиков далеки от идеала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000620
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000620,
					"content": "Хотя звуки барабанов действительно разбудили Рашну.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000621
					]
				},
				{
					"id": 737000621,
					"content": "Паймон, кажется, понимает, почему Зурван не доверяет нынешнему ордену скептиков. Подумай, Соруш. Помогли ли они на самом деле? Подсказки, которые они дали, в лучшем случае полуправда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000622
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000622,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000623
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000623,
					"content": "В нынешнем поколении ордена скептиков действительно есть не слишком надёжные представители, но, подобно дереву, сколько бы листьев ни распускалось, всегда найдутся те, что пожухнут и засохнут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000624
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000624,
					"content": "Когда эти сухие листья рассыплются, оставшиеся... будут теми, на кого можно положиться... Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000625
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000625,
					"content": "...Как орден скептиков стал таким?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000626
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000626,
					"content": "Хотелось бы и мне знать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000627
					]
				},
				{
					"id": 737000627,
					"content": "Именно потому, что я слишком долго пробыла в ордене скептиков, я стала неспособна различать их постепенные изменения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000628
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000628,
					"content": "Только когда я начала общаться с вами и другими незнакомцами, я поняла, что орден скептиков изменился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000629
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000629,
					"content": "Прошло несколько сотен лет. Название всё то же, но сменилось уже несколько поколений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000630
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000630,
					"content": "Неужели слава, к которой я стремлюсь, репутация, восхваляемая яснапати, тоже так... изменится? И останется лишь пустое имя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000631
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000631,
					"content": "Это хочет мне сказать первоявленная. Нет, не может быть... Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000632
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 737000632,
					"content": "...Соруш, не падай духом! Может быть... Может быть, Зурван не это имела в виду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000633
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000633,
					"content": "Паймон грустно видеть Соруш такой подавленной, как будто Паймон сделала что-то не так... Может, стоит попросить Зурван подбодрить Соруш.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737000609,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000610
					]
				},
				{
					"id": 737000610,
					"content": "#...Ладно, {NICKNAME}, скажи что-нибудь! Молчание нервирует Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000611
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}