			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Камисато Аяка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070201,
					"content": "Она открылась? Открылась? Оставил ли наш инадзумский Адепт какое-нибудь сокровище?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070202,
					"content": "Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070203
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070203,
					"content": "Хм... Похоже на книгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070204,
					"content": "Кажется, это ещё одна записная книжка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070205
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070205,
					"content": "Не принадлежит ли она Цубаки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070206
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070206,
					"content": "Давайте лучше пока выйдем. Здесь всё немного не так, как я себе представляла. Мне что-то... не очень хочется открывать записи в этом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070207
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070207,
					"content": "Паймон понимает. Читать в потёмках плохо для глаз. Выходим, выходим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1200703,
			"completionStepIds": [
				1200707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200707",
							"2"
						],
						"stepId": 1200707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Камисато Аяка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070301,
					"content": "Вот это место подходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070302
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070302,
					"content": "Ладно, давайте посмотрим, что там написано!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070303,
					"content": "Ух, наверняка о загадочном сокровище! Паймон не терпится узнать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070304,
					"content": "Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070305
					]
				},
				{
					"id": 120070305,
					"content": "Что такое? Чего это ты вдруг шепчешь? Паймон не по себе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070306,
					"content": "Давай отойдём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070307
					]
				},
				{
					"id": 120070307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070308
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070308,
					"content": "#А-а-а, так ты {M#хотел}{F#хотела}, чтобы Аяка читала записи и не отвлекалась. Похоже, там речь идёт о чём-то действительно важном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070309,
					"content": "Но, судя по выражению её лица... скорее всего, карты сокровищ там нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070310,
					"content": "Хм, что же там такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070311,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070312
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070312,
					"content": "У-у-уф.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070313
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070313,
					"content": "#{NICKNAME}, Паймон, простите, что заставила вас так долго ждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070314
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070314,
					"content": "Пустяки, это было совсем недолго! Ты читаешь очень быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070315,
					"content": "Ты прочла все записи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070316
					]
				},
				{
					"id": 120070316,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070317
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070317,
					"content": "Думаю, я должна поделиться правдой из этой записной книжки с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070318
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070318,
					"content": "Даже учитывая то, что прочесть такое я вовсе не ожидала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070319
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070319,
					"content": "Не ожидала? То есть, это не записи посланницы кицунэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070320,
					"content": "Не посланницы кицунэ, нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070321
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070321,
					"content": "Цубаки на самом деле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070322
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070322,
					"content": "...И есть моя мать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070323
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070323,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070324,
					"content": "Удивлена? Я т-тоже... Но об этом говорится в самом начале записей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070325
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070325,
					"content": "«Цубаки - это я, и в то же время некто иной. Когда я Цубаки, я перестаю быть Камисато Каё и становлюсь самой обыкновенной женщиной».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070326
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070326,
					"content": "«На этих страницах изложены мелочи жизни простого человека, и только».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070327
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070327,
					"content": "По большей части здесь собраны личные размышления матери о всяческих пустяках. Всё, что мы предполагали о Цубаки, на деле относилось к ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070328
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070328,
					"content": "Выходит... Чертёж наряда, иностранное блюдо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070329,
					"content": "Да, это то, что хотела попробовать моя мать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070330
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070330,
					"content": "Наверное, выглядит всё это несуразно, но я вполне могу понять её поведение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070331
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070331,
					"content": "Иными словами... Другая сторона есть и у меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070332
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070332,
					"content": "Эти записи потрясли меня до глубины души... Словно кто-то взял мои мысли и перенёс их на бумагу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070333
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070333,
					"content": "Аяка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070334
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070334,
					"content": "Выйдя замуж за отца, она стала хозяйкой дома Камисато, с чем пришли разнообразные обязанности. В то же время определённые обязательства налагал и статус комиссии Ясиро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070335
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070335,
					"content": "Вдобавок за каждым её действием пристально следили, видя в ней представителя клана Камисато. В таких условиях у неё не оставалось времени на то, что ей нравилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070336
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070336,
					"content": "Когда погиб отец, делами клана стали заниматься мы с братом. В те времена мы столкнулись со всевозможными трудностями. Вряд ли кто-нибудь вне клана может представить, как нам пришлось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070337
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070337,
					"content": "Каждый раз, когда предо мной возникала проблема, я спрашивала себя: прошла ли через это моя мать? Как бы она поступила на моём месте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070338
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070338,
					"content": "Быть может, мы с ней слишком давно не виделись, но... почему-то я запомнила только её величие и властность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070339
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070339,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070340
					]
				},
				{
					"id": 120070340,
					"content": "Но... её запечатлевшийся образ оказался неверным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070341
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070341,
					"content": "Когда я прочла эти записи, то поняла... Она была такой же, как я. За всеми этими обязательствами и статусом был обычный человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070342
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070342,
					"content": "Ей нравилась красивая одежда, ей хотелось попробовать лакомства из разных стран, увидеть невиданные пейзажи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070343
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070343,
					"content": "Быть может, это прозвучит наивно, но... Мне хочется того же. Мне хочется быть не Камисато Аякой, а обычной девушкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070344
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070344,
					"content": "Мать писала, что всегда хотела сходить на местный инадзумский праздник. Что иногда в ясную ночь из окна нашего дома виднелись его огни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070345
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070345,
					"content": "Их видела и я! Там так оживлённо, такая пёстрая толпа, а фонари такие яркие, что освещают всё небо... Конечно, иногда я беспокоюсь по поводу общественной безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070346
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070346,
					"content": "Но человеку моего статуса нельзя взять и прийти на праздник. Это сочли бы нарушением приличий. Ещё хуже пришлось бы моим родителям, поскольку в их времена комиссия Ясиро была не так близка к населению...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070347
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070347,
					"content": "Даже без всех этих ограничений появление кого-нибудь из комиссии Ясиро вызовет не один изумлённый взгляд. Все стали бы ожидать неприятностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070348
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070348,
					"content": "Мать не стала бы тревожить людей и хотела, чтобы они наслаждались весельем и свободой праздника... Она не желала никого беспокоить, и досуга у неё почти не было. Она так никогда и не сходила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070349
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070349,
					"content": "Вот оно как вышло... А чертёж того наряда - она собиралась надеть его на праздник, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070350
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070350,
					"content": "Верно. На праздниках иногда продают иностранные блюда. Ей хотелось попробовать и их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070351
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070351,
					"content": "Надеюсь, это не прозвучит дерзко, но... Я и подумать не могла, что в сердце моя мать оставалась юной девушкой, ха-ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070352
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070352,
					"content": "Это вовсе не дерзко! Паймон думает, она была и милой девушкой, и ответственной хозяйкой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070353
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070353,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070354
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070354,
					"content": "Не ведая того, я сама исполнила некоторые из её желаний. Вот только сходить ради неё на праздник я не могу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070355
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070355,
					"content": "Наверное, этому исполниться не суждено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070356,
						120070357
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070356,
					"content": "Ты уже достигла многого.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				},
				{
					"id": 120070358,
					"content": "Да, я понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070359
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070359,
					"content": "...Спасибо вам. Кажется, я кое-что поняла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070360
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070360,
					"content": "Мы с матерью во многом схожи. То, с чем ей пришлось столкнуться, и с чем ещё предстоит столкнуться мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070361
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070361,
					"content": "Она перенесла всё несбывшееся и несбыточное на Цубаки. Что же до меня... я уже приняла решение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070362
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070362,
					"content": "О, ты тоже решила завести второе «я»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070363
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070363,
					"content": "Нет, я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070364
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070364,
					"content": "Такого у меня в планах нет. Думаю... думаю, я поставлю перед собой новую цель: жить каждый день без сожалений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070365
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070365,
					"content": "#Так что... {NICKNAME}, я... Кхм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070366
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070366,
					"content": "Уф... спокойно, спокойно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070367
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070367,
					"content": "Интересует ли вас инадзумский праздник?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070368
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070368,
					"content": "Паймон смерть как захотелось сходить ещё с тех пор, когда она увидела объявление! То есть, тебе тоже хочется пойти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070369
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070369,
					"content": "Так ты правда ни разу не была на празднике, Аяка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070370
					]
				},
				{
					"id": 120070370,
					"content": "Эй, не смейтесь надо мной! В-всё потому, что у меня были те же опасения, что и у матери... но теперь, думаю, не стоит об этом так беспокоиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070371
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070371,
					"content": "Я буду искренней с собой и исполню разделяемые мной и матерью желания. Вы, как никто другой, поймёте мою волю пойти собственным путём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070372
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070372,
					"content": "Я хотела бы... хотела бы пригласить вас на праздник!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070373
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070373,
					"content": "Я с удовольствием присоединюсь к тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070374
					]
				},
				{
					"id": 120070374,
					"content": "И Паймон, и Паймон! Здесь ведь на праздниках много вкусностей, да? И развлечений? Хе-хе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070375
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070375,
					"content": "...Как здорово! Спасибо, ребята!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070376
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070376,
					"content": "Если выйдем сейчас, то ещё успеем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070377
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 120070377,
					"content": "Точно, сегодня же последний день, не так ли? Чего мы ждём? Вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120070357,
					"content": "В этом твоей вины нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				}
			]
		}
	]
}