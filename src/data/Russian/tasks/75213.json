			},
			"dialogs": [
				{
					"id": 752130401,
					"content": "Как же печёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130402
					],
					"speakerTitle": "Турист в синем"
				},
				{
					"id": 752130402,
					"content": "Добрый день! Ваш напиток.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130403
					]
				},
				{
					"id": 752130403,
					"content": "Напиток? Я не заказывал напитки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130404
					],
					"speakerTitle": "Турист в синем"
				},
				{
					"id": 752130404,
					"content": "Не тот человек! В синих штанах, а не в синей рубашке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7521305,
