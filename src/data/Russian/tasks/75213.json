			},
			"dialogs": [
				{
					"id": 752130501,
					"content": "Жарковато...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130502
					],
					"speakerTitle": "Турист в серых штанах"
				},
				{
					"id": 752130502,
					"content": "Добрый день! Ваш напиток.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130503
					]
				},
				{
					"id": 752130503,
					"content": "Бесплатный напиток? О Архонты! Мои молитвы были услышаны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130504
					],
					"speakerTitle": "Турист в серых штанах"
				},
				{
					"id": 752130504,
					"content": "Не тот! Нам нужен человек в синих штанах, а не в серых!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
