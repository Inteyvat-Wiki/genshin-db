					"Хайяк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752130201,
					"content": "Нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130202
					]
				},
				{
					"id": 752130202,
					"content": "А? Правда поможешь? Ну, раз уж настаиваешь... Все сотрудники уже заняты делами, а тут как раз срочный заказ на доставку остался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130203
					],
					"speakerTitle": "Хайяк"
				},
				{
					"id": 752130203,
					"content": "В заказе пометка: <color=#00E1FFFF>гостю в синих штанах на пляже</color>. Главное - доставить вовремя, и всё будет в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130204
					],
					"speakerTitle": "Хайяк"
				},
				{
					"id": 752130204,
					"content": "Огромное спасибо за помощь! Вдобавок к плате за доставку я поделюсь с тобой рецептом нашего фирменного напитка. Очень на тебя рассчитываю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хайяк"
				}
			]
		},
		{
			"id": 7521303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
